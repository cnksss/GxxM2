          SM_RANDOMCODE, // 登录验证码
          SM_OPENL2PASSWORD, SM_SETL2PASSWORD, SM_SETL2PASSWORD_RESULT, SM_CHECKL2PASSWORD, SM_RANDOMCODE_RET, SM_HEAR, SM_SENDNOTICE, SM_GETBAKCHAR_SUCCESS, // 找回人物
          SM_GETBAKCHAR_FAIL, {SM_FEATURECHANGED,}
          SM_LOGON, SM_ABILITY, SM_HEALTHSPELLCHANGED, SM_MAPDESCRIPTION, SM_SYSMESSAGE, SM_GROUPMESSAGE, SM_CRY, SM_WHISPER, SM_GUILDMESSAGE, SM_MOVEMESSAGE, SM_SCREENMESSAGE, SM_DELAYMESSAGE, SM_CENTERMESSAGE, SM_TOPCHATBOARDMESSAGE, SM_NATIONMESSAGE, SM_SERVERCONFIG, SM_ENABLE_UPLOAD_PICKITEMS, SM_GETREGINFO, SM_UNBINDLIST, SM_SENDUSERMOVECMD, SM_NEWMAP, SM_MISSIONNPC, // 任务列表
          SM_EFFECTIMAGELIST, // WIL列表
          SM_PLAYEFFECT, // 播放人物效果
          SM_SCREENEFFECT, SM_CHANGESPEED, // 游戏速度
          SM_MAPCANRUN, // 穿人穿怪状态
          SM_PLUGFILE, // 客户端插件MD5 M2发送过来进行检测
          SM_MODULEMD5, // 白名单模块MD5
          SM_CUSTOMMONEYRULE, SM_SENDITEMDESCLIST, SM_SENDITEMDESCTOPLIST, SM_BLACKMODULEMD5, SM_ABILITY_NOBONUS, SM_SENDCUSTOMMONSTERCONFIG, SM_SENDCUSTOMMAGICCONFIG, SM_STDITEMLIST, SM_SPECIALCMD, SM_SENDFILTERITEMLIST, SM_SENDTZITEMDESCLIST, SM_SENDCUSTOMNPCCONFIG, SM_SENDDROPITEMEFFECTLIST, SM_SENDENABLEDAUCTIONITEMLIST, SM_SENDRUNGATE_CHECKCODE, SM_SENDSELGATE_CHECKCODE, SM_ANTIPLUGSTREAM, SM_CONTINUEANTIPLUGSTREAM, SM_ANTIPLUGSTREAM_2, SM_CONTINUEANTIPLUGSTREAM_2, SM_ANTIPLUGSTREAM_LEG,
