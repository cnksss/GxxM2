procedure TfrmMain.ProcessMessageCustomMonsterConfig(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  MonsterConfig:PClientCustomMonsterConfig;
  OutBytes:Integer;
  OutBuf:PChar;
  Buffer:PChar;
begin
  if (DefMsg.Series = 0) or (Length(sData) > 0) then begin
    g_MonstersCRC := BufferCrc(PChar(sData), Length(sData));

    for I := 0 to g_CustomMonsterConfig.Count - 1 do begin
      Dispose(PClientCustomMonsterConfig(g_CustomMonsterConfig.Items[I]));
    end;
    g_CustomMonsterConfig.Clear;

    if (DefMsg.Recog > 0) and (DefMsg.Recog = Length(sData)) then begin
      OutBytes := MakeLong(DefMsg.Param, DefMsg.Tag);
      GetMem(OutBuf, OutBytes + 1);
      try
        zLibDecompressString(sData, OutBuf, OutBytes);
        Buffer := OutBuf;
        for I := 0 to OutBytes div SizeOf(TClientCustomMonsterConfig) - 1 do begin
          New(MonsterConfig);
          Move(Buffer^, MonsterConfig^, SizeOf(TClientCustomMonsterConfig));
          g_CustomMonsterConfig.Add(MonsterConfig);

          Buffer := Buffer + SizeOf(TClientCustomMonsterConfig);
        end;
      finally
        FreeMem(OutBuf, OutBytes + 1);
      end;
    end;
  end;

  if DefMsg.Series > 0 then begin
    g_nShowClientDataFileProgress := DefMsg.Series;
    //OutputDebugString(PChar('正在加载资源' + IntToStr(g_nShowClientDataFileProgress)));
    RenderEvent(Self);
    Application.ProcessMessages;
  end;
end;

procedure TfrmMain.ProcessMessageCustomMagicConfig(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  MagicConfig:PClientCustomMagicConfig;
  OutBytes:Integer;
  OutBuf:PChar;
  Buffer:PChar;
  MagicWarrNGOption:TMagicWarrNGOption;
begin
  if (DefMsg.Series = 0) or (Length(sData) > 0) then begin
    g_MagicsCRC := BufferCrc(PChar(sData), Length(sData));

    for I := 0 to g_CustomMagicConfig.Count - 1 do begin
      Dispose(PClientCustomMagicConfig(g_CustomMagicConfig.Items[I]));
    end;
    g_CustomMagicConfig.Clear;

    for MagicWarrNGOption := Low(g_AutoCustomMagic) to High(g_AutoCustomMagic) do begin
      SetLength(g_AutoCustomMagic[MagicWarrNGOption], 0);
    end;

    if (DefMsg.Recog > 0) and (DefMsg.Recog = Length(sData)) then begin
      OutBytes := MakeLong(DefMsg.Param, DefMsg.Tag);
      GetMem(OutBuf, OutBytes + 1);
      try
        zLibDecompressString(sData, OutBuf, OutBytes);
        Buffer := OutBuf;
        for I := 0 to OutBytes div SizeOf(TClientCustomMagicConfig) - 1 do begin
          New(MagicConfig);
          Move(Buffer^, MagicConfig^, SizeOf(TClientCustomMagicConfig));
          g_CustomMagicConfig.Add(MagicConfig);

          MagicWarrNGOption := MagicConfig.MagicBaseConfig.MagicWarrNGOption;
          if MagicConfig.boIsMagicWarr and (MagicWarrNGOption <> mngoNone) then begin
            SetLength(g_AutoCustomMagic[MagicWarrNGOption], Length(g_AutoCustomMagic[MagicWarrNGOption]) + 1);
            g_AutoCustomMagic[MagicWarrNGOption][Length(g_AutoCustomMagic[MagicWarrNGOption]) - 1] := MagicConfig.wMagicID;
          end;

          Buffer := Buffer + SizeOf(TClientCustomMagicConfig);
        end;
      finally
        FreeMem(OutBuf, OutBytes + 1);
      end;
    end;
  end;

  if DefMsg.Series > 0 then begin
    g_nShowClientDataFileProgress := DefMsg.Series;
    //OutputDebugString(PChar('正在加载资源' + IntToStr(g_nShowClientDataFileProgress)));
    RenderEvent(Self);
    Application.ProcessMessages;
  end;
end;

