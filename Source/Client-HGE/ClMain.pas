    if g_AntiPlugDllStringCRC <> 0 then begin
      SendClientMessage(CM_IOCP_ANTIPLUG_CRC, g_AntiPlugDllStringCRC, 0, 0, 0, '');
    end;

    if g_AntiPlugDllStringCRC_IOCP2 <> 0 then begin
      SendClientMessage(CM_IOCP_ANTIPLUG_CRC, g_AntiPlugDllStringCRC_IOCP2, 0, 0, 0, '');
    end;

    if g_AntiPlugDllStringCRC2 <> 0 then begin
      SendClientMessage(CM_IOCP_ANTIPLUG_CRC2, g_AntiPlugDllStringCRC2, 0, 0, 0, '');
    end;

    if g_AntiPlugDllStringCRC_LEG <> 0 then begin
      SendClientMessage(CM_IOCP_ANTIPLUG_CRC_LEG, g_AntiPlugDllStringCRC_LEG, 0, 0, 0, '');
    end;

    SendClientMessage(CM_CLIENTDATAFILE, 0, 0, 0, 0, GetRequestClientDataFileMD5);
  end
  else if DefMsg.Param = Length(sData) then begin
    g_boShowClientDataFile := False;

    g_boShowNotice := True;
    g_boDoFastFadeOut := False;
    msgstr := zLibDecompressString(sData);

    if Assigned(g_AntiPlugNotifyFunc) then begin
      g_AntiPlugNotifyFunc(event_Recv_LoginNotice, nil, 0);
    end;

    if FrmDlg.DMessageNoticeDlg(msgstr) = mrOk then begin
      {$IF PRIVATE_CLIENT = 0}
      {$I VMProtectBegin.inc}
      {$IFEND}
      len := Length(sData);

      // k为string类型数据(url) 的下标, 起始值从1开始
      k := 1;

      a := MakeLong(DefMsg.Tag, DefMsg.Series);
      b := $609CD4C4; // 9E3779B9
      c := $14A54394; // E6359A60

      while len >= 12 do begin
        a := a + DWORD(Ord(sData[k + 0]) + (Ord(sData[k + 1]) shl 8) + (Ord(sData[k + 2]) shl 16) + (Ord(sData[k + 3]) shl 24));
        b := b + DWORD(Ord(sData[k + 4]) + (Ord(sData[k + 5]) shl 8) + (Ord(sData[k + 6]) shl 16) + (Ord(sData[k + 7]) shl 24));
        c := c + DWORD(Ord(sData[k + 8]) + (Ord(sData[k + 9]) shl 8) + (Ord(sData[k + 10]) shl 16) + (Ord(sData[k + 11]) shl 24));

        // a -= b; a -= c; a ^= c >> 13;
        a := a - b;
        a := a - c;
        a := a xor (c shr 13);

        // b -= c; b += a; b ^= a << 8;
        b := b + c;
        b := b - a;
        b := b xor (a shl 8);

        // c -= a; c += b; c ^= b >> 15;
        c := c - a;
        c := c + b;
        c := c xor (b shr 3);

        Inc(k, 12);
        Dec(len, 12);
      end;

      c := c + DWORD(Length(sData));

      if len >= 11 then
        c := c + DWORD(Ord(sData[k + 10]) shl 24);
      if len >= 10 then
        c := c + DWORD(Ord(sData[k + 9]) shl 16);
      if len >= 9 then
        c := c + DWORD(Ord(sData[k + 8]) shl 8);

      if len >= 8 then
        b := b + DWORD(Ord(sData[k + 7]) shl 24);
      if len >= 7 then
        b := b + DWORD(Ord(sData[k + 6]) shl 16);
      if len >= 6 then
        b := b + DWORD(Ord(sData[k + 5]) shl 8);
      if len >= 5 then
        b := b + DWORD(Ord(sData[k + 4]));

      if len >= 4 then
        a := a + DWORD(Ord(sData[k + 3]) shl 24);
      if len >= 3 then
        a := a + DWORD(Ord(sData[k + 2]) shl 16);
      if len >= 2 then
        a := a + DWORD(Ord(sData[k + 1]) shl 8);
      if len >= 1 then
        a := a + DWORD(Ord(sData[k + 0]));

      // a -= b; a -= c; a ^= c >> 13;
      a := a - b;
      a := a - c;
      a := a xor (c shr 13);

      // b -= c; b += a; b ^= a << 8;
      b := b + c;
      b := b - a;
      b := b xor (a shl 8);

      // c -= a; c += b; c ^= b >> 15;
      c := c - a;
      c := c + b;
      c := c xor (b shr 3);

      {$IF PRIVATE_CLIENT = 0}
      {$I VMProtectEnd.inc}
      {$IFEND}

      Msg := MakeDefaultMsg(CM_LOGINNOTICEOK, MakeLong(g_nScreenWidth, g_nScreenHeight), LoWord(c), HiWord(c), MakeWord(Integer(g_ClientVersion), WIDTHGRIDCOUNT));
      SendSocket(EncodeMessage(Msg));

      if g_boAutoUpdate and (g_UpdateEngine <> nil) then begin
        g_UpdateEngine.ClearRequestList;
      end;
    end;
  end;
end;

