            end;
          end
          else
            FrmDlg.DChatMemo.Previous;
        end;
      VK_DOWN:begin
          if ssCtrl in Shift then begin
            if FrmDlg.IsInputChatEdit then begin
              S := FrmDlg.GetNextHistroySendSay;
            end
            else begin
              S := FrmDlg.GetLastHistroySendSay;
            end;

            if Length(S) > 0 then begin
              FrmDlg.ShowChatEdit();
              FrmDlg.DEdChat.Text := S;
            end;
          end
          else
            FrmDlg.DChatMemo.Next;
        end;
      VK_PRIOR:begin
          if FrmDlg.DChatMemo.Position >= FrmDlg.DChatMemo.Height then
            FrmDlg.DChatMemo.Position := FrmDlg.DChatMemo.Position - FrmDlg.DChatMemo.Height
          else
            FrmDlg.DChatMemo.Position := 0;
        end;
      VK_NEXT:begin
          if FrmDlg.DChatMemo.Position + FrmDlg.DChatMemo.Height < FrmDlg.DChatMemo.MaxValue then
            FrmDlg.DChatMemo.Position := FrmDlg.DChatMemo.Position + FrmDlg.DChatMemo.Height
          else
            FrmDlg.DChatMemo.Position := FrmDlg.DChatMemo.MaxValue;
        end;
    end;
  end;
end;

procedure TfrmMain.FormKeyPress(Sender:TObject; var Key:Char);
var
  boEdDlgEdit:Boolean;
  EdDlgEdit:TDxEdit;
begin
  if FrmDlg = nil then
    Exit;
  if not FrmDlg.DBackground.KeyPress(Key) then begin
    {$IF Enabled_PlugEngine = 1}
    if Assigned(HookFormKeyPress) then begin
      try
        HookFormKeyPress(Sender, Key);
      except
        on E:Exception do begin
          DebugOutStr('[Exception] HookFormKeyPress');
          DebugOutStr(E.Message);
        end;
      end;
    end;
    {$IFEND}

    if DScreen.CurrentScene = PlayScene then begin
      if FrmDlg.IsInputChatEdit then begin
        FrmDlg.DEdChat.SetFocus;
        Exit;
      end;

      if ((FrmDlg.Memo <> nil) and Frmdlg.Memo.Visible and FrmDlg.Memo.Focused) then
        Exit;

      if ((g_ClientConfig.btConfigDlgType = 0) and (TMirConfigDlg(g_ConfigDlg).FMemo <> nil) and TMirConfigDlg(g_ConfigDlg).FMemo.Visible and TMirConfigDlg(g_ConfigDlg).FMemo.Focused) then
        Exit;

      {.$I VMProtectBegin.inc}
      case byte(Key) of
        byte('1')..byte('6'):begin
            if (not g_boMapMovingWait) then begin
              g_ConfigDlg.ProtectEnabled := False;
              try
                EatItem(byte(Key) - byte('1'));
              finally
                g_ConfigDlg.ProtectEnabled := True;
              end;
            end;
          end;
        byte(' '), 13:begin
            boEdDlgEdit := False;
            EdDlgEdit := nil;
            case g_ClientVersion of
              cv176, cv185, cvHero, cvSerial, cvMirSequel, cvMirNewUI205:begin
                  if TSerialWindows(FrmDlg).DMsgDlg.Visible and TSerialWindows(FrmDlg).EdDlgEdit.Visible then begin
                    EdDlgEdit := TSerialWindows(FrmDlg).EdDlgEdit;
                    boEdDlgEdit := True;
                  end;
                end;
              {
              cvMirs:
                begin
                  if TMirsWindows(FrmDlg).DMsgDlg.Visible and TMirsWindows(FrmDlg).EdDlgEdit.Visible then
                  begin
                    EdDlgEdit := TMirsWindows(FrmDlg).EdDlgEdit;
                    boEdDlgEdit := True;
                  end;
                end;
              cvMirReturn:
                begin
                  if TReturnWindows(FrmDlg).DMsgDlg.Visible and TReturnWindows(FrmDlg).EdDlgEdit.Visible then
                  begin
                    EdDlgEdit := TReturnWindows(FrmDlg).EdDlgEdit;
                    boEdDlgEdit := True;
                  end;
                end;
              }
            end;

            if (not boEdDlgEdit) and (not ((FrmDlg.Memo <> nil) and Frmdlg.Memo.Visible and FrmDlg.Memo.Focused)) and (not ((g_ClientConfig.btConfigDlgType = 0) and (TMirConfigDlg(g_ConfigDlg).FMemo <> nil)
              and TMirConfigDlg(g_ConfigDlg).FMemo.Visible and TMirConfigDlg(g_ConfigDlg).FMemo.Focused)) then begin
              // DScreen.AddChatBoardString(Format('FormKeyPress:%D Key:%S', [1,Key]), clGreen, clWhite);
              // DebugOutStr(Format('FormKeyPress:%D Key:%S %d %d Key:%d', [1,Key,Ord('M'),Ord('m'),Ord(Key)]));
              // Showmessage(inttostr(Ord(key)));
              FrmDlg.ShowChatEdit();

              if FrmDlg.BoGuildChat then begin
                FrmDlg.DEdChat.Text := '!~';
                FrmDlg.DEdChat.SelStart := Length(FrmDlg.DEdChat.Text);
                FrmDlg.DEdChat.SelLength := 0;
              end else begin
                FrmDlg.DEdChat.Text := '';
              end;
            end else begin
              if EdDlgEdit <> nil then
                EdDlgEdit.SetFocus;
            end;
          end;
        byte('@'), byte('!'), byte('/'):begin
            boEdDlgEdit := False;
            EdDlgEdit := nil;
            case g_ClientVersion of
              cv176, cv185, cvHero, cvSerial, cvMirSequel, cvMirNewUI205:begin
                  if TSerialWindows(FrmDlg).DMsgDlg.Visible and TSerialWindows(FrmDlg).EdDlgEdit.Visible then begin
                    EdDlgEdit := TSerialWindows(FrmDlg).EdDlgEdit;
                    boEdDlgEdit := True;
                  end;
                end;
            end;
            if boEdDlgEdit then begin
              if EdDlgEdit <> nil then
                EdDlgEdit.SetFocus;
            end
            else begin
              // DScreen.AddChatBoardString(Format('FormKeyPress:%D', [2]), clGreen, clWhite);
              FrmDlg.ShowChatEdit();
              if Key = '/' then begin
                if WhisperName = '' then
                  FrmDlg.DEdChat.Text := Key
                else if Length(WhisperName) > 2 then
                  FrmDlg.DEdChat.Text := '/' + WhisperName + ' '
                else
                  FrmDlg.DEdChat.Text := Key;
                FrmDlg.DEdChat.SelStart := Length(FrmDlg.DEdChat.Text);
                FrmDlg.DEdChat.SelLength := 0;
              end
              else begin
                FrmDlg.DEdChat.Text := Key;
                FrmDlg.DEdChat.SelStart := 1;
                FrmDlg.DEdChat.SelLength := 0;
              end;
            end;
          end;
      end;
      {.$I VMProtectEnd.inc}
      if (not ((FrmDlg.Memo <> nil) and Frmdlg.Memo.Visible and FrmDlg.Memo.Focused)) or (not ((g_ClientConfig.btConfigDlgType = 0) and (TMirConfigDlg(g_ConfigDlg).FMemo <> nil) and TMirConfigDlg(g_ConfigDlg).FMemo.Visible and TMirConfigDlg(g_ConfigDlg).FMemo.Focused)) then
        Key := #0;
    end;
  end;
end;

function TfrmMain.GetMagicByKey(Key:Char):PTClientMagic;
var
  I:Integer;
  pm:PTClientMagic;
begin
  Result := nil;
  g_MagicList.Lock;
  try
    for I := 0 to g_MagicList.Count - 1 do begin
      pm := PTClientMagic(g_MagicList[I]);
      if pm.Key = Key then begin
        Result := pm;
        Break;
      end;
    end;
  finally
    g_MagicList.UnLock;
  end;
end;

function TfrmMain.FindMagic(wMagicId:Word):PTClientMagic;
var
  I:Integer;
  pm:PTClientMagic;
begin
  Result := nil;
  g_MagicList.Lock;
  try
    for I := 0 to g_MagicList.Count - 1 do begin
      pm := PTClientMagic(g_MagicList[I]);
      if pm.Def.wMagicId = wMagicId then begin
        Result := pm;
        Break;
      end;
    end;
  finally
    g_MagicList.UnLock;
  end;
end;

