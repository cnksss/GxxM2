procedure TfrmMain.Timer1Timer(Sender:TObject);
const
  nMaxSendSize = 60000;
  MAXBUFFERSIZE = 4096;
var
  Data:string;
  Buffer:PChar;
  nSendBuffLen:Integer;
  nSendLen:Integer;
  nSendBlock:Integer;
  AntiPlugData:PAntiPlugData;
  {$IF TESTMODE = 1}
  RunTick, RunTime:LongWord;
  {$IFEND}
  dmsg:TDefaultMessage;
  MsgHeader:TRungateMsgHeader;
  Offset:Integer;
  CheckValue:array[0..29] of Byte;
  dwProtectValueCRC:LongWord;
begin
  //DebugOutStr('UserCenterMode Timer1.1');

  if g_boAutoUpdate then begin
    if (MyGetTickCount - g_LastRefreshUpdateProgress >= 1000) then begin
      g_LastRefreshUpdateProgress := MyGetTickCount;

      g_UpdateSizeLock.Enter;

      if g_UpdateSize >= 1024 * 1024 then
        g_UpdateSpeedStr := Format('%.2fM/s', [g_UpdateSize / 1024 / 1024])
      else if g_UpdateSize >= 1024 then
        g_UpdateSpeedStr := Format('%.2fK/s', [g_UpdateSize / 1024])
      else
        g_UpdateSpeedStr := Format('%.2fB/s', [g_UpdateSize * 1.0]);

      g_UpdateSize := 0;
      g_UpdateSizeLock.Leave;
    end;
  end;

  if g_WaitAppExit and (tick_diff(g_RecvBufTick, MyGetTickCount) >= 5000) then begin
    g_AntiPlugNotifyFunc := nil;

    g_boAppExit := True;

    SaveOrLoadMyBagItemList(True);
    CloseAllWindows;

    {$IF IsMultiThreadRender = 1}
    if RenderThread <> nil then
      RenderThread.Terminate;
    {$ELSE}
    TimerRender.Enabled := False;
    {$IFEND}

    CSocket.Close;

    GameCanvas.Finalize;

    Application.Terminate;
    Exit;
  end;

  // 将这里移动线程Timer中，修复过图卡位 (移动线程中，执行服务器npc脚本; messagebox 会白屏并报错) chongchong 2017-06-21
  if g_AntiPlugText <> nil then begin
    g_AntiPlugText.Lock;
    try
      while g_AntiPlugText.Count > 0 do begin
        //OutputDebugString('----------------------------------------------------');
        AntiPlugData := PAntiPlugData(g_AntiPlugText.Objects[0]);
        if AntiPlugData.DataType = adpChatText then begin
          DScreen.AddChatBoardString(g_AntiPlugText.Strings[0], AntiPlugData.ForeColor, AntiPlugData.BackColor);
        end
        else begin
          frmMain.SendSocket(g_AntiPlugText.Strings[0], True);
        end;

        Dispose(AntiPlugData);
        g_AntiPlugText.Delete(0);
      end;
    finally
      g_AntiPlugText.UnLock;
    end;
  end;


  EnterCriticalSection(g_SendSocketLock);
  try
    if (not g_boClientCanSend) and (MyGetTickCount - g_dwClientCanSendTick > 100) then
      g_boClientCanSend := True;

    while (g_SendStream.Position > 0) do begin
      if (g_SendStream.Length >= g_SendStream.Position) or (not CSocket.Socket.Connected) then begin // 发送完成
        // g_SendStream.Clear;
        g_SendStream.Length := 0;
        g_SendStream.Position := 0;
        break;
      end;
      dwCheckActiveTick := MyGetTickCount;
      nSendBuffLen := g_SendStream.Position - g_SendStream.Length;

      if nSendBuffLen > MAXBUFFERSIZE then
        nSendBlock := MAXBUFFERSIZE
      else
        nSendBlock := nSendBuffLen;

      Buffer := PChar(Integer(g_SendStream.Memory) + g_SendStream.Length);

      g_dwLastSendBufTick := MyGetTickCount;
      nSendLen := CSocket.Socket.SendBuf(Buffer^, nSendBlock);

      if nSendLen = SOCKET_ERROR then begin
        if (WSAGetLastError = WSAEWOULDBLOCK) then begin // 缓存满 退出
          g_boClientCanSend := False;
          g_dwClientCanSendTick := MyGetTickCount;
        end;
        Break;
      end
      else if nSendLen > 0 then begin
        g_SendStream.Length := g_SendStream.Length + nSendLen;
      end;
    end;

    if (g_SendStream.Length >= g_SendStream.Position) then begin // 发送完成
      g_SendStream.Length := 0;
      g_SendStream.Position := 0;
    end;
  except
    DebugOutStr('Timer1Timer 1');
  end;
  LeaveCriticalSection(g_SendSocketLock);

  {$IF TESTMODE = 1}
  RunTick := timeGetTime;
  {$IFEND}
  // if g_boBusy then Exit;
  // g_boBusy := True;

  BufferStr := BufferStr + SocStr;
  SocStr := '';
  if BufferStr <> '' then begin
    if g_ConnectionStep < cnsPlay then begin
      while Length(BufferStr) >= 2 do begin
        if g_boMapMovingWait then
          Break;

        BufferStr := ArrestStringEx_Ansi(BufferStr, '#', '!', Data);
        if Length(Data) = 0 then
          Break;

        try
          DecodeMessagePacketOld(Data);
        except
          DebugOutStr('DecodeMessagePacket');
        end;

        if Length(BufferStr) = 0 then
          Break;
      end;
    end else begin
      while Length(BufferStr) >= SizeOf(TRungateMsgHeader) do begin
        if g_boMapMovingWait then
          Break;

        MsgHeader := pTRungateMsgHeader(BufferStr)^;

        dmsg := MsgHeader.Msg;
        if MsgHeader.Code <> RUN_GATE_MSG_CODE then begin
          BufferStr := '';
          DebugOutStr('MsgHeader Is Error');
          Exit;
        end;

        if Length(BufferStr) < SizeOf(TRungateMsgHeader) + Integer(MsgHeader.DataLen) then
          Break;

        Data := Copy(BufferStr, SizeOf(TRungateMsgHeader) + 1, MsgHeader.DataLen);
        BufferStr := Copy(BufferStr, SizeOf(TRungateMsgHeader) + MsgHeader.DataLen + 1, Length(BufferStr) - SizeOf(TRungateMsgHeader) - Integer(MsgHeader.DataLen));

        if dmsg.Ident = SM_RUNGATE_HEARTBEAT then begin
          dmsg := MakeDefaultMsg(CM_RUNGATE_HEARTBEAT, 0, 0, 0, 0);
          SendSocket(EncodeMessage(dmsg));
        end else begin
          try
            DecodeMessagePacket(dmsg, Data);
          except
            DebugOutStr('DecodeMessagePacket');
          end;
        end;

        if Length(BufferStr) = 0 then
          Break;
      end;
    end;
  end;

  {$IF TESTMODE = 1}
  RunTime := timeGetTime - RunTick;
  if RunTime > 10 then begin
    OutputDebugString(PChar('TfrmMain.Timer1Timer:' + IntToStr(RunTime)));
  end;
  {$IFEND}
  // if WarningLevel > 30 then
    // frmMain.Close;
  if g_MySelf <> nil then begin
    if g_boQueryPrice then begin
      if MyGetTickCount - g_dwQueryPriceTime > 500 then begin
        g_boQueryPrice := False;
        case FrmDlg.SpotDlgMode of
          dmSell:
            SendQueryPrice(g_nCurMerchant, g_SellDlgItem.MakeIndex, g_SellDlgItem.S.Name, False, 0);
          dmRepair:
            SendQueryRepairCost(g_nCurMerchant, g_SellDlgItem.MakeIndex, g_SellDlgItem.S.Name);
        end;
      end;
    end;

    if g_nBonusPoint > 0 then begin
      FrmDlg.DBotPlusAbil.Visible := True;
    end else begin
      FrmDlg.DBotPlusAbil.Visible := False;
    end;

    if tick_diff(FCheckValueCRCTick, MyGetTickCount) >= FCheckValueCRCTime then begin
      {$I VMProtectBegin.inc}
      Randomize;
      FCheckValueCRCTime := 20000 + Random(40000); // 20 - 60秒
      FCheckValueCRCTick := MyGetTickCount;

      Offset := 0;
      Move(g_Clientconfig.dwMoveFrameTime, CheckValue[Offset], SizeOf(g_Clientconfig.dwMoveFrameTime));
      Inc(Offset, SizeOf(g_Clientconfig.dwMoveFrameTime));

      Move(g_Clientconfig.dwHitFrameTime, CheckValue[Offset], SizeOf(g_Clientconfig.dwHitFrameTime));
      Inc(Offset, SizeOf(g_Clientconfig.dwHitFrameTime));

      Move(g_Clientconfig.dwMagicHitFrameTime, CheckValue[Offset], SizeOf(g_Clientconfig.dwMagicHitFrameTime));
      Inc(Offset, SizeOf(g_Clientconfig.dwMagicHitFrameTime));

      Move(g_Clientconfig.nMoveSpeed, CheckValue[Offset], SizeOf(g_Clientconfig.nMoveSpeed));
      Inc(Offset, SizeOf(g_Clientconfig.nMoveSpeed));

      Move(g_Clientconfig.nAttackSpeed, CheckValue[Offset], SizeOf(g_Clientconfig.nAttackSpeed));
      Inc(Offset, SizeOf(g_Clientconfig.nAttackSpeed));

      Move(g_Clientconfig.nSpellSpeed, CheckValue[Offset], SizeOf(g_Clientconfig.nSpellSpeed));
      Inc(Offset, SizeOf(g_Clientconfig.nSpellSpeed));

      Move(g_Clientconfig.dwIncSpeedDecInterval, CheckValue[Offset], SizeOf(g_Clientconfig.dwIncSpeedDecInterval));
      Inc(Offset, SizeOf(g_Clientconfig.dwIncSpeedDecInterval));

      Move(g_Clientconfig.dwIncMoveSpeedDecInterval, CheckValue[Offset], SizeOf(g_Clientconfig.dwIncMoveSpeedDecInterval));
      Inc(Offset, SizeOf(g_Clientconfig.dwIncMoveSpeedDecInterval));

      Move(g_Clientconfig.dwIncSpellSpeedDecInterval, CheckValue[Offset], SizeOf(g_Clientconfig.dwIncSpellSpeedDecInterval));
      //Inc(Offset, SizeOf(g_Clientconfig.dwIncSpellSpeedDecInterval)); //HZQ 20230523

      dwProtectValueCRC := BufferCrc(@CheckValue[0], SizeOf(CheckValue));

      if dwProtectValueCRC <> g_ClientConfig.dwProtectValueCRC then begin
        FCheckValueCRCTime := 200000 + Random(400000); // 200 - 600秒
        SendClientMessage(CM_VALUE_CRC_ERROR, 0, 0, 0, 0, '');

        {
        if Assigned(g_AntiPlugNotifyFunc) then
        begin
          g_AntiPlugNotifyFunc(event_SocketDataAbnormal, nil, DefMsg.Ident);
          Exit;
        end;
        }
      end;
      {$I VMProtectEnd.inc}
    end;
  end;

  Run;

  //HZQ 用户中心模式没有启用SOCKET所以要排除这种情况的欢迎场景延长这种情况
  if g_boShowVersionBmp  and (not CSocket.Socket.Connected)
  and (MyGetTickCount - g_dwShowVersionBmpTick >= g_dwShowVersionBmpTime) then begin
      if (g_nClientLoginMode <> CLIENT_MODE_UC) then begin
          g_dwShowVersionBmpTime := g_dwShowVersionBmpTime + 1000;
      end;
  end;
  //DebugOutStr(Format('UserCenterMode Bool = %d , %d, %d, %d', [BoolToInt(g_boShowVersionBmp), g_dwShowVersionBmpTime, MyGetTickCount, g_dwShowVersionBmpTick]));

  if g_boShowVersionBmp and (MyGetTickCount - g_dwShowVersionBmpTick >= g_dwShowVersionBmpTime) then begin
    // if g_boShowVersionBmp and (MyGetTickCount - g_dwShowVersionBmpTick > dwShowVersionBmpTime) then begin
    g_boShowVersionBmp := False;

    if g_ConnectionStep = cnsLogin then begin
      if g_nClientLoginMode <> CLIENT_MODE_UC then begin
          if CSocket.Socket.Connected then begin
              DScreen.ChangeScene(stLogin);
          end;
      end else begin
          DScreen.ChangeScene(stLogin);
      end;
    end;
  end;

  if (FIOCPSendFileStream.Size <> 0) and (FIOCPSendFilePacketCount > 0) and (FIOCPSendFilePacketIndex < FIOCPSendFilePacketCount)
    and (tick_diff(FIOCPSendFilePacketTick, MyGetTickCount) >= 100) then begin
    if not CSocket.Socket.Connected then begin
      FIOCPSendFilePacketCount := 0;
      FIOCPSendFilePacketIndex := 0;
      FIOCPSendFileStream.Clear;
      Exit;
    end;

    Buffer := FIOCPSendFileStream.Memory;
    Inc(Buffer, nMaxSendSize * FIOCPSendFilePacketIndex);
    nSendLen := Min(nMaxSendSize, FIOCPSendFileStream.Size - FIOCPSendFilePacketIndex * nMaxSendSize);

    Data := EncodeBuffer(Buffer, nSendLen);
    dmsg := MakeDefaultMsg(CM_IOCP_RESPONSE_FILE2, Length(Data), nSendLen, FIOCPSendFilePacketCount, FIOCPSendFilePacketIndex + 1);
    SendSocket(EncodeMessage(dmsg) + Data);
    Inc(FIOCPSendFilePacketIndex);

    if FIOCPSendFilePacketIndex > FIOCPSendFilePacketCount then begin
      FIOCPSendFilePacketCount := 0;
      FIOCPSendFilePacketIndex := 0;
      FIOCPSendFileStream.Clear;
    end;

    FIOCPSendFilePacketTick := MyGetTickCount;
  end;

end;

function DevicePathToWin32Path(const FileName:string):string;
var
  C:Char;
  StrFile, StrPath, StrDriver:string;
  I:Integer;
  Buf:array[0..MAX_PATH] of Char;
begin
  Result := '';
  I := PosEx('\', FileName, 2);
  I := PosEx('\', FileName, I + 1);

  StrFile := Copy(FileName, I, Length(FileName));
  StrPath := Copy(FileName, 1, I - 1);

  if Length(StrPath) > 0 then begin
    for C := 'A' to 'Z' do begin
      StrDriver := C + ':';
      if QueryDosDevice(PChar(StrDriver), Buf, MAX_PATH) <> 0 then begin
        if SameText(StrPath, StrPas(Buf)) then begin
          Result := StrDriver + StrFile;
          Exit;
        end;
      end;
    end;
  end;
end;

procedure TfrmMain.SpeedHackTimerTimer(Sender:TObject);
var
  I:Integer;
  sPath:string;
  sMD5:string;
  {$IF Enabled_PlugEngine = 1}
  PlugInfo:pTPlugInfo;
  boFind:Boolean;
  II, III:Integer;
  {$IFEND}

  List:TStringList;
  Msg:TDefaultMessage;
begin
  {$IF PRIVATE_CLIENT = 1}
  {$I AddVmpFeatureCode_M.inc}
  {$IFEND}

  if g_MySelf = nil then
    Exit;

  SendUploadPickItemsConfig;

  if MyGetTickCount - g_dwLogonTick < 1000 * 60 then
    Exit;
  // ==============================================================================
// 删除定制版外挂检测 chongchong 2014-11-12
  {$IF TESTMODE <> 2}
  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectBegin.inc}
  {$IFEND}

  if FRandomCodeAbnormal and Assigned(g_AntiPlugNotifyFunc) then begin
    g_AntiPlugNotifyFunc(event_LoginRandomCodeAbnormal, nil, 0);
    FRandomCodeAbnormal := False;
  end;

  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}
  {
  if nShowHook > 0 then
  begin
    EnterCriticalSection(FCSActionLock);
    try
      FActionLock := True;
      ActionLockTime := MyGetTickCount;
    finally
      LeaveCriticalSection(FCSActionLock);
    end;

    SendClientMessage(CM_SENDUSERSPEEDING, 0, 0, 0, 0);
    case nShowHook of
      1: FrmDlg.DMessageDlg(DecodeResStr(SGameStopMsg1), [mbOk]);
      2: FrmDlg.DMessageDlg(DecodeResStr(SGameStopMsg2), [mbOk]);
    end;
    Exit;
  end;
  }
  {$IFEND}
  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectBegin.inc}
  {$IFEND}

  if (not FNoticeMsgDlgOkClick) and Assigned(g_AntiPlugNotifyFunc) then begin
    g_AntiPlugNotifyFunc(event_NoticeMsgDlgAbnormal, nil, 0);
    FNoticeMsgDlgOkClick := True;
  end;

  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}

  if g_ProcessBlackList.Count > 0 then begin
    if FCheckBlackProcessMD5Thread.Sleeping then
      FCheckBlackProcessMD5Thread.TriggerEvent;
  end;

  if not g_boGetPlugFileMD5OK^ then
    Exit;
  if MyGetTickCount - g_dwCheckModuleTick > 1000 then begin
    g_dwCheckModuleTick := MyGetTickCount;
    if g_boCheckModule^ or g_boAddModule^ then begin
      if SelfProcessEntry.th32ProcessID = 0 then begin
        FindModules.Clear;
        SelfModules.Clear;
        GetSelfProcesses(SelfModules);
      end;

      if SelfProcessEntry.th32ProcessID <> 0 then begin
        SelfModules.Clear;
        GetSelfModules(SelfProcessEntry.Th32ProcessID, SelfModules);

        sPath := g_sSelfFilePath + 'D3DX81ab.dll';
        for I := SelfModules.Count - 1 downto 0 do begin
          if CompareText(sPath, SelfModules.Strings[I]) = 0 then
            SelfModules.Delete(I);
        end;

        {$IF Enabled_PlugEngine = 1}
        if g_boGetPlugFileMD5OK^ then begin // 检测是不是客户端插件
          for I := SelfModules.Count - 1 downto 0 do begin
            boFind := False;
            for II := 0 to PlugInManage.PlugList.Count - 1 do begin
              if CompareText(PlugInManage.PlugList.Strings[II], SelfModules.Strings[I]) = 0 then begin
                PlugInfo := pTPlugInfo(PlugInManage.PlugList.Objects[II]);
                for III := 0 to g_ServerPlugFileMD5List.Count - 1 do begin
                  if CompareText(PlugInfo.MD5, g_ServerPlugFileMD5List.Strings[III]) = 0 then begin
                    boFind := True;
                    break;
                  end;
                end;
              end;
              if boFind then
                break;
            end;

            if boFind then
              SelfModules.Delete(I);
          end;
        end
        else begin
          sPath := g_sSelfFilePath + 'PlugIn\';
          for I := SelfModules.Count - 1 downto 0 do begin
            if CompareLStr(sPath, SelfModules.Strings[I], Length(sPath)) then
              SelfModules.Delete(I);
          end;
        end;
        {$IFEND}

        sPath := Application.ExeName;
        for I := SelfModules.Count - 1 downto 0 do begin
          if CompareText(sPath, SelfModules.Strings[I]) = 0 then
            SelfModules.Delete(I);
        end;

        for I := SelfModules.Count - 1 downto 0 do begin
          if CheckProcessModule(SelfModules.Strings[I]) then
            SelfModules.Delete(I);
        end;

        if SelfModules.Count > 0 then begin
          if g_boAddModule^ then begin
            List := TStringList.Create;
            for I := 0 to SelfModules.Count - 1 do begin
              sMD5 := RivestFile(SelfModules.Strings[I]);
              if (not AddModuleMD5List.Exists(sMD5)) and (not BlackModuleMD5List.Exists(sMD5)) then begin
                AddModuleMD5List.Add(sMD5, nil);
                List.Add(sMD5 + '|' + SelfModules.Strings[I]);
              end;
            end;
            if List.Count > 0 then begin
              Msg := MakeDefaultMsg(CM_SENDMODULEMD5, 0, 0, 0, 0);
              SendSocket(EncodeMessage(Msg) + zEncodeString(List.Text));
            end;
            List.Free;
          end
          else begin
            for I := 0 to SelfModules.Count - 1 do begin
              DebugOutStr(RivestFile(SelfModules.Strings[I]) + '|' + SelfModules.Strings[I], False);
            end;
          end;

          if g_boCheckModule^ then begin
            SpeedHackTimer.Enabled := False;

            SendDelayMsg(g_MySelf, RCM_FindModule, 0, 0, 0, 0, '', 2000);
          end;
        end;
      end;
    end;
  end;
end;

procedure TfrmMain.GetSelfProcesses(ModuleList:TStringList);

  function CheckModuleOwnerProcessID(ProcessID:DWORD):Boolean;
  var
    hSnap:THandle;
    ModuleEntry:TModuleEntry32;
    Proceed:Boolean;
  begin
    Result := False;
    hSnap := CreateToolhelp32Snapshot(TH32CS_SNAPMODULE, ProcessID);
    if hSnap <> INVALID_HANDLE_VALUE then begin
      ModuleEntry.dwSize := SizeOf(TModuleEntry32);
      Proceed := Module32First(hSnap, ModuleEntry);
      while Proceed do begin
        if ModuleEntry.th32ProcessID <> ProcessID then begin
          Result := True;
          Break;
        end;
        Proceed := Module32Next(hSnap, ModuleEntry);
      end;
      CloseHandle(hSnap);
    end;
  end;

  function CheckThreadOwnerProcessID(ProcessID:DWORD):Boolean;
  var
    hSnap:THandle;
    ThreadEntry:TThreadEntry32;
    Proceed:Boolean;
  begin
    Result := False;
    hSnap := CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, ProcessID);
    if hSnap <> INVALID_HANDLE_VALUE then begin
      ThreadEntry.dwSize := SizeOf(TThreadEntry32);
      Proceed := Thread32First(hSnap, ThreadEntry);
      while Proceed do begin
        if ThreadEntry.th32OwnerProcessID <> ProcessID then begin
          Result := True;
          Break;
        end;
        Proceed := Thread32Next(hSnap, ThreadEntry);
      end;
      CloseHandle(hSnap);
    end;
  end;

var
  I:Integer;
  hSnap:THandle;
  ProcessEntry:TProcessEntry32;
  Proceed:Boolean;
  sExeName:string;
begin
  sExeName := Application.ExeName;
  // showmessage(sExeName);
  hSnap := CreateToolhelp32Snapshot(TH32CS_SNAPALL, 0); // 创建系统快照
  if hSnap <> INVALID_HANDLE_VALUE then begin
    ProcessEntry.dwSize := SizeOf(TProcessEntry32); // 先初始化 FProcessEntry32 的大小
    Proceed := Process32First(hSnap, ProcessEntry);
    while Proceed do begin
      ModuleList.Clear;
      with ProcessEntry do begin
        // if CompareText(sExeName, StrPas(szEXEFile)) = 0 then begin
        // SelfProcessEntry := ProcessEntry;
        GetSelfModules(Th32ProcessID, ModuleList);
      end;
      // showmessage('ok');
      // Break;
   // end;
      if ModuleList.Count > 0 then begin
        for I := 0 to ModuleList.Count - 1 do begin
          if CompareText(sExeName, ModuleList.Strings[I]) = 0 then begin
            SelfProcessEntry := ProcessEntry;
            break;
          end;
        end;
      end;
      Proceed := Process32Next(hSnap, ProcessEntry);
    end;
    CloseHandle(hSnap);
  end;
end;

function TfrmMain.GetSelfModules(ProcessID:DWORD; ModuleList:TStringList):Boolean;
var
  hSnap:THandle;
  ModuleEntry:TModuleEntry32;
  Proceed:Boolean;
begin
  Result := False;
  hSnap := CreateToolhelp32Snapshot(TH32CS_SNAPMODULE, ProcessID);
  if hSnap <> INVALID_HANDLE_VALUE then begin
    ModuleEntry.dwSize := SizeOf(TModuleEntry32);
    Proceed := Module32First(hSnap, ModuleEntry);
    while Proceed do begin
      ModuleList.Add(LowerCase(ExpandFileName(StrPas(ModuleEntry.szExePath))));
      Proceed := Module32Next(hSnap, ModuleEntry);
    end;
    CloseHandle(hSnap);
  end;
end;

procedure TfrmMain.DrawScreenEffect(boDrawTopmost:Boolean);
var
  ScreenEffectInfo:pTScreenEffectInfo;
  Images:TGameImages;
  d:TTexture;
  I, nX, nY:Integer;
  FireMyselfX, FireMyselfY, shx, shy:Integer;
  LockObj:Int64;
  LockkActor:TActor;
begin
  if g_MySelf = nil then
    Exit;
  I := 0;
  while True do begin
    if I >= ScreenEffectList.Count then
      break;
    ScreenEffectInfo := ScreenEffectList.Items[I];

    if ScreenEffectInfo.boDrawTopmost <> boDrawTopmost then begin
      Inc(I);
      Continue;
    end;

    LockObj := ScreenEffectInfo.LockObject;
    LockkActor := PlayScene.FindActor(LockObj);

    if LockkActor <> nil then begin
      FireMyselfX := LockkActor.m_nRx * UNITX + LockkActor.m_nShiftX;
      FireMyselfY := LockkActor.m_nRy * UNITY + LockkActor.m_nShiftY;
      shx := (g_MySelf.m_nRx * UNITX + g_MySelf.m_nShiftX) - FireMyselfX;
      shy := (g_MySelf.m_nRy * UNITY + g_MySelf.m_nShiftY) - FireMyselfY;

      if MyGetTickCount - ScreenEffectInfo.dwFrameTimeTick > ScreenEffectInfo.wFrameTime then begin
        ScreenEffectInfo.dwFrameTimeTick := MyGetTickCount;
        Inc(ScreenEffectInfo.nCurrentFrame);
        if ScreenEffectInfo.nCurrentFrame >= ScreenEffectInfo.wImageCount then begin
          ScreenEffectInfo.nCurrentFrame := 0;
          if ScreenEffectInfo.nLoopCount > 0 then begin
            Dec(ScreenEffectInfo.nLoopCount);
            if ScreenEffectInfo.nLoopCount <= 0 then begin
              ScreenEffectList.Delete(I);
              Dispose(ScreenEffectInfo);
              Continue;
            end;
          end;
        end;
      end;

      if (ScreenEffectInfo.nFileIndex >= 0) and (ScreenEffectInfo.nFileIndex < g_EffectImageList.Count) then begin
        Images := TGameImages(g_EffectImageList.Objects[ScreenEffectInfo.nFileIndex]);
        if Images <> nil then begin
          if (g_MySelf <> nil) and g_MySelf.m_boDeath then
            d := Images.GetCachedGrayImage(ScreenEffectInfo.nImageIndex + ScreenEffectInfo.nCurrentFrame, nX, nY)
          else
            d := Images.GetCachedImage(ScreenEffectInfo.nImageIndex + ScreenEffectInfo.nCurrentFrame, nX, nY);
          if d <> nil then begin
            if ScreenEffectInfo.boBlend then
              { GameCanvas.DrawBlend(
                 ScreenEffectInfo.nX - nX,
                 ScreenEffectInfo.nY - nY,
                 d)    }
              GameCanvas.DrawBlend(ScreenEffectInfo.nX + nX - UNITX div 2 - shx, ScreenEffectInfo.nY + nY - UNITY div 2 - shy, d)
            else
              GameCanvas.Draw(ScreenEffectInfo.nX + nX - UNITX div 2 - shx, ScreenEffectInfo.nY + nY - UNITY div 2 - shy, d);
          end;
        end;
      end;
    end;
    Inc(I);
  end;
end;

procedure TfrmMain.ClientFeatureChanged(Actor:TActor; sData:string);
var
  nFeature:Integer;
begin
  case Actor.m_btRace of
    RC_PLAYOBJECT, RC_HEROOBJECT:begin
        nFeature := g_nHumFeature;
        Actor.m_Feature.Feature := SizeOf(THumFeature);
      end;
    else begin
        nFeature := g_nMonFeature;
        Actor.m_Feature.Feature := SizeOf(TMonFeature);
      end;
  end;
  if nFeature <= Length(sData) then begin
    DecodeString(sData, @Actor.m_Feature.Buffer, Actor.m_Feature.Feature);
    Actor.FeatureChanged;
  end;
end;

