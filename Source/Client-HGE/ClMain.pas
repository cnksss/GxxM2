procedure TfrmMain.ProcessMessageViewSellPlayerFengHao(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  Index:Integer;
  cu:TClientItem;
  OutBuf:PAnsiChar;
  OutBufSize:Integer;
  Buffer:PChar;
  ClientItem:PTClientItem;
begin
  g_SellPlayerFengHaoItems.Lock;
  try
    for I := 0 to g_SellPlayerFengHaoItems.Count - 1 do begin
      Dispose(PTClientItem(g_SellPlayerFengHaoItems.Items[I]));
    end;
    g_SellPlayerFengHaoItems.Clear;

    {$IF TESTMODE = 1}
    DScreen.AddChatBoardString('收到称号.', clRed, clBlack);
    {$IFEND}

    if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
      OutBufSize := DefMsg.Series * (SizeOf(TClientItem) + 1) + 1;

      try
        GetMem(OutBuf, OutBufSize);
      except
        on E:Exception do begin
          DebugOutStr('[Exception] ProcessMessageSendUserStateFengHao');
          DebugOutStr(E.Message);
          Exit;
        end;
      end;

      try
        g_SellPlayerActiveFengHaoIndex := DefMsg.Recog;

        zLibDecompressString(sData, OutBuf, OutBufSize);
        Buffer := OutBuf;

        for I := 0 to DefMsg.Series - 1 do begin
          Index := Ord(Buffer^);
          Inc(Buffer);
          Move(Buffer^, cu, SizeOf(TClientItem));
          Buffer := Buffer + SizeOf(TClientItem);
          if Index in [Low(THumanFengHaoItems)..High(THumanFengHaoItems)] then begin
            New(ClientItem);
            FillChar(ClientItem^, SizeOf(TClientItem), 0);
            ClientItem^ := cu;
            g_SellPlayerFengHaoItems.Add(ClientItem)
          end;
        end;
      finally
        FreeMem(OutBuf, OutBufSize);
      end;
    end;
  finally
    g_SellPlayerFengHaoItems.UnLock;
  end;
end;

