procedure TfrmMain.SendMerchantDlgSelect(merchant:Int64; rstr:string);
type
  TMerchantDlgSelectFunc = procedure(DefMsg:pTDefaultMessage; lpData:PChar; InDataLen:Integer; var IsHooked:BOOL); stdcall;
var
  Msg:TDefaultMessage;
  param:string;
  sMsg, sLabel:string;
  I, Index:Integer;
  LowerS:string;
  IsHooked:BOOL;
  MerchantDlgSelectFunc:TMerchantDlgSelectFunc;
begin
  {$IF TESTMODE_LOG = 1}
  // 输出日志模式不让点击npc 2020-02-13 23:00:32
  {$ELSE}
  if Length(rstr) >= 2 then begin
    if (rstr[1] = '@') and (rstr[2] = '@') then begin
      LowerS := LowerCase(rstr);

      if SameText(rstr, '@@dealybme') then begin
        FrmDlg.OpenDGameGoldDealDlg;
        Exit;
      end else begin
        if SameText(rstr, '@@buildguildnow') then begin
          FrmDlg.DMessageDlg(DecodeResStr(SInputGuildName), [mbOk, mbAbort])
        end else if Pos('@@inputstring', LowerS) > 0 then begin
          sMsg := rstr;
          sMsg := ArrestStringEx(sMsg, '(', ')', sLabel);
          if sLabel <> '' then begin
            FrmDlg.DMessageDlg(sLabel, [mbOk, mbAbort]);

            Index := Pos('(', rstr);
            if Index > 0 then begin
              rstr := Copy(rstr, 1, Index - 1);
            end;
          end else begin
            FrmDlg.DMessageDlg(DecodeResStr(SInputInfo), [mbOk, mbAbort]);
          end;

          if (Trim(FrmDlg.DlgEditText) = '') then begin
            FrmDlg.DMessageDlg(DecodeResStr(SInputEmpty), [mbOk]);
            Exit;
          end;

          if GetInputBoxInFilterList(FrmDlg.DlgEditText) then begin
            FrmDlg.DMessageDlg(DecodeResStr(SInputNumFilter), [mbOk]);
            Exit;
          end;
        end else if Pos('@@inputinteger', LowerS) > 0 then begin
          sMsg := rstr;
          sMsg := ArrestStringEx(sMsg, '(', ')', sLabel);
          if sLabel <> '' then begin
            FrmDlg.DMessageDlg(sLabel, [mbOk, mbAbort]);
            Index := Pos('(', rstr);
            if Index > 0 then begin
              rstr := Copy(rstr, 1, Index - 1);
            end;
          end else begin
            FrmDlg.DMessageDlg(DecodeResStr(SInputInfo), [mbOk, mbAbort]);
          end;

          if (Trim(FrmDlg.DlgEditText) = '') then begin
            FrmDlg.DMessageDlg(DecodeResStr(SInputEmpty), [mbOk]);
            Exit;
          end;

          for I := 1 to length(FrmDlg.DlgEditText) do begin
            if not (FrmDlg.DlgEditText[I] in ['0'..'9']) then begin
              FrmDlg.DMessageDlg(DecodeResStr(SInputNumFilter), [mbOk]);
              Exit;
            end;
          end;

          if (StrToInt64Def(FrmDlg.DlgEditText, 0) > 2147483646) then begin
            FrmDlg.DMessageDlg(DecodeResStr(SInputNumOutRange), [mbOk]);
            Exit;
          end;
        end else if Pos('@@copytoclipboard', LowerS) > 0 then begin //增加复制到剪粘板功能 2019-12-26
          {$I VMProtectBegin.inc}
          sMsg := rstr;
          sMsg := ArrestStringEx(sMsg, '(', ')', sLabel);
          if sLabel <> '' then begin
            SetClipboardText(sLabel);
            Index := Pos('(', rstr);
            if Index > 0 then begin
              rstr := Copy(rstr, 1, Index - 1);
            end;

            IsHooked := False;
            Msg := MakeDefaultMsg(CM_MERCHANTDLGSELECT, merchant, 0, 0, 0);

            {$IF AntiPlugInMemory = 1}
            if g_AntiPlugDllMemoryModule <> nil then begin
              MerchantDlgSelectFunc := MemoryGetProcAddress(g_AntiPlugDllMemoryModule, 1736); // 'MerchantDlgSelectFunc'
              if Assigned(MerchantDlgSelectFunc) then begin
                try
                  MerchantDlgSelectFunc(@Msg, PChar(rstr), Length(rstr), IsHooked);
                except
                  on E:Exception do begin
                    DebugOutStr('[Exception] MerchantDlgSelectFunc 1, Label: ' + rstr);
                    DebugOutStr(E.Message);
                  end;
                end;
              end;
            end;
            {$ELSE}
            if g_AntiPlugDllModule <> 0 then begin
              MerchantDlgSelectFunc := GetProcAddress(g_AntiPlugDllModule, Pointer(1736)); // 'MerchantDlgSelectFunc'
              if Assigned(MerchantDlgSelectFunc) then begin
                MerchantDlgSelectFunc(@Msg, PChar(rstr), Length(rstr), IsHooked);
              end;
            end;
            {$IFEND}

            if not IsHooked then begin
              SendSocket(EncodeMessage(Msg) + EncodeString(rstr));
            end;
          end;
          {$I VMProtectEnd.inc}
          Exit;
        end else begin
          sMsg := rstr;
          sMsg := ArrestStringEx(sMsg, '(', ')', sLabel);
          if sLabel <> '' then
            FrmDlg.DMessageDlg(sLabel, [mbOk, mbAbort])
          else
            FrmDlg.DMessageDlg(DecodeResStr(SInputInfo), [mbOk, mbAbort]);
        end;
        param := Trim(FrmDlg.DlgEditText);
        rstr := rstr + #13 + param;
      end;
    end;
  end;

  {$I VMProtectBegin.inc}
  IsHooked := False;
  Msg := MakeDefaultMsg(CM_MERCHANTDLGSELECT, merchant, 0, 0, 0);

  {$IF AntiPlugInMemory = 1}
  if g_AntiPlugDllMemoryModule <> nil then begin
    MerchantDlgSelectFunc := MemoryGetProcAddress(g_AntiPlugDllMemoryModule, 1736); // 'MerchantDlgSelectFunc'
    if Assigned(MerchantDlgSelectFunc) then begin
      try
        MerchantDlgSelectFunc(@Msg, PChar(rstr), Length(rstr), IsHooked);
      except
        on E:Exception do begin
          DebugOutStr('[Exception] MerchantDlgSelectFunc 2, Label: ' + rstr);
          DebugOutStr(E.Message);
        end;
      end;
    end;
  end;
  {$ELSE}
  if g_AntiPlugDllModule <> 0 then begin
    MerchantDlgSelectFunc := GetProcAddress(g_AntiPlugDllModule, Pointer(1736)); // 'MerchantDlgSelectFunc'
    if Assigned(MerchantDlgSelectFunc) then begin
      MerchantDlgSelectFunc(@Msg, PChar(rstr), Length(rstr), IsHooked);
    end;
  end;
  {$IFEND}

  if not IsHooked then begin
    SendSocket(EncodeMessage(Msg) + EncodeString(rstr));
  end;
  {$I VMProtectEnd.inc}
  {$IFEND}
end;

