  if (DefMsg.Series = 0) or ((Length(sData) > 0) and (DefMsg.Recog = Length(sData))) and (DefMsg.Param = Length(g_CustomItemPropertyChecks)) then begin
    g_CustomItemPropertyCRC := BufferCrc(PChar(sData), Length(sData));

    S := zLibDecompressString(sData);
    Move(S[1], g_CustomItemPropertyChecks[1], SizeOf(g_CustomItemPropertyChecks));

    StringList := TStringList.Create;
    try
      StringList.Text := Copy(S, SizeOf(g_CustomItemPropertyChecks) + 1, MaxInt);

      if StringList.Count >= Length(g_CustomItemPropertyBindNames) then begin
        for I := 0 to Length(g_CustomItemPropertyBindNames) - 1 do begin
          g_CustomItemPropertyBindNames[I + 1] := StringList.Strings[I];
        end;
      end;

    finally
      StringList.Free;
    end;
  end;

  if DefMsg.Series > 0 then begin
    g_nShowClientDataFileProgress := DefMsg.Series;
    RenderEvent(Self);
    Application.ProcessMessages;
