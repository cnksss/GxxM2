procedure TfrmMain.ProcessMessageSendOpenGuardianLevelDlg(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  nIndex:Integer;
  Str:string;
  StdItem:TStdItem;
begin
  FillChar(FrmDlg.FGuardianLevelRewardItems, SizeOf(FrmDlg.FGuardianLevelRewardItems), 0);
  FrmDlg.OpenGameLevelDlg(DefMsg.Recog, DefMsg.Param);

  nIndex := 0;
  while True do begin
    if sData = '' then
      Break;
    sData := GetValidStr3_Ex(sData, Str, '/');
    if Str = '' then
      break;

    DecodeString(Str, @StdItem, SizeOf(TStdItem));
    FrmDlg.FGuardianLevelRewardItems[nIndex].S := StdItem;
    FrmDlg.FGuardianLevelRewardItems[nIndex].Dura := StdItem.DuraMax;
    FrmDlg.FGuardianLevelRewardItems[nIndex].DuraMax := StdItem.DuraMax;
    Inc(nIndex);
    if nIndex > High(FrmDlg.FGuardianLevelRewardItems) then
      Break;
  end;
end;

