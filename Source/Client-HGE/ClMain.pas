procedure TfrmMain.AutoFindPathTimerTimer(Sender:TObject);
var
  I:Integer;
  IsRun3Grid:Boolean;
  dwCurrentTick:DWORD;
begin
  if g_MySelf = nil then begin
      LegendMap.Stop;
      Exit;
  end;

  if (g_MySelf <> nil) and g_MySelf.m_boDeath then begin
      LegendMap.Stop;
      Exit;
  end;

  // 自动挂机时不让这里寻路 chongchong 2015-09-04
  if g_boGJRun then Exit;

  if (LegendMap.EndX > 0) and (LegendMap.EndY > 0) then begin
    if (abs(g_MySelf.m_nCurrX - LegendMap.EndX) <= 1) and (abs(g_MySelf.m_nCurrY - LegendMap.EndY) <= 1) then begin
        DScreen.AddChatBoardString(Format(DecodeResStr(SPathGotoXYOK), [LegendMap.EndX, LegendMap.EndY]), GetRGB(154), clWhite);
        SendClientMessage(CM_AUTOFINDPATHINFO, 0, 0, 0, 3, '');
        LegendMap.Stop;
    end else begin
      dwCurrentTick := MyGetTickCount;
      if dwCurrentTick - g_dwAutoFindPathTick >= 15{100} then begin   //HZQ 20230704 优化自动寻路间隔, 原100间隔有明显卡顿
          g_dwAutoFindPathTick := MyGetTickCount;
      end else begin
          Exit;
      end;  

      if LegendMap.StartFind then Exit; //HZQ 20230704 StartFind是一个内部标志，表示正在操作寻路数组

      if (Length(LegendMap.RunPath) <= 0) and (not LegendMap.StartFind) and (LegendMap.FindCount = 0) then begin
        LegendMap.Find(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, LegendMap.EndX, LegendMap.EndY);
        Exit;
      end;

      if LegendMap.StartFind then Exit;


      if Length(LegendMap.RunPath) <= 0 then begin
        DScreen.AddChatBoardString(Format(DecodeResStr(SPathGotoXYFail), [LegendMap.EndX, LegendMap.EndY]), GetRGB(154), clWhite);
        SendClientMessage(CM_AUTOFINDPATHINFO, 0, 0, 0, 2, '');
        LegendMap.Stop;
      end else begin
        // 如果寻好了路发现上马/下马，重新寻一次吧 2020-11-27 11:46:19
        IsRun3Grid := (g_MySelf.m_btHorse <> 0) and g_ClientConfig.boHorseRun3Grid;
        if IsRun3Grid <> LegendMap.IsRun3Grid then begin
          if not (g_ChrAction in [caWalk, caRun, caHorseRun]) then begin
            LegendMap.Find(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, LegendMap.EndX, LegendMap.EndY);
          end;
          Exit;
        end;

        for I := LegendMap.PathPoisonIndex to Length(LegendMap.RunPath) - 1 do begin
          if (g_MySelf.m_nCurrX <> LegendMap.RunPath[I].X) or (g_MySelf.m_nCurrY <> LegendMap.RunPath[I].Y) then begin
            if (abs(g_MySelf.m_nCurrX - LegendMap.RunPath[I].X) <= 1) and (abs(g_MySelf.m_nCurrY - LegendMap.RunPath[I].Y) <= 1) then begin
              // if (not CheckCanRun(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y)) and (CheckCanWalk(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y)) then begin
              if PlayScene.CanWalk(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y) then begin
                g_ChrAction := caWalk;
                g_nTargetX := LegendMap.RunPath[I].X;
                g_nTargetY := LegendMap.RunPath[I].Y;
                PlayScene.ScreenXYfromMCXY(g_nTargetX, g_nTargetY, g_nMoveMouseX, g_nMoveMouseY);
                LegendMap.PathPoisonIndex := I;
                // Inc(g_nPathPoisonIndex);
                Exit;
              end else begin
                LegendMap.Find(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, LegendMap.EndX, LegendMap.EndY);
                LegendMap.PathPoisonIndex := 0;
                Exit;
                {if Length(LegendMap.RunPath) <= 0 then begin
                  DScreen.AddChatBoardString(Format('自动移动坐标点(%d:%d)不可到达', [LegendMap.EndX, LegendMap.EndY]), GetRGB(154), clWhite);
                  LegendMap.Stop;
                end;
                Exit; }
              end;
            end else begin
              if PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y) then begin
                if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
                  g_ChrAction := caWalk
                else begin
                  // if CheckCanRun(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y) then
                  g_ChrAction := caRun;
                  //DScreen.AddChatBoardString('g_ChrAction 7', clGreen, clWhite);
                end;
                g_nTargetX := LegendMap.RunPath[I].X;
                g_nTargetY := LegendMap.RunPath[I].Y;
                PlayScene.ScreenXYfromMCXY(g_nTargetX, g_nTargetY, g_nMoveMouseX, g_nMoveMouseY);
                LegendMap.PathPoisonIndex := I;
                // Inc(g_nPathPoisonIndex);
                Exit;
              end else begin
                LegendMap.Find(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, LegendMap.EndX, LegendMap.EndY);
                LegendMap.PathPoisonIndex := 0;
                {if Length(LegendMap.RunPath) <= 0 then begin
                  DScreen.AddChatBoardString(Format('自动移动坐标点(%d:%d)不可到达', [LegendMap.EndX, LegendMap.EndY]), GetRGB(154), clWhite);
                  LegendMap.Stop;
                end;  }
                Exit;
              end;
            end;
          end;
        end;
      end; 
    end;
  end;
end;

