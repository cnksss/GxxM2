procedure TfrmMain.ProcessMessageDigUp(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  MessageBodyWL:pTMessageBodyWL;
  Feature:TFeature;
  Actor:TActor;
begin
  // DScreen.AddChatBoardString('ProcessMessageDigUp dir 1 :' + IntToStr(LoByte(DefMsg.series)),  clRed, clWhite);
  if Length(sData) >= SizeOf(TMessageBodyWL) then begin
    MessageBodyWL := PTMessageBodyWL(sData);

    if Length(sData) = SizeOf(TMessageBodyWL) + MessageBodyWL.lParam1 then begin
      Feature.Feature := MessageBodyWL.lParam1;
      Move(sData[1 + SizeOf(TMessageBodyWL)], Feature.Buffer[0], Feature.Feature);

      Actor := PlayScene.FindActor(DefMsg.Recog);
      if Actor = nil then
        Actor := PlayScene.NewActor(DefMsg.Recog, DefMsg.param, DefMsg.tag, DefMsg.series, Feature {MessageBodyWL.lParam1}, MessageBodyWL.lParam2)
      else
        Actor.m_nState := MessageBodyWL.lParam2;

      if Actor <> nil then begin
        // DScreen.AddChatBoardString('ProcessMessageDigUp dir 2 :' + IntToStr(LoByte(DefMsg.series))+' m_boDeath:'+booltostr(Actor.m_boDeath),  clRed, clWhite);
        Actor.m_nCurrentEvent := MessageBodyWL.lTag1;
        Actor.SendMsg(DefMsg.ident, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir + light}, Feature, MessageBodyWL.lParam2, '', 0);
      end;
    end;
  end;
end;

