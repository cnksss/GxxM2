procedure TfrmMain.AttackTarget(target:TActor; IsAutoAttack:Boolean {是否自动攻击});
var
  tdir, dx, dy, nHitMsg, CustomMagiID, II:Integer;
  boCanAttack:Boolean;
  EffectLevel:Integer;
  ClientMagic:PTClientMagic;
  MagicID:Integer;
  IsLongHit:Boolean;
  PlugData:TAntiPlugNotifyEventHitData;
label
  NORMAL_ATTACK;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode_M.inc}
  {$IFEND}
  // 修改测试chonchong 2016-12-09

  IsLongHit := False; //HZQ 20230523

  if CanNextAction(caHit) and ServerAcceptNextAction(True) {and (MyGetTickCount - g_dwLatestRushRushTick > 2000)} then begin
    //if MyGetTickCount - g_dwLatestHitTick >= 560 then
    if (target <> nil) and (not target.m_boDeath) then begin
      if g_ClientConfig.btConfigDlgType = 1 then begin
        if TJSYConfigDlg(g_ConfigDlg).AutoUseMagic then
          Exit;
      end;

      //if g_UseItems[U_WEAPON].S.StdMode = 6 then nHitMsg := CM_HEAVYHIT;
      tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, target.m_nCurrX, target.m_nCurrY);

      if target.m_btRealRace in [RC_BOX, RC_BOX2] then begin
        if (abs(g_MySelf.m_nCurrX - target.m_nCurrX) <= _MAX(target.m_Abil.Level, 1))
          and (abs(g_MySelf.m_nCurrY - target.m_nCurrY) <= _MAX(target.m_Abil.Level, 1)) and (not target.m_boDeath) then begin
          if CanNextAction and ServerAcceptNextAction(False) and (tdir <> g_MySelf.m_btDir) then begin
            g_MySelf.SendMsg(CM_TURN, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, 0, '', 0);
          end else if CanNextAction and ServerAcceptNextAction(False) then begin
            g_TargetCret := nil;
            SendClientMessage(CM_CLICKBOX, target.m_nRecogId, 1, 0, 0);
          end;
        end else begin
          if (abs(g_MySelf.m_nCurrX - target.m_nCurrX) <= 2) and (abs(g_MySelf.m_nCurrY - target.m_nCurrY) <= 2) and (not target.m_boDeath) then
            g_ChrAction := caWalk
          else
            g_ChrAction := caRun; //跑步砍
          GetBackPosition(target.m_nCurrX, target.m_nCurrY, tdir, dx, dy);
          g_nTargetX := dx;
          g_nTargetY := dy;
        end;
        Exit;
      end;
      nHitMsg := SearchHitMsg(tdir, target);

      g_LockTarget := target;
      g_dwLockTargetTick := MyGetTickCount;

      // function TfrmMain.TargetInSwordLongAttackRange(ndir: Integer; target: TActor; nRange: Integer): Boolean;
      // nRange = 1 检测在1格的位置是否可以攻击到
      // nRange = 2 检测在1~2格的位置是否可以攻击到
      // nRange = 3 检测在2格的位置是否可以攻击到
      if (not IsInContinuous {g_boContinuous} {不在连击状态}) then begin
        IsLongHit := nHitMsg = CM_LONGHIT;
        if not IsLongHit then begin
          for II := 0 to Length(g_AutoCustomMagic[mngoLongHit]) - 1 do begin
            CustomMagiID := g_AutoCustomMagic[mngoLongHit][II];

            if CheckIsCustomMagic(CustomMagiID) then begin
              IsLongHit := (nHitMsg = (CustomMagiID - CUSTOM_MAGIC_START_ID + CM_CUSTOM_HIT001));
              if IsLongHit then
                Break;
            end;
          end;              
        end;

        if PlugInEnabled and g_ClientConfig.boSmartWalkLongHit and g_ConfigDlg.ConfigCheckeds[ckSmartWalkLongHit]
          and IsLongHit then begin // 走位刺杀
          // ((abs(g_MySelf.m_nCurrX - target.m_nCurrX) <> 2) or (abs(g_MySelf.m_nCurrY - target.m_nCurrY) <> 2)){(not TargetInSwordLongAttackRange(tdir, target, 3))} then begin //走位刺杀
          // DScreen.AddChatBoardString('boSmartWalkLongHit 1 ' + Format('X:%d Y:%d X:%d Y:%d', [g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, target.m_nCurrX, target.m_nCurrY]), clGreen, clWhite);

          if TargetInSwordLongAttackRange(tdir, target, 3) or g_boGJRun then begin
            // DScreen.AddChatBoardString('boSmartWalkLongHit 2 ' + Format('X:%d Y:%d X:%d Y:%d', [g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, target.m_nCurrX, target.m_nCurrY]), clGreen, clWhite);
            if CanNextHit then begin
              if nHitMsg = CM_LONGHIT then begin
                ClientMagic := FindMagic(12)
              end else begin
                ClientMagic := FindMagic(nHitMsg - CM_CUSTOM_HIT001 + CUSTOM_MAGIC_START_ID);
              end;

              if ClientMagic <> nil then begin
                g_boLatestSpell := True;
                g_dwMagicDelayTime := g_MySelf.UseMagicDelayTime(ClientMagic.Def.dwMagicDelayTime);
                ClientMagic.dwLastUseTick := MyGetTickCount;
              end;

              g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, GetHitEffectLevel(nHitMsg), '', 0);
              g_dwLatestHitTick := MyGetTickCount;
              CloseWarriorSkillAttack(nHitMsg);

              if Assigned(g_AntiPlugNotifyFunc) then begin
                PlugData.nDir := tdir;
                PlugData.cmMessage := nHitMsg;

                g_AntiPlugNotifyFunc(event_Hit, @PlugData, SizeOf(PlugData));
              end;
            end;
            Exit;
          end else begin
            if GetWalkLongHitXY(target.m_nCurrX, target.m_nCurrY, dx, dy) then begin
              g_nTargetX := dx;
              g_nTargetY := dy;

              if ((abs(g_MySelf.m_nCurrX - dx) <= 1) and (abs(g_MySelf.m_nCurrY - dy) <= 1))
                or g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then begin
                g_ChrAction := caWalk
              end else begin
                g_ChrAction := caRun;
                //DScreen.AddChatBoardString('debug___g_ChrAction 0', clGreen, clWhite);
              end;

              PlayScene.ScreenXYfromMCXY(g_nTargetX, g_nTargetY, g_nMoveMouseX, g_nMoveMouseY);
              g_LockTarget := target;
              g_dwLockTargetTick := MyGetTickCount;
              Exit;
            end;
          end;
        end else if ((nHitMsg = CM_LONGHIT) or IsLongHit) and PlugInEnabled and g_ClientConfig.boSmartPosLongHit
          and g_ConfigDlg.ConfigCheckeds[ckSmartPosLongHit] then begin // 隔位刺杀
          if TargetInSwordLongAttackRange(tdir, target, 2) then begin
            if CanNextHit then begin
              g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, GetHitEffectLevel(nHitMsg), '', 0);

              if Assigned(g_AntiPlugNotifyFunc) then begin
                PlugData.nDir := tdir;
                PlugData.cmMessage := nHitMsg;

                g_AntiPlugNotifyFunc(event_Hit, @PlugData, SizeOf(PlugData));
              end;

              if nHitMsg = CM_LONGHIT then begin
                ClientMagic := FindMagic(12);

                if ClientMagic <> nil then begin
                  g_boLatestSpell := True;
                  g_dwMagicDelayTime := g_MySelf.UseMagicDelayTime(ClientMagic.Def.dwMagicDelayTime);
                  ClientMagic.dwLastUseTick := MyGetTickCount;
                end;
                g_dwLatestHitTick := MyGetTickCount;
              end else begin
                ClientMagic := FindMagic(nHitMsg - CM_CUSTOM_HIT001 + CUSTOM_MAGIC_START_ID);

                if ClientMagic <> nil then begin
                  g_boLatestSpell := True;
                  g_dwMagicDelayTime := g_MySelf.UseMagicDelayTime(ClientMagic.Def.dwMagicDelayTime);
                  ClientMagic.dwLastUseTick := MyGetTickCount;
                end;
                g_dwLatestHitTick := MyGetTickCount;
              end;
            end;
            Exit;
          end;
        end;
      end;

      // DScreen.AddChatBoardString('AttackTarget 3', clGreen, clWhite);

      if g_boContinuous then begin // 连击
        if (nHitMsg > 0) and TargetInSwordLongAttackRange(tdir, target, 1) then begin
          if CanNextHit then begin
            if (nHitMsg = CM_100HIT) then begin // 追心刺
              // 修正追心刺按技能释放后攻击错位，因为UseMagic中没有把坐标还原为对象坐标chongchong 2015-05-20
              //PlayScene.ScreenXYfromMCXY(, target.m_nCurrY, nX, nY);
              UseMagic(target.m_nCurrX, target.m_nCurrY, @g_CurrContinuousMagic);
              Inc(g_nContinuousIndex);
              if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
                  DoFinishContinuous();
              end;
              Exit;
            end;
            g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, GetHitEffectLevel(nHitMsg), '', 0);
            g_dwLatestHitTick := MyGetTickCount;
            LastHitTick := timeGetTime;
            Inc(g_nContinuousIndex);
            if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
                DoFinishContinuous();
            end;               

            if Assigned(g_AntiPlugNotifyFunc) then begin
              PlugData.nDir := tdir;
              PlugData.cmMessage := nHitMsg;
              g_AntiPlugNotifyFunc(event_Hit, @PlugData, SizeOf(PlugData));
            end;
          end;
        end else begin
           if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
               DoFinishContinuous();
           end; 
           //HZQ 20230830 修改了连击索引后，后续的手段不需要了
           //HZQ 20230705 解决连击勾选后，触发连击技能后，不能继续挂机攻击的问题
           if CanNextHit then begin
              nHitMsg := CM_HIT;
              goto  NORMAL_ATTACK;
           end;            
        end;
      end else begin
        NORMAL_ATTACK:
        // if ((nHitMsg = CM_HIT) and TargetInSwordLongAttackRange(tdir, target, 1)) or (nHitMsg <> CM_HIT)  then begin
        case nHitMsg of
          CM_HIT:
            boCanAttack := TargetInSwordLongAttackRange(tdir, target, 1);
          CM_60HIT:
            boCanAttack := True; // 破魂
          CM_POWERHIT:
            boCanAttack := TargetInSwordLongAttackRange(tdir, target, 1); // TargetInSwordLongAttackRange(tdir, target, 1); //攻杀
          CM_FIREHIT:
            boCanAttack := TargetInSwordLongAttackRange(tdir, target, 1); // TargetInSwordLongAttackRange(tdir, target, 1); //烈火
          CM_SWORDHIT:
            boCanAttack := TargetInSkillSWordAttackRange(tdir, target); // 逐日剑法
          CM_66HIT, CM_66HIT1, CM_113HIT, CM_115HIT:
            boCanAttack := TargetInKTZAttackRange(tdir, target); // 开天斩重击、轻击
          CM_TWNHIT:
            boCanAttack := TargetInSwordLongAttackRange(tdir, target, 1) or TargetInSkill42AttackRange(tdir, target); // TargetInSwordLongAttackRange(tdir, target, 1) or TargetInSkill42AttackRange(tdir, target); //龙影剑法
          CM_43HIT:
            boCanAttack := TargetInSwordLongAttackRange(tdir, target, 1); // TargetInSwordLongAttackRange(tdir, target, 1); //雷霆剑法
          CM_CRSHIT:
            boCanAttack := TargetInSwordLongAttackRange(tdir, target, 1) or TargetInSwordCrsAttackRangeEx(tdir, target); // TargetInSwordLongAttackRange(tdir, target, 1) or TargetInSwordCrsAttackRange(tdir, target); //抱月
          CM_WIDEHIT:
            boCanAttack := TargetInSwordLongAttackRange(tdir, target, 1) or TargetInSwordWideAttackRangeEx(tdir, target); // 半月
          CM_LONGHIT:
            boCanAttack := TargetInSwordLongAttackRange(tdir, target, 2); // 刺杀
          else begin
              if IsLongHit then
                boCanAttack := TargetInSwordLongAttackRange(tdir, target, 2) // 新刺杀设置的也是2格·但是只要目标中间有其他可以攻击的他就不会移动到目标身边去 2020-05-12
              else
                boCanAttack := True;
            end;
        end;
        // DScreen.AddChatBoardString(Format('AttackTarget 1 %d %d', [abs(g_MySelf.m_nCurrX - target.m_nCurrX), abs(g_MySelf.m_nCurrY - target.m_nCurrY)]), clGreen, clWhite);
        if boCanAttack then begin
          // DScreen.AddChatBoardString('AttackTarget 2', clGreen, clWhite);
          if CanNextHit then begin
            EffectLevel := GetHitEffectLevel(nHitMsg);
            MagicID := 0;
            // 4级技能强化 -- 4级烈火 chongchong 2013-12-04
            // g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, EffectLevel, '', 0);
            if nHitMsg = CM_FIREHIT then begin
              g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, LoWord(EffectLevel), '', HiWord(EffectLevel));
              MagicID := 26;

              g_WarrContinueHitManager.UseMagic(26);

              if Assigned(g_AntiPlugNotifyFunc) then begin
                PlugData.nDir := tdir;
                PlugData.cmMessage := nHitMsg;

                g_AntiPlugNotifyFunc(event_Hit, @PlugData, SizeOf(PlugData));
              end;
            end else begin
              if nHitMsg = CM_POWERHIT then begin //攻杀
                MagicID := 7;
              end else if nHitMsg = CM_LONGHIT then begin //刺杀
                MagicID := 12;
              end else if nHitMsg = CM_WIDEHIT then begin // 半月弯刀
                MagicID := 25;
              end else if nHitMsg = CM_CRSHIT then begin // 双龙斩
                MagicID := 40;
              end else if nHitMsg = CM_TWNHIT then begin // 龙影
                MagicID := 42;
              end else if (nHitMsg = CM_66HIT) or (nHitMsg = CM_66HIT1) then begin // 开天斩
                MagicID := 66;
              end else if (nHitMsg = CM_113HIT) then begin // 断空斩
                MagicID := 113;
              end else if (nHitMsg = CM_113HIT) then begin // 血魄一击 战
                MagicID := 113;
              end else if (nHitMsg = CM_43HIT) then begin // 雷霆剑法
                MagicID := 43;
              end else if (nHitMsg = CM_SWORDHIT) then begin // 逐日剑法
                MagicID := 56;
              end else if (nHitMsg >= CM_CUSTOM_HIT001) and (nHitMsg < CM_CUSTOM_HIT001 + CUSTOM_MAGIC_COUNT) then begin
                MagicID := nHitMsg - CM_CUSTOM_HIT001 + CUSTOM_MAGIC_START_ID;
              end;

              {$IF TESTMODE = 1}
              if MagicID > 0 then begin
                //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~使用技能.' + IntToStr(MagicID), clRed, clBlack);
              end;
              {$IFEND}

              g_WarrContinueHitManager.UseMagic(MagicID);

              g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, EffectLevel, '', 0);

              if Assigned(g_AntiPlugNotifyFunc) then begin
                PlugData.nDir := tdir;
                PlugData.cmMessage := nHitMsg;
                g_AntiPlugNotifyFunc(event_Hit, @PlugData, SizeOf(PlugData));
              end;
            end;

            if MagicID > 0 then begin
              ClientMagic := FindMagic(MagicID);
              if (ClientMagic <> nil) then begin
                g_boLatestSpell := True;
                if (MagicID <> 26) or (not g_ClientConfig.boEnableDoubleFireHitSkill) then begin
                  g_dwMagicDelayTime := g_MySelf.UseMagicDelayTime(ClientMagic.Def.dwMagicDelayTime);
                  ClientMagic.dwLastUseTick := MyGetTickCount;
                end;
              end;
            end;

            g_dwLatestHitTick := MyGetTickCount;
            CloseWarriorSkillAttack(nHitMsg);
          end;
          Exit;
        end;
      end;


      // HZQ 20230523 根据代码愿意，移动代码到此处，以消除变量未定义及target可能为空造成的程序崩溃
      if (not target.m_boDeath) then begin
        GetBackPosition(target.m_nCurrX, target.m_nCurrY, tdir, dx, dy);
        g_nTargetX := dx;
        g_nTargetY := dy;
        PlayScene.ScreenXYfromMCXY(g_nTargetX, g_nTargetY, g_nMoveMouseX, g_nMoveMouseY);

        // DScreen.AddChatBoardString(Format('AttackTarget  m_nCurrX:%d m_nCurrY:%d TargetX:%d TargetY:%d MoveX:%d MoveY:%d',
         // [g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, target.m_nCurrX, target.m_nCurrY, g_nTargetX, g_nTargetY]), clGreen, clWhite);

        if ((abs(g_MySelf.m_nCurrX - g_nTargetX) <= 1) and (abs(g_MySelf.m_nCurrY - g_nTargetY) <= 1))
          or g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then begin
          g_ChrAction := caWalk;//caWalk; 20230705
        end else begin
          g_ChrAction := caRun; // 跑步砍
          //DScreen.AddChatBoardString('debug___g_ChrAction 2', clGreen, clWhite);
        end;
        // Exit;
      end; 
    end;

    (*
    //根据代码意思，这段应该移动到 if (target <> nil) and (not target.m_boDeath) then begin中才合理
    if (target <> nil) and (not target.m_boDeath) then begin
      GetBackPosition(target.m_nCurrX, target.m_nCurrY, tdir, dx, dy);
      g_nTargetX := dx;
      g_nTargetY := dy;
      PlayScene.ScreenXYfromMCXY(g_nTargetX, g_nTargetY, g_nMoveMouseX, g_nMoveMouseY);

      // DScreen.AddChatBoardString(Format('AttackTarget  m_nCurrX:%d m_nCurrY:%d TargetX:%d TargetY:%d MoveX:%d MoveY:%d',
       // [g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, target.m_nCurrX, target.m_nCurrY, g_nTargetX, g_nTargetY]), clGreen, clWhite);

      if ((abs(g_MySelf.m_nCurrX - g_nTargetX) <= 1) and (abs(g_MySelf.m_nCurrY - g_nTargetY) <= 1))
      or g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then begin
        g_ChrAction := caWalk
      end else begin
        g_ChrAction := caRun; // 跑步砍
        //DScreen.AddChatBoardString('debug___g_ChrAction 2', clGreen, clWhite);
      end;
      // Exit;
    end; *)

  end;
end;

procedure TfrmMain._DXDrawMouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  tdir, nX, nY, nHitMsg, sel, II, MagicID, nSpellPoint:Integer;
  target:TActor;
  TempMagic, ClientMagic:PTClientMagic;
  CustomMagicConfig:PClientCustomMagicConfig;
  OldTargetCret:TActor;
  IsCheckNextMagic, IsOK:Boolean;
begin
  // GetCursorPos(pt);
  target := nil;
  ActionKey := 0;

  // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
  WaitUseActionKeyMagicID := 0;
  ExcludeWaitUseActionKeyMagicID := 0;

  g_nMouseX := X;
  g_nMouseY := Y;
  g_nMoveMouseX := X; // 鼠标所在屏幕位置座标X
  g_nMoveMouseY := Y; // 鼠标所在屏幕位置座标Y
  g_boAutoDig := False;
  if g_boMapMovingWait then begin
     //OutputDebugString('MapMovingWait');
     Exit;
  end;

  if (Button = mbRight) and g_boItemMoving then begin // 是否当前在移动物品
    g_DropMoveItemTick := MyGetTickCount;
    FrmDlg.CancelItemMoving;
    Exit;
  end;

  if (Button = mbRight) and g_boMagicMoving then begin // 是否当前在移动物品
    g_DropMoveItemTick := MyGetTickCount;
    FrmDlg.CancelMagicMoving;
    Exit;
  end;

  //if m_boMouseDownOnMiniMap and (FrmDlg.DMinMapDlg.MouseDowned) then Exit;

  if FrmDlg.DBackground.MouseDown(Button, Shift, X, Y) then begin
    if (not (FrmDlg.DMinMapDlg.Visible and (FrmDlg.DMinMapDlg.MouseDowned))) then begin
      Exit; // 鼠标移到窗口上了则跳过
    end;
  end;

  if Length(LegendMap.RunPath) > 0 then
    SendClientMessage(CM_AUTOFINDPATHINFO, 0, 0, 0, 2, '');
  LegendMap.Stop;

  if (g_MySelf = nil) or (DScreen.CurrentScene <> PlayScene) then
    Exit; // 如果人物退出则跳过

  PlayScene.CXYfromMouseXY(X, Y, g_nMouseCurrX, g_nMouseCurrY);

  if ssRight in Shift then begin // 鼠标右键
    FLastButchTargetRecogId := 0;
    FLastButchTargetDir := 0;

    if Shift = [ssRight] then Inc(g_nDupSelection);

    target := PlayScene.GetAttackFocusCharacter(X, Y, g_nDupSelection, sel, False); // 取指定坐标上的角色

    if g_nDupSelection <> sel then g_nDupSelection := 0;

    if target <> nil then begin
      if ssCtrl in Shift then begin // CTRL + 鼠标右键 = 显示角色的信息
        if TimeGetTime - g_dwLastMoveTick > 1000 then begin
          if (target.m_btRace in [0, 1]) and ((not target.m_boDeath) or target.m_boPlayMoster) then begin
            {
            // 取得人物信息
            g_USFengHaoItems.Lock;
            try
              for I := 0 to g_USFengHaoItems.Count - 1 do
              begin
                Dispose(PTClientItem(g_USFengHaoItems.Items[I]));
              end;
              g_USFengHaoItems.Clear;
            finally
              g_USFengHaoItems.UnLock;
            end;
            }
            {$IF TESTMODE = 1}
            DScreen.AddChatBoardString('清空称号.', clRed, clBlack);
            {$IFEND}

            SendClientMessage(CM_QUERYUSERSTATE, target.m_nRecogId, target.m_nCurrX, target.m_nCurrY, 0);
            Exit;
          end;
        end;
      end else if ssAlt in Shift then begin
          if GetKeyState(Integer('N')) < 0 then begin //HZQ 20230829新功能
              g_ConfigDlg.AddOrRemoveBossList(target.m_sUserName); //ALT + N + MouseRight
          end else begin
              FrmDlg.ShowChatEdit(); //HZQ 20230829 原功能
              FrmDlg.DEdChat.Text := '/' + target.m_sUserName;
          end;
          Exit;
      end;
    end else begin
      g_nDupSelection := 0;
    end;

    // 按鼠标右键，并且鼠标指向空位置
    if (g_nMoveCount <= 0) and (not g_MySelf.m_boShopStall {摆摊禁止移动}) and (g_MySelf.m_nState and $00080000 = 0) {冰冻状态}
    and (not g_MySelf.m_boForeverFrozen) then begin
      if (abs(g_MySelf.m_nCurrX - g_nMouseCurrX) <= 1) and (abs(g_MySelf.m_nCurrY - g_nMouseCurrY) <= 1) then begin
        Inc(g_nMoveCount);
        nX := X;
        nY := Y;
        tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);
        { TODO -c修复 -opiaoyun : ★★★★★ 修复转向灵活度1 【2013-6-9】 ★★★★★ }
        if (g_MySelf.m_MsgList.Count <= 0) and (g_MySelf.m_nCurrentAction = SM_TURN) then begin
          g_MySelf.ActionEnded;
          g_MySelf.m_nCurrentAction := 0;
          g_MySelf.m_boUseMagic := False;
        end;

        if CanNextAction and ServerAcceptNextAction(False) then begin
          g_MySelf.SendMsg(CM_TURN, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, 0, '', 0);
        end;
        // DScreen.AddChatBoardString('CM_TURN', clGreen, clWhite);
        Exit;
      end else begin
        tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);
        nX := g_MySelf.m_nCurrX;
        nY := g_MySelf.m_nCurrY;
        if ((abs(g_MySelf.m_nCurrX - g_nMouseCurrX) > 0) or (abs(g_MySelf.m_nCurrY - g_nMouseCurrY) > 0)) then begin
          Inc(g_nMoveCount);
          if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then begin
            GetNextPosXY(tdir, nX, nY);
            g_ChrAction := caWalk;
            g_nTargetX := nX;
            g_nTargetY := nY;
            // DScreen.AddChatBoardString('caRun 1', clGreen, clWhite);
          end {
            // 麻痹并只请允许走动 chongchong 2015-03-03
            else if (g_MySelf.m_nState and $04000000 <> 0) and
              g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and
              g_ClientConfig.boParalyCanWalk and (not g_ClientConfig.boParalyCanRun) then
            begin
              GetNextPosXY(tdir, nX, nY);
              g_ChrAction := caWalk;
              g_nTargetX := nX;
              g_nTargetY := nY;
            end
            }
          else begin
            // DScreen.AddChatBoardString('caRun 2', clGreen, clWhite);
            GetNextRunXY(tdir, nX, nY);
            if PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY) then begin
              g_ChrAction := caRun;
              //DScreen.AddChatBoardString('debug___g_ChrAction 3', clGreen, clWhite);
              g_nTargetX := nX;
              g_nTargetY := nY;
              // DScreen.AddChatBoardString('caRun 3', clGreen, clWhite);
              Exit;
            end;

            nX := g_MySelf.m_nCurrX;
            nY := g_MySelf.m_nCurrY;
            // GetNextPosXY(tdir, nX, nY);
            GetNextRunXY(tdir, nX, nY);
            g_ChrAction := caRun;
            //DScreen.AddChatBoardString('debug___g_ChrAction 4', clGreen, clWhite);
            g_nTargetX := nX;
            g_nTargetY := nY;

            // DScreen.AddChatBoardString('caRun 4', clGreen, clWhite);
            // DScreen.AddChatBoardString('caRun 1', clGreen, clWhite);
          end;
          // end;
          Exit;
        end;
      end;
    end;
    target := nil;
  end; // if ssRight in Shift then begin //鼠标右键

  OldTargetCret := g_TargetCret;
  try
    if (ssLeft in Shift) then begin
      FLastButchTargetRecogId := 0;
      FLastButchTargetDir := 0;

      if PlayScene.IsSelectMyself(X, Y) and (not g_MySelf.m_boDeath) and g_MySelf.m_boShopStall then begin
        if (MyGetTickCount - g_dwQueryBusinessTime > 500) and (not g_boMouseMoveDown) then begin
          g_dwQueryBusinessTime := MyGetTickCount;
          SendQuerySelectShopInfo(g_MySelf.m_sUserName, g_MySelf.m_nRecogId);
        end;
        Exit;
      end;

      target := PlayScene.GetAttackFocusCharacter(X, Y, g_nDupSelection, sel, True);
      if g_nDupSelection <> sel then
        g_nDupSelection := 0;

      if (not g_MySelf.m_boShopStall {摆摊禁止移动}) and (g_MySelf.m_nState and $00080000 = 0) {冰冻状态} then begin
        // PlayScene.CXYfromMouseXY(X, Y, g_nMouseCurrX, g_nMouseCurrY);
        {if g_TargetCret<>nil then begin
          PlayScene.ScreenXYfromMCXY(g_TargetCret.m_nCurrX, g_TargetCret.m_nCurrY, nX, nY);
          DScreen.AddChatBoardString(Format('g_TargetCret %d:%d %d:%d ', [X, Y, nX, nY]), clGreen, clWhite);
        end;}
        {$IF IsMultiThreadRender = 1}
        EnterCriticalSection(g_ActorLock);
        {$IFEND}
        g_TargetCret := nil;

        //DScreen.AddChatBoardString('cleartarget.....', clGreen, 0);
        // DScreen.AddChatBoardString('target:' + bOolTosTR(target <> nil), clGreen, clWhite);
        {$IF IsMultiThreadRender = 1}
        LeaveCriticalSection(g_ActorLock);
        {$IFEND}
        if (g_UseItems[U_WEAPON].S.Name <> '') and (target = nil) and (g_MySelf.m_btHorse = 0) and (not IsInContinuous {g_boContinuous} {不在连击状态}) and (g_MySelf.m_nChangeAppr < 0 {没有变身}) then begin
          // 挖矿
          if g_UseItems[U_WEAPON].S.Shape = 19 then begin // 鹤嘴锄
            tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);
            GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, nX, nY);
            if not Map.CanMove(nX, nY) or (ssShift in Shift) then begin // 不能移动或强行挖矿
              if CanNextAction(caHit) and ServerAcceptNextAction(True) and CanNextHit then begin
                g_MySelf.SendMsg(CM_HEAVYHIT, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, 0, '', 0);
                LastHitTick := timeGetTime;
                Inc(g_nMoveCount);
              end;
              g_boAutoDig := True;
              Exit;
            end;
          end;
        end;
      end;
    end; // if (ssLeft in Shift) then begin

    if (g_MySelf.m_btHorse = 0) {骑马状态不可以操作} and (not g_MySelf.m_boShopStall {摆摊禁止移动}) and (g_MySelf.m_nState and $00080000 = 0) {冰冻状态} and (not IsInContinuous{g_boContinuous} {不在连击状态}) and (g_MySelf.m_nChangeAppr < 0 {没有变身}) then begin
      if (ssAlt in Shift) then begin
        Inc(g_nMoveCount);
        // 挖肉相关
        tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);
        if (MyGetTickCount - FLastButchTargetTick >= 1000) and CanNextAction(caSitDown) and ServerAcceptNextAction(False) {and CanNextHit} then begin
          target := PlayScene.ButchAnimal(g_nMouseCurrX, g_nMouseCurrY);
          if target <> nil then begin
            FLastButchTargetRecogId := target.m_nRecogID;
            FLastButchTargetDir := tdir;
            g_MySelf.SendMsg(CM_SITDOWN, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, target.m_nRecogId, '', 0);
            LastHitTick := timeGetTime;
            FLastButchTargetTick := MyGetTickCount;
            Exit;
          end else begin
            g_MySelf.SendMsg(CM_SITDOWN, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, 0, '', 0);
            LastHitTick := timeGetTime;
            FLastButchTargetTick := MyGetTickCount;
          end;
        end;
        g_nTargetX := -1;
        g_nTargetY := -1;
        Exit;
      end else begin
        FLastButchTargetRecogId := 0;
      end;
      (*
      else if PlugInEnabled and g_ClientConfig.boContinueButchItem and g_ConfigDlg.ConfigCheckeds[ckContinueButchItem] and (FLastButchTargetRecogId <> 0) then
      begin
        tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);
        if CanNextAction(caSitDown) and ServerAcceptNextAction {and CanNextHit} then
        begin
          target := PlayScene.ButchAnimal(g_nMouseCurrX, g_nMouseCurrY);
          if (target <> nil) and (target.m_nRecogId = FLastButchTargetRecogId) then
          begin
            g_MySelf.SendMsg(CM_SITDOWN, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, target.m_nRecogId, '', 0);
            LastHitTick := timeGetTime;
            g_nTargetX := -1;
            Exit;
          end
          else
          begin
            FLastButchTargetRecogId := 0;
          end;
        end;
      end;
      *)
    end;

    // Shift加右键不攻击 chongchong 2014-11-29
    //if (target <> nil) or (ssShift in Shift) then
    if (target <> nil) or (ssShift in Shift) and (not (ssRight in Shift)) then begin
      Inc(g_nMoveCount);
      g_nTargetX := -1;
      g_nTargetY := -1;                                                                         
      if target <> nil then begin
        if TimeGetTime - g_dwLastMoveTick > 1000 then begin
          if (target.m_btRace = RC_MERCHANT) and (not (target.m_wAppearance in [54..58])) then begin
            // DScreen.AddChatBoardString('CM_CLICKNPC '+inttostr(g_nMoveCount), clGreen, clWhite);
            if (not g_boMouseMoveDown) and (MyGetTickCount - dwNPCClickTick >= g_ClientConfig.dwNpcActorClickTime) then begin
              dwNPCClickTick := MyGetTickCount;
              // DScreen.AddChatBoardString('CM_CLICKNPC 2 '+inttostr(g_nMoveCount), clGreen, clWhite);
              g_boOpenMerchantBigDlg := False;
              g_boKeepBigDlg := False;
              SendClientMessage(CM_CLICKNPC, target.m_nRecogId, 0, 0, 0);
            end;
            Exit;
          end;
        end;

        if (not target.m_boDeath) and (target.m_btRace = 0) and target.m_boShopStall then begin // 查询摆摊
          if (MyGetTickCount - g_dwQueryBusinessTime > 500) and (not g_boMouseMoveDown) then begin
            g_dwQueryBusinessTime := MyGetTickCount;
            SendQuerySelectShopInfo(target.m_sUserName, target.m_nRecogId);
          end;
          Exit;
        end;

        if (not target.m_boDeath) and (g_MySelf.m_btHorse = 0) and (not g_MySelf.m_boShopStall {摆摊禁止移动}) and (g_MySelf.m_nState and $00080000 = 0) {冰冻状态} and (g_MySelf.m_nChangeAppr < 0 {没有变身}) then begin // 骑马不允许操作
          {$IF IsMultiThreadRender = 1}
          EnterCriticalSection(g_ActorLock);
          {$IFEND}
          g_TargetCret := target;

          //DScreen.AddChatBoardString('SetTarget', clGreen, 0);
          // 挂机时允许手动指定攻击目标 chongchong 2015-09-01
          FGJTargetCret := target;

          {$IF IsMultiThreadRender = 1}
          LeaveCriticalSection(g_ActorLock);
          {$IFEND}

          if ((not (target.m_btRace in [0, 1])) and //(not Actor.m_boHumsBB) and
            (target.m_btRace <> RC_GUARD2) and (target.m_btRace <> RC_MERCHANT) and //(Pos('(', target.m_sUserName) = 0)
            (target.m_HumsBBType = bbNo)) or (ssShift in Shift) or // SHIFT + 鼠标左键
          (target.m_nNameColor = ENEMYCOLOR) or ((PlugInEnabled and g_ClientConfig.boNotNeedShift and g_ConfigDlg.ConfigCheckeds[ckNotNeedShift]) and ((g_ConfigDlg.ConfigCheckeds[ckShiftSwitch] and g_boShift) or (not g_ConfigDlg.ConfigCheckeds[ckShiftSwitch])) and (target.m_btRace <> RC_MERCHANT)) // 免Shift
          then begin
            AttackTarget(target, False);
            g_dwLatestHitTick := MyGetTickCount;

            g_LockTarget := target;
            g_dwLockTargetTick := MyGetTickCount;
          end; //else begin
        end;
        Exit;
      end  else {// target = nil}  begin
        // 空释放连击技能  chongchong 2013-11-22
        if (ssShift in Shift) and IsInContinuous{g_boContinuous} then begin
          tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);
          nHitMsg := StartContinuousAttack;
          if (nHitMsg > 0) and CanNextAction(caHit) and ServerAcceptNextAction(True) and CanNextHit then begin
            boForceContinuous := True;
            if (nHitMsg = CM_100HIT) then {// 追心刺}  begin
              GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, nX, nY);
              UseMagic(nX, nY, @g_CurrContinuousMagic);
              Inc(g_nContinuousIndex);
              if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
                 DoFinishContinuous();
              end;
              Exit;
            end;
            g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, GetHitEffectLevel(nHitMsg), '', 0);
            g_dwLatestHitTick := MyGetTickCount;
            LastHitTick := timeGetTime;
            Inc(g_nContinuousIndex);
            if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
               DoFinishContinuous();
            end;
            // 2021-01-22 改这里，处理2边不同步
            {
            g_boContinuous := g_nContinuousIndex < Length(g_ContinuousMagic);
            if not g_boContinuous then
            begin
              OutputDebugString('~~~~~~~~~~~~~~~~~~~~~~~~~~~~Stop Continuous AAA');
            end;
            }
          end else if nHitMsg = 0 then begin
            // ++++++ 修复魔道连击移动中断后不能继续释放 chongchong 2015-05-04
            boForceContinuous := True;
            StartContinuousMagicAttack;
          end;
        end;
      end;

      // 骑马不允许操作
      if (g_MySelf.m_btHorse = 0) and (not g_MySelf.m_boShopStall {摆摊禁止移动}) and (g_MySelf.m_nState and $00080000 = 0) {冰冻状态} and (not IsInContinuous {g_boContinuous} {不在连击状态}) and (g_MySelf.m_nChangeAppr < 0 {没有变身}) then begin
        // if MyGetTickCount - g_dwLatestRushRushTick < 500 then Exit; //野蛮冲撞时禁止移动
        tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);

        if CanNextAction(caHit) and ServerAcceptNextAction(True) and CanNextHit then begin
          Inc(g_nMoveCount);

          ClientMagic := nil;

          nHitMsg := CM_HIT + Random(3);

          // 龙影剑法不判断目标 piaoyun 2013-07-23
          if g_boNextTime42Hit then begin
            TempMagic := FindMagic(42);
            if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
              ClientMagic := TempMagic;
              nHitMsg := CM_TWNHIT;
              g_boNextTime42Hit := False;
            end;
          end;

          // 自定义龙影
          if (ClientMagic = nil) then begin
            for II := 0 to Length(g_AutoCustomMagic[mngoTWNHit]) - 1 do begin
              MagicID := g_AutoCustomMagic[mngoTWNHit][II];
              if (g_boNextTimeCustomMagicList.IndexOf(Pointer(MagicID - CUSTOM_MAGIC_START_ID)) >= 0) then begin
                TempMagic := FindMagic(MagicID);
                if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
                  ClientMagic := TempMagic;
                  nHitMsg := CM_CUSTOM_HIT001 + (MagicID - CUSTOM_MAGIC_START_ID);
                  Break;
                end;
              end;
            end;
          end;

          IsCheckNextMagic := True;

          // 是否可以使用刺杀
          if (TargetInSwordLongAttackRange(tdir) or (PlugInEnabled and g_ClientConfig.boSmartLongHit and g_ConfigDlg.ConfigCheckeds[ckSmartLongHit])) then begin
            if g_boCanLongHit then begin
              TempMagic := FindMagic(12);
              if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
                ClientMagic := TempMagic;
                nHitMsg := CM_LONGHIT;
                IsCheckNextMagic := False;
              end;
            end;

            // 自定义刺杀
            if (ClientMagic = nil) then begin
              for II := 0 to Length(g_AutoCustomMagic[mngoLongHit]) - 1 do begin
                MagicID := g_AutoCustomMagic[mngoLongHit][II];

                if (g_boNextTimeCustomMagicList.IndexOf(Pointer(MagicID - CUSTOM_MAGIC_START_ID)) >= 0) then begin
                  TempMagic := FindMagic(MagicID);
                  if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
                    ClientMagic := TempMagic;
                    nHitMsg := CM_CUSTOM_HIT001 + (MagicID - CUSTOM_MAGIC_START_ID);
                    IsCheckNextMagic := False;
                    Break;
                  end;
                end;
              end;
            end;
          end;

          // 是否可以使用半月
          if IsCheckNextMagic and TargetInSwordLongAttackRange(tdir, 1) then begin
            if (g_MySelf.m_Abil.MP >= 3) then begin
              if g_boCanWideHit then begin
                TempMagic := FindMagic(25);
                if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
                  ClientMagic := TempMagic;
                  nHitMsg := CM_WIDEHIT;
                end;
              end;
            end;

            // 自定义半月
            if (ClientMagic = nil) then begin
              for II := 0 to Length(g_AutoCustomMagic[mngoWideHit]) - 1 do begin
                MagicID := g_AutoCustomMagic[mngoWideHit][II];

                if (g_boNextTimeCustomMagicList.IndexOf(Pointer(MagicID - CUSTOM_MAGIC_START_ID)) >= 0) then begin
                  TempMagic := FindMagic(MagicID);

                  if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
                    CustomMagicConfig := GetCustomMagicConfig(MagicID);

                    // MP不足时不释放自定义技能
                    nSpellPoint := Round(TempMagic.Def.wSpell / (TempMagic.Def.btTrainLv + 1) * (TempMagic.Level + 1)) + TempMagic.Def.wDefSpell;
                    if (CustomMagicConfig <> nil) and CustomMagicConfig.IsAttackUseNG then
                      IsOK := g_MySelf.m_boTrainingNG and (nSpellPoint <= g_MySelf.m_AbilNG.NH)
                    else
                      IsOK := (Cardinal(nSpellPoint) <= g_MySelf.m_Abil.MP);

                    if IsOK then begin
                      ClientMagic := TempMagic;
                      nHitMsg := CM_CUSTOM_HIT001 + (MagicID - CUSTOM_MAGIC_START_ID);
                      Break;
                    end;
                  end;
                end;
              end;
            end;
          end;

          IsCheckNextMagic := True;

          // 逐日剑法不判断目标 piaoyun 2013-07-23
          if TargetInKTZAttackRange(tdir) then begin
            if g_boNextTimeSwordHit then begin
              TempMagic := FindMagic(56);
              if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
                ClientMagic := TempMagic;
                nHitMsg := CM_SWORDHIT;
                g_boNextTimeSwordHit := False;
              end;
            end;

            // 自定义逐日剑法
            if (ClientMagic = nil) then begin
              for II := 0 to Length(g_AutoCustomMagic[mngoSwordHit]) - 1 do begin
                MagicID := g_AutoCustomMagic[mngoSwordHit][II];

                if (g_boNextTimeCustomMagicList.IndexOf(Pointer(MagicID - CUSTOM_MAGIC_START_ID)) >= 0) then begin
                  TempMagic := FindMagic(MagicID);
                  if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
                    ClientMagic := TempMagic;
                    nHitMsg := CM_CUSTOM_HIT001 + (MagicID - CUSTOM_MAGIC_START_ID);
                    IsCheckNextMagic := False;
                    Break;
                  end;
                end;
              end;
            end;
          end;

          if IsCheckNextMagic and TargetInKTZAttackRange(tdir) then begin
            if g_boNextTime66Hit {开天斩重击} then begin
              TempMagic := FindMagic(66);
              if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
                ClientMagic := TempMagic;
                nHitMsg := CM_66HIT;
                g_boNextTime66Hit := False;
              end;
            end;

            // 自定义开天
            if (ClientMagic = nil) then begin
              for II := 0 to Length(g_AutoCustomMagic[mngoKTZHit]) - 1 do begin
                MagicID := g_AutoCustomMagic[mngoKTZHit][II];
                if (g_boNextTimeCustomMagicList.IndexOf(Pointer(MagicID - CUSTOM_MAGIC_START_ID)) >= 0) then begin
                  TempMagic := FindMagic(MagicID);
                  if (TempMagic <> nil) and (MyGetTickCount - TempMagic.dwLastUseTick >= TempMagic.dwRealInterval + 100) then begin
                    ClientMagic := TempMagic;
                    nHitMsg := CM_CUSTOM_HIT001 + (MagicID - CUSTOM_MAGIC_START_ID);
                    Break;
                  end;
                end;
              end;
            end;
          end;

          if ClientMagic <> nil then begin
            g_boLatestSpell := True;
            g_dwMagicDelayTime := g_MySelf.UseMagicDelayTime(ClientMagic.Def.dwMagicDelayTime);
            ClientMagic.dwLastUseTick := MyGetTickCount;
          end;

          g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, GetHitEffectLevel(nHitMsg), '', 0);
          LastHitTick := timeGetTime;
          // g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, 0, '', 0);
        end;
        g_dwLastAttackTick := MyGetTickCount;
      end;
      Exit;
    end; // if (target <> nil) or (ssShift in Shift) then begin
  finally
    if (OldTargetCret <> g_TargetCret) then begin
      if Assigned(g_AntiPlugNotifyFunc) then begin
        if g_TargetCret <> nil then
          g_AntiPlugNotifyFunc(event_Target_Click, nil, g_TargetCret.m_nRecogId)
        else
          g_AntiPlugNotifyFunc(event_Target_Click, nil, 0);
      end;
    end;
  end;

  if (g_MySelf.m_boShopStall {摆摊禁止移动}) or (g_MySelf.m_nState and $00080000 <> 0) {冰冻状态} then
    Exit;

  if (g_nMouseCurrX = g_MySelf.m_nCurrX) and (g_nMouseCurrY = g_MySelf.m_nCurrY) then begin
    // if (abs(g_nScreenCenterX - X) <= UNITX div 2) and (abs(g_nScreenCenterY - Y) <= UNITY div 2) then begin
    GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);
    if CanNextAction and ServerAcceptNextAction(False) then begin
      SendPickup; // 捡物品
    end;
    // DScreen.AddChatBoardString('g_nMouseCurrX = (g_MySelf.m_nCurrX', clGreen, clWhite);
  end else begin
    // if MyGetTickCount - g_dwLatestRushRushTick < 500 then Exit; //野蛮冲撞时禁止移动

    Inc(g_nMoveCount);
    tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);
    nX := g_MySelf.m_nCurrX;
    nY := g_MySelf.m_nCurrY;

    if ((ssCtrl in Shift) or (ssRight in Shift)) and (not g_MySelf.m_boCobweb {被蜘蛛网罩住}) and (g_MySelf.m_nChangeAppr < 0) then begin
      // DScreen.AddChatBoardString('caRun 5', clGreen, clWhite);
      GetNextRunXY(tdir, nX, nY);
      if PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY) then begin
        g_ChrAction := caRun;
        //DScreen.AddChatBoardString('debug___g_ChrAction 5', clGreen, clWhite);
        g_nTargetX := nX;
        g_nTargetY := nY;
        // DScreen.AddChatBoardString('caRun 6', clGreen, clWhite);
        Exit;
      end;
      // DScreen.AddChatBoardString('caRun 7', clGreen, clWhite);
      nX := g_MySelf.m_nCurrX;
      nY := g_MySelf.m_nCurrY;
      GetNextRunXY(tdir, nX, nY);
      // GetNextPosXY(tdir, nX, nY);
      g_ChrAction := caRun;
      //DScreen.AddChatBoardString('debug___g_ChrAction 6', clGreen, clWhite);
      g_nTargetX := nX;
      g_nTargetY := nY;

    end else begin
      GetNextPosXY(tdir, nX, nY);
      g_ChrAction := caWalk;
      g_nTargetX := nX;
      g_nTargetY := nY;
      // DScreen.AddChatBoardString('caRun 8 ', clGreen, clWhite);
      //OutputDebugString('MouseLeft: action Move');
    end;
  end;

  if (Cursor <> GetDefaultCursor) then begin
    Cursor := GetDefaultCursor;
    Exit;
  end;
end;

function TfrmMain.CheckDoorAction(dx, dy:Integer):Boolean;
var
  door:Integer;
  dwCurTick:DWORD;
const
  {$J+}
  //nMsgCount:Integer = 0;
  dwLastOpendoorTick:DWORD = 0;
  {$J-}
begin
  Result := False;
  dwCurTick := GetTickCount;
  if (dwCurTick - dwLastOpendoorTick) < 1000  then Exit;

  //if not Map.CanMove (dx, dy) then begin
   //if (Abs(dx-g_Myself.m_nCurrX) <= 1) and (Abs(dy-g_Myself.m_nCurrY) <= 1) then begin
      door := Map.GetDoor(dx, dy);
      if door > 0 then begin
        if not Map.IsDoorOpen(dx, dy) then begin
          SendClientMessage(CM_OPENDOOR, door, dx, dy, 0);
          dwLastOpendoorTick := dwCurTick;
          //OutputDebugString(PChar(Format('OpenDoorMsg [%d]', [nMsgCount])));
          //Inc(nMsgCount);
          Result := True;
        end;
      end;
   //end;
 //end;
end;

procedure TfrmMain.MouseTimerTimer(Sender:TObject);
var
  nX, nY, tdir, nHitMsg:Integer;
  pt:TPoint;
  TargetCret:TActor;
  NowTime:Integer;
  H, M, S, MS:Word;
  KeyState:TKeyboardState;
  ShiftState:TShiftState;
  IsInClientRect:Boolean;
  SelfR:TRect;
begin
  // 就是这个不导致不停的触发，这种方式在某些win10下有问题 OnMouseMove chongchong 2018-02-04
  //GetCursorPos(pt);
  //SetCursorPos(pt.X, pt.Y);

  SelfR.TopLeft := ClientToScreen(Point(0, 0));
  SelfR.Right := SelfR.Left + (ClientRect.Right - ClientRect.Left);
  SelfR.Bottom := SelfR.Top + (ClientRect.Bottom - ClientRect.Top);

  GetCursorPos(pt);

  GetKeyboardState(KeyState);
  ShiftState := KeyboardStateToShiftState(KeyState);

  IsInClientRect := PtInRect(SelfR, pt);
  if Active and IsInClientRect and Assigned(OnMouseMove) then
    DoMouseMove(Self, ShiftState, pt.X, pt.Y, True); // 若为false，旧模式下移动装备上面不显示提示 chongchong 2018-02-10

  if Active and (not IsInClientRect) then begin
    if g_IsInMouseMove then begin
      DScreen.ClearHint;
      HintWindows.Clear;
      g_IsInMouseMove := False;
    end;
  end;

  if PlugInEnabled and g_ClientConfig.boContinueButchItem and g_ConfigDlg.ConfigCheckeds[ckContinueButchItem] and (FLastButchTargetRecogId <> 0) then begin
    TargetCret := PlayScene.FindActor(FLastButchTargetRecogId);
    if (TargetCret <> nil) and TargetCret.m_boDeath and (not (TargetCret.m_btRace in [1])) and (abs(TargetCret.m_nCurrX - g_MySelf.m_nCurrX) <= 1) and (abs(TargetCret.m_nCurrY - g_MySelf.m_nCurrY) <= 1) then begin
      if (g_MySelf.m_nCurrX = TargetCret.m_nCurrX) and (g_MySelf.m_nCurrY = TargetCret.m_nCurrY) then
        tdir := FLastButchTargetDir
      else
        tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, TargetCret.m_nCurrX, TargetCret.m_nCurrY);

      // 修正挖肉跳帧 +(MyGetTickCount - g_MySelf.m_dwActionEndTime >= 150)  chongchong 2018-05-05
      if (MyGetTickCount - FLastButchTargetTick >= 1500) and (TimeGetTime - g_MySelf.m_dwActionEndTime >= 60) and CanNextAction(caSitDown) and ServerAcceptNextAction(False) {and CanNextHit} then begin
        g_MySelf.SendMsg(CM_SITDOWN, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, TargetCret.m_nRecogId, '', 0);
        LastHitTick := timeGetTime;
        FLastButchTargetTick := MyGetTickCount;
        g_nTargetX := -1;
        g_nTargetY := -1;
        Exit;
      end;
    end
    else begin
      FLastButchTargetRecogId := 0;
    end;
  end;

  // 发网关发一个时间验证包 chongchong 2016-01-01
  if (g_MySelf <> nil) and (Length(g_sRunServerAddr) > 0) and (MyGetTickCount - g_RungateCheckInfoTick >= g_RungateCheckInfoTime) then begin
    g_RungateCheckInfoTime := 1200000 + Random(1200000);
    g_RungateCheckInfoTick := MyGetTickCount;

    NowTime := Trunc(Now());
    DecodeTime(Now(), H, M, S, MS);
    SendClientMessage(CM_RUNGATE_CHECK_INFO, inet_addr(PChar(g_sRunServerAddr)), HiWord(NowTime), LoWord(NowTime), H);
  end;

  if (g_ChrAction > caNone) or g_boMouseRightDown then begin
    if ActionKey > 0 then begin
      ProcessKeyMessages;
    end else begin
      // 修正有时候跑步间隔会比常规间隔小，造成封挂困难 chongchong 2015-07-27
      //ProcessActionMessages;
    end;
  end else begin
    {$IF IsMultiThreadRender = 1}
    EnterCriticalSection(g_ActorLock);
    {$IFEND}
    TargetCret := g_TargetCret;
    {$IF IsMultiThreadRender = 1}
    LeaveCriticalSection(g_ActorLock);
    {$IFEND}
    // DScreen.AddChatBoardString('MouseTimerTimer 1', clGreen, clWhite);

    if (TargetCret <> nil) and (g_MySelf <> nil) then begin
      // DScreen.AddChatBoardString('MouseTimerTimer2 ', clGreen, clWhite);
      if ActionKey > 0 then begin
        ProcessKeyMessages;
      end else begin
        // DScreen.AddChatBoardString('MouseTimerTimer 3', clGreen, clWhite);
        // if MyGetTickCount - g_dwLatestRushRushTick > 1200 then begin //野蛮冲撞时禁止移动
          // DScreen.AddChatBoardString('MouseTimerTimer 4', clGreen, clWhite);

        if PlayScene.IsValidActor(TargetCret) and (not TargetCret.m_boDeath) and (not g_MySelf.m_boShopStall) {摆摊禁止移动} and (g_MySelf.m_btHorse = 0) and (g_MySelf.m_nChangeAppr < 0 {没有变身}) then begin
          // 不放在这里，放这里时攻击间隔误差较大 chongchong 2016-12-19
          (*
          // 修正攻击间隔不均匀，移动自：TfrmMain.MouseTimerTimer chongchong 2016-12-10
          // DScreen.AddChatBoardString('MouseTimerTimer 5', clGreen, clWhite);
          FillChar(keyvalue, SizeOf(TKeyBoardState), #0);
          if GetKeyboardState(keyvalue) then
          begin
            // DScreen.AddChatBoardString('MouseTimerTimer 6', clGreen, clWhite);
            Shift := [];
            if ((keyvalue[VK_SHIFT] and $80) <> 0) then Shift := Shift + [ssShift];
            if (not (TargetCret.m_btRace in [0, 1]) and
              (TargetCret.m_btRace <> RCC_GUARD) and
              (TargetCret.m_btRace <> RCC_MERCHANT) and
              (Pos('(', TargetCret.m_sUserName) = 0) // 林牢乐绰 各(碍力傍拜 秦具窃)
              )
              or (TargetCret.m_nNameColor = ENEMYCOLOR) // 利篮 磊悼 傍拜捞 凳
              or ((PlugInEnabled and g_ClientConfig.boNotNeedShift and
                g_ConfigDlg.ConfigCheckeds[ckNotNeedShift]) and
                ((g_ConfigDlg.ConfigCheckeds[ckShiftSwitch] and g_boShift) or (not g_ConfigDlg.ConfigCheckeds[ckShiftSwitch])) and
                (TargetCret.m_btRace <> RCC_MERCHANT)) // 免Shift
              or ((ssShift in Shift) and (not FrmDlg.IsInputChatEdit)) then
            begin // 荤恩阑 角荐肺 傍拜窍绰 巴阑 阜澜
              //DScreen.AddChatBoardString('消息处理间隔:' + IntToStr(MyGetTickCount - LastAttackTick), clWhite, clBlack);
              //LastAttackTick := MyGetTickCount;
              AttackTarget(TargetCret);
              // DScreen.AddChatBoardString('MouseTimerTimer 7', clGreen, clWhite);
            end; // else begin
            // TargetCret := nil;
            // end
          end;
          *)
        end else begin
          // DScreen.AddChatBoardString('g_TargetCret := nil 4', clGreen, clWhite);
          {$IF IsMultiThreadRender = 1}
          EnterCriticalSection(g_ActorLock);
          {$IFEND}
          g_TargetCret := nil;
          {$IF IsMultiThreadRender = 1}
          LeaveCriticalSection(g_ActorLock);
          {$IFEND}
        end;
        // end;
      end;
    end else if (TargetCret = nil) and (IsInContinuous{g_boContinuous}) and boForceContinuous then begin
      // 空释放连击技能  chongchong 2013-11-22
      tdir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_nMouseCurrX, g_nMouseCurrY);
      nHitMsg := StartContinuousAttack;
      if (nHitMsg > 0) and CanNextAction(caHit) and ServerAcceptNextAction(True) and CanNextHit then begin
        boForceContinuous := True;
        if (nHitMsg = CM_100HIT) then {// 追心刺}  begin
          GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, nX, nY);
          UseMagic(nX, nY, @g_CurrContinuousMagic);
          Inc(g_nContinuousIndex);
          if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
            DoFinishContinuous();
          end;
          Exit;
        end;
        g_MySelf.SendMsg(nHitMsg, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, tdir, GetHitEffectLevel(nHitMsg), '', 0);
        g_dwLatestHitTick := MyGetTickCount;
        LastHitTick := timeGetTime;
        Inc(g_nContinuousIndex);
        if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
            DoFinishContinuous();
        end; 
      end else if (nHitMsg = 0) then begin
        // ++++++ 修复魔道连击移动中断后不能继续释放 chongchong 2015-05-04
        boForceContinuous := True;
        StartContinuousMagicAttack;
      end;
    end;
  end;

  if not IsInContinuous{g_boContinuous} then
    boForceContinuous := False;

  if g_boAutoDig and (g_MySelf <> nil) and (not IsInContinuous {g_boContinuous} {不在连击状态}) then begin
    if CanNextAction(caHit) and ServerAcceptNextAction(True) and CanNextHit then begin
      g_MySelf.SendMsg(CM_HIT + 1, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_MySelf.m_btDir, 0, '', 0);
    end;
  end;

  if (g_MySelf <> nil) and (not g_MySelf.m_boShopStall) {摆摊禁止移动} and PlugInEnabled and (not g_MySelf.m_boDeath) then begin
    AutoPickUpItem(); // 自动捡取
  end;

  if (g_MySelf <> nil) and g_boGJRun then begin
    RunGJ;
  end;
end;

procedure TfrmMain.AutoPickUpItem;
var
  I:Integer;
  DropItem:pTDropItem;
  CanPick:Boolean;
begin
  // 骑马，被别人载着 chongchong 2014-05-28
  if (g_MySelf.m_btHorse in [1, 2]) and (g_MySelf.m_btDoubleHumHorse = 0) then
    Exit;

  if g_AutoPickupList = nil then
    Exit;

  // 挂机时不让自动捡物 （因为挂机有捡物的功能） chongchong 2015-09-05
  if g_boGJRun then
    Exit;

  CanPick := False;

  g_AutoPickupList.Clear;
  if g_ClientConfig.boPickupAll and g_ConfigDlg.ConfigCheckeds[ckPickupAll] then
    CanPick := True
  else if g_ClientConfig.boAutoPickUpItem and g_ConfigDlg.ConfigCheckeds[ckAutoPickUpItem] then begin
    PlayScene.GetXYDropItemsList(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, g_AutoPickupList);
    for I := 0 to g_AutoPickupList.Count - 1 do begin
      DropItem := g_AutoPickupList.Items[I];
      if (DropItem.ShowItem <> nil) and (pTShowItem(DropItem.ShowItem).boPickup) then begin
        CanPick := True;
        break;
      end;
    end;
  end;

  if CanPick then begin
    SendPickup(True);
  end;
end;

procedure TfrmMain.WaitMsgTimerTimer(Sender:TObject);
begin
  if g_MySelf = nil then
    Exit;
  if g_MySelf.ActionFinished then begin
    WaitMsgTimer.Enabled := False;
    // PlayScene.MemoLog.Lines.Add('WaitingMsg: ' + IntToStr(WaitingMsg.Ident));
    case WaitingMsg.ident of
      SM_CHANGEMAP:begin
          {$IF IsMultiThreadRender = 1}
          EnterCriticalSection(g_CriticalSection);
          try
            {$IFEND}
            g_nTargetX := -1;
            g_nTargetY := -1;
            g_boMapMovingWait := False;

            g_boMapMoving := False;
            if Length(LegendMap.RunPath) > 0 then
              SendClientMessage(CM_AUTOFINDPATHINFO, 0, 0, 0, 2, '');
            LegendMap.Stop; // 停止寻路

            if not SameText(WaitingStr, g_sMapName) then begin
              g_AutoGJPoints.Clear;
              StopGJ;
            end;

            if g_nMDlgX <> -1 then begin
              FrmDlg.CloseMDlg;
              g_nMDlgX := -1;
            end;

            // 切换地图或随机卷飞时，清空前面的下载列表 chongchong 2016-01-08
            if g_boAutoUpdate then begin
              if (g_UpdateEngine <> nil) { and (g_UpdateEngine.GetUpdateCount > 0)} then {// 清空前面的数据，不管队列是否有数据 2020-03-04 16:59:58}  begin
                //DScreen.AddChatBoardString('更新列表:' + IntToStr(g_UpdateEngine.GetUpdateCount), clWhite, clBlack);
                g_UpdateEngine.ClearRequestList;
              end;
            end;

            PlayScene.CleanObjects;
            //g_sMapTitle := '';
            g_MySelf.CleanCharMapSetting(WaitingMsg.param, WaitingMsg.tag);
            PlayScene.SendMsg(SM_CHANGEMAP, 0, WaitingMsg.param {x}, WaitingMsg.tag {y}, WaitingMsg.series {darkness}, nil, 0, WaitingStr {mapname});

            // DScreen.AddSysMsg (IntToStr(WaitingMsg.Param) + ' ' +
            // IntToStr(WaitingMsg.Tag) + ' : My ' +
            // IntToStr(Myself.XX) + ' ' +
            // IntToStr(Myself.m_nCurrY) + ' ' +
            // IntToStr(Myself.RX) + ' ' +
            // IntToStr(Myself.RY) + ' '
            // );
            {$IF IsMultiThreadRender = 1}
          finally
            LeaveCriticalSection(g_CriticalSection);
          end;
          {$IFEND}
          {$IF IsMultiThreadRender = 1}
          EnterCriticalSection(g_ActorLock);
          {$IFEND}
          g_MagicTarget := nil;
          g_TargetCret := nil;
          g_FocusCret := nil;
          g_FocusCretTick := MyGetTickCount;
          g_BrightActor := nil;
          // DScreen.AddChatBoardString('g_TargetCret := nil 5', clGreen, clWhite);
          {$IF IsMultiThreadRender = 1}
          LeaveCriticalSection(g_ActorLock);
          {$IFEND}
        end;
    end;
  end;
end;

