function TfrmMain.Operate(ProcessMsg:pTProcessMessage):Boolean;
var
  I:Integer;
  DefMsg:TDefaultMessage;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode_M.inc}
  {$IFEND}

  Result := True;
  case ProcessMsg.wIdent of
    SM_TAKEONITEM:
      ClientTakeOnItem(ProcessMsg.nParam1, ProcessMsg.wParam, ProcessMsg.sMsg);
    SM_TAKEOFFITEM:
      ClientTakeOffItem(ProcessMsg.nParam1, ProcessMsg.wParam, ProcessMsg.sMsg);
    SM_HEROTAKEONITEM:
      ClientHeroTakeOnItem(ProcessMsg.nParam1, ProcessMsg.wParam, ProcessMsg.sMsg);
    SM_HEROTAKEOFFITEM:
      ClientHeroTakeOffItem(ProcessMsg.nParam1, ProcessMsg.wParam, ProcessMsg.sMsg);
    CM_GETSHOPITEMS:
      SendSocket(ProcessMsg.sMsg);
    RCM_UNBINDITEM:begin
        if ProcessMsg.wParam < 3 then begin
          // 加入英雄手动吃药自动解包 chongchong 2015-02-07
          if ProcessMsg.nParam1 = 1 then begin
            if (g_HeroEatingItem.S.Name <> '') and (g_WaitingHeroUseItem.Item.s.Name = '') and (MyGetTickCount - g_dwHeroEatTime > 5 * 1000) then begin
              g_HeroEatingItem.S.Name := '';
            end;

            if (g_HeroEatingItem.S.Name = '') and (g_WaitingHeroUseItem.Item.s.Name = '') then begin
              if not UnBindHeroItem(ProcessMsg.sMsg) then
                SendDelayMsg(g_MySelf, RCM_UNBINDITEM, ProcessMsg.wParam + 1, 1, 0, 0, ProcessMsg.sMsg, 500);
            end
            else
              SendDelayMsg(g_MySelf, RCM_UNBINDITEM, ProcessMsg.wParam + 1, 1, 0, 0, ProcessMsg.sMsg, 500);
          end
          else begin
            if (g_EatingItem.S.Name <> '') and (g_WaitingUseItem.Item.s.Name = '') and (MyGetTickCount - g_dwEatTime > 5 * 1000) then begin
              g_EatingItem.S.Name := '';
              g_EatingItemIndex := -1;
            end;

            if (g_EatingItem.S.Name = '') and (g_WaitingUseItem.Item.s.Name = '') then begin
              if not UnBindItem(ProcessMsg.sMsg) then
                SendDelayMsg(g_MySelf, RCM_UNBINDITEM, ProcessMsg.wParam + 1, 0, 0, 0, ProcessMsg.sMsg, 500);
            end
            else
              SendDelayMsg(g_MySelf, RCM_UNBINDITEM, ProcessMsg.wParam + 1, 0, 0, 0, ProcessMsg.sMsg, 500);
          end;
        end;
      end;
    RCM_AutoUNBINDITEM:begin
        if ProcessMsg.wParam < 3 then begin
          if (g_AutoEatingItem.S.Name <> '') and (MyGetTickCount - g_dwAutoEatTime > 5 * 1000) then begin
            g_AutoEatingItem.S.Name := '';
          end;

          if (g_AutoEatingItem.S.Name = '') then begin
            if not AutoUnBindItem(ProcessMsg.sMsg) then
              SendDelayMsg(g_MySelf, RCM_AutoUNBINDITEM, ProcessMsg.wParam + 1, 0, 0, 0, ProcessMsg.sMsg, 500);
          end
          else
            SendDelayMsg(g_MySelf, RCM_AutoUNBINDITEM, ProcessMsg.wParam + 1, 0, 0, 0, ProcessMsg.sMsg, 500);
        end;
      end;
    RCM_AutoUNBINDITEM_Auto:begin
        if ProcessMsg.wParam < 3 then begin
          if (g_AutoEatingItem.S.Name <> '') and (MyGetTickCount - g_dwAutoEatTime > 5 * 1000) then begin
            g_AutoEatingItem.S.Name := '';
          end;

          if (g_AutoEatingItem.S.Name = '') then begin
            if not AutoUnBindItem(ProcessMsg.sMsg) then
              SendDelayMsg(g_MySelf, RCM_AutoUNBINDITEM_Auto, ProcessMsg.wParam + 1, 0, 0, 0, ProcessMsg.sMsg, 500);
          end
          else
            SendDelayMsg(g_MySelf, RCM_AutoUNBINDITEM_Auto, ProcessMsg.wParam + 1, 0, 0, 0, ProcessMsg.sMsg, 500);
        end;
      end;

    // CM_SENDBUSINESSSTATUS: SendClientMessage(CM_SENDBUSINESSSTATUS, BoolToInt(not g_MySelf.m_boShopStall), 0, 0, 0);
    CM_QUERYMYSHOPSELLEDITEMS:
      SendQueryMyShopSelledItem(0, 0, 0, 0, 0, '');

    CM_QUERYMYSHOPSTORAGEITEMS:
      SendQueryMyShopStorageItem(0, 0, 0, 0, 0, '');

    RCM_PLAYMAPMUSIC:begin
        if PlugInEnabled and g_ClientConfig.boBGMusic and g_ConfigDlg.ConfigCheckeds[ckBGMusic] then begin
          if g_boLoadUserConfig then
            PlayMapMusic(True)
          else
            SendDelayMsg(g_MySelf, RCM_PLAYMAPMUSIC, 0, 0, 0, 0, '', 1000);
        end;
      end;
    SM_SENDUSERICON:begin
        DefMsg := MakeDefaultMsg(ProcessMsg.wIdent, ProcessMsg.nParam1, ProcessMsg.wParam, 1, ProcessMsg.nParam3);
        ClientGetUseIcons(@DefMsg, ProcessMsg.sMsg);
      end;
    SM_SENDUSEREFFECT:begin
        DefMsg := MakeDefaultMsg(ProcessMsg.wIdent, ProcessMsg.nParam1, ProcessMsg.wParam, 1, ProcessMsg.nParam3);
        ClientGetUseEffects(@DefMsg, ProcessMsg.sMsg);
      end;
    RCM_AutoOrderItem:begin
        if (ProcessMsg.nParam1 in [0..5]) then begin // 自动放药
          if (g_EatingItem.S.Name = '') then begin
            if g_ItemArr[ProcessMsg.nParam1].S.Name = '' then begin
              for I := Low(g_ItemArr) + 6 to GetMaxBagCount - 1 do begin
                if Length(g_ItemArr[I].S.Name) > 0 then begin
                  if SameText(g_ItemArr[I].S.Name, ProcessMsg.sMsg) then begin
                    g_ItemArr[ProcessMsg.nParam1] := g_ItemArr[I];
                    g_ItemArr[I].S.Name := '';
                    Break;
                  end;
                end;
              end;
            end;
          end else begin
            SendDelayMsg(g_MySelf, RCM_AutoOrderItem, 0, ProcessMsg.nParam1, 0, 0, ProcessMsg.sMsg, 500);
          end;
        end;
      end;
    RCM_AutoOrderItem_Auto:begin
        if (ProcessMsg.nParam1 in [0..5]) then begin // 自动放药
          if (g_AutoEatingItem.S.Name = '') then begin
            if g_ItemArr[ProcessMsg.nParam1].S.Name = '' then begin
              for I := Low(g_ItemArr) + 6 to GetMaxBagCount - 1 do begin
                if g_ItemArr[I].S.Name <> '' then begin
                  if Comparetext(g_ItemArr[I].S.Name, ProcessMsg.sMsg) = 0 then begin
                    g_ItemArr[ProcessMsg.nParam1] := g_ItemArr[I];
                    g_ItemArr[I].S.Name := '';
                    Break;
                  end;
                end;
              end;
            end;
          end else begin
            SendDelayMsg(g_MySelf, RCM_AutoOrderItem_Auto, 0, ProcessMsg.nParam1, 0, 0, ProcessMsg.sMsg, 500);
          end;
        end;
      end;
    RCM_StartContinuousMagicAttack:begin
        StartContinuousMagicAttack;
      end;
    RCM_PlayBGMgameover:
      PlayBGM(bmg_gameover176);
    RCM_FindModule:begin
        EnterCriticalSection(FCSActionLock);
        try
          FActionLock := True;
          ActionLockTime := MyGetTickCount;
        finally
          LeaveCriticalSection(FCSActionLock);
        end;

        // 检测到使用外挂，游戏已被中止代码3
        SendClientMessage(CM_SENDUSERSPEEDING, 0, 0, 0, 0);
        CSocket.Close;
        FrmDlg.DMessageDlg(DecryString_LF(DecodeResStr(SFindModuleMsg)), [mbOk]);
      end;

    RCM_FINDPROCESS:begin
        EnterCriticalSection(FCSActionLock);
        try
          FActionLock := True;
          ActionLockTime := MyGetTickCount;
        finally
          LeaveCriticalSection(FCSActionLock);
        end;

        // 检测到使用外挂，游戏已被中止代码4
        CSocket.Close;
        FrmDlg.DMessageDlg(DecryString_LF(DecodeResStr(SFindProcessMsg)), [mbOk]);
      end;
    RCM_CHECKCRCERROR:begin
        EnterCriticalSection(FCSActionLock);
        try
          FActionLock := True;
          ActionLockTime := MyGetTickCount;
        finally
          LeaveCriticalSection(FCSActionLock);
        end;
        // SendClientMessage(CM_SENDUSERSPEEDING, 0, 0, 0, 0);
        FrmDlg.DMessageDlg(DecryString_LF(DecodeResStr(SCheckErrorMsg)), [mbOk]);
      end;
    else
      Result := False;
  end;
end;

