function EnabledDebugPrivilege(Enabled:Boolean):Boolean;
var
  TP:TTokenPrivileges;
  ReturnLength:dword;
  hToken:THandle;
  Luid:int64;
begin
  Result := False;
  { ????????? }
  if OpenProcessToken(GetCurrentProcess, TOKEN_ADJUST_PRIVILEGES, hToken) then
    Exit;
  LookupPrivilegeValue(nil, 'SeDebugPrivilege', Luid);
  TP.Privileges[0].Luid := Luid;
  TP.PrivilegeCount := 1;
  { ???????? }
  if Enabled then
    TP.Privileges[0].Attributes := SE_PRIVILEGE_ENABLED
  else
    TP.Privileges[0].Attributes := 0;
  AdjustTokenPrivileges(hToken, False, TP, ReturnLength, nil, ReturnLength);
  Result := GetLastError = ERROR_SUCCESS;
  CloseHandle(hToken);
end;

