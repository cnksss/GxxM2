procedure TfrmMain.ProcessMessageHeroMagicLvExp(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  MagicAttr:TMagicAttr;
begin
  MagicAttr := TMagicAttr(StrToIntDef(DecodeString(sData), 0));
  if MagicAttr = mtContinuous then begin
    g_HeroContinuousMagicList.Lock;
    try
      for I := 0 to g_HeroContinuousMagicList.Count - 1 do begin
        if PTClientMagic(g_HeroContinuousMagicList.Items[I]).Def.wMagicId = DefMsg.Recog then begin
          PTClientMagic(g_HeroContinuousMagicList.Items[I]).Level := LoByte(DefMsg.param);
          PTClientMagic(g_HeroContinuousMagicList.Items[I]).NewLevel := HiByte(DefMsg.param);
          PTClientMagic(g_HeroContinuousMagicList.Items[I]).CurTrain := MakeLong(DefMsg.tag, DefMsg.series);
          Break;
        end;
      end;
    finally
      g_HeroContinuousMagicList.UnLock;
    end;
  end
  else if MagicAttr in [mtDefense, mtAttack] then begin
    g_HeroMagicNGList.Lock;
    try
      for I := 0 to g_HeroMagicNGList.Count - 1 do begin
        if (PTClientMagic(g_HeroMagicNGList.Items[I]).Def.wMagicId = DefMsg.Recog) and (PTClientMagic(g_HeroMagicNGList.Items[I]).Def.MagicAttr = MagicAttr) then begin
          PTClientMagic(g_HeroMagicNGList.Items[I]).Level := LoByte(DefMsg.param);
          PTClientMagic(g_HeroMagicNGList.Items[I]).NewLevel := HiByte(DefMsg.param);
          PTClientMagic(g_HeroMagicNGList.Items[I]).CurTrain := MakeLong(DefMsg.tag, DefMsg.series);
          Break;
        end;
      end;
    finally
      g_HeroMagicNGList.UnLock;
    end;
  end
  else begin
    g_HeroMagicList.Lock;
    try
      for I := 0 to g_HeroMagicList.Count - 1 do begin
        if PTClientMagic(g_HeroMagicList.Items[I]).Def.wMagicId = DefMsg.Recog then begin
          PTClientMagic(g_HeroMagicList.Items[I]).Level := LoByte(DefMsg.param);
          PTClientMagic(g_HeroMagicList.Items[I]).NewLevel := HiByte(DefMsg.param);
          PTClientMagic(g_HeroMagicList.Items[I]).CurTrain := MakeLong(DefMsg.tag, DefMsg.series);
          Break;
        end;
      end;
    finally
      g_HeroMagicList.UnLock;
    end;
  end;

  if (FrmDlg is TSerialWindows) and (g_ClientVersion in [cvSerial, cvMirSequel, cvMirNewUI205]) then begin
    TSerialWindows(FrmDlg).RefreshHeroUpgradeButtons;
    TSerialWindows(FrmDlg).NewStateWindows.RefreshHeroUpgradeButtons;
  end;
end;

