procedure TfrmMain.ProcessMessageHeroDelItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, iindex:Integer;
  Str, iname:string;
begin
  sData := DecodeString(sData);
  while sData <> '' do begin
    sData := GetValidStr3_Ex(sData, iname, '/');
    sData := GetValidStr3_Ex(sData, Str, '/');
    if (iname <> '') and (Str <> '') then begin
      iindex := StrToIntDef(Str, 0);
      DelHeroItemBag(iname, iindex);
      if g_WaitingHeroUseItem.Item.MakeIndex = iindex then
        g_WaitingHeroUseItem.Item.s.Name := '';

      for I := Low(TUseItems) to High(TUseItems) do begin
        if (g_HeroUseItems[I].S.Name = iname) and (g_HeroUseItems[I].MakeIndex = iindex) then begin
          g_HeroUseItems[I].S.Name := '';
        end;
      end;

      for I := Low(TJewelryBoxItems) to High(TJewelryBoxItems) do begin
        if (g_HeroJewelryBoxItems[I].S.Name = iname) and (g_HeroJewelryBoxItems[I].MakeIndex = iindex) then begin
          g_HeroJewelryBoxItems[I].S.Name := '';
        end;
      end;

      for I := Low(TGodBlessItems) to High(TGodBlessItems) do begin
        if (g_HeroGodBlessItems[I].S.Name = iname) and (g_HeroGodBlessItems[I].MakeIndex = iindex) then begin
          g_HeroGodBlessItems[I].S.Name := '';
        end;
      end;
    end
    else
      Break;
  end;
end;

procedure TfrmMain.ProcessMessageHeroChangeItem(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);

  function FindHeroUseItem(iname:string; iindex:Integer):Integer;
  var
    I:Integer;
  begin
    Result := -1;
    for I := High(g_HeroUseItems) downto Low(g_HeroUseItems) do begin
      if (g_HeroUseItems[I].S.Name = iname) and (g_HeroUseItems[I].MakeIndex = iindex) then begin
        Result := I;
        Break;
      end;
    end;
  end;

  function FindHeroItemBag(iname:string; iindex:Integer):Integer;
  var
    I:Integer;
  begin
    Result := -1;
    for I := High(g_HeroItemArr) downto Low(g_HeroItemArr) do begin
      if (g_HeroItemArr[I].S.Name = iname) and (g_HeroItemArr[I].MakeIndex = iindex) then begin
        Result := I;
        Break;
      end;
    end;
  end;

var
  nIndex, nWhere:Integer;
  nMakeIndex:Integer;
  sItemName:string;
  sindex:string;
  sMakeIndex:string;
  UseItem:TClientItem;
  sMsg:string;
  boFlag:Boolean;
begin
  if (g_MyHero = nil) then
    Exit;
  sMsg := DecodeString(sData);
  sMsg := GetValidStr3_Ex(sMsg, sindex, '/');
  sMsg := GetValidStr3_Ex(sMsg, sItemName, '/');
  sMsg := GetValidStr3_Ex(sMsg, sMakeIndex, '/');
  nWhere := StrToIntDef(sindex, -1);
  nMakeIndex := StrToIntDef(sMakeIndex, 0);
  if (nWhere in [Low(TUseItems)..High(TUseItems)]) and (nMakeIndex <> 0) and (sItemName <> '') then begin
    nIndex := FindHeroItemBag(sItemName, nMakeIndex);
    if (nIndex >= 0) and (g_HeroItemArr[nIndex].S.Name <> '') then begin
      case GetTakeOnPosition(g_HeroItemArr[nIndex].S.StdMode, g_HeroItemArr[nIndex].S.Shape) of
        U_DRESS:begin
            if g_MyHero.m_btSex = 0 then
              if g_HeroItemArr[nIndex].S.StdMode <> 10 then
                Exit;
            if g_MyHero.m_btSex = 1 then
              if g_HeroItemArr[nIndex].S.StdMode <> 11 then
                Exit;
            boFlag := True;
          end;
        else
          boFlag := True;
      end;
      if boFlag then begin
        if g_HeroUseItems[nWhere].S.Name <> '' then begin
          UseItem := g_HeroUseItems[nWhere];
          g_HeroUseItems[nWhere] := g_HeroItemArr[nIndex];
          g_HeroItemArr[nIndex] := UseItem;
        end
        else begin
          g_HeroUseItems[nWhere] := g_HeroItemArr[nIndex];
          g_HeroItemArr[nIndex].S.Name := '';
        end;
      end;
    end;
  end;
  ArrangeHeroItemBag;
end;

