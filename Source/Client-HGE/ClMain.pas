          end;
        end
        else begin
          if mrYes <> FrmDlg.DMessageDlg('是否确认开始练习 "' + g_HeroItemArr[idx].S.Name + '"？,.', [mbYes, mbNo]) then begin
            g_HeroItemArr[idx] := g_HeroEatingItem;
            Exit;
          end;
        end;
      end;

      // 传送系列物品使用不要间隔 2018-07-11 17:20:11
      if ((g_HeroEatingItem.s.StdMode = 2) and (g_HeroEatingItem.s.Shape in [1, 2, 3])) or // 传送石系列
      ((g_HeroEatingItem.s.StdMode = 3) and (g_HeroEatingItem.s.Shape in [1, 2, 3, 5])) then {// 传送卷系列}  begin
        TimeInterval := 0
      end
      else begin
        TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].Other;
        if (g_HeroEatingItem.s.StdMode = 0) then begin
          if g_HeroEatingItem.s.Shape <> 1 then {// 普通药物}  begin
            if (g_HeroEatingItem.s.AC1 > 0) and (g_HeroEatingItem.s.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].NormalHPMP
            else if (g_HeroEatingItem.s.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].NormalMP
            else
              TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].NormalHP;
          end
          else {// 特殊药物}  begin
            if (g_HeroEatingItem.s.AC1 > 0) and (g_HeroEatingItem.s.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].SpecialHPMP
            else if (g_HeroEatingItem.s.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].SpecialMP
            else
              TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].SpecialHP;
          end;
        end;
      end;

      if (MyGetTickCount - g_dwHeroEatTime < Cardinal(TimeInterval)) then begin
        AddHeroItemBag(g_HeroEatingItem);
        g_HeroEatingItem.s.Name := '';
        Exit;
      end else begin
        g_dwHeroEatTime := MyGetTickCount;

        SendHeroEat(g_HeroEatingItem.MakeIndex, g_HeroEatingItem.s.Name);
        ItemUseSound(g_HeroEatingItem.s);
      end;
    end else if (g_HeroEatingItem.S.Name = '') and (g_HeroItemArr[idx].S.Name <> '') and (g_HeroItemArr[idx].S.StdMode = 31) then begin // 自动吃药
      g_HeroEatingItem := g_HeroItemArr[idx];
