          end;

          if boFoundOpenHitMagic then begin
            FAutoOpenHitMagicIndex := FoundOpenHitMagicIndex + 1;
            if FAutoOpenHitMagicIndex >= 13 then
              FAutoOpenHitMagicIndex := 0;
            Break;
          end;
        end;
      end;

      // 自动合击
      if (g_MySelf.m_btJob = 0) then begin
        if (g_TargetCret <> nil) and (g_TargetCret.m_btRace <> 50) and CanNextAction(caSpell) and CanNextAction(caHit) and ServerAcceptNextAction(False) and //(tick_diff(g_dwLastMoveTick, MyGetTickCount) >= 2000) and
        (g_MyHero <> nil) and (not g_MyHero.m_boDeath) and (g_MyHero.m_btAttackMode in [0, 3]) and // 攻击模式，强制攻击模式
        g_ClientConfig.boAutoGroupAttack and (tick_diff(g_LastGroupAttackTick, MyGetTickCount) >= 800) and g_ConfigDlg.ConfigCheckeds[ckAutoGroupAttack] and (THeroActor(g_MyHero).m_nMaxAngryValue > 0) and (THeroActor(g_MyHero).m_nAngryValue >= THeroActor(g_MyHero).m_nMaxAngryValue) and (not ((((g_TargetCret.m_btRace > RC_PLAYOBJECT) and (g_TargetCret.m_btRace <> RC_MERCHANT) and (g_TargetCret.m_btRealRace <> 55) and (not (g_TargetCret.m_btRealRace in [RC_GUARD, 12, RC_ARCHERGUARD, RC_MOVE_ARCHERGUARD]))) or ((g_TargetCret.m_btRace = 0) and g_TargetCret.m_boPlayMoster)) and g_ConfigDlg.ConfigCheckeds[ckAutoGroupNoAttackMon] and g_ClientConfig.boAutoGroupNoAttackMon)) then begin
          g_MagicList.Lock;
          try
            for I := 0 to g_HeroMagicList.Count - 1 do begin
              Magic := g_HeroMagicList.Items[I];
              if Magic.Def.wMagicId in [60, 61, 62] then begin
                if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                  g_LastGroupAttackTick := MyGetTickCount;
                  g_MyHero.GroupAttack;
                  //THeroActor(g_MyHero).m_nAngryValue := 0;
                end;
                Break;
              end;
            end;
          finally
            g_HeroMagicList.UnLock;
          end;
        end;
      end else begin
        tempTarget := nil;
        if (g_MagicLockActor <> nil) and (g_MagicLockActor <> g_MySelf) and (g_MagicLockActor <> g_MyHero) then begin
          tempTarget := g_MagicLockActor;
        end
        else if (g_MagicTarget <> nil) and (g_MagicTarget <> g_MySelf) and (g_MagicTarget <> g_MyHero) then begin
          tempTarget := g_MagicTarget;
        end;

        if (tick_diff(g_dwLatestNoGroupSpellTick, MyGetTickCount) <= 6000) and //(tick_diff(g_dwLatestMagicTick, MyGetTickCount) >= 3000) and
        CanUseMagic and (ActionKey = 0) and CanNextAction(caSpell) and CanNextAction(caHit) and ServerAcceptNextAction(False) and (tempTarget <> nil) and (tempTarget.m_btRace <> 50) and (g_MyHero <> nil) and (not g_MyHero.m_boDeath) and (g_MyHero.m_btAttackMode in [0, 3]) and // 攻击模式，强制攻击模式
        g_ClientConfig.boAutoGroupAttack and (tick_diff(g_LastGroupAttackTick, MyGetTickCount) >= 800) and g_ConfigDlg.ConfigCheckeds[ckAutoGroupAttack] and (THeroActor(g_MyHero).m_nMaxAngryValue > 0) and (THeroActor(g_MyHero).m_nAngryValue >= THeroActor(g_MyHero).m_nMaxAngryValue) and (not ((((tempTarget.m_btRace > RC_PLAYOBJECT) and (tempTarget.m_btRace <> RC_MERCHANT) and (tempTarget.m_btRealRace <> 55) and (not (tempTarget.m_btRealRace in [RC_GUARD, 12, RC_ARCHERGUARD, RC_MOVE_ARCHERGUARD]))) or ((tempTarget.m_btRace = 0) and tempTarget.m_boPlayMoster)) and g_ConfigDlg.ConfigCheckeds[ckAutoGroupNoAttackMon] and g_ClientConfig.boAutoGroupNoAttackMon)) then begin
          if (g_MySelf.m_btJob = 1) then begin
            g_MagicList.Lock;
            try
              for I := 0 to g_HeroMagicList.Count - 1 do begin
                Magic := g_HeroMagicList.Items[I];
                if Magic.Def.wMagicId in [62, 64, 65] then begin
                  if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                    g_LastGroupAttackTick := MyGetTickCount;
                    g_MyHero.GroupAttack;
                    //THeroActor(g_MyHero).m_nAngryValue := 0;
                  end;
                  Break;
                end;
              end;
            finally
              g_HeroMagicList.UnLock;
            end;
          end else if (g_MySelf.m_btJob = 2) then begin
            g_MagicList.Lock;
            try
              for I := 0 to g_HeroMagicList.Count - 1 do begin
                Magic := g_HeroMagicList.Items[I];
                if Magic.Def.wMagicId in [61, 63, 64] then begin
                  if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                    g_LastGroupAttackTick := MyGetTickCount;
                    g_MyHero.GroupAttack;
                    //THeroActor(g_MyHero).m_nAngryValue := 0;
                  end;
                  Break;
                end;
              end;
            finally
              g_HeroMagicList.UnLock;
            end;
          end;
        end;
      end;

      // 自动连击 2020-10-27 02:10:36
      if not g_boGJRun then begin
        if (not IsInContinuous {g_boContinuous}) and g_MySelf.m_boTrainingNG and (g_ContinuousMagicList.Count > 0) and g_boCanUseContinuous // 可以使用连击
        and((g_ContinuousMagicOrder[0] > 0) or (g_ContinuousMagicOrder[1] > 0) or (g_ContinuousMagicOrder[2] > 0) or (g_ContinuousMagicOrder[3] > 0))
        and (tick_diff(g_dwContinuousTick, MyGetTickCount) > 1000) and CanUseMagic and (ActionKey = 0) and CanNextAction(caSpell) and CanNextAction(caHit) and ServerAcceptNextAction(False) and g_ClientConfig.boAutoContinueAttack and g_ConfigDlg.ConfigCheckeds[ckAutoContinueAttack] then begin
          tempTarget := nil;

          if g_MySelf.m_btJob = 0 then
            tempTarget := g_TargetCret;

          if tempTarget = nil then begin
            if (g_MagicLockActor <> nil) and (g_MagicLockActor <> g_MySelf) and (g_MagicLockActor <> g_MyHero) then begin
              tempTarget := g_MagicLockActor;
            end else if (g_MagicTarget <> nil) and (g_MagicTarget <> g_MySelf) and (g_MagicTarget <> g_MyHero) then begin
              tempTarget := g_MagicTarget;
            end;
          end;

          if (tempTarget <> nil) and (tempTarget.m_nRecogId <> 0) and (not tempTarget.m_boDeath) and (not IsNpc(tempTarget.m_btRace)) then begin {// 增加(not g_MySelf.m_boUseMagic)，不然可能卡技能 2021-01-15 23:19:29}
            //g_dwContinuousTick := MyGetTickCount;
            DoStartContinuous(tempTarget.m_nCurrX, tempTarget.m_nCurrY);
          end; 
        end;
      end;
    end;
  end;

  //--------------------------------------------------------------------------------------------------

  if (g_TargetCret <> nil) then begin
    // 攻击目标时，按住右键不跑 +(not g_boMouseRightDown) chongchong 2016-12-28
    if PlayScene.IsValidActor(g_TargetCret) and (not g_TargetCret.m_boDeath) and (not g_MySelf.m_boShopStall) {摆摊禁止移动} and (g_MySelf.m_btHorse = 0) and (not g_boMouseRightDown) and (g_MySelf.m_nChangeAppr < 0 {没有变身}) then begin
      FillChar(keyvalue, SizeOf(TKeyBoardState), #0);
      if GetKeyboardState(keyvalue) then begin
        // DScreen.AddChatBoardString('MouseTimerTimer 6', clGreen, clWhite);
        Shift := [];
        if ((keyvalue[VK_SHIFT] and $80) <> 0) then
          Shift := Shift + [ssShift];
        if (not (g_TargetCret.m_btRace in [0, 1]) and (g_TargetCret.m_btRace <> RC_GUARD2) and (g_TargetCret.m_btRace <> RC_MERCHANT) and //(Pos('(', g_TargetCret.m_sUserName) = 0) // 林牢乐绰 各(碍力傍拜 秦具窃)
          (g_TargetCret.m_HumsBBType = bbNo)) or (g_TargetCret.m_nNameColor = ENEMYCOLOR) // 利篮 磊悼 傍拜捞 凳
        or ((PlugInEnabled and g_ClientConfig.boNotNeedShift and g_ConfigDlg.ConfigCheckeds[ckNotNeedShift]) and ((g_ConfigDlg.ConfigCheckeds[ckShiftSwitch] and g_boShift) or (not g_ConfigDlg.ConfigCheckeds[ckShiftSwitch])) and (g_TargetCret.m_btRace <> RC_MERCHANT)) // 免Shift
        or ((ssShift in Shift) and (not FrmDlg.IsInputChatEdit)) then begin
          //DScreen.AddChatBoardString('消息处理间隔:' + IntToStr(MyGetTickCount - LastAttackTick), clWhite, clBlack);
          FrmMain.AttackTarget(g_TargetCret, False);
        end;
      end;
    end;
  end;

  ProcessActionMessages;
end;


