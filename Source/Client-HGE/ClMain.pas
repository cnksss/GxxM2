procedure TfrmMain.ProcessMessageLockUser(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
begin
  if DefMsg.Param = 1 then begin
    g_boMySelfLock := True;

    if Length(sData) > 0 then begin
      sData := DecodeString(sData);
      DScreen.AddChatBoardString(sData, clWhite, clRed);
    end;

    if g_MySelf <> nil then begin
      //g_MySelf.m_nCurrentAction := 0;
      g_MySelf.CancelAction;
      g_MySelf.m_boWarMode := False;
      g_MySelf.CalcActorFrame;
      g_MySelf.ActionChanged;

      // 解除动作锁定，不然要等一会才能动作 chongchong 2014-12-16
      EnterCriticalSection(FCSActionLock);
      try
        FActionLock := False;
      finally
        LeaveCriticalSection(FCSActionLock);
      end;
    end;
  end
  else begin
    g_boMySelfLock := False;
    DScreen.AddChatBoardString('解除锁定', clWhite, clGreen);
  end;
end;

procedure TfrmMain.ProcessMessageBagUseItem(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
begin
  if DefMsg.Series = 0 then begin
    for I := Low(g_ItemArr) to High(g_ItemArr) do begin
      if (g_ItemArr[I].S.Name <> '') and (g_ItemArr[I].MakeIndex = DefMsg.Recog) then begin
        g_ItemArr[I].Dura := DefMsg.Param;
        Break;
      end;
    end;

    {
    if DefMsg.Recog = g_EatingItem.MakeIndex then
    begin
      g_EatingItem.Dura := DefMsg.Param;
      g_EatingItem.DuraMax := DefMsg.Tag;

      IsChangeWeight := LoByte(DefMsg.Series);
      NewWeight := HiByte(DefMsg.Series);

      if IsChangeWeight = 1 then
      begin
        g_EatingItem.s.Weight := NewWeight;
      end;
    end;
    }
  end
  else if DefMsg.Series = 2 then begin
    DScreen.AddChatBoardString(Format(DecodeResStr(SStoneMsg1), [g_ClientConfig.nItemFluteStoneCount]), clWhite, clRed);
    Exit;
  end
  else if DefMsg.Series = 3 then begin
    DScreen.AddChatBoardString(Format(DecodeResStr(SStoneMsg2), [g_ClientConfig.nItemFluteStoneIdxCount]), clWhite, clRed);
    Exit;
  end
  else if DefMsg.Series = 4 then begin
    FrmDlg.DMessageDlg('没有可镶嵌宝石的位置', [mbOK]);
  end;
end;

