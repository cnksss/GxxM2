procedure TfrmMain.ProcessMessageRunGateVerifyCode(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Source:TDIB;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  d, d1:TTexture;
begin
  if (DefMsg.Recog > 0) and (DefMsg.Recog = Length(sData)) then begin
    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));

    Source := TDIB.Create;
    Source.PixelFormat := MakeDIBPixelFormat(8, 8, 8);
    Source.SetSize(170, 70, 24);

    if Assigned(g_AntiPlugNotifyFunc) then begin
      g_AntiPlugNotifyFunc(event_Recv_VerifyCode, nil, 2);
    end;

    Move(OutBuf[SizeOf(TBitmapFileHeader) + SizeOf(TBitmapInfoHeader)], Source.PBits^, Source.Size);
    d := NewTexture(Source);
    if d <> nil then begin
      {$IF IsMultiThreadRender = 1}
      EnterCriticalSection(g_CriticalSection);
      try
        {$IFEND}
        d1 := g_RandomCodeSurface[rctLogin];
        g_RandomCodeSurface[rctLogin] := d;
        {$IF IsMultiThreadRender = 1}
      finally
        LeaveCriticalSection(g_CriticalSection);
      end;
      {$IFEND}

      d1.Free;
    end;
    Source.Free;
  end;

  TSerialWindows(FrmDlg).DEditVerifyCode.Text := '';
  TSerialWindows(FrmDlg).DVerifyCodeDlg.Left := (g_nScreenWidth - TSerialWindows(FrmDlg).DVerifyCodeDlg.Width) div 2;
  TSerialWindows(FrmDlg).DVerifyCodeDlg.Top := (g_nScreenHeight - TSerialWindows(FrmDlg).DVerifyCodeDlg.Height) div 2 + 50;
  TSerialWindows(FrmDlg).DVerifyCodeDlg.Visible := True;
end;

procedure TfrmMain.ProcessMessageRunGateVerifyCodeCheckRet(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
begin
  // chongchong 2018-02-10 去劫持
  {$I VMProtectBegin.inc}
  if DefMsg.Param = 1 then begin
    TSerialWindows(FrmDlg).DVerifyCodeDlg.Visible := False;
