procedure TfrmMain.ProcessMessageFilterItemList(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, II:Integer;
  List:TPointDropItemList;
  DropItem:pTDropItem;
  SL:TStringList;
begin
  if (DefMsg.Series = 0) or (Length(sData) > 0) then begin
    g_FilterItemsCRC := BufferCrc(PChar(sData), Length(sData));

    g_ConfigDlg.ClearShowItem;

    g_DropItemsMgr.Lock;
    try
      for I := g_DropItemsMgr.Count - 1 downto 0 do begin
        List := g_DropItemsMgr.Items[I];
        for II := 0 to List.Count - 1 do begin
          DropItem := List.Items[II];
          DropItem.ItemTexture := nil;
          DropItem.NameImageInfo.Width := 0;
          DropItem.NameImageInfo.Height := 0;
          DropItem.NameImageInfo.ImageIndexs := nil;
          DropItem.ShowItem := nil;
          DropItem.ShowName := False;
        end;
      end;
    finally
      g_DropItemsMgr.UnLock;
    end;

    if (DefMsg.Recog > 0) and (DefMsg.Recog = Length(sData)) then begin
      sData := zLibDecompressString(sData);
      SL := TStringList.Create;
      try
        SL.Text := sData;
        g_FileItemDB.LoadFormList(SL, True);
      finally
        SL.Free;
      end;
    end;

    if PlugInEnabled then begin
      g_DropItemsMgr.Lock;
      try
        for I := g_DropItemsMgr.Count - 1 downto 0 do begin
          List := g_DropItemsMgr.Items[I];
          for II := 0 to List.Count - 1 do begin
            DropItem := List.Items[II];
            DropItem.ShowItem := g_ConfigDlg.GetShowItem(DropItem.DBName);
          end;
        end;
      finally
        g_DropItemsMgr.UnLock;
      end;
    end;
    g_ConfigDlg.RefShowItem;
  end;

  if DefMsg.Series > 0 then begin
    g_nShowClientDataFileProgress := DefMsg.Series;
    //OutputDebugString(PChar('正在加载资源' + IntToStr(g_nShowClientDataFileProgress)));
    RenderEvent(Self);
    Application.ProcessMessages;
  end;
end;

