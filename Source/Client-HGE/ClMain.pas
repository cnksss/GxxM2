  function GetItemControl(btControlID:Byte; nMakeIndex:Integer; var R:TRect):Boolean;
  var
    I, Idx, nX, nY:Integer;
    D:TDxControl;
    Grid:TDxImageGrid;
  begin
    Result := False;
    case btControlID of
      0:begin
          Grid := TDxImageGrid(TSerialWindows(FrmDlg).DItemGrid);
          if not Grid.Visible or not Grid.Owner.Visible then
            Exit;
          for I := Low(g_ItemArr) to High(g_ItemArr) - 1 do begin
            if (g_ItemArr[I].MakeIndex = nMakeIndex) and (g_ItemArr[I].S.Name <> '') then begin
              Idx := I - 6;
              if Idx > Grid.ColCount * Grid.RowCount then
                Exit;
              nX := Idx mod Grid.ColCount; //Col 8
              nY := Idx div Grid.ColCount; //Row 5
              R.Left := Grid.VisibleRect.Left + Grid.ColWidth * nX;
              R.Top := Grid.VisibleRect.Top + Grid.RowHeight * nY;
              R.Right := R.Left + Grid.ColWidth;
              R.Bottom := R.Top + Grid.RowHeight;
              Result := True; //TSerialWindows(FrmDlg).DItemGrid;
              Break;
            end;
          end;
        end;
