procedure TfrmMain.ProcessMessageHeroM2SendShopItem(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Data, sUserName:string;
  ClientItem:TClientItem;
begin
  g_nHeroM2SelectRecogId := 0;
  g_HeroM2SelectActor := nil;
  g_HeroM2SelectShopItem.S.Name := '';
  g_HeroM2ShopRemoteMouseItem.S.Name := '';
  SafeFillChar(g_HeroM2ShopRemoteItems, SizeOf(g_HeroM2ShopRemoteItems), #0);
  SafeFillChar(g_HeroM2ShopRemoteItemEffects, SizeOf(g_HeroM2ShopRemoteItemEffects), #0);

  g_nHeroM2SelectRecogId := DefMsg.Recog;
  g_HeroM2SelectActor := PlayScene.FindActor(g_nHeroM2SelectRecogId);
  if g_MySelf <> g_HeroM2SelectActor then begin
    sUserName := '';
    sData := GetValidStr3_Ex(sData, sUserName, '\');

    if Length(sUserName) = 0 then begin
      sUserName := g_HeroM2SelectActor.m_sUserName;
    end;

    while True do begin
      if sData = '' then
        break;
      sData := GetValidStr3_Ex(sData, Data, '/');
      if Data = '' then
        break;
      DecodeString(Data, @ClientItem, SizeOf(TClientItem));
      if ClientItem.S.Name <> '' then
        HeroM2AddRemoteUserShopItem(ClientItem);
    end;

    FrmDlg.OpenDHeroM2ShopRemoteDlg(sUserName);
  end
  else begin
    g_nHeroM2SelectRecogId := 0;
    g_HeroM2SelectActor := nil;
    g_HeroM2SelectShopItem.S.Name := '';
    g_HeroM2ShopRemoteMouseItem.S.Name := '';
    FrmDlg.OpenDHeroM2ShopDlg;
  end;
end;

