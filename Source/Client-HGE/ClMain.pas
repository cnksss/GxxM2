function TfrmMain.TargetInSwordWideAttackRange(ndir:Integer):Boolean; // 半月的范围 有2个怪物可以攻击
var
  nX, nY, nC, n10, nMonCount:Integer;
  Actor1, Actor:TActor;
const
  WideAttack:array[0..2] of Integer = (7, 1, 2);
begin
  Result := False;
  nMonCount := 0;
  GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, ndir, nX, nY);
  Actor1 := PlayScene.FindActorXY(nX, nY);
  if (Actor1 <> nil) and Actor1.m_boDeath then
    Actor1 := nil;
  if (Actor1 <> nil) and IsAttackTarget(Actor1) then begin
    Inc(nMonCount);
  end;

  nC := 0;
  while (True) do begin
    n10 := (ndir + WideAttack[nC]) mod 8;
    GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, n10, nX, nY);
    Actor := PlayScene.FindActorXY(nX, nY);
    if (Actor <> nil) and (not Actor.m_boDeath) and (Actor <> Actor1) and IsAttackTarget(Actor) then begin
      Inc(nMonCount);
      if nMonCount >= 2 then begin
        Result := True;
        break;
      end;
    end;

    Inc(nC);
    if nC >= 3 then
      Break;
  end;
  // DScreen.AddChatBoardString('nMonCount: '+inttostr(nMonCount), clGreen, clWhite);
end;

