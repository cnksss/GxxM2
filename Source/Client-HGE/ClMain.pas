procedure TfrmMain.SendSay(Str:string);
var                                                             
  I:Integer;
  Images:TGameImages;
  Msg:TDefaultMessage;
  Feature:THumFeature;
  nTempX, nTempY:Integer;
  //S2: array[0..5] of Byte;
  //S3: array[0..6] of Byte;
  //RSA: TLbRSA;
  //OutBuf: array[0..128] of Byte;
  //OutBufSize: Integer;
  //IsExit: Boolean;
begin
  if Str <> '' then begin
    if m_boPasswordIntputStatus then begin
      m_boPasswordIntputStatus := False;
      FrmDlg.DEdChat.PasswordChar := #0;
      FrmDlg.HideChatEdit;
      SendPassword(Str, 1);
      Exit;
    end;
    if CompareLstr(Str, '/cmd', Length('/cmd')) then begin
      ProcessCommand(Str);
      Exit;
    end;

    if Str = '/getpakfile' then begin
      Exit;
    end;

    {$IF DEBUG_RUN_DELAY_SELF = 1}
    if Str = '/clearlog' then begin
      g_SelfRunSendMsg.Clear;
      g_SelfRunRecvMsg.Clear;
      g_SelfRunStart.Clear;
      g_SelfRunEnd.Clear;
      Exit;
    end;
    {$IFEND}

    if Str = '/checkbug' then begin
      // g_boShowMemoLog := not g_boShowMemoLog;
      // PlayScene.MemoLog.Clear;
      // PlayScene.MemoLog.Visible := g_boShowMemoLog;
      g_boCheckBug := True;
      DebugOutStr('------------------------------------------------------------');
      DebugOutStr(Format('RenderCode:%d RunCode:%d', [g_nRenderCode, g_nRunCode]));

      DebugOutStr(Format('NULL g_MySelf:%s ActiveControl:%s CanNextAction:%S ServerAcceptNextAction:%S ActionLock:%S ActionLockTime:%d g_ChrAction:%d ActionKey:%d g_nTargetX:%d g_ActionCode:%d', [BoolToStr(g_MySelf <> nil), BoolToStr(FrmDlg.DBackground.ActiveControl <> nil), BoolToStr(CanNextAction), BoolToStr(ServerAcceptNextAction(False)), BoolToStr(FActionLock), MyGetTickCount - ActionLockTime, Integer(g_ChrAction), ActionKey, g_nTargetX, g_ActionCode]));

      if g_MySelf <> nil then begin
        Move(g_MySelf.m_Feature.Buffer, Feature, SizeOf(Feature));
        // Feature := THumFeature(g_MySelf.m_Feature.Buffer);
        with Feature do
          DebugOutStr(Format('g_MySelf Dir:%d X:%d Y:%d CurrentAction:%d  wRace:%d ' + 'Level:%d ' + 'HP:%d ' + 'MaxHP:%d ' + 'MP:%d ' + 'MaxMP:%d ' + 'wWeapon:%d ' + // 武器
            'wDress:%d ' + // 衣服
            'btGender:%d ' + 'btJob:%d ' + 'btHair:%d ' + 'btHorseType:%d ' + 'btCaseltGuild:%d ' + // 1=沙行会成员 //2=沙行会掌门
            'boShopStall:%d ' + // 摆摊
