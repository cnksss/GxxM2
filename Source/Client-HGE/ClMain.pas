        if ((DefMsg.Ident = CM_RUN) or (DefMsg.Ident = CM_WALK) or (DefMsg.Ident = CM_TURN) or (DefMsg.Ident = CM_PICKUP)) and (Length(LegendMap.RunPath) > 0) then
        begin

        end

        // 战士攻击练功师后，最小化
        else if (
            (DefMsg.Ident = CM_HIT) or
            (DefMsg.Ident = CM_HEAVYHIT) or
            (DefMsg.Ident = CM_BIGHIT) or
            (DefMsg.Ident = CM_POWERHIT) or
            (DefMsg.Ident = CM_LONGHIT) or
            (DefMsg.Ident = CM_WIDEHIT) or
            (DefMsg.Ident = CM_FIREHIT) or
            (DefMsg.Ident = CM_CRSHIT) or
            (DefMsg.Ident = CM_TWNHIT) or
            (DefMsg.Ident = CM_43HIT) or
            (DefMsg.Ident = CM_SWORDHIT) or
            (DefMsg.Ident = CM_113HIT) or
            (DefMsg.Ident = CM_115HIT) or
            (DefMsg.Ident = CM_66HIT) or
            (DefMsg.Ident = CM_66HIT1) or
            ((DefMsg.Ident >= CM_CUSTOM_HIT1) and (DefMsg.Ident <= CM_CUSTOM_HIT100))
          ) and (g_TargetCret <> nil) then
        begin

        end
        else if Assigned(g_AntiPlugNotifyFunc) then
        begin
          g_AntiPlugNotifyFunc(event_SocketDataAbnormal, nil, DefMsg.Ident);
          Exit;
        end;
      end;
    end;
    *)

    EnterCriticalSection(g_SendSocketLock);
    try
      sSendText := '#' + IntToStr(g_btCode) + SendText + '!';
     
      if g_SendStream.Position > g_SendStream.Length then begin
        g_SendStream.Write(sSendText[1], Length(sSendText));
      end else begin
        nSendLen := CSocket.Socket.SendText(sSendText);
        if nSendLen = SOCKET_ERROR then begin
          LastError := WSAGetLastError;
          if (LastError = WSAEWOULDBLOCK) then begin // 缓存满
            g_SendStream.Write(sSendText[1], Length(sSendText));
          end else begin
            DebugOutStr('SendSocket Error, Code: ' + IntToStr(LastError) + ', Length: ' + IntToStr(nSendLen));
          end;
        end;
      end;

      Inc(g_btCode);
      if g_btCode >= 10 then begin
          g_btCode := 1;
      end;
    finally
      LeaveCriticalSection(g_SendSocketLock);
    end;
  end;
end;

