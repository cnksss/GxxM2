function GetAlignedSize(Origin:Int64):int64;
begin
  result := (Origin + 32 - 1) div 32 * 32;
end;

function GetAlignedSize2(Origin:Integer):Integer;
begin
  Result := (((Origin * 32) + 31) div 32) * 4;
end;

procedure TfrmMain.ProcessMessageSendMyMagic(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  pcm:PTClientMagic;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  Buffer:Pointer;
begin
  g_MagicList.Lock;
  try
    FrmDlg.ClearScreenMagicButtons;

    for I := 0 to g_MagicList.Count - 1 do begin
      Dispose(PTClientMagic(g_MagicList.Items[I]));
    end;
    g_MagicList.Clear;
  finally
    g_MagicList.UnLock;
  end;

  g_MagicNGList.Lock;
  try
    for I := 0 to g_MagicNGList.Count - 1 do begin
      Dispose(PTClientMagic(g_MagicNGList.Items[I]));
    end;
    g_MagicNGList.Clear;
  finally
    g_MagicNGList.UnLock;
  end;

  g_ContinuousMagicList.Lock;
  try
    for I := 0 to g_ContinuousMagicList.Count - 1 do begin
      Dispose(PTClientMagic(g_ContinuousMagicList.Items[I]));
    end;
    g_ContinuousMagicList.Clear;
  finally
    g_ContinuousMagicList.UnLock;
  end;
  // Showmessage(inttostr(Length(body)) + ' ' + inttostr(Msg.Param) + ' Count:' + inttostr(Msg.Series)+ ' SizeOf(TClientMagic):' + inttostr(SizeOf(TClientMagic)));

  if DefMsg.Param = Length(sData) then begin
    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));

    Buffer := @OutBuf;
    for I := 0 to DefMsg.Series - 1 do begin
      New(pcm);
      // GetMem(pcm, GetAlignedSize2(SizeOf(TClientMagic)));
      Move(Buffer^, pcm^, SizeOf(TClientMagic));
      Buffer := Pointer(Integer(Buffer) + SizeOf(TClientMagic));
      if pcm.dwLastUseTick > 0 then begin
        pcm.dwLastUseTick := MyGetTickCount - pcm.dwLastUseTick;
      end;

      // 不要转圈了(技能CD时间) chongchong 2018-07-13 13:22:46
      //if not CheckIsCustomMagic(pcm.Def.wMagicId) then
      //begin
      //  pcm.dwInterval := 0;
      //end;
      {MemoryStream:=TMemoryStream.Create;
      MemoryStream.Write(pcm^, SizeOf(TClientMagic));
      MemoryStream.SaveToFile(IntToStr(Integer(g_MagicList))+'.dat');
      MemoryStream.Free;}
      // DebugOutStr('ProcessMessageSendMyMagic:'+IntToStr(Integer(g_MagicList))+' pcm:'+IntToStr(Integer(pcm)));
      case pcm.Def.MagicAttr of
        mtHum:begin
            g_MagicList.Lock;
            try
              g_MagicList.Add(pcm);
            finally
              g_MagicList.UnLock;
            end;

            case pcm.Def.wMagicId of
              26:
                g_nFireHitDelayTime := pcm.dwInterval + 1000; // 烈火
              66:
                g_nKTZHitDelayTime := pcm.dwInterval + 1000; // 开天斩
              42:
                g_n42HitDelayTime := pcm.dwInterval + 1000; // 龙影剑法
              56:
                g_nSwordHitDelayTime := pcm.dwInterval + 1000; // 逐日剑法
              113:
                g_nDKZHitDelayTime := pcm.dwInterval + 1000; // 断空斩
              115:
                g_nXHYJHitDelayTime := pcm.dwInterval + 1000; // 血魄一击
            end;
          end;
        mtContinuous:begin
            g_ContinuousMagicList.Lock;
            try
              g_ContinuousMagicList.Add(pcm);
            finally
              g_ContinuousMagicList.UnLock;
            end;
          end;
        mtDefense, mtAttack:begin
            g_MagicNGList.Lock;
            try
              g_MagicNGList.Add(pcm);
            finally
              g_MagicNGList.UnLock;
            end;
          end;
      end;
    end;
  end;
  // Showmessage(' g_MagicNGList.Count:' + inttostr(g_MagicNGList.Count));

  if (FrmDlg is TSerialWindows) and (g_ClientVersion in [cvSerial, cvMirSequel, cvMirNewUI205]) then begin
    TSerialWindows(FrmDlg).RefreshUpgradeButtons;
    TSerialWindows(FrmDlg).NewStateWindows.RefreshMySelfMagicList;
  end;

  g_ConfigDlg.RefreshMySelfMagicList;

  FrmDlg.LoadMagicButtons;
end;

