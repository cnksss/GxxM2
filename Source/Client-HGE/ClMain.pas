procedure TfrmMain.ProcessMessageTakeOffFail(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  n:Integer;
begin
  if g_WaitingUseItem.Index < 0 then begin
    n := -(g_WaitingUseItem.Index + 1);
    g_UseItems[n] := g_WaitingUseItem.Item;
  end;
  g_WaitingUseItem.Item.S.Name := '';
end;

procedure TfrmMain.ProcessMessageSendUseItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  Index:Integer;
  cu:PTClientItem;
  P:PChar;
begin
  SafeFillChar(g_UseItems, SizeOf(g_UseItems), #0);

  if (DefMsg.Param = Length(sData)) and (DefMsg.Param = DefMsg.Series * (SizeOf(TClientItem) + 1)) then begin
    P := PChar(sData);
    for I := 0 to DefMsg.Series - 1 do begin
      Index := Ord(P^);
      Inc(P);
      cu := PTClientItem(P);
      Inc(P, SizeOf(TClientItem));
      if Index in [Low(TUseItems)..High(TUseItems)] then begin
        g_UseItems[Index] := cu^;
      end;
    end;
  end;
end;

