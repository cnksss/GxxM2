procedure FreeMemorys;
var
  I:Integer;
  Actor:TActor;
  MagicEff:TMagicEff;
  Event:TClEvent;
  dwTimeTick:longword;
begin
  if MyGetTickCount - g_dwFreeActorTick > 1000 then begin
    g_dwFreeActorTick := MyGetTickCount;
    dwTimeTick := MyGetTickCount;
    if TryEnterCriticalSection(g_FreeMemorysLock) then begin
      try
        for I := g_FreeActorList.Count - 1 downto 0 do begin
          Actor := TActor(g_FreeActorList.Items[I]);
          if MyGetTickCount - Actor.m_dwDeleteTime > 1000 * 15 then begin
            g_FreeActorList.Delete(I);
            try
              Actor.Free;
            except
              on E:Exception do begin
                DebugOutStr('[Exception] Actor.Free');
                DebugOutStr(E.Message);
              end;
            end;
          end;
          if (MyGetTickCount - dwTimeTick) > 6 then begin
            Break;
          end;
        end;

        dwTimeTick := MyGetTickCount;
        EnterCriticalSection(g_FreeMemorysLock);
        try
          for I := g_FreeEffectList.Count - 1 downto 0 do begin
            MagicEff := TMagicEff(g_FreeEffectList.Items[I]);
            if MyGetTickCount - MagicEff.m_dwGhostTick > 1000 * 15 then {// 改短时间 chongchong 2016-02-17 // 1000 * 15}  begin
              g_FreeEffectList.Delete(I);
              try
                MagicEff.Free;
              except
                on E:Exception do begin
                  DebugOutStr('[Exception] MagicEff.Free');
                  DebugOutStr(E.Message);
                end;
              end;
            end;
            if (MyGetTickCount - dwTimeTick) > 6 then begin
              Break;
            end;
          end;
        finally
          LeaveCriticalSection(g_FreeMemorysLock);
        end;

        dwTimeTick := MyGetTickCount;
        for I := g_FreeEventList.Count - 1 downto 0 do begin
          Event := TClEvent(g_FreeEventList.Items[I]);
          if MyGetTickCount - Event.m_dwGhostTick > 1000 * 15 then {// 改短时间 chongchong 2016-02-17 // 1000 * 15}  begin
            g_FreeEventList.Delete(I);
            try
              Event.Free;
            except
              on E:Exception do begin
                DebugOutStr('[Exception] Event.Free');
                DebugOutStr(E.Message);
              end;
            end;
          end;
          if (MyGetTickCount - dwTimeTick) > 6 then begin
            Break;
          end;
        end;
      finally
        LeaveCriticalSection(g_FreeMemorysLock);
      end;
    end;
  end;

  // 修改释放间隔  chongchong 2016-02-23  1500
  if MyGetTickCount - g_dwFreeOldMemorysTick > 1000 then begin
    g_dwFreeOldMemorysTick := MyGetTickCount;
    g_ImageEvent.FreeOldMemorys;

    // 修复npc对话框乱码 ??????? chongchong 2014-10-29
    TextureFonts.FreeOldMemorys;
  end;
end;

procedure TRender.Execute;
begin
  while not (Application.Terminated or Terminated) do begin
    if g_boAppExit then
      break;

    try
      frmMain.ProcessEvent(Self);
    except
      on E:Exception do begin
        DebugOutStr('[Exception] ProcessEvent');
        DebugOutStr(E.Message);
      end;
    end;

    if (MyGetTickCount - g_dwRunTick >= 10) then begin
      g_dwRunTick := MyGetTickCount;
      {$IF IsMultiThreadRender = 1}
      EnterCriticalSection(g_CriticalSection);
      {$IFEND}
      frmMain.TimerEvent(Self);
      {$IF IsMultiThreadRender = 1}
      LeaveCriticalSection(g_CriticalSection);
      {$IFEND}
      try
        FreeMemorys;
      except
        on E:Exception do begin
          DebugOutStr('[Exception] FreeMemorys');
          DebugOutStr(E.Message);
        end;
      end;
    end
    else begin
      Sleep(1);
    end;
  end;
end;

