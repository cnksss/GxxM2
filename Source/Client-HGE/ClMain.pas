  if DefMsg.Series = 0 then begin
    ClientFeatureChanged(g_MySelf, sData);
    if g_WaitingUseItem.Index in [Low(TUseItems)..High(TUseItems)] then begin
      g_UseItems[g_WaitingUseItem.Index] := g_WaitingUseItem.Item;
