        if mrYes <> FrmDlg.DMessageDlg('是否确认开始练习 "' + g_HeroEatingItem.S.Name + '"？', [mbYes, mbNo]) then begin
          AddHeroItemBag(g_HeroEatingItem);
          g_HeroEatingItem.S.Name := '';
          Exit;
        end;
      end
      else begin
        if mrYes <> FrmDlg.DMessageDlg('是否确认开始练习 "' + g_HeroEatingItem.S.Name + '"？.', [mbYes, mbNo]) then begin
          AddHeroItemBag(g_HeroEatingItem);
          g_HeroEatingItem.S.Name := '';
          Exit;
        end;
      end;
    end;

    // 传送系列物品使用不要间隔 2018-07-11 17:20:11
    if ((g_HeroEatingItem.s.StdMode = 2) and (g_HeroEatingItem.s.Shape in [1, 2, 3])) or // 传送石系列
    ((g_HeroEatingItem.s.StdMode = 3) and (g_HeroEatingItem.s.Shape in [1, 2, 3, 5])) then {// 传送卷系列}  begin
      TimeInterval := 0
    end
    else begin
      TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].Other;
      if (g_HeroEatingItem.s.StdMode = 0) then begin
        if g_HeroEatingItem.s.Shape <> 1 then {// 普通药物}  begin
          if (g_HeroEatingItem.s.AC1 > 0) and (g_HeroEatingItem.s.MAC1 > 0) then
            TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].NormalHPMP
          else if (g_HeroEatingItem.s.MAC1 > 0) then
            TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].NormalMP
          else
            TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].NormalHP;
        end
        else {// 特殊药物}  begin
          if (g_HeroEatingItem.s.AC1 > 0) and (g_HeroEatingItem.s.MAC1 > 0) then
            TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].SpecialHPMP
          else if (g_HeroEatingItem.s.MAC1 > 0) then
            TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].SpecialMP
          else
            TimeInterval := g_EatItemCDConfig.Hero[g_MyHero.m_btJob].SpecialHP;
        end;
      end;
    end;

    if (MyGetTickCount - g_dwHeroEatTime < Cardinal(TimeInterval)) then begin
      AddHeroItemBag(g_HeroEatingItem);
      g_HeroEatingItem.s.Name := '';
      Exit;
    end
    else begin
      g_dwHeroEatTime := MyGetTickCount;
      SendHeroEat(g_HeroEatingItem.MakeIndex, g_HeroEatingItem.S.Name);
      ItemUseSound(g_HeroEatingItem.S);
    end;

    // 加入英雄手动吃药自动解包 chongchong 2015-02-07
    if PlugInEnabled and g_ClientConfig.boAutoOrderItem and g_ConfigDlg.ConfigCheckeds[ckAutoOrderItem] then begin
      boFind := False;
      // if (g_MovingItem.Index >= 0) and (g_MovingItem.Index <= 5) then begin //自动放药
      for I := Low(g_HeroItemArr) to High(g_HeroItemArr) do begin
        if g_HeroItemArr[I].S.Name <> '' then begin
          if CompareText(g_HeroItemArr[I].S.Name, g_HeroEatingItem.S.Name) = 0 then begin
            boFind := True;
            Break;
          end;
        end;
      end;

      if (not boFind) and (g_MyHero <> nil) then begin // 查找解包
        if g_MyHero.m_nBagCount - HeroBagItemCount >= 6 then begin
          if (FindHeroBindItemIndex(g_HeroEatingItem.S.Name) >= 0) then begin
            SendDelayMsg(g_MySelf, RCM_UNBINDITEM, 0, 1, 0, 0, g_HeroEatingItem.S.Name, 1000);
          end;
        end;
      end;
    end;
  end
  else if idx in [0..MAX_HERO_BAG_ITEM - 1] then begin
    if (g_HeroEatingItem.S.Name <> '') and (MyGetTickCount - g_dwHeroEatTime > 5 * 1000) then begin
      g_HeroEatingItem.S.Name := '';
    end;
    if (g_HeroEatingItem.S.Name = '') and (g_HeroItemArr[idx].S.Name <> '') and ((g_HeroItemArr[idx].S.StdMode <= 3) or (g_HeroItemArr[idx].S.StdMode = 60)) then begin
      g_HeroEatingItem := g_HeroItemArr[idx];
      g_HeroItemArr[idx].S.Name := '';
      if (g_HeroItemArr[idx].S.StdMode = 4) and (g_HeroItemArr[idx].S.Shape < 100) then begin
        if g_HeroItemArr[idx].S.Shape < 50 then begin
          if mrYes <> FrmDlg.DMessageDlg('是否确认开始练习 "' + g_HeroItemArr[idx].S.Name + '"？,', [mbYes, mbNo]) then begin
            g_HeroItemArr[idx] := g_HeroEatingItem;
