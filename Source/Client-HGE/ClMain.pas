      g_JewelryBoxItems[DefMsg.param - U_JEWELRYITEM1].Dura := DefMsg.Recog;
      g_JewelryBoxItems[DefMsg.param - U_JEWELRYITEM1].DuraMax := MakeLong(DefMsg.tag, DefMsg.series);
    end;
  end
  else if DefMsg.Param in [U_GODBLESSITEM1..U_GODBLESSITEM12] then begin
    if g_GodBlessItems[DefMsg.param - U_GODBLESSITEM1].S.Name <> '' then begin
      g_GodBlessItems[DefMsg.param - U_GODBLESSITEM1].Dura := DefMsg.Recog;
      g_GodBlessItems[DefMsg.param - U_GODBLESSITEM1].DuraMax := MakeLong(DefMsg.tag, DefMsg.series);
    end;
  end;
end;

procedure TfrmMain.ProcessMessageMerchantSay(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  sNpcName:string;
  boTemp:Boolean;
begin
  // 临时保存NPC窗口是否移动 -- piaoyun 2013-09-10
  boTemp := boNpcDlgCanMove;

  // 点击使用自定义大对话框[OPENMERCHANTBIGDLG], 没有点击过普通NPC，直接通过命令行调用FQ或QM脚本，不换回小对话框 chongchong 2014-04-27
  if (MyGetTickCount - g_dwOpenMerchantBigDlgTick > 2000) and (not g_boKeepBigDlg) then begin
    g_boOpenMerchantBigDlg := False;
  end;

  //HZQ 20230619 如果不是大对话框，进行对话框还原
  if not g_boOpenMerchantBigDlg then begin
    FrmDlg.RestoreDMerchantDlg;
  end;

  g_nMDlgX := g_MySelf.m_nCurrX;
  g_nMDlgY := g_MySelf.m_nCurrY;
  if DefMsg.Recog = g_nMissionMerchant then begin
    if Pos(#13, sData) > 0 then begin
      sData := GetValidStr3_Ex(sData, sNpcName, #13)
    end else begin
      sNpcName := '';
    end;

    for I := 0 to g_MissionPageCaptionList.Count - 1 do begin
      if (CompareText(sNpcName, '@' + g_MissionPageCaptionList.Strings[I]) = 0) then begin
        FrmDlg.AddMissionMemo1(I, sData);
        Exit;
      end;
    end;
    FrmDlg.AddMissionMemo2(sData);
  end else begin
    FrmDlg.CloseDPleaseDrinkWineDlg;
    FrmDlg.CloseDGuessfingerDlg;
    if g_nCurMerchant <> DefMsg.Recog then begin
      CancelUpgradeItem(DefMsg.Recog);
      FrmDlg.ResetMenuDlg;
      FrmDlg.CloseMDlg;
    end;
    // 还原NPC窗口是否移动 -- piaoyun 2013-09-10
    boNpcDlgCanMove := boTemp;

    if Pos(#13, sData) > 0 then begin
      sData := GetValidStr3_Ex(sData, sNpcName, #13)
    end else begin
      sNpcName := '';
    end;
    // saying := GetValidStr3_Ex(saying, npcname, #13);
    FrmDlg.ShowMDlg(DefMsg.param, sNpcName, sData, not g_boOpenMerchantBigDlg); //打开NPC对话框
  end;
end;

