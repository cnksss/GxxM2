procedure TfrmMain.SendUploadPickItemsConfig;
var
  I, Count, ItemIdx:Integer;
  ShowItem:pTShowItem;
  Buf:PChar;
  BufSize:Integer;
  NGItem:PWord;
  TempHash:LongWord;
  IsAddGold:Boolean;
  Msg:TDefaultMessage;
  S:string;
begin
  if not g_boUploadClientPickItems then
    Exit;
  if not g_IsClientPickItemsChanged then
    Exit;
  if tick_diff(g_UploadPickItemsTick, MyGetTickCount) <= g_dwUploadClientPickItemsTime then
    Exit;

  Count := 0;
  IsAddGold := False;

  BufSize := MAX_UPLOAD_PICKITEMS * SizeOf(Word); //  最多上传条数 5120
  GetMem(Buf, BufSize);
  try
    NGItem := PWord(Buf);
    for I := 0 to g_FileItemDB.m_ShowItemList.Count - 1 do begin
      ShowItem := g_FileItemDB.m_ShowItemList.Items[I];
      ItemIdx := GetItemIdxByName(ShowItem.sItemName);
      if (ShowItem.boShowSpecial or ShowItem.boPickup) then begin
        if (ItemIdx > 0) or (WideSameStr(ShowItem.sItemName, '金币') and (not IsAddGold)) then begin
          if ItemIdx = 0 then
            IsAddGold := True;

          // 用了2bit, 还有 14bit 支持 16384
          NGItem^ := ItemIdx;

          if ShowItem.boShowSpecial then
            NGItem^ := NGItem^ or $8000; // 第1bit为标记

          if ShowItem.boPickup then
            NGItem^ := NGItem^ or $4000; // 第2bit为标记

          Inc(NGItem);
          Inc(Count);

          if (Count + 1) * SizeOf(Word) > BufSize then begin
            //OutputDebugString(PChar(IntToStr(Count)));
            Break;
          end;
        end;
      end;
    end;

    TempHash := DJBHash(System.PByte(Buf), Count * SizeOf(Word));

    if Count > 0 then begin
      if TempHash <> g_UploadPickItemsHash then begin
        S := zLibEncodeBuffer(Buf, Count * SizeOf(Word));

        Msg := MakeDefaultMsg(CM_UPLOAD_PICK_ITMES, DJBHash(@S[1], Length(S)), Count, 0, 0);
        SendSocket(EncodeMessage(Msg) + S);

        g_UploadPickItemsHash := TempHash;
      end;
    end
    else begin
      Msg := MakeDefaultMsg(CM_UPLOAD_PICK_ITMES, 0, 0, 0, 0);
      SendSocket(EncodeMessage(Msg));
    end;

    g_UploadPickItemsTick := MyGetTickCount;
    g_IsClientPickItemsChanged := False;
  finally
    FreeMem(Buf);
  end;
end;

procedure TfrmMain.UnLockAction;
begin
  EnterCriticalSection(FCSActionLock);
  try
    FActionLock := False;
  finally
    LeaveCriticalSection(FCSActionLock);
  end;
end;


