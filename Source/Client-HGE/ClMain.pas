procedure TfrmMain.ProcessMessageUnBindList(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  UnbindItem:pTUnbindItem;
  InBuf:array[0..102400] of Char;
  Buffer:PChar;
begin
  for I := 0 to g_UnbindItemList.Count - 1 do begin
    Dispose(pTUnbindItem(g_UnbindItemList.Items[I]));
  end;
  g_UnbindItemList.Clear;
  // List := TStringList.Create;
  if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
    zLibDecompressString(sData, @InBuf, SizeOf(InBuf));
    Buffer := @InBuf;
    for I := 0 to DefMsg.Series - 1 do begin
      New(UnbindItem);
      Move(Buffer^, UnbindItem^, SizeOf(TUnbindItem));
      g_UnbindItemList.Add(UnbindItem);
      Buffer := Buffer + SizeOf(TUnbindItem);
      // List.Add(UnbindItem.sItemName);
    end;
  end;

  for I := 0 to ConfigDlgManage.ConfigDlgList.Count - 1 do begin
    TGameConfigObject(ConfigDlgManage.ConfigDlgList.Objects[I]).RefreshUnBindItemList();
  end;
end;

