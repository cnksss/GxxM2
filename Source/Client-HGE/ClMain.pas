procedure TfrmMain.ProcessMessageDelItem(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  MakeIndex:Integer;
  ItemName:string;
begin
  if sData <> '' then begin
    MakeIndex := DefMsg.Recog;
    ItemName := DecodeString(sData);

    if g_WaitingUseItem.Item.MakeIndex = MakeIndex then
      g_WaitingUseItem.Item.s.Name := '';

    DelItemBag(ItemName, MakeIndex);

    // 修正把物品放到升级框中，然后点npc执行脚本 take xxxx，回收物品后升级框中的还显示 chongchong 2015-05-27
    for I := Low(g_UpgradeItemArr) to High(g_UpgradeItemArr) do begin
      if (g_UpgradeItemArr[I].S.Name = ItemName) and (g_UpgradeItemArr[I].MakeIndex = MakeIndex) then
        g_UpgradeItemArr[I].S.Name := '';
    end;

    for I := Low(TUseItems) to High(TUseItems) do begin
      if (g_UseItems[I].S.Name = ItemName) and (g_UseItems[I].MakeIndex = MakeIndex) then begin
        g_UseItems[I].S.Name := '';
      end;
    end;

    for I := Low(TJewelryBoxItems) to High(TJewelryBoxItems) do begin
      if (g_JewelryBoxItems[I].S.Name = ItemName) and (g_JewelryBoxItems[I].MakeIndex = MakeIndex) then begin
        g_JewelryBoxItems[I].S.Name := '';
      end;
    end;

    for I := Low(TGodBlessItems) to High(TGodBlessItems) do begin
      if (g_GodBlessItems[I].S.Name = ItemName) and (g_GodBlessItems[I].MakeIndex = MakeIndex) then begin
        g_GodBlessItems[I].S.Name := '';
      end;
    end;
  end;
end;

procedure TfrmMain.ProcessMessageBagItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, II:Integer;
  Word1, Word2:Word;
  cu:pTClientItem;
  S:string;
  NoMove1_6:Boolean;
  IsFound:Boolean;
begin
  Word1 := LoWord(DefMsg.Recog);
  Word2 := HiWord(DefMsg.Recog);

  NoMove1_6 := LoByte(Word1) <> 0;
  g_ExtBagOpenItemCount := HiByte(Word1);

  FrmDlg.FCurrentBagPage := LoByte(Word2);
  FrmDlg.FExtBagPageCount := HiByte(Word2);

  FrmDlg.ResetBagPageButton;

  if NoMove1_6 then begin
    for I := Low(g_SaveItem1_6) to High(g_SaveItem1_6) do begin
      g_SaveItem1_6[I] := g_ItemArr[I];
    end;
  end;

  // 有人闲得蛋疼，在自定义OK框中写刷新包裹的脚本 chongchong 2015-05-26
  for I := Low(g_ItemBoxItems) to High(g_ItemBoxItems) do begin
    g_ItemBoxItems[I].S.Name := '';
  end;

  g_UpgradeItemArr[0].S.Name := '';
  g_UpgradeItemArr[1].S.Name := '';
  g_UpgradeItemArr[2].S.Name := '';

  ClearBag;
  FillChar(g_ItemArr, sizeof(g_ItemArr), #0);

  if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
    S := zLibDecompressString(sData);

    if Length(S) = DefMsg.Series * SizeOf(TClientItem) then begin
      cu := pTClientItem(S);
      for I := 0 to DefMsg.Series - 1 do begin
        IsFound := False;
        for II := 0 to Length(g_GameGoldDealItems) - 1 do begin
          if (Length(g_GameGoldDealItems[II].S.Name) > 0) and (g_GameGoldDealItems[II].MakeIndex = cu.MakeIndex) then begin
            IsFound := True;
            Break;
          end;
        end;

        if not IsFound then
          AddItemBag(cu^, not NoMove1_6);

        Inc(cu);
      end;
    end;
  end;

  // 强制包裹排序 chongchong 2015-01-06
  ArrangeItembag(g_boBagLoaded);

  g_boBagLoaded := True;
end;

