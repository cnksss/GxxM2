                ViewItem := ListItem.AddItem('', nil); // 物品

                ViewItem.ImageIndex.BeginUpdate;
                try
                  ViewItem.ImageIndex.Image := g_WBagItemImages.Indexs[g_SearchUserShopItems[II].Item.s.Looks div 10000];
                  ViewItem.ImageIndex.Up := g_SearchUserShopItems[II].Item.s.Looks mod 10000;
                finally
                  ViewItem.ImageIndex.EndUpdate;
                end;

                ViewItem := ListItem.AddItem('', nil); // 物品名称
                ViewItem.Caption := ProcessItemName(g_SearchUserShopItems[II].Item.s.Name);
                ViewItem.Color.Up.Color := clWhite;
                ViewItem.Color.Hot.Color := clWhite;
                ViewItem.Color.Down.Color := clWhite;

                ViewItem := ListItem.AddItem('', nil); // 物品价格
                case g_SearchUserShopItems[II].btMoneyType of
                  0:
                    ViewItem.Caption := IntToStr(g_SearchUserShopItems[II].Item.s.Price) + ' ' + g_sGameGoldName;
                  1:
                    ViewItem.Caption := IntToStr(g_SearchUserShopItems[II].Item.s.Price) + ' ' + g_sGamePointName;
                  2:
                    ViewItem.Caption := IntToStr(g_SearchUserShopItems[II].Item.s.Price) + ' ' + g_sGoldName;
                  3:
                    ViewItem.Caption := IntToStr(g_SearchUserShopItems[II].Item.s.Price) + ' ' + g_sGameDiamondName;
                  4:
                    ViewItem.Caption := IntToStr(g_SearchUserShopItems[II].Item.s.Price) + ' ' + g_sGameGirdName;
                  else
                    ViewItem.Caption := IntToStr(g_SearchUserShopItems[II].Item.s.Price) + ' ' + GetCustomMoneyNameByRule(g_SearchUserShopItems[II].btMoneyType, 0);
                end;
                ViewItem.Color.Up.Color := clWhite;
                ViewItem.Color.Hot.Color := clWhite;
                ViewItem.Color.Down.Color := clWhite;

                ViewItem := ListItem.AddItem('', nil); // 所在店铺
                ViewItem.Caption := g_SearchUserShopItems[II].sShopName;
                ViewItem.Color.Up.Color := clLime;
                ViewItem.Color.Up.Style := [fsUnderline];
                ViewItem.Color.Hot.Color := clWhite; // clWhite;
                ViewItem.Color.Hot.Style := [fsUnderline];
                ViewItem.Color.Down.Color := clRed;
                ViewItem.Color.Down.Style := [fsUnderline];

                ViewItem := ListItem.AddItem('', nil); // 店主名称
                ViewItem.Caption := g_SearchUserShopItems[II].sMasterName;
                ViewItem.Color.Up.Color := clWhite;
                ViewItem.Color.Hot.Color := clWhite;
                ViewItem.Color.Down.Color := clWhite;

                ViewItem := ListItem.AddItem('', nil); // 物品类别
                ViewItem.Caption := GetUserShopItemType(g_SearchUserShopItems[II].btItemType);
                ViewItem.Color.Up.Color := clWhite;
                ViewItem.Color.Hot.Color := clWhite;
                ViewItem.Color.Down.Color := clWhite;

                ViewItem := ListItem.AddItem('', nil); // 购买
                {
                if CompareText(g_SearchUserShopItems[II].sMasterName, g_MySelf.m_sUserName) = 0 then
                begin
                  ViewItem.Caption := '取回';
                end
                else
                begin
                  ViewItem.Caption := '购买';
                end;
                }

                if g_SearchUserShopItems[I].IsMyShopeItem then
                  ViewItem.Caption := DecodeResStr(SUserShopGetBack)
                else
                  ViewItem.Caption := DecodeResStr(SUserShopBuy);

                if g_SearchUserShopItems[II].sBuyName = '' then begin
                  ViewItem.Color.Up.Color := clLime;
                  ViewItem.Color.Up.Style := [fsUnderline];
                  ViewItem.Color.Hot.Color := clWhite; // clWhite;
                  ViewItem.Color.Hot.Style := [fsUnderline];
                  ViewItem.Color.Down.Color := clRed;
                  ViewItem.Color.Down.Style := [fsUnderline];
                end
                else begin
                  ViewItem.Caption := DecodeResStr(SUserShopSelled);
                  ViewItem.Color.Up.Color := clGray;
                  ViewItem.Color.Hot.Color := clGray;
                  ViewItem.Color.Down.Color := clGray;
                end;
              end;
            end;
          finally
            TSerialWindows(FrmDlg).ListViewGameShopItem.UnLock;
          end;
          break;
        end;
      end;
    end;
  end;
end;

