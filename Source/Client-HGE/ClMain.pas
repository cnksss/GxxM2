procedure TfrmMain.ProcessMessageQuerySelectShopInfo(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  SelectUserShop:PClientUserShop;
  IsMyShop:Boolean;
begin
  if Length(sData) <> SizeOf(TClientUserShop) then
    Exit;

  SelectUserShop := PClientUserShop(sData);

  IsMyShop := DefMsg.Series = 1;

  if IsMyShop then begin
    if DefMsg.Tag = 1 then begin
      FrmDlg.OpenDMyShopDlg(SelectUserShop);
      FrmDlg.CloseDGameShopDlg;

      if g_MyShopItemCounts[0] <= 0 then
        SendQueryMyShopSellingItem(0, 0, 0, 0, 0, '')
      else
        SendClientMessage(CM_GETMYSHOPITEMS, g_MyShopItemIndexs[0], 0, 0, 0);

      if g_MyShopItemCounts[1] <= 0 then
        SendQueryMyShopSelledItem(0, 0, 0, 0, 0, '')
      else
        SendClientMessage(CM_GETMYSHOPITEMS, g_MyShopItemIndexs[1], 1, 0, 0);

      if g_MyShopItemCounts[2] <= 0 then
        SendQueryMyShopStorageItem(0, 0, 0, 0, 0, '')
      else
        SendClientMessage(CM_GETMYSHOPITEMS, g_MyShopItemIndexs[2], 2, 0, 0);
    end;
  end
  else begin
    g_SelectUserShop := SelectUserShop^;

    if DefMsg.Tag = 1 then begin
      SendQueryUserShopItem(0, 0, 0, 0, 0, g_SelectUserShop.sMasterName, '');

      FrmDlg.OpenDUserShopDlg(SelectUserShop);
      FrmDlg.CloseDGameShopDlg;
    end;
  end;
end;

