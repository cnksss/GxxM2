    sData := GetValidStr3(sData, sYes, [#13, #10]);
    sData := GetValidStr3(sData, sNo, [#13, #10]);
    nNpc := DefMsg.Recog;

    sLineText := sMsg;

    // 这里不用再换行了。里面有换行符\的处理 chongchong 2016-08-05
    {
    while Pos('\', sLineText) > 0 do
    begin
      sLineText := AnsiReplaceText(sLineText, '\', #13#10)
    end;
    }

    if (sYes <> '') then begin
      if mrOk = FrmDlg.DMessageDlg(sLineText, [mbOk, mbCancel]) then begin
        SendMerchantDlgSelect(nNpc, sYes);
      end else begin
        if sNo <> '' then
          SendMerchantDlgSelect(nNpc, sNo);
      end;
    end else begin
      FrmDlg.DMessageDlg(sLineText, [mbOk]); //HZQ 20230610 弹出GUI窗口
    end;
    // FrmDlg.DMessageDlg(sLineText, [mbOk]);
  end;
end;

