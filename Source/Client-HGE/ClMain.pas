procedure TfrmMain.ClientGetUseEffects(Msg:pTDefaultMessage; sBody:string);
var
  I, II:Integer;
  ActorEffect:PTActorEffect;
  Effect:pTClientActorEffect;
  Actor:TActor;
  Buffer:PChar;
  IsFound:Boolean;
begin
  Actor := PlayScene.FindActor(Msg.Recog);
  if Actor <> nil then begin
    Actor.m_ActorEffects.Lock;
    try
      for I := 0 to Actor.m_ActorEffects.Count - 1 do begin
        pTClientActorEffect(Actor.m_ActorEffects.Items[I]).boWantDelete := True;
      end;

      if (Msg.Param = Length(sBody)) and (Msg.Series > 0) and (Msg.Param = Msg.Series * SizeOf(TActorEffect)) then begin
        Buffer := PChar(sBody);
        for I := 0 to Msg.Series - 1 do begin
          ActorEffect := PTActorEffect(Buffer);
          if (ActorEffect.nEffectFileIndex >= 0) and (ActorEffect.wEffectImageCount > 0) and (ActorEffect.nLoopCount <> 0) then begin
            IsFound := False;
            for II := 0 to Actor.m_ActorEffects.Count - 1 do begin
              Effect := Actor.m_ActorEffects.Items[II];

              if (Effect.nEffectFileIndex = ActorEffect.nEffectFileIndex) and (Effect.nEffectImageOffSet = ActorEffect.nEffectImageOffSet) and (Effect.wEffectImageCount = ActorEffect.wEffectImageCount) and (Effect.wEffectFrameTime = ActorEffect.wEffectFrameTime) and (Effect.nOldLoopCount = ActorEffect.nLoopCount) and (Effect.btDrawOrder = ActorEffect.btDrawOrder) and (Effect.nOffsetX = ActorEffect.nOffsetX) and (Effect.nOffsetY = ActorEffect.nOffsetY) and (Effect.boBlendMode = ActorEffect.boBlendMode) then begin
                IsFound := True;
                Effect.boWantDelete := False;
                Break;
              end;
            end;

            if not IsFound then begin
              New(Effect);
              Effect.nEffectFileIndex := ActorEffect.nEffectFileIndex;
              Effect.nEffectImageOffSet := ActorEffect.nEffectImageOffSet;
              Effect.wEffectImageCount := ActorEffect.wEffectImageCount;
              Effect.wEffectFrameTime := ActorEffect.wEffectFrameTime;
              Effect.nOldLoopCount := ActorEffect.nLoopCount;
              Effect.nLoopCount := ActorEffect.nLoopCount;
              Effect.btDrawOrder := ActorEffect.btDrawOrder;
              Effect.nOffsetX := ActorEffect.nOffsetX;
              Effect.nOffsetY := ActorEffect.nOffsetY;
              Effect.boBlendMode := ActorEffect.boBlendMode;
              Effect.nOldCurrentFrame := -1;
              Effect.nCurrentFrame := ActorEffect.nEffectImageOffSet;
              Effect.dwEffectTick := MyGetTickCount;
              Effect.Texture := nil;
              Effect.boWantDelete := False;

              Actor.m_ActorEffects.Add(Effect);
            end;
          end;
          Buffer := Buffer + SizeOf(TActorEffect);
        end;
      end;

      for I := Actor.m_ActorEffects.Count - 1 downto 0 do begin
        Effect := Actor.m_ActorEffects.Items[I];
        if Effect.boWantDelete then begin
          Dispose(Effect);
          Actor.m_ActorEffects.Delete(I);
        end;
      end;
    finally
      Actor.m_ActorEffects.UnLock;
    end;
  end
  else begin
    if Msg.Tag = 0 then
      SendDelayMsg(g_MySelf, Msg.Ident, Msg.Param, Msg.Recog, Msg.Tag, Msg.Series, sBody, 2000);
  end;
end;

procedure TfrmMain.ClientGetUseIcons(Msg:pTDefaultMessage; sBody:string);
var
  I, Index:Integer;
  Actor:TActor;
  Buffer:PChar;
begin
  Actor := PlayScene.FindActor(Msg.Recog);
  if Actor <> nil then begin
    with Actor do begin
      FillChar(m_ActorIconIndexs, SizeOf(m_ActorIconIndexs), 0);
      FillChar(m_ActorIcons, SizeOf(m_ActorIcons), 0);
      for I := Low(TActorIconArray) to High(TActorIconArray) do begin
        m_ActorIcons[I].nFileIndex := -1;
        m_ActorIconIndexs[I].nCurrentFrame := -1;
        m_ActorIconIndexs[I].nOCurrentFrame := -1;
        m_ActorIconIndexs[I].nEndFrame := -1;
      end;

      if (Msg.Series > 0) and (Msg.Param = Length(sBody)) and (Msg.Param = (SizeOf(TActorIcon) + 1) * Msg.Series) then begin
        Buffer := PChar(sBody);
        for I := 0 to Msg.Series - 1 do begin
          Index := Ord(Buffer^);
          Inc(Buffer);
          if Index in [Low(TActorIconArray)..High(TActorIconArray)] then begin
            System.Move(Buffer^, m_ActorIcons[Index], SizeOf(TActorIcon));
            m_ActorIconIndexs[Index].nOCurrentFrame := -1;
            m_ActorIconIndexs[Index].nCurrentFrame := m_ActorIcons[Index].nIconIndex;
            m_ActorIconIndexs[Index].nEndFrame := m_ActorIcons[Index].nIconIndex + m_ActorIcons[Index].nIconCount;
            m_ActorIconIndexs[Index].dwLoadTick := 0;
          end;

          Buffer := Buffer + SizeOf(TActorIcon);
        end;
      end;
    end;
  end
  else begin
    if Msg.Tag = 0 then
      SendDelayMsg(g_MySelf, Msg.Ident, Msg.Param, Msg.Recog, Msg.Tag, Msg.Series, sBody, 2000);
  end;
end;

