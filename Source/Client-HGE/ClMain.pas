procedure TfrmMain.ProcessMessageGamePetList(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  GamePetData:TClientGamePetData;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  Buffer:PChar;
  pGamePetData:pTClientGamePetData;
begin
  if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));
    Buffer := @OutBuf;

    g_GamePetList.Lock;
    try
      for I := 0 to g_GamePetList.Count - 1 do begin
        Dispose(PTClientGamePetData(g_GamePetList.Items[I]));
      end;
      g_GamePetList.Clear;

      for I := 0 to DefMsg.Series - 1 do begin
        Move(Buffer^, GamePetData, SizeOf(TClientGamePetData));
        Buffer := Buffer + SizeOf(TClientGamePetData);
        New(pGamePetData);
        FillChar(pGamePetData^, SizeOf(TClientGamePetData), 0);
        pGamePetData^ := GamePetData;
        g_GamePetList.Add(pGamePetData)
      end;
    finally
      g_GamePetList.UnLock;
    end;
  end;
end;

