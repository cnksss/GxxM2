  I:Integer;
  ItemName:string;
  MakeIndex:Integer;
begin
  if sData <> '' then begin
    MakeIndex := DefMsg.Recog;
    ItemName := DecodeString(sData);

    DelHeroItemBag(ItemName, MakeIndex);

    if g_WaitingHeroUseItem.Item.MakeIndex = MakeIndex then
      g_WaitingHeroUseItem.Item.s.Name := '';

    for I := Low(TUseItems) to High(TUseItems) do begin
      if (g_HeroUseItems[I].S.Name = ItemName) and (g_HeroUseItems[I].MakeIndex = MakeIndex) then begin
        g_HeroUseItems[I].S.Name := '';
      end;
    end;

    for I := Low(TJewelryBoxItems) to High(TJewelryBoxItems) do begin
      if (g_HeroJewelryBoxItems[I].S.Name = ItemName) and (g_HeroJewelryBoxItems[I].MakeIndex = MakeIndex) then begin
        g_HeroJewelryBoxItems[I].S.Name := '';
      end;
    end;

    for I := Low(TGodBlessItems) to High(TGodBlessItems) do begin
      if (g_HeroGodBlessItems[I].S.Name = ItemName) and (g_HeroGodBlessItems[I].MakeIndex = MakeIndex) then begin
        g_HeroGodBlessItems[I].S.Name := '';
      end;
    end;
  end;
end;

