procedure TfrmMain.ProcessMessageEffectStep(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Actor:TActor;
  CustomMagicConfig:PClientCustomMagicConfig;
  MagicPlusLevel:TMagicPlusLevel;
begin
  Actor := PlayScene.FindActor(DefMsg.Recog);
  if Actor = nil then
    Exit;
  case DefMsg.Param of
    9999:begin
        // 永恒冰冻
        Actor.m_dwForeverFrozenTick := MyGetTickCount;
        Actor.m_nForeverFrozenIndex := 0;
        Actor.m_boForeverFrozen := True;
        if Actor = g_MySelf then begin
          g_boCanAttack := False;
          g_boCanMove := False;
        end;
      end;
    9998:begin
        // 解除永恒冰冻
        Actor.m_boForeverFrozen := False;
        if Actor = g_MySelf then begin
          g_boCanAttack := True;
          g_boCanMove := True;
        end;
      end;
    9997:begin
        Actor.m_boDingShen := True;
        if Actor = g_MySelf then begin
          g_boCanMove := False;
        end;
      end;
    9996:begin
        Actor.m_boDingShen := False;
        if Actor = g_MySelf then begin
          g_boCanMove := True;
        end;
      end;
    9995:begin
        Actor.m_boTanHuan := True;
        if Actor = g_MySelf then begin
          g_boCanAttack := False;
          g_boCanMove := False;
        end;
      end;
    9994:begin
        Actor.m_boTanHuan := False;
        if Actor = g_MySelf then begin
          g_boCanAttack := True;
          g_boCanMove := True;
        end;
      end;
    9993:begin
        Actor.m_boThunderPalsy := True;
      end;
    9992:begin
        Actor.m_boThunderPalsy := False;
      end;
    9991:begin
        Actor.m_CustomMagicStatusEffect.boShow := False;
        CustomMagicConfig := GetCustomMagicConfig(DefMsg.Tag);
        if (CustomMagicConfig <> nil) then begin
          Actor.m_CustomMagicStatusEffect.m_nGenAniIndex := 0;
          Actor.m_CustomMagicStatusEffect.m_nStruck := 0;

          case DefMsg.Series of
            0:
              MagicPlusLevel := mplNone;
            1..3:
              MagicPlusLevel := mpl1_3;
            4..6:
              MagicPlusLevel := mpl4_6;
            7..9:
              MagicPlusLevel := mpl7_9;
            else
              MagicPlusLevel := mpl7_9;
          end;

          Actor.m_CustomMagicStatusEffect.m_nGenAniTick := timeGetTime;

          Actor.m_CustomMagicStatusEffect.Status1_File := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus1_File;
          Actor.m_CustomMagicStatusEffect.Status1_StartIndex := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus1_StartIndex;
          Actor.m_CustomMagicStatusEffect.Status1_PlayCount := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus1_PlayCount;
          Actor.m_CustomMagicStatusEffect.Status1_EmptyCount := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus1_EmptyCount;
          //Actor.m_CustomMagicStatusEffect.Status1_PlayTime := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus1_PlayTime;
          Actor.m_CustomMagicStatusEffect.Status1_DrawMode := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus1_DrawMode;
          Actor.m_CustomMagicStatusEffect.Status1_CalcDir := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus1_CalcDir;

          Actor.m_CustomMagicStatusEffect.Status2_File := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus2_File;
          Actor.m_CustomMagicStatusEffect.Status2_StartIndex := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus2_StartIndex;
          Actor.m_CustomMagicStatusEffect.Status2_PlayCount := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus2_PlayCount;
          Actor.m_CustomMagicStatusEffect.Status2_EmptyCount := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus2_EmptyCount;
          //Actor.m_CustomMagicStatusEffect.Status2_PlayTime := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus2_PlayTime;
