procedure TfrmMain.ProcessMessageSpecialCmd(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  ClientCmd:pTClientCmd;
  InBuf:array[0..102400] of Char;
  Buffer:PChar;
begin
  if (DefMsg.Series = 0) or (Length(sData) > 0) then begin
    g_SpecialCmdsCRC := BufferCrc(PChar(sData), Length(sData));

    FrmDlg.DSpecialCmdMenu.Items.Clear;
    for I := 0 to g_SpecialCmdList.Count - 1 do begin
      Dispose(pTClientCmd(g_SpecialCmdList.Items[I]));
    end;

    g_SpecialCmdList.Clear;
    if (DefMsg.Recog > 0) and (DefMsg.Recog = Length(sData)) then begin
      DecodeString(sData, @InBuf, SizeOf(InBuf));
      Buffer := @InBuf;
      for I := 0 to DefMsg.Tag - 1 do begin
        New(ClientCmd);
        Move(Buffer^, ClientCmd^, SizeOf(TClientCmd));
        Buffer := Buffer + SizeOf(TClientCmd);
        g_SpecialCmdList.Add(ClientCmd);
        FrmDlg.DSpecialCmdMenu.Items.AddObject(ClientCmd.sCaption, TObject(ClientCmd));
      end;
    end;
  end;

  if DefMsg.Series > 0 then begin
    g_nShowClientDataFileProgress := DefMsg.Series;
    //OutputDebugString(PChar('正在加载资源' + IntToStr(g_nShowClientDataFileProgress)));
    RenderEvent(Self);
    Application.ProcessMessages;
  end;
end;

