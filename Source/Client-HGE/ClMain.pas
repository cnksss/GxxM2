    end
    else if g_FBFailTime > 0 then begin
      g_sFBFailTime := Format(DecodeResStr(SFBMapMsg3), [g_FBFailTime div 1000]);
    end;
  end;

  if (MyGetTickCount - FCheckUpdateConnectTick >= 1000) and (g_nUpdateGatePort > 0) and g_boAutoUpdate and (g_UpdateEngine <> nil) then begin
    FCheckUpdateConnectTick := MyGetTickCount;

    if (not g_UpdateEngine.CheckConnect) and (MyGetTickCount - FTryConnectClientSocketGateTick >= 10000) then begin
