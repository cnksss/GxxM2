procedure TfrmMain.ReConnectClientSocketGate;
var
  Temp:TUpdateEngine;
begin
  if g_UpdateEngine <> nil then begin
    g_boAutoUpdate := False;
    Temp := g_UpdateEngine;
    g_UpdateEngine := nil;

    Temp.ClearRequestList;
    Temp.Free;
  end;

  ClientSocketGate.Active := True;
  FTryConnectClientSocketGateTick := MyGetTickCount;
end;

function MakeByte(a, b:Byte):Byte;
begin
  Result := a or b shl 4;
end;

procedure TfrmMain.SendAddAuctionItem(nMakeIndex, CurrencyType, StartPrice, SellPrice:Integer; TimeIndex:Byte; IsSendBroadcast:Boolean);
var
  Msg:TDefaultMessage;
begin
  if g_MySelf = nil then
    Exit;
  Msg := MakeDefaultMsg(CM_AddAuctionItem, nMakeIndex, LoWord(StartPrice), HiWord(StartPrice), MakeWord(MakeByte(TimeIndex, Integer(IsSendBroadcast)), CurrencyType));
  SendSocket(EncodeMessage(Msg) + IntToStr(SellPrice));
end;

