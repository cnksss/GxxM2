function TfrmMain.EatBindItem(idx:Integer):Boolean;
begin
  Result := False;
  if (idx in [0..GetMaxBagCount - 1]) and (g_WaitingUseItem.Item.s.Name = '') then begin
    if (g_EatingItem.s.Name <> '') and (MyGetTickCount - g_dwEatTime > 5 * 1000) then begin
      g_EatingItem.s.Name := '';
      g_EatingItemIndex := -1;
    end;
    if (g_EatingItem.s.Name = '') then begin
      if (g_ItemArr[idx].S.Name <> '') and ((g_ItemArr[idx].S.StdMode <= 3) or (g_ItemArr[idx].S.StdMode = 31)) then begin
        g_dwEatTime := MyGetTickCount;
        g_EatingItem := g_ItemArr[idx];
        g_EatingItemIndex := idx;
        g_nUnPakItemMakeIndex := g_EatingItem.MakeIndex;
        g_ItemArr[idx].S.Name := '';
        SendEat(g_EatingItem.MakeIndex, g_EatingItem.s.Name);
        Result := True;
      end;
    end;
  end;
end;

