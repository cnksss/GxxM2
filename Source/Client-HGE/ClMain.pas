function TfrmMain.CanUseMagic:Boolean;
var
  dwMagicDelayTime:LongWord;
  IsExit:Boolean;
begin
  Result := False;
  IsExit := False;

  // 战技锁定 chongchong 2017-12-10
  if (g_MySelf.m_nState and $00010000 <> 0) then begin
    IsExit := True;
  end;

  // 骑马不允许攻击 chongchong 2013-10-12
  if g_MySelf.m_btHorse <> 0 then begin
    IsExit := True;
  end;

  // 变身后不允许攻击 2020-08-22 12:19:23
  if (g_MySelf.m_nChangeAppr >= 0) then begin
    IsExit := True;
  end;

  if (not IsExit) and g_boCanAttack then begin
    // 两次魔法攻击之间的间隔时间 piaoyun 2013-07-20
    dwMagicDelayTime := g_ClientConfig.dwMagicHitFrameTime + 50 + g_dwMagicDelayTime;

    // 修正魔法速度以全速为准
    if g_MySelf.m_nSpellSpeed > 0 then begin // 魔法速度
      //HZQ 20230520 g_MySelf.m_nSpellSpeed --> Cardinal(g_MySelf.m_nSpellSpeed)
      dwMagicDelayTime := _Max(dwMagicDelayTime - Cardinal(g_MySelf.m_nSpellSpeed) * g_ClientConfig.dwIncSpellSpeedDecInterval, 0)
    end else if g_MySelf.m_nSpellSpeed < 0 then begin
      //HZQ 20230520 g_MySelf.m_nSpellSpeed --> Cardinal(g_MySelf.m_nSpellSpeed);
      dwMagicDelayTime := _Max(dwMagicDelayTime - Cardinal(g_MySelf.m_nSpellSpeed) * g_ClientConfig.dwIncSpellSpeedDecInterval, 0);
    end;

    //HZQ 20230822 增加一个保底的魔法间隔
    if dwMagicDelayTime < 180 then begin
        dwMagicDelayTime := 180;
    end;

    if (MyGetTickCount - g_dwLatestSpellTick >= dwMagicDelayTime) and (not g_boMapMovingWait) and (*(not g_boContinuous {不在连击}) and *) // 修正为不在连击状态也可以使用魔法  chongchong 2013-11-22
    //(not g_MySelf.m_boCobweb) {没有被蜘蛛网罩住} and
    (g_MySelf.m_nState and $00080000 = 0) {没有冰冻} and (g_MySelf.m_nState and $00010000 = 0) {没有战技锁定} then begin
      Result := True;

      if (g_MySelf.m_nState and $04000000 <> 0) then {被麻痹}
        Result := g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and g_ClientConfig.boParalyCanSpell;
    end;
  end;
end;

