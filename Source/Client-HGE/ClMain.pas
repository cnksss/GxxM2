procedure TfrmMain.ProcessMessageUpdateMagicInterval(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  pcm:PTClientMagic;
begin
  g_MagicList.Lock;
  try
    for I := 0 to g_MagicList.Count - 1 do begin
      pcm := g_MagicList.Items[I];
      if pcm.Def.wMagicId = DefMsg.Param then begin
        pcm.dwInterval := LongWord(DefMsg.Recog);
        pcm.dwRealInterval := pcm.dwInterval;

        case pcm.Def.wMagicId of
          26:
            g_nFireHitDelayTime := pcm.dwInterval + 1000; // 烈火
          66:
            g_nKTZHitDelayTime := pcm.dwInterval + 1000; // 开天斩
          42:
            g_n42HitDelayTime := pcm.dwInterval + 1000; // 龙影剑法
          56:
            g_nSwordHitDelayTime := pcm.dwInterval + 1000; // 逐日剑法
          113:
            g_nDKZHitDelayTime := pcm.dwInterval + 1000; // 断空斩
          115:
            g_nXHYJHitDelayTime := pcm.dwInterval + 1000; // 血魄一击
        end;

        Break;
      end;
    end;
  finally
    g_MagicList.UnLock;
  end;
end;

