            {$IFEND}begin
            {$IF TESTMODE_LOG = 1}
            MyOutputDebugString('准备获取函数地址：Init .');
            {$IFEND}
            {$IF AntiPlugInMemory = 1}
            Init := MemoryGetProcAddress(g_AntiPlugDllMemoryModule2, 'Init'); //);
            {$ELSE}
            Init := GetProcAddress(g_AntiPlugDllModule2, 'Init'); //'Init');
            {$IFEND}

            if Assigned(Init) then begin
