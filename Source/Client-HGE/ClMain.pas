procedure TfrmMain.DoMagicKeyPress(Shift:TShiftState; Key:Word);
var
  TempActionKey:Word;
  pcm:PTClientMagic;
  TempKeyStr:Char;
begin
  if CanUseMagic then begin
    if Key in [VK_F1..VK_F8] then begin
      if ssCtrl in Shift then begin
        TempActionKey := Key - 100;
      end else begin
        TempActionKey := Key;
      end;
    end else if (Key >= Ord('A')) and (Key <= Ord('Z')) then begin
      TempActionKey := Key;
    end else begin
      TempActionKey := 0; //HZQ 20230520 根据代码猜测补全
    end;

    ActionKey := TempActionKey;
  end else if (g_MySelf.m_nCurrentAction <> SM_SPELL) and (g_MySelf.m_nCurrentAction <> CM_SPELL) then begin
    TempKeyStr := #0;
    if Key in [VK_F1..VK_F8] then begin
      if ssCtrl in Shift then begin
        TempKeyStr := Char((Key - VK_F1) + byte('E'));
      end
      else begin
        TempKeyStr := Char((Key - VK_F1) + byte('1'));
      end;
    end
    else if (Key >= Ord('A')) and (Key <= Ord('Z')) then
      TempKeyStr := Chr(Ord(Key) + 32);

    if TempKeyStr = #0 then
      Exit;

    pcm := GetMagicByKey(TempKeyStr);
    if pcm <> nil then begin
      // 修正在攻击时，按下技能快捷键使用治愈术超过1秒钟，会连续使用2次治愈术技能 2019-12-26
      if (ExcludeWaitUseActionKeyMagicID = pcm.Def.wMagicId) and (MyGetTickCount - ExcludeWaitUseActionKeyMagicTick >= 600) then begin
        WaitUseActionKeyMagicID := pcm.Def.wMagicId;
        WaitUseActionKeyMagicTick := MyGetTickCount;

        {$IF TESTMODE = 1}
        //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~延时使用技能.' + IntToStr(WaitUseActionKeyMagicID), clRed, clBlack);
        {$IFEND}
      end;
    end;
  end;

  if g_ConfigDlg.ConfigCheckeds[ckAutoDownHorse] and (g_MySelf.m_btHorse <> 0) then
    g_MySelf.TakeHorse;
end;

