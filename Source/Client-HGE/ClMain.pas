function GetWebAddr(sAddr:string):string;
begin
  Result := sAddr;

  if CompareLStr(sAddr, 'http:// ', Length('http://')) then
    sAddr := Copy(sAddr, 8, Length(sAddr) - 7);

  if Pos('/', sAddr) > 0 then
    sAddr := Copy(sAddr, 1, Pos('/', sAddr) - 1);
  Result := sAddr;
end;

{
function GetInstanceInfo(): PInstanceInfo;
begin
  Result := nil;
  if Assigned(InstanceInfo) then UnmapViewOfFile(InstanceInfo);
  if MappingHandle <> 0 then CloseHandle(MappingHandle);
  InstanceInfo := nil;
  MappingHandle := 0;
  MappingName := StringReplace(g_ClientParam.sGameLoginFileName, '\', '', [rfReplaceAll, rfIgnoreCase]);
  MappingHandle := OpenFileMapping(FILE_MAP_ALL_ACCESS, False, PChar(MappingName));
  if MappingHandle <> 0 then
  begin
    Result := MapViewOfFile(MappingHandle,
      FILE_MAP_ALL_ACCESS,
      0,
      0,
      SizeOf(TInstanceInfo));
    // DebugOutStr('InstanceInfo:' + IntToStr(InstanceInfo.PreviousHandle) + ' RunCount:' + IntToStr(InstanceInfo.RunCount));
  end;
end;
}

function EnableProcessPrivilege(const Enable:Boolean; const Privilege:string):Boolean;
const
  PrivAttrs:array[Boolean] of DWORD = (0, SE_PRIVILEGE_ENABLED);
var
  Token:THandle;
  TokenPriv:TTokenPrivileges;
  PrevTokenPriv:TOKEN_PRIVILEGES;
  ReturnLength:Cardinal;
begin
  Result := False;
  if OpenProcessToken(GetCurrentProcess, TOKEN_ADJUST_PRIVILEGES or TOKEN_QUERY, Token) then begin
    TokenPriv.PrivilegeCount := 1;
    LookupPrivilegeValue(nil, PChar(Privilege), TokenPriv.Privileges[0].Luid);
    TokenPriv.Privileges[0].Attributes := PrivAttrs[Enable];
    AdjustTokenPrivileges(Token, False, TokenPriv, SizeOf(TokenPriv), PrevTokenPriv, ReturnLength);
    Result := GetLastError = ERROR_SUCCESS;
    CloseHandle(Token);
  end;
end;

function AdjustProcessPrivilege:Boolean;
const
  SE_DEBUG_PRIVILEGE = $14; //调试权限
var
  IsEnabled:BOOL;
  DllHandle:THandle;
  RtlAdjustPrivilege:function(Privilege:ULONG; Enable:BOOL; CurrentThread:BOOL; var Enabled:BOOL):DWORD; stdcall;
begin
  Result := False;
  DllHandle := LoadLibrary('ntdll.dll');
  if DllHandle <> 0 then begin
    @RtlAdjustPrivilege := GetProcAddress(DllHandle, 'RtlAdjustPrivilege');
    if (@RtlAdjustPrivilege <> nil) then begin
      Result := RtlAdjustPrivilege(SE_DEBUG_PRIVILEGE, True, False, IsEnabled) = 0;
    end;
    FreeLibrary(DllHandle);
  end;
end;

procedure TfrmMain.FormCreate(Sender:TObject);
var
  flname:string;
  sFilePath:string;
  ItemDescFileList:TStringList;
  HC:HCURSOR;
  RandCodeType:TRandCodeType;

  {$IF TESTMODE = 2}
  I:Integer;
  RsaPublicKey:string;
  PublicKey:pBIO;
  ChrTable:array of Char;
  StrUrl:string;
  {$IFEND}

begin
  // 提升权限，这样获取进程列表完整些
  //if not AdjustProcessPrivilege then
  //EnableProcessPrivilege(True, 'SeDebugPrivilege');

  if g_UseCustomDefCursor then begin
    flname := g_sSelfFilePath + g_CustomCursorDefFileName;
    if FileExists(flname) then begin
      HC := LoadCursorFromFile(PChar(flname));
      if HC <> 0 then begin
        g_CustomCursorIndex := 8;
        Screen.Cursors[g_CustomCursorIndex] := HC;
        Cursor := g_CustomCursorIndex;
      end;
    end;
  end;

  ///////////////// 是否允许窗口最大化 //////////////////////
  if not g_ConfigClient.boWindowBiMaximize then
    BorderIcons := BorderIcons - [biMaximize];

  // 尝试连接微端网关 piaoyun 2013-11-21
  try
    ClientSocketGate.Active := False;

    if g_nUpdateGatePort > 0 then begin
      // 支持域名 chongchong 2015-05-25
