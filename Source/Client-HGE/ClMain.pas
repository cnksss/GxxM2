procedure TfrmMain.AddDlgItemClick(Sender:TObject; X, Y:Integer);
var
  sCmdText:string;
  nIndex:Integer;
begin
  if Sender is TNpcLabel then
    sCmdText := TNpcLabel(Sender).m_sCmd
  else if Sender is TNpcButton then
    sCmdText := TNpcButton(Sender).m_sCmd
  else if Sender is TNpcItemButton then
    sCmdText := TNpcItemButton(Sender).m_sCmd
  else if Sender is TNpcProgressBoxButton then
    sCmdText := TNpcProgressBoxButton(Sender).m_sCmd
  else if Sender is TCountDownLabel then
    sCmdText := TCountDownLabel(Sender).m_sCmd;

  if CompareText(sCmdText, '@EXIT') = 0 then begin
    TDxControl(Sender).Owner.Visible := False;
    Exit;
  end
  else begin
    PlaySound(s_glass_button_click);
  end;

  if (Length(sCmdText) > 0) and (sCmdText[1] = '@') then begin
    sCmdText := Copy(sCmdText, 2, Length(sCmdText) - 1);
  end;

  if TryStrToInt(sCmdText, nIndex) then begin
    SendClientMessage(CM_DLGBUTTONCLICK, 0, nIndex, 0, 0, '');
  end;
end;

