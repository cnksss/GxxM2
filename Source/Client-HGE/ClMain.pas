procedure TfrmMain.ProcessMessageGoldChanged(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  nTempX, nTempY:Integer;
begin
  if g_MySelf = nil then
    Exit;
  SoundUtil.PlaySound(s_money);

  if g_ClientConfig.boAddItemMsgXRightToLeft then
    nTempX := SCREENWIDTH - g_ClientConfig.nAddItemMsgX
  else
    nTempX := g_ClientConfig.nAddItemMsgX;

  if g_ClientConfig.boAddItemMsgYBottomToTop then
    nTempY := SCREENHEIGHT - g_ClientConfig.nAddItemMsgY
  else
    nTempY := g_ClientConfig.nAddItemMsgY;

  if DefMsg.Recog > g_MySelf.m_nGold then begin
    DScreen.AddSysMsg(IntToStr(DefMsg.Recog - g_MySelf.m_nGold) + ' ' + g_sGoldName + '增加.' {'金币。'}, g_ClientConfig.btAddItemMsgFColor, g_ClientConfig.btAddItemMsgBColor, nTempX, nTempY);
  end;

  // 获得金币添加信息提示 piaoyun 2013-07-22
  if Cardinal(MakeLong(DefMsg.param, DefMsg.tag)) > g_MySelf.m_nGameGold then begin //HZQ 20230523 add Cardinal();
    DScreen.AddSysMsg(IntToStr(Cardinal(MakeLong(DefMsg.param, DefMsg.tag)) - g_MySelf.m_nGameGold) + ' ' + g_sGameGoldName + '增加.', g_ClientConfig.btAddItemMsgFColor, g_ClientConfig.btAddItemMsgBColor, nTempX, nTempY);
  end;

  g_MySelf.m_nGold := DefMsg.Recog;
  g_MySelf.m_nGameGold := MakeLong(DefMsg.param, DefMsg.tag);

  FrmDlg.MySelfAbilChange;                                                
  g_ConfigDlg.RefreshMySelfAbil;
end;

