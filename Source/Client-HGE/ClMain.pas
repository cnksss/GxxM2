procedure TfrmMain.ProcessMessageScreenEffect(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  ScreenEffectData:pTScreenEffectData;
  ScreenEffectInfo:pTScreenEffectInfo;
begin
  if Length(sData) = SizeOf(TScreenEffectData) then begin
    ScreenEffectData := pTScreenEffectData(sData);

    if (ScreenEffectData.nImageCount > 0) and (ScreenEffectData.nImageIndex >= 0)
      and (ScreenEffectData.nImageIndex < g_EffectImageList.Count) and (ScreenEffectData.nX >= 0)
      and (ScreenEffectData.nX <= SCREENWIDTH) and (ScreenEffectData.nY >= 0) and (ScreenEffectData.nY <= SCREENHEIGHT) then begin
      New(ScreenEffectInfo);
      FillChar(ScreenEffectInfo^, SizeOf(TScreenEffectInfo), 0);
      ScreenEffectInfo.nX := ScreenEffectData.nX;
      ScreenEffectInfo.nY := ScreenEffectData.nY;
      ScreenEffectInfo.nFileIndex := ScreenEffectData.nImageIndex;
      ScreenEffectInfo.nImageIndex := ScreenEffectData.nStartImage;
      ScreenEffectInfo.wFrameTime := ScreenEffectData.nTime;
      ScreenEffectInfo.nLoopCount := ScreenEffectData.nPlayCount;
      ScreenEffectInfo.wImageCount := ScreenEffectData.nImageCount;
      ScreenEffectInfo.boBlend := ScreenEffectData.boBlend;
      ScreenEffectInfo.boDrawTopmost := ScreenEffectData.boDrawTopmost;
      ScreenEffectInfo.nCurrentFrame := 0;
      ScreenEffectInfo.dwFrameTimeTick := MyGetTickCount;
      ScreenEffectInfo.LockObject := DefMsg.Recog;
      ScreenEffectList.Add(ScreenEffectInfo);
    end;
  end;
end;

procedure TfrmMain.ProcessMessageStopScreenEffect(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  ScreenEffectData:pTScreenEffectData;
  ScreenEffectInfo:pTScreenEffectInfo;
begin
  if Length(sData) = SizeOf(TScreenEffectData) then begin
    ScreenEffectData := pTScreenEffectData(sData);

    if (ScreenEffectData.nImageCount > 0) and (ScreenEffectData.nImageIndex >= 0) and (ScreenEffectData.nImageIndex < g_EffectImageList.Count) and (ScreenEffectData.nX >= 0) and (ScreenEffectData.nX <= SCREENWIDTH) and (ScreenEffectData.nY >= 0) and (ScreenEffectData.nY <= SCREENHEIGHT) then begin
      for I := 0 to ScreenEffectList.Count - 1 do begin
        ScreenEffectInfo := ScreenEffectList.Items[I];

        if (ScreenEffectData.nX = ScreenEffectInfo.nX) and (ScreenEffectData.nY = ScreenEffectInfo.nY) and (ScreenEffectData.nImageIndex = ScreenEffectInfo.nFileIndex) and (ScreenEffectData.nImageCount = ScreenEffectInfo.wImageCount) and (ScreenEffectData.nStartImage = ScreenEffectInfo.nImageIndex) and //(ScreenEffectData.nPlayCount = ScreenEffectInfo.wLoopCount) and
        (ScreenEffectData.nTime = ScreenEffectInfo.wFrameTime) and (ScreenEffectData.boBlend = ScreenEffectInfo.boBlend) and (DefMsg.Recog = ScreenEffectInfo.LockObject) then begin
          ScreenEffectList.Delete(I);
          Dispose(ScreenEffectInfo);
          Break;
        end;
      end;
    end;
  end;
end;

