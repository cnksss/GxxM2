procedure TfrmMain.ProcessMessageSendUserStateFengHao(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  Index:Integer;
  cu:TClientItem;
  OutBuf:PAnsiChar;
  OutBufSize:Integer;
  Buffer:PChar;
  ClientItem:PTClientItem;
begin
  g_USFengHaoItems.Lock;
  try
    for I := 0 to g_USFengHaoItems.Count - 1 do begin
      Dispose(PTClientItem(g_USFengHaoItems.Items[I]));
    end;
    g_USFengHaoItems.Clear;

    {$IF TESTMODE = 1}
    DScreen.AddChatBoardString('收到称号.', clRed, clBlack);
    {$IFEND}

    if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
      OutBufSize := DefMsg.Series * (SizeOf(TClientItem) + 1) + 1;

      try
        GetMem(OutBuf, OutBufSize);
      except
        on E:Exception do begin
          DebugOutStr('[Exception] ProcessMessageSendUserStateFengHao');
          DebugOutStr(E.Message);
          Exit;
        end;
      end;

      try
        g_USActiveFengHaoIndex := DefMsg.Recog;

        zLibDecompressString(sData, OutBuf, OutBufSize);
        Buffer := OutBuf;

        for I := 0 to DefMsg.Series - 1 do begin
          Index := Ord(Buffer^);
          Inc(Buffer);
          Move(Buffer^, cu, SizeOf(TClientItem));
          Buffer := Buffer + SizeOf(TClientItem);
          if Index in [Low(THumanFengHaoItems)..High(THumanFengHaoItems)] then begin
            New(ClientItem);
            FillChar(ClientItem^, SizeOf(TClientItem), 0);
            ClientItem^ := cu;
            g_USFengHaoItems.Add(ClientItem)
          end;
        end;
      finally
        FreeMem(OutBuf, OutBufSize);
      end;
    end;
  finally
    g_USFengHaoItems.UnLock;
  end;
end;

procedure TfrmMain.tmrRunTimer(Sender:TObject);
var
  I:Integer;
