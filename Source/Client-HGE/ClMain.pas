procedure TfrmMain.ProcessMessageHeroBagItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  cu:TClientItem;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  Buffer:Pointer;
begin
  ClearHeroBag;
  if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));

    Buffer := @OutBuf;
    for I := 0 to DefMsg.Series - 1 do begin
      Move(Buffer^, cu, SizeOf(TClientItem));
      Buffer := Pointer(Integer(Buffer) + SizeOf(TClientItem));
      AddHeroItemBag(cu);
    end;
    ArrangeHeroItembag;
  end;
end;

procedure TfrmMain.ProcessMessageHeroSendUseItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  Index:Integer;
  cu:TClientItem;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  Buffer:PChar;
begin
  SafeFillChar(g_HeroUseItems, SizeOf(g_HeroUseItems), #0);
  if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));

    Buffer := @OutBuf;
    for I := 0 to DefMsg.Series - 1 do begin
      Index := Ord(Buffer^);
      Inc(Buffer);
      Move(Buffer^, cu, SizeOf(TClientItem));
      Buffer := Buffer + SizeOf(TClientItem);
      if Index in [Low(TUseItems)..High(TUseItems)] then begin
        g_HeroUseItems[Index] := cu;
      end;
    end;
  end;
end;

procedure TfrmMain.ProcessMessageHeroMyMagics(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  pcm:PTClientMagic;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  Buffer:PChar;
begin
  g_HeroMagicList.Lock;
  try
    for I := 0 to g_HeroMagicList.Count - 1 do begin
      Dispose(PTClientMagic(g_HeroMagicList.Items[I]));
    end;
    g_HeroMagicList.Clear;
  finally
    g_HeroMagicList.UnLock;
  end;

  g_HeroMagicNGList.Lock;
  try
    for I := 0 to g_HeroMagicNGList.Count - 1 do begin
      Dispose(PTClientMagic(g_HeroMagicNGList.Items[I]));
    end;
    g_HeroMagicNGList.Clear;
  finally
    g_HeroMagicNGList.UnLock;
  end;

  g_HeroContinuousMagicList.Lock;
  try
    for I := 0 to g_HeroContinuousMagicList.Count - 1 do begin
      Dispose(PTClientMagic(g_HeroContinuousMagicList.Items[I]));
    end;
    g_HeroContinuousMagicList.Clear;
  finally
    g_HeroContinuousMagicList.UnLock;
  end;

  if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));

    Buffer := @OutBuf;
    for I := 0 to DefMsg.Series - 1 do begin
      New(pcm);
      Move(Buffer^, pcm^, SizeOf(TClientMagic));
      Buffer := Buffer + SizeOf(TClientMagic);
      case pcm.Def.MagicAttr of
        mtHero:begin
            g_HeroMagicList.Lock;
            try
              g_HeroMagicList.Add(pcm);
            finally
              g_HeroMagicList.UnLock;
            end;
          end;
        mtContinuous:begin
            g_HeroContinuousMagicList.Lock;
            try
              g_HeroContinuousMagicList.Add(pcm);
            finally
              g_HeroContinuousMagicList.UnLock;
            end;
          end;
        mtDefense, mtAttack:begin
            g_HeroMagicNGList.Lock;
            try
              g_HeroMagicNGList.Add(pcm);
            finally
              g_HeroMagicNGList.UnLock;
            end;
          end;
      end;
    end;
  end;
  if (FrmDlg is TSerialWindows) and (g_ClientVersion in [cvSerial, cvMirSequel, cvMirNewUI205]) then begin
    TSerialWindows(FrmDlg).RefreshHeroUpgradeButtons;
    TSerialWindows(FrmDlg).NewStateWindows.RefreshMyHeroMagicList;
  end;
  g_ConfigDlg.RefreshMyHeroMagicList;
end;

