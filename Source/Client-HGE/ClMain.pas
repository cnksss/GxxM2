procedure HookFunction(OldProc, NewProc:Pointer); // 直接在内存里替换新的函数，新界面函数
var
  t:Cardinal;
  // tpv: array[0..3] of Byte;
  NewAddress:array[0..7] of Byte;
  OldAddress:array[0..7] of Byte;
begin
  // Move(NewProc, tpv, 4);
  NewAddress[0] := $B8;
  PInteger(@NewAddress[1])^ := PInteger(@NewProc)^;
  NewAddress[5] := $FF;
  NewAddress[6] := $E0;
  NewAddress[7] := 0;

  if ReadProcessMemory(GetCurrentProcess, OldProc, @OldAddress, 8, t) then
    WriteProcessMemory(GetCurrentProcess, OldProc, @NewAddress, 8, t);
end;

