  end;

  if (not g_ConfigClient.boDisableDrogMagicIcon) and g_boMagicMoving and (g_MovingMagic <> nil) then begin
    FrmDlg.AddScreenMagicButton(g_MovingMagic, pt.X, pt.Y);

    g_boMagicIconDown := False;
    g_boMagicMoving := False;
    g_MovingMagic := nil;
  end;
