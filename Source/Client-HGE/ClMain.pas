procedure TfrmMain.ProcessMessageGroupMembers(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  ListItem:TDxListItem;
  ViewItem:pTViewItem;
  I:Integer;
  NewMember:PGroupMember;
  GroupMember:PGroupMember;
begin
  FrmDlg.ClearNewGroupMember;
  ClearGroupMembers;

  if Length(sData) <> DefMsg.Recog * SizeOf(TGroupMember) then
    Exit;

  GroupMember := PGroupMember(sData);
  for I := 0 to DefMsg.Recog - 1 do begin
    New(NewMember);
    NewMember^ := GroupMember^;
    g_GroupMembers.Add(NewMember);
    Inc(GroupMember);
  end;

  FrmDlg.DMemoGroupMembers.Lock;
  try
    FrmDlg.DMemoGroupMembers.Clear;

    if g_GroupMembers.Count > 0 then begin
      if FrmDlg.DLabelGroupMembersOwner <> nil then begin
        FrmDlg.DLabelGroupMembersOwner.Caption := PGroupMember(g_GroupMembers[0]).sCharName;

        // 修正队长不能自动对齐 2019-10-21 14:42:25
        // FrmDlg.DLabelGroupMembersOwner.AutoSize := True;
      end;

      ListItem := nil;
      for I := 1 to g_GroupMembers.Count - 1 do begin
        if I mod 2 = 1 then begin
          ListItem := FrmDlg.DMemoGroupMembers.Add;
        end;

        if ListItem <> nil then begin
          ViewItem := ListItem.AddItem('', nil);
          ViewItem.Caption := PGroupMember(g_GroupMembers[I]).sCharName;
          ViewItem.Style := bsButton; // bsRadio;
          ViewItem.Alignment := taLeftJustify;
          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;
        end;
      end;
    end;

    FrmDlg.ReshowNewGroupMember;
  finally
    FrmDlg.DMemoGroupMembers.UnLock;
  end;
end;

procedure TfrmMain.ProcessMessageOpenGuildDlg(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Str, Data, linestr, s1:string;
  pstep:Integer;
begin
  g_dwQueryMsgTick := MyGetTickCount;
  Str := DecodeString(sData);
  Str := GetValidStr3_Ex(Str, FrmDlg.Guild, #13);

  if (FrmDlg is TSerialWindows) then
    (FrmDlg as TSerialWindows).DGLName.Caption := FrmDlg.Guild;

  Str := GetValidStr3_Ex(Str, FrmDlg.GuildFlag, #13);
  Str := GetValidStr3_Ex(Str, Data, #13);
  FrmDlg.GuildCommanderMode := StrToIntDef(Data, 0);
  {$IF IsMultiThreadRender = 1}
  FrmDlg.DBackground.Lock;
  {$IFEND}
  FrmDlg.GuildStrs.Clear;
  FrmDlg.GuildNotice.Clear;
  {$IF IsMultiThreadRender = 1}
  FrmDlg.DBackground.UnLock;
  {$IFEND}
  FrmDlg.GuildWJ.Clear;
  pstep := 0;
  if DefMsg.Param = 0 then begin
    while True do begin
      if Str = '' then
        Break;
      Str := GetValidStr3_Ex(Str, Data, #13);
      if Data = '<Notice>' then begin
        FrmDlg.GuildStrs.AddObject(Char(7) + '行会公告', TObject(clWhite));
        FrmDlg.GuildStrs.Add(' ');
        pstep := 1;
        Continue;
      end;
      if Data = '<KillGuilds>' then begin
        FrmDlg.GuildStrs.Add(' ');
        FrmDlg.GuildStrs.AddObject(Char(7) + '敌对行会', TObject(clWhite));
        FrmDlg.GuildStrs.Add(' ');
        pstep := 2;
        linestr := '';
        Continue;
      end;
      if Data = '<AllyGuilds>' then begin
        if linestr <> '' then
          FrmDlg.GuildStrs.Add(linestr);
        linestr := '';
        FrmDlg.GuildStrs.Add(' ');
        FrmDlg.GuildStrs.AddObject(Char(7) + '联盟行会', TObject(clWhite));
        FrmDlg.GuildStrs.Add(' ');
        pstep := 3;
        Continue;
      end;

      if pstep = 1 then
        FrmDlg.GuildNotice.Add(Data);

      if Data <> '' then begin
        if Data[1] = '<' then begin
          ArrestStringEx(Data, '<', '>', s1);
          if s1 <> '' then begin
            FrmDlg.GuildStrs.Add(' ');
            FrmDlg.GuildStrs.AddObject(Char(7) + s1, TObject(clWhite));
            FrmDlg.GuildStrs.Add(' ');
            Continue;
          end;
        end;
      end;
      if (pstep = 2) or (pstep = 3) then begin
        if Length(linestr) > 80 then begin
          FrmDlg.GuildStrs.Add(linestr);
          linestr := '';
        end else begin
          linestr := linestr + fmstr(Data, 18);
        end;
        Continue;
      end;

      FrmDlg.GuildStrs.Add(Data);
    end;

    if linestr <> '' then
      FrmDlg.GuildStrs.Add(linestr);
  end else begin
    while True do begin
      if Str = '' then
        Break;
      Str := GetValidStr3_Ex(Str, Data, #13);
      if Data = '<Notice>' then begin
        //FrmDlg.GuildStrs.AddObject(Char(7) + '行会公告', TObject(clWhite));
        //FrmDlg.GuildStrs.Add(' ');
        pstep := 1;
        Continue;
      end;

      if Data = '<KillGuilds>' then begin
        //FrmDlg.GuildStrs.Add(' ');
        //FrmDlg.GuildStrs.AddObject(Char(7) + '敌对行会', TObject(clWhite));
        //FrmDlg.GuildStrs.Add(' ');
        pstep := 2;
        linestr := '';
        Continue;
      end;

      if Data = '<AllyGuilds>' then begin
        //if linestr <> '' then FrmDlg.GuildStrs.Add(linestr);
        //linestr := '';
        //FrmDlg.GuildStrs.Add(' ');
        //FrmDlg.GuildStrs.AddObject(Char(7) + '联盟行会', TObject(clWhite));
        //FrmDlg.GuildStrs.Add(' ');
        pstep := 3;
        Continue;
      end;

      if Data = '<AttentionGuilds>' then begin
        //if linestr <> '' then FrmDlg.GuildStrs.Add(linestr);
        //linestr := '';
        //FrmDlg.GuildStrs.Add(' ');
        //FrmDlg.GuildStrs.AddObject(Char(7) + '关注行会', TObject(clWhite));
        //FrmDlg.GuildStrs.Add(' ');
        pstep := 4;
        Continue;
      end;

      if Data = '<RequestAllyGuilds>' then begin
        //if linestr <> '' then FrmDlg.GuildStrs.Add(linestr);
        //linestr := '';
        //FrmDlg.GuildStrs.Add(' ');
        //FrmDlg.GuildStrs.AddObject(Char(7) + '申请联盟', TObject(clWhite));
        //FrmDlg.GuildStrs.Add(' ');
        pstep := 5;
        Continue;
      end;

      if pstep = 1 then
        FrmDlg.GuildNotice.Add(Data)
      else
        FrmDlg.GuildWJ.AddObject(Data, TObject(pstep));

      if Data <> '' then begin
        if Data[1] = '<' then begin
          ArrestStringEx(Data, '<', '>', s1);
          if s1 <> '' then begin
            FrmDlg.GuildStrs.Add(' ');
            FrmDlg.GuildStrs.AddObject(Char(7) + s1, TObject(clWhite));
            FrmDlg.GuildStrs.Add(' ');
            Continue;
          end;
        end;
      end;

      FrmDlg.GuildStrs.Add(Data);
    end;

    if linestr <> '' then
      FrmDlg.GuildStrs.Add(linestr);
  end;

  FrmDlg.GuildOnlineCount := LoWord(DefMsg.Recog);
  FrmDlg.GuildMemberCount := HiWord(DefMsg.Recog);
  FrmDlg.GuildMemberMaxLimit := DefMsg.Tag;
  FrmDlg.OpenDGuildDlg(DefMsg.Param <> 0, Boolean(DefMsg.Series));
end;

procedure TfrmMain.ProcessMessageSendGuildMemberList(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Str, Data, rankname, members, sOnline:string;
  rank, Index:Integer;
  GuildGroup:TGuildGroup;
begin
  GuildGroup := nil;

  g_dwQueryMsgTick := MyGetTickCount;
  {$IF IsMultiThreadRender = 1}
  FrmDlg.DBackground.Lock;
  {$IFEND}
  FrmDlg.GuildStrs.Clear;
  FrmDlg.GuildMembers.Clear;
  {$IF IsMultiThreadRender = 1}
  FrmDlg.DBackground.UnLock;
  {$IFEND}

  FrmDlg.GuildGroupList.Clear;

  //hzq Sst内容格式： #RankNo/*RandkName/Mem1 online/.... online/Memn online/...下一个rank.../
  Str := DecodeString(sData);
  rank := 0;
  while True do begin
    if Str = '' then
      Break;
    Str := GetValidStr3_Ex(Str, Data, '/');
    if Data <> '' then begin
      if Data[1] = '#' then begin
        rank := StrToIntDef(System.Copy(Data, 2, Length(Data) - 1), 0);
        Continue;
      end;

      if Data[1] = '*' then begin
        if members <> '' then begin
          FrmDlg.GuildStrs.Add(members);
        end;
        rankname := System.Copy(Data, 2, Length(Data) - 1);
        members := '';
        FrmDlg.GuildStrs.Add(' ');
        if FrmDlg.GuildCommanderMode > 0 then
          FrmDlg.GuildStrs.AddObject(fmstr('(' + IntToStr(rank) + ')', 3) + '<' + rankname + '>', TObject(clWhite))
        else
          FrmDlg.GuildStrs.AddObject('<' + rankname + '>', TObject(clWhite));
        FrmDlg.GuildMembers.Add('#' + IntToStr(rank) + ' <' + rankname + '>');

        GuildGroup := FrmDlg.GuildGroupList.Add(rank, rankname);

        Continue;
      end;

      if Length(members) > 80 then begin
        FrmDlg.GuildStrs.Add(members);
        members := '';
      end;

      if DefMsg.Param = 1 then begin
        Index := Length(Data) - 1;

        sOnline := Copy(Data, Index + 1, MaxInt);
        Data := Copy(Data, 1, Index - 1);

        members := members + fmstr(Data, 18);
        FrmDlg.GuildMembers.Add(Data);

        if GuildGroup <> nil then begin
          GuildGroup.Members.AddObject(Data, TObject(StrToIntDef(sOnline, 0)));
        end;
      end else begin
        members := members + fmstr(Data, 18);
        FrmDlg.GuildMembers.Add(Data);

        if GuildGroup <> nil then begin
          GuildGroup.Members.Add(Data);
        end;
      end
    end;
  end;

  if members <> '' then
    FrmDlg.GuildStrs.Add(members);

  if DefMsg.Param = 1 then begin
    FrmDlg.RefreshGuildMembers(DefMsg.Tag); //HZQ DefMsg.Tag为当前玩家所在的组索引
  end;
end;

