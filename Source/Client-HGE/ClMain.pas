end;

function ProcessElementNewPropertyText(S:string):string;
var
  I, Index1, Index2:Integer;
  S1, S2, S3:string;
  TempS:string;
begin
  Result := S;

  for I := 1 to 3 do begin
    Index1 := Pos('<', S);

    if Index1 > 0 then
      Index2 := Pos('>', S)
    else
      Index2 := 0;

    if (Index1 > 0) and (Index2 > 0) and (Index2 > Index1) then begin
      S1 := Copy(S, 1, Index1 - 1);
      S2 := Copy(S, Index1 + 1, Index2 - Index1 - 1);
      S3 := Copy(S, Index2 + 1, MaxInt);

      if Length(S2) > 0 then begin
        if SameText(Copy(S2, 1, 4), 'img:') or SameText(Copy(S2, 1, 6), 'looks:') or SameText(Copy(S2, 1, 8), 'dnitems:') or SameText(Copy(S2, 1, 10), 'stateitem:') or SameText(Copy(S2, 1, 8), 'newopui:') or SameText(Copy(S2, 1, 8), 'playimg:') or SameText(Copy(S2, 1, 13), 'ItemProgress:') or SameText(Copy(S2, 1, 7), 'ImgNum:') or SameText(Copy(S2, 1, 10), 'Countdown:') then begin
          Result := S1 + S3;
        end;
      end;
    end;

    Index1 := Pos('{', S);

    if Index1 > 0 then
      Index2 := Pos('}', S)
    else
      Index2 := 0;

    if (Index1 > 0) and (Index2 > 0) and (Index2 > Index1) then begin
      S1 := Copy(S, 1, Index1 - 1);
      S2 := Copy(S, Index1 + 1, Index2 - Index1 - 1);
      S3 := Copy(S, Index2 + 1, MaxInt);

      if Length(S2) > 0 then begin
        Index1 := Pos('|', S2);
        if Index1 > 0 then begin
          TempS := Copy(S2, Index1 + 1, MaxInt);
          if TryStrToInt(TempS, Index2) then begin
            if (Index2 >= 0) and (Index2 < 256) then begin
              S2 := Copy(S2, 1, Index1 - 1);

              Result := S1 + S2 + S3;
            end;
          end;
        end;
      end;
    end;
    S := Result;
  end;
end;

