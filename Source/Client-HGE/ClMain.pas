  g_boServerChanging := True;
  CSocket.Active := False;
  CSocket.Host := '';
  CSocket.Port := 0;
  // DScreen.AddChatBoardString('ProcessMessageReConnect:' + addr + ' ' + sport, clRed, clWhite);

  WaitAndPass(1000);

  g_ConnectionStep := cnsPlay;
  with CSocket do begin
    Address := addr;
    Port := StrToIntDef(sport, 0);
    Active := True;
  end;
end;

