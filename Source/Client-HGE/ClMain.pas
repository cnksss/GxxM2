procedure GetScreenMode;
begin
  FNeedChangeScreenMode := False;
  FScreenModeChanged := False;
  if EnumDisplaySettings(nil, $FFFFFFFF, FCurrentScreenMode) then begin
    // FNewScreenMode := FCurrentScreenMode;
    //HZQ 20230520
    if (g_nScreenWidth = 900) and (g_nScreenHeight = 600) then begin
      FNeedChangeScreenMode := (not g_boWindowMode) and ((Cardinal(g_nBitCount) <> FCurrentScreenMode.dmBitsPerPel) or (1024 <> FCurrentScreenMode.dmPelsWidth) or (768 <> FCurrentScreenMode.dmPelsHeight));
      FDisplayChange := (not g_boWindowMode) and ((1024 <> FCurrentScreenMode.dmPelsWidth) or (768 <> FCurrentScreenMode.dmPelsHeight));
    end else begin
      FNeedChangeScreenMode := (not g_boWindowMode) and ((Cardinal(g_nBitCount) <> FCurrentScreenMode.dmBitsPerPel)
        or (Cardinal(SCREENWIDTH) <> FCurrentScreenMode.dmPelsWidth) or (Cardinal(SCREENHEIGHT) <> FCurrentScreenMode.dmPelsHeight));

      FDisplayChange := (not g_boWindowMode) and ((Cardinal(SCREENWIDTH) <> FCurrentScreenMode.dmPelsWidth)
        or (Cardinal(SCREENHEIGHT) <> FCurrentScreenMode.dmPelsHeight));
    end;
  end;
end;

function ChangeScreenMode:Boolean;
var
  nError:Integer;
begin
  Result := False;
  if (not g_boWindowMode) and (FNeedChangeScreenMode) and (not FScreenModeChanged) then begin
    ZeroMemory(@FNewScreenMode, SizeOf(FNewScreenMode)); // 确保内存分配
    FNewScreenMode.dmSize := SizeOf(FNewScreenMode);

    if FCurrentScreenMode.dmBitsPerPel <> Cardinal(g_nBitCount) then begin //HZQ
      FNewScreenMode.dmBitsPerPel := g_nBitCount;
      FNewScreenMode.dmFields := DM_BITSPERPEL;
    end;
    // FNewScreenMode.dmFields := DM_BITSPERPEL or DM_PELSWIDTH or DM_PELSHEIGHT; //or DM_DISPLAYFLAGS;
    {
    if (g_nScreenWidth = 900) and (g_nScreenHeight = 600) then
    begin
      if (FCurrentScreenMode.dmPelsWidth <> 1024) then
      begin
        FNewScreenMode.dmPelsWidth := 1024;
        FNewScreenMode.dmFields := FNewScreenMode.dmFields or DM_PELSWIDTH;
      end;
      if (FCurrentScreenMode.dmPelsHeight <> 768) then
      begin
        FNewScreenMode.dmPelsHeight := 768;
        FNewScreenMode.dmFields := FNewScreenMode.dmFields or DM_PELSHEIGHT;
      end;
    end
    else
    }
    begin
      if (FCurrentScreenMode.dmPelsWidth <> Cardinal(SCREENWIDTH)) then begin //HZQ
        FNewScreenMode.dmPelsWidth := SCREENWIDTH;
        FNewScreenMode.dmFields := FNewScreenMode.dmFields or DM_PELSWIDTH;
      end;
      if (FCurrentScreenMode.dmPelsHeight <> Cardinal(SCREENHEIGHT)) then begin
        FNewScreenMode.dmPelsHeight := SCREENHEIGHT;
        FNewScreenMode.dmFields := FNewScreenMode.dmFields or DM_PELSHEIGHT;
      end;
    end;

    nError := ChangeDisplaySettings(FNewScreenMode, CDS_CMD);
    FScreenModeChanged := nError = DISP_CHANGE_SUCCESSFUL;
    Result := FScreenModeChanged;
    if not FScreenModeChanged then begin
      DebugOutStr('Fail ChangeDisplaySettings(1):' + IntToStr(nError));
      nError := ChangeDisplaySettings(FNewScreenMode, 0);
      FScreenModeChanged := nError = DISP_CHANGE_SUCCESSFUL;
      Result := FScreenModeChanged;
      if FScreenModeChanged then begin
        g_nScreenWidth := FNewScreenMode.dmPelsWidth;
        g_nScreenHeight := FNewScreenMode.dmPelsHeight;

        CDS_CMD := 0;
      end
      else begin
        FNewScreenMode.dmFields := 0;
        if (g_nScreenWidth = 900) and (g_nScreenHeight = 600) then begin
          if (FCurrentScreenMode.dmPelsWidth <> 1024) then begin
            FNewScreenMode.dmPelsWidth := 1024;
            FNewScreenMode.dmFields := FNewScreenMode.dmFields or DM_PELSWIDTH;
          end;
          if (FCurrentScreenMode.dmPelsHeight <> 768) then begin
            FNewScreenMode.dmPelsHeight := 768;
            FNewScreenMode.dmFields := FNewScreenMode.dmFields or DM_PELSHEIGHT;
          end;
        end
        else begin
          if (FCurrentScreenMode.dmPelsWidth <> Cardinal(SCREENWIDTH)) then begin
            FNewScreenMode.dmPelsWidth := SCREENWIDTH;
            FNewScreenMode.dmFields := FNewScreenMode.dmFields or DM_PELSWIDTH;
          end;
          if (FCurrentScreenMode.dmPelsHeight <> Cardinal(SCREENHEIGHT)) then begin
            FNewScreenMode.dmPelsHeight := SCREENHEIGHT;
            FNewScreenMode.dmFields := FNewScreenMode.dmFields or DM_PELSHEIGHT;
          end;
        end;

        nError := ChangeDisplaySettings(FNewScreenMode, CDS_CMD);
        FScreenModeChanged := nError = DISP_CHANGE_SUCCESSFUL;
        Result := FScreenModeChanged;
        if FScreenModeChanged then begin
          g_nScreenWidth := FNewScreenMode.dmPelsWidth;
          g_nScreenHeight := FNewScreenMode.dmPelsHeight;

          g_nBitCount := FNewScreenMode.dmBitsPerPel;
        end
        else begin
          DebugOutStr('Fail ChangeDisplaySettings(2) :' + IntToStr(nError));
          nError := ChangeDisplaySettings(FNewScreenMode, 0);
          FScreenModeChanged := nError = DISP_CHANGE_SUCCESSFUL;
          Result := FScreenModeChanged;
          if FScreenModeChanged then begin
            CDS_CMD := 0;
          end
          else begin
            DebugOutStr('Fail ChangeDisplaySettings(3) :' + IntToStr(nError));
          end;
        end;
        { case nError of
           DISP_CHANGE_BADDUALVIEW:
             DebugOutStr('[Result] DISP_CHANGE_BADDUALVIEW');
           DISP_CHANGE_BADFLAGS:
             DebugOutStr('[Result] DISP_CHANGE_BADFLAGS');
           DISP_CHANGE_BADMODE:
             DebugOutStr('[Result] DISP_CHANGE_BADMODE');
           DISP_CHANGE_BADPARAM:
             DebugOutStr('[Result] DISP_CHANGE_BADPARAM');
           DISP_CHANGE_FAILED:
             DebugOutStr('[Result] DISP_CHANGE_FAILED');
           DISP_CHANGE_NOTUPDATED:
             DebugOutStr('[Result] DISP_CHANGE_NOTUPDATED');
           DISP_CHANGE_RESTART:
             DebugOutStr('[Result] DISP_CHANGE_RESTART');

           default:
             DebugOutStr('[Result] Unknown');
         end;}
      end;
    end;
  end;
end;

procedure RestoreScreenMode;
begin
  if FScreenModeChanged then begin
    if FNewScreenMode.dmBitsPerPel <> FCurrentScreenMode.dmBitsPerPel then begin
      FCurrentScreenMode.dmFields := FCurrentScreenMode.dmFields or DM_BITSPERPEL;
    end;

    if (FNewScreenMode.dmPelsWidth <> FCurrentScreenMode.dmPelsWidth) then begin
      FCurrentScreenMode.dmFields := FCurrentScreenMode.dmFields or DM_PELSWIDTH;
    end;

    if (FNewScreenMode.dmPelsHeight <> FCurrentScreenMode.dmPelsHeight) then begin
      FCurrentScreenMode.dmFields := FCurrentScreenMode.dmFields or DM_PELSHEIGHT;
    end;

    // FCurrentScreenMode.dmFields := DM_BITSPERPEL or DM_PELSWIDTH or DM_PELSHEIGHT; //or DM_DISPLAYFLAGS;
    FScreenModeChanged := not (ChangeDisplaySettings(FCurrentScreenMode, CDS_CMD) = DISP_CHANGE_SUCCESSFUL);
  end;
end;

procedure TfrmMain.WMSYSCommand(var Msg:TWMSYSCommand);
begin
  if Msg.CmdType = SC_SCREENSAVE then begin
    if not g_boWindowMode then
      Msg.Result := 1
    else
      inherited;
  end
  else if Msg.CmdType = SC_MINIMIZE then begin
    g_MinimizedTick := MyGetTickCount;
    g_boMinimized := True;
    g_BassSound.Active := False;
    inherited;
  end
  else if Msg.CmdType = SC_RESTORE then begin
    g_boMinimized := False;
    g_BassSound.Active := True;
    // DebugOutStr('WMSYSCommand SC_RESTORE');
    inherited;
  end
  else
    inherited;
end;

procedure TfrmMain.WMDisplayChange(var message:TMessage);
begin
  // This event happens when user changes screen resolution.
  //
  // We also detect if the screen resolution has changed because of our
  // full screen mode, in which case we simply exit.    分辨率改变
  // if (Tag = 1) then Exit;
  // DebugOutStr('WMDisplayChange');

  inherited;

  // 防止开多个窗口从将系统分辨率从32位换为16时，有一个白屏  chongchong 2016-03-23
  Sleep(Random(800));

  if boNeedRestoreDevice then begin
    boNeedRestoreDevice := False;
  end
  else begin
    // 修复白屏问题 我们登陆器窗口游戏的时候 你使用其他登陆器全屏游戏后 我们的就白了 piaoyun 2013-12-17
    // if (GameCanvas <> nil) and GameCanvas.Active (not g_boRestore) then
    // 再次修复全屏模式后按Alt+Tab或自动进入屏保后白屏 chongchong 2014-03-16
    if (GameCanvas <> nil) and ((GameCanvas.Active and (not g_boWindowMode)) { or g_boWindowMode} {先去掉这个看下 chongchong 2016-03-24}) and (not g_boRestore) then begin
      {$IF IsMultiThreadRender = 1}
      EnterCriticalSection(g_CriticalSection);
      try
        {$IFEND}
        g_boRestore := True;
        // DebugOutStr('WMDisplayChange1');

        if g_boWindowMode then begin
          // RestoreWindow;
          ClientWidth := SCREENWIDTH;
          ClientHeight := SCREENHEIGHT;

          // 窗口模式最大化后，不让调整大小 chongchong 2014-10-21
          if not g_ConfigClient.boWindowBiMaximize then
            BorderStyle := bsSingle
          else
            BorderStyle := bsSizeable; // bsSizeable;// bsSingle

          WindowState := wsNormal;
          Width := Width + (SCREENWIDTH - ClientWidth);
          Height := Height + (SCREENHEIGHT - ClientHeight);

          Left := Round((Screen.Width - Width) / 2);
          Top := Round((Screen.Height - Height) / 2);
        end
        else begin
          // StoreWindow;
          if (g_nScreenWidth = 900) and (g_nScreenHeight = 600) then begin
            Width := 1024;
            Height := 768;
          end
          else begin
            Width := SCREENWIDTH;
            Height := SCREENHEIGHT;
          end;
          Left := 0;
          Top := 0;
          BorderStyle := bsNone;
          WindowState := wsMaximized;
          FormStyle := fsNormal; // fsStayOnTop;
        end;

        if g_boWindowMode then begin
          GameCanvas.Finalize;
          if (not g_boAppExit) then begin
            if (g_nScreenWidth = 900) and (g_nScreenHeight = 600) and (not g_boWindowMode) then begin
              PanelSurface.Visible := True;
              PanelSurface.Width := SCREENWIDTH;
              PanelSurface.Height := SCREENHEIGHT;
              PanelSurface.Left := (Width - PanelSurface.Width) div 2;
              PanelSurface.Top := (Height - PanelSurface.Height) div 2;
              GameCanvas.Handle := PanelSurface.Handle;
              Color := clBlack;
            end
            else begin
              GameCanvas.Handle := Handle;
              PanelSurface.Visible := False;
            end;
            GameCanvas.BitCount := g_nBitCount;
            GameCanvas.Initialize;
          end;
        end
        else begin
          // DebugOutStr('WMDisplayChange2');
          GameCanvas.Finalize;
          if (not g_boAppExit) and (Focused or ((not GameCanvas.Active) and g_boFirstTime)) then begin
            if (g_nScreenWidth = 900) and (g_nScreenHeight = 600) and (not g_boWindowMode) then begin
              PanelSurface.Visible := True;
              PanelSurface.Width := SCREENWIDTH;
              PanelSurface.Height := SCREENHEIGHT;
              PanelSurface.Left := (Width - PanelSurface.Width) div 2;
              PanelSurface.Top := (Height - PanelSurface.Height) div 2;
              GameCanvas.Handle := PanelSurface.Handle;
              Color := clBlack;
            end
            else begin
              GameCanvas.Handle := Handle;
              PanelSurface.Visible := False;
            end;

            GameCanvas.BitCount := g_nBitCount;
            GameCanvas.Initialize;
          end;
        end;
        g_boCanDrawTileMap := True;
        g_boRestore := False;
        {$IF IsMultiThreadRender = 1}
      finally
        LeaveCriticalSection(g_CriticalSection);
      end;
      {$IFEND}
    end;
  end;
end;

procedure TfrmMain.RestoreDevice;
begin
  // DebugOutStr('RestoreDevice');
  if (not g_boAppExit) and (not g_boFirstTime) and (not g_boWindowMode) and (GameCanvas <> nil) and (not g_boRestore) then begin
    {$IF IsMultiThreadRender = 1}
    EnterCriticalSection(g_CriticalSection);
    try
      {$IFEND}
      g_boRestore := True;
      if GameCanvas <> nil then
        GameCanvas.Finalize;

      Left := 0;
      Top := 0;
      BorderStyle := bsNone;
      WindowState := wsMaximized;
      FormStyle := fsStayOnTop; // fsNormal; //

      if (g_nScreenWidth = 900) and (g_nScreenHeight = 600) then begin
        Width := 1024;
        Height := 768;
      end
      else begin
        Width := SCREENWIDTH;
        Height := SCREENHEIGHT;
      end;

      GameCanvas.BitCount := g_nBitCount;
      if (g_nScreenWidth = 900) and (g_nScreenHeight = 600) then begin
        PanelSurface.Visible := True;
        PanelSurface.Width := SCREENWIDTH;
        PanelSurface.Height := SCREENHEIGHT;
        PanelSurface.Left := (Width - PanelSurface.Width) div 2;
        PanelSurface.Top := (Height - PanelSurface.Height) div 2;
        GameCanvas.Handle := PanelSurface.Handle;
        Color := clBlack;
      end
      else begin
        GameCanvas.Handle := Handle;
        PanelSurface.Visible := False;
      end;
      if GameCanvas.Initialize then
        g_boCanDrawTileMap := True;
      g_boRestore := False;

      // 声音开后，开地图背景 chongchong 2014-10-15
      if FileExists(g_sMapMusic) then
        PlayMp3(g_sMapMusic, True);

      {$IF IsMultiThreadRender = 1}
    finally
      LeaveCriticalSection(g_CriticalSection);
    end;
    {$IFEND}
  end;
end;

procedure TfrmMain.WMSetFocus(var Message:TWMSetFocus);
begin
  inherited;
  // DebugOutStr('WMSetFocus');
  if (not g_boAppExit) and (g_boWindowMode) then begin
    g_boMinimized := False;
    g_BassSound.Active := True;
  end;
end;

function GetClassNameString(AHandle:THandle):string;
var
  lpClassName:array[0..255] of Char;
begin
  GetClassName(AHandle, @lpClassName, SizeOf(lpClassName));
  Result := lpClassName;
end;

procedure TfrmMain.WMKillFocus(var Message:TWMSetFocus);
var
  AParentHandle:THandle;
begin
  inherited;
  // DebugOutStr('WMKillFocus');
  if g_boRestore or (not g_boDeviceInitializeOK) then
    Exit;
  if Handle = GetForegroundWindow then
    Exit;
  if Application.Handle = GetForegroundWindow then
    Exit;
  AParentHandle := GetForegroundWindow;
  while True do begin
    AParentHandle := GetWindowLong(AParentHandle, GWL_HWNDPARENT);
    if AParentHandle = Handle then
      Exit;
    if AParentHandle <= 0 then
      break;
  end;
  // DScreen.AddChatBoardString(GetClassNameString(GetForegroundWindow), clYellow, clRed);
  // DebugOutStr(''+GetClassNameString(GetForegroundWindow));
  g_BassSound.Active := False;

  g_MinimizedTick := MyGetTickCount;

  if not g_boWindowMode then begin
    {$IF IsMultiThreadRender = 1}
    EnterCriticalSection(g_CriticalSection);
    try
      {$IFEND}
      if GameCanvas <> nil then
        GameCanvas.Finalize;
      {$IF IsMultiThreadRender = 1}
    finally
      LeaveCriticalSection(g_CriticalSection);
    end;
    {$IFEND}
    Application.Minimize;

    RestoreScreenMode;
  end;
end;

procedure TfrmMain.WMGetMinMaxInfo(var Msg:TWMGetMinMaxInfo);
begin

  with Msg.MinMaxInfo^ do begin
    // 限制窗体最小尺寸为
    ptMinTrackSize := Point(SCREENWIDTH + g_nLeft * 2, SCREENHEIGHT + g_nTop + g_nLeft);
    // 限制窗体最大尺寸为
    ptMaxTrackSize := Point(Screen.Width, Screen.Height);
  end;
end;

