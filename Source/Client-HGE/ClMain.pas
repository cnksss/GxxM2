procedure TfrmMain.SendStartGJ;
var
  I:Integer;
begin
  if g_boGJRun then
    Exit;
  if g_MySelf = nil then
    Exit;

  // 骑马
  if (g_MySelf.m_btHorse <> 0) then
    Exit;

  if (g_MySelf.m_nChangeAppr >= 0) then
    Exit;

  if (g_ConfigDlg is TMirConfigDlg) then begin
    if not g_ClientConfig.ClientConfigTabSheetVisibles[7] then
      Exit;
  end else begin
    if not g_ClientConfig.ClientConfigTabSheetVisibles[6] then
      Exit;
  end;

  FGJTargetCret := nil;
  g_TargetCret := nil;

  for I := 0 to FGJExcludeMonList.Count - 1 do
    Dispose(PExcludeMonInfo(FGJExcludeMonList.Items[I]));
  FGJExcludeMonList.Clear;

  //PrepareDefaultPoint(); 转移到收到服务器消息后再进行

  SendClientMessage(CM_AUTOGJ, 0, 0, 0, 1, '');

  g_nGJStartX := g_MySelf.m_nCurrX;
  g_nGJStartY := g_MySelf.m_nCurrY;

  FGJCallMonMagicID := 0;

  FGJAutoPickupList.Clear;
  FGJExcludePickupList.Clear;
  FGJAutoPickupItem := nil;
  FGJWaitPickupTick := 0;
  FGJWaitCheckPickupTick := 0;
end;

