  if MyGetTickCount - g_RefreshAuctionAllItemsTick >= 1000 then begin
    g_RefreshAuctionAllItemsTick := MyGetTickCount;

    for I := Low(g_AuctionAllItems) to High(g_AuctionAllItems) do begin
      if (g_AuctionAllItems[I].AuctionID > 0) and (g_AuctionAllItems[I].TradingStatus = 0)
        and (g_AuctionAllItems[I].TimeLeft > 0) then begin
        Dec(g_AuctionAllItems[I].TimeLeft);
      end;
    end;
  end;

  if MyGetTickCount - g_RefreshAuctionMyItemsTick >= 1000 then begin
    g_RefreshAuctionMyItemsTick := MyGetTickCount;

    for I := Low(g_AuctionMyItems) to High(g_AuctionMyItems) do begin
      if (g_AuctionMyItems[I].AuctionID > 0) and (g_AuctionMyItems[I].TradingStatus = 0)
        and (g_AuctionMyItems[I].TimeLeft > 0) then begin
        Dec(g_AuctionMyItems[I].TimeLeft);
      end;
    end;
  end;

  if MyGetTickCount - g_RefreshAuctionMyAttentionTick >= 1000 then begin
    g_RefreshAuctionMyAttentionTick := MyGetTickCount;

    for I := Low(g_AuctionMyAttention) to High(g_AuctionMyAttention) do begin
      if (g_AuctionMyAttention[I].AuctionID > 0) and (g_AuctionMyAttention[I].TradingStatus = 0)
        and (g_AuctionMyAttention[I].TimeLeft > 0) then begin
        Dec(g_AuctionMyAttention[I].TimeLeft);
      end;
    end;
  end;

  PlayScene.CheckSceneShake;

  {$IF AntiPlugInMemory = 1}
  if g_TempAntiPlugDllMemoryModule <> nil then begin
    if tick_diff(g_TempAntiPlugFreeTick, MyGetTickCount) >= 5000 then begin
      MemoryFreeLibrary(g_TempAntiPlugDllMemoryModule, False);
      g_TempAntiPlugDllMemoryModule := nil;

      {$IF TESTMODE_LOG = 1}
      DScreen.AddChatBoardString('~~~~~~~~~~~卸载插件（FreeLibrary）~~~~~~~~~~~~~~~~~.', clRed, clBlack);
      {$IFEND}

      if g_boWaitLoadAntiPlugDllMemoryModule then begin
        {$IF TESTMODE_LOG = 1}
        DScreen.AddChatBoardString('~~~~~~~~~~~重新加载插件~~~~~~~~~~~~~~~~~.', clRed, clBlack);
        {$IFEND}
        g_boWaitLoadAntiPlugDllMemoryModule := False;

        ThreadHandle := BeginThread(nil, 0, @LoadDllAndInit, nil, 0, ThreadID);
        if (ThreadHandle <> INVALID_HANDLE_VALUE) and (ThreadHandle <> 0) then begin
          CloseHandle(ThreadHandle); //HZQ 20230524
        end else begin
          {$IF TESTMODE_LOG = 1}
          Error := GetLastError;
          DScreen.AddChatBoardString('开启线程异常，错误代码' + IntToStr(Error) + ',' + SysErrorMessage(Error), clRed, clBlack);
          {$IFEND}
        end;
      end;
    end;
  end;
  {$ELSE}
  if g_TempAntiPlugDllModule >= 32 then begin
    if tick_diff(g_TempAntiPlugFreeTick, MyGetTickCount) >= 5000 then begin
      FreeLibrary(g_TempAntiPlugDllModule);
      g_TempAntiPlugDllModule := 0;

      {$IF TESTMODE_LOG = 1}
      DScreen.AddChatBoardString('~~~~~~~~~~~卸载插件~~~~~~~~~~~~~~~~~.', clRed, clBlack);
      {$IFEND}

      if g_boWaitLoadAntiPlugDllModule then begin
        {$IF TESTMODE_LOG = 1}
        DScreen.AddChatBoardString('~~~~~~~~~~~加载缓存插件~~~~~~~~~~~~~~~~~.', clRed, clBlack);
        {$IFEND}
