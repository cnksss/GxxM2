  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  Buffer:Pointer;
begin
  g_SellPlayerMagicList.Lock;
  try
    for I := 0 to g_SellPlayerMagicList.Count - 1 do begin
      Dispose(PTClientMagic(g_SellPlayerMagicList.Items[I]));
    end;
    g_SellPlayerMagicList.Clear;
  finally
    g_SellPlayerMagicList.UnLock;
  end;

  g_SellPlayerMagicNGList.Lock;
  try
    for I := 0 to g_SellPlayerMagicNGList.Count - 1 do begin
      Dispose(PTClientMagic(g_SellPlayerMagicNGList.Items[I]));
    end;
    g_SellPlayerMagicNGList.Clear;
  finally
    g_SellPlayerMagicNGList.UnLock;
  end;

  g_SellPlayerContinuousMagicList.Lock;
