procedure TfrmMain.CSocketConnect(Sender:TObject; Socket:TCustomWinSocket);
begin
  // DebugOutStr('g_sServerAddr '+g_sServerAddr+' g_nServerPort '+inttostr(g_nServerPort));
  // DebugOutStr('CSocketConnect CSocket.Address:' + CSocket.Address + ' RemotePort：' + inttostr(CSocket.Port) + ' RemoteAddress:' + Socket.RemoteAddress + ' RemotePort：' + inttostr(Socket.RemotePort));
  // DScreen.AddChatBoardString('CSocketConnect:' , clRed, clWhite);
  EnterCriticalSection(g_SendSocketLock);
  try
    g_SendStream.Clear;
  finally
    LeaveCriticalSection(g_SendSocketLock);
  end;

  SocStr := '';
  BufferStr := '';
  nCheckReceiveLength := 0;
  dwCheckActiveTick := MyGetTickCount;

  g_boServerConnected := True;
  if g_ConnectionStep = cnsLogin then begin
    g_dwShowVersionBmpTick := MyGetTickCount;
    SendGetRandomCode(rctLogin);
  end;

  if g_boDeviceInitializeOK then begin
    if g_ConnectionStep = cnsSelChr then begin
      CmdTimer.Interval := 1;
      ActiveCmdTimer(tcFastQueryChr);
      LoginScene.OpenLoginDoor;
    end;

    if g_ConnectionStep = cnsReSelChr then begin
      CmdTimer.Interval := 1;
      ActiveCmdTimer(tcFastQueryChr);

      with FrmDlg.DscStart do begin
        Enabled := False;
        g_ClientRect := FrmDlg.DscStart.VirtualRect;
      end;
      g_dwReSelConnectTick := MyGetTickCount + 500;
      g_boReSelConnect := True;
    end;

    if g_ConnectionStep = cnsPlay then begin
      if not g_boServerChanging then begin
        ClearBag;

        DScreen.ClearChatBoard;
        DScreen.ChangeScene(stLoginNotice);

        // ★★★★★★修正小退后跑步卡★★★★★ chongchong 2018-09-20
          //setsockopt(CSocket.Socket.SocketHandle, SOL_SOCKET, SO_SNDBUF, @nZero, SizeOf(nZero));
      end else begin
        ChangeServerClearGameVariables;
        // DScreen.AddChatBoardString('ChangeServerClearGameVariables', clRed, clWhite);
      end;
      SendRunLogin;

    end;
  end;
end;

procedure TfrmMain.CSocketDisconnect(Sender:TObject; Socket:TCustomWinSocket);
begin

  g_boShowVersionBmp := False;
  g_boServerConnected := False;
  if (g_ConnectionStep = cnsLogin) and (not g_boSendLogin) then begin
    WelcomeScene.CloseScene;
    if g_boDeviceInitializeOK {and (not g_boShowVersionBmp)} and (not g_LoginGateClose) then begin
      FrmDlg.DMessageDlg('Connection closed...', [mbOk]);
      Close;
    end;
  end;

  if g_ConnectionStep = cnsPlay then begin
    // 卸载客户端反外挂插件chongchong 2016-07-12
    if Assigned(g_AntiPlugNotifyFunc) then begin
