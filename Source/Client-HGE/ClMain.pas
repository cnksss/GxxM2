{线程入口函数}

function LoadDllAndInit(p:Pointer):Integer;
type
  TSendSocketFunc = procedure(InBuf:PChar; InLen:Integer); stdcall;

  TEncodeMessageFunc = procedure(Msg:TDefaultMessage; OutText:PChar; var OutLen:Integer); stdcall;

  TDecodeMessageFunc = procedure(InText:PChar; InLen:Integer; Msg:PTDefaultMessage); stdcall;

  TEncodeDecodeFunc = function(InBuf:PChar; InLen:Integer; OutBuf:PChar; var OutSize:Integer):BOOL; stdcall;

  TAddChatTextFunc = procedure(InBuf:PChar; ForeColor:Integer; BackColor:Integer); stdcall;

  TInVirtualMachine = function():BOOL; stdcall;

  PAntiPlugData = ^TAntiPlugData;

  TAntiPlugData = packed record
    Handle:THandle; // 窗口句柄
    CheckCode:DWORD; // 网关上对每个连接随机生成的通信密码
    MsgIdent:array[0..3] of Word; // 4个预留消息头
    Account:array[0..27] of Char; // 帐户信息
    SendSocket:TSendSocketFunc; // 发送数据到网关
    EncodeMessage:TEncodeMessageFunc; // 将TDefaultMessage消息头转换为字符串
    DecodeMessage:TDecodeMessageFunc; // 将字符串转换为TDefaultMessage消息头
    EncodeBuffer:TEncodeDecodeFunc; // 将非可视字符编码为可视字符
    ZLibEncodeBuffer:TEncodeDecodeFunc; // zLib压缩
    ZLibDecodeBuffer:TEncodeDecodeFunc; // zLib解压
    AddChatText:TAddChatTextFunc; // 添加内容到聊天框
    PlugHeartbeatIdent:Word;
    Reserve1:Word;
    nGJSwitchAddr:PBOOL; // 挂机开关地址,指向的值为 4Byte 的 BOOL
    nRunGJFuncAddr:Pointer; // 挂机运行函数地址
    InVirtualMachine:TInVirtualMachine; // 检测是否虚拟机运行
    Reserve2:array[0..15] of Integer; // 预留
  end;

  TDoInit = procedure(lpBuffer:PChar; BufferLen:Integer); stdcall;
var
  DoUnInit:TAntiPlugDoUnInit;
  Buf:PChar;
  AntiPlugData:TAntiPlugData;
  DoInit:TDoInit;
  RSA:TLbRSA;
  OutBuf:PAnsiChar;
  OutBufSize:Integer;
  TempModule:PMemoryModule;
  RunCode, ErrCode:Integer;
  SendDefMsg:TDefaultMessage;
  S:string;
begin
  {$IF PRIVATE_CLIENT = 1} // 1  OR  0
  {.$I AddVmpFeatureCode.inc}
  {$ELSE}
  {$I VMProtectBegin.inc}
  {$IFEND}

  Result := 0; //HZQ 添加一个返回值

  {$IF TESTMODE = 1}
  OutputDebugString('跳过反外挂插件.');
  Exit;
  {$IFEND}

  {$IF TESTMODE_LOG = 1}
  MyOutputDebugString('准备加载插件..');
  {$IFEND}

  //ErrCode := 0;
  EnterCriticalSection(g_AntiPlugDllMemoryModuleCS);
  try
    {$IF TESTMODE_LOG = 1}
    MyOutputDebugString('申请解压缩内存..' + InttoStr(g_AntiPlugDllBufferSize));
    {$IFEND}

    //ErrCode := 1;
    GetMem(Buf, g_AntiPlugDllBufferSize);
    try
      {$IF TESTMODE_LOG = 1}
      MyOutputDebugString('反外挂插件并开始解压缩 .');
      {$IFEND}

      //ErrCode := 2;
      zLibDecompressString(g_AntiPlugDllString, Buf, g_AntiPlugDllBufferSize);

      {$IF TESTMODE_LOG = 1}
      MyOutputDebugString('解压缩插件完成 .');
      {$IFEND}

      //ErrCode := 3;
      g_AntiPlugNotifyFunc := nil;

      if not Assigned(g_AntiPlugDllMemory) then begin
        g_AntiPlugDllMemory := TMemoryStream.Create
      end else begin
        {$IF AntiPlugInMemory = 1}
        if g_AntiPlugDllMemoryModule <> nil then begin
          {$ELSE}
          if g_AntiPlugDllModule > 32 then begin
            {$IFEND}
            //ErrCode := 4;

            {$IF TESTMODE = 1}
            DebugOutStr('加载前反初始化');
            {$IFEND}

            {$IF AntiPlugInMemory = 1}
            DoUnInit := MemoryGetProcAddress(g_AntiPlugDllMemoryModule, 'DoUnInit');
            TempModule := g_AntiPlugDllMemoryModule;
            g_AntiPlugDllMemoryModule := nil;
            {$ELSE}
            DoUnInit := GetProcAddress(g_AntiPlugDllModule, 'DoUnInit');
            {$IFEND}

            //ErrCode := 5;
            if Assigned(DoUnInit) then begin
              //ErrCode := 6;
              DoUnInit;
            end;

            {$IF TESTMODE_LOG = 1}
            MyOutputDebugString('~~~~~~~~~~~反初始化2222~~~~~~~~~~~~~~~~~.');
            {$IFEND}

            //ErrCode := 7;

            {$IF AntiPlugInMemory = 1}
            MemoryFreeLibrary(TempModule);
            {$ELSE}
            FreeLibrary(g_AntiPlugDllModule);
            g_AntiPlugDllModule := 0;
            {$IFEND}
          end;
        end;

        {$IF TESTMODE_LOG = 1}
        MyOutputDebugString('完成反外挂插件接收 .');
        {$IFEND}

        //ErrCode := 8;
        FillChar(AntiPlugData, SizeOf(AntiPlugData), 0);

        //ErrCode := 9;

        // 前面8个字节是消息头 chongchong 2016-05-29
        Move(Buf^, AntiPlugData.MsgIdent, SizeOf(AntiPlugData.MsgIdent));
        Move(AntiPlugData.MsgIdent, g_AntiPlugMsgIdent, SizeOf(AntiPlugData.MsgIdent));

        {$IF TESTMODE_LOG = 1}
        MyOutputDebugString('处理插件数据 .');
        {$IFEND}

        //ErrCode := 10;
        g_AntiPlugDllMemory.Clear;

        ErrCode := 11;
        g_AntiPlugDllMemory.Write(PChar(Integer(Buf) + SizeOf(AntiPlugData.MsgIdent))^, g_AntiPlugDllBufferSize - SizeOf(AntiPlugData.MsgIdent));
        try
          {$IF TESTMODE_LOG = 1}
          MyOutputDebugString('内存加载插件dll .');
          {$IFEND}

          ErrCode := 11;

          {$IF AntiPlugInMemory = 1}
          g_AntiPlugDllMemoryModule := MemoryLoadLibary(g_AntiPlugDllMemory.Memory, g_AntiPlugDllMemory.Size, RunCode);
          {$ELSE}
          TempSaveFile := IncludeTrailingBackslash(GetTempDir) + MakeTempFileName('dll');
          g_AntiPlugDllMemory.SaveToFile(TempSaveFile);
          g_AntiPlugDllModule := LoadLibrary(PAnsiChar(TempSaveFile));
          {$IFEND}
          {$IF TESTMODE_LOG = 1}
          MyOutputDebugString('内存加载插件dll完成 .');
          {$IFEND}

          ErrCode := 12;
          {$IF AntiPlugInMemory = 1}
          if g_AntiPlugDllMemoryModule <> nil then begin
            {$ELSE}
            if g_AntiPlugDllModule > 32 then begin
              {$IFEND}
              {$IF TESTMODE_LOG = 1}
              MyOutputDebugString('准备获取函数地址：DoInit .');
              {$IFEND}

              ErrCode := 13;
              {$IF AntiPlugInMemory = 1}
              DoInit := MemoryGetProcAddress(g_AntiPlugDllMemoryModule, 1929); //'DoInit');
              {$ELSE}
              DoInit := GetProcAddress(g_AntiPlugDllModule, Pointer(1929)); //'DoInit');
              {$IFEND}
              //g_AntiPlug_ReLogin := MemoryGetProcAddress(g_AntiPlugDllMemoryModule, 'ReLogin');
              //g_AntiPlug_EncodeSendData := MemoryGetProcAddress(g_AntiPlugDllMemoryModule, 'EncodeSendData');

              ErrCode := 14;
              if Assigned(DoInit) then begin
                {$IF TESTMODE_LOG = 1}
                MyOutputDebugString('已获取函数地址：DoInit .');
                {$IFEND}

                ErrCode := 15;
                AntiPlugData.Handle := frmMain.Handle;
                AntiPlugData.SendSocket := @_SendSocket;
                AntiPlugData.EncodeMessage := @_EncodeMessage;
                AntiPlugData.DecodeMessage := @_DecodeMessage;
                AntiPlugData.EncodeBuffer := @_EncodeBuffer;
                AntiPlugData.ZLibEncodeBuffer := @_ZLibEncodeBuffer;
                AntiPlugData.ZLibDecodeBuffer := @_ZLibDecodeBuffer;
                AntiPlugData.AddChatText := @_AddChatText;

                AntiPlugData.CheckCode := g_AntiPlugCheckCode;
                FillChar(AntiPlugData.Account[0], SizeOf(AntiPlugData.Account), 0);
                Move(frmMain.LoginID[1], AntiPlugData.Account[0], Length(frmMain.LoginID));

                AntiPlugData.nGJSwitchAddr := @g_boGJRun;
                AntiPlugData.nRunGJFuncAddr := @TfrmMain.RunGJ;
                AntiPlugData.InVirtualMachine := @_IsInsideVMWare;

                ErrCode := 16;
                RSA := TLbRSA.Create(nil);
                try
                  {$IF TESTMODE_LOG = 1}
                  MyOutputDebugString('准备初始化参数');
                  {$IFEND}

                  RSA.KeySize := aks128;
                  RSA.PublicKey.ModulusAsString := '25EA5C3AE8DC9A9E31A3DAA5AC626285';
                  RSA.PublicKey.ExponentAsString := 'F7B7866C82EFA9BAFF18376FD9D23671';

                  {$IF TESTMODE_LOG = 1}
                  MyOutputDebugString('加密参数');
                  {$IFEND}

                  ErrCode := 17;
                  GetMem(OutBuf, 1024);
                  try
                    ErrCode := 18;
                    {$IF TESTMODE_LOG = 1}
                    MyOutputDebugString('加密参数1');
                    {$IFEND}
                    OutBufSize := RSA.EncryptBuffer(AntiPlugData, SizeOf(AntiPlugData), OutBuf^);

                    {$IF TESTMODE_LOG = 1}
                    MyOutputDebugString('反外挂开始初始化');
                    {$IFEND}

                    ErrCode := 19;
                    DoInit(OutBuf, OutBufSize);

                    {$IF TESTMODE_LOG = 1}
                    MyOutputDebugString('反外挂初始化完成');
                    {$IFEND}
                  finally
                    FreeMem(OutBuf);
                  end;

                  ErrCode := 20;
                  {$IF AntiPlugInMemory = 1}
                  g_AntiPlugNotifyFunc := MemoryGetProcAddress(g_AntiPlugDllMemoryModule, 1727);
                  {$ELSE}
                  g_AntiPlugNotifyFunc := GetProcAddress(g_AntiPlugDllModule, Pointer(1727));
                  {$IFEND}

                  {$IF TESTMODE_LOG = 1}
                  MyOutputDebugString('反外挂加载成功');
                  {$IFEND}
                finally
                  RSA.Free;
                end;
              end else begin
                {$IF TESTMODE_LOG = 1}
                MyOutputDebugString('DoInit未找到！');
                {$IFEND}

                SendDefMsg := MakeDefaultMsg(CM_IOCP_PLUG_LOAD_FAIL, -10, 0, 0, 0);
                S := EncodeMessage(SendDefMsg);
                _SendSocket(PChar(S), Length(S));
              end;
            end else begin
              SendDefMsg := MakeDefaultMsg(CM_IOCP_PLUG_LOAD_FAIL, RunCode, 0, 0, 0);
              S := EncodeMessage(SendDefMsg);
              _SendSocket(PChar(S), Length(S));

              {$IF TESTMODE_LOG = 1}
              MyOutputDebugString('加载插件失败:' + SysErrorMessage(GetLastError) + ';' + 'ErrorCode:' + IntToStr(RunCode));
              {$IFEND}
            end;
        except
          on E:Exception do begin
            SendDefMsg := MakeDefaultMsg(CM_IOCP_PLUG_LOAD_FAIL, GetLastError, ErrCode, 0, 1);
            S := EncodeMessage(SendDefMsg);
            _SendSocket(PChar(S), Length(S));

            {$IF TESTMODE_LOG = 1}
            MyOutputDebugString('插件加载异常:' + E.Message);
            {$IFEND}
          end;
        end;

        FillChar(g_AntiPlugDllMemory.Memory^, g_AntiPlugDllMemory.Size, 0);
        g_AntiPlugDllMemory.Clear;
    finally
      FreeMem(Buf, g_AntiPlugDllBufferSize);
    end;
  finally
    LeaveCriticalSection(g_AntiPlugDllMemoryModuleCS);
  end;

  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}
end;

