procedure TfrmMain.SendPickup(IsAutoPickup:Boolean);
var
  I:Integer;
  Msg:TDefaultMessage;
  CanPickup:Boolean;
  PickItem:pTDropItem;
  EventData:TAntiPlugItemEventData;
begin
  if IsAutoPickup then begin
    if (Cutecode_T(g_nStartPickupX) <> g_MySelf.m_nCurrX) or (Cutecode_T(g_nStartPickupY) <> g_MySelf.m_nCurrY) then begin
      g_dwStartAutoPickupTick := MyGetTickCount;
      g_nStartPickupX := Makecode_T(g_MySelf.m_nCurrX);
      g_nStartPickupY := Makecode_T(g_MySelf.m_nCurrY);
      Exit;
    end;

    if MyGetTickCount - g_dwStartAutoPickupTick < g_ClientConfig.dwPluginPickupTime then
      Exit;
  end;

  CanPickup := False;

  // 修正包裹满时不能拾取金币 chongchong 2014-03-06
  PickItem := PlayScene.GetXYDropItems(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
  if (PickItem <> nil) then begin
    if ((PickItem.Name = g_sGoldName) or (PickItem.Name = g_sGameGoldName)) then
      CanPickup := True
    else begin
      // 当包裹放满物品时，不捡起物品 chongchong 2014-01-15
      CanPickup := False;
      for I := 0 to GetMaxBagCount - 1 do begin
        if Length(g_ItemArr[I].S.Name) = 0 then begin
          CanPickup := True;
          Break;
        end;
      end;
    end;
  end;

  if CanPickup then begin
    if IsAutoPickup then
      g_dwStartAutoPickupTick := MyGetTickCount;

    Msg := MakeDefaultMsg(CM_PICKUP, 0, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, 0);
    SendSocket(EncodeMessage(Msg));

    EventData.nX := g_MySelf.m_nCurrX;
    EventData.nY := g_MySelf.m_nCurrY;
    EventData.ItemID := 0;

    if Assigned(g_AntiPlugNotifyFunc) then begin
      g_AntiPlugNotifyFunc(event_SendPickUp, @EventData, SizeOf(EventData));
    end;
  end;
end;

