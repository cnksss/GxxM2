procedure TfrmMain.ProcessActionMessages;
var
  mx, my, dx, dy, crun, I:Integer;
  ndir, adir, mdir:Byte;
  bowalk, bostop:Boolean;
  PlugData:TAntiPlugNotifyEventMoveData;
label
  LB_WALK, LB_RUN;                                      

begin
  if g_MySelf = nil then
    Exit;

  EnterCriticalSection(FCSActionLock);
  try
    if (g_ChrAction = caWalk) or (g_ChrAction = caRun) then begin
      // MyDebugString('action: run/walk');
      //OutputDebugString(Pchar(Format('run/walk [Enter]', []))); //const nRunCount
    end;

    if (g_ChrAction > caNone) and (g_nTargetX >= 0) and CanNextAction(caWalk) and CanNextAction(caRun) and ServerAcceptNextAction(False) then begin

      if (g_nTargetX <> g_MySelf.m_nCurrX) or (g_nTargetY <> g_MySelf.m_nCurrY) then begin
        mx := g_MySelf.m_nCurrX;
        my := g_MySelf.m_nCurrY;
        dx := g_nTargetX;
        dy := g_nTargetY;
        ndir := GetNextDirection(mx, my, dx, dy);

        // 客户端处理连续跑、走 (记录位置)  chongchong 2014-10-22
        case g_ChrAction of
          caWalk:begin
              //(*
              LB_WALK: {
              DScreen.AddSysMsg ('caWalk ' + IntToStr(Myself.XX) + ' ' +
                                             IntToStr(Myself.m_nCurrY) + ' ' +
                                             IntToStr(TargetX) + ' ' +
                                             IntToStr(TargetY));
                                             }
                  // if (g_ChrAction = caNone) or g_boMapMovingWait then Exit;
              crun := g_MySelf.CanWalk;


              if IsUnLockAction(CM_WALK, ndir) and (crun > 0) then begin
                // DScreen.AddChatBoardString('LB_WALK 1', clGreen, clWhite);
                GetNextPosXY(ndir, mx, my);
                bostop := False;
                if not PlayScene.CanWalk(mx, my) then begin
                  // DScreen.AddChatBoardString('LB_WALK 2', clGreen, clWhite);
                  bowalk := False;
                  adir := 0;
                  if not bowalk then begin
                    mx := g_MySelf.m_nCurrX;
                    my := g_MySelf.m_nCurrY;
                    GetNextPosXY(ndir, mx, my);
                    if CheckDoorAction(mx, my) then
                      bostop := True;
                  end;
                  if (not bostop) and (not PlayScene.CrashMan(mx, my)) then begin
                    mx := g_MySelf.m_nCurrX;
                    my := g_MySelf.m_nCurrY;
                    adir := PrivDir(ndir);
                    GetNextPosXY(adir, mx, my);
                    if not Map.CanMove(mx, my) then begin
                      mx := g_MySelf.m_nCurrX;
                      my := g_MySelf.m_nCurrY;
                      adir := NextDir(ndir);
                      GetNextPosXY(adir, mx, my);
                      if Map.CanMove(mx, my) then
                        bowalk := True;
                      // DScreen.AddChatBoardString('LB_WALK 3', clGreen, clWhite);
                    end else
                      bowalk := True;
                  end;
                  if bowalk then begin
                    if CanNextWalk then begin
                      {$IF TESTMODE = 1}
                      //DScreen.AddChatBoardString(Format('walk: %d,%d -> %d, %d', [g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, mx, my]) , clGreen, clWhite);   // chongchong 2017-06-21
                      {$IFEND}

