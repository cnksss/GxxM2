                        Break;
                      end;
                    end;
                  finally
                    g_MagicList.UnLock;
                  end;
                end;
              end;
            end;
          end
          else if (MagicID = 56) and (g_ClientConfig.boSmartSwordHit and g_ConfigDlg.ConfigCheckeds[ckSmartSwordHit]) then begin
            if (not g_boNextTimeSwordHit) and g_WarrContinueHitManager.CanOpenMagic(56) then begin
