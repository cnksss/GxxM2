procedure TfrmMain.ProcessMessageChangePoison(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  Item:PTClientItem;
begin
  if g_MyHero = nil then
    Exit;
  g_WaitingHeroUseItem.Index := U_BUJUK;
  if (g_HeroUseItems[U_BUJUK].S.StdMode <> 25) then
    Exit;

  { 绿毒 }
  if g_HeroUseItems[U_BUJUK].S.Shape = 1 then begin
    for I := Low(g_HeroItemArr) to High(g_HeroItemArr) do begin
      Item := @g_HeroItemArr[I];
      if Length(Trim(Item.S.Name)) = 0 then
        Continue;

      // 红毒
      if (Item.s.StdMode = 25) and (Item.s.Shape = 2) then begin
        g_dwMoveItemTick := MyGetTickCount;
        g_MovingItem.Index := I;
        g_MovingItem.ItemType := mtHeroBagItem;
        g_MovingItem.Item := Item^;

        g_WaitingHeroUseItem := g_MovingItem;
        g_WaitingHeroUseItem.Index := U_BUJUK;
        frmMain.SendHeroTakeOnItem(U_BUJUK, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
        g_HeroItemArr[I].S.Name := '';
        g_boItemMoving := False;

        Break;
      end;
    end;
  end // 红毒
  else if g_HeroUseItems[U_BUJUK].S.Shape = 2 then begin
    for I := Low(g_HeroItemArr) to High(g_HeroItemArr) do begin
      Item := @g_HeroItemArr[I];
      if Length(Trim(Item.S.Name)) = 0 then
        Continue;

      // 绿毒
      if (Item.s.StdMode = 25) and (Item.s.Shape = 1) then begin
        g_MovingItem.Index := I;
        g_MovingItem.ItemType := mtHeroBagItem;
        g_MovingItem.Item := Item^;

        g_WaitingHeroUseItem := g_MovingItem;
        g_WaitingHeroUseItem.Index := U_BUJUK;
        frmMain.SendHeroTakeOnItem(U_BUJUK, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
        g_HeroItemArr[I].S.Name := '';
        g_boItemMoving := False;

        Break;
      end;
    end;
  end;

  ArrangeHeroItembag;
end;

