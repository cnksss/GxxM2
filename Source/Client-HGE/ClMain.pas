procedure TfrmMain.ProcessMessageItemShow(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  DropItem:pTDropItem;
  sColor, sCount:string;
  sValueItem:string;
  sName:string;
  sDBName:string;
  sItemName:string;
  IsNew:Boolean;
  IsValueItem:Boolean;
  nCount, nOverlapCount:Integer;
  ShowItem:pTShowItem;
  boTeleport:Boolean;
  EffectIndex:Integer;
  EventData:TAntiPlugItemEventData;
begin
  sItemName := DecodeString(sData);
  sItemName := GetValidStr3_Ex(sItemName, sColor, '/');
  sItemName := GetValidStr3_Ex(sItemName, sCount, '/');
  sItemName := GetValidStr3_Ex(sItemName, sValueItem, '/');
  sItemName := GetValidStr3_Ex(sItemName, sName, '/');
  sItemName := GetValidStr3_Ex(sItemName, sDBName, '/');

  nCount := StrToIntDef(sCount, 0);
  IsValueItem := StrToIntDef(sValueItem, 0) = 1;

  nOverlapCount := LoWord(nCount);
  EffectIndex := HiWord(nCount);

  if sDBName = '' then
    sDBName := sName;
  g_DropItemsMgr.Lock;
  try
    DropItem := g_DropItemsMgr.AddDropItem(DefMsg.Recog, DefMsg.Param, DefMsg.Tag, sDBName, EffectIndex, IsNew);
    if DropItem <> nil then begin
      if not IsNew then begin
        DropItem.Visible := True;
        DropItem.ItemColor := GetRGB(StrToIntDef(sColor, 255));
        DropItem.Name := ProcessItemName(sName); // 优化绘制时cpu占用 2019-11-27 01:15:46
        DropItem.DBName := sDBName;

        DropItem.OverlapCount := nOverlapCount;
        DropItem.boValueItem := IsValueItem;
      end
      else begin
        DropItem.Visible := True;
        DropItem.looks := DefMsg.series;
        DropItem.Name := ProcessItemName(sName); // 优化绘制时cpu占用 2019-11-27 01:15:46
        //DropItem.DBName := sDBName;
        DropItem.FlashTime := MyGetTickCount - LongWord(Random(3000));
        DropItem.ShowFlash := False;
        DropItem.FlashStep := 0;
        DropItem.ItemColor := GetRGB(StrToIntDef(sColor, 255));

        DropItem.OverlapCount := nOverlapCount;
        DropItem.boValueItem := IsValueItem;

        DropItem.ItemTexture := nil;
        DropItem.NameImageInfo.Width := 0;
        DropItem.NameImageInfo.Height := 0;
        DropItem.NameImageInfo.ImageIndexs := nil;
        DropItem.ShowItem := nil;
        DropItem.ShowName := False;

        DropItem.ValueItemEffectFrame := 0;
        DropItem.ValueItemEffectTick := MyGetTickCount;

        if PlugInEnabled then
          DropItem.ShowItem := g_ConfigDlg.GetShowItem(sDBName);
      end;
    end;
  finally
    g_DropItemsMgr.UnLock;
  end;

  if (DropItem <> nil) and IsNew then begin
    EventData.nX := DropItem.X;
    EventData.nY := DropItem.y;
    EventData.ItemID := DropItem.id;

    if Assigned(g_AntiPlugNotifyFunc) then begin
      g_AntiPlugNotifyFunc(event_ItemShow, @EventData, SizeOf(EventData));
    end;

    if (DropItem.ShowItem <> nil) then
      g_ConfigDlg.HintItem(sDBName, DefMsg.param, DefMsg.tag);

    if PlugInEnabled and (MyGetTickCount - FAutoTeleportTick >= (g_ClientConfig.dwUserMoveTime * 1000 + 500)) then begin
      ShowItem := g_FileItemDB.Find(sDBName);
      if (ShowItem <> nil) and (ShowItem.boAutoMove) then begin
        boTeleport := False;
        for I := Low(g_UseItems) to High(g_UseItems) do begin
          if (Length(g_UseItems[I].S.Name) > 0) and (g_UseItems[I].MakeIndex > 0) then begin
            if (I = U_WEAPON) or (I = U_RIGHTHAND) or (I = U_DRESS) or (I = U_FASHIONDRESS) or (I = U_FASHIONWEAPON) then begin
              if (g_UseItems[I].S.AniCount in [112, 157, 158, 159, 160]) then begin
                boTeleport := True;
                Break;
              end;
            end;

            if g_UseItems[I].S.Shape in [112, 157, 158, 159, 160] then begin
              boTeleport := True;
              Break;
            end;

            if ((I = U_BUJUK) or (I = 5)) and (g_UseItems[I].S.StdMode = 25) and (g_UseItems[I].S.Shape = 6) then begin
              boTeleport := True;
              Break;
            end;
          end;
        end;

        for I := Low(g_JewelryBoxItems) to High(g_JewelryBoxItems) do begin
          if (Length(g_JewelryBoxItems[I].S.Name) > 0) and (g_JewelryBoxItems[I].MakeIndex > 0) then begin
            if g_JewelryBoxItems[I].S.Shape in [112, 157, 158, 159, 160] then begin
              boTeleport := True;
              Break;
            end;
          end;
        end;

        if boTeleport then begin
          FAutoTeleportTick := MyGetTickCount;
          if g_sUserMoveCmd <> '' then begin
            frmMain.SendSay(Format('@%s %d %d', [g_sUserMoveCmd, DefMsg.param, DefMsg.tag]));
          end;
        end;
      end;
    end;
  end;
end;

procedure TfrmMain.ProcessMessageItemHide(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  IsDelete:Boolean;
  DropItem:pTDropItem;
  nX, nY:Word;
  EventData:TAntiPlugItemEventData;
begin
  g_DropItemsMgr.Lock;
  try
    DropItem := g_DropItemsMgr.DelDropItem(DefMsg.Recog, nX, nY);
    IsDelete := DropItem <> nil;

    if IsDelete then begin
      if DropItem = g_FocusItem then
        g_FocusItem := nil;
      if DropItem = g_OldFocusItem then
        g_OldFocusItem := nil;
    end;
  finally
    g_DropItemsMgr.UnLock;
  end;

  if IsDelete then begin
    EventData.nX := nX;
    EventData.nY := nY;
    EventData.ItemID := DefMsg.Recog;

    if Assigned(g_AntiPlugNotifyFunc) then begin
      g_AntiPlugNotifyFunc(event_ItemHide, @EventData, SizeOf(EventData));
    end;
  end;
end;

