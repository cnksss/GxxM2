procedure TfrmMain.ProcessMessageRunGateSpeedIntervals(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  OutBuf:array[0..81920 - 1] of Char;
  OutSize:Integer;
  SendSpeedIntervalsToClient:array[TAntiPlugActionMode] of Boolean;
  SpeedIntervalsCount:Integer;
  ActionMode:TAntiPlugActionMode;
  P:pByte;
begin
  if DefMsg.Recog = Length(sData) then begin
    OutSize := zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));
    if OutSize = MakeLong(DefMsg.Param, DefMsg.Series) then begin
      if OutSize > SizeOf(SendSpeedIntervalsToClient) then begin
        SpeedIntervalsCount := 0;
        Move(OutBuf[0], SendSpeedIntervalsToClient, SizeOf(SendSpeedIntervalsToClient));

        for ActionMode := Low(TAntiPlugActionMode) to High(TAntiPlugActionMode) do begin
          if SendSpeedIntervalsToClient[ActionMode] then begin
            Inc(SpeedIntervalsCount);
          end;
        end;

        P := @OutBuf[0];
        if OutSize = SizeOf(SendSpeedIntervalsToClient) + SpeedIntervalsCount * SizeOf(TSpeedIntervals) then begin
          Inc(P, SizeOf(SendSpeedIntervalsToClient));
          for ActionMode := Low(TAntiPlugActionMode) to High(TAntiPlugActionMode) do begin
            if SendSpeedIntervalsToClient[ActionMode] then begin
              Move(P^, g_wActionSpeedIntervals[ActionMode], SizeOf(g_wActionSpeedIntervals[ActionMode]));
              Inc(P, SizeOf(g_wActionSpeedIntervals[ActionMode]));
            end;
          end;
        end;
      end;
    end;
  end;
end;

