procedure TfrmMain.SendMsg(Actor:TActor; wIdent, wParam, nParam1, nParam2, nParam3:Integer; sMsg:string);
var
  ProcessMessage:pTProcessMessage;
begin
  try
    m_MsgList.Lock;
    New(ProcessMessage);
