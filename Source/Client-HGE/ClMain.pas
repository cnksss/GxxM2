        //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~关闭逐日.', clRed, clBlack);
        {$IFEND}
      end;
    CM_66HIT: {// 开天斩重击 piaoyun 2013-08-24} begin
        g_boNextTime66Hit := False;
