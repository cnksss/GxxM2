procedure TfrmMain.ProcessMessageGuildOpenGuildAddDlg(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  SLine, sGuildName, sOnlineCount, sWantAddGuild:string;
  nCount:Integer;
  SL:TStringList;
begin
  SL := TStringList.Create;
  try
    SL.Delimiter := '/';
    SL.DelimitedText := DecodeString(sData);

    sWantAddGuild := '';

    FrmDlg.ShowGuildList.Clear;
    for I := 0 to SL.Count - 1 do begin
      SLine := SL.Strings[I];

      SLine := GetValidStr3_Ex(SLine, sGuildName, ':');
      SLine := GetValidStr3_Ex(SLine, sOnlineCount, ':');
      nCount := StrToIntDef(SLine, 0);

      if DefMsg.Recog = I then begin
        sWantAddGuild := sGuildName;
      end;

      if (nCount >= 0) and (Length(sGuildName) > 0) then begin
        FrmDlg.ShowGuildList.Add(sGuildName, StrToIntDef(sOnlineCount, 0), nCount);
      end;
    end;

    FrmDlg.ShowGuildList.DoSort;
    FrmDlg.WantAddGuildName := sWantAddGuild;
    FrmDlg.OpenDGuildApplyDlg;
  finally
    SL.Free;
  end;
end;

