procedure TfrmMain.ProcessMessageWeather(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, Index:Integer;
  sFileName:string;
  Effect:PTServerWeateherEffect;
  Buffer:PChar;
begin
  if Length(sData) = DefMsg.Series * (SizeOf(TServerWeateherEffect) + 1) then begin
    for I := Low(g_WeateherEffect) to High(g_WeateherEffect) do begin
      g_WeateherEffect[I].boIsUsed := False;
    end;

    Buffer := PChar(sData);
    for I := 0 to DefMsg.Series - 1 do begin
      Index := Ord(Buffer^);
      Inc(Buffer);

      Effect := PTServerWeateherEffect(Buffer);

      if (Index >= Low(g_WeateherEffect)) and (Index <= High(g_WeateherEffect)) then begin
        g_WeateherEffect[Index].boIsUsed := Effect.boIsUsed;
        g_WeateherEffect[Index].boIsDark := Effect.boIsDark;
        g_WeateherEffect[Index].dwTick := MyGetTickCount;
        g_WeateherEffect[Index].dwIndex := 0;
        g_WeateherEffect[Index].sMusic := Effect.sMusic;
      end;

      Buffer := Buffer + SizeOf(TServerWeateherEffect);
    end;

    for I := Low(g_WeateherEffect) to High(g_WeateherEffect) do begin
      sFileName := {'\wav\' + } g_WeateherEffect[I].sMusic;

      if g_WeateherEffect[I].boIsUsed then begin
        AddBGMusic(sFileName);
      end
      else
        DelBGMusic(sFileName);
    end;
  end;
end;

