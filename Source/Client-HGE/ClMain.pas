procedure TfrmMain.RzToolButtonCloseClick(Sender:TObject);
var
  WebPanel:TWebPanel;
begin
  if (WebBrowserIndex >= 0) and (WebBrowserIndex < WebBrowserList.Count) then begin
    WebPanel := TWebPanel(WebBrowserList.Items[WebBrowserIndex]);
    WebBrowserList.Remove(WebPanel);
    if (WebBrowserIndex >= 0) and (WebBrowserIndex < WebBrowserList.Count) then begin
      TWebPanel(WebBrowserList.Items[WebBrowserIndex]).Visible := True;
    end else begin
      while WebBrowserIndex > 0 do begin
        Dec(WebBrowserIndex);
        if (WebBrowserIndex >= 0) and (WebBrowserIndex < WebBrowserList.Count) then begin
          TWebPanel(WebBrowserList.Items[WebBrowserIndex]).Visible := True;
          break;
        end;
      end;
    end;
    WebPanel.WebBrowser.Free;
