      g_AntiPlugDllMemory2.Write(Buf^, g_AntiPlugDllBufferSize2);
      try

        {$IF TESTMODE_LOG = 1}
        MyOutputDebugString('内存加载插件dll .');
        {$IFEND}
        {$IF AntiPlugInMemory = 1}
        g_AntiPlugDllMemoryModule2 := MemoryLoadLibary(g_AntiPlugDllMemory2.Memory, g_AntiPlugDllMemory2.Size, RunCode);
        {$ELSE}
        TempSaveFile := IncludeTrailingBackslash(GetTempDir) + MakeTempFileName('dl');
        g_AntiPlugDllMemory2.SaveToFile(TempSaveFile);
        g_AntiPlugDllModule2 := LoadLibrary(PAnsiChar(TempSaveFile));
