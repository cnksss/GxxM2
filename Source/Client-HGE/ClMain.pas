procedure TfrmMain.ProcessMessageDelMagic(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
begin
  // 防止删除内功技能假象 --- piaoyun 2013-07-14
  if DefMsg.Param = 0 then begin
    g_MagicList.Lock;
    try
      for I := 0 to g_MagicList.Count - 1 do begin
        if PTClientMagic(g_MagicList.Items[I]).Def.wMagicId = DefMsg.Recog then begin
          FrmDlg.DelScreenMagicButton(g_MagicList.Items[I]);
          Dispose(PTClientMagic(g_MagicList.Items[I]));
          g_MagicList.Delete(I);
          Break;
        end;
      end;
    finally
      g_MagicList.UnLock;
    end;
  end;

  // 内功
  if (DefMsg.Param = 3 {静之}) or (DefMsg.Param = 4 {怒之}) then begin
    g_MagicNGList.Lock;
    try
      for I := 0 to g_MagicNGList.Count - 1 do begin
        if (PTClientMagic(g_MagicNGList.Items[I]).Def.wMagicId = DefMsg.Recog) and (PTClientMagic(g_MagicNGList.Items[I]).Def.MagicAttr = TMagicAttr(DefMsg.Param)) then begin
          Dispose(PTClientMagic(g_MagicNGList.Items[I]));
          g_MagicNGList.Delete(I);
          Break;
        end;
      end;
    finally
      g_MagicNGList.UnLock;
    end;
  end;

  g_ContinuousMagicList.Lock;
  try
    for I := 0 to g_ContinuousMagicList.Count - 1 do begin
      if PTClientMagic(g_ContinuousMagicList.Items[I]).Def.wMagicId = DefMsg.Recog then begin
        Dispose(PTClientMagic(g_ContinuousMagicList.Items[I]));
        g_ContinuousMagicList.Delete(I);
        Break;
      end;
    end;
  finally
    g_ContinuousMagicList.UnLock;
  end;
  if (FrmDlg is TSerialWindows) and (g_ClientVersion in [cvSerial, cvMirSequel, cvMirNewUI205]) then begin
    TSerialWindows(FrmDlg).RefreshUpgradeButtons;
    TSerialWindows(FrmDlg).NewStateWindows.RefreshMySelfMagicList;
  end;
  g_ConfigDlg.RefreshMySelfMagicList;
end;

procedure TfrmMain.ProcessMessageMagicLvExp(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  MagicAttr:TMagicAttr;
begin
  MagicAttr := TMagicAttr(StrToIntDef(DecodeString(sData), 0));
  if MagicAttr = mtContinuous then begin
    g_ContinuousMagicList.Lock;
    try
      for I := 0 to g_ContinuousMagicList.Count - 1 do begin
        if PTClientMagic(g_ContinuousMagicList.Items[I]).Def.wMagicId = DefMsg.Recog then begin
          PTClientMagic(g_ContinuousMagicList.Items[I]).Level := LoByte(DefMsg.param);
          PTClientMagic(g_ContinuousMagicList.Items[I]).NewLevel := HiByte(DefMsg.param);
          PTClientMagic(g_ContinuousMagicList.Items[I]).CurTrain := MakeLong(DefMsg.tag, DefMsg.series);
          Break;
        end;
      end;
    finally
      g_ContinuousMagicList.UnLock;
    end;
  end
  else if MagicAttr in [mtDefense, mtAttack] then begin
    g_MagicNGList.Lock;
    try
      for I := 0 to g_MagicNGList.Count - 1 do begin
        if (PTClientMagic(g_MagicNGList.Items[I]).Def.wMagicId = DefMsg.Recog) and (PTClientMagic(g_MagicNGList.Items[I]).Def.MagicAttr = MagicAttr) then begin
          PTClientMagic(g_MagicNGList.Items[I]).Level := LoByte(DefMsg.param);
          PTClientMagic(g_MagicNGList.Items[I]).NewLevel := HiByte(DefMsg.param);
          PTClientMagic(g_MagicNGList.Items[I]).CurTrain := MakeLong(DefMsg.tag, DefMsg.series);
          Break;
        end;
      end;
    finally
      g_MagicNGList.UnLock;
    end;
  end
  else begin
    g_MagicList.Lock;
    try
      for I := 0 to g_MagicList.Count - 1 do begin
        if PTClientMagic(g_MagicList.Items[I]).Def.wMagicId = DefMsg.Recog then begin
          PTClientMagic(g_MagicList.Items[I]).Level := LoByte(DefMsg.param);
          PTClientMagic(g_MagicList.Items[I]).NewLevel := HiByte(DefMsg.param);
          PTClientMagic(g_MagicList.Items[I]).CurTrain := MakeLong(DefMsg.tag, DefMsg.series);
          Break;
        end;
      end;
    finally
      g_MagicList.UnLock;
    end;
  end;

  if (FrmDlg is TSerialWindows) and (g_ClientVersion in [cvSerial, cvMirSequel, cvMirNewUI205]) then begin
    TSerialWindows(FrmDlg).RefreshUpgradeButtons;
    TSerialWindows(FrmDlg).NewStateWindows.RefreshUpgradeButtons;
  end;
end;

