procedure TfrmMain.OnUserCenterNotify(var msg: TMessage);
begin
    if g_nClientLoginMode = CLIENT_MODE_UC then begin
        case msg.WParam of
        TUserCenterManager.UC_LOGIN_RET: begin
            if (msg.LParam = 100200) or (msg.LParam = 0) then begin
               TSerialWindows(FrmDlg).OpenUcSubAccountDlg();
            end else if (msg.LParam = 101007) then begin
               TSerialWindows(FrmDlg).UcShowHintDlg(9);  //手机验证码错误
            end else if (msg.LParam = 101009) then begin
               TSerialWindows(FrmDlg).UcShowHintDlg(8);  //密码或账号错误
            end else if (msg.LParam = 100400) or (msg.LParam = 100408) or (msg.LParam < 0) then begin
                TSerialWindows(FrmDlg).UcShowHintDlg(4); //后台繁忙
            end else if (msg.LParam = 100430) then begin
                TSerialWindows(FrmDlg).UcShowHintDlg(10); //账户格式错误
            end else if (msg.LParam = 100202) or (msg.LParam = 100203) then begin
               TSerialWindows(FrmDlg).UcShowHintDlg(3); //二维码过期
            end;
        end;

        TUserCenterManager.UC_PHONE_CODE_RET: begin
            if (msg.LParam = 100404) or (msg.LParam < 0) then begin
                TSerialWindows(FrmDlg).ResetGetPhoneVerifyCodeLabel();
                TSerialWindows(FrmDlg).UcShowHintDlg(2); //请求验证码失败
            end else if (msg.LParam = 100405) or (msg.LParam = 100400) then begin
                TSerialWindows(FrmDlg).UcShowHintDlg(7); //手机号请求过于频繁
            end;
        end;

        TUserCenterManager.UC_WEICHAT_CODE_RET: begin
            if msg.LParam = 0 then begin
                g_UserCenterManager.UpdateWechatQrCode(); //生成二维码，必须放在放在用户中心线程中否则会有白屏的BUG
            end;
        end;

        TUserCenterManager.UC_SUB_ACCOUNT_RET: begin
            if msg.LParam = 0 then begin
                 TSerialWindows(FrmDlg).SetSubAccountList(0);
            end else {if msg.LParam =  then} begin
               
            end;
        end;

        end;
    end;
end;

