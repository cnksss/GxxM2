procedure TfrmMain.ProcessMessageOpenHumDlg(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  IsNewOpen:Boolean;
  StateWindows:TStateWindows;
begin
  if DefMsg.Param = 7 then begin
    if not TSerialWindows(FrmDlg).DItemBag.Visible then
      TSerialWindows(FrmDlg).OpenDItemBagDlg;

    if (DefMsg.Tag <> 0) or (DefMsg.Series <> 0) then begin
      TSerialWindows(FrmDlg).DItemBag.Left := SmallInt(DefMsg.Tag);
      TSerialWindows(FrmDlg).DItemBag.Top := SmallInt(DefMsg.Series);
    end;

    Exit;
  end;

  IsNewOpen := False;
  if (g_ClientConfig.boUseOldSerialWindows) then begin
    StateWindows := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows); //HZQ 20230524补全初始化变量, 没有找到旧的StateWindows

    if (DefMsg.Param = 8) then begin
      IsNewOpen := not TSerialWindows(FrmDlg).DSWJewelryBoxDlg.Visible;
