function TfrmMain.ServerAcceptNextAction(IsAttack:Boolean):Boolean;
begin
  Result := True;

  if FActionLock and (not (IsAttack and g_ClientConfig.boNoCaton and g_ConfigDlg.ConfigCheckeds[ckNoCaton])) then begin
    if MyGetTickCount - ActionLockTime > 10 * 1000 then begin
      FActionLock := False;
      g_boLatestSpell := False;
    end;
    Result := False;
  end;
end;

function TfrmMain.CanNextAction(Action:TChrAction):Boolean;
var
    dwCurTick:DWORD;
begin
  Result := False;
  if g_boMySelfLock then begin
    //OutputDebugString('MyselfLock');
    Exit;
  end;

  dwCurtick := MyGetTickCount;


  // 修正在不停的跑步过程中，使用随机传送卷可能导致的卡位 chongchong 2017-11-21
  if (Action in [caWalk, caRun]) then begin
    if (dwCurtick - g_dwMapMovingWaitTick <= 90) then begin
      //OutputDebugString('Move Fail');
      Exit;
    end;

    // ★★★★★★★★ 修正在跑动时自动合击卡位 ★★★★★★★★ chongchong 2018-06-19 20:54:53
    //if g_LastGroupAttackTick - dwCurtick <= 50 then begin
    if dwCurtick - g_LastGroupAttackTick <= 50 then begin //HZQ 20230704
      //OutputDebugString('aaa');
      Exit;
    end;
    //OutputDebugString(PChar(Format('Action[%d], CurrentAction[%d]', [Integer(Action), g_MySelf.m_nCurrentAction])));
  end;

  //脚本释放技能卡顿时 g_MySelf.IsIdle条件为假，需要进一步跟踪 20230703
  if (g_MySelf.IsIdle)  and (dwCurtick - g_dwDizzyDelayStart > g_dwDizzyDelayTime) then begin
    if (g_MySelf.m_nState and $04000000 = 0) and (g_MySelf.m_nState and $00080000 = 0) then begin
      case Action of
        caWalk:begin
            Result := g_boCanMove;
            if Result and g_ClientConfig.boSkill43LockParaly and g_MySelf.m_boThunderPalsy then begin
              Result := g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and (g_ClientConfig.boParalyCanRun or g_ClientConfig.boParalyCanWalk);
            end;
          end;
        caRun, caHorseRun:begin
            Result := g_boCanMove;
            if Result and g_ClientConfig.boSkill43LockParaly and g_MySelf.m_boThunderPalsy then begin
              Result := g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and (g_ClientConfig.boParalyCanRun or g_ClientConfig.boParalyCanWalk);
            end;
          end;
        caHit, caSitdown:begin
            Result := g_boCanAttack;

            if Result and g_ClientConfig.boSkill43LockParaly and g_MySelf.m_boThunderPalsy then begin
              Result := g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and g_ClientConfig.boParalyCanHit;
            end;
          end;
        caSpell:begin
            Result := g_boCanAttack;
            if Result and g_ClientConfig.boSkill43LockParaly and g_MySelf.m_boThunderPalsy then begin
              Result := g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and g_ClientConfig.boParalyCanSpell;
            end;
          end;
        else
          Result := True;
      end;
    end else begin
      if (Action > caNone) and PlugInEnabled then begin
          case Action of // 麻痹只勾选允许走动或允许跑动一个选项时，不能走也不能跑 chongchong 2015-03-03
            caWalk:
              Result := g_boCanMove and (g_MySelf.m_nState and $00080000 = 0) and g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and (g_ClientConfig.boParalyCanRun or g_ClientConfig.boParalyCanWalk);
            caRun, caHorseRun:
              Result := g_boCanMove and (g_MySelf.m_nState and $00080000 = 0) and g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and (g_ClientConfig.boParalyCanRun or g_ClientConfig.boParalyCanWalk);
            caHit, caSitdown:
              Result := g_boCanAttack and (g_MySelf.m_nState and $00080000 = 0) and g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and g_ClientConfig.boParalyCanHit;
            caSpell:
              Result := g_boCanAttack and (g_MySelf.m_nState and $00080000 = 0) and g_ClientConfig.boNotParaly and g_ConfigDlg.ConfigCheckeds[ckNotParaly] and g_ClientConfig.boParalyCanSpell;
          end;
      end;
    end;
  end;
  {if Result = True then
    DScreen.AddChatBoardString('CanNextAction True', clGreen, clWhite) else
    DScreen.AddChatBoardString('CanNextAction False', clRed, clWhite)}
end;

function TfrmMain.CanNextWalk:Boolean;
var
  dwWalkIntervalTime:Cardinal;
begin
  if not g_boCanMove then begin
    Result := False;
    Exit;
  end;

  if g_boMySelfLock then begin
    Result := False;
    Exit;
  end;

  if g_MySelf.m_nState and $00010000 <> 0 {战技锁定} then begin
    Result := False; //HZQ 20230523
    Exit;
  end;

  // 骑马 - 被邀请双人同骑 chongchong 2013-10-14
  if (g_MySelf.m_btHorse in [1, 2]) and (g_MySelf.m_btDoubleHumHorse = 0) then begin
    Result := False;
    Exit;
  end;

  dwWalkIntervalTime := g_ClientConfig.dwMoveFrameTime;
  if g_MySelf.m_nMoveSpeed <> 0 then begin
    dwWalkIntervalTime := Max(Integer(dwWalkIntervalTime) - (Integer(g_ClientConfig.dwIncMoveSpeedDecInterval) * g_MySelf.m_nMoveSpeed), 0);
  end;
  Result := (TimeGetTime - g_dwLastMoveTick > dwWalkIntervalTime);

  // 恢复攻击到移动间隔 chongchong 2017-12-07
  {
  if Result then
  begin
    Result := (MyGetTickCount - g_dwLastAttackTick > g_MySelf.GetNextHitTime);
  end;
  }
end;

