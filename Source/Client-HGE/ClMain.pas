function DoTakeOnItem(nWhere, nType, nCount:Integer):Boolean;
var
  I:Integer;
  sName:string;
begin
  Result := False;

  if Length(g_WaitingUseItem.Item.S.Name) > 0 then
    Exit;

  if (Length(g_UseItems[nWhere].S.Name) > 0) and (g_UseItems[nWhere].S.StdMode = 25) and (g_UseItems[nWhere].S.Shape = nType) and (Round(g_UseItems[nWhere].Dura / g_nMagicItemRate) >= nCount) then begin
    Exit;
  end;

  if (Length(g_UseItems[nWhere].S.Name) = 0) or (g_UseItems[nWhere].S.StdMode <> 25) or (g_UseItems[nWhere].S.Shape <> nType) then begin
    for I := Low(g_ItemArr) to GetMaxBagCount - 1 do begin
      if (g_ItemArr[I].S.Name <> '') and ((g_ItemArr[I].S.OverLap = 0) and ((g_ItemArr[I].S.OverLap = 0) or (g_ItemArr[I].S.OverLap and 1 <> 0))) and (g_ItemArr[I].S.StdMode = 25) and (g_ItemArr[I].S.Shape = nType) and (Round(g_ItemArr[I].Dura / g_nMagicItemRate) >= nCount) then begin
        Result := True;

        g_WaitingUseItem.Item := g_ItemArr[I];
        g_WaitingUseItem.Index := nWhere;
        g_ItemArr[I].S.Name := '';
        sName := g_WaitingUseItem.Item.S.Name;
        frmMain.SendTakeOnItem(nWhere, g_WaitingUseItem.Item.MakeIndex, sName);

        Break;
      end;
    end;
  end;
end;

procedure TfrmMain.AutoTakeOnItem(Magic:PTClientMagic); // 自动上毒/符
var
  I, nCount:Integer;
  nShape:Integer;
  nWhere:Integer;
  Target:TActor;
  mx, my:Integer;
  CustomMagicConfig:PClientCustomMagicConfig;
  NeedItem:TMagicNeedItem;
  NeedCount:Integer;
  HasShap1, HasShap2:Boolean;
begin
  // g_ClientConfig.boStartGameAuxiliary and g_ConfigDlg.Enabled  // 启动内挂

  if (Magic <> nil) and (Length(g_WaitingUseItem.Item.S.Name) = 0) then begin
    // 取得毒符的装备位置
    nWhere := GetTakeOnPosition(25, 5);

    if nWhere = U_BUJUK then begin
      { 1.76界面下面一排不允许装备 chongchong 2013-09-16 }
      if g_ClientConfig.boUseOldSerialWindows and (g_ClientConfig.boStateWindowsType = 0) then begin
        if not g_ClientConfig.boDisableDuFuTakeArmRingL then
          nWhere := U_ARMRINGL
        else
          nWhere := -1;
      end;
    end;

    if nWhere >= 0 then begin
      if (g_ClientConfig.nHumNeedMagicItem = 1) and (Magic.Def.wMagicId in [6, 51]) then {// 施毒术、群毒术}  begin
        if Magic.Def.wMagicId = 6 then
          nCount := 1
        else
          nCount := 5;

        HasShap1 := False;
        HasShap2 := False;

        for I := Low(g_ItemArr) to GetMaxBagCount - 1 do begin
          if (Length(g_ItemArr[I].S.Name) > 0) and ((g_ItemArr[I].S.OverLap = 0) and ((g_ItemArr[I].S.OverLap = 0) or (g_ItemArr[I].S.OverLap and 1 <> 0))) and (g_ItemArr[I].S.StdMode = 25) then begin
            if g_ItemArr[I].S.Shape = 1 then
              HasShap1 := True
            else if g_ItemArr[I].S.Shape = 2 then
              HasShap2 := True;

            if HasShap1 and HasShap2 then begin
              Break;
            end;
          end;
        end;

        if (g_ClientConfig.boAutoCHangePoison and g_ConfigDlg.ConfigCheckeds[ckAutoChangePoison]) then begin
          Target := g_MagicTarget;

          if (not PlayScene.IsValidActor(g_MagicTarget)) or g_MagicTarget.m_boDeath then begin
            if PlayScene.IsValidActor(g_FocusCret) and (not g_FocusCret.m_boDeath) then begin
              Target := g_FocusCret;
            end else begin
              PlayScene.CXYfromMouseXY(g_nMouseX, g_nMouseY, mx, my);
              Target := PlayScene.FindActorXY(mx, my);
            end;
          end else begin
            if g_FocusCret <> nil then
              Target := g_FocusCret;
          end;

          // 自动红绿毒互换
          if (Target <> nil) then begin
            if (Length(g_UseItems[nWhere].S.Name) > 0) and (g_UseItems[nWhere].S.StdMode = 25) and (g_UseItems[nWhere].S.Shape in [1, 2]) then begin
              if g_UseItems[nWhere].S.Shape = 2 then
                nShape := 1
              else
                nShape := 2;
            end else begin
              if (HasShap1 and HasShap2) or ((not HasShap1) and (not HasShap2)) then begin
                if (Target.m_nState and $80000000 <> 0) then begin // ceGreen;
                  nShape := 2;
                end else if (Target.m_nState and $40000000 <> 0) then begin
                  nShape := 1; // ceRed;
                end else begin
                  if g_nMagicItemType = 2 then
                    nShape := 1
                  else
                    nShape := 2;
                end;
              end else begin
                // 身上没毒，包裹中只有一种毒，就装这种 chongchong 2015-09-10
                if HasShap1 then
                  nShape := 1
                else
                  nShape := 2;
              end;
            end;
          end else begin // if (Target <> nil) then begin
            if (Length(g_UseItems[nWhere].S.Name) > 0) and (g_UseItems[nWhere].S.StdMode = 25) and (g_UseItems[nWhere].S.Shape in [1, 2]) then begin
              if g_UseItems[nWhere].S.Shape = 2 then
                nShape := 1
              else
                nShape := 2;
            end else begin
              if g_nMagicItemType = 2 then
                nShape := 1
              else
                nShape := 2;
            end;
          end;

          if DoTakeOnItem(nWhere, nShape, nCount) then begin
            g_nMagicItemType := nShape;
          end;
        end else begin
          if (Length(g_UseItems[nWhere].S.Name) > 0) and (g_UseItems[nWhere].S.StdMode = 25) and (g_UseItems[nWhere].S.Shape in [1, 2]) and (Round(g_UseItems[nWhere].Dura / g_nMagicItemRate) >= nCount) then begin
            Exit;
          end;

          g_nMagicItemType := 1;
          if not DoTakeOnItem(nWhere, 1, nCount) then {// 先装红毒}  begin
            g_nMagicItemType := 2;
            DoTakeOnItem(nWhere, 2, nCount); // 先装绿毒
          end;
        end;
      end // 自动上符
      else if (g_ClientConfig.nHumNeedMagicItem = 1) and (Magic.Def.wMagicId in [13, 14, 15, 16, 17, 18, 19, 30, 38 {诅咒术}, 46 {新诅咒术}, 57, 52, 76, 55 {召唤月灵}, 202 {裂神符}, 210 {幽冥火符}]) then begin // 自动换符
        nCount := 1;
        if (Magic.Def.wMagicId = 30) or (Magic.Def.wMagicId = 76) then
          nCount := 5;

        DoTakeOnItem(nWhere, 5, nCount);
      end // 自定义技能
      else if CheckIsCustomMagic(Magic.Def.wMagicId) then begin
        NeedItem := meiNone;
        NeedCount := 0;

        CustomMagicConfig := GetCustomMagicConfig(Magic.Def.wMagicId);
        if (CustomMagicConfig <> nil) then begin
          NeedItem := CustomMagicConfig.NeedItem;
          NeedCount := CustomMagicConfig.NeedItemCount;

          if (CustomMagicConfig.NeedItemUseBagItem) or (NeedCount <= 0) then
            NeedItem := meiNone;
        end;

        // 自动换毒
        if NeedItem in [meiRedPoison, meiGreenPoison] then begin
          nCount := NeedCount;

          if NeedItem = meiRedPoison then
            nShape := 2
          else
            nShape := 1;

          g_nMagicItemType := nShape;

          g_nMagicItemType := nShape;
          DoTakeOnItem(nWhere, nShape, nCount);
        end
        else if NeedItem = meiFu then begin // 自动换符
          nCount := NeedCount;

          DoTakeOnItem(nWhere, 5, nCount);
        end;
      end;
    end;
  end;
end;

