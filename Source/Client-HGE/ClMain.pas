{$IF DEBUG_HIT_DELAY = 1}
var
  LastSendHitTick2:LongWord;
  //LastSendRunTick2: LongWord;
  {$IFEND}
  {$IF DEBUG_SPELL_DELAY = 1}

var
  LastSendSpellTick2:LongWord;
  {$IFEND}

procedure TfrmMain.SendActionMsg(ident, X, Y, dir:Integer; target:Int64; sMsg:string);
var
  Msg:TDefaultMessage;
  tx, ty:Integer;
begin

  {$IF DEBUG_HIT_DELAY = 1}
  // 这里是发送攻击消息的间隔
  if (ident = CM_HIT) or (ident = CM_HEAVYHIT) or (ident = CM_BIGHIT) or (ident = CM_POWERHIT) or (ident = CM_LONGHIT) or (ident = CM_WIDEHIT) or (ident = CM_FIREHIT) or (ident = CM_CRSHIT) or (ident = CM_TWNHIT) or (ident = CM_SWORDHIT) or (ident = CM_43HIT) or (ident = CM_66HIT) or (ident = CM_66HIT1) or (ident = CM_101HIT) or (ident = CM_102HIT) or (ident = CM_103HIT) or (ident = CM_113HIT) or (ident = CM_115HIT) or ((ident >= CM_CUSTOM_HIT1) and (ident <= CM_CUSTOM_HIT100)) then begin
    DScreen.AddChatBoardString('攻击间隔:' + IntToStr(MyGetTickCount - LastSendHitTick2), clWhite, clRed);
    LastSendHitTick2 := MyGetTickCount;
  end;
  {$IFEND}
  {
  if Ident = CM_RUN then   // 这里是发送攻击消息的间隔
  begin
    DScreen.AddChatBoardString('跑步间隔:' + IntToStr(MyGetTickCount - LastSendRunTick2), clWhite, clRed);
    LastSendRunTick2 := MyGetTickCount;
  end;
  }
  {$IF DEBUG_RUN_DELAY_SELF = 1}
  if ident = CM_RUN then begin
    g_SelfRunSendMsg.Add(IntToStr(TimeGetTime));
    g_SelfRunSendMsg.SaveToFile(g_sSelfRunSendMsgFile);
    //DScreen.AddChatBoardString('跑步时间:' + IntToStr(MyGetTickCount), clWhite, clRed);
  end;
  {$IFEND}

  if ident = CM_SPELL then begin
    // 修正自动连击时使用普通技能会卡技能。2021-01-15 23:35:24
    if g_boContinuous and (not (dir in [100..111])) then begin
      DoFinishContinuous();
    end;
  end;

  {$IF DEBUG_SPELL_DELAY = 1}
  if ident = CM_SPELL then begin
    //g_SelfSpellStart.Add(IntToStr(MyGetTickCount));
    //g_SelfSpellStart.SaveToFile(g_sSelfSpellStartFile);

    DScreen.AddChatBoardString('魔法间隔:' + IntToStr(MyGetTickCount - LastSendSpellTick2), clWhite, clRed);
    LastSendSpellTick2 := MyGetTickCount;
  end;
  {$IFEND}

  g_ActionCode := ident;

  {.$I VMProtectBeginMutation.inc}

  tx := Cutecode_T(X);
  ty := Cutecode_T(Y);
  {.$I VMProtectEnd.inc}
  Msg := MakeDefaultMsg(ident, target, tx, dir, ty); // -921173984, 252, 57, 363
  SendSocket(EncodeMessage(Msg) + EncodeString(sMsg));
  EnterCriticalSection(FCSActionLock);
  try
    FActionLock := True;
    ActionLockTime := MyGetTickCount;
  finally
    LeaveCriticalSection(FCSActionLock);
  end;
  Inc(g_nSendCount);

  {
  if ident = CM_WALK then
    DScreen.AddChatBoardString('---walk', clWhite, clRed)       // chongchong 2017-06-21
  else if ident = cm_run then
    DScreen.AddChatBoardString('---run', clWhite, clRed);       // chongchong 2017-06-21
  }
end;

procedure TfrmMain.SendSpellMsg(ident, X, Y, dir:Integer; target:Int64);
  procedure UpdateActionStatus(bStatus:Boolean);
  begin
      EnterCriticalSection(FCSActionLock);
      try
        FActionLock := bStatus;
        ActionLockTime := MyGetTickCount;
      finally
        LeaveCriticalSection(FCSActionLock);
      end;
  end;
var
  Msg:TDefaultMessage;
  CustomMagicConfig:PClientCustomMagicConfig;
const
   {$J+}
   nSendCount:Integer = 0;
   {$J-}
begin
  g_ActionCode := ident;
  Msg := MakeDefaultMsg(ident, target, X, dir, Y);
  SendSocket(EncodeMessage(Msg));

  // 在跑动过程中，持续按烈火剑法快捷键会卡顿半秒  chongchong 2017-01-11
  if (ident = CM_SPELL) then begin
    if dir in [7 {攻杀}, 12 {刺杀}, 25 {半月}, 26 {烈火}, 40 {双龙斩}, 42 {龙影}, 43 {雷霆剑法}, 56 {逐日剑法}, 66 {开天斩}] then begin
      {$IF TESTMODE = 1}
      //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~' + IntToStr(dir), clWhite, clBlack);
      {$IFEND}
    end else if CheckIsCustomMagic(dir) then begin
      CustomMagicConfig := GetCustomMagicConfig(dir);

      {$IF TESTMODE = 1}
      //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~' + IntToStr(dir), clWhite, clBlack);
      {$IFEND}

      if (CustomMagicConfig <> nil) and (CustomMagicConfig.MagicBaseConfig.MagicSwitchMode = msmSwitch) then begin
        // 自定义战士技能不用 ActionLock 2020-03-25 14:17:43
      end else if not CustomMagicConfig.boIsMagicWarr then begin
          UpdateActionStatus(True);
      end;
    end else begin
        UpdateActionStatus(True);
    end;

    //OutputDebugString(PChar(Format('[TfrmMain.SendSpellMsg] [%d]  Send CM_SPELL', [nSendCount])));
    Inc(nSendCount);
  end else begin
    UpdateActionStatus(True);             
  end;

  Inc(g_nSendCount);
  // DebugOutStr('SendSpellMsg:'+IntToStr(g_ActionCode));
end;

