begin
  if DefMsg.param in [Low(TUseItems)..High(TUseItems)] then begin
    if g_UseItems[DefMsg.param].S.Name <> '' then begin
      g_UseItems[DefMsg.param].Dura := DefMsg.Recog;
      g_UseItems[DefMsg.param].DuraMax := MakeLong(DefMsg.tag, DefMsg.series);
    end;
  end
  else if DefMsg.Param in [U_JEWELRYITEM1..U_JEWELRYITEM6] then begin
