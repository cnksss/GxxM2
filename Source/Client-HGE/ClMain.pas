procedure TfrmMain.ProcessMessageAddClientBuff(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, nFileIndex, nImageIndex, Index:Integer;
  GameImages:TGameImages;
  nTime, nX, nY:Integer;
  sXY:string;
begin
  nX := 0;
  nY := 0;

  nTime := DefMsg.Recog;

  nFileIndex := DefMsg.Param;
  nImageIndex := DefMsg.Tag;
  Index := Pos('|', sData);
  if Index > 0 then begin
    sXY := Copy(sData, 1, Index - 1);
    sData := Copy(sData, Index + 1, MaxInt);

    Index := Pos(',', sXY);
    if Index > 0 then begin
      nX := StrToIntDef(Copy(sXY, 1, Index - 1), 0);
      nY := StrToIntDef(Copy(sXY, Index + 1, MaxInt), 0);
    end;
  end;

  GameImages := nil;
  g_EffectImageList.Lock;
  try
    if (nFileIndex >= 0) and (nFileIndex < g_EffectImageList.Count) then begin
      GameImages := TGameImages(g_EffectImageList.Objects[nFileIndex]);
    end;
  finally
    g_EffectImageList.UnLock;
  end;

  for I := 0 to Length(g_ClientBuffs) - 1 do begin
    if (g_ClientBuffs[I].Button <> nil) and g_ClientBuffs[I].Button.Visible and (g_ClientBuffs[I].Button.Tag = DefMsg.Series) then begin // 已经存在
      g_ClientBuffs[I].Time := nTime;
      g_ClientBuffs[I].Tick := MyGetTickCount;

      g_ClientBuffs[I].Button.Width := 30;
      g_ClientBuffs[I].Button.Width := 16;

      g_ClientBuffs[I].Button.Designing := False;
      g_ClientBuffs[I].Button.Floating := False;
      g_ClientBuffs[I].Button.Tag := DefMsg.Series;
      g_ClientBuffs[I].Button.Caption := '';
      g_ClientBuffs[I].Button.AutoSize := True;
      g_ClientBuffs[I].Button.OnMouseMove := ClientBuffButtonMouseMove;
      g_ClientBuffs[I].Button.OnStopPaint := ClientBuffButtonPaint;
      g_ClientBuffs[I].Button.Hint := sData;
      g_ClientBuffs[I].Button.Data := @g_ClientBuffs[I];
      g_ClientBuffs[I].Button.OnGetImage := FrmDlg.DBackground.OnGetImage;

      g_ClientBuffs[I].Button.ImageIndex.BeginUpdate;
      try
        g_ClientBuffs[I].Button.ImageIndex.Image := GameImages;
        g_ClientBuffs[I].Button.ImageIndex.Up := nImageIndex;
      finally
        g_ClientBuffs[I].Button.ImageIndex.EndUpdate;
      end;

      g_ClientBuffs[I].Button.BringToFront;

      g_ClientBuffs[I].Button.Left := nX;
      g_ClientBuffs[I].Button.Top := nY;
      Exit;
    end;
  end;

  // 没有找到在显示的按钮，则找一个无用的(没创建或不显示的)用一下
  for I := 0 to Length(g_ClientBuffs) - 1 do begin
    if (g_ClientBuffs[I].Button = nil) or (not g_ClientBuffs[I].Button.Visible) then begin
      g_ClientBuffs[I].Time := nTime;
      g_ClientBuffs[I].Tick := MyGetTickCount;

      if (g_ClientBuffs[I].Button = nil) then
        g_ClientBuffs[I].Button := TDxImageButton.Create(FrmDlg.DBackground);

      g_ClientBuffs[I].Button.Width := 30;
      g_ClientBuffs[I].Button.Width := 16;

      g_ClientBuffs[I].Button.Visible := True;
      g_ClientBuffs[I].Button.Designing := False;
      g_ClientBuffs[I].Button.Floating := False;
      g_ClientBuffs[I].Button.Tag := DefMsg.Series;
      g_ClientBuffs[I].Button.Caption := '';
      g_ClientBuffs[I].Button.AutoSize := True;
      g_ClientBuffs[I].Button.OnMouseMove := ClientBuffButtonMouseMove;
      g_ClientBuffs[I].Button.OnStopPaint := ClientBuffButtonPaint;
      g_ClientBuffs[I].Button.Hint := sData;
      g_ClientBuffs[I].Button.Data := @g_ClientBuffs[I];
      g_ClientBuffs[I].Button.OnGetImage := FrmDlg.DBackground.OnGetImage;

      g_ClientBuffs[I].Button.ImageIndex.BeginUpdate;
      try
        g_ClientBuffs[I].Button.ImageIndex.Image := GameImages;
        g_ClientBuffs[I].Button.ImageIndex.Up := nImageIndex;
      finally
        g_ClientBuffs[I].Button.ImageIndex.EndUpdate;
      end;

      g_ClientBuffs[I].Button.BringToFront;

      g_ClientBuffs[I].Button.Left := nX;
      g_ClientBuffs[I].Button.Top := nY;
      g_ClientBuffs[I].Button.OnClick := OnClientBuffClick;

      Exit;
    end;
  end;
end;

