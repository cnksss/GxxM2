      Dispose(PTClientItem(StorageList.Items[I]));
    StorageList.Clear;

    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));
    Buffer := @OutBuf;

    Header := nil;
    HeaderExt := nil;

    if boStorageViewDlgIsExt then begin
      HeaderExt := PTSellPlayerStorageExtViewHeader(Buffer);
      Inc(Buffer, SizeOf(TSellPlayerStorageExtViewHeader));
    end
    else begin
      Header := PTSellPlayerStorageViewHeader(Buffer);
      Inc(Buffer, SizeOf(TSellPlayerStorageViewHeader));
    end;

    for I := 0 to nCount - 1 do begin
      New(pc);
      Move(Buffer^, pc^, SizeOf(TClientItem));
      Buffer := Buffer + SizeOf(TClientItem);
      StorageList.Add(pc);
    end;

    FrmDlg.OpenViewSellPlayerStorage(Header, HeaderExt);
  end;
end;

