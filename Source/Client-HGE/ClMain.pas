procedure TfrmMain.ProcessMessageQueryUserShops(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  UserShop:PClientUserShop;
  ListItem:TDxListItem;
  ViewItem:pTViewItem;
begin
  // showmessage(inttostr(DefMsg.Recog));
  g_boOfflineCloseMyShop := DefMsg.Tag = 1;
  g_nUserShopIndex := DefMsg.Param;
  g_nUserShopCount := DefMsg.Recog;
  SafeFillChar(g_UserShops, SizeOf(g_UserShops), #0);
  FrmDlg.SetGameShopPageCount;

  if (DefMsg.Series > 0) and (Length(sData) = SizeOf(TClientUserShop) * DefMsg.Series) then begin
    UserShop := pClientUserShop(sData);
    for I := 0 to DefMsg.Series - 1 do begin
      if I >= Length(g_UserShops) then
        Break;
      g_UserShops[I] := UserShop^;
      Inc(UserShop);
    end;
  end;

  if FrmDlg is TSerialWindows then begin
    TSerialWindows(FrmDlg).ListViewGameShop.Clear;
    TSerialWindows(FrmDlg).ListViewGameShop.Lock;
    try
      for I := 0 to Length(g_UserShops) - 1 do begin
        if g_UserShops[I].sShopName <> '' then begin
          ListItem := TSerialWindows(FrmDlg).ListViewGameShop.Add;
          ViewItem := ListItem.AddItem('', nil); // 店铺名称
          ViewItem.Caption := g_UserShops[I].sShopName;
          // if g_UserShops[I].boBusiness then begin
          if (g_UserShops[I].btState = 2) and g_boOfflineCloseMyShop then begin // 商铺关闭
            ViewItem.Color.Up.Color := clGray;
            ViewItem.Color.Up.Style := [];
            ViewItem.Color.Hot.Color := clGray; // clWhite;
            ViewItem.Color.Hot.Style := [];
            ViewItem.Color.Down.Color := clGray;
            ViewItem.Color.Down.Style := [];
          end
          else begin
            ViewItem.Color.Up.Color := clLime;
            ViewItem.Color.Up.Style := [fsUnderline];
            ViewItem.Color.Hot.Color := clWhite; // clWhite;
            ViewItem.Color.Hot.Style := [fsUnderline];
            ViewItem.Color.Down.Color := clRed;
            ViewItem.Color.Down.Style := [fsUnderline];
          end;

          {end else begin
            ViewItem.Color.Up.Color := clWhite;
            ViewItem.Color.Hot.Color := clWhite; // clWhite;
            ViewItem.Color.Down.Color := clWhite;
          end;    }

          ViewItem := ListItem.AddItem('', nil); // 店主名称
          ViewItem.Caption := g_UserShops[I].sMasterName;
          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;

          ViewItem := ListItem.AddItem('', nil); // 开业时间
          Set8087CW($133F);
          ViewItem.Caption := FormatDateTime('yyyy-mm-dd hh:nn:ss', g_UserShops[I].dCreateDate);
          Set8087CW(Default8087CW); //恢复默认的浮点精度

          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;

          ViewItem := ListItem.AddItem('', nil); // 物品总数
          ViewItem.Caption := IntToStr(g_UserShops[I].nSellingItemCount);
          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;

          ViewItem := ListItem.AddItem('', nil); // 销售总数
          ViewItem.Caption := IntToStr(g_UserShops[I].nSelledItemCount);
          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;

          ViewItem := ListItem.AddItem('', nil); // 状态
          ViewItem.Caption := GetUserShopStatus(g_UserShops[I].btState);
          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;

          ViewItem := ListItem.AddItem('', nil); // 关注度
          ViewItem.Caption := IntToStr(g_UserShops[I].nCareValue);
          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;
        end;
      end;
    finally
      TSerialWindows(FrmDlg).ListViewGameShop.UnLock;
    end;
  end;
end;

procedure TfrmMain.ProcessMessageSearchShopItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  UserShopItem:pTClientUserShopItem;
  ListItem:TDxListItem;
  ViewItem:pTViewItem;
begin
  g_nSearchUserShopItemIndex := DefMsg.Param;
  g_nSearchUserShopItemCount := DefMsg.Recog;
  FrmDlg.SetGameShopPageCount;

  for I := 0 to Length(g_SearchUserShopItems) - 1 do begin
    g_SearchUserShopItems[I].sShopName := '';
    g_SearchUserShopItems[I].sMasterName := '';
    g_SearchUserShopItems[I].Item.s.Name := '';
  end;

  if (DefMsg.Series > 0) and (Length(sData) = DefMsg.Series * SizeOf(TClientUserShopItem)) then begin
    UserShopItem := pTClientUserShopItem(sData);
    for I := 0 to DefMsg.Series - 1 do begin
      if I >= Length(g_SearchUserShopItems) then
        Break;

      g_SearchUserShopItems[I] := UserShopItem^;

      Inc(UserShopItem);
    end;
  end;

  if FrmDlg is TSerialWindows then begin
    TSerialWindows(FrmDlg).ListViewGameShopItem.Clear;
    TSerialWindows(FrmDlg).ListViewGameShopItem.Lock;
    try
      for I := 0 to Length(g_SearchUserShopItems) - 1 do begin
        if g_SearchUserShopItems[I].sMasterName <> '' then begin
          ListItem := TSerialWindows(FrmDlg).ListViewGameShopItem.Add;

          ViewItem := ListItem.AddItem('', nil); // 物品

          ViewItem.ImageIndex.BeginUpdate;
          try
            ViewItem.ImageIndex.Image := g_WBagItemImages.Indexs[g_SearchUserShopItems[I].Item.s.Looks div 10000];
            ViewItem.ImageIndex.Up := g_SearchUserShopItems[I].Item.s.Looks mod 10000;
          finally
            ViewItem.ImageIndex.EndUpdate;
          end;

          ViewItem := ListItem.AddItem('', nil); // 物品名称
          ViewItem.Caption := ProcessItemName(g_SearchUserShopItems[I].Item.s.Name);
          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;

          ViewItem := ListItem.AddItem('', nil); // 物品价格
          case g_SearchUserShopItems[I].btMoneyType of
            0:
              ViewItem.Caption := IntToStr(g_SearchUserShopItems[I].Item.s.Price) + ' ' + g_sGameGoldName;
            1:
              ViewItem.Caption := IntToStr(g_SearchUserShopItems[I].Item.s.Price) + ' ' + g_sGamePointName;
            2:
              ViewItem.Caption := IntToStr(g_SearchUserShopItems[I].Item.s.Price) + ' ' + g_sGoldName;
            3:
              ViewItem.Caption := IntToStr(g_SearchUserShopItems[I].Item.s.Price) + ' ' + g_sGameDiamondName;
            4:
              ViewItem.Caption := IntToStr(g_SearchUserShopItems[I].Item.s.Price) + ' ' + g_sGameGirdName;
            else
              ViewItem.Caption := IntToStr(g_SearchUserShopItems[I].Item.s.Price) + ' ' + GetCustomMoneyNameByRule(g_SearchUserShopItems[I].btMoneyType, 0);
          end;

          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;

          ViewItem := ListItem.AddItem('', nil); // 所在店铺
          ViewItem.Caption := g_SearchUserShopItems[I].sShopName;
          ViewItem.Color.Up.Color := clLime;
          ViewItem.Color.Up.Style := [fsUnderline];
          ViewItem.Color.Hot.Color := clWhite; // clWhite;
          ViewItem.Color.Hot.Style := [fsUnderline];
          ViewItem.Color.Down.Color := clRed;
          ViewItem.Color.Down.Style := [fsUnderline];

          ViewItem := ListItem.AddItem('', nil); // 店主名称
          ViewItem.Caption := g_SearchUserShopItems[I].sMasterName;
          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;

          ViewItem := ListItem.AddItem('', nil); // 物品类别
          ViewItem.Caption := GetUserShopItemType(g_SearchUserShopItems[I].btItemType);
          ViewItem.Color.Up.Color := clWhite;
          ViewItem.Color.Hot.Color := clWhite;
          ViewItem.Color.Down.Color := clWhite;

          ViewItem := ListItem.AddItem('', nil); // 购买
          {
          if CompareText(g_SearchUserShopItems[I].sMasterName, g_MySelf.m_sUserName) = 0 then
          begin
            ViewItem.Caption := '取回';
          end
          else
          begin
            ViewItem.Caption := '购买';
          end;
          }

          if g_SearchUserShopItems[I].IsMyShopeItem then
            ViewItem.Caption := DecodeResStr(SUserShopGetBack)
          else
            ViewItem.Caption := DecodeResStr(SUserShopBuy);

          ViewItem.Color.Up.Color := clLime;
          ViewItem.Color.Up.Style := [fsUnderline];
          ViewItem.Color.Hot.Color := clWhite; // clWhite;
          ViewItem.Color.Hot.Style := [fsUnderline];
          ViewItem.Color.Down.Color := clRed;
          ViewItem.Color.Down.Style := [fsUnderline];

          if g_UserShopItems[I].sBuyName = '' then begin
            ViewItem.Color.Up.Color := clLime;
            ViewItem.Color.Up.Style := [fsUnderline];
            ViewItem.Color.Hot.Color := clWhite; // clWhite;
            ViewItem.Color.Hot.Style := [fsUnderline];
            ViewItem.Color.Down.Color := clRed;
            ViewItem.Color.Down.Style := [fsUnderline];
          end
          else begin
            ViewItem.Caption := DecodeResStr(SUserShopSelled);
            ViewItem.Color.Up.Color := clGray;
            ViewItem.Color.Hot.Color := clGray;
            ViewItem.Color.Down.Color := clGray;
          end;
        end;
      end;
    finally
      TSerialWindows(FrmDlg).ListViewGameShopItem.UnLock;
    end;
  end;
end;

