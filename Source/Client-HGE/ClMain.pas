procedure TfrmMain.DeviceFinalize(Sender:TObject);
var
  I:Integer;
  RandCodeType:TRandCodeType;
begin
  // DebugOutStr('DeviceFinalize Handle:'+IntToStr(Handle));
  if g_boDeviceInitializeOK then begin
    g_boDeviceInitializeOK := False;

    {$IF Enabled_PlugEngine = 1}
    if Assigned(HookFinalize) then begin
      try
        HookFinalize();
      except
        on E:Exception do begin
          DebugOutStr('[Exception] HookFinalize');
          DebugOutStr(E.Message);
        end;
      end;
    end;
    {$IFEND}

    FrmDlg.DBackground.Finalize;

    WelcomeScene.Finalize;
    LoginScene.Finalize;
    SelectChrScene.Finalize;
    LoginNoticeScene.Finalize;

    DScreen.Finalize;
    PlayScene.Finalize;
    HintWindows.Finalize;

    g_ImageEvent.Finalize;

    for I := 0 to Length(g_RenderTarget) - 1 do begin
      if g_RenderTarget[I] <> nil then
        FreeAndNil(g_RenderTarget[I]);
    end;

    if g_NullImage <> nil then
      FreeAndNil(g_NullImage);

    for RandCodeType := Low(TRandCodeType) to High(TRandCodeType) do begin
      if g_RandomCodeSurface[RandCodeType] <> nil then
        FreeAndNil(g_RandomCodeSurface[RandCodeType]);
    end;

    if g_ImgMixSurface <> nil then
      FreeAndNiL(g_ImgMixSurface);

    if g_PayMentQRCodeSurface <> nil then
      FreeAndNIl(g_PayMentQRCodeSurface);
    g_BassSound.Finalize;
    ConfigDlgManage.Finalize;

    DebugOutStr('----------------------- Finalize ------------------------', False);
  end;
end;
