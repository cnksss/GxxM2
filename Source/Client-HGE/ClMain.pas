        {$IFEND}
        g_boWaitLoadAntiPlugDllMemoryModule_IOCP2 := False;

        LoadDllAndInit_IOCP2(nil);

        //HZQ 此处删除了判断ThreadHandle的语句，因为此处跟本没有创建线程
      end;
    end;
  end;
  {$ELSE}
  if g_TempAntiPlugDllModule_IOCP2 >= 32 then begin
    if tick_diff(g_TempAntiPlugFreeTick_IOCP2, MyGetTickCount) >= 5000 then begin
      FreeLibrary(g_TempAntiPlugDllModule_IOCP2);
