procedure TfrmMain.ProcessMessageServerMsg(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);

  function ExtractUserName(Line:string):string;
  var
    uname:string;
  begin
    GetValidStr3(Line, Line, ['(', '!', '*', '/', ')']);
    GetValidStr3(Line, uname, [' ', '=', ':']);
    if uname <> '' then
      if (uname[1] = '/') or (uname[1] = '(') or (uname[1] = ' ') or (uname[1] = '[') then
        uname := '';
    Result := uname;
  end;

begin
  case DefMsg.Ident of
    SM_CRY:
      if not g_NotFilterMsg[1] then
        Exit;
    SM_WHISPER:
      if not g_NotFilterMsg[2] then
        Exit;
    SM_GUILDMESSAGE:
      if not g_NotFilterMsg[3] then
        Exit;
  end;

  if (DefMsg.Ident = SM_SYSMESSAGE) or CheckBlockListSys(DefMsg.Ident, sData) then
    DScreen.AddChatBoardString(sData, GetRGB(Lobyte(DefMsg.param)), GetRGB(Hibyte(DefMsg.param)));

  if DefMsg.ident = SM_GUILDMESSAGE then
    FrmDlg.AddGuildChat(sData);

  if DefMsg.ident = SM_WHISPER then begin // 自动回复
    if FrmDlg.DWhisperMemo <> nil then
      // 私聊框默认文字颜色全为白色 chongchong 2013-11-20
      FrmDlg.DWhisperMemo.Add(FormatDateTime('HH:MM:SS', Time) + ' ' + sData, {GetRGB(Lobyte(DefMsg.param))} DWhisperMemoUpColor, GetRGB(Hibyte(DefMsg.param)));
    if (FrmDlg.DCheckBoxAutoAnswersWhisper <> nil) and (FrmDlg.DEditAutoAnswersWhisper <> nil) and (FrmDlg.DCheckBoxAutoAnswersWhisper.Checked) and (FrmDlg.DEditAutoAnswersWhisper.Text <> '') then
      SendSay('/' + ExtractUserName(sData) + ' ' + FrmDlg.DEditAutoAnswersWhisper.Text);
  end;
end;

