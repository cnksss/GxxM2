procedure TfrmMain.DecodeMessagePacket(Msg:TDefaultMessage; DataAdd:string);
type
  TDoRecvPacketFunc = procedure(DefMsg:pTDefaultMessage; lpData:PChar; InDataLen:Integer); stdcall;
var
  body, sData:string;
  DefMsg:TDefaultMessage;
  nIndex, nTemp:Integer;
  nX, nY:Integer;
  DoRecvPacket:TDoRecvPacketFunc;
  ClientMagic:PTClientMagic;
begin
  DefMsg := Msg;
  body := DataAdd;
  sData := body;
  
  //OutputDebugString(PChar(Format('MsgID = [%d]', [msg.Ident])));

  if Msg.Ident = SM_ACTION_RET then begin
    if Msg.Param = 1 then begin
      if Msg.Tag = 1 then begin
        g_HumanRunConfig.boCanRunHuman := LoByte(LoWord(Msg.Recog)) = 1;
        g_HumanRunConfig.boCanRunMon := HiByte(LoWord(Msg.Recog)) = 1;

        g_HumanRunConfig.boCanRunNpc := LoByte(HiWord(Msg.Recog)) = 1;
      end;

      EnterCriticalSection(FCSActionLock);
      try
        FActionLock := False;
      finally
        LeaveCriticalSection(FCSActionLock);
      end;
      Inc(g_nReceiveCount);

      {$IF DEBUG_RUN_DELAY_SELF = 1}
      if g_ActionCode = CM_RUN then begin
        g_SelfRunRecvMsg.Add(IntToStr(TimeGetTime));
        g_SelfRunRecvMsg.SaveToFile(g_sSelfRunRecvMsgFile);
      end;
      {$IFEND}
    end else begin
      EnterCriticalSection(FCSActionLock);
      try
        FActionLock := False;
      finally
        LeaveCriticalSection(FCSActionLock);
      end;

      if Msg.Tag = 1 then
        ActionFailed(Msg.Recog, StrToIntDef(sData, -1), Msg.Series)
      else
        ActionFailed;

      Inc(g_nReceiveCount);

      {$IF DEBUG_RUN_DELAY_SELF = 1}
      if g_ActionCode = CM_RUN then begin
        g_SelfRunRecvMsg.Add(IntToStr(TimeGetTime));
        g_SelfRunRecvMsg.SaveToFile(g_sSelfRunRecvMsgFile);
      end;
      {$IFEND}

      if (Msg.Tag = 1) and (LegendMap.EndX > 0) and (LegendMap.EndY > 0) and (Length(LegendMap.RunPath) > 0)
        and (not LegendMap.StartFind) and (not (g_boGJRun and (g_AutoGJPoints.Count > 0))) then begin
        nX := LegendMap.EndX;
        nY := LegendMap.EndY;
        LegendMap.Stop;
        LegendMap.EndX := nX;
        LegendMap.EndY := nY;
        LegendMap.Find(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, LegendMap.EndX, LegendMap.EndY);
        LegendMap.PathPoisonIndex := 0;
      end;
    end;
    Exit;
  end else if Msg.Ident = SM_MAGIC_OPEN then begin
    case Msg.Param of
      7: {// 打开攻杀} begin
          g_boNextTimePowerHit := True;
        end;
      12: {// 刺杀} begin
          g_boCanLongHit := Msg.Tag <> 0;
        end;
      25: {// 半月} begin
          g_boCanWideHit := Msg.Tag <> 0;
        end;
      26: {// 烈火} begin
          g_boNextTimeFireHit := Msg.Tag <> 0;

          if g_boNextTimeFireHit then begin
            {$IF TESTMODE = 1}
            //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~烈火开启.', clRed, clBlack);
            {$IFEND}
            // 开启双烈火时
            if g_ClientConfig.boEnableDoubleFireHitSkill then begin
              ClientMagic := FindMagic(26);

              if (ClientMagic <> nil) then begin
                g_dwMagicDelayTime := g_MySelf.UseMagicDelayTime(ClientMagic.Def.dwMagicDelayTime);
                ClientMagic.dwLastUseTick := MyGetTickCount;
              end;
            end;
          end else begin
            // 关闭烈火
            g_boLatestSpell := False;
          end
        end;
      40: {// 抱月/ 双龙斩} begin
          g_boCanCrsHit := Msg.Tag <> 0;
        end;
      42: {// 龙影} begin
          g_boNextTime42Hit := Msg.Tag <> 0;
          if g_boNextTime42Hit then begin
            g_dwLatest42HitTick := MyGetTickCount;
          end;
        end;
      43: {// 雷霆剑法} begin
          boNextTime43Hit := Msg.Tag <> 0;
        end;
      56: {// 逐日} begin
          g_boNextTimeSwordHit := Msg.Tag <> 0;

          if g_boNextTimeSwordHit then begin
            g_dwLatestSwordHitTick := MyGetTickCount;
          end;
        end;
      66: {// 开天斩} begin
          // 开天斩重击
          if Msg.Series = 0 then begin
            g_boNextTime66Hit := Msg.Tag <> 0;

            if g_boNextTime66Hit then begin
              g_boNextTime66Hit1 := False; // 开天斩轻击不可用
              g_dwLatest66HitTick := MyGetTickCount;
            end;
          end else begin
            // 开天斩轻击
            g_boNextTime66Hit1 := Msg.Tag <> 0;

            if g_boNextTime66Hit1 then begin
              g_boNextTime66Hit := False; // 开天斩轻击不可用
              g_dwLatest66HitTick := MyGetTickCount;
            end;
          end;
        end;
      113: {// 断空斩} begin
          g_boNextTime113Hit := Msg.Tag <> 0;

          if g_boNextTime113Hit then begin
            g_dwLatest113HitTick := MyGetTickCount;
          end;
        end;
      115: {// 血魄一击} begin
          g_boNextTime115Hit := Msg.Tag <> 0;

          if g_boNextTime115Hit then begin
            g_dwLatest115HitTick := MyGetTickCount;
          end;
        end;
      else begin
          if Msg.Param = 0 then begin
            g_MySelf.m_boDigFragment := True;
          end else if CheckIsCustomMagic(Msg.Param) then begin
            nIndex := Msg.Param - CUSTOM_MAGIC_START_ID;

            if Msg.Tag <> 0 then begin
              // 开自定义技能时，不关前面的自定义技能 2020-04-28
              {
              if Msg.Series = 0 then
              begin
                // 刺杀技能不要关闭 2019-11-16 15:40:18
                if g_ConfigClient.AutoCustomMagic[7].IsOpen then
                begin
                  for I := g_boNextTimeCustomMagicList.Count - 1 downto 0 do
                  begin
                    IsFound := False;
                    for II := 0 to Length(g_AutoCustomMagic[7]) - 1 do
                    begin
                      if Integer(g_boNextTimeCustomMagicList.Items[I]) = (g_AutoCustomMagic[7][II] - CUSTOM_MAGIC_START_ID) then
                      begin
                        IsFound := True;
                        Break;
                      end;
                    end;

                    if not IsFound then
                    begin
                      g_boNextTimeCustomMagicList.Delete(I);
                    end;
                  end;
                end
                else
                begin
                  // 改成开技能时关闭前面所有技能 chongchong 2017-01-15
                  g_boNextTimeCustomMagicList.Clear;
                end;
              end;
              }

              nTemp := g_boNextTimeCustomMagicList.IndexOf(Pointer(nIndex));
              if nTemp >= 0 then begin
                g_boNextTimeCustomMagicList.Delete(nTemp);
              end;

              g_boNextTimeCustomMagicList.Insert(0, Pointer(nIndex));
            end else begin
              nTemp := g_boNextTimeCustomMagicList.IndexOf(Pointer(nIndex));
              if nTemp >= 0 then begin
                g_boNextTimeCustomMagicList.Delete(nTemp);
              end;
            end;
          end;
        end;
    end;

    Exit;
  end;

  g_nRunCode := Msg.Ident;

  {$IF Enabled_PlugEngine = 1}
  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectBegin.inc}
  {$IFEND}
  if Assigned(HookDecodeMessagePacketStart) then begin
    try
      HookDecodeMessagePacketStart(@Msg, PChar(body));
    except
      on E:Exception do begin
        DebugOutStr('[Exception] HookDecodeMessagePacketStart Msg.Ident: ' + IntToStr(Msg.Ident));
        DebugOutStr(E.Message);
      end;
    end;
  end;
  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}
  {$IFEND}

  if {(Msg.ident >= 0) and}(Msg.ident <= 21000) then begin //HZQ 20230523 Msg.ident: WORD;
    if Msg.ident = SM_SOFT_DELAY_EXIT then begin
      g_boIOCP_Rungate := True;
      //SendGameCenterMsg(10001, 'IOCP');
