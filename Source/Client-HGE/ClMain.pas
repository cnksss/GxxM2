function TfrmMain.StartContinuousAttack:Integer; // 连击 战士连击

  function ContinuousHitCmd(wMagicId:Word):Word;
  begin
    case wMagicId of
      100:
        Result := CM_100HIT;
      101:
        Result := CM_101HIT;
      102:
        Result := CM_102HIT;
      103:
        Result := CM_103HIT;
      else
        Result := 0;
    end;
  end;

begin
  Result := 0; // CM_HIT;
  if g_nContinuousIndex < Length(g_ContinuousMagic) then begin
    g_CurrContinuousMagic := g_ContinuousMagic[g_nContinuousIndex];
    Result := ContinuousHitCmd(g_CurrContinuousMagic.Def.wMagicId);
  end;
end;

