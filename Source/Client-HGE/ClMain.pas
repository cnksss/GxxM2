      DScreen.AddSysMsg(g_ClientConfig.sNotEnoughMPPoint, g_ClientConfig.btUpLevelMsgFColor, g_ClientConfig.btUpLevelMsgBColor, nTempX, nTempY);
    end;
  end;
end;

function TfrmMain.UseJNMagic(tx, ty:Integer; ItemIndex:Integer):Boolean;
var
  tdir, targx, targy:integer;
  targid:Int64;
  pmag:PTUseMagicInfo;
  Feature:TFeature;
begin
  Result := False;

  if PlayScene.IsValidActor(g_FocusCret) and (not g_FocusCret.m_boDeath) then begin
    {$IF IsMultiThreadRender = 1}
    EnterCriticalSection(g_ActorLock);
    {$IFEND}
    g_MagicLockActor := g_FocusCret;
    {$IF IsMultiThreadRender = 1}
    LeaveCriticalSection(g_ActorLock);
    {$IFEND}
  end;

  if g_MagicLockActor = nil then begin
    PlayScene.CXYfromMouseXY(tx, ty, targx, targy);
    targid := 0;
  end else begin
    targx := g_MagicLockActor.m_nCurrX;
    targy := g_MagicLockActor.m_nCurrY;
    targid := g_MagicLockActor.m_nRecogId;
  end;

  tdir := GetFlyDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, targx, targy); //计算魔法攻击的方向

  if CanNextAction and ServerAcceptNextAction(False) then begin
    g_dwLatestSpellTick := MyGetTickCount;
    g_dwLatestNoGroupSpellTick := MyGetTickCount;

    new(pmag);
    FillChar(pmag^, sizeof(TUseMagicInfo), #0);
    pmag.EffectNumber := 10;
    pmag.MagicSerial := 60000;
    pmag.ServerMagicCode := 1;
    g_dwMagicDelayTime := 260; //魔法延迟时间
    g_dwLatestMagicTick := MyGetTickCount;

    FillChar(Feature, SizeOf(TFeature), 0);
    Feature.Feature := Integer(pmag);

    g_MySelf.SendMsg(CM_SPELL, targx, targy, tdir, Feature, targid, IntToStr(ItemIndex), 0);
    Result := True;
  end;
end;

procedure TfrmMain.UseMagicSpell(who:Int64; effnum, targetx, targety, magic_id, NewLevel:Integer; MagicLevel:Integer);
var
  Actor:TActor;
  adir:Integer;
  UseMagic:PTUseMagicInfo;
  Feature:TFeature;
begin
  Actor := PlayScene.FindActor(who);
  if Actor <> nil then begin
    adir := GetFlyDirection(Actor.m_nCurrX, Actor.m_nCurrY, targetx, targety);
    New(UseMagic);
    FillChar(UseMagic^, SizeOf(TUseMagicInfo), #0);
    UseMagic.EffectNumber := effnum;
    UseMagic.ServerMagicCode := 0;
    UseMagic.MagicSerial := magic_id;

    if NewLevel mod 2 = 0 then
      UseMagic.MagicItemType := True
    else
      UseMagic.MagicItemType := False;

    if UseMagic.MagicItemType then
      UseMagic.NewLevel := NewLevel div 2
    else
      UseMagic.NewLevel := (NewLevel - 1) div 2;

    UseMagic.MagicLevel := MagicLevel;
    FillChar(Feature, SizeOf(TFeature), 0);
    Feature.Feature := Integer(UseMagic);
    Actor.SendMsg(SM_SPELL, 0, 0, adir, Feature, 0, '', 0);
    // Actor.SendMsg(SM_SPELL, 0, 0, adir, Integer(UseMagic), 0, '', 0);
    Inc(g_nSpellCount);
  end else begin
    Inc(g_nSpellFailCount);
  end;
end;

procedure TfrmMain.UseMagicFire(who:Int64; efftype, effnum, targetx, targety:Integer; target:Int64; NewLevel:Integer; MagicLevel:Integer; sSayMsg:string = '');
var
  Actor:TActor;
  sound:Integer;
  // pmag: PTUseMagicInfo;
  Feature:TFeature;
begin
  // 4级技能强化 -- 4级灵魂火符 4级灭天火 chongchong 2013-12-04
  //sound := 0;
  sound := MagicLevel;

  Actor := PlayScene.FindActor(who);
  if Actor <> nil then begin
    FillChar(Feature, SizeOf(TFeature), 0);
    Feature.Feature := targetx;

    Actor.SendMsg(SM_MAGICFIRE, targety {111magid}, efftype, MakeLong(effnum, NewLevel), Feature, target, sSayMsg, sound);
    if g_nFireCount < g_nSpellCount then
      Inc(g_nFireCount);
  end;
  {$IF IsMultiThreadRender = 1}
  EnterCriticalSection(g_ActorLock);
  {$IFEND}
  g_MagicTarget := nil;
  {$IF IsMultiThreadRender = 1}
  LeaveCriticalSection(g_ActorLock);
  {$IFEND}
end;

procedure TfrmMain.UseMagicFireFail(who:Int64);
var
  Actor:TActor;
begin
  Actor := PlayScene.FindActor(who);
  if Actor <> nil then begin
    Actor.SendMsg(SM_MAGICFIRE_FAIL, 0, 0, 0, 0, '', 0);
  end;
  {$IF IsMultiThreadRender = 1}
  EnterCriticalSection(g_ActorLock);
  {$IFEND}
  g_MagicTarget := nil;
  {$IF IsMultiThreadRender = 1}
  LeaveCriticalSection(g_ActorLock);
  {$IFEND}
end;

function TfrmMain.AutoEatItem(idx:Integer):Boolean;
var
  TimeInterval, TimeInterval2:Integer;
begin
  Result := False;
  if idx in [0..GetMaxBagCount - 1] then begin
    if (g_AutoEatingItem.S.Name <> '') and (MyGetTickCount - g_dwAutoEatTime > 5 * 1000) then begin
      g_AutoEatingItem.S.Name := '';
    end;
    if (g_AutoEatingItem.S.Name = '') and (g_ItemArr[idx].S.Name <> '') then begin
      // 修正内挂吃药会吃31类卷轴的问题 chongchong 2013-10-27
      if (g_ItemArr[idx].S.Name <> '') and ((g_ItemArr[idx].S.StdMode <= 3) or ((g_ItemArr[idx].S.StdMode = 31) and (not (g_ItemArr[idx].S.Shape in [0, 1, 15..51])) and (g_ItemArr[idx].S.Reserved = 0))) and (g_EatingItem.s.Name = '') then begin
        TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].Other;
        if (g_ItemArr[idx].S.StdMode = 0) then begin
          if g_ItemArr[idx].S.Shape <> 1 then {// 普通药物}  begin
            if (g_ItemArr[idx].S.AC1 > 0) and (g_ItemArr[idx].S.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].NormalHPMP
            else if (g_ItemArr[idx].S.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].NormalMP
            else
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].NormalHP;
          end
          else {// 特殊药物}  begin
            if (g_ItemArr[idx].S.AC1 > 0) and (g_ItemArr[idx].S.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].SpecialHPMP
            else if (g_ItemArr[idx].S.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].SpecialMP
            else
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].SpecialHP;
          end;
        end;

        if TimeInterval > 0 then
          TimeInterval2 := TimeInterval + 10
        else
          TimeInterval2 := TimeInterval;

        if (MyGetTickCount - g_dwEatTime < Cardinal(TimeInterval))
          and (MyGetTickCount - g_dwAutoEatTime <= Cardinal(TimeInterval2)) then begin
          Exit;
        end else begin
          Result := True;
          g_AutoEatingItem := g_ItemArr[idx];
          g_ItemArr[idx].S.Name := '';
          g_dwAutoEatTime := MyGetTickCount;
          SendAutoEat(g_AutoEatingItem.MakeIndex, g_AutoEatingItem.s.Name);
          ItemUseSound(g_AutoEatingItem.s);
        end;
      end // 及时雨手动添加保护物品 chongchong 2015-04-19
      else if (g_ItemArr[idx].S.Name <> '') and (g_ItemArr[idx].S.StdMode = 31) and (g_EatingItem.S.Name = '') then begin
        TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].Other;
        if (g_ItemArr[idx].S.StdMode = 0) then begin
          if g_ItemArr[idx].S.Shape <> 1 then {// 普通药物}  begin
            if (g_ItemArr[idx].S.AC1 > 0) and (g_ItemArr[idx].S.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].NormalHPMP
            else if (g_ItemArr[idx].S.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].NormalMP
            else
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].NormalHP;
          end
          else {// 特殊药物}  begin
            if (g_ItemArr[idx].S.AC1 > 0) and (g_ItemArr[idx].S.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].SpecialHPMP
            else if (g_ItemArr[idx].S.MAC1 > 0) then
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].SpecialMP
            else
              TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].SpecialHP;
          end;
        end;

        if (MyGetTickCount - g_dwEatTime < Cardinal(TimeInterval)) and (MyGetTickCount - g_dwAutoEatTime < Cardinal(TimeInterval)) then begin
          Exit;
        end else begin
          Result := True;
          g_dwAutoEatTime := MyGetTickCount;
          g_AutoEatingItem := g_ItemArr[idx];
          g_ItemArr[idx].S.Name := '';
          SendAutoEat(g_AutoEatingItem.MakeIndex, g_ItemArr[idx].S.Name);
          ItemUseSound(g_AutoEatingItem.s);
        end;
      end;
    end;
  end;
end;

procedure TfrmMain.EatItem(idx:Integer);
var
  I:Integer;
  boFind:Boolean;
  TimeInterval:Integer;
begin
  if g_boMySelfLock then
    Exit;

  // 快速按快捷方式上的“药品”，然后 同时点“回城石”，“回城石”会闪一下，然后回城无效。chongchong 2018-07-10 00:14:46
  if (tick_diff(g_dwEatTime, MyGetTickCount) <= 1500) and (Length(g_EatingItem.s.Name) > 0) then begin
    Exit;
  end;

  {$IF TESTMODE = 1}
  DScreen.AddChatBoardString(IntToStr(g_dwEatTime) + g_EatingItem.s.Name, clRed, clBlack);
  {$IFEND}
  // 修正物品人摆摊框中点击，选中物品后，到背包中双击放入到背包后，马上把物品用了 2020-08-04 23:15:40
  if g_IsStopEat and (tick_diff(g_dwStopEatTime, MyGetTickCount) <= 2000) then begin
    Exit;
  end
  else begin
    g_IsStopEat := False;
  end;

  if g_boItemMoving then begin
    g_boItemMoving := False;
    g_EatingItem := g_MovingItem.Item;
    g_MovingItem.Item.S.Name := '';
    g_EatingItemIndex := g_MovingItem.Index;

    if (g_EatingItem.S.StdMode = 4) and (g_EatingItem.S.Shape < 100) then begin
      if g_EatingItem.S.Shape < 50 then begin
        if mrYes <> FrmDlg.DMessageDlg('是否确认开始练习 "' + g_EatingItem.S.Name + '"？', [mbYes, mbNo]) then begin
          AddItemBag(g_EatingItem);
          g_EatingItem.S.Name := '';
          g_EatingItemIndex := -1;
          Exit;
        end;
      end
      else begin
        if mrYes <> FrmDlg.DMessageDlg('是否确认开始练习 "' + g_EatingItem.S.Name + '"？.', [mbYes, mbNo]) then begin
          AddItemBag(g_EatingItem);
          g_EatingItem.S.Name := '';
          g_EatingItemIndex := -1;
          Exit;
        end;
      end;
    end
    else if (g_EatingItem.S.StdMode = 93) then begin
      if g_CurrentRecallGamePetIndex < 0 then begin
        DScreen.AddChatBoardString(DecodeResStr(SPetMsg1), clRed, clBlack);
        AddItemBag(g_EatingItem);
        g_EatingItem.S.Name := '';
        g_EatingItemIndex := -1;
        Exit;
      end;

      if mrYes <> FrmDlg.DMessageDlg('是否确认开始练习宠物技能 "' + g_EatingItem.S.Name + '"？.', [mbYes, mbNo]) then begin
        AddItemBag(g_EatingItem);
        g_EatingItem.S.Name := '';
        g_EatingItemIndex := -1;
        Exit;
      end;
    end
    else if g_EatingItem.s.StdMode = 95 then begin
      if not UseJNMagic(g_nMouseX, g_nMouseY, g_EatingItem.MakeIndex) then begin
        AddItemBag(g_EatingItem);
        g_EatingItem.S.Name := '';
        g_EatingItemIndex := -1;
      end
      else begin
        g_dwEatTime := MyGetTickCount;
      end;
      Exit;
    end;

    // 聚灵珠释放提示先不要 chongchong 2016-03-12
    {
    if ((g_EatingItem.S.StdMode = 49) and (g_EatingItem.Dura >= g_EatingItem.DuraMax)) then
    begin
      case g_EatingItem.S.AniCount of
        0: sGoldName := g_sGameGoldName;
        1: sGoldName := g_sGoldName;
      else
        sGoldName := g_sGoldName;
      end;
      if mrYes <> FrmDlg.DMessageDlg(Format('是否要花费%d%s来释放%s的经验？', [g_EatingItem.S.Need, sGoldName, g_EatingItem.S.Name]), [mbYes, mbNo]) then
      begin
        AddItemBag(g_EatingItem);
        g_EatingItem.S.Name := '';
        Exit;
      end;
    end;
    }
    // 传送系列物品使用不要间隔 2018-07-11 17:20:11
    if ((g_EatingItem.s.StdMode = 2) and (g_EatingItem.s.Shape in [1, 2, 3])) or // 传送石系列
    ((g_EatingItem.s.StdMode = 3) and (g_EatingItem.s.Shape in [1, 2, 3, 5])) then {// 传送卷系列}  begin
      TimeInterval := 0
    end
    else begin
      TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].Other;
      if (g_EatingItem.s.StdMode = 0) then begin
        if g_EatingItem.s.Shape <> 1 then {// 普通药物}  begin
          if (g_EatingItem.s.AC1 > 0) and (g_EatingItem.s.MAC1 > 0) then
            TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].NormalHPMP
          else if (g_EatingItem.s.MAC1 > 0) then
            TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].NormalMP
          else
            TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].NormalHP;
        end
        else {// 特殊药物}  begin
          if (g_EatingItem.s.AC1 > 0) and (g_EatingItem.s.MAC1 > 0) then
            TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].SpecialHPMP
          else if (g_EatingItem.s.MAC1 > 0) then
            TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].SpecialMP
          else
            TimeInterval := g_EatItemCDConfig.Hum[g_MySelf.m_btJob].SpecialHP;
        end;
      end;
    end;

    if (MyGetTickCount - g_dwEatTime < Cardinal(TimeInterval))
      and (MyGetTickCount - g_dwAutoEatTime < Cardinal(TimeInterval)) then begin
      g_MovingItem.Item.S.Name := g_EatingItem.s.Name;
      AddItemBag(g_MovingItem.Item);
      g_EatingItem.s.Name := '';
      g_EatingItemIndex := -1;
      g_MovingItem.Item.s.Name := '';
      Exit;
    end else begin
      g_dwEatTime := MyGetTickCount;
      SendEat(g_EatingItem.MakeIndex, g_EatingItem.S.Name);
      ItemUseSound(g_EatingItem.S);
    end;

    if PlugInEnabled and g_ClientConfig.boAutoOrderItem and g_ConfigDlg.ConfigCheckeds[ckAutoOrderItem] then begin
      boFind := False;
      for I := Low(g_ItemArr) + 6 to GetMaxBagCount - 1 do begin
        if g_ItemArr[I].S.Name <> '' then begin
          if CompareText(g_ItemArr[I].S.Name, g_EatingItem.S.Name) = 0 then begin
            g_boLockBeltShortcut := True;
            SendDelayMsg(g_MySelf, RCM_AutoOrderItem, 0, g_MovingItem.Index, 0, 0, g_EatingItem.S.Name, 500);
            boFind := True;

            // DScreen.AddChatBoardString('TfrmMain.EatItem2:' + IntToStr(g_MovingItem.Index) + ' ' + g_EatingItem.S.Name, clWhite, clPurple);
            Break;
          end;
        end;
      end;

      if not boFind then begin // 查找解包
        if HumBagNoUseItemCount >= 6 then begin
          if (FindHumBindItemIndex(g_EatingItem.S.Name) >= 0) then begin
            // DScreen.AddChatBoardString('TfrmMain.EatItem 解包:' + IntToStr(nIndex) + ' ' + g_EatingItem.S.Name, clWhite, clPurple);
            SendDelayMsg(g_MySelf, RCM_UNBINDITEM, 0, 0, 0, 0, g_EatingItem.S.Name, 1000);
          end;
        end;
      end;
    end;
  end
  else begin
    if idx in [0..GetMaxBagCount - 1] then begin
      if (g_EatingItem.S.Name <> '') and (MyGetTickCount - g_dwEatTime > 10 * 1000) then begin
        g_EatingItem.S.Name := '';
        g_EatingItemIndex := -1;
      end;

      if (g_EatingItem.S.Name = '') and (g_ItemArr[idx].S.Name <> '') and ((g_ItemArr[idx].S.StdMode <= 3) or (g_ItemArr[idx].S.StdMode = 60) or (g_ItemArr[idx].S.StdMode = 49) or (g_ItemArr[idx].S.StdMode in [95, 96])) then begin
        g_EatingItem := g_ItemArr[idx];
        g_EatingItemIndex := idx;
