function TfrmMain.AutoEatBindItem(idx:Integer):Boolean;
begin
  Result := False;
  if (idx in [0..GetMaxBagCount - 1]) then begin
    if (g_AutoEatingItem.s.Name <> '') and (MyGetTickCount - g_dwAutoEatTime > 5 * 1000) then begin
      g_AutoEatingItem.s.Name := '';
    end;
    if (g_AutoEatingItem.s.Name = '') then begin
      // 修正内挂吃药会吃31类卷轴的问题 chongchong 2013-10-27
      if (g_ItemArr[idx].S.Name <> '') and ((g_ItemArr[idx].S.StdMode <= 3) or ((g_ItemArr[idx].S.StdMode = 31) and not (g_ItemArr[idx].S.Shape in [0, 1, 15..51]) and (g_ItemArr[idx].S.Reserved = 0))) then begin
        g_dwAutoEatTime := MyGetTickCount;
        g_AutoEatingItem := g_ItemArr[idx];
        g_nAutoUnPakItemMakeIndex := g_AutoEatingItem.MakeIndex;
        g_ItemArr[idx].S.Name := '';

        SendAutoEat(g_AutoEatingItem.MakeIndex, g_AutoEatingItem.s.Name);
        Result := True;
      end;
    end;
  end;
end;
