procedure TfrmMain.ProcessMessageHide(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I64:Int64Rec;
begin
  if g_MySelf = nil then
    Exit;
  if g_MySelf.m_nRecogId <> DefMsg.Recog then begin
    if DefMsg.Ident <> SM_DISAPPEARMYHERO then begin
      if (DefMsg.Ident = SM_DISAPPEAR) and (sData <> '') and (Length(sData) = SizeOf(Int64)) then begin
        Move(sData[1], I64, SizeOf(Int64));
        PlayScene.SendMsg(SM_HIDE, DefMsg.Recog, I64.Lo, I64.Hi, 0, nil, 0, '')
      end
      else
        PlayScene.SendMsg(SM_HIDE, DefMsg.Recog, DefMsg.param {x}, DefMsg.tag {y}, 0, nil, 0, '');
    end
    else
