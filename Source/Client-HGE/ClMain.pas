function TfrmMain.CanNextHit:Boolean;
var
  NextHitTime:Integer;
  CurHitTick:LongWord;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode_M.inc}
  {$IFEND}
  Result := False;

  if (g_MySelf.m_btHorse = 0) and g_boCanAttack and (not g_boMySelfLock) and (g_MySelf.m_nChangeAppr < 0 {没有变身}) then begin
    NextHitTime := g_MySelf.GetNextHitTime;

    CurHitTick := timeGetTime;

    // 在跑步前去攻击目标时，前几刀过快 chongchong 2016-01-06
    if (CurHitTick - LastHitTick) > LongWord(NextHitTime) then begin
      //DScreen.AddChatBoardString('攻击间隔:' + IntToStr(MyGetTickCount - LastHitTick), clWhite, clBlack);
      LastHitTick := CurHitTick;
      Result := True;
    end
  end;
end;

function TfrmMain.IsUnLockAction(Action, adir:Integer):Boolean;
begin
  if ActionFailLock then begin // 如果操作被锁定，则在指定时间后解锁  (g_ActionCode = Action)
    if MyGetTickCount() - ActionFailLockTime > 1000 then
      ActionFailLock := False;
  end;
  if (ActionFailLock) or (g_boMapMoving) or (g_boServerChanging) then begin
    Result := False;
  end
  else
    Result := True;
  {
     if (ActionFailLock and (action = FailAction) and (adir = FailDir))
        or (MapMoving)
        or (BoServerChanging) then begin
        Result := False;
     end else begin
        ActionFailLock := False;
        Result := TRUE;
     end;
  }
end;

procedure Tfrmmain.ClearGroupMembers;
var
  I:Integer;
  GroupMember:PGroupMember;
begin
  for I := 0 to g_GroupMembers.Count - 1 do begin
    GroupMember := g_GroupMembers.Items[I];
    Dispose(GroupMember);
  end;
  g_GroupMembers.Clear;
end;

function TfrmMain.IsGroupMember(uname:string):Boolean;
var
  I:Integer;
  GroupMember:PGroupMember;
begin
  Result := False;
  for I := 0 to g_GroupMembers.Count - 1 do begin
    GroupMember := g_GroupMembers.Items[I];
    if SameText(GroupMember.sCharName, uname) then begin
      Result := True;
      Break;
    end;
  end;
end;

procedure TfrmMain.Run;
var
  ProcessMsg:TProcessMessage;
begin
  m_dwGetMsgTick := MyGetTickCount();
  while (MyGetTickCount - m_dwGetMsgTick < 200) and GetMessage(@ProcessMsg) do begin
    if not Operate(@ProcessMsg) then
      Break;
  end;
end;

