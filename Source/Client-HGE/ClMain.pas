procedure TfrmMain.ProcessMessageHit(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Actor:TActor;
  Level:Integer;
begin
  if g_MySelf = nil then
    Exit;

  if (DefMsg.ident >= SM_60HIT) and (DefMsg.ident <= SM_62HIT) then begin
    if DefMsg.Recog = g_MySelf.m_nRecogId then begin
      // 修复战战合击破魂斩卡位（使用合击之后，立马跑步) chongchong 2018-06-20 17:21:35

      if DefMsg.Ident = SM_60HIT then begin
        g_LastGroupAttackTick := MyGetTickCount;
      end;

      g_MySelf.SendMsg(DefMsg.ident, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir}, 0, '', 0);
      Exit;
    end;
  end;

  //DScreen.AddChatBoardString('攻击间隔:' + IntToStr(MyGetTickCount - LastHitMsg), clWhite, clBlack);
  //LastHitMsg := MyGetTickCount;

  Actor := PlayScene.FindActor(DefMsg.Recog);
  if Actor <> nil then begin
    // 4级技能强化 -- 4级烈火 chongchong 2013-12-04
    if DefMsg.ident = SM_FIREHIT then begin
      Level := StrToIntDef(sData, 0);
      Actor.SendMsg(DefMsg.ident, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir}, LoWord(Level), '', HiWord(Level));
    end
    else begin
      {$IF TESTMODE = 1}
      if (DefMsg.ident = rm_66hit) or (DefMsg.ident = sm_66hit1) then begin
        //DScreen.AddChatBoardString('~~~~~~开天.', clRed, clBlack);
      end;
      {$IFEND}

      Actor.SendMsg(DefMsg.ident, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir}, StrToIntDef(sData, 0), '', 0);
    end;

    if DefMsg.ident = SM_HEAVYHIT then begin
      if sData <> '' then
        Actor.m_boDigFragment := True;
    end;

    {$IF TESTMODE = 1}
    if Actor = g_MyHero then begin
      //DScreen.AddChatBoardString('~~~~~~英雄攻击间隔: ' + IntToStr(MyGetTickCount - g_MyHeroHitTick), clRed, clBlack);
      g_MyHeroHitTick := MyGetTickCount;
    end;
    {$IFEND}
  end;
end;

