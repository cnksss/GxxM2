procedure TfrmMain.ProcessMessageQueryChrOK(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, select:Integer;
  Str, uname, sjob, shair, slevel, ssex, sSelName:string;
begin
  SelectChrScene.ClearChrs;
  Str := DecodeString(sData);
  select := 0;
  sSelName := '';
  I := 0;
  while True do {//for I := 0 to 2 do}  begin
    Str := GetValidStr3_Ex(Str, uname, '/');
    Str := GetValidStr3_Ex(Str, sjob, '/');
    Str := GetValidStr3_Ex(Str, shair, '/');
    Str := GetValidStr3_Ex(Str, slevel, '/');
    Str := GetValidStr3_Ex(Str, ssex, '/');
    if (uname <> '') and (slevel <> '') and (ssex <> '') then begin
      if uname[1] = '*' then begin
        select := I;
        uname := System.Copy(uname, 2, Length(uname) - 1);
        sSelName := uname;
      end;
      SelectChrScene.m_nHighIndex := I;
      Inc(I);
      SelectChrScene.AddChr(uname, StrToIntDef(sjob, 0), StrToIntDef(shair, 0), StrToIntDef(slevel, 0), StrToIntDef(ssex, 0));
      // Showmessage(uname);
    end else begin
      Break;
    end;
  end;
  with SelectChrScene do begin
    for I := 0 to High(ChrArr) do begin
      ChrArr[I].FreezeState := True;
      ChrArr[I].Selected := False;
    end;
    ChrArr[select].FreezeState := False;
    ChrArr[select].Selected := True;

    SelSetText;
  end;

  // 修复窗口游戏标题不要显示第一个名字只需要显示正确的即可！ chongchong 2014-03-17
  if sSelName = '' then
    Caption := g_sServerName + ' - ' + SelectChrScene.ChrArr[0].UserChr.name
  else
    Caption := {g_ClientParam.sServerCaption + ' - ' +} g_sServerName + ' - ' + sSelName;

  // Application.Title := g_sServerName + ' - ' + sSelName;
end;

