      SendHeroEat(g_HeroEatingItem.MakeIndex, g_HeroEatingItem.s.Name);
      ItemUseSound(g_HeroEatingItem.s);
    end;
  end;
end;

function TfrmMain.IsAttackTarget(Actor:TActor):Boolean;
var
  sUserName, sText:string;
begin
  Result := False;
  if (not Actor.m_boDeath) and (not Actor.m_boGhost) then begin
    if (Actor.m_btRace <> RC_MERCHANT) and (Actor <> g_MyHero) and (Actor.m_btRace <> 50) then begin
      Result := True;
      if (Pos('(', Actor.m_sUserName) > 0) then begin
        sText := Actor.m_sUserName;
        sText := ArrestStringEx(sText, '(', ')', sUserName);
        if CompareText(sUserName, g_MySelf.m_sUserName) = 0 then
          Result := False;
        {$IF IsMultiThreadRender = 1}
        EnterCriticalSection(g_ActorLock);
        try
          {$IFEND}
          if (g_MyHero <> nil) and (CompareText(sUserName, g_MyHero.m_sUserName) = 0) then
            Result := False;
          {$IF IsMultiThreadRender = 1}
        finally
          LeaveCriticalSection(g_ActorLock);
        end;
        {$IFEND}
      end;
    end;
  end;
end;

function TfrmMain.CanAttack(ndir:Integer; target:TActor):Boolean;
var
  nX, nY:Integer;
  Actor:TActor;
begin
  Result := False;
  GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, ndir, nX, nY);
  if (target.m_nCurrX = nX) and (target.m_nCurrY = nY) then begin
    Actor := PlayScene.FindActorXY(nX, nY, target);
    if (Actor = target) then
      Result := True;
  end;
end;

