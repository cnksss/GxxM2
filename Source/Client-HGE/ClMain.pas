              end;
            end;

            // 自定义技能 - 断空斩
            for II := 0 to Length(g_AutoCustomMagic[mngo113Hit]) - 1 do begin
              CustomMagiID := g_AutoCustomMagic[mngo113Hit][II];
              if (not boFoundOpenHitMagic) and CheckIsCustomMagic(CustomMagiID) and (g_boNextTimeCustomMagicList.IndexOf(Pointer(CustomMagiID - CUSTOM_MAGIC_START_ID)) < 0) and (MyGetTickCount - g_dwLastTryCustomMagicHitTick[CustomMagiID - CUSTOM_MAGIC_START_ID] >= 1000) and g_WarrContinueHitManager.CanOpenMagic(CustomMagiID) then begin
                CustomMagicConfig := GetCustomMagicConfig(CustomMagiID);
                if (CustomMagicConfig <> nil) and (CustomMagicConfig.boIsMagicWarr) and (CustomMagicConfig.MagicBaseConfig.MagicSwitchMode in [msmSwitch, msmNone]) then begin
                  g_MagicList.Lock;
                  try
                    for I := 0 to g_MagicList.Count - 1 do begin
                      Magic := g_MagicList.Items[I];
                      if (Magic.Def.wMagicId = CustomMagiID) and (MyGetTickCount - Magic.dwLastUseTick >= Magic.dwRealInterval + 100) then begin
                        if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                          g_dwLastTryCustomMagicHitTick[CustomMagiID - CUSTOM_MAGIC_START_ID] := MyGetTickCount;

                          PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);

                          // 不能用 UseMagic，会被时间拦截 chongchong 2018-06-04
                          //UseMagic(nX, nY, Magic);
