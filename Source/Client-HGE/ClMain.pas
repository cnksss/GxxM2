function IsGJAttackTarget(Actor:TActor):Boolean;
begin
  Result := (Actor <> nil) and (not Actor.m_boDeath) and (not Actor.m_boGhost) and (Actor.m_HumsBBType = bbNo) and (not ((Actor.m_btRace in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (not Actor.m_boPlayMoster))) and (not ((Actor is TNpcActor) or (Actor is TStatuaryNpcActor))) and (not (Actor.m_btRealRace in [RC_GUARD {卫士}, 12 {巡逻卫士}, RC_ARCHERGUARD {大刀}, 55 {练功师}, 110 {沙巴克的 城门}, 111 {沙巴克的 左墙,中，右}, 112 {弓箭手}, 142 {巡逻箭手}]));

  // 内挂挂机道法不攻击石化怪物 2020-07-07
  if Result and (g_MySelf <> nil) and (g_MySelf.m_btJob in [1, 2]) then
    Result := Actor.m_nState and STATE_STONE_MODE = 0;

  {and (Actor.m_nState and STATE_STONE_MODE = 0)}; // 修正内挂挂机不会攻击石化怪物(祖玛雕像) 2020-03-24 18:14:38
end;

function GetRoundTargetCount:Integer;
var
  I, nX, nY:Integer;
  Actor:TActor;
const
  WideAttack:array[0..2] of Integer = (7, 1, 2);
begin
  Result := 0;
  for I := 0 to 7 do begin
    GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, I, nX, nY);
    Actor := PlayScene.FindActorXY(nX, nY);
    if IsGJAttackTarget(Actor) then begin
      Inc(Result);
    end;
  end;
end;

procedure GetRoundTargetList(X, Y:Integer; Actors:TList; Distance:Integer);
var
  I, J, nX, nY:Integer;
  Actor:TActor;
begin
  Actors.Clear;
  if Distance <= 0 then Distance := 1;

  for I := 0 to 7 do begin
    for J := 1 to Distance do begin
      GetFrontPosition(X, Y, I, J, nX, nY);
      Actor := PlayScene.FindActorXY(nX, nY);
      if IsGJAttackTarget(Actor) then begin
         Actors.Add(Actor)
      end;
    end;
  end;
end;

function MagCanHitTarget(sX, sY, dX, dY:Integer):Boolean;
var
  n14, n18, n1C, n20:Integer;
begin
  Result := False;

  n20 := abs(sX - dX) + abs(sY - dY);
  n14 := 0;
  while (n14 < 13) do begin
    n18 := GetNextDirection(sX, sY, dX, dY);

    GetFrontPosition(sX, sY, n18, 1, sX, sY);
    if Map.NewCanMove(sX, sY) then begin
      if (sX = dX) and (sY = dY) then begin
        Result := True;
        Break;
      end else begin
        n1C := abs(sX - dX) + abs(sY - dY);
        if n1C > n20 then begin
          Result := True;
          Break;
        end;
      end;
    end else begin
      Break;
    end;
    Inc(n14);
  end;
end;

