// 检测包裹中是否有符和毒
// nType 为指定类型 5 为护身符 1,2 为毒药

function GetUserItemList(Shape, nCount:Integer):Integer;
var
  I:Integer;
begin
  Result := -1;
  for I := 0 to GetMaxBagCount - 1 do begin
    if g_ItemArr[I].S.Name <> '' then begin
      if CheckItemType(Shape, @g_ItemArr[I].S) and (Round(g_ItemArr[I].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
        Result := I;
        Break;
      end;
    end;
  end;
end;

// 检测包裹中是否有符和毒
// nType 为指定类型 5 为护身符 1,2 为毒药

function GetUserItemListEx(Shape, nCount:Integer):Integer;
var
  I:Integer;
begin
  Result := -1;
  for I := 0 to GetMaxBagCount - 1 do begin
    if g_ItemArr[I].S.Name <> '' then begin
      if CheckItemTypeEx(Shape, @g_ItemArr[I].S) and (Round(g_ItemArr[I].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
        Result := I;
        Break;
      end;
    end;
  end;
end;

function CheckBagAmulet(var nShape:Integer; nCount:Integer; var Idx:Integer; boEqual:Boolean = False):Boolean;
var
  boNeedMagicItem:Boolean;
begin
  Result := False;
  Idx := -1;

  boNeedMagicItem := False;
  if g_ClientConfig.nHumNeedMagicItem = 0 then begin
    Result := True;
  end else begin
    boNeedMagicItem := g_ClientConfig.nHumNeedMagicItem = 2;
  end;

  if boNeedMagicItem then begin
    if boEqual then begin
      Idx := GetUserItemListEx(nShape, nCount);
      if Idx < 0 then begin
        Idx := GetUserItemList(nShape, nCount);
        boEqual := False;
      end;
    end
    else begin
      Idx := GetUserItemList(nShape, nCount);
    end;

    if (Idx >= 0) and (Idx < GetMaxBagCount) then begin
      if (g_ItemArr[Idx].S.Name <> '') then begin
        if (g_ItemArr[Idx].S.StdMode = 25) then begin
          case nShape of
            5:begin
                if (g_ItemArr[Idx].S.Shape = nShape) and (Round(g_ItemArr[Idx].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                  Inc(Idx, 13);
                  Result := True;
                  Exit;
                end;
              end;
            1, 2:begin
                if boEqual then begin
                  if (g_ItemArr[Idx].S.Shape = nShape) and (Round(g_ItemArr[Idx].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                    Inc(Idx, 13);
                    nShape := g_ItemArr[Idx].S.Shape;
                    Result := True;
                    Exit;
                  end;
                end
                else begin
                  if (g_ItemArr[Idx].S.Shape in [1, 2]) and (Round(g_ItemArr[Idx].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                    Inc(Idx, 13);
                    nShape := g_ItemArr[Idx].S.Shape;
                    Result := True;
                    Exit;
                  end;
                end;
              end;
          end;
        end;
      end;
    end;
  end;
end;

// nType 为指定类型 1 为护身符 2 为毒药  3诅咒符    Idx = -1; 不需要毒 符  Idx >= 13 使用包裹中的  Idx < 13 使用身上的

function CheckAmulet(var nShape:Integer; nCount:Integer; var Idx:Integer):Boolean;
var
  boNeedMagicItem:Boolean;
begin
  Result := False;
  Idx := -1;
  boNeedMagicItem := False;

  if g_ClientConfig.nHumNeedMagicItem = 0 then begin
    Result := True;
  end
  else begin
    boNeedMagicItem := True;
  end;

  if boNeedMagicItem then begin
    if g_UseItems[U_ARMRINGL].S.Name <> '' then begin
      if (g_UseItems[U_ARMRINGL].S.StdMode = 25) then begin
        case nShape of
          5:begin // 符咒
              if (g_UseItems[U_ARMRINGL].S.Shape = nShape) and (Round(g_UseItems[U_ARMRINGL].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                Idx := U_ARMRINGL;
                Result := True;
                Exit;
              end;
            end;
          1, 2:begin // 毒
              if (g_UseItems[U_ARMRINGL].S.Shape in [1, 2]) and (Round(g_UseItems[U_ARMRINGL].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                nShape := g_UseItems[U_ARMRINGL].S.Shape;
                Idx := U_ARMRINGL;
                Result := True;
                Exit;
              end;
            end;
        end;
      end;
    end;

    if g_UseItems[U_BUJUK].S.Name <> '' then begin
      if (g_UseItems[U_BUJUK].S.StdMode = 25) then begin
        case nShape of
          5:begin
              if (g_UseItems[U_BUJUK].S.Shape = nShape) and (Round(g_UseItems[U_BUJUK].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                Idx := U_BUJUK;
                Result := True;
                Exit;
              end;
            end;
          1, 2:begin // 毒
              if (g_UseItems[U_BUJUK].S.Shape in [1, 2]) and (Round(g_UseItems[U_BUJUK].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                Idx := U_BUJUK;
                nShape := g_UseItems[U_BUJUK].S.Shape;
                Result := True;
                Exit;
              end;
            end;
        end;
      end;
    end;
  end;
end;

function CheckMagLighteningType(UserMagic:PTClientMagic; Actor:TActor):Boolean;
var
  nType, nAmuletIdx, nCount:Integer;
begin
  Result := True;
  if (UserMagic.Def.wMagicId in [6, 51]) and (Actor <> nil) then begin
    if UserMagic.Def.wMagicId = 6 then
      nCount := 1
    else
      nCount := 5;

    nType := 2;
    if CheckAmulet(nType, nCount, nAmuletIdx) or CheckBagAmulet(nType, nCount, nAmuletIdx) then begin
      if nAmuletIdx < 0 then begin // 不需要毒，根据怪物中毒类型自动选择不同的下毒类型
        if Actor.m_nState and $80000000 = 0 then begin
          Result := True;
        end
        else if Actor.m_nState and $40000000 = 0 then begin
          Result := False;
        end
        else begin
          Result := True;
        end;
      end
      else if (nAmuletIdx >= 0) and (nAmuletIdx < Length(g_UseItems)) then begin
        case nType of
          1:begin
              Result := True;
            end;
          2:begin
              Result := False;
            end;
        end;
      end
      else begin
        if Actor.m_nState and $80000000 = 0 then
          nType := 1
        else if Actor.m_nState and $40000000 = 0 then
          nType := 2
        else
          nType := 1;

        if CheckBagAmulet(nType, nCount, nAmuletIdx, True) then begin
          if (nAmuletIdx - Length(g_UseItems) >= 0) and (nAmuletIdx - Length(g_UseItems) < GetMaxBagCount) then begin
            case nType of
              1:begin
                  Result := True;
                end;
              2:begin
                  Result := False;
                end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

function TfrmMain.UseMagic(tx, ty:Integer; pcm:PTClientMagic; IsFromActionKey:Boolean):Boolean;
  procedure CleanMagicIDByFormActionKey;
  begin
      if IsFromActionKey then begin
          WaitUseActionKeyMagicID := 0;
          ExcludeWaitUseActionKeyMagicID := 0;
      end;
  end;
var
  tdir, targx, targy:Integer;
  targid:Int64;
  pmag:PTUseMagicInfo;
  Feature:TFeature;
  MagicTarget:TActor;
  boMagicLock:Boolean;
  nSpellPoint:Integer;
  CustomMagicConfig:PClientCustomMagicConfig;
  ClientMagic:PTClientMagic;
  nTempX, nTempY:Integer;
  IsCheckSpellPoint:Boolean;
  IsDoExit:Boolean;
  I:Integer;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode_M.inc}
  {$IFEND}
  Result := False;
  if pcm = nil then
    Exit;

  // 魔法攻击自动下马 chongchong 2013-10-19
  if g_ConfigDlg.ConfigCheckeds[ckAutoDownHorse] then begin
    if g_MySelf.m_btHorse <> 0 then
      g_MySelf.TakeHorse;
  end;

  // 使用道法使用合击技能时，快速按F1使用灵魂火符，会卡技能 chongchong 2015-09-14
  if (g_MySelf.m_boUseMagic and (g_MySelf.m_CurMagic.EffectNumber > 0)) then begin
    //DScreen.AddChatBoardString('usemagic exit', clRed, clBlack);
    // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
    if IsFromActionKey then begin
      WaitUseActionKeyMagicID := 0;
      ExcludeWaitUseActionKeyMagicID := 0;
    end;
    Exit;
  end;

  IsDoExit := False;

  // 修复剩余蓝与技能消耗蓝相同时，游戏中提示没有足够的魔法点数 chongchong 2014-06-25
  // 扣蓝算法来自服务器 TBaseObject.GetSpellPoint
  // nSpellPoint := pcm.Def.wSpell + pcm.Def.btDefSpell;
  nSpellPoint := Round(pcm.Def.wSpell / (pcm.Def.btTrainLv + 1) * (pcm.Level + 1)) + pcm.Def.wDefSpell;

  CustomMagicConfig := nil;
  IsCheckSpellPoint := (Cardinal(nSpellPoint) <= g_MySelf.m_Abil.MP); //HZQ
  if CheckIsCustomMagic(pcm.Def.wMagicId) then begin
    CustomMagicConfig := GetCustomMagicConfig(pcm.Def.wMagicId);
    if (CustomMagicConfig <> nil) then begin
      if CustomMagicConfig.IsAttackUseNG then begin
        IsCheckSpellPoint := g_MySelf.m_boTrainingNG and (nSpellPoint <= g_MySelf.m_AbilNG.NH);

        if not IsCheckSpellPoint and IsFromActionKey then begin
          if g_ClientConfig.boUpLevelMsgXRightToLeft then
            nTempX := SCREENWIDTH - g_ClientConfig.nUpLevelMsgX
          else
            nTempX := g_ClientConfig.nUpLevelMsgX;

          if g_ClientConfig.boUpLevelMsgYBottomToTop then
            nTempY := SCREENHEIGHT - g_ClientConfig.nUpLevelMsgY
          else
            nTempY := g_ClientConfig.nUpLevelMsgY;

          DScreen.AddSysMsg(g_ClientConfig.sNotEnoughNGPoint, g_ClientConfig.btUpLevelMsgFColor, g_ClientConfig.btUpLevelMsgBColor, nTempX, nTempY);

          IsDoExit := True;
        end;
      end;
    end else begin
      DScreen.AddChatBoardString(Format(DecodeResStr(SCustomMagicNoConfig), [pcm.Def.wMagicId]), clWhite, clRed);
      IsDoExit := True;
    end;
  end;

  if IsDoExit then
    Exit;

  if IsCheckSpellPoint or IsInContinuous{g_boContinuous} or (pcm.Def.btEffectType = 0) then begin
    if pcm.Def.btEffectType = 0 then begin
      // DScreen.AddChatBoardString(' wMagicId:' + IntToStr(pcm.Def.wMagicId), clGreen, clWhite);
      if pcm.Def.wMagicId = 26 then begin
        // 烈火剑法时间未到提示 chongchong 2014-04-23
        //ClientMagic := FindMagic(pcm.Def.wMagicId);  //HZQ 20230520 没有使用所以注释掉

        if (MyGetTickCount - g_dwLatestFireHitTick < Cardinal(g_nFireHitDelayTime))
          or (not g_WarrContinueHitManager.CanOpenMagic(26)) then begin
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;
      end;

      if pcm.Def.wMagicId = 27 then begin
        if (MyGetTickCount - g_dwLatestRushRushTick < 1 * 1000) or (not g_WarrContinueHitManager.CanOpenMagic(27)) then begin
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;
      end;

      // 逐日剑法
      if pcm.Def.wMagicId = 56 then begin
        ClientMagic := FindMagic(pcm.Def.wMagicId);
        if (ClientMagic <> nil) and (MyGetTickCount - ClientMagic.dwLastUseTick <= ClientMagic.dwInterval) then begin
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;

        if (MyGetTickCount - g_dwLatestSwordHitTick < Cardinal(g_nSwordHitDelayTime))
          or (not g_WarrContinueHitManager.CanOpenMagic(56)) then begin
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;
      end;

      if pcm.Def.wMagicId = 66 then begin // 开天斩
        ClientMagic := FindMagic(pcm.Def.wMagicId);
        if (ClientMagic <> nil) and (MyGetTickCount - ClientMagic.dwLastUseTick <= ClientMagic.dwInterval) then begin
          //OutputDebugString('aaa');
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;

        if (MyGetTickCount - g_dwLatest66HitTick <= Cardinal(g_nKTZHitDelayTime))
          or (not g_WarrContinueHitManager.CanOpenMagic(66)) then begin
          //OutputDebugString('bbb');
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;
      end;

      // 断空斩
      if pcm.Def.wMagicId = 113 then begin
        ClientMagic := FindMagic(pcm.Def.wMagicId);
        if (ClientMagic <> nil) and (MyGetTickCount - ClientMagic.dwLastUseTick <= ClientMagic.dwInterval) then begin
          //OutputDebugString('aaa');
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;

        if (MyGetTickCount - g_dwLatest113HitTick <= Cardinal(g_nDKZHitDelayTime))
          or (not g_WarrContinueHitManager.CanOpenMagic(113)) then begin
          //OutputDebugString('bbb');
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;
      end;

      // 血魄一击
