procedure TfrmMain.CheckInBossList(Actor:TActor; nX, nY:Integer);
var
  nDir:Integer;
  PtS:TPoint;
  IsCheckInBossList, IsInBossList:Boolean;
begin
  { TODO -opiaoyun -c修改 : BOSS聊天框提示 【2013-08-04】 }
  IsCheckInBossList := False;

  if g_ConfigDlg.ConfigCheckeds[ckNearHint] then begin
    if (Actor <> nil) and (((Actor.m_btRace > RC_PLAYOBJECT) and (Actor.m_btRealRace <> 55) and (not (Actor.m_btRealRace in [RC_GUARD, 12, RC_ARCHERGUARD, RC_MOVE_ARCHERGUARD]))) or ((Actor.m_btRace = RC_PLAYOBJECT) and Actor.m_boPlayMoster)) then begin
      IsInBossList := False;
      if not IsCheckInBossList then begin
        IsInBossList := g_BossList.IndexOf(Actor.m_sUserName) >= 0;
        IsCheckInBossList := True;
      end;

      // 加对象的名字(带数字) chongchong 2015-09-06
      //if g_BossList.IndexOf(Actor.m_sUserName) >= 0 then

      if IsInBossList then begin
        PtS.X := g_MySelf.m_nCurrX;
        PtS.Y := g_MySelf.m_nCurrY;

        if nX < PtS.X then begin
          if nY < PtS.Y then
            nDir := DR_UPLEFT
          else if nY = PtS.Y then
            nDir := DR_LEFT
          else
            nDir := DR_DOWNLEFT;
        end
        else if nX = PtS.X then begin
          if nY < PtS.Y then
            nDir := DR_UP
          else
            nDir := DR_DOWN
        end
        else begin
          if nY < PtS.Y then
            nDir := DR_UPRIGHT
          else if nY = PtS.Y then
            nDir := DR_RIGHT
          else
            nDir := DR_DOWNRIGHT;
        end;

        DScreen.AddChatBoardString(Format('发现[%s],方位:%s,坐标:(%d,%d)', [Actor.m_sUserName, DirsStr[nDir], nX, nY]), clRed, clWhite);
      end;
    end;
  end;

  // 自动锁定BOSS piaoyun 2013-09-09
  if g_ConfigDlg.ConfigCheckeds[ckAutoLock] then begin
    if (Actor <> nil) and (Actor.m_btRace > RC_PLAYOBJECT) and (Actor.m_btRealRace <> 55) and (not (Actor.m_btRealRace in [RC_GUARD, 12, RC_ARCHERGUARD, RC_MOVE_ARCHERGUARD])) then begin
      // 加对象的名字(带数字) chongchong 2015-09-06
      //if g_BossList.IndexOf(Actor.m_sUserName) >= 0 then

      if not IsCheckInBossList then begin
        IsInBossList := g_BossList.IndexOf(Actor.m_sUserName) >= 0;
        IsCheckInBossList := True;

        if IsInBossList then begin
          g_MagicLockActor := Actor;
        end;
      end;

      { //HZQ 20230524 移动到上面的if中执行
      if IsInBossList then begin
        g_MagicLockActor := Actor;
      end;
      }
    end;
  end;

  // BOSS变色 piaoyun 2013-09-09
  if g_ConfigDlg.ConfigCheckeds[ckColorShow] then begin
    if (Actor <> nil) and (Actor.m_btRace > RC_PLAYOBJECT) and (Actor.m_btRealRace <> 55)
      and (not (Actor.m_btRealRace in [RC_GUARD, 12, RC_ARCHERGUARD, RC_MOVE_ARCHERGUARD])) then begin
      // 加对象的名字(带数字) chongchong 2015-09-06
      //if g_BossList.IndexOf(Actor.m_sUserName) >= 0 then

      if not IsCheckInBossList then begin
        IsInBossList := g_BossList.IndexOf(Actor.m_sUserName) >= 0;
        //IsCheckInBossList := True;
        if IsInBossList then Actor.m_boChangeEff := True;
      end;
      //if IsInBossList then Actor.m_boChangeEff := True; //HZQ移动到上面的IF中
    end;
  end;
end;

