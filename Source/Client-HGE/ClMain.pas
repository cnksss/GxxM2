    if (g_EatingItem.s.Name <> '') and (g_EatingItem.MakeIndex = nMakeIndex) then begin
      Move(sData[1], g_EatingItem.CustomProperty.Properties[btPropertyIndex], Length(sData));
      Exit;
    end;
  end
  else begin
    if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then begin
      if (g_HeroUseItems[nWhere].S.Name <> '') and (g_HeroUseItems[nWhere].MakeIndex = nMakeIndex) then begin
        Move(sData[1], g_HeroUseItems[nWhere].CustomProperty.Properties[btPropertyIndex], Length(sData));
        Exit;
      end;
    end
    else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then begin
      if (g_HeroJewelryBoxItems[nWhere - U_JEWELRYITEM1].S.Name <> '') and (g_HeroJewelryBoxItems[nWhere - U_JEWELRYITEM1].MakeIndex = nMakeIndex) then begin
        Move(sData[1], g_HeroJewelryBoxItems[nWhere - U_JEWELRYITEM1].CustomProperty.Properties[btPropertyIndex], Length(sData));
        Exit;
      end;
    end
    else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then begin
      if (g_HeroGodBlessItems[nWhere - U_GODBLESSITEM1].S.Name <> '') and (g_HeroGodBlessItems[nWhere - U_GODBLESSITEM1].MakeIndex = nMakeIndex) then begin
        Move(sData[1], g_HeroGodBlessItems[nWhere - U_GODBLESSITEM1].CustomProperty.Properties[btPropertyIndex], Length(sData));
        Exit;
      end;
    end;

    for I := Low(g_HeroItemArr) to High(g_HeroItemArr) do begin
      if (g_HeroItemArr[I].MakeIndex = nMakeIndex) and (Length(g_HeroItemArr[I].S.Name) <> 0) then begin
        Move(sData[1], g_HeroItemArr[I].CustomProperty.Properties[btPropertyIndex], Length(sData));
        Exit;
      end;
    end;

    for I := 0 to g_HeroFengHaoItems.Count - 1 do begin
      Item := g_HeroFengHaoItems.Items[I];
      if (Item.MakeIndex = nMakeIndex) and (Length(Item.S.Name) <> 0) then begin
        Move(sData[1], Item.CustomProperty.Properties[btPropertyIndex], Length(sData));
        Exit;
      end;
    end;

    if (g_HeroEatingItem.s.Name <> '') and (g_HeroEatingItem.MakeIndex = nMakeIndex) then begin
      Move(sData[1], g_HeroEatingItem.CustomProperty.Properties[btPropertyIndex], Length(sData));
      Exit;
    end;
  end;
end;

