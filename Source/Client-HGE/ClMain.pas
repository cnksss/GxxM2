        //BeginThread(nil, 0, @LoadDllAndInit, nil, 0, ThreadID);
        ThreadHandle := BeginThread(nil, 0, @LoadDllAndInit, nil, 0, ThreadID); //HZQ 20230524
        if (ThreadHandle <> 0) and (ThreadHandle <> INVALID_HANDLE_VALUE then begin
            CloseHandle(ThreadHandle);
        end;
      end;
    end;
  end;
  {$IFEND}

  {$IF AntiPlugInMemory = 1}
