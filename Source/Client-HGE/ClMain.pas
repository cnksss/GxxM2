procedure TCheckBlackProcessMD5Thread.DoRun;
var
  sMD5:string;
  H, H2:THandle;
  ExePath:string;
  IsFound:Boolean;
  PE:TProcessEntry32; //结构类型的变量
  Buf:array[0..MAX_PATH] of Char;
  nMD5:MD5Digest;
  hPSAPI:THandle;
  GetProcessImageFileNameA:function(hProcess:THANDLE; lpImageFileName:LPSTR; nSize:DWORD):DWORD; stdcall;
begin
  @GetProcessImageFileNameA := nil;

  hPSAPI := LoadLibrary('PSAPI.dll');
  if hPSAPI >= 32 then
    @GetProcessImageFileNameA := GetProcAddress(hPSAPI, 'GetProcessImageFileNameA');

  H := CreateToolhelp32Snapshot(TH32CS_SNAPALL, 0);
  PE.dwSize := SizeOf(TProcessEntry32);
  IsFound := Process32First(H, PE);
  SetLength(sMD5, SizeOf(nMD5));
  while IsFound do begin
    ExePath := '';
    if PE.th32ProcessID > 0 then begin
      H2 := OpenProcess(PROCESS_QUERY_INFORMATION or PROCESS_VM_READ, False, PE.th32ProcessID);
      if H2 > 0 then begin
        if (@GetProcessImageFileNameA <> nil) then begin
          if GetProcessImageFileNameA(H2, Buf, MAX_PATH) <> 0 then begin
            ExePath := DevicePathToWin32Path(StrPas(Buf));
          end;
        end
        else begin
          if (GetModuleFileNameEx(H2, 0, Buf, Length(Buf))) > 0 then begin
            ExePath := StrPas(Buf);
          end;
        end;

        CloseHandle(H2);
      end;
    end;

    if Length(ExePath) > 0 then begin
      nMD5 := MD5File(ExePath);
      Move(nMD5, sMD5[1], SizeOf(nMD5));

      if g_ProcessBlackList.IndexOf(sMD5) >= 0 then begin
        //OutputDebugString(PChar(MD5Print(nMD5)));
        Synchronize(DoStop);
        Exit;
      end;
    end;

    IsFound := Process32Next(H, PE);
  end;
end;

procedure TCheckBlackProcessMD5Thread.DoStop;
begin
  FrmMain.SpeedHackTimer.Enabled := False;
  FrmMain.SendDelayMsg(g_MySelf, RCM_FINDPROCESS, 0, 0, 0, 0, '', 2000);
end;

