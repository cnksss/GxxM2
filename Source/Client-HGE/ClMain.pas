procedure TfrmMain.ProcessMessageEatFail(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  IsChangeWeight, NewWeight:Byte;
begin
  if DefMsg.Recog = g_EatingItem.MakeIndex then begin
    g_EatingItem.Dura := DefMsg.Param;
    g_EatingItem.DuraMax := DefMsg.Tag;

    IsChangeWeight := LoByte(DefMsg.Series);
    NewWeight := HiByte(DefMsg.Series);

    if IsChangeWeight = 1 then begin
      g_EatingItem.s.Weight := NewWeight;
    end;
  end;
  if g_EatingItem.MakeIndex = g_nUnPakItemMakeIndex then begin
    g_nUnPakItemMakeIndex := 0;
    SendDelayMsg(g_MySelf, RCM_UNBINDITEM, 0, 0, 0, 0, g_EatingItem.s.Name, 1000);
    // DScreen.AddChatBoardString('ProcessMessageEatFail False' + g_EatingItem.s.Name, clWhite, clRed);
  end;
  AddItemBag(g_EatingItem);

  g_EatingItem.S.Name := '';
  g_EatingItemIndex := -1;
end;

