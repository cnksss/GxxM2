    for I := 0 to g_SellPlayerContinuousMagicList.Count - 1 do begin
      Dispose(PTClientMagic(g_SellPlayerContinuousMagicList.Items[I]));
    end;
    g_SellPlayerContinuousMagicList.Clear;
  finally
    g_SellPlayerContinuousMagicList.UnLock;
  end;

  FrmDlg.ClearSellPlayerOtherInfo;

  if DefMsg.Param = Length(sData) then begin
    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));

    Buffer := @OutBuf;
    for I := 0 to DefMsg.Series - 1 do begin
      New(pcm);
      Move(Buffer^, pcm^, SizeOf(TClientMagic));
      Buffer := Pointer(Integer(Buffer) + SizeOf(TClientMagic));
      case pcm.Def.MagicAttr of
        mtHum:begin
            g_SellPlayerMagicList.Lock;
