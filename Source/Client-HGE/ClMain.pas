            {$IFEND}

            g_boNextTimeCustomMagicList.Delete(Index);
          end;
        end;
      end;
  end;
end;

function _CheckAmulet(var nShape:Integer; nCount:Integer; var Idx:Integer; boEqual:Boolean = False):Boolean;
begin
  Result := False;
  Idx := -1;

  if g_UseItems[U_ARMRINGL].S.Name <> '' then begin
    if (g_UseItems[U_ARMRINGL].S.StdMode = 25) then begin
      case nShape of
        5:begin // 符咒
            if (g_UseItems[U_ARMRINGL].S.Shape = nShape) and (Round(g_UseItems[U_ARMRINGL].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
              Idx := U_ARMRINGL;
              Result := True;
              Exit;
            end;
          end;
        1, 2:begin // 毒
            if boEqual then begin
              if (g_UseItems[U_ARMRINGL].S.Shape = nShape) and (Round(g_UseItems[U_ARMRINGL].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                Idx := U_ARMRINGL;
                Result := True;
                Exit;
              end;
            end
            else if (g_UseItems[U_ARMRINGL].S.Shape in [1, 2]) and (Round(g_UseItems[U_ARMRINGL].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
              nShape := g_UseItems[U_ARMRINGL].S.Shape;
              Idx := U_ARMRINGL;
              Result := True;
              Exit;
            end;
          end;
      end;
    end;
  end;

  if g_UseItems[U_BUJUK].S.Name <> '' then begin
    if (g_UseItems[U_BUJUK].S.StdMode = 25) then begin
      case nShape of
        5:begin
            if (g_UseItems[U_BUJUK].S.Shape = nShape) and (Round(g_UseItems[U_BUJUK].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
              Idx := U_BUJUK;
              Result := True;
              Exit;
            end;
          end;
        1, 2:begin // 毒
            if boEqual then begin
              if (g_UseItems[U_BUJUK].S.Shape = nShape) and (Round(g_UseItems[U_BUJUK].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                Idx := U_BUJUK;
                Result := True;
                Exit;
              end;
            end
            else if (g_UseItems[U_BUJUK].S.Shape in [1, 2]) and (Round(g_UseItems[U_BUJUK].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
              Idx := U_BUJUK;
              nShape := g_UseItems[U_BUJUK].S.Shape;
              Result := True;
              Exit;
            end;
          end;
      end;
    end;
  end;
end;

function _CheckBagAmulet(var nShape:Integer; nCount:Integer; var Idx:Integer; boEqual:Boolean = False):Boolean;
begin
  Result := False;
  Idx := -1;

  if boEqual then begin
    Idx := GetUserItemListEx(nShape, nCount);
    if Idx < 0 then begin
      Idx := GetUserItemList(nShape, nCount);
      boEqual := False;
    end;
  end
  else begin
    Idx := GetUserItemList(nShape, nCount);
  end;

  if (Idx >= 0) and (Idx < GetMaxBagCount) then begin
    if (g_ItemArr[Idx].S.Name <> '') then begin
      if (g_ItemArr[Idx].S.StdMode = 25) then begin
        case nShape of
          5:begin
              if (g_ItemArr[Idx].S.Shape = nShape) and (Round(g_ItemArr[Idx].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                Inc(Idx, 13);
                Result := True;
                Exit;
              end;
            end;
          1, 2:begin
              if boEqual then begin
                if (g_ItemArr[Idx].S.Shape = nShape) and (Round(g_ItemArr[Idx].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                  Inc(Idx, 13);
                  nShape := g_ItemArr[Idx].S.Shape;
                  Result := True;
                  Exit;
                end;
              end
              else begin
                if (g_ItemArr[Idx].S.Shape in [1, 2]) and (Round(g_ItemArr[Idx].Dura / g_ClientConfig.nMagicItemRate) >= nCount) then begin
                  Inc(Idx, 13);
                  nShape := g_ItemArr[Idx].S.Shape;
                  Result := True;
                  Exit;
                end;
              end;
            end;
        end;
      end;
    end;
  end;
end;

function TfrmMain.CheckCustomMagicNeedItem(MagicID:Word):Boolean;
var
  nShape:Integer;
  I, ItemIndex:Integer;
  CustomMagicConfig:PClientCustomMagicConfig;
begin
  Result := False;
  CustomMagicConfig := GetCustomMagicConfig(MagicID);
  if CustomMagicConfig = nil then
    Exit;

  if CustomMagicConfig.NeedItemCount <= 0 then begin
    Result := True;
    Exit;
  end;

  if CustomMagicConfig.MagicBaseConfig.MagicSwitchMode = msmSwitch then begin
    Result := True;
    Exit;
  end;

  case CustomMagicConfig.NeedItem of
    meiNone:
      Result := True;
    meiRedPoison:begin
        nShape := 2;

        if _CheckAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True) then
          Result := True;

        if (not Result) and CustomMagicConfig.NeedItemUseBagItem then
          Result := _CheckBagAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True)
        else

      end;
    meiGreenPoison:begin
        nShape := 1;

        if _CheckAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True) then
          Result := True;

        if (not Result) and CustomMagicConfig.NeedItemUseBagItem then
          Result := _CheckBagAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True);
      end;
    {
    meiRedOrGreenPoison:
      begin
        nShape := 1;
        if _CheckAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, False) then
          Result := True
        else if CustomMagicConfig.NeedItemUseBagItem then
          Result := _CheckBagAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, False);
      end;
    }
    meiFu:begin
        nShape := 5;
        if _CheckAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, False) then
          Result := True;

        if (not Result) and CustomMagicConfig.NeedItemUseBagItem then
          Result := _CheckBagAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, False);
      end;
    {
    meiRedPoisonAndFu:
      begin
        nShape := 2;
        if _CheckAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True) then
          Result := True
        else if CustomMagicConfig.NeedItemUseBagItem then
          Result := _CheckBagAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True);

        if Result then
        begin
          nShape := 5;
          if _CheckAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True) then
            Result := True
          else if CustomMagicConfig.NeedItemUseBagItem then
            Result := _CheckBagAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True);
        end;
      end;
    meiGreenPoisonAndFu:
      begin
        nShape := 1;
        if _CheckAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True) then
          Result := True
        else if CustomMagicConfig.NeedItemUseBagItem then
          Result := _CheckBagAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True);

        if Result then
        begin
          nShape := 5;
          if _CheckAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True) then
            Result := True
          else if CustomMagicConfig.NeedItemUseBagItem then
            Result := _CheckBagAmulet(nShape, CustomMagicConfig.NeedItemCount, ItemIndex, True);
        end;
      end;
    }
    meiCustomItem:begin
        if Length(CustomMagicConfig.NeedItemCustomItemName) = 0 then
          Result := True
        else begin
          for I := 0 to Length(g_UseItems) - 1 do begin
            if SameText(g_UseItems[I].S.Name, CustomMagicConfig.NeedItemCustomItemName) and (Round(g_UseItems[I].Dura / g_ClientConfig.nMagicItemRate) >= CustomMagicConfig.NeedItemCount) then begin
              Result := True;
              Break;
            end;
          end;

          if (not Result) and CustomMagicConfig.NeedItemUseBagItem then begin
            for I := 0 to GetMaxBagCount - 1 do begin
              if SameText(g_ItemArr[I].S.Name, CustomMagicConfig.NeedItemCustomItemName) and (Round(g_ItemArr[I].Dura / g_ClientConfig.nMagicItemRate) >= CustomMagicConfig.NeedItemCount) then begin
                Result := True;
                Break;
              end;
            end;
          end;
        end;
      end;
  end;
end;

function TfrmMain.SearchHitMsg(tdir:Integer; Actor:TActor):Integer;
var
  I, II, III, nIndex:Integer;
  nX, nY:Integer;
  Index1, Index2:Integer;
  MagicID:Word;
  CustomMagicConfig:PClientCustomMagicConfig;
  sMsg:string;
  ClientMagic:PTClientMagic;
  AutoHitMagic:array of Word;
  PlugData:TAntiPlugNotifyEventSpellData;
  nSpellPoint:Integer;
  IsOK:Boolean;
  CustomMagiID:Integer;
  MagicWarrNGOption:TMagicWarrNGOption;
  boFound:Boolean;
begin
  // ★★★★★★修正延时使用快捷键技能(F1灵魂火符)时，2次举手 chongchong 2018-06-12 11:48:16
  Result := CM_HIT;

  if g_boContinuous {IsInContinuous} then begin // 连击
    // 修复魔道连击移动中断后不能继续释放 chongchong 2015-05-04
    // 原代码：Result := StartContinuousAttack

    if g_MySelf.m_btJob = 0 then begin
      Result := StartContinuousAttack; // 连击 战士连击
    end else begin
      StartContinuousMagicAttack;
    end;

    Exit;
  end;

  // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
  if (WaitUseActionKeyMagicID > 0) then begin
    if (tick_diff(WaitUseActionKeyMagicTick, MyGetTickCount) <= 2000) then begin
      if CanUseMagic then begin
        ClientMagic := FindMagic(WaitUseActionKeyMagicID);

        if (ClientMagic = nil) then begin
          WaitUseActionKeyMagicID := 0;
        end
        else begin
          if g_MagicLockActor <> nil then begin
            {$IF TESTMODE = 1}
            //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~使用延时~~技能.' + IntToStr(WaitUseActionKeyMagicID), clRed, clBlack);
            {$IFEND}

            if UseMagic(g_MagicLockActor.m_nCurrX, g_MagicLockActor.m_nCurrY, ClientMagic, False) then begin
              WaitUseActionKeyMagicID := 0;

              if Assigned(g_AntiPlugNotifyFunc) then begin
                PlugData.nX := g_MagicLockActor.m_nCurrX;
                PlugData.nY := g_MagicLockActor.m_nCurrY;
                PlugData.nMagicID := WaitUseActionKeyMagicID;

                g_AntiPlugNotifyFunc(event_Spell, @PlugData, SizeOf(PlugData));
              end;

              Exit;
            end;
          end
          else if g_MagicTarget <> nil then begin
            {$IF TESTMODE = 1}
            //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~使用延时~~技能.' + IntToStr(WaitUseActionKeyMagicID), clRed, clBlack);
            {$IFEND}

            if UseMagic(g_MagicTarget.m_nCurrX, g_MagicTarget.m_nCurrY, ClientMagic, False) then begin
              WaitUseActionKeyMagicID := 0;
              ExcludeWaitUseActionKeyMagicID := 0;

              if Assigned(g_AntiPlugNotifyFunc) then begin
                PlugData.nX := g_MagicLockActor.m_nCurrX;
                PlugData.nY := g_MagicLockActor.m_nCurrY;
                PlugData.nMagicID := WaitUseActionKeyMagicID;

                g_AntiPlugNotifyFunc(event_Spell, @PlugData, SizeOf(PlugData));
              end;

              Exit;
            end;
          end
          else begin
            {$IF TESTMODE = 1}
            //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~使用延时~~技能.' + IntToStr(WaitUseActionKeyMagicID), clRed, clBlack);
            {$IFEND}

            if UseMagic(g_nMouseX, g_nMouseY, ClientMagic, False) then begin
              WaitUseActionKeyMagicID := 0;
              ExcludeWaitUseActionKeyMagicID := 0;

              if Assigned(g_AntiPlugNotifyFunc) then begin
                PlugData.nX := g_nMouseX;
                PlugData.nY := g_nMouseY;
                PlugData.nMagicID := WaitUseActionKeyMagicID;

                g_AntiPlugNotifyFunc(event_Spell, @PlugData, SizeOf(PlugData));
              end;

              Exit;
            end;
          end;
        end;
      end;
    end
    else begin
      WaitUseActionKeyMagicID := 0;
      ExcludeWaitUseActionKeyMagicID := 0;
    end;
  end;

  // Result := CM_43HIT;
  // Exit;
  Result := CM_HIT;

  SetLength(AutoHitMagic, 6);
  AutoHitMagic[0] := 26; // 烈火剑法
  AutoHitMagic[1] := 56; // 逐日
  AutoHitMagic[2] := 66; // 开天
  AutoHitMagic[3] := 42; // 龙影
  AutoHitMagic[4] := 43; // 雷霆剑法
  AutoHitMagic[5] := 40; // 双龙斩/抱月技能
  // 刺杀不绑定内挂，一直开启时，DB半月用不了 2020-06-09
  if (not PlugInEnabled) or (not g_ClientConfig.boSmartWideHit) or (not g_ConfigDlg.ConfigCheckeds[ckSmartWideHit]) then begin
    SetLength(AutoHitMagic, 7);
    AutoHitMagic[6] := 25; // 双龙斩/抱月技能
  end;

  // 自定义技能是手动释放的方式，优化选择，不然使用的几率会低 chongchong 2017-11-30
  if Actor <> nil then begin
    for I := 0 to g_boNextTimeCustomMagicList.Count - 1 do begin
      nIndex := Integer(g_boNextTimeCustomMagicList.Items[I]);

      CustomMagicConfig := GetCustomMagicConfig(CUSTOM_MAGIC_START_ID + nIndex);
      if (CustomMagicConfig <> nil) and CustomMagicConfig.boIsMagicWarr and TargetInCustomAttackRange(tdir, Actor, CustomMagicConfig.btNearAttackRange) and g_WarrContinueHitManager.CanUseMagic(CUSTOM_MAGIC_START_ID + nIndex) then begin
        //if CustomMagicConfig.IsAttackUseNG
        if not CheckCustomMagicNeedItem(CUSTOM_MAGIC_START_ID + nIndex) then begin
          if MyGetTickCount - CustomMagicLastHitMsgTime >= 5000 then begin
            CustomMagicLastHitMsgTime := MyGetTickCount;
            if CustomMagicConfig.NeedItem in [meiRedPoison, meiGreenPoison, meiFu] then begin
              if CustomMagicConfig.NeedItem = meiRedPoison then
                sMsg := '黄色药粉已经用完，请及时补充'
              else if CustomMagicConfig.NeedItem = meiGreenPoison then
                sMsg := '灰色药粉已经用完，请及时补充'
              else
                sMsg := '护身符已经用完，请及时补充';
              DScreen.AddSysMsg(sMsg, 222, 0, 30, 360);
            end else if CustomMagicConfig.NeedItem = meiCustomItem then begin
              sMsg := CustomMagicConfig.NeedItemCustomItemName;
              DScreen.AddChatBoardString('没有技能需要的物品[' + sMsg + ']或物品数量不够.', clWhite, clRed);
            end;
          end;

          Continue;
        end;

        ClientMagic := FindMagic(CUSTOM_MAGIC_START_ID + nIndex);
        if ClientMagic <> nil then begin
          nSpellPoint := Round(ClientMagic.Def.wSpell / (ClientMagic.Def.btTrainLv + 1) * (ClientMagic.Level + 1)) + ClientMagic.Def.wDefSpell;

          if CustomMagicConfig.IsAttackUseNG then
            IsOK := g_MySelf.m_boTrainingNG and (nSpellPoint <= g_MySelf.m_AbilNG.NH)
          else
            IsOK := (Cardinal(nSpellPoint) <= g_MySelf.m_Abil.MP); // 2020-08-14 12:37:23
          // 2019-11-25
          if IsOK and (MyGetTickCount - ClientMagic.dwLastUseTick >= ClientMagic.dwRealInterval) then begin
            SetLength(AutoHitMagic, Length(AutoHitMagic) + 1);
            AutoHitMagic[Length(AutoHitMagic) - 1] := CM_CUSTOM_HIT001 + nIndex
          end;
        end;
      end;
    end;
  end;

  if g_boNextTime60Hit then begin
    Result := CM_60HIT; // 破魂
    Exit;
  end;

  Randomize();
  for I := 0 to Length(AutoHitMagic) do begin
    Index1 := Random(Length(AutoHitMagic));
    Index2 := Random(Length(AutoHitMagic));

    if Index1 <> Index2 then begin
      MagicID := AutoHitMagic[Index1];
      AutoHitMagic[Index1] := AutoHitMagic[Index2];
      AutoHitMagic[Index2] := MagicID;
    end;
  end;

  // 移动这里，不然开了自动半月/开天，又有几个怪在一起，自动半月和开天可以不停使用时，自定义技能释放不了 2020-05-17 21:50:21
  // 优先使用能关闭的技能, 如果先用永不关闭的技能话，手动释放能关闭的技能就没有什么机会能使用了 2020-05-12 01:12:27
  for I := Low(AutoHitMagic) to High(AutoHitMagic) do begin
    MagicID := AutoHitMagic[I];
    // 手动按的技能也要使用 2020-05-11
    if (MagicID >= CM_CUSTOM_HIT001) and (MagicID < CM_CUSTOM_HIT001 + CUSTOM_MAGIC_COUNT) then begin
      boFound := False;

      // 排除掉绑定的些技能 比如，绑定刺杀，又只勾选了隔位刺杀。前面就用不了。到了这里反而能用
      // 上面的情况在这里就不对 2020-05-11 23:06:22

      for MagicWarrNGOption := mngoWideHit to High(TMagicWarrNGOption) do begin
        for II := 0 to Length(g_AutoCustomMagic[MagicWarrNGOption]) - 1 do begin
          if g_AutoCustomMagic[MagicWarrNGOption][II] = MagicID - CM_CUSTOM_HIT001 + CUSTOM_MAGIC_START_ID then begin
            boFound := True;
            Break;
          end;
        end;
      end;

      if not boFound then begin
        CustomMagicConfig := GetCustomMagicConfig(MagicID - CM_CUSTOM_HIT001 + CUSTOM_MAGIC_START_ID);
        if (CustomMagicConfig <> nil) and (not CustomMagicConfig.MagicBaseConfig.SwitchModeNoClose) then begin
          Result := MagicID;
          Exit;
        end;
      end;
    end;
  end;

  // 攻杀搞到前面 chongchong 2020-10-20
  if g_boNextTimePowerHit and (Actor <> nil) and TargetInSwordLongAttackRange(tdir, Actor, 1) then begin
    if Random(3) = 0 then begin
      ClientMagic := FindMagic(7);
      if ClientMagic <> nil then begin
        if MyGetTickCount - ClientMagic.dwLastUseTick >= ClientMagic.dwInterval then begin
          Result := CM_POWERHIT; // 攻杀
          Exit;
        end;
      end;
    end;
  end;

  // 不对应内挂选项时，如果存在多个技能开启后都不关闭，以最后一个开启的技能为准 2020-06-09 08:55:35
  for I := Low(AutoHitMagic) to High(AutoHitMagic) do begin
