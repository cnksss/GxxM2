procedure TFrmMain.DoThreadRun();
const
  ALL_OPEN_MAGIC_COUNT = 12;
  DEF_ALL_OPEN_MAGIC:array[0..ALL_OPEN_MAGIC_COUNT] of Integer = (26, // 烈火
    56, // 逐日
    66, // 开天
    42, // 龙影
    113, // 断空斩
    9991, // 自定义技能1
    9992, // 自定义技能2
    9993, // 自定义技能3
    9994, // 自定义技能4
    9995, // 自定义技能5
    9996, // 自定义技能6
    9997, // 自定义技能7
    9998 // 自定义技能8
    );
var
  keyvalue:TKeyBoardState;
  Shift:TShiftState;
  N, I, II, nX, nY:Integer;
  Magic:PTClientMagic;
  MDFMagic:PTClientMagic;
  MagicID:Integer;
  ArrAutoOpenHitMagic:array[0..ALL_OPEN_MAGIC_COUNT] of Integer;
  boFoundOpenHitMagic:Boolean;
  FoundOpenHitMagicIndex:Integer;
  tempTarget:TActor;
  CustomMagiID:Integer;
  CustomMagicConfig:PClientCustomMagicConfig;
  dwMoveIntervalTime:LongWord;
  IsOpenCustomMagic:Boolean;
  CustomMagicOption:TMagicWarrNGOption;
begin
  if (g_MySelf = nil) then
    Exit;

  if DScreen.CurrentScene = PlayScene then begin
    PlayScene.ProcessActors();
  end;

  //--------------------------------------------------------------------------------------------
  //非挂机状态， 15秒后结束挂机状态
  if (g_MySelf <> nil) and (g_boContinuous) and (not g_boGjRun) then begin
      if tick_diff(g_dwContinuousTick, MyGetTickCount) > 15000 then begin
	        DoFinishContinuous();
      end;
  end;

  if (g_MySelf <> nil) and (not g_MySelf.m_boDeath) and (not g_MySelf.m_boShopStall) {摆摊禁止移动} and (not IsInContinuous {g_boContinuous} {不在连击状态}) and (g_MySelf.m_nState and $04000000 = 0) {麻痹} and (g_MySelf.m_nState and $00080000 = 0) {冰冻} and PlugInEnabled then begin
    // 自动隐身
    if (not g_MySelf.m_boCobweb) {被蜘蛛网罩住禁止使用魔法} then begin
      if (g_ClientConfig.boAutoHideMode and g_ConfigDlg.ConfigCheckeds[ckAutoHideMode])
        and (g_MySelf.m_btJob = 2) and (not (g_MySelf.m_nState and $00800000 <> 0)) and CanUseMagic and CanNextAction(caSpell)
        and ServerAcceptNextAction(False) then begin
        // 修正内挂自动隐身，在跑的时候边跑边隐身 2020-03-23 17:31:01
        // +++ (TimeGetTime - g_dwLastMoveTick >= dwMoveIntervalTime + 400)
        dwMoveIntervalTime := g_ClientConfig.dwMoveFrameTime;
        if g_MySelf.m_nMoveSpeed <> 0 then
          dwMoveIntervalTime := Max(Integer(dwMoveIntervalTime) - (Integer(g_ClientConfig.dwIncMoveSpeedDecInterval) * g_MySelf.m_nMoveSpeed), 0);

        if (MyGetTickCount - g_dwAutoHideModeTick > 1000)
          and (TimeGetTime - g_dwLastMoveTick >= dwMoveIntervalTime + 400) then begin
          g_dwAutoHideModeTick := MyGetTickCount;

          g_MagicList.Lock;
          try
            for I := 0 to g_MagicList.Count - 1 do begin
              Magic := g_MagicList.Items[I];
              if (Magic.Def.wMagicId = 18) then begin
                if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                  PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
                  //AutoTakeOnItem(Magic); // 自动上毒/符
                  UseMagic(nX, nY, Magic);
                end;
                Break;
              end;
            end;
          finally
            g_MagicList.UnLock;
          end;
        end;
      end;

      // 自动魔法盾 改为选项适用于三职业 chongchong 2013-11-18
      if (not IsInContinuous{g_boContinuous}) and (g_ClientConfig.boHumAutoShield and g_ConfigDlg.ConfigCheckeds[ckHumAutoShield]) { and (g_MySelf.m_btJob = 1) } and CanUseMagic and CanNextAction(caSpell) and ServerAcceptNextAction(False) then begin
        if (MyGetTickCount - g_dwAutoHumShieldTick > 600) then begin
          g_dwAutoHumShieldTick := MyGetTickCount;
          MDFMagic := nil;
          g_MagicList.Lock;
          try
            for I := 0 to g_MagicList.Count - 1 do begin
              Magic := g_MagicList.Items[I];
              if Magic.Def.wMagicId in [31, 73, 87] then begin
                MDFMagic := Magic;
                Break;
              end;
            end;

            if MDFMagic <> nil then begin
              if (g_MySelf.m_nState and $00100000 = 0) then begin
                if (MDFMagic.Def.wSpell + MDFMagic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                  PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
                  UseMagic(nX, nY, MDFMagic);
                end;
              end;
            end
            else begin
              // 新武力盾
              for I := 0 to g_MagicList.Count - 1 do begin
                Magic := g_MagicList.Items[I];
                if Magic.Def.wMagicId = 88 then begin
                  MDFMagic := Magic;
                  Break;
                end;
              end;

              if MDFMagic <> nil then begin
                if (g_MySelf.m_nState and $00040000 = 0) then begin
                  if (MDFMagic.Def.wSpell + MDFMagic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                    PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
                    UseMagic(nX, nY, MDFMagic);
                  end;
                end;
              end
              else begin
                // 新道力盾
                for I := 0 to g_MagicList.Count - 1 do begin
                  Magic := g_MagicList.Items[I];
                  if Magic.Def.wMagicId = 89 then begin
                    MDFMagic := Magic;
                    Break;
                  end;
                end;

                if MDFMagic <> nil then begin
                  if (g_MySelf.m_nState and $00020000 = 0) then begin
                    if (MDFMagic.Def.wSpell + MDFMagic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                      PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
                      UseMagic(nX, nY, MDFMagic);
                    end;
                  end;
                end;
              end;
            end;
          finally
            g_MagicList.UnLock;
          end;
        end;
      end;

      if (((g_TargetCret <> nil) and (g_TargetCret.m_btRace <> 50)) or (g_ClientConfig.boAutoOpenSpell and g_ConfigDlg.ConfigCheckeds[ckAutoOpenSpell])) and CanNextAction(caHit) and ServerAcceptNextAction(False) and (g_MySelf.m_btJob = 0) then begin
        if FAutoOpenHitMagicIndex <= ALL_OPEN_MAGIC_COUNT then begin
          for II := Low(ArrAutoOpenHitMagic) to High(ArrAutoOpenHitMagic) do begin
            ArrAutoOpenHitMagic[II] := DEF_ALL_OPEN_MAGIC[(II + FAutoOpenHitMagicIndex) mod 13];
          end;
        end
        else begin
          for II := Low(ArrAutoOpenHitMagic) to High(ArrAutoOpenHitMagic) do begin
            ArrAutoOpenHitMagic[II] := DEF_ALL_OPEN_MAGIC[II];
          end;
        end;

        boFoundOpenHitMagic := False;
        FoundOpenHitMagicIndex := -1;

        for N := Low(ArrAutoOpenHitMagic) to High(ArrAutoOpenHitMagic) do begin
          MagicID := ArrAutoOpenHitMagic[N];
          IsOpenCustomMagic := False;

          case MagicID of
            9991:begin
                CustomMagicOption := mngoCustomHit1;
                IsOpenCustomMagic := g_ClientConfig.boSmartCustomHit1 and g_ConfigDlg.ConfigCheckeds[ckSmartCustomHit1];
              end;
            9992:begin
                CustomMagicOption := mngoCustomHit2;
                IsOpenCustomMagic := g_ClientConfig.boSmartCustomHit2 and g_ConfigDlg.ConfigCheckeds[ckSmartCustomHit2];
              end;
            9993:begin
                CustomMagicOption := mngoCustomHit3;
                IsOpenCustomMagic := g_ClientConfig.boSmartCustomHit3 and g_ConfigDlg.ConfigCheckeds[ckSmartCustomHit3];
              end;
            9994:begin
                CustomMagicOption := mngoCustomHit4;
                IsOpenCustomMagic := g_ClientConfig.boSmartCustomHit4 and g_ConfigDlg.ConfigCheckeds[ckSmartCustomHit4];
              end;
            9995:begin
                CustomMagicOption := mngoCustomHit5;
                IsOpenCustomMagic := g_ClientConfig.boSmartCustomHit5 and g_ConfigDlg.ConfigCheckeds[ckSmartCustomHit5];
              end;
            9996:begin
                CustomMagicOption := mngoCustomHit6;
                IsOpenCustomMagic := g_ClientConfig.boSmartCustomHit6 and g_ConfigDlg.ConfigCheckeds[ckSmartCustomHit6];
              end;
            9997:begin
                CustomMagicOption := mngoCustomHit7;
                IsOpenCustomMagic := g_ClientConfig.boSmartCustomHit7 and g_ConfigDlg.ConfigCheckeds[ckSmartCustomHit7];
              end;
            9998:begin
                CustomMagicOption := mngoCustomHit8;
                IsOpenCustomMagic := g_ClientConfig.boSmartCustomHit8 and g_ConfigDlg.ConfigCheckeds[ckSmartCustomHit8];
              end;
            else CustomMagicOption := mngoNone; //HZQ 保证有值
          end;

          if (MagicID = 26) and (g_ClientConfig.boSmartFireHit and g_ConfigDlg.ConfigCheckeds[ckSmartFireHit]) then begin
            // 自动烈火
            if (not g_boNextTimeFireHit) and g_WarrContinueHitManager.CanOpenMagic(26) then begin
              if (MyGetTickCount - g_dwLatestFireHitTick > Cardinal(g_nFireHitDelayTime))
                and (MyGetTickCount - g_dwLatestTryFireHitTick > Cardinal(g_nFireHitDelayTime div 3)) {and CanNextAction and ServerAcceptNextAction and CanNextHit} then begin
                g_MagicList.Lock;
                try
                  for I := 0 to g_MagicList.Count - 1 do begin
                    Magic := g_MagicList.Items[I];
                    if Magic.Def.wMagicId = 26 then begin
                      if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                        g_dwLatestTryFireHitTick := MyGetTickCount;
                        PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);

                        // 不能用 UseMagic，会被时间拦截 chongchong 2018-06-04
                        //UseMagic(nX, nY, Magic);
                        SendSpellMsg(CM_SPELL, 0, 0, Magic.Def.wMagicId, 0);

                        {$IF TESTMODE = 1}
                        //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~请求烈火开启.', clRed, clBlack);
                        {$IFEND}

                        boFoundOpenHitMagic := True;
                        FoundOpenHitMagicIndex := N;
                      end;

                      Break;
                    end;
                  end;
                finally
                  g_MagicList.UnLock;
                end;
              end;
            end;

            // 自定义技能 - 烈火
            for II := 0 to Length(g_AutoCustomMagic[mngoFireHit]) - 1 do begin
              CustomMagiID := g_AutoCustomMagic[mngoFireHit][II];
              if (not boFoundOpenHitMagic) and CheckIsCustomMagic(CustomMagiID) and (g_boNextTimeCustomMagicList.IndexOf(Pointer(CustomMagiID - CUSTOM_MAGIC_START_ID)) < 0) and (MyGetTickCount - g_dwLastTryCustomMagicHitTick[CustomMagiID - CUSTOM_MAGIC_START_ID] >= 1000) and g_WarrContinueHitManager.CanOpenMagic(CustomMagiID) then begin
                CustomMagicConfig := GetCustomMagicConfig(CustomMagiID);
                if (CustomMagicConfig <> nil) and (CustomMagicConfig.boIsMagicWarr) and (CustomMagicConfig.MagicBaseConfig.MagicSwitchMode in [msmSwitch, msmNone]) then begin
                  g_MagicList.Lock;
                  try
                    for I := 0 to g_MagicList.Count - 1 do begin
                      Magic := g_MagicList.Items[I];
                      if (Magic.Def.wMagicId = CustomMagiID) and (MyGetTickCount - Magic.dwLastUseTick >= Magic.dwRealInterval + 100) then begin
                        if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                          g_dwLastTryCustomMagicHitTick[CustomMagiID - CUSTOM_MAGIC_START_ID] := MyGetTickCount;
                          PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);

                          // 不能用 UseMagic，会被时间拦截 chongchong 2018-06-04
