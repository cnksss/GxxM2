procedure TfrmMain.ProcessMessageStartContinuousOK(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);

  function FindContinuousMagic(wMagicID:Word):pTClientMagic;
  var
    I:Integer;
    Magic:pTClientMagic;
  begin
    Result := nil;
    if wMagicID > 0 then begin
      g_ContinuousMagicList.Lock;
      try
        for I := 0 to g_ContinuousMagicList.Count - 1 do begin
          Magic := g_ContinuousMagicList.Items[I];
          if Magic.Def.wMagicId = wMagicID then begin
            Result := Magic;
            break;
          end;
        end;
      finally
        g_ContinuousMagicList.UnLock;
      end;
    end;
  end;

var
  I:Integer;
  Magic:pTClientMagic;
begin
  {$IF TESTMODE = 1}
  DScreen.AddChatBoardString('连击技能允许施放..', clRed, clGreen);
  {$IFEND}

  g_ContinuousMagic := nil;

  if LoByte(DefMsg.Param) > 0 then begin
    SetLength(g_ContinuousMagic, Length(g_ContinuousMagic) + 1);
    g_ContinuousMagic[Length(g_ContinuousMagic) - 1].Def.wMagicID := LoByte(DefMsg.Param);
  end;
  if HiByte(DefMsg.Param) > 0 then begin
    SetLength(g_ContinuousMagic, Length(g_ContinuousMagic) + 1);
    g_ContinuousMagic[Length(g_ContinuousMagic) - 1].Def.wMagicID := HiByte(DefMsg.Param);
  end;
  if LoByte(DefMsg.Tag) > 0 then begin
    SetLength(g_ContinuousMagic, Length(g_ContinuousMagic) + 1);
    g_ContinuousMagic[Length(g_ContinuousMagic) - 1].Def.wMagicID := LoByte(DefMsg.Tag);
  end;
  if HiByte(DefMsg.Tag) > 0 then begin
    SetLength(g_ContinuousMagic, Length(g_ContinuousMagic) + 1);
    g_ContinuousMagic[Length(g_ContinuousMagic) - 1].Def.wMagicID := HiByte(DefMsg.Tag);
  end;

  if Length(g_ContinuousMagic) <= 0 then begin
    Exit;
  end;

  for I := 0 to Length(g_ContinuousMagic) - 1 do begin
    Magic := FindContinuousMagic(g_ContinuousMagic[I].Def.wMagicID);
    if Magic = nil then begin
      Exit;
    end;
    g_ContinuousMagic[I] := Magic^;
  end;

  g_nContinuousIndex := 0;
  g_boContinuous := True;

  // OutputDebugString('~~~~~~~~~~~~~~~~~~~~~~~~~~~~ProcessMessageStartContinuousOK');

  if not (g_ContinuousMagic[g_nContinuousIndex].Def.wMagicId in [100..103]) then begin // 不是战士连击技能
    StartContinuousMagicAttack; // 连击魔法
  end;

end;

procedure TfrmMain.ProcessMessageStartContinuousFail(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  boContinuousAttackUseNG:Boolean;
  MsgStr:string;
  nTempX, nTempY:Integer;
begin
  InterlockedExchange(g_nContinuousStatus, $00);

  // 服务器在连击状态才返回的这个，如果这里直接置为False，会和服务器不同步 2020-01-19
  boContinuousAttackUseNG := DefMsg.Param <> 0;

  g_boContinuous := False; //HZQ 20230905 //连接失败，取消连击标志
  {$IF TESTMODE = 1}
  DScreen.AddChatBoardString('连击技能禁止释放.', clRed, clGreen);
  {$IFEND}

  if boContinuousAttackUseNG then
    MsgStr := g_ClientConfig.sNotEnoughNGPoint
  else
    MsgStr := g_ClientConfig.sNotEnoughMPPoint;

  if DefMsg.Recog = -1 then begin
    if g_ClientConfig.boUpLevelMsgXRightToLeft then
      nTempX := SCREENWIDTH - g_ClientConfig.nUpLevelMsgX
    else
      nTempX := g_ClientConfig.nUpLevelMsgX;

    if g_ClientConfig.boUpLevelMsgYBottomToTop then
      nTempY := SCREENHEIGHT - g_ClientConfig.nUpLevelMsgY
    else
      nTempY := g_ClientConfig.nUpLevelMsgY;

    DScreen.AddSysMsg(MsgStr, g_ClientConfig.btUpLevelMsgFColor, g_ClientConfig.btUpLevelMsgBColor, nTempX, nTempY);
  end;

end;

