  //曲线救国了 By 一支笔 at:2022-02-10 16:11:24
  //if FrmDlg.DBackground.ScrollControl <> nil then begin
  //  TDxScrollControl(FrmDlg.DBackground.ScrollControl).MouseUp(Button, Shift, pt.X, pt.Y);
