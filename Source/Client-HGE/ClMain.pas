//血量改变变，附带自定义飘血
procedure TfrmMain.ProcessMessageHealthSpellChange(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Actor, ActorAttack:TActor;
  NewMessageBodyWL:pTNewMessageBodyWL;
  HP, MP, MaxHP, MaxMP, Level, ChangeHP:LongInt;
  nHpNmResID, nHpNmResStartIdx:Integer;
  nIndex:Integer;
  BlastHitType:TBlastHitType;
  HealthSpellChangedInfo:pTMessageHealthSpellChangedInfo;
  GroupMember:PGroupMember;
begin
  nHpNmResID := -1; //HZQ 20230608 配合服务端新加，资源ID配置
  nHpNmResStartIdx := -1;
  
  Actor := PlayScene.FindActor(DefMsg.Recog);
  {$IF IsMultiThreadRender = 1}
  EnterCriticalSection(g_ActorLock);
  try
    {$IFEND}
    if (Actor = nil) and (g_MyHero <> nil) and (g_MyHero.m_nRecogId = DefMsg.Recog) then
      Actor := g_MyHero;
    {$IF IsMultiThreadRender = 1}
  finally
    LeaveCriticalSection(g_ActorLock);
  end;
  {$IFEND}

  ChangeHP := 0;
  BlastHitType := bhtNone;

  if Actor <> nil then begin
    if HiByte(DefMsg.Series) = 1 then begin
      Actor.m_boStruckShowNumber := True;
    end;

    MaxHP := Actor.m_Abil.MaxHP;
    MaxMP := Actor.m_Abil.MaxMP;
    Level := Actor.m_Abil.Level;
    HP := Actor.m_Abil.HP;
    MP := LongInt(MakeLong(DefMsg.param, DefMsg.tag));

    NewMessageBodyWL := nil;
    //HealthSpellChangedInfo := nil; HZQ

    if Length(sData) = SizeOf(TNewMessageBodyWL) then begin
      NewMessageBodyWL := pTNewMessageBodyWL(sData);

      HP := LongInt(NewMessageBodyWL.lParam1);
      MaxHP := LongInt(NewMessageBodyWL.lParam2);
      ChangeHP := NewMessageBodyWL.lTag1; // 血量改变
      //ChangeHP :=  Int64(Actor.m_Abil.HP) - HP;
      Level := NewMessageBodyWL.lTag2; // 等级
      MaxMP := NewMessageBodyWL.lTag3; // 蓝最大值
      Actor.m_btJob := LoByte(DefMsg.Series);
      BlastHitType := NewMessageBodyWL.BlastHitType;
      nHpNmResID := NewMessageBodyWl.ResID; //HZQ 20230608 配合服务端新加，资源ID配置 SM_EFFECTIMAGELIST or SM_EFFECTIMAGELIST_CACHE
      nHpNmResStartIdx := NewMessageBodyWl.ResStartIdx;
      //DScreen.AddChatBoardString('ProcessMessageHealthSpellChange1 ' + Actor.m_sUserName + ' HP:' + IntToStr(HP), clWhite, clRed);
    end else if Length(sData) = SizeOf(TMessageHealthSpellChangedInfo) then begin
      HealthSpellChangedInfo := pTMessageHealthSpellChangedInfo(sData);
      HP := HealthSpellChangedInfo.ChangeHP;
    end;

    if Actor.m_Abil.MaxHP > 0 then begin
      g_ConfigDlg.HealthChange(Actor, HP, MP, MaxHP);

      // 挂机受到人物攻击回城 chongchong 2014-11-26
      if g_boGJRun and (Actor = g_MySelf) and g_ConfigDlg.ConfigCheckeds[ckGJ_PlayAttack] then begin
        // 受到人物攻击
        if (NewMessageBodyWL <> nil) and (NewMessageBodyWL.lTag5 <> 0) then begin
          // 反击
          if nGJPlayAttackOption = g_NGProtectItems.Count - 2 then begin
            ActorAttack := PlayScene.FindActor(NewMessageBodyWL.lTag5);
            if ActorAttack <> nil then begin
              if FGJTargetCret <> ActorAttack then begin
                FGJTargetCretTick := MyGetTickCount;
              end;
              FGJTargetCret := ActorAttack;
              FGJTargetMapName := g_sMapName;
            end;
            Exit;
          end else if nGJPlayAttackOption = g_NGProtectItems.Count - 1 then begin
            // 小退
            if NewMessageBodyWL.lTag5 <> 0 then begin
                ActorAttack := PlayScene.FindActor(NewMessageBodyWL.lTag5);
            end else begin
                ActorAttack := nil;
            end;
            
            if (ActorAttack <> nil) and ((ActorAttack.m_btRace = 0) or (ActorAttack.m_HumsBBType <> bbNo))then begin //chi
                g_IsWaitLogout := True;
                StopGJ;
                frmMain.Logout;
                Exit;
            end;
          end else if (nGJPlayAttackOption >= 0) and (nGJPlayAttackOption < g_NGProtectItems.Count) then begin
            nIndex := FindHumBookItemIndex(g_NGProtectItems.Strings[nGJPlayAttackOption]);
            if nIndex >= 0 then begin
              frmMain.AutoEatItem(nIndex);

              {
              if (g_ItemArr[nIndex].s.StdMode <> 31) and
                // 随机传送卷也不停止挂机chongchong 2016-08-02
                (not ((g_ItemArr[nIndex].s.StdMode = 3) and (g_ItemArr[nIndex].s.Shape = 2))) and
                // 随机传送石也不停止挂机chongchong 2016-08-02
                (not ((g_ItemArr[nIndex].s.StdMode = 2) and (g_ItemArr[nIndex].s.Shape = 2))) then
              begin
                StopGJ;
                Exit;
              end;
              }
            end;
          end;
        end;
      end;

      { TODO -ochongchong -c修改 : 客户端处理飘血叠加 【2013-08-20】}
      if ChangeHP <> 0 then begin
        if BlastHitType = bhtFatalBlow1 then
          Actor.AddHealthNumber(tFatalBlow1, -ChangeHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut)
        else if BlastHitType = bhtFatalBlow2 then
          Actor.AddHealthNumber(tFatalBlow2, -ChangeHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut)
        else if BlastHitType = bhtFatalBlow3 then
          Actor.AddHealthNumber(tFatalBlow3, -ChangeHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut)
        else if BlastHitType = bhtFatalBlow4 then
          Actor.AddHealthNumber(tFatalBlow4, -ChangeHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut)
        else begin
          if not g_ClientConfig.boHealthNumberText then begin
            //if (ChangeHP > Actor.m_Abil.MaxHP * 10 div 100) then
            if (ChangeHP > Integer(Actor.m_Abil.MaxHP) * 10 div 100) then begin
              Actor.AddHealthNumber(tGreen, -ChangeHP, nHpNmResID, nHpNmResStartIdx, ndsNormal)
            end else begin
              if (nHpNmResID < 0)  then begin
                 Actor.AddHealthNumber(tHP, -ChangeHP, nHpNmResID, nHpNmResStartIdx, ndsNormal);
              end else begin
                 Actor.AddHealthNumber(tTextHP, -ChangeHP, nHpNmResID, nHpNmResStartIdx, ndsNormal); //修改，让同屏可以出现多个，20231102
              end; 
            end;
          end else begin
            if BlastHitType = bhtBlastHit then
              Actor.AddHealthNumber(tBlastHP, -ChangeHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut)
            else if not g_ClientConfig.boBlastHitShowHealthNum then
              Actor.AddHealthNumber(tTextHP, -ChangeHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
          end;
        end;

        // 英雄不会像客户端发 SM_STRUCK 消息，不会调用
        // 外挂吃药  物品--自动使用药品 (当HP减一定的值时，使用指定的药品) chongchong 2013-11-13
        if (Actor = g_MyHero) and (ChangeHP > 0) then
          g_ConfigDlg.Struck(g_MyHero, ChangeHP, 0);
      end else if Cardinal(HP) <> Actor.m_Abil.HP then begin
        // HZQ 20230816 增加飘血淡出特效
        if not g_ClientConfig.boHealthNumberText then begin //HZQ 此处应该是绘制淡出
            Actor.AddHealthNumber(tHP, Cardinal(HP) - Actor.m_Abil.HP, nHpNmResID, nHpNmResStartIdx, ndsNormal);
        end else begin
            //Actor.AddHealthNumber(tHP, Cardinal(HP) - Actor.m_Abil.HP, nHpNmResID, nHpNmResStartIdx, ndsStayFadeOut);            
        end;

        // 英雄不会像客户端发 SM_STRUCK 消息，不会调用
        // 外挂吃药  物品--自动使用药品 (当HP减一定的值时，使用指定的药品) chongchong 2013-11-13
        if (Actor = g_MyHero) and (Integer(Actor.m_Abil.HP) > HP) then //HZQ 20230523 Actor.m_bil.Hp - HP > 0
          g_ConfigDlg.Struck(g_MyHero, Actor.m_Abil.HP - Cardinal(HP), 0);
      end;

      if (Cardinal(MP) <> Actor.m_Abil.MP) then begin
          // HZQ 20230816 增加MP飘字淡出特效
          if (not g_ClientConfig.boHealthNumberText) then begin
             Actor.AddHealthNumber(tMP, MP - Integer(Actor.m_Abil.MP), nHpNmResID, nHpNmResStartIdx, ndsNormal);
          end else begin
             //HZQ 20230831 勾选淡化飘血后，不再显示飘蓝
             //Actor.AddHealthNumber(tMP, MP - Integer(Actor.m_Abil.MP), nHpNmResID, nHpNmResStartIdx, ndsStayFadeOut);
          end;
      end;
    end;
    Actor.m_Abil.MaxHP := MaxHP;
    Actor.m_Abil.MaxMP := MaxMP;
    Actor.m_Abil.Level := Level;
    Actor.m_Abil.HP := HP;
    Actor.m_Abil.MP := MP;

    // 修复人物满血之后，调用AddHumNewValue 7 = 20 18血条显示不正常
    if Actor.m_Abil.HP > Actor.m_Abil.MaxHP then begin
      Actor.m_Abil.HP := Actor.m_Abil.MaxHP;
    end;

    FrmDlg.RefreshGuardianLevelStatueMonHP(Actor);
  end;

  if Actor = g_MySelf then begin
    FrmDlg.MySelfAbilChange;
    g_ConfigDlg.RefreshMySelfAbil;
  end;

  if g_ClientConfig.boShowNewGroupInfo then begin
    for nIndex := 0 to g_GroupMembers.Count - 1 do begin
      GroupMember := g_GroupMembers.Items[nIndex];
      if GroupMember.nRecogId = DefMsg.Recog then begin
        if Length(sData) = SizeOf(TNewMessageBodyWL) then begin
          NewMessageBodyWL := pTNewMessageBodyWL(sData);

          GroupMember.HP := LongInt(NewMessageBodyWL.lParam1);
          GroupMember.MaxHP := LongInt(NewMessageBodyWL.lParam2);

          GroupMember.Level := NewMessageBodyWL.lTag2; // 等级
          GroupMember.MaxMP := NewMessageBodyWL.lTag3; // 蓝最大值

          GroupMember.MP := MakeLong(DefMsg.param, DefMsg.tag);
        end else if Length(sData) = SizeOf(TMessageHealthSpellChangedInfo) then begin
          HealthSpellChangedInfo := pTMessageHealthSpellChangedInfo(sData);
          GroupMember.HP := HealthSpellChangedInfo.ChangeHP;
          GroupMember.MP := LongInt(MakeLong(DefMsg.param, DefMsg.tag));
        end;

        FrmDlg.RefreshNewGroupMember(nIndex);

        Break;
      end;
    end;
  end;

  {$IF IsMultiThreadRender = 1}
  EnterCriticalSection(g_ActorLock);
  try
    {$IFEND}
    if Actor = g_MyHero then begin
      FrmDlg.MyHeroAbilChange;
      g_ConfigDlg.RefreshMyHeroAbil;
    end;
    {$IF IsMultiThreadRender = 1}
  finally
    LeaveCriticalSection(g_ActorLock);
  end;
  {$IFEND}
end;

