procedure TfrmMain.ProcessMessageDeath(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Actor:TActor;
  CharDesc:TCharDesc;
  Feature:TFeature;
begin
  Feature.Feature := 0;

  FillChar(CharDesc, SizeOf(TCharDesc), 0);

  if Length(sData) >= SizeOf(TCharDesc) then begin
    CharDesc := pTCharDesc(sData)^;

    if (CharDesc.Feature > 0) and (Length(sData) = SizeOf(TCharDesc) + CharDesc.Feature) then begin
      Feature.Feature := CharDesc.Feature;
      Move(sData[1 + SizeOf(TCharDesc)], Feature.Buffer[0], Feature.Feature);
    end;
  end;

  if Feature.Feature > 0 then
    Actor := PlayScene.SendMsg(DefMsg.ident, DefMsg.Recog, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir + light}, @Feature, CharDesc.Status, '')
  else
    Actor := PlayScene.SendMsg(DefMsg.ident, DefMsg.Recog, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir + light}, nil, CharDesc.Status, '');

  if Actor <> nil then begin
    // Actor.DeleteMsg(SM_ALIVE);
    // DScreen.AddChatBoardString(IntToStr(DefMsg.ident)+' ProcessMessageDeath m_btDir:' + IntToStr(DefMsg.series), clRed, clWhite);
    // Actor.CleanMsgs;
    // Actor.m_nCurrentAction := 0;
    // Actor.ActionEnded;
    // Actor.m_boUseMagic := False;
    (* Actor.SendMsg(DefMsg.ident,
    DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir},
    Actor.m_Feature,
    Status, '',
    0);
    *)
  end
  else begin
    {$IF IsMultiThreadRender = 1}
    EnterCriticalSection(g_ActorLock);
    {$IFEND}
    Actor := g_MyHero;
    {$IF IsMultiThreadRender = 1}
    LeaveCriticalSection(g_ActorLock);
    {$IFEND}
    if (Actor <> nil) and (Actor.m_nRecogId = DefMsg.Recog) then begin
      Actor.SendMsg(DefMsg.ident, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir}, Actor.m_Feature, CharDesc.Status, '', 0);
      Actor.ProcMsg;
      Actor.Run;
      Actor.ProcHurryMsg;
    end;
  end;
end;

procedure TfrmMain.ProcessMessageAlive(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  CharDesc:pTCharDesc;
  Feature:TFeature;
begin
  if Length(sData) >= SizeOf(TCharDesc) then begin
    CharDesc := pTCharDesc(sData);

    if (CharDesc.Feature > 0) and (Length(sData) >= SizeOf(TCharDesc) + CharDesc.Feature) then begin
      Feature.Feature := CharDesc.Feature;
      Move(sData[1 + SizeOf(TCharDesc)], Feature.Buffer[0], Feature.Feature);

      if (DefMsg.Ident = SM_SKELETON) and (DefMsg.Recog = FLastButchTargetRecogId) then
        FLastButchTargetRecogId := 0;

      PlayScene.SendMsg(DefMsg.ident, DefMsg.Recog, DefMsg.param {X}, DefMsg.tag {Y}, DefMsg.series {dir}, @Feature, CharDesc.Status, '');
    end;
  end;
end;

