        ClientMagic := FindMagic(pcm.Def.wMagicId);
        if (ClientMagic <> nil) and (MyGetTickCount - ClientMagic.dwLastUseTick <= ClientMagic.dwInterval) then begin
          //OutputDebugString('aaa');
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;

        if (MyGetTickCount - g_dwLatest115HitTick <= Cardinal(g_nXHYJHitDelayTime))
          or (not g_WarrContinueHitManager.CanOpenMagic(115)) then begin
          //OutputDebugString('bbb');
          // 修正调整砍怪时(速度很快)，使用技能雷电术无法释放 chongchong 2018-06-04
          CleanMagicIDByFormActionKey();
          Exit;
        end;
      end;

      // 2020-06-08
      (*
