procedure TfrmMain.TimerEvent(Sender:TObject);
var
  Scene:TScene;
  boCanDrawTileMap:Boolean;
  ErrCode:Integer;
begin
  // Sleep(10);
  // Timer1Timer(Self);
  ErrCode := 0;

  if g_boAppExit then
    Exit;
  try
    ErrCode := 1;
    Scene := DScreen.CurrentScene;
    if (Scene <> nil) and (GameCanvas <> nil) then begin
      ErrCode := 2;
      if g_btStartPrintScreenNow = 2 then begin // 保存屏幕截图
        g_btStartPrintScreenNow := 0;
        {$IF TESTMODE = 0}
        GameCanvas.HGE.System_Snapshot(g_sScreenCaptureFileName);
        {$IFEND}
      end;

      {
      // 代码移动ThreadTimer中
      if (Scene = PlayScene) then
      begin
        PlayScene.ProcessActors();
      end;
      }
      ErrCode := 3;

      if GameCanvas.Active and GameCanvas.Initialized and (not g_boMinimized) then begin // (WindowState <> wsMinimized)
        ErrCode := 4;
        if (Scene = PlayScene) then begin // 游戏场景
          ErrCode := 5;

          if g_UpdateEngine <> nil then begin
            ErrCode := 6;
            boCanDrawTileMap := g_boCanDrawTileMap or (g_boAutoUpdate and g_UpdateEngine.NeedDrawTileMap);
            g_UpdateEngine.NeedDrawTileMap := False;
          end else begin
            ErrCode := 7;
            boCanDrawTileMap := g_boCanDrawTileMap;
          end;

          ErrCode := 8;
          g_boCanDrawTileMap := False;
          if (g_MySelf <> nil) then begin
            ErrCode := 9;
            if g_boRenderTargetTileMap and (PlayScene.m_boCanDrawTileMap or boCanDrawTileMap) then begin
              ErrCode := 10;
              GameCanvas.Render(PlayScene.RenderTileMap, DisplaceRB(Scene.BackgroundColor) or $FF000000, True, g_RenderTarget[0]);
            end;

            ErrCode := 11;
            if ((g_boViewFog and g_ClientConfig.boViewFog) or g_boMapNight) and g_boRenderTarget then begin
              ErrCode := 12;
              GameCanvas.Render(PlayScene.RenderLight, ARGB(255, g_nDarkValue, g_nDarkValue, g_nDarkValue), True, g_RenderTarget[2]);
            end;
            if g_boGuide and (g_GuideR <> 0) and (g_GuideB <> 0) then begin
              ErrCode := 18;
              GameCanvas.Render(PlayScene.RenderGuide, ARGB(255, 160, 160, 160), True, g_RenderTarget[3]);
            end;
          end;
        end;

        ErrCode := 13;
        if g_boRenderTarget and (Scene <> nil) and (g_RenderTarget[1] <> nil) then begin
          ErrCode := 14;
          GameCanvas.Render(RenderScene, DisplaceRB(Scene.BackgroundColor) or $FF000000, True, g_RenderTarget[1]);
        end else begin
          ErrCode := 15;
          GameCanvas.Render(RenderScene, DisplaceRB(Scene.BackgroundColor) or $FF000000);
        end;

        ErrCode := 16;
        if g_boRenderTarget then begin
          ErrCode := 17;
          GameCanvas.Render(RenderControl, DisplaceRB(Scene.BackgroundColor) or $FF000000);
        end;
      end;
    end;
  except
    on E:Exception do begin
      DebugOutStr(DecodeResStr(SFrmMainTimerEventErr) + '; code =' + IntToStr(ErrCode));
      DebugOutStr(E.Message);
    end;
  end;
end;

procedure TfrmMain.RenderControl(Sender:TObject);
var
  nW:Integer;
  d:TTexture;
begin
  if DScreen.CurrentScene <> nil then
    GameCanvas.FillRect(Bounds(0, 0, SCREENWIDTH, SCREENHEIGHT), DScreen.CurrentScene.BackgroundColor);
  if g_boRenderTarget then
    GameCanvas.Draw(0, 0, Bounds(0, 0, SCREENWIDTH, SCREENHEIGHT), g_RenderTarget[1]);
  if (g_MySelf <> nil) and g_boRenderTarget and g_boGuide and (g_GuideR <> 0) and (g_GuideB <> 0) then begin
    GameCanvas.Draw(0, 0, g_RenderTarget[3].ClientRect, g_RenderTarget[3], Blend_Multiply);
    d := g_WMobileImages.Images[265];
    if d <> nil then
      GameCanvas.Draw(g_GuideR - d.Width div 2 + g_GuideOffset, g_GuideY - d.Height div 2 - g_GuideOffset, d);

    d := g_WMobileImages.Images[266];
    if d <> nil then
      GameCanvas.Draw(g_GuideR - d.Width div 2 + g_GuideOffset, g_GuideB - d.Height div 2 + g_GuideOffset, d);

    d := g_WMobileImages.Images[267];
    if d <> nil then
      GameCanvas.Draw(g_GuideX - d.Width div 2 - g_GuideOffset, g_GuideY - d.Height div 2 - g_GuideOffset, d);

    d := g_WMobileImages.Images[268];
    if d <> nil then
      GameCanvas.Draw(g_GuideX - d.Width div 2 - g_GuideOffset, g_GuideB - d.Height div 2 + g_GuideOffset, d);

    //    g_GuideStrLen := CurrentFont.TextWidth(g_GuideStr) + 12;
    if g_nScreenWidth div 2 > g_GuideX then
    {//if //g_GuideX - (g_GuideStrLen + 100) < 0 then} begin
      //向左指向的箭头
      d := g_WMobileImages.Images[262];
      if d <> nil then begin
        nW := d.Width;
        GameCanvas.Draw(g_GuideR + g_GuideOffset, g_GuideY + (g_GuideB - g_GuideY) div 2 - d.Height div 2, d);
      end else begin
        nW := 0; //HZQ 20230520 根据代码意思补全，此处可能会有问题
      end;
      //信息框在右边
      d := g_WMobileImages.Images[264];
      if d <> nil then begin
        GameCanvas.StretchDraw(Bounds(g_GuideR + g_GuideOffset + nW, g_GuideY + (g_GuideB - g_GuideY) div 2 - d.Height div 2, g_GuideStrLen, d.Height), d);
      end;

      BoldTextOut(CurrentFont, g_GuideR + g_GuideOffset + nW + 6, g_GuideY + (g_GuideB - g_GuideY) div 2 - g_CurrentFontHeight div 2, g_GuideStr, clWhite);
    end
    else begin
      //向右指向的箭头
      d := g_WMobileImages.Images[260];
      if d <> nil then begin
        nW := d.Width;
        GameCanvas.Draw(g_GuideX - g_GuideOffset - nW, g_GuideY + (g_GuideB - g_GuideY) div 2 - d.Height div 2, d);
      end else begin
        nW := 0; //HZQ 20230520 补全
      end;
      //信息框在左边
      d := g_WMobileImages.Images[264];
      if d <> nil then
        GameCanvas.StretchDraw(Bounds(g_GuideX - g_GuideOffset - nW * 3 - 12, g_GuideY + (g_GuideB - g_GuideY) div 2 - d.Height div 2, g_GuideStrLen, d.Height), d);

      BoldTextOut(CurrentFont, g_GuideX - g_GuideOffset - nW * 3 - 6, g_GuideY + (g_GuideB - g_GuideY) div 2 - g_CurrentFontHeight div 2, g_GuideStr, clWhite);
    end;

    if g_GuideSwitch then
      Dec(g_GuideOffset)
    else
      Inc(g_GuideOffset);
    if (g_GuideOffset > 10) or (g_GuideOffset < 1) then
      g_GuideSwitch := not g_GuideSwitch;
  end;
end;

