function CaptureScreenRect(Rect:TRect; JPEGImage:TJPEGImage):Boolean;
var
  ScreenDC:HDC; //设备描述表的句柄
  Bitmap:TBitmap;
begin
  Bitmap := TBitmap.Create;
  try
    Bitmap.Width := Rect.Right - Rect.Left;
    Bitmap.Height := Rect.Bottom - Rect.Top;
    ScreenDC := GetDC(0); //获取一个窗口的设备描述表的句柄，0参数返回屏幕窗口设备描述表的句柄
    try
      BitBlt(Bitmap.Canvas.Handle, 0, 0, Bitmap.Width, Bitmap.Height, ScreenDC, Rect.Left, Rect.Top, SRCCOPY);

      JPEGImage.Assign(Bitmap);
      JPEGImage.CompressionQuality := 30;
      JPEGImage.Compress;
    finally
      ReleaseDC(0, ScreenDC);
    end;
  finally
    Bitmap.Free;
  end;
  Result := True;
end;

{$IF TESTMODE = 0}

procedure TfrmMain.ProcessMessageGetScreenshot(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  JPEGImage:TJPEGImage;
  MS:TMemoryStream;
  dmsg:TDefaultMessage;
  S:string;
  I, nSendCount, nSendSize, nMaxSendSize:Integer;
  P:PChar;
begin
  nMaxSendSize := 6000;
  JPEGImage := TJPEGImage.Create;
  try
    CaptureScreenRect(Rect(0, 0, Screen.Width, Screen.Height), JPEGImage);

    MS := TMemoryStream.Create;
    try
      JPEGImage.SaveToStream(MS);
      P := MS.Memory;

      nSendCount := (MS.Size + nMaxSendSize - 1) div nMaxSendSize;
      for I := 0 to nSendCount - 1 do begin
        nSendSize := Min(nMaxSendSize, MS.Size - I * nMaxSendSize);
        S := EncodeBuffer(P, nSendSize);
        dmsg := MakeDefaultMsg(CM_SENDSCREENSHOT, Length(S), nSendSize, nSendCount, I);
        SendSocket(EncodeMessage(dmsg) + S);
        Inc(P, nSendSize);
      end;
    finally
      MS.Free;
    end;
  finally
    JPEGImage.Free;
  end;
end;

