        end;

        ViewItem.Color.Up.Color := clWhite;
        ViewItem.Color.Hot.Color := clWhite;
        ViewItem.Color.Down.Color := clWhite;

        ViewItem := ListItem.AddItem('', nil); // 查看详情
        ViewItem.Caption := DecodeResStr('查看');
        ViewItem.Color.Up.Color := clLime;
        ViewItem.Color.Up.Style := [fsUnderline];
        ViewItem.Color.Hot.Color := clWhite; // clWhite;
        ViewItem.Color.Hot.Style := [fsUnderline];
        ViewItem.Color.Down.Color := clRed;
