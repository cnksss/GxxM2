        DoRun;
      end;
    finally
      FInExecuteLoop := False;
    end;
  end;
end;

function TCheckBlackProcessMD5Thread.GetSleeping:Boolean;
begin
  Result := not FInExecuteLoop;
end;

procedure TCheckBlackProcessMD5Thread.Terminate;
begin
  inherited Terminate;
  TriggerEvent;
end;

procedure TCheckBlackProcessMD5Thread.TriggerEvent;
begin
  FEvent.SetEvent;
end;

