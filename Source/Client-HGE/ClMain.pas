procedure TfrmMain.ProcessMessageUpdateJewelryBox(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  IsHero:Boolean;
  JewelryBoxStatus:Integer;
  I:Integer;
  Index:Integer;
  cu:TClientItem;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  Buffer:PChar;
begin
  IsHero := DefMsg.Recog <> 0;
  JewelryBoxStatus := DefMsg.Tag;
  if not IsHero then begin
    g_MySelf.m_nJewelryBoxStatus := TJewelryBoxStatus(JewelryBoxStatus);

    if (FrmDlg is TSerialWindows) and (g_ClientVersion in [cvSerial, cvMirSequel, cvMirNewUI205]) then begin
      TSerialWindows(FrmDlg).NewStateWindows.SetMySelfJewelryBoxButton;
      TSerialWindows(FrmDlg).SetMySelfJewelryBoxButton;
    end;

    if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
      zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));

      for I := Low(g_JewelryBoxItems) to High(g_JewelryBoxItems) do begin
        g_JewelryBoxItems[I].MakeIndex := 0;
        g_JewelryBoxItems[I].S.Name := '';
      end;

      Buffer := @OutBuf;
      for I := 0 to DefMsg.Series - 1 do begin
        Index := Ord(Buffer^);
        Inc(Buffer);
        Move(Buffer^, cu, SizeOf(TClientItem));
        Buffer := Buffer + SizeOf(TClientItem);
        if Index in [Low(TJewelryBoxItems)..High(TJewelryBoxItems)] then begin
          g_JewelryBoxItems[Index] := cu;
        end;
      end;
    end;
  end else begin
    if g_MyHero = nil then
      Exit;
    g_MyHero.m_nJewelryBoxStatus := TJewelryBoxStatus(JewelryBoxStatus);

    if (FrmDlg is TSerialWindows) and (g_ClientVersion in [cvSerial, cvMirSequel, cvMirNewUI205]) then begin
      TSerialWindows(FrmDlg).NewStateWindows.SetMyHeroJewelryBoxButton;
      TSerialWindows(FrmDlg).SetMyHeroJewelryBoxButton;
    end;

    for I := Low(g_HeroJewelryBoxItems) to High(g_HeroJewelryBoxItems) do begin
      g_HeroJewelryBoxItems[I].MakeIndex := 0;
      g_HeroJewelryBoxItems[I].S.Name := '';
    end;

    if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
      zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));

      Buffer := @OutBuf;
      for I := 0 to DefMsg.Series - 1 do begin
        Index := Ord(Buffer^);
        Inc(Buffer);
        Move(Buffer^, cu, SizeOf(TClientItem));
        Buffer := Buffer + SizeOf(TClientItem);
        if Index in [Low(TJewelryBoxItems)..High(TJewelryBoxItems)] then begin
          g_HeroJewelryBoxItems[Index] := cu;
        end;
      end;
    end;
  end;
end;

