procedure TfrmMain.AppMessage(var Msg:TMsg; var Handled:Boolean);
var
  wKey:Word;
  Key:Char;
  Actor:TActor;
begin
  Handled := False;

  case Msg.Message of
    WM_KeyDown:begin
        wKey := Msg.wParam;
        if Msg.wParam = VK_TAB then begin
          FormKeyDown(Self, wKey, []);
          Key := Char(wKey);
          FormKeyPress(Self, Key);
        end;
      end;
    WM_KeyUp:begin
        if g_ClientConfig.boKeyTabGetActor and (Msg.wParam = VK_TAB) then begin
          {$IF IsMultiThreadRender = 1}
          EnterCriticalSection(g_ActorLock);
          {$IFEND}
          Actor := g_FocusCret;
          {$IF IsMultiThreadRender = 1}
          LeaveCriticalSection(g_ActorLock);
          {$IFEND}
          if (Actor <> nil) and PlayScene.IsValidActor(Actor) and (Actor.m_btHair < 4) then begin
            FrmDlg.ShowChatEdit();
            FrmDlg.DEdChat.Text := '/' + Actor.m_sUserName + ' ';
          end;
        end;
        Key := Char(Msg.wParam);
      end;
    WM_SYSCOMMAND:begin
        if (Msg.wParam = SC_RESTORE) then begin
          g_boMinimized := False;
          g_BassSound.Active := True;
          ChangeScreenMode;
          RestoreDevice;
        end;
      end;
  end;
end;

