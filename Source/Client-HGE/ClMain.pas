procedure TfrmMain.ProcessMessageSoftExit(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
begin
  if DefMsg.Series = 0 then begin
    g_AntiPlugNotifyFunc := nil;

    g_boAppExit := True;

    SaveOrLoadMyBagItemList(True);
    CloseAllWindows;

    {$IF IsMultiThreadRender = 1}
    if RenderThread <> nil then
      RenderThread.Terminate;
    {$ELSE}
    TimerRender.Enabled := False;
    {$IFEND}
    CSocket.Close;

    GameCanvas.Finalize;

    Application.Terminate;
  end
  else begin
    g_WaitAppExit := False;
  end;
end;

procedure TfrmMain.ProcessPreviewMonItemRet(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  S:string;
  I, nX:Integer;
  Actor:TActor;
  Item:pTPreviewMonItem;
  HGEFont:THGEFont;
  DropItemEffect:PDropItemEffect;
begin
  if DefMsg.Param = 1 then begin
    S := '[失败]：禁止透视该怪物';

    HGEFont := TextureFonts.FindFont(g_sCurFontName, 10, [fsBold]);
    if HGEFont <> nil then
      nX := g_nMouseX - HGEFont.TextWidth(S) div 2
    else
      nX := CurrentFont.TextWidth(S) div 2;

    DScreen.AddNewMoveMsg(S, 249, 255, 10, nX, g_nMouseY - 10, 1); // DefMsg.Series
  end
  else if DefMsg.Param = 2 then begin
    S := '[失败]：怪物已经被他人透视';

    HGEFont := TextureFonts.FindFont(g_sCurFontName, 10, [fsBold]);
    if HGEFont <> nil then
      nX := g_nMouseX - HGEFont.TextWidth(S) div 2
    else
      nX := CurrentFont.TextWidth(S) div 2;

    DScreen.AddNewMoveMsg(S, 249, 255, 10, nX, g_nMouseY - 10, 1); // DefMsg.Series
  end
  else if DefMsg.Param = 3 then begin
    S := '[失败]：怪物已经被他人透视，等待' + IntToStr(MakeLong(DefMsg.Tag, DefMsg.Series)) + '秒后可透视';

    HGEFont := TextureFonts.FindFont(g_sCurFontName, 10, [fsBold]);
    if HGEFont <> nil then
      nX := g_nMouseX - HGEFont.TextWidth(S) div 2
    else
      nX := CurrentFont.TextWidth(S) div 2;

    DScreen.AddNewMoveMsg(S, 249, 255, 10, nX, g_nMouseY - 10, 1); // DefMsg.Series
  end
  else if DefMsg.Param = 0 then begin
    Actor := PlayScene.FindActor(DefMsg.Recog);
    if (Actor <> nil) and (DefMsg.Tag * SizeOf(TPreviewMonItem) = Length(sData)) then begin
      if DefMsg.Tag = 0 then begin
        SetLength(g_PreviewItem, 0);
      end
      else begin
        Item := pTPreviewMonItem(sData);
        SetLength(g_PreviewItem, DefMsg.Tag);
        for I := 0 to DefMsg.Tag - 1 do begin
          g_PreviewItem[I].PreiewMonItem := Item^;

          g_PreviewItem[I].ItemEffect.FileIndex := -1;
          g_PreviewItem[I].ItemEffect.ImageCount := 0;

          if Item^.EffectIndex > 0 then begin
            DropItemEffect := g_DropItemEffectList.Get(Item^.EffectIndex);

            if DropItemEffect <> nil then begin
              g_PreviewItem[I].ItemEffect := DropItemEffect^;
              g_PreviewItem[I].ItemEffectFrame := DropItemEffect.StartIndex;
              g_PreviewItem[I].ItemEffectTick := MyGetTickCount;
            end;
          end;

          g_PreviewItem[I].ValueItemEffectFrame := 0;
          g_PreviewItem[I].ValueItemEffectTick := MyGetTickCount;

          Inc(Item);
        end;
      end;

      g_nPreviewItemActorRecog := DefMsg.Recog;
      g_dwPreviewItemShowTick := MyGetTickCount;
      g_dwPreviewItemShowTime := DefMsg.Series * 1000;
    end;
  end;
end;

