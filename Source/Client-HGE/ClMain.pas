      else if not FrmDlg.CheckDMinMapExShowButton then begin
        // 显示收缩仿页游小地图
        g_nViewMinMapLv := 1;
        g_boViewMiniMap := True;
        frmMain.SendWantMiniMap;
      end
      else begin
        g_nViewMinMapLv := 0;
        g_boViewMiniMap := True;
        frmMain.SendWantMiniMap;
      end;
    end;

    FrmDlg.MinMapLevelChange;

    // TAB键要支持这个 2019-05-17
    if (not g_boViewMiniMap) and g_ClientConfig.boUseFindPath then begin
      FrmDlg.OpenDMinMapBigDlg;

      if FrmDlg.CheckDMinMapBigDlgVisible and (g_nMiniMapIndex < 0) then begin
        frmMain.SendWantMiniMap;
      end;
    end;

    Exit;
  end;

  // ----------------------------------------------------------

  if FrmDlg.CheckDMinMapExDlgVisible then begin
    FrmDlg.CloseDMinMapExDlg;
  end;

  if g_ClientConfig.boUseFindPath then begin
    // DScreen.AddChatBoardString(Format('g_nViewMinMapLv:%D', [g_nViewMinMapLv]), clGreen, clWhite);
    if FrmDlg.CheckDMinMapBigDlgVisible then begin
      if g_nViewMinMapLv = 0 then begin
        FrmDlg.CloseDMinMapBigDlg;
        Exit;
      end
      else begin
        if g_nViewMinMapLv = 2 then begin
          FrmDlg.CloseDMinMapBigDlg;
        end;
      end;
    end
    else begin
      if g_nViewMinMapLv = 2 then begin
        FrmDlg.OpenDMinMapBigDlg;
      end;
    end;
    if FrmDlg.CheckDMinMapBigDlgVisible and (g_nMiniMapIndex < 0) then begin
      frmMain.SendWantMiniMap;
    end;
  end;

  if not g_boViewMiniMap then begin
    if MyGetTickCount > g_dwQueryMsgTick then begin
      g_dwQueryMsgTick := MyGetTickCount + 1000;
      frmMain.SendWantMiniMap;
      g_nViewMinMapLv := 1;
    end;
  end
  else begin
    if g_nViewMinMapLv >= 2 then begin
      g_nViewMinMapLv := 0;
      g_boViewMiniMap := False;
      FrmDlg.DMinMapDlg.Visible := False; {g_ClientVersion = cvMirs;}
    end
    else
      Inc(g_nViewMinMapLv);
  end;
  FrmDlg.MinMapLevelChange;
end;

