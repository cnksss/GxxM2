procedure TfrmMain.ProcessKeyMessages;
var
  PlugData:TAntiPlugNotifyEventSpellData;
  Magic:PTClientMagic;
begin
  if ActionKey = 0 then
    Exit;

  case ActionKey of
    VK_F1, VK_F2, VK_F3, VK_F4, VK_F5, VK_F6, VK_F7, VK_F8:begin
        Magic := GetMagicByKey(Char((ActionKey - VK_F1) + byte('1')));
        if (Magic <> nil) and UseMagic(g_nMouseX, g_nMouseY, Magic, True) then begin
          if Assigned(g_AntiPlugNotifyFunc) then begin
            PlugData.nX := g_nMouseX;
            PlugData.nY := g_nMouseY;
            PlugData.nMagicID := Magic.Def.wMagicId;

            g_AntiPlugNotifyFunc(event_Spell, @PlugData, SizeOf(PlugData));
          end;
        end;
        ActionKey := 0;
        g_nTargetX := -1;
        g_nTargetY := -1;
      end;
    12..19:begin
        Magic := GetMagicByKey(Char((ActionKey - 12) + byte('1') + byte($14)));
        if (Magic <> nil) and UseMagic(g_nMouseX, g_nMouseY, Magic, True) then begin
          if Assigned(g_AntiPlugNotifyFunc) then begin
            PlugData.nX := g_nMouseX;
            PlugData.nY := g_nMouseY;
            PlugData.nMagicID := Magic.Def.wMagicId;

            g_AntiPlugNotifyFunc(event_Spell, @PlugData, SizeOf(PlugData));
          end;
        end;

        ActionKey := 0;
        g_nTargetX := -1;
        g_nTargetY := -1;
      end;
    else
      if (ActionKey >= Ord('A')) and (ActionKey <= Ord('Z')) then begin
        Magic := GetMagicByKey(Chr(ActionKey + 32));
        if (Magic <> nil) and UseMagic(g_nMouseX, g_nMouseY, Magic, True) then begin
          if Assigned(g_AntiPlugNotifyFunc) then begin
            PlugData.nX := g_nMouseX;
            PlugData.nY := g_nMouseY;
            PlugData.nMagicID := Magic.Def.wMagicId;

            g_AntiPlugNotifyFunc(event_Spell, @PlugData, SizeOf(PlugData));
          end;
        end;
        ActionKey := 0;
        g_nTargetX := -1;
        g_nTargetY := -1;
      end;
  end;
end;

