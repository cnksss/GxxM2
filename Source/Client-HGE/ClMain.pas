        ListItem := TSerialWindows(FrmDlg).DLvSellPlayerShopItem.Add;

        ViewItem := ListItem.AddItem('', nil); // 物品
        ViewItem.Caption := IntToStr(g_SellPlayerShopItems[I].Index);

