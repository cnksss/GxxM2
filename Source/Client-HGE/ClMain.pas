procedure TfrmMain.ProcessMessageSendUpgradeDialogItemFail(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
begin
  // FrmDlg.DMessageDlg('ClientObjUpgradeDialogItemFail:' + inttostr(DefMsg.Recog), [mbOk]);
  case DefMsg.Recog of
    0:begin // 升级失败
        if DefMsg.Series = 1 then begin // 装备破碎
          for I := 0 to Length(g_UpgradeItemArr) - 1 do begin
            g_UpgradeItemArr[I].S.Name := '';
            g_WaitingUpgradeItemArr[I].S.Name := '';
          end;
        end
        else begin
          for I := 0 to Length(g_UpgradeItemArr) - 1 do begin
            g_UpgradeItemArr[I].S.Name := '';
            g_WaitingUpgradeItemArr[I].S.Name := '';
          end;

          if Length(sData) = SizeOf(TClientItem) then begin
            g_UpgradeItemArr[0] := pTClientItem(sData)^;
          end;
        end;
      end;
    -1, -2, -3, -4, -5, -6:begin // 不能升级
        for I := 0 to Length(g_UpgradeItemArr) - 1 do begin
          g_UpgradeItemArr[I] := g_WaitingUpgradeItemArr[I];
          g_WaitingUpgradeItemArr[I].S.Name := '';
        end;
      end;
    -7:begin // 宝石删除
        {
        for I := 0 to Length(g_UpgradeItemArr) - 1 do
        begin
          g_UpgradeItemArr[I].s.Name := '';
        end;

        g_UpgradeItemArr[0] := g_WaitingUpgradeItemArr[0];
        for I := 0 to Length(g_WaitingUpgradeItemArr) - 1 do
        begin
          g_WaitingUpgradeItemArr[I].s.Name := '';
        end;
        }
        for I := 0 to Length(g_UpgradeItemArr) - 1 do begin
          g_UpgradeItemArr[I] := g_WaitingUpgradeItemArr[I];
          g_WaitingUpgradeItemArr[I].S.Name := '';
        end;
      end;
    -8:begin // 宝石和装备不对应
        for I := 0 to Length(g_UpgradeItemArr) - 1 do begin
          g_UpgradeItemArr[I] := g_WaitingUpgradeItemArr[I];
          g_WaitingUpgradeItemArr[I].S.Name := '';
        end;
      end;
  end;

  case DefMsg.Recog of
    0:
      if DefMsg.Series = 1 then begin // 装备破碎
        DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail1), clYellow, clRed);
      end
      else begin
        DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail2), clYellow, clRed);
      end;
    -1:
      DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail3), clYellow, clRed);
    -2:
      DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail4), clYellow, clRed);

    -3:
      DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail5), clYellow, clRed);
    -4:
      DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail6), clYellow, clRed);
    -5:
      DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail7), clYellow, clRed);
    -6:
      DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail8), clYellow, clRed);
    -7:
      DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail2), clYellow, clRed); // 宝石删除
    else
      DScreen.AddChatBoardString(DecodeResStr(SUpgradeItemFail2), clYellow, clRed);
  end;
end;

