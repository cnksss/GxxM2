procedure TfrmMain.ProcessMessageStdItemList(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  ClientItem:pTClientItem;
  SortItem:PSortClientItem;
  OutBytes:Integer;
  OutBuf, Buffer:PChar;
  PartialStdItem:PTPartialStdItem;
  CompleteStdItem:PTCompleteStdItem;
  StdItemsHeader:TStdItemsHeader;
begin
  if (DefMsg.Series = 0) or (Length(sData) > 0) then begin
    g_StdItemsCRC := BufferCrc(PChar(sData), Length(sData));

    for I := 0 to g_SortStdItemList.Count - 1 do
      Dispose(PSortClientItem(g_SortStdItemList.Items[I]));
    g_SortStdItemList.Clear;

    for I := 0 to g_StdItemList.Count - 1 do
      Dispose(pTClientItem(g_StdItemList.Items[I]));
    g_StdItemList.Clear;

    if (DefMsg.Recog > 0) and (Length(sData) = DefMsg.Recog) then begin
      OutBytes := MakeLong(DefMsg.Param, DefMsg.Tag);
      GetMem(OutBuf, OutBytes + 1);
      try
        zLibDecompressString(sData, OutBuf, OutBytes);
        Buffer := OutBuf;

        StdItemsHeader := PTStdItemsHeader(Buffer)^;
        Inc(Buffer, SizeOf(TStdItemsHeader));

        g_StdItemList.Capacity := StdItemsHeader.PartialFieldsCount;
        g_SortStdItemList.Capacity := StdItemsHeader.PartialFieldsCount;

        for I := 0 to StdItemsHeader.PartialFieldsCount - 1 do begin
          New(ClientItem);
          ZeroMemory(ClientItem, SizeOf(TClientItem));
          ClientItem.s.Color := 255;

          PartialStdItem := PTPartialStdItem(Buffer);
          ClientItem.s.Looks := PartialStdItem.Looks;
          ClientItem.s.Name := PartialStdItem.Name;
          ClientItem.s.StdMode := PartialStdItem.StdMode;
          ClientItem.s.Shape := PartialStdItem.Shape;

          // 这个数据只是昨时的，算不得数，主要用于及时雨外挂判断药品类型 chongchong 2015-02-07
          ClientItem.s.Horse := PartialStdItem._Horse;

          ClientItem.MakeIndex := 0;
          g_StdItemList.Add(ClientItem);

          // 限定2^14次方个
          if g_SortStdItemList.Count < 16384 then {// 2^14次方}  begin
            New(SortItem);
            SortItem.ItemIndex := I + 1;
            SortItem.ClientItem := ClientItem;
            g_SortStdItemList.Add(SortItem);
          end;

          Inc(Buffer, SizeOf(TPartialStdItem));
        end;

        for I := 0 to StdItemsHeader.AllFiledsCount - 1 do begin
          CompleteStdItem := PTCompleteStdItem(Buffer);
          if (CompleteStdItem.Index >= 0) and (CompleteStdItem.Index < g_StdItemList.Count) then begin
            ClientItem := g_StdItemList[CompleteStdItem.Index];

            Move(CompleteStdItem.StdItem, ClientItem.s, SizeOf(TStdItem));

            ClientItem.MakeIndex := 0;
            ClientItem.Dura := ClientItem.s.DuraMax;
            ClientItem.DuraMax := ClientItem.s.DuraMax;
          end;

          Inc(Buffer, SizeOf(TCompleteStdItem));
        end;

        if g_SortStdItemList.Count > 0 then begin
          SortStdItemListDoSort(0, g_SortStdItemList.Count - 1);
        end;

        // OutputDebugString(PChar(IntToStr(GetItemIdxByName('宠物技能1'))));
      finally
        FreeMem(OutBuf, OutBytes + 1)
      end;
    end;
  end;

  if DefMsg.Series > 0 then begin
    g_nShowClientDataFileProgress := DefMsg.Series;
    //OutputDebugString(PChar('正在加载资源' + IntToStr(g_nShowClientDataFileProgress)));
    RenderEvent(Self);
    Application.ProcessMessages;
  end;
end;

