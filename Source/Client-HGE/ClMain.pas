procedure TfrmMain.ProcessMessageAddDlg(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, nLen:Integer;
  nDlgIndex, nFileIndex, nImageIndex:Integer;
  ptDlgPositon, ptTextOffset:TPoint;
  boCanMove:Boolean;
  btOwner:Byte;
  ShortMessage:TShortMessage;
  DxForm:TDxImageForm;
  CurForm:TDxImageForm;
  GameImages:TGameImages;
  nLeft, nTop:Integer;
  R1, R2:TRect;
  AOwner:TDxControl;
begin
  nLen := Length(sData);
  if nLen >= g_nShortMessage then begin
    DecodeString(sData, @ShortMessage, SizeOf(TShortMessage));
    sData := Copy(sData, g_nShortMessage + 1, Length(sData) - g_nShortMessage);
    sData := DecodeString(sData);

    nFileIndex := LoWord(DefMsg.Recog);
    nDlgIndex := LoByte(HiWord(DefMsg.Recog));
    btOwner := HiByte(HiWord(DefMsg.Recog));

    // 第1bit为是否可移动，后面7bit为btOwner
    boCanMove := btOwner and 128 <> 0;
    btOwner := btOwner and $7F;

    ptDlgPositon.X := SmallInt(DefMsg.Param);
    ptDlgPositon.Y := SmallInt(DefMsg.Tag);
    nImageIndex := SmallInt(DefMsg.Series);
    ptTextOffset.X := SmallInt(ShortMessage.Ident);
    ptTextOffset.Y := SmallInt(ShortMessage.wMsg);

    nLeft := ptDlgPositon.X;
    nTop := ptDlgPositon.Y;

    if btOwner = 6 then begin
      // 聊天框左侧
      R1 := TSerialWindows(FrmDlg).DMainBottomDlg.GetLeftRect;
      R2 := TSerialWindows(FrmDlg).DMainBottomDlg.VirtualRect;
      nLeft := R1.Left - R2.Left + nLeft;
      nTop := R1.Top - R2.Top + nTop;
    end else if btOwner = 7 then begin
      // 聊天框右侧
      R1 := TSerialWindows(FrmDlg).DMainBottomDlg.GetRightRect;
      R2 := TSerialWindows(FrmDlg).DMainBottomDlg.VirtualRect;
      nLeft := R1.Left - R2.Left + nLeft;
      nTop := R1.Top - R2.Top + nTop;
    end;

    AOwner := nil;

    if btOwner in [0, 1] then begin
      AOwner := FrmDlg.DBackground;
    end else if btOwner = 2 then begin
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DStateForm1
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DStateBasic;
    end else if btOwner = 3 then begin
      AOwner := TSerialWindows(FrmDlg).DItemBag;
    end else if btOwner = 4 then begin
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DHeroStateForm1
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DHeroStateBasic;
    end else if btOwner = 5 then begin
      AOwner := TSerialWindows(FrmDlg).DHeroItemBag;
    end else if btOwner = 6 then begin
      AOwner := TSerialWindows(FrmDlg).DMainBottomDlg; // 聊天框左侧
    end else if btOwner = 7 then begin
      AOwner := TSerialWindows(FrmDlg).DMainBottomDlg; // 聊天框右侧
    end else if btOwner = 8 then begin
      AOwner := TSerialWindows(FrmDlg).DShopDlg; // 个人商铺
    end else if btOwner = 9 then begin
      if not g_ClientConfig.boUseOldSerialWindows then begin
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DStateFashion; // 时装
      end
    end else if btOwner = 10 then begin
      if not g_ClientConfig.boUseOldSerialWindows then
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DHeroStateFashion;
    end else if btOwner = 11 then begin
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DStateTabSheet4
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DStateTabSheet6;
    end else if btOwner = 12 then begin
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DHeroStateTabSheet4
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DHeroStateTabSheet6;
    end else if btOwner = 13 then begin
      if (not g_ClientConfig.boUseOldSerialWindows) then begin
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DStateTitle;
      end
    end else if btOwner = 14 then begin
      if (not g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DHeroStateTitle;
    end else if btOwner = 15 then begin
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DStateForm2
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DStateInfo;
    end else if btOwner = 16 then begin
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DHeroStateForm2
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DHeroStateInfo;
    end else if btOwner = 17 then begin
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DStateForm3
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DStateAbil;
    end else if btOwner = 18 then begin
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DHeroStateForm3
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DHeroStateAbil;
    end else if btOwner = 19 then begin
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DStateForm5
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DStateDeputyHero;
    end else if btOwner = 20 then begin
      if not g_ClientConfig.boOpenNewGuild then
        AOwner := TSerialWindows(FrmDlg).DGuildDlg
      else
        AOwner := TSerialWindows(FrmDlg).DGuildManageDlg;
    end else if btOwner = 21 then begin
      if not g_ClientConfig.boUseOldSerialWindows then begin
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DStateWinEx; // 详细信息
      end
    end else if btOwner = 22 then begin
      if not g_ClientConfig.boUseOldSerialWindows then begin
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DSWPetsDlg; // 宠物界面
      end
    end else if btOwner = 23 then begin
      if not g_ClientConfig.boUseOldSerialWindows then begin
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DSWPetsBagDlg; // 宠物背包
      end
    end else if btOwner = 24 then begin // 人物首饰
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DSWJewelryBoxDlg
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DSWJewelryBoxDlg;
    end else if btOwner = 25 then begin // 英雄首饰
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DHeroSWJewelryBoxDlg
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DHeroSWJewelryBoxDlg;
    end else if btOwner = 26 then begin // 人物神佑
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DSWGodBlessDlg
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DSWGodBlessDlg;
    end else if btOwner = 27 then begin // 英雄神佑
      if (g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DHeroSWGodBlessDlg
      else
        AOwner := TStateWindows(TSerialWindows(FrmDlg).NewStateWindows).DHeroSWGodBlessDlg;
    end else if btOwner = 29 then begin
      if (not g_ClientConfig.boUseOldSerialWindows) then
        AOwner := TSerialWindows(FrmDlg).DMultiMemo;
    end else if btOwner = 30 then begin
        AOwner := TSerialWindows(FrmDlg).DMinMapBigDlg; //HZQ 20230609 添加对话框扩展到小地图窗口     
    end;

    if AOwner = nil then
      Exit;

    CurForm := nil;
    for I := 0 to g_NewDlgList.Count - 1 do begin
      DxForm := g_NewDlgList.Items[I];
      if DxForm.Tag = nDlgIndex then begin
        if DxForm.Owner <> AOwner then begin
          g_NewDlgList.Delete(I);
          DxForm.Free;
        end else begin
          CurForm := DxForm;
        end;
        Break;
      end;
    end;

    if CurForm = nil then begin
      CurForm := TDxImageForm.Create(AOwner);
      CurForm.Tag := nDlgIndex;
      g_NewDlgList.Add(CurForm);
    end;

    g_EffectImageList.Lock;
    try
      if (nFileIndex >= 0) and (nFileIndex < g_EffectImageList.Count) then begin
        GameImages := TGameImages(g_EffectImageList.Objects[nFileIndex]);
        if GameImages <> nil then begin
          CurForm.ImageIndex.Image := GameImages;
        end;
      end;
    finally
      g_EffectImageList.UnLock;
    end;

    CurForm.OnMouseMove := FrmDlg.DMouseMoveClearHints;
    CurForm.ImageIndex.Up := nImageIndex;
    CurForm.Designing := False;
    CurForm.NoMove := not boCanMove;
    CurForm.Left := nLeft;
    CurForm.Top := nTop;
    CurForm.Show;
    FrmDlg.AddNpcMemo(CurForm, ptTextOffset.X, ptTextOffset.Y, AddDlgItemClick, sData, True, True);
    CurForm.BringToFront;
