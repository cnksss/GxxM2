procedure TfrmMain.PetUseItem(idx:Integer);
begin
  if g_CurrentRecallGamePetIndex < 0 then begin
    DScreen.AddChatBoardString(DecodeResStr(SPetMsg1), clRed, clBlack);
    Exit;
  end;

  if idx in [0..MAX_GAMEPET_BAG_COUNT - 1] then begin
    if (g_PetUseingItem.S.Name <> '') and (MyGetTickCount - g_dwPetUseingTime > 5 * 1000) then begin
      g_PetUseingItem.S.Name := '';
    end;

    if (g_PetUseingItem.S.Name = '') and (g_PetItemArr[idx].S.Name <> '') and ((g_PetItemArr[idx].S.StdMode in [0, 31, 49, 93])) then begin
      g_PetUseingItem := g_PetItemArr[idx];
      g_PetItemArr[idx].S.Name := '';
      if (g_PetItemArr[idx].S.StdMode = 93) then begin
        if mrYes <> FrmDlg.DMessageDlg(Format(DecodeResStr(SPetMsg2), [g_PetItemArr[idx].S.Name]), [mbYes, mbNo]) then begin
          g_PetItemArr[idx] := g_PetUseingItem;
          Exit;
        end;
      end;

      // DScreen.AddChatBoardString('TfrmMain.EatItem:' + IntToStr(nIndex) + ' ' + g_PetUseingItem.S.Name, clWhite, clPurple);
      g_dwPetUseingTime := MyGetTickCount;
      SendPetUseItem(g_PetUseingItem.MakeIndex, g_PetUseingItem.s.Name);
      ItemUseSound(g_PetUseingItem.s);
    end
    else if (g_PetUseingItem.S.Name = '') and (g_PetItemArr[idx].S.Name <> '') and (g_PetItemArr[idx].S.StdMode = 31) then begin // 自动吃药
      g_PetUseingItem := g_PetItemArr[idx];
      g_PetItemArr[idx].S.Name := '';

      g_dwPetUseingTime := MyGetTickCount;
      SendPetUseItem(g_PetUseingItem.MakeIndex, g_PetUseingItem.s.Name);
      ItemUseSound(g_PetUseingItem.s);
    end;
  end
  else begin
    if (idx = -1) and g_boItemMoving then begin
      g_boItemMoving := False;
      g_PetUseingItem := g_MovingItem.Item;
      g_MovingItem.Item.S.Name := '';

      if (g_PetUseingItem.S.StdMode = 93) then begin
        if mrYes <> FrmDlg.DMessageDlg(Format(DecodeResStr(SPetMsg2), [g_PetUseingItem.S.Name]), [mbYes, mbNo]) then begin
          AddPetItemBag(g_PetUseingItem);
          Exit;
        end;
      end;

      g_dwPetUseingTime := MyGetTickCount;
      SendPetUseItem(g_PetUseingItem.MakeIndex, g_PetUseingItem.S.Name);
      ItemUseSound(g_PetUseingItem.S);
    end;
  end;
end;

