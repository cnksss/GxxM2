procedure TfrmMain.ProcessMessageMapDescription(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  sTitle:string;
  sMusic, sFileName:string;
  sOldMapTitle:string;
  Index:Integer;
  GroupMember:PGroupMember;
begin
  g_boMapNight := DefMsg.Recog = 1;

  sData := DecodeString(sData);
  sData := GetValidStr3_Ex(sData, sTitle, #13);
  sData := GetValidStr3_Ex(sData, sMusic, #13);

  if (CompareText(g_sMapTitleA, sTitle) <> 0) then begin
    PlayMapMusic(False);
  end;

  sOldMapTitle := g_sMapTitle;
  g_sMapTitleA := sTitle;
  g_sMapTitle := sTitle;

  // 人物英雄百分比显示血量 chongchong 2016-10-11
  g_boMapHumAndHeroPercentHP := DefMsg.Param <> 0;

  // DebugOutStr('ProcessMessageMapDescription '+g_sMapTitle);

  ClearMsg(RCM_PLAYMAPMUSIC);
  sFileName := GetAbsolutePathEx(g_sSelfFilePath, sMusic);
  if (not SameText(sFileName, g_sMapMusic)) or (not SameText(sOldMapTitle, g_sMapTitle)) then begin
    g_sMapMusic := sFileName;

    if FileExists(g_sMapMusic) then begin
      if PlugInEnabled and g_ClientConfig.boBGMusic and g_ConfigDlg.ConfigCheckeds[ckBGMusic] then begin
        if g_boLoadUserConfig then
          PlayMapMusic(True)
        else
          SendDelayMsg(g_MySelf, RCM_PLAYMAPMUSIC, 0, 0, 0, 0, '', 2000);
      end;
    end
    else if (Length(sMusic) > 0) and g_boAutoUpdate and (g_UpdateEngine <> nil) then begin
      if PlugInEnabled and g_ClientConfig.boBGMusic and g_ConfigDlg.ConfigCheckeds[ckBGMusic] then begin
        g_UpdateEngine.Add(g_sMapMusic, udtFileWav, -1, nil, nil);
        SendDelayMsg(g_MySelf, RCM_PLAYMAPMUSIC, 0, 0, 0, 0, '', 2000);
      end;
    end;
  end;

  if g_MySelf <> nil then begin
    for Index := 0 to g_GroupMembers.Count - 1 do begin
      GroupMember := g_GroupMembers.Items[Index];
      if GroupMember.nRecogId = g_MySelf.m_nRecogId then begin
        GroupMember.sMapName := g_sMapName;
        GroupMember.sMapDesc := g_sMapTitle;
        FrmDlg.RefreshNewGroupMember(Index);
        Break;
      end;
    end;
  end;
end;

