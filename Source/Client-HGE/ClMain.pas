    MaxMP := Actor.m_Abil.MaxMP;
    Level := Actor.m_Abil.Level;
    HP := Actor.m_Abil.HP;
    MP := LongInt(MakeLong(DefMsg.param, DefMsg.tag));

    if Length(sData) = SizeOf(TNewMessageBodyWL) then begin
      NewMessageBodyWL := pTNewMessageBodyWL(sData);
      HP := LongInt(NewMessageBodyWL.lParam1);
      MaxHP := LongInt(NewMessageBodyWL.lParam2);
      HideHPMP := NewMessageBodyWL.lTag1; // 血量改变
      Level := NewMessageBodyWL.lTag2; // 等级
      MaxMP := NewMessageBodyWL.lTag3; // 蓝最大值
      //nHpNmResID := NewMessageBodyWl.ResID; //HZQ 20230609 本消息使用默认的资源ID
      //nHpNmResStartIdx := NewMessageBodyWl.ResIdx;
      Actor.m_btJob := LoByte(DefMsg.Series);
    end;

    if Actor.m_Abil.MaxHP > 0 then begin
      g_ConfigDlg.HealthChange(Actor, HP, MP, MaxHP);

      { TODO -ochongchong -c修改 : 客户端处理飘血叠加 【2013-08-20】}
      //HZQ 20230816 分开淡出选项
      if (Cardinal(HP) <> Actor.m_Abil.HP) and (LoByte(HideHPMP) = 0) then begin
        if (not g_ClientConfig.boHealthNumberText) then begin
            Actor.AddHealthNumber(tHP, HP - Integer(Actor.m_Abil.HP), nHpNmResID, nHpNmResStartIdx, ndsNormal);
        end else begin
            Actor.AddHealthNumber(tHP, HP - Integer(Actor.m_Abil.HP), nHpNmResID, nHpNmResStartIdx, ndsStayFadeOut);
        end;
      end;

      //HZQ 20230816 分开淡出选项
      if (Cardinal(MP) <> Actor.m_Abil.MP) and (HiByte(HideHPMP) = 0) then begin
        if (not g_ClientConfig.boHealthNumberText) then begin
            Actor.AddHealthNumber(tMP, MP - Integer(Actor.m_Abil.MP), nHpNmResID, nHpNmResStartIdx, ndsNormal);
        end else begin
            Actor.AddHealthNumber(tMP, MP - Integer(Actor.m_Abil.MP), nHpNmResID, nHpNmResStartIdx, ndsStayFadeOut);
        end;
      end;
    end;
    Actor.m_Abil.MaxHP := MaxHP;
    Actor.m_Abil.MaxMP := MaxMP;
    Actor.m_Abil.Level := Level;
    Actor.m_Abil.HP := HP;
    Actor.m_Abil.MP := MP;

    // 修复人物满血之后，调用AddHumNewValue 7 = 20 18血条显示不正常
    if Actor.m_Abil.HP > Actor.m_Abil.MaxHP then begin
      Actor.m_Abil.HP := Actor.m_Abil.MaxHP;
    end;

    FrmDlg.RefreshGuardianLevelStatueMonHP(Actor);
  end;

  if g_ClientConfig.boShowNewGroupInfo then begin
    if Length(sData) = SizeOf(TNewMessageBodyWL) then begin
      for nIndex := 0 to g_GroupMembers.Count - 1 do begin
        GroupMember := g_GroupMembers.Items[nIndex];
        if GroupMember.nRecogId = DefMsg.Recog then begin
          NewMessageBodyWL := pTNewMessageBodyWL(sData);

          //nHpNmResID := NewMessageBodyWl.ResID; //HZQ 20230609 本消息使用默认的资源ID
          //nHpNmResStartIdx := NewMessageBodyWl.ResIdx;

          GroupMember.HP := LongInt(NewMessageBodyWL.lParam1);
          GroupMember.MaxHP := LongInt(NewMessageBodyWL.lParam2);

          //ChangeHP := NewMessageBodyWL.lTag1;     // 血量改变

          GroupMember.Level := NewMessageBodyWL.lTag2; // 等级
          GroupMember.MaxMP := NewMessageBodyWL.lTag3; // 蓝最大值

          GroupMember.MP := LongInt(MakeLong(DefMsg.param, DefMsg.tag));

          FrmDlg.RefreshNewGroupMember(nIndex);
          //GroupMember.Job := LoByte(DefMsg.Series);
          Break;
        end;
      end;
    end;
  end;

  if Actor = g_MySelf then begin
    FrmDlg.MySelfAbilChange;
    g_ConfigDlg.RefreshMySelfAbil;
  end;

  {$IF IsMultiThreadRender = 1}
  EnterCriticalSection(g_ActorLock);
  try
    {$IFEND}
    if Actor = g_MyHero then begin
      FrmDlg.MyHeroAbilChange;
      g_ConfigDlg.RefreshMyHeroAbil;
    end;
    {$IF IsMultiThreadRender = 1}
  finally
    LeaveCriticalSection(g_ActorLock);
  end;
  {$IFEND}
end;

procedure TfrmMain.ProcessMessageStruck(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Actor, ActorAttack:TActor;
  NewMessageBodyWL:pTNewMessageBodyWL;
  nDamageHP:Integer;
  nIndex:Integer;
  GroupMember:PGroupMember;
  nHpNmResID, nHpNmResStartIdx:Integer; //HZQ 20230609 自定义飘血资源编号
begin
   nHpNmResID := -1; nHpNmResStartIdx := -1;  //HZQ 20230609 本消息使用默认的资源ID

  if Length(sData) = SizeOf(TNewMessageBodyWL) then begin
    NewMessageBodyWL := pTNewMessageBodyWL(sData);

    Actor := PlayScene.FindActor(DefMsg.Recog);
    {$IF IsMultiThreadRender = 1}
    EnterCriticalSection(g_ActorLock);
    try
      {$IFEND}
      if (Actor = nil) and (g_MyHero <> nil) and (g_MyHero.m_nRecogId = DefMsg.Recog) then
        Actor := g_MyHero;
      {$IF IsMultiThreadRender = 1}
    finally
      LeaveCriticalSection(g_ActorLock);
    end;
    {$IFEND}

    if g_ClientConfig.boShowNewGroupInfo then begin
      for nIndex := 0 to g_GroupMembers.Count - 1 do begin
        GroupMember := g_GroupMembers.Items[nIndex];
        if GroupMember.nRecogId = DefMsg.Recog then begin
          NewMessageBodyWL := pTNewMessageBodyWL(sData);
          //nHpNmResID := NewMessageBodyWL.ResID;  //本消息不处理，使用默认值
          //nHpNmResStartIdx := NewMessageBodyWL.ResIdx;

          GroupMember.HP := LongInt(NewMessageBodyWL.lParam1);
          GroupMember.MaxHP := LongInt(NewMessageBodyWL.lParam2);

          GroupMember.Level := NewMessageBodyWL.lTag2; // 等级
          GroupMember.MaxMP := NewMessageBodyWL.lTag3; // 蓝最大值
          //GroupMember.MP := MakeLong(DefMsg.param, DefMsg.tag);

          FrmDlg.RefreshNewGroupMember(nIndex);

          Break;
        end;
      end;
    end;

    if Actor <> nil then begin
      Actor.m_boStruckShowNumber := True;

      if Actor = g_MySelf then begin
        if g_MySelf.m_nNameColor = 249 then
          g_dwLatestStruckTick := MyGetTickCount;
        g_nRunReadyCount := 0; // 被攻击需要重新助跑
      end else begin
        if Actor.CanCancelAction then
          Actor.CancelAction;
      end;

      if (Actor <> g_MySelf) or (not (PlugInEnabled and g_ClientConfig.boDisableSelfStruck and g_ConfigDlg.ConfigCheckeds[ckDisableSelfStruck])) then begin
        Actor.UpdateStruckMsg(SM_STRUCK, LoByte(DefMsg.Series), 0, // MessageBodyWL.lTag2
          MakeLong(DefMsg.param, DefMsg.tag), Actor.m_Feature, NewMessageBodyWL.lTag4, '', NewMessageBodyWL.lTag5);
      end;

      g_ConfigDlg.Struck(Actor, NewMessageBodyWL.lParam1, NewMessageBodyWL.lParam2);

      // 挂机受到人物攻击回城 chongchong 2014-11-26
      if g_boGJRun and (Actor = g_MySelf) and g_ConfigDlg.ConfigCheckeds[ckGJ_PlayAttack] then begin
        // 受到人物攻击
        if NewMessageBodyWL.lTag5 <> 0 then begin
          // 反击
          if nGJPlayAttackOption = g_NGProtectItems.Count - 2 then begin
            ActorAttack := PlayScene.FindActor(NewMessageBodyWL.lTag5);
            if ActorAttack <> nil then begin
              if FGJTargetCret <> ActorAttack then begin
                FGJTargetCretTick := MyGetTickCount;
              end;
              FGJTargetCret := ActorAttack;
              FGJTargetMapName := g_sMapName;
            end;
            Exit;
          end
          else // 小退
            if nGJPlayAttackOption = g_NGProtectItems.Count - 1 then begin
              g_IsWaitLogout := True;
              StopGJ;
              frmMain.Logout;
              Exit;
            end
            else if (nGJPlayAttackOption >= 0) and (nGJPlayAttackOption < g_NGProtectItems.Count) then begin
              nIndex := FindHumBookItemIndex(g_NGProtectItems.Strings[nGJPlayAttackOption]);
              if nIndex >= 0 then begin
                frmMain.AutoEatItem(nIndex);

                {
                if (g_ItemArr[nIndex].s.StdMode <> 31) and
                  // 随机传送卷也不停止挂机chongchong 2016-08-02
                  (not ((g_ItemArr[nIndex].s.StdMode = 3) and (g_ItemArr[nIndex].s.Shape = 2))) and
                  // 随机传送石也不停止挂机chongchong 2016-08-02
                  (not ((g_ItemArr[nIndex].s.StdMode = 2) and (g_ItemArr[nIndex].s.Shape = 2))) then
                begin
                  StopGJ;
                  Exit;
                end;
                }
              end;
            end;
        end;
      end;

      { TODO -ochongchong -c修改 : 修改打怪下血的飘血效果,经常显示出为几次伤害叠加的效果 【2013-07-24】}
      //nDamageHP := Actor.m_Abil.HP - MessageBodyWL.lParam1;
      { 注意：上面的算法是由客户端的血值减去服务器发过来当前血值计算，
        如果中间掉包，则会出现客户端血值减服务器端血值过大 }

      Actor.m_Abil.MaxHP := NewMessageBodyWL.lParam2;

      nDamageHP := NewMessageBodyWL.lTag1;
      //nDamageHP := -nDamageHP;
      // 攻击者等级 chongchong 2014-10-27
      Actor.m_Abil.Level := NewMessageBodyWL.lTag2;
      Actor.m_Abil.MaxMP := NewMessageBodyWL.lTag3;

      if Actor.m_Abil.MaxHP > 0 then begin
        if not g_ClientConfig.boHealthNumberText then begin
          if (nDamageHP > 0) then begin
            case NewMessageBodyWL.BlastHitType of
              bhtBlastHit:
                Actor.AddHealthNumber(tBlastHP, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
              bhtFatalBlow1:
                Actor.AddHealthNumber(tFatalBlow1, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
              bhtFatalBlow2:
                Actor.AddHealthNumber(tFatalBlow2, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
              bhtFatalBlow3:
                Actor.AddHealthNumber(tFatalBlow3, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
              bhtFatalBlow4:
                Actor.AddHealthNumber(tFatalBlow4, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
              else
                //if (nDamageHP > Actor.m_Abil.MaxHP * 10 div 100) then begin
                if (nDamageHP > Integer(Actor.m_Abil.MaxHP) * 10 div 100) then begin//HZQ 20230523
                  Actor.AddHealthNumber(tGreen, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsNormal)
                end else begin
                  Actor.AddHealthNumber(tHP, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsNormal);
                end;
            end;
          end;
        end else begin
          case NewMessageBodyWL.BlastHitType of
            bhtBlastHit:
              Actor.AddHealthNumber(tBlastHP, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
            bhtFatalBlow1:
              Actor.AddHealthNumber(tFatalBlow1, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
            bhtFatalBlow2:
              Actor.AddHealthNumber(tFatalBlow2, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
            bhtFatalBlow3:
              Actor.AddHealthNumber(tFatalBlow3, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
            bhtFatalBlow4:
              Actor.AddHealthNumber(tFatalBlow4, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
            else
              if not g_ClientConfig.boBlastHitShowHealthNum then
                Actor.AddHealthNumber(tTextHP, -nDamageHP, nHpNmResID, nHpNmResStartIdx, ndsMovingFadeOut);
          end;
        end;
      end;

      Actor.m_Abil.HP := NewMessageBodyWL.lParam1;

      if Actor = g_MySelf then begin
        FrmDlg.MySelfAbilChange;
        g_ConfigDlg.RefreshMySelfAbil;
      end;

      FrmDlg.RefreshGuardianLevelStatueMonHP(Actor);

      {$IF IsMultiThreadRender = 1}
      EnterCriticalSection(g_ActorLock);
      try
        {$IFEND}
        if Actor = g_MyHero then begin
          FrmDlg.MyHeroAbilChange;
          g_ConfigDlg.RefreshMyHeroAbil;
        end;
        {$IF IsMultiThreadRender = 1}
      finally
        LeaveCriticalSection(g_ActorLock);
      end;
      {$IFEND}
    end;
  end;
end;

procedure TfrmMain.ProcessMessageChangeFace(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I64:Int64;
  P:PAnsiChar;
  Actor:TActor;
  Feature:TFeature;
  CharDesc:pTCharDesc;
begin
  if Length(sData) >= SizeOf(TCharDesc) then begin
    P := PAnsiChar(sData);

    I64 := PInt64(P)^;

    Inc(P, SizeOf(I64));
    CharDesc := pTCharDesc(P);

    if (CharDesc.Feature > 0) and (Length(sData) >= SizeOf(TCharDesc) + CharDesc.Feature) then begin
      Feature.Feature := CharDesc.Feature;
      Move(sData[1 + SizeOf(I64) + SizeOf(TCharDesc)], Feature.Buffer[0], Feature.Feature);

      Actor := PlayScene.FindActor(DefMsg.Recog);
      if Actor <> nil then begin
        Actor.m_nWaitForRecogId := I64;
        Actor.m_WaitForFeature := Feature;
        Actor.m_nWaitForStatus := CharDesc.Status;
        AddChangeFace(Actor.m_nWaitForRecogId);
        if (Actor.m_btRace = RC_PLAYOBJECT) then begin
          if (Actor <> g_MySelf) then begin
            Actor.m_btJob := pTHumFeature(@Feature.Buffer).btJob;
          end;
          // Actor.m_boStartStore := pTHumFeature(@Feature.Buffer).boStore;
        end;
      end;
    end;
  end;
end;

