procedure TfrmMain.ProcessMessageDelArrButton(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  ImageButton:TDxImageButton;
begin
  for I := 0 to g_ArrButtonList.Count - 1 do begin
    ImageButton := TDxImageButton(g_ArrButtonList.Items[I]);
    if ImageButton.Tag = DefMsg.Param then begin
      g_ArrButtonList.Delete(I);
      ImageButton.Free;
      Break;
    end;
  end;

  RearrangeArrButton;
end;

procedure TfrmMain.ProcessMessageAddNumberButton(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);

  procedure GetNumberImageSize(nImageIndex, CharSpace:Integer; S:string; var Pt:TPoint);
  var
    II, nIndex:Integer;
    Texture:TTexture;
  begin
    Pt.X := 0;
    Pt.Y := 0;
    if (nImageIndex < 0) or (nImageIndex > 9) then
      Exit;

    if (g_WNewopUIImages = nil) or (Length(S) = 0) then
      Exit;
    for II := 1 to Length(S) do begin
      nIndex := 1230 + (nImageIndex * 10) + StrToInt(S[II]);
      Texture := g_WNewopUIImages.Images[nIndex];
      if Texture <> nil then begin
        if Pt.Y < Texture.Height then
          Pt.Y := Texture.Height;
        Pt.X := Pt.X + Texture.Width + CharSpace;
      end;
    end;
  end;

var
  I:Integer;
  nLen:Integer;
  sCaption, sHintMsg:string;
  nNumberIndex, nTag, nLeft, nTop, nSpace:SmallInt;
