  boFloating:Boolean;
  R1, R2:TRect;
begin
  boFloating := False;
  nLen := Length(sData);
  if nLen < g_nShortMessage then
    Exit;

  DecodeString(sData, @ShortMessage, SizeOf(TShortMessage));
  sData := Copy(sData, g_nShortMessage + 1, Length(sData) - g_nShortMessage);
  sData := DecodeString(sData);
  nLen := Pos(#13, sData);
  btCaptionColor := 255;
  if nLen > 0 then begin
    sCaption := Copy(sData, 1, nLen - 1);
    sHintMsg := Copy(sData, nLen + 1, Length(sData) - nLen);

    sCaption := GetValidStr3_Ex(sCaption, sColor, '#');
    if sCaption = '' then begin
      btCaptionColor := 255;
      sCaption := sColor;
    end else begin
      btCaptionColor := StrToIntDef(sColor, 0);
    end;
  end else begin
    sCaption := '';
    sHintMsg := sData;
  end;

  sCaption := StringReplace(sCaption, '\', sLineBreak, [rfReplaceAll]);

  nFileIndex := LoWord(DefMsg.Recog);
  nTag := LoByte(HiWord(DefMsg.Recog));
  btMove := HiByte(HiWord(DefMsg.Recog));
  nUpImage := SmallInt(DefMsg.Param);
  nHotImage := SmallInt(DefMsg.Tag);
  nTop := SmallInt(DefMsg.Series);
  nDownImage := SmallInt(ShortMessage.Ident);
  nLeft := SmallInt(ShortMessage.wMsg);

  if btMove >= 200 then begin
    boFloating := btMove mod 100 = 1;
    btMove := btMove div 100;
  end;

  // 聊天框左侧
  if btMove = 6 then begin
    R1 := TSerialWindows(FrmDlg).DMainBottomDlg.GetLeftRect;
    R2 := TSerialWindows(FrmDlg).DMainBottomDlg.VirtualRect;
    nLeft := R1.Left - R2.Left + nLeft;
    nTop := R1.Top - R2.Top + nTop;
  end else if btMove = 7 then begin // 聊天框右侧
    R1 := TSerialWindows(FrmDlg).DMainBottomDlg.GetRightRect;
    R2 := TSerialWindows(FrmDlg).DMainBottomDlg.VirtualRect;
    nLeft := R1.Left - R2.Left + nLeft;
    nTop := R1.Top - R2.Top + nTop;
  end;

  //ImageButton := nil; HZQ 20230524

  //找到已存在的按钮后，修改定义然后退出
  for I := 0 to g_ButtonList.Count - 1 do begin
    ImageButton := TDxImageButtonEx(g_ButtonList.Items[I]);
    if ImageButton.Tag = nTag then begin
      ImageButton.Left := nLeft;
      ImageButton.Top := nTop;

      ImageButton.CaptionColor.Up.Color := GetRGB(btCaptionColor);
      ImageButton.CaptionColor.Down.Color := GetRGB(btCaptionColor);
      ImageButton.CaptionColor.Hot.Color := GetRGB(btCaptionColor);
      ImageButton.Caption := sCaption;

      ImageButton.Hint := sHintMsg;
      ImageButton.OnClick := ImageButtonClick;
      ImageButton.OnMouseMove := ImageButtonMouseMove;

      ImageButton.ImageIndex.BeginUpdate;
      try
        g_EffectImageList.Lock;
        try
          if (nFileIndex >= 0) and (nFileIndex < g_EffectImageList.Count) then begin
            GameImages := TGameImages(g_EffectImageList.Objects[nFileIndex]);
