procedure TfrmMain.ProcessMessageQueryMyShopSellingItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  UserShopItem:pTClientUserShopItem;
  ListItem:TDxListItem;
  ViewItem:pTViewItem;
begin
  g_MyShopItemIndexs[0] := DefMsg.Param;
  g_MyShopItemCounts[0] := DefMsg.Recog;
  for I := 0 to 4 do begin
    g_MyShopItems[0, I].sShopName := '';
    g_MyShopItems[0, I].sMasterName := '';
    g_MyShopItems[0, I].Item.s.Name := '';
  end;
  FrmDlg.SetMyShopPageCount;

  if (DefMsg.Series > 0) and (Length(sData) = DefMsg.Series * SizeOf(TClientUserShopItem)) then begin
    UserShopItem := pTClientUserShopItem(sData);
    for I := 0 to DefMsg.Series - 1 do begin
      if I >= Length(g_MyShopItems[0]) then
        Break;

      g_MyShopItems[0, I] := UserShopItem^;

      Inc(UserShopItem);
    end;
  end;

  if FrmDlg is TSerialWindows then begin
    TSerialWindows(FrmDlg).ListViewMyShopSelling.Clear;
    TSerialWindows(FrmDlg).ListViewMyShopSelling.Lock;
    try
      for I := 0 to 4 do begin
        if g_MyShopItems[0, I].sMasterName <> '' then begin

          ListItem := TSerialWindows(FrmDlg).ListViewMyShopSelling.Add;

          ViewItem := ListItem.AddItem('', nil); // 物品        showmessage('');

          ViewItem.ImageIndex.BeginUpdate;
          try
            ViewItem.ImageIndex.Image := g_WBagItemImages.Indexs[g_MyShopItems[0, I].Item.s.Looks div 10000];
            ViewItem.ImageIndex.Up := g_MyShopItems[0, I].Item.s.Looks mod 10000;
          finally
            ViewItem.ImageIndex.EndUpdate;
          end;

          ViewItem := ListItem.AddItem('', nil); // 物品名称

          if g_MyShopItems[0, I].btAllowSell = 2 then begin
