procedure TfrmMain.ProcessMessageOpenClientDlg(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  IsSetPos:Boolean;
  Pos:TPoint;
begin
  IsSetPos := DefMsg.Param <> 0;
  Pos.X := LoWord(DefMsg.Tag);
  Pos.Y := HiWord(DefMsg.Tag);
  //  DefMsg.Series
  case DefMsg.Recog of
    1: {// 系统商铺} begin
        //        if (not TSerialWindows(FrmDlg).DShopDlg.Visible and (DefMsg.Series = 2)) or
        if ((not TSerialWindows(FrmDlg).DShopDlg.Visible or (DefMsg.Series = 0)) and (DefMsg.Series <> 1)) then
          FrmDlg.OpenDShopDlg
        else
          FrmDlg.CloseDShopDlg;
        if FrmDlg is TSerialWindows then begin
          if IsSetPos then begin
            TSerialWindows(FrmDlg).DShopDlg.Left := Pos.X;
            TSerialWindows(FrmDlg).DShopDlg.Top := Pos.Y;
          end;
        end;
      end;
    2: {// 个人商店} begin
        if not FrmDlg.CheckDGameShopDlgVisible then begin
          if (TSerialWindows(FrmDlg).DGameShopDlg.Visible or (DefMsg.Series = 0)) and (DefMsg.Series <> 1) then
            FrmDlg.OpenDGameShopDlg
          else
            FrmDlg.CloseDGameShopDlg;
        end;
        //SendClientMessage(CM_QUERYUSERSHOPS, 0, 0, 0, 0);
        if FrmDlg is TSerialWindows then begin
          if IsSetPos then begin
            TSerialWindows(FrmDlg).DGameShopDlg.Left := Pos.X;
            TSerialWindows(FrmDlg).DGameShopDlg.Top := Pos.Y;
          end;
          TSerialWindows(FrmDlg).DMyShopPageControl.ActivePageIndex := 0;
          TSerialWindows(FrmDlg).DGameShopPageControl.ActivePageIndex := 0;
        end;
      end;
    3: {// 任务} begin
        if not IsSetPos then
          FrmDlg.OpenDMissionDlg(0, 0)
        else
          FrmDlg.OpenDMissionDlg(Pos.X, Pos.Y);
      end;
    4: {// 日志} begin
        frmMain.SendDActionLogClick;
      end;
    5: {// 小地图} begin
        if FrmDlg is TSerialWindows then begin
          FrmDlg.BotMiniMapClick(TSerialWindows(FrmDlg).DBotMiniMap, 0, 0);
        end;
      end;
    6: {// 交易} begin
        if MyGetTickCount > g_dwQueryMsgTick then begin
          g_dwQueryMsgTick := MyGetTickCount + 3000;
          frmMain.SendDealTry;
        end;
      end;
    7: {// 行会} begin
        if FrmDlg is TSerialWindows then begin
          if TSerialWindows(FrmDlg).DGuildDlg.Visible then begin
            TSerialWindows(FrmDlg).DGuildDlg.Visible := False;
          end
          else if MyGetTickCount > g_dwQueryMsgTick then begin
            g_dwQueryMsgTick := MyGetTickCount + 3000;
            SendGuildDlg;
          end;

          TSerialWindows(FrmDlg).DGroupDlg.Left := Pos.X;
          TSerialWindows(FrmDlg).DGroupDlg.Top := Pos.Y;
        end;
      end;
    8: {// 组队} begin
        if FrmDlg is TSerialWindows then begin
          TSerialWindows(FrmDlg).DGroupDlg.Visible := not TSerialWindows(FrmDlg).DGroupDlg.Visible;
          TSerialWindows(FrmDlg).DGrpShowNewGroupInfo.Checked := g_ConfigDlg.ConfigCheckeds[ckShowNewGroupInfo];

          if IsSetPos then begin
            TSerialWindows(FrmDlg).DGroupDlg.Left := Pos.X;
            TSerialWindows(FrmDlg).DGroupDlg.Top := Pos.Y;
          end;
        end;
      end;
    9: {// 关系} begin
        if FrmDlg is TSerialWindows then begin
          TSerialWindows(FrmDlg).DFriendDlg.Visible := not TSerialWindows(FrmDlg).DFriendDlg.Visible;

          if IsSetPos then begin
            TSerialWindows(FrmDlg).DFriendDlg.Left := Pos.X;
            TSerialWindows(FrmDlg).DFriendDlg.Top := Pos.Y;
          end;
        end;
      end;
    10: {// 帮助} begin
        frmMain.SendClientMessage(CM_HELPBUTTONCLICK, 0, 0, 0, 0);
      end;
    11: {// 排行榜} begin
        if FrmDlg is TSerialWindows then begin
          TSerialWindows(FrmDlg).DRankingDlg.Visible := not TSerialWindows(FrmDlg).DRankingDlg.Visible;

          if IsSetPos then begin
            TSerialWindows(FrmDlg).DRankingDlg.Left := Pos.X;
            TSerialWindows(FrmDlg).DRankingDlg.Top := Pos.Y;
          end;
        end;
      end;
    12: {// 挑战} begin
        if MyGetTickCount > g_dwQueryMsgTick then begin
          g_dwQueryMsgTick := MyGetTickCount + 3000;
          frmMain.SendChallengeTry;
        end;
      end;
    13: {// 私聊信息} begin
        if FrmDlg is TSerialWindows then begin
          TSerialWindows(FrmDlg).DWhisperDlg.Visible := not TSerialWindows(FrmDlg).DWhisperDlg.Visible;

          if IsSetPos then begin
            TSerialWindows(FrmDlg).DWhisperDlg.Left := Pos.X;
            TSerialWindows(FrmDlg).DWhisperDlg.Top := Pos.Y;
          end;
        end;
      end;
    14: {// 属性点分配} begin
        FrmDlg.OpenDAdjustAbilityDlg;
        if FrmDlg is TSerialWindows then begin
          if IsSetPos then begin
            TSerialWindows(FrmDlg).DAdjustAbility.Left := Pos.X;
            TSerialWindows(FrmDlg).DAdjustAbility.Top := Pos.Y;
          end;
        end;
      end;
    15:begin
        if g_MySelf <> nil then begin
          g_ConfigDlg.Visible := not g_ConfigDlg.Visible;
        end;
      end;
    16:begin
        FrmDlg.OpenDMinMapBigDlg;
        if FrmDlg.CheckDMinMapBigDlgVisible and (g_nMiniMapIndex < 0) then begin
          frmMain.SendWantMiniMap;
        end;
      end;
  end;
end;

