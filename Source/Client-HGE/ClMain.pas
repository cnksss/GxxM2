        //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~关闭开天.', clRed, clBlack);
        {$IFEND}
      end;
    CM_66HIT1: {// 开天斩轻击 piaoyun 2013-08-24} begin
        g_boNextTime66Hit1 := False;
        {$IF TESTMODE = 1}
        //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~关闭开天.', clRed, clBlack);
        {$IFEND}
      end;
    CM_113HIT: {// 断空斩 chongchong 2018-01-29} begin
        g_boNextTime113Hit := False;
        {$IF TESTMODE = 1}
        //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~关闭断空斩.', clRed, clBlack);
        {$IFEND}
      end;
    CM_115HIT: {// 血魄一击(战) chongchong 2018-01-29} begin
        g_boNextTime115Hit := False;
        {$IF TESTMODE = 1}
        //DScreen.AddChatBoardString('~~~~~~~~~~~~~~~~~~~关闭血魄一击.', clRed, clBlack);
        {$IFEND}
      end;
