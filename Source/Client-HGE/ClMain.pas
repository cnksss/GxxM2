begin
  PlayScene.SendMsg(SM_DIGDOWN, DefMsg.Recog, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series, nil, 0, '');
end;

procedure TfrmMain.ProcessMessageShowEvent(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  event:TClEvent;
  MessageBodyWL:pTMessageBodyWL;
  EventData:pTEventData;
begin
  event := nil; //HZQ 解决变量未初始化的问题
  if LoByte(DefMsg.param) = ET_MAPEFFECT then begin
    if Length(sData) = SizeOf(TMessageBodyWL) then begin
      MessageBodyWL := pTMessageBodyWL(sData);
      event := TMapEffectEvent.Create(DefMsg.Recog, DefMsg.tag {x}, DefMsg.series {y}, LoWord(MessageBodyWL.lTag2), MessageBodyWL.lParam1, LoWord(MessageBodyWL.lParam2), MessageBodyWL.lTag1, HiWord(MessageBodyWL.lTag2), HiByte(DefMsg.param) = 1, HiWord(MessageBodyWL.lParam2));
      event.m_nDir := 0;
    end;
  end else if Length(sData) = SizeOf(EventData) then begin
    EventData := pTEventData(sData);
    if LoByte(DefMsg.param) = ET_CUSTOM_EFF then begin
      event := TCustomEffectEvent.Create(DefMsg.Recog, DefMsg.tag {x}, DefMsg.series {y}, LoByte(DefMsg.param) {e-type}, EventData.Data1 {appr}, EventData.Data2 {attackindex})
    end else if LoByte(DefMsg.param) = ET_CUSTOM_MAGIC_EFF then begin
      event := TCustomMagicEffectEvent.Create(DefMsg.Recog, DefMsg.tag {x}, DefMsg.series {y}, LoByte(DefMsg.param) {e-type}, EventData.Data1 {MagicID}, EventData.Data2 {NewLevel})
    end else begin
      event := TClEvent.Create(DefMsg.Recog, DefMsg.tag {x}, DefMsg.series {y}, LoByte(DefMsg.param) {e-type});

      event.m_boKeepShow := EventData.Data1 <> 0;
      event.m_nDir := EventData.Data2;

      event.m_nEventParam := HiByte(DefMsg.param);
      // if LoByte(DefMsg.param) in [ET_FIREFLOWER_1..ET_FIREFLOWER_8] then
      case LoByte(DefMsg.param) of
        ET_FIREFLOWER_1..ET_FIREFLOWER_8:event.m_dwFrameTickTime := 150; // 烟花播放时间
        ET_THUNDER {, ET_LAVA}:event.m_dwFrameTickTime := 80; // 地图闪电、岩浆播放时间  -- piaoyun 2013-07-10
        ET_FIREDRAGON, ET_FIREDRAGON2:event.m_dwFrameTickTime := 100;
        ET_THUNDER2:event.m_dwFrameTickTime := 80;
        ET_DEDING:event.m_dwFrameTickTime := 200;
        ET_SPRINGS1, ET_SPRINGS2, ET_SPRINGS3:event.m_dwFrameTickTime := 200;
        ET_SPRINGS_LIGHT:event.m_dwFrameTickTime := 80; // 修复火墙燃烧速度慢的问题 chongchong 2013-10-27
        ET_FIRE, ET_FIRELevel1, ET_FIRELevel2, ET_FIRELevel3:event.m_dwFrameTickTime := 40;
        else event.m_dwFrameTickTime := 150;
      end;
    end;
  end;

  if event <> nil then begin //HZQ 20230524解决变量未初始化的问题
    EventMan.AddEvent(event);
  end;
end;

