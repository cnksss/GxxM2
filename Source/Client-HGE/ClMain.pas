procedure TfrmMain.ImageButtonMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  vtRect:TRect;
  i:Integer;
  HintLines:THintLines;
  HintWindow:THintWindow;
  slLines:TStringList;
  sHintText, sHintColor:string;
  btHintColor:Byte;
begin
  if g_LastHintMakeIndex <> Integer(Sender) then begin
    DScreen.ClearHint;
    HintWindows.Clear;

    with Sender as TDxImageButton do begin
      if Length(Hint) <> 0 then begin
        vtRect := VirtualRect;
        HintWindow := THintWindow.Create;

        slLines := TStringList.Create;
        try
          slLines.Delimiter := '\';
          slLines.DelimitedText := Hint;
          for i := 0 to slLines.Count - 1 do begin
            //ShowMessage(slLines[i]);
            slLines[i] := GetValidStr3_Ex(slLines[i], sHintColor, '#');
            if slLines[i] = '' then begin
              btHintColor := 255;
              sHintText := sHintColor;
            end else begin
              sHintText := slLines[i];
              btHintColor := StrToIntDef(sHintColor, 0);
            end;
            HintLines := THintLines.Create;
            HintLines.Add(sHintText, GetRGB(btHintColor), GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke());
            HintWindow.Add(HintLines);
          end;
        finally
          slLines.Free;
        end;

        HintWindow.Show(vtRect.Left, vtRect.Bottom);

        HintWindows.Add(HintWindow);
      end;
    end;

    g_LastHintMakeIndex := Integer(Sender);
  end;
end;

procedure TfrmMain.ImageNumberButtonPaint(Sender:TObject); stdcall;
var
  S:string;
  Texture:TTexture;
  I, Index, PX, PY:Integer;
  Btn:TDxImageButton;
  R:TRect;
begin
  Btn := Sender as TDxImageButton;

  R := Btn.Owner.VisibleRect;
  if Btn.Owner.Left < 0 then
    R.Left := R.Left + Btn.Owner.Left;
  if Btn.Owner.Top < 0 then
    R.Top := R.Top + Btn.Owner.Top;

  PX := R.Left + Btn.Left;
  PY := R.Top + Btn.Top;

  S := IntToStr(Btn.ImageIndex.Hot);
  if (g_WNewopUIImages = nil) or (Length(S) = 0) then
    Exit;

  if (Btn.ImageIndex.Up < 0) or (Btn.ImageIndex.Up > 9) then
    Exit;

  for I := 1 to Length(S) do begin
    Index := 1230 + (Btn.ImageIndex.Up * 10) + StrToInt(S[I]);
    Texture := g_WNewopUIImages.Images[Index];
    if Texture <> nil then begin
      GameCanvas.Draw(PX, PY + (Btn.Height - Texture.Height) div 2, Texture);
      PX := PX + Texture.Width + Btn.ImageIndex.Down;
    end;
  end;
end;

procedure TfrmMain.ProcessMessageAddButton(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  nLen:Integer;
  ShortMessage:TShortMessage;
  sCaption, sHintMsg, sColor:string;
  btCaptionColor:Byte;
  nFileIndex, nTag, nUpImage, nHotImage, nDownImage, nLeft, nTop:SmallInt;
  btMove:Byte;
