procedure TfrmMain.ProcessMessageTradingSellItemsRet(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, II, III, nMakeIndex:Integer;
  SL:TStringList;
  pcg:PTClientGoods;
  IsFound:Boolean;
begin
  g_WantSellItems := False;

  if g_MySelf.m_nGold <> DefMsg.Recog then begin
    g_MySelf.m_nGold := DefMsg.Recog;
    SoundUtil.PlaySound(s_money);
  end;

  SL := TStringList.Create;
  try
    SL.Delimiter := #9;
    SL.DelimitedText := DecodeString(sData);

    for I := 0 to SL.Count - 1 do begin
      nMakeIndex := StrToIntDef(SL.Strings[I], 0);
      if nMakeIndex > 0 then begin
        for II := 0 to Length(g_SellDlgItems) - 1 do begin
          if g_SellDlgItems[II].MakeIndex = nMakeIndex then begin
            IsFound := False;
            for III := 0 to FrmDlg.MenuList.Count - 1 do begin
              pcg := FrmDlg.MenuList[III];
              if pcg.Name = g_SellDlgItems[II].S.DBName then begin
                IsFound := True;
                Break;
              end;
            end;

            if not IsFound then begin
              New(pcg);
              pcg.RealName := g_SellDlgItems[II].S.DBName;
              pcg.Name := pcg.RealName;
              pcg.SubMenu := 1;
              pcg.Price := 1;
              pcg.Stock := 1;
              pcg.Count := 1;
              pcg.Grade := -1;
              pcg.Looks := g_SellDlgItems[II].S.Looks;

              FrmDlg.MenuList.Add(pcg);
            end;

            {
            if TSerialWindows(FrmDlg).DTradingMarketItemsDlg.Visible and
              (g_MenuItemList.Count < TSerialWindows(FrmDlg).DTradingMarketBuyItems.RowCount * TSerialWindows(FrmDlg).DTradingMarketBuyItems.ColCount) then
            begin
              if g_MenuItemList.Count > 0 then
              begin
                Item := g_MenuItemList.Items[0];
                if Item.s.DBName = g_SellDlgItems[II].s.DBName then
                begin
                  New(Item);
                  Item^ := g_SellDlgItems[II];
                  g_MenuItemList.Add(Item);
                end;
              end;
            end;
            }

            g_SellDlgItems[II].S.Name := '';
          end;
        end;
      end;
    end;

    FrmDlg.RecallTradingSellPrices;
    if DefMsg.Tag > 0 then begin
      FrmDlg.DMessageDlg(Format('您已出售成功%d个，失败%d个。', [DefMsg.Param, DefMsg.Tag]), [mbOk]);
    end;
  finally
    SL.Free;
  end;
end;

