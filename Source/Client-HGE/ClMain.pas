      MyOutputDebugString('解压缩插件完成 .');
      {$IFEND}

      if not Assigned(g_AntiPlugDllMemory2) then
        g_AntiPlugDllMemory2 := TMemoryStream.Create
      else begin
        {$IF AntiPlugInMemory = 1}
        if g_AntiPlugDllMemoryModule2 <> nil then
