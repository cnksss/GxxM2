      // 会重新取获图片来算大小，成了 UI1-1000，而UI1又没有1000张图导致微端重新请求 UI1.Index
      //DMerchantDlg.ImageIndex.Image := nil;

      DMerchantDlg.ImageIndex.BeginUpdate;
      try
        DMerchantDlg.ImageIndex.Image := Images;
        DMerchantDlg.ImageIndex.Up := DefMsg.Tag;
        DMerchantDlg.ImageIndex.Hot := DefMsg.Tag;
        DMerchantDlg.ImageIndex.Down := DefMsg.Tag;
        DMerchantDlg.ImageIndex.Disabled := DefMsg.Tag;
        DMerchantDlg.ImageIndex.Checked := DefMsg.Tag;
      finally
        DMerchantDlg.ImageIndex.EndUpdate;
      end;

      DMerchantDlg.Floating := HiByte(DefMsg.Param) > 0;
      // 对话框是否能移动--不和引擎开关冲突 piaoyun 2013-09-10
      boNpcDlgCanMove := HiByte(DefMsg.Param) > 0;
      if (DMerchantDlgHelp <> nil) then
        DMerchantDlgHelp.Visible := False;

      case LoByte(DefMsg.Series) of
        0:begin // 左上角
            DMerchantDlg.Left := 0;
            DMerchantDlg.Top := 0;
          end;
        1:begin // 右上角
            DMerchantDlg.Left := SCREENWIDTH - DMerchantDlg.Width;
            DMerchantDlg.Top := 0;
          end;
        2:begin // 左下角
            DMerchantDlg.Left := 0;
            DMerchantDlg.Top := SCREENHEIGHT - DMerchantDlg.Height;
          end;
        3:begin // 右下角
            DMerchantDlg.Left := SCREENWIDTH - DMerchantDlg.Width;
            DMerchantDlg.Top := SCREENHEIGHT - DMerchantDlg.Height;
          end;
        4:begin // 居中
            DMerchantDlg.Left := (SCREENWIDTH - DMerchantDlg.Width) div 2;
            DMerchantDlg.Top := (SCREENHEIGHT - DMerchantDlg.Height) div 2;
          end;
        else begin
            DMerchantDlg.Left := 0;
            DMerchantDlg.Top := 0;
          end;
      end;
      DMerchantDlg.Left := DMerchantDlg.Left + nX;
      DMerchantDlg.Top := DMerchantDlg.Top + nY;
      DMerchantDlgClose.Visible := HiByte(DefMsg.Series) > 0;

      if DMerchantDlgClose.Visible then begin
        sData := GetValidStr3_Ex(sData, sX, '/');
        sData := GetValidStr3_Ex(sData, sY, '/');

        if sData = '1' then
          g_boKeepBigDlg := True;

        nCloseX := StrToIntDef(sX, -High(Integer));
        nCloseY := StrToIntDef(sY, -High(Integer));
        if nCloseX <> -High(Integer) then
          DMerchantDlgClose.Left := nCloseX;
        if nCloseY <> -High(Integer) then
          DMerchantDlgClose.Top := nCloseY;
        DMerchantDlgClose.BringToFront;
      end else begin
        sData := GetValidStr3_Ex(sData, sX, '/');
        sData := GetValidStr3_Ex(sData, sY, '/');

        if sData = '1' then
          g_boKeepBigDlg := True;
      end;

      {$IF IsMultiThreadRender = 1}
      DBackground.Lock;
      try
        {$IFEND}
        ClearMerchantSay;
        {$IF IsMultiThreadRender = 1}
      finally
        DBackground.UnLock;
      end;
      {$IFEND}
      OpenDMerchantDlg;
    end;
  end;

  // 点击使用自定义大对话框[OPENMERCHANTBIGDLG], 没有点击过普通NPC，直接通过命令行调用FQ或QM脚本，不换回小对话框 chongchong 2014-04-27
  g_dwOpenMerchantBigDlgTick := MyGetTickCount;

end;

