  if g_boGuide and ((g_GuideX <> 0) or (g_GuideY <> 0) or ((g_GuideR <> 0) and (g_GuideB <> 0))) and ((pt.X < g_GuideX) or (pt.X > g_GuideR) or (pt.Y < g_GuideY) or (pt.Y > g_GuideB)) then begin
