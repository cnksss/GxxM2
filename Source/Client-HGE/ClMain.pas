function _IsInsideVMWare():BOOL; stdcall;
begin
  Result := False;
  try
    asm
        push    edx
        push    ecx
        push    ebx
        mov     eax, 'VMXh'
        mov     ebx, 0 // any value but not the MAGIC VALUE
        mov     ecx, 10 // get VMWare version
        mov     edx, 'VX' // port number
        IN      eax, dx // read port
                     // on return EAX returns the VERSION
        cmp     ebx, 'VMXh' // is it a reply from VMWare?
        mov     Result, True
        pop     ebx
        pop     ecx
        pop     edx
    end;
  except
  end;
end;

