function TfrmMain.AutoHeroEatItem(idx:Integer):Boolean;
begin
  Result := False;
  if (idx in [0..40 - 1]) then begin
    if (g_HeroEatingItem.s.Name <> '') and (MyGetTickCount - g_dwHeroEatTime > 5 * 1000) then begin
      g_HeroEatingItem.s.Name := '';
    end;
    if (g_HeroEatingItem.s.Name = '') then begin
      // 修正内挂吃药会吃31类卷轴的问题 chongchong 2013-10-27
      if (g_HeroItemArr[idx].S.Name <> '') and ((g_HeroItemArr[idx].S.StdMode <= 3) or ((g_HeroItemArr[idx].S.StdMode = 31) and not (g_HeroItemArr[idx].S.Shape in [0, 1, 15..51]) and (g_HeroItemArr[idx].S.Reserved = 0))) then begin
        g_dwHeroEatTime := MyGetTickCount;
        g_HeroEatingItem := g_HeroItemArr[idx];
        g_HeroItemArr[idx].S.Name := '';
        SendHeroEat(g_HeroEatingItem.MakeIndex, g_HeroEatingItem.s.Name);
        Result := True;
      end
      else if (g_HeroItemArr[idx].S.Name <> '') and (g_HeroItemArr[idx].S.StdMode = 31) then begin
        g_dwHeroEatTime := MyGetTickCount;
        g_HeroEatingItem := g_HeroItemArr[idx];
        g_HeroItemArr[idx].S.Name := '';
        SendHeroEat(g_HeroEatingItem.MakeIndex, g_HeroEatingItem.s.Name);
        Result := True;
      end;
    end;
  end;
end;

procedure TfrmMain.FormCloseQuery(Sender:TObject; var CanClose:Boolean);
begin
  // DebugOutStr('----------------------- CloseQuery ------------------------');
  if (g_MySelf <> nil) and (g_ConnectionStep = cnsPlay){$IF TESTMODE = 0} and Timer1.Enabled{$IFEND} then begin
    RzToolButtonBackGameClick(Self);

    if g_boAppExit or (FrmDlg.DMessageDlg(DecodeResStr(SQuitAppAsk), [mbOk, mbCancel]) = mrOk) then begin
      {$I VMProtectBegin.inc}
      g_RecvBufTick := MyGetTickCount;
      SendClientMessage(CM_IOCP_APPEXIT, 0, 0, 0, 0);

      if (not g_boIOCP_Rungate) or (not CSocket.Active) then begin
        g_AntiPlugNotifyFunc := nil;

        g_boAppExit := True;

        SaveOrLoadMyBagItemList(True);
        CloseAllWindows;

        {$IF IsMultiThreadRender = 1}
        if RenderThread <> nil then
          RenderThread.Terminate;
        {$ELSE}
        TimerRender.Enabled := False;
        {$IFEND}
        CSocket.Close;

        GameCanvas.Finalize;
      end
      else begin
        g_WaitAppExit := True;
        CanClose := False;
      end;
      {$I VMProtectEnd.inc}
    end
    else begin
      CanClose := False;
    end;
  end
  else begin
    g_boAppExit := True;

    g_AntiPlugNotifyFunc := nil;

    {$IF IsMultiThreadRender = 1}
    if RenderThread <> nil then
      RenderThread.Terminate;
    {$ELSE}
    TimerRender.Enabled := False;
    {$IFEND}
    GameCanvas.Finalize;
  end;
end;

procedure TfrmMain.FormMouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  pt:TPoint;
  PlugData:TAntiPlugNotifyEventMouseData;
begin
  // 点击鼠标立即进入登录界面 piaoyun 2013-08-28
  if DScreen.CurrentScene = WelcomeScene then
    g_dwShowVersionBmpTime := 0;
  //////////////////////////////////////////////////////////////////////////////

  g_boMouseRightDown := Button = mbRight;

  if (Button = mbRight) and (Cursor <> GetDefaultCursor) and (Cursor <> crIBeam) then begin
    Cursor := GetDefaultCursor;
    Exit;
  end;

  if FrmDlg = nil then
    Exit;
  // DScreen.AddChatBoardString('FormMouseDown:' , clGreen, clWhite);
  GetCursorPos(pt);

  if Assigned(g_AntiPlugNotifyFunc) then begin
    PlugData.nX := pt.X;
    PlugData.nY := pt.Y;
    PlugData.ShiftState := ShiftStateToPlugShiftState(Shift);
    PlugData.MouseButton := Integer(Button);

    g_AntiPlugNotifyFunc(event_MouseDown, @PlugData, SizeOf(PlugData));
  end;

  pt := TControl(Sender).ScreenToClient(pt);

  if not PanelSurface.Visible then begin
    pt.X := Round(pt.X * (SCREENWIDTH / ClientWidth));
    pt.Y := Round(pt.Y * (SCREENHEIGHT / ClientHeight));
  end;

  if g_boGuide and ((g_GuideX <> 0) or (g_GuideY <> 0) or ((g_GuideR <> 0) and (g_GuideB <> 0))) and ((pt.X < g_GuideX) or (pt.X > g_GuideR) or (pt.Y < g_GuideY) or (pt.Y > g_GuideB)) then begin
    Exit;
  end;

  mousedowntime := MyGetTickCount;
  g_nRunReadyCount := 0;

  g_nMoveCount := 0;
  //DScreen.AddChatBoardString('LB_RUN 004', clGreen, clWhite);
  { TODO -ochongchong -c修改 : 修复丢弃物品时人物还移动 【2013-08-19】 }
  if (m_boIsStartDropItem) or (g_boShowMiniMapXY) then begin
    m_boIsStartDropItem := False;

    { TODO -ochongchong -c修改 : 小地图点击不移动处理 【2013-08-28】 }
    if g_boShowMiniMapXY then
      FrmDlg.DBackground.MouseDown(Button, Shift, X, Y);
  end
  else
    _DXDrawMouseDown(Sender, Button, Shift, pt.X, pt.Y);

  // DebugOutStr(Format('%d/%d %d/%d',[X, Y,pt.X, pt.Y]));
  // DScreen.AddChatBoardString(Format('%d/%d %d/%d',[X, Y,pt.X, pt.Y]), clGreen, clWhite);
  {$IF Enabled_PlugEngine = 1}
  if Assigned(HookFormMouseDown) then begin
    try
      HookFormMouseDown(Sender, Button, Shift, pt.X, pt.Y);
    except
      on E:Exception do begin
        DebugOutStr('[Exception] HookFormMouseDown');
        DebugOutStr(E.Message);
      end;
    end;
  end;
  {$IFEND}

end;

procedure TfrmMain.DoMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer; IsRealMouseMove:Boolean);
{$J+}
const
  g_FocusItemHintPt:TPoint = (
    X: - 100;
    Y: - 100
    );
  {$J-}
var
  mx, my, sel, Index:Integer;
  target:TActor;
  itemnames, itemnames2:string;
  Screenpt:TPoint;
  Originpt:TPoint;
  pt:TPoint;
  boSetPt:Boolean;
begin
  if FrmDlg = nil then
    Exit;

  GetCursorPos(Screenpt);
  pt := TControl(Sender).ScreenToClient(Screenpt);
  if not PanelSurface.Visible then begin
    pt.X := Round(pt.X * (SCREENWIDTH / ClientWidth));
    pt.Y := Round(pt.Y * (SCREENHEIGHT / ClientHeight));
  end;

  if g_boGuide and ((g_GuideX <> 0) or (g_GuideY <> 0) or ((g_GuideR <> 0) and (g_GuideB <> 0))) and ((pt.X < g_GuideX) or (pt.X > g_GuideR) or (pt.Y < g_GuideY) or (pt.Y > g_GuideB)) then begin
    Exit;
  end;
  //FrmDlg.CloseSayItemDlg(x, y);
  // DScreen.AddChatBoardString(Format('pt.X:%D pt.Y:%D',[pt.X,pt.Y]), clGreen, clWhite);
  if (FrmDlg.DBackground.MouseDownControl <> nil) then begin
    boSetPt := False;
    Originpt := TControl(Sender).ClientOrigin;
    if Screenpt.X < Originpt.X then begin
      Screenpt.X := Originpt.X;
      pt.X := 0;
      boSetPt := True;
    end;

    if Screenpt.Y < Originpt.Y then begin
      Screenpt.Y := Originpt.Y;
      pt.Y := 0;
      boSetPt := True;
    end;

    if Screenpt.X > Originpt.X + TControl(Sender).ClientWidth then begin
      Screenpt.X := Originpt.X + TControl(Sender).ClientWidth;
      pt.X := FrmDlg.DBackground.Width;
      boSetPt := True;
    end;

    if Screenpt.Y > Originpt.Y + TControl(Sender).ClientHeight then begin
      Screenpt.Y := Originpt.Y + TControl(Sender).ClientHeight;
      pt.Y := FrmDlg.DBackground.Height;
      boSetPt := True;
    end;

    if boSetPt then
      SetCursorPos(Screenpt.X, Screenpt.Y);
  end;

  {$IF TESTMODE = 1}
  g_nMouseMoveX := pt.X;
  g_nMouseMoveY := pt.Y;
  {$IFEND}

  if IsRealMouseMove then begin
    // 修复鼠标离开地图后，人物不跑动了 -- piaoyun 2013-08-18
    if FrmDlg.DBackground.MouseMove(Shift, pt.X, pt.Y) then begin
      {
      if not (FrmDlg.DMinMapDlg.Visible and
        (pt.X >= FrmDlg.DMinMapDlg.Left) and (pt.Y <= FrmDlg.DMinMapDlg.Height) and
        (FrmDlg.DMinMapDlg.MouseMoveed)) then
        Exit;
      }
      // 大地图处理一下
      if {条件1} not (FrmDlg.CheckDMinMapBigDlgMouseDown(pt)) and {条件2}(not (FrmDlg.DMinMapDlg.Visible and (FrmDlg.DMinMapDlg.MouseMoveed))) then
        Exit;
    end;
  end;

  {$IF Enabled_PlugEngine = 1}
  if Assigned(HookFormMouseMove) then begin
    try
      HookFormMouseMove(Sender, Shift, pt.X, pt.Y);
    except
      on E:Exception do begin
        DebugOutStr('[Exception] HookFormMouseMove');
        DebugOutStr(E.Message);
      end;
    end;
  end;
  {$IFEND}

  if IsRealMouseMove then begin
    if ((FrmDlg.DMinMapDlg.Visible and (FrmDlg.DMinMapDlg.MouseDowned))) or ((not FrmDlg.DMinMapDlg.MouseDowned) and (FrmDlg.DMinMapDlg.MouseMoveed) {(X >= FrmDlg.DMinMapDlg.Left) and (Y <= FrmDlg.DMinMapDlg.Height) and
      (FrmDlg.DBackground.FindCtrlAt(Point(X, Y)) = FrmDlg.DMinMapDlg)}) then
      g_boShowMiniMapXY := True
    else
      g_boShowMiniMapXY := False;

    if (g_MySelf = nil) or (DScreen.CurrentScene <> PlayScene) then
      Exit;

    if g_boMapMovingWait then
      Exit;

    g_boSelectMyself := PlayScene.IsSelectMyself(pt.X, pt.Y);

    target := PlayScene.GetAttackFocusCharacter(pt.X, pt.Y, g_nDupSelection, sel, False);
    if g_nDupSelection <> sel then
      g_nDupSelection := 0;
    if target <> nil then begin
      if (target.m_sUserName = '') and (MyGetTickCount - target.m_dwSendQueryUserNameTime > 10 * 1000) then begin
        target.m_dwSendQueryUserNameTime := MyGetTickCount;
        SendQueryUserName(target.m_nRecogId, target.m_nCurrX, target.m_nCurrY);
      end;
      {$IF IsMultiThreadRender = 1}
      EnterCriticalSection(g_ActorLock);
      {$IFEND}
      if g_FocusCret <> target then begin
        g_FocusCret := target;
        g_FocusCretTick := MyGetTickCount;
      end;
      {$IF IsMultiThreadRender = 1}
      LeaveCriticalSection(g_ActorLock);
      {$IFEND}
    end
    else begin
      {$IF IsMultiThreadRender = 1}
      EnterCriticalSection(g_ActorLock);
      {$IFEND}
      g_FocusCret := nil;
      g_FocusCretTick := MyGetTickCount;
      {$IF IsMultiThreadRender = 1}
      LeaveCriticalSection(g_ActorLock);
      {$IFEND}
    end;

    g_boShowBagInfo := False;
    g_boShowHeroBagInfo := False;

    g_FocusItem := PlayScene.GetDropItems(pt.X, pt.Y, itemnames);
    if g_FocusItem <> nil then begin
      // 免得不停的重新创建提示窗口 chongchong 2015-01-22
      //if (g_FocusItem.id <> g_LastHintMakeIndex) then
      // 修正提示有时候不太准 2020-01-06 01:11:13
      if (Abs(g_FocusItemHintPt.X - pt.X) > 2) or (Abs(g_FocusItemHintPt.Y - pt.Y) > 2) then begin
        g_FocusItemHintPt := pt;
        PlayScene.ScreenXYfromMCXY(Cutecode_T(g_FocusItem.X), Cutecode_T(g_FocusItem.Y), mx, my);

        // 修正掉落物品提示不居中chongchong 2013-11-09
        //HintWindows.Show(mx, my - 2, itemnames, clWhite, True);

        itemnames2 := ProcessItemName(itemnames);
        Index := Pos('\', itemnames2);
        if Index > 0 then
          mx := mx - CurrentFont.TextWidth(Copy(itemnames2, 1, Index - 1)) div 2
        else
          mx := mx - CurrentFont.TextWidth(itemnames2) div 2;

        // Changeitemname 1 <PlayImg:1:780:10:100:120:80:0:0:0>测试装备名字真的很长
        // 不要提示中的图片 2019-05-27 15:46:01
        HintWindows.Show(mx, my - 2, itemnames2, clWhite, True);
        g_LastHintMakeIndex := g_FocusItem.id;
      end;
    end
    else begin
      HintWindows.Clear;
    end;
  end;

  PlayScene.CXYfromMouseXY(pt.X, pt.Y, g_nMouseCurrX, g_nMouseCurrY);
  g_Mouse := pt;
  g_nMouseX := pt.X;
  g_nMouseY := pt.Y;
  g_MouseItem.S.Name := '';
  g_MouseStateItem.S.Name := '';
  g_MouseUserStateItem.S.Name := '';
  // 如果不考虑Shift强行攻击的问题 (MyGetTickCount - mousedowntime > 200) 这一行就可以
  // 修正 Shift 强行攻击第一次会慢 修正点击目标后，跑向目标一会又停掉(原因是_DXDrawMouseDown中调用间隔太短，多次调用将 g_TargetSet := nil了 2019-09-17 00:34:28
  if ((ssLeft in Shift) or (ssRight in Shift)) and ((MyGetTickCount - mousedowntime > 250) or ((ssShift in Shift) and (MyGetTickCount - mousedowntime > 50))) then begin
    // 修正丢弃物品时人物会走动 2019-08-19 21:38:44
    if tick_diff(g_DropMoveItemTick, MyGetTickCount) >= 300 then begin
      g_boMouseMoveDown := True;

      // 修正小地图支持寻路时，跑步弄到小地图上了，会一直寻路提示 2019-07-08 23:43:27
      if ssRight in Shift then
        _DXDrawMouseDown(Self, mbRight, Shift, pt.X, pt.Y)
      else if ssLeft in Shift then
        _DXDrawMouseDown(Self, mbLeft, Shift, pt.X, pt.Y)
      else if ssMiddle in Shift then
        _DXDrawMouseDown(Self, mbMiddle, Shift, pt.X, pt.Y);
    end;
  end
  else begin
    g_boMouseMoveDown := False;
  end;
end;

procedure TfrmMain.FormMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
begin
  g_IsInMouseMove := True;
  DoMouseMove(Sender, Shift, X, Y, True);
