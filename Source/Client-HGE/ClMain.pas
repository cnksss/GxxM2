      if (abs(g_MySelf.m_nCurrX - nX) <= 2) and (abs(g_MySelf.m_nCurrY - nY) <= 2) then begin
        Result := PlayScene.FindActorXY(nX, nY, target) = target;
      end;
    end;
  end;
end;

