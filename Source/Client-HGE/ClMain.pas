procedure TfrmMain.ProcessMessageSpaceMoveShow(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  body2, sColor:string;
  CharDesc:pTCharDesc;
  Feature:TFeature;
  Actor:TActor;
  S:string;
begin
  if g_MySelf = nil then
    Exit;

  if Length(sData) >= SizeOf(TCharDesc) then begin
    CharDesc := pTCharDesc(sData);

    if (CharDesc.Feature > 0) and (Length(sData) >= SizeOf(TCharDesc) + CharDesc.Feature) then begin
      Feature.Feature := CharDesc.Feature;
      Move(sData[1 + SizeOf(TCharDesc)], Feature.Buffer[0], Feature.Feature);

      body2 := Copy(sData, SizeOf(TCharDesc) + Feature.Feature + 1, Length(sData) - SizeOf(TCharDesc) - Feature.Feature);

      body2 := DecodeString(body2);
      sColor := GetValidStr3_Ex(body2, body2, '/');

      if DefMsg.Recog <> g_MySelf.m_nRecogId then begin // 促弗 某腐磐牢 版快
        // 修正神兽在爬下的瞬间换地图或随机后看不到了 chongchong 2016-03-18
        DelChangeFace(DefMsg.Recog);
        PlayScene.NewActor(DefMsg.Recog, DefMsg.param, DefMsg.tag, DefMsg.series, Feature, CharDesc.Status);
      end;

      Actor := PlayScene.SendMsg(DefMsg.ident, DefMsg.Recog, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir + light}, @Feature, CharDesc.Status, '');

      if body2 <> '' then begin
        // Actor := PlayScene.FindActor(DefMsg.Recog);
        if Actor <> nil then begin
          Actor.m_sDescUserName := GetValidStr3_Ex(body2, S, '\');
          Actor.m_sUserName := S;

          if (Actor.m_btRace = RC_PLAYOBJECT) then begin
            if (Actor <> g_MySelf) then begin
              Actor.m_btJob := pTHumFeature(@Feature.Buffer).btJob;
            end;
            // Actor.m_boStartStore := pTHumFeature(@Feature.Buffer).boStore;
          end;
          Actor.m_nNameColor := GetRGB(StrToIntDef(sColor, 0));
        end;
      end;
    end;
  end;
end;

procedure TfrmMain.ProcessMessageTurn(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  body2, sColor:string;
  nData, nPos:Integer;
  CharDesc:TCharDesc;
  Feature:TFeature;
  Actor:TActor;
  S:string;
begin
  Feature.Feature := 0;
  nData := Length(sData);

  FillChar(CharDesc, SizeOf(TCharDesc), 0);

  if Length(sData) >= SizeOf(TCharDesc) then begin
    CharDesc := pTCharDesc(sData)^;

    if (CharDesc.Feature > 0) and (Length(sData) >= SizeOf(TCharDesc) + CharDesc.Feature) then begin
      Feature.Feature := CharDesc.Feature;
      Move(sData[1 + SizeOf(TCharDesc)], Feature.Buffer[0], Feature.Feature);
    end;
  end;

  body2 := System.Copy(sData, SizeOf(TCharDesc) + Feature.Feature + 1, nData - SizeOf(TCharDesc) - Feature.Feature);

  body2 := DecodeString(body2);
  nPos := Pos('/', body2);
  if nPos > 0 then begin
    sColor := GetValidStr3_Ex(body2, body2, '/');
  end;

  if Feature.Feature > 0 then
    PlayScene.SendMsg(DefMsg.ident, DefMsg.Recog, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir + light}, @Feature, CharDesc.Status, '')
  else
    PlayScene.SendMsg(DefMsg.ident, DefMsg.Recog, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir + light}, nil, CharDesc.Status, '');

  if body2 <> '' then begin
    Actor := PlayScene.FindActor(DefMsg.Recog);
    if Actor <> nil then begin
      Actor.m_sDescUserName := GetValidStr3_Ex(body2, S, '\');
      Actor.m_sUserName := S;

      if (Actor.m_btRace = RC_PLAYOBJECT) then begin
        if (Actor <> g_MySelf) then begin
          Actor.m_btJob := pTHumFeature(@Feature.Buffer).btJob;
        end;
        // Actor.m_boStartStore := pTHumFeature(@Feature.Buffer).boStore;
      end;
      Actor.m_nNameColor := GetRGB(StrToIntDef(sColor, 0));
      // DScreen.AddChatBoardString('ProcessMessageTurn '+Actor.m_sUserName+' '+sColor, clWhite, clRed);

      CheckInBossList(Actor, DefMsg.param, DefMsg.tag);
    end;
  end;
end;

procedure TfrmMain.ProcessMessageRush(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  body2:string;
  nData:Integer;
  CharDesc:TCharDesc;
  Actor:TActor;
  nPos:Integer;
  PushedObject:TPushedObject;
begin
  if g_MySelf = nil then
    Exit;

  body2 := '';
  nData := Length(sData);
  if nData >= g_nCharDesc then begin
    if (DefMsg.ident = SM_100HIT) or ((DefMsg.Ident >= SM_CUSTOM_PUSH001) and (DefMsg.Ident < SM_CUSTOM_PUSH001 + CUSTOM_MAGIC_COUNT)) then begin
      nPos := Pos('|', sData);
      if nPos > 0 then begin
        body2 := Copy(sData, nPos + 1, nData - nPos);
        sData := Copy(sData, 1, nPos - 1);
      end;
    end;
    DecodeString(sData, @CharDesc, SizeOf(TCharDesc));
    if ((DefMsg.ident = SM_100HIT) or ((DefMsg.Ident >= SM_CUSTOM_PUSH001) and (DefMsg.Ident < SM_CUSTOM_PUSH001 + CUSTOM_MAGIC_COUNT))) and (body2 <> '') then begin // 追心刺
      sData := body2;
      while True do begin
        if sData = '' then
          break;
        sData := GetValidStr3_Ex(sData, body2, '/');
        if body2 = '' then
          break;
        DecodeString(body2, @PushedObject, SizeOf(TPushedObject));
        Actor := PlayScene.FindActor(PushedObject.nRecogId);

        if Actor <> nil then begin
          PlayScene.SendMsg(SM_BACKSTEP, PushedObject.nRecogId, PushedObject.nCurrX {x}, PushedObject.nCurrY {y}, MakeWord(PushedObject.btDir, PushedObject.btStep) {dir + light}, @Actor.m_Feature, Actor.m_nState, '');
        end;
      end;
    end;

    PlayScene.SendMsg(DefMsg.ident, DefMsg.Recog, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir+light}, nil, CharDesc.Status, '');

    if (DefMsg.ident = SM_RUSH) then begin
      g_dwLatestRushRushTick := MyGetTickCount;
      g_ChrAction := caNone;
    end;
  end;
end;

