procedure TfrmMain.StartContinuousMagicAttack; // 连击魔法
var
  MagicTarget:TActor;
  FocusCret:TActor;
  TargetCret:TActor;
  Actor:TActor;
  nX, nY:Integer;
begin
  if not g_boContinuous then Exit;

  if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
    g_MySelf.m_boUseMagic := False;

    // 2021-01-22 改这里，处理2边不同步
    //frmMain.SendClientMessage(CM_STOP_CONTINUOUSMAGIC, 0, 0, 0, 0);
    DoFinishContinuous();
    Exit;
  end;

  if not (g_ContinuousMagic[g_nContinuousIndex].Def.wMagicId in [100..103]) then begin // 不是战士连击技能
    if CanNextAction(caSpell) and ServerAcceptNextAction(False) and CanNextHit then begin
      Actor := nil;
      {$IF IsMultiThreadRender = 1}
      EnterCriticalSection(g_ActorLock);
      {$IFEND}
      TargetCret := g_TargetCret;
      FocusCret := g_FocusCret;
      MagicTarget := g_MagicTarget;
      {$IF IsMultiThreadRender = 1}
      LeaveCriticalSection(g_ActorLock);
      {$IFEND}

      if (MagicTarget <> nil) and PlayScene.IsValidActor(MagicTarget) and (not MagicTarget.m_boDeath) then
        Actor := MagicTarget
      else if (TargetCret <> nil) and PlayScene.IsValidActor(TargetCret) and (not {MagicTarget.m_boDeath}  TargetCret.m_boDeath) then
        Actor := TargetCret
      else if (FocusCret <> nil) and PlayScene.IsValidActor(FocusCret) and (not FocusCret.m_boDeath) then
        Actor := FocusCret;

      g_CurrContinuousMagic := g_ContinuousMagic[g_nContinuousIndex];

      if Actor <> nil then begin
        PlayScene.ScreenXYfromMCXY(Actor.m_nCurrX, Actor.m_nCurrY, nX, nY);
        UseMagic(nX, nY, @g_CurrContinuousMagic);
        Inc(g_nContinuousIndex);
        if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
           DoFinishContinuous();
        end;

      end else begin
        UseMagic(g_nMouseX, g_nMouseY, @g_CurrContinuousMagic);
        Inc(g_nContinuousIndex);
        if g_nContinuousIndex >= Length(g_ContinuousMagic) then begin
            DoFinishContinuous();
        end;

        // SendDelayMsg(g_MySelf, RCM_StartContinuousMagicAttack, 0, 0, 0, 0, '', 500);
      end;
    end;
    SendDelayMsg(g_MySelf, RCM_StartContinuousMagicAttack, 0, 0, 0, 0, '', 500);
  end;
end;

procedure TfrmMain.ClientTakeOnItem(nMakeIndex, nWhere:Integer; sItemName:string);
var
  I:Integer;
  Item:TClientItem;
begin
  // if g_MySelf = nil then Exit;
  if nWhere in [Low(TUseItems)..High(TUseItems)] then begin
    Item.S.Name := '';
    for I := 0 to GetMaxBagCount - 1 do begin
      if g_ItemArr[I].S.Name <> '' then begin
        if (Comparetext(g_ItemArr[I].S.Name, sItemName) = 0) and (g_ItemArr[I].MakeIndex = nMakeIndex) then begin
          Item := g_ItemArr[I];
          g_ItemArr[I].S.Name := '';
          Break;
        end;
      end;
    end;
    if Item.S.Name <> '' then begin
      g_UseItems[nWhere] := Item;
    end
    else begin
      SendDelayMsg(g_MySelf, SM_TAKEONITEM, nWhere, nMakeIndex, 0, 0, sItemName, 1000);
    end;
  end;
end;

