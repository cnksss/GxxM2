        // 自定义技能-刺杀不要关闭 2019-11-16 15:42:28
        for I := 0 to Length(g_AutoCustomMagic[mngoLongHit]) - 1 do begin
          if g_AutoCustomMagic[mngoLongHit][I] = nHitMsg - CM_CUSTOM_HIT001 + CUSTOM_MAGIC_START_ID then begin
