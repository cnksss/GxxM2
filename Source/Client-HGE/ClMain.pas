procedure TfrmMain.RearrangeArrButton;

  function CompareListButton(List:TList; Index1, Index2:Integer):Integer;
  begin
    Result := TDxImageButtonEx(List.Items[Index1]).tag - TDxImageButtonEx(List.Items[Index2]).tag;
  end;

  procedure QuickSortList(List:TList; L, R:Integer);
  var
    I, J, P:Integer;
  begin
    repeat
      I := L;
      J := R;
      P := (L + R) shr 1;
      repeat
        while CompareListButton(List, I, P) < 0 do Inc(I);
        while CompareListButton(List, J, P) > 0 do Dec(J);
        if I <= J then begin
          List.Exchange(I, J);
          if P = I then begin
            P := J
          end else if P = J then begin
            P := I;
          end;
          Inc(I);
          Dec(J);
        end;
      until I > J;
      if L < J then QuickSortList(List, L, J);
      L := I;
    until I >= R;
  end;

var
  I, II, nX, nY:Integer;
  IsInitPos:Boolean;
  ImageButton:TDxImageButtonEx;
  Group:array[Low(TArrButtonConfig)..High(TArrButtonConfig)] of TList;
  List:TList;
  R:TRect;
begin
  for I := Low(Group) to High(Group) do begin
    Group[I] := TList.Create;
  end;

  try
    for I := 0 to g_ArrButtonList.Count - 1 do begin
      ImageButton := TDxImageButtonEx(g_ArrButtonList.Items[I]);
      List := Group[ImageButton.AddData1];
      List.Add(ImageButton);
    end;

    for I := Low(Group) to High(Group) do begin
      List := Group[I];
      if List.Count > 0 then begin
        QuickSortList(List, 0, List.Count - 1);
      end;

      
      IsInitPos := False;
      {$MESSAGE HINT '此处增加的代码未经测试，可能不符合原本的意思'}
      nX := g_ArrButtonConfig[I].OffsetX; //HZQ 20230524
      nY := g_ArrButtonConfig[I].OffsetY; //

      for II := 0 to List.Count - 1 do begin
        ImageButton := List[II];

        if not IsInitPos then begin
          R.Left := 0;
          R.Top := 0;
          R.Right := R.Left + ImageButton.Owner.Width;
          R.Bottom := R.Top + ImageButton.Owner.Height;

          case g_ArrButtonConfig[I].HorzAligment of
            taLeftJustify:nX := R.Left + g_ArrButtonConfig[I].OffsetX;
            taRightJustify:nX := R.Right - ImageButton.Width + g_ArrButtonConfig[I].OffsetX;
            taCenter:nX := (R.Right - R.Left) div 2 + g_ArrButtonConfig[I].OffsetX;
            else nX := g_ArrButtonConfig[I].OffsetX; //HZQ 20230524 Custom default
          end;

          case g_ArrButtonConfig[I].VertAligment of
            taAlignTop:nY := R.Top + g_ArrButtonConfig[I].OffsetY;
            taAlignBottom:nY := R.Bottom - ImageButton.Height + g_ArrButtonConfig[I].OffsetY;
            taVerticalCenter:nY := (R.Bottom - R.Top) div 2 + g_ArrButtonConfig[I].OffsetY;
            else nY := g_ArrButtonConfig[I].OffsetY; //HZQ 20230524 Custom default
          end;

          IsInitPos := True;
        end;

        ImageButton.Left := nX;
        ImageButton.Top := nY;

        nX := nX + g_ArrButtonConfig[I].NextOffsetX;
        nY := nY + g_ArrButtonConfig[I].NextOffsetY;
      end;
    end;

  finally
    for I := Low(Group) to High(Group) do begin
      Group[I].Free;
    end;
  end;
end;

