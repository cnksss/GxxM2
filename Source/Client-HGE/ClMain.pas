procedure TfrmMain.ProcessMessageUpdateFengHaoItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  Index:Integer;
  cu:TClientItem;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  Buffer:PChar;
  ClientItem:PTClientItem;
  IsHero:Boolean;
  FengHaoItems:TGList;
begin
  IsHero := Boolean(DefMsg.Tag);

  if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
    if IsHero then begin
      g_HeroActiveFengHaoIndex := DefMsg.Recog;
      FengHaoItems := g_HeroFengHaoItems;
    end
    else begin
      g_ActiveFengHaoIndex := DefMsg.Recog;
      FengHaoItems := g_FengHaoItems;
    end;

    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));
    Buffer := @OutBuf;

    FengHaoItems.Lock;
    try
      for I := 0 to FengHaoItems.Count - 1 do begin
        Dispose(PTClientItem(FengHaoItems.Items[I]));
      end;
      FengHaoItems.Clear;

      for I := 0 to DefMsg.Series - 1 do begin
        Index := Ord(Buffer^);
        Inc(Buffer);
        Move(Buffer^, cu, SizeOf(TClientItem));
        Buffer := Buffer + SizeOf(TClientItem);
        if Index in [Low(THumanFengHaoItems)..High(THumanFengHaoItems)] then begin
          New(ClientItem);
          FillChar(ClientItem^, SizeOf(TClientItem), 0);
          ClientItem^ := cu;
          FengHaoItems.Add(ClientItem)
        end;
      end;
    finally
      FengHaoItems.UnLock;
    end;
  end;
end;

