procedure TfrmMain.ProcessMessageUpdateItem(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  CI:PTClientItem;
  cu:TClientItem;
  OldDura:Integer;
  nTempX, nTempY:Integer;
  sShowName:string;
begin
  if (Length(sData) = SizeOf(TClientItem)) then begin
    cu := PTClientItem(sData)^;

    // 叠加物品捡起时加提示 chongchong 2016-10-29
    if UpdateItemBag(cu, OldDura, False) then begin
      if (cu.Dura > OldDura) and (cu.s.OverLap > 0) and (cu.s.StdMode in [0, 2, 3, 31, 40, 41, 42, 46, 47]) and (cu.s.DuraMax > 1) then begin
        if g_ClientConfig.boAddItemMsgXRightToLeft then
          nTempX := SCREENWIDTH - g_ClientConfig.nAddItemMsgX
        else
          nTempX := g_ClientConfig.nAddItemMsgX;

        if g_ClientConfig.boAddItemMsgYBottomToTop then
          nTempY := SCREENHEIGHT - g_ClientConfig.nAddItemMsgY
        else
          nTempY := g_ClientConfig.nAddItemMsgY;

        sShowName := ProcessItemName(cu.s.Name);
        DScreen.AddSysMsg(sShowName + '[×' + IntToStr(cu.Dura - OldDura) + '] 被发现.', g_ClientConfig.btAddItemMsgFColor, g_ClientConfig.btAddItemMsgBColor, nTempX, nTempY);
      end;
    end;

    for I := Low(TUseItems) to High(TUseItems) do begin
      if (g_UseItems[I].S.Name = cu.S.Name) and (g_UseItems[I].MakeIndex = cu.MakeIndex) then begin
        g_UseItems[I] := cu;
      end;
    end;

    for I := Low(TJewelryBoxItems) to High(TJewelryBoxItems) do begin
      if (g_JewelryBoxItems[I].S.Name = cu.S.Name) and (g_JewelryBoxItems[I].MakeIndex = cu.MakeIndex) then begin
        g_JewelryBoxItems[I] := cu;
      end;
    end;

    for I := Low(TGodBlessItems) to High(TGodBlessItems) do begin
      if (g_GodBlessItems[I].S.Name = cu.S.Name) and (g_GodBlessItems[I].MakeIndex = cu.MakeIndex) then begin
        g_GodBlessItems[I] := cu;
      end;
    end;

    for I := 0 to g_FengHaoItems.Count - 1 do begin
      CI := g_FengHaoItems.Items[I];
      if (CI.S.Name = cu.S.Name) and (CI.MakeIndex = cu.MakeIndex) then begin
        CI^ := cu;
      end;
    end;

    for I := 0 to g_HeroFengHaoItems.Count - 1 do begin
      CI := g_HeroFengHaoItems.Items[I];
      if (CI.S.Name = cu.S.Name) and (CI.MakeIndex = cu.MakeIndex) then begin
        CI^ := cu;
      end;
    end;
  end;
end;

procedure TfrmMain.ProcessMessageDelItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, iindex:Integer;
  Str, iname:string;
begin
  sData := DecodeString(sData);
  while sData <> '' do begin
    sData := GetValidStr3_Ex(sData, iname, '/');
    sData := GetValidStr3_Ex(sData, Str, '/');
    if (iname <> '') and (Str <> '') then begin
      iindex := StrToIntDef(Str, 0);
      DelItemBag(iname, iindex);
      if g_WaitingUseItem.Item.MakeIndex = iindex then
        g_WaitingUseItem.Item.s.Name := '';
      for I := Low(TUseItems) to High(TUseItems) do begin
        if (g_UseItems[I].S.Name = iname) and (g_UseItems[I].MakeIndex = iindex) then begin
          g_UseItems[I].S.Name := '';
        end;
      end;

      for I := Low(TJewelryBoxItems) to High(TJewelryBoxItems) do begin
        if (g_JewelryBoxItems[I].S.Name = iname) and (g_JewelryBoxItems[I].MakeIndex = iindex) then begin
          g_JewelryBoxItems[I].S.Name := '';
        end;
      end;

      for I := Low(TGodBlessItems) to High(TGodBlessItems) do begin
        if (g_GodBlessItems[I].S.Name = iname) and (g_GodBlessItems[I].MakeIndex = iindex) then begin
          g_GodBlessItems[I].S.Name := '';
        end;
      end;
    end
    else
      Break;
  end;
end;

