procedure LoadMapFileList();
var
    i:Integer;
    sLine, sFile:string;
    slstMap:TStringList;
begin
    slstMap := TStringList.Create;
    if g_MapFileList = nil then begin
       g_MapFileList := TStringList.Create;
    end else begin
       g_MapFileList.Clear;
    end;
    
    try
        sFile := g_sSelfFilePath + 'MapFileList.txt';
        if FileExists(sFile) then begin
            slstMap.LoadFromFile(sFile);
            for I := 0 to slstMap.Count - 1 do begin
                sLine := Trim(slstMap[i]);
                if sLine <> '' then begin
                    g_MapFileList.Add( g_sSelfFilePath + sLine);
                end;
            end;
        end;
    except

    end;
    slstMap.Free;
end;

