              AppFuncDef.ZLibEncodeBuffer := @_ZLibEncodeBuffer;
              AppFuncDef.ZLibDecodeBuffer := @_ZLibDecodeBuffer;

              Init(@AppFuncDef, BufferCrc(@AppFuncDef, SizeOf(AppFuncDef)), 0);
