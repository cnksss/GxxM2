          Actor.m_CustomMagicStatusEffect.Status2_CalcDir := CustomMagicConfig.MagicConfigs[MagicPlusLevel].TargetStatus2_CalcDir;
          Actor.m_CustomMagicStatusEffect.boShow := True;
