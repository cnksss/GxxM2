      IsNewOpen := not TSerialWindows(FrmDlg).DSWGodBlessDlg.Visible;
    end else if not TSerialWindows(FrmDlg).DStateWin.Visible then begin
      IsNewOpen := True;
      TSerialWindows(FrmDlg).OpenDStateWinDlg;
    end;

    TSerialWindows(FrmDlg).DStatePageControl.ActivePage := StateWindows.MainTabSheet1;
    //if TSerialWindows(FrmDlg).DStateWin.Visible then
    begin
      case DefMsg.Param of
        0:TSerialWindows(FrmDlg).DStatePageControl.ActivePage := TSerialWindows(FrmDlg).DStateTabSheet1;
