procedure TfrmMain.ProcessMessageSendShopItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);

  procedure AddShopItem(Item:TShopClientItem);
  var
    I:Integer;
  begin
    for I := 0 to 9 do begin
      if g_ShopItems[DefMsg.Param, I].StdItem.Name = '' then begin
        Item.StdItem.DBName := Item.StdItem.Name;
        Item.StdItem.Name := ProcessItemName(Item.StdItem.Name);
        g_ShopItems[DefMsg.Param, I] := Item;
        Break;
      end;
    end;
  end;

  procedure AddShopItem1(Item:TShopClientItem);
  var
    I:Integer;
  begin
    for I := 0 to 4 do begin
      if g_ShopItems1[I].StdItem.Name = '' then begin
        Item.StdItem.DBName := Item.StdItem.Name;
        Item.StdItem.Name := ProcessItemName(Item.StdItem.Name);
        g_ShopItems1[I] := Item;
        Break;
      end;
    end;
  end;

var
  I, nC, nData:Integer;
  cu:pTShopClientItem;
  Buffer:PChar;
begin
  if DefMsg.Param in [0..5] then begin
    if DefMsg.Param < 5 then begin
      g_ShopTablePages[DefMsg.Param] := DefMsg.Tag; // 当前页
      g_ShopTablePageCounts[DefMsg.Param] := DefMsg.Series; // 总页数
      FrmDlg.ShopTabPage := DefMsg.Param; // 商铺类型

      SafeFillChar(g_ShopItems[DefMsg.Param], SizeOf(TShopClientItem) * 10, #0);

      nC := LoWord(DefMsg.Recog);
      nData := HiWord(DefMsg.Recog);
      if (nData = Length(sData)) and (Length(sData) = nC * SizeOf(TShopClientItem)) then begin
        Buffer := PChar(sData);
        for I := 0 to nC - 1 do begin
          cu := pTShopClientItem(Buffer);
          Buffer := Buffer + SizeOf(TShopClientItem);
          AddShopItem(cu^);
        end;
      end;
    end else begin
      SafeFillChar(g_ShopItems1, SizeOf(TShopClientItem) * 5, #0);
      nC := LoWord(DefMsg.Recog);
      nData := HiWord(DefMsg.Recog);
      if (nData = Length(sData)) and (Length(sData) = nC * SizeOf(TShopClientItem)) then begin
        Buffer := PChar(sData);
        for I := 0 to nC - 1 do begin
          cu := pTShopClientItem(Buffer);
          Buffer := Buffer + SizeOf(TShopClientItem);
          AddShopItem1(cu^);
        end;
      end;
    end;
    // 商铺界面显示页码 piaoyun 2013-08-15
    if (FrmDlg is TSerialWindows) then
      TSerialWindows(FrmDlg).ShopPageChange;
  end;
end;

procedure TfrmMain.ProcessMessageSendRanking(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);

  procedure AddUserRanking(Ranking:TUserLevelRanking);
  var
    I:Integer;
  begin
    for I := 0 to 9 do begin
      if g_UserLevelRankings[I].sChrName = '' then begin
        g_UserLevelRankings[I] := Ranking;
        Break;
      end;
    end;
  end;

  procedure AddHeroRanking(Ranking:THeroLevelRanking);
  var
    I:Integer;
  begin
    for I := 0 to 9 do begin
      if g_HeroLevelRankings[I].sChrName = '' then begin
        g_HeroLevelRankings[I] := Ranking;
        Break;
      end;
    end;
  end;

  procedure AddMasterRanking(Ranking:TUserMasterRanking);
  var
    I:Integer;
  begin
    for I := 0 to 9 do begin
      if g_UserMasterRankings[I].sChrName = '' then begin
        g_UserMasterRankings[I] := Ranking;
        Break;
      end;
    end;
  end;

var
  UserRanking:TUserLevelRanking;
  HeroRanking:THeroLevelRanking;
  MasterRanking:TUserMasterRanking;
  Str:string;
begin
  if DefMsg.Recog < 0 then begin
    case DefMsg.Series of
      1:
        FrmDlg.DMessageDlg('[失败] 服务器繁忙，请稍后在试！', [mbOk]);
      2:
        FrmDlg.DMessageDlg('[失败] 排行榜刷新失败！', [mbOk]);
      3:
        FrmDlg.DMessageDlg('[提示] 排行榜系统未开放！', [mbOk]);
    end;
    Exit;
  end;
  // FrmDlg.DMessageDlg('Msg.Param:'+inttostr(Msg.Param)+' Msg.Recog:'+inttostr(Msg.Recog)+' Msg.Tag:'+inttostr(Msg.Tag)+' Msg.Series:'+inttostr(Msg.Series), [mbOk]);
  if DefMsg.Param in [0..2] then begin
    // 如果返回数据太慢，跑到别的页去了，不展现数据 chongchong 2015-06-11
    if g_nRankingsTablePage <> DefMsg.Param then
      Exit;

    g_nRankingsTablePage := DefMsg.Param;
    g_nRankingsTableType := DefMsg.Recog;
    g_nRankingsPage := DefMsg.Tag;
    g_nRankingsPageCount := DefMsg.Series;
    // FrmDlg.RankingPage := Msg.Param;
    case g_nRankingsTablePage of
      0:begin
          // FrmDlg.RankingPageChanged(FrmDlg.DCharRanking);
          // FrmDlg.DCharRanking.OnClick(FrmDlg.DCharRanking, 0, 0);
          SafeFillChar(g_UserLevelRankings, SizeOf(g_UserLevelRankings), #0);
          while True do begin
            if sData = '' then
              Break;
            sData := GetValidStr3_Ex(sData, Str, '/');
            DecodeString(Str, @UserRanking, SizeOf(TUserLevelRanking));
            AddUserRanking(UserRanking);
          end;
        end;
      1:begin
          SafeFillChar(g_HeroLevelRankings, SizeOf(g_HeroLevelRankings), #0);
          while True do begin
            if sData = '' then
              Break;
            sData := GetValidStr3_Ex(sData, Str, '/');
            DecodeString(Str, @HeroRanking, SizeOf(THeroLevelRanking));
            AddHeroRanking(HeroRanking);
          end;
        end;
      2:begin
          // FrmDlg.RankingPageChanged(FrmDlg.DMasterRanking);
          // FrmDlg.DMasterRanking.OnClick(FrmDlg.DMasterRanking, 0, 0);
          SafeFillChar(g_UserMasterRankings, SizeOf(g_UserMasterRankings), #0);
          while True do begin
            if sData = '' then
              Break;
            sData := GetValidStr3_Ex(sData, Str, '/');
            DecodeString(Str, @MasterRanking, SizeOf(TUserMasterRanking));
            AddMasterRanking(MasterRanking);
          end;
        end;
    end;
  end;
end;

