procedure TfrmMain.ProcessMessageQueryDelChr(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);

  function AddDeleteHumanInfo(DeleteHumanInfo:pTDeleteHumanInfo):Integer;
  var
    I:Integer;
  begin
    Result := -1;
    for I := 0 to Length(g_DeleteHumanInfoArray) - 1 do begin
      if g_DeleteHumanInfoArray[I].sChrName = '' then begin
        g_DeleteHumanInfoArray[I] := DeleteHumanInfo^;
        Result := I;
        break;
      end;
    end;
  end;

var
  Str:string;
  nIndex:Integer;
  ListItem:TDxListItem;
  ViewItem:pTViewItem;
  DeleteHumanInfo:TDeleteHumanInfo;
begin
  g_SelDeleteHumanInfo.sChrName := '';
  SafeFillChar(g_DeleteHumanInfoArray, SizeOf(g_DeleteHumanInfoArray), #0);

  FrmDlg.DListViewDeleteHuman.Clear;
  while True do begin
    if sData = '' then
      Break;
    sData := GetValidStr3_Ex(sData, Str, '/');
    if Str = '' then
      break;

    DecodeString(Str, @DeleteHumanInfo, SizeOf(TDeleteHumanInfo));
    nIndex := AddDeleteHumanInfo(@DeleteHumanInfo);
    if nIndex >= 0 then begin
      ListItem := FrmDlg.DListViewDeleteHuman.Add;
      FrmDlg.DListViewDeleteHuman.Lock;
      try
        // ListItem.Style := bsRadio;
        ViewItem := ListItem.AddItem('', nil); // 人物名称
        ViewItem.Data := @g_DeleteHumanInfoArray[nIndex];
        ViewItem.Caption := '  ' + DeleteHumanInfo.sChrName;
        ViewItem.Alignment := taLeftJustify;
        ViewItem.Color.Up.Color := clWhite;
        ViewItem.Color.Hot.Color := clWhite;
        ViewItem.Color.Down.Color := clRed;
        ViewItem.Color.Checked.Color := clRed;
        ViewItem.Style := bsRadio;

        ViewItem := ListItem.AddItem('', nil); // 等级
        ViewItem.Data := @g_DeleteHumanInfoArray[nIndex];
        ViewItem.Caption := IntToStr(DeleteHumanInfo.nLevel) + '级';
        ViewItem.Color.Up.Color := clWhite;
        ViewItem.Color.Hot.Color := clWhite;
        ViewItem.Color.Down.Color := clRed;
        ViewItem.Color.Checked.Color := clRed;
        ViewItem.Style := bsCheckBox;

        ViewItem := ListItem.AddItem('', nil); // 职业
        ViewItem.Data := @g_DeleteHumanInfoArray[nIndex];
        ViewItem.Caption := GetJobName(DeleteHumanInfo.btJob);
        ViewItem.Color.Up.Color := clWhite;
        ViewItem.Color.Hot.Color := clWhite;
        ViewItem.Color.Down.Color := clRed;
        ViewItem.Color.Checked.Color := clRed;
        ViewItem.Style := bsCheckBox;

        ViewItem := ListItem.AddItem('', nil); // 性别
        ViewItem.Data := @g_DeleteHumanInfoArray[nIndex];
        ViewItem.Caption := GetSexName(DeleteHumanInfo.btSex);
        ViewItem.Color.Up.Color := clWhite;
        ViewItem.Color.Hot.Color := clWhite;
        ViewItem.Color.Down.Color := clRed;
        ViewItem.Color.Checked.Color := clRed;
        ViewItem.Style := bsCheckBox;
      finally
        FrmDlg.DListViewDeleteHuman.UnLock;
      end;
    end;
  end;
  FrmDlg.OpenDDeleteHumanDlg;
end;

