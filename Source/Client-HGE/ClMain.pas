      if GetCanLongHit and g_WarrContinueHitManager.CanUseMagic(12) then begin
        ClientMagic := FindMagic(12);
        if ClientMagic <> nil then begin
          if MyGetTickCount - ClientMagic.dwLastUseTick >= ClientMagic.dwInterval then begin
            Result := CM_LONGHIT;
            Exit;
          end;
        end;
      end;

      for II := 0 to Length(g_AutoCustomMagic[mngoLongHit]) - 1 do begin
        CustomMagiID := g_AutoCustomMagic[mngoLongHit][II];

        if CheckIsCustomMagic(CustomMagiID) and (g_boNextTimeCustomMagicList.IndexOf(Pointer(CustomMagiID - CUSTOM_MAGIC_START_ID)) >= 0) and g_WarrContinueHitManager.CanUseMagic(CustomMagiID) then begin
          CustomMagicConfig := GetCustomMagicConfig(CustomMagiID);
          if (CustomMagicConfig <> nil) and CustomMagicConfig.boIsMagicWarr and (CustomMagicConfig.MagicBaseConfig.MagicSwitchMode <> msmNone) then begin
            ClientMagic := FindMagic(CustomMagiID);

            if (ClientMagic <> nil) and (MyGetTickCount - ClientMagic.dwLastUseTick >= ClientMagic.Def.dwMagicDelayTime) and CheckCustomMagicNeedItem(CustomMagiID) then begin
              nSpellPoint := Round(ClientMagic.Def.wSpell / (ClientMagic.Def.btTrainLv + 1) * (ClientMagic.Level + 1)) + ClientMagic.Def.wDefSpell;

              if CustomMagicConfig.IsAttackUseNG then
                IsOK := g_MySelf.m_boTrainingNG and (nSpellPoint <= g_MySelf.m_AbilNG.NH)
              else
                IsOK := True;

              if IsOK then begin
                Result := CM_CUSTOM_HIT001 + (CustomMagiID - CUSTOM_MAGIC_START_ID);
                Exit;
              end;
            end;
          end;
        end;
      end;
    end;

    // DScreen.AddChatBoardString('SearchHitMsg 1 ', clGreen, clWhite);

    if g_ClientConfig.boSmartWalkLongHit and g_ConfigDlg.ConfigCheckeds[ckSmartWalkLongHit] then begin // 走位刺杀
      if frmMain.TargetInSwordLongAttackRange(tdir, Actor, 3) or ((not frmMain.TargetInSwordLongAttackRange(tdir, Actor, 3)) and GetWalkLongHitXY(Actor.m_nCurrX, Actor.m_nCurrY, nX, nY)) then begin
        if GetCanLongHit and g_WarrContinueHitManager.CanUseMagic(12) then begin
          ClientMagic := FindMagic(12);
          if ClientMagic <> nil then begin
            if MyGetTickCount - ClientMagic.dwLastUseTick >= ClientMagic.dwInterval then begin
              Result := CM_LONGHIT;
              Exit;
            end;
          end;
        end;

        for II := 0 to Length(g_AutoCustomMagic[mngoLongHit]) - 1 do begin
          CustomMagiID := g_AutoCustomMagic[mngoLongHit][II];
          if CheckIsCustomMagic(CustomMagiID) and (g_boNextTimeCustomMagicList.IndexOf(Pointer(CustomMagiID - CUSTOM_MAGIC_START_ID)) >= 0) and g_WarrContinueHitManager.CanUseMagic(CustomMagiID) then begin
            CustomMagicConfig := GetCustomMagicConfig(CustomMagiID);
            if (CustomMagicConfig <> nil) and CustomMagicConfig.boIsMagicWarr and (CustomMagicConfig.MagicBaseConfig.MagicSwitchMode <> msmNone) then begin
              ClientMagic := FindMagic(CustomMagiID);

              if (ClientMagic <> nil) and (MyGetTickCount - ClientMagic.dwLastUseTick >= ClientMagic.Def.dwMagicDelayTime) and CheckCustomMagicNeedItem(CustomMagiID) then begin
                nSpellPoint := Round(ClientMagic.Def.wSpell / (ClientMagic.Def.btTrainLv + 1) * (ClientMagic.Level + 1)) + ClientMagic.Def.wDefSpell;

                if CustomMagicConfig.IsAttackUseNG then
                  IsOK := g_MySelf.m_boTrainingNG and (nSpellPoint <= g_MySelf.m_AbilNG.NH)
                else
                  IsOK := True;

                if IsOK then begin
                  Result := CM_CUSTOM_HIT001 + (CustomMagiID - CUSTOM_MAGIC_START_ID);
                  Exit;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

function GetHitEffectLevel(HitMsg:Integer):Integer; // 获取强化技能等级

  function GetMagicNewLevel(wMagicID:Integer):Integer;
  var
    I:Integer;
  begin
    Result := 0;
    for I := 0 to g_MagicList.Count - 1 do begin
      if PTClientMagic(g_MagicList.Items[I]).Def.wMagicId = wMagicID then begin
        // 4级技能强化 -- 4级烈火 chongchong 2013-12-04
        if wMagicID = 26 then
          Result := MakeLong(PTClientMagic(g_MagicList.Items[I]).NewLevel, PTClientMagic(g_MagicList.Items[I]).Level)
        else
          Result := PTClientMagic(g_MagicList.Items[I]).NewLevel;
        break;
      end;
    end;
  end;

begin
  if (HitMsg >= CM_CUSTOM_HIT001) and (HitMsg < CM_CUSTOM_HIT001 + CUSTOM_MAGIC_COUNT) then
    Result := GetMagicNewLevel(HitMsg - CM_CUSTOM_HIT001 + CUSTOM_MAGIC_START_ID)
  else begin
    case HitMsg of
      CM_POWERHIT:
        Result := GetMagicNewLevel(7); // 攻杀剑术
      CM_LONGHIT:
        Result := GetMagicNewLevel(12); // 刺杀剑术
      CM_WIDEHIT:
        Result := GetMagicNewLevel(25); // 半月弯刀
      CM_FIREHIT:
        Result := GetMagicNewLevel(26); // 烈火剑法
      CM_SWORDHIT:
        Result := GetMagicNewLevel(56); // 逐日剑法
      else
        Result := 0;
    end;
  end;
end;

procedure TfrmMain.CancelUpgradeItem(merchant:Int64; boCheckMerchant:Boolean);
begin
  if (g_nCurMerchant <> merchant) or (not boCheckMerchant) then begin // 取回正在OK框升级的装备
    if (FrmDlg.SpotDlgMode = dmUpgrade) and (g_SellDlgItemSellWait.S.Name <> '') then begin
      SendCancelUpgradeItem(g_nCurMerchant, g_SellDlgItemSellWait.MakeIndex, g_SellDlgItemSellWait.S.Name);
    end;
    if boCheckMerchant then
      g_nCurMerchant := merchant;
  end;
end;

function IsInLine(nTargetX, nTargetY:Integer):Boolean;
var
  nCurrX, nCurrY:Integer;
  btDir:Byte;
begin
  Result := False;

  nCurrX := g_MySelf.m_nCurrX;
  nCurrY := g_MySelf.m_nCurrY;
  btDir := GetNextDirection(nCurrX, nCurrY, nTargetX, nTargetY);
  while True do begin
    if (nCurrX = nTargetX) and (nCurrY = nTargetY) then
      Break;
    GetFrontPosition(nCurrX, nCurrY, btDir, nCurrX, nCurrY);
    btDir := GetNextDirection(nCurrX, nCurrY, nCurrX, nCurrY);
    if (nCurrX = nTargetX) and (nCurrY = nTargetY) then begin
      Result := True;
      Break;
    end;
    if GetNextDirection(nCurrX, nCurrY, nTargetX, nTargetY) <> btDir then begin
      Result := False;
      Break;
    end;
  end;
end;

function IsInRangeLine(nTargetX, nTargetY, nRange:Integer):Boolean; overload;
var
  I:Integer;
  nCurrX, nCurrY:Integer;
  btDir:Byte;
begin
  Result := False;
  nCurrX := g_MySelf.m_nCurrX;
  nCurrY := g_MySelf.m_nCurrY;
  btDir := GetNextDirection(nCurrX, nCurrY, nTargetX, nTargetY);
  for I := 1 to nRange do begin
    if (nCurrX = nTargetX) and (nCurrY = nTargetY) then
      Break;
    GetFrontPosition(nCurrX, nCurrY, btDir, nCurrX, nCurrY);
    btDir := GetNextDirection(nCurrX, nCurrY, nCurrX, nCurrY);
    if (nCurrX = nTargetX) and (nCurrY = nTargetY) then begin
      Result := True;
      Break;
    end;
    if GetNextDirection(nCurrX, nCurrY, nTargetX, nTargetY) <> btDir then begin
      Result := False;
      Break;
    end;
  end;
end;

function TargetInRangeLine(target:TActor; nRange:Integer):Boolean; overload;
var
  I:Integer;
  Actor:TActor;
  nCurrX, nCurrY:Integer;
  btDir:Byte;
begin
  Result := False;
  if g_MySelf = nil then
    Exit;
  nCurrX := g_MySelf.m_nCurrX;
  nCurrY := g_MySelf.m_nCurrY;
  btDir := GetNextDirection(nCurrX, nCurrY, target.m_nCurrX, target.m_nCurrY);
  for I := 1 to nRange do begin
    Actor := PlayScene.FindActorXY(nCurrX, nCurrY);
    if (Actor = target) then begin
      Result := True;
      Break;
    end;
    GetFrontPosition(nCurrX, nCurrY, btDir, nCurrX, nCurrY);
    btDir := GetNextDirection(nCurrX, nCurrY, nCurrX, nCurrY);

    if GetNextDirection(nCurrX, nCurrY, target.m_nCurrX, target.m_nCurrY) <> btDir then begin
      Result := False;
      Break;
    end;
  end;
end;

function GetWalkLongHitXY(nCurrX, nCurrY:Integer; var nX, nY:Integer):Boolean; // 获取刺杀坐标

  procedure GetLongHitXY(sx, sy:Integer; var dx, dy:Integer);
  var
    btDir:Byte;
  begin
    if (abs(g_MySelf.m_nCurrX - sx) > 2) or (abs(g_MySelf.m_nCurrY - sy) > 2) then begin
      btDir := GetNextDirection(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, sx, sy);
      GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, btDir, dx, dy);
    end;
  end;

var
  btDir:Byte;
  ndir:Integer;
begin
  Result := False;
  if g_MySelf = nil then
    Exit;
  nX := nCurrX;
  nY := nCurrY;
  btDir := GetNextDirection(nCurrX, nCurrY, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
  GetFrontPosition(nX, nY, btDir, 2, nX, nY);
  if ((nCurrX <> nX) or (nCurrY <> nY)) then begin
    if (abs(g_MySelf.m_nCurrX - nX) <= 1) and (abs(g_MySelf.m_nCurrY - nY) <= 1) then begin
      if PlayScene.CanWalk(nX, nY) then begin
        Result := True;
        Exit;
      end;
    end
    else begin
      if PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY) then begin
        // GetLongHitXY(nX, nY, nX, nY);
        Result := True;
        Exit;
      end;
    end;
  end;

  if btDir + 1 > 7 then
    btDir := 0
  else
    btDir := btDir + 1;
  GetFrontPosition(nX, nY, btDir, 2, nX, nY);
  if ((nCurrX <> nX) or (nCurrY <> nY)) then begin
    if (abs(g_MySelf.m_nCurrX - nX) <= 1) and (abs(g_MySelf.m_nCurrY - nY) <= 1) then begin
      if PlayScene.CanWalk(nX, nY) then begin
        Result := True;
        Exit;
      end;
    end
    else begin
      if PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY) then begin
        // GetLongHitXY(nX, nY, nX, nY);
        Result := True;
        Exit;
      end;
    end;
  end;

  btDir := GetNextDirection(nCurrX, nCurrY, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
  if btDir - 1 < 0 then
    btDir := 7
  else
    btDir := btDir - 1;
  GetFrontPosition(nX, nY, btDir, 2, nX, nY);
  if ((nCurrX <> nX) or (nCurrY <> nY)) then begin
    if (abs(g_MySelf.m_nCurrX - nX) <= 1) and (abs(g_MySelf.m_nCurrY - nY) <= 1) then begin
      if PlayScene.CanWalk(nX, nY) then begin
        Result := True;
        Exit;
      end;
    end
    else begin
      if PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY) then begin
        // GetLongHitXY(nX, nY, nX, nY);
        Result := True;
        Exit;
      end;
    end;
  end;

  // ==============================================================================
  ndir := GetNextDirection(nCurrX, nCurrY, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
  Inc(ndir);
  if ndir > 7 then
    ndir := 0;
  Inc(ndir);
  if ndir > 7 then
    ndir := 0;
  btDir := ndir;

  GetFrontPosition(nX, nY, btDir, 2, nX, nY);
  if ((nCurrX <> nX) or (nCurrY <> nY)) then begin
    if (abs(g_MySelf.m_nCurrX - nX) <= 1) and (abs(g_MySelf.m_nCurrY - nY) <= 1) then begin
      if PlayScene.CanWalk(nX, nY) then begin
        Result := True;
        Exit;
      end;
    end
    else begin
      if PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY) then begin
        // GetLongHitXY(nX, nY, nX, nY);
        Result := True;
        Exit;
      end;
    end;
  end;

  ndir := GetNextDirection(nCurrX, nCurrY, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
  Dec(ndir);
  if ndir < 0 then
    ndir := 7;
  Dec(ndir);
  if ndir < 0 then
    ndir := 7;
  btDir := ndir;

  GetFrontPosition(nX, nY, btDir, 2, nX, nY);
  if ((nCurrX <> nX) or (nCurrY <> nY)) then begin
    if (abs(g_MySelf.m_nCurrX - nX) <= 1) and (abs(g_MySelf.m_nCurrY - nY) <= 1) then begin
      if PlayScene.CanWalk(nX, nY) then begin
        Result := True;
        Exit;
      end;
    end
    else begin
      if PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY) then begin
        // GetLongHitXY(nX, nY, nX, nY);
        Result := True;
        Exit;
      end;
    end;
  end;
end;

