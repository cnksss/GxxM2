procedure TfrmMain.CSocketRead(Sender:TObject; Socket:TCustomWinSocket);
var
  n, EncRecLen:Integer;
  sData, sData2:string;
begin
  g_RecvBufTick := MyGetTickCount;

  if g_ConnectionStep = cnsPlay then begin
    sData := Socket.ReceiveText;
    SocStr := SocStr + sData;
  end else begin
    sData := Socket.ReceiveText;
    n := Pos('*', sData);

    if n > 0 then begin
      sData2 := System.Copy(sData, 1, n - 1);
      sData := sData2 + System.Copy(sData, n + 1, Length(sData));
      if CSocket.Socket.SendText('*') <> 1 then begin
        sData2 := '*';
        EnterCriticalSection(g_SendSocketLock);
        try
          g_SendStream.Write(sData2[1], Length(sData2));
        finally
          LeaveCriticalSection(g_SendSocketLock);
        end;
      end;
    end;

    if not boFirstSend then begin
      boFirstSend := True;
      LoginGatePassword[0] := 0;
      LoginGatePassword[1] := 0;
      LoginGatePassword[2] := 0;
      LoginGatePassword[3] := 0;

      EncRecLen := GetEncodeSize(SizeOf(LoginGatePassword));
      n := length(sData) - EncRecLen;

      if (n >= 0) then begin
        DecodeString(sData, @LoginGatePassword, SizeOf(LoginGatePassword));

        if n > 0 then
          SocStr := Copy(sData, EncRecLen + 1, n);
      end else begin
        SocStr := SocStr + sData;
      end;

      { 与登录网关连接后，向登录网关发送机器码 }
      SendMachineID;
    end else begin
      SocStr := SocStr + sData;
    end;
  end;
end;

