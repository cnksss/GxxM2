function ReadKeyFromBIO(In_BIO:PBIO; IsPublicKey:Boolean):PRSA;
var
  pKey, pKey2:PEVP_PKEY;
begin
  pKey := nil;
  Result := nil;

  if IsPublicKey then
    pKey := PEM_read_bio_PUBKEY(In_BIO, pKey2, nil, nil)
  else
    pKey := PEM_read_bio_PrivateKey(In_BIO, nil, nil, nil);

  if pKey <> nil then
    Result := EVP_PKEY_get1_RSA(pKey);
end;
{$IFEND}

