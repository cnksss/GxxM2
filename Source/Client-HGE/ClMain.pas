      frmMain.ActionKey := 0;
      g_nTargetX := -1;
    end;
  end;}
  Result := g_boCanLongHit;
end;

function GetCanLongHit(ndir:Integer; target:TActor):Boolean; overload; // 刺杀
begin
  Result := False;

  GetCanLongHit;

  if g_boCanLongHit then begin
    { if PlugInEnabled and g_ClientConfig.boSmartWalkLongHit and g_ConfigDlg.ConfigCheckeds[ckSmartWalkLongHit] then begin // 走位刺杀
       if (not frmMain.TargetInSwordLongAttackRange(ndir, target, 3)) and // 检测目标是否在隔位刺杀的位置
         GetWalkLongHitXY(target.m_nCurrX, target.m_nCurrY, nX, nY) then begin
         Result := True;
         Exit;
       end;
     end;

     if (PlugInEnabled and g_ClientConfig.boSmartPosLongHit and
       g_ConfigDlg.ConfigCheckeds[ckSmartPosLongHit]) and frmMain.TargetInSwordLongAttackRange(ndir, target, 3) then begin // 隔位刺杀
       Result := True;
       Exit;
     end;}

    Result := frmMain.TargetInSwordLongAttackRange(ndir, target, 1) and frmMain.TargetInSwordLongAttackRange(ndir, 3);
  end;
end;

