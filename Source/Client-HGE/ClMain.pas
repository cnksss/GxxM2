        {$IFEND}
        g_boWaitLoadAntiPlugDllModule_IOCP2 := False;
        LoadDllAndInit_IOCP2(nil);
      end;
    end;
  end;
  {$IFEND}

  if g_MySelf <> nil then begin
    g_ConfigDlg.Run;

    if MyGetTickCount - FRefActorListTick >= 2000 then begin
      FRefActorListTick := MyGetTickCount;
      g_ConfigDlg.RefActorList;
    end;

    if g_NotFilterMsg[4] and (MyGetTickCount - g_dwAutoSayMsgTick > 1000 * 60) then begin
      g_dwAutoSayMsgTick := MyGetTickCount;
      if g_sAutoSayMsg <> '' then begin
        SendSay(g_sAutoSayMsg);
