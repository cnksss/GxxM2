  SendClientMessage(CM_AUTOGJ, 0, 0, 0, 0, '');
end;

procedure TfrmMain.StopGJ;
var
  I:Integer;
begin
  if not g_boGJRun then
    Exit;

  // 停止寻路 chongchong 2015-09-04
  LegendMap.Stop;

  FGJTargetCret := nil;
  g_TargetCret := nil;
  FGJCallMonMagicID := 0;

  for I := 0 to FGJExcludeMonList.Count - 1 do
    Dispose(PExcludeMonInfo(FGJExcludeMonList.Items[I]));
  FGJExcludeMonList.Clear;

  {$I VMProtectBegin.inc}
  FGJAutoPickupList.Clear;
  FGJExcludePickupList.Clear;
  FGJAutoPickupItem := nil;
  FGJWaitPickupTick := 0;
  FGJWaitCheckPickupTick := 0;

  SendClientMessage(CM_AUTOGJ, 0, 0, 0, 0, '');
  DScreen.AddChatBoardString(s_GJRunEnd, GetRGB(219), clWhite);

  g_boGJRun := False;
  if g_ClientConfig.btConfigDlgType = 0 then begin
    TMirConfigDlg(g_ConfigDlg).PlugButtonGJRun.Caption := s_GJRunStart;
    TMirConfigDlg(g_ConfigDlg).PlugCheckBoxLimitScreen.Enabled := True;
  end else if FrmJSYDlg <> nil then begin
    FrmJSYDlg.btnGJRun.Caption := s_GJRunStart;
    FrmJSYDlg.chkLimitScreen.Enabled := True;
  end;

  g_boSendGJRunToRunGate := False;
  SendClientMessage(CM_GJ_RUN_CHANGED, 0, 0, 0, 0, '');
  {$I VMProtectEnd.inc}
end;

function TfrmMain.GetGJPickItem:pTDropItem;
var
  I:Integer;
  DropItem:pTDropItem;
  nMinDis, nDis:Integer;
begin
  Result := nil;
  if FGJAutoPickupList.Count = 0 then
    Exit;

  nMinDis := 999;
  for I := 0 to FGJAutoPickupList.Count - 1 do begin
    DropItem := FGJAutoPickupList.Items[I];
    if (DropItem.ShowItem <> nil) and (pTShowItem(DropItem.ShowItem).boShowSpecial) then begin
      nDis := abs(Cutecode_T(DropItem.X) - g_MySelf.m_nCurrX) + abs(Cutecode_T(DropItem.Y) - g_MySelf.m_nCurrY);
      if nDis < nMinDis then begin
        nMinDis := nDis;
        Result := DropItem;
      end;
    end;
  end;

  if Result = nil then begin
    nMinDis := 999;
    for I := 0 to FGJAutoPickupList.Count - 1 do begin
      DropItem := FGJAutoPickupList.Items[I];
      nDis := abs(Cutecode_T(DropItem.X) - g_MySelf.m_nCurrX) + abs(Cutecode_T(DropItem.Y) - g_MySelf.m_nCurrY);
      if nDis < nMinDis then begin
        nMinDis := nDis;
        Result := DropItem;
      end;
    end;
  end;

  if Result = nil then
    Result := FGJAutoPickupList.Items[0];
end;

function TfrmMain.RunGJPickItem:Boolean;
var
  I, J, K:Integer;
  boFound:Boolean;
  DropItem:pTDropItem;
  List:TPointDropItemList;
begin
  Result := False;

  // 超过5分钟的物品，从排除列表删除
  for I := FGJExcludePickupList.Count - 1 downto 0 do begin
    DropItem := FGJExcludePickupList.Items[I];
    if MyGetTickCount - DropItem.dwGJExcludeTick >= 10 * 60 * 1000 then begin
      FGJExcludePickupList.Delete(I);
    end;
  end;

  if (FGJAutoPickupItem <> nil) and (FGJAutoPickupItem.Visible) then begin
    // 如果10秒钟都没有走到捡物的位置尝试捡物，这个物品不要了 chongchong 2014-12-03
    if (MyGetTickCount - FGJStartPickupTick >= 10000) or (not FGJAutoPickupItem.Visible) then begin
      for I := 0 to FGJAutoPickupList.Count - 1 do begin
        if FGJAutoPickupList.Items[I] = FGJAutoPickupItem then begin
          FGJAutoPickupList.Delete(I);
          Break;
        end;
      end;

      FGJAutoPickupItem.dwGJExcludeTick := MyGetTickCount;
      FGJExcludePickupList.Add(FGJAutoPickupItem);
      FGJAutoPickupItem := nil;
      FGJWaitPickupTick := 0;
      FGJWaitCheckPickupTick := 0;
      Result := True;
      Exit;
    end;

    // 等待捡物或捡物的时候，什么都不做，给点时间让客户端和服务器端坐标同步 chongchong 2014-12-04
    if FGJWaitPickupTick <> 0 then begin
      // 捡物的时候不能跑快了，跑快了捡不成功 (客户端坐标和服务器端不同步) chongchong 2014-12-04
      if MyGetTickCount - FGJWaitPickupTick >= g_ClientConfig.dwPluginPickupTime + 100 then begin
        for I := 0 to FGJAutoPickupList.Count - 1 do begin
          if FGJAutoPickupList.Items[I] = FGJAutoPickupItem then begin
            FGJAutoPickupList.Delete(I);
            Break;
          end;
        end;
        FGJAutoPickupItem.dwGJExcludeTick := MyGetTickCount;
        FGJExcludePickupList.Add(FGJAutoPickupItem);

        SendPickup(False);

        FGJWaitPickupTick := 0;
        FGJWaitCheckPickupTick := MyGetTickCount;
      end;

      Result := True;
      Exit;
    end;

    // 发送了捡物，等待检测 chongchong 2014-12-08
    {
    if (FGJWaitCheckPickupTick <> 0) then
    begin
      if (MyGetTickCount - FGJWaitCheckPickupTick < 1000) then
      begin
        for I := 0 to FGJAutoPickupList.Count - 1 do
        begin
          if FGJAutoPickupList.Items[I] = FGJAutoPickupItem then
          begin
            FGJAutoPickupList.Delete(I);
            Break;
          end;
        end;

        FGJAutoPickupItem.dwGJExcludeTick := MyGetTickCount;
        FGJExcludePickupList.Add(FGJAutoPickupItem);
        FGJAutoPickupItem := nil;
        FGJWaitPickupTick := 0;
        FGJWaitCheckPickupTick := 0;
      end;

      Exit;
    end;
    }
    // 刚捡完物品，等一会吧 2020-01-08
    if (FGJWaitCheckPickupTick <> 0) and (MyGetTickCount - FGJWaitCheckPickupTick < 1000) then begin
      Result := True;
      Exit;
    end;

    if (Cutecode_T(FGJAutoPickupItem.x) = g_MySelf.m_nCurrX) and (Cutecode_T(FGJAutoPickupItem.Y) = g_MySelf.m_nCurrY) then begin
      FGJWaitPickupTick := MyGetTickCount;
    end
    else begin
      g_nTargetX := Cutecode_T(FGJAutoPickupItem.x);
      g_nTargetY := Cutecode_T(FGJAutoPickupItem.y);
      if ((abs(g_MySelf.m_nCurrX - g_nTargetX) <= 1) or (abs(g_MySelf.m_nCurrY - g_nTargetY) <= 1)) or g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
        g_ChrAction := caWalk
      else begin
        g_ChrAction := caRun;
      end;
      FGJWaitPickupTick := 0;
    end;

    Result := True;
    Exit;
  end
  else if FGJAutoPickupList.Count > 0 then begin
    for I := FGJAutoPickupList.Count - 1 downto 0 do begin
      if not pTDropItem(FGJAutoPickupList.Items[I]).Visible then begin
        FGJAutoPickupList.Delete(I);
      end;
    end;

    if SameText(FGJAutoPickupMapName, g_sMapName) then begin
      if FGJAutoPickupList.Count > 0 then begin
        FGJAutoPickupItem := GetGJPickItem;

        FGJStartPickupTick := MyGetTickCount;
      end
      else begin
        FGJAutoPickupItem := nil;
        FGJStartPickupTick := 0;
      end;
    end
    else begin
      FGJAutoPickupList.Clear;
      FGJExcludePickupList.Clear;
    end;

    Result := True;
    Exit;
  end
  else {//if FGJTargetCret = nil then}  begin
    FGJAutoPickupMapName := g_sMapName;

    g_DropItemsMgr.Lock;
    try
      for I := 0 to g_DropItemsMgr.Count - 1 do begin
        List := g_DropItemsMgr.Items[I];
        for J := 0 to List.Count - 1 do begin
          DropItem := List.Items[J];
          boFound := False;
          for K := 0 to FGJExcludePickupList.Count - 1 do begin
            if DropItem = FGJExcludePickupList.Items[K] then begin
              boFound := True;
              Break;
            end;
          end;

          if (not boFound) and DropItem.Visible and (Abs(Cutecode_T(DropItem.X) - g_MySelf.m_nCurrX) <= 6) and (Abs(Cutecode_T(DropItem.Y) - g_MySelf.m_nCurrY) <= 6) and (DropItem.ShowItem <> nil) and (pTShowItem(DropItem.ShowItem).boPickup) then begin
            // 特殊物品优先捡取
            if pTShowItem(DropItem.ShowItem).boShowSpecial then begin
              FGJAutoPickupList.Insert(0, DropItem)
            end
            else begin
              FGJAutoPickupList.Add(DropItem);
            end;
          end;
        end;
      end;
    finally
      g_DropItemsMgr.UnLock;
    end;

    if FGJAutoPickupList.Count > 0 then begin
      Result := True;
      Exit;
    end;
  end;
end;

// HZQ 20230610
function TfrmMain.RunGJ_GetAttackMagicID(UseMagicList:TList):Integer;
var
  II, nShape:Integer;
  nX, nY:Integer;
  nSpellPoint, nCount, nIndex:Integer;
  boFound, boRed, boGreen:Boolean;
  DoMagic:PTClientMagic;
  MagicConfig:PClientCustomMagicConfig;
const
  // 召唤技能使用间隔
  CALLMONTIME = 90000; // 1.5分钟 90
begin
  if UseMagicList.Count > 0 then begin
    // 技能冷却时间没到的技能不用
    FGJTempList.Clear;
    FGJCallMonMagicList.Clear;
    for II := 0 to UseMagicList.Count - 1 do begin
      Result := Integer(UseMagicList.Items[II]);

      DoMagic := FindMagic(Result);
      if DoMagic = nil then Continue;

      if (MyGetTickCount - DoMagic.dwLastUseTick < DoMagic.dwInterval + 300) then Continue;

      if CheckIsCustomMagic(Result) then begin
        MagicConfig := GetCustomMagicConfig(Result);

        {
        if  then
        begin
          // 自定义技能如果是开关模式的，并已经开启，则不用再开启 chongchong 2015-09-17
          if not ((MagicConfig <> nil) and (MagicConfig.MagicBaseConfig.MagicSwitchMode) and g_boNextTimeCustomMagic[DoMagic.Def.wMagicId - CUSTOM_MAGIC_START_ID]) then
          begin

          end;
        end;
        }

        if (MagicConfig <> nil) then begin
          if CheckCustomMagicNeedItem(Result) then begin
            nSpellPoint := Round(DoMagic.Def.wSpell / (DoMagic.Def.btTrainLv + 1) * (DoMagic.Level + 1)) + DoMagic.Def.wDefSpell;

            if MagicConfig.IsAttackUseNG then begin
              boFound := g_MySelf.m_boTrainingNG and (nSpellPoint <= g_MySelf.m_AbilNG.NH);
            end else begin
              boFound := (Cardinal(nSpellPoint) <= g_MySelf.m_Abil.MP) or (DoMagic.Def.btEffectType = 0);
            end;

            if boFound then begin
              PlayScene.ScreenXYfromMCXY(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, nX, nY);
              g_MagicLockActor := FGJTargetCret;
              g_MagicTarget := FGJTargetCret;

              UseMagic(nX, nY, DoMagic);
            end;
          end;
        end;
      end else begin
        case Result of
          26: {// 烈火剑法} begin
              if MyGetTickCount - g_dwLatestFireHitTick < Cardinal(g_nFireHitDelayTime) then
                Continue;
            end;
          27:begin
              if MyGetTickCount - g_dwLatestRushRushTick < 1 * 1000 then
                Continue;
            end;
          56: {// 逐日剑法} begin
              if MyGetTickCount - g_dwLatestSwordHitTick < Cardinal(g_nSwordHitDelayTime) then
                Continue;
            end;
          66: {// 开天斩} begin
              if MyGetTickCount - g_dwLatest66HitTick < Cardinal(g_nKTZHitDelayTime) then
                Continue;
            end;
          42: {// 龙影剑法} begin
              if MyGetTickCount - g_dwLatest42HitTick < Cardinal(g_n42HitDelayTime) then
                Continue;
            end;
          113:begin
              if MyGetTickCount - g_dwLatest113HitTick < Cardinal(g_nDKZHitDelayTime) then
                Continue;
            end;
          115:begin
              if MyGetTickCount - g_dwLatest115HitTick < Cardinal(g_nXHYJHitDelayTime) then
                Continue;
            end;
        end;
      end;

      // 当前蓝不够的技能就不用了
      nSpellPoint := Round(DoMagic.Def.wSpell / (DoMagic.Def.btTrainLv + 1) * (DoMagic.Level + 1)) + DoMagic.Def.wDefSpell;
      boFound := (Cardinal(nSpellPoint) <= g_MySelf.m_Abil.MP) or IsInContinuous {g_boContinuous} or (DoMagic.Def.btEffectType = 0);

      // 先把召唤技能拿掉再说
      if boFound then begin
        if Result in [17 {召唤骷髅}, 30 {召唤神兽}, 76 {召唤圣兽}, 55 {召唤月灵}] then begin
          FGJCallMonMagicList.Add(Pointer(Result));
          boFound := False;
        end;
      end;

      // 施毒术，群毒术
      if boFound and (Result in [6, 51]) then begin
        if Result = 6 then
          nCount := 1
        else
          nCount := 5;

        boRed := FGJTargetCret.m_nState and $40000000 <> 0;
        boGreen := FGJTargetCret.m_nState and $80000000 <> 0;

        // 中了两种毒
        if boRed and boGreen then
          boFound := False // 只中了一种毒
        else if boRed or boGreen then begin
          if g_ClientConfig.nHumNeedMagicItem = 0 then
            boFound := True
          else begin
            nShape := 2;
            if CheckAmulet(nShape, nCount, nIndex) then begin
              // 中红毒，装备的是绿毒
              if boRed and (nShape = 1) then begin
                boFound := True // 中绿毒，装备的是红毒
              end else if boGreen and (nShape = 2) then begin
                boFound := True
              end else begin
                boFound := False;

                if (g_ConfigDlg.Enabled and g_ClientConfig.boAutoCHangePoison and g_ConfigDlg.ConfigCheckeds[ckAutoCHangePoison]) or (g_ClientConfig.nHumNeedMagicItem = 2) then begin
                  if boRed then
                    boFound := GetUserItemListEx(1, nCount) > 0
                  else
                    boFound := GetUserItemListEx(2, nCount) > 0
                end;
              end;
            end;
          end;
        end else begin
          boFound := True;  // 一种毒没中
        end;
      end;

      if boFound then
        FGJTempList.Add(Pointer(Result))
    end;

    // 如果有召唤技能并且召唤技能使用间隔有1.5分钟
    // 问下服务器看能不能用召唤技能
    if (FGJCallMonMagicList.Count > 0) and (MyGetTickCount - FGJCallMonMagicTick >= CALLMONTIME) then begin
      Result := Integer(FGJCallMonMagicList.Items[Random(FGJCallMonMagicList.Count)]);
      SendClientMessage(CM_GJ_CALLMON_MAGIC, 0, 0, 0, Result, '');
      FGJCallMonMagicTick := MyGetTickCount;
    end;

    if FGJTempList.Count > 0 then
      Result := Integer(FGJTempList.Items[Random(FGJTempList.Count)])
    else
      Result := 0;
  end
  else begin
    Result := 0;
  end;
end;

// HZQ 20230610处理挂机保护，自动吃药，并返回后续是否继续运行挂机函数 0 = 继续， 1 = 退出
function TfrmMain.RunGJ_ProcessGJPortect(nProtectPoisonOption:Integer):Integer;
var
   nIndex, UseItemStdMode:Integer;
begin
    Result := 0;
    // 小退
    if nProtectPoisonOption = g_NGProtectItems.Count - 1 then begin
       g_IsWaitLogout := True;
       StopGJ;
       frmMain.Logout;
       Result := 1;
    end else if (nProtectPoisonOption >= 0) and (nProtectPoisonOption < g_NGProtectItems.Count) then begin
      nIndex := FindHumBookItemIndex(g_NGProtectItems.Strings[nProtectPoisonOption]);
      if nIndex >= 0 then begin
        // 这里的1000更准确的应该为非吃药间隔
        UseItemStdMode := g_ItemArr[nIndex].S.StdMode;
        //AutoEatItem 毒符是否有用有待考证，原代码改写前，红、绿、毒符都是有AutoEatItem这个动作
        if (MyGetTickCount - g_dwAutoEatTime >= 1000) and frmMain.AutoEatItem(nIndex) then begin
          if UseItemStdMode <> 31 then begin
             StopGJ;
             Result := 1;
          end;
        end;
      end;
    end;
end;

//HZQ 20230612 把原来的查找未解包的药水独立出来，并合并了查找的两个循环
function TfrmMain.RunGJ_FinUnBindMedicine(nItemType:TUnBindItemType):Integer;
var
    i,j:Integer;
    UnBindItem:pTCustomBindItem;
begin
    Result := -1;
    for I := 0 to g_CustomUnbindItemList.Count - 1 do begin
        UnBindItem := g_CustomUnbindItemList.Items[I];
        if (UnBindItem.UnBindItemType = nItemType) and (UnBindItem.sBindItemName = '') then begin
          for J := Low(g_ItemArr) to GetMaxBagCount - 1 do begin
            if (CompareText(UnBindItem.sItemName, g_ItemArr[J].S.Name) = 0)  //HZQ, 20230612 抽出公共部分，并合并了两个循环
            or (CompareText(UnBindItem.sBindItemName, g_ItemArr[J].S.Name) = 0)  then begin
              Result := J;
              Exit;
            end;
          end;
        end;
    end; 
end;

procedure TfrmMain.RunGJ_FindAttackObjectList(objList:TList);
var
    i, J:Integer;
    Actor, Actor2:TActor;
    boFound, boCanAttack:Boolean;
    ExcludeMonInfo:PExcludeMonInfo;
begin
    // 没有攻击目标，找攻击目标 chongchong 2014-11-23
    for I := 0 to PlayScene.m_ActorList.Count - 1 do begin
      Actor := PlayScene.m_ActorList.Items[I];
      if IsGJAttackTarget(Actor) then begin
        // 不攻击怪物
        if g_GJMonList.IndexOf(Actor.m_sUserName) <> -1 then
          Continue;

        // 中间有障碍物也不攻击吧 chongchong 2014-12-08
        if not MagCanHitTarget(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, Actor.m_nCurrX, Actor.m_nCurrY) then
          Continue;

        // 修正挂机有时候会打假的对象 chongchong 2018-08-25 23:52:00
        if (Length(Actor.m_sUserName) = 0) then
          Continue;

        // 不抢别人的怪
        boFound := False;
        if g_ConfigDlg.ConfigCheckeds[ckGJ_NotRushMon] then begin
          for J := 0 to PlayScene.m_ActorList.Count - 1 do begin
            Actor2 := PlayScene.m_ActorList.Items[J];

            if (not Actor2.m_boDeath) and (not Actor2.m_boGhost) and (Actor2.m_btRace = RC_PLAYOBJECT) and (not Actor.m_boPlayMoster) and (Actor2 <> g_MySelf) and (Abs(Actor.m_nCurrX - Actor2.m_nCurrX) <= nGJNotRushMonRange) and (Abs(Actor.m_nCurrY - Actor2.m_nCurrY) <= nGJNotRushMonRange) then begin
              boFound := True;
              Break;
            end;
          end;
        end;

        if (not boFound) then begin
          // 找找排除列表，看有没有这个怪物 chongchong 2014-11-25
          for J := FGJExcludeMonList.Count - 1 downto 0 do begin
            ExcludeMonInfo := FGJExcludeMonList.Items[J];
            if ExcludeMonInfo.Mon = Actor then begin
              // 都已经站到跟前了，不用排除了 2019-12-20 02:29:00
              if (g_MySelf.m_btJob = 0) then begin
                boCanAttack := (Abs(Actor.m_nCurrX - g_MySelf.m_nCurrX) <= 1) and (Abs(Actor.m_nCurrY - g_MySelf.m_nCurrY) <= 1);
              end else begin
                boCanAttack := MagCanHitTarget(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, Actor.m_nCurrX, Actor.m_nCurrY);
              end;

              if boCanAttack then begin
                Dispose(ExcludeMonInfo);
                FGJExcludeMonList.Delete(J);
              end else begin
                boFound := True;
                Break;
              end;
            end;
          end;

          // 限制在当前屏幕
          if (not boFound) and g_ConfigDlg.ConfigCheckeds[ckGJ_LimitScreen] then begin
            boFound := (Abs(Actor.m_nCurrX - g_nGJStartX) >= 7) or (Abs(Actor.m_nCurrY - g_nGJStartY) >= 7);
          end else begin
            boFound := (Abs(Actor.m_nCurrX - g_MySelf.m_nCurrX) > 10) or (Abs(Actor.m_nCurrY - g_MySelf.m_nCurrY) > 10);
          end;

          if not boFound then begin
            objList.Add(Actor);
          end;
        end;
      end;
    end;
end;

function TfrmMain.RunGJ_FindAttackObjectFromList(nMinRange:Integer; objList:TList):TActor;
var
    i, TempRange:Integer;
    Actor:TActor;
begin
    Result := nil;
    if objList.Count > 0 then begin
      for I := 0 to objList.Count - 1 do begin
        Actor := objList.Items[I];
        // 加入 TempRange > 0，怪物不能和人物在同一个坐标点，不然打不到 chongchong 2018-08-25 18:43:00
        TempRange := Abs(g_MySelf.m_nCurrX - Actor.m_nCurrX) + Abs(g_MySelf.m_nCurrY - Actor.m_nCurrY);
        if (nMinRange >= TempRange) and (TempRange > 0) then begin
           nMinRange := TempRange;
          Result := Actor;
          //FGJTargetMapName := g_sMapName;
        end;
      end;
    end;
end;

function TfrmMain.RunGj_GetRoundMonstCount(X, Y:Integer; nDistance:Integer):Integer;
var
  I, J, nX, nY:Integer;
  Actor:TActor;
begin
  Result := 0;
  if nDistance <= 0 then nDistance := 1;

  for I := 0 to 7 do begin
    for J := 1 to nDistance do begin
      GetFrontPosition(X, Y, I, J, nX, nY);
      Actor := PlayScene.FindActorXY(nX, nY);
      if IsGJAttackTarget(Actor) then begin
          Inc(Result);
      end;
    end;
  end;
end;

procedure TfrmMain.RunGJ; //运行自动挂机
const
  // 召唤技能使用间隔
  CALLMONTIME = 90000; // 1.5分钟 90秒
  GJ_POINT_OFFSET = 3;
  {$J+}
  IsTrapped:Boolean = False; //HZQ 20230612
  LastSelfPosX:Integer = -1;   //自己最后所在的位置
  LastSelfPosY:Integer = -1;   //自己最后所在的位置
  LastTrappedTick:DWORD = 0;    // 被困时的时
  LastMonsterCount:Integer = 0;
  {$J-}
var
  I, J, K, nBagCount:Integer;
  Actor, Actor2:TActor;
  Item:PTClientItem;
  boFound, boBagFull, boCanAttack:Boolean;
  nDir, nX, nY, nIndex:Integer;
  UseMagicList:TList;
  MinRange, TempRange:Integer;
  ExcludeMonInfo:PExcludeMonInfo;
  AttackRang:Integer;
  MagicAttackID:Integer;
  DoMagic, Magic:PTClientMagic;
  nSpellPoint, nCount:Integer;
  nShape:Integer;
  boRed, boGreen:Boolean;
  GJPoint:LongInt;
  GJPointX, GJPointY:Integer;
  UseItemStdMode:Integer;
  MagicConfig:PClientCustomMagicConfig;
  UnBindItem:pTCustomBindItem;
  Count:Integer;
  boMagicLock:Boolean;
  IsWaitTime:Boolean;
  IsNearTarget:Boolean;
begin
  if g_MySelf = nil then Exit;
  if not g_boGJRun then Exit;


  if MyGetTickCount - dwGJRunTick < 25 then Exit;

  dwGJRunTick := MyGetTickCount;

  // 把锁定的目标搞掉，不然会自动物理攻击 chongchong 2014-11-26
  g_TargetCret := nil;

  // 红药用完回城 chongchong 2014-11-24
  if g_ConfigDlg.ConfigCheckeds[ckGJ_NoRedPoison] then begin
    nIndex := FindHumHPItemIndex;
    if nIndex < 0 then begin
      nIndex := RunGJ_FinUnBindMedicine(t_HP);

      if nIndex < 0 then begin
         if RunGJ_ProcessGJPortect(nGJNoRedPoisonOption) <> 0 then begin
             Exit;
         end;
      end;
    end;
  end;

  // 蓝药用完回城 chongchong 2014-11-24
  if g_ConfigDlg.ConfigCheckeds[ckGJ_NoBluePoison] then begin
    nIndex := FindHumMPItemIndex;
    if nIndex < 0 then begin
      nIndex := RunGJ_FinUnBindMedicine(t_MP); 
      if nIndex < 0 then begin
         if RunGJ_ProcessGJPortect(nGJNoBluePoisonOption) <> 0 then begin
             Exit;
         end; 
      end;
    end;
  end;

  // 毒符用完回城 chongchong 2014-11-24
  if g_ConfigDlg.ConfigCheckeds[ckGJ_NoDuFu] then begin
    nShape := 1;
    boFound := CheckAmulet(nShape, 1, nIndex);

    if not boFound then begin
      nShape := 5;
      boFound := CheckAmulet(nShape, 1, nIndex);
    end;

    if not boFound then
      boFound := GetUserItemList(1, 1) <> -1;

    if not boFound then
      boFound := GetUserItemList(5, 1) <> -1;

    if not boFound then begin
      if RunGJ_ProcessGJPortect(nGJNoDuFuOption) <> 0 then begin
         Exit;
      end;
    end;
  end;

  {$I VMProtectBegin.inc}
  if not g_boSendGJRunToRunGate then begin
    g_boSendGJRunToRunGate := True;
    SendClientMessage(CM_GJ_RUN_CHANGED, 0, 0, 0, 1, '');
  end;
  {$I VMProtectEnd.inc}

  boBagFull := True;
  nBagCount :=  GetMaxBagCount;
  for I := 6 to nBagCount - 1 do begin
    //OutputDebugString(Pchar(IntToStr(i)));
    if g_ItemArr[I].S.Name = '' then begin
      boBagFull := False;
      Break;
    end;
  end;


  // 包裹满时回城
  if g_ConfigDlg.ConfigCheckeds[ckGJ_BagFull] and boBagFull then begin
    // 小退
    if nGJBagFullOption = g_NGProtectItems.Count - 1 then begin
      g_IsWaitLogout := True;
      StopGJ;
      frmMain.Logout;
      Exit;
    end else if (nGJBagFullOption >= 0) and (nGJBagFullOption < g_NGProtectItems.Count) then begin
      nIndex := FindHumBookItemIndex(g_NGProtectItems.Strings[nGJBagFullOption]);
      if nIndex >= 0 then begin
        if (MyGetTickCount - g_dwAutoEatTime >= 1000) and frmMain.AutoEatItem(nIndex) then begin
          if g_ItemArr[nIndex].S.StdMode <> 31 then begin
            StopGJ;
            Exit;
          end;
        end;
      end;
    end;
  end;

  // 如果用户在操作，则用户接管
  if g_boMouseMoveDown then Exit;

  // 先看下2格内有没有怪物
  FGJTempList.Clear;
  GetRoundTargetList(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, FGJTempList, 2);
  if FGJTempList.Count = 0 then begin
    // 没有目标时先自动捡物 chongchong 2014-11-24
    if g_ConfigDlg.ConfigCheckeds[ckGJ_AutoPickup] and (not boBagFull) and (g_MySelf.m_Abil.Weight < g_MySelf.m_Abil.MaxWeight) then begin
      try
        if RunGJPickItem then Exit;
      except
        // 不知道会不会存在物品被别人捡走，列空访问空对象的问题
      end;
    end;
  end;

  // 如果排除列表中的怪物超过两分钟，从排除列表删除 chongchong 2014-11-25
  for I := FGJExcludeMonList.Count - 1 downto 0 do begin
    ExcludeMonInfo := FGJExcludeMonList.Items[I];
    if MyGetTickCount - ExcludeMonInfo.AddTick = 10 * 60 * 1000 then begin
      Dispose(PExcludeMonInfo(FGJExcludeMonList.Items[I]));
      FGJExcludeMonList.Delete(I);
    end;
  end;

  if (FGJTargetCret = nil) or (FGJTargetCret.m_boDeath) or (FGJTargetCret.m_boGhost) then begin
    FGJTargetCret := nil;
    FGJTempList.Clear;

    RunGJ_FindAttackObjectList(FGJTempList); //寻找可攻击目标，并放到列表中

    if FGJTargetCret = nil then begin
        Actor := RunGJ_FindAttackObjectFromList(10000, FGJTempList); //从列表中挑选合适的目标
        if Actor <> nil then begin
            if FGJTargetCret <> Actor then begin
               FGJTargetCretTick := MyGetTickCount;
            end;

            FGJTargetCret := Actor;
            FGJTargetMapName := g_sMapName;
        end;
    end;
  end else begin
    // 中间有障碍物也不攻击吧 chongchong 2014-12-08
    if (g_MySelf.m_btJob <> 0) and not MagCanHitTarget(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY) then begin
      FGJTargetCret := nil;
      Exit;
    end else if (Abs(FGJTargetCret.m_nCurrX - g_MySelf.m_nCurrX) > 10) or (Abs(FGJTargetCret.m_nCurrY - g_MySelf.m_nCurrY) > 10) then begin
      // 修正寻路时，跑动将怪物清掉了。然后寻路跑又将怪物设置为目标，反复操作
      // 导致来回跑 2019-12-20 02:10:00
      New(ExcludeMonInfo);
      ExcludeMonInfo.AddTick := MyGetTickCount;
      ExcludeMonInfo.Mon := FGJTargetCret;
      FGJExcludeMonList.Add(ExcludeMonInfo);

      FGJTargetCret := nil;
      Exit;
    end else if (g_sMapName <> FGJTargetMapName) or (MyGetTickCount - FGJTargetCretTick >= 20000) then begin
      FGJTargetCret := nil;
      Exit;
    end;
  end;

  if FGJTargetCret <> nil then begin
    // 有攻击目标还捡毛线的物 chongchong 2014-12-04
    FGJAutoPickupList.Clear;
    FGJAutoPickupItem := nil;
    FGJWaitPickupTick := 0;

    if g_ConfigDlg.ConfigCheckeds[ckGJ_LimitScreen] and ((Abs(FGJTargetCret.m_nCurrX - g_nGJStartX) >= 7) or (Abs(FGJTargetCret.m_nCurrY - g_nGJStartY) >= 7)) then begin
        FGJTargetCret := nil;
        if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
          g_ChrAction := caWalk
        else
          g_ChrAction := caRun;
        
        g_nTargetX := g_nGJStartX;
        g_nTargetY := g_nGJStartY;
        Exit;
    end;

    if g_MySelf.m_btJob = 0 then
      AttackRang := 1
    else
      AttackRang := 5;

    if (Abs(FGJTargetCret.m_nCurrX - g_MySelf.m_nCurrX) <= AttackRang) and (Abs(FGJTargetCret.m_nCurrY - g_MySelf.m_nCurrY) <= AttackRang) then begin
      // 打怪的时候也可能跑到挂机点去了，跑到了附近的话，不用再跑了 chongchong 2015-09-05
      if g_AutoGJPoints.Count >= 2 then begin
        if nGJPointIndex >= g_AutoGJPoints.Count then begin
          nGJPointIndex := 0;
          LegendMap.Stop;
        end;

        GJPoint := LongInt(g_AutoGJPoints.Items[nGJPointIndex]);
        GJPointX := LoWord(GJPoint);
        GJPointY := HiWord(GJPoint);

        if (abs(g_MySelf.m_nCurrX - GJPointX) <= 3) and (abs(g_MySelf.m_nCurrY - GJPointY) <= 3) then begin
          Inc(nGJPointIndex);
          if nGJPointIndex >= g_AutoGJPoints.Count then begin
            nGJPointIndex := 0;
          end;
        end;

        LegendMap.Stop;
      end;

      // 看下有没有召唤技能可以用
      if (FGJCallMonMagicID <> 0) and CanUseMagic and CanNextAction(caSpell) then begin
        if FGJCallMonMagicID in [17 {召唤骷髅}, 30 {召唤神兽}, 76 {召唤圣兽}, 55 {召唤月灵}] then begin
          DoMagic := FindMagic(FGJCallMonMagicID);
          FGJCallMonMagicID := 0;
          if (DoMagic <> nil) and (MyGetTickCount - DoMagic.dwLastUseTick >= DoMagic.dwInterval + 200) then begin
            PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
            //AutoTakeOnItem(DoMagic);     // 自动上毒/符

            g_MagicLockActor := nil;
            g_MagicTarget := nil;

            UseMagic(nX, nY, DoMagic);
            Exit;
          end;
        end else begin
          FGJCallMonMagicID := 0;
        end;
      end;

      // 自动合击
      if g_ClientConfig.boAutoGroupAttack and g_ConfigDlg.ConfigCheckeds[ckAutoGroupAttack] and (FGJTargetCret.m_btRace <> 50) and CanNextAction(caSpell) and CanNextAction(caHit) and ServerAcceptNextAction(False) and (g_MyHero <> nil) and (not g_MyHero.m_boDeath) and (g_MyHero.m_btAttackMode in [0, 3]) and (THeroActor(g_MyHero).m_nMaxAngryValue > 0) and (THeroActor(g_MyHero).m_nAngryValue >= THeroActor(g_MyHero).m_nMaxAngryValue) then begin
        if (g_MySelf.m_btJob = 0) then begin
          if (tick_diff(g_LastGroupAttackTick, MyGetTickCount) >= 800) and (not ((((FGJTargetCret.m_btRace > RC_PLAYOBJECT) and (FGJTargetCret.m_btRace <> RC_MERCHANT) and (FGJTargetCret.m_btRealRace <> 55) and (not (FGJTargetCret.m_btRealRace in [RC_GUARD, 12, RC_ARCHERGUARD, RC_MOVE_ARCHERGUARD]))) or ((FGJTargetCret.m_btRace = 0) and FGJTargetCret.m_boPlayMoster)) and g_ConfigDlg.ConfigCheckeds[ckAutoGroupNoAttackMon] and g_ClientConfig.boAutoGroupNoAttackMon)) then begin
            g_MagicList.Lock;
            try
              for I := 0 to g_HeroMagicList.Count - 1 do begin
                Magic := g_HeroMagicList.Items[I];
                if Magic.Def.wMagicId in [60, 61, 62] then begin
                  if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                    g_LastGroupAttackTick := MyGetTickCount;
                    g_MyHero.GroupAttack;
                    //THeroActor(g_MyHero).m_nAngryValue := 0;
                  end;
                  Break;
                end;
              end;
            finally
              g_HeroMagicList.UnLock;
            end;
          end;
        end else begin
          if (tick_diff(g_dwLatestNoGroupSpellTick, MyGetTickCount) <= 6000) and //(tick_diff(g_dwLatestMagicTick, MyGetTickCount) >= 3000) and
          CanUseMagic and (ActionKey = 0) and (tick_diff(g_LastGroupAttackTick, MyGetTickCount) >= 800) and (not ((((FGJTargetCret.m_btRace > RC_PLAYOBJECT) and (FGJTargetCret.m_btRace <> RC_MERCHANT) and (FGJTargetCret.m_btRealRace <> 55) and (not (FGJTargetCret.m_btRealRace in [RC_GUARD, 12, RC_ARCHERGUARD, RC_MOVE_ARCHERGUARD]))) or ((FGJTargetCret.m_btRace = 0) and FGJTargetCret.m_boPlayMoster)) and g_ConfigDlg.ConfigCheckeds[ckAutoGroupNoAttackMon] and g_ClientConfig.boAutoGroupNoAttackMon)) then begin
            if (g_MySelf.m_btJob = 1) then begin
              g_MagicList.Lock;
              try
                for I := 0 to g_HeroMagicList.Count - 1 do begin
                  Magic := g_HeroMagicList.Items[I];
                  if Magic.Def.wMagicId in [62, 64, 65] then begin
                    if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                      g_LastGroupAttackTick := MyGetTickCount;
                      g_MyHero.GroupAttack;
                      //THeroActor(g_MyHero).m_nAngryValue := 0;
                    end;
                    Break;
                  end;
                end;
              finally
                g_HeroMagicList.UnLock;
              end;
            end else if (g_MySelf.m_btJob = 2) then begin
              g_MagicList.Lock;
              try
                for I := 0 to g_HeroMagicList.Count - 1 do begin
                  Magic := g_HeroMagicList.Items[I];
                  if Magic.Def.wMagicId in [61, 63, 64] then begin
                    if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                      g_LastGroupAttackTick := MyGetTickCount;
                      g_MyHero.GroupAttack;
                      //THeroActor(g_MyHero).m_nAngryValue := 0;
                    end;
                    Break;
                  end;
                end;
              finally
                g_HeroMagicList.UnLock;
              end;
            end;
          end;
        end;
      end;


      //自动连击 HZQ 20230706 补充自动连击技能的逻辑

      if (not IsInContinuous) and g_boCanUseContinuous and g_MySelf.m_boTrainingNG and (g_ContinuousMagicList.Count > 0)  // 可以使用连击
      and((g_ContinuousMagicOrder[0] > 0) or (g_ContinuousMagicOrder[1] > 0) or (g_ContinuousMagicOrder[2] > 0) or (g_ContinuousMagicOrder[3] > 0))
      and (tick_diff(g_dwContinuousTick, MyGetTickCount) > 1000) and CanUseMagic and (ActionKey = 0) and CanNextAction(caSpell)
      and CanNextAction(caHit) and ServerAcceptNextAction(False)
      and g_ClientConfig.boAutoContinueAttack and g_ConfigDlg.ConfigCheckeds[ckAutoContinueAttack] then begin
          //g_dwContinuousTick := MyGetTickCount;
          PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
          DoStartContinuous(nX, nY);
          //DoStartContinuous(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY);
          {$IF TESTMODE = 1}
          DScreen.AddChatBoardString('挂机 自动连击技能..', clRed, clGreen);
          {$IFEND}
      end;

      // 先看下自己四周有没有被包围
      FGJTempList.Clear;
      GetRoundTargetList(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, FGJTempList, 1);
      UseMagicList := g_GJUseMagic1;
      if g_ConfigDlg.ConfigCheckeds[ckGJ_GroupAttack] then begin
        // 看下目标周围2格有几个怪，没算怪自己
        FGJTempList.Clear;
        GetRoundTargetList(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, FGJTempList, 2);

        // 如果满足群攻技能条件
        if FGJTempList.Count + 1 >= nGJGroupAttackCount then begin
          UseMagicList := g_GJUseMagic2;
        end;
      end;

      if InterlockedCompareExchange(g_nContinuousStatus, 0, 0) = 0 then begin
          MagicAttackID := RUNGJ_GetAttackMagicID(UseMagicList); //HZQ 20230610 移植到外边
          // 群攻技能没找到，找下单攻技能
          if (MagicAttackID = 0) and (UseMagicList = g_GJUseMagic2) then begin
            UseMagicList := g_GJUseMagic1;
            MagicAttackID := RUNGJ_GetAttackMagicID(UseMagicList);
          end;
      end else begin
          MagicAttackID := 0;
      end;  

      DoMagic := nil;

      // 战士还是用物理攻击的几率高点 chongchog 2014-11-26
      if (not ((g_MySelf.m_btJob = 0) and (Random(5) <> 0))) and (MagicAttackID > 0) then begin
         // 有技能，但使用技能时间没到，消停一下
         if CanUseMagic and CanNextAction(caSpell) and (not IsInContinuous) then begin
             DoMagic := FindMagic(MagicAttackID);
         end else begin
            //OutputDebugString('Pause');            
            Exit;
         end;
      end;


      if DoMagic <> nil then begin
        // 道法躲避怪物 chongchong 2014-11-26
        if (g_MySelf.m_btJob <> 0) and (not g_ConfigDlg.ConfigCheckeds[ckGJ_DFStopAvoid]) then begin

          if not IsTrapped then begin //如果被包围不能走动的情况下，继续执行别的挂机动作
            if (Abs(FGJTargetCret.m_nCurrX - g_MySelf.m_nCurrX) <= 2) and (Abs(FGJTargetCret.m_nCurrY - g_MySelf.m_nCurrY) <= 2) then begin
                //HZQ 根据时长判断是否被包围不能动了
                if (LastSelfPosX = g_MySelf.m_nCurrX) and (LastSelfPosY = g_MySelf.m_nCurrY) then begin
                    if (GetTickCount - LastTrappedTick) > 2000 then begin
                        LastMonsterCount := RunGj_GetRoundMonstCount(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, 1);
                        IsTrapped := True;
                    end;
                end else begin
                    LastSelfPosX := g_MySelf.m_nCurrX;
                    LastSelfPosY := g_MySelf.m_nCurrY;
                    LastTrappedTick := GetTickCount;
                end;

                nDir := GetNextDirection(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
                GetFrontPosition(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, nDir, 5, nX, nY);
                if Map.CanMove(nX, nY) then begin
                  if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
                    g_ChrAction := caWalk
                  else
                    g_ChrAction := caRun;

                  g_nTargetX := nX;
                  g_nTargetY := nY;

                  Exit;
                end else begin
                  GetFrontPosition(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, nDir, Random(8), nX, nY);
                  if Map.CanMove(nX, nY) then begin
                    if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
                      g_ChrAction := caWalk
                    else
                      g_ChrAction := caRun;

                    g_nTargetX := nX;
                    g_nTargetY := nY;

                    Exit;
                  end;
                end;
             end;
          end else begin
             if RunGj_GetRoundMonstCount(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, 1) <> LastMonsterCount then begin
                 IsTrapped := False; //没有被困或已脱困
                 LastSelfPosX := -1;
                 LastSelfPosY := -1;
                 LastMonsterCount := 0;
             end;
          end;
        end;

        { 如果中间有障碍物，则近身 }
        if MagCanHitTarget(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY) then begin
          PlayScene.ScreenXYfromMCXY(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, nX, nY);
          g_MagicLockActor := FGJTargetCret;
          g_MagicTarget := FGJTargetCret;

          //AutoTakeOnItem(DoMagic);     // 自动上毒/符

          if CheckIsCustomMagic(DoMagic.Def.wMagicId) then begin
            MagicConfig := GetCustomMagicConfig(DoMagic.Def.wMagicId);

            if (MagicConfig <> nil) then begin
              if CheckCustomMagicNeedItem(DoMagic.Def.wMagicId) then begin
                DoMagic := FindMagic(DoMagic.Def.wMagicId);
                if (DoMagic <> nil) and (MyGetTickCount - DoMagic.dwLastUseTick >= DoMagic.dwInterval + 500) then begin
                  nSpellPoint := Round(DoMagic.Def.wSpell / (DoMagic.Def.btTrainLv + 1) * (DoMagic.Level + 1)) + DoMagic.Def.wDefSpell;

                  if MagicConfig.IsAttackUseNG then begin
                    boFound := g_MySelf.m_boTrainingNG and (nSpellPoint <= g_MySelf.m_AbilNG.NH);
                  end else begin
                    boFound := (Cardinal(nSpellPoint) <= g_MySelf.m_Abil.MP) or (DoMagic.Def.btEffectType = 0);
                  end;

                  if boFound then begin
                    UseMagic(nX, nY, DoMagic);
                  end;
                end;
              end;
            end;
          end else if not ((DoMagic.Def.wMagicId = 25) and g_boCanWideHit) then begin
            UseMagic(nX, nY, DoMagic); // 半月弯刀开了不用反复开 chongchong 2015-09-17
          end;

          Exit;
        end else begin
          // 修正挂机容易跑到和怪物叠加 2019-12-27 00:28:43
          // g_nTargetX := FGJTargetCret.m_nCurrX;
          // g_nTargetY := FGJTargetCret.m_nCurrY;

          nDir := GetNextDirection(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
          GetFrontPosition(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, nDir, nX, nY);

          if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
            g_ChrAction := caWalk
          else begin
            if (Abs(nX - g_MySelf.m_nCurrX) >= 2) or (Abs(nY - g_MySelf.m_nCurrY) >= 2) then
              g_ChrAction := caRun
            else
              g_ChrAction := caWalk;
          end;

          g_nTargetX := nX;
          g_nTargetY := nY;
        end;
      end else begin
        if (g_MySelf.m_btJob <> 0) and (not g_ConfigDlg.ConfigCheckeds[ckGJ_DFStopAvoid]) then begin
          if not IsTrapped then begin //如果被包围不能走动的情况下，继续执行别的挂机动作
            if (Abs(FGJTargetCret.m_nCurrX - g_MySelf.m_nCurrX) <= 2) and (Abs(FGJTargetCret.m_nCurrY - g_MySelf.m_nCurrY) <= 2) then begin
              //HZQ 根据时长判断是否被包围不能动了
              if (LastSelfPosX = g_MySelf.m_nCurrX) and (LastSelfPosY = g_MySelf.m_nCurrY) then begin
                  if (GetTickCount - LastTrappedTick) > 2000 then begin
                      LastMonsterCount := RunGj_GetRoundMonstCount(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, 1); 
                      IsTrapped := True;
                  end;
              end else begin
                  LastSelfPosX := g_MySelf.m_nCurrX;
                  LastSelfPosY := g_MySelf.m_nCurrY;
                  LastTrappedTick := GetTickCount;
              end;

              nDir := GetNextDirection(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
              GetFrontPosition(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, nDir, 5, nX, nY);
              if Map.CanMove(nX, nY) then begin
                if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
                  g_ChrAction := caWalk
                else
                  g_ChrAction := caRun;

                g_nTargetX := nX;
                g_nTargetY := nY;

                Exit;
              end else begin
                GetFrontPosition(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, nDir, Random(8), nX, nY);
                if Map.CanMove(nX, nY) then begin
                  if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
                    g_ChrAction := caWalk
                  else
                    g_ChrAction := caRun;

                  g_nTargetX := nX;
                  g_nTargetY := nY;

                  Exit;
                end;
              end;
            end;
          end else begin
              if RunGj_GetRoundMonstCount(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, 1) <> LastMonsterCount then begin
                  IsTrapped := False; //没有被困或已脱困
                  LastSelfPosX := -1;
                  LastSelfPosY := -1;
                  LastMonsterCount := 0;
              end;
          end;
        end;

        if (Abs(FGJTargetCret.m_nCurrX - g_MySelf.m_nCurrX) <= 1) and (Abs(FGJTargetCret.m_nCurrY - g_MySelf.m_nCurrY) <= 1) then begin
          if (g_MySelf.m_btJob = 0) then begin
            // 自动烈火
            if (not g_boNextTimeFireHit) and (g_ClientConfig.boSmartFireHit and g_ConfigDlg.ConfigCheckeds[ckSmartFireHit]) and (g_MySelf.m_btJob = 0) then begin
              if (MyGetTickCount - g_dwLatestFireHitTick > Cardinal(g_nFireHitDelayTime))
                and (MyGetTickCount - g_dwLatestTryFireHitTick > Cardinal(g_nFireHitDelayTime div 3)) {and CanNextAction and ServerAcceptNextAction and CanNextHit} then begin
                g_MagicList.Lock;
                try
                  for I := 0 to g_MagicList.Count - 1 do begin
                    Magic := g_MagicList.Items[I];
                    if Magic.Def.wMagicId = 26 then begin
                      if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                        g_dwLatestTryFireHitTick := MyGetTickCount;
                        PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
                        UseMagic(nX, nY, Magic);
                      end;
                      Break;
                    end;
                  end;
                finally
                  g_MagicList.UnLock;
                end;
              end;
            end;

            // 自动逐日剑法
            if (not g_boNextTimeSwordHit) and (g_ClientConfig.boSmartSwordHit and g_ConfigDlg.ConfigCheckeds[ckSmartSwordHit]) and (g_MySelf.m_btJob = 0) then begin
              if (MyGetTickCount - g_dwLatestSWordHitTick > Cardinal(g_nSwordHitDelayTime)) and (MyGetTickCount - g_dwLatestTrySWordHitTick > Cardinal(g_nSwordHitDelayTime div 3)) {and CanNextAction and ServerAcceptNextAction and CanNextHit} then begin
                g_MagicList.Lock;
                try
                  for I := 0 to g_MagicList.Count - 1 do begin
                    Magic := g_MagicList.Items[I];
                    if Magic.Def.wMagicId = 56 then begin
                      if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                        g_dwLatestTrySWordHitTick := MyGetTickCount;
                        PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
                        UseMagic(nX, nY, Magic);
                      end;
                      Break;
                    end;
                  end;
                finally
                  g_MagicList.UnLock;
                end;
              end;
            end;

            // 自动龙影剑法
            if (not g_boNextTime42Hit) and (g_ClientConfig.boSmartTwnHit and g_ConfigDlg.ConfigCheckeds[ckSmartTwnHit]) and (g_MySelf.m_btJob = 0) then begin
              if (MyGetTickCount - g_dwLatest42HitTick > Cardinal(g_n42HitDelayTime)) and (MyGetTickCount - g_dwLatestTry42HitTick > Cardinal(g_n42HitDelayTime div 3)) {and CanNextAction and ServerAcceptNextAction and CanNextHit} then begin
                g_MagicList.Lock;
                try
                  for I := 0 to g_MagicList.Count - 1 do begin
                    Magic := g_MagicList.Items[I];
                    if Magic.Def.wMagicId = 42 then begin
                      if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                        g_dwLatestTry42HitTick := MyGetTickCount;
                        PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
                        UseMagic(nX, nY, Magic);
                      end;
                      Break;
                    end;
                  end;
                finally
                  g_MagicList.UnLock;
                end;
              end;
            end;

            // 自动开天斩
            if (not g_boNextTime66Hit) and (not g_boNextTime66Hit1) and (g_ClientConfig.boSmart66Hit and g_ConfigDlg.ConfigCheckeds[ckSmart66Hit]) and (g_MySelf.m_btJob = 0) then begin
              if (MyGetTickCount - g_dwLatest66HitTick > Cardinal(g_nKTZHitDelayTime)) and (MyGetTickCount - g_dwLatestTry66HitTick > Cardinal(g_nKTZHitDelayTime div 3)) {and CanNextAction and ServerAcceptNextAction and CanNextHit} then begin
                // g_dwLatest66HitTick := MyGetTickCount;
                g_MagicList.Lock;
                try
                  for I := 0 to g_MagicList.Count - 1 do begin
                    Magic := g_MagicList.Items[I];
                    if Magic.Def.wMagicId = 66 then begin
                      if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                        g_dwLatestTry66HitTick := MyGetTickCount;
                        PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
                        UseMagic(nX, nY, Magic);
                      end;
                      Break;
                    end;
                  end;
                finally
                  g_MagicList.UnLock;
                end;
              end;
            end;

            // 自动断空斩
            if (not g_boNextTime113Hit) and (g_ClientConfig.boSmart113Hit and g_ConfigDlg.ConfigCheckeds[ckSmart113Hit]) and (g_MySelf.m_btJob = 0) then begin
              if (MyGetTickCount - g_dwLatest113HitTick > Cardinal(g_nDKZHitDelayTime)) and (MyGetTickCount - g_dwLatestTry113HitTick > Cardinal(g_nDKZHitDelayTime div 3)) {and CanNextAction and ServerAcceptNextAction and CanNextHit} then begin
                g_MagicList.Lock;
                try
                  for I := 0 to g_MagicList.Count - 1 do begin
                    Magic := g_MagicList.Items[I];
                    if Magic.Def.wMagicId = 113 then begin
                      if (Magic.Def.wSpell + Magic.Def.wDefSpell <= g_MySelf.m_Abil.MP) then begin
                        g_dwLatestTry113HitTick := MyGetTickCount;
                        PlayScene.ScreenXYfromMCXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
                        UseMagic(nX, nY, Magic);
                      end;
                      Break;
                    end;
                  end;
                finally
                  g_MagicList.UnLock;
                end;
              end;
            end;
          end;

          AttackTarget(FGJTargetCret, True);
        end else begin
          // 近身攻击，在道法躲避时，加判断条件 2020-09-20 09:02:35

          if (g_MySelf.m_btJob = 0) then begin
            IsNearTarget := True
          end
          else if not g_ConfigDlg.ConfigCheckeds[ckGJ_DFStopAvoid] then begin
            if (Abs(FGJTargetCret.m_nCurrX - g_MySelf.m_nCurrX) > 5) or (Abs(FGJTargetCret.m_nCurrY - g_MySelf.m_nCurrY) > 5) then
              IsNearTarget := True
            else
              IsNearTarget := False;
          end
          else begin
            IsNearTarget := True;
          end;

          if IsNearTarget then begin
            nDir := GetNextDirection(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
            GetFrontPosition(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, nDir, nX, nY);

            if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
              g_ChrAction := caWalk
            else begin
              if (Abs(nX - g_MySelf.m_nCurrX) >= 2) or (Abs(nY - g_MySelf.m_nCurrY) >= 2) then
                g_ChrAction := caRun
              else
                g_ChrAction := caWalk;
            end;

            g_nTargetX := nX;
            g_nTargetY := nY;
          end;
        end;
      end;
    end else begin
       if g_boContinuous then begin //增加挂机中使用连击技能的处理
           if tick_diff(g_dwContinuousTick, MyGetTickCount) > 15000 then begin
              DoFinishContinuous();
           end;
       end; 

      // 10秒也跑不到攻击目标那里，把目标删了，让其重搜目标 chongchong 2014-11-25
      if (MyGetTickCount - FGJTargetCretTick > 1000 * 5) and ((Abs(FGJTargetCret.m_nCurrX - g_MySelf.m_nCurrX) > 2) or (Abs(FGJTargetCret.m_nCurrY - g_MySelf.m_nCurrY) > 2)) then begin
        boFound := False;

        for I := 0 to FGJExcludeMonList.Count - 1 do begin
          ExcludeMonInfo := FGJExcludeMonList.Items[I];
          if ExcludeMonInfo.Mon = FGJTargetCret then begin
            boFound := True;
            ExcludeMonInfo.AddTick := MyGetTickCount;
            Break;
          end;
        end;

        if not boFound then begin
          New(ExcludeMonInfo);
          FGJExcludeMonList.Add(ExcludeMonInfo);
          ExcludeMonInfo.Mon := FGJTargetCret;
          ExcludeMonInfo.AddTick := MyGetTickCount;
        end;

        // 别忘了删除目标 chongchong 2014-12-03
        FGJTargetCret := nil;
      end else begin
        // 修正挂机容易跑到和怪物叠加 2019-12-27 00:28:43
        // g_nTargetX := FGJTargetCret.m_nCurrX;
        // g_nTargetY := FGJTargetCret.m_nCurrY;

        nDir := GetNextDirection(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY);
        GetFrontPosition(FGJTargetCret.m_nCurrX, FGJTargetCret.m_nCurrY, nDir, nX, nY);

        if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
          g_ChrAction := caWalk
        else begin
          if (Abs(nX - g_MySelf.m_nCurrX) >= 2) or (Abs(nY - g_MySelf.m_nCurrY) >= 2) then
            g_ChrAction := caRun
          else
            g_ChrAction := caWalk;
        end;

        g_nTargetX := nX;
        g_nTargetY := nY;
      end;
    end;
  end else if not g_boMouseMoveDown then begin
    // 攻击目标也没找到，则瞎跑
    if not g_ConfigDlg.ConfigCheckeds[ckGJ_LimitScreen] then begin
      if g_AutoGJPoints.Count >= 2 then begin
        if nGJPointIndex >= g_AutoGJPoints.Count then begin
          nGJPointIndex := 0;
          LegendMap.Stop;
        end;

        GJPoint := LongInt(g_AutoGJPoints.Items[nGJPointIndex]);
        GJPointX := LoWord(GJPoint);
        GJPointY := HiWord(GJPoint);

        if (abs(g_MySelf.m_nCurrX - GJPointX) <= GJ_POINT_OFFSET) and (abs(g_MySelf.m_nCurrY - GJPointY) <= GJ_POINT_OFFSET) then begin
          Inc(nGJPointIndex);

          if nGJPointIndex >= g_AutoGJPoints.Count then begin
            nGJPointIndex := 0;
          end;

          LegendMap.Stop;
        end else begin
          if (LegendMap.EndX > 0) and (LegendMap.EndY > 0) then begin
            if (abs(g_MySelf.m_nCurrX - LegendMap.EndX) <= GJ_POINT_OFFSET) and (abs(g_MySelf.m_nCurrY - LegendMap.EndY) <= GJ_POINT_OFFSET) then begin
              Inc(nGJPointIndex);

              if nGJPointIndex >= g_AutoGJPoints.Count then begin
                nGJPointIndex := 0;
              end;

              LegendMap.Stop;
            end
          end;

          if (Length(LegendMap.RunPath) <= 0) and (not LegendMap.StartFind) and (LegendMap.FindCount = 0) then begin
            LegendMap.EndX := GJPointX;
            LegendMap.EndY := GJPointY;

            LegendMap.FindPath(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, GJPointX, GJPointY);
            Exit;
          end;

          if LegendMap.StartFind then
            Exit;

          if Length(LegendMap.RunPath) > 0 then begin
            for I := LegendMap.PathPoisonIndex to Length(LegendMap.RunPath) - 1 do begin
              if (g_MySelf.m_nCurrX <> LegendMap.RunPath[I].X) or (g_MySelf.m_nCurrY <> LegendMap.RunPath[I].Y) then begin
                if ((abs(g_MySelf.m_nCurrX - LegendMap.RunPath[I].X) <= 1) and (abs(g_MySelf.m_nCurrY - LegendMap.RunPath[I].Y) <= 1)) or g_MySelf.m_boCobweb or (g_MySelf.m_nChangeAppr >= 0) then begin
                  // if (not CheckCanRun(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y)) and (CheckCanWalk(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y)) then begin
                  if PlayScene.CanWalk(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y) then begin
                    g_ChrAction := caWalk;
                    g_nTargetX := LegendMap.RunPath[I].X;
                    g_nTargetY := LegendMap.RunPath[I].Y;
                    PlayScene.ScreenXYfromMCXY(g_nTargetX, g_nTargetY, g_nMoveMouseX, g_nMoveMouseY);
                    LegendMap.PathPoisonIndex := I;
                    // Inc(g_nPathPoisonIndex);
                    Exit;
                  end
                  else begin
                    LegendMap.FindPath(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, LegendMap.EndX, LegendMap.EndY);
                    LegendMap.PathPoisonIndex := 0;
                    Exit;
                    {if Length(LegendMap.RunPath) <= 0 then begin
                      DScreen.AddChatBoardString(Format('自动移动坐标点(%d:%d)不可到达', [LegendMap.EndX, LegendMap.EndY]), GetRGB(154), clWhite);
                      LegendMap.Stop;
                    end;
                    Exit; }
                  end;
                end
                else begin
                  if PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y) then begin
                    if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
                      g_ChrAction := caWalk
                    else begin
                      // if CheckCanRun(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y) then
                      g_ChrAction := caRun;
                      //DScreen.AddChatBoardString('g_ChrAction 7', clGreen, clWhite);
                    end;
                    g_nTargetX := LegendMap.RunPath[I].X;
                    g_nTargetY := LegendMap.RunPath[I].Y;
                    PlayScene.ScreenXYfromMCXY(g_nTargetX, g_nTargetY, g_nMoveMouseX, g_nMoveMouseY);
                    LegendMap.PathPoisonIndex := I;
                    // Inc(g_nPathPoisonIndex);
                    Exit;
                  end
                  else begin
                    LegendMap.FindPath(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, LegendMap.EndX, LegendMap.EndY);
                    LegendMap.PathPoisonIndex := 0;
                    {if Length(LegendMap.RunPath) <= 0 then begin
                      DScreen.AddChatBoardString(Format('自动移动坐标点(%d:%d)不可到达', [LegendMap.EndX, LegendMap.EndY]), GetRGB(154), clWhite);
                      LegendMap.Stop;
                    end;  }
                    Exit;
                  end;
                end;
              end;
            end;
          end
          else begin
            Inc(nGJPointIndex);
            if nGJPointIndex >= g_AutoGJPoints.Count then begin
              nGJPointIndex := 0;
            end;
            LegendMap.Stop;
          end;
        end;
      end
      else begin
        nDir := g_MySelf.m_btDir;

        if Random(30) = 0 then
          nDir := Random(8);

        if g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then begin
          GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nDir, 1, nX, nY);

          if not PlayScene.CanWalk(nX, nY) then begin
            nDir := ((nDir - 1) + 8) mod 8;
            Count := 0;
            GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nDir, 1, nX, nY);
            while not PlayScene.CanWalk(nX, nY) do begin
              nDir := ((nDir - 1) + 8) mod 8;
              GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nDir, 1, nX, nY);
              Inc(Count);
              if Count >= 8 then
                Break;
            end;
          end;

          // 如果和上一次的目标坐标相同，说明人物没动 chongchong 2014-12-03
          if (g_nTargetX = nX) and (g_nTargetY = nY) then begin
            if Random(10) = 0 then
              nDir := Random(8);
            GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nDir, 8, nX, nY);
          end;

          g_nTargetX := nX;
          g_nTargetY := nY;
          PlayScene.ScreenXYfromMCXY(g_nTargetX, g_nTargetY, g_nMoveMouseX, g_nMoveMouseY);
          g_ChrAction := caWalk
        end else begin
          GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nDir, 3, nX, nY);

          if not PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY) then begin
            nDir := ((nDir - 1) + 8) mod 8;
            Count := 0;
            GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nDir, 3, nX, nY);
            while not PlayScene.CanRun(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY) do begin
              nDir := ((nDir - 1) + 8) mod 8;
              GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nDir, 3, nX, nY);
              Inc(Count);
              if Count >= 8 then
                Break;
            end;
          end;

          // HZQ 20230821 增加目标为-1时，随机换方向, g_nTargetX，Y在服务器返回走路结果步认可后被置为-1，
          if (g_nTargetX = -1) and (g_nTargetY =-1)  then begin
             if Random(2) = 0 then begin
                nDir := Random(8);
             end;
             GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nDir, 8, nX, nY);
          end else if ((g_nTargetX = nX) and (g_nTargetY = nY)) then begin
            // 如果和上一次的目标坐标相同，说明人物没动 chongchong 2014-12-03
            if Random(10) = 0 then
              nDir := Random(8);
              GetFrontPosition(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nDir, 8, nX, nY);
          end;

          g_nTargetX := nX;
          g_nTargetY := nY;
          PlayScene.ScreenXYfromMCXY(g_nTargetX, g_nTargetY, g_nMoveMouseX, g_nMoveMouseY);

          if ((abs(g_MySelf.m_nCurrX - g_nTargetX) <= 1) and (abs(g_MySelf.m_nCurrY - g_nTargetY) <= 1)) or g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
            g_ChrAction := caWalk
          else begin
            g_ChrAction := caRun;
          end;
        end;
      end;
    end else begin
      if (g_MySelf.m_nCurrX <> g_nGJStartX) or (g_MySelf.m_nCurrY <> g_nGJStartY) then begin
        g_nTargetX := g_nGJStartX;
        g_nTargetY := g_nGJStartY;

        if ((abs(g_MySelf.m_nCurrX - g_nTargetX) <= 1) and (abs(g_MySelf.m_nCurrY - g_nTargetY) <= 1)) or g_MySelf.m_boCobweb {被蜘蛛网罩住} or (g_MySelf.m_nChangeAppr >= 0) then
          g_ChrAction := caWalk
        else
          g_ChrAction := caRun;

        Exit;
      end;
    end;
  end;
end;

