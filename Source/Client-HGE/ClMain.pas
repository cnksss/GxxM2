procedure TfrmMain.ProcessMessageMagicFireEx_2(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  S:string;
  sNewLevel, sObj, sOther, sMagID, sLevel:string;
  Actor:TActor;
  MagicInfo:TUseMagicInfo;
begin
  S := sData;
  S := GetValidStr3_Ex(S, sNewLevel, '|');
  S := GetValidStr3_Ex(S, sObj, '|');
  S := GetValidStr3_Ex(S, sOther, ';');
  sLevel := GetValidStr3_Ex(sOther, sMagID, ',');

  Actor := PlayScene.FindActor(DefMsg.Recog);
  if (Actor <> nil) and (Actor is THumActor) then begin
    MagicInfo.ServerMagicCode := 111;
    MagicInfo.MagicSerial := StrToIntDef(sMagID, 0);
    MagicInfo.EffectType := TMagicType(Lobyte(DefMsg.series));
    MagicInfo.EffectNumber := Hibyte(DefMsg.series);
    MagicInfo.target := StrToInt64Def(sObj, 0);

    MagicInfo.targx := DefMsg.param;
    MagicInfo.targy := DefMsg.tag;
    MagicInfo.MagicLevel := StrToIntDef(sLevel, 0);
    MagicInfo.NewLevel := StrToIntDef(sNewLevel, 0);
    Actor.m_Saying := S;

    Actor.SetMagicSound(MagicInfo.MagicSerial);

    THumActor(Actor).PlayMagicEffect(@MagicInfo, MagicInfo.target);
  end;
end;

