            SM_CONTINUEANTIPLUGSTREAM_LEG, SM_ANTIPLUGSTREAM_IOCP2, SM_CONTINUEANTIPLUGSTREAM_IOCP2, SM_PROCESSBLACKLIST, SM_OPENBIGMERCHANTBIGDLG, SM_ITEMEAT_CDTIME, SM_FBTIME, SM_RUNGATE_SPEED_INTERVALS, SM_RUNGATE_VERIFYCODE, SM_RUNGATE_DISABLE_LOGIN, SM_CUSTOMITEMPROPERTYCONFIG, SM_CUSTOMITEMPROPERTYTEXTVARLIST, SM_ARR_BUTTON_CONFIG, SM_RESPONSE_UPDATE_DLL, SM_InputBoxFilterList:begin // 黑名单模块MD5
