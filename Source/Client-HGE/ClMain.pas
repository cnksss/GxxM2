procedure TfrmMain.ProcessMessageSendProcessBlacklist(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, Count:Integer;
  RSA:TLbRSA;
  OutBuf:array[0..10240] of Byte;
  OutBufSize:Integer;
  S:string;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode.inc}
  {$ELSE}
  {$I VMProtectBegin.inc}
  {$IFEND}

  if (DefMsg.Recog > 0) and (DefMsg.Recog = Length(sData)) then begin
    OutBufSize := zLibDecompressString(sData, PChar(@OutBuf[0]), SizeOf(OutBuf));

    RSA := TLbRSA.Create(nil);
    try
      RSA.KeySize := aks128;
      RSA.PrivateKey.ModulusAsString := '597A185BA5F22A014F50B453E647C0C5';
      RSA.PrivateKey.ExponentAsString := '5F08';

      OutBufSize := RSA.DecryptBuffer(OutBuf[0], OutBufSize, OutBuf[0]);

      SetLength(S, SizeOf(MD5Digest));
      Count := OutBufSize div SizeOf(MD5Digest);
      for I := 0 to Count - 1 do begin
        Move(OutBuf[I * SizeOf(MD5Digest)], S[1], SizeOf(MD5Digest));
        g_ProcessBlackList.Add(S);
      end;
    finally
      RSA.Free;
    end;
  end;

  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}
end;

