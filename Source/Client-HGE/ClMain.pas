procedure TfrmMain.ProcessMessageLogon(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Feature:TFeature;
  wl:PTMessageBodyWL;
begin
  g_boShowNotice := False;
  g_dwFirstServerTime := 0;
  g_dwFirstClientTime := 0;
  // DebugOutStr('SM_LOGON: 1 ');
  {$IF AntiPlugInMemory = 1}
  g_boWaitLoadAntiPlugDllMemoryModule := False;
  g_boWaitLoadAntiPlugDllMemoryModule_IOCP2 := False;
  {$ELSE}
  g_boWaitLoadAntiPlugDllModule := False;
  g_boWaitLoadAntiPlugDllModule_IOCP2 := False;
  {$IFEND}

  g_IsWaitLogout := False;
  wl := nil; //HZQ, 消除下面的警告

  if Length(sData) = SizeOf(TMessageBodyWL) + SizeOf(THumFeature) then begin
    wl := PTMessageBodyWL(sData);
    Feature.Feature := SizeOf(THumFeature);
    Move(sData[1 + SizeOf(TMessageBodyWL)], Feature.Buffer[0], Feature.Feature);

    PlayScene.SendMsg(DefMsg.ident, DefMsg.Recog, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir}, @Feature, // MsgWL.lParam1 {desc.Feature},
      wl.lParam2 {desc.Status}, '');

    DScreen.ChangeScene(stPlayGame);

    SendClientMessage(CM_QUERYBAGITEMS, 0, MakeWord(0, 0), 0, 0, '');

    if Lobyte(Loword(wl.lTag1)) = 1 then
      g_boAllowGroup := True
    else
      g_boAllowGroup := False;
    g_boServerChanging := False;
    FrmDlg.DGrpAllowGroup.Checked := g_boAllowGroup;
  end;

  if (g_MySelf <> nil) then begin
    g_MySelf.OnShopStall := OnShopStall;
    if g_ClientVersion in [cvSerial, cvMirSequel, cvMirNewUI205] then begin
      if (FrmDlg is TSerialWindows) and (wl <> nil) then begin //HZQ 20230523 添加 and (wl <> nil) //g_MySelf <> nil， wl必有值
        TSerialWindows(FrmDlg).NewStateWindows.SetDeputyHeroJob(wl.lTag2); // 副将职业
      end;
    end;
  end;

  Randomize;
  FCheckValueCRCTime := 20000 + Random(40000); // 20 - 60秒
  FCheckValueCRCTick := MyGetTickCount;

  g_boLoadUserConfig := False;
  if g_wAvailIDDay > 0 then begin
    DScreen.AddChatBoardString('您当前已通过固定账号包月充值。', clGreen, clWhite)
  end else if g_wAvailIPDay > 0 then begin
    DScreen.AddChatBoardString('您当前已通过固定IP包月充值。', clGreen, clWhite)
  end else if g_wAvailIPHour > 0 then begin
    DScreen.AddChatBoardString('您当前已通过固定IP计时充值。', clGreen, clWhite)
  end else if g_wAvailIDHour > 0 then begin
    DScreen.AddChatBoardString('您当前已通过固定账号计时充值。', clGreen, clWhite)
  end;

  g_dwLogonTick := MyGetTickCount;
end;

