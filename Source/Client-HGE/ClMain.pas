procedure TfrmMain.ProcessMessageSaveItemList(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  ClientItem, pc:PTClientItem;
  pcg:PTClientGoods;
begin
  FrmDlg.ResetMenuDlg;

  for I := 0 to g_SaveItemList.Count - 1 do
    Dispose(PTClientItem(g_SaveItemList.Items[I]));

  g_SaveItemList.Clear;

  CancelUpgradeItem(DefMsg.Recog);
  g_nCurMerchant := DefMsg.Recog;

  if (MakeLong(DefMsg.Param, DefMsg.Tag) = Length(sData)) and (DefMsg.Series > 0) and (Length(sData) = DefMsg.Series * SizeOf(TClientItem)) then begin
    ClientItem := PTClientItem(sData);

    for I := 0 to DefMsg.Series - 1 do begin
      New(pc);
      pc^ := ClientItem^;

      Inc(ClientItem);

      g_SaveItemList.Add(pc);
    end;
  end;

  with FrmDlg do begin
    MenuList.Lock;
    try
      // deocde body received from server
      for I := 0 to g_SaveItemList.Count - 1 do begin
        New(pcg);
        pcg.RealName := PTClientItem(g_SaveItemList[I]).S.Name;
        pcg.Name := ProcessItemName(pcg.RealName);
        pcg.SubMenu := 0;
        pcg.Price := PTClientItem(g_SaveItemList[I]).MakeIndex;
        pcg.Stock := Round(PTClientItem(g_SaveItemList[I]).Dura / 1000);
        pcg.Grade := Round(PTClientItem(g_SaveItemList[I]).DuraMax / 1000);
        if IsUnOverLapItem(PTClientItem(g_SaveItemList[I])) then begin // 重叠物品
          pcg.Count := PTClientItem(g_SaveItemList[I]).Dura + 1;
        end
        else begin
          pcg.Count := 1;
        end;
        MenuList.Add(pcg);
      end;
    finally
      MenuList.UnLock;
    end;
    FrmDlg.BoStorageMenu := True;
    FrmDlg.OpenDMenuDlg(False);
  end;
end;

procedure TfrmMain.ProcessMessageStorageViewItemList(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  pc:PTClientItem;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  Buffer:PChar;
  Header:PTStorageViewItemListHeader;
  Count:Integer;
  MaxCount:Integer;
  Page:Word;
  MaxPage:Word;
  boStorageViewDlgIsExt:Boolean;
  boResetPosition:Boolean;
  nCount:Integer;
  IsTakeBackItem:Boolean;
begin
  if (DefMsg.Param > 0) and (DefMsg.Param = Length(sData)) then begin
    nCount := LoByte(DefMsg.Series);
    IsTakeBackItem := HiByte(DefMsg.Series) = 1;

    boStorageViewDlgIsExt := DefMsg.Tag <> 0;
    boResetPosition := not FrmDlg.CheckDStorageViewDlgShow(boStorageViewDlgIsExt);
    FrmDlg.ResetMenuDlg;

    // 修复打开npc对话框，然后双击使用触发物品，打开仓库OpenStorageView后，npc对话框中的不能点击 ++ DefMsg.Recog <> 0 2019-07-01 11:09:52
    CancelUpgradeItem(DefMsg.Recog, False);

    {
    // 修复打开npc对话框，然后双击使用触发物品，打开仓库OpenStorageView后，npc对话框中的不能点击 ++ DefMsg.Recog <> 0 2019-07-01 11:09:52
    if DefMsg.Recog <> 0 then
    begin
      g_nCurMerchant := DefMsg.Recog;
    end;
    }

    for I := 0 to g_SaveItemList.Count - 1 do
      Dispose(PTClientItem(g_SaveItemList.Items[I]));

    g_SaveItemList.Clear;

    zLibDecompressString(sData, @OutBuf, SizeOf(OutBuf));

    Buffer := @OutBuf;
    Header := PTStorageViewItemListHeader(Buffer);
    Inc(Buffer, SizeOf(TStorageViewItemListHeader));

    Count := Header.Count;
    MaxCount := Header.MaxCount;
    Page := Header.Page;
    MaxPage := Header.MaxPage;

    for I := 0 to nCount - 1 do begin
      New(pc);
      Move(Buffer^, pc^, SizeOf(TClientItem));
      Buffer := Buffer + SizeOf(TClientItem);
      g_SaveItemList.Add(pc);
    end;

    g_nMDlgX := g_MySelf.m_nCurrX;
    g_nMDlgY := g_MySelf.m_nCurrY;

    FrmDlg.OpenDStorageViewDlg(DefMsg.Recog, IsTakeBackItem, boResetPosition, boStorageViewDlgIsExt, Header.PosX, Header.PosY);
    FrmDlg.RefrshDStorageViewDlgText(boStorageViewDlgIsExt, Count, MaxCount, Page, MaxPage);
  end;
  g_SendGetBackStorageViewItem := False;
end;

procedure TfrmMain.ProcessMessageStorageViewOK(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  nIdx, MakeIndex:Integer;
  pc:PTClientItem;
  IsStorageViewDlgIsExt:Boolean;
begin
  {$I VMProtectBegin.inc}
  MakeIndex := DefMsg.Recog;
  IsStorageViewDlgIsExt := DefMsg.Tag = 1;

  for nIdx := 0 to GetMaxBagCount - 1 do begin
    if (g_ItemArr[nIdx].MakeIndex = MakeIndex) then begin
      if (g_ItemArr[nIdx].S.Name <> '') or (g_SellDlgItemSellWait.MakeIndex = MakeIndex) then begin

        if FrmDlg.CheckDStorageViewDlgShow(IsStorageViewDlgIsExt) and (g_SaveItemList.Count < 49) then begin
          New(pc);
          pc^ := g_ItemArr[nIdx];
          if pc.s.Name = '' then
            pc.s.Name := g_SellDlgItemSellWait.s.Name;
          g_SaveItemList.Add(pc);

          if (not g_IsWaitItemToStorage) and Assigned(g_AntiPlugNotifyFunc) then begin
            g_AntiPlugNotifyFunc(event_ItemToStorage_Abnormal, nil, 0);
          end;
        end;
        FrmDlg.RefrshDStorageViewDlgText(IsStorageViewDlgIsExt, FrmDlg.FDStorageViewDlgCount + 1, FrmDlg.FDStorageViewDlgMaxCount, FrmDlg.FDStorageViewDlgPage, DefMsg.Param);
        g_ItemArr[nIdx].S.Name := '';
        g_IsWaitItemToStorage := False;

        Break;
      end;
    end;
  end;
  g_SellDlgItemSellWait.s.Name := '';

  {$I VMProtectEnd.inc}
end;

