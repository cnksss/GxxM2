          end;
        finally
          g_EffectImageList.UnLock;
        end;

        ImageButton.ImageIndex.Up := nUpImage;
        ImageButton.ImageIndex.Hot := nHotImage;
        ImageButton.ImageIndex.Down := nDownImage;
      finally
        ImageButton.ImageIndex.EndUpdate;
      end;

      ImageButton.Floating := boFloating or (btMove = 1);
      ImageButton.Visible := True;
      ImageButton.AutoSize := False;
      ImageButton.AutoSize := True;
      ImageButton.BringToFront;
      Exit;
    end;
  end;

  ImageButton := nil;

