procedure TfrmMain.ProcessMessageSendRequestAuctionItemsByIndexRet(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, II, PageIndex:Integer;
  Item:pTRefreshAuctionItem;
  ListItem:TDxListItem;
  ArrChanged:array[0..AUCTION_PAGE_COUNT - 1] of Boolean;
begin
  g_IsRequeryAuctionMyItemsWait := False;
  if DefMsg.Tag = 1 then
    Exit;

  PageIndex := DefMsg.Series;

  if DefMsg.Recog = 0 then begin
    if PageIndex <> FrmDlg.FAuctionAllItemsPage then begin
      //OutputDebugString('aaa');
      Exit;
    end;

    for I := 0 to AUCTION_PAGE_COUNT - 1 do begin
      ArrChanged[I] := False;
    end;

    if (DefMsg.Param > 0) and (Length(sData) = DefMsg.Param * SizeOf(TRefreshAuctionItem)) then begin
      Item := pTRefreshAuctionItem(sData);
      for I := 0 to DefMsg.Param - 1 do begin
        for II := 0 to AUCTION_PAGE_COUNT - 1 do begin
          if g_AuctionAllItems[II].AuctionID = Item.AuctionID then begin
            g_AuctionAllItems[II].LastBidPrice := Item.LastBidPrice;
            g_AuctionAllItems[II].TradingStatus := Item.TradingStatus;
            g_AuctionAllItems[II].IsItemGive := Item.IsItemGive;

            ArrChanged[II] := True;

            ListItem := TSerialWindows(FrmDlg).DLvAuctionAllItems.Items[II];
            if ListItem <> nil then begin
              if (ListItem.Items[4] <> nil) then begin
                if (g_AuctionAllItems[II].TradingStatus = 0) then begin
                  ListItem.Items[4].Caption := DecodeResStr(SAuctionItemJoinBuy);
                end
                else begin
                  ListItem.Items[4].Caption := '';
                end;
              end;
            end;

            Break;
          end;
        end;

        Inc(Item);
      end;
    end;

    for I := 0 to AUCTION_PAGE_COUNT - 1 do begin
      if not ArrChanged[I] then begin
        if I > DefMsg.Param - 1 then begin
          g_AuctionAllItems[I].AuctionID := 0;
          g_AuctionAllItems[I].Item.s.Name := '';

          g_AuctionAllItems[I].TradingStatus := -1;
        end;
      end;
    end;
  end
  else if DefMsg.Recog = 1 then begin
    if PageIndex <> FrmDlg.FAuctionMyItemsPage then begin
      //OutputDebugString('aaa');
      Exit;
    end;

    for I := 0 to AUCTION_PAGE_COUNT - 1 do begin
      ArrChanged[I] := False;
    end;

    if (DefMsg.Param > 0) and (Length(sData) = DefMsg.Param * SizeOf(TRefreshAuctionItem)) then begin
      Item := pTRefreshAuctionItem(sData);
      for I := 0 to DefMsg.Param - 1 do begin
        for II := 0 to AUCTION_PAGE_COUNT - 1 do begin
          if g_AuctionMyItems[II].AuctionID = Item.AuctionID then begin
            g_AuctionMyItems[II].LastBidPrice := Item.LastBidPrice;
            g_AuctionMyItems[II].TradingStatus := Item.TradingStatus;
            g_AuctionMyItems[II].IsItemGive := Item.IsItemGive;

            ArrChanged[II] := True;

            ListItem := TSerialWindows(FrmDlg).DLvAuctionMyItems.Items[II];
            if ListItem <> nil then begin
              if ListItem.Items[4] <> nil then begin
                if g_AuctionMyItems[II].IsItemGive then
                  ListItem.Items[4].Caption := DecodeResStr(SAuctionItemDelete)
                else if g_AuctionMyItems[II].TradingStatus = 1 then
                  ListItem.Items[4].Caption := DecodeResStr(SAuctionItemGetBack)
                else
                  ListItem.Items[4].Caption := '';
              end;
            end;

            Break;
          end;
        end;

        Inc(Item);
      end;
    end;

    for I := 0 to AUCTION_PAGE_COUNT - 1 do begin
      if not ArrChanged[I] then begin
        if I > DefMsg.Param - 1 then begin
          g_AuctionMyItems[I].AuctionID := 0;
          g_AuctionMyItems[I].Item.s.Name := '';

          g_AuctionMyItems[I].TradingStatus := -1;
        end;
      end;
    end;
  end
  else if DefMsg.Recog = 2 then begin
    if PageIndex <> FrmDlg.FAuctionMyAuctioningItemsPage then begin
      //OutputDebugString('aaa');
      Exit;
    end;

    for I := 0 to AUCTION_PAGE_COUNT - 1 do begin
      ArrChanged[I] := False;
    end;

    if (DefMsg.Param > 0) and (Length(sData) = DefMsg.Param * SizeOf(TRefreshAuctionItem)) then begin
      Item := pTRefreshAuctionItem(sData);
      for I := 0 to DefMsg.Param - 1 do begin
        for II := 0 to AUCTION_PAGE_COUNT - 1 do begin
          if g_AuctionMyAttention[II].AuctionID = Item.AuctionID then begin
            g_AuctionMyAttention[II].LastBidPrice := Item.LastBidPrice;
            g_AuctionMyAttention[II].TradingStatus := Item.TradingStatus;
            g_AuctionMyAttention[II].IsItemGive := Item.IsItemGive;
            g_AuctionMyAttention[II].IsAttention := Item.IsCancelAttention;
            g_AuctionMyAttention[II].IsItemCanRetrieve := Item.IsItemCanRetrieve;

            ArrChanged[II] := True;

            ListItem := TSerialWindows(FrmDlg).DLvAuctionMyAttentionItems.Items[II];
            if ListItem <> nil then begin
              if ListItem.Items[4] <> nil then begin
                if g_AuctionMyAttention[II].IsItemCanRetrieve then
                  ListItem.Items[4].Caption := DecodeResStr(SAuctionItemGetBack2)
                else if g_AuctionMyAttention[II].IsItemGive or g_AuctionMyAttention[II].IsAttention then
                  ListItem.Items[4].Caption := DecodeResStr(SAuctionItemDelete2)
                else
                  ListItem.Items[4].Caption := '';
              end;

              if ListItem.Items[5] <> nil then begin
                if g_AuctionMyAttention[I].TradingStatus = 0 then
                  ListItem.Items[5].Caption := DecodeResStr(SAuctionItemJoinAuction)
                else
                  ListItem.Items[5].Caption := '';
              end;
            end;

            Break;
          end;
        end;

        Inc(Item);
      end;
    end;

    for I := 0 to AUCTION_PAGE_COUNT - 1 do begin
      if not ArrChanged[I] then begin
        if I > DefMsg.Param - 1 then begin
          g_AuctionMyAttention[I].AuctionID := 0;
          g_AuctionMyAttention[I].Item.s.Name := '';
          g_AuctionMyAttention[I].TradingStatus := -1;
        end;
      end;
    end;
  end;
end;

procedure TfrmMain.ProcessMessageQueryAllAuctionItems(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I:Integer;
  AllItem:pTAllAuctionItem;
  ListItem:TDxListItem;
  ViewItem:pTViewItem;
begin
  for I := 0 to AUCTION_PAGE_COUNT - 1 do begin
    g_AuctionAllItems[I].AuctionID := 0;
    g_AuctionAllItems[I].Item.s.Name := '';
  end;

  FrmDlg.FAuctionAllItemsPage := DefMsg.Recog;
  FrmDlg.FAuctionAllItemsPageCount := MakeLong(DefMsg.Param, DefMsg.Tag);
  FrmDlg.SetAuctionPageCount();

  if (DefMsg.Series > 0) and (Length(sData) = DefMsg.Series * SizeOf(TAllAuctionItem)) then begin
    AllItem := pTAllAuctionItem(sData);
    for I := 0 to DefMsg.Series - 1 do begin
      if I >= Length(g_AuctionAllItems) then
        Break;
      g_AuctionAllItems[I] := AllItem^;
      Inc(AllItem);
    end;
  end;

  g_RefreshAuctionAllItemsTick := MyGetTickCount;

  if FrmDlg is TSerialWindows then begin
    TSerialWindows(FrmDlg).DLvAuctionAllItems.Clear;
    TSerialWindows(FrmDlg).DLvAuctionAllItems.Lock;
    try
      for I := 0 to AUCTION_PAGE_COUNT - 1 do begin
        if g_AuctionAllItems[I].AuctionID > 0 then begin
          ListItem := TSerialWindows(FrmDlg).DLvAuctionAllItems.Add;

          ViewItem := ListItem.AddItem('', nil); // 物品
          ViewItem.StringLineEx := nil; //HZQ 20230524 防止编译器警告

          ViewItem := ListItem.AddItem('', nil); // 当前价格
          ViewItem.Color.Up.Color := clYellow;
          ViewItem.Color.Hot.Color := clYellow;
          ViewItem.Color.Down.Color := clYellow;

          ViewItem := ListItem.AddItem(GetGoldStr(g_AuctionAllItems[I].SellingPrice), nil); // 一口价
          ViewItem.Color.Up.Color := clYellow;
          ViewItem.Color.Hot.Color := clYellow;
          ViewItem.Color.Down.Color := clYellow;

          ViewItem := ListItem.AddItem('', nil); // 剩余时间
          ViewItem.StringLineEx := nil; //HZQ 20230524 防止编译器警告

          ViewItem := ListItem.AddItem('', nil); // 操作

          if g_AuctionAllItems[I].TradingStatus = 0 then begin
            ViewItem.Caption := DecodeResStr(SAuctionItemJoinBuy);
          end;

          ViewItem.Color.Up.Color := clLime;
          ViewItem.Color.Up.Style := [fsUnderline];
          ViewItem.Color.Hot.Color := clWhite; // clWhite;
          ViewItem.Color.Hot.Style := [fsUnderline];
          ViewItem.Color.Down.Color := clRed;
          ViewItem.Color.Down.Style := [fsUnderline];
        end;
      end;
    finally
      TSerialWindows(FrmDlg).DLvAuctionAllItems.UnLock;
    end;
  end;
end;

