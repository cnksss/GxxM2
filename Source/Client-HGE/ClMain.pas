procedure TfrmMain.ProcessMessageEnabledAuctionItemList(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  I, Count:Integer;
  AcutionPrices:PTAcutionItemPricesLime;
  S:string;
  ActionItem:PTRulesActionItem;
begin
  if (DefMsg.Series = 0) or (Length(sData) > 0) then begin
    g_EnabledAuctionItemListCRC := BufferCrc(PChar(sData), Length(sData));

    if (DefMsg.Recog > 0) and (DefMsg.Recog = Length(sData)) then begin
      Clear_g_EnabledAuctionItemList;

      S := zLibDecompressString(sData);
      if Length(S) mod SizeOf(TRulesActionItem) = 0 then begin
        Count := Length(S) div SizeOf(TRulesActionItem);

        ActionItem := @S[1];
        for I := 0 to Count - 1 do begin
          New(AcutionPrices);
          AcutionPrices^ := ActionItem.Prices;

          g_EnabledAuctionItemList.AddObject(ActionItem.ItemName, TObject(AcutionPrices));

          Inc(ActionItem);
        end;
        g_EnabledAuctionItemList.Sorted := True;
      end;

    end;
  end;

  if DefMsg.Series > 0 then begin
    g_nShowClientDataFileProgress := DefMsg.Series;
    //OutputDebugString(PChar('正在加载资源' + IntToStr(g_nShowClientDataFileProgress)));
    RenderEvent(Self);
    Application.ProcessMessages;
  end;
end;

procedure TfrmMain.ProcessMessageCustomAttack(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Actor:TActor;
  UseMagic:PTUseMagicInfo;
  sx, sy, sobj, sSaying:string;
  Feature:TFeature;
begin
  // 自定义怪物攻击 chongchong 2014-07-22
  Actor := PlayScene.FindActor(DefMsg.Recog);
  if Actor <> nil then begin
    New(UseMagic);
    FillChar(UseMagic^, SizeOf(TUseMagicInfo), #0);

    sx := '';
    sy := '';
    sobj := '';
    sData := DecodeString(sData);
    sData := GetValidStr3_Ex(sData, sx, '|');
    sData := GetValidStr3_Ex(sData, sy, '|');
    sSaying := GetValidStr3_Ex(sData, sobj, '|');

    if (Length(sx) = 0) or (Length(sy) = 0) or (Length(sobj) = 0) then
      Exit;

    UseMagic.EffectNumber := -1 * DefMsg.ident;
    //UseMagic.ServerMagicCode := -1;       // chongchong 2016-05-02
    UseMagic.MagicSerial := DefMsg.ident;
    UseMagic.EffectType := mtExplosion;

    UseMagic.targx := StrToIntDef(sx, 0);
    UseMagic.targy := StrToIntDef(sy, 0);
    UseMagic.target := StrToInt64Def(sobj, 0);

    FillChar(Feature, SizeOf(TFeature), 0);
    Feature.Feature := Integer(UseMagic);
    Actor.SendMsg(DefMsg.ident, DefMsg.param {x}, DefMsg.tag {y}, DefMsg.series {dir}, Feature, 0, sSaying, 0);
    // Actor.SendMsg(SM_SPELL, 0, 0, adir, Integer(UseMagic), 0, '', 0);
    Inc(g_nSpellCount);
  end;
end;

