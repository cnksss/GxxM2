procedure TfrmMain.ProcessMessageRandomCode(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Source:TDIB;
  OutBuf:array[0..BUFFER_SIZE - 1] of Char;
  d, d1:TTexture;
begin
  if (DefMsg.Recog = 0) or (DefMsg.Recog <> Length(sData)) then
    Exit;

  if DefMsg.Series = Integer(rctLogin) then begin
    zLibDecodeString(sData, @OutBuf, SizeOf(OutBuf));

    Source := TDIB.Create;
    Source.SetSize(170, 70, 8);

    if Assigned(g_AntiPlugNotifyFunc) then begin
      g_AntiPlugNotifyFunc(event_Recv_VerifyCode, nil, 0);
    end;

    Move(OutBuf[SizeOf(TBitmapFileHeader) + SizeOf(TBitmapInfoHeader)], Source.PBits^, Source.Size);
    d := NewTexture(Source);
    if d <> nil then begin

      {$IF IsMultiThreadRender = 1}
      EnterCriticalSection(g_CriticalSection);
      try
        {$IFEND}
        d1 := g_RandomCodeSurface[rctLogin];
        g_RandomCodeSurface[rctLogin] := d;

        if DScreen.CurrentScene = LoginScene then begin
          FrmDlg.OpenDRandomCodeDlg;
        end else begin
          DScreen.SetShowLoginSceneShowRandomCodeDlg;
        end;

        {$IF IsMultiThreadRender = 1}
      finally
        LeaveCriticalSection(g_CriticalSection);
      end;
      {$IFEND}

      d1.Free;
    end;
    Source.Free;
  end
  else if (DefMsg.Series = Integer(rctPwdChange)) or (DefMsg.Series = Integer(rctRegister)) then begin
    zLibDecodeString(sData, @OutBuf, SizeOf(OutBuf));

    Source := TDIB.Create;
    Source.SetSize(110, 30, 24);

    if Assigned(g_AntiPlugNotifyFunc) then begin
      g_AntiPlugNotifyFunc(event_Recv_VerifyCode, nil, 1);
    end;

    Move(OutBuf[SizeOf(TBitmapFileHeader) + SizeOf(TBitmapInfoHeader)], Source.PBits^, Source.Size);
    d := NewTexture(Source);
    if d <> nil then begin

      {$IF IsMultiThreadRender = 1}
      EnterCriticalSection(g_CriticalSection);
      try
        {$IFEND}
        d1 := g_RandomCodeSurface[TRandCodeType(DefMsg.Series)];
        g_RandomCodeSurface[TRandCodeType(DefMsg.Series)] := d;

        {$IF IsMultiThreadRender = 1}
      finally
        LeaveCriticalSection(g_CriticalSection);
      end;
      {$IFEND}

      d1.Free;
    end;
    Source.Free;
  end;
end;

procedure TfrmMain.ProcessMessageChangeMap(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Index:Integer;
  sSubMap:string;
begin
  {$IF TESTMODE = 1}
  DScreen.AddChatBoardString('使用物品到换地图间隔0:' + IntToStr(MyGetTickCount - m_EatItemTick), clWhite, clBlack);
  {$IFEND}

  WaitingMsg := DefMsg^;

  WaitingStr := DecodeString(sData);
  sSubMap := WaitingStr;

  Index := Pos(sLineBreak, WaitingStr);
  if Index > 0 then begin
    sSubMap := Copy(WaitingStr, Index + 2, MaxInt);
    WaitingStr := Copy(WaitingStr, 1, Index - 1);
  end;

  if Assigned(g_AntiPlugNotifyFunc) then begin
    g_AntiPlugNotifyFunc(event_NewMap, System.PByte(sSubMap), Length(WaitingStr));
  end;

  g_boMapMovingWait := True;
  g_ChrAction := caNone;
  g_nTargetX := -1;
  g_nTargetY := -1;
  g_dwMapMovingWaitTick := MyGetTickCount;
  WaitMsgTimer.Enabled := True;

  FrmDlg.CloseGameLevelDlg;
end;

procedure TfrmMain.ProcessMessageGroupMemberChangeMap(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  Index:Integer;
  MapName, MapDesc:string;
  GroupMember:PGroupMember;
begin
  {$IF TESTMODE = 1}
  DScreen.AddChatBoardString('使用物品到换地图间隔0:' + IntToStr(MyGetTickCount - m_EatItemTick), clWhite, clBlack);
  {$IFEND}

  MapName := DecodeString(sData);
  MapDesc := '';
  Index := Pos(sLineBreak, MapName);
  if Index > 0 then begin
    MapDesc := Copy(MapName, 1, Index - 1);
    MapName := Copy(MapName, Index + 2, MaxInt);

    Index := Pos(sLineBreak, MapName);
    if Index > 0 then begin
      MapName := Copy(MapName, 1, Index - 1);
    end;
  end;

  if g_ClientConfig.boShowNewGroupInfo then begin
    for Index := 0 to g_GroupMembers.Count - 1 do begin
      GroupMember := g_GroupMembers.Items[Index];
      if GroupMember.nRecogId = DefMsg.Recog then begin
        GroupMember.sMapName := MapName;
        GroupMember.sMapDesc := MapDesc;
        FrmDlg.RefreshNewGroupMember(Index);
        Break;
      end;
    end;
  end;
end;

