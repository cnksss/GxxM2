  // 不是新的交易框
  FrmDlg.ResetMenuDlg(DefMsg.Series = 0);

  CancelUpgradeItem(DefMsg.Recog);
  g_nCurMerchant := DefMsg.Recog;

  if (DefMsg.Param > 0) and (Length(sData) = DefMsg.Param * SizeOf(TClientItem)) then begin
    pcTemp := PTClientItem(sData);
    g_MenuItemList.Lock;
    try
      for I := 0 to DefMsg.Param - 1 do begin
        New(pc);
        pc^ := pcTemp^;
        g_MenuItemList.Add(pc);

        Inc(pcTemp);
      end;
    finally
      g_MenuItemList.UnLock;
    end;
  end;

  // 不是新的交易框
  if DefMsg.Series = 0 then begin
    with FrmDlg do begin
      MenuList.Lock;
