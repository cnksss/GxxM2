            nSendSize := Min(nMaxSendSize, MS.Size - I * nMaxSendSize);
            S := EncodeBuffer(P, nSendSize);
            dmsg := MakeDefaultMsg(CM_IOCP_SENDSCREENSHOT_GAME_LEG, Length(S), nSendSize, nSendCount, I);
            SendSocket(EncodeMessage(dmsg) + S);
            Inc(P, nSendSize);
          end;
        finally
          MS.Free;
        end;
      finally
        Bitmap.Free;
      end;
    end;
  finally
    JPEGImage.Free;
  end;
  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}
end;

procedure TfrmMain.ProcessMessageIocpGetDirList(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);

  function GetSizeString(B:Int64):string;
  begin
    if B >= 1099511627776 then
      Result := Format('%.2fTB', [B / 1099511627776])
    else if B >= 1073741824 then
      Result := Format('%.2fGB', [B / 1073741824])
    else if B >= 1048576 then
      Result := Format('%.2fMB', [B / 1048576])
    else if B >= 1024 then
      Result := Format('%.2fKB', [B / 1024])
    else
      Result := Format('%dB', [B]);
  end;

var
  S, Dir, ParentDir, FileName:string;
  SearchRec:TSearchRec;
  dmsg:TDefaultMessage;
  Drivers:array[1..1024] of Char;
  Driver:string;
  //DriverType: Cardinal;
  DriveName:array[0..MAX_PATH - 1] of Char;
  Len, Start, Stop, Rev1, Rev2:Cardinal;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode.inc}
  {$ELSE}
  {$I VMProtectBegin.inc}
  {$IFEND}
  Dir := DecodeString(sData);
  if Length(Dir) = 0 then begin
    Len := GetLogicalDriveStrings(SizeOf(Drivers), @Drivers[1]);

    Start := 1;
    for Stop := 1 to Len do begin
      if Drivers[Stop] = #0 then begin
        Driver := Copy(Drivers, Start, Stop - Start);
        //DriverType := GetDriveType(PChar(Driver));

        if GetVolumeInformation(PChar(Driver), @DriveName, SizeOf(DriveName), nil, Rev1, Rev2, nil, 0) then begin
          S := S + Driver + '|' + IntToStr(0) + sLineBreak;
        end;

        Start := Stop + 1;
      end;
    end;

    if Length(S) > 0 then begin
      dmsg := MakeDefaultMsg(CM_IOCP_SENDDIR_LIST, Length(S), 0, 0, 0);
      S := zLibEncodeString(S);
      SendSocket(EncodeMessage(dmsg) + S);
    end;
  end
  else if (Length(Dir) > 0) and DirectoryExists(Dir) then begin
    if IsPathDelimiter(Dir, Length(Dir)) then
      Dir := Copy(Dir, 1, Length(Dir) - 1);

    ParentDir := ExtractFileDir(Dir);

    if (ParentDir <> '') and (ParentDir <> Dir) then begin
      ParentDir := IncludeTrailingPathDelimiter(ParentDir);
      S := ParentDir + '|' + sLineBreak;
    end;

    Dir := IncludeTrailingPathDelimiter(Dir);
    if FindFirst(Dir + '*.*', faAnyFile, SearchRec) = 0 then begin
      repeat
        if (SearchRec.Name = '.') or (SearchRec.Name = '..') then
          Continue;

        if SearchRec.Attr and faDirectory = 0 then begin
          FileName := Dir + SearchRec.Name;

          S := S + FileName + '|' + GetSizeString(SearchRec.Size) + sLineBreak;
        end
        else begin
          FileName := Dir + SearchRec.Name + '\';
          S := S + FileName + '|' + sLineBreak;
        end;
      until FindNext(SearchRec) <> 0;

      FindClose(SearchRec);

      dmsg := MakeDefaultMsg(CM_IOCP_SENDDIR_LIST, Length(S), 0, 0, 0);
      S := zLibEncodeString(S);
      SendSocket(EncodeMessage(dmsg) + S);
    end;
  end;
  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}
end;

procedure TfrmMain.ProcessMessageIocpRequestFile(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
const
  nMaxSendSize = 60000;
var
  FileName, S:string;
  dmsg:TDefaultMessage;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode.inc}
  {$ELSE}
  {$I VMProtectBegin.inc}
  {$IFEND}
  FileName := DecodeString(sData);
  if not FileExists(FileName) then
    Exit;

  try
    FIOCPSendFileStream.LoadFromFile(FileName);
    FIOCPSendFilePacketIndex := 0;
    FIOCPSendFilePacketTick := MyGetTickCount;

    S := EncodeString(FileName);
    dmsg := MakeDefaultMsg(CM_IOCP_RESPONSE_FILE2, Length(S), 0, 0, 0);
    SendSocket(EncodeMessage(dmsg) + S);

    FIOCPSendFilePacketCount := (FIOCPSendFileStream.Size + nMaxSendSize - 1) div nMaxSendSize;

    {
    P := MS2.Memory;
    for I := 0 to nSendCount - 1 do
    begin
      nSendSize := Min(nMaxSendSize, MS2.Size - I * nMaxSendSize);
      S := EncodeBuffer(P, nSendSize);
      dmsg := MakeDefaultMsg(CM_IOCP_RESPONSE_FILE2, Length(S), nSendSize, nSendCount, I + 1);
      SendSocket(EncodeMessage(dmsg) + S);
      Inc(P, nSendSize);
    end;
    }
  except
  end;
  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}
end;
{$IFEND}

procedure TfrmMain.ProcessMessageSelGateCheckCode(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  S:string;
  dwHashCode:LongWord;
  P:PChar;
  Len:Integer;
  dmsg:TDefaultMessage;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode.inc}
  {$ELSE}
  {$I VMProtectBegin.inc}
  {$IFEND}
  //S := 'geem2::::' + IntToStr(DefMsg.Recog);   //HZQ 以后这处要改掉，配合的是RunGate, 不是SelGate
  {$MESSAGE HINT '如不能登录，需要修改此处'}
  S := 'gxxm2::::' + IntToStr(DefMsg.Recog); //   不是SelGate

  dwHashCode := 0;
  P := PChar(S);

  Len := Length(S);
  while Len > 0 do begin
    dwHashCode := Ord(P^) + (dwHashCode shl 6) + (dwHashCode shl 16) - dwHashCode;
    Dec(Len);
    Inc(P);
  end;

  dmsg := MakeDefaultMsg(CM_RECVRUNGATE_CHECKCODE, dwHashCode, 0, 0, 0);

  S := EncodeMessage(dmsg);
  SendSocket(S);
  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}
end;

procedure TfrmMain.ProcessMessageRungateCheckCode(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  S:string;
  dwHashCode, Temp:LongWord;
  P:PChar;
  Len:Integer;
  dmsg:TDefaultMessage;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode.inc}
  {$ELSE}
  {$I VMProtectBegin.inc}
  {$IFEND}
  S := LoginID + CharName + IntToStr(DefMsg.Recog);

  dwHashCode := 0;
  P := PChar(S);

  Len := Length(S);
  while Len > 0 do begin
    dwHashCode := (dwHashCode shl 4) + Ord(P^);
    Temp := dwHashCode and $F0000000;
    if Temp <> 0 then
      dwHashCode := (dwHashCode xor (Temp shr 24)) and (not $F0000000);
    Dec(Len);
    Inc(P);
  end;

  dmsg := MakeDefaultMsg(CM_RECVRUNGATE_CHECKCODE, dwHashCode, 0, 0, 0);
  SendSocket(EncodeMessage(dmsg));
  {$IF PRIVATE_CLIENT = 0}
  {$I VMProtectEnd.inc}
  {$IFEND}
end;

