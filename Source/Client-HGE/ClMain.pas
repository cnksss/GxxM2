procedure TfrmMain.ClientSocketGateRead(Sender:TObject; Socket:TCustomWinSocket);
var
  N:Integer;
  S:string;
  IP, Port:string;
  Temp:TUpdateEngine;
begin
  S := Socket.ReceiveText;
  // 收到消息后，覆盖IP和端口，重新启用自动更新 piaoyun 2013-11-21
  N := Pos('|', S);
  IP := LeftStr(S, N - 1);
  if IP = '' then
    Exit;
  Port := RightStr(S, Length(S) - N);
  if Length(Port) = 0 then
    Exit;

  g_sUpdateAddr := IP;
  g_nUpdatePort := StrToInt(Port);

  if g_nUpdatePort > 0 then begin
    g_boAutoUpdate := False;
    if g_UpdateEngine <> nil then begin
      Temp := g_UpdateEngine;
      g_UpdateEngine := nil;
      Temp.Free;
    end;

    g_UpdateEngine := TUpdateEngine.Create;
    g_boAutoUpdate := True;

    S := g_sSelfFilePath + 'wav\sound.lst';
    if g_boAutoUpdate then
      g_UpdateEngine.Add(S, udtFileWav, -1, nil, nil);
  end;
end;

