procedure TfrmMain.ProcessMessageMagicHintMsg(Sender:TObject; DefMsg:pTDefaultMessage; sData:string);
var
  ColorF, ColorB:Byte;
  nTempX, nTempY:Integer;
begin
  if Length(sData) = 0 then
    Exit;

  if DefMsg.Param = 1 then begin
    ColorF := g_ClientConfig.btMagicOKMsgFColor;
    ColorB := g_ClientConfig.btMagicOKMsgBColor;
  end
  else begin
    ColorF := g_ClientConfig.btMagicFailMsgFColor;
    ColorB := g_ClientConfig.btMagicFailMsgBColor;
  end;

  if g_ClientConfig.boMagicMsgAddChatBoardMsg then begin
    DScreen.AddChatBoardString(sData, GetRGB(ColorF), GetRGB(ColorB))
  end
  else begin
    if g_ClientConfig.boMagicMsgXRightToLeft then
      nTempX := SCREENWIDTH - g_ClientConfig.nMagicMsgX
    else
      nTempX := g_ClientConfig.nMagicMsgX;

    if g_ClientConfig.boMagicMsgYBottomToTop then
      nTempY := SCREENHEIGHT - g_ClientConfig.nMagicMsgY
    else
      nTempY := g_ClientConfig.nMagicMsgY;

    DScreen.AddSysMsg(sData, ColorF, ColorB, nTempX, nTempY, True, True)
  end;
end;

