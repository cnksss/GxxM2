procedure TSerialWindows.ShopPageChange;
var
  nPage, nPageCount:Integer;
  nNextPage:Integer;
begin
  nPageCount := g_ShopTablePageCounts[ShopTabPage] div 10; // 总页数
  nNextPage := g_ShopTablePages[ShopTabPage];

  g_MouseShopItems.StdItem.Name := '';
  DGridShop.ClearSelect;
  DLabelShopMemo.Caption := '';
  DLabelShopMemo.Lines.Clear;

  if g_ShopTablePageCounts[ShopTabPage] > 0 then begin
    nPage := nNextPage div 10 + 1;
    if g_ShopTablePageCounts[ShopTabPage] mod 10 > 0 then
      Inc(nPageCount);
    if nPageCount <= 0 then
      nPageCount := 1;
    DLabelPageCount.Caption := Format('(%d/%d 页)', [nPage, nPageCount]);
  end
  else begin
    nPage := 1;
    nPageCount := 1;
    DLabelPageCount.Caption := Format('(%d/%d 页)', [nPage, nPageCount]);
  end;
end;

