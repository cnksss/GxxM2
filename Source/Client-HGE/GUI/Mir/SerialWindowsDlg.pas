procedure TSerialWindows.OpenDAuctionDlg(nPage:Integer; ShowAuctionID:Integer);
var
  I:Integer;
  Money:pTClientCustomMoney;
begin
  DAuctionDlg.Visible := True;

  DAuctionPage.ActivePageIndex := 0;
  DAuctionSheet1Form.Visible := True;

  DBtnAuctionAllItemsGroup01.Checked := False;
  DBtnAuctionAllItemsGroup02.Checked := False;
  DBtnAuctionAllItemsGroup03.Checked := False;
  DBtnAuctionAllItemsGroup04.Checked := False;
  DBtnAuctionAllItemsGroup05.Checked := False;
  DBtnAuctionAllItemsGroup06.Checked := False;
  DBtnAuctionAllItemsGroup07.Checked := False;
  DBtnAuctionAllItemsGroup08.Checked := False;
  DBtnAuctionAllItemsGroup09.Checked := False;
  DBtnAuctionAllItemsGroup10.Checked := False;
  DBtnAuctionAllItemsGroup11.Checked := False;
  DBtnAuctionAllItemsGroup12.Checked := False;
  DBtnAuctionAllItemsGroup00.Checked := True;

  FAuctionAllItemsSortField := 0;
  FAuctionAllItemsSortASC := True;

  DBtnAuctionAllItemsMoney.Items.Clear;
  DBtnAuctionAllItemsMoney.Items.AddObject('不限', TObject(0));

  if g_ClientConfig.nAuctionCurrencyTypeEx and 2 <> 0 then {// 元宝}  begin
    DBtnAuctionAllItemsMoney.Items.AddObject(g_sGameGoldName, TObject(1));
  end;

  if g_ClientConfig.nAuctionCurrencyTypeEx and 16 <> 0 then {// 游戏点}  begin
    DBtnAuctionAllItemsMoney.Items.AddObject(g_sGamePointName, TObject(2));
  end;

  if g_ClientConfig.nAuctionCurrencyTypeEx and 1 <> 0 then {// 金币}  begin
    DBtnAuctionAllItemsMoney.Items.AddObject(g_sGoldName, TObject(3));
  end;

  if g_ClientConfig.nAuctionCurrencyTypeEx and 4 <> 0 then {// 金刚石}  begin
    DBtnAuctionAllItemsMoney.Items.AddObject(g_sGameDiamondName, TObject(4));
  end;

  if g_ClientConfig.nAuctionCurrencyTypeEx and 8 <> 0 then {// 灵符}  begin
    DBtnAuctionAllItemsMoney.Items.AddObject(g_sGameGirdName, TObject(5));
  end;

  for I := 0 to g_CustomMoneyRule.Count - 1 do begin
    Money := pTClientCustomMoney(g_CustomMoneyRule.Items[I]);
    if Money.boCanAuction then begin
      DBtnAuctionAllItemsMoney.Items.Add(Money.sName);
    end;
  end;
  DBtnAuctionAllItemsMoney.ItemIndex := 0;

  DEdtAuctionAllItemsPrices1.Text := '';
  DEdtAuctionAllItemsPrices2.Text := '';

  FrmMain.SendQueryMyAuctionItems(1);
  FQueryAllAuctionItems_KeyWord := '';
  SendQueryAllAuctionItems(1, ShowAuctionID);
  FrmMain.SendQueryMyAuctioningItems(1);

  FAuctionMyItemsBagPage := 1;
  FAuctionMyItemsBagSelectIndex := -1;

  if (MyGetTickCount - FAuctionBroadcastShowTick < Cardinal(FAuctionBroadcastShowTime)) then begin
    DAuctionBroadcastDlg.Visible := True;
  end;

  DBackground.FocusedControl := nil;
end;

