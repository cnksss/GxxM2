procedure TSerialWindows.DGameGoldDealOKClick(Sender:TObject; X, Y:Integer);
var
  I:Integer;
  sChrName:string;
  nGameGold:Integer;
  nDealItemCount:Integer;
begin
  if g_MySelf = nil then
    Exit;
  if not g_boGameGoldDealing then begin
    sChrName := Trim(DEditGameGoldDealChrName.Text);
    if sChrName = '' then begin
      DMessageDlg('[失败]：买家名称不正确', [mbOk]);
      DEditGameGoldDealChrName.SetFocus;
      Exit;
    end;

    if sChrName = g_MySelf.m_sUserName then begin
      DMessageDlg('[失败]：买家名称不能是自己', [mbOk]);
      DEditGameGoldDealChrName.SetFocus;
      Exit;
    end;

    nGameGold := StrToIntDef(Trim(DEditGameGoldDeal.Text), 0);
    if nGameGold = 0 then begin
      DMessageDlg('[失败]：出售价格不正确', [mbOk]);
      DEditGameGoldDeal.SetFocus;
      Exit;
    end;

    if g_nDealGameDiamond <= 0 then begin
      nDealItemCount := 0;
      for I := 0 to Length(g_GameGoldDealItems) - 1 do begin
        if g_GameGoldDealItems[I].S.Name <> '' then
          nDealItemCount := nDealItemCount + 1;
      end;
      if nDealItemCount = 0 then begin
        DMessageDlg('[失败]：出售物品不能为空', [mbOk]);
        Exit;
      end;
    end;

    if FrmDlg.DMessageDlg('您确认出售这些物品吗？', [mbOk, mbCancel]) <> mrOk then
      Exit;

    g_boGameGoldDealing := True;
    g_dwGameGoldDealTick := MyGetTickCount;
    g_GameGoldDeal.SellChrName := g_MySelf.m_sUserName;
    g_GameGoldDeal.BuyChrName := sChrName;
    g_GameGoldDeal.GameGold := StrToIntDef(Trim(DEditGameGoldDeal.Text), 0);
    g_GameGoldDeal.GameDiamond := g_nDealGameDiamond;
    g_GameGoldDeal.DealState := s_Normal;
    g_GameGoldDeal.ItemCount := 0;
    g_GameGoldDeal.SellDateTime := Now;
    frmMain.SendGameGoldDeal;
  end;
  // DGameGoldDealDlg.Visible := False;
end;

