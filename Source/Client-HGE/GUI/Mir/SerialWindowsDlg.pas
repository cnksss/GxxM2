    DScreen.AddChatBoardString(DecodeResStr(SCannotExitGame2), clYellow, clRed);
  end;
end;

procedure TSerialWindows.MinMapLevelChange;
var
  boShowDMinMapDlgEx:Boolean;
begin
  if g_ClientConfig.btMinMapType <> 2 then begin
    inherited;
    Exit;
  end;

  DMinMapDlg.Visible := False;

  if CheckDMinMapBigDlgVisible then begin
    // M键显示大地图和小地图，在大地图上飞坐标，小地图会关闭 2019-08-07 01:11:34
    //DMinMapDlgEx.Visible := False;
    //DMinMapExShow.Visible := False;
    Exit;
  end;

  boShowDMinMapDlgEx := (g_nMiniMapIndex >= 0) and g_boViewMiniMap;
  if g_nViewMinMapLv = 1 then begin
    boShowDMinMapDlgEx := (g_nMiniMapIndex >= 0);

    if DMinMapExShow.Visible <> boShowDMinMapDlgEx then begin
      DMinMapExShow.Visible := boShowDMinMapDlgEx;

      if DMinMapDlgEx.Visible then
        DMinMapDlgEx.Visible := False;

      if DMinMapExShow.Visible then begin
        if g_boViewMiniMap then begin
          DMinMapExShow.Left := DMinMapDlgEx.Left + DMinMapExHide.Left;
          DMinMapExShow.Top := DMinMapDlgEx.Top + DMinMapExHide.Top;
          DMinMapExShow.Visible := g_nMiniMapIndex >= 0;
        end;
      end;
    end;

    if (not g_boViewMiniMap) and DMinMapExShow.Visible then
      DMinMapExShow.Visible := False;
  end
  else begin
    if DMinMapDlgEx.Visible <> boShowDMinMapDlgEx then begin
      DMinMapDlgEx.Visible := boShowDMinMapDlgEx;

      if not DMinMapDlgEx.Visible then begin
        if g_boViewMiniMap then begin
          DMinMapExShow.Left := DMinMapDlgEx.Left + DMinMapExHide.Left;
          DMinMapExShow.Top := DMinMapDlgEx.Top + DMinMapExHide.Top;
          DMinMapExShow.Visible := g_nMiniMapIndex >= 0;
        end
        else begin
          if DMinMapExShow.Visible then
            DMinMapExShow.Visible := False;
        end;
      end
      else begin
        if DMinMapExShow.Visible then
          DMinMapExShow.Visible := False;
      end;
    end;

    if (not g_boViewMiniMap) and DMinMapExShow.Visible then
      DMinMapExShow.Visible := False;
  end;
end;

procedure TSerialWindows.DMinMapBigDlgMouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  nX, nY:Integer;
  vtRect:TRect;
  d:TTexture;
begin
  if g_nMiniMapIndex < 0 then
    Exit;

  if (g_MySelf <> nil) and (not g_MySelf.m_boDeath) then begin
    { TODO -c修正 -ochongchong : 小地图扩展再修改 【2013-4-23】}
    case g_nMiniMapIndex of
      9900..9999:
        d := g_WBmpMapImages.Images[g_nMiniMapIndex - 9900]; // 预留
      // mmap10.wil从10001-15000开始
      10000..14999:
        d := g_WMMapImages10.Images[g_nMiniMapIndex - 10000];

      // mmap11.wil从15001-20000开始
      15000..19999:
        d := g_WMMapImages11.Images[g_nMiniMapIndex - 15000];

      // mmap12.wil从20001-24999开始
      20000..24999:
        d := g_WMMapImages12.Images[g_nMiniMapIndex - 20000];

      else
        d := g_WMMapImages.Images[g_nMiniMapIndex];
    end;

    if (d = nil) then
      Exit;

    vtRect := DMinMapBigDlg.VirtualRect;
    nX := X - vtRect.Left;
    nY := Y - vtRect.Top;
    nX := Round(nX * d.Width / DMinMapBigDlg.Width);
    nY := Round(nY * d.Height / DMinMapBigDlg.Height);
    nX := nX * 32 div 48;
    nY := nY * 32 div 32;
    if Button = mbLeft then begin
      if (abs(g_MySelf.m_nCurrX - nX) <= 1) and (abs(g_MySelf.m_nCurrY - nY) <= 1) then begin
        LegendMap.Stop;
      end
      else begin
        if LegendMap.StartFind then begin
          if (LegendMap.EndX <> nX) or (LegendMap.EndY <> nY) then begin
            LegendMap.Stop;
          end
          else
            Exit;
        end;
        LegendMap.Stop;

        frmMain.SendClientMessage(CM_AUTOFINDPATHINFO, 0, 0, 0, 1, '');
        DScreen.AddChatBoardString(Format(DecodeResStr(SFindPathHint), [nX, nY]), GetRGB(154), clWhite);

        g_dwAutoFindPathTick := MyGetTickCount;
        LegendMap.BeginX := g_MySelf.m_nCurrX;
        LegendMap.BeginY := g_MySelf.m_nCurrY;
        LegendMap.EndX := nX;
        LegendMap.EndY := nY;
      end;
    end
    else begin
      if g_sUserMoveCmd <> '' then
        frmMain.SendSay(Format('@%s %d %d', [g_sUserMoveCmd, nX, nY]));
    end;
  end;
end;

