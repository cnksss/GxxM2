procedure TSerialWindows.UpDate;
var
  n1C:Integer;
begin
  if DGuessResultDlg.Visible then begin
    if (MyGetTickCount - g_dwPlayGuessfingerTick > 50) and (DGuessResultDlg.Width > 165) then begin
      g_dwPlayGuessfingerTick := MyGetTickCount;
      DGuessResultDlg.Width := DGuessResultDlg.Width - 20;
      DGuessResultDlg.Left := (DGuessfingerDlg.Width - DGuessResultDlg.Width) div 2;
      DGuessResultDlg.Draw1.DestLeft := (DGuessResultDlg.Width - 108) div 2;
    end;
    if (MyGetTickCount - g_dwPlayGuessfingerTick > 2000) then begin
      if DGuessResultDlg.Width <= 165 then begin
        GuessfingerOK;
      end;
    end;
  end;
  if g_boNpcSelectWine then begin // NPC开始选酒 喝酒
    if MyGetTickCount - g_dwNpcSelectWineTick > 300 then begin
      g_dwNpcSelectWineTick := MyGetTickCount;
      Inc(g_nSelectWineIndex);
      if g_nSelectWineIndex < 0 then
        g_nSelectWineIndex := 0;
      if g_nSelectWineIndex > 5 then
        g_nSelectWineIndex := 0;
      n1C := 0;
      while True do begin
        if (n1C >= 6) or (not g_DrinkItems[g_nSelectWineIndex]) then begin
          Dec(g_nNpcSelectWineTime);
          break;
        end;
        Inc(n1C);
        Inc(g_nSelectWineIndex);
        if g_nSelectWineIndex > 5 then
          g_nSelectWineIndex := 0;
      end;
    end;
    if g_nNpcSelectWineTime <= 0 then begin
      NpcSelectDrinkWine;
    end;
  end;
  if g_boPlayDrink then begin // 播放喝酒动作
    if g_nPlayDrinkImageCount > 0 then begin // 播放图片数量
      if MyGetTickCount - g_dwPlayDrinkTick > 150 then begin
        g_dwPlayDrinkTick := MyGetTickCount;
        Dec(g_nPlayDrinkImageCount);
        if g_boPlayDrinkObject then begin // 播放对象 True=NPC False=Self
          DGuessfingerDlg.Draw1.ImageIndex := DGuessfingerDlg.Draw1.ImageIndex + 1;
        end
        else begin
          DGuessfingerDlg.Draw2.ImageIndex := DGuessfingerDlg.Draw2.ImageIndex + 1;
        end;
      end;
    end
    else begin
      PlayDrinkOK; // 播放喝酒动画完成
    end;
  end;
  if g_MySelf <> nil then
    NewStateWindows.UpDate;
  inherited;
end;

