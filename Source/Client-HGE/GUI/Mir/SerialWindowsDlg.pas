// 在"确定"和"取消"的确定框时,按Enter键会误触发聊天编辑 chongchong 2013-11-13

procedure TSerialWindows.DMsgDlgKeyPress(Sender:TObject; var Key:Char); stdcall;
begin
  if (Sender = DMsgDlg) or (Sender is TDxEdit) then begin
    {
    // 不让输入空格 2019-12-20 23:56:28
    if Key = Chr(VK_SPACE) then
    begin
      Key := #0;
      Beep;
      Exit;
    end;
    }

    if Key = #13 then begin
      { TODO -opiaoyun -c修改 : 商店购买物品，默认回车”确定“处理 【2013-08-15】 }
      if DMsgDlgOk.Visible and not (DMsgDlgYes.Visible {or DMsgDlgCancel.Visible} or DMsgDlgNo.Visible) then begin
        DMsgDlg.DialogResult := mrOk;
        DMsgDlg.Visible := False;
        Key := #0;
        Exit;
      end;
      if DMsgDlgYes.Visible and not (DMsgDlgOk.Visible or DMsgDlgCancel.Visible or DMsgDlgNo.Visible) then begin
        DMsgDlg.DialogResult := mrYes;
        DMsgDlg.Visible := False;
        Key := #0;
        Exit;
      end;
    end;

    if Key = #27 then begin
      if DMsgDlgCancel.Visible then begin
        DMsgDlg.DialogResult := mrCancel;
        DMsgDlg.Visible := False;
        Key := #0;
        Exit;
      end;
    end;
  end
  else begin
    if Key = #13 then begin
      TDxImageForm(Sender).DialogResult := mrOk;
      TDxImageForm(Sender).Visible := False;
    end;
  end;
end;

procedure TSerialWindows.DGroupJoinDlgButtonClick(Sender:TObject; X, Y:Integer);
var
  Msg:TDefaultMessage;
  S:string;
begin
  if Sender = FDGroupJoinDlgOK then begin
