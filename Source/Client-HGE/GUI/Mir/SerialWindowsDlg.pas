        TreeView.ImageIndex.ImageType := FMissionTreeViewSetting.ImageIndex.Image;
        TreeView.ImageIndex.Up := FMissionTreeViewSetting.ImageIndex.Up;
        TreeView.ImageIndex.Hot := FMissionTreeViewSetting.ImageIndex.Hot;
        TreeView.ImageIndex.Down := FMissionTreeViewSetting.ImageIndex.Down;
