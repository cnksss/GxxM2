    Exit;

  if (ComboBoxMyShopItemMoneyType.ItemIndex < 0) or (ComboBoxMyShopItemMoneyType.ItemIndex >= ComboBoxMyShopItemMoneyType.Items.Count) then begin
    DMessageDlg(DecodeResStr(SUserShopMoneyType), [mbOk]);
    Exit;
  end;

  g_dwQueryMyShopItemTime := MyGetTickCount;
  S := ComboBoxMyShopItemMoneyType.Items[ComboBoxMyShopItemMoneyType.ItemIndex];
  if SameText(S, g_sGameGoldName) then
    MoneyType := 0
  else if SameText(S, g_sGamePointName) then
    MoneyType := 1
  else if SameText(S, g_sGoldName) then
    MoneyType := 2
  else if SameTExt(S, g_sGameDiamondName) then
    MoneyType := 3
  else if SameText(S, g_sGameGirdName) then
    MoneyType := 4
  else if GetCustomMoneyIndexByName(S, 0) <> -1 then
    MoneyType := GetCustomMoneyIndexByName(S, 0)
  else begin
    DMessageDlg(DecodeResStr(SUserShopMoneyType), [mbOk]);
    Exit;
  end;

  if ComboBoxMyShopItemPos.ItemIndex = 0 then
    sShopType := DecodeResStr(SUserShopSell)
  else
    sShopType := DecodeResStr(SUserShopToStorage);

  if (g_MyShopDlgItem.S.Name <> '') or (g_MyShopDlgItemWait.S.Name <> '') then begin
    if (g_MyShopDlgItemWait.S.Name = '') then begin
      if DMessageDlg(Format(DecodeResStr(SUserShopOperateAsk), [ProcessItemName(g_MyShopDlgItem.S.Name), EditMyShopItemPrice.Value, S, sShopType]), [mbOk, mbCancel]) = mrOk then begin
        frmMain.SendAddItemToMyShop(g_MyShopDlgItem.MakeIndex, ComboBoxMyShopItemPos.ItemIndex, ComboBoxMyShopItemType.ItemIndex, MoneyType, EditMyShopItemPrice.Value, g_MyShopDlgItem.S.Name);

        g_MyShopDlgItemWait := g_MyShopDlgItem;
        g_MyShopDlgItem.s.Name := '';
      end;
    end;
  end
  else begin
    if (g_SelectMyShopItem <> nil) and (g_SelectMyShopItem.Item.s.Name <> '') then begin
      if DMessageDlg(Format(DecodeResStr(SUserShopOperateAsk), [ProcessItemName(g_SelectMyShopItem.Item.s.Name), EditMyShopItemPrice.Value, S, sShopType]), [mbOk, mbCancel]) = mrOk then begin
        g_SelectMyShopItemWait := g_SelectMyShopItem.Item;

        frmMain.SendChangeMyShopItem(g_SelectMyShopItem.Item.MakeIndex, ComboBoxMyShopItemPos.ItemIndex, ComboBoxMyShopItemType.ItemIndex, MoneyType, EditMyShopItemPrice.Value, g_SelectMyShopItem.Item.S.Name);
      end;
    end;
  end;
end;

