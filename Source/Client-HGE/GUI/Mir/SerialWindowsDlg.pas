      DrawGridItem(TDxImageButton(Sender).VirtualRect, @g_SellPlayerUserInfo.UseItems[nWhere].S, @g_SellPlayerUseItemsEffect[nWhere])
    else
      DrawBodyItem(TDxImageButton(Sender).VirtualRect, @g_SellPlayerUserInfo.UseItems[nWhere].S, g_SellPlayerUserInfo.UseItems[nWhere].btHeroM2Light, @g_SellPlayerUseItemsEffect[nWhere], nWhere <> U_RIGHTHAND);
