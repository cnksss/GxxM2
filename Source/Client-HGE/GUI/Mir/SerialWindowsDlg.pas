  vtRect:TRect;
  vbRect:TRect;
begin
  if g_MyShopDlgItem.S.Name <> '' then begin
    with Sender as TDxImageButton do begin
      vbRect := VisibleRect;
      if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
        Exit;
      vtRect := VirtualRect;

      // 默认店铺绘制时不要外观发光特效 chongchong 2014-04-17
      DrawGridItem(vtRect, @g_MyShopDlgItem, @g_MyShopDlgItemEffect, False);
    end;
  end
  else if (g_SelectMyShopItem <> nil) then begin
    with Sender as TDxImageButton do begin
      vbRect := VisibleRect;
      if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
        Exit;
      vtRect := VirtualRect;

      // 默认店铺绘制时不要外观发光特效 chongchong 2014-04-17
