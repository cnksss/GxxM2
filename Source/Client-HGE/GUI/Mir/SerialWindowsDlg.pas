procedure TSerialWindows.DChatMemoKeyPress(Sender:TObject; var Key:Char);
begin
  if DScreen.CurrentScene = PlayScene then begin
    case byte(Key) of
      byte(' '), 13:begin
          ShowChatEdit();

          if BoGuildChat then begin
            DEdChat.Text := '!~';
            DEdChat.SelStart := Length(DEdChat.Text);
            DEdChat.SelLength := 0;
          end
          else begin
            DEdChat.Text := '';
          end;
        end;
      byte('@'), byte('!'), byte('/'):begin
          ShowChatEdit();

          if Key = '/' then begin
            if frmMain.WhisperName = '' then
              DEdChat.Text := Key
            else if Length(frmMain.WhisperName) > 2 then
              DEdChat.Text := '/' + frmMain.WhisperName + ' '
            else
              DEdChat.Text := Key;
            DEdChat.SelStart := Length(DEdChat.Text);
            DEdChat.SelLength := 0;
          end
          else begin
            DEdChat.Text := Key;
            DEdChat.SelStart := 1;
            DEdChat.SelLength := 0;
          end;
        end;
    end;
    Key := #0;
  end;
end;

