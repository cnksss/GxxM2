procedure TSerialWindows.DMinMapDlgExPaint(Sender:TObject);
{$J+}
//声明静态变量
const
  DrawSelfRect:Boolean = False;
  LastUpdateTime:LongWord = 0;
  {$J-}
const
  INDEX_MONSTER = 1650; // 怪物
  INDEX_NPC = 1651; // NPC
  INDEX_GUARD = 1652; // 守卫
  INDEX_OTHER_PLAY = 1653; // 其他玩家
  INDEX_HERO = 1654; // 自己英雄
  INDEX_BOSS = 1655; // BOSS
  INDEX_SELF = 1656; // 自己
var
  vtRect:TRect;
  MapRect, PaintRect:TRect;
  nX, nY:Integer;
  nMapX, nMapY:Integer;
  nTempX, nTempY:Integer;
  Actor:TActor;
  Index:Integer;
  sText:string;
  I:Integer;
  MapDescInfo:pTMapDescInfo;
  DescList:TList;
  nMinX, nMinY, nMaxX, nMaxY:Integer;
  srcBits:Pointer;
  srcPitch:Integer;
  srcPoint:PInteger;
  DrawAreaRect:TRect;
  D:TTexture;
begin
  if g_MySelf = nil then
    Exit;

  if (g_nMiniMapIndex < 0) then begin
    Exit;
  end;

  if (g_nMiniMapIndex <> FMiniMapLoadIndex) or (MyGetTickCount - FMiniMapLoadSurfaceTime >= 2 * 1000) then begin
    // 修复小地图错误 chongchong 2015-01-05
    { TODO -c修正 -ochongchong : 小地图扩展再修改 【2013-4-23】}
    case g_nMiniMapIndex of
      9900..9999:
        FMiniMapSurface := g_WBmpMapImages.Images[g_nMiniMapIndex - 9900]; // 预留
      // mmap10.wil从10001-15000开始
      10000..14999:
        FMiniMapSurface := g_WMMapImages10.Images[g_nMiniMapIndex - 10000];

      // mmap11.wil从15001-20000开始
      15000..19999:
        FMiniMapSurface := g_WMMapImages11.Images[g_nMiniMapIndex - 15000];

      // mmap12.wil从20001-24999开始
      20000..24999:
        FMiniMapSurface := g_WMMapImages12.Images[g_nMiniMapIndex - 20000];
      else
        FMiniMapSurface := g_WMMapImages.Images[g_nMiniMapIndex];
    end;

    if FMiniMapSurface <> nil then begin
      FMiniMapLoadIndex := g_nMiniMapIndex;
      FMiniMapLoadSurfaceTime := MyGetTickCount;
      // 修复小地图有透明区域 chongchong 2015-10-30
      if FMiniMapSurface.Lock(srcBits, srcPitch, True) then begin
        try
          for nY := 0 to FMiniMapSurface.Height - 1 do begin
            for nX := 0 to FMiniMapSurface.Width - 1 do begin
              srcPoint := PInteger(Integer(srcBits) + srcPitch * nY + nX shl 2);
              srcPoint^ := Cardinal(srcPoint^) or $FF000000; //HZQ 20230520 srcPoint^ or $FF000000;
            end;
          end;
        finally
          FMiniMapSurface.Unlock;
        end;
      end;
    end;
  end;

  if (FMiniMapSurface = nil) then begin
    DlblMinMapExName.Caption := g_sMapTitle;
    DlblMinMapExPos.Caption := IntToStr(g_MySelf.m_nCurrX) + ':' + IntToStr(g_MySelf.m_nCurrY);
    Exit;
  end;

  vtRect := DMinMapExDrawArea.VirtualRect;

  ActorXYToMapXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
  MapRect := Bounds(_Max(0, nX - DMinMapExDrawArea.Width div 2), _Max(0, nY - DMinMapExDrawArea.Height div 2), DMinMapExDrawArea.Width, DMinMapExDrawArea.Height);

  GameCanvas.Draw(vtRect.Left, vtRect.Top, MapRect, FMiniMapSurface); //HZQ 20230529 小地图绘制并未处理圆形区域的边角镂空

  DrawAreaRect := DMinMapExDrawArea.VirtualRect;

  // 加入小地图寻路功能 2019-05-17 11:47:26
  if g_ClientConfig.boMinMapUseFindPath and (Length(LegendMap.RunPath) > 0) then begin
    for I := 0 to Length(LegendMap.RunPath) - 1 do begin
      ActorXYToMapXY(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y, nMapX, nMapY);

      nMapX := nMapX - MapRect.Left;
      nMapY := nMapY - MapRect.Top;

      nX := vtRect.Left + nMapX;
      nY := vtRect.Top + nMapY;

      if PtInRect(DrawAreaRect, Point(nX, nY)) then begin
        PaintRect := Bounds(nX - 1, nY - 1, 2, 2);
        GameCanvas.FillRect(PaintRect, clRed);
      end;
    end;
  end;

  // 只有及时雨判断这个选项
  if g_ConfigDlg.ConfigCheckeds[ckShowRadarPlayer] or g_ConfigDlg.ConfigCheckeds[ckShowRadarNpc] or g_ConfigDlg.ConfigCheckeds[ckShowRadarAttackNpc] or g_ConfigDlg.ConfigCheckeds[ckShowRadarActor] or (g_ConfigDlg is TMirConfigDlg) then begin
    for nX := g_MySelf.m_nCurrX - 12 to g_MySelf.m_nCurrX + 12 do begin
      for nY := g_MySelf.m_nCurrY - 12 to g_MySelf.m_nCurrY + 12 do begin
        Actor := PlayScene.FindActorXY(nX, nY);
        if (Actor <> nil) and (g_MySelf <> Actor) and (not Actor.m_boDeath) then begin
          ActorXYToMapXY(Actor.m_nCurrX, Actor.m_nCurrY, nMapX, nMapY);
          nMapX := nMapX - MapRect.Left;
          nMapY := nMapY - MapRect.Top;

          if (Actor is TNpcActor) then // 系统NPC
            Index := INDEX_NPC
          else if Actor.ClassType = THumActor then // 其他玩家
            Index := INDEX_OTHER_PLAY
          else if Actor.ClassType = THeroActor then {// 英雄}  begin
            if Actor = g_MyHero then
              Index := INDEX_HERO // 自己英雄的颜色
            else
              Index := INDEX_OTHER_PLAY; // 其他玩家英雄的颜色和玩家一样
          end
          else begin
            case Actor.m_btRealRace of
              RC_PLAYOBJECT: // 玩家
                Index := INDEX_OTHER_PLAY;
              55, // 练功师
              RC_PEACENPC, RC_ANIMAL:
                Index := INDEX_NPC;
              RC_GUARD, // 弓箭手
              RC_ARCHERGUARD: // 大刀守卫
                Index := INDEX_GUARD;
              else begin
                  if g_BossList.IndexOf(Actor.m_sUserName) >= 0 then
                    Index := INDEX_BOSS
                  else
                    Index := INDEX_MONSTER;
                end;
            end;
          end;

          if (g_MyHero <> nil) and (g_MyHero = Actor) then
            Index := INDEX_HERO;

          if
            // ---------玩家
          ((Actor.m_btRace in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarPlayer] or (g_ConfigDlg is TMirConfigDlg))) or
            // ---------特殊npc (和平npc)
          ((Actor.m_btRace in [RC_ANIMAL, 55]) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarNpc] or (g_ConfigDlg is TMirConfigDlg))) or
            // --------攻击npc
          (((Actor.m_btRace = RC_PEACENPC) or (Actor.m_btRealRace in [RC_GUARD {弓箭手}, RC_ARCHERGUARD {大刀}])) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarAttackNpc] or (g_ConfigDlg is TMirConfigDlg))) or
            // ---------怪物
          ((not (Actor.m_btRace in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PEACENPC, RC_ANIMAL, 55])) and (not (Actor.m_btRealRace in [RC_GUARD {弓箭手}, RC_ARCHERGUARD {大刀}])) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarActor] or (g_ConfigDlg is TMirConfigDlg))) then begin
            if (not g_ClientConfig.boMinMapCloseRadar) and (Index >= 0) then begin
              D := g_WNewopUIImages.Images[Index];

              if D <> nil then begin
                nTempX := vtRect.Left + nMapX - D.Width div 2;
                nTempY := vtRect.Top + nMapY - D.Height div 2;

                GameCanvas.Draw(nTempX, nTempY, D);
              end;
            end;
          end;

        end;
      end;
    end;
  end;

  // 画自己所在区域 chongchogn 2015-09-05
  if g_clientconfig.dwMinMapFlagFlash < 200 then begin
    if not DrawSelfRect then begin
      DrawSelfRect := True;
    end;
  end
  else if MyGetTickCount - LastUpdateTime >= g_clientconfig.dwMinMapFlagFlash then begin
    DrawSelfRect := not DrawSelfRect;
    LastUpdateTime := MyGetTickCount;
  end;

  if DrawSelfRect then begin
    ActorXYToMapXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nMapX, nMapY);
    nMapX := nMapX - MapRect.Left;
    nMapY := nMapY - MapRect.Top;

    D := g_WNewopUIImages.Images[INDEX_SELF];

    if D <> nil then begin
      nTempX := vtRect.Left + nMapX - D.Width div 2;
      nTempY := vtRect.Top + nMapY - D.Height div 2;

      GameCanvas.Draw(nTempX, nTempY, D);
    end;
  end;

  if g_ConfigDlg.ConfigCheckeds[ckShowMapDesc] and g_MapDesc.Get(g_sMapTitle, False, DescList) and (DescList.Count > 0) then begin
    MapXYToActorXY(MapRect.Left, MapRect.Top, nMinX, nMinY);
    MapXYToActorXY(MapRect.Right, MapRect.Bottom, nMaxX, nMaxY);
    for I := 0 to DescList.Count - 1 do begin
      MapDescInfo := DescList[I];
      if (MapDescInfo.nX >= nMinX) and (MapDescInfo.nX <= nMaxX) and (MapDescInfo.nY >= nMinY) and (MapDescInfo.nY <= nMaxY) then begin
        ActorXYToMapXY(MapDescInfo.nX, MapDescInfo.nY, nMapX, nMapY);
        nMapX := nMapX - MapRect.Left;
        nMapY := nMapY - MapRect.Top;
        sText := MapDescInfo.sDescName;
        nX := _Max(vtRect.Left, vtRect.Left + nMapX - CurrentFont.TextWidth(sText) div 2);
        nY := _Max(vtRect.Top, vtRect.Top + nMapY);
        if nX + CurrentFont.TextWidth(sText) > vtRect.Right then
          nX := vtRect.Right - CurrentFont.TextWidth(sText);
        if nY + g_CurrentFontHeight > vtRect.Bottom then
          nY := vtRect.Bottom - g_CurrentFontHeight;
        BoldTextOut(nX, nY, sText, MapDescInfo.FColor);
      end;
    end;
  end;

  DlblMinMapExName.Caption := g_sMapTitle;

  DlblMinMapExPos.Caption := IntToStr(g_MySelf.m_nCurrX) + ':' + IntToStr(g_MySelf.m_nCurrY);
end;

procedure TSerialWindows.DMinMapDlgExMouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer); stdcall;
var
  nX, nY, nMapX, nMapY:Integer;
  vtRect, MapRect:TRect;
  d:TTexture;
begin
  if g_nMiniMapIndex < 0 then
    Exit;
  if not g_ClientConfig.boMinMapUseFindPath then
    Exit;

  if not PtInRect(DMinMapExDrawArea.VirtualRect, Point(X, Y)) then
    Exit;

  // 加入小地图寻路功能 2019-05-17 11:47:26
  if (g_MySelf <> nil) and (not g_MySelf.m_boDeath) then begin
    { TODO -c修正 -ochongchong : 小地图扩展再修改 【2013-4-23】}
    case g_nMiniMapIndex of
      9900..9999:
        d := g_WBmpMapImages.Images[g_nMiniMapIndex - 9900]; // 预留
      // mmap10.wil从10001-15000开始
      10000..14999:
        d := g_WMMapImages10.Images[g_nMiniMapIndex - 10000];

      // mmap11.wil从15001-20000开始
      15000..19999:
        d := g_WMMapImages11.Images[g_nMiniMapIndex - 15000];

      // mmap12.wil从20001-24999开始
      20000..24999:
        d := g_WMMapImages12.Images[g_nMiniMapIndex - 20000];

      else
        d := g_WMMapImages.Images[g_nMiniMapIndex];
    end;

    if (d = nil) then
      Exit;

    vtRect := DMinMapExDrawArea.VirtualRect;
    ActorXYToMapXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
    MapRect := Bounds(_Max(0, nX - DMinMapExDrawArea.Width div 2), _Max(0, nY - DMinMapExDrawArea.Height div 2), DMinMapExDrawArea.Width, DMinMapExDrawArea.Height);

    if Button = mbLeft then begin
      if (abs(g_MySelf.m_nCurrX - nX) <= 1) and (abs(g_MySelf.m_nCurrY - nY) <= 1) then begin
        LegendMap.Stop;
      end
      else begin
        if LegendMap.StartFind then begin
          if (LegendMap.EndX <> nX) or (LegendMap.EndY <> nY) then begin
            LegendMap.Stop;
          end
          else
            Exit;
        end;
        LegendMap.Stop;

        nMapX := (X - vtRect.Left + MapRect.Left);
        nMapY := (Y - vtRect.Top + MapRect.Top);
        MapXYToActorXY(nMapX, nMapY, nX, nY);

        frmMain.SendClientMessage(CM_AUTOFINDPATHINFO, 0, 0, 0, 1, '');
        DScreen.AddChatBoardString(Format(DecodeResStr(SFindPathHint), [nX, nY]), GetRGB(154), clWhite);

        LegendMap.BeginX := g_MySelf.m_nCurrX;
        LegendMap.BeginY := g_MySelf.m_nCurrY;
        LegendMap.EndX := nX;
        LegendMap.EndY := nY;
      end;
    end;
  end;
end;

