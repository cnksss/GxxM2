procedure TSerialWindows.RefreshAdjustAbilityValue;

  procedure AdjustAb2(Abil:Integer; Val:Word; var lov, hiv:Word);
  var
    Lo, Hi:byte;
    I:Integer;
  begin
    Lo := LoWord(Abil);
    Hi := HiWord(Abil);
    lov := 0;
    hiv := 0;
    for I := 1 to Val do begin
      if Lo + 1 < Hi then begin
        Inc(Lo);
        Inc(lov);
      end
      else begin
        Inc(Hi);
        Inc(hiv);
      end;
    end;
  end;

var
  adc, amc, asc, aac, amac:Integer;
  ldc, lmc, lsc, lac, lmac, hdc, hmc, hsc, hac, hmac:Word;
begin
  if not DAdjustAbility.Visible then
    Exit;

  adc := (g_BonusAbilChg.DC + g_BonusAbil.DC) div g_BonusTick.DC;
  amc := (g_BonusAbilChg.MC + g_BonusAbil.MC) div g_BonusTick.MC;
  asc := (g_BonusAbilChg.SC + g_BonusAbil.SC) div g_BonusTick.SC;
  aac := (g_BonusAbilChg.AC + g_BonusAbil.AC) div g_BonusTick.AC;
  amac := (g_BonusAbilChg.MAC + g_BonusAbil.MAC) div g_BonusTick.MAC;

  AdjustAb2(g_NakedAbil.DC, adc, ldc, hdc);
  AdjustAb2(g_NakedAbil.MC, amc, lmc, hmc);
  AdjustAb2(g_NakedAbil.SC, asc, lsc, hsc);
  AdjustAb2(g_NakedAbil.AC, aac, lac, hac);
  AdjustAb2(g_NakedAbil.MAC, amac, lmac, hmac);

  DLblAdjustedDC.Caption := IntToStr(g_Self_Abil_NoBouns.DC1 + ldc) + '-' + IntToStr(g_Self_Abil_NoBouns.DC2 + hdc);
  DLblAdjustedMC.Caption := IntToStr(g_Self_Abil_NoBouns.MC1 + lmc) + '-' + IntToStr(g_Self_Abil_NoBouns.MC2 + hmc);
  DLblAdjustedSC.Caption := IntToStr(g_Self_Abil_NoBouns.SC1 + lsc) + '-' + IntToStr(g_Self_Abil_NoBouns.SC2 + hsc);
  DLblAdjustedAC.Caption := IntToStr(g_Self_Abil_NoBouns.AC1 + lac) + '-' + IntToStr(g_Self_Abil_NoBouns.AC2 + hac);
  DLblAdjustedMAC.Caption := IntToStr(g_Self_Abil_NoBouns.MAC1 + lmac) + '-' + IntToStr(g_Self_Abil_NoBouns.MAC2 + hmac);

  DLblAdjustedHP.Caption := IntToStr(Integer(g_Self_Abil_NoBouns.MaxHP) + (g_BonusAbil.HP + g_BonusAbilChg.HP) div g_BonusTick.HP);
  DLblAdjustedMP.Caption := IntToStr(Integer(g_Self_Abil_NoBouns.MaxMP) + (g_BonusAbil.MP + g_BonusAbilChg.MP) div g_BonusTick.MP);

  DLblAdjustedHit.Caption := IntToStr(g_nNoBounsMyHitPoint {g_nMyHitPoint} + (g_BonusAbil.Hit + g_BonusAbilChg.Hit) div g_BonusTick.Hit);
  DLblAdjustedSpeed.Caption := IntToStr(g_nNoBounsMySpeedPoint {g_nMySpeedPoint} + (g_BonusAbil.Speed + g_BonusAbilChg.Speed) div g_BonusTick.Speed);
  DLblAdjustPoint.Caption := IntToStr(g_nBonusPoint);

  //---------------------------------------------------------------------------------------------------

  DLblAdjustDC.Caption := Format('%d/%d', [g_BonusAbilChg.DC + g_BonusAbil.DC, g_BonusTick.DC]);
  if g_BonusAbilChg.DC > 0 then begin
    DLblAdjustDC.CaptionColor.Up.Color := DLblAdjustDC.CaptionColor.Hot.Color;
  end
  else begin
