procedure TSerialWindows.ShowSayItemDlg(Item:PTClientItem; X, Y:Integer);
var
  HintWindowList:THintWindows;
  TzHintWindow, HintWindow:THintWindow;
  I:Integer;
  TzHintWindows:TList;
  nWidth, nHeight, nX, nY:Integer;
  ArrHintWindows:TArrHintWindows;
begin
  inherited;
  HintWindowList := FSayItemHintWin as THintWindows;
  HintWindowList.Finalize;

  TzHintWindows := GetTzItemHintWindowEx(0, g_MySelf.m_btSex, g_MySelf, Item, False);
  // 两列显示 piaoyun 2013-09-16
  if g_ClientConfig.boSingleHint and (TzHintWindows <> nil) then begin
    // 单列显示 piaoyun 2013-09-16
    if TzHintWindows <> nil then begin
      for I := 0 to TzHintWindows.Count - 1 do begin
        TzHintWindow := THintWindow(TzHintWindows.Items[I]);
        {$MESSAGE HINT '假设nX, nY 为 X, Y'}
        nX := X;
        nY := Y; //HZQ
        TzHintWindow.Show(nX, nY);
        HintWindowList.Add(TzHintWindow);
      end;
      TzHintWindows.Free;
    end;
  end else begin
    for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
      ArrHintWindows[I] := THintWindow.Create;
    end;

    FrmDlg.GetMouseItemInfo(g_MySelf, Item, False, ArrHintWindows);

    for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
      HintWindow := THintWindow(ArrHintWindows[I]);
      HintWindow.Show(0, 0);
      if HintWindow.Count > 0 then
        HintWindowList.Add(HintWindow)
      else
        HintWindow.Free;
    end;

    if not g_ClientConfig.boTZSupportRenameItem then
      TzHintWindows := GetTzItemHintWindow(0, g_MySelf.m_btSex, Item.s.DBName)
    else
      TzHintWindows := GetTzItemHintWindow(0, g_MySelf.m_btSex, Item.s.Name);

    if TzHintWindows <> nil then begin
      for I := 0 to TzHintWindows.Count - 1 do begin
        TzHintWindow := THintWindow(TzHintWindows.Items[I]);
        TzHintWindow.Show(0, 0);
        HintWindowList.Add(TzHintWindow);
      end;

      TzHintWindows.Free;
    end;
  end;

  // 重算所有提示窗口的位置
  nWidth := 0;
  nHeight := 0;

  for I := 0 to HintWindowList.Count - 1 do begin
    HintWindow := THintWindow(HintWindowList.Items[I]);

    if (not g_ConfigClient.boChatSayItemHideClose) and (I = HintWindowList.Count - 1) then
      HintWindow.Width := HintWindow.Width + 20
    else
      HintWindow.Width := HintWindow.Width;

    nWidth := nWidth + HintWindow.Width;
    nHeight := Max(HintWindow.Height, nHeight);
  end;

  nX := X;
  nY := Y - nHeight;

  if nX + nWidth > SCREENWIDTH then
    nX := SCREENWIDTH - nWidth;

  if nY + nHeight > SCREENHEIGHT then
    nY := SCREENHEIGHT - nHeight;

  if nX < 0 then
    nX := 0;
  if nY < 0 then
    nY := 0;

  DSayItemDlg.Left := nX;
  DSayItemDlg.Top := nY;

  DSayItemDlg.Width := nWidth;
  DSayItemDlg.Height := nHeight;

  for I := 0 to HintWindowList.Count - 1 do begin
    HintWindow := THintWindow(HintWindowList.Items[I]);
    HintWindow.X := nX;
    HintWindow.Y := nY;
    Inc(nX, HintWindow.Width);
  end;

  DSayItemDlgClose.Left := DSayItemDlg.Width - DSayItemDlgClose.Width - 1;
  DSayItemDlgClose.Top := 5;

  nSayItemMakeIndex := Item.MakeIndex;
  DSayItemDlg.Visible := True;
  DSayItemDlg.BringToFront;
  boSayItemDlgMoveOutClose := False;
end;

