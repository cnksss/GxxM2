procedure TSerialWindows.DMinMapBigDlgPaint(Sender:TObject);
{$J+}
const
  IsShowSelfRadar:Boolean = False;
const
  ShowSelfRadarTick:LongWord = 0;
  {$J-}
var
  vtRect:TRect;
  MapRect:TRect;
  PaintRect:TRect;
  nX, nY:Integer;
  nMapX, nMapY:Integer;
  d {, D2}:TTexture;
  Actor:TActor;
  Color:TColor;
  sText:string;
  I:Integer;
  MapDescInfo:pTMapDescInfo;
  DescList:TList;
begin
  vtRect := DMinMapBigDlg.VirtualRect;
  GameCanvas.FillRect(vtRect, clBlack);
  if g_MySelf = nil then
    Exit;
  if g_nMiniMapIndex < 0 then begin
    {
    if (g_ClientVersion = cvMirNewUI205) or g_ConfigClient.boCustomUI then
      DLabelMinMapName.Caption := g_sMapTitle
    else
      DLabelMinMapName.Caption := '';
    }

    DLabelMinMapName.Caption := g_sMapTitle;

    sText := IntToStr(g_MySelf.m_nCurrX) + ':' + IntToStr(g_MySelf.m_nCurrY);
    DLabelMinMapPosition.Caption := sText;

    Exit;
  end;

  { TODO -ochongchong -c修改 : 地图扩展二次修改 }
  case g_nMiniMapIndex of
    9900..9999:
      d := g_WBmpMapImages.Images[g_nMiniMapIndex - 9900]; // 预留
    // mmap10.wil从10001-15000开始
    10000..14999:
      d := g_WMMapImages10.Images[g_nMiniMapIndex - 10000];

    // mmap11.wil从15001-20000开始
    15000..19999:
      d := g_WMMapImages11.Images[g_nMiniMapIndex - 15000];

    // mmap12.wil从20001-24999开始
    20000..24999:
      d := g_WMMapImages12.Images[g_nMiniMapIndex - 20000];
    else
      d := g_WMMapImages.Images[g_nMiniMapIndex];
  end;

  if (d = nil) then begin
    DLabelMinMapName.Caption := g_sMapTitle;

    sText := IntToStr(g_MySelf.m_nCurrX) + ':' + IntToStr(g_MySelf.m_nCurrY);
    DLabelMinMapPosition.Caption := sText;

    Exit;
  end;

  with DMinMapBigDlg do begin
    vtRect := DMinMapBigDlg.VirtualRect;
    g_nMapWidth := d.Width;
    g_nMapHeight := d.Height;
    MapTextureWidth := d.Width;
    MapTextureHeight := d.Height;
    MapRect := vtRect;
    GameCanvas.StretchDraw(MapRect, d.ClientRect, d, -1);

    // 挂机状态不显示寻路路径 chongchong 2015-09-05
    if (Length(LegendMap.RunPath) > 0) {and (not g_boGJRun)} then begin
      for I := 0 to Length(LegendMap.RunPath) - 1 do begin
        ActorXYToMapXY(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y, nMapX, nMapY);
        MapToScreen(d.Width, MapRect.Right - MapRect.Left, nMapX, nMapX);
        MapToScreen(d.Height, MapRect.Bottom - MapRect.Top, nMapY, nMapY);
        PaintRect := Bounds(vtRect.Left + nMapX - 1, vtRect.Top + nMapY - 1, 2, 2);
        GameCanvas.FillRect(PaintRect, clRed);
      end;
    end;

    if g_ConfigDlg.ConfigCheckeds[ckShowRadarPlayer] or g_ConfigDlg.ConfigCheckeds[ckShowRadarNpc] or g_ConfigDlg.ConfigCheckeds[ckShowRadarAttackNpc] or g_ConfigDlg.ConfigCheckeds[ckShowRadarActor] or (g_ConfigDlg is TMirConfigDlg) then begin
      for nX := g_MySelf.m_nCurrX - 12 to g_MySelf.m_nCurrX + 12 do begin
        for nY := g_MySelf.m_nCurrY - 12 to g_MySelf.m_nCurrY + 12 do begin
          Actor := PlayScene.FindActorXY(nX, nY);
          if (Actor <> nil) and (g_MySelf <> Actor) and (not Actor.m_boDeath) then begin
            ActorXYToMapXY(Actor.m_nCurrX, Actor.m_nCurrY, nMapX, nMapY);
            MapToScreen(d.Width, MapRect.Right - MapRect.Left, nMapX, nMapX);
            MapToScreen(d.Height, MapRect.Bottom - MapRect.Top, nMapY, nMapY);

            { TODO -ochongchong -c修改 : 修改小地图雷达 人怪 npc颜色【2013-07-19】 }
            {
            case Actor.m_btRace of
              45, RC_PEACENPC: Color := clLime; // clLime;    //和平NPC
              RC_ANIMAL: Color := clRed;        // 攻击NPC
              // , , 50, 45, 12: Color := clLime; //clLime;
              0: Color := clYellow;
            else
              Color := clRed;                   // clRed;
            end;
            }
            if (Actor is TNpcActor) then // 系统NPC
              Color := GetRGB(g_ClientConfig.btMinMapColorNPC)
            else if Actor.ClassType = THumActor then // 其他玩家
              Color := GetRGB(g_ClientConfig.btMinMapColorOther)
            else if Actor.ClassType = THeroActor then {// 英雄}  begin
              if Actor = g_MyHero then
                Color := GetRGB(g_ClientConfig.btMinMapColorHero) // 自己英雄的颜色
              else
                Color := GetRGB(g_ClientConfig.btMinMapColorOther); // 其他玩家英雄的颜色和玩家一样
            end
            else begin
              case Actor.m_btRealRace of
                RC_PLAYOBJECT: // 玩家
                  Color := GetRGB(g_ClientConfig.btMinMapColorOther);

                55, // 练功师
                RC_PEACENPC, RC_ANIMAL:
                  Color := GetRGB(g_ClientConfig.btMinMapColorNPC);

                RC_GUARD, RC_ARCHERGUARD: // 弓箭手,大刀守卫
                  Color := GetRGB(g_ClientConfig.btMinMapColorGuard);
                else begin
                    if g_BossList.IndexOf(Actor.m_sUserName) >= 0 then
                      Color := GetRGB(g_ClientConfig.btMinMapColorBoss)
                    else
                      Color := GetRGB(g_ClientConfig.btMinMapColorMonster);
                  end;
              end;
            end;

            if
              // ---------玩家
            ((Actor.m_btRace in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarPlayer] or (g_ConfigDlg is TMirConfigDlg))) or
              // ---------特殊npc (和平npc)
            ((Actor.m_btRace in [RC_ANIMAL, 55]) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarNpc] or (g_ConfigDlg is TMirConfigDlg))) or
              // --------攻击npc
            (((Actor.m_btRace = RC_PEACENPC) or (Actor.m_btRealRace in [RC_GUARD {弓箭手}, RC_ARCHERGUARD {大刀}])) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarAttackNpc] or (g_ConfigDlg is TMirConfigDlg))) or
              // ---------怪物
            ((not (Actor.m_btRace in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PEACENPC, RC_ANIMAL, 55])) and (not (Actor.m_btRealRace in [RC_GUARD {弓箭手}, RC_ARCHERGUARD {大刀}])) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarActor] or (g_ConfigDlg is TMirConfigDlg))) then begin
              if (g_MyHero <> nil) and (g_MyHero = Actor) then
                Color := GetRGB(g_ClientConfig.btMinMapColorHero);

              { TODO -ochongchong -c添加 : 修改小地图雷达 人怪 npc颜色 【2013-07-19】 }
              {
                PaintRect := Bounds(vtRect.Left + nMapX - 2, vtRect.Top + nMapY - 2, 4, 4);
                GameCanvas.FillRect(PaintRect, Color);
              }
              if (not g_ClientConfig.boMinMapCloseRadar) then begin
                PaintRect := Bounds(vtRect.Left + nMapX - 2, vtRect.Top + nMapY - 2, 4, 4);
                GameCanvas.FillRect(PaintRect, Color);
              end;
            end;

          end;
        end;
      end;
    end;

    ActorXYToMapXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nMapX, nMapY);
    MapToScreen(d.Width, MapRect.Right - MapRect.Left, nMapX, nMapX);
    MapToScreen(d.Height, MapRect.Bottom - MapRect.Top, nMapY, nMapY);

    if g_clientconfig.dwMinMapFlagFlash < 200 then
      IsShowSelfRadar := True
    else if tick_diff(ShowSelfRadarTick, MyGetTickCount) >= g_clientconfig.dwMinMapFlagFlash then begin
      IsShowSelfRadar := not IsShowSelfRadar;
      ShowSelfRadarTick := MyGetTickCount;
    end;

    { TODO -ochongchong -c添加 : 小地图中人物矩形闪烁效果 【2013-07-18】 }
    if IsShowSelfRadar then begin
      PaintRect := Bounds(vtRect.Left + nMapX - 2, vtRect.Top + nMapY - 2, 4, 4);
      GameCanvas.FillRect(PaintRect, GetRGB(g_ClientConfig.btMinMapColorSelf));
    end;

    if g_ConfigDlg.ConfigCheckeds[ckShowMapDesc] then begin
      if g_MapDesc.Get(g_sMapTitle, True, DescList) and (DescList.Count > 0) then begin
        for I := 0 to DescList.Count - 1 do begin
          MapDescInfo := DescList[I];
          ActorXYToMapXY(MapDescInfo.nX, MapDescInfo.nY, nMapX, nMapY);
          MapToScreen(d.Width, Width, nMapX, nMapX);
          MapToScreen(d.Height, Height, nMapY, nMapY);
          sText := MapDescInfo.sDescName;

          nX := _Max(vtRect.Left, vtRect.Left + nMapX - CurrentFont.TextWidth(sText) div 2);
          nY := _Max(vtRect.Top, vtRect.Top + nMapY);
          if nX + CurrentFont.TextWidth(sText) > vtRect.Right then
            nX := vtRect.Right - CurrentFont.TextWidth(sText);
          if nY + g_CurrentFontHeight > vtRect.Bottom then
            nY := vtRect.Bottom - g_CurrentFontHeight;
          BoldTextOut(nX, nY, sText, MapDescInfo.FColor);
        end;
      end;
    end;

    {
    if (g_ClientVersion = cvMirNewUI205) or g_ConfigClient.boCustomUI then
      DLabelMinMapName.Caption := g_sMapTitle
    else
      DLabelMinMapName.Caption := '';
    }
    DLabelMinMapName.Caption := g_sMapTitle;

    if ShowMiniBigMapXY then begin
      nMapX := Round((BigMinMapX - MapRect.Left) * d.Width / Width);
      nMapY := Round((BigMinMapY - MapRect.Top) * d.Height / Height);

      MapXYToActorXY(nMapX, nMapY, nMapX, nMapY);
      sText := IntToStr(nMapX) + ':' + IntToStr(nMapY);
      DLabelMinMapPosition.Caption := sText;
    end
    else {if (g_ClientVersion = cvMirNewUI205) then}  begin
      sText := IntToStr(g_MySelf.m_nCurrX) + ':' + IntToStr(g_MySelf.m_nCurrY);
      DLabelMinMapPosition.Caption := sText;
    end;
  end;
end;

