procedure TSerialWindows.CloseDMerchantDlg;
var
  I:Integer;
  IsFound:Boolean;
begin

  // add chongchong 2014-04-27
  DMerchantDlg.Visible := False; //HZQ 关闭对话框    

  if not g_ClientConfig.boHeroStateDlgNoMove then begin
    if (DHeroStateDlg185 <> nil) and DHeroStateDlg185.Visible then
      DHeroStateDlg185.Left := 0;

    if (DHeroStateDlg <> nil) and DHeroStateDlg.Visible then
      DHeroStateDlg.Left := 0;
  end;

  frmMain.CancelUpgradeItem(0, False);
  frmMain.boNpcDlgCanMove := False;

  // 关闭自定义大对话框时，还原背包位置 chongchong 2017-09-29
  DItemBag.Left := 0;
  DItemBag.Top := 90;

  IsFound := False;
  for I := Low(g_ItemBoxItems) to High(g_ItemBoxItems) do begin
    if g_ItemBoxItems[I].S.Name <> '' then begin
      AddItemBag(g_ItemBoxItems[I]);
      IsFound := True;
    end;
  end;

  if IsFound then begin
    FillChar(g_ItemBoxItems, SizeOf(g_ItemBoxItems), #0);
    frmMain.SendClearItemBox;
  end;
end;

procedure TSerialWindows.OpenDMenuDlg(IsTrading:Boolean);
var
  Count:Integer;
begin
  menuindex := -1;
  MenuTop := 0;

  if not IsTrading then begin
    DMerchantDlg.Left := 0;
    DMerchantDlg.Top := 0;
    DMerchantDlg.Visible := True;

    DSellDlg.Visible := False;
    DMenuDlg.Left := 0;
    DMenuDlg.Top := 176;
    DMenuDlg.Visible := True;

    DItemBag.Left := SCREENWIDTH - DItemBag.Width - 10;
    DItemBag.Top := 90;
    DItemBag.Visible := True;
    DItemGrid.BringToFront;

    if (not g_ClientConfig.boHeroStateDlgNoMove) then begin
      if (DHeroStateDlg185 <> nil) and DHeroStateDlg185.Visible then
        DHeroStateDlg185.Left := DMerchantDlg.Width;

      if (DHeroStateDlg <> nil) and DHeroStateDlg.Visible then
        DHeroStateDlg.Left := DMerchantDlg.Width;
    end;
  end
  else begin
    if not g_ConfigClient.boCustomUI then {// 修正自定义UI下，交易市场看不到 2020-03-23 15:42:31}  begin
      DTradingMarketDlg.Left := (SCREENWIDTH - DTradingMarketDlg.Width) div 2 - 30;
      DTradingMarketDlg.Top := 10;
    end
    else begin
      if DTradingMarketDlg.Left + DTradingMarketDlg.Width + DTradingMarketItemsDlg.Width > SCREENWIDTH then begin
        DTradingMarketDlg.Left := SCREENWIDTH - DTradingMarketDlg.Width - DTradingMarketItemsDlg.Width;
      end;

      if DTradingMarketDlg.Top + DTradingMarketDlg.Height > SCREENHEIGHT then begin
        DTradingMarketDlg.Top := 10;
      end;
    end;

    DTradingMarketDlg.Visible := True;

    Count := DTradingMarketBuyGroup.RowCount * DTradingMarketBuyGroup.ColCount;
    DTradingMarketBuyGroupCount.Caption := Format('%d/%d', [1, (MenuList.Count + Count - 1) div Count]);

    // RecallTradingSellPrices;
  end;
  LastestClickTime := MyGetTickCount;
end;

