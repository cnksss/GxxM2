        Exit;

      if (g_MovingItem.Index >= 0) and (g_MovingItem.Item.S.OverLap and 4 <> 0) and ((g_MovingItem.Item.S.Expand1 = SelIndex + 1) or (g_MovingItem.Item.S.Expand1 = 13)) then
