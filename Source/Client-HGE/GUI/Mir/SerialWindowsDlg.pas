procedure TSerialWindows.OnDKsHotKeyKeyDown(Sender:TObject; var Key:Word; Shift:TShiftState);

  function IsValidHotKey(Key:Word; shift:TShiftState):Boolean;
  begin
    Result := False;
    if Shift = [] then begin
      if (Key in [VK_F1..VK_F8]) then begin
        Result := True;
      end else if (Key >= Ord('A')) and (Key <= Ord('Z')) then begin
        if (Key <> Ord('Z')) and (Key <> Ord('T')) and (Key <> Ord('P')) and (Key <> Ord('M')) then begin
          Result := True;
        end;
      end;
    end else if Shift = [ssCtrl] then begin
      Result := (Key in [VK_F1..VK_F8])
    end
  end;

begin
  if (Shift = [ssCtrl]) and (Key = VK_CONTROL) then Exit;

  //if not (((Shift = []) or (Shift = [ssCtrl])) and (Key in [VK_F1..VK_F8]) or ((Shift = []) and (Key >= Ord('A')) and (Key <= Ord('Z')) and (not (Key in [Ord('Z'), Ord('T'), Ord('P'), Ord('G'), Ord('M')])))
  //    or ((Shift = []) and (Key >= Ord('a')) and (Key <= Ord('z')) and (not (Key in [Ord('z'), Ord('t'), Ord('p'), Ord('g'), Ord('m')])))) then begin
  if not IsValidHotKey(Key, Shift) then begin
    DLabelMagKeyFail.Visible := True;
    UnCheckAllHotKeyButton;
    DKsNone.Checked := True;
    DKsHotKey.Caption := '';
    Exit;
  end;

  //Key不是Char 没有大小写的区别，也不存在VK_F1 = 'P'的问题// HZQ
  //if (Key >= Ord('a')) and (Key <= Ord('z')) then begin
  //  Key := Key - 32;
  //end;

  DLabelMagKeyFail.Visible := False;
  DKsHotKey.Caption := ConfigShare.GetKeyDownStr(Key, Shift, True);

  UnCheckAllHotKeyButton;

  if Shift = [] then begin
    case Key of
      VK_F1:
        DKsF1.Checked := True;
      VK_F2:
        DKsF2.Checked := True;
