      if frmMain.boNewLoginDlg then begin
         DNewLoginDlg.Visible := True;
         DNewLogin.Visible := False;
      end else begin
         DLoginDlg.Visible := True;
         DLogin.Visible := False;
      end;
      if not DUserCenterLoginDlg.Visible then begin
          InitUcLoginDlg();
          DUserCenterLoginDlg.Visible := True;
          DUcAccountEdit.SetFocus();
      end;
  end else begin
      if frmMain.boNewLoginDlg then begin
        DNewLoginDlg.Visible := True;
        DNewLogin.Visible := True;
      end else begin
        DLoginDlg.Visible := True;
        DLogin.Visible := True;
