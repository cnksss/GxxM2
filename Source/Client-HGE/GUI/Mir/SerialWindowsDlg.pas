procedure TSerialWindows.MagicBallStopPaint(Sender:TObject);
var
  d:TTexture;
  Abil:TAbility;
  dxCtrl:TDxMagicBall;
  PaintRect, vtRect:TRect;
  nWidth, nHeight:Integer;
begin
  if (g_MySelf = nil) then
    Exit;
  if not (Sender is TDxMagicBall) then
    Exit;

  dxCtrl := Sender as TDxMagicBall;
  Abil := g_MySelf.m_Abil;
  if (Abil.MaxHP <= 0) or (Abil.MaxMP <= 0) then
    Exit;

  vtRect := dxCtrl.VirtualRect;
  { 绘制魔法球特效 chongchogn 2013-11-18 }

  if dxCtrl.BallType in [mbtHPMP, mbtHP] then begin
    if (g_HPMagicBallEffectInfo.ShowTime <> 0) and ((g_HPMagicBallEffectInfo.ShowTime < 0)
      or (MyGetTickCount - g_HPMagicBallEffectInfo.StarTick <= Cardinal(g_HPMagicBallEffectInfo.ShowTime * 1000)))
      and (g_HPMagicBallEffectInfo.FileIndex >= 0) and (g_HPMagicBallEffectInfo.FileIndex < g_EffectImageList.Count)
      and (g_HPMagicBallEffectInfo.ImageIndex >= 0) and (g_HPMagicBallEffectInfo.ImageCount > 0) then begin
      d := TGameImages(g_EffectImageList.Objects[g_HPMagicBallEffectInfo.FileIndex]).Images[g_HPMagicBallEffectInfo.ImageIndex + g_HPMagicBallEffectInfo.FrameIndex];
      if d <> nil then begin
        PaintRect := d.ClientRect;
        nWidth := d.Width;
        nHeight := d.Height;

        if g_HPMagicBallEffectInfo.DrawType = 1 then begin
          if dxCtrl.ValueAlignment in [mbaLeft, mbaRight] then begin
            nWidth := d.Width;
            nHeight := d.Height div 2;
            PaintRect.Bottom := nHeight - dxCtrl.OverallSetting.MiddleZoneWidth div 2;
          end
          else begin
            nWidth := d.Width div 2;
            nHeight := d.Height;
            PaintRect.Right := nWidth - dxCtrl.OverallSetting.MiddleZoneWidth div 2;
          end;
        end;

        if g_HPMagicBallEffectInfo.DrawHeigh = 1 then begin
          case dxCtrl.ValueAlignment of
            mbaLeft:
              PaintRect.Right := MAX(Round(nWidth / Abil.MaxHP * Abil.HP), 0);
            mbaRight:
              PaintRect.Left := MAX(Round(nWidth / Abil.MaxHP * MAX(Abil.MaxHP - Abil.HP, 0)), 0);
            mbaTop:
              PaintRect.Bottom := MAX(Round(nHeight / Abil.MaxHP * Abil.HP), 0);
            else //mbaBottom:
              PaintRect.Top := MAX(Round(nHeight / Abil.MaxHP * MAX(Abil.MaxHP - Abil.HP, 0)), 0);
          end;
        end;

        if g_HPMagicBallEffectInfo.IsNormalDraw then
          GameCanvas.Draw(vtRect.Left + (dxCtrl.Width - d.Width) div 2 + PaintRect.Left + g_HPMagicBallEffectInfo.OffsetX, vtRect.Top + (dxCtrl.Height - d.Height) div 2 + PaintRect.Top + g_HPMagicBallEffectInfo.OffsetY, PaintRect, d)
        else
          GameCanvas.DrawBlend(vtRect.Left + (dxCtrl.Width - d.Width) div 2 + PaintRect.Left + g_HPMagicBallEffectInfo.OffsetX, vtRect.Top + (dxCtrl.Height - d.Height) div 2 + PaintRect.Top + g_HPMagicBallEffectInfo.OffsetY, PaintRect, d);
      end;

      //HZQ 20230519 消除符号警告
      if MyGetTickCount - FHPMagicBallEffectTick >= Cardinal(g_HPMagicBallEffectInfo.FrameTime) then begin
        FHPMagicBallEffectTick := MyGetTickCount;
        Inc(g_HPMagicBallEffectInfo.FrameIndex);
        if g_HPMagicBallEffectInfo.FrameIndex >= g_HPMagicBallEffectInfo.ImageCount then
          g_HPMagicBallEffectInfo.FrameIndex := 0;
      end;
    end;
  end;

  if dxCtrl.BallType in [mbtHPMP, mbtMP] then begin
    //HZQ 20230519 消除符号警告
    if (g_MPMagicBallEffectInfo.ShowTime <> 0) and ((g_MPMagicBallEffectInfo.ShowTime < 0)
      or (MyGetTickCount - g_MPMagicBallEffectInfo.StarTick <= Cardinal(g_MPMagicBallEffectInfo.ShowTime * 1000)))
      and (g_MPMagicBallEffectInfo.FileIndex >= 0) and (g_MPMagicBallEffectInfo.FileIndex < g_EffectImageList.Count)
      and (g_MPMagicBallEffectInfo.ImageIndex >= 0) and (g_MPMagicBallEffectInfo.ImageCount > 0) then begin
      d := TGameImages(g_EffectImageList.Objects[g_MPMagicBallEffectInfo.FileIndex]).Images[g_MPMagicBallEffectInfo.ImageIndex + g_MPMagicBallEffectInfo.FrameIndex];
      if d <> nil then begin
        PaintRect := d.ClientRect;
        nWidth := d.Width;
        nHeight := d.Height;

        if g_MPMagicBallEffectInfo.DrawType = 1 then begin
          if dxCtrl.ValueAlignment in [mbaLeft, mbaRight] then begin
            nWidth := d.Width;
            nHeight := d.Height div 2;
            PaintRect.Top := nHeight + dxCtrl.OverallSetting.MiddleZoneWidth div 2;
          end
          else begin
            nWidth := d.Width div 2;
            nHeight := d.Height;
            PaintRect.Left := nWidth + dxCtrl.OverallSetting.MiddleZoneWidth div 2;
          end;
        end;

        if g_MPMagicBallEffectInfo.DrawHeigh = 1 then begin
          case dxCtrl.ValueAlignment of
            mbaLeft:
              PaintRect.Right := MAX(Round(nWidth / Abil.MaxMP * Abil.MP), 0);
            mbaRight:
              PaintRect.Left := MAX(Round(nWidth / Abil.MaxMP * MAX(Abil.MaxMP - Abil.MP, 0)), 0);
            mbaTop:
              PaintRect.Bottom := MAX(Round(nHeight / Abil.MaxMP * Abil.MP), 0);
            else //mbaBottom:
              PaintRect.Top := MAX(Round(nHeight / Abil.MaxMP * MAX(Abil.MaxMP - Abil.MP, 0)), 0);
          end;
        end;

        if g_MPMagicBallEffectInfo.IsNormalDraw then
          GameCanvas.Draw(vtRect.Left + (dxCtrl.Width - d.Width) div 2 + PaintRect.Left + g_MPMagicBallEffectInfo.OffsetX, vtRect.Top + (dxCtrl.Height - d.Height) div 2 + PaintRect.Top + g_MPMagicBallEffectInfo.OffsetY, PaintRect, d)
        else
          GameCanvas.DrawBlend(vtRect.Left + (dxCtrl.Width - d.Width) div 2 + PaintRect.Left + g_MPMagicBallEffectInfo.OffsetX, vtRect.Top + (dxCtrl.Height - d.Height) div 2 + PaintRect.Top + g_MPMagicBallEffectInfo.OffsetY, PaintRect, d);
      end;

      //HZQ 20230519 消除符号警告
      if MyGetTickCount - FMPMagicBallEffectTick >= Cardinal(g_MPMagicBallEffectInfo.FrameTime) then begin
        FMPMagicBallEffectTick := MyGetTickCount;
        Inc(g_MPMagicBallEffectInfo.FrameIndex);
        if g_MPMagicBallEffectInfo.FrameIndex >= g_MPMagicBallEffectInfo.ImageCount then
          g_MPMagicBallEffectInfo.FrameIndex := 0;
      end;
    end;
  end;
end;

procedure TSerialWindows.MainBottomDlgStartSubPaint(Sender:TObject);
var
  D:TTexture;
  R:TRect;
  sAttackMode:string;
  Abil:TAbility;
  nWidth:Integer;
begin
  if (g_ClientVersion <> cvMirNewUI205) and (not g_ConfigClient.boCustomUI) then begin
    R := DMainBottomDlg.GetRightRect;
    if not g_ClientConfig.DOpenHeroButton then begin
      D := g_WNewopUIImages.Images[4];
      if D <> nil then
        GameCanvas.Draw(R.Left + 25, R.Top + 104, D);

      if LabelDBottomAttackMode.Top <> SCREENHEIGHT - 140 then
        LabelDBottomAttackMode.Top := SCREENHEIGHT - 140;
    end
    else begin
      if LabelDBottomAttackMode.Top <> SCREENHEIGHT - 125 then
        LabelDBottomAttackMode.Top := SCREENHEIGHT - 125;

      // 单独控制副将英雄按钮显示 chongchong 2013-12-20
      if g_ClientConfig.boShowDeputyHeroButton then begin
        D := g_WMain3Images.Images[313];
        if D <> nil then
          GameCanvas.Draw(R.Left + 25, R.Top + 104, D);
      end;
    end;

    if not g_ClientConfig.DOpenShopButton then begin
      D := g_WNewopUIImages.Images[6];
      if D <> nil then begin
        R := DOpenShop.VisibleRect;
        R.Left := R.Left + (D.Width - DOpenShop.Width) div 2;
        R.Top := R.Top + (D.Height - DOpenShop.Height) div 2;
        R.Right := R.Left + D.Width;
        R.Bottom := R.Top + D.Height;

        GameCanvas.Draw(R.Left, R.Top, D);
      end;
    end;
  end;

  if LabelDBottomAttackMode.Visible then begin
    sAttackMode := '';
    if (g_MySelf <> nil) then begin
      if g_ClientVersion = cvMirNewUI205 then begin
        {$IF TESTMODE = 0}
        if (g_nAttactkMode in [HAM_ALL..HAM_NATION]) then begin
          sAttackMode := g_ConfigClient.sAttackModeTexts[Integer(g_nAttactkMode)];
        end;
        {$ELSE}
        case g_nAttactkMode of
          HAM_ALL:
            sAttackMode := '[全体攻击]';
          HAM_PEACE:
            sAttackMode := '[和平攻击]';
          HAM_DEAR:
            sAttackMode := '[夫妻攻击]';
          HAM_MASTER:
            sAttackMode := '[师徒攻击]';
          HAM_GROUP:
            sAttackMode := '[编组攻击]';
          HAM_GUILD:
            sAttackMode := '[行会攻击]';
          HAM_PKATTACK:
            sAttackMode := '[红名攻击]';
          HAM_NATION:
            sAttackMode := '[国家攻击]';
        end;
        {$IFEND}
      end else begin
        {$IF TESTMODE = 0}
        if (g_nAttactkMode in [HAM_ALL..HAM_NATION]) then begin
          sAttackMode := g_ConfigClient.sAttackModeTexts[Integer(g_nAttactkMode)];
        end;
        {$ELSE}
        case g_nAttactkMode of
          HAM_ALL:
            sAttackMode := '[全体攻击]';
          HAM_PEACE:
            sAttackMode := '[和平攻击]';
          HAM_DEAR:
            sAttackMode := '[夫妻攻击]';
          HAM_MASTER:
            sAttackMode := '[师徒攻击]';
          HAM_GROUP:
            sAttackMode := '[编组攻击]';
          HAM_GUILD:
            sAttackMode := '[行会攻击]';
          HAM_PKATTACK:
            sAttackMode := '[红名攻击]';
          HAM_NATION:
            sAttackMode := '[国家攻击]';
        end;
        {$IFEND}
      end;
    end;
    LabelDBottomAttackMode.Caption := sAttackMode;
  end;

  if LabelDBottomTime.Visible then
    LabelDBottomTime.Caption := FormatDateTime('hh:mm:ss', Time);

  if LabelGameGloryValue.Visible then
    LabelGameGloryValue.Caption := IntToStr(g_nGameGlory);

  if g_ConfigClient.boBottomLevelTextUseSystemDef then begin
    LabelDBottomLevel.Caption := '   ';
    if LabelDBottomLevel.Visible and (g_MySelf <> nil) then
      PomiTextOut(LabelDBottomLevel.VirtualRect.Left - 8, LabelDBottomLevel.VirtualRect.Top + 1, IntToStr(g_MySelf.m_Abil.Level));
  end
  else begin
    if LabelDBottomLevel.Visible and (g_MySelf <> nil) then
      LabelDBottomLevel.Caption := IntToStr(g_MySelf.m_Abil.Level);
  end;

  if DDayBrightIcon.Visible then begin
    case g_nDayBright of
      0:
        DDayBrightIcon.ImageIndex.Up := FDayBrightIconStartIndex + 3; // 早上
      1:
        DDayBrightIcon.ImageIndex.Up := FDayBrightIconStartIndex + 0; // 白天
      2:
        DDayBrightIcon.ImageIndex.Up := FDayBrightIconStartIndex + 1; // 傍晚
      3:
        DDayBrightIcon.ImageIndex.Up := FDayBrightIconStartIndex + 2; // 晚上
    end;
  end;

  if g_MySelf <> nil then begin
    Abil := g_MySelf.m_Abil;

    if Abil.MaxExp < Abil.Exp then
      Abil.MaxExp := Abil.Exp;
    if Abil.MaxWeight < Abil.Weight then
      Abil.MaxWeight := Abil.Weight;

    nWidth := 0;
    if DButtonCurrentExp.Visible and (DButtonCurrentExp.ImageIndex.Image <> nil) and (DButtonCurrentExp.ImageIndex.Up >= 0) and (Abil.MaxExp > 0) then begin
      D := DButtonCurrentExp.ImageIndex.Image.Images[DButtonCurrentExp.ImageIndex.Up];
