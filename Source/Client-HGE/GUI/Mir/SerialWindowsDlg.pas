procedure TSerialWindows.DSellPlayerBtnSearchClick(Sender:TObject; X, Y:Integer);
var
  Msg:TDefaultMessage;
  SearchInfo:TSellPlayerSearchInfo;
begin
  if MyGetTickCount - FSellPlayerShopItemSearchTick < 500 then
    Exit;
  FSellPlayerShopItemSearchTick := MyGetTickCount;

  SearchInfo.PlayerName := DSellPlayerEdtName.Text;
  SearchInfo.LevelMin := DSellPlayerEdtLevel1.Value;
  SearchInfo.LevelMax := DSellPlayerEdtLevel2.Value;
  SearchInfo.Job := DSellPlayerCboJob.ItemIndex;
  SearchInfo.PricesMin := DSellPlayerEdtPrices1.Value;
  SearchInfo.PricesMax := DSellPlayerEdtPrices2.Value;
  if DSellPlayerCboMoneyType.ItemIndex >= 0 then
    SearchInfo.MoneyType := Integer(DSellPlayerCboMoneyType.Items.Objects[DSellPlayerCboMoneyType.ItemIndex])
  else
    SearchInfo.MoneyType := 0;
  SearchInfo.SortType := DSellPlayerCboPricesSort.ItemIndex;

  Msg := MakeDefaultMsg(CM_QUERY_SELLPLAYERSHOPITEM, 0, 0, 0, 0);
  FrmMain.SendSocket(EncodeMessage(Msg) + EncodeBuffer(@SearchInfo, SizeOf(SearchInfo)));
end;

procedure TSerialWindows.DSellPlayerLblPageSelectClick(Sender:TObject; X, Y:Integer);
begin
  if FSellPlayerShopMaxPage = 0 then
    Exit;
  if MyGetTickCount - FSellPlayerShopItemSearchTick < 500 then
    Exit;

  if Sender = DSellPlayerLblPageFirst then begin
    if FSellPlayerShopCurPage > 0 then begin
      frmMain.SendClientMessage(CM_GET_SELLPLAYERSHOPITEM, 0, 0, 0, 0);
      FSellPlayerShopItemSearchTick := MyGetTickCount;
    end;
  end
  else if Sender = DSellPlayerLblPageLast then begin
    if FSellPlayerShopCurPage <> FSellPlayerShopMaxPage - 1 then begin
      frmMain.SendClientMessage(CM_GET_SELLPLAYERSHOPITEM, FSellPlayerShopMaxPage - 1, 0, 0, 0);
      FSellPlayerShopItemSearchTick := MyGetTickCount;
    end;
  end
  else if Sender = DSellPlayerLblPagePrev then begin
    if FSellPlayerShopCurPage > 0 then begin
      frmMain.SendClientMessage(CM_GET_SELLPLAYERSHOPITEM, FSellPlayerShopCurPage - 1, 0, 0, 0);
      FSellPlayerShopItemSearchTick := MyGetTickCount;
    end;
  end
  else if Sender = DSellPlayerLblPageNext then begin
    if FSellPlayerShopCurPage < FSellPlayerShopMaxPage - 1 then begin
      frmMain.SendClientMessage(CM_GET_SELLPLAYERSHOPITEM, FSellPlayerShopCurPage + 1, 0, 0, 0);
      FSellPlayerShopItemSearchTick := MyGetTickCount;
    end;
  end;
end;

procedure TSerialWindows.DSellPlayerViewMenuClick(Sender:TObject; X, Y:Integer); stdcall;
var
  Msg:TDefaultMessage;
  Index:Integer;
begin
  if Length(FSellPlayerViewName) > 0 then begin
    if MyGetTickCount - FSellPlayerShopItemSearchTick < 500 then
      Exit;
    FSellPlayerShopItemSearchTick := MyGetTickCount;

    Index := DSellPlayerViewMenu.ItemIndex;

    if (Index >= 2) and (not DSellPlayerViewMenu.Items.Visible[2]) then
      Inc(Index);

    if (Index >= 3) and (not DSellPlayerViewMenu.Items.Visible[3]) then
      Inc(Index);

    Msg := MakeDefaultMsg(CM_VIEW_SELLPLAYER_INFO, Index, 0, 0, 0);
    FrmMain.SendSocket(EncodeMessage(Msg) + EncodeString(FSellPlayerViewName));
  end;
end;

procedure TSerialWindows.ListViewSellPlayerShopItemClick(Sender:TObject; ARow, ACol:Integer; ListItem:TObject; ViewItem:Pointer);
var
  Msg:TDefaultMessage;
  R:TRect;
  TempRow:Integer;
  S:string;
begin
  if (g_SellPlayerShopItems[ARow].PlayerName = '') then
    Exit;

  if (ACol = 5) then {// 查看详情}  begin
    R := DLvSellPlayerShopItem.ColRects[5];

    TempRow := ARow div DLvSellPlayerShopItem.ShowItemCount;

    DSellPlayerViewMenu.Left := DLvSellPlayerShopItem.VirtualRect.Left + R.Left;
    DSellPlayerViewMenu.Top := DLvSellPlayerShopItem.ViewRect.Top + DLvSellPlayerShopItem.HeaderHeight + TempRow * DLvSellPlayerShopItem.ItemHeight;

    DSellPlayerViewMenu.Items.Visible[2] := FSellPlayerViewStorage;
    DSellPlayerViewMenu.Items.Visible[3] := FSellPlayerViewStorageEx;
    DSellPlayerViewMenu.Items.Visible[4] := FSellPlayerViewHeroInfo;

    FSellPlayerViewName := TDxListItem(ListItem).Items[1].Caption;

    DSellPlayerViewMenu.Show;
  end
  else if (ACol = 6) then {// 购买}  begin
    S := '';
    case g_SellPlayerShopItems[ARow].MoneyType of
      0:
        S := g_sGameGoldName;
      1:
        S := g_sGamePointName;
      2:
        S := g_sGoldName;
      3:
        S := g_sGameDiamondName;
      4:
        S := g_sGameGirdName;
      else
        S := GetCustomMoneyNameByRule(g_SellPlayerShopItems[ARow].MoneyType, 3)
    end;

    S := Format('是否确认以 %d {%s/AUTOCOLOR=250,251,254,222} 的价格购买角色 %s？ "', [g_SellPlayerShopItems[ARow].Prices, S, g_SellPlayerShopItems[ARow].PlayerName]);

    if DMessageDlg(S, [mbOk, mbCancel]) = mrOK then begin
      Msg := MakeDefaultMsg(CM_BUY_SELLPLAYER, g_SellPlayerShopItems[ARow].Prices, g_SellPlayerShopItems[ARow].MoneyType, 0, 0);
      FrmMain.SendSocket(EncodeMessage(Msg) + EncodeString(g_SellPlayerShopItems[ARow].PlayerName));
    end;
  end;
end;

procedure TSerialWindows.OpenSellPlayDlg(CurrentType:Integer);
var
  I:Integer;
  Money:pTClientCustomMoney;
begin
  DSellPlayerDlg.Visible := True;
  DSellPlayerMoneyType.Items.Clear;

  DSellPlayerPrice.Text := '';
  DSellPlayerDelegator.Text := '';
  DSellPlayerLblSetUser.Checked := False;
  DSellPlayerEdtSetUser.Text := '';
  DSellPlayerEdtSetUser.Enabled := DSellPlayerLblSetUser.Checked;

  DSellPlayerDelegatorType.ItemIndex := 0;
  DSellPlayerDelegator.Enabled := DSellPlayerDelegatorType.ItemIndex <> 0;

  DSellPlayerPrice.SetFocus;

  if CurrentType and 2 <> 0 then {// 元宝}  begin
    DSellPlayerMoneyType.Items.AddObject(g_sGameGoldName, TObject(0));
  end;

  if CurrentType and 16 <> 0 then {// 游戏点}  begin
    DSellPlayerMoneyType.Items.AddObject(g_sGamePointName, TObject(1));
  end;

  if CurrentType and 1 <> 0 then {// 金币}  begin
    DSellPlayerMoneyType.Items.AddObject(g_sGoldName, TObject(2));
  end;

  if CurrentType and 4 <> 0 then {// 金刚石}  begin
    DSellPlayerMoneyType.Items.AddObject(g_sGameDiamondName, TObject(3));
  end;

  if CurrentType and 8 <> 0 then {// 灵符}  begin
    DSellPlayerMoneyType.Items.AddObject(g_sGameGirdName, TObject(4));
  end;

  for I := 0 to g_CustomMoneyRule.Count - 1 do begin
    Money := pTClientCustomMoney(g_CustomMoneyRule.Items[I]);
    if Money.boCanSellPlayer then begin
      DSellPlayerMoneyType.Items.AddObject(Money.sName, TObject(Money.nIndex + 5));
    end;
  end;

  if DSellPlayerMoneyType.Items.Count > 0 then begin
    DSellPlayerMoneyType.ItemIndex := 0;
    DSellPlayerMoneyType.Text := DSellPlayerMoneyType.Items[0];
  end;
end;

