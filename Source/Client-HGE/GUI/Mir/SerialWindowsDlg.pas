procedure TSerialWindows.OpenViewSellPlayerBagItems(SellPlayerMoney:PSellPlayerMoney; ExtBagOpenItemCount, ExtBagPageCount:Word);
var
  CalcPageCount:Integer;
  BagOnePageCount:Integer;
  S, sTempName:string;
begin
  inherited;
  BagOnePageCount := DSellPlayerItemGrid.RowCount * DSellPlayerItemGrid.ColCount;

  CalcPageCount := (MAX_EXT_ONE_PAGE_ITEM_COUNT + ExtBagPageCount * MAX_EXT_ONE_PAGE_ITEM_COUNT + BagOnePageCount - 1) div BagOnePageCount;
  DSellPlayerBagPag1.Visible := CalcPageCount >= 2;
  DSellPlayerBagPag2.Visible := CalcPageCount >= 2;
  DSellPlayerBagPag3.Visible := CalcPageCount >= 3;
  DSellPlayerBagPag4.Visible := CalcPageCount >= 4;
  DSellPlayerBagPag5.Visible := CalcPageCount >= 5;

  if DSellPlayerBagPag1.Visible then
    DSellPlayerBagPag1.BringToFront;
  if DSellPlayerBagPag2.Visible then
    DSellPlayerBagPag2.BringToFront;
  if DSellPlayerBagPag3.Visible then
    DSellPlayerBagPag3.BringToFront;
  if DSellPlayerBagPag4.Visible then
    DSellPlayerBagPag4.BringToFront;
  if DSellPlayerBagPag5.Visible then
    DSellPlayerBagPag5.BringToFront;

  DSellPlayerBagPag1.Checked := True;
  DSellPlayerBagPag1.BringToFront;

  FViewSellPlayerBagPage := 0;
  FViewSellPlayerExtBagOpenItemCount := ExtBagOpenItemCount;
  FViewSellPlayerExtBagPageCount := ExtBagPageCount;

  if SellPlayerMoney <> nil then begin
    S := StringReplace(FlblSellPlayerItemBagUserName_Text, '<$name>', SellPlayerMoney.sUserName, [rfIgnoreCase]);
    DlblSellPlayerItemBagUserName.Caption := S;

    DSellPlayerGoldValue.Caption := GetGoldStr(SellPlayerMoney.nGold);

    if g_ClientConfig.boShowBagGameGoldSeparator then
      sTempName := GetGoldStr(SellPlayerMoney.nGameGold)
    else
      sTempName := IntToStr(SellPlayerMoney.nGameGold);
