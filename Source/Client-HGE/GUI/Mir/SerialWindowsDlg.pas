procedure TSerialWindows.DFriendDlgAddClick(Sender:TObject; X, Y:Integer);
var
  I:Integer;
  sWho:string;
  sDirectory, sFileName:string;
  ChatMemo:TDxChatMemo;
  ViewItem:pTViewItem;
begin
  if g_MySelf = nil then
    Exit;
  sDirectory := 'Config\';
  if not DirectoryExists(sDirectory) then
    ForceDirectories(sDirectory);

  DMessageDlg('输入人物名称：', [mbOk, mbAbort]);
  sWho := Trim(DlgEditText);
  if sWho <> '' then begin
    ChatMemo := nil;
    case DFriendPageControl.ActivePageIndex of
      0:begin
          ChatMemo := DMemoFriend;
          sFileName := Format(FriendListFile, [g_sPlugServerName, g_sPlugUserName]);
        end;
      1:begin
          ChatMemo := DMemoTarget;
          sFileName := Format(TargetListFile, [g_sPlugServerName, g_sPlugUserName]);
        end;
      2:begin
          ChatMemo := DMemoHeiMingDan;
          sFileName := Format(BlackListFile, [g_sPlugServerName, g_sPlugUserName]);
        end;
    end;
    if (ChatMemo <> nil) then begin
      for I := 0 to ChatMemo.Lines.Count - 1 do begin
        if CompareText(ChatMemo.Lines.Strings[I], sWho) = 0 then begin
          ChatMemo.ItemIndex := I;
          Exit;
        end;
      end;
      ChatMemo.Add(sWho, clWhite, clBlack);

      if DFriendPageControl.ActivePageIndex = 1 then
        g_MyTargetList.Add(sWho)
      else if DFriendPageControl.ActivePageIndex = 2 then
        g_MyBlacklist.Add(sWho);

      ViewItem := TDxLines(ChatMemo.Lines).Items[ChatMemo.Lines.Count - 1];

      ViewItem.Color.Up.Color := clWhite;
      ViewItem.Color.Hot.Color := clYellow;
      ViewItem.Color.Down.Color := clRed;
      try
        ChatMemo.Lines.SaveToFile(sFileName);
      except

      end;
    end;
  end;
end;

procedure TSerialWindows.DFriendDlgDelClick(Sender:TObject; X, Y:Integer);
var
  ChatMemo:TDxChatMemo;
  sDirectory, sFileName:string;
begin
  if g_MySelf = nil then
    Exit;
  sDirectory := 'Config\';
  if not DirectoryExists(sDirectory) then
    ForceDirectories(sDirectory);

  ChatMemo := nil;
  case DFriendPageControl.ActivePageIndex of
    0:begin
        ChatMemo := DMemoFriend;
        sFileName := Format(FriendListFile, [g_sPlugServerName, g_sPlugUserName]);
      end;
    1:begin
        ChatMemo := DMemoTarget;
        sFileName := Format(TargetListFile, [g_sPlugServerName, g_sPlugUserName]);
      end;
    2:begin
        ChatMemo := DMemoHeiMingDan;
        sFileName := Format(BlackListFile, [g_sPlugServerName, g_sPlugUserName]);
      end;
  end;
  if (ChatMemo <> nil) and (ChatMemo.ItemIndex >= 0) then begin
    if DFriendPageControl.ActivePageIndex = 1 then
      g_MyTargetList.Delete(ChatMemo.ItemIndex)
    else if DFriendPageControl.ActivePageIndex = 2 then
      g_MyBlacklist.Delete(ChatMemo.ItemIndex);
    ChatMemo.Delete(ChatMemo.ItemIndex);
    try
      ChatMemo.Lines.SaveToFile(sFileName);
    except

    end;
  end;
end;

