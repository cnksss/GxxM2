      DxFontAssign(TabSheet.CaptionColor.Hot, FMissionTabSheetSetting.CaptionColor.Hot);
      DxFontAssign(TabSheet.CaptionColor.Down, FMissionTabSheetSetting.CaptionColor.Down);
      DxFontAssign(TabSheet.CaptionColor.Disabled, FMissionTabSheetSetting.CaptionColor.Disabled);

