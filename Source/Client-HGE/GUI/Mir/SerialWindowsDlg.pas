procedure TSerialWindows.ViewItemPaint(Sender:TObject; ACol, ARow:Integer; Rect:TRect; ViewItem:Pointer; var PaintOverride:Boolean);
var
  UserShopItem:pTClientUserShopItem;
  DrawItemEffect:pTDrawItemEffect;
begin
  PaintOverride := ACol = 0;
  if PaintOverride then begin
    UserShopItem := nil;
    DrawItemEffect := nil; //
    if Sender = ListViewMyShopSelling then begin
      UserShopItem := @g_MyShopItems[0, ARow];
      DrawItemEffect := @g_MyShopItemEffects[0, ARow];
    end else if Sender = ListViewMyShopSelled then begin
      UserShopItem := @g_MyShopItems[1, ARow];
      DrawItemEffect := @g_MyShopItemEffects[1, ARow];
    end else if Sender = ListViewMyShopStorage then begin
      UserShopItem := @g_MyShopItems[2, ARow];
      DrawItemEffect := @g_MyShopItemEffects[2, ARow];
    end else if Sender = ListViewGameShopItem then begin
      UserShopItem := @g_SearchUserShopItems[ARow];
      DrawItemEffect := @g_SearchUserShopItemEffects[ARow];
    end else if Sender = ListViewUserShopItem then begin
      UserShopItem := @g_UserShopItems[ARow];
      DrawItemEffect := @g_UserShopItems[ARow];
    end;

    if UserShopItem <> nil then begin
      // 默认店铺绘制时不要外观发光特效 chongchong 2014-04-17
      DrawGridItem(Rect, @UserShopItem.Item, DrawItemEffect, False);
    end;
  end;
end;

procedure TSerialWindows.ListViewGameShopItemListItemClick(Sender:TObject; ARow, ACol:Integer; ListItem:TObject; ViewItem:Pointer);
begin
  if g_MySelf = nil then
    Exit;
  if MyGetTickCount - g_dwQueryUserShopItemTime < 500 then
    Exit;

  g_dwQueryUserShopItemTime := MyGetTickCount;

  if (ARow >= 0) and (ARow <= 4) and (g_SelectMyShopItemWait.S.Name = '') and (g_MyShopDlgItem.S.Name = '') and (g_MyShopDlgItemWait.S.Name = '') then begin
    if ACol = 3 then begin // 进入该店铺
      if (g_SearchUserShopItems[ARow].sMasterName <> '') then begin
        //if CompareText(g_SearchUserShopItems[ARow].sMasterName, g_MySelf.m_sUserName) = 0 then
        if g_SearchUserShopItems[ARow].IsMyShopeItem then begin
          frmMain.SendQuerySelectShopInfo(g_SearchUserShopItems[ARow].sMasterName);
        end
        else begin
          g_SelectUserShop.sShopName := '';
          g_SelectUserShop.sMasterName := '';
          frmMain.SendQuerySelectShopInfo(g_SearchUserShopItems[ARow].sMasterName);
        end;
      end;
    end
    else if (ACol = 6) and (g_SearchUserShopItems[ARow].Item.s.Name <> '') and (g_SearchUserShopItems[ARow].sBuyName = '') then begin // 购买物品
      //if CompareText(g_SearchUserShopItems[ARow].sMasterName, g_MySelf.m_sUserName) = 0 then
      if g_SearchUserShopItems[ARow].IsMyShopeItem then begin
        frmMain.SendMoveMyShopItem(g_SearchUserShopItems[ARow].Item.MakeIndex, 0, 2, g_SearchUserShopItems[ARow].Item.S.Name);
      end
      else begin
        if (g_SearchUserShopItems[ARow].sBuyName = '') then begin
          if DMessageDlg('是否确认购买 "' + ProcessItemName(g_SearchUserShopItems[ARow].Item.s.Name) + '"？', [mbOk, mbCancel]) = mrOk then
          {//if DMessageDlg(Format(DecodeResStr(SUserShopOperateAsk), [ProcessItemName(g_MyShopDlgItem.S.Name), EditMyShopItemPrice.Value, S , sShopType]), [mbOk, mbCancel]) = mrOk then} begin
            frmMain.SendBuyUserShopItem(g_SearchUserShopItems[ARow].Item.MakeIndex, g_SearchUserShopItems[ARow].sMasterName, $10 or g_SearchUserShopItems[ARow].btMoneyType, g_SearchUserShopItems[ARow].Item.s.Price);
          end;
        end;
      end;
    end;
  end;
end;

