procedure TSerialWindows.SetAuctionPageCount();
begin
  DBtnAuctionAllItemsPageNum.Caption := Format('%d/%d', [FAuctionAllItemsPage, FAuctionAllItemsPageCount]);
  DBtnAuctionMyPageNum.Caption := Format('%d/%d', [FAuctionMyItemsPage, FAuctionMyItemsPageCount]);
  DBtnAuctionMyAttentionPageNum.Caption := Format('%d/%d', [FAuctionMyAuctioningItemsPage, FAuctionMyAuctioningItemsPageCount]);
  DLblAuctionBagPageNum.Caption := Format('%d/%d', [FAuctionMyItemsBagPage, FAuctionMyItemsBagPageCount]);

  DBtnAuctionAllItemsPrev.Enabled := FAuctionAllItemsPage > 1;
  DBtnAuctionAllItemsNext.Enabled := FAuctionAllItemsPage < FAuctionAllItemsPageCount;

  DBtnAuctionMyPrev.Enabled := FAuctionMyItemsPage > 1;
  DBtnAuctionMyNext.Enabled := FAuctionMyItemsPage < FAuctionMyItemsPageCount;

  DBtnAuctionMyAttentionPrev.Enabled := FAuctionMyAuctioningItemsPage > 1;
  DBtnAuctionMyAttentionNext.Enabled := FAuctionMyAuctioningItemsPage < FAuctionMyAuctioningItemsPageCount;

  DBtnAuctionBagPrev.Enabled := FAuctionMyItemsBagPage > 1;
  DBtnAuctionBagNext.Enabled := FAuctionMyItemsBagPage < FAuctionMyItemsBagPageCount;
end;

