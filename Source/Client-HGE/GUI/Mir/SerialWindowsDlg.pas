procedure TSerialWindows.DGameShopPageControlPageChange(Sender:TObject);
var
  S:string;
  MoneyType:Integer;
begin
  if g_MySelf = nil then
    Exit;
  SetGameShopPageCount;
  if (DGameShopPageControl.ActivePageIndex = 1) and (g_nSearchUserShopItemCount <= 0) and (MyGetTickCount - g_dwQueryUserShopItemTime > 500) then begin
    MoneyType := ComboBoxGameShopMoneyType.ItemIndex;
    if MoneyType > 0 then begin
      S := ComboBoxGameShopMoneyType.Items[ComboBoxGameShopMoneyType.ItemIndex];
      if SameText(S, g_sGameGoldName) then
        MoneyType := 1
      else if SameText(S, g_sGamePointName) then
        MoneyType := 2
      else if SameText(S, g_sGoldName) then
        MoneyType := 3
      else if SameTExt(S, g_sGameDiamondName) then
        MoneyType := 4
      else if SameText(S, g_sGameGirdName) then
        MoneyType := 5
      else if GetCustomMoneyIndexByName(S, 0) <> -1 then
        MoneyType := GetCustomMoneyIndexByName(S, 0)
      else
        Exit;
    end;

    g_dwQueryUserShopItemTime := MyGetTickCount;
    frmMain.SendQuerySearchShopItem(ComboBoxGameShopItemNameType.ItemIndex, MoneyType, ComboBoxGameShopPriceSortType.ItemIndex, EditGameShopSearchShopItemPriceMin.Value, EditGameShopSearchShopItemPriceMax.Value, EditGameShopSearchShopItem.Text);
  end;
end;

procedure TSerialWindows.OpenUserShop(Sender:TObject; ARow, ACol:Integer; ListItem:TObject; ViewItem:Pointer);
begin
  if g_MySelf = nil then
    Exit;
  if MyGetTickCount - g_dwQueryUserShopTime < 500 then
    Exit;

  g_dwQueryUserShopTime := MyGetTickCount;

  if (ACol = 0) and (ARow >= 0) and (ARow < Length(g_UserShops)) and (g_SelectMyShopItemWait.S.Name = '') and (g_MyShopDlgItem.S.Name = '') and (g_MyShopDlgItemWait.S.Name = '') then begin
    if (g_UserShops[ARow].sMasterName <> '') then {and g_UserShops[ARow].boBusiness}  begin
      if CompareText(g_MySelf.m_sUserName, g_UserShops[ARow].sMasterName) = 0 then begin
        if (g_SelectMyShopItemWait.S.Name = '') and (g_MyShopDlgItem.S.Name = '') and (g_MyShopDlgItemWait.S.Name = '') then begin
          frmMain.SendQueryMyShopSellingItem(0, 0, 0, 0, 0, '');
          frmMain.SendQueryMyShopSelledItem(0, 0, 0, 0, 0, '');
          frmMain.SendQueryMyShopStorageItem(0, 0, 0, 0, 0, '');
        end;

        OpenDMyShopDlg(@g_UserShops[ARow]);
      end
      else begin
        g_SelectUserShop.sShopName := '';
        g_SelectUserShop.sMasterName := '';
        if (g_UserShops[ARow].btState = 2) and g_boOfflineCloseMyShop then
          Exit;
        frmMain.SendQuerySelectShopInfo(g_UserShops[ARow].sMasterName);
      end;
      CloseDGameShopDlg;
    end;
  end;
end;

procedure TSerialWindows.ListViewGameShopItemListItemMouseMove(Sender:TObject; Shift:TShiftState; X, Y, ARow, ACol:Integer; ListItem:TObject; ViewItem:Pointer; Select:Boolean);
var
  UserShopItem:TClientUserShopItem;
  vtRect:TRect;
begin
  if (ARow >= 0) and (ARow <= 4) and (ACol = 0) and Select then begin
    UserShopItem := g_SearchUserShopItems[ARow];
    if UserShopItem.Item.s.Name <> '' then begin
      g_MouseItem := UserShopItem.Item;
      vtRect := ListViewGameShopItem.VisibleRect;
      ShowMouseItemInfo(g_MySelf, @g_MouseItem, vtRect.Left, vtRect.Top + (ARow + 1) * ListViewGameShopItem.ItemHeight, True, 0, False, True);
