      DLblAuctionSellMinPrices.Visible := (AcutionPrices.Min[CurrencyType] <> 0) and (CurrencyType in [0..4]);
      DLblAuctionSellMinPricesValue.Visible := (AcutionPrices.Min[CurrencyType] <> 0) and (CurrencyType in [0..4]);
      if CurrencyType in [0..4] then
        DLblAuctionSellMinPricesValue.Caption := IntToStr(AcutionPrices.Min[CurrencyType]) + DEdtAuctionSellItemMoneyType.Text;

      DLblAuctionSellMaxPrices.Visible := (AcutionPrices.Max[CurrencyType] <> 0) and (CurrencyType in [0..4]);
      DLblAuctionSellMaxPricesValue.Visible := (AcutionPrices.Max[CurrencyType] <> 0) and (CurrencyType in [0..4]);
      if CurrencyType in [0..4] then
        DLblAuctionSellMaxPricesValue.Caption := IntToStr(AcutionPrices.Max[CurrencyType]) + DEdtAuctionSellItemMoneyType.Text;
    end;
  end;
end;

procedure TSerialWindows.DLblAuctionStartAuctionClick(Sender:TObject; X, Y:Integer);
var
  Index, RealIndex:Integer;
  I:Integer;
  List:TList;
  sMoneyName:string;
  CurrencyType:Integer;
  AcutionPrices:PTAcutionItemPricesLime;
  Money:pTClientCustomMoney;
begin
  if g_IsAuctionDlgItemWait then
    Exit;

  if FAuctionMyItemsBagSelectIndex = -1 then begin
    FrmDlg.DMessageDlg(DecodeResStr(SAuctionAddNoItem), [mbOk]);
    Exit;
  end;

  List := TList.Create;
  try
    List.Capacity := GetMaxBagCount;

    for I := Low(g_ItemArr) to GetMaxBagCount - 1 do begin
      if (Length(g_ItemArr[I].S.Name) > 0) and (g_EnabledAuctionItemList.IndexOf(g_ItemArr[I].S.DBName) >= 0) then begin
        List.Add(Pointer(I));
      end;
    end;

    Index := (FAuctionMyItemsBagPage - 1) * AUCTION_BAG_ONE_PAGE_COUNT + FAuctionMyItemsBagSelectIndex;
    if (Index >= 0) and (Index <= List.Count - 1) then begin
      RealIndex := Integer(List.Items[Index]);

      if Length(g_ItemArr[RealIndex].S.Name) > 0 then begin
        if g_ItemArr[RealIndex].IsBind then begin
          FrmDlg.DMessageDlg(DecodeResStr(SAuctionAddBindItem), [mbOk]);
          Exit;
        end;

        g_AuctionDlgItem := g_ItemArr[RealIndex];

        DLblAuctionSellItemName.Caption := ProcessItemName(g_AuctionDlgItem.s.Name);
        DLblAuctionSellItemName.CaptionColor.Up.Color := GetRGB(g_AuctionDlgItem.s.Color);
        DLblAuctionSellItemName.CaptionColor.Hot.Color := GetRGB(g_AuctionDlgItem.s.Color);
        DLblAuctionSellItemName.CaptionColor.Down.Color := GetRGB(g_AuctionDlgItem.s.Color);

        DEdtAuctionSellItemMoneyType.Items.Clear;
        DLblAuctionSellMoneyType2.Caption := '';
        if g_ClientConfig.nAuctionCurrencyTypeEx and 2 <> 0 then {// 元宝}  begin
          DEdtAuctionSellItemMoneyType.Items.AddObject(g_sGameGoldName, TObject(0));
        end;

        if g_ClientConfig.nAuctionCurrencyTypeEx and 16 <> 0 then {// 游戏点}  begin
          DEdtAuctionSellItemMoneyType.Items.AddObject(g_sGamePointName, TObject(1));
        end;

        if g_ClientConfig.nAuctionCurrencyTypeEx and 1 <> 0 then {// 金币}  begin
          DEdtAuctionSellItemMoneyType.Items.AddObject(g_sGoldName, TObject(2));
        end;

        if g_ClientConfig.nAuctionCurrencyTypeEx and 4 <> 0 then {// 金刚石}  begin
          DEdtAuctionSellItemMoneyType.Items.AddObject(g_sGameDiamondName, TObject(3));
        end;

        if g_ClientConfig.nAuctionCurrencyTypeEx and 8 <> 0 then {// 灵符}  begin
          DEdtAuctionSellItemMoneyType.Items.AddObject(g_sGameGirdName, TObject(4));
        end;

        for I := 0 to g_CustomMoneyRule.Count - 1 do begin
          Money := pTClientCustomMoney(g_CustomMoneyRule.Items[I]);
          if Money.boCanAuction then begin
            DEdtAuctionSellItemMoneyType.Items.AddObject(Money.sName, TObject(Money.nIndex + 5));
          end;
        end;

        if DEdtAuctionSellItemMoneyType.Items.Count > 0 then begin
          DEdtAuctionSellItemMoneyType.ItemIndex := 0;

          DLblAuctionSellMoneyType2.Caption := DEdtAuctionSellItemMoneyType.Text;

          CurrencyType := Integer(DEdtAuctionSellItemMoneyType.Items.Objects[DEdtAuctionSellItemMoneyType.ItemIndex]);
          Index := g_EnabledAuctionItemList.IndexOf(g_AuctionDlgItem.s.DBName);
          if Index >= 0 then begin
            AcutionPrices := PTAcutionItemPricesLime(g_EnabledAuctionItemList.Objects[Index]);

            DLblAuctionSellMinPrices.Visible := AcutionPrices.Min[CurrencyType] <> 0;
            DLblAuctionSellMinPricesValue.Visible := AcutionPrices.Min[CurrencyType] <> 0;
            DLblAuctionSellMinPricesValue.Caption := IntToStr(AcutionPrices.Min[CurrencyType]) + DEdtAuctionSellItemMoneyType.Text;

            DLblAuctionSellMaxPrices.Visible := AcutionPrices.Max[CurrencyType] <> 0;
            DLblAuctionSellMaxPricesValue.Visible := AcutionPrices.Max[CurrencyType] <> 0;
            DLblAuctionSellMaxPricesValue.Caption := IntToStr(AcutionPrices.Max[CurrencyType]) + DEdtAuctionSellItemMoneyType.Text;
          end;
        end;

        case g_ClientConfig.nAuctionBroadcastCurrencyType of
          0:
            sMoneyName := g_sGameGoldName;
          1:
            sMoneyName := g_sGamePointName;
          2:
            sMoneyName := g_sGoldName;
          3:
            sMoneyName := g_sGameDiamondName;
          4:
            sMoneyName := g_sGameGirdName;
          else
            sMoneyName := GetCustomMoneyNameByRule(g_ClientConfig.nAuctionBroadcastCurrencyType, 2)
              //        else
//          sMoneyName := '';
        end;
        if sMoneyName = '' then
          sMoneyName := GetCustomMoneyNameByRule(g_ClientConfig.nAuctionBroadcastCurrencyType, 2);
        DLblAuctionSellSendBroadcastPrice.Caption := IntToStr(g_ClientConfig.nAuctionBroadcastPrice) + ' ' + sMoneyName;

        DEdtAuctionSellItemPrice1.Text := '';
        DEdtAuctionSellItemPrice2.Text := '';

        DChkAuctionSellH08.Checked := True;
        DChkAuctionSellSendBroadcast.Checked := False;

        DAuctionSellDlg.ShowModal;
      end
      else begin
        FrmDlg.DMessageDlg(DecodeResStr(SAuctionAddNoItem), [mbOk]);
        Exit;
      end;
    end
    else begin
      FrmDlg.DMessageDlg(DecodeResStr(SAuctionAddNoItem), [mbOk]);
      Exit;
    end;
  finally
    List.Free;
  end;
end;

procedure TSerialWindows.DBtnAuctionSellStartClick(Sender:TObject; X, Y:Integer);
var
  S, sMoneyType:string;
  TimeIndex, CurrencyType, Index:Integer;
  AcutionPrices:PTAcutionItemPricesLime;
  V1, V2:Int64;
begin
  if g_IsAuctionDlgItemWait then
    Exit;

  if Length(g_AuctionDlgItem.s.Name) = 0 then begin
    FrmDlg.DMessageDlg(DecodeResStr(SAuctionStartSellNoItem), [mbOk]);
    Exit;
  end;

  V1 := StrToInt64Def(Trim(DEdtAuctionSellItemPrice1.Text), 0);
  V2 := StrToInt64Def(Trim(DEdtAuctionSellItemPrice2.Text), 0);

  if V1 <= 0 then begin
    FrmDlg.DMessageDlg(DecodeResStr(SAuctionStartSellPrice1), [mbOk]);
    Exit;
  end;

  if V1 >= V2 then begin
    FrmDlg.DMessageDlg(DecodeResStr(SAuctionStartSellPrice2), [mbOk]);
    Exit;
  end;

  if DEdtAuctionSellItemMoneyType.ItemIndex < 0 then begin
    FrmDlg.DMessageDlg(DecodeResStr(SAuctionNoSelectCurrentType), [mbOk]);
    Exit;
  end;

  V1 := Min(V1, High(DWORD));
  V2 := Min(V2, High(DWORD));

  CurrencyType := Integer(DEdtAuctionSellItemMoneyType.Items.Objects[DEdtAuctionSellItemMoneyType.ItemIndex]);

  Index := g_EnabledAuctionItemList.IndexOf(g_AuctionDlgItem.s.DBName);
  if Index >= 0 then begin
    AcutionPrices := PTAcutionItemPricesLime(g_EnabledAuctionItemList.Objects[Index]);

    case CurrencyType of
      0:
        sMoneyType := g_sGameGoldName;
      1:
        sMoneyType := g_sGamePointName;
      2:
        sMoneyType := g_sGoldName;
      3:
        sMoneyType := g_sGameDiamondName;
      4:
        sMoneyType := g_sGameGirdName;
      else
        sMoneyType := GetCustomMoneyNameByRule(CurrencyType, 2)
          //    else
//      sMoneyType := '';
    end;

    if (AcutionPrices.Min[CurrencyType] <> 0) and (V1 < AcutionPrices.Min[CurrencyType]) then begin
      FrmDlg.DMessageDlg('起拍价不能低于最低价: ' + IntToStr(AcutionPrices.Min[CurrencyType]) + sMoneyType, [mbOk]);
      Exit;
    end;

    if (AcutionPrices.Max[CurrencyType] <> 0) and (V2 > AcutionPrices.Max[CurrencyType]) then begin
      FrmDlg.DMessageDlg('一口价不能高于最高价: ' + IntToStr(AcutionPrices.Max[CurrencyType]) + sMoneyType, [mbOk]);
      Exit;
    end;
  end;

  S := Format(DecodeResStr(SAuctionStartSellAsk), [ProcessItemName(g_AuctionDlgItem.S.Name), V1, sMoneyType]);
  if DMessageDlg(S, [mbOk, mbCancel]) = mrOk then begin
    g_IsAuctionDlgItemWait := True;

    TimeIndex := 0;
    if DChkAuctionSellH16.Checked then
      TimeIndex := 1
    else if DChkAuctionSellH24.Checked then
      TimeIndex := 2;

    frmMain.SendAddAuctionItem(g_AuctionDlgItem.MakeIndex, CurrencyType, V1, V2, TimeIndex, DChkAuctionSellSendBroadcast.Checked);

    CloseDAuctionSellDlg;
  end;
end;

