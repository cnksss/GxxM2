procedure TSerialWindows.DTradingMarketBuyGroupDblClick(Sender:TObject; X, Y:Integer);
var
  I:Integer;
  pg:PTClientGoods;
  Item:PTClientItem;
begin
  if (menuindex >= 0) and (menuindex < MenuList.Count) then begin
    pg := PTClientGoods(MenuList[menuindex]);

    if pg.SubMenu > 0 then begin
      if MyGetTickCount < LastestClickTime then
        Exit;
      LastestClickTime := MyGetTickCount + 1000;

      TradingItemTopLine := 0;

      // 请求二级物品列表回来
      FrmMain.SendGetDetailItem(g_nCurMerchant, 0, pg.Name, True);
      CurDetailItem := pg.Name;
    end
    else begin
      g_MenuItemList.Lock;
      try
        for I := 0 to g_MenuItemList.Count - 1 do
          Dispose(PTClientItem(g_MenuItemList[I]));
        g_MenuItemList.Clear;
      finally
        g_MenuItemList.UnLock;
      end;

      New(Item);
      Item.MakeIndex := -1;
      Item.s.Name := pg.Name;
      Item.s.Looks := pg.Looks;
      Item.Dura := pg.Count;
      Item.DuraMax := pg.Price;
      Item.s.Expand2 := pg.Stock;

      g_MenuItemList.Add(Item);

      TradingItemTopLine := 0;
      BoDetailMenu := True;
      OpenTradingMarketItemsDlg;
    end;
  end;
end;

