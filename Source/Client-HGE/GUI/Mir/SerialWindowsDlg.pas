  bo2D:Boolean;
  D:TTexture;
  SizePt:TPoint;
  // 下面冗余代码，改为了常量 -- piaoyun 20103-07-04
const
  C_FCOLOR = 'FCOLOR=';
  C_SCOLOR = 'SCOLOR=';
  C_AUTOCOLOR = 'AUTOCOLOR=';
  C_FNAME = 'FNAME=';
  C_FSIZE = 'FSIZE=';
  C_FBOLD = 'FBOLD';
  C_IMG = 'IMG:';
  C_PLAYIMG = 'PLAYIMG:';
  C_ITEMSHOW = 'ITEMSHOW:';
  C_ITEMBOX = 'ITEMBOX:';
  C_IMGEX = 'IMGEX:';
