procedure TSerialWindows.DChatMemoOnChange(Sender:TObject);
var
  I:Integer;
  ChatMemo:TDxChatMemo;
begin
  ChatMemo := TDxChatMemo(Sender);
  ChatMemo.Lock;
  try
    if ChatMemo.Lines.Count > 200 then begin
      for I := 0 to 29 do begin
        if ChatMemo.Lines.Count > 0 then
          ChatMemo.Delete(0)
        else
          break;
      end;
      ChatMemo.RemoveDelete;
    end;
    if ChatMemo.TopLines.Count > 3 then begin
      ChatMemo.DeleteTop(0); // 不允许超过3条信息
      ChatMemo.RemoveDeleteTop;
    end;
  finally
    ChatMemo.UnLock;
  end;
end;

procedure TSerialWindows.DChatMemoMouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  I, J, CurrentIndex, StartIndex, EndIndex:Integer;
  CurrentColor:TColor;
  DMemo:TDxChatMemo;
  ViewItem:pTViewItem;
  StringLineEx:TStringLineEx;
  Token:PStringToken;

  function ExtractUserName(Line:string):string;
  var
    uname:string;
  begin
    if DMemo = DWhisperMemo then
      Line := GetValidStr3(Line, uname, [' ']);

    GetValidStr3(Line, Line, ['(', '!', '*', '/', ')']);
    GetValidStr3(Line, uname, [' ', '=', ':']);
    if uname <> '' then
      if (uname[1] = '/') or (uname[1] = '(') or (uname[1] = ' ') or (uname[1] = '[') then
        uname := '';
    Result := uname;
  end;

begin
  DMemo := TDxChatMemo(Sender);
  if DMemo.ShowScroll and (X >= (DMemo.VirtualRect.Right - DMemo.ScrollSize)) then
    Exit;
  if (DMemo.ItemIndex - DMemo.TopIndex >= 0) and (DMemo.ItemIndex - DMemo.TopIndex < DMemo.TopLines.Count) then begin
    if not DedChat.Enabled then
      ShowChatEdit();

    DEdChat.Text := '/' + ExtractUserName(DMemo.TopLines[DMemo.ItemIndex - DMemo.TopIndex]) + ' ';
    DEdChat.SelStart := Length(DEdChat.Text);
    DEdChat.SelLength := 0;

    DEdChat.SetFocus;
  end
  else if (DMemo.ItemIndex - DMemo.TopLines.Count >= 0) and (DMemo.ItemIndex - DMemo.TopLines.Count < DMemo.Lines.Count) then begin
    if not DedChat.Enabled then
      ShowChatEdit();

    DEdChat.Text := '/' + ExtractUserName(DMemo.Lines[DMemo.ItemIndex - DMemo.TopLines.Count]) + ' ';
    DEdChat.SelStart := Length(DEdChat.Text);
    DEdChat.SelLength := 0;
    DEdChat.SetFocus;

    { 私聊框选中后文字变为红色 chongchong 2013-11-20 }
    if Sender = DWhisperMemo then begin
      CurrentIndex := DMemo.ItemIndex - DMemo.TopLines.Count;
      StartIndex := Max(CurrentIndex - 15, 0);
      EndIndex := Min(StartIndex + 30, DMemo.Lines.Count - 1);
      for I := StartIndex to EndIndex do begin
        ViewItem := TDxLines(DMemo.Lines).Items[I];
        if I = CurrentIndex then
          CurrentColor := DWhisperMemoDownColor
        else
          CurrentColor := DWhisperMemoUpColor;

        if ViewItem <> nil then begin
          if ViewItem.StringLineEx <> nil then begin
            StringLineEx := TStringLineEx(ViewItem.StringLineEx);
            for J := 0 to StringLineEx.Count - 1 do begin
              Token := StringLineEx.Tokens[J];
              Token.FColor := CurrentColor;
            end;
          end;
          ViewItem.Color.UP.Color := CurrentColor;
          ViewItem.Color.Down.Color := CurrentColor;
          ViewItem.Color.Hot.Color := CurrentColor;
        end;
      end;
    end;
  end
  else // DEdChat.Text := '';

end;

procedure TSerialWindows.DWhisperMemoMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer); stdcall;
var
  I, J, CurrentIndex, SelectIndex, StartIndex, EndIndex:Integer;
  CurrentColor:TColor;
  ViewItem:pTViewItem;
  StringLineEx:TStringLineEx;
  Token:PStringToken;
begin
  if Sender = DWhisperDlg then
    DWhisperMemo.HotItemIndex := -1;

  { 私聊框移入后文字变为黄色 chongchong 2013-11-20 }
  if (DWhisperMemo.HotItemIndex - DWhisperMemo.TopLines.Count >= 0) and (DWhisperMemo.HotItemIndex - DWhisperMemo.TopLines.Count < DWhisperMemo.Lines.Count) then begin
    CurrentIndex := DWhisperMemo.HotItemIndex - DWhisperMemo.TopLines.Count;
    SelectIndex := DWhisperMemo.ItemIndex - DWhisperMemo.TopLines.Count;
    StartIndex := Max(CurrentIndex - 15, 0);
    EndIndex := Min(StartIndex + 30, DWhisperMemo.Lines.Count - 1);
    for I := StartIndex to EndIndex do begin
      ViewItem := TDxLines(DWhisperMemo.Lines).Items[I];
      if I = SelectIndex then
        CurrentColor := DWhisperMemoDownColor
      else if (I = CurrentIndex) then
        CurrentColor := DWhisperMemoHotColor
      else
        CurrentColor := DWhisperMemoUpColor;

      if ViewItem <> nil then begin
        if ViewItem.StringLineEx <> nil then begin
          StringLineEx := TStringLineEx(ViewItem.StringLineEx);
          for J := 0 to StringLineEx.Count - 1 do begin
            Token := StringLineEx.Tokens[J];
            Token.FColor := CurrentColor;
          end;
        end;
        ViewItem.Color.UP.Color := CurrentColor;
        ViewItem.Color.Down.Color := CurrentColor;
        ViewItem.Color.Hot.Color := CurrentColor;
      end;
    end;
  end
  else begin
    CurrentIndex := DWhisperMemo.HotItemIndex - DWhisperMemo.TopLines.Count;
    SelectIndex := DWhisperMemo.ItemIndex - DWhisperMemo.TopLines.Count;
    StartIndex := Max(CurrentIndex - 15, 0);
    EndIndex := Min(StartIndex + 30, DWhisperMemo.Lines.Count - 1);
    for I := StartIndex to EndIndex do begin
      ViewItem := TDxLines(DWhisperMemo.Lines).Items[I];
      if I = SelectIndex then
        CurrentColor := DWhisperMemoDownColor
      else
        CurrentColor := DWhisperMemoUpColor;

      if ViewItem <> nil then begin
        if ViewItem.StringLineEx <> nil then begin
          StringLineEx := TStringLineEx(ViewItem.StringLineEx);
          for J := 0 to StringLineEx.Count - 1 do begin
            Token := StringLineEx.Tokens[J];
            Token.FColor := CurrentColor;
          end;
        end;
        ViewItem.Color.UP.Color := CurrentColor;
        ViewItem.Color.Down.Color := CurrentColor;
        ViewItem.Color.Hot.Color := CurrentColor;
      end;
    end;
  end;
end;

procedure TSerialWindows.DHeroItemBagDirectPaint(Sender:TObject);
var
  ItemName, sLine1, sLine2, sLine3:string;
  n, I, nLeft, nTop, nY:Integer;
  IsUseableLine2, IsUseableLine3:Boolean;
  vtRect:TRect;
  DHeroItemBag:TDxImageButton;
  ItemDesc:TStringList;
begin
  if g_MyHero = nil then
    Exit;

  { TODO -c注释 -opiaoyun : 英雄包裹信息传统旧模式显示 【2013-4-25 】}
  if (g_ClientConfig.btSuspensionShowItem = 0) and (g_ClientVersion <= {cvHero} cvSerial) and (g_MouseItem.S.Name <> '') and g_boShowHeroBagInfo then begin
    DHeroItemBag := TDxImageButton(Sender);
    with DHeroItemBag do begin
      vtRect := VirtualRect;

      GetMouseItemInfo(g_MyHero, @g_MouseItem, True, ItemName, sLine1, sLine2, sLine3, IsUseableLine2, IsUseableLine3);

      nLeft := vtRect.Left + 12;
      nTop := vtRect.Top + Height - 56;

      if ItemName <> '' then begin
        nY := nTop;
        if sLine2 <> '' then
          nY := nTop + 14;
        if sLine3 <> '' then
          nY := nTop + 14 * 2;

        n := DrawItemHintOldStyle(nLeft, nTop, ItemName, clYellow);
        DrawItemHintOldStyle(nLeft + n, nTop, sLine1);

        if not IsUseableLine2 then
          DrawItemHintOldStyle(nLeft, nTop + 14, sLine2, clRed)
        else
          DrawItemHintOldStyle(nLeft, nTop + 14, sLine2);

        if not IsUseableLine3 then
          DrawItemHintOldStyle(nLeft, nTop + 14 * 2, sLine3, clRed)
        else
          DrawItemHintOldStyle(nLeft, nTop + 14 * 2, sLine3);

        if not g_ClientConfig.boDescSupportRenamItem then
          ItemDesc := GetItemDesc(@g_MouseItem, g_MouseItem.S.DBName)
        else begin
          ItemDesc := GetItemDesc(@g_MouseItem, g_MouseItem.S.Name);
          if g_ClientConfig.boNoRenameDescReadDefault and ((ItemDesc = nil) or (ItemDesc.Count = 0)) then begin
            ItemDesc := GetItemDesc(@g_MouseItem, g_MouseItem.S.DBName);
          end;
        end;

        if (ItemDesc <> nil) and (ItemDesc.Count > 0) then begin

          for I := 0 to ItemDesc.Count - 1 do begin
            CurrentFont.TextOut(nLeft, nY + 14 * (I + 1), ItemDesc.Strings[I], TColor(ItemDesc.Objects[I]));
          end;

        end;
      end;
    end;
  end
  else if g_ClientConfig.boShowHeroShortKey then begin
    DHeroItemBag := TDxImageButton(Sender);
    vtRect := DHeroItemBag.VirtualRect;

    if g_ClientVersion <> cvMirNewUI205 then begin
      nLeft := vtRect.Left + 12 + g_ClientConfig.nShowHeroShortKeyX;
      nTop := vtRect.Top + DHeroItemBag.Height - 53 + g_ClientConfig.nShowHeroShortKeyY;
      CurrentFont.TextOut(nLeft, nTop, 'Alt + B 刷新英雄包裹', clWhite);
    end
    else begin
      nLeft := vtRect.Left + 35;
      nTop := vtRect.Top + DHeroItemBag.Height - 34;
      CurrentFont.TextOut(nLeft, nTop, 'Alt + B 刷新英雄包裹', Def205FontColor);
    end;
  end;
end;

procedure TSerialWindows.DHeroItemGridGridMouseMove(Sender:TObject; ACol, ARow:Integer; Shift:TShiftState);
var
  nIdx:Integer;
  vtRect:TRect;
  DItemGrid:TDxImageGrid;
begin
  if g_MyHero = nil then
    Exit;
  if ssRight in Shift then begin
    if g_boItemMoving then
      DHeroItemGridGridSelect(Self, ACol, ARow, mbLeft, Shift);
  end
  else begin
    DItemGrid := TDxImageGrid(Sender);
    nIdx := ACol + ARow * DItemGrid.ColCount;

    if nIdx in [0..MAX_HERO_BAG_ITEM - 1] then begin
      g_MouseItem := g_HeroItemArr[nIdx];
      if (g_ClientConfig.btSuspensionShowItem > 0) or (g_ClientVersion > {cvHero} cvSerial) then begin
        g_boShowHeroBagInfo := False;
        vtRect := DItemGrid.VirtualRect;
        ShowMouseItemInfo(g_MyHero, @g_MouseItem, vtRect.Left + ACol * DItemGrid.ColWidth, vtRect.Top + +(ARow + 1) * DItemGrid.RowHeight, True, 1, False, False, True);
      end
      else begin
        g_boShowHeroBagInfo := True;
      end;
    end
    else begin
      g_boShowHeroBagInfo := False;
      g_MouseItem.S.Name := '';
      DScreen.ClearHint;
      HintWindows.Clear;
    end;
  end;
end;

procedure TSerialWindows.DHeroItemGridGridSelect(Sender:TObject; ACol, ARow:Integer; Button:TMouseButton; Shift:TShiftState);
var
  where, nIdx, nC:Integer;
  temp:TClientItem;
  DItemGrid:TDxImageGrid;
  flag:Boolean;
  I, WantUseToIndex:Integer;
begin
  if g_MyHero = nil then
    Exit;
  DItemGrid := TDxImageGrid(Sender);
  nIdx := ACol + ARow * DItemGrid.ColCount;
  if nIdx in [0..MAX_HERO_BAG_ITEM - 1] then begin
    if mbRight = Button then begin
      if g_ClientConfig.boBagRightkey then begin // 右键穿装备
        where := GetTakeOnPosition(g_HeroItemArr[nIdx].S.StdMode, g_HeroItemArr[nIdx].S.Shape);

        if (g_WaitingHeroUseItem.Item.s.Name = '') and (g_HeroItemArr[nIdx].S.Name <> '') then begin
          if ((g_HeroItemArr[nIdx].S.OverLap = 0) or (g_HeroItemArr[nIdx].S.OverLap and 1 <> 0)) then begin
            flag := False;
            case where of
              U_DRESS, U_FASHIONDRESS:begin
                  if (where = U_FASHIONDRESS) and (g_ClientConfig.boUseOldSerialWindows) then
                    Exit;

                  {
                  case g_MyHero.m_btSex of
                    0:
                      begin
                        if not (g_HeroItemArr[nIdx].S.StdMode in [10, 66]) then
                        begin
                          //DScreen.AddChatBoardString('非男性用品', clRed, clWhite);
                          Exit;
                        end;
                      end;
                    1:
                      begin
                        if not (g_HeroItemArr[nIdx].S.StdMode in [11, 67]) then
                        begin
                          //DScreen.AddChatBoardString('非女性用品', clRed, clWhite);
                          Exit;
                        end;
                      end;
                  end;
                  }

                  flag := True;
                end;
              U_WEAPON:
                flag := True;
              U_NECKLACE:
                flag := True;
              U_RIGHTHAND:
                flag := True;
              U_HELMET:
                flag := True;
              U_RINGR, U_RINGL:
                flag := True;
              U_ARMRINGR, U_ARMRINGL:
                flag := True;
              U_BUJUK:
                flag := True;
              U_BELT:
                flag := True;
              U_BOOTS:
                flag := True;
              U_CHARM:
                flag := True;
              U_HAT:
                flag := True;
              U_DRUM:
                flag := (not g_ClientConfig.boUseOldSerialWindows);
              U_HORSE:
                flag := True;
              U_SHIELD:
                flag := True; // 盾牌 chongchong 2013-09-16
              U_JADE:
                flag := (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONWEAPON:
                flag := (not g_ClientConfig.boUseOldSerialWindows);

              U_FASHIONNECKLACE:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONHELMET:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONARMRINGR, U_FASHIONARMRINGL:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONRINGL:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONRIGHTHAND:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONBELT:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONBOOTS:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONCHARM:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            end;
            if flag then begin
              if where in [U_RINGR, U_RINGL] then begin
                if (g_HeroUseItems[U_RINGR].S.Name = '') then
                  where := U_RINGR;
                if g_HeroUseItems[U_RINGL].S.Name = '' then
                  where := U_RINGL;
                if (g_HeroUseItems[U_RINGR].S.Name <> '') and (g_HeroUseItems[U_RINGL].S.Name <> '') then begin
                  // 修复英雄右击戴戒指只穿右边，不戴左边 chongchong 2013-11-11
                  if FIsRingLeft then
                    where := U_RINGL
                  else
                    where := U_RINGR;
                  FIsRingLeft := not FIsRingLeft;
                end;
              end;

              if where in [U_ARMRINGR, U_ARMRINGL] then begin
                if g_HeroItemArr[nIdx].S.StdMode = 25 then
                  where := U_ARMRINGL
                else begin
                  if g_HeroUseItems[U_ARMRINGR].S.Name = '' then
                    where := U_ARMRINGR;
                  if g_HeroUseItems[U_ARMRINGL].S.Name = '' then
                    where := U_ARMRINGL;
                  if (g_HeroUseItems[U_ARMRINGR].S.Name <> '') and (g_HeroUseItems[U_ARMRINGL].S.Name <> '') then begin
                    // 修复英雄右击戴手镯只穿右边，不戴左边 chongchong 2013-11-11
                    if FIsArmRingLeft then
                      where := U_ARMRINGL
                    else
                      where := U_ARMRINGR;
                    FIsArmRingLeft := not FIsArmRingLeft;
                  end;
                end;
              end;

              if where in [U_FASHIONRINGR, U_FASHIONRINGL] then begin
                if (g_HeroUseItems[U_FASHIONRINGR].S.Name = '') then
                  where := U_FASHIONRINGR;
                if g_HeroUseItems[U_FASHIONRINGL].S.Name = '' then
                  where := U_FASHIONRINGL;
                if (g_HeroUseItems[U_FASHIONRINGR].S.Name <> '') and (g_HeroUseItems[U_FASHIONRINGL].S.Name <> '') then begin
                  // 修复双击戴戒指只穿右边，不戴左边 chongchong 2013-11-11
                  if FIsFashionRingLeft then
                    where := U_FASHIONRINGL
                  else
                    where := U_FASHIONRINGR;
                  FIsFashionRingLeft := not FIsFashionRingLeft;
                end;
              end;

              if where in [U_FASHIONARMRINGR, U_FASHIONARMRINGL] then begin
                if g_HeroUseItems[U_FASHIONARMRINGR].S.Name = '' then
                  where := U_FASHIONARMRINGR;
                if g_HeroUseItems[U_FASHIONARMRINGL].S.Name = '' then
                  where := U_FASHIONARMRINGL;
                if (g_HeroUseItems[U_FASHIONARMRINGR].S.Name <> '') and (g_HeroUseItems[U_FASHIONARMRINGL].S.Name <> '') then begin
                  if FIsFashionArmRingLeft then
                    where := U_FASHIONARMRINGL
                  else
                    where := U_FASHIONARMRINGR;
                  FIsFashionArmRingLeft := not FIsFashionArmRingLeft;
                end;
              end;
              g_WaitingHeroUseItem.Index := where;
              g_WaitingHeroUseItem.Item := g_HeroItemArr[nIdx];
              g_WaitingHeroUseItem.ItemType := mtHeroBagItem;
              g_boItemMoving := False;
              g_HeroItemArr[nIdx].S.Name := '';
              frmMain.SendHeroTakeOnItem(where, g_WaitingHeroUseItem.Item.MakeIndex, g_WaitingHeroUseItem.Item.S.Name);
              ItemClickSound(g_HeroItemArr[nIdx].S);
            end;
          end
          else if (g_MyHero.m_nJewelryBoxStatus = jbsOpen) and (g_HeroItemArr[nIdx].S.OverLap and 2 <> 0)
            //HZQ 20230525 右戒指笔误
          and (where in [U_HELMET {头盔}, U_NECKLACE {项链}, U_ARMRINGL {左手镯}, U_ARMRINGR {右手镯}, U_RINGL {左戒指}, U_RINGR {右戒指}]) then begin
            if (g_HeroItemArr[nIdx].S.Expand1 = 0) or (g_HeroItemArr[nIdx].S.Expand1 = 7) then begin
              WantUseToIndex := 0;
              for I := Low(g_HeroJewelryBoxItems) to High(g_HeroJewelryBoxItems) do begin
                if g_HeroJewelryBoxItems[I].S.Name = '' then begin
                  WantUseToIndex := I;
                  Break;
                end;
              end;
            end else if g_HeroItemArr[nIdx].S.Expand1 in [1..6] then begin
              WantUseToIndex := g_ItemArr[nIdx].S.Expand1 - 1;
            end else begin
              WantUseToIndex := -1; //HZQ
            end;
            //HZQ 20230519 处理WantUseToIndex的问题
            if WantUseToIndex >= 0 then begin
              g_WaitingHeroUseItem.Item := g_HeroItemArr[nIdx];
              g_WaitingHeroUseItem.Index := WantUseToIndex;
              g_HeroItemArr[nIdx].S.Name := '';
              frmMain.SendHeroTakeOnJewelry(WantUseToIndex, g_WaitingHeroUseItem.Item.MakeIndex, g_WaitingHeroUseItem.Item.S.Name);
            end;
          end
          else if g_MyHero.m_boShowGodBless and (g_HeroItemArr[nIdx].S.OverLap and 4 <> 0) then begin
            if g_HeroItemArr[nIdx].S.Expand1 = 13 then begin
              WantUseToIndex := -1;
              for I := Low(g_GodBlessItems) to High(g_GodBlessItems) do begin
                if (g_GodBlessItems[I].S.Name = '') and (g_HeroGodBlessItemsState[I] = 1) then begin
                  WantUseToIndex := I;
                  Break;
                end;
              end;

              if WantUseToIndex = -1 then begin
                for I := Low(g_GodBlessItems) to High(g_GodBlessItems) do begin
                  if g_HeroGodBlessItemsState[I] = 1 then begin
                    WantUseToIndex := I;
                    Break;
                  end;
                end;
              end;

              if WantUseToIndex >= 0 then begin
                g_WaitingHeroUseItem.Item := g_HeroItemArr[nIdx];
                g_WaitingHeroUseItem.Index := WantUseToIndex;
                g_HeroItemArr[nIdx].S.Name := '';
                frmMain.SendTakeOnGodBless(True, WantUseToIndex, g_WaitingHeroUseItem.Item.MakeIndex, g_WaitingHeroUseItem.Item.S.Name);
              end;
            end
            else if g_HeroItemArr[nIdx].S.Expand1 in [1..12] then begin
              if (g_HeroGodBlessItemsState[g_HeroItemArr[nIdx].S.Expand1 - 1] = 1) then begin
                WantUseToIndex := g_HeroItemArr[nIdx].S.Expand1 - 1;

                g_WaitingHeroUseItem.Item := g_HeroItemArr[nIdx];
                g_WaitingHeroUseItem.Index := WantUseToIndex;
                g_HeroItemArr[nIdx].S.Name := '';
                frmMain.SendTakeOnGodBless(True, WantUseToIndex, g_WaitingHeroUseItem.Item.MakeIndex, g_WaitingHeroUseItem.Item.S.Name);
              end;
            end;
          end;

        end;
      end
        // 设置准星光标 宝石镶嵌 chongchong 2015-01-04
      else if (g_HeroItemArr[nIdx].S.StdMode = 47) and (g_HeroItemArr[nIdx].S.Shape in [50, 51]) and (g_HeroItemArr[nIdx].S.Name <> '') then begin
        g_FluteItem_UseBS := g_HeroItemArr[nIdx];
        g_boMySelItemCursorFromFluteStone := False;
        g_boMySelItemCursorFromHero := True;
        FrmMain.Cursor := crMySelItem;
      end
      else begin
        if not g_boItemMoving then begin
          // 鼠标右键点击[英雄背包]中的物品将该物品放入[人物背包]中。
          if (g_WaitingUseItem.Item.s.Name = '') and (g_HeroItemArr[nIdx].S.Name <> '') then begin
            g_WaitingUseItem.Item := g_HeroItemArr[nIdx];
            g_WaitingUseItem.ItemType := mtHeroBagItem;
            g_WaitingUseItem.Index := nIdx;
            g_HeroItemArr[nIdx].S.Name := '';
            g_MovingItem.Item.S.Name := '';
            g_boItemMoving := False;
            frmMain.SendHeroBagToMasterBag(g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.s.Name);
            ItemClickSound(g_HeroItemArr[nIdx].S);
          end;
        end;
      end;

      Exit;
    end;

    if not g_boItemMoving then begin
      if g_HeroItemArr[nIdx].S.Name <> '' then begin
        if (FrmMain.Cursor = crMySelItem) then begin
          if not g_boMySelItemCursorFromHero then begin
            g_FluteItem_UseBS.s.Name := '';
            FrmMain.Cursor := GetDefaultCursor;
            Exit;
          end;

          if (not g_boMySelItemCursorFromFluteStone) then begin
            if (g_FluteItem_UseBS.s.Name <> '') and (g_FluteItem_UseBS.S.StdMode = 47) and (g_FluteItem_UseBS.S.Shape in [50, 51]) then begin
              FrmMain.SendBagUseMode47Item(g_HeroItemArr[nIdx].MakeIndex, g_FluteItem_UseBS.MakeIndex, True);
            end;
            FrmMain.Cursor := GetDefaultCursor;

            Exit;
          end;
        end;
      end
      else if (FrmMain.Cursor = crMySelItem) and (not g_boMySelItemCursorFromHero) then begin
        g_FluteItem_UseBS.s.Name := '';
        FrmMain.Cursor := GetDefaultCursor;
        Exit;
      end;

      if (ssShift in Shift) and IsUnOverLapItem(@g_HeroItemArr[nIdx]) then begin
        if (g_WaitingHeroUseItem.Item.s.Name = '') then begin
          DMessageDlg('请输入要拆分的数量：', [mbOk, mbAbort]);
          nC := StrToIntDef(Trim(DlgEditText), -1);
          if nC > 0 then begin
            g_WaitingHeroUseItem.ItemType := mtHeroBagItem;
            g_WaitingHeroUseItem.Index := nIdx;
            g_WaitingHeroUseItem.Item := g_HeroItemArr[nIdx];
            g_HeroItemArr[nIdx].S.Name := '';
            frmMain.SendHeroPackageItem(g_WaitingHeroUseItem.Item.MakeIndex, nC, g_WaitingHeroUseItem.Item.S.Name);
          end;
        end;
        Exit;
      end;

      if g_HeroItemArr[nIdx].S.Name <> '' then begin
        g_dwMoveItemTick := MyGetTickCount;
        g_boItemMoving := True;
        g_MovingItem.Index := nIdx;
        g_MovingItem.Item := g_HeroItemArr[nIdx];
        g_MovingItem.ItemType := mtHeroBagItem;
        g_HeroItemArr[nIdx].S.Name := '';
        ItemClickSound(g_HeroItemArr[nIdx].S);
      end;
    end
    else begin
      // 不让自定义Ok框的物品放到英雄包裹 chongchong 2013-11-13
      if g_MovingItem.ItemType in [mtUseItem, mtBagGold, mtDealGold, mtDealItem, mtItemBoxItem, mtJewelryItem, mtGodBlessItem] then
        Exit;

      if g_MovingItem.ItemType = mtHeroUseItem then begin
        if (g_WaitingHeroUseItem.Item.s.Name = '') then begin
          g_WaitingHeroUseItem := g_MovingItem;
          frmMain.SendHeroTakeOffItem(-(g_MovingItem.Index + 1), g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';

          g_boItemMoving := False;
        end;
      end
      else if g_MovingItem.ItemType = mtBagItem then begin // 主人包裹到英雄包裹
        if (g_WaitingUseItem.Item.s.Name = '') then begin
          g_WaitingUseItem := g_MovingItem;
          frmMain.SendMasterBagToHeroBag(g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';

          g_boItemMoving := False;
        end;
      end
      else if g_MovingItem.ItemType = mtHeroJewelryItem then begin
        if g_WaitingHeroUseItem.Item.s.Name = '' then begin
          g_WaitingHeroUseItem := g_MovingItem;
          frmMain.SendHeroTakeOffJewelry(g_MovingItem.Index, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end
      else if g_MovingItem.ItemType = mtHeroGodBlessItem then begin
        if g_WaitingHeroUseItem.Item.s.Name = '' then begin
          g_WaitingHeroUseItem := g_MovingItem;
          frmMain.SendTakeOffGodBless(True, g_MovingItem.Index, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end
      else begin
        if g_HeroItemArr[nIdx].S.Name <> '' then begin
          if (g_MovingItem.ItemType = mtHeroBagItem) and IsOverLapItem(@g_HeroItemArr[nIdx], @g_MovingItem.Item) then begin // 开始重叠物品
            if (g_WaitingHeroUseItem.Item.s.Name = '') then begin
              g_WaitingHeroUseItem := g_MovingItem;
              g_MovingItem.Item.S.Name := '';

              g_boItemMoving := False;
              frmMain.SendHeroOverLapItem(g_WaitingHeroUseItem.Item.MakeIndex, g_HeroItemArr[nIdx].MakeIndex, g_WaitingHeroUseItem.Item.s.Name);
            end;
          end
          else begin
            temp := g_HeroItemArr[nIdx];
            g_HeroItemArr[nIdx] := g_MovingItem.Item;
            g_MovingItem.Index := nIdx;
            g_MovingItem.Item := temp;
          end;
        end
        else begin
          g_HeroItemArr[nIdx] := g_MovingItem.Item;
          g_MovingItem.Item.S.Name := '';

          g_boItemMoving := False;
        end;
      end;
    end;
  end;
  ArrangeHeroItembag;
end;

