// 给所有控件设置提示信息

procedure TSerialWindows.IntControlsHintEvent(DxControl:TDxControl);
var
  I:Integer;
begin
  if DxControl = nil then
    Exit;

  if DxControl is TDxImageButton then
    DxControl.OnMouseMove := DBottomShowHintMouseMove
  else if (DxControl is TDxImageForm) or (DxControl is TDxImageFormShape) then
    DxControl.OnMouseMove := DMouseMoveClearHints;

  if DxControl.ComponentCount > 0 then begin
    for I := 0 to DxControl.ComponentCount - 1 do begin
      IntControlsHintEvent(DxControl.Components[I]);
    end;
  end;
end;

procedure TSerialWindows.CopySameNameControl(dxcDest, dxcSrc:TDxcontrol);
var
  i, j:Integer;
  SrcCtrl, DestCtrl:TDxControl;
  lstDest, lstSrc:TList;
begin
  lstDest := TList.Create;
  lstSrc := TList.Create;

  lstDest.Add(dxcDest);
  GetAllSubComponents(dxcDest, lstDest);

  lstSrc.Add(dxcSrc);
  GetAllSubComponents(dxcSrc, lstSrc);

  for I := 0 to lstDest.Count - 1 do begin
    DestCtrl := lstDest.Items[I];
    for J := 0 to lstSrc.Count - 1 do begin
      SrcCtrl := lstSrc.Items[J];
      if SameText(DestCtrl.Name + '2', SrcCtrl.Name) then begin
        DestCtrl.Assign(SrcCtrl);
        // 修正开启微端1920*1080进入游戏后，小退换1024*768后显示错误 2020-04-18 19:12:57
        DestCtrl.Left := SrcCtrl.Left;
        DestCtrl.Top := SrcCtrl.Top;
        DestCtrl.Width := SrcCtrl.Width;
        DestCtrl.Height := SrcCtrl.Height;
        Break;
      end;
    end;
  end;

  lstDest.Free;
  lstSrc.Destroy;
end;

