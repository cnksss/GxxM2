function TSerialWindows.GetLastHistroySendSay:string;
begin
  Result := '';
  if FHistroySendSayList.Count > 0 then begin
    FHistroySendSayListIndex := FHistroySendSayList.Count - 1;
    Result := FHistroySendSayList[FHistroySendSayListIndex];
  end;
end;

function TSerialWindows.GetPreHistroySendSay:string;
begin
  Result := '';
  if FHistroySendSayListIndex = -1 then begin
    if FHistroySendSayList.Count > 0 then begin
      FHistroySendSayListIndex := FHistroySendSayList.Count - 1;
      Result := FHistroySendSayList[FHistroySendSayListIndex];
    end;
    Exit;
  end;

  if (FHistroySendSayList.Count > 0) then begin
    if (FHistroySendSayListIndex > 0) then
      FHistroySendSayListIndex := FHistroySendSayListIndex - 1;

    if FHistroySendSayList.Count > FHistroySendSayListIndex then
      Result := FHistroySendSayList[FHistroySendSayListIndex];
  end;
end;

function TSerialWindows.GetNextHistroySendSay:string;
begin
  Result := '';

  if FHistroySendSayListIndex = -1 then begin
    if FHistroySendSayList.Count > 0 then begin
      FHistroySendSayListIndex := FHistroySendSayList.Count - 1;
      Result := FHistroySendSayList[FHistroySendSayListIndex];
    end;
    Exit;
  end;

  if (FHistroySendSayList.Count > 0) then begin
    if (FHistroySendSayList.Count > FHistroySendSayListIndex + 1) then
      FHistroySendSayListIndex := FHistroySendSayListIndex + 1
    else
      FHistroySendSayListIndex := FHistroySendSayList.Count - 1;

    if FHistroySendSayList.Count > FHistroySendSayListIndex then
      Result := FHistroySendSayList[FHistroySendSayListIndex];
  end;
end;

