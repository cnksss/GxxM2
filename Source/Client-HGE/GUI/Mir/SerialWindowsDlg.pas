procedure TSerialWindows.DRegExitClick(Sender:TObject; X, Y:Integer);
begin
  CloseDRegAccount;
  OpenDLoginDlg;
end;

procedure TSerialWindows.DBindPhoneOKClick(Sender:TObject; X, Y:Integer);
begin
  frmMain.SendBindPhone(DEdBindPhone.Text, DEdBindPhoneCode.Text);
end;

procedure TSerialWindows.DMultiShowClick(Sender:TObject; X, Y:Integer);
begin
  DMultiDlg.Visible := True;
end;

procedure TSerialWindows.DMultiHideClick(Sender:TObject; X, Y:Integer);
begin
  DMultiDlg.Visible := False;
  DMultiShow.Left := DMultiDlg.Left;
  DMultiShow.Top := DMultiDlg.Top;
  DMultiShow.VisiBle := True;
end;

end.
