    g_DrinkItems[g_nSelectWineIndex] := True;
  Dec(g_nWineMatCount);
  g_nSelectWineIndex := -1; // 选择的酒的序号
  g_boSelfSelectWine := False;
  g_boNpcSelectWine := False;
  frmMain.SendClientMessage(CM_SENDDRINK, g_nCurMerchant, 0, 0, 0);
end;

procedure TSerialWindows.GuessfingerOK; // 猜拳动作播放完成
begin
  if g_nGuessfingerResult = 1 then begin // Npc赢了 开始选酒
    g_boNpcSelectWine := True;
    g_boSelfSelectWine := False;
    g_nSelectWineIndex := 0; // NPC选酒序号
    g_nNpcSelectWineTime := g_nWineMatCount * 2;
  end
  else if g_nGuessfingerResult = 0 then begin // 自己赢了 开始选酒
    g_boSelfSelectWine := True;
    g_boNpcSelectWine := False;
  end
  else begin // 平局
    g_nSelectWineIndex := -1;
    g_boSelfSelectWine := False;
    g_boNpcSelectWine := False;
  end;

  DGuessResultDlg.Visible := False;
end;

