    D := GameImages.Images[Index];
    if (D <> nil) and (D.Width > 4) and (D.Height > 4) then begin
      nX := (Button.Width - D.Width) div 2;
      nY := (Button.Height - D.Height) div 2;

      GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + nY, D);
