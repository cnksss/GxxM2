procedure TSerialWindows.DSellPlayerItemGridPaint(Sender:TObject; ACol, ARow:Integer; Rect:TRect; State:TGridDrawState);
var
  nIdx:Integer;
  DItemGrid:TDxImageGrid;
  R:TRect;
  Item:PTClientItem;
  d:TTexture;
begin
  DItemGrid := TDxImageGrid(Sender);
  nIdx := ACol + ARow * DItemGrid.ColCount;
  if nIdx in [0..DItemGrid.ColCount * DItemGrid.RowCount - 1] then begin
    nIdx := nIdx + FViewSellPlayerBagPage * DItemGrid.ColCount * DItemGrid.RowCount; //MAX_EXT_ONE_PAGE_ITEM_COUNT
    R := Bounds(Rect.Left, Rect.Top, DItemGrid.ColWidth, DItemGrid.RowHeight);

    if (nIdx < Length(g_SellPlayerItemArr)) then begin
      Item := @g_SellPlayerItemArr[nIdx];

      DrawGridItem(R, Item, @g_SellPlayerItemArrEffect[nIdx]);
    end
    else begin
      if nIdx >= DEF_MAX_BAG_ITEM + FViewSellPlayerExtBagOpenItemCount then begin
        d := g_WNewopUIImages.Images[1636];
        if d <> nil then
          GameCanvas.Draw(R.Left + ((R.Right - R.Left) - d.Width) div 2, R.Top + ((R.Bottom - R.Top) - d.Height) div 2, d.ClientRect, d);
        Exit;
      end;
    end;
  end;
end;

procedure TSerialWindows.DSellPlayerItemGridMouseMove(Sender:TObject; ACol, ARow:Integer; Shift:TShiftState);
var
  nIdx:Integer;
  vtRect:TRect;
  DItemGrid:TDxImageGrid;
begin
  DItemGrid := TDxImageGrid(Sender);
  nIdx := ACol + ARow * DItemGrid.ColCount;
  nIdx := nIdx + FViewSellPlayerBagPage * DItemGrid.ColCount * DItemGrid.RowCount; // MAX_EXT_ONE_PAGE_ITEM_COUNT

  if (nIdx >= 0) and (nIdx < DEF_MAX_BAG_ITEM + FViewSellPlayerExtBagOpenItemCount) and (nIdx < Length(g_SellPlayerItemArr)) and (g_SellPlayerItemArr[nIdx].S.Name <> '') then begin
    if (g_ClientConfig.btSuspensionShowItem > 0) or (g_ClientVersion > cvSerial) then begin
      vtRect := DItemGrid.VirtualRect;
      ShowMouseItemInfo(g_MySelf, @g_SellPlayerItemArr[nIdx], vtRect.Left + ACol * DItemGrid.ColWidth, vtRect.Top + +(ARow + 1) * DItemGrid.RowHeight, True, 0, False, False, True);
    end;
  end
  else begin
    DScreen.ClearHint;
    HintWindows.Clear;
  end;
end;

procedure TSerialWindows.OpenViewSellPlayerStorage(Header:PTSellPlayerStorageViewHeader; HeaderExt:PTSellPlayerStorageExtViewHeader);
begin
  if Header <> nil then begin
    if Header.IsBeginShow then
      DSellPlayerBaseStorageViewDlg.Visible := True;

    FSellPlayerViewStorageName := Header.sName;
    DlblSellPlayerBaseStorageUserName.Caption := StringReplace(FlblSellPlayerBaseStorageUserName_Text, '<$name>', Header.sName, [rfIgnoreCase]);

    DSellPlayerBaseStorageItemCount.Caption := Format('%d/%d', [Header.Count, Header.MaxCount]);

    DBtnSellPlayerBaseStoragePage1.ImageIndex.Up := FSellPalayerBaseStoragePages_ImageIndex[0];
    DBtnSellPlayerBaseStoragePage2.ImageIndex.Up := FSellPalayerBaseStoragePages_ImageIndex[1];
    DBtnSellPlayerBaseStoragePage3.ImageIndex.Up := FSellPalayerBaseStoragePages_ImageIndex[2];
    DBtnSellPlayerBaseStoragePage4.ImageIndex.Up := FSellPalayerBaseStoragePages_ImageIndex[3];

    DBtnSellPlayerBaseStoragePage1.Enabled := Header.StorageOpen[0];
    DBtnSellPlayerBaseStoragePage2.Enabled := Header.StorageOpen[1];
    DBtnSellPlayerBaseStoragePage3.Enabled := Header.StorageOpen[2];
    DBtnSellPlayerBaseStoragePage4.Enabled := Header.StorageOpen[3];

    if Header.Page = 1 then
      DBtnSellPlayerBaseStoragePage1.ImageIndex.Up := DBtnSellPlayerBaseStoragePage1.ImageIndex.Down
    else if Header.Page = 2 then
      DBtnSellPlayerBaseStoragePage2.ImageIndex.Up := DBtnSellPlayerBaseStoragePage2.ImageIndex.Down
    else if Header.Page = 3 then
      DBtnSellPlayerBaseStoragePage3.ImageIndex.Up := DBtnSellPlayerBaseStoragePage3.ImageIndex.Down
    else if Header.Page = 4 then
      DBtnSellPlayerBaseStoragePage4.ImageIndex.Up := DBtnSellPlayerBaseStoragePage4.ImageIndex.Down
  end
  else if HeaderExt <> nil then begin
    if HeaderExt.IsBeginShow then
      DSellPlayerStorageViewDlg.Visible := True;

    FSellPlayerViewStorageExtName := HeaderExt.sName;

    DlblSellPlayerStorageUserName.Caption := StringReplace(FlblSellPlayerStorageUserName_Text, '<$name>', HeaderExt.sName, [rfIgnoreCase]);

    if HeaderExt.MaxPage = 0 then
      HeaderExt.MaxPage := 1;

    FSellPlayerStorageViewDlgCount := HeaderExt.Count;
    FSellPlayerStorageViewDlgMaxCount := HeaderExt.MaxCount;
    FSellPlayerStorageViewDlgPage := HeaderExt.Page - 1;
    FSellPlayerStorageViewDlgMaxPage := HeaderExt.MaxPage;

    DSellPlayerStorageItemPgTitle.Caption := Format('%d/%d页', [HeaderExt.Page, HeaderExt.MaxPage]);
    DSellPlayerStorageItemCountTitle.Caption := Format('%d/%d件', [HeaderExt.Count, HeaderExt.MaxCount]);

    DSellPlayerStorageItemPgUP.Enabled := HeaderExt.Page > 1;
    DSellPlayerStorageItemPgDown.Enabled := HeaderExt.Page <> HeaderExt.MaxPage;
  end;
end;

