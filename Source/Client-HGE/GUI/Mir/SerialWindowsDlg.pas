procedure TSerialWindows.UcEnterGameButtonClick(Sender:TObject; X, Y:Integer);
var
    s1, s2:string;
begin
    if not g_UserCenterManager.LoginIsBusy then begin
        if DUcLoginPageControl.ActivePageIndex = 0 then begin
            s1 := Trim(DUcAccountEdit.Text);
            s2 := Trim(DUcPasswordEdit.Text);
            if (s1 <> EmptyStr) and (s2 <> EmptyStr) then begin
                g_UserCenterManager.RequestAccountLogin(s1, s2, 0);
            end else begin
                UcShowHintDlg(5);
            end;
        end else if DUcLoginPageControl.ActivePageIndex = 1 then begin
            s1 := Trim(DUcPhoneNoEdit.Text);
            s2 := Trim(DUcPhoneVerifyCodeEdit.Text);
            if g_UserCenterManager.IsPhoneNumber(s1) and (s2 <> EmptyStr) then begin
                g_UserCenterManager.RequestPhoneLogin(s1, s2, 0);
            end else begin
                UcShowHintDlg(6);
            end;
        end;
    end else begin
        UcShowHintDlg(0);
    end;
end;

