procedure TSerialWindows.OpenDGuildApplyDlg;
var
  I:Integer;
  S, TempS, TempS2:WideString;
begin
  FrmDlg.ShowGuildListPage := 0;

  DGuildApplyDlg.Visible := True;
  DGuildApplyDlg.Left := (SCREENWIDTH - DGuildApplyDlg.Width) div 2;
  DGuildApplyDlg.Top := (SCREENHEIGHT - DGuildApplyDlg.Height) div 2;

  if Length(WantAddGuildName) > 0 then begin
    DGuildApplyDlgApply.Enabled := False;
    DGuildApplyDlgLabelStatus.Caption := '您正在向 ' + WantAddGuildName + ' 发起申请';
    DGuildApplyDlgCancel.Visible := True;
    DGuildApplyDlgLabelStatus.Visible := True;
  end
  else begin
    DGuildApplyDlgApply.Enabled := True;
    DGuildApplyDlgCancel.Visible := False;
    DGuildApplyDlgLabelStatus.Visible := False;
  end;

  if DGuildApplyDlgLabel1.Tag = 0 then begin
    DGuildApplyDlgLabel1.Tag := 1;
    DGuildApplyDlgLabel1.Caption := StringReplace(DGuildApplyDlgLabel1.Caption, sLineBreak, '', [rfReplaceAll]);
    DGuildApplyDlgLabel1.Caption := StringReplace(DGuildApplyDlgLabel1.Caption, '<$SERVERNAME>', g_sServerName, [rfIgnoreCase, rfReplaceAll]);
    S := DGuildApplyDlgLabel1.Caption;
    TempS := '';
    TempS2 := '';
    if Length(S) > 0 then begin
      for I := 1 to Length(S) do begin
        TempS := TempS + S[I];
        if CurrentFont.TextWidth(TempS) >= DGuildApplyDlgLabel1.Width - 12 then begin
          if I = Length(S) then
            TempS2 := TempS2 + TempS
          else
            TempS2 := TempS2 + TempS + sLineBreak;

          TempS := '';
        end;
      end;
      DGuildApplyDlgLabel1.Caption := TempS2 + TempS;
    end;
  end;

  RefreshShowGuildList;
end;

procedure TSerialWindows.RefreshShowGuildList;
var
  I, StartIndex, EndIndex, MaxPage:Integer;
  ListItem:TDxListItem;
  ViewItem:pTViewItem;
  GuildInfo:PShowGuildInfo;
  PageCount:Integer;
begin
  DGuildApplyDlgListView.Clear;
  if ShowGuildList.Count = 0 then
    Exit;

  DGuildApplyDlgListView.Lock;
  try
    PageCount := DGuildApplyDlgListView.ShowItemCount;
    if PageCount <= 0 then
      PageCount := 9;

    MaxPage := (ShowGuildList.Count + PageCount - 1) div PageCount - 1;

    if MaxPage < 0 then
      Exit;

    if ShowGuildListPage < 0 then
      ShowGuildListPage := 0
    else if ShowGuildListPage >= MaxPage then
      ShowGuildListPage := MaxPage;

    StartIndex := ShowGuildListPage * PageCount;
    EndIndex := Min(StartIndex + PageCount - 1, ShowGuildList.Count - 1);
    for I := StartIndex to EndIndex do begin
      GuildInfo := ShowGuildList.ShowGuild[I];

      ListItem := DGuildApplyDlgListView.Add;

      ViewItem := ListItem.AddItem('', nil);
      ViewItem.Caption := GuildInfo.GuildName;
      ViewItem.Data := GuildInfo;
      ViewItem.Style := bsButton;
      ViewItem.Alignment := taLeftJustify;
      ViewItem.Color.Up.Color := clWhite;
      ViewItem.Color.Hot.Color := clYellow;
      ViewItem.Color.Down.Color := clRed;

      ViewItem := ListItem.AddItem('', nil);

      if GuildInfo.Count = 0 then
        ViewItem.Caption := '-/-'
      else
        ViewItem.Caption := IntToStr(GuildInfo.OnlineCount) + '/' + IntToStr(GuildInfo.Count);

      ViewItem.Data := GuildInfo;
      ViewItem.Style := bsButton;
      ViewItem.Alignment := taCenter;
      ViewItem.Color.Up.Color := clWhite;
      ViewItem.Color.Hot.Color := clWhite;
      ViewItem.Color.Down.Color := clWhite;

      ViewItem := ListItem.AddItem('', nil);
      ViewItem.Caption := '查看详情';
      ViewItem.Data := GuildInfo;
      ViewItem.Style := bsButton;
      ViewItem.Alignment := taLeftJustify;
      ViewItem.Color.Up.Color := clLime;
      ViewItem.Color.Hot.Color := clYellow;
      ViewItem.Color.Down.Color := clRed;
    end;
  finally
    DGuildApplyDlgListView.UnLock;
  end;
end;

