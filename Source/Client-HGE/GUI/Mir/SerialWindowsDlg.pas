procedure TSerialWindows.LoadFromStream(MemoryStream:TMemoryStream);
var
  nError, I, J, Index:Integer;
  ControlAddress:Pointer;
  DxControl:TDxControl;
  R:TRect;
  GroupChatRightSpace:Integer;
  ChatMemoRightSpace:Integer;
  EditChatRightSpace:Integer;
  ChangeChatHeightRightSpace:Integer;
  AddHeight:Integer;
  ItemGroup:TItemGroup;
  Token:PFmtToken;
  lx, ly, nSpace:Integer;
  ControlAddrList:THashedStringList;
  msDefaultUI:TMemoryStream;
begin
  // try
  nError := 0;  

  msDefaultUI := LoadDxControlEx.LoadCompressedUIData('MIR_UI', 'ZDAT'); //必须存在，否则报错
  ControlAddrList := Self.MakeControlAddrList;
  try
     LoadDxControlEx.LoadControlFromStream(MemoryStream, DBackground, ControlAddrList, 'Mir');
     LoadDxControlEx.PatchLoadControlFromStream(msDefaultUI, DBackground, ControlAddrList, 'Mir');
  finally
     msDefaultUI.Free;
     ControlAddrList.Free;
  end;

  IntControlsHintEvent(DBackground);

  // ------------------------------------------------------------------------------

  DEdId := DEdId_;
  DEdPasswd := DEdPasswd_;
  DEdNewId := DEdNewId_;
  DEdConfirm := DEdConfirm_;
  DEdChgId := DEdChgId_;
  DEdChrName := DEdChrName_;
  DscStart := DscStart_;
  DEdChat := DEdChat_;
  //DMinMapDlg := DMinMapDlg_;
  DGuildDlg := DGuildDlg_;
  DChatMemo := DChatMemo_;
  DWhisperMemo := DWhisperMemo_;
  DCheckBoxAutoAnswersWhisper := DCheckBoxAutoAnswersWhisperMsg;
  DEditAutoAnswersWhisper := DEditAutoAnswersWhisperMsg;
