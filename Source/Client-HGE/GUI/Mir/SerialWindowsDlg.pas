  end;
end;

procedure TSerialWindows.OpenDStorageViewDlg(Merchant:Int64; IsTakeBackItem:Boolean; ResetPosition, IsStorageViewDlgIsExt:Boolean; PosX:Integer; PosY:Integer);
begin
  inherited;

  FStorageViewDlgMerchant := Merchant;

  menuindex := -1;
  DSellDlg.Visible := False;
  DMenuDlg.Visible := False;
  MenuTop := 0;

  if not IsTakeBackItem then begin
    // 可视化仓库打开时不关闭npc对话框 chongchong 2019-04-28 00:03:52
    //DMerchantDlg.Close;

    if not g_ClientConfig.boHeroStateDlgNoMove then begin
      if (DHeroStateDlg185 <> nil) and DHeroStateDlg185.Visible then
        DHeroStateDlg185.Left := 0;

      if (DHeroStateDlg <> nil) and DHeroStateDlg.Visible then
        DHeroStateDlg.Left := 0;
    end;

    DItemBag.Left := SCREENWIDTH - DItemBag.Width - 10;
    DItemBag.Top := 90;
  end;

  DItemBag.Visible := True;
  DItemGrid.BringToFront;

  LastestClickTime := MyGetTickCount;

  if IsStorageViewDlgIsExt then begin
    DBaseStorageViewDlg.Visible := False;

    if ResetPosition then begin
      if (PosX <> 0) or (PosY <> 0) then begin
        DStorageViewDlg.Left := PosX;
        DStorageViewDlg.Top := PosY;
      end
      else begin
        DStorageViewDlg.Left := 0;
        DStorageViewDlg.Top := 10;
      end;
    end;

    DStorageViewDlg.Visible := True;
  end
  else begin
    DStorageViewDlg.Visible := False;

    if ResetPosition then begin
      if (PosX <> 0) or (PosY <> 0) then begin
        DBaseStorageViewDlg.Left := PosX;
        DBaseStorageViewDlg.Top := PosY;
      end
      else begin
        DBaseStorageViewDlg.Left := 0;
        DBaseStorageViewDlg.Top := 10;
      end;
    end;

    DBaseStorageViewDlg.Visible := True;
  end;
end;

procedure TSerialWindows.RefrshDStorageViewDlgText(IsStorageViewDlgIsExt:Boolean; ACount, AMaxCount, APage, AMaxPage:Integer);
begin
  inherited;
  if AMaxPage = 0 then
    AMaxPage := 1;

  if IsStorageViewDlgIsExt then begin
    DStorageItemPgTitle.Caption := Format('%d/%d页', [APage, AMaxPage]);
    DStorageItemCountTitle.Caption := Format('%d/%d件', [ACount, AMaxCount]);

    DStorageItemPgUP.Enabled := APage <> 1;
    DStorageItemPgDown.Enabled := APage <> AMaxPage;
  end
  else begin
    DBaseStorageItemCount.Caption := Format('%d/%d', [ACount, AMaxCount]);
    RefrshDStorageOpen;

    DButtonDBaseStoragePage1.ImageIndex.Up := DButtonDBaseStoragePages_ImageIndex[0];
    DButtonDBaseStoragePage2.ImageIndex.Up := DButtonDBaseStoragePages_ImageIndex[1];
    DButtonDBaseStoragePage3.ImageIndex.Up := DButtonDBaseStoragePages_ImageIndex[2];
    DButtonDBaseStoragePage4.ImageIndex.Up := DButtonDBaseStoragePages_ImageIndex[3];

    if not g_StorageOpenStatus[0] then
      DButtonDBaseStoragePage1.ImageIndex.Up := DButtonDBaseStoragePage1.ImageIndex.Disabled;
    if not g_StorageOpenStatus[1] then
      DButtonDBaseStoragePage2.ImageIndex.Up := DButtonDBaseStoragePage2.ImageIndex.Disabled;
    if not g_StorageOpenStatus[2] then
      DButtonDBaseStoragePage3.ImageIndex.Up := DButtonDBaseStoragePage3.ImageIndex.Disabled;
    if not g_StorageOpenStatus[3] then
      DButtonDBaseStoragePage4.ImageIndex.Up := DButtonDBaseStoragePage4.ImageIndex.Disabled;

    if APage = 1 then
      DButtonDBaseStoragePage1.ImageIndex.Up := DButtonDBaseStoragePage1.ImageIndex.Down
    else if APage = 2 then
      DButtonDBaseStoragePage2.ImageIndex.Up := DButtonDBaseStoragePage2.ImageIndex.Down
    else if APage = 3 then
      DButtonDBaseStoragePage3.ImageIndex.Up := DButtonDBaseStoragePage3.ImageIndex.Down
    else if APage = 4 then
      DButtonDBaseStoragePage4.ImageIndex.Up := DButtonDBaseStoragePage4.ImageIndex.Down
  end;
end;

