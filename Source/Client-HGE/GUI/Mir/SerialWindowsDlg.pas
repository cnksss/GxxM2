procedure TSerialWindows.SetHeroBagCount(BagCount:Integer);
begin
  if not g_ConfigClient.boCustomUI then begin
    if g_ClientVersion <> cvMirNewUI205 then begin
      case BagCount of
        10:begin
            DHeroItemBag.ImageIndex.Up := 375;
            DHeroItemGrid.RowCount := 2;
          end;
        20:begin
