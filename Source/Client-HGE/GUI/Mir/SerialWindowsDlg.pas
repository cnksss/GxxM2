procedure TSerialWindows.DBotWineMatDirectPaint(Sender:TObject);
var
  DxButton:TDxImageButton;
  Texture:TTexture;
  vtRect:TRect;
  BlendMode:Integer;
begin
  DxButton := TDxImageButton(Sender);
  if DxButton.Tag in [0, 1] then begin
    vtRect := DxButton.VirtualRect;
    if (DxButton.ImageIndex.Image <> nil) and (DxButton.ImageIndex.Up >= 0) then begin
      if g_BotWineMatMouseEnter[DxButton.Tag] then
        BlendMode := Blend_Bright
      else
        BlendMode := Blend_Default;

      Texture := DxButton.ImageIndex.Image.Images[DxButton.ImageIndex.Up];
      if Texture <> nil then begin

        if g_BotWineMatMouseEnter[DxButton.Tag] then
          GameCanvas.DrawColorAlpha(vtRect.Left + (DxButton.Width - Texture.Width) div 2, vtRect.Top + (DxButton.Height - Texture.Height) div 2, Texture, clWhite, 100, BlendMode)
        else
          GameCanvas.Draw(vtRect.Left + (DxButton.Width - Texture.Width) div 2, vtRect.Top + (DxButton.Height - Texture.Height) div 2, Texture, BlendMode);
      end;

      if g_PleaseDrinkItem[DxButton.Tag].S.Name <> '' then begin
        Texture := g_WBagItemImages.Images[g_PleaseDrinkItem[DxButton.Tag].S.looks];
        if Texture <> nil then begin
          if g_BotWineMatMouseEnter[DxButton.Tag] then
            GameCanvas.DrawColorAlpha(vtRect.Left + (DxButton.Width - Texture.Width) div 2, vtRect.Top + (DxButton.Height - Texture.Height) div 2, Texture, clWhite, 100, BlendMode)
          else
            GameCanvas.Draw(vtRect.Left + (DxButton.Width - Texture.Width) div 2, vtRect.Top + (DxButton.Height - Texture.Height) div 2, Texture, BlendMode);
        end;
      end;
    end;
  end;
end;

