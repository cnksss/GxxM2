procedure TSerialWindows.ChangePassWordOK();
var
  sAccount, sPassword, sNewPassword, sRepeatNewPassword, sL2Password, sRandomCode:string;
begin
  sAccount := DEdChgId.Text;
  sPassword := DEdChgCurrentpw.Text;
  sNewPassword := DEdChgNewPw.Text;
  sRepeatNewPassword := DEdChgRepeat.Text;
  sL2Password := DEdChgL2Pw.Text;
  sRandomCode := Trim(DEdRandCode.Text);

  if sNewPassword <> sRepeatNewPassword then begin
    DMessageDlg(DecodeResStr(SPasswordInptu2Msg), [mbOk]);
    DEdChgNewPw.SetFocus;
    Exit;
  end;

  if DEdRandCode.Enabled and (Length(sRandomCode) = 0) then begin
    DMessageDlg(DecodeResStr(SRandCodeEmptyMsg), [mbOk]);
    DEdRandCode.SetFocus;
    Exit;
  end;

  frmMain.SendChgPw(sAccount, sPassword, sNewPassword, sL2Password, sRandomCode);
  LoginScene.ChgpwCancel;
end;

