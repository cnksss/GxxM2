function GetJobText(nJob:Integer):string;
begin
  case nJob of
    0:
      Result := '战';
    1:
      Result := '法';
    2:
      Result := '道';
    else
      Result := '?';
  end;
end;

function GetMemberCaption(FmtTokenMgr:TFmtTokenMgr; GroupMember:PGroupMember):string;
const
  SEX_NAMES:array[Boolean] of string = ('男', '女');
var
  I:Integer;
  Token:PFmtToken;
  Text:string;
begin
  Result := '';
  for I := 0 to FmtTokenMgr.Count - 1 do begin
    Token := FmtTokenMgr[I];
    if Token.VarName = '' then begin
      Result := Result + Token.Text;
    end
    else if SameText(Token.VarName, '$name') then begin
      Text := GroupMember.sCharName;
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
    else if SameText(Token.VarName, '$sex') then begin
      Text := SEX_NAMES[GroupMember.Gender <> 0];
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
    else if SameText(Token.VarName, '$job') then begin
      Text := GetJobText(GroupMember.Job);
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
    else if SameText(Token.VarName, '$mapid') then begin
      Text := GroupMember.sMapName;
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
    else if SameText(Token.VarName, '$map') then begin
      Text := GroupMember.sMapDesc;
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
    else if SameText(Token.VarName, '$level') then begin
      Text := IntToStr(GroupMember.Level);
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
    else if SameText(Token.VarName, '$hp') then begin
      Text := IntToStr(GroupMember.HP);
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
    else if SameText(Token.VarName, '$maxhp') then begin
      Text := IntToStr(GroupMember.MaxHP);
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
    else if SameText(Token.VarName, '$mp') then begin
      Text := IntToStr(GroupMember.MP);
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
    else if SameText(Token.VarName, '$maxmp') then begin
      Text := IntToStr(GroupMember.MaxMP);
      if Token.FixedLen <= 0 then
        Result := Result + Text
      else
        Result := Result + Format('%-' + IntToStr(Token.FixedLen) + 's', [Text]);
    end
  end;
end;

procedure TSerialWindows.RefreshNewGroupMember(Index:Integer);
var
  DxLabel:TDxLabel;
begin
  if not FIsOnlyTextNewGroupMemeber then
    Exit;
  if not FGroupMemberNeedRefresh then
    Exit;

  if (Index >= 0) and (Index <= FGroupMemberButtonList.Count - 1) then begin
    DxLabel := FGroupMemberButtonList[Index];
    DxLabel.Caption := GetMemberCaption(FGroupMemberFmtTokenMgr, PGroupMember(DxLabel.Tag));
  end;
end;

procedure TSerialWindows.ReshowNewGroupMember;
const
  START_LEFT = 12;
var
  nTop:Integer;
  I:Integer;
  DxButton:TDxImageButton;
  DxLabel:TDxLabel;
  GroupMember:PGroupMember;
begin
  ClearGroupMemberButtonList;

  if not g_ClientConfig.boShowNewGroupInfo then
    Exit;
  if not g_ConfigDlg.ConfigCheckeds[ckShowNewGroupInfo] then
    Exit;

  lblGroupTitle.Left := START_LEFT + g_ClientConfig.nNewLeftGroupInfoOffsetX;
  nTop := 2 + g_ClientConfig.nNewLeftGroupInfoOffsetY;

  if PlugInEnabled and g_ClientConfig.boShowGreenHint and g_ConfigDlg.ConfigCheckeds[ckShowGreenHint] then begin
    nTop := nTop + 14;
  end;

  if not FIsOnlyTextNewGroupMemeber then begin
    lblGroupTitle.Top := nTop;
    lblGroupTitle.Caption := Format('- [组队信息] %d人', [g_GroupMembers.Count]);
    lblGroupTitle.Visible := g_GroupMembers.Count > 0;

    nTop := nTop + lblGroupTitle.Height + 4;

    for I := 0 to g_GroupMembers.Count - 1 do begin
      DxButton := TDxImageButton.Create(FrmDlg.DBackground);
      DxButton.Floating := False;
      DxButton.Designing := False;
      DxButton.ImageIndex.Assign(FrmGroupHuman.ImageIndex);
      DxButton.AutoSize := True;
      DxButton.Left := START_LEFT + g_ClientConfig.nNewLeftGroupInfoOffsetX;
      DxButton.Top := nTop;
      Inc(nTop, DxButton.Height);
      DxButton.Tag := Integer(g_GroupMembers.Items[I]);

      DxButton.OnStopPaint := NewGroupMemberPaint;
      DxButton.OnMouseMove := NewGroupMemberMouseMove;
      FGroupMemberButtonList.Add(DxButton);
    end;
  end
  else begin
    lblGroupTitle.Top := nTop;
    lblGroupTitle.Caption := Format('+ [组队信息] %d人', [g_GroupMembers.Count]);
    lblGroupTitle.Visible := g_GroupMembers.Count > 0;

    nTop := nTop + lblGroupTitle.Height + 4;

    for I := 0 to g_GroupMembers.Count - 1 do begin
      GroupMember := g_GroupMembers.Items[I];
      DxLabel := TDxLabel.Create(FrmDlg.DBackground);
      DxLabel.Floating := False;
      DxLabel.Designing := False;
      DxLabel.AutoSize := True;
      DxLabel.Left := START_LEFT + 10 + g_ClientConfig.nNewLeftGroupInfoOffsetX;
      DxLabel.Top := nTop;

      // 支持变量{$name}{$sex}{$job}{$mapid}{$map}{$level}{$HP}{$MaxHP}{$MP}{MaxMP}
      // 如 {$name:16}{job:4}{$level}

      DxLabel.Caption := GetMemberCaption(FGroupMemberFmtTokenMgr, GroupMember);

      DxLabel.CaptionColor.Assign(lblGroupHuman2.CaptionColor);

      Inc(nTop, DxLabel.Height + 3);
      DxLabel.Tag := Integer(g_GroupMembers.Items[I]);
      DxLabel.OnMouseMove := NewGroupMemberMouseMove;

      FGroupMemberButtonList.Add(DxLabel);
    end;
  end;
end;

procedure TSerialWindows.NewGroupMemberPaint(Sender:TObject);
var
  R:TRect;
  DxButton:TDxImageButton;
  GameImages:TGameImages;
  D:TTexture;
  DxFont:TDxFont;
  I, II, nWidth, nHeight:Integer;
  vtRect, vbRect, TempRect, SrcRect:TRect;
  S:string;
  HGEFont:THGEFont;
  TextImages:TImageInfos;
  ProgressSetting:TProgressSetting;
  GroupMember:PGroupMember;
begin
  DxButton := Sender as TDxImageButton;
  R := DxButton.VirtualRect;

  vbRect := DxButton.VisibleRect;

  GroupMember := PGroupMember(DxButton.Tag);
  if GroupMember = nil then
    Exit;

  // 绘制组队人物图标
  if BtnGroupHumanIcon.Visible then begin
    D := g_WNewopUIImages.Images[1661 + GroupMember.Job * 2 + GroupMember.Gender];
    if D <> nil then begin
      GameCanvas.Draw(R.Left + BtnGroupHumanIcon.Left, R.Top + BtnGroupHumanIcon.Top, D);
    end;
  end;

  // 绘制组队人物名称
  if lblGroupHumanName.Visible then begin
    if GroupMember.IsCaptain then
      DxFont := lblGroupHumanName.CaptionColor.Disabled
    else
      DxFont := lblGroupHumanName.CaptionColor.Up;

    HGEFont := TextureFonts.FindFont(DxFont.Name, DxFont.Size, DxFont.Style);
    if HGEFont <> nil then begin
      if DxFont.Bold then
        BoldTextOut(HGEFont, R.Left + lblGroupHumanName.Left, R.Top + lblGroupHumanName.Top, GroupMember.sCharName, DxFont.Color, DxFont.BColor)
      else
        HGEFont.TextOut(R.Left + lblGroupHumanName.Left, R.Top + lblGroupHumanName.Top, GroupMember.sCharName, DxFont.Color);
    end;
  end;

  // 绘制组队人物血条
  if prgGroupHumanHP.Visible then begin
    vtRect.Left := R.Left + prgGroupHumanHP.Left;
    vtRect.Top := R.Top + prgGroupHumanHP.Top;
    vtRect.Right := vtRect.Left + prgGroupHumanHP.Width;
    vtRect.Bottom := vtRect.Bottom + prgGroupHumanHP.Height;

    TempRect.Left := vbRect.Left + prgGroupHumanHP.Left;
    TempRect.Top := vbRect.Top + prgGroupHumanHP.Top;
    TempRect.Right := TempRect.Left + prgGroupHumanHP.Width;
    TempRect.Bottom := TempRect.Top + prgGroupHumanHP.Height;

    ProgressSetting := prgGroupHumanHP.ProgressSetting;
    if prgGroupHumanHP.Visible and (ProgressSetting.Image <> nil) then begin
      if (ProgressSetting.ImageBG >= 0) then begin
        D := ProgressSetting.Image.Images[ProgressSetting.ImageBG];

        if D <> nil then begin
          SrcRect := Rect(0, 0, Min(D.Width, prgGroupHumanHP.Width), Min(D.Height, prgGroupHumanHP.Height));
          GameCanvas.Draw(vtRect.Left, vtRect.Top, SrcRect, D);
        end;
      end;

      //HZQ 20230520 GroupMember.HP, MaxHP为无符号数
      if (ProgressSetting.ImageProgress >= 0) and (GroupMember.MaxHP > 0) {and (GroupMember.HP >= 0)} then begin
        D := ProgressSetting.Image.Images[ProgressSetting.ImageProgress];

        if D <> nil then begin
          SrcRect := Rect(0, 0, D.Width, D.Height);
          SrcRect.Right := SrcRect.Left + Round((SrcRect.Right - SrcRect.Left) / (GroupMember.MaxHP - 0) * Min(GroupMember.HP, GroupMember.MaxHP));
          GameCanvas.Draw(vtRect.Left + ProgressSetting.ImageProgressX, vtRect.Top + ProgressSetting.ImageProgressY, SrcRect, D);
        end;
      end;

      if (ProgressSetting.ImageBG >= 0) and (GroupMember.MaxHP > 0) {and (GroupMember.HP >= 0)} then begin
        if ProgressSetting.ValueType = vtValueAndMax then
          S := ProgressSetting.ValuePrefix + IntToStr(GroupMember.HP) + ProgressSetting.ValueSplite + IntToStr(GroupMember.MaxHP) + ProgressSetting.ValueSuffix
        else if ProgressSetting.ValueType = vtValue then
          S := ProgressSetting.ValuePrefix + IntToStr(GroupMember.HP) + ProgressSetting.ValueSuffix
        else if ProgressSetting.ValueType = vtPercentage then
          S := ProgressSetting.ValuePrefix + Format('%d%%', [Round(GroupMember.HP / (GroupMember.MaxHP - 0) * 100)]) + ProgressSetting.ValueSuffix
        else
          S := '';

        if Length(S) > 0 then begin
          HGEFont := TextureFonts.FindFont(ProgressSetting.Font.Name, ProgressSetting.Font.Size, ProgressSetting.Font.Style);

          if HGEFont <> nil then begin
            TextImages := HGEFont.GetImageInfos(S);

            nWidth := 0;
            nHeight := 0;
            for I := 0 to Length(TextImages) - 1 do begin
              if nWidth < TextImages[I].Width then
                nWidth := TextImages[I].Width;

              if TextImages[I].Height <= 0 then
                Inc(nHeight, HGEFont.TextHeight('0'))
              else
                Inc(nHeight, TextImages[I].Height);
            end;

            if ProgressSetting.Font.Bold then begin
              Inc(nWidth, 2);
              Inc(nHeight, 2);
            end;

            DxButton.DrawCaption(HGEFont, ProgressSetting.Font, ProgressSetting.ValueAlignment, TextImages, Bounds(vtRect.Left, vtRect.Top, nWidth, nHeight), TempRect, vtRect, 0, 0);
          end;
        end;
      end;
    end;
  end;

  // 绘制组队人物蓝条
  if prgGroupHumanMP.Visible then begin
    vtRect.Left := R.Left + prgGroupHumanMP.Left;
    vtRect.Top := R.Top + prgGroupHumanMP.Top;
    vtRect.Right := vtRect.Left + prgGroupHumanMP.Width;
    vtRect.Bottom := vtRect.Bottom + prgGroupHumanMP.Height;

    TempRect.Left := vbRect.Left + prgGroupHumanMP.Left;
    TempRect.Top := vbRect.Top + prgGroupHumanMP.Top;
    TempRect.Right := TempRect.Left + prgGroupHumanMP.Width;
    TempRect.Bottom := TempRect.Top + prgGroupHumanMP.Height;

    ProgressSetting := prgGroupHumanMP.ProgressSetting;
    if prgGroupHumanMP.Visible and (ProgressSetting.Image <> nil) then begin
      if (ProgressSetting.ImageBG >= 0) then begin
        D := ProgressSetting.Image.Images[ProgressSetting.ImageBG];

        if D <> nil then begin
          SrcRect := Rect(0, 0, Min(D.Width, prgGroupHumanMP.Width), Min(D.Height, prgGroupHumanMP.Height));
          GameCanvas.Draw(vtRect.Left, vtRect.Top, SrcRect, D);
        end;
      end;

      //HZQ 20230520 GroupMember.MaxMP MP为无符号数
      if (ProgressSetting.ImageProgress >= 0) and (GroupMember.MaxMP > 0) {and (GroupMember.MP >= 0)} then begin
        D := ProgressSetting.Image.Images[ProgressSetting.ImageProgress];

        if D <> nil then begin
          SrcRect := Rect(0, 0, D.Width, D.Height);
          SrcRect.Right := SrcRect.Left + Round((SrcRect.Right - SrcRect.Left) / (GroupMember.MaxMP - 0) * Min(GroupMember.MP, GroupMember.MaxMP));
          GameCanvas.Draw(vtRect.Left + ProgressSetting.ImageProgressX, vtRect.Top + ProgressSetting.ImageProgressY, SrcRect, D);
        end;
      end;

      if (ProgressSetting.ImageBG >= 0) and (GroupMember.MaxMP > 0) {and (GroupMember.MP >= 0)} then begin
        if ProgressSetting.ValueType = vtValueAndMax then
          S := ProgressSetting.ValuePrefix + IntToStr(GroupMember.MP) + ProgressSetting.ValueSplite + IntToStr(GroupMember.MaxMP) + ProgressSetting.ValueSuffix
        else if ProgressSetting.ValueType = vtValue then
          S := ProgressSetting.ValuePrefix + IntToStr(GroupMember.MP) + ProgressSetting.ValueSuffix
        else if ProgressSetting.ValueType = vtPercentage then
          S := ProgressSetting.ValuePrefix + Format('%d%%', [Round(GroupMember.MP / (GroupMember.MaxMP - 0) * 100)]) + ProgressSetting.ValueSuffix
        else
          S := '';

        if Length(S) > 0 then begin
          HGEFont := TextureFonts.FindFont(ProgressSetting.Font.Name, ProgressSetting.Font.Size, ProgressSetting.Font.Style);

          if HGEFont <> nil then begin
            TextImages := HGEFont.GetImageInfos(S);

            nWidth := 0;
            nHeight := 0;
            for I := 0 to Length(TextImages) - 1 do begin
              if nWidth < TextImages[I].Width then
                nWidth := TextImages[I].Width;

              if TextImages[I].Height <= 0 then
                Inc(nHeight, HGEFont.TextHeight('0'))
              else
                Inc(nHeight, TextImages[I].Height);
            end;

            if ProgressSetting.Font.Bold then begin
              Inc(nWidth, 2);
              Inc(nHeight, 2);
            end;

            DxButton.DrawCaption(HGEFont, ProgressSetting.Font, ProgressSetting.ValueAlignment, TextImages, Bounds(vtRect.Left, vtRect.Top, nWidth, nHeight), TempRect, vtRect, 0, 0);
          end;
        end;
      end;
    end;
  end;

  // 等级
  if lblprgGroupHumanLevel.Visible then begin
    vtRect.Left := R.Left + lblprgGroupHumanLevel.Left;
    vtRect.Top := R.Top + lblprgGroupHumanLevel.Top;
    vtRect.Right := vtRect.Left + lblprgGroupHumanLevel.Width;
