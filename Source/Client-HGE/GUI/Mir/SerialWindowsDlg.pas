procedure TSerialWindows.LabelUserShopItemLastClick(Sender:TObject; X, Y:Integer);
begin
  if MyGetTickCount - g_dwQueryUserShopItemTime < 500 then
    Exit;
  g_dwQueryUserShopItemTime := MyGetTickCount;

  if g_SelectUserShop.sMasterName <> '' then begin
    if g_nUserShopItemCount > 0 then begin
      if g_nUserShopItemCount - 5 >= 0 then begin
        if g_nUserShopItemCount mod 5 > 0 then
          g_nUserShopItemIndex := g_nUserShopItemCount div 5 * 5
        else
