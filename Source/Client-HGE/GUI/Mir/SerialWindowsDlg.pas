procedure TSerialWindows.DBetterItemTakeOnClick(Sender:TObject; X, Y:Integer);
var
  J, K, where, WantUseToIndex:Integer;
  flag:Boolean;
  cu:pTClientItem;
begin
  //  CloseDBetterItemDlg
  //  for I := 0 to g_BetterItemList.Count - 1 do
  //  begin
  if g_BetterItemList.Count = 0 then Exit;
  cu := g_BetterItemList.Items[0];
  for J := 0 to GetMaxBagCount - 1 do begin
    if (g_ItemArr[J].MakeIndex = cu.MakeIndex) and (g_ItemArr[J].s.Name = cu.s.Name) then begin
      where := GetTakeOnPosition(g_ItemArr[J].S.StdMode, g_ItemArr[J].S.Shape);

      if where = -1 then begin
        if (g_ItemArr[J].S.StdMode <= 4) or (g_ItemArr[J].S.StdMode = 31) or (g_ItemArr[J].S.StdMode = 60) or
          ((g_ItemArr[J].S.StdMode = 49) and (g_ItemArr[J].Dura >= g_ItemArr[J].DuraMax)) or
          (g_ItemArr[J].S.StdMode in [91, 92]) or (g_ItemArr[J].S.StdMode in [95, 96]) then begin

          g_ConfigDlg.ProtectEnabled := False;
          try
            frmMain.EatItem(J);
            CloseDBetterItemDlg;
            Dispose(pTClientItem(g_BetterItemList.Items[0]));
            g_BetterItemList.Delete(0);
          finally
            g_ConfigDlg.ProtectEnabled := True;
          end;
        end
      end;

      // DScreen.AddChatBoardString('右键穿装备', clWhite, clRed);
      if (g_WaitingUseItem.Item.s.Name = '') and (g_ItemArr[J].S.Name <> '') then begin
        if ((g_ItemArr[J].S.OverLap = 0) or (g_ItemArr[J].S.OverLap and 1 <> 0)) then begin
          flag := False;

          case where of
            U_DRESS:begin
                flag := True;
              end;
            U_WEAPON:
              flag := True;
            U_NECKLACE:
              flag := True;
            U_RIGHTHAND:
              flag := True;
            U_HELMET:
              flag := True;
            U_RINGR, U_RINGL:
              flag := True;
            U_ARMRINGR, U_ARMRINGL:
              flag := True;

            { 1.76界面下面一排不允许装备 chongchong 2013-09-16 }
            U_BUJUK:begin
                if g_ClientConfig.boUseOldSerialWindows and (g_ClientConfig.boStateWindowsType = 0) then begin
                  flag := not g_ClientConfig.boDisableDuFuTakeArmRingL;
                  if flag then
                    where := U_ARMRINGL;
                end
                else begin
                  flag := True;
                end;
              end;

            U_BELT:
              flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;
            U_BOOTS:
              flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;
            U_CHARM:
              flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;

            U_HAT:
              flag := True;
            U_DRUM:
              flag := (not g_ClientConfig.boUseOldSerialWindows);

            U_HORSE:begin
                flag := True;
                if g_ClientConfig.boUseOldSerialWindows then begin
                  where := U_RIGHTHAND;
                end;
              end;
            U_SHIELD:
              flag := True; // 盾牌 chongchong 2013-09-16
            U_JADE:
              flag := (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONDRESS:
              flag := (not g_ClientConfig.boUseOldSerialWindows); // 时装衣服 chongchong 2013-10-23
            U_FASHIONWEAPON:
              flag := (not g_ClientConfig.boUseOldSerialWindows); // 时装武器 chongchong 2013-10-23

            U_FASHIONNECKLACE:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONHELMET:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONARMRINGR, U_FASHIONARMRINGL:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONRINGL:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONRIGHTHAND:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONBELT:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONBOOTS:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONCHARM:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          end;
          if flag then begin
            if where in [U_RINGR, U_RINGL] then begin
              if (g_UseItems[U_RINGR].S.Name = '') then
                where := U_RINGR;
              if g_UseItems[U_RINGL].S.Name = '' then
                where := U_RINGL;
              if (g_UseItems[U_RINGR].S.Name <> '') and (g_UseItems[U_RINGL].S.Name <> '') then begin
                // 修复右击戴戒指只穿右边，不戴左边 chongchong 2013-11-11
                if FIsRingLeft then
                  where := U_RINGL
                else
                  where := U_RINGR;
                FIsRingLeft := not FIsRingLeft;
              end;
            end;

            if where in [U_ARMRINGR, U_ARMRINGL] then begin
              if g_ItemArr[J].S.StdMode = 25 then
                where := U_ARMRINGL
              else begin
                if g_UseItems[U_ARMRINGR].S.Name = '' then
                  where := U_ARMRINGR;
                if g_UseItems[U_ARMRINGL].S.Name = '' then
                  where := U_ARMRINGL;
                if (g_UseItems[U_ARMRINGR].S.Name <> '') and (g_UseItems[U_ARMRINGL].S.Name <> '') then begin
                  // 修复右击戴手镯只穿右边，不戴左边 chongchong 2013-11-11
                  if FIsArmRingLeft then
                    where := U_ARMRINGL
                  else
                    where := U_ARMRINGR;
                  FIsArmRingLeft := not FIsArmRingLeft;
                end;
              end;
            end;

            if where in [U_FASHIONRINGR, U_FASHIONRINGL] then begin
              if (g_UseItems[U_FASHIONRINGR].S.Name = '') then
                where := U_FASHIONRINGR;
              if g_UseItems[U_FASHIONRINGL].S.Name = '' then
                where := U_FASHIONRINGL;
              if (g_UseItems[U_FASHIONRINGR].S.Name <> '') and (g_UseItems[U_FASHIONRINGL].S.Name <> '') then begin
                // 修复双击戴戒指只穿右边，不戴左边 chongchong 2013-11-11
                if FIsFashionRingLeft then
                  where := U_FASHIONRINGL
                else
                  where := U_FASHIONRINGR;
                FIsFashionRingLeft := not FIsFashionRingLeft;
              end;
            end;

            if where in [U_FASHIONARMRINGR, U_FASHIONARMRINGL] then begin
              if g_UseItems[U_FASHIONARMRINGR].S.Name = '' then
                where := U_FASHIONARMRINGR;
              if g_UseItems[U_FASHIONARMRINGL].S.Name = '' then
                where := U_FASHIONARMRINGL;
              if (g_UseItems[U_FASHIONARMRINGR].S.Name <> '') and (g_UseItems[U_FASHIONARMRINGL].S.Name <> '') then begin
                if FIsFashionArmRingLeft then
                  where := U_FASHIONARMRINGL
                else
                  where := U_FASHIONARMRINGR;
                FIsFashionArmRingLeft := not FIsFashionArmRingLeft;
              end;
            end;

            g_WaitingUseItem.Index := where;
            g_WaitingUseItem.Item := g_ItemArr[J];
            g_WaitingUseItem.ItemType := mtBagItem;
            g_boItemMoving := False;
            g_ItemArr[J].S.Name := '';
            frmMain.SendTakeOnItem(where, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
            ItemClickSound(g_ItemArr[J].S);
          end;
        end
        else if (g_MySelf.m_nJewelryBoxStatus = jbsOpen) and (g_ItemArr[J].S.OverLap and 2 <> 0)
          //HZQ 20230525 右戒指笔误
        and (where in [U_HELMET {头盔}, U_NECKLACE {项链}, U_ARMRINGL {左手镯}, U_ARMRINGR {右手镯}, U_RINGL {左戒指}, U_RINGR {右戒指}]) then begin
          if (g_ItemArr[J].S.Expand1 = 0) or (g_ItemArr[J].S.Expand1 = 7) then begin
            WantUseToIndex := 0;
            for K := Low(g_JewelryBoxItems) to High(g_JewelryBoxItems) do begin
              if g_JewelryBoxItems[K].S.Name = '' then begin
                WantUseToIndex := K;
                Break;
              end;
            end;
          end else if g_ItemArr[J].S.Expand1 in [1..6] then begin
            WantUseToIndex := g_ItemArr[J].S.Expand1 - 1;
          end else begin
            WantUseToIndex := -1;
          end;

          //处理WangUseToIndex 警告
          if WantUseToIndex >= 0 then begin
            g_WaitingUseItem.Item := g_ItemArr[J];
            g_WaitingUseItem.Index := WantUseToIndex;
            g_ItemArr[J].S.Name := '';
            frmMain.SendTakeOnJewelry(WantUseToIndex, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
          end;
        end
        else if g_MySelf.m_boShowGodBless and (g_ItemArr[J].S.OverLap and 4 <> 0) then begin
          if g_ItemArr[J].S.Expand1 = 13 then begin
            WantUseToIndex := -1;
            for K := Low(g_GodBlessItems) to High(g_GodBlessItems) do begin
              if (g_GodBlessItems[K].S.Name = '') and (g_GodBlessItemsState[K] = 1) then begin
                WantUseToIndex := K;
                Break;
              end;
            end;

            if WantUseToIndex = -1 then begin
              for K := Low(g_GodBlessItems) to High(g_GodBlessItems) do begin
                if g_GodBlessItemsState[K] = 1 then begin
                  WantUseToIndex := K;
                  Break;
                end;
              end;
            end;

            if WantUseToIndex >= 0 then begin
              g_WaitingUseItem.Item := g_ItemArr[J];
              g_WaitingUseItem.Index := WantUseToIndex;
              g_ItemArr[J].S.Name := '';
              frmMain.SendTakeOnGodBless(False, WantUseToIndex, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
            end;
          end
          else if g_ItemArr[J].S.Expand1 in [1..12] then begin
            if (g_GodBlessItemsState[g_ItemArr[J].S.Expand1 - 1] = 1) then begin
              WantUseToIndex := g_ItemArr[J].S.Expand1 - 1;

              g_WaitingUseItem.Item := g_ItemArr[J];
              g_WaitingUseItem.Index := WantUseToIndex;
              g_ItemArr[J].S.Name := '';
              frmMain.SendTakeOnGodBless(False, WantUseToIndex, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
            end;
          end;
        end;
      end;
      CloseDBetterItemDlg;
      Dispose(pTClientItem(g_BetterItemList.Items[0]));
      g_BetterItemList.Delete(0);
      Exit;
    end;
  end;
  CloseDBetterItemDlg;
  Dispose(pTClientItem(g_BetterItemList.Items[0]));
  g_BetterItemList.Delete(0);
end;

