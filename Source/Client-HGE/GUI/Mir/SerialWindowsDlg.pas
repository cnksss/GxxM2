          HGEFont := TextureFonts.FindFont(DSellPlayerstLJMagLblName1.CaptionColor.Up.Name, DSellPlayerstLJMagLblName1.CaptionColor.Up.Size, DSellPlayerstLJMagLblName1.CaptionColor.Up.Style);
