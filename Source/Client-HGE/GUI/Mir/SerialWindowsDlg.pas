    //if Abil.HP < 0 then
    //  Abil.HP := 0;
    //if Abil.MP < 0 then
    //  Abil.MP := 0;

    if Abil.HP > Abil.MaxHP then
      Abil.HP := Abil.MaxHP;
    if Abil.MP > Abil.MaxMP then
      Abil.MP := Abil.MaxMP;

    if LabelDBottomHP.Visible then begin
      if (g_ConfigClient.boHPPercentShow) and (Abil.MaxHP > 0) then
        LabelDBottomHP.Caption := Format('%d%%', [Round(Abil.HP / Abil.MaxHP * 100)])
      else begin
        if g_ClientConfig.boShowHPUnit and g_ConfigDlg.ConfigCheckeds[ckShowHPUnit] then begin
          LabelDBottomHP.Caption := Format('%s/%s', [HpAddUnit(Abil.HP), HpAddUnit(Abil.MaxHP)]);
        end
        else begin
          LabelDBottomHP.Caption := Format('%u/%u', [Abil.HP, Abil.MaxHP]);
        end;
      end;
    end;

    if LabelDBottomMP.Visible then begin
      if (g_ConfigClient.boMPPercentShow) and (Abil.MaxMP > 0) then
        LabelDBottomMP.Caption := Format('%d%%', [Round(Abil.MP / Abil.MaxMP * 100)])
      else begin
        if g_ClientConfig.boShowHPUnit and g_ConfigDlg.ConfigCheckeds[ckShowHPUnit] then begin
          LabelDBottomMP.Caption := Format('%s/%s', [HpAddUnit(Abil.MP), HpAddUnit(Abil.MaxMP)]);
        end
        else begin
          LabelDBottomMP.Caption := Format('%u/%u', [Abil.MP, Abil.MaxMP]);
        end;
      end
    end;

    if LabelDBottomMapName.Visible then
      LabelDBottomMapName.Caption := Format('%s %d:%d', [g_sMapTitle, g_MySelf.m_nCurrX, g_MySelf.m_nCurrY]);
  end;
end;

procedure TSerialWindows.RefLoadConfig;
var
  I:Integer;
  sFileName:string;
  ViewItem:pTViewItem;
begin
  sFileName := Format(FriendListFile, [g_sPlugServerName, g_sPlugUserName]);
  try
    if FileExists(sFileName) then
      DMemoFriend.LoadFromFile(sFileName);
  except
  end;
  sFileName := Format(TargetListFile, [g_sPlugServerName, g_sPlugUserName]);
