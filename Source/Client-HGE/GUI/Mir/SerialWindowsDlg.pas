procedure TSerialWindows.DBtnAuctionSortClick(Sender:TObject; X, Y:Integer);
begin
  if Sender = DBtnAuctionSort00 then
    FAuctionAllItemsSortField := 0
  else if Sender = DBtnAuctionSort01 then begin
    if FAuctionAllItemsSortField = 1 then
      FAuctionAllItemsSortASC := not FAuctionAllItemsSortASC
    else begin
      FAuctionAllItemsSortField := 1;
      FAuctionAllItemsSortASC := True;
    end;
  end
  else if Sender = DBtnAuctionSort02 then begin
    if FAuctionAllItemsSortField = 2 then
      FAuctionAllItemsSortASC := not FAuctionAllItemsSortASC
    else begin
      FAuctionAllItemsSortField := 2;
      FAuctionAllItemsSortASC := True;
    end;
  end
  else if Sender = DBtnAuctionSort03 then begin
    if FAuctionAllItemsSortField = 3 then
      FAuctionAllItemsSortASC := not FAuctionAllItemsSortASC
    else begin
      FAuctionAllItemsSortField := 3;
      FAuctionAllItemsSortASC := True;
    end;
  end;

  SendQueryAllAuctionItems(FAuctionAllItemsPage, 0);
end;

