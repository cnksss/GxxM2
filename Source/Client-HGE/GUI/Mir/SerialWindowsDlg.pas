      DEdId.SetFocus;

      if g_nClientLoginMode = CLIENT_MODE_CUSTOM then begin
          DLoginNew.Visible := False;
          DLoginChgPw.Visible := False;
      end;
  end;
  // DebugOutStr(Format('Width:%d Height:%d',[DLoginDlg.Width,DLoginDlg.Height]));
end;

