procedure TSerialWindows.ImageButtonMyShopItemClick(Sender:TObject; X, Y:Integer);
var
  temp:TClientItem;
begin
  if (g_MyShopDlgItemWait.S.Name <> '') then
    Exit;

  if not g_boItemMoving then begin
    if g_MyShopDlgItem.S.Name <> '' then begin
      ItemClickSound(g_MyShopDlgItem.S);
      g_boItemMoving := True;
      g_MovingItem.Index := -99;
      g_MovingItem.Item := g_MyShopDlgItem;
      g_MyShopDlgItem.S.Name := '';

      if (g_SelectMyShopItem <> nil) and (g_SelectMyShopItem.Item.s.Name <> '') then
        ImageButtonMyShopChangeItem.Caption := '修改';
    end;
  end
  else begin
    if (g_MovingItem.Index = -97) or (g_MovingItem.Index = -98) or (g_MovingItem.ItemType in [mtHeroBagItem, mtHeroUseItem, mtChallengeItem, mtBagGold, mtDealGold, mtGameGoldDeal, mtChallengeGold]) then
      Exit;
    if (g_MovingItem.Index >= 0) or (g_MovingItem.Index = -99) then begin
      ItemClickSound(g_MovingItem.Item.S);
      if g_MyShopDlgItem.S.Name <> '' then begin
        temp := g_MyShopDlgItem;
        g_MyShopDlgItem := g_MovingItem.Item;
        g_MovingItem.Index := -99;
        g_MovingItem.Item := temp
      end
      else begin
        g_MyShopDlgItem := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
        g_boItemMoving := False;
      end;
      ImageButtonMyShopChangeItem.Caption := '增加';
    end;
  end;
end;

