procedure TSerialWindows.UcDlgAfterPaint(Sender:TObject);
var
    dwDiffTick, dwCurTick:DWORD;
    nRem:Integer;
begin
    if (DUcLoginPageControl.ActivePageIndex = 1) then begin
       if ( not DucGetPhoneVerifyCodeLabel.Enabled) then begin
           dwCurTick := GetTickCount;
           if dwCurTick - g_UserCenterManager.LastGetPhoneCodeTick {dwLastRefeshTick} > 100 then begin
               dwDiffTick := tick_diff(g_UserCenterManager.LastGetPhoneCodeTick, dwCurTick);
               {$IFDEF DEBUG}
               nRem := 20*1000 - dwDiffTick - 1;
               {$ELSE}
               nRem := 60*1000 - dwDiffTick - 1;
               {$ENDIF}
               if nRem > 0 then begin
                   DucGetPhoneVerifyCodeLabel.Caption := Format('%d秒后重新获取', [nRem div 1000 + 1]);
               end else begin
                   ResetGetPhoneVerifyCodeLabel();
               end;
           end;
       end;
    end;
end;

