procedure TSerialWindows.DCbAuctionAllItemsGroupClick(Sender:TObject; X, Y:Integer);
begin
  FQueryAllAuctionItems_KeyWord := '';
  SendQueryAllAuctionItems(1, 0);
end;

procedure TSerialWindows.DBtnAuctionPageClick(Sender:TObject; X, Y:Integer);
begin
  if Sender = DBtnAuctionAllItemsPrev then begin
    if FAuctionAllItemsPage > 1 then begin
      SendQueryAllAuctionItems(FAuctionAllItemsPage - 1, 0);
    end;
  end
  else if Sender = DBtnAuctionAllItemsNext then begin
    if FAuctionAllItemsPage < FAuctionAllItemsPageCount then begin
      SendQueryAllAuctionItems(FAuctionAllItemsPage + 1, 0);
    end;
  end
  else if Sender = DBtnAuctionAllItemsRefresh then begin
    //FQueryAllAuctionItems_KeyWord := '';
    SendQueryAllAuctionItems(FAuctionAllItemsPage, 0);
  end
  else if Sender = DBtnAuctionBagPrev then begin
    if FAuctionMyItemsBagPage > 1 then begin
      FAuctionMyItemsBagPage := FAuctionMyItemsBagPage - 1;
      SetAuctionPageCount();
      FAuctionMyItemsBagSelectIndex := -1;
    end;
  end
  else if Sender = DBtnAuctionBagNext then begin
    if FAuctionMyItemsBagPage < FAuctionMyItemsBagPageCount then begin
      FAuctionMyItemsBagPage := FAuctionMyItemsBagPage + 1;
      SetAuctionPageCount();
      FAuctionMyItemsBagSelectIndex := -1;
    end;
  end
  else if Sender = DBtnAuctionMyPrev then begin
    if FAuctionMyItemsPage > 1 then begin
      FrmMain.SendQueryMyAuctionItems(FAuctionMyItemsPage - 1);
    end;
  end
  else if Sender = DBtnAuctionMyNext then begin
    if FAuctionMyItemsPage < FAuctionMyItemsPageCount then begin
      FrmMain.SendQueryMyAuctionItems(FAuctionMyItemsPage + 1);
    end;
  end
  else if Sender = DBtnAuctionMyRefresh then begin
    FrmMain.SendQueryMyAuctionItems(FAuctionMyItemsPage);
  end
  else if Sender = DBtnAuctionMyAttentionPrev then begin
    if FAuctionMyAuctioningItemsPage > 1 then begin
      FrmMain.SendQueryMyAuctioningItems(FAuctionMyAuctioningItemsPage - 1);
    end;
  end
  else if Sender = DBtnAuctionMyAttentionNext then begin
    if FAuctionMyAuctioningItemsPage < FAuctionMyAuctioningItemsPageCount then begin
      FrmMain.SendQueryMyAuctioningItems(FAuctionMyAuctioningItemsPage + 1);
    end;
  end
  else if Sender = DBtnAuctionMyAttentionRefresh then begin
    FrmMain.SendQueryMyAuctioningItems(FAuctionMyAuctioningItemsPage);
  end;
end;

procedure TSerialWindows.DLblAuctionBagItemPaint(Sender:TObject); stdcall;
var
  Index, RealIndex:Integer;
  R:TRect;
  Button:TDxImageButton;
  I:Integer;
  List:TList;
begin
  {.$I AddVmpFeatureCode_M.inc}

  List := TList.Create;
  try
    List.Capacity := GetMaxBagCount;

    for I := Low(g_ItemArr) to GetMaxBagCount - 1 do begin
      if (Length(g_ItemArr[I].S.Name) > 0) and (g_EnabledAuctionItemList.IndexOf(g_ItemArr[I].S.DBName) >= 0) then begin
