          ACaption := Copy(ACaption, 1, nPos - 1);
          sColorText := Trim(sColorText);
          sColor := Trim(Copy(sColorText, Length(C_FCOLOR) + 1, Length(sColorText) - Length(C_FCOLOR)));
          btColor := StrToIntDef(sColor, 100);
          Up := GetRGB(btColor);
        end else if CompareLStr(sColorText, C_AUTOCOLOR, Length(C_AUTOCOLOR)) then begin
          ACaption := Copy(ACaption, 1, nPos - 1);
          sColorText := Trim(sColorText);
          sColor := Trim(Copy(sColorText, Length(C_AUTOCOLOR) + 1, Length(sColorText) - Length(C_AUTOCOLOR)));
          GetColorList(sColor);
          if ColorList.Count > 0 then
            Up := TColor(ColorList.Items[0]);
        end  else if CompareLStr(sColorText, C_FNAME, Length(C_FNAME)) then begin
          sColorText := Trim(sColorText);
          FontName := Trim(Copy(sColorText, Length(C_FNAME) + 1, Length(sColorText) - Length(C_FNAME)));
