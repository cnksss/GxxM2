procedure TSerialWindows.DSellPlayerSWPetsShowStopPaint(Sender:TObject);
var
  GamePetData:pTClientGamePetData;
  Image:TGameImages;
  D:TTexture;
  nX, nY:Integer;
  vR:TRect;
begin
  if (FSelectSellPlayerGamePetIndex >= 0) and (FSelectSellPlayerGamePetIndex < DSellPlayerSWPetsList.Count) then begin
    vR := DSellPlayerSWPetsShow.VirtualRect;

    GamePetData := g_SellPlayerGamePetList.Items[FSelectSellPlayerGamePetIndex];
    if (GamePetData.ShowConfig.ShowCount1 = GamePetData.ShowConfig.ShowCount2) and (GamePetData.ShowConfig.ShowTime1 = GamePetData.ShowConfig.ShowTime2) then begin
      if GamePetData.ShowConfig.ShowCount1 > 0 then begin
        if FSellPlayerPetShowIndex1 < 0 then
          FSellPlayerPetShowIndex1 := 0
        else if FSellPlayerPetShowIndex1 >= GamePetData.ShowConfig.ShowCount1 then
          FSellPlayerPetShowIndex1 := 0;

        if MyGetTickCount - FSellPlayerPetShowTick1 >= Cardinal(GamePetData.ShowConfig.ShowTime1) then begin
          FSellPlayerPetShowTick1 := MyGetTickCount;
          Inc(FSellPlayerPetShowIndex1);
          if FSellPlayerPetShowIndex1 >= GamePetData.ShowConfig.ShowCount1 then
            FSellPlayerPetShowIndex1 := 0
        end;

        if (GamePetData.ShowConfig.ShowFile1 > 0) and (GamePetData.ShowConfig.ShowFile1 <= g_EffectImageList.Count) then
          Image := TGameImages(g_EffectImageList.Objects[GamePetData.ShowConfig.ShowFile1 - 1])
        else
          Image := g_WMonImages.Images[GamePetData.ShowConfig.wAppr];

        D := Image.GetCachedImage(GamePetData.ShowConfig.ShowStart1 + FSellPlayerPetShowIndex1, nX, nY);

        if D <> nil then
          GameCanvas.Draw(vR.Left + GamePetData.ShowConfig.ShowOffsetX1 + nX, vR.Top + GamePetData.ShowConfig.ShowOffsetY1 + nY, D);

        if (GamePetData.ShowConfig.ShowFile2 > 0) and (GamePetData.ShowConfig.ShowFile2 <= g_EffectImageList.Count) then
          Image := TGameImages(g_EffectImageList.Objects[GamePetData.ShowConfig.ShowFile2 - 1])
        else
          Image := g_WMonImages.Images[GamePetData.ShowConfig.wAppr];

        D := Image.GetCachedImage(GamePetData.ShowConfig.ShowStart2 + FSellPlayerPetShowIndex1, nX, nY);

        if D <> nil then
          GameCanvas.Draw(vR.Left + GamePetData.ShowConfig.ShowOffsetX2 + nX, vR.Top + GamePetData.ShowConfig.ShowOffsetY2 + nY, D);
      end;
    end else begin
      if GamePetData.ShowConfig.ShowCount1 > 0 then begin
        if FSellPlayerPetShowIndex1 < 0 then
          FSellPlayerPetShowIndex1 := 0
        else if FSellPlayerPetShowIndex1 >= GamePetData.ShowConfig.ShowCount1 then
          FSellPlayerPetShowIndex1 := 0;

        if MyGetTickCount - FSellPlayerPetShowTick1 >= Cardinal(GamePetData.ShowConfig.ShowTime1) then begin
          FSellPlayerPetShowTick1 := MyGetTickCount;
          Inc(FSellPlayerPetShowIndex1);
          if FSellPlayerPetShowIndex1 >= GamePetData.ShowConfig.ShowCount1 then
            FSellPlayerPetShowIndex1 := 0
        end;

        if (GamePetData.ShowConfig.ShowFile1 > 0) and (GamePetData.ShowConfig.ShowFile1 <= g_EffectImageList.Count) then
          Image := TGameImages(g_EffectImageList.Objects[GamePetData.ShowConfig.ShowFile1 - 1])
        else
          Image := g_WMonImages.Images[GamePetData.ShowConfig.wAppr];

        D := Image.GetCachedImage(GamePetData.ShowConfig.ShowStart1 + FSellPlayerPetShowIndex1, nX, nY);

        if D <> nil then
          GameCanvas.Draw(vR.Left + GamePetData.ShowConfig.ShowOffsetX1 + nX, vR.Top + GamePetData.ShowConfig.ShowOffsetY1 + nY, D);
      end;

      if GamePetData.ShowConfig.ShowCount2 > 0 then begin
        if FSellPlayerPetShowIndex2 < 0 then
          FSellPlayerPetShowIndex2 := 0
        else if FSellPlayerPetShowIndex2 >= GamePetData.ShowConfig.ShowCount2 then
          FSellPlayerPetShowIndex2 := 0;

        if MyGetTickCount - FSellPlayerPetShowTick2 >= Cardinal(GamePetData.ShowConfig.ShowTime2) then begin
          FSellPlayerPetShowTick2 := MyGetTickCount;
          Inc(FSellPlayerPetShowIndex2);
          if FSellPlayerPetShowIndex2 >= GamePetData.ShowConfig.ShowCount2 then
            FSellPlayerPetShowIndex2 := 0
        end;

        if (GamePetData.ShowConfig.ShowFile2 > 0) and (GamePetData.ShowConfig.ShowFile2 <= g_EffectImageList.Count) then
          Image := TGameImages(g_EffectImageList.Objects[GamePetData.ShowConfig.ShowFile2 - 1])
        else
          Image := g_WMonImages.Images[GamePetData.ShowConfig.wAppr];

        D := Image.GetCachedImage(GamePetData.ShowConfig.ShowStart2 + FSellPlayerPetShowIndex2, nX, nY);

        if D <> nil then
          GameCanvas.Draw(vR.Left + GamePetData.ShowConfig.ShowOffsetX2 + nX, vR.Top + GamePetData.ShowConfig.ShowOffsetY2 + nY, D);
      end;
    end;
  end;
end;

procedure TSerialWindows.DSellPlayerSWPetsMagicMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  Ctrl:TDxControl;
  GamePetData:pTClientGamePetData;
  vR:TRect;
  Item:PTClientItem;
begin
  Ctrl := Sender as TDxControl;
  if (FSelectSellPlayerGamePetIndex >= 0) and (FSelectSellPlayerGamePetIndex < DSellPlayerSWPetsList.Count) and (Ctrl.Tag >= 0) and (Ctrl.Tag < MAX_GAMEPET_MAGIC_COUNT) then begin
    vR := Ctrl.VirtualRect;
    GamePetData := g_SellPlayerGamePetList.Items[FSelectSellPlayerGamePetIndex];

    if GamePetData.wMagics[Ctrl.Tag] > 0 then begin
