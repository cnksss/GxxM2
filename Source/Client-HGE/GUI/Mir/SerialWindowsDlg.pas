function TSerialWindows.GetMissionTreeView(Index:Integer):TDxTreeView;
var
  TabSheet:TDxTabSheet;
  TreeView:TDxTreeView;
begin
  if (Index >= 0) and (DPageControlMission.PageCount - 1 < Index) and (Index < g_MissionPageCaptionList.Count) then begin
    while (DPageControlMission.PageCount - 1 < Index) do begin
      // DPageControlMission.PageCount := DPageControlMission.PageCount + 1;
      // TabSheet := TDxTabSheet(DPageControlMission.Pages[DPageControlMission.PageCount - 1]);
      // TabSheet.OnGetImage := DPageControlMission.OnGetImage;
      TabSheet := DPageControlMission.Add;

      TabSheet.OffSetX := FMissionTabSheetSetting.OffSetX;
      TabSheet.OffSetY := FMissionTabSheetSetting.OffSetY;

      TabSheet.ImageIndex.BeginUpdate;
      try
        TabSheet.ImageIndex.ImageType := FMissionTabSheetSetting.ImageIndex.Image;
        TabSheet.ImageIndex.Up := FMissionTabSheetSetting.ImageIndex.Up;
        TabSheet.ImageIndex.Hot := FMissionTabSheetSetting.ImageIndex.Hot;
        TabSheet.ImageIndex.Down := FMissionTabSheetSetting.ImageIndex.Down;
        TabSheet.ImageIndex.Disabled := FMissionTabSheetSetting.ImageIndex.Disabled;
      finally
        TabSheet.ImageIndex.EndUpdate;
      end;

