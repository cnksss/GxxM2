      nPos := Pos('{', ACaption);
      sColorText := Copy(ACaption, nPos + 1, Length(ACaption) - nPos - 1);
      sTemp := sColorText;
      while sTemp <> '' do begin
        sTemp := GetValidStr3_Ex(sTemp, sColorText, ':');
