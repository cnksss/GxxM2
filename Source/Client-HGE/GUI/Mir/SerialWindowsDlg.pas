    else if ACol = 6 then begin // 取回物品
      frmMain.SendMoveMyShopItem(g_MyShopItems[0, ARow].Item.MakeIndex, 0, 2, g_MyShopItems[0, ARow].Item.S.Name);
    end
    else begin
      if g_MyShopItems[0, ARow].Item.s.Name <> '' then
