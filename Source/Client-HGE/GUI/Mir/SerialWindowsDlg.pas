procedure TSerialWindows.DGuildViewMemberInfoPaint(Sender:TObject);
var
  R:TRect;
  nL1, nL2, nT, nH:Integer;
begin
  R := DGuildViewMemberInfo.VisibleRect;
  GameCanvas.FillRect(R, $00003031);

  nL1 := R.Left + 22;
  nL2 := R.Left + 94;
  nT := R.Top + 20;
  nH := 16;

  CurrentFont.TextOut(nL1, nT + nH * 0, '状态');
  if FGuildViewMemberInfo.boOnline then
    CurrentFont.TextOut(nL2, nT + nH * 0, '在线', clYellow)
  else
    CurrentFont.TextOut(nL2, nT + nH * 0, '离线', clYellow);

  CurrentFont.TextOut(nL1, nT + nH * 1, '性别');
  if FGuildViewMemberInfo.btSex = 0 then
    CurrentFont.TextOut(nL2, nT + nH * 1, '男', clYellow)
  else
    CurrentFont.TextOut(nL2, nT + nH * 1, '女', clYellow);

  CurrentFont.TextOut(nL1, nT + nH * 2, '职业');
  if FGuildViewMemberInfo.btJob = 0 then
    CurrentFont.TextOut(nL2, nT + nH * 2, '战士', clYellow)
  else if FGuildViewMemberInfo.btJob = 1 then
    CurrentFont.TextOut(nL2, nT + nH * 2, '法师', clYellow)
  else
    CurrentFont.TextOut(nL2, nT + nH * 2, '道士', clYellow);

  CurrentFont.TextOut(nL1, nT + nH * 3, '等级');
  CurrentFont.TextOut(nL2, nT + nH * 3, IntToStr(FGuildViewMemberInfo.nLevel), clYellow);

  CurrentFont.TextOut(nL1, nT + nH * 4, '封号');
  CurrentFont.TextOut(nL2, nT + nH * 4, FGuildViewMemberInfo.nRankName, clYellow);

  CurrentFont.TextOut(nL1, nT + nH * 5, '权限');
  if FGuildViewMemberInfo.boMaster then
    CurrentFont.TextOut(nL2, nT + nH * 5, '掌门人', clYellow);

  CurrentFont.TextOut(nL1, nT + nH * 6, '上次登录');
  if FGuildViewMemberInfo.boOnline then
    CurrentFont.TextOut(nL2, nT + nH * 6, '在线', clYellow)
  else begin
    CurrentFont.TextOut(nL2, nT + nH * 6, FormatDateTime('yyyy-mm-dd', FGuildViewMemberInfo.dtLastLogin), clYellow)
  end;
end;

