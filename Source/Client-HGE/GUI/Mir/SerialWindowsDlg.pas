begin
  {$IF IsMultiThreadRender = 1}
  DBackground.Lock;
  try
    {$IFEND}
    ColorList := TList.Create;
    Str := Text;
    nX := X;
    nY := Y;

    // showmessage(Text);
    while True do begin
      if Str = '' then
        Break;
      btFontSize := 9;
      // 2个换行放一起，只识别一个 \\ chongchong 2016-08-05
      if Str[1] = '\' then begin
        nX := nX + NewNpcLabel('', '', clWhite, '宋体', 9, []);
        Str := Copy(Str, 2, MaxInt);
        nX := X;
        nY := nY + 16;
        Continue;
      end;

      Str := GetValidStr3_Ex(Str, sTemp, '\');

      Data := sTemp;

      if Data <> '' then begin
        fdata := '';

        // 替换有颜色的{} {MirYQ/AUTOCOLOR=254,251,168,191,250,70,245,249,253}
        nPos1 := Pos('{', Data);
        nPos2 := Pos('/', Data);
        nPos3 := Pos('}', Data);
        if (nPos1 > 0) and (nPos2 > 0) and (nPos3 > 0) then begin
          bo1D := False;
          bo2D := False;
          for I := 1 to Length(Data) do begin
            if Data[I] = '{' then begin
              bo1D := True;
              nPos1 := I;
              Continue;
            end;
            if (Data[I] = '/') then begin
              if bo1D then begin
                bo2D := True;
                nPos2 := I;
                Continue;
              end
              else begin
                bo1D := False;
                bo2D := False;
              end;
            end;
            if (Data[I] = '}') then begin
              if bo1D and bo2D then begin
                sColor := Copy(Data, nPos2 + 1, I - nPos2 - 1); //Copy(Data, nPos2 + 1, I);
                if CompareLStr(sColor, C_FCOLOR, Length(C_FCOLOR)) or CompareLStr(sColor, C_SCOLOR, Length(C_SCOLOR)) then begin
                  Data[nPos1] := '<';
                  Data[I] := '>';
                  bo1D := False;
                  bo2D := False;
                  Continue;
                end
                else if CompareLStr(sColor, C_AUTOCOLOR, Length(C_AUTOCOLOR)) then begin
                  Data[nPos1] := '<';
                  Data[I] := '>';
                  bo1D := False;
                  bo2D := False;
                  Continue;
                end
                else begin
                  bo1D := False;
                  bo2D := False;
                end;
              end
              else begin
                bo1D := False;
                bo2D := False;
              end;

            end;
          end;
        end;

        while (Pos('<', Data) > 0) and (Pos('>', Data) > 0) and (Data <> '') do begin
          fdata := '';
          cmdstr := '';
          cmdparam := '';
          if Data[1] <> '<' then
            Data := '<' + GetValidStr3_Ex(Data, fdata, '<');

          // 如果出这样的 <<$STR(A1041)>/FCOLOR=254> 就比较蛋疼了。。
          Data := ArrestStringEx(Data, '<', '>', cmdstr);

          if Length(cmdstr) > 0 then begin
            if UpperCase(cmdstr) = 'C' then begin
              Continue;
            end;
            if UpperCase(cmdstr) = '/C' then begin
              Continue;
            end;

            {/FCOLOR=232}
            if cmdstr[1] = '/' then begin
              cmdstr := '';
            end
            else
              cmdparam := GetValidStr3_Ex(cmdstr, cmdstr, '/');
            // cmdstr 标题   cmdparam 命令
          end
          else begin
            CloseDMenuDlg;
            CloseDSellDlg;
          end;

          if Length(fdata) > 0 then begin
            // DecodeColor(fdata, '', nil);
            nX := nX + NewNpcLabel(fdata, '', clWhite, '宋体', 9, []);
          end;

          UseColor := clRed;

          if (Length(cmdparam) > 0) and (cmdparam[1] <> '@') then begin
            sTemp := cmdparam;
            while sTemp <> '' do begin
              sTemp := GetValidStr3_Ex(sTemp, cmdparam, ':');
              if CompareLStr(cmdparam, C_FCOLOR, Length(C_FCOLOR)) or CompareLStr(cmdparam, C_SCOLOR, Length(C_SCOLOR)) then begin
                cmdparam := Trim(cmdparam);
                sColor := Trim(Copy(cmdparam, Length(C_FCOLOR) + 1, Length(cmdparam) - Length(C_FCOLOR)));
                btColor := StrToIntDef(sColor, 100);
                UseColor := GetRGB(btColor);
                cmdparam := '';
              end
              else if CompareLStr(cmdparam, C_AUTOCOLOR, Length(C_AUTOCOLOR)) then begin
                cmdparam := Trim(cmdparam);
                sColor := Trim(Copy(cmdparam, Length(C_AUTOCOLOR) + 1, Length(cmdparam) - Length(C_AUTOCOLOR)));
                GetColorList(sColor);
                if ColorList.Count > 0 then
                  UseColor := TColor(ColorList.Items[0]);
                cmdparam := '';
              end
              else if CompareLStr(cmdparam, C_FNAME, Length(C_FNAME)) then begin
                cmdparam := Trim(cmdparam);
                sFontName := Trim(Copy(cmdparam, Length(C_FNAME) + 1, Length(cmdparam) - Length(C_FNAME)));
                cmdparam := '';
              end
              else if CompareLStr(cmdparam, C_FSIZE, Length(C_FSIZE)) then begin
                cmdparam := Trim(cmdparam);
                sColor := Trim(Copy(cmdparam, Length(C_FSIZE) + 1, Length(cmdparam) - Length(C_FSIZE)));
                btFontSize := StrToIntDef(sColor, 9);
                cmdparam := '';
              end
              else if CompareLStr(cmdparam, C_FBOLD, Length(C_FBOLD)) then begin
                FontStyle := FontStyle + [fsBold];
                cmdparam := '';
              end;
            end;
            // nPos := Pos('FCOLOR=', cmdparam);
//            if CompareLStr(cmdparam, C_FCOLOR, Length(C_FCOLOR)) or
//              CompareLStr(cmdparam, C_SCOLOR, Length(C_SCOLOR)) then
//            begin
//              cmdparam := Trim(cmdparam);
//              sColor := Trim(Copy(cmdparam, Length(C_FCOLOR) + 1,
//                Length(cmdparam) - Length(C_FCOLOR)));
//              btColor := StrToIntDef(sColor, 100);
//              UseColor := GetRGB(btColor);
//              cmdparam := '';
//            end
//            else if CompareLStr(cmdparam, C_AUTOCOLOR, Length(C_AUTOCOLOR))
//              then
//            begin
//              cmdparam := Trim(cmdparam);
//              sColor := Trim(Copy(cmdparam, Length(C_AUTOCOLOR) + 1,
//                Length(cmdparam) - Length(C_AUTOCOLOR)));
//              GetColorList(sColor);
//              if ColorList.Count > 0 then
//                UseColor := TColor(ColorList.Items[0]);
//              cmdparam := '';
//            end;
          end;

          if (Length(cmdstr) > 0) and (Length(cmdparam) > 0) and (cmdparam[1] = '@') then begin
            // 超链接按钮 -- 文字、颜色  -- piaoyun 2013-07-04
            nX := nX + NewNpcLabel(cmdstr, cmdparam, clWhite, '宋体', 9, []);
          end
          else begin
            if (cmdstr <> '') then begin
              nX := nX + NewNpcLabel(cmdstr, '', UseColor, sFontName, btFontSize, FontStyle);
            end;
          end;
        end;
        if Length(Data) > 0 then
          nX := nX + NewNpcLabel(Data, '', clWhite, '宋体', 9, []);
        // DecodeColor(Data, '', nil);
      // Data := '';
      end;
      nX := X;
      nY := nY + 16;
    end;

    ColorList.Free;
    {$IF IsMultiThreadRender = 1}
  finally
    DBackground.UnLock;
  end;
  {$IFEND}
end;

function TSerialWindows.DMessageDlg(MsgStr:string; DlgButtons:TMsgDlgButtons; DefaultText:string = ''; MaxLen:Integer = 0):TModalResult;
var
  XBase:Integer;
  I, lx, ly:Integer;
  Ctrl:TDxControl;
  nSpace:Integer;
begin
  if DMsgDlg.Visible then begin
    Result := mrNone;
    Exit;
  end;

  if not g_ConfigClient.boCustomUI then begin
    if g_ClientVersion <> cvMirNewUI205 then begin
      XBase := 324;
      lx := XBase;
      ly := 126;
      nSpace := 110;
    end
    else begin
      XBase := 300;
      lx := XBase;
      ly := 126;
      nSpace := 110;
    end;
  end
  else begin
    XBase := DMsgDlgCancel.Left;
    lx := XBase;
    ly := DMsgDlgCancel.Top;
    nSpace := FMsgDlgButtonSpace;
  end;

  DScreen.ClearHint;
  HintWindows.Clear;

  for I := DMsgDlg.ControlCount - 1 downto 0 do begin
    Ctrl := TDxControl(DMsgDlg.Control[I]);
    if (Ctrl <> DMsgDlgLabel) and (Ctrl <> EdDlgEdit) and (Ctrl <> DMsgDlgYes) and (Ctrl <> DMsgDlgNo) and (Ctrl <> DMsgDlgOk) and (Ctrl <> DMsgDlgCancel) then begin
      Ctrl.Free;
    end;
  end;

  //DMsgDlgLabel.Caption := MsgStr;
  DMsgDlgLabel.Visible := False;
  AddMessageDlg(DMsgDlg, DMsgDlgLabel.Left, DMsgDlgLabel.Top, MsgStr);

  ViewDlgEdit := False;

  EdDlgEdit.Visible := False;
  DMsgDlg.Floating := True;
  DMsgDlgOk.Visible := False;
  DMsgDlgYes.Visible := False;
  DMsgDlgCancel.Visible := False;
  DMsgDlgNo.Visible := False;
  DMsgDlg.Left := (SCREENWIDTH - DMsgDlg.Width) div 2;
  DMsgDlg.Top := (SCREENHEIGHT - DMsgDlg.Height) div 2;

  if mbCancel in DlgButtons then begin
    DMsgDlgCancel.Left := lx;
    DMsgDlgCancel.Top := ly;
    DMsgDlgCancel.Visible := True;
    lx := lx - nSpace;
  end;
  if mbNo in DlgButtons then begin
    DMsgDlgNo.Left := lx;
    DMsgDlgNo.Top := ly;
    DMsgDlgNo.Visible := True;
    lx := lx - nSpace;
  end;
  if mbYes in DlgButtons then begin
    DMsgDlgYes.Left := lx;
    DMsgDlgYes.Top := ly;
    DMsgDlgYes.Visible := True;
    lx := lx - nSpace;
  end;
  if (mbOk in DlgButtons) or (lx = XBase) then begin
    DMsgDlgOk.Left := lx;
    DMsgDlgOk.Top := ly;
    DMsgDlgOk.Visible := True;
  end;

  HideAllControls;

  if mbAbort in DlgButtons then begin
    ViewDlgEdit := True;
    DMsgDlg.Floating := False;

    EdDlgEdit.Text := DefaultText;
    if MaxLen > 0 then begin
      EdDlgEdit.MaxLength := MaxLen;
    end
    else begin
      EdDlgEdit.MaxLength := g_ClientConfig.nMaxInputStringLen;
    end;

    if not g_ConfigClient.boCustomUI then begin
      EdDlgEdit.Width := DMsgDlg.Width - 70;
      EdDlgEdit.Left := (DMsgDlg.Width - EdDlgEdit.Width) div 2;
      EdDlgEdit.Top := (DMsgDlg.Height - EdDlgEdit.Height) div 2 - 10;
    end;

    EdDlgEdit.Visible := True;
  end;

  DScreen.ClearHint;
  HintWindows.Clear;
  DMsgDlg.EnableFocus := not EdDlgEdit.Visible;

  {$IF IsMultiThreadRender = 1}
  DMsgDlg.ShowModal();
  {$ELSE}
  frmMain.TimerRender.Enabled := False;
  DMsgDlg.ShowModal(frmMain.RenderNotifyEvent);
  frmMain.TimerRender.Enabled := True;
  {$IFEND}

  DlgEditText := EdDlgEdit.Text;
  ViewDlgEdit := False;
  RestoreHideControls;
  Result := DMsgDlg.DialogResult;

  for I := DMsgDlg.ControlCount - 1 downto 0 do begin
    Ctrl := TDxControl(DMsgDlg.Control[I]);
    if (Ctrl <> DMsgDlgLabel) and (Ctrl <> EdDlgEdit) and (Ctrl <> DMsgDlgYes) and (Ctrl <> DMsgDlgNo) and (Ctrl <> DMsgDlgOk) and (Ctrl <> DMsgDlgCancel) then begin
      Ctrl.Free;
    end;
  end;
end;

procedure TSerialWindows.DMsgDlgOkClick(Sender:TObject; X, Y:Integer);
var
  PlugData:TAntiPlugNotifyEventMouseData;
begin
  if Sender = DMsgDlgOk then begin
    DMsgDlg.DialogResult := mrOk;

    if Assigned(g_AntiPlugNotifyFunc) then begin
      PlugData.nX := X;
      PlugData.nY := Y;
      PlugData.MouseButton := 0;
      PlugData.ShiftState := 0;

      g_AntiPlugNotifyFunc(event_MsgDlg_Click, @PlugData, SizeOf(PlugData));
    end;
  end;
  if Sender = DMsgDlgYes then begin
    DMsgDlg.DialogResult := mrYes;

    if Assigned(g_AntiPlugNotifyFunc) then begin
      PlugData.nX := X;
      PlugData.nY := Y;
      PlugData.MouseButton := 0;
      PlugData.ShiftState := 0;

      g_AntiPlugNotifyFunc(event_MsgDlg_Click, @PlugData, SizeOf(PlugData));
    end;
  end;

  if Sender = DMsgDlgCancel then
    DMsgDlg.DialogResult := mrCancel;
  if Sender = DMsgDlgNo then
    DMsgDlg.DialogResult := mrNo;
  DMsgDlg.Visible := False;
end;

