procedure TSerialWindows.DBotPlusAbilPaint(Sender:TObject);
var
  Texture:TTexture;
  vtRect:TRect;
begin
  with Sender as TDxImageButton do begin
    if g_ClientVersion <> cvMirNewUI205 then begin
      if g_ConfigClient.boCustomUI and (DBotPlusAbil.ImageIndex.Image <> nil) then begin
        if g_nBotPlusAbilFlashIndex < FBotPlusAbilFlashStartIndex then
          g_nBotPlusAbilFlashIndex := FBotPlusAbilFlashStartIndex
        else if g_nBotPlusAbilFlashIndex > FBotPlusAbilFlashStartIndex + 3 then
          g_nBotPlusAbilFlashIndex := FBotPlusAbilFlashStartIndex;

        if MyGetTickCount - g_dwBotPlusAbilFlashTick > 200 then begin
          g_dwBotPlusAbilFlashTick := MyGetTickCount;
          Inc(g_nBotPlusAbilFlashIndex);
          if g_nBotPlusAbilFlashIndex > FBotPlusAbilFlashStartIndex + 3 then
            g_nBotPlusAbilFlashIndex := FBotPlusAbilFlashStartIndex;
        end;

        Texture := DBotPlusAbil.ImageIndex.Image.Images[g_nBotPlusAbilFlashIndex];
      end
      else begin
        if MyGetTickCount - g_dwBotPlusAbilFlashTick > 200 then begin
          g_dwBotPlusAbilFlashTick := MyGetTickCount;
          Inc(g_nBotPlusAbilFlashIndex);
          if g_nBotPlusAbilFlashIndex > 221 then
            g_nBotPlusAbilFlashIndex := 218;
        end;
        Texture := g_WMainImages.Images[g_nBotPlusAbilFlashIndex];
      end;
    end
    else begin
      if g_nBotPlusAbilFlashIndex < 426 then
        g_nBotPlusAbilFlashIndex := 426;
      if MyGetTickCount - g_dwBotPlusAbilFlashTick > 200 then begin
        g_dwBotPlusAbilFlashTick := MyGetTickCount;
        Inc(g_nBotPlusAbilFlashIndex);
        if g_nBotPlusAbilFlashIndex > 429 then
          g_nBotPlusAbilFlashIndex := 426;
      end;
      Texture := g_WNewopUIImages.Images[g_nBotPlusAbilFlashIndex];
    end;

    if Texture <> nil then begin
      vtRect := VirtualRect;
      if MouseDowned then begin
        GameCanvas.Draw(vtRect.Left + 1, vtRect.Top + 1, Texture);
      end
      else begin
        GameCanvas.Draw(vtRect.Left, vtRect.Top, Texture);
      end;
    end;
  end;
end;

