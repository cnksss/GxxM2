procedure TSerialWindows.DGuildManagePageChangeClick(Sender:TObject; X, Y:Integer);
var
  OnPageCount:Integer;
  GuildGroup:TGuildGroup;
begin
  if DGuildManagePageControl.ActivePageIndex = 0 then begin
    if Sender = DGuildManagePrevious then begin
      if Memo.Visible then begin
        SendMessage(Memo.Handle, EM_LINESCROLL, 0, -1);
      end
      else if DGuildManageMemoGuildMember.Position > 0 then begin
        DGuildManageMemoGuildMember.Previous
      end;
    end
    else if Sender = DGuildManageNext then begin
      if Memo.Visible then begin
        SendMessage(Memo.Handle, EM_LINESCROLL, 0, 1);
      end
      else if DGuildManageMemoGuildMember.Lines.Count > DGuildManageMemoGuildMember.ShowItemCount then begin
        DGuildManageMemoGuildMember.Next;
      end;
    end;
  end
  else if DGuildManagePageControl.ActivePageIndex = 1 then begin
    if (FGuildGroupIndex < 0) or (FGuildGroupIndex > GuildGroupList.Count) then
      Exit;

    GuildGroup := GuildGroupList.Groups[FGuildGroupIndex];
    if GuildGroup = nil then
      Exit;

    if Sender = DGuildManagePrevious then begin
      if GuildGroupListPage > 0 then begin
        Dec(GuildGroupListPage);
      end;
    end
    else if Sender = DGuildManageNext then begin
      OnPageCount := DGuildManageForm2ChatMembers.RowCount * DGuildManageForm2ChatMembers.ColCount;
      if OnPageCount > 0 then begin
        if (GuildGroup.Members.Count + OnPageCount - 1) div OnPageCount - 1 > GuildGroupListPage then begin
          Inc(GuildGroupListPage);
        end;
      end;
    end;
  end
  else if DGuildManagePageControl.ActivePageIndex = 2 then begin
    if Sender = DGuildManagePrevious then begin
      if GuildJoinUserListPage > 0 then begin
        Dec(GuildJoinUserListPage);
        FrmMain.SendGuildGetJoinUserList(GuildJoinUserListPage);
      end;
    end
    else if Sender = DGuildManageNext then begin
      Inc(GuildJoinUserListPage);
      FrmMain.SendGuildGetJoinUserList(GuildJoinUserListPage);
    end;
  end
  else if DGuildManagePageControl.ActivePageIndex = 3 then begin
    if Sender = DGuildManagePrevious then begin
      if DGuildManageListViewWJ.Position > 0 then begin
        DGuildManageListViewWJ.Previous
      end;
    end
    else if Sender = DGuildManageNext then begin
      if DGuildManageListViewWJ.Count > DGuildManageListViewWJ.ShowItemCount then begin
        DGuildManageListViewWJ.Next;
      end;
    end;
  end
  else if DGuildManagePageControl.ActivePageIndex = 4 then begin
    if Sender = DGuildManagePrevious then begin
      if DGuildManageMemo5.Position > 0 then begin
        DGuildManageMemo5.Previous
      end;
    end
    else if Sender = DGuildManageNext then begin
      if DGuildManageMemo5.Lines.Count > DGuildManageMemo5.ShowItemCount then begin
        DGuildManageMemo5.Next;
      end;
    end;
  end
end;

