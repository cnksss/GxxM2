procedure TSerialWindows.SetMyShopPageCount;
var
  nPage, nPageCount:Integer;
begin
  if DMyShopPageControl.ActivePageIndex <= 2 then begin
    if g_MyShopItemCounts[DMyShopPageControl.ActivePageIndex] > 0 then begin
      nPage := (g_MyShopItemIndexs[DMyShopPageControl.ActivePageIndex] + 1) div 5 + 1;
      nPageCount := g_MyShopItemCounts[DMyShopPageControl.ActivePageIndex] div 5;
      if g_MyShopItemCounts[DMyShopPageControl.ActivePageIndex] mod 5 > 0 then
        Inc(nPageCount);
      if nPageCount <= 0 then
        nPageCount := 1;
    end
    else begin
      nPage := 0;
      nPageCount := 0;
    end;
    if DMyShopPageControl.ActivePage <> nil then begin
      LabelMyShopPageCount.Caption := Format('%s %d/%d', [TDxTabSheet(DMyShopPageControl.ActivePage).Caption, nPage, nPageCount]);
    end;
  end;
end;

procedure TSerialWindows.SetGameShopPageCount;
var
  nPage, nPageCount:Integer;
begin
  if DGameShopPageControl.ActivePageIndex = 0 then begin
    if g_nUserShopCount > 0 then begin
      nPage := (g_nUserShopIndex + 1) div 8 + 1;

      nPageCount := g_nUserShopCount div 8;
      if g_nUserShopCount mod 8 > 0 then
        Inc(nPageCount);
      if nPageCount <= 0 then
        nPageCount := 1;
    end
    else begin
      nPage := 0;
      nPageCount := 0;
    end;
    LabelGameShopPageCount.Caption := Format('%s %d/%d', ['所有商铺', nPage, nPageCount]);
  end
  else begin
    if g_nSearchUserShopItemCount > 0 then begin
      nPage := (g_nSearchUserShopItemIndex + 1) div 5 + 1;
      nPageCount := g_nSearchUserShopItemCount div 5;
      if g_nSearchUserShopItemCount mod 5 > 0 then
        Inc(nPageCount);
      if nPageCount <= 0 then
        nPageCount := 1;
    end
    else begin
      nPage := 0;
      nPageCount := 0;
    end;
    LabelGameShopPageCount.Caption := Format('%s %d/%d', ['购买物品', nPage, nPageCount]);
  end;
end;

