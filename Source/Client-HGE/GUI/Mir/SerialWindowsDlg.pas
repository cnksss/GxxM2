procedure TSerialWindows.DRankingDlgMouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  ly, idx:Integer;
  vtRect:TRect;
begin
  vtRect := TDxImageForm(Sender).VirtualRect;
  ly := Y - vtRect.Top;
  idx := ly div (LISTLINEHEIGHT + 9);
  if (idx > 0) and (idx <= 10) then begin
    RankingSelectLine := idx;
    if g_nRankingsTablePage = 0 then begin
      if g_UserLevelRankings[idx - 1].sChrName <> '' then begin
        ShowChatEdit();
        DEdChat.Text := '/' + g_UserLevelRankings[idx - 1].sChrName + ' ';
      end;
    end
    else begin
      if g_UserMasterRankings[idx - 1].sChrName <> '' then begin
        ShowChatEdit();
