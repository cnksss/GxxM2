    nItemBoxIndex, nFaceIndex, nFileIndex, nHotIndex, nDownIndex, nLeft, nTop, nWidth, nHeight, nCount:Integer;
    nCaptionIndex:Integer;
    sHintText:string;
  begin
    Result := 0; //HZQ 缺少预置默认值
