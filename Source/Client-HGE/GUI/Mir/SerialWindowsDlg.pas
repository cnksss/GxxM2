{ TFmtTokenMgr }

constructor TFmtTokenMgr.Create;
begin
  FTokens := TList.Create;
end;

destructor TFmtTokenMgr.Destroy;
begin
  Clear;
  FTokens.Free;
  inherited;
end;

function TFmtTokenMgr.Add(AVarName, AText:string; AFixedLen:Integer):PFmtToken;
begin
  New(Result);
  FTokens.Add(Result);
  Result.VarName := AVarName;
  Result.Text := AText;
  Result.FixedLen := AFixedLen;
end;

procedure TFmtTokenMgr.Clear;
var
  I:Integer;
  FmtToken:PFmtToken;
begin
  for I := 0 to FTokens.Count - 1 do begin
    FmtToken := FTokens.Items[I];
    Dispose(FmtToken);
  end;
  FTokens.Clear;
end;

function TFmtTokenMgr.GetCount:Integer;
begin
  Result := FTokens.Count;
end;

function TFmtTokenMgr.GetTokens(Index:Integer):PFmtToken;
begin
  Result := FTokens.Items[Index];
end;

procedure TFmtTokenMgr.Init(S:string);

  function CheckToken(AToken:WideString; var AVarName:WideString; var AFixedLen:Integer):Boolean;
  var
    I, Index:Integer;
    S1, S2:WideString;
  begin
    Result := False;
    Index := 0;
    AToken := Copy(AToken, 2, Length(AToken) - 2);
    for I := 1 to Length(AToken) do begin
      if AToken[I] = ':' then begin
        Index := I;
        Break;
      end;
    end;

    if Index = 0 then begin
      Result := True;
      AVarName := AToken;
      AFixedLen := 0;
    end
    else begin
      S1 := Copy(AToken, 1, Index - 1);
      S2 := Copy(AToken, Index + 1, Length(AToken) - Index);

      if TryStrToInt(S2, AFixedLen) then begin
        Result := True;
        AVarName := S1;
      end;
    end;
  end;

var
  Index, Index2, TokenLen:Integer;
  Text:WideString;
  WChar:WideChar;
  SRemberText, Token, VarName:WideString;
begin
  Clear;
  Text := S;
  Index := 1;
  SRemberText := '';

  while True do begin
    if Index > Length(Text) then
      Break;

    WChar := Text[Index];
    if WChar = '{' then begin
      Index2 := Index + 1;
      while (Index2 < Length(Text)) and (Text[Index2] <> '}') do begin
        Inc(Index2);
      end;

      TokenLen := Index2 - Index + 1;
      Token := Copy(Text, Index, TokenLen);

      if (Length(Token) > 3) and (Token[2] = '$') and (Token[Length(Token)] = '}') then begin
        if not CheckToken(Token, VarName, TokenLen) then begin
          SRemberText := SRemberText + Token;
        end
        else begin
          if Length(SRemberText) > 0 then begin
            Add('', SRemberText, 0);
            SRemberText := '';
          end;

          Add(VarName, Token, TokenLen);
        end;
      end
      else begin
        SRemberText := SRemberText + Token;
      end;

      Index := Index2 + 1;
    end
    else begin
      SRemberText := SRemberText + WChar;
      Inc(Index);
    end;
  end;

  if Length(SRemberText) > 0 then begin
    Add('', SRemberText, 0);
    SRemberText := '';
  end;
end;

