procedure TSerialWindows.HeroStateWinDirectPaint(Sender:TObject);
var
  ItemName, sLine1, sLine2, sLine3:string;
  n, I, nLeft, nTop, nY:Integer;
  IsUseableLine2, IsUseableLine3:Boolean;
  bbx, bby, nIdx, ax, ay:Integer;
  d:TTexture;
  vtRect, vtRect2:TRect;
  vbRect:TRect;
  IsShowHelmet, IsShowHair:Boolean;
  ItemDesc:TStringList;
  R:TRect;
begin
  if g_MyHero = nil then
    Exit;
  // DStateWin := TDxImageForm(Sender);
  // 修正调整UI时，背景与发型对不上 chongchong 2014-11-06
  {
  with DHeroStateWin do
  begin
    vbRect := VisibleRect;
    if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then Exit;
    vtRect := VirtualRect;
    if DHeroStatePageControl.ActivePageIndex = 0 then
    begin
      bbx := vtRect.Left + 38;
      bby := vtRect.Top + 52;
  end;
  }
  // 把这个B底层播放放到衣服下面 太阳.... chongchong 2016-08-04
  FrmDlg.DrawBodyItemBelowEffect(DHeroSWLight.VirtualRect, @g_HeroUseItems[DHeroSWLight.Tag].S, @g_HeroUseItemsEffect[DHeroSWLight.Tag]);

  with DHeroStateForm1 do begin
    vbRect := VisibleRect;
    if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
      Exit;
    vtRect := VirtualRect;
    if DHeroStatePageControl.ActivePageIndex = 0 then begin
      bbx := vtRect.Left + 0;
      bby := vtRect.Top + 0;

      bbx := bbx - 7 + g_ConfigClient.nHeroUserHairOffsetX2;
      bby := bby + 44 + g_ConfigClient.nHeroUserHairOffsetX2;

      IsShowHair := True;
      if g_HeroUseItems[U_DRESS].S.Name <> '' then begin
        // 个位用来表示是否显示发型，Expand5 div 10用来表示使提示框文字使用哪个图片作为背景 2019-12-15 10:05:20
        IsShowHair := g_HeroUseItems[U_DRESS].S.Expand5 mod 10 = 0;
      end;

      if IsShowHair then begin
        if g_MyHero.m_btHair < 4 then begin
          nIdx := 440 + g_MyHero.m_btHair;
          if nIdx > 0 then begin
            d := g_WMainImages.GetCachedImage(nIdx, ax, ay);
            if d <> nil then
              GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
          end;
        end
        else if (g_MyHero.m_btHair >= 50) and (g_MyHero.m_btHair <= 69) then begin
          nIdx := 350 + g_MyHero.m_btHair;
          d := g_WNewopUIImages.GetCachedImage(nIdx, ax, ay);
          if d <> nil then
            GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
        end;
      end;

      if g_HeroUseItems[U_DRESS].S.Name <> '' then begin
        DrawBodyItemEffect(bbx, bby, @g_HeroUseItems[U_DRESS], @g_HeroUseItemsEffect[U_DRESS], True);

        nIdx := g_HeroUseItems[U_DRESS].S.looks;
        if nIdx >= 0 then begin
          d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
          if d <> nil then
            GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
        end;

        DrawBodyItemEffect(bbx, bby, @g_HeroUseItems[U_DRESS], @g_HeroUseItemsEffect[U_DRESS], False);
      end;
      if g_HeroUseItems[U_WEAPON].S.Name <> '' then begin
        DrawBodyItemEffect(bbx, bby, @g_HeroUseItems[U_WEAPON], @g_HeroUseItemsEffect[U_WEAPON], True);

        nIdx := g_HeroUseItems[U_WEAPON].S.looks;
        if nIdx >= 0 then begin
          d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
          if d <> nil then
            GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
        end;

        DrawBodyItemEffect(bbx, bby, @g_HeroUseItems[U_WEAPON], @g_HeroUseItemsEffect[U_WEAPON], False);
      end;
      if g_HeroUseItems[U_HELMET].S.Name <> '' then begin
        nIdx := g_HeroUseItems[U_HELMET].S.looks;
        IsShowHelmet := True;
        if (g_HeroUseItems[U_HELMET].S.StdMode = 15) then begin
          if (g_HeroUseItems[U_HAT].S.Name <> '') and (g_HeroUseItems[U_HAT].S.StdMode = 16) and (g_HeroUseItems[U_HAT].S.Shape <> 1000) {1000 为面巾，面巾和头盔可同时显示} then
            IsShowHelmet := False;
        end;
        if (nIdx >= 0) and IsShowHelmet then begin
          d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
          if d <> nil then begin
            if g_ClientConfig.boHelmetShowInBox then begin
              ax := DHeroSWHelmet.VirtualRect.Left + (DHeroSWHelmet.Width - d.Width) div 2;
              ay := DHeroSWHelmet.VirtualRect.Top + (DHeroSWHelmet.Height - d.Height) div 2;
              GameCanvas.Draw(ax, ay, d.ClientRect, d);
            end
            else begin
              GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
            end;
          end;
        end;
        if IsShowHelmet then
          DrawBodyItemEffect(DHeroSWHelmet.VirtualRect, @g_HeroUseItems[U_HELMET].S, @g_HeroUseItemsEffect[U_HELMET], False);
      end;

      if g_HeroUseItems[U_HAT].S.Name <> '' then begin
        nIdx := g_HeroUseItems[U_HAT].S.looks;
        if nIdx >= 0 then begin
          d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
          if d <> nil then
            GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
        end;
        DrawBodyItemEffect(DHeroSWHelmet.VirtualRect, @g_HeroUseItems[U_HAT].S, @g_HeroUseItemsEffect[U_HAT], False);
      end;

      // 修复非连击界面看不到英雄盾牌内观 chongchong 2014-11-29
      if g_HeroUseItems[U_SHIELD].S.Name <> '' then begin
        DrawBodyItemEffect(R, @g_HeroUseItems[U_SHIELD].S, @g_HeroUseItemsEffect[U_SHIELD], True);

        nIdx := g_HeroUseItems[U_SHIELD].S.looks;
        if nIdx >= 0 then begin
          d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
          if d <> nil then
            GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
        end;

        R := DHeroSWShield.VirtualRect;
        OffsetRect(R, 16, -2);

        DrawBodyItemEffect(R, @g_HeroUseItems[U_SHIELD].S, @g_HeroUseItemsEffect[U_SHIELD], False);
      end;
    end;

    LabelDHeroStateWinCharName.Caption := g_MyHero.m_sUserName;
    LabelDHeroStateWinCharName.CaptionColor.Up.Color := $00B1C2DC; // g_MyHero.m_nNameColor;
    vtRect2 := LabelDHeroStateWinCharName.Owner.ClientRect;

    { TODO -c注释 -opiaoyun : 英雄装备栏信息传统旧模式显示 【2013-4-24 】}
    if (g_ClientConfig.btSuspensionShowItem = 0) and (g_ClientVersion <= {cvHero} cvSerial) and (g_MouseStateItem.S.Name <> '') and (g_boShowHeroItemInfo) then begin
      GetMouseItemInfo(g_MyHero, @g_MouseStateItem, False, ItemName, sLine1, sLine2, sLine3, IsUseableLine2, IsUseableLine3);
      if g_ClientVersion = cv176 then begin
        nLeft := vtRect.Left + 0;
        nTop := vtRect.Top + 220;
      end
      else begin
        nLeft := vtRect.Left + 0;
        nTop := vtRect.Top + 258;
      end;
      if ItemName <> '' then begin
        nY := nTop;
        if sLine2 <> '' then
          nY := nTop + 14;
        if sLine3 <> '' then
          nY := nTop + 14 * 2;

        n := DrawItemHintOldStyle(nLeft, nTop, ItemName, clYellow);
        DrawItemHintOldStyle(nLeft + n, nTop, sLine1);

        if not IsUseableLine2 then
          DrawItemHintOldStyle(nLeft, nTop + 14, sLine2, clRed)
        else
          DrawItemHintOldStyle(nLeft, nTop + 14, sLine2);

        if not IsUseableLine3 then
          DrawItemHintOldStyle(nLeft, nTop + 14 * 2, sLine3, clRed)
        else
          DrawItemHintOldStyle(nLeft, nTop + 14 * 2, sLine3);

        if not g_ClientConfig.boDescSupportRenamItem then
          ItemDesc := GetItemDesc(@g_MouseStateItem, g_MouseStateItem.S.DBName)
        else begin
          ItemDesc := GetItemDesc(@g_MouseStateItem, g_MouseStateItem.S.Name);
          if g_ClientConfig.boNoRenameDescReadDefault and ((ItemDesc = nil) or (ItemDesc.Count = 0)) then begin
            ItemDesc := GetItemDesc(@g_MouseStateItem, g_MouseStateItem.S.DBName);
          end;
        end;

        if (ItemDesc <> nil) and (ItemDesc.Count > 0) then begin
          for I := 0 to ItemDesc.Count - 1 do begin
            CurrentFont.TextOut(nLeft, nY + 14 * (I + 1), ItemDesc.Strings[I], TColor(ItemDesc.Objects[I]));
          end;

        end;
      end;
    end;
  end;
end;

