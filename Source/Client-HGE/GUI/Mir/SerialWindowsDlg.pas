procedure TSerialWindows.OpenGuildEditGradeDlg;
var
  sData:string;
  I:Integer;
  vtRect:TRect;
begin
  if GuildMembers.Count <= 0 then begin
    DMessageDlg('请先打开成员列表。', [mbOk]);
    Exit;
  end;

  DGEHint.Caption := GuildEditHint;
  DGEHint.AutoSize := True;

  with DGuildEditNotice do begin
    Left := (SCREENWIDTH - Width) div 2;
    Top := (SCREENHEIGHT - Height) div 2;

    HideAllControls;

    vtRect := VirtualRect;
    Memo.Left := vtRect.Left + DGEEdit.Left;
    Memo.Top := vtRect.Top + DGEEdit.Top;
    Memo.Width := DGEEdit.Width;
    Memo.Height := DGEEdit.Height;
    Memo.Lines.Assign(GuildMembers);
    Memo.Visible := True;
    ShowModal;
    Memo.Visible := False;
    DGuildEditNotice.Visible := False;
    RestoreHideControls;
    Memo.Visible := False;
    if DMsgDlg.DialogResult = mrOk then begin
      Application.ProcessMessages;
      // GuildMembers.Assign(Memo.Lines);
      sData := '';
      for I := 0 to Memo.Lines.Count - 1 do begin
        sData := sData + Memo.Lines[I] + #13;
      end;
      if Length(sData) > 5000 then begin
        sData := Copy(sData, 1, 5000);
        DMessageDlg('内容超过限制大小，将被截短！', [mbOk]);
      end;
      frmMain.SendGuildUpdateGrade(sData);
    end
    else
      Application.ProcessMessages;
  end;
end;

