end;

procedure TSerialWindows.RecallTradingSellPrices;
var
  I:Integer;
  Prices:LongWord;
begin
  if DTradingMarketDlg.Visible then begin
    Prices := 0;
    for I := 0 to Length(g_SellDlgItems) - 1 do begin
      if Length(g_SellDlgItems[I].S.Name) > 0 then
        Prices := Prices + LongWord(g_SellDlgItems[I].S.Expand1);
    end;

    DTradingMarketSellTotalPrices.Caption := IntToStr(Prices) + g_sGoldName;
  end;
end;

