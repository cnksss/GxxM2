procedure TSerialWindows.DBtnRemoveStoneDirectPaint(Sender:TObject);
var
  I, Index:Integer;
  R:TRect;
  d:TTexture;
  Item:PTClientItem;
  S:string;
begin
  if g_StoneRemoveItem.Item.s.Name = '' then
    Exit;

  Index := (Sender as TDxImageButton).Tag - 1;
  if (Index in [0..MAX_FLUTE_COUNT - 1]) and (Index < g_StoneRemoveItem.Item.btFluteCount) then begin
    Item := GetStdItem(g_StoneRemoveItem.Item.Flutes[Index].GemIndex);
    if Item <> nil then begin
      R := TDxImageButton(Sender).VirtualRect;
      d := g_WBagItemImages.Images[Item.s.Looks];
      if d <> nil then begin
        GameCanvas.Draw(R.Left + ((R.Right - R.Left) - d.Width) div 2 - 1, R.Top + ((R.Bottom - R.Top) - d.Height) div 2 + 1, d.ClientRect, d);
        if g_StoneRemoveItem.Item.Flutes[Index].GemCount > 1 then begin
          S := 'x' + IntToStr(g_StoneRemoveItem.Item.Flutes[Index].GemCount);

          BoldTextOut(R.Left + ((R.Right - R.Left) - CurrentFont.TextWidth(S) - 2), R.Top + 2, S, clLime);
        end;
      end;

      if FRemoveStoneShowEffect and (Index = FRemoveStoneIdx) then begin
        if (MyGetTickCount - FRemoveStoneShowEffectTick) > 54 then begin
          FRemoveStoneShowEffectTick := MyGetTickCount;
          Inc(FRemoveStoneShowEffectIdx);
          if FRemoveStoneShowEffectIdx >= 25 then begin
            FRemoveStoneShowEffect := False;

            // 删除锤子
            if IsOverLapItem(@g_StoneRemove_UseQZ.s) and (g_StoneRemove_UseQZ.Dura > 0) then begin
              for I := Low(g_ItemArr) to High(g_ItemArr) do begin
                if (g_ItemArr[I].S.Name <> '') and (g_ItemArr[I].MakeIndex = g_StoneRemove_UseQZ.MakeIndex) then begin
                  g_ItemArr[I].Dura := g_ItemArr[I].Dura - 1;
                  Break;
                end;
              end;
            end
            else begin
              DelItemBag(g_StoneRemove_UseQZ.s.Name, g_StoneRemove_UseQZ.MakeIndex);
            end;

            Item.MakeIndex := FRemoveStoneIndex;
            Item.Dura := 0;

            // 把宝石加入包裹
            if not FRemoveStoneHideStone then begin
              if FOverlapStoneItemMakeIndex = 0 then
                AddItemBag(Item^)
              else begin
                for I := Low(g_ItemArr) to High(g_ItemArr) do begin
                  if (g_ItemArr[I].S.Name <> '') and (g_ItemArr[I].MakeIndex = FOverlapStoneItemMakeIndex) then begin
                    g_ItemArr[I].Dura := g_ItemArr[I].Dura + 1;
                    Break;
                  end;
                end;
              end;

              if g_StoneRemoveItem.Item.Flutes[FRemoveStoneIdx].GemCount > 1 then begin
                Dec(g_StoneRemoveItem.Item.Flutes[FRemoveStoneIdx].GemCount);
              end
              else begin
                g_StoneRemoveItem.Item.Flutes[FRemoveStoneIdx].GemIndex := 0;
                g_StoneRemoveItem.Item.Flutes[FRemoveStoneIdx].GemCount := 0;
              end;

              FRemoveStoneLock := False;
            end
            else begin
              FRemoveStoneHideStoneEffect := True;
              FRemoveStoneHideStoneEffectTick := MyGetTickCount;
              FRemoveStoneHideStoneEffectIdx := 0;

              //g_StoneRemoveItem.Item.wFlute[FRemoveStoneIdx] := 0;
              //FRemoveStoneLock := False;
            end;
            g_SendStoneRemove_UseQZ.s.name := '';
          end;
        end;

        d := g_WNewopUIImages.Images[1170 + FRemoveStoneShowEffectIdx mod 7];
        if d <> nil then begin
          GameCanvas.Draw(R.Left + 1, R.Top + 1, d.ClientRect, d);
        end;
      end
      else if FRemoveStoneHideStoneEffect and (Index = FRemoveStoneIdx) then begin
        if (MyGetTickCount - FRemoveStoneHideStoneEffectTick) > 100 then begin
          FRemoveStoneHideStoneEffectTick := MyGetTickCount;
          Inc(FRemoveStoneHideStoneEffectIdx);
          if FRemoveStoneHideStoneEffectIdx >= 4 then begin
            FRemoveStoneHideStoneEffect := False;

            // 宝石消失
            if g_StoneRemoveItem.Item.Flutes[FRemoveStoneIdx].GemCount > 1 then begin
              Dec(g_StoneRemoveItem.Item.Flutes[FRemoveStoneIdx].GemCount);
            end
            else begin
              g_StoneRemoveItem.Item.Flutes[FRemoveStoneIdx].GemIndex := 0;
              g_StoneRemoveItem.Item.Flutes[FRemoveStoneIdx].GemCount := 0;
            end;

            if Length(FRemoveStoneHideStoneMsg) > 0 then begin
              DScreen.AddChatBoardString(FRemoveStoneHideStoneMsg, clRed, clWhite);
            end;

            FRemoveStoneLock := False;
          end;
        end;

        d := g_WNewopUIImages.Images[1160 + FRemoveStoneHideStoneEffectIdx];
        if d <> nil then begin
          GameCanvas.Draw(R.Left - 102, R.Top - 203, d.ClientRect, d);
        end;
      end;
    end;
  end;
end;

