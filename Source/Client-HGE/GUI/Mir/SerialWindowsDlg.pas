procedure TSerialWindows.DBotWineMatMouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  DxButton:TDxImageButton;
begin
  DxButton := TDxImageButton(Sender);
  if (DxButton.Tag in [0, 1]) and (g_PleaseDrinkItemWait[0].S.Name = '') and (g_PleaseDrinkItemWait[1].S.Name = '') then begin
    if g_boItemMoving then begin
      if (g_MovingItem.ItemType in [mtBagItem, mtWineMatItem]) and (g_PleaseDrinkItem[DxButton.Tag].S.Name = '') and (g_MovingItem.Item.s.StdMode = 60) then begin
        ItemClickSound(g_MovingItem.Item.S);
        g_PleaseDrinkItem[DxButton.Tag] := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';

        g_boItemMoving := False;
      end;
    end
    else begin
      if g_PleaseDrinkItem[DxButton.Tag].S.Name <> '' then begin
        ItemClickSound(g_PleaseDrinkItem[DxButton.Tag].S);
        g_MovingItem.Item := g_PleaseDrinkItem[DxButton.Tag];
        g_MovingItem.ItemType := mtWineMatItem;
        g_PleaseDrinkItem[DxButton.Tag].S.Name := '';
        g_boItemMoving := True;
      end;
    end;
  end;
end;

