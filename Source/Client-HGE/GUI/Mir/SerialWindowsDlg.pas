procedure TSerialWindows.DHeroM2BuyShopItemOnClick(Sender:TObject; X, Y:Integer);
var
  nReadValue, nIdx:Integer;
  sGoldName:string;
  Msg:string;
begin
  if g_MySelf = nil then
    Exit;

  if (g_nHeroM2SelectRecogId <> 0) and (g_HeroM2SelectShopItem.S.Name <> '') then begin
    if g_HeroM2SelectShopItem.S.Reserved1 = 0 then begin
      sGoldName := g_sGameGoldName;
      nReadValue := g_MySelf.m_nGameGold;
    end
    else if g_HeroM2SelectShopItem.S.Reserved1 = 1 then begin
      sGoldName := g_sGamePointName;
      nReadValue := g_MySelf.m_nGamePoint;
    end
    else if g_HeroM2SelectShopItem.S.Reserved1 = 2 then begin
      sGoldName := g_sGoldName;
      nReadValue := g_MySelf.m_nGold;
    end
    else if g_HeroM2SelectShopItem.S.Reserved1 = 3 then begin
      sGoldName := g_sGameDiamondName;
      nReadValue := g_nGameDiamond;
    end
    else if g_HeroM2SelectShopItem.S.Reserved1 = 4 then begin
      sGoldName := g_sGameGirdName;
      nReadValue := g_nGameGird;
    end
    else begin
      sGoldName := GetCustomMoneyNameByRule(g_HeroM2SelectShopItem.S.Reserved1, 0);
      nIdx := g_MoneyList.GetIndex(sGoldName);
      if nIdx >= 0 then
        nReadValue := Integer(g_MoneyList.Objects[nIdx])
      else
        nReadValue := 0;
    end;

    if nReadValue < g_HeroM2SelectShopItem.S.Price then begin
      DScreen.AddChatBoardString(sGoldName + '不足，无法购买！', clRed, clWhite);
      Exit;
    end;

    Msg := Format('你确定花费 %d %s 购买物品 %s ？', [g_HeroM2SelectShopItem.S.Price, sGoldName, ProcessItemName(g_HeroM2SelectShopItem.s.Name)]) + sLineBreak;

    if mrYes <> FrmDlg.DMessageDlg(Msg, [mbYes, mbNo]) then begin
      Exit;
    end;

    frmMain.SendClientMessage(CM_HEROM2BUYUSERSHOPITEM, g_nHeroM2SelectRecogId, LoWord(g_HeroM2SelectShopItem.MakeIndex), HiWord(g_HeroM2SelectShopItem.MakeIndex), 0, IntToStr(g_HeroM2SelectShopItem.s.Stock));
  end;
end;

procedure TSerialWindows.DHeroM2ShopRemoteDlgOnGridPaint(Sender:TObject; ACol, ARow:Integer; Rect:TRect; State:TGridDrawState);
var
  nIdx:Integer;
  PaintRect:TRect;
  sText:string;
  SrcRect:TRect;
  Texture:TTexture;
  ClientItem:TClientItem;
begin
  nIdx := ACol + ARow * DHeroM2ShopDlgRemoteGrid.ColCount;
  if nIdx in [0..19] then begin
    PaintRect := Rect;
    PaintRect.Right := Rect.Left + DHeroM2ShopDlgRemoteGrid.ColWidth;
    PaintRect.Bottom := Rect.Top + DHeroM2ShopDlgRemoteGrid.RowHeight;
    DrawGridItem(PaintRect, @g_HeroM2ShopRemoteItems[nIdx], @g_HeroM2ShopRemoteItemEffects[nIdx]);

    if (g_HeroM2ShopRemoteItems[nIdx].S.Name <> '') and (g_HeroM2SelectShopItem.S.Name <> '') and (g_HeroM2SelectShopItem.MakeIndex = g_HeroM2ShopRemoteItems[nIdx].MakeIndex) then begin // 绘制选择
      Texture := g_WMain3Images.Images[602];
      if Texture <> nil then begin
        SrcRect := Texture.ClientRect;
        GameCanvas.DrawBlend(PaintRect.Left + (DHeroM2ShopDlgRemoteGrid.ColWidth - Texture.Width) div 2, PaintRect.Top + (DHeroM2ShopDlgRemoteGrid.RowHeight - Texture.Height) div 2, SrcRect, Texture);
      end;
    end;

    if g_HeroM2ShopRemoteMouseItem.S.Name <> '' then
      ClientItem := g_HeroM2ShopRemoteMouseItem
    else if g_HeroM2SelectShopItem.S.Name <> '' then
      ClientItem := g_HeroM2SelectShopItem
    else
      ClientItem.S.Name := '';

    if ClientItem.S.Name <> '' then begin
      DLabelHeroM2ShopDlgRemoteItemName.Caption := ProcessItemName(ClientItem.S.Name);

      sText := '';
      case ClientItem.S.Reserved1 of
        0:
          sText := IntToStr(ClientItem.S.Price) + g_sGameGoldName;
        1:
          sText := IntToStr(ClientItem.S.Price) + g_sGamePointName;
        2:
          sText := IntToStr(ClientItem.S.Price) + g_sGoldName;
        3:
          sText := IntToStr(ClientItem.S.Price) + g_sGameDiamondName;
