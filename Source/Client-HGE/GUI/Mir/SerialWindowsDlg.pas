                frmMain.SendTakeOnGodBless(True, WantUseToIndex, g_WaitingHeroUseItem.Item.MakeIndex, g_WaitingHeroUseItem.Item.S.Name);
                g_MovingItem.Item.S.Name := '';
                g_boItemMoving := False;
              end;
            end
            else if g_MovingItem.Item.s.Expand1 in [1..12] then begin
              if (g_HeroGodBlessItemsState[g_MovingItem.Item.s.Expand1 - 1] = 1) then begin
                WantUseToIndex := g_MovingItem.Item.s.Expand1 - 1;

                g_WaitingHeroUseItem := g_MovingItem;
                g_WaitingHeroUseItem.Index := WantUseToIndex;
                frmMain.SendTakeOnGodBless(True, WantUseToIndex, g_WaitingHeroUseItem.Item.MakeIndex, g_WaitingHeroUseItem.Item.S.Name);
                g_MovingItem.Item.S.Name := '';
                g_boItemMoving := False;
              end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

function CompareHeroItem(BagItem, UseItem:PTClientItem):Boolean; //英雄背包物品对比
begin
  Result := False;

  if Length(UseItem.s.Name) > 0 then begin
    case g_ClientConfig.btBagFastItemCompareMode of
      1:begin
          if BagItem.s.NeedLevel > UseItem.s.NeedLevel then
            Result := True;
        end;
      2:begin
          if BagItem.s.Weight > UseItem.s.Weight then
            Result := True;
        end;
      else
        if g_MyHero.m_btJob = 0 then begin
          if ((BagItem.s.DC1 = UseItem.s.DC1) and (BagItem.s.DC2 > UseItem.s.DC2)) or ((BagItem.s.DC1 > UseItem.s.DC1) and (BagItem.s.DC2 = UseItem.s.DC2)) or ((BagItem.s.DC1 > UseItem.s.DC1) and (BagItem.s.DC2 > UseItem.s.DC2)) or (BagItem.s.DC2 > UseItem.s.DC2) or ((BagItem.s.DC1 = UseItem.s.DC1) and (BagItem.s.DC2 = UseItem.s.DC2) and (((BagItem.s.AC1 = UseItem.s.AC1) and (BagItem.s.AC2 > UseItem.s.AC2)) or ((BagItem.s.AC1 > UseItem.s.AC1) and (BagItem.s.AC2 = UseItem.s.AC2)) or ((BagItem.s.AC1 > UseItem.s.AC1) and (BagItem.s.AC2 > UseItem.s.AC2)))) then begin
            Result := True;
          end;
        end
        else if g_MyHero.m_btJob = 1 then begin
          if ((BagItem.s.MC1 = UseItem.s.MC1) and (BagItem.s.MC2 > UseItem.s.MC2)) or ((BagItem.s.MC1 > UseItem.s.MC1) and (BagItem.s.MC2 = UseItem.s.MC2)) or ((BagItem.s.MC1 > UseItem.s.MC1) and (BagItem.s.MC2 > UseItem.s.MC2)) or (BagItem.s.MC2 > UseItem.s.MC2) or ((BagItem.s.MC1 = UseItem.s.MC1) and (BagItem.s.MC2 = UseItem.s.MC2) and (((BagItem.s.AC1 = UseItem.s.AC1) and (BagItem.s.AC2 > UseItem.s.AC2)) or ((BagItem.s.AC1 > UseItem.s.AC1) and (BagItem.s.AC2 = UseItem.s.AC2)) or ((BagItem.s.AC1 > UseItem.s.AC1) and (BagItem.s.AC2 > UseItem.s.AC2)))) then begin
            Result := True;
          end;
        end
        else begin
          if ((BagItem.s.SC1 = UseItem.s.SC1) and (BagItem.s.SC2 > UseItem.s.SC2)) or ((BagItem.s.SC1 > UseItem.s.SC1) and (BagItem.s.SC2 = UseItem.s.SC2)) or ((BagItem.s.SC1 > UseItem.s.SC1) and (BagItem.s.SC2 > UseItem.s.SC2)) or (BagItem.s.SC2 > UseItem.s.SC2) or ((BagItem.s.SC1 = UseItem.s.SC1) and (BagItem.s.SC2 = UseItem.s.SC2) and (((BagItem.s.AC1 = UseItem.s.AC1) and (BagItem.s.AC2 > UseItem.s.AC2)) or ((BagItem.s.AC1 > UseItem.s.AC1) and (BagItem.s.AC2 = UseItem.s.AC2)) or ((BagItem.s.AC1 > UseItem.s.AC1) and (BagItem.s.AC2 > UseItem.s.AC2)))) then begin
            Result := True;
          end;
        end;
    end;
  end
  else begin
    Result := True;
  end;
end;

procedure TSerialWindows.DHeroItemGridGridPaint(Sender:TObject; ACol, ARow:Integer; Rect:TRect; State:TGridDrawState);
{$J+}
const
  nAniBagCompareImgIndex:Integer = -1;
  nAniBagCompareImgPlayTick:LongWord = 0;
  {$J-}
var
  nIdx:Integer;
  DItemGrid:TDxImageGrid;
  R:TRect;
  BagItem:PTClientItem;
  UseItem:PTClientItem;
  nWhere, nWhere1, nWhere2:Integer;
  Flag:Boolean;
  d:TTexture;
  boShowUP:Boolean;
begin
  if g_MyHero = nil then
    Exit;
  DItemGrid := TDxImageGrid(Sender);
  nIdx := ACol + ARow * DItemGrid.ColCount;
  if nIdx in [0..MAX_HERO_BAG_ITEM - 1] then begin
    BagItem := @g_HeroItemArr[nIdx];
    R := Bounds(Rect.Left, Rect.Top, DItemGrid.ColWidth, DItemGrid.RowHeight);
    DrawGridItem(R, BagItem, @g_HeroItemArrEffect[nIdx]);

    if (Length(BagItem.s.Name) > 0) and g_ClientConfig.boBagFastItemCompare and g_ConfigDlg.ConfigCheckeds[ckBagFastItemCompare] and (not (BagItem.s.StdMode in [93 {宠物加负重}])) then begin
      boShowUP := False;

      Flag := False;
      nWhere := GetTakeOnPosition(BagItem.S.StdMode, BagItem.S.Shape);

      UseItem := nil;
      if (g_MyHero.m_nJewelryBoxStatus = jbsOpen) and (BagItem.s.OverLap and 2 <> 0)
        //HZQ 20230525 右戒指笔误
      and (nWhere in [U_HELMET {头盔}, U_NECKLACE {项链}, U_ARMRINGL {左手镯}, U_ARMRINGR {右手镯}, U_RINGL {左戒指}, U_RINGR {右戒指}]) then begin
        if BagItem.s.Expand1 in [1..6] then begin
          UseItem := @g_HeroJewelryBoxItems[BagItem.s.Expand1 - 1];
        end;
      end
      else if g_MyHero.m_boShowGodBless and (BagItem.s.OverLap and 4 <> 0) then begin
        if BagItem.s.Expand1 in [1..12] then begin
          if (g_HeroGodBlessItemsState[BagItem.s.Expand1 - 1] = 1) then begin
            UseItem := @g_HeroGodBlessItems[BagItem.s.Expand1 - 1];
          end;
        end;
      end;

      if UseItem <> nil then begin
        boShowUP := CompareHeroItem(BagItem, UseItem);
      end;

      if (not boShowUP) and ((BagItem.S.OverLap = 0) or (BagItem.S.OverLap and 1 = 1)) then begin
        case nWhere of
          U_DRESS, U_FASHIONDRESS:begin
              if not ((nWhere = U_FASHIONDRESS) and (g_ClientConfig.boUseOldSerialWindows)) then begin
                Flag := True;
              end;
            end;
          U_WEAPON:
            Flag := True;
          U_NECKLACE:
            Flag := True;
          U_RIGHTHAND:
            Flag := True;
          U_HELMET:
            Flag := True;
          U_RINGR, U_RINGL:
            Flag := True;
          U_ARMRINGR, U_ARMRINGL:
            Flag := True;

          { 1.76界面下面一排不允许装备 chongchong 2013-09-16 }
          U_BUJUK:begin
              if g_ClientConfig.boUseOldSerialWindows and (g_ClientConfig.boStateWindowsType = 0) then begin
                Flag := not g_ClientConfig.boDisableDuFuTakeArmRingL;
                if Flag then
                  nWhere := U_ARMRINGL;
              end
              else begin
                Flag := True;
              end;
            end;
          U_BELT:
            Flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;
          U_BOOTS:
            Flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;
          U_CHARM:
            Flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;

          U_HAT:
            Flag := True;
          U_DRUM:
            Flag := (not g_ClientConfig.boUseOldSerialWindows);
          U_HORSE:begin
              Flag := True;
              if g_ClientConfig.boUseOldSerialWindows then begin
                nWhere := U_RIGHTHAND;
              end;
            end;
          U_SHIELD:
            Flag := True; // 盾牌 chongchong 2013-09-16
          U_JADE:
            Flag := (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONWEAPON:
            Flag := (not g_ClientConfig.boUseOldSerialWindows);

          U_FASHIONNECKLACE:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONHELMET:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONARMRINGR, U_FASHIONARMRINGL:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONRINGL:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONRIGHTHAND:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONBELT:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONBOOTS:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONCHARM:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
        end;

        if Flag then begin
          nWhere1 := nWhere;
          nWhere2 := -1;

          if nWhere in [U_RINGR, U_RINGL] then begin
            nWhere1 := U_RINGR;
            nWhere2 := U_RINGL;
          end
          else if nWhere in [U_ARMRINGR, U_ARMRINGL] then begin
            if BagItem.s.StdMode = 25 then
              nWhere1 := U_ARMRINGL
            else begin
              nWhere1 := U_ARMRINGR;
              nWhere2 := U_ARMRINGL;
            end;
          end
          else if nWhere in [U_FASHIONRINGR, U_FASHIONRINGL] then begin
            nWhere1 := U_FASHIONRINGR;
            nWhere2 := U_FASHIONRINGL;
          end
          else if nWhere in [U_FASHIONARMRINGR, U_FASHIONARMRINGL] then begin
            nWhere1 := U_FASHIONARMRINGR;
            nWhere2 := U_FASHIONARMRINGL;
          end;

          boShowUP := False;
          if nWhere1 > -1 then begin
            UseItem := @g_HeroUseItems[nWhere1];

            boShowUP := CompareHeroItem(BagItem, UseItem);
          end;

          if (not boShowUP) and (nWhere2 > -1) then begin
            UseItem := @g_HeroUseItems[nWhere2];

            boShowUP := CompareHeroItem(BagItem, UseItem);
          end;
        end;
      end;

      if boShowUP and (g_WNewopUIImages <> nil) then begin
        if not g_ConfigClient.boShowAniBagCompareImg then begin
           d := g_WNewopUIImages.Images[1182];
        end else begin
          if nAniBagCompareImgIndex < g_ConfigClient.nShowAniBagCompareImgIndex then begin
            nAniBagCompareImgIndex := g_ConfigClient.nShowAniBagCompareImgIndex;
            nAniBagCompareImgPlayTick := MyGetTickCount;
          end else if nAniBagCompareImgIndex >= g_ConfigClient.nShowAniBagCompareImgIndex + g_ConfigClient.nShowAniBagCompareImgCount then begin
            nAniBagCompareImgIndex := g_ConfigClient.nShowAniBagCompareImgIndex;
            nAniBagCompareImgPlayTick := MyGetTickCount;
          end;

          //HZQ 20230520 消除符号警告
          if tick_diff(nAniBagCompareImgPlayTick, MyGetTickCount) >= Cardinal(g_ConfigClient.nShowAniBagCompareImgPlayTime) then begin
            Inc(nAniBagCompareImgIndex);
            nAniBagCompareImgPlayTick := MyGetTickCount;

            if nAniBagCompareImgIndex >= g_ConfigClient.nShowAniBagCompareImgIndex + g_ConfigClient.nShowAniBagCompareImgCount then
              nAniBagCompareImgIndex := g_ConfigClient.nShowAniBagCompareImgIndex;
          end;

          d := g_WNewopUIImages.Images[nAniBagCompareImgIndex];
        end;

        if d <> nil then begin
          GameCanvas.Draw(R.Right - d.Width - 1, R.Bottom - d.Height - 1, d);
        end;
      end;
    end;
  end;
end;

procedure TSerialWindows.ItemBagDirectPaint(Sender:TObject);
var
  ItemName, sLine1, sLine2, sLine3:string;
  n, I, nLeft, nTop, nY:Integer;
  IsUseableLine2, IsUseableLine3:Boolean;
  vtRect:TRect;
  DItemBag:TDxImageButton;
  ItemDesc:TStringList;
  S, sTempName:string;
begin
  if g_MySelf = nil then
    Exit;
  DItemBag := TDxImageButton(Sender);
  with DItemBag do begin
    vtRect := VirtualRect;

    { TODO -c注释 -opiaoyun : 人物包裹信息传统旧模式显示 【2013-4-24 】}
    if (g_ClientConfig.btSuspensionShowItem = 0) and (g_ClientVersion <= {cvHero} cvSerial) and (g_MouseItem.S.Name <> '') and g_boShowBagInfo then begin
      DlblItemBagRefresh.Visible := False;

      GetMouseItemInfo(g_MySelf, @g_MouseItem, True, ItemName, sLine1, sLine2, sLine3, IsUseableLine2, IsUseableLine3);
      if g_ClientVersion = cv176 then begin
        nLeft := vtRect.Left + 68;
        nTop := vtRect.Top + 214;
      end
      else begin
        nLeft := vtRect.Left + 75;
        nTop := vtRect.Top + 242;
      end;
      if ItemName <> '' then begin
        nY := nTop;
        if sLine2 <> '' then
          nY := nTop + 14;
        if sLine3 <> '' then
          nY := nTop + 14 * 2;

        n := DrawItemHintOldStyle(nLeft, nTop, ItemName, clYellow);
        DrawItemHintOldStyle(nLeft + n, nTop, sLine1);

        if not IsUseableLine2 then
          DrawItemHintOldStyle(nLeft, nTop + 14, sLine2, clRed)
        else
          DrawItemHintOldStyle(nLeft, nTop + 14, sLine2);

        if not IsUseableLine3 then
          DrawItemHintOldStyle(nLeft, nTop + 14 * 2, sLine3, clRed)
        else
          DrawItemHintOldStyle(nLeft, nTop + 14 * 2, sLine3);

        if not g_ClientConfig.boDescSupportRenamItem then
          ItemDesc := GetItemDesc(@g_MouseItem, g_MouseItem.S.DBName)
        else begin
          ItemDesc := GetItemDesc(@g_MouseItem, g_MouseItem.S.Name);
          if g_ClientConfig.boNoRenameDescReadDefault and ((ItemDesc = nil) or (ItemDesc.Count = 0)) then begin
            ItemDesc := GetItemDesc(@g_MouseItem, g_MouseItem.S.DBName);
          end;
        end;

        if (ItemDesc <> nil) and (ItemDesc.Count > 0) then begin
          for I := 0 to ItemDesc.Count - 1 do begin
            CurrentFont.TextOut(nLeft, nY + 14 * (I + 1), ItemDesc.Strings[I], TColor(ItemDesc.Objects[I]));
          end;
        end;
      end;
    end
    else begin
      // 包裹中金币数量可以移动 chongchong 2014-04-09
      //CurrentFont.TextOut(vtRect.Left + 69, vtRect.Top + 213, GetGoldStr(g_MySelf.m_nGold), clWhite);
      DGoldValue.Caption := GetGoldStr(g_MySelf.m_nGold);

      DlblItemBagRefresh.Visible := (not g_ClientConfig.boShowBagGameInfo) and (not FItemBagShowState);

      if g_ClientConfig.boShowBagGameInfo or FItemBagShowState then begin
        DItemBagGoldIcon.Visible := FItemBagGoldIcon_Visible;
        DlblItemBagGold.Visible := FlblItemBagGold_Visible;
        if FlblItemBagGold_Visible then begin
          if g_ClientConfig.boShowBagGameGoldSeparator then
            sTempName := GetGoldStr(g_MySelf.m_nGameGold)
          else
            sTempName := IntToStr(g_MySelf.m_nGameGold);

          S := StringReplace(FlblItemBagGameGold_Text, '<$name>', g_sGameGoldName, [rfIgnoreCase]);
          S := StringReplace(S, '<$value>', sTempName, [rfIgnoreCase]);

          DlblItemBagGold.Caption := S;
        end;

        DItemBagGirdIcon.Visible := FItemBagGirdIcon_Visible;
        DlblItemBagGird.Visible := FlblItemBagGird_Visible;
        if FlblItemBagGird_Visible then begin
          if g_ClientConfig.boShowBagGameGoldSeparator then
            sTempName := GetGoldStr(g_nGameGird)
          else
            sTempName := IntToStr(g_nGameGird);

          S := StringReplace(FlblItemBagGird_Text, '<$name>', g_sGameGirdName, [rfIgnoreCase]);
          S := StringReplace(S, '<$value>', sTempName, [rfIgnoreCase]);

          DlblItemBagGird.Caption := S;
        end;

        DItemBagDiamondIcon.Visible := FItemBagDiamondIcon_Visible;
        DlblItemBagDiamond.Visible := FlblItemBagDiamond_Visible;
        if FlblItemBagDiamond_Visible then begin
          if g_ClientConfig.boShowBagGameGoldSeparator then
            sTempName := GetGoldStr(g_nGameDiamond)
          else
            sTempName := IntToStr(g_nGameDiamond);

          S := StringReplace(FlblItemBagDiamond_Text, '<$name>', g_sGameDiamondName, [rfIgnoreCase]);
          S := StringReplace(S, '<$value>', sTempName, [rfIgnoreCase]);

          DlblItemBagDiamond.Caption := S;
        end;
      end
      else begin
        DItemBagGoldIcon.Visible := False;
        DlblItemBagGold.Visible := False;

        DItemBagGirdIcon.Visible := False;
        DlblItemBagGird.Visible := False;

        DItemBagDiamondIcon.Visible := False;
        DlblItemBagDiamond.Visible := False;
      end;
    end;
  end;
end;

