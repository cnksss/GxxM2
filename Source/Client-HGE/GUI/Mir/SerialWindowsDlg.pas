procedure TSerialWindows.NewGroupMemberMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  DxCtrl:TDxImageButton;
  GroupMember:PGroupMember;
  HintLines:THintLines;
  HintWindow:THintWindow;
begin
  DxCtrl := Sender as TDxImageButton;

  GroupMember := PGroupMember(DxCtrl.Tag);
  if GroupMember = nil then
    Exit;

  HintWindows.Clear;

  HintWindow := THintWindow.Create;
  HintWindow.X := DxCtrl.VirtualRect.Right;
  HintWindow.Y := DxCtrl.VirtualRect.Top;

  HintLines := THintLines.Create;
  HintLines.Add(GroupMember.sCharName, clLime, GetHintFontSize, GetHintFontStyle([fsBold]), GetHintFontStroke(True));
  HintWindow.Add(HintLines);

  HintLines := THintLines.Create;
  HintLines.Add('-');
  HintWindow.Add(HintLines);

  HintLines := THintLines.Create;
  HintLines.Add(Format('HP: %d/%d', [GroupMember.HP, GroupMember.MaxHP]), clYellow, GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke);
  HintWindow.Add(HintLines);

  HintLines := THintLines.Create;
  HintLines.Add(Format('MP: %d/%d', [GroupMember.MP, GroupMember.MaxMP]), clYellow, GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke);
  HintWindow.Add(HintLines);

  HintLines := THintLines.Create;
  HintLines.Add(Format('等级: %d', [GroupMember.Level]), clYellow, GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke);
  HintWindow.Add(HintLines);

  HintLines := THintLines.Create;
  HintLines.Add(Format('地图: %s', [GroupMember.sMapDesc]), clYellow, GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke);
  HintWindow.Add(HintLines);

  HintWindow.Show(HintWindow.X, HintWindow.Y);
  HintWindows.Add(HintWindow);
end;

