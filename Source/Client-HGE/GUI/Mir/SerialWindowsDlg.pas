procedure TSerialWindows.DItemBoxGridGridPaint(Sender:TObject; ACol, ARow:Integer; Rect:TRect; State:TGridDrawState);
var
  nIdx, nIndex:Integer;
  d:TTexture;
  DGrid:TDxImageGrid;
begin
  DGrid := TDxImageGrid(Sender);
  nIdx := ACol + ARow * DGrid.ColCount;
  if nIdx in [0..8] then begin
    d := g_WMain3Images.Images[514];
    if d <> nil then begin // 绘制背景方框
      GameCanvas.Draw(Rect.Left + (DGrid.ColWidth - d.Width) div 2 - 1, // - 1
        Rect.Top + (DGrid.RowHeight - d.Height) div 2 + 1, // + 1
        d.ClientRect, d);
    end;

    if nIdx = 4 then begin // 绘制中间一格背景方框
      d := g_WMain3Images.Images[513];
      if d <> nil then begin
        GameCanvas.Draw(Rect.Left + (DGrid.ColWidth - d.Width) div 2 - 1, //
          Rect.Top + (DGrid.RowHeight - d.Height) div 2 + 1, // + 1
          d.ClientRect, d);
      end;
    end;

    DrawGridItemEx(Bounds(Rect.Left, Rect.Top, DGrid.ColWidth, DGrid.RowHeight), @g_ItemBoxConfig.Items[nIdx], @g_ItemBoxConfig.ItemEffects[nIdx], nIdx <> g_ItemBoxConfig.nSelIndex);

    if nIdx = g_ItemBoxConfig.nSelIndex then begin // 绘制选择效果
      if MyGetTickCount - g_ItemBoxConfig.dwSelEffectTick > 200 then begin
        g_ItemBoxConfig.dwSelEffectTick := MyGetTickCount;
        {
        if g_ItemBoxConfig.nSelEffectIndex mod 2 = 0 then
          Inc(g_ItemBoxConfig.nSelEffectIndex)
        else
          Dec(g_ItemBoxConfig.nSelEffectIndex);
        }
        Inc(g_ItemBoxConfig.nSelEffectIndex, 2);
        if g_ItemBoxConfig.nSelEffectIndex > 616 then
          g_ItemBoxConfig.nSelEffectIndex := 602;
      end;

      nIndex := g_ItemBoxConfig.nSelEffectIndex;

      d := g_WMain3Images.Images[nIndex];
      if d <> nil then begin
        GameCanvas.DrawBlend(Rect.Left + (DGrid.ColWidth - d.Width) div 2 - 2, //
          Rect.Top + (DGrid.RowHeight - d.Height) div 2 + 1, //
          d.ClientRect, d);
      end;
    end;
  end;
end;

