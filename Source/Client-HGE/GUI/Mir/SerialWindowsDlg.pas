      g_SelectMyShopItems[0] := g_MyShopItems[0, ARow];
    end;

    ComboBoxMyShopItemPos.ItemIndex := 0;

    {
    S := '';
    case g_MyShopItems[0, ARow].btMoneyType of
      0: S := g_sGameGoldName;
      1: S := g_sGamePointName;
      2: S := g_sGoldName;
      3: S := g_sGameDiamondName;
      4: S := g_sGameGirdName;
