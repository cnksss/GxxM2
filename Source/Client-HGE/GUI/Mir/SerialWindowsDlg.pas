procedure TSerialWindows.UpdateSelectSellPlayerPetsInfo;
var
  GamePetData:pTClientGamePetData;
begin
  if (FSelectSellPlayerGamePetIndex < 0) or (FSelectSellPlayerGamePetIndex >= DSellPlayerSWPetsList.Count) then begin
    Exit;
  end;

  GamePetData := g_SellPlayerGamePetList.Items[FSelectSellPlayerGamePetIndex];

  DSellPlayerSWPetsName.Caption := GamePetData.sName;
  DSellPlayerSWPetsLevel.Caption := IntToStr(GamePetData.GamePetAbility.Level);
  DSellPlayerSWPetsExp.Caption := Format('%u/%u', [GamePetData.GamePetAbility.Exp, GamePetData.GamePetAbility.MaxExp]);
  DSellPlayerSWPetsHP.Caption := Format('%u/%u', [GamePetData.GamePetAbility.HP, GamePetData.GamePetAbility.MaxHP]);
  DSellPlayerSWPetsDC.Caption := Format('%d-%d', [GamePetData.GamePetAbility.DC1, GamePetData.GamePetAbility.DC2]);
  DSellPlayerSWPetsMC.Caption := Format('%d-%d', [GamePetData.GamePetAbility.MC1, GamePetData.GamePetAbility.MC2]);
  DSellPlayerSWPetsSC.Caption := Format('%d-%d', [GamePetData.GamePetAbility.SC1, GamePetData.GamePetAbility.SC2]);
  DSellPlayerSWPetsAC.Caption := Format('%d-%d', [GamePetData.GamePetAbility.AC1, GamePetData.GamePetAbility.AC2]);
  DSellPlayerSWPetsMAC.Caption := Format('%d-%d', [GamePetData.GamePetAbility.MAC1, GamePetData.GamePetAbility.MAC2]);
end;

procedure TSerialWindows.RefreshSellPlayerGamePetList;
var
  I:Integer;
  ListItem:TDxListItem;
  ViewItem:pTViewItem;
  GamePetData:pTClientGamePetData;
begin
  DSellPlayerSWPetsList.Clear;
  for I := 0 to g_SellPlayerGamePetList.Count - 1 do begin
    GamePetData := g_SellPlayerGamePetList.Items[I];

    ListItem := DSellPlayerSWPetsList.Add;

    ViewItem := ListItem.AddItem('', nil);

    ViewItem.Caption := '宠物名: ' + GamePetData.sName + sLineBreak + '宠物等级: ' + IntToStr(GamePetData.GamePetAbility.Level);
    ViewItem.Style := bsButton; //bsButton;                                                                   // bsRadio;
    ViewItem.Alignment := taCenter;
    ViewItem.ImageIndex.ImageType := NewopUI_Pak;
    ViewItem.ImageIndex.Up := 1050;
    ViewItem.ImageIndex.Hot := 1051;
    ViewItem.ImageIndex.Down := 1052;
    ViewItem.ImageIndex.Checked := 1052;

    ViewItem.Data := Pointer(I);
  end;

  DSellPlayerSWPetsViewBag.Enabled := g_SellPlayerGamePetList.Count > 0;
  if g_SellPlayerGamePetList.Count > 0 then
    UpdateSelectSellPlayerPetsInfo
  else begin
    DSellPlayerSWPetsName.Caption := '';
    DSellPlayerSWPetsLevel.Caption := '';
    DSellPlayerSWPetsExp.Caption := '';
    DSellPlayerSWPetsHP.Caption := '';
    DSellPlayerSWPetsDC.Caption := '';
    DSellPlayerSWPetsMC.Caption := '';
    DSellPlayerSWPetsSC.Caption := '';
    DSellPlayerSWPetsAC.Caption := '';
    DSellPlayerSWPetsMAC.Caption := '';
  end;
end;

