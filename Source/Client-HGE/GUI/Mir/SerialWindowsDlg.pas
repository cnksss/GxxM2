procedure TSerialWindows.DItemBoxLuckClick(Sender:TObject; X, Y:Integer);
// 开始旋转宝箱
begin
  //if (not g_ItemBoxConfig.boRotation) then
  //begin
  try
    if (not g_ItemBoxConfig.boUse) or g_ItemBoxConfig.boRotation or g_ItemBoxConfig.boRotationOK then
      Exit;

    g_ItemBoxConfig.nSelRotationIndex := -1; // 点击选择后服务器随机获取的装备序号
    g_ItemBoxConfig.nRotationCount := 0; // 旋转次数
    g_ItemBoxConfig.nCycleCount := 0; // 旋转圈数
    g_ItemBoxConfig.dwRotationTick := MyGetTickCount;
    g_ItemBoxConfig.dwRotationTime := 10; // 旋转速度time
    g_ItemBoxConfig.boRotation := True; // 是否开始旋转
    g_ItemBoxConfig.boRotationOK := False; // 旋转结束
    g_ItemBoxConfig.nOpenMoveGold := -1;
    g_ItemBoxConfig.nOpenMoveGameGold := -1;
    frmMain.SendClientMessage(CM_ROTATIONBOX, 0, 0, 0, 0);
  finally
    if not g_ItemBoxConfig.boRotation and g_ItemBoxConfig.boRotationOK and g_ItemBoxConfig.boUse then begin
      if (g_ItemBoxConfig.nOpenMoveGold >= 0) or (g_ItemBoxConfig.nOpenMoveGameGold >= 0) then begin
        if DMessageDlg(Format('是否确定要再次启动宝箱转盘？' + SLineBreak + SLineBreak + '再次启动需要[金币:%d]和[%s:%d] ！', [g_ItemBoxConfig.nOpenMoveGold, g_sGameGoldName, g_ItemBoxConfig.nOpenMoveGameGold]), [mbYes, mbNo]) = mrYes then begin
          if (g_MySelf.m_nGold >= Cardinal(g_ItemBoxConfig.nOpenMoveGold))
            and (g_MySelf.m_nGameGold >= Cardinal(g_ItemBoxConfig.nOpenMoveGameGold)) then begin
            g_ItemBoxConfig.nSelRotationIndex := -1; // 点击选择后服务器随机获取的装备序号
            g_ItemBoxConfig.nRotationCount := 0; // 旋转次数
            g_ItemBoxConfig.nCycleCount := 0; // 旋转圈数
            g_ItemBoxConfig.dwRotationTick := MyGetTickCount;
            g_ItemBoxConfig.dwRotationTime := 10; // 旋转速度time
            g_ItemBoxConfig.boRotation := True; // 是否开始旋转
            g_ItemBoxConfig.boRotationOK := False; // 旋转结束
            g_ItemBoxConfig.nOpenMoveGold := -1;
            g_ItemBoxConfig.nOpenMoveGameGold := -1;
            frmMain.SendClientMessage(CM_ROTATIONBOX, 0, 0, 0, 0);
          end else begin
            DMessageDlg('你身上的金币或者' + g_sGameGoldName + '好像不太够哦。', [mbOk]);
          end;
        end;
        //
      end
      else
        DMessageDlg('宝箱已经损坏，无法再次启动转盘。', [mbOk]);
    end;
  end;
  //end;
end;

