  if g_SellPlayerUserInfo.Abil.HandWeight > g_SellPlayerUserInfo.Abil.MaxHandWeight then begin
    DSellPlayerStateHandWeightLabel.CaptionColor.Up.Color := clRed;
    DSellPlayerStateHandWeightLabel.CaptionColor.Hot.Color := clRed;
    DSellPlayerStateHandWeightLabel.CaptionColor.Down.Color := clRed;
  end
  else begin
    DSellPlayerStateHandWeightLabel.CaptionColor.Up.Color := FStateHandWeightLabelColor.Up;
    DSellPlayerStateHandWeightLabel.CaptionColor.Hot.Color := FStateHandWeightLabelColor.Hot;
    DSellPlayerStateHandWeightLabel.CaptionColor.Down.Color := FStateHandWeightLabelColor.Down;
    DSellPlayerStateHandWeightLabel.CaptionColor.Disabled.Color := FStateHandWeightLabelColor.Disabled;
  end;

  DSellPlayerStateAntiMagicLabel.Caption := FSellPlayerCaption_AntiMagic + ' +' + IntToStr(g_SellPlayerUserInfo.AntiMagic * 10) + '%';
  DSellPlayerStateAntiPoisonLabel.Caption := FSellPlayerCaption_AntiPoison + ' +' + IntToStr(g_SellPlayerUserInfo.AntiPoison * 10) + '%';

  DSellPlayerStatePoisonRecoverLabel.Caption := FSellPlayerCaption_PoisonRecover + ' +' + IntToStr(g_SellPlayerUserInfo.PoisonRecover * 10) + '%';
  DSellPlayerStateHealthRecoverLabel.Caption := FSellPlayerCaption_HealthRecover + ' +' + IntToStr(g_SellPlayerUserInfo.HealthRecover * 10) + '%';
  DSellPlayerStateSpellRecoverLabel.Caption := FSellPlayerCaption_SpellRecover + ' +' + IntToStr(g_SellPlayerUserInfo.SpellRecover * 10) + '%';

  SellPlayerAbilChange;

  //-----------------------------------------------------
  DSellPlayerStateNGLevelValue.Caption := IntToStr(g_SellPlayerUserInfo.AbilNG.Level);
  DSellPlayerStateNGExpValue.Caption := IntToStr(g_SellPlayerUserInfo.AbilNG.Exp);
  DSellPlayerStateNGMaxExpValue.Caption := IntToStr(g_SellPlayerUserInfo.AbilNG.MaxExp);
  DSellPlayerStateNGValue.Caption := IntToStr(g_SellPlayerUserInfo.AbilNG.NH) + '/' + IntToStr(g_SellPlayerUserInfo.AbilNG.MaxNH);
  DSellPlayerStateNGRecoverValue.Caption := IntToStr(g_SellPlayerUserInfo.NPRecoverTime);
  DSellPlayerStateNGHitValue.Caption := IntToStr(g_SellPlayerUserInfo.AbilNG.NGDamage);
  DSellPlayerStateNGAntiPoisonValue.Caption := IntToStr(g_SellPlayerUserInfo.AbilNG.UnNGDamage);

  // -----------------------------------------------------
  ActivePageIndex := DSellPlayerMeridiansPageControl.ActivePageIndex;

  DSellPlayerMeridiansTabSheet1.TabVisible := g_SellPlayerUserInfo.Meridians[4].Acupoints[4] > 0;
  DSellPlayerMeridiansTabSheet2.TabVisible := g_SellPlayerUserInfo.Meridians[0].Acupoints[4] > 0;
  DSellPlayerMeridiansTabSheet3.TabVisible := g_SellPlayerUserInfo.Meridians[1].Acupoints[4] > 0;
  DSellPlayerMeridiansTabSheet4.TabVisible := g_SellPlayerUserInfo.Meridians[2].Acupoints[4] > 0;

  DSellPlayerBotMeridians1.Visible := g_SellPlayerUserInfo.Meridians[4].Acupoints[4] > 0;
  DSellPlayerBotMeridians2.Visible := g_SellPlayerUserInfo.Meridians[0].Acupoints[4] > 0;
  DSellPlayerBotMeridians3.Visible := g_SellPlayerUserInfo.Meridians[1].Acupoints[4] > 0;
  DSellPlayerBotMeridians4.Visible := g_SellPlayerUserInfo.Meridians[2].Acupoints[4] > 0;

  if (not DSellPlayerMeridiansTabSheet4.TabVisible) and (DSellPlayerMeridiansPageControl.ActivePageIndex >= 4) then begin
    DSellPlayerMeridiansPageControl.ActivePageIndex := 3;
    DSellPlayerBotMeridians3.Checked := True;
    DSellPlayerBotMeridiansClick(DSellPlayerBotMeridians3, 0, 0);
  end;
  if (not DSellPlayerMeridiansTabSheet3.TabVisible) and (DSellPlayerMeridiansPageControl.ActivePageIndex >= 3) then begin
    DSellPlayerMeridiansPageControl.ActivePageIndex := 2;
    DSellPlayerBotMeridians2.Checked := True;
    DSellPlayerBotMeridiansClick(DSellPlayerBotMeridians2, 0, 0);
  end;
  if (not DSellPlayerMeridiansTabSheet2.TabVisible) and (DSellPlayerMeridiansPageControl.ActivePageIndex >= 2) then begin
    DSellPlayerMeridiansPageControl.ActivePageIndex := 1;
    DSellPlayerBotMeridians1.Checked := True;
    DSellPlayerBotMeridiansClick(DSellPlayerBotMeridians1, 0, 0);
  end;

  DSellPlayerMeridiansPageControl.ActivePageIndex := ActivePageIndex;
  case DSellPlayerMeridiansPageControl.ActivePageIndex of
    0:begin
        DSellPlayerBotMeridians0.Checked := True;
      end;
    1:begin
        DSellPlayerBotMeridians1.Checked := True;
      end;
    2:begin
        DSellPlayerBotMeridians2.Checked := True;
      end;
    3:begin
        DSellPlayerBotMeridians3.Checked := True;
      end;
    4:begin
        DSellPlayerBotMeridians4.Checked := True;
      end;
  end;

  DSellPlayerStateWin.Visible := True;

  S := StringReplace(FSellPlayerSWGodBlessUserName_Text, '<$name>', g_SellPlayerUserInfo.UserName, [rfIgnoreCase]);
  DlblSellPlayerSWGodBlessUserName.Caption := S;

  S := StringReplace(FSellPlayerSWJewelryBoxUserName_Text, '<$name>', g_SellPlayerUserInfo.UserName, [rfIgnoreCase]);
  DlblSellPlayerSWJewelryBoxUserName.Caption := S;

  S := StringReplace(FSellPlayerSWPetsUserName_Text, '<$name>', g_SellPlayerUserInfo.UserName, [rfIgnoreCase]);
  DlblSellPlayerSWPetsUserName.Caption := S;

  S := StringReplace(FSellPlayerSWPetsBagUsreName_Text, '<$name>', g_SellPlayerUserInfo.UserName, [rfIgnoreCase]);
  DlblSellPlayerSWPetsBagUsreName.Caption := S;
end;

