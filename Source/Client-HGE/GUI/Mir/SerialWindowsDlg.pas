procedure TSerialWindows.DSellPlayerStateMagicDirectPaint(Sender:TObject);
var
  Magic:TClientMagic;
  vtRect:TRect;
  vbRect:TRect;
  d:TTexture;
  DxForm:TDxImageForm;
  HGEFont:THGEFont;
begin
  DxForm := Sender as TDxImageForm;

  Magic.Def.wMagicId := 0;
  g_SellPlayerMagicList.Lock;
  try
    if (DxForm.Tag + FSellPlayerMagicIndex >= 0) and (DxForm.Tag + FSellPlayerMagicIndex < g_SellPlayerMagicList.Count) then begin
      Magic := PTClientMagic(g_SellPlayerMagicList.Items[DxForm.Tag + FSellPlayerMagicIndex])^;
    end;
  finally
    g_SellPlayerMagicList.UnLock;
  end;

  if Magic.Def.wMagicId = 0 then
    Exit;

  vbRect := DxForm.VisibleRect;
  if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
    Exit;
  vtRect := DxForm.VirtualRect;

  {
  DStMagLblName1.Visible := False;
  DStMagLvIcon1.Visible := False;
  DStMagLvText1.Visible := False;
  DStMagExpIcon1.Visible := False;
  DStMagExpText1.Visible := False;
  }
  // 技能名称
  HGEFont := TextureFonts.FindFont(DSellPlayerStMagLblName1.CaptionColor.Up.Name, DSellPlayerStMagLblName1.CaptionColor.Up.Size, DSellPlayerStMagLblName1.CaptionColor.Up.Style);
  if HGEFont = nil then
    HGEFont := CurrentFont;
  HGEFont.TextOut(vtRect.Left + DSellPlayerStMagLblName1.Left, vtRect.Top + DSellPlayerStMagLblName1.Top, Magic.Def.sMagicName, DSellPlayerStMagLblName1.CaptionColor.Up.Color);

  if Magic.NewLevel <= 0 then begin
    // Level 等级
    // d := g_WMainImages.Images[112];
    d := DSellPlayerStMagLvIcon1.ImageIndex.Image.Images[DSellPlayerStMagLvIcon1.ImageIndex.Up];
    if d <> nil then begin
      GameCanvas.Draw(vtRect.Left + DSellPlayerStMagLvIcon1.Left, vtRect.Top + DSellPlayerStMagLvIcon1.Top, d.ClientRect, d);
    end;

    HGEFont := TextureFonts.FindFont(DSellPlayerStMagLvText1.CaptionColor.Up.Name, DSellPlayerStMagLvText1.CaptionColor.Up.Size, DSellPlayerStMagLvText1.CaptionColor.Up.Style);
    if HGEFont = nil then
      HGEFont := CurrentFont;
    HGEFont.TextOut(vtRect.Left + DSellPlayerStMagLvText1.Left, vtRect.Top + DSellPlayerStMagLvText1.Top, IntToStr(Magic.Level), DSellPlayerStMagLvText1.CaptionColor.Up.Color);

    // exp 升级经验
    //d := g_WMainImages.Images[111];
    d := DSellPlayerStMagExpIcon1.ImageIndex.Image.Images[DSellPlayerStMagExpIcon1.ImageIndex.Up];
    if d <> nil then begin
