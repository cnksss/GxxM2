procedure TSerialWindows.DUpgradeDlgItemClick(Sender:TObject; X, Y:Integer);
var
  DButton:TDxImageButton;
  Item:TClientItem;
begin
  if g_MySelf = nil then
    Exit;
  DButton := TDxImageButton(Sender);
  if DButton.Tag in [0..2] then begin
    if g_boItemMoving then begin
      if (g_MovingItem.Item.S.Name = '') or (g_WaitingUseItem.Item.S.Name <> '') or (g_WaitingUpgradeItemArr[0].S.Name <> '') then
        Exit;
      if g_MovingItem.ItemType in [mtBagItem, mtUpgradeItem] then begin
        if ((DButton.Tag = 0) and (GetTakeOnPosition(g_MovingItem.Item.S.StdMode, g_MovingItem.Item.S.Shape) >= 0)) or ((DButton.Tag = 1) and (g_MovingItem.Item.S.StdMode in [55..58])) or ((DButton.Tag = 2) and (g_MovingItem.Item.S.StdMode = 59)) then begin
          if g_UpgradeItemArr[DButton.Tag].S.Name <> '' then begin
            ItemClickSound(g_UpgradeItemArr[DButton.Tag].S);
            Item := g_UpgradeItemArr[DButton.Tag];
            g_UpgradeItemArr[DButton.Tag] := g_MovingItem.Item;
            g_MovingItem.Item := Item;
            g_MovingItem.Index := DButton.Tag;
            g_boItemMoving := g_MovingItem.Item.S.Name <> '';
          end
          else begin
            g_UpgradeItemArr[DButton.Tag] := g_MovingItem.Item;
            ItemClickSound(g_UpgradeItemArr[DButton.Tag].S);
            g_MovingItem.Item.s.Name := '';
            g_MovingItem.Index := DButton.Tag;
            g_boItemMoving := False;
          end;
        end;
      end;
    end
    else begin
      if (g_MovingItem.Item.S.Name <> '') or (g_WaitingUseItem.Item.S.Name <> '') or (g_WaitingUpgradeItemArr[0].S.Name <> '') then
        Exit;
      if g_UpgradeItemArr[DButton.Tag].S.Name <> '' then begin
        ItemClickSound(g_UpgradeItemArr[DButton.Tag].S);
        g_MovingItem.Index := DButton.Tag;
        g_MovingItem.Item := g_UpgradeItemArr[DButton.Tag];
        g_MovingItem.ItemType := mtUpgradeItem;
        g_UpgradeItemArr[DButton.Tag].S.Name := '';
        g_boItemMoving := True;
      end;
    end;
  end;
end;

