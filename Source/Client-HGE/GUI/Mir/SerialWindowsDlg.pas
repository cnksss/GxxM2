procedure TSerialWindows.RefreshGuildMembers(GroupIndex:Integer);
var
  I, Index:Integer;
  GuildGroup:TGuildGroup;
  ViewItem:pTViewItem;
begin
  DGuildManageForm2ChatMemo1.Lines.Clear;

  if GroupIndex < 0 then
    GroupIndex := 0
  else if GroupIndex > GuildGroupList.Count - 1 then
    GroupIndex := GuildGroupList.Count - 1;

  FGuildGroupIndex := GroupIndex;
  DoGuildGroupIndexSelect; //HZQ 创建封号 等几个按钮的使能，根据当前传递的组成员索引确定权限

  for I := 0 to GuildGroupList.Count - 1 do begin
    GuildGroup := GuildGroupList.Groups[I];
    Index := DGuildManageForm2ChatMemo1.Lines.Add(GuildGroup.Name);

    ViewItem := TDxLines(DGuildManageForm2ChatMemo1.Lines).Items[Index];

    //HZQ 20230523 增加以使ChantMemo的Item可点击
    //ViewItem.StringLineEx := TStringLineEx.Create;
    //TStringLineEx(ViewItem.StringLineEx).Add(clYellow, clWhite, 0, GuildGroup.Name, tt_Item);

    if I = GroupIndex then
      ViewItem.Color.Up.Color := 4760808
    else
      ViewItem.Color.Up.Color := 11064552;

    ViewItem.Color.Hot.Color := 11064552;
    ViewItem.Color.Down.Color := 4760808;
  end;
end;

procedure TSerialWindows.DGuildManageForm2ChatMemo1MouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  CurrentIndex, StartIndex, EndIndex:Integer;
  I:Integer;
  ViewItem:pTViewItem;
begin
  if (DGuildManageForm2ChatMemo1.ItemIndex - DGuildManageForm2ChatMemo1.TopLines.Count >= 0) and (DGuildManageForm2ChatMemo1.ItemIndex - DGuildManageForm2ChatMemo1.TopLines.Count < DGuildManageForm2ChatMemo1.Lines.Count) then begin
    CurrentIndex := DGuildManageForm2ChatMemo1.ItemIndex - DGuildManageForm2ChatMemo1.TopLines.Count;
    GuildGroupListPage := 0;
    FGuildGroupIndex := CurrentIndex;
    DoGuildGroupIndexSelect;
    StartIndex := Max(CurrentIndex - 30, 0);
    EndIndex := Min(StartIndex + 30, DGuildManageForm2ChatMemo1.Lines.Count - 1);
    for I := StartIndex to EndIndex do begin
      ViewItem := TDxLines(DGuildManageForm2ChatMemo1.Lines).Items[I];
      if I = CurrentIndex then
        ViewItem.Color.Up.Color := 4760808
      else
        ViewItem.Color.Up.Color := 11064552;
    end;
  end;
end;

procedure TSerialWindows.DGuildMembersGridPaint(Sender:TObject; ACol, ARow:Integer; Rect:TRect; State:TGridDrawState);
var
  GuildGroup:TGuildGroup;
  Index, nX, nY:Integer;
  IsOnLine:Boolean;
  ImageIndex:Integer;
  d:TTexture;
  Images:TGameImages;
begin
  if (FGuildGroupIndex < 0) or (FGuildGroupIndex > GuildGroupList.Count) then
    Exit;

  GuildGroup := GuildGroupList.Groups[FGuildGroupIndex];
  if GuildGroup = nil then
    Exit;

  Index := ARow * DGuildManageForm2ChatMembers.ColCount + ACol;
  Index := Index + GuildGroupListPage * DGuildManageForm2ChatMembers.RowCount * DGuildManageForm2ChatMembers.ColCount;

  if Index >= GuildGroup.Members.Count then
    Exit;

  IsOnLine := Integer(GuildGroup.Members.Objects[Index]) = 1;

  DGuildManageMemberIcon.Visible := False;
  DGuildManageMemberName.Visible := False;

  if GuildGroup.ID = 1 then begin
    if IsOnLine then
      ImageIndex := DGuildManageMemberIcon.ImageIndex.Up
    else
      ImageIndex := DGuildManageMemberIcon.ImageIndex.Hot;
  end
  else begin
    if IsOnLine then
      ImageIndex := DGuildManageMemberIcon.ImageIndex.Down
    else
      ImageIndex := DGuildManageMemberIcon.ImageIndex.Disabled;
  end;

  Images := DGuildManageMemberIcon.ImageIndex.Image;

  if Images <> nil then begin
    d := Images.Images[ImageIndex];
    if d <> nil then begin
      // nX := Rect.Left + DGuildManageMemberIcon.Left;
      nY := Rect.Top + DGuildManageMemberIcon.Top;
      GameCanvas.Draw(Rect.Left + DGuildManageMemberIcon.Left, nY, d);
    end;
  end;

  nX := Rect.Left + DGuildManageMemberName.Left;
  nY := Rect.Top + DGuildManageMemberName.Top;
  if (Index = FHotGuildMemeberIndex) and (FHotGuildMemmberFlag = 1) then begin
    if DGuildManageForm2ChatMembers.MouseDowned then
      CurrentFont.TextOut(nX, nY, GuildGroup.Members.Strings[Index], DGuildManageMemberName.CaptionColor.Down.Color)
    else
      CurrentFont.TextOut(nX, nY, GuildGroup.Members.Strings[Index], DGuildManageMemberName.CaptionColor.Hot.Color);
  end
  else
    CurrentFont.TextOut(nX, nY, GuildGroup.Members.Strings[Index], DGuildManageMemberName.CaptionColor.Up.Color);
end;

procedure TSerialWindows.DGuildMembersGridMouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  Row, Col, Index:Integer;
  R, R2:TRect;
  GuildGroup:TGuildGroup;
  IsOnLine:Boolean;
  ImageIndex:Integer;
  d:TTexture;
  Images:TGameImages;
begin
  GuildGroup := GuildGroupList.Groups[FGuildGroupIndex];
  if GuildGroup = nil then
    Exit;

  if DGuildManageForm2ChatMembers.GetColRow(X, Y, Col, Row) then begin
    Index := Row * DGuildManageForm2ChatMembers.ColCount + Col;
    Index := Index + GuildGroupListPage * DGuildManageForm2ChatMembers.RowCount * DGuildManageForm2ChatMembers.ColCount;

    if Index < GuildGroup.Members.Count then begin
      R := DGuildManageForm2ChatMembers.GetCellRect(Col, Row);

      IsOnLine := Integer(GuildGroup.Members.Objects[Index]) = 1;

      if GuildGroup.ID = 1 then begin
        if IsOnLine then
          ImageIndex := DGuildManageMemberIcon.ImageIndex.Up
        else
          ImageIndex := DGuildManageMemberIcon.ImageIndex.Hot;
      end
      else begin
        if IsOnLine then
          ImageIndex := DGuildManageMemberIcon.ImageIndex.Down
        else
          ImageIndex := DGuildManageMemberIcon.ImageIndex.Disabled;
      end;

      Images := DGuildManageMemberIcon.ImageIndex.Image;
      if Images <> nil then begin
        d := Images.Images[ImageIndex];
        if (d <> nil) then begin
          R2.Left := R.Left + DGuildManageMemberIcon.Left;
          R2.Top := R.Top + DGuildManageMemberIcon.Top;
          R2.Right := R2.Left + d.Width;
          R2.Bottom := R2.Top + d.Height;

          if PtInRect(R2, Point(X, Y)) and (GuildCommanderMode > 0) then begin
            FDropGuildMemberImageIndex := ImageIndex;
            FDropGuildMemberName := GuildGroup.Members.Strings[Index];

            DGuildMemberMenu.Left := X;
            DGuildMemberMenu.Top := R2.Bottom - 1;
            DGuildMemberMenu.Show;
            Exit;
          end;
        end;
      end;

      R2.Left := R.Left + DGuildManageMemberName.Left;
      R2.Top := R.Top + DGuildManageMemberName.Top;
      R2.Right := R2.Left + DGuildManageMemberName.Width;
      R2.Bottom := R2.Top + DGuildManageMemberName.Height;
      if PtInRect(R2, Point(X, Y)) and (GuildCommanderMode > 0) then begin
        FIsDropGuildMemberDownPt := Point(X, Y);

        // 1老大不能编辑 chongchong 2015-08-28
        if not ((GuildGroup.ID = 1) and (Index = 0)) then
          FIsDropGuildMember := True;

        FDropGuildMemberImageIndex := ImageIndex;
        FDropGuildMemberName := GuildGroup.Members.Strings[Index];
        FDropGuildMemberOffsetX := R.Left - X;
        FDropGuildMemberOffsetY := R.Top - Y;
      end;
    end;
  end;
end;

procedure TSerialWindows.DGuildMembersGridMouseUp(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer); stdcall;
begin
  if (FIsDropGuildMemberDownPt.X = X) and (FIsDropGuildMemberDownPt.Y = Y) and (FDropGuildMemberImageIndex <> -1) and (FHotGuildMemmberFlag = 1) then begin
    FrmMain.SendGuildViewMemberInfo(FHotGuildMemberName);
  end;
end;

procedure TSerialWindows.DGuildMembersGridMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  Row, Col, Index:Integer;
  R, R2:TRect;
  GuildGroup:TGuildGroup;
  FlagIndex:Integer;
  ImageIndex:Integer;
  d:TTexture;
  IsOnLine:Boolean;
  IsHotGuildMemberChanged:Boolean;
  Images:TGameImages;
begin
  if FIsDropGuildMember then
    Exit;

  GuildGroup := GuildGroupList.Groups[FGuildGroupIndex];
  if GuildGroup = nil then begin
    if FHotGuildMemeberIndex <> -1 then begin
      FHotGuildMemeberIndex := -1;
    end;

    FHotGuildMemmberFlag := -1;
    FHotGuildMemberName := '';
  end;

  IsHotGuildMemberChanged := False;

  if DGuildManageForm2ChatMembers.GetColRow(X, Y, Col, Row) and (GuildGroup <> nil) then begin
    Index := Row * DGuildManageForm2ChatMembers.ColCount + Col;
    Index := Index + GuildGroupListPage * DGuildManageForm2ChatMembers.RowCount * DGuildManageForm2ChatMembers.ColCount;

    if Index < GuildGroup.Members.Count then begin
      IsOnLine := Integer(GuildGroup.Members.Objects[Index]) = 1;

      if FHotGuildMemeberIndex <> Index then begin
        IsHotGuildMemberChanged := True;
        FHotGuildMemeberIndex := Index;
      end;

      FlagIndex := -1;

      if GuildGroup.ID = 1 then begin
        if IsOnLine then
          ImageIndex := DGuildManageMemberIcon.ImageIndex.Up
        else
          ImageIndex := DGuildManageMemberIcon.ImageIndex.Hot;
      end
      else begin
        if IsOnLine then
          ImageIndex := DGuildManageMemberIcon.ImageIndex.Down
        else
          ImageIndex := DGuildManageMemberIcon.ImageIndex.Disabled;
      end;

      Images := DGuildManageMemberIcon.ImageIndex.Image;

      R := DGuildManageForm2ChatMembers.GetCellRect(Col, Row);

      if Images <> nil then begin
        d := Images.Images[ImageIndex];
        if (d <> nil) then begin
          R2.Left := R.Left + DGuildManageMemberIcon.Left;
          R2.Top := R.Top + DGuildManageMemberIcon.Top;
          R2.Right := R2.Left + d.Width;
          R2.Bottom := R2.Top + d.Height;

          if PtInRect(R2, Point(X, Y)) then begin
            FlagIndex := 0;
          end;
        end;
      end;

      R2.Left := R.Left + DGuildManageMemberName.Left;
      R2.Top := R.Top + DGuildManageMemberName.Top;
      R2.Right := R2.Left + DGuildManageMemberName.Width;
      R2.Bottom := R2.Top + DGuildManageMemberName.Height;
      if PtInRect(R2, Point(X, Y)) then begin
        FlagIndex := 1;
      end;

      FHotGuildMemmberFlag := FlagIndex;
      FHotGuildMemberName := GuildGroup.Members.Strings[Index];
    end
    else begin
      if FHotGuildMemeberIndex <> -1 then begin
        IsHotGuildMemberChanged := True;
        FHotGuildMemeberIndex := -1;
      end;
      FHotGuildMemmberFlag := -1;
      FHotGuildMemberName := '';
    end;
  end
  else begin
    if FHotGuildMemeberIndex <> -1 then begin
      IsHotGuildMemberChanged := True;
      FHotGuildMemeberIndex := -1;
    end;

    FHotGuildMemmberFlag := -1;
    FHotGuildMemberName := '';
  end;

  if IsHotGuildMemberChanged or (FHotGuildMemmberFlag <> 1) then begin
    if DGuildViewMemberInfo.Visible then
      DGuildViewMemberInfo.Visible := False;
  end;

  if IsHotGuildMemberChanged or (FHotGuildMemmberFlag <> 0) then begin
    if DGuildMemberMenu.Visible then
      DGuildMemberMenu.Visible := False;
  end;
end;

function TSerialWindows.GetRankNo:Integer;
var
  I, No:Integer;
  IsFound:Boolean;
  GuildGroup:TGuildGroup;
begin
  No := 2;
  while No < 99 do begin
    IsFound := False;
    for I := 0 to GuildGroupList.Count - 1 do begin
      GuildGroup := GuildGroupList.Groups[I];
      if GuildGroup.ID = No then begin
        IsFound := True;
        Break;
      end;
    end;

    if IsFound then begin
      Inc(No);
    end else begin
      //Result := No; HZQ ,移动到循环外部
      Break;
    end;
  end;
  Result := NO;
end;

procedure TSerialWindows.DGuildManageCreateGradeClick(Sender:TObject; X, Y:Integer);
var
  RankName, S:string;
  I, RankNo:Integer;
  GuildGroup:TGuildGroup;
begin
  if FrmDlg.DMessageDlg('输入封号名称', [mbOk, mbAbort]) <> mrOk then
    Exit;

  RankName := Trim(FrmDlg.DlgEditText);
  if (RankName = '') then begin
    FrmDlg.DMessageDlg('封号名称不能为空！', [mbOk]);
    Exit;
  end;

  for I := 0 to GuildGroupList.Count - 1 do begin
    GuildGroup := GuildGroupList.Groups[I];
    if SameText(GuildGroup.Name, RankName) then begin
      FrmDlg.DMessageDlg('封号名称已经存在！', [mbOk]);
      Exit;
    end;
  end;

  RankNo := GetRankNo;

  S := '';

  for I := 0 to GuildGroupList.Count - 1 do begin
    GuildGroup := GuildGroupList.Groups[I];

    S := S + '#' + IntToStr(GuildGroup.ID) + ' <' + GuildGroup.Name + '>' + sLineBreak;

    S := S + GuildGroup.Members.Text + sLineBreak;
  end;

  S := S + '#' + IntToStr(RankNo) + ' <' + RankName + '>' + sLineBreak;

  FrmMain.SendGuildUpdateGrade(S, GuildGroupList.Count);
end;

procedure TSerialWindows.DGuildManageDelGradeClick(Sender:TObject; X, Y:Integer);
var
  I:Integer;
  S:string;
  IsFound:Boolean;
  GuildGroup:TGuildGroup;
begin
  GuildGroup := nil; //HZQ 默认赋值
  if (FGuildGroupIndex >= 0) or (FGuildGroupIndex < GuildGroupList.Count) then begin
    GuildGroup := GuildGroupList.Groups[FGuildGroupIndex];
    if (GuildGroup.ID = 1) or (GuildGroup.ID = 99) then begin
      Exit;
    end;
  end;

  if (GuildGroup <> nil) then begin
    S := GuildGroup.Members.Text;

    if Length(S) = 0 then begin
      IsFound := True
    end else begin
      IsFound := False;
      for I := 0 to GuildGroupList.Count - 1 do begin
        GuildGroup := GuildGroupList.Groups[I];
        if GuildGroup.ID = 99 then begin
          GuildGroup.Members.Add(S);
          IsFound := True;
          Break;
        end;
      end;
    end;

    if not IsFound then begin
      FrmDlg.DMessageDlg('未发现“所有成员”封号且当前封号有行会成员，无法删除', [mbOk]);
      Exit;
    end;

    if GuildGroupList.DeleteGroupByIndex(FGuildGroupIndex) then begin
      for I := 0 to GuildGroupList.Count - 1 do begin
        GuildGroup := GuildGroupList.Groups[I];
        S := S + '#' + IntToStr(GuildGroup.ID) + ' <' + GuildGroup.Name + '>' + sLineBreak;
        S := S + GuildGroup.Members.Text + sLineBreak;
      end;

      FrmMain.SendGuildUpdateGrade(S, FGuildGroupIndex);
    end;
  end;
end;

