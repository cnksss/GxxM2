procedure TSerialWindows.DLvAuctionAllItemsItemPaint(Sender:TObject; ACol, ARow:Integer; Rect:TRect; ViewItem:Pointer; var PaintOverride:Boolean);
const
  LineSpace = 4;
var
  Value, H, M, S, L, T:Integer;
  Text:string;
  Color:TColor;
  D:TTexture;
  nX, nY:Integer;
  GameImage:TGameImages;
  sStr:string;
begin
  if (ARow >= 0) and (ARow < AUCTION_PAGE_COUNT) and (g_AuctionAllItems[ARow].AuctionID > 0) then begin
    if ACol = 0 then begin
      D := g_WNewopUIImages.Images[1518];
      if D <> nil then begin
        nX := Rect.Left + (Rect.Right - Rect.Left - D.Width) div 2;
        nY := Rect.Top + (Rect.Bottom - Rect.Top - D.Height) div 2;
        GameCanvas.Draw(nX, nY, D.ClientRect, D);

        nX := nX + D.Width;

        GameImage := g_WBagItemImages.Indexs[g_AuctionAllItems[ARow].Item.s.Looks div 10000];
        if GameImage <> nil then begin
          D := GameImage.Images[g_AuctionAllItems[ARow].Item.s.Looks mod 10000];
          if D <> nil then begin
            GameCanvas.Draw(Rect.Left + (Rect.Right - Rect.Left - D.Width) div 2, Rect.Top + (Rect.Bottom - Rect.Top - D.Height) div 2, D.ClientRect, D);
          end;
        end;

        if IsUnOverLapItem(@g_AuctionAllItems[ARow].Item) then {// 重叠物品}  begin
          // 重叠物品的显示数字修改到右上角 chongchong 2013-12-26
          Text := 'x' + IntToStr(g_AuctionAllItems[ARow].Item.Dura + 1);
          BoldTextOut(nX - CurrentFont.TextWidth(Text) - 4, nY + 4, Text, clLime {clSkyBlue});
        end;
      end
      else begin
        GameImage := g_WBagItemImages.Indexs[g_AuctionAllItems[ARow].Item.s.Looks div 10000];
        if GameImage <> nil then begin
          D := GameImage.Images[g_AuctionAllItems[ARow].Item.s.Looks mod 10000];
          if D <> nil then begin
            GameCanvas.Draw(Rect.Left + (Rect.Right - Rect.Left - D.Width) div 2, Rect.Top + (Rect.Bottom - Rect.Top - D.Height) div 2, D.ClientRect, D);
          end;
        end;

        if IsUnOverLapItem(@g_AuctionAllItems[ARow].Item) then {// 重叠物品}  begin
          Text := 'x' + IntToStr(g_AuctionAllItems[ARow].Item.Dura + 1);
          BoldTextOut(Rect.Left + ((Rect.Right - Rect.Left) - CurrentFont.TextWidth(Text) - 4), Rect.Top + 4, Text, clLime {clSkyBlue});
        end;
      end;

      if g_AuctionAllItems[ARow].IsItemFlash then begin
        if MyGetTickCount - FAuctionItemFlashTick >= 100 then begin
          FAuctionItemFlashTick := MyGetTickCount;
          Inc(FAuctionItemFlashFrame);
          if FAuctionItemFlashFrame >= 8 then
            FAuctionItemFlashFrame := 0;
        end;

        D := g_WNewopUIImages.Images[1530 + FAuctionItemFlashFrame];
        if D <> nil then begin
          GameCanvas.Draw(Rect.Left + (Rect.Right - Rect.Left - D.Width) div 2, Rect.Top + (Rect.Bottom - Rect.Top - D.Height) div 2, D.ClientRect, D);
        end;
      end;
    end
    else if ACol = 1 then begin
      sStr := '';
      case g_AuctionAllItems[ARow].CurrencyType of
        0:
          sStr := g_sGameGoldName; // 元宝
        1:
          sStr := g_sGamePointName; // 游戏点
        2:
          sStr := g_sGoldName; // 金币
        3:
          sStr := g_sGameDiamondName; // 金刚石
        4:
          sStr := g_sGameGirdName; // 灵符
        else
          sStr := GetCustomMoneyNameByRule(g_AuctionAllItems[ARow].CurrencyType, 2)
      end;

      if g_AuctionAllItems[ARow].LastBidPrice = 0 then begin
        Text := GetGoldStr(g_AuctionAllItems[ARow].StartingPrice) + ' ' + sStr;
        Color := clFuchsia;
      end
      else begin
        Text := GetGoldStr(g_AuctionAllItems[ARow].LastBidPrice) + ' ' + sStr;
        Color := clYellow;
      end;

      L := Rect.Left + (Rect.Right - Rect.Left - CurrentFont.TextWidth(Text)) div 2;
      T := Rect.Top + (Rect.Bottom - Rect.Top - g_CurrentFontHeight) div 2;

      CurrentFont.TextOut(L - 1, T, Text, clBlack);
      CurrentFont.TextOut(L + 1, T, Text, clBlack);
      CurrentFont.TextOut(L, T - 1, Text, clBlack);
      CurrentFont.TextOut(L, T + 1, Text, clBlack);
      CurrentFont.TextOut(L, T, Text, Color);

      PaintOverride := True;
    end
    else if ACol = 3 then begin
      //Value := g_AuctionAllItems[ARow].TimeLeft;

      case g_AuctionAllItems[ARow].TradingStatus of
        -1:begin
            Text := DecodeResStr(SAuctionTradingStatus01);
            Color := clRed;
          end;
        1:begin
            Text := DecodeResStr(SAuctionTradingStatus02);
            Color := clRed;
          end;
        2:begin
            Text := DecodeResStr(SAuctionTradingStatus03);
            Color := clLime
          end;
        else begin
            Color := clYellow;

            Value := g_AuctionAllItems[ARow].TimeLeft;

            if Value > 0 then begin
              H := Value div 3600;
              Value := Value mod 3600;
              M := Value div 60;
              S := Value mod 60;

              if H > 0 then begin
                Text := Format('%d:%.2d:%.2d', [H, M, S]);
              end
              else if M > 0 then begin
                Text := Format('%.2d:%.2d', [M, S]);
              end
              else begin
                Text := Format('%.2d', [S]);
              end;
            end;
          end;
      end;

      L := Rect.Left + (Rect.Right - Rect.Left - CurrentFont.TextWidth(Text)) div 2;
      T := Rect.Top + (Rect.Bottom - Rect.Top - g_CurrentFontHeight) div 2;
      CurrentFont.TextOut(L - 1, T, Text, clBlack);
      CurrentFont.TextOut(L + 1, T, Text, clBlack);
      CurrentFont.TextOut(L, T - 1, Text, clBlack);
      CurrentFont.TextOut(L, T + 1, Text, clBlack);
      CurrentFont.TextOut(L, T, Text, Color);

      PaintOverride := True;
    end;
  end;
end;

