procedure TSerialWindows.DHeroM2ShopDlgOnGridPaint(Sender:TObject; ACol, ARow:Integer; Rect:TRect; State:TGridDrawState);
var
  nIdx:Integer;
  vtRect, PaintRect:TRect;
  sText:string;
begin
  nIdx := ACol + ARow * DHeroM2ShopDlgGrid.ColCount;
  if nIdx in [0..19] then begin
    PaintRect := Rect;
    PaintRect.Right := Rect.Left + DHeroM2ShopDlgGrid.ColWidth;
    PaintRect.Bottom := Rect.Top + DHeroM2ShopDlgGrid.RowHeight;
    DrawGridItem(PaintRect, @g_HeroM2ShopItems[nIdx], @g_HeroM2ShopItemEffects[nIdx]);

    if g_HeroM2ShopMouseItem.S.Name <> '' then begin
      vtRect := DHeroM2ShopDlg.VirtualRect;
      DLabelHeroM2ShopDlgItemName.Caption := ProcessItemName(g_HeroM2ShopMouseItem.S.Name);

      sText := '';
      case g_HeroM2ShopMouseItem.S.Reserved1 of
        0:
          sText := IntToStr(g_HeroM2ShopMouseItem.S.Price) + g_sGameGoldName;
        1:
          sText := IntToStr(g_HeroM2ShopMouseItem.S.Price) + g_sGamePointName;
        2:
          sText := IntToStr(g_HeroM2ShopMouseItem.S.Price) + g_sGoldName;
        3:
          sText := IntToStr(g_HeroM2ShopMouseItem.S.Price) + g_sGameDiamondName;
        4:
          sText := IntToStr(g_HeroM2ShopMouseItem.S.Price) + g_sGameGirdName;
        else
          sText := IntToStr(g_HeroM2ShopMouseItem.S.Price) + GetCustomMoneyNameByRule(g_HeroM2ShopMouseItem.S.Reserved1, 0);
      end;

      DLabelHeroM2ShopDlgItemPrice.Caption := sText;
    end
    else begin
      DLabelHeroM2ShopDlgItemName.Caption := '';
      DLabelHeroM2ShopDlgItemPrice.Caption := '';
    end;
  end
  else begin
    DLabelHeroM2ShopDlgItemName.Caption := '';
    DLabelHeroM2ShopDlgItemPrice.Caption := '';
  end;
end;

procedure TSerialWindows.DHeroM2ShopDlgOnGridSelect(Sender:TObject; ACol, ARow:Integer; Button:TMouseButton; Shift:TShiftState);
var
  nIdx:Integer;
  nPrices:Integer;
  nMoneyType:Integer;
begin
  // 摆摊中可加物品 2019-06-05 16:47:57
  if (g_HeroM2ShopWaiting.S.Name = '') and (g_MySelf <> nil) { and (not g_MySelf.m_boShopStall) } then begin
    nIdx := ACol + ARow * DHeroM2ShopDlgGrid.ColCount;
    if nIdx in [0..19] then begin
      if not g_boItemMoving then begin
        if g_HeroM2ShopItems[nIdx].S.Name <> '' then begin
          g_boItemMoving := True;
          g_MovingItem.Index := nIdx;
          g_MovingItem.Item := g_HeroM2ShopItems[nIdx];
          g_MovingItem.ItemType := mtHeroM2ShopItem;
          g_HeroM2ShopItems[nIdx].S.Name := '';
          ItemClickSound(g_MovingItem.Item.S);
        end;
      end
      else begin
        if g_MovingItem.ItemType in [mtBagItem, mtHeroM2ShopItem] then begin
          ItemClickSound(g_MovingItem.Item.S);
          if g_MovingItem.ItemType = mtBagItem then begin
            g_boItemMoving := False;
            g_HeroM2ShopWaiting := g_MovingItem.Item;
            g_MovingItem.Item.S.Name := '';
            if DHeroM2InputPriceDlg <> nil then begin
              if ShowDHeroM2InputDlg(nPrices, nMoneyType) then begin
                frmMain.SendClientMessage(CM_HEROM2ADDUSERSHOPITEM, g_HeroM2ShopWaiting.MakeIndex, LoWord(nPrices), HiWord(nPrices), nMoneyType);
              end
              else begin
                AddItemBag(g_HeroM2ShopWaiting);
                g_HeroM2ShopWaiting.S.Name := '';
              end;
            end;
          end
          else begin
            HeroM2AddUserShopItem(g_MovingItem.Item);
            g_MovingItem.Item.S.Name := '';
            g_boItemMoving := False;
          end;
        end;
      end;
    end;
  end;
end;

