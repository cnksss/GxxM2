procedure TSerialWindows.DSellPlayerOKClick(Sender:TObject; X, Y:Integer);
var
  Msg:TDefaultMessage;
begin
  if DSellPlayerPrice.Value <= 0 then begin
    DMessageDlg('出售价格必须大于0！', [mbOk]);
    DSellPlayerPrice.SetFocus;
    Exit;
  end;

  if DSellPlayerMoneyType.ItemIndex < 0 then begin
    DMessageDlg('必须指定货币类型！', [mbOk]);
    DSellPlayerMoneyType.SetFocus;
    Exit;
  end;

  if (DSellPlayerDelegatorType.ItemIndex <> 0) then begin
    if (DSellPlayerDelegator.Text = '') then begin
      DMessageDlg('委托玩家不能为空！', [mbOk]);
      DSellPlayerDelegator.SetFocus;
      Exit;
    end
    else if Length(DSellPlayerDelegator.Text) < 4 then begin
      DMessageDlg('委托玩家名字长度最少为4字节', [mbOk]);
      DSellPlayerDelegator.SetFocus;
      Exit;
    end;
  end;

  if DSellPlayerLblSetUser.Checked then begin
    if (DSellPlayerEdtSetUser.Text = '') then begin
      DMessageDlg('指定玩家不能为空！', [mbOk]);
      DSellPlayerDelegator.SetFocus;
      Exit;
    end
    else if Length(DSellPlayerEdtSetUser.Text) < 4 then begin
      DMessageDlg('指定玩家名字长度最少为4字节', [mbOk]);
      DSellPlayerEdtSetUser.SetFocus;
      Exit;
    end;
  end;

  Msg := MakeDefaultMsg(CM_ADD_SELLPLAYER, DSellPlayerPrice.Value, Integer(DSellPlayerMoneyType.Items.Objects[DSellPlayerMoneyType.ItemIndex]), Integer(DSellPlayerLblSetUser.Checked), DSellPlayerDelegatorType.ItemIndex);
  FrmMain.SendSocket(EncodeMessage(Msg) + EncodeString(DSellPlayerDelegator.Text) + '|' + EncodeString(DSellPlayerEdtSetUser.Text));
  DSellPlayerDlg.Visible := False;
end;

