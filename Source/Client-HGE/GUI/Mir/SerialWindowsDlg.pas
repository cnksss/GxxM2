function TSerialWindows.CheckUserEntrys:Boolean;
begin
  Result := False;
  DEdNewId.Text := Trim(DEdNewId.Text);
  DEdQuiz1.Text := Trim(DEdQuiz1.Text);
  DEdYourName.Text := Trim(DEdYourName.Text);
  if not NewIdCheckNewId then
    Exit;

  if not EnglishVersion then begin
    if not NewIdCheckSSno then
      Exit;
  end;

  if not NewIdCheckBirthDay then
    Exit;
  if Length(DEdNewId.Text) < 4 then begin
    DEdNewId.SetFocus;
    Exit;
  end;
  if Length(DEdNewPasswd.Text) < 3 then begin
    DEdNewPasswd.SetFocus;
    Exit;
  end;
  if DEdNewPasswd.Text <> DEdConfirm.Text then begin
    DEdConfirm.SetFocus;
    Exit;
  end;
  if Length(DEdQuiz1.Text) < 1 then begin
    DEdQuiz1.SetFocus;
    Exit;
  end;
  if Length(DEdAnswer1.Text) < 1 then begin
    DEdAnswer1.SetFocus;
    Exit;
  end;
  if Length(DEdQuiz2.Text) < 1 then begin
    DEdQuiz2.SetFocus;
    Exit;
  end;
  if Length(DEdAnswer2.Text) < 1 then begin
    DEdAnswer2.SetFocus;
    Exit;
  end;
  if Length(DEdYourName.Text) < 1 then begin
    DEdYourName.SetFocus;
    Exit;
  end;
  if not EnglishVersion then begin
    if Length(DEdSSNo.Text) < 1 then begin
      DEdSSNo.SetFocus;
      Exit;
    end;
  end;

  if DEdRandCodeNew.Enabled and (Length(Trim(DEdRandCodeNew.Text)) = 0) then begin
    DEdRandCodeNew.SetFocus;
    Exit;
  end;

  Result := True;
end;

function TSerialWindows.NewIdCheckNewId:Boolean;
begin
  Result := True;
  DEdNewId.Text := Trim(DEdNewId.Text);
  if Length(DEdNewId.Text) < 4 then begin
    DMessageDlg('账号长度最低需4位.', [mbOk]);
    Beep;
    DEdNewId.SetFocus;
    Result := False;
  end;
end;

function TSerialWindows.NewIdCheckSSno:Boolean;
var
  Str, t1, t2, smon, sday:string;
  amon, aday, sex:Integer;
  flag:Boolean;
begin
  Result := True;
  Str := DEdSSNo.Text;
  Str := GetValidStr3_Ex(Str, t1, '-');
  GetValidStr3_Ex(Str, t2, '-');
  flag := True;
  if (Length(t1) = 6) and (Length(t2) = 7) then begin
    smon := Copy(t1, 3, 2);
    sday := Copy(t1, 5, 2);
    amon := StrToIntDef(smon, 0);
    aday := StrToIntDef(sday, 0);
    if (amon <= 0) or (amon > 12) then
      flag := False;
    if (aday <= 0) or (aday > 31) then
      flag := False;
    sex := StrToIntDef(Copy(t2, 1, 1), 0);
    if (sex <= 0) or (sex > 2) then
      flag := False;
  end
  else
    flag := False;
  if not flag then begin
    Beep;
    DEdSSNo.SetFocus;
    Result := False;
  end;
end;

function TSerialWindows.NewIdCheckBirthDay:Boolean;
var
  Str, syear, smon, sday:string;
  ayear, amon, aday:Integer;
  flag:Boolean;
begin
  Result := True;
  flag := True;
  Str := DEdBirthDay.Text;
  Str := GetValidStr3_Ex(Str, syear, '/');
  Str := GetValidStr3_Ex(Str, smon, '/');
  Str := GetValidStr3_Ex(Str, sday, '/');
  ayear := StrToIntDef(syear, 0);
  amon := StrToIntDef(smon, 0);
  aday := StrToIntDef(sday, 0);
  if (ayear <= 1890) or (ayear > 2101) then
    flag := False;
  if (amon <= 0) or (amon > 12) then
    flag := False;
  if (aday <= 0) or (aday > 31) then
    flag := False;
  if not flag then begin
    Beep;
    DEdBirthDay.SetFocus;
    Result := False;
  end;
end;

procedure TSerialWindows.EdNewIdKeyPress(Sender:TObject; var Key:Char);
begin
  if (Sender = DEdNewPasswd) or (Sender = DEdChgNewPw) or (Sender = DEdChgRepeat) then
    if (Key = '~') or (Key = '''') or (Key = ' ') then
      Key := #0;
  if Key = #13 then begin
    Key := #0;
    if Sender = DEdNewId then begin
      if not NewIdCheckNewId then
        Exit;
    end;
    if Sender = DEdNewPasswd then begin
      if Length(DEdNewPasswd.Text) < 3 then begin
        DMessageDlg(DecodeResStr(SPasswordLenErr), [mbOk]);
        Beep;
        DEdNewPasswd.SetFocus;
        Exit;
      end;
    end;
    if Sender = DEdConfirm then begin
      if DEdNewPasswd.Text <> DEdConfirm.Text then begin
        DMessageDlg(DecodeResStr(SPasswordNotEqual), [mbOk]);
        Beep;
        DEdConfirm.SetFocus;
        Exit;
      end;
    end;
    if (Sender = DEdYourName) or (Sender = DEdQuiz1) or (Sender = DEdAnswer1) or (Sender = DEdQuiz2) or (Sender = DEdAnswer2) or (Sender = DEdPhone) or (Sender = DEdMobPhone) or (Sender = DEdEMail) then begin
      TDxEdit(Sender).Text := Trim(TDxEdit(Sender).Text);
      if TDxEdit(Sender).Text = '' then begin
        Beep;
        TDxEdit(Sender).SetFocus;
        Exit;
      end;
    end;
    if (Sender = DEdSSNo) and (not EnglishVersion) then begin
      if not NewIdCheckSSno then
        Exit;
    end;
    if Sender = DEdBirthDay then begin
      if not NewIdCheckBirthDay then
        Exit;
    end;
    if TDxEdit(Sender).Text <> '' then begin
      if Sender = DEdNewId then
        DEdNewPasswd.SetFocus;
      if Sender = DEdNewPasswd then
        DEdConfirm.SetFocus;
      if Sender = DEdConfirm then
        DEdYourName.SetFocus;
      if Sender = DEdYourName then
        DEdSSNo.SetFocus;
      if Sender = DEdSSNo then
        DEdBirthDay.SetFocus;
      if Sender = DEdBirthDay then
        DEdQuiz1.SetFocus;
      if Sender = DEdQuiz1 then
        DEdAnswer1.SetFocus;
      if Sender = DEdAnswer1 then
        DEdQuiz2.SetFocus;
      if Sender = DEdQuiz2 then
        DEdAnswer2.SetFocus;
      if Sender = DEdAnswer2 then
        DEdPhone.SetFocus;
      if Sender = DEdPhone then
        DEdMobPhone.SetFocus;
      if Sender = DEdMobPhone then
        DEdEMail.SetFocus;
      if Sender = DEdEMail then begin
        if DEdNewId.Enabled then
          DEdNewId.SetFocus
        else if DEdNewPasswd.Enabled then
          DEdNewPasswd.SetFocus;
      end;

      if Sender = DEdChgId then
        DEdChgCurrentpw.SetFocus;
      if Sender = DEdChgCurrentpw then
        DEdChgNewPw.SetFocus;
      if Sender = DEdChgNewPw then
        DEdChgRepeat.SetFocus;
      if Sender = DEdChgRepeat then
        DEdChgId.SetFocus;
    end;
  end;
end;

