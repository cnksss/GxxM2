procedure TSerialWindows.DUpgradeDlgItemMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  Ctrl:TDxControl;
  sel:Integer;
  vtRect:TRect;
  sMsg:string;
begin
  Ctrl := TDxControl(Sender);

  sel := TDxImageButton(Sender).Tag;
  if (sel >= 0) and (sel <= 2) then begin
    if (g_UpgradeItemArr[sel].S.Name <> '') then begin
      g_MouseItem := g_UpgradeItemArr[sel];
      if (g_ClientConfig.btSuspensionShowItem > 0) or (g_ClientVersion > {cvHero} cvSerial) then begin
        g_boShowBagInfo := False;
        vtRect := Ctrl.VirtualRect;
        ShowMouseItemInfo(g_MySelf, @g_MouseItem, vtRect.Left, vtRect.Top, True, 0, False);
      end
      else begin
        g_boShowBagInfo := True;
      end;
    end
    else begin
      DScreen.ClearHint;
      HintWindows.Clear;
      sMsg := Ctrl.Hint;
      if sMsg <> '' then begin
        vtRect := Ctrl.VirtualRect;
        HintWindows.Show(vtRect.Left, vtRect.Top, sMsg, clWhite, True);
      end;
    end;
  end
  else begin
    g_boShowBagInfo := False;
    g_MouseItem.s.Name := '';
    HintWindows.Clear;
  end;
end;

