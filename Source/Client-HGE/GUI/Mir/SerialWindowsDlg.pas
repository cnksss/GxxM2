  if (ARow >= 0) and (ARow <= 4) and (g_SelectMyShopItemWait.S.Name = '') and (g_MyShopDlgItem.S.Name = '') and (g_MyShopDlgItemWait.S.Name = '') then begin
    if ACol = 5 then begin // 返回仓库
      frmMain.SendMoveMyShopItem(g_MyShopItems[0, ARow].Item.MakeIndex, 0, 1, g_MyShopItems[0, ARow].Item.S.Name);
