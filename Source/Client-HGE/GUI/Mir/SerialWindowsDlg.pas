procedure TSerialWindows.DShowProgressDlgPaint(Sender:TObject);
var
  nBarCount:Integer;
begin
  if (MyGetTickCount > (FShowProgressBarTick + FShowProgressBarTime)) or (FShowProgressBarTime <= 0) then begin
    DShowProgressDlg.Visible := False;
    FrmMain.SendClientMessage(FShowProgressBarCmd, FShowProgressBarParam1, FShowProgressBarParam2, 0, 0, '');
    Exit;
  end;

  nBarCount := Round((MyGetTickCount - FShowProgressBarTick) / FShowProgressBarTime * 100);
  DShowProgressBar.Width := Round(DShowProgressBar.Tag / 100 * nBarCount);
end;

