  //self.DMainBottomDlg.Visible := False;
  //Exit;        

  dwCurTick := MyGetTickCount;

  // 强行退出
  g_dwLatestStruckTick := dwCurTick + 10001;
  g_dwLatestMagicTick := dwCurTick + 10001;
  g_dwLatestHitTick := dwCurTick + 10001;

  if DVerifyCodeDlg.Visible then begin
    DScreen.AddChatBoardString(DecodeResStr(SCannotExitGame1), clYellow, clRed);
    Exit;
  end;

  if (dwCurTick - g_dwLatestStruckTick > 10000) and (dwCurTick - g_dwLatestMagicTick > 10000)
  and (dwCurTick - g_dwLatestHitTick > 10000) or ((g_MySelf <> nil) and g_MySelf.m_boDeath) then begin
    frmMain.AppLogout;
