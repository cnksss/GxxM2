  end;
end;

procedure TSerialWindows.DSellPlayerMeridiansLineDirectPaint(Sender:TObject); // 绘制穴位
var
  I:Integer;
  nC:Integer;
  d:TTexture;
  vtRect:TRect;
begin
  with Sender as TDxImageForm do begin
    vtRect := VirtualRect;
    nC := 1;
    for I := 0 to 4 do begin
      if g_SellPlayerUserInfo.Meridians[Tag].Acupoints[I] > 0 then begin
        vtRect := FSellPlayerAcupointArray[Tag, I].VirtualRect;
        d := g_WMainImages.Images[851];
        if d <> nil then
          GameCanvas.Draw(vtRect.Left, vtRect.Top, d);
        Inc(nC);
      end;
    end;

    Dec(nC);
    if nC in [0..4] then begin
      Inc(g_nAcupointTicks);
