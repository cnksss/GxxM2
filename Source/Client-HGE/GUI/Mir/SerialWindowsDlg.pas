procedure TSerialWindows.DPlusDCClick(Sender:TObject; X, Y:Integer);
var
  incp, nValue:Integer;
  nHighValue:Integer;

  ///返回调整量, 最多加到整数最大值

  function AddIncpValue(var nChgVal:Integer; var nVal:Integer; nInc:Integer):Integer;
  begin
    Result := 0;
    if (Int64(nChgVal) + Int64(nVal)) < High(Integer) then begin
      if (Int64(nChgVal) + Int64(nVal) + Int64(nInc)) <= High(Integer) then begin
        Inc(nChgVal, nInc);
        Result := nInc;
      end else begin
        Result := High(Integer) - nChgVal - nVal;
        Inc(nChgVal, Result);
      end;
    end;
  end;

begin
  if IsKeyPressed(VK_CONTROL) and (g_nBonusPoint > 10) then
    incp := 10
  else
    incp := 1;

  if g_nBonusPoint > 0 then begin

    if Sender = DPlusDC then begin
      nValue := AddIncpValue(g_BonusAbilChg.DC, g_BonusAbil.DC, incp);
      Dec(g_nBonusPoint, nValue);
    end else if Sender = DPlusMC then begin
      nValue := AddIncpValue(g_BonusAbilChg.MC, g_BonusAbil.MC, incp);
      Dec(g_nBonusPoint, nValue);
    end else if Sender = DPlusSC then begin
      nValue := AddIncpValue(g_BonusAbilChg.SC, g_BonusAbil.SC, incp);
      Dec(g_nBonusPoint, nValue);
    end else if Sender = DPlusAC then begin
      nValue := AddIncpValue(g_BonusAbilChg.AC, g_BonusAbil.AC, incp);
      Dec(g_nBonusPoint, nValue);
    end else if Sender = DPlusMAC then begin
      nValue := AddIncpValue(g_BonusAbilChg.MAC, g_BonusAbil.MAC, incp);
      Dec(g_nBonusPoint, nValue);
    end else if Sender = DPlusHP then begin
      nValue := AddIncpValue(g_BonusAbilChg.HP, g_BonusAbil.HP, incp);
      Dec(g_nBonusPoint, nValue);
    end else if Sender = DPlusMP then begin
      nValue := AddIncpValue(g_BonusAbilChg.MP, g_BonusAbil.MP, incp);
      Dec(g_nBonusPoint, nValue);
    end else if Sender = DPlusHit then begin
      if g_ClientConfig.btMaxHitPoint = 1 then
        nHighValue := High(Word)
      else
        nHighValue := High(Byte);

      if g_nNoBounsMyHitPoint + (g_BonusAbil.Hit + g_BonusAbilChg.Hit) div g_BonusTick.Hit < nHighValue then begin
        if Int64(g_BonusAbilChg.Hit) + Int64(g_BonusAbil.Hit) < High(Integer) then begin
          if (Int64(g_BonusAbilChg.Hit) + Int64(g_BonusAbil.Hit) + Int64(incp)) <= High(Integer) then begin
            Inc(g_BonusAbilChg.Hit, incp);
            Dec(g_nBonusPoint, incp);
          end else begin
            nValue := High(Integer) - g_BonusAbilChg.Hit - g_BonusAbil.Hit;
            Inc(g_BonusAbilChg.Hit, nValue);
            Dec(g_nBonusPoint, nValue);
          end;
        end;
      end;
    end else if Sender = DPlusSpeed then begin
      if g_ClientConfig.btMaxHitPoint = 1 then
        nHighValue := High(Word)
      else
        nHighValue := High(Byte);

      if g_nNoBounsMySpeedPoint + (g_BonusAbil.Speed + g_BonusAbilChg.Speed) div g_BonusTick.Speed < nHighValue then begin
        if Int64(g_BonusAbilChg.Speed) + Int64(g_BonusAbil.Speed) < High(Integer) then begin
          if (Int64(g_BonusAbilChg.Speed) + Int64(g_BonusAbil.Speed) + Int64(incp)) <= High(Integer) then begin
            Inc(g_BonusAbilChg.Speed, incp);
            Dec(g_nBonusPoint, incp);
          end else begin
            nValue := High(Integer) - g_BonusAbilChg.Speed - g_BonusAbil.Speed;
            Inc(g_BonusAbilChg.Speed, nValue);
            Dec(g_nBonusPoint, nValue);
          end;
        end;
      end;
    end;
  end;

  RefreshAdjustAbilityValue;
end;

