procedure TSerialWindows.ResetMenuDlg(ClearMenuList:Boolean);
var
  I:Integer;
  Item:PTClientItem;
begin
  CloseDSellDlg;
  g_MenuItemList.Lock;
  try
    for I := 0 to g_MenuItemList.Count - 1 do
      Dispose(PTClientItem(g_MenuItemList[I]));
    g_MenuItemList.Clear;
  finally
    g_MenuItemList.UnLock;
  end;

  if ClearMenuList then begin
    MenuList.Lock;
    try
      for I := 0 to MenuList.Count - 1 do
        Dispose(PTClientGoods(MenuList[I]));
      MenuList.Clear;
    finally
      MenuList.UnLock;
    end;
  end;

  for I := 0 to Length(g_SellDlgItems) - 1 do begin
    Item := @g_SellDlgItems[I];
    if Length(Item.s.Name) > 0 then begin
      AddItemBag(Item^);
      Item.s.Name := '';
    end;
  end;

  BoDetailMenu := False;
  BoStorageMenu := False;
  BoMakeDrugMenu := False;

  DSellDlg.Visible := False;
  DMenuDlg.Visible := False;

  DStorageViewDlg.Visible := False;
  DBaseStorageViewDlg.Visible := False;

  if ClearMenuList then begin
    menuindex := -1;
    MenuTopLine := 0;
    DTradingMarketDlg.Visible := False;
    DTradingMarketItemsDlg.Visible := False;
  end;
end;

procedure TSerialWindows.CloseMDlg;
var
  I:Integer;
  Item:PTClientItem;
begin
  MDlgStr := '';
  CloseDMerchantDlg;

  DItemBag.Left := 0;
  DItemBag.Top := 90;
  DMenuDlg.Visible := False;

  if (not g_ClientConfig.boHeroStateDlgNoMove) then begin
    if (DHeroStateDlg185 <> nil) and DHeroStateDlg185.Visible then
      DHeroStateDlg185.Left := 0;

    if (DHeroStateDlg <> nil) and DHeroStateDlg.Visible then
      DHeroStateDlg.Left := 0;
  end;

  CloseDSellDlg;

  DStorageViewDlg.Visible := False;
  DBaseStorageViewDlg.Visible := False;
  DTradingMarketDlg.Visible := False;

  for I := 0 to Length(g_SellDlgItems) - 1 do begin
    Item := @g_SellDlgItems[I];
    if Length(Item.s.Name) > 0 then begin
      AddItemBag(Item^);
      Item.s.Name := '';
    end;
  end;
  DTradingMarketItemsDlg.Visible := False;
end;

