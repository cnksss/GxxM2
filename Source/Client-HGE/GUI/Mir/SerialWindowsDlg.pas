end;

procedure TSerialWindows.DSellPlayerUseItemMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  I, J, K, sel, nX, nY, nWidth, nHeight:Integer;
  vtRect:TRect;
  DrawLeft:Boolean;
  HintWindow:THintWindow;
  HintList:TList;
  TzHintWindows:TList;
  D:TDxControl;
  CtrlRect:TRect;
  HatItem:TClientItem;
  HintLines:THintLines;
  HintText:THintText;
  ArrHintWindows:TArrHintWindows;
begin
  sel := TDxImageButton(Sender).Tag;
  if (sel = U_HELMET) and (g_SellPlayerUserInfo.UseItems[U_HELMET].S.Name = '') and (g_SellPlayerUserInfo.UseItems[U_HAT].S.Name <> '') then // 优先显示斗笠
    sel := U_HAT;

  if (sel < 0) or (g_SellPlayerUserInfo.UseItems[sel].S.Name = '') then begin
    g_MouseUserStateItem.s.Name := '';
    HintWindows.Clear;
    Exit;
  end;

  g_MouseUserStateItem := g_SellPlayerUserInfo.UseItems[sel];

  // 免得不停的重新创建提示窗口 chongchong 2015-01-22
  if (g_MouseUserStateItem.MakeIndex <> g_LastHintMakeIndex) then begin
    if (g_ClientConfig.btSuspensionShowItem > 0) or (g_ClientVersion > cvSerial) then begin
      if g_MouseUserStateItem.s.Name <> '' then begin
        HintWindows.Clear;

        D := TDxControl(Sender);

        while True do begin
          if (D.Owner <> nil) and (D.Owner is TDxControlEngine) then
            break;
          D := D.Owner;
        end;

        if g_ClientConfig.boHintWithMouse then begin
          CtrlRect := TDxControl(Sender).VirtualRect;
          vtRect := D.VirtualRect;
          nY := CtrlRect.Bottom;
          nX := CtrlRect.Left;
          DrawLeft := False;
        end
        else begin
          vtRect := D.VirtualRect;
          nY := vtRect.Top + 40; // + 40;

          DrawLeft := vtRect.Right + 160 > SCREENWIDTH;
          if DrawLeft then
            nX := vtRect.Left // + 40
          else
            nX := vtRect.Right;
        end;

        //nX := vtRect.Left;
        //nY := vtRect.Top + 40;

        HintWindows.Clear;
        HintList := TList.Create;

        // 两列显示 piaoyun 2013-09-16
        if not g_ClientConfig.boSingleHint then begin
          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            ArrHintWindows[I] := THintWindow.Create;
          end;

          GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_MouseUserStateItem, nX, nY, False, False, DrawLeft);

          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            HintWindow := THintWindow(ArrHintWindows[I]);
            if HintWindow.Count > 0 then begin
              HintList.Add(HintWindow);
              HintWindow.Show(0, 0);
            end
            else
              HintWindow.Free;
          end;

          if not g_ClientConfig.boTZSupportRenameItem then
            TzHintWindows := GetTzItemHintWindow(2, g_SellPlayerUserInfo.Gender, g_MouseUserStateItem.s.DBName)
          else
            TzHintWindows := GetTzItemHintWindow(2, g_SellPlayerUserInfo.Gender, g_MouseUserStateItem.s.Name);

          if TzHintWindows <> nil then begin
            for I := 0 to TzHintWindows.Count - 1 do begin
              THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
              HintList.Add(TzHintWindows.Items[I]);
            end;
            TzHintWindows.Free;
          end;

          if (sel = U_HELMET) and (g_SellPlayerUserInfo.UseItems[U_HAT].S.Name <> '') then begin
            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              ArrHintWindows[I] := THintWindow.Create;
            end;

            GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_SellPlayerUserInfo.UseItems[U_HAT], nX, nY, False, False, DrawLeft);

            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              HintWindow := THintWindow(ArrHintWindows[I]);
              if HintWindow.Count > 0 then begin
                HintList.Add(HintWindow);
                HintWindow.Show(0, 0);
              end
              else
                HintWindow.Free;
            end;

            if not g_ClientConfig.boTZSupportRenameItem then
              TzHintWindows := GetTzItemHintWindow(2, g_SellPlayerUserInfo.Gender, g_SellPlayerUserInfo.UseItems[U_HAT].S.DBName)
            else
              TzHintWindows := GetTzItemHintWindow(2, g_SellPlayerUserInfo.Gender, g_SellPlayerUserInfo.UseItems[U_HAT].S.Name);

            if TzHintWindows <> nil then begin
              for I := 0 to TzHintWindows.Count - 1 do begin
                THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
                HintList.Add(TzHintWindows.Items[I]);
              end;
              TzHintWindows.Free;
            end;
          end;
        end
        else begin
          // 单列显示 piaoyun 2013-09-16
          TzHintWindows := GetTzItemHintWindowEx(2, g_SellPlayerUserInfo.Gender, g_MySelf, @g_MouseUserStateItem, False);
          if TzHintWindows <> nil then begin
            for I := 0 to TzHintWindows.Count - 1 do begin
              THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
              HintList.Add(TzHintWindows.Items[I]);
            end;
            TzHintWindows.Free;
          end
          else begin
            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              ArrHintWindows[I] := THintWindow.Create;
            end;

            GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_MouseUserStateItem, nX, nY, False, False, DrawLeft);

            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              HintWindow := THintWindow(ArrHintWindows[I]);
              if HintWindow.Count > 0 then begin
                HintList.Add(HintWindow);
                HintWindow.Show(0, 0);
              end
              else
                HintWindow.Free;
            end;
          end;

          if (sel = U_HELMET) and (g_SellPlayerUserInfo.UseItems[U_HAT].S.Name <> '') then begin
            TzHintWindows := GetTzItemHintWindowEx(2, g_SellPlayerUserInfo.Gender, g_MySelf, @g_SellPlayerUserInfo.UseItems[U_HAT], False);
            if TzHintWindows <> nil then begin
              for I := 0 to TzHintWindows.Count - 1 do begin
                THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
                HintList.Add(TzHintWindows.Items[I]);
              end;
              TzHintWindows.Free;
            end
            else begin
              for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                ArrHintWindows[I] := THintWindow.Create;
              end;

              GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_SellPlayerUserInfo.UseItems[U_HAT], nX, nY, False, False, DrawLeft);

              for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                HintWindow := THintWindow(ArrHintWindows[I]);
                if HintWindow.Count > 0 then begin
                  HintList.Add(HintWindow);
                  HintWindow.Show(0, 0);
                end
                else
                  HintWindow.Free;
              end;

            end;
          end;
        end;

        nWidth := 0;
        nHeight := 0;
        for I := 0 to HintList.Count - 1 do begin
          HintWindow := THintWindow(HintList.Items[I]);
          nWidth := nWidth + HintWindow.Width;
          nHeight := Max(HintWindow.Height, nHeight);
        end;

        if g_ClientConfig.boHintWithMouse then begin
          if CtrlRect.Left >= (SCREENWIDTH - D.Width) then begin
            nX := CtrlRect.Left; // HintWindow.Width;
            DrawLeft := True;
          end
          else begin
            nX := CtrlRect.Right;
            DrawLeft := False;
          end;
        end
        else begin
          if vtRect.Left >= (SCREENWIDTH - D.Width) div 2 then begin
            nX := vtRect.Left - nWidth; // HintWindow.Width;
            DrawLeft := True;
          end
          else begin
            nX := vtRect.Right;
            DrawLeft := False;
          end;
        end;

        if nX + nWidth > SCREENWIDTH then
          nX := SCREENWIDTH - nWidth;

        if nY + nHeight > SCREENHEIGHT then
          nY := SCREENHEIGHT - nHeight;

        if nX < 0 then
          nX := 0;
        if nY < 0 then
          nY := 0;

        if DrawLeft then begin
          for I := HintList.Count - 1 downto 0 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            HintWindow.X := nX;
            HintWindow.Y := nY;
            Inc(nX, HintWindow.Width);
            HintWindows.Add(HintWindow);
          end;
        end
        else begin
          for I := 0 to HintList.Count - 1 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            HintWindow.X := nX;
            HintWindow.Y := nY;
            Inc(nX, HintWindow.Width);
            HintWindows.Add(HintWindow);
          end;
        end;
        HintList.Free;
      end;
    end
    else if (sel = U_HELMET) and (g_SellPlayerUserInfo.UseItems[U_HAT].S.Name <> '') then begin
      sel := U_HAT;
      g_boShowBagInfo := False;
      D := TDxControl(Sender);

      while True do begin
        if (D.Owner <> nil) and (D.Owner is TDxControlEngine) then
          break;
        D := D.Owner;
      end;
      with D do begin
        CtrlRect := TDxControl(Sender).VirtualRect;
        vtRect := VirtualRect;
        nY := CtrlRect.Bottom;
        nX := CtrlRect.Left;
        DrawLeft := False;

        HatItem := g_SellPlayerUserInfo.UseItems[sel];
        HintWindows.Clear;
        HintList := TList.Create;

        TzHintWindows := GetTzItemHintWindowEx(0, g_SellPlayerUserInfo.Gender, g_MySelf, @HatItem, False);
        if TzHintWindows <> nil then begin
          for I := 0 to TzHintWindows.Count - 1 do begin
            THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
            HintList.Add(TzHintWindows.Items[I]);
          end;
          TzHintWindows.Free;
        end
        else begin
          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            ArrHintWindows[I] := THintWindow.Create;
          end;

          GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @HatItem, nX, nY, False, False, DrawLeft);

          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            HintWindow := THintWindow(ArrHintWindows[I]);
            if HintWindow.Count > 0 then begin
              HintList.Add(HintWindow);
              HintWindow.Show(0, 0);
            end
            else
              HintWindow.Free;
          end;
        end;

        nWidth := 0;
        nHeight := 0;

        for I := 0 to HintList.Count - 1 do begin
          HintWindow := THintWindow(HintList.Items[I]);
          nWidth := nWidth + HintWindow.Width;
          nHeight := Max(HintWindow.Height, nHeight);
        end;

        if CtrlRect.Left >= (SCREENWIDTH - Width) then begin
          nX := CtrlRect.Left; // HintWindow.Width;
          DrawLeft := True;
        end
        else begin
          nX := CtrlRect.Right;
          DrawLeft := False;
        end;

        if nX + nWidth > SCREENWIDTH then
          nX := SCREENWIDTH - nWidth;

        if nY + nHeight > SCREENHEIGHT then
          nY := SCREENHEIGHT - nHeight;

        if nX < 0 then
          nX := 0;
        if nY < 0 then
          nY := 0;
        if DrawLeft then begin
          for I := HintList.Count - 1 downto 0 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            HintWindow.X := nX;
            HintWindow.Y := nY;

            // 旧模式斗笠显示黄色字 chongchong 2013-12-17
            if g_ClientConfig.boUseOldSerialWindows then begin
              for J := 0 to HintWindow.Count - 1 do begin
                HintLines := HintWindow.Items[J];
                for K := 0 to HintLines.Count - 1 do begin
                  HintText := HintLines.Objects[K] as THintText;
                  HintText.Color := clYellow;
                end;
              end;
            end;

            Inc(nX, HintWindow.Width);
            HintWindows.Add(HintWindow);
          end;
        end
        else begin
          for I := 0 to HintList.Count - 1 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            HintWindow.X := nX;
            HintWindow.Y := nY;

            // 旧模式斗笠显示黄色字 chongchong 2013-12-17
            if g_ClientConfig.boUseOldSerialWindows then begin
              for J := 0 to HintWindow.Count - 1 do begin
                HintLines := HintWindow.Items[J];
                for K := 0 to HintLines.Count - 1 do begin
                  HintText := HintLines.Objects[K] as THintText;
                  HintText.Color := clYellow;
                end;
              end;
            end;

            Inc(nX, HintWindow.Width);
            HintWindows.Add(HintWindow);
          end;
        end;
        HintList.Free;
      end;
    end;
  end;
  g_LastHintMakeIndex := g_MouseUserStateItem.MakeIndex;
end;

procedure TSerialWindows.DSellPlayerStateWinDirectPaint(Sender:TObject);
var
  bbx, bby, nIdx, ax, ay:Integer;
  d:TTexture;
  vtRect:TRect;
  vbRect:TRect;
  IsShowHelmet:Boolean;
  IsShowHair:Boolean;
begin
  // 把这个B底层播放放到衣服下面 太阳.... chongchong 2016-08-04
  if (g_SellPlayerUserInfo.UseItems[U_RIGHTHAND].S.Name <> '') then begin
    if g_SellPlayerUserInfo.UseItems[U_RIGHTHAND].S.StdMode = 30 then
      FrmDlg.DrawBodyItemBelowEffect(DSWLight.VirtualRect, @g_SellPlayerUserInfo.UseItems[U_RIGHTHAND].S, @g_SellPlayerUseItemsEffect[U_RIGHTHAND])
    else begin
      if g_SellPlayerUserInfo.UseItems[U_RIGHTHAND].S.StdMode = 29 then
        FrmDlg.DrawBodyItemBelowEffect(DSWLight.VirtualRect, @g_SellPlayerUserInfo.UseItems[U_RIGHTHAND].S, @g_SellPlayerUseItemsEffect[U_RIGHTHAND]);
    end;
  end;

  with Sender as TDxControl do begin
    vbRect := VisibleRect;
    if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
      Exit;
    vtRect := VirtualRect;

    if g_ClientVersion = cvMirNewUI205 then begin
      bbx := vtRect.Left + 55 + g_ConfigClient.nUserHairOffsetX;
      bby := vtRect.Top + 94 + g_ConfigClient.nUserHairOffsetY;
    end
    else begin
      bbx := vtRect.Left + 52 + g_ConfigClient.nUserHairOffsetX;
      bby := vtRect.Top + 78 + g_ConfigClient.nUserHairOffsetY;
    end;

    IsShowHair := True;
    if g_SellPlayerUserInfo.UseItems[U_DRESS].S.Name <> '' then begin
      // 个位用来表示是否显示发型，Expand5 div 10用来表示使提示框文字使用哪个图片作为背景 2019-12-15 10:05:20
      IsShowHair := g_SellPlayerUserInfo.UseItems[U_DRESS].S.Expand5 mod 10 = 0;
    end;

    if IsShowHair then begin
      if g_SellPlayerUserInfo.Hair < 4 then begin
        nIdx := 440 + g_SellPlayerUserInfo.Hair;
        if nIdx > 0 then begin
          d := g_WMainImages.GetCachedImage(nIdx, ax, ay);
          if d <> nil then
            GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
        end;
      end
      else if (g_SellPlayerUserInfo.Hair >= 50) and (g_SellPlayerUserInfo.Hair <= 69) then begin
        nIdx := 350 + g_SellPlayerUserInfo.Hair;
        d := g_WNewopUIImages.GetCachedImage(nIdx, ax, ay);
        if d <> nil then
          GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
      end;
    end;

    if g_SellPlayerUserInfo.UseItems[U_DRESS].S.Name <> '' then begin
      FrmDlg.DrawBodyItemEffect(bbx, bby, @g_SellPlayerUserInfo.UseItems[U_DRESS].S, @g_SellPlayerUseItemsEffect[U_DRESS], True);
      nIdx := g_SellPlayerUserInfo.UseItems[U_DRESS].S.looks;
      if nIdx >= 0 then begin
        d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
        if d <> nil then
          GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
      end;
      FrmDlg.DrawBodyItemEffect(bbx, bby, @g_SellPlayerUserInfo.UseItems[U_DRESS].S, @g_SellPlayerUseItemsEffect[U_DRESS], False);
    end;

    if g_SellPlayerUserInfo.UseItems[U_WEAPON].S.Name <> '' then begin
      FrmDlg.DrawBodyItemEffect(bbx, bby, @g_SellPlayerUserInfo.UseItems[U_WEAPON].S, @g_SellPlayerUseItemsEffect[U_WEAPON], True);
      nIdx := g_SellPlayerUserInfo.UseItems[U_WEAPON].S.looks;
      if nIdx >= 0 then begin
        d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
        if d <> nil then
          GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
      end;
      FrmDlg.DrawBodyItemEffect(bbx, bby, @g_SellPlayerUserInfo.UseItems[U_WEAPON].S, @g_SellPlayerUseItemsEffect[U_WEAPON], False);
    end;
    if g_SellPlayerUserInfo.UseItems[U_HELMET].S.Name <> '' then begin
      nIdx := g_SellPlayerUserInfo.UseItems[U_HELMET].S.looks;

      IsShowHelmet := True;
      if (g_SellPlayerUserInfo.UseItems[U_HELMET].S.StdMode = 15) then begin
        if (g_SellPlayerUserInfo.UseItems[U_HAT].S.Name <> '') and (g_SellPlayerUserInfo.UseItems[U_HAT].S.StdMode = 16) and (g_SellPlayerUserInfo.UseItems[U_HAT].S.Shape <> 1000) {1000 为面巾，面巾和头盔可同时显示} then
          IsShowHelmet := False;
      end;
      if (nIdx >= 0) and IsShowHelmet then begin
        FrmDlg.DrawBodyItemEffect(DSellPlayerSWHelmet.VirtualRect, @g_SellPlayerUserInfo.UseItems[U_HELMET].S, @g_SellPlayerUseItemsEffect[U_HELMET], True);
        d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
        if (d <> nil) then begin
          if g_ClientConfig.boHelmetShowInBox then begin
