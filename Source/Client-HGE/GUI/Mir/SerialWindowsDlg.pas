procedure TSerialWindows.DBoxDlgUpDate(Sender:TObject);
begin
  if g_BoxConfig.boOpen then begin
    if (g_BoxConfig.nCurrentFrame < g_BoxConfig.nEndFrame) then begin
      if MyGetTickCount - g_BoxConfig.dwOpenTick >= Cardinal(g_BoxConfig.nFrameTime) then begin
        g_BoxConfig.dwOpenTick := MyGetTickCount;
        Inc(g_BoxConfig.nCurrentFrame);
      end;
    end else begin
      OpenDItemBoxDlg;
    end;
  end;
end;

procedure TSerialWindows.DItemBoxDlgUpDate(Sender:TObject);

  function GetNextIndex(nIndex:Integer):Integer;
  begin
    case nIndex of
      0:
        Result := 1;
      1:
        Result := 2;
      2:
        Result := 5;
      5:
        Result := 8;
      8:
        Result := 7;
      7:
        Result := 6;
      6:
        Result := 3;
      3:
        Result := 0;
      else begin
          Result := Random(8);
          while Result = nIndex do begin
            Result := Random(8);
          end;
        end;
    end;
  end;

begin
  if (g_ItemBoxConfig.boRotation) and (not g_ItemBoxConfig.boRotationOK) then begin
    if MyGetTickCount - g_ItemBoxConfig.dwRotationTick > g_ItemBoxConfig.dwRotationTime then begin
      g_ItemBoxConfig.dwRotationTick := MyGetTickCount;

      g_ItemBoxConfig.nSelIndex := GetNextIndex(g_ItemBoxConfig.nSelIndex);

      Inc(g_ItemBoxConfig.nRotationCount);
      if g_ItemBoxConfig.nRotationCount >= 8 then begin
        Inc(g_ItemBoxConfig.nCycleCount);
        g_ItemBoxConfig.nRotationCount := 0;
      end;

      if g_ItemBoxConfig.nCycleCount >= 2 then // 开始减速
        Inc(g_ItemBoxConfig.dwRotationTime, 30)
      else
        Inc(g_ItemBoxConfig.dwRotationTime, 20);

      if (g_ItemBoxConfig.nCycleCount >= 3) then begin // 3圈后开始停止转动
        if g_ItemBoxConfig.nSelRotationIndex = g_ItemBoxConfig.nSelIndex then begin
          // 转到选择的装备停止
          g_ItemBoxConfig.boRotationOK := True;
          // 如果还可以旋转 则赋值
          g_ItemBoxConfig.boRotation := False;
        end;
      end;
      PlaySound(s_Flashbox);
    end;
  end;
end;

procedure TSerialWindows.OpenDBoxDlg(nShape:Integer); // 显示箱子
begin
  if nShape >= 15 then begin
    g_BoxConfig.Item := g_EatingItem;
    g_BoxConfig.sName := g_EatingItem.S.Name;
    g_BoxConfig.boUse := True;
    g_BoxConfig.nShape := nShape;
    g_BoxConfig.boOpen := False;
    g_BoxConfig.dwOpenTick := MyGetTickCount;
    if g_BoxConfig.nShape >= 19 {黄金宝箱 piaoyun 2013-08-26} then begin
      DBoxDlg.ImageIndex.ImageType := DBoxDlg.Animation2.ImageType;
      g_BoxConfig.nStartFrame := DBoxDlg.Animation2.StartIndex;
      g_BoxConfig.nEndFrame := DBoxDlg.Animation2.EndIndex;
      g_BoxConfig.nFrameTime := DBoxDlg.Animation2.FrameTime;
    end
    else begin
      DBoxDlg.ImageIndex.ImageType := DBoxDlg.Animation1.ImageType;
      g_BoxConfig.nStartFrame := DBoxDlg.Animation1.StartIndex + (nShape - 15) * 20;
      g_BoxConfig.nEndFrame := DBoxDlg.Animation1.EndIndex + (nShape - 15) * 20;
      g_BoxConfig.nFrameTime := DBoxDlg.Animation1.FrameTime;
    end;

    g_BoxConfig.nCurrentFrame := g_BoxConfig.nStartFrame;

    DBoxDlg.ImageIndex.Up := g_BoxConfig.nStartFrame;
    DBoxDlg.Left := (SCREENWIDTH - DBoxDlg.Width) div 2;
    DBoxDlg.Top := (SCREENHEIGHT - DBoxDlg.Height) div 2 - 100;
    DBoxDlg.Visible := True;
  end;
end;

