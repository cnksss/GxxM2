procedure TSerialWindows.EndDropGuidMember(Pt:TPoint);
var
  I, ItemIndex, Index:Integer;
  vtRect:TRect;
  GuildGroup1, GuildGroup2, GuildGroup99:TGuildGroup;
  S:string;
begin
  FIsDropGuildMember := False;

  vtRect := DGuildManageForm2ChatMemo1.VirtualRect;
  if PtInRect(vtRect, Pt) then begin
    ItemIndex := (Pt.Y - vtRect.Top - DGuildManageForm2ChatMemo1.OffSetY) div DGuildManageForm2ChatMemo1.ItemHeight + DGuildManageForm2ChatMemo1.Position div DGuildManageForm2ChatMemo1.ItemHeight;

    if ItemIndex <> FGuildGroupIndex then begin
      GuildGroup1 := GuildGroupList.Groups[FGuildGroupIndex];
      GuildGroup2 := GuildGroupList.Groups[ItemIndex];

      if (GuildGroup1 <> nil) and (GuildGroup2 <> nil) then begin
        if GuildGroup1.ID = 1 then begin
          if GuildGroup1.Members.Count >= 2 then begin
            if FrmDlg.DMessageDlg('是否取消该会员的会长权限？', [mbOk, mbCancel]) <> mrOk then
              Exit;
          end
          else begin
            DScreen.AddChatBoardString('不允许取消该会员的会长权限.', clWhite, clRed);
            Exit;
          end;
        end;

        if GuildGroup2.ID = 1 then begin
          if GuildGroup2.Members.Count >= 2 then begin
            if FrmDlg.DMessageDlg('是否将会长 "' + GuildGroup2.Members.Strings[1] + '" 换成该会员？', [mbOk, mbCancel]) = mrOk then begin
              GuildGroup99 := nil;
              for I := 0 to GuildGroupList.Count - 1 do begin
                if GuildGroupList.Groups[I].ID = 99 then begin
                  GuildGroup99 := GuildGroupList.Groups[I];
                  Break;
                end;
              end;

              if GuildGroup99 <> nil then begin
                Index := GuildGroup1.Members.IndexOf(FDropGuildMemberName);
                if Index >= 0 then begin
                  GuildGroup99.Members.Add(GuildGroup2.Members[1]);
                  GuildGroup2.Members.Delete(1);

                  GuildGroup1.Members.Delete(Index);
                  GuildGroup2.Members.Add(FDropGuildMemberName);
                end;
              end;
            end;
          end
          else begin
            if FrmDlg.DMessageDlg('是否将该会员设置为会长？', [mbOk, mbCancel]) = mrOk then begin
              Index := GuildGroup1.Members.IndexOf(FDropGuildMemberName);
              if Index >= 0 then begin
                GuildGroup1.Members.Delete(Index);
                GuildGroup2.Members.Add(FDropGuildMemberName);
              end;
            end;
          end;
        end
        else begin
          Index := GuildGroup1.Members.IndexOf(FDropGuildMemberName);
          if Index >= 0 then begin
            GuildGroup1.Members.Delete(Index);
            GuildGroup2.Members.Add(FDropGuildMemberName);
          end;
        end;

        for I := 0 to GuildGroupList.Count - 1 do begin
          GuildGroup1 := GuildGroupList.Groups[I];
          S := S + '#' + IntToStr(GuildGroup1.ID) + ' <' + GuildGroup1.Name + '>' + sLineBreak;
          S := S + GuildGroup1.Members.Text + sLineBreak;
        end;

        FrmMain.SendGuildUpdateGrade(S, FGuildGroupIndex);
      end;
    end;
  end;
end;

procedure TSerialWindows.DoGuildGroupIndexSelect;
var
  GuildGroup:TGuildGroup;
begin
  if (FGuildGroupIndex >= 0) or (FGuildGroupIndex < GuildGroupList.Count) then begin
    GuildGroup := GuildGroupList.Groups[FGuildGroupIndex];
    case GuildGroup.ID of
      1:begin
          DGuildManageEditGrade.Enabled := GuildCommanderMode > 0;
          DGuildManageDelGrade.Enabled := False;
        end;
      99:begin
          DGuildManageEditGrade.Enabled := GuildCommanderMode > 0;
          DGuildManageDelGrade.Enabled := False;
        end;
      else begin
          DGuildManageEditGrade.Enabled := GuildCommanderMode > 0;
          DGuildManageDelGrade.Enabled := GuildCommanderMode > 0;
        end;
    end;
  end;
end;

