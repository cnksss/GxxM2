  C_PLAYIMGEX = 'PLAYIMGEX:';

  procedure GetNumberImageSize(nImageIndex, CharSpace:Integer; S:string; var Pt:TPoint);
  var
    II, nIndex:Integer;
    Texture:TTexture;
  begin
    Pt.X := 0;
    Pt.Y := 0;
    if (nImageIndex < 0) or (nImageIndex > 9) then
      Exit;

    if (g_WNewopUIImages = nil) or (Length(S) = 0) then
      Exit;
    for II := 1 to Length(S) do begin
      nIndex := 1230 + (nImageIndex * 10) + StrToInt(S[II]);
      Texture := g_WNewopUIImages.Images[nIndex];
      if Texture <> nil then begin
        if Pt.Y < Texture.Height then
          Pt.Y := Texture.Height;
        Pt.X := Pt.X + Texture.Width + CharSpace;
      end;
    end;
  end;

  procedure GetColorList(sColos:string);
  var
    II, nColor:Integer;
    StringList:TStringList;
    sLineText:string;
  begin
    ColorList.Clear;
    StringList := TStringList.Create;
    ExtractStrings([','], [' '], PChar(sColos), StringList);
    for II := 0 to StringList.Count - 1 do begin
      sLineText := Trim(StringList.Strings[II]);
      if sLineText = '' then
        Continue;
      nColor := StrToIntDef(sLineText, -1);
      if nColor in [0..255] then
        ColorList.Add(Pointer(GetRGB(nColor)));
    end;
    StringList.Free;
  end;

  // NPC对话框可以点击的标签

  function NewNpcLabel(ACaption, ACmd:string; Up:TColor; FontName:string; btSize:Byte; Style:TFontStyles):Integer;
