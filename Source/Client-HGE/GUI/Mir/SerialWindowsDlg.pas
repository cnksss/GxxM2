  HintLines:THintLines;
  TzHintWindows:TList;
  ArrHintWindows:TArrHintWindows;
begin
  Index := TDxImageButton(Sender).Tag;
  if Index < 0 then
    Exit;

  if g_GodBlessItemsState[Index] = 0 then begin
    HintWindows.Clear;

    ItemDesc := GetGodBlessItem(IntToStr(Index + 1));
