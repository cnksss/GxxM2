procedure TSerialWindows.DbtnRemoveStoneItemClick(Sender:TObject; X, Y:Integer);
var
  I:Integer;
begin
  if FRemoveStoneLock then
    Exit;

  if not g_boItemMoving then begin
    if g_StoneRemoveItem.Item.s.Name <> '' then
      AddItemBag(g_StoneRemoveItem.Item);
    SafeFillChar(g_StoneRemoveItem, SizeOf(g_StoneRemoveItem), #0);
  end;

  if g_boItemMoving and (g_MovingItem.ItemType = mtBagItem) and (g_MovingItem.Item.s.Name <> '') then begin
    if CheckInlaidGemstone(g_MovingItem.Item.s.StdMode) then begin
      if g_MovingItem.Item.btFluteCount > 0 then begin
        for I := 0 to g_MovingItem.Item.btFluteCount - 1 do begin
          if g_MovingItem.Item.Flutes[I].GemIndex > 0 then begin
            if g_StoneRemoveItem.Item.s.Name <> '' then
              AddItemBag(g_StoneRemoveItem.Item);
            g_StoneRemoveItem := g_MovingItem;
            g_boItemMoving := False;
            g_MovingItem.Item.s.Name := '';
            Exit;
          end;
        end;
        FrmDlg.CancelItemMoving;
        FrmDlg.DMessageDlg(Format(DecodeResStr(SNoFlute), [g_MovingItem.Item.s.DBName]), []);
      end
      else begin
        FrmDlg.CancelItemMoving;
        FrmDlg.DMessageDlg(Format(DecodeResStr(SNoFlute), [g_MovingItem.Item.s.DBName]), []);
      end;
    end
    else begin
      FrmDlg.CancelItemMoving;
    end;
  end;
end;

