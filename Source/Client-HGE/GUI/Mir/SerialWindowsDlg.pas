procedure TSerialWindows.RequestAuctionItems;
var
  I:Integer;
  S:string;
  Msg:TDefaultMessage;
  nPage:Integer;
begin
  if not DAuctionDlg.Visible then
    Exit;
  if g_IsRequeryAuctionMyItemsWait then
    Exit;

  if (MyGetTickCount - FRequeryAuctionMyItemsTick) >= 2000 then begin
    FRequeryAuctionMyItemsTick := MyGetTickCount;

    if DAuctionPage.ActivePageIndex = 0 then begin
      nPage := FAuctionAllItemsPage;

      for I := Low(g_AuctionAllItems) to High(g_AuctionAllItems) do begin
        if g_AuctionAllItems[I].AuctionID > 0 then begin
          S := S + IntToStr(g_AuctionAllItems[I].AuctionID) + ',';
        end;
      end;
    end
    else if DAuctionPage.ActivePageIndex = 1 then begin
      nPage := FAuctionMyItemsPage;

      for I := Low(g_AuctionMyItems) to High(g_AuctionMyItems) do begin
        if g_AuctionMyItems[I].AuctionID > 0 then begin
          S := S + IntToStr(g_AuctionMyItems[I].AuctionID) + ',';
        end;
      end;
    end
    else begin
      nPage := FAuctionMyItemsPage;

      for I := Low(g_AuctionMyAttention) to High(g_AuctionMyAttention) do begin
        if g_AuctionMyAttention[I].AuctionID > 0 then begin
          S := S + IntToStr(g_AuctionMyAttention[I].AuctionID) + ',';
        end;
      end;
    end;

    if Length(S) > 0 then begin
      S := Copy(S, 1, Length(S) - 1);

      g_IsRequeryAuctionMyItemsWait := True;
      Msg := MakeDefaultMsg(CM_RequestAuctionItems_ByIndex, DAuctionPage.ActivePageIndex, nPage, 0, 0);
      FrmMain.SendSocket(EncodeMessage(Msg) + EncodeString(S));
    end;
  end;
end;

procedure TSerialWindows.SendQueryAllAuctionItems(nPage:Integer; ShowAuctionID:Integer);
var
  GroupIndex:Integer;
  Msg:TDefaultMessage;
  btColors:Byte;
  ResquestAllAuctionItem:TResquestAllAuctionItem;
begin
  if g_MySelf = nil then
    Exit;

  if DBtnAuctionAllItemsGroup01.Checked then
    GroupIndex := 1
  else if DBtnAuctionAllItemsGroup02.Checked then
    GroupIndex := 2
  else if DBtnAuctionAllItemsGroup03.Checked then
    GroupIndex := 3
  else if DBtnAuctionAllItemsGroup04.Checked then
    GroupIndex := 4
  else if DBtnAuctionAllItemsGroup05.Checked then
    GroupIndex := 5
  else if DBtnAuctionAllItemsGroup06.Checked then
    GroupIndex := 6
  else if DBtnAuctionAllItemsGroup07.Checked then
    GroupIndex := 7
  else if DBtnAuctionAllItemsGroup08.Checked then
    GroupIndex := 8
  else if DBtnAuctionAllItemsGroup09.Checked then
    GroupIndex := 9
  else if DBtnAuctionAllItemsGroup10.Checked then
    GroupIndex := 10
  else if DBtnAuctionAllItemsGroup11.Checked then
    GroupIndex := 11
  else if DBtnAuctionAllItemsGroup12.Checked then
    GroupIndex := 12
  else
    GroupIndex := 0;

  btColors := 0;
  if DBtnAuctionAllItemsColor01.Checked then
    btColors := btColors + 1;
  if DBtnAuctionAllItemsColor02.Checked then
    btColors := btColors + 2;
  if DBtnAuctionAllItemsColor03.Checked then
    btColors := btColors + 4;
  if DBtnAuctionAllItemsColor04.Checked then
    btColors := btColors + 8;
  if DBtnAuctionAllItemsColor05.Checked then
    btColors := btColors + 16;
  if DBtnAuctionAllItemsColor06.Checked then
    btColors := btColors + 32;

  FillChar(ResquestAllAuctionItem, SizeOf(TResquestAllAuctionItem), 0);
  ResquestAllAuctionItem.ShowAuctionID := ShowAuctionID;
  ResquestAllAuctionItem.KeyWord := FQueryAllAuctionItems_KeyWord;

  ResquestAllAuctionItem.MoneyType := Integer(DBtnAuctionAllItemsMoney.Items.Objects[DBtnAuctionAllItemsMoney.ItemIndex]);
  ResquestAllAuctionItem.Prices1 := DEdtAuctionAllItemsPrices1.Value;
  ResquestAllAuctionItem.Prices2 := DEdtAuctionAllItemsPrices2.Value;

  Msg := MakeDefaultMsg(CM_QueryAllAuctionItems, nPage, GroupIndex, btColors, MakeWord(FAuctionAllItemsSortField, Byte(FAuctionAllItemsSortASC)));
  FrmMain.SendSocket(EncodeMessage(Msg) + EncodeBuffer(@ResquestAllAuctionItem, SizeOf(TResquestAllAuctionItem)));
end;

procedure TSerialWindows.OpenDAuctionBroadcastDlg(sText:string; nAuctionID, nShowTime:Integer);
var
  HGEFont:THGEFont;
begin
  FAuctionBroadcastAuctionID := nAuctionID;
  DLblAuctionBroadcastText.Caption := sText;

  FAuctionBroadcastShowTick := MyGetTickCount;
  FAuctionBroadcastShowTime := nShowTime * 1000;
  FAuctionBroadcastRefreshTick := MyGetTickCount;

  HGEFont := TextureFonts.FindFont(DLblAuctionBroadcastText.CaptionColor.Up.Name, DLblAuctionBroadcastText.CaptionColor.Up.Size, DLblAuctionBroadcastText.CaptionColor.Up.Style);
  if HGEFont = nil then
    HGEFont := CurrentFont;

  FAuctionBroadcastTextSize.X := HGEFont.TextWidth(sText);
  FAuctionBroadcastTextSize.Y := HGEFont.TextHeight('|') + 2;

  FAuctionBroadcastShowX := DAuctionBroadcastText.Width;

  DAuctionBroadcastDlg.Visible := True;
  DAuctionBroadcastDlg.BringToFront;
end;

procedure TSerialWindows.CloseDAuctionBroadcastDlg;
begin
  DAuctionBroadcastDlg.Visible := False;

