          BoldTextOut(vtRect.Left + nX + (36 - CurrentFont.TextWidth(sMsg) - 2), vtRect.Top + nY + (32 - g_CurrentFontHeight), sMsg, clSkyBlue);
          // CurrentFont.TextOut(ARect.Left + ((ARect.Right - ARect.Left) - CurrentFont.TextWidth(sMsg) - 2),
           // ARect.Top + ((ARect.Bottom - ARect.Top) - g_CurrentFontHeight), sMsg, clSkyBlue {GetRGB(Item.s.Color)});
        end;
      end;
  end;
end;

procedure TSerialWindows.DEdtAuctionSellItemMoneyTypeSelect(Sender:TObject);
var
  Index, CurrencyType:Integer;
  AcutionPrices:PTAcutionItemPricesLime;
begin
  if DEdtAuctionSellItemMoneyType.Items.Count > 0 then begin
    DLblAuctionSellMoneyType2.Caption := DEdtAuctionSellItemMoneyType.Text;

    CurrencyType := Integer(DEdtAuctionSellItemMoneyType.Items.Objects[DEdtAuctionSellItemMoneyType.ItemIndex]);
    Index := g_EnabledAuctionItemList.IndexOf(g_AuctionDlgItem.s.DBName);
