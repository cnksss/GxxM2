      D := DButtonCurrentWeight.ImageIndex.Image.Images[DButtonCurrentWeight.ImageIndex.Up];
      if D <> nil then begin
        nWidth := Min(D.Width, Round(D.Width * (Abil.Weight / Abil.MaxWeight)));
