procedure TSerialWindows.SetSubAccountList(nPage:Integer);
const
    nSaItemCountPerPage = 3;
var
    i, nSACount, nCurPageCount, nStartIdx:Integer;
    nPageCount:Integer;
    arrCtrlList:array[0..nSaItemCountPerPage-1] of TDxLabel;
begin
    if nPage >= 0 then begin
        arrCtrlList[0] := DUcSubAccountItemLabel1;
        arrCtrlList[1] := DUcSubAccountItemLabel2;
        arrCtrlList[2] := DUcSubAccountItemLabel3;
        g_UserCenterManager.Lock();
        try
            nSACount := g_UserCenterManager.SACount;
            nPageCount := (nSACount + 2) div nSaItemCountPerPage;
            if (nSACount > 0) and( nPage < nPageCount )then begin
                nStartIdx := nPage * nSaItemCountPerPage;
                nCurPageCount := (nSACount - nStartIdx);
                if nCurPageCount > nSaItemCountPerPage then nCurPageCount := nSaItemCountPerPage;
                for i := 0 to nCurPageCount - 1 do begin
                    arrCtrlList[i].Caption := g_UserCenterManager.SubAccountString[nStartIdx + i];
                    if (nStartIdx + i) = g_UserCenterManager.SubAccountSelected then begin
                        arrCtrlList[i].CaptionColor.Up.Color := clLime;
                    end else begin
                        arrCtrlList[i].CaptionColor.Up.Color := clWhite;
                    end;
                end;
                DUcPageNoLabel.Tag := nPage;
                DUcPageNoLabel.Caption := Format('第 %d 页', [nPage + 1]);
            end;
        finally
            g_UserCenterManager.Unlock();
        end;
    end;
end;

