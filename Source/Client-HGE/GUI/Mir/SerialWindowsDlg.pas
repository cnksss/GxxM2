procedure TSerialWindows.DGJPointsMapMouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  d:TTexture;
  vtRect:TRect;
  nX, nY:Integer;
  GJPoint, ReadPoint:LongInt;
  Index:Integer;
begin
  if Button = mbRight then begin
    g_AutoGJPoints.Clear;
  end else if Button = mbLeft then begin
    if g_MySelf = nil then
      Exit;

    if (g_nMiniMapIndex < 0) then begin
      Exit;
    end;

    case g_nMiniMapIndex of
      9900..9999:
        d := g_WBmpMapImages.Images[g_nMiniMapIndex - 9900]; // 预留
      // mmap10.wil从10001-15000开始
      10000..14999:
        d := g_WMMapImages10.Images[g_nMiniMapIndex - 10000];

      // mmap11.wil从15001-20000开始
      15000..19999:
        d := g_WMMapImages11.Images[g_nMiniMapIndex - 15000];

      // mmap12.wil从20001-24999开始
      20000..24999:
        d := g_WMMapImages12.Images[g_nMiniMapIndex - 20000];
      else
        d := g_WMMapImages.Images[g_nMiniMapIndex];
    end;
    if (d = nil) then Exit; //判断小地图是否存在

    vtRect := DGJPointsMap.VirtualRect;

    nX := Round((X - vtRect.Left) * d.Width / DGJPointsMap.Width);
    nY := Round((Y - vtRect.Top) * d.Height / DGJPointsMap.Height);
    MapXYToActorXY(nX, nY, nX, nY);

    if LegendMap.StartFind then
      LegendMap.Stop;

    GJPoint := MakeLong(nX, nY);
    Index := g_AutoGJPoints.IndexOf(Pointer(GJPoint));

    if (abs(g_MySelf.m_nCurrX - nX) <= 1) and (abs(g_MySelf.m_nCurrY - nY) <= 1) then begin
      if Index < 0 then begin
        g_AutoGJPoints.Add(Pointer(GJPoint));
      end;
    end else begin
      if Index < 0 then begin
        if g_AutoGJPoints.Count > 0 then begin
          ReadPoint := LongInt(g_AutoGJPoints.Items[g_AutoGJPoints.Count - 1]);
          LegendMap.BeginX := LoWord(ReadPoint);
          LegendMap.BeginY := HiWord(ReadPoint);
        end else begin
          LegendMap.BeginX := g_MySelf.m_nCurrX;
          LegendMap.BeginY := g_MySelf.m_nCurrY;
        end;

        LegendMap.EndX := nX;
        LegendMap.EndY := nY;
        LegendMap.FindPath(LegendMap.BeginX, LegendMap.BeginY, LegendMap.EndX, LegendMap.EndY, 0, True);
        if Length(LegendMap.RunPath) <= 0 then begin
          DScreen.AddChatBoardString(Format('自动移动坐标点(%d:%d)不可到达', [LegendMap.EndX, LegendMap.EndY]), GetRGB(154), clWhite);
        end else begin
          g_AutoGJPoints.Add(Pointer(GJPoint));
        end;
        LegendMap.Stop;
      end;
    end;
  end;
end;

procedure TSerialWindows.DGJPointsMapDirectPaint(Sender:TObject);
var
  vtRect, PaintRect:TRect;
  nX, nY:Integer;
  nMapX, nMapY:Integer;
  D, D2:TTexture;
  I:Integer;
  GJPoint:LongInt;
  sText:string;

  {$J+}
  //声明静态变量
const
  DrawSelfRect:Boolean = False;
  LastUpdateTime:LongWord = 0;
  {$J-}
begin
  if g_MySelf = nil then
    Exit;

  if (g_nMiniMapIndex < 0) then begin
    Exit;
  end;

  // 修复小地图错误 chongchong 2015-01-05
  { TODO -c修正 -ochongchong : 小地图扩展再修改 【2013-4-23】}
  case g_nMiniMapIndex of
    9900..9999:
      D := g_WBmpMapImages.Images[g_nMiniMapIndex - 9900]; // 预留
    // mmap10.wil从10001-15000开始
    10000..14999:
      D := g_WMMapImages10.Images[g_nMiniMapIndex - 10000];

    // mmap11.wil从15001-20000开始
    15000..19999:
      D := g_WMMapImages11.Images[g_nMiniMapIndex - 15000];

    // mmap12.wil从20001-24999开始
    20000..24999:
      D := g_WMMapImages12.Images[g_nMiniMapIndex - 20000];
    else
      D := g_WMMapImages.Images[g_nMiniMapIndex];
  end;
  if (D = nil) then
    Exit;

  vtRect := DGJPointsMap.VirtualRect;
  GameCanvas.StretchDraw(vtRect, D.ClientRect, D, -1);

  // 画自己所在区域 chongchogn 2015-09-05
  if g_clientconfig.dwMinMapFlagFlash < 200 then begin
    if not DrawSelfRect then begin
      DrawSelfRect := True;
    end;
  end
  else if MyGetTickCount - LastUpdateTime >= g_clientconfig.dwMinMapFlagFlash then begin
    DrawSelfRect := not DrawSelfRect;
    LastUpdateTime := MyGetTickCount;
  end;

  if DrawSelfRect then begin
    ActorXYToMapXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nMapX, nMapY);
    MapToScreen(D.Width, vtRect.Right - vtRect.Left, nMapX, nMapX);
    MapToScreen(D.Height, vtRect.Bottom - vtRect.Top, nMapY, nMapY);

    PaintRect := Bounds(vtRect.Left + nMapX - MINMAP_RECT_SIZE2 div 2, vtRect.Top + nMapY - MINMAP_RECT_SIZE2 div 2, MINMAP_RECT_SIZE2, MINMAP_RECT_SIZE2);
    GameCanvas.FillRect(PaintRect, GetRGB(g_ClientConfig.btMinMapColorSelf));
  end;

  // 绘制文字 chongchong 2015-09-05
  if FIsShowGJMapXY then begin
    nMapX := Round((FGJMapPoint.X - vtRect.Left) * D.Width / DGJPointsMap.Width);
    nMapY := Round((FGJMapPoint.Y - vtRect.Top) * D.Height / DGJPointsMap.Height);
    MapXYToActorXY(nMapX, nMapY, nMapX, nMapY);
    sText := DecodeResStr(SGJSetPoint) + IntToStr(nMapX) + ':' + IntToStr(nMapY);

    BoldTextOut(vtRect.Left, vtRect.Bottom - g_CurrentFontHeight - 2, sText, clWhite);
  end
  else begin
    sText := DecodeResStr(SGJSetPoint) + IntToStr(g_MySelf.m_nCurrX) + ':' + IntToStr(g_MySelf.m_nCurrY);
    BoldTextOut(vtRect.Left, vtRect.Bottom - g_CurrentFontHeight - 2, sText, clWhite);
  end;

  // 绘制挂机点 -  chongchong 2015-09-05
  if (g_AutoGJPoints.Count > 0) then begin
    D2 := g_WNewopUIImages.Images[310];
    if D2 <> nil then begin
      for I := 0 to g_AutoGJPoints.Count - 1 do begin
        GJPoint := LongInt(g_AutoGJPoints.Items[I]);
        ActorXYToMapXY(LoWord(GJPoint), HiWord(GJPoint), nMapX, nMapY);
        MapToScreen(D.Width, vtRect.Right - vtRect.Left, nMapX, nMapX);
        MapToScreen(D.Height, vtRect.Bottom - vtRect.Top, nMapY, nMapY);

        nX := vtRect.Left + nMapX;
        nY := vtRect.Top + nMapY - D2.Height;
        GameCanvas.Draw(nX, nY, D2);
      end;
    end;
  end;
end;

