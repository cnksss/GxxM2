procedure TFrmDlg.ShowMouseItemInfo(Actor:TActor; MouseItem:pTClientItem; X, Y:Integer; Secret:Boolean; HintList:TList; ShowTzItemDesc:Byte; DrawUp:Boolean; DrawLeft:Boolean);
var
  I, nX, nY, nWidth, nHeight:Integer;
  HintWindow:THintWindow;
  TzHintWindows:TList;
  TzHintWindow:THintWindow;
begin
  TzHintWindows := nil;
  if MouseItem.s.Name <> '' then begin
    if not (Secret and (MouseItem.S.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75..90]) and (MouseItem.S.Shape in [130, 131, 132])) then begin
      if not g_ClientConfig.boTZSupportRenameItem then
        TzHintWindows := GetTzItemHintWindow(ShowTzItemDesc, Actor.m_btSex, MouseItem.s.DBName)
      else
        TzHintWindows := GetTzItemHintWindow(ShowTzItemDesc, Actor.m_btSex, MouseItem.s.Name);
    end;
    DScreen.ClearHint;

    HintWindow := THintWindow(HintList);
    HintWindow.Show(X, Y, DrawUp, DrawLeft);
    HintWindows.Add(HintWindow);

    if TzHintWindows <> nil then begin
      nHeight := HintWindow.Height;
      nWidth := HintWindow.Width;
      nX := HintWindow.X;
      nY := HintWindow.Y;

      for I := 0 to TzHintWindows.Count - 1 do begin
        TzHintWindow := THintWindow(TzHintWindows.Items[I]);
        TzHintWindow.Show(X, Y, DrawUp, DrawLeft);
        nWidth := nWidth + TzHintWindow.Width;
        nHeight := Max(TzHintWindow.Height, nHeight);
      end;

      if nX + nWidth > SCREENWIDTH then
        nX := SCREENWIDTH - nWidth;

      if nY + nHeight > SCREENHEIGHT then
        nY := SCREENHEIGHT - nHeight;

      if nX < 0 then
        nX := 0;
      if nY < 0 then
        nY := 0;

      HintWindow.X := nX;
      HintWindow.Y := nY;
      Inc(nX, HintWindow.Width);

      for I := 0 to TzHintWindows.Count - 1 do begin
        TzHintWindow := THintWindow(TzHintWindows.Items[I]);
        TzHintWindow.X := nX;
        TzHintWindow.Y := nY;
        Inc(nX, TzHintWindow.Width);
        HintWindows.Add(TzHintWindow);
      end;
      TzHintWindows.Free;
    end;
  end
  else begin
    DScreen.ClearHint;
    HintWindows.Clear;
  end;
end;
