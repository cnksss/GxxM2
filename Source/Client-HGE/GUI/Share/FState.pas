procedure TFrmDlg.DMerchantDlgClick(Sender:TObject; X, Y:Integer);
var
  sPostText:string;
  NpcButtonClickTime:LongWord;
  FocuseCtrl:TDxControl;
  PlugData:TAntiPlugNotifyEventNpcDlgCmdData;
begin
  if not (Sender is TCountDownLabel) then begin
    if MyGetTickCount < LastestClickTime then
      Exit;
  end;

  // 添加NPC按钮点击间隔控制 chongchong 2013-11-09
  NpcButtonClickTime := g_ClientConfig.dwNpcButtonClickTime;

  if Sender is TNpcLabel then begin
    PlaySound(s_glass_button_click);
    if CompareText(TNpcLabel(Sender).m_sCmd, '@EXIT') = 0 then begin
      CloseMDlg;
    end
    else begin
      if not GetPostTextLabel(TNpcLabel(Sender), sPostText, FocuseCtrl) then begin
        if Length(sPostText) > 0 then begin
          FrmDlg.DMessageDlg(sPostText, [mbOk]);
        end;

        if FocuseCtrl <> nil then
          FocuseCtrl.SetFocus;
        Exit;
      end
      else begin
        if Assigned(g_AntiPlugNotifyFunc) then begin
          PlugData.nX := X;
          PlugData.nY := Y;
          FillChar(PlugData.Command[0], SizeOf(PlugData.Command), 0);

          if Length(TNpcLabel(Sender).m_sCmd) > 0 then
            Move(TNpcLabel(Sender).m_sCmd[1], PlugData.Command[0], Length(TNpcLabel(Sender).m_sCmd));

          g_AntiPlugNotifyFunc(event_NpcDlgCmd_Click, @PlugData, SizeOf(PlugData));
        end;

        frmMain.SendMerchantDlgSelect(g_nCurMerchant, TNpcLabel(Sender).m_sCmd + sPostText);
      end;
    end;
    LastestClickTime := MyGetTickCount + NpcButtonClickTime;
  end
  else if Sender is TNpcButton then begin
    PlaySound(s_glass_button_click);
    if CompareText(TNpcButton(Sender).m_sCmd, '@EXIT') = 0 then begin
      CloseMDlg;
    end
    else begin
      if not GetPostTextButton(TNpcButton(Sender), sPostText, FocuseCtrl) then begin
        if Length(sPostText) > 0 then begin
          FrmDlg.DMessageDlg(sPostText, [mbOk]);
        end;

        if FocuseCtrl <> nil then
          FocuseCtrl.SetFocus;
        Exit;
      end
      else begin
        if Assigned(g_AntiPlugNotifyFunc) then begin
          PlugData.nX := X;
          PlugData.nY := Y;
          FillChar(PlugData.Command[0], SizeOf(PlugData.Command), 0);

          if Length(TNpcButton(Sender).m_sCmd) > 0 then
            Move(TNpcButton(Sender).m_sCmd[1], PlugData.Command[0], Length(TNpcButton(Sender).m_sCmd));

          g_AntiPlugNotifyFunc(event_NpcDlgCmd_Click, @PlugData, SizeOf(PlugData));
        end;

