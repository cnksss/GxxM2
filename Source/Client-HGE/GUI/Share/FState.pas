procedure TImgCountDownButton.Paint;
var
  S:string;
  Texture:TTexture;
  I, Index, PX, PY:Integer;
  R:TRect;
  C:Char;
begin
  R := Owner.VisibleRect;

  if Owner.Left < 0 then
    R.Left := R.Left + Owner.Left;
  if Owner.Top < 0 then
    R.Top := R.Top + Owner.Top;

  PX := R.Left + Left;
  PY := R.Top + Top;

  S := Caption;

  if (g_WNewopUIImages = nil) or (Length(S) = 0) then
    Exit;

  if (m_ImgStartIndex < 0) then
    Exit;

  for I := 1 to Length(S) do begin
    C := S[I];
    if C in ['0'..'9'] then
      Index := m_ImgStartIndex + StrToInt(C)
    else if C = ':' then
      Index := m_ImgStartIndex + 10
    else
      Index := -1;

    if Index >= 0 then begin
      Texture := g_WNewopUIImages.Images[Index];
      if Texture <> nil then begin
        GameCanvas.Draw(PX, PY + (Height - Texture.Height) div 2, Texture);
        PX := PX + Texture.Width + m_ImgSpace;
      end;
    end;
  end;
end;

procedure TFrmDlg.LoadJsonControl(DOwner:TDxControl; aJson:ISuperObject);
type
  TNpcType = (t_None, t_Label, t_CoolDownLabel, t_ImgCoolDown, t_Button, t_ItemButton, t_UserItemButton, t_ItemBox, t_InputEdit, t_ProgressBox, t_ScrollBox, t_CheckBox);

  function GetImage(a:ISuperObject; Name:string):TGameImages;
  var
    n:Integer;
  begin
    Result := nil;
    n := JsonLoad(-1, a, 'wil');
    if n <> -1 then
      Result := TGameImages(g_EffectImageList.Objects[n]);
  end;

  function CreateControl(nTag:TNpcType; baba:TDxControl):TDxControl;
  var
    //TreeNode, ChildTreeNode: TTreeNode;
    DxControl:TDxControl;
    AOwner:TDxControl;
    //PageControl: TDxPageControl;
    //TabSheet: TDxTabSheet;
    SelectGui:TNpcType;
    vtRect:TRect;
  begin
    Result := nil; //HZQ 20250525
    SelectGui := nTag;
    if (SelectGui <> t_None) then begin
      AOwner := baba;
      if (AOwner = nil) or (AOwner is TDxImageButton) or (AOwner is TDxEdit) or (AOwner is TDxImageEdit)
        or (AOwner is TDxLabel) or (AOwner is TDxPopupMenu) or (AOwner is TDxComboBox) {or (AOwner is TDxImageGrid)} then begin
        Exit;
      end;
      if AOwner <> nil then begin
        DxControl := nil;
        case SelectGui of
          t_Label:begin
              DxControl := TNpcLabel.Create(AOwner);
              DxControl.Caption := '请输入文字';
            end;
          t_CoolDownLabel:
            DxControl := TCountDownLabel.Create(AOwner);
          t_ImgCoolDown:
            DxControl := TImgCountDownButton.Create(AOwner);
          t_Button:
            DxControl := TNpcButton.Create(AOwner);
          t_ItemButton:
            DxControl := TNpcItemButton.Create(AOwner);
          t_UserItemButton:
            DxControl := TNpcUserItemButton.Create(AOwner);
          t_ItemBox:
            DxControl := TNpcItemBoxButton.Create(AOwner);
          t_InputEdit:
            DxControl := TNpcInputEdit.Create(AOwner);
          t_ProgressBox:
            DxControl := TNpcProgressBoxButton.Create(AOwner);
          t_ScrollBox:
            DxControl := TNpcScrollBox.Create(AOwner);
          t_CheckBox:
            DxControl := TNpcButton.Create(AOwner);
        end;

        if DxControl <> nil then begin
          DxControl.Designing := False;
          DxControl.OnClick := DMerchantDlgClick;
          vtRect := AOwner.VirtualRect;
          DxControl.Left := g_nMouseX - vtRect.Left;
          DxControl.Top := g_nMouseY - vtRect.Top;
          Result := DxControl;
        end;
      end;
    end;
  end;

  procedure LoadDxFont(ff:ISuperObject; Font:TDxFont);
  begin
    Font.Name := JsonLoad(Font.Name, ff, 'name');
    Font.Color := JsonLoad(Font.Size, ff, 'color');
    Font.BColor := JsonLoad(Font.Size, ff, 'bcolor');
    Font.Size := JsonLoad(Font.Size, ff, 'size');
    Font.Bold := JsonLoad(Font.Bold, ff, 'bold');

    if JsonLoad(fsBold in Font.Style, ff, 'fsbold') then
      Font.Style := Font.Style + [fsBold];

    if JsonLoad(fsUnderline in Font.Style, ff, 'fsunderline') then
      Font.Style := Font.Style + [fsUnderline];

    if JsonLoad(fsItalic in Font.Style, ff, 'fsitalic') then
      Font.Style := Font.Style + [fsItalic];

    if JsonLoad(fsStrikeOut in Font.Style, ff, 'fsstrikeOut') then
      Font.Style := Font.Style + [fsStrikeOut];
  end;

  procedure LoadButtonAnimation(a:ISuperObject; Ani:TButtonAnimation);
  begin
    Ani.Image := TGameImages(GetImage(a, 'wil'));

    Ani.StartIndex := JsonLoad(Ani.StartIndex, a, 'start');
    Ani.EndIndex := JsonLoad(Ani.EndIndex, a, 'end');
    Ani.FrameTime := JsonLoad(Ani.FrameTime, a, 'time');
    Ani.PlayCount := JsonLoad(Ani.PlayCount, a, 'count');
    Ani.OffsetX := JsonLoad(Ani.OffsetX, a, 'x');
    Ani.OffsetY := JsonLoad(Ani.OffsetY, a, 'y');
    Ani.UseImageOffset := JsonLoad(Ani.UseImageOffset, a, 'useoffset');
    Ani.OutsideAreaDraw := JsonLoad(Ani.OutsideAreaDraw, a, 'outside');
    Ani.Draw := JsonLoad(Ani.Draw, a, 'draw');
    Ani.BlendDraw := JsonLoad(Ani.BlendDraw, a, 'blend');
    Ani.DrawBeforeDef := JsonLoad(Ani.DrawBeforeDef, a, 'befor');
  end;

  procedure LoadArrayControl(list:TSuperArray; baba:TDxControl);
  var
    I:Integer;
    aa:ISuperObject;
    ctype:TNpcType;
    D:TDxControl;
  begin
    for I := 0 to list.Length - 1 do begin
      aa := list.N[I];
      ctype := TNpcType(aa.I['type']);
      if ctype = t_None then
        Exit;

      D := CreateControl(ctype, baba);

      D.Left := JsonLoad(D.Left, aa, 'x');
      D.Top := JsonLoad(D.Top, aa, 'y');
      D.Width := JsonLoad(D.Width, aa, 'w');
      D.Height := JsonLoad(D.Height, aa, 'h');
      case ctype of
        t_Label:begin
            D.Caption := StringReplace(JsonLoad('', aa, 'text'), '\', #13#10, [rfReplaceAll]);
            if aa.N['cfont'] <> nil then
              LoadDxFont(aa.N['cfont'], TNpcLabel(D).CaptionColor.Up);
            if aa.N['mfont'] <> nil then
              LoadDxFont(aa.N['mfont'], TNpcLabel(D).CaptionColor.Hot);
            if aa.N['dfont'] <> nil then
              LoadDxFont(aa.N['dfont'], TNpcLabel(D).CaptionColor.Down);
            TNpcLabel(D).m_sCmd := JsonLoad(TNpcLabel(D).m_sCmd, aa, 'cmd');
          end;
        t_CoolDownLabel:begin

          end;
        t_Button:begin
            D.Caption := StringReplace(JsonLoad('', aa, 'text'), '\', #13#10, [rfReplaceAll]);
            TNpcButton(D).ImageIndex.Image := GetImage(aa, 'wil');
            TNpcButton(D).ImageIndex.Up := JsonLoad(TNpcButton(D).ImageIndex.Up, aa, 'up');
            TNpcButton(D).ImageIndex.Hot := JsonLoad(TNpcButton(D).ImageIndex.Hot, aa, 'hot');
            TNpcButton(D).ImageIndex.Down := JsonLoad(TNpcButton(D).ImageIndex.Down, aa, 'down');
            TNpcButton(D).m_sCmd := JsonLoad(TNpcButton(D).m_sCmd, aa, 'cmd');
            if aa.N['ani'] <> nil then
              LoadButtonAnimation(aa.N['ani'], TNpcButton(D).Animation);
          end;
      end;
      if aa.A['child'] <> nil then
        LoadArrayControl(aa.A['child'], D);
    end;
  end;

  //var
  //  I: Integer;
begin
  ClearMerchantSay(DOwner);
  LoadArrayControl(aJson.A['list'], DOwner);
end;

