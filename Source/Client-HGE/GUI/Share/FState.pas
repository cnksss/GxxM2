  idx:Integer;
  temp:TClientItem;
  DGameGoldDealGrid:TDxImageGrid;
  sGold:string;
begin
  if not g_boGameGoldDealing then begin
    DGameGoldDealGrid := TDxImageGrid(Sender);
    idx := ACol + ARow * DGameGoldDealGrid.ColCount;
    if idx in [0..9] then begin
      if idx = 9 then begin
        case g_btChallengeGoldIndex of
          0:
            sGold := g_sGameDiamondName;
          1:
            sGold := g_sGameGoldName;
          2:
            sGold := g_sGameGirdName;
        end;

        DMessageDlg(Format('请输入%s数量，在0-9999之间', [{g_sGameDiamondName} sGold]), [mbOk, mbAbort]);
        g_nDealGameDiamond := StrToIntDef(Trim(DlgEditText), 0);
      end
      else begin
        if not g_boItemMoving then begin
          if g_GameGoldDealItems[idx].S.Name <> '' then begin
            g_dwMoveItemTick := MyGetTickCount;
            g_boItemMoving := True;
            g_MovingItem.Index := idx;
            g_MovingItem.Item := g_GameGoldDealItems[idx];
            g_MovingItem.ItemType := mtGameGoldDeal;
            g_GameGoldDealItems[idx].S.Name := '';
            ItemClickSound(g_GameGoldDealItems[idx].S);
          end;
        end
        else begin
          if g_MovingItem.ItemType in [mtBagItem, mtGameGoldDeal] then begin
            if g_GameGoldDealItems[idx].S.Name <> '' then begin
              temp := g_GameGoldDealItems[idx];
              g_GameGoldDealItems[idx] := g_MovingItem.Item;
              g_MovingItem.Index := idx;
              g_MovingItem.Item := temp;
            end
            else begin
              g_GameGoldDealItems[idx] := g_MovingItem.Item;
              g_MovingItem.Item.S.Name := '';
              g_boItemMoving := False;
            end;
          end;
        end;
      end;
    end;
    ArrangeItembag;
  end;
end;

