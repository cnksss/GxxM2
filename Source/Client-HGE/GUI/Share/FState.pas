procedure TFrmDlg.UserState1DirectPaint(Sender:TObject);
var
  I, bbx, bby, nIdx, ax, ay, hair:Integer;
  d:TTexture;
  ItemName, sLine1, sLine2, sLine3:string;
  n, nLeft, nTop, nY:Integer;
  IsUseableLine2, IsUseableLine3:Boolean;
  vtRect:TRect;
  vbRect:TRect;
  ItemDesc:TStringList;
  IsShowHelmet, IsShowHair:Boolean;
begin
  // 修正调整UI时，背景与发型对不上 chongchong 2014-11-06

  with Sender as TDxControl do begin
    vbRect := VisibleRect;
    if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
      Exit;
    vtRect := VirtualRect;
    hair := pTHumFeature(@g_UserState1.Feature.Buffer).btHair;
    // sex := DRESSfeature(UserState1.feature) mod 2;
    // hair := HAIRfeature(UserState1.feature); //?
    // hair := (hair - sex) div 2;
    // if sex = 1 then pgidx := 30 //377 Mars 修改
    // else pgidx := 29; //376 Mars 修改
    // 修正调整UI时，背景与发型对不上 chongchong 2014-11-06
    //bbx := vtRect.Left + 38;
    //bby := vtRect.Top + 52;

    bbx := vtRect.Left + 0;
    bby := vtRect.Top + 0;

    bbx := bbx - 7 + g_ConfigClient.nOtherUserHairOffsetX2;
    bby := bby + 44 + g_ConfigClient.nOtherUserHairOffsetY2;
    {
    d := g_WUI2Images.Images[pgidx];

    if d <> nil then
      dsurface.Draw(bbx, bby, d.ClientRect, d, False);
    }
    // bbx := bbx - 9;
    // bby := bby + 44;

    IsShowHair := True;
    if g_UserState1.UseItems[U_DRESS].S.Name <> '' then begin
      // 个位用来表示是否显示发型，Expand5 div 10用来表示使提示框文字使用哪个图片作为背景 2019-12-15 10:05:20
      IsShowHair := g_UserState1.UseItems[U_DRESS].S.Expand5 mod 10 = 0;
    end;

    if IsShowHair then begin
      if hair < 4 then begin
        nIdx := 440 + hair;
        // if sex = 1 then idx := 480 + hair div 2;
        if nIdx > 0 then begin
          d := g_WMainImages.GetCachedImage(nIdx, ax, ay);
          if d <> nil then
            GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
        end;
      end
      else if (hair >= 50) and (hair <= 69) then begin
        nIdx := 350 + hair;
        d := g_WNewopUIImages.GetCachedImage(nIdx, ax, ay);
        if d <> nil then
          GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
      end;
    end;

    if g_UserState1.UseItems[U_DRESS].S.Name <> '' then begin
      DrawBodyItemEffect(bbx, bby, @g_UserState1.UseItems[U_DRESS].S, @g_UseItemsEffect1[U_DRESS], True);
      nIdx := g_UserState1.UseItems[U_DRESS].S.looks;
      if nIdx >= 0 then begin
        d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
        if d <> nil then
          GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
      end;
      DrawBodyItemEffect(bbx, bby, @g_UserState1.UseItems[U_DRESS].S, @g_UseItemsEffect1[U_DRESS], False);
    end;

    if g_UserState1.UseItems[U_WEAPON].S.Name <> '' then begin
      DrawBodyItemEffect(bbx, bby, @g_UserState1.UseItems[U_WEAPON].S, @g_UseItemsEffect1[U_WEAPON], True);
      nIdx := g_UserState1.UseItems[U_WEAPON].S.looks;
      if nIdx >= 0 then begin
        d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
        if d <> nil then
          GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
      end;
      DrawBodyItemEffect(bbx, bby, @g_UserState1.UseItems[U_WEAPON].S, @g_UseItemsEffect1[U_WEAPON], False);
    end;

    IsShowHelmet := True;
    if g_UserState1.UseItems[U_HELMET].S.Name <> '' then begin
      nIdx := g_UserState1.UseItems[U_HELMET].S.looks;
      if (g_UserState1.UseItems[U_HELMET].S.StdMode = 15) then begin
        if (g_UserState1.UseItems[U_HAT].S.Name <> '') and (g_UserState1.UseItems[U_HAT].S.StdMode = 16) and (g_UserState1.UseItems[U_HAT].S.Shape <> 1000) {1000 为面巾，面巾和头盔可同时显示} then
          IsShowHelmet := False;
      end;

      if (nIdx >= 0) and IsShowHelmet then begin
        d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
        if d <> nil then begin
          if g_ClientConfig.boHelmetShowInBox then begin
            ax := DHelmetUS1_.VirtualRect.Left + (DHelmetUS1_.Width - d.Width) div 2;
            ay := DHelmetUS1_.VirtualRect.Top + (DHelmetUS1_.Height - d.Height) div 2;
            GameCanvas.Draw(ax, ay, d.ClientRect, d);
          end
          else begin
            GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
          end;
        end;
      end;

      if IsShowHelmet then
        DrawBodyItemEffect(DHelmetUS1_.VirtualRect, @g_UserState1.UseItems[U_HELMET].S, @g_UseItemsEffect1[U_HELMET], False);
    end;

    if g_UserState1.UseItems[U_HAT].S.Name <> '' then begin
      nIdx := g_UserState1.UseItems[U_HAT].S.looks;
      if nIdx >= 0 then begin
        d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
        if d <> nil then
          GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
      end;
      DrawBodyItemEffect(DHelmetUS1_.VirtualRect, @g_UserState1.UseItems[U_HAT].S, @g_UseItemsEffect1[U_HAT], False);
    end;

    if g_UserState1.UseItems[U_SHIELD].S.Name <> '' then begin
      DrawBodyItemEffect(GetUserStateShieldRect, @g_UserState1.UseItems[U_SHIELD].S, @g_UseItemsEffect1[U_SHIELD], True);
      nIdx := g_UserState1.UseItems[U_SHIELD].S.looks;
      if nIdx >= 0 then begin
        d := g_WStateItemImages.GetCachedImage(nIdx, ax, ay);
        if d <> nil then
          GameCanvas.Draw(bbx + ax, bby + ay, d.ClientRect, d);
      end;
      DrawBodyItemEffect(GetUserStateShieldRect, @g_UserState1.UseItems[U_SHIELD].S, @g_UseItemsEffect1[U_SHIELD], False);
    end;

    if (g_ClientConfig.btSuspensionShowItem = 0) and (g_ClientVersion <= cvSerial) and (g_MouseUserStateItem.S.Name <> '') then begin
      GetMouseItemInfo(g_MySelf, @g_MouseUserStateItem, True, ItemName, sLine1, sLine2, sLine3, IsUseableLine2, IsUseableLine3);
      // (g_ClientConfig.boUseOldSerialWindows) and (g_ClientConfig.boStateWindowsType = 0)
      if (g_ClientVersion = cv176) or (g_ClientConfig.boStateWindowsType = 0) {1.76传统样式显示} then begin
        nLeft := vtRect.Left + 0;
        nTop := vtRect.Top + 220;
      end
      else begin
        nLeft := vtRect.Left + 0;
        nTop := vtRect.Top + 258;
      end;
      if ItemName <> '' then begin
        nY := nTop;
        if sLine2 <> '' then
          nY := nTop + 14;
        if sLine3 <> '' then
          nY := nTop + 14 * 2;

        n := DrawItemHintOldStyle(nLeft, nTop, ItemName, clYellow);
        DrawItemHintOldStyle(nLeft + n, nTop, sLine1);

        if not IsUseableLine2 then
          DrawItemHintOldStyle(nLeft, nTop + 14, sLine2, clRed)
        else
          DrawItemHintOldStyle(nLeft, nTop + 14, sLine2);

        if not IsUseableLine3 then
          DrawItemHintOldStyle(nLeft, nTop + 14 * 2, sLine3, clRed)
        else
          DrawItemHintOldStyle(nLeft, nTop + 14 * 2, sLine3);

        if not g_ClientConfig.boDescSupportRenamItem then
          ItemDesc := GetItemDesc(@g_MouseUserStateItem, g_MouseUserStateItem.S.DBName)
        else begin
          ItemDesc := GetItemDesc(@g_MouseUserStateItem, g_MouseUserStateItem.S.Name);
          if g_ClientConfig.boNoRenameDescReadDefault and ((ItemDesc = nil) or (ItemDesc.Count = 0)) then begin
            ItemDesc := GetItemDesc(@g_MouseUserStateItem, g_MouseUserStateItem.S.DBName)
          end;
        end;

        if (ItemDesc <> nil) and (ItemDesc.Count > 0) then begin
          for I := 0 to ItemDesc.Count - 1 do begin
            CurrentFont.TextOut(nLeft, nY + 14 * (I + 1), ItemDesc.Strings[I], TColor(ItemDesc.Objects[I]));
          end;
        end;
      end;
    end;
  end;
end;

procedure TFrmDlg.WeaponUS1MouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  I, J, K, sel, nX, nY, nWidth, nHeight:Integer;
  vtRect:TRect;
  DrawLeft:Boolean;
  HintWindow:THintWindow;
  HintList:TList;
  TzHintWindows:TList;
  D:TDxControl;
  CtrlRect:TRect;
  HatItem:TClientItem;
  HintLines:THintLines;
  HintText:THintText;
  ArrHintWindows:TArrHintWindows;
begin
  sel := TDxImageButton(Sender).Tag;
  if (sel = U_HELMET) and (g_UserState1.UseItems[U_HELMET].S.Name = '') and (g_UserState1.UseItems[U_HAT].S.Name <> '') then // 优先显示斗笠
    sel := U_HAT;

  if (sel < 0) or (g_UserState1.UseItems[sel].S.Name = '') then begin
    g_MouseUserStateItem.s.Name := '';
    HintWindows.Clear;
    Exit;
  end;

  g_MouseUserStateItem := g_UserState1.UseItems[sel];

  // 免得不停的重新创建提示窗口 chongchong 2015-01-22
  if (g_MouseUserStateItem.MakeIndex <> g_LastHintMakeIndex) then begin
    if (g_ClientConfig.btSuspensionShowItem > 0) or (g_ClientVersion > cvSerial) then begin
      if g_MouseUserStateItem.s.Name <> '' then begin
        HintWindows.Clear;

        D := TDxControl(Sender);

        while True do begin
          if (D.Owner <> nil) and (D.Owner is TDxControlEngine) then
            break;
          D := D.Owner;
        end;

        if g_ClientConfig.boHintWithMouse then begin
          CtrlRect := TDxControl(Sender).VirtualRect;
          vtRect := D.VirtualRect;
          nY := CtrlRect.Bottom;
          nX := CtrlRect.Left;
          DrawLeft := False;
        end
        else begin
          vtRect := D.VirtualRect;
          nY := vtRect.Top + 40; // + 40;

          DrawLeft := vtRect.Right + 160 > SCREENWIDTH;
          if DrawLeft then
            nX := vtRect.Left // + 40
          else
            nX := vtRect.Right;
        end;

        //nX := vtRect.Left;
        //nY := vtRect.Top + 40;

        HintWindows.Clear;
        HintList := TList.Create;

        // 两列显示 piaoyun 2013-09-16
        if not g_ClientConfig.boSingleHint then begin
          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            ArrHintWindows[I] := THintWindow.Create;
          end;

          GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_MouseUserStateItem, nX, nY, False, False, DrawLeft);

          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            HintWindow := THintWindow(ArrHintWindows[I]);
            if HintWindow.Count > 0 then begin
              HintList.Add(HintWindow);
              HintWindow.Show(0, 0);
            end
            else
              HintWindow.Free;
          end;

          if not g_ClientConfig.boTZSupportRenameItem then
            TzHintWindows := GetTzItemHintWindow(2, pTHumFeature(@g_UserState1.Feature.Buffer).btGender, g_MouseUserStateItem.s.DBName)
          else
            TzHintWindows := GetTzItemHintWindow(2, pTHumFeature(@g_UserState1.Feature.Buffer).btGender, g_MouseUserStateItem.s.Name);

          if TzHintWindows <> nil then begin
            for I := 0 to TzHintWindows.Count - 1 do begin
              THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
              HintList.Add(TzHintWindows.Items[I]);
            end;
            TzHintWindows.Free;
          end;

          if (sel = U_HELMET) and (g_UserState1.UseItems[U_HAT].S.Name <> '') then begin
            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              ArrHintWindows[I] := THintWindow.Create;
            end;

            GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_UserState1.UseItems[U_HAT], nX, nY, False, False, DrawLeft);

            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              HintWindow := THintWindow(ArrHintWindows[I]);
              if HintWindow.Count > 0 then begin
                HintList.Add(HintWindow);
                HintWindow.Show(0, 0);
              end
              else
                HintWindow.Free;
            end;

            if not g_ClientConfig.boTZSupportRenameItem then
              TzHintWindows := GetTzItemHintWindow(2, pTHumFeature(@g_UserState1.Feature.Buffer).btGender, g_UserState1.UseItems[U_HAT].S.DBName)
            else
              TzHintWindows := GetTzItemHintWindow(2, pTHumFeature(@g_UserState1.Feature.Buffer).btGender, g_UserState1.UseItems[U_HAT].S.Name);

            if TzHintWindows <> nil then begin
              for I := 0 to TzHintWindows.Count - 1 do begin
                THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
                HintList.Add(TzHintWindows.Items[I]);
              end;
              TzHintWindows.Free;
            end;
          end;
        end
        else begin
          // 单列显示 piaoyun 2013-09-16
          TzHintWindows := GetTzItemHintWindowEx(2, pTHumFeature(@g_UserState1.Feature.Buffer).btGender, g_MySelf, @g_MouseUserStateItem, False);
          if TzHintWindows <> nil then begin
            for I := 0 to TzHintWindows.Count - 1 do begin
              THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
              HintList.Add(TzHintWindows.Items[I]);
            end;
            TzHintWindows.Free;
          end
          else begin
            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              ArrHintWindows[I] := THintWindow.Create;
            end;

            GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_MouseUserStateItem, nX, nY, False, False, DrawLeft);

            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              HintWindow := THintWindow(ArrHintWindows[I]);
              if HintWindow.Count > 0 then begin
                HintList.Add(HintWindow);
                HintWindow.Show(0, 0);
