          else
            line3 := sTemp;
        end;

        // 魔法躲避
        if MouseItem.S.MC2 > 0 then begin
          sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httMagicAvoid].Text, '<$v>', IntToStr(MouseItem.S.MC2), [rfIgnoreCase]);
          if line3 <> '' then
            line3 := line3 + ONE_SPACE + sTemp
          else
            line3 := sTemp;
        end;

        // 体力恢复
        if MouseItem.S.SC1 > 0 then begin
          sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httHealthRecover].Text, '<$v>', IntToStr(MouseItem.S.SC1), [rfIgnoreCase]);
          if line3 <> '' then
            line3 := line3 + ONE_SPACE + sTemp
          else
            line3 := sTemp;
        end;

        // 加负重
        if MouseItem.S.DuraMax > 0 then begin
          sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httBurden].Text, '<$v>', IntToStr(MouseItem.S.DuraMax), [rfIgnoreCase]);
          if line3 <> '' then
            line3 := line3 + ONE_SPACE + sTemp
          else
            line3 := sTemp;
        end;

        // 加背包重量
        if MouseItem.S.Overlap > 0 then begin
          sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httBagWeight].Text, '<$v>', IntToStr(MouseItem.S.Overlap), [rfIgnoreCase]);
          if line3 <> '' then
            line3 := line3 + ONE_SPACE + sTemp
          else
            line3 := sTemp;
        end;
      end;
    94:begin
        sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httWeight].Text, '<$v>', IntToStr(MouseItem.S.Weight), [rfIgnoreCase]);
        line1 := sTemp;

        sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httCount].Text, '<$v>', GetMagicItemDuraStr(MouseItem.Dura, MouseItem.DuraMax), [rfIgnoreCase]);
        line2 := sTemp;
      end;
    95:begin
        sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httWeight].Text, '<$v>', IntToStr(MouseItem.S.Weight), [rfIgnoreCase]);
        line1 := sTemp;

        sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httUseCount].Text, '<$v>', GetDuraStr(MouseItem.Dura, MouseItem.DuraMax), [rfIgnoreCase]);
        line2 := sTemp;
      end;
    96: {// 祝福罐，泉水罐} begin
        sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httWeight].Text, '<$v>', IntToStr(MouseItem.S.Weight), [rfIgnoreCase]);
        line1 := sTemp;

        sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httCapacity].Text, '<$v>', GetDuraStr(MouseItem.Dura, MouseItem.DuraMax), [rfIgnoreCase]);
        line2 := sTemp;
      end;
    97:begin
        sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httWeight].Text, '<$v>', IntToStr(MouseItem.S.Weight), [rfIgnoreCase]);
        line1 := sTemp;

        sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httCapacity].Text, '<$v>', IntToStr(MouseItem.Dura), [rfIgnoreCase]);
        line2 := sTemp;
      end;
    else begin
        sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httWeight].Text, '<$v>', IntToStr(MouseItem.S.Weight), [rfIgnoreCase]);
        if line1 <> '' then
          line1 := line1 + ONE_SPACE + sTemp
        else
          line1 := sTemp;
      end;
  end;

  if MouseItem.S.Need in [101, 102, 103] then begin
    sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httLimitedItem].Text, '<$v>', IntToStr(MouseItem.S.NeedLevel), [rfIgnoreCase]);
    if line3 <> '' then
      line3 := line3 + ONE_SPACE + sTemp
    else
      line3 := sTemp;
  end
  else if MouseItem.s.Need = 104 then begin
    sTemp := StringReplace(g_ConfigClient.ItemHintTextConfig[httLimitedItemTimeOut].Text, '<$v>', GetIncMinuteTime(MouseItem.ItemFrom.DateTime, MouseItem.S.NeedLevel), [rfIgnoreCase]);
    if line3 <> '' then
      line3 := line3 + ONE_SPACE + sTemp
    else
      line3 := sTemp;
  end;

  BoNoDisplayMaxDura := False;
end;

procedure TFrmDlg.DItemGridGridMouseMove(Sender:TObject; ACol, ARow:Integer; Shift:TShiftState);
var
  nIdx, nShowX, nShowY:Integer;
  vtRect:TRect;
  DItemGrid:TDxImageGrid;
  S:string;
begin
  if ssRight in Shift then begin
    if g_boItemMoving then
      DItemGridGridSelect(Self, ACol, ARow, mbLeft, Shift);
  end else begin
    DItemGrid := TDxImageGrid(Sender);
    nIdx := ACol + ARow * DItemGrid.ColCount + 6;
    nIdx := nIdx + FCurrentBagPage * DItemGrid.ColCount * DItemGrid.RowCount; // MAX_EXT_ONE_PAGE_ITEM_COUNT

    if (nIdx in [6..GetMaxBagCount - 1]) and (g_ItemArr[nIdx].S.Name <> '') then begin
      g_MouseItem := g_ItemArr[nIdx];
      if (g_ClientConfig.btSuspensionShowItem > 0) or (g_ClientVersion > cvSerial) then begin
        g_boShowBagInfo := False;
        vtRect := DItemGrid.VirtualRect;
        nShowX := vtRect.Left + (ACol + 1) * DItemGrid.ColWidth; //HZQ 20230815, 尽量的偏移物品的位置 原（ACol * DItemGrid.ColWidth)
        nShowY := vtRect.Top + +(ARow + 1) * DItemGrid.RowHeight;
        ShowMouseItemInfo(g_MySelf, @g_MouseItem, nShowX, nShowY, True, 0, False, False, True);
      end else begin
        g_boShowBagInfo := True;
      end;
    end else if (nIdx >= GetMaxBagCount) then begin
      DScreen.ClearHint;
      HintWindows.Clear;
      S := g_ConfigClient.ItemHintTextConfig[httHintDblClickOpenBagGrid].Text;
      if S <> '' then begin
        vtRect := DItemGrid.VirtualRect;
        nShowX := vtRect.Left + ((ACol) * DItemGrid.ColWidth) + (DItemGrid.ColWidth div 2); //HZQ 20230815, 尽量的偏移物品的位置 原（ACol * DItemGrid.ColWidth)
        nShowY := vtRect.Top + +(ARow + 1) * DItemGrid.RowHeight;
        HintWindows.Show(nShowX, nShowY, S, clWhite, False, False);
      end;
    end else begin
      g_boShowBagInfo := False;
      g_MouseItem.S.Name := '';
      DScreen.ClearHint;
      HintWindows.Clear;
    end;
  end;
end;

procedure TFrmDlg.DItemGridGridSelect(Sender:TObject; ACol, ARow:Integer; Button:TMouseButton; Shift:TShiftState);
var
  where, nIdx, nC:Integer;
  temp:TClientItem;
  DItemGrid:TDxImageGrid;
  // bytes: array[0..62 - 1] of Byte;
  flag:Boolean;
  S:string;
  I, WantUseToIndex:Integer;
begin
  DItemGrid := TDxImageGrid(Sender);

  DScreen.ClearHint;
  HintWindows.Clear;
  g_LastHintMakeIndex := 0;

  if g_boItemMoving and (g_MovingItem.ItemType = mtHeroM2ShopItem) then begin
    // 摆摊中可删物品 2019-06-05 16:47:57
    if (g_MySelf <> nil) {and (not g_MySelf.m_boShopStall)} then begin
      nIdx := ACol + ARow * DItemGrid.ColCount + 6;
      if nIdx in [6..DItemGrid.ColCount * DItemGrid.RowCount + 6 - 1] then begin
        g_HeroM2ShopWaiting := g_MovingItem.Item;
        g_boItemMoving := False;
        g_MovingItem.Item.S.Name := '';
        g_MovingItem.ItemType := mtBagItem;
        frmMain.SendClientMessage(CM_HEROM2DELUSERSHOPITEM, g_HeroM2ShopWaiting.MakeIndex, 0, 0, 0);
      end;
    end;
    Exit;
  end;

  nIdx := ACol + ARow * DItemGrid.ColCount + 6;
  nIdx := nIdx + FCurrentBagPage * DItemGrid.ColCount * DItemGrid.RowCount; // MAX_EXT_ONE_PAGE_ITEM_COUNT

  if nIdx in [6..Length(g_ItemArr) - 1] then begin
    if mbRight = Button then begin
      if nIdx >= GetMaxBagCount then begin
        Exit;
      end;

      if CheckDStorageViewDlgShow(True) and (g_ItemArr[nIdx].S.Name <> '') then begin
        {$IF PRIVATE_CLIENT = 0}
        {.$I VMProtectBegin.inc}
        {$IFEND}
        if (g_SellDlgItemSellWait.s.Name = '') then begin
          g_IsWaitItemToStorage := True;
          g_SellDlgItemSellWait := g_ItemArr[nIdx];
          g_ItemArr[nIdx].S.Name := '';
          FrmMain.SendClientMessage(CM_USERSTORAGEVIEWITEM, FStorageViewDlgMerchant, LoWord(g_SellDlgItemSellWait.MakeIndex), HiWord(g_SellDlgItemSellWait.MakeIndex), FDStorageViewDlgPage * 2 + Integer(True), g_SellDlgItemSellWait.S.Name);
        end;
        {$IF PRIVATE_CLIENT = 0}
        {.$I VMProtectEnd.inc}
        {$IFEND}
      end else if CheckDStorageViewDlgShow(False) and (g_ItemArr[nIdx].S.Name <> '') then begin
        {$IF PRIVATE_CLIENT = 0}
        {.$I VMProtectBegin.inc}
        {$IFEND}
        if (g_SellDlgItemSellWait.s.Name = '') then begin
          g_IsWaitItemToStorage := True;
          g_SellDlgItemSellWait := g_ItemArr[nIdx];
          g_ItemArr[nIdx].S.Name := '';
          FrmMain.SendClientMessage(CM_USERSTORAGEVIEWITEM, FStorageViewDlgMerchant, LoWord(g_SellDlgItemSellWait.MakeIndex), HiWord(g_SellDlgItemSellWait.MakeIndex), FDStorageViewDlgPage * 2 + Integer(False), g_SellDlgItemSellWait.S.Name);
        end;
        {$IF PRIVATE_CLIENT = 0}
        {.$I VMProtectEnd.inc}
        {$IFEND}
      end
      else if CheckDTradingMarketDlgVisible and (g_ItemArr[nIdx].S.Name <> '') then begin

        if (not g_WantSellItems) and (g_WaitSellDlgItem.s.Name = '') then begin
          for I := 0 to Length(g_SellDlgItems) - 1 do begin
            if g_SellDlgItems[I].S.Name = '' then begin
              g_WaitSellDlgItem := g_ItemArr[nIdx];
              frmMain.SendQueryPrice(g_nCurMerchant, g_WaitSellDlgItem.MakeIndex, g_WaitSellDlgItem.S.Name, True, I);
              g_ItemArr[nIdx].S.Name := '';
              Break;
            end;
          end;
        end;
      end // 设置准星光标 宝石镶嵌 chongchong 2015-01-04
      else if (not g_ClientConfig.boDisableRightClickFluteStone) and (g_ItemArr[nIdx].S.StdMode = 46) and (g_ItemArr[nIdx].S.Shape = 3) and (g_ItemArr[nIdx].S.Name <> '') then begin
        g_FluteItem_UseBS := g_ItemArr[nIdx];
        g_boMySelItemCursorFromFluteStone := True;
        g_boMySelItemCursorFromHero := False;
        FrmMain.Cursor := crMySelItem;
      end // 设置锤子光标 取下镶嵌的宝石 chongchong 2015-01-04
      else if (g_ItemArr[nIdx].S.StdMode = 46) and (g_ItemArr[nIdx].S.Shape = 9) and (g_ItemArr[nIdx].S.Name <> '') then begin
        if (g_SendStoneRemove_UseQZ.s.name = '') then begin
          if CheckShowRemoveStoneForm then begin
            g_StoneRemove_UseQZ := g_ItemArr[nIdx];
            FrmMain.Cursor := crSrepair;
          end
          else begin
            FrmDlg.DMessageDlg('请先打开卸下装备宝石窗口再使用.', []);
          end;
        end;
        Exit;
      end // 设置准星光标 宝石镶嵌 chongchong 2015-01-04
      else if (g_ItemArr[nIdx].S.StdMode = 47) and (g_ItemArr[nIdx].S.Shape in [50, 51]) and (g_ItemArr[nIdx].S.Name <> '') then begin
        g_FluteItem_UseBS := g_ItemArr[nIdx];
        g_boMySelItemCursorFromFluteStone := False;
        g_boMySelItemCursorFromHero := False;
        FrmMain.Cursor := crMySelItem;
      end
      else if g_ClientConfig.boBagRightkey then {// 右键穿装备} begin
        FrmMain.Cursor := GetDefaultCursor;
        where := GetTakeOnPosition(g_ItemArr[nIdx].S.StdMode, g_ItemArr[nIdx].S.Shape);
        // DScreen.AddChatBoardString('右键穿装备', clWhite, clRed);
        if (g_WaitingUseItem.Item.s.Name = '') and (g_ItemArr[nIdx].S.Name <> '') then begin
          if ((g_ItemArr[nIdx].S.OverLap = 0) or (g_ItemArr[nIdx].S.OverLap and 1 <> 0)) then begin
            flag := False;

            case where of
              U_DRESS:begin
                  {
                  case g_MySelf.m_btSex of
                    0:
                      begin
                        if g_ItemArr[nIdx].S.StdMode <> 10 then
                        begin
                          //DScreen.AddChatBoardString('非男性用品', clRed, clWhite);
                          Exit;
                        end;
                      end;
                    1:
                      begin
                        if g_ItemArr[nIdx].S.StdMode <> 11 then
                        begin
                          //DScreen.AddChatBoardString('非女性用品', clRed, clWhite);
                          Exit;
                        end;
                      end;
                  end;
                  }

                  flag := True;
                end;
              U_WEAPON:
                flag := True;
              U_NECKLACE:
                flag := True;
              U_RIGHTHAND:
                flag := True;
              U_HELMET:
                flag := True;
              U_RINGR, U_RINGL:
                flag := True;
              U_ARMRINGR, U_ARMRINGL:
                flag := True;

              { 1.76界面下面一排不允许装备 chongchong 2013-09-16 }
              U_BUJUK:begin
                  if g_ClientConfig.boUseOldSerialWindows and (g_ClientConfig.boStateWindowsType = 0) then begin
                    flag := not g_ClientConfig.boDisableDuFuTakeArmRingL;
                    if flag then
                      where := U_ARMRINGL;
                  end
                  else begin
                    flag := True;
                  end;
                end;

              U_BELT:
                flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;
              U_BOOTS:
                flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;
              U_CHARM:
                flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;

              U_HAT:
                flag := True;
              U_DRUM:
                flag := (not g_ClientConfig.boUseOldSerialWindows);

              U_HORSE:begin
                  flag := True;
                  if g_ClientConfig.boUseOldSerialWindows then begin
                    where := U_RIGHTHAND;
                  end;
                end;
              U_SHIELD:
                flag := True; // 盾牌 chongchong 2013-09-16
              U_JADE:
                flag := (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONDRESS:
                flag := (not g_ClientConfig.boUseOldSerialWindows); // 时装衣服 chongchong 2013-10-23
              U_FASHIONWEAPON:
                flag := (not g_ClientConfig.boUseOldSerialWindows); // 时装武器 chongchong 2013-10-23

              U_FASHIONNECKLACE:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONHELMET:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONARMRINGR, U_FASHIONARMRINGL:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONRINGL:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONRIGHTHAND:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONBELT:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONBOOTS:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
              U_FASHIONCHARM:
                flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            end;
            if flag then begin
              if where in [U_RINGR, U_RINGL] then begin
                if (g_UseItems[U_RINGR].S.Name = '') then
                  where := U_RINGR;
                if g_UseItems[U_RINGL].S.Name = '' then
                  where := U_RINGL;
                if (g_UseItems[U_RINGR].S.Name <> '') and (g_UseItems[U_RINGL].S.Name <> '') then begin
                  // 修复右击戴戒指只穿右边，不戴左边 chongchong 2013-11-11
                  if FIsRingLeft then
                    where := U_RINGL
                  else
                    where := U_RINGR;
                  FIsRingLeft := not FIsRingLeft;
                end;
              end;

              if where in [U_ARMRINGR, U_ARMRINGL] then begin
                if g_ItemArr[nIdx].S.StdMode = 25 then
                  where := U_ARMRINGL
                else begin
                  if g_UseItems[U_ARMRINGR].S.Name = '' then
                    where := U_ARMRINGR;
                  if g_UseItems[U_ARMRINGL].S.Name = '' then
                    where := U_ARMRINGL;
                  if (g_UseItems[U_ARMRINGR].S.Name <> '') and (g_UseItems[U_ARMRINGL].S.Name <> '') then begin
                    // 修复右击戴手镯只穿右边，不戴左边 chongchong 2013-11-11
                    if FIsArmRingLeft then
                      where := U_ARMRINGL
                    else
                      where := U_ARMRINGR;
                    FIsArmRingLeft := not FIsArmRingLeft;
                  end;
                end;
              end;

              if where in [U_FASHIONRINGR, U_FASHIONRINGL] then begin
                if (g_UseItems[U_FASHIONRINGR].S.Name = '') then
                  where := U_FASHIONRINGR;
                if g_UseItems[U_FASHIONRINGL].S.Name = '' then
                  where := U_FASHIONRINGL;
                if (g_UseItems[U_FASHIONRINGR].S.Name <> '') and (g_UseItems[U_FASHIONRINGL].S.Name <> '') then begin
                  // 修复双击戴戒指只穿右边，不戴左边 chongchong 2013-11-11
                  if FIsFashionRingLeft then
                    where := U_FASHIONRINGL
                  else
                    where := U_FASHIONRINGR;
                  FIsFashionRingLeft := not FIsFashionRingLeft;
                end;
              end;

              if where in [U_FASHIONARMRINGR, U_FASHIONARMRINGL] then begin
                if g_UseItems[U_FASHIONARMRINGR].S.Name = '' then
                  where := U_FASHIONARMRINGR;
                if g_UseItems[U_FASHIONARMRINGL].S.Name = '' then
                  where := U_FASHIONARMRINGL;
                if (g_UseItems[U_FASHIONARMRINGR].S.Name <> '') and (g_UseItems[U_FASHIONARMRINGL].S.Name <> '') then begin
                  if FIsFashionArmRingLeft then
                    where := U_FASHIONARMRINGL
                  else
                    where := U_FASHIONARMRINGR;
                  FIsFashionArmRingLeft := not FIsFashionArmRingLeft;
                end;
              end;

              g_WaitingUseItem.Index := where;
              g_WaitingUseItem.Item := g_ItemArr[nIdx];
              g_WaitingUseItem.ItemType := mtBagItem;
              g_boItemMoving := False;
              g_ItemArr[nIdx].S.Name := '';
              frmMain.SendTakeOnItem(where, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
              ItemClickSound(g_ItemArr[nIdx].S);
            end;
          end else if (g_MySelf.m_nJewelryBoxStatus = jbsOpen) and (g_ItemArr[nIdx].S.OverLap and 2 <> 0)
            //HZQ 20230525 有个右戒指的笔误修复
          and (where in [U_HELMET {头盔}, U_NECKLACE {项链}, U_ARMRINGL {左手镯}, U_ARMRINGR {右手镯}, U_RINGL {左戒指}, U_RINGR {右戒指}]) then begin
            if (g_ItemArr[nIdx].S.Expand1 = 0) or (g_ItemArr[nIdx].S.Expand1 = 7) then begin
              WantUseToIndex := 0;
              for I := Low(g_JewelryBoxItems) to High(g_JewelryBoxItems) do begin
                if g_JewelryBoxItems[I].S.Name = '' then begin
                  WantUseToIndex := I;
                  Break;
                end;
              end;
            end else if g_ItemArr[nIdx].S.Expand1 in [1..6] then begin
              WantUseToIndex := g_ItemArr[nIdx].S.Expand1 - 1;
            end else begin
              WantUseToIndex := -1; //HZQ 20230525
            end;

            if WantUseToIndex >= 0 then begin //HZQ 20230525 增加一个判断，
              g_WaitingUseItem.Item := g_ItemArr[nIdx];
              g_WaitingUseItem.Index := WantUseToIndex;
              g_ItemArr[nIdx].S.Name := '';
              frmMain.SendTakeOnJewelry(WantUseToIndex, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
            end;
          end else if g_MySelf.m_boShowGodBless and (g_ItemArr[nIdx].S.OverLap and 4 <> 0) then begin
            if g_ItemArr[nIdx].S.Expand1 = 13 then begin
              WantUseToIndex := -1;
              for I := Low(g_GodBlessItems) to High(g_GodBlessItems) do begin
                if (g_GodBlessItems[I].S.Name = '') and (g_GodBlessItemsState[I] = 1) then begin
                  WantUseToIndex := I;
                  Break;
                end;
              end;

              if WantUseToIndex = -1 then begin
                for I := Low(g_GodBlessItems) to High(g_GodBlessItems) do begin
                  if g_GodBlessItemsState[I] = 1 then begin
                    WantUseToIndex := I;
                    Break;
                  end;
                end;
              end;

              if WantUseToIndex >= 0 then begin
                g_WaitingUseItem.Item := g_ItemArr[nIdx];
                g_WaitingUseItem.Index := WantUseToIndex;
                g_ItemArr[nIdx].S.Name := '';
                frmMain.SendTakeOnGodBless(False, WantUseToIndex, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
              end;
            end else if g_ItemArr[nIdx].S.Expand1 in [1..12] then begin
              if (g_GodBlessItemsState[g_ItemArr[nIdx].S.Expand1 - 1] = 1) then begin
                WantUseToIndex := g_ItemArr[nIdx].S.Expand1 - 1;

                g_WaitingUseItem.Item := g_ItemArr[nIdx];
                g_WaitingUseItem.Index := WantUseToIndex;
                g_ItemArr[nIdx].S.Name := '';
                frmMain.SendTakeOnGodBless(False, WantUseToIndex, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
              end;
            end;
          end;
        end;
      end
      else begin
        FrmMain.Cursor := GetDefaultCursor;

        if (not g_boItemMoving) and (g_MyHero <> nil) and (g_ItemArr[nIdx].S.Name <> '') then begin
          // 鼠标右键点击[人物背包]中的物品将该物品放入[英雄背包]中。
          if (g_WaitingUseItem.Item.s.Name = '') then begin
            g_WaitingUseItem.Item := g_ItemArr[nIdx];
            g_WaitingUseItem.ItemType := mtBagItem;
            g_ItemArr[nIdx].S.Name := '';
            g_MovingItem.Item.S.Name := '';
            g_boItemMoving := False;
            frmMain.SendMasterBagToHeroBag(g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.s.Name);
            ItemClickSound(g_ItemArr[nIdx].S);
            Exit;
          end;
        end;
      end;

      Exit;
    end;

    if (not g_boItemMoving) then begin
      if (nIdx >= GetMaxBagCount) then
        Exit;

      // DScreen.AddChatBoardString('请输入要拆分的数量。1', clGreen, clWhite);
      if (ssShift in Shift) and IsUnOverLapItem(@g_ItemArr[nIdx]) then begin
        if g_WaitingUseItem.Item.s.Name = '' then begin
          DMessageDlg('请输入要拆分的数量：', [mbOk, mbAbort]);
          nC := StrToIntDef(Trim(DlgEditText), -1);
          // DScreen.AddChatBoardString('请输入要拆分的数量。1: '+IntToStr(nC)+' DlgEditText:'+DlgEditText+' ClassName:'+Self.ClassName, clGreen, clWhite);
          if nC > 0 then begin
            // DScreen.AddChatBoardString('请输入要拆分的数量。 2:'+IntToStr(nC), clGreen, clWhite);
            g_WaitingUseItem.Index := nIdx;
            g_WaitingUseItem.Item := g_ItemArr[nIdx];
            g_WaitingUseItem.ItemType := mtBagItem;
            g_ItemArr[nIdx].S.Name := '';
            frmMain.SendPackageItem(g_WaitingUseItem.Item.MakeIndex, nC, g_WaitingUseItem.Item.S.Name);
          end;
        end;
        Exit;
      end;

      if g_ItemArr[nIdx].S.Name <> '' then begin
        if (FrmMain.Cursor = crMySelItem) then begin
          if g_boMySelItemCursorFromHero then begin
            g_FluteItem_UseBS.s.Name := '';
            FrmMain.Cursor := GetDefaultCursor;
            Exit;
          end;

          if g_boMySelItemCursorFromFluteStone then begin
            if (not g_ClientConfig.boDisableRightClickFluteStone) then begin
              FrmMain.Cursor := GetDefaultCursor;

              if CheckInlaidGemstone(g_ItemArr[nIdx].S.StdMode) then begin
                if (g_FluteItem_UseBS.s.Name <> '') and (g_FluteItem_UseBS.S.StdMode = 46) and (g_FluteItem_UseBS.S.Shape = 3) then begin
                  {
                  if (g_ClientConfig.nItemFluteStoneCount > 0) and
                    (g_ClientConfig.nItemFluteStoneCount <= GetAnicountFluteCount(@g_ItemArr[nIdx], g_FluteItem_UseBS.s.AniCount)) then
                  begin
                    DMessageDlg(Format('相同属性的宝石镶嵌不能超过%d个', [g_ClientConfig.nItemFluteStoneCount]) , [mbOK]);
                    Exit;
                  end;

                  if (g_ClientConfig.nItemFluteStoneCount > 0) and
                    (g_ClientConfig.nItemFluteStoneCount <= GetIdxFluteCount(@g_ItemArr[nIdx], g_FluteItem_UseBS.s.)) then
                  begin
                    DMessageDlg(Format('相同属性的宝石镶嵌不能超过%d个', [g_ClientConfig.nItemFluteStoneCount]) , [mbOK]);
                    Exit;
                  end;
                  }

                  if g_ItemArr[nIdx].btFluteCount > 0 then begin
                    if (g_ItemArr[nIdx].btFluteCount > 0) then begin
                      FrmMain.SendBagUseItem(g_ItemArr[nIdx].MakeIndex, g_FluteItem_UseBS.MakeIndex, False);
                    end;
                  end;
                end;
              end;

              Exit;
            end;
          end
          else begin
            if (g_FluteItem_UseBS.s.Name <> '') and (g_FluteItem_UseBS.S.StdMode = 47) and (g_FluteItem_UseBS.S.Shape in [50, 51]) then begin
              FrmMain.SendBagUseMode47Item(g_ItemArr[nIdx].MakeIndex, g_FluteItem_UseBS.MakeIndex, False);
            end;
            FrmMain.Cursor := GetDefaultCursor;

            Exit;
          end;
        end;

        if ssCtrl in Shift then begin
          if not DedChat.Enabled then begin
            ShowChatEdit();
          end;
          S := DedChat.Text + Format('{[%s]/%d}', [ProcessItemName(g_ItemArr[nIdx].S.Name), g_ItemArr[nIdx].MakeIndex]);
          if Length(S) <= DedChat.MaxLength then
            DEdChat.Text := S;
          DEdChat.SelStart := Length(DEdChat.Text);
          DEdChat.SelLength := 0;
          DEdChat.SetFocus;
          Exit;
        end;

        g_dwMoveItemTick := MyGetTickCount;
        g_boItemMoving := True;
        g_MovingItem.Index := nIdx;
        g_MovingItem.Item := g_ItemArr[nIdx];
        g_MovingItem.ItemType := mtBagItem;
        g_ItemArr[nIdx].S.Name := '';

        {Move(PByte(@g_ItemArr[nIdx].S.Name)^,bytes,SizeOf(bytes));
       for nIdx:=0 to Length(bytes)-1 do
         DebugOutStr ('bytes'+inttostr(nIdx)+' '+ inttostr(bytes[nIdx]));

        DebugOutStr ('');

       g_ItemArr[nIdx].S.Name := '';
        Move(PByte(@g_ItemArr[nIdx].S.Name)^,bytes,SizeOf(bytes));
       for nIdx:=0 to Length(bytes)-1 do
         DebugOutStr ('bytes'+inttostr(nIdx)+' '+ inttostr(bytes[nIdx]));
                       }
        ItemClickSound(g_ItemArr[nIdx].S);

      end
      else if (FrmMain.Cursor = crMySelItem) and g_boMySelItemCursorFromHero then begin
        g_FluteItem_UseBS.s.Name := '';
        FrmMain.Cursor := GetDefaultCursor;
        Exit;
      end;
    end
    else begin
      if g_MovingItem.ItemType in [mtHeroUseItem, mtBagGold, mtDealGold, mtChallengeGold, mtHeroJewelryItem, mtHeroGodBlessItem] then
        Exit;

      if g_MovingItem.ItemType = mtUseItem then begin
        if g_WaitingUseItem.Item.s.Name = '' then begin
          g_WaitingUseItem := g_MovingItem;
          frmMain.SendTakeOffItem(-(g_MovingItem.Index + 1), g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end
      else if g_MovingItem.ItemType = mtHeroBagItem then begin // 英雄包裹到主人包裹
        if g_WaitingUseItem.Item.s.Name = '' then begin
          g_WaitingUseItem := g_MovingItem;
          frmMain.SendHeroBagToMasterBag(g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end
      else if g_MovingItem.ItemType = mtJewelryItem then begin
        if g_WaitingUseItem.Item.s.Name = '' then begin
          g_WaitingUseItem := g_MovingItem;
          frmMain.SendTakeOffJewelry(g_MovingItem.Index, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end
      else if g_MovingItem.ItemType = mtItemBoxItem then begin
        if g_WaitingUseItem.Item.s.Name = '' then begin
          g_WaitingUseItem := g_MovingItem;
          frmMain.SendMoveItemBoxToBag(g_MovingItem.Index, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end
      else if g_MovingItem.ItemType = mtGodBlessItem then begin
        if g_WaitingUseItem.Item.s.Name = '' then begin
          g_WaitingUseItem := g_MovingItem;
          frmMain.SendTakeOffGodBless(False, g_MovingItem.Index, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end {
        else if g_MovingItem.ItemType = mtHeroGodBlessItem then
        begin
          if g_WaitingUseItem.Item.s.Name = '' then
          begin
            g_WaitingUseItem := g_MovingItem;
            frmMain.SendTakeOffGodBless(True, g_MovingItem.Index,
              g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
            g_MovingItem.Item.S.Name := '';
            g_boItemMoving := False;
          end;
        end
        }
      else if g_MovingItem.ItemType = mtGamePetBagItem then begin // 英雄包裹到主人包裹
        if g_WaitingUseItem.Item.s.Name = '' then begin
          g_WaitingUseItem := g_MovingItem;
          frmMain.SendPetBagItemToBag(g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end
      else if (nIdx < GetMaxBagCount) then begin
        if g_MovingItem.ItemType = mtDealItem then
          DealItemReturnBag(g_MovingItem.Item);

        if g_MovingItem.ItemType = mtChallengeItem then
          DChallengeItemReturnBag(g_MovingItem.Item);

        if g_ItemArr[nIdx].S.Name <> '' then begin
          if (g_MovingItem.ItemType = mtBagItem) and IsOverLapItem(@g_ItemArr[nIdx], @g_MovingItem.Item) then begin // 开始重叠物品
            if g_WaitingUseItem.Item.s.Name = '' then begin
              g_WaitingUseItem := g_MovingItem;
              g_MovingItem.Item.S.Name := '';
              g_boItemMoving := False;
              frmMain.SendOverLapItem(g_WaitingUseItem.Item.MakeIndex, g_ItemArr[nIdx].MakeIndex, g_WaitingUseItem.Item.s.Name);
            end;
          end
          else begin
            temp := g_ItemArr[nIdx];
            g_ItemArr[nIdx] := g_MovingItem.Item;
            g_MovingItem.Index := nIdx;
            g_MovingItem.Item := temp;
          end;
        end
        else begin
          g_ItemArr[nIdx] := g_MovingItem.Item;

          if (g_MovingItem.Index = -99) then
            RecallTradingSellPrices;

          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end;
    end;
  end;
  ArrangeItembag;
end;

procedure TFrmDlg.DItemGridDblClick(Sender:TObject; X, Y:Integer);
var
  idx:Integer;
  keyvalue:TKeyBoardState;
  cu:TClientItem;
  where:Integer;
  flag:Boolean;
  DItemGrid:TDxImageGrid;
  I, WantUseToIndex:Integer;
begin
  if g_MySelf = nil then
    Exit;

  DItemGrid := TDxImageGrid(Sender);
  idx := DItemGrid.Col + DItemGrid.row * DItemGrid.ColCount + 6;

  idx := idx + FCurrentBagPage * DItemGrid.ColCount * DItemGrid.RowCount; // MAX_EXT_ONE_PAGE_ITEM_COUNT

  if idx < 6 then
    Exit;
  if (idx >= GetMaxBagCount) and (idx <= Length(g_ItemArr) - 1) then begin
    frmMain.SendCloseBagItemClick(idx);
  end;

  if not (idx in [6..GetMaxBagCount - 1]) then
    Exit;

  if g_ItemArr[idx].S.Name <> '' then begin
    FillChar(keyvalue, SizeOf(TKeyBoardState), #0);
    GetKeyboardState(keyvalue);
    if keyvalue[VK_CONTROL] = $80 then begin
      cu := g_ItemArr[idx];
      g_ItemArr[idx].S.Name := '';
      AddItemBag(cu);
    end
    else if (g_ItemArr[idx].S.StdMode <= 4) or (g_ItemArr[idx].S.StdMode = 31) or (g_ItemArr[idx].S.StdMode = 60) or ((g_ItemArr[idx].S.StdMode = 49) and (g_ItemArr[idx].Dura >= g_ItemArr[idx].DuraMax)) or (g_ItemArr[idx].S.StdMode in [91, 92]) or (g_ItemArr[idx].S.StdMode in [95, 96]) then begin

      g_ConfigDlg.ProtectEnabled := False;
      try
        frmMain.EatItem(idx);
      finally
        g_ConfigDlg.ProtectEnabled := True;
      end;
    end
    else if (g_WaitingUseItem.Item.S.Name = '') then begin
      where := GetTakeOnPosition(g_ItemArr[idx].S.StdMode, g_ItemArr[idx].S.Shape);

      if ((g_ItemArr[idx].S.OverLap = 0) or (g_ItemArr[idx].S.OverLap and 1 <> 0)) then begin
        flag := False;
        case where of
          U_DRESS, U_FASHIONDRESS:begin
              if (where = U_FASHIONDRESS) and (g_ClientConfig.boUseOldSerialWindows) then
                Exit;

              {
              case g_MySelf.m_btSex of
                0:
                  begin
                    if not (g_ItemArr[idx].S.StdMode in [10, 66]) then
                    begin
                      //DScreen.AddChatBoardString('非男性用品', clRed, clWhite);
                      Exit;
                    end;
                  end;
                1:
                  begin
                    if not (g_ItemArr[idx].S.StdMode in [11, 67]) then
