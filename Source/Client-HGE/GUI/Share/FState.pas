procedure TFrmDlg.AddScreenMagicButton(Magic:PTClientMagic; const X, Y:Integer; IsSave:Boolean);
var
  DxButton:TMagicButton;
begin
  // 同一个技能图标支持多次拖动，位置以最后一次为准 2020-03-31 22:37:20
  DxButton := FindMagicButton(Magic);
  if DxButton = nil then begin
    DxButton := TMagicButton.Create(DBackground);
    DxButton.BringToFront;
    DxButton.m_Magic := Magic;
    DxButton.Left := X - 16;
    DxButton.Top := Y - 15;
    DxButton.Width := 32;
    DxButton.Height := 30;
    DxButton.Designing := False;
    DxButton.Floating := True;
    DxButton.OnMouseMove := OnMagicButtonMouseMove;
    DxButton.OnClick := OnMagicButtonClick; //(Sender: TObject; X, Y: Integer); stdcall;
    DxButton.OnDblClick := OnMagicButtonDblClick;
    DxButton.OnMove := OnMagicButtonMove;
    FScreenMagicBtnList.Add(DxButton);

    if IsSave then begin
      SaveMagicButtons;
    end;
  end
  else begin
    DxButton.Left := X - 16;
    DxButton.Top := Y - 15;
    if IsSave then begin
      SaveMagicButtons;
    end;
  end;
end;

