          nX := vtRect.Left + 40
        else
          nX := vtRect.Right - 20;
      end;

      // 修正自定义OK框物品不显示套装备注 chongchong 2017-05-12
      ShowMouseItemInfo(g_MySelf, @g_ItemBoxItems[Index], nX, nY, False);
    end;
  end
  else begin
    g_boShowBagInfo := False;
    g_MouseStateItem.s.Name := '';
    DScreen.ClearHint;
    HintWindows.Clear;
    NpcLabelMouseMove(Sender, Shift, X, Y);
  end;
