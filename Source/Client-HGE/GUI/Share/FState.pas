procedure TFrmDlg.DDChallengeGoldClick(Sender:TObject; X, Y:Integer);
var
  DGold:Integer;
  valstr:string;
begin
  if g_MySelf = nil then
    Exit;
  if not g_boChallengeEnd and (MyGetTickCount > g_dwChallengeActionTick) then begin
    if not g_boItemMoving then begin
      if g_nChallengeGold > 0 then begin
        PlaySound(s_money);
        g_boItemMoving := True;
        g_MovingItem.Index := -100;
        g_MovingItem.ItemType := mtChallengeGold;
        g_MovingItem.Item.S.Name := g_sGoldName {'金币'};
      end;
    end
    else begin
      if (g_MovingItem.ItemType in [mtBagGold, mtChallengeGold]) then begin
        if (g_MovingItem.ItemType = mtBagGold) then begin
          if g_MovingItem.Item.S.Name = g_sGoldName {'金币'} then begin

            g_boItemMoving := False;
            g_MovingItem.Item.S.Name := '';
            DMessageDlg('您想抵押多少' + g_sGoldName {金币} + '?', [mbOk, mbAbort]);
            valstr := Trim(DlgEditText);
            DGold := StrToIntDef(valstr, 0);
            if (DGold > 0) and (DGold <= (g_nChallengeGold + Int64(g_MySelf.m_nGold))) then begin
              frmMain.SendChangeChallengeGold(DGold);
              g_dwChallengeActionTick := MyGetTickCount + 4000;
            end;
          end;
        end;
        g_boItemMoving := False;
        g_MovingItem.Item.S.Name := '';
      end;
    end;
  end;
end;

