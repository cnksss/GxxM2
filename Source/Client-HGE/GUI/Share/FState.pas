procedure TFrmDlg.DBuyGameGoldDealItemOKClick(Sender:TObject; X, Y:Integer);
var
  I, Index:Integer;
  Msg:string;
  SL:TStringList;
begin
  Msg := Format('你确定花费 %d %s购买 %s 出售的以下物品：', [g_GameGoldDeal.GameGold, g_sGameGoldName, g_GameGoldDeal.SellChrName]) + sLineBreak;

  if g_GameGoldDeal.GameDiamond > 0 then
    Msg := Msg + sLineBreak + Format('%-20sx%d', [g_sGameDiamondName, g_GameGoldDeal.GameDiamond]);

  SL := TStringList.Create;

  for I := 0 to g_GameGoldDeal.ItemCount - 1 do begin
    if g_GameGoldDealRemoteItems[I].S.Name <> '' then begin
      Index := SL.IndexOf(g_GameGoldDealRemoteItems[I].S.Name);
      if Index = -1 then
        SL.AddObject(g_GameGoldDealRemoteItems[I].S.Name, TObject(1))
      else
        SL.Objects[Index] := TObject(Integer(SL.Objects[Index]) + 1);
    end;
  end;
  for I := 0 to SL.Count - 1 do begin
    Msg := Msg + sLineBreak + Format('%-20sx%d', [SL[I], Integer(SL.Objects[I])]);
  end;

  SL.Free;

  if FrmDlg.DMessageDlg(Msg, [mbOk, mbCancel]) <> mrOk then
    Exit;
  frmMain.SendBuyGameGoldDealItem();
end;

