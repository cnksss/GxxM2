            TzHintWindows := GetTzItemHintWindowEx(2, pTHumFeature(@g_UserState1.Feature.Buffer).btGender, g_MySelf, @g_UserState1.UseItems[U_HAT], False);
            if TzHintWindows <> nil then begin
              for I := 0 to TzHintWindows.Count - 1 do begin
