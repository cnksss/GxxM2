    with Button.Owner do begin
      if g_ClientConfig.boHintWithMouse then begin
        CtrlRect := TDxControl(Sender).VirtualRect;
        vtRect := VirtualRect;
        nY := CtrlRect.Bottom;
        nX := CtrlRect.Right; // nX := CtrlRect.Left;
