destructor TNpcGraphicButton.Destroy;
begin
  if m_GraphicTexture <> nil then begin
    m_GraphicTexture.Free;
  end;
  inherited;
end;

procedure TNpcGraphicButton.SetGraphic(AGraphic:TGraphic);
begin
  m_GraphicTexture := NewTextureFromGraphic(AGraphic);
end;

procedure TNpcGraphicButton.Paint;
begin
  inherited;
  GameCanvas.Draw(VirtualRect.Left, VirtualRect.Top, m_GraphicTexture);

end;

end.
