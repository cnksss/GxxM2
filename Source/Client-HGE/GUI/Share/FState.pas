    end;
  end;

var
  I, II, III, IIII, nCount:Integer;
  ItemDesc:pTTzItemDesc;
  UseItems:pTUseItems;
  JewelryBoxItems:pTJewelryBoxItems;
  GodBlessItems:PTGodBlessItems;
  FenHaoItems:TGList;
  TempItem:PTClientItem;
  boFind:Boolean;
  ItemNameList:TStringList;
  TZItemDescList:TList;
  ItemSelecteds:array[U_DRESS..U_GODBLESSITEM12] of Boolean;
  FenHaoItemSelecteds:array of Boolean;
  HintLines:THintLines;
  HintWindow:TList;
  sItemName:string;
  ArrHintWindows:TArrHintWindows;
begin
  Result := nil;
  if not g_ClientConfig.boTZSupportRenameItem then
    sItemName := MouseItem.s.DBName
