procedure TFrmDlg.ShowMouseItemInfo(Actor:TActor; MouseItem:pTClientItem; X, Y:Integer; Secret:Boolean; ShowTzItemDesc:Byte; DrawUp:Boolean; DrawLeft:Boolean; boCompareUseItem:Boolean; boShowSellPrice:Boolean; boHeroM2ShopItem:Boolean);
var
  I, I2, nX, nY, nWidth, nHeight, nWhere, nWhere1, nWhere2:Integer;
  HintWindow:THintWindow;
  TzHintWindows:TList;
  TzHintWindow:THintWindow;
  HintLines:THintLines;
  Flag:Boolean;
  HintWindowList:TList;
  UseItem:pTClientItem;
  sText:string;
  boSingleLineHintShow:Boolean;
  ArrHintWindows:TArrHintWindows;
  IsJewelryBoxOpen, IsShowGodBless:Boolean;
  GodBlessItemsState:pTGodBlessItemsState;
  IsBlessItemOpen:Boolean;
begin
  // 这个函数要修改 chongchong 2015-05-22
  if Length(MouseItem.s.Name) = 0 then begin
    DScreen.ClearHint;
    HintWindows.Clear;
    Exit;
  end;

  // 免得不停的重新创建提示窗口 chongchong 2015-01-22
  if (MouseItem.MakeIndex <> g_LastHintMakeIndex) then begin
    HintWindows.Clear;
    HintWindowList := TList.Create;

    boSingleLineHintShow := False;
    // 两列显示 piaoyun 2013-09-16
    if g_ClientConfig.boSingleHint then begin
      TzHintWindows := GetTzItemHintWindowEx(ShowTzItemDesc, Actor.m_btSex, Actor, MouseItem, Secret, boShowSellPrice);

      if (TzHintWindows <> nil) then begin
        // 单列显示 piaoyun 2013-09-16
        for I := 0 to TzHintWindows.Count - 1 do begin
          TzHintWindow := THintWindow(TzHintWindows.Items[I]);

          if boHeroM2ShopItem then begin
            sText := '售价: ';

            case MouseItem.S.Reserved1 of
              0:sText := sText + IntToStr(MouseItem.S.Price) + g_sGameGoldName;
              1:sText := sText + IntToStr(MouseItem.S.Price) + g_sGamePointName;
              2:sText := sText + IntToStr(MouseItem.S.Price) + g_sGoldName;
              3:sText := sText + IntToStr(MouseItem.S.Price) + g_sGameDiamondName;
              4:sText := sText + IntToStr(MouseItem.S.Price) + g_sGameGirdName;
              else sText := sText + IntToStr(MouseItem.S.Price) + GetCustomMoneyNameByRule(MouseItem.S.Reserved1, 0);
            end;

            HintLines := THintLines.Create;

            // 套装信息不能调整对齐 2019-12-27 23:23:59
            HintLines.Alignment := g_ConfigClient.OtherHintAlignment;

            HintLines.Add(sText, clYellow, GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke(True));
            TzHintWindow.Add(HintLines);
          end;

          //TzHintWindow.Show(nX, nY, DrawUp, DrawLeft);
          TzHintWindow.Show(X, Y, DrawUp, DrawLeft); //HZQ 20230525 nX, nY是没有初值的
          HintWindowList.Add(TzHintWindow);
        end;
        TzHintWindows.Free;
        boSingleLineHintShow := True;
      end;
    end;

    if not boSingleLineHintShow then begin
      for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
        ArrHintWindows[I] := THintWindow.Create;
      end;

      GetMouseItemInfo(Actor, MouseItem, Secret, ArrHintWindows, False, boShowSellPrice);

