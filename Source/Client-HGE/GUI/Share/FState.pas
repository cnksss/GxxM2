procedure TFrmDlg.DDGridGridSelect(Sender:TObject; ACol, ARow:Integer; Button:TMouseButton; Shift:TShiftState);
var
  mi, nIdx:Integer;
  DDGrid:TDxImageGrid;
begin
  if not g_boDealEnd and (MyGetTickCount > g_dwDealActionTick) then begin
    DDGrid := TDxImageGrid(Sender);
    if not g_boItemMoving then begin
      nIdx := ACol + ARow * DDGrid.ColCount;
      if nIdx in [0..9] then
        if g_DealItems[nIdx].S.Name <> '' then begin
          g_boItemMoving := True;
          g_MovingItem.Index := -nIdx - 20;
          g_MovingItem.Item := g_DealItems[nIdx];
          g_MovingItem.ItemType := mtDealItem;
          g_DealItems[nIdx].S.Name := '';
          ItemClickSound(g_MovingItem.Item.S);
        end;
    end
    else begin
      mi := g_MovingItem.Index;
      if g_MovingItem.ItemType in [mtHeroBagItem, mtHeroUseItem] then
        Exit;

      if (mi >= 0) or (mi <= -20) and (mi > -30) then begin
        ItemClickSound(g_MovingItem.Item.S);
        g_boItemMoving := False;
        if mi >= 0 then begin
          g_DealDlgItem := g_MovingItem.Item;
          frmMain.SendAddDealItem(g_DealDlgItem);
          g_dwDealActionTick := MyGetTickCount + 4000;
        end
        else
          AddDealItem(g_MovingItem.Item);
        g_MovingItem.Item.S.Name := '';
      end;
      if mi = -98 then
        DDGoldClick(Self, 0, 0);
    end;
    ArrangeItembag;
  end;
end;

