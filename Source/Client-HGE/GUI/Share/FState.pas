procedure TFrmDlg.ProgressButtonStartSubDirectPaint(Sender:TObject);
var
  GameImage:TGameImages;
  Button:TNpcProgressBoxButton;
  d:TTexture;
  vtRect, PaintRect:TRect;
  nMaxValue, nCurrValue:Integer;
  nW:Integer;
  sText:string;
  Font:TDxFont;
begin
  if not (Sender is TNpcProgressBoxButton) then
    Exit;
  Button := Sender as TNpcProgressBoxButton;

  GameImage := Button.ImageIndex.Image;
  if GameImage = nil then
    Exit;

  vtRect := Button.VirtualRect;
  {
      m_nBgIndex: Integer;
      m_nProgressIndex: Integer;
      m_nProgressCount: Integer;
      m_nProgressOffsetX: Integer;
      m_nProgressOffsetY: Integer;
      m_nProgressMinValue: Integer;
      m_nProgressMaxValue: Integer;
      m_nProgressValue: Integer;
      m_nProgressDist: Integer;
      m_nProgressTextColor: Byte;
      m_sText: string;
  }

  d := GameImage.Images[Button.m_nBgIndex];
  if d <> nil then begin
    if Button.Tag = 1 then
      Button.DrawRect(vtRect, d)
    else
      GameCanvas.Draw(vtRect.Left, vtRect.Top, d);
  end;

  if (Button.m_nProgressStartIndex >= 0) and (Button.m_nProgressCount > 1) then begin
    if MyGetTickCount - Button.m_nProgressRefresTick >= Cardinal(Button.m_nProgressRefresTime) then begin
      Inc(Button.m_nProgressIndex);
      Button.m_nProgressRefresTick := MyGetTickCount;
    end;

    if Button.m_nProgressIndex >= Button.m_nProgressCount then
      Button.m_nProgressIndex := 0;

    d := GameImage.Images[Button.m_nProgressStartIndex + Button.m_nProgressIndex];
  end else begin
    d := GameImage.Images[Button.m_nProgressStartIndex];
  end;

  nMaxValue := Button.m_nProgressMaxValue - Button.m_nProgressMinValue;
  nCurrValue := Button.m_nProgressValue - Button.m_nProgressMinValue;

  if d <> nil then begin
    PaintRect := d.ClientRect;

    case Button.m_nProgressDist of
      0:
        PaintRect.Right := MAX(Round(d.Width / nMaxValue * nCurrValue), 0);
      1:
        PaintRect.Left := MAX(Round(d.Width / nMaxValue * MAX(nMaxValue - nCurrValue, 0)), 0);
      2:
        PaintRect.Bottom := MAX(Round(d.Height / nMaxValue * nCurrValue), 0);
      else //mbaBottom:
        PaintRect.Top := MAX(Round(d.Height / nMaxValue * MAX(nMaxValue - nCurrValue, 0)), 0);
    end;

    if Button.Tag = 1 then
      Button.DrawRect(Bounds(vtRect.Left + Button.m_nProgressOffsetX + PaintRect.Left, vtRect.Top + Button.m_nProgressOffsetY + PaintRect.Top, PaintRect.Right, PaintRect.Bottom), PaintRect, Button.VisibleRect, d)
    else
      GameCanvas.Draw(vtRect.Left + Button.m_nProgressOffsetX + PaintRect.Left, vtRect.Top + Button.m_nProgressOffsetY + PaintRect.Top, PaintRect, d);
  end;

  if Length(Button.m_sText) > 0 then begin
    sText := StringReplace(Button.m_sText, '%p', IntToStr(Button.m_nProgressValue), [rfReplaceAll, rfIgnoreCase]);
    sText := StringReplace(sText, '%m', IntToStr(Button.m_nProgressMaxValue), [rfReplaceAll, rfIgnoreCase]);
    if nMaxValue = 0 then
      sText := StringReplace(sText, '%r', '0', [rfReplaceAll, rfIgnoreCase])
    else
      sText := StringReplace(sText, '%r', IntToStr(Trunc(nCurrValue / nMaxValue * 100)), [rfReplaceAll, rfIgnoreCase]);

    if CurrentFont <> nil then begin
      nW := CurrentFont.TextWidth(sText);

      if Button.Tag = 1 then begin
        Font := Button.CaptionColor.Up;
        Font.Color := Button.m_nProgressTextColor;
        Button.DrawCaption(CurrentFont, Font, sText, Bounds(vtRect.Left, vtRect.Top, nW, g_CurrentFontHeight), Button.VisibleRect, vtRect, Button.m_nProgressTextOffsetX, Button.m_nProgressTextOffsetY);
      end else begin
        BoldTextOut(vtRect.Left + (vtRect.Right - vtRect.Left - nW) div 2 + Button.m_nProgressTextOffsetX, vtRect.Top + (vtRect.Bottom - vtRect.Top - g_CurrentFontHeight) div 2 + Button.m_nProgressTextOffsetY, sText, Button.m_nProgressTextColor);
      end;
    end;
  end;
end;

