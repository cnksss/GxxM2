// 处理NPC提示标签 piaoyun 2013-07-26

procedure TFrmDlg.NpcLabelMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  vtRect:TRect;
  i:Integer;
  HintLines:THintLines;
  HintWindow:THintWindow;
  NpcDlg:TDxControl; // label的父窗口--NPC对话框窗口
  slLines:TStringList;
  sHintText, sHintColor:string;
  btHintColor:Byte;
  dxCtrl:TDxControl;
begin
  DScreen.ClearHint;
  HintWindows.Clear;
  if not (Sender is TDxControl) then
    Exit;
  dxCtrl := Sender as TDxControl;
  if Length(dxCtrl.Hint) = 0 then
    Exit;

  vtRect := dxCtrl.VirtualRect;
  HintWindow := THintWindow.Create;

  slLines := TStringList.Create;
  try
    ExtractStrings(['^'], [], PChar(dxCtrl.Hint), slLines);
    for i := 0 to slLines.Count - 1 do begin
      //ShowMessage(slLines[i]);
      slLines[i] := GetValidStr3_Ex(slLines[i], sHintColor, '#');
      if slLines[i] = '' then begin
        btHintColor := 255;
        sHintText := sHintColor;
      end
      else begin
        sHintText := slLines[i];
        btHintColor := StrToIntDef(sHintColor, 0);
      end;
      HintLines := THintLines.Create;
      HintLines.Add(sHintText, GetRGB(btHintColor), GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke());
      HintWindow.Add(HintLines);
    end;
  finally
    slLines.Free;
  end;

  // NPC提示标签是否随鼠标位置 piaoyun 2013-07-26
  if not g_ClientConfig.boNpcDlgHintWithMouse then begin
    NpcDlg := TDxControl(TDxLabel(Sender).Owner);
    HintWindow.Show(NpcDlg.VisibleRect.Left + NpcDlg.Width - 20, NpcDlg.VisibleRect.Bottom - 130);
  end
  else
    HintWindow.Show(vtRect.Left, vtRect.Top + TNpcLabel(Sender).Height);

  HintWindows.Add(HintWindow);
end;

