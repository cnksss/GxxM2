procedure TFrmDlg.ItemBoxButtonClick(Sender:TObject; X, Y:Integer);
var
  I, SelIndex:Integer;
  Flag:Boolean;
  DButton:TNpcItemBoxButton;
  nStdMode:Integer;
  StdModes:TStringList;
begin
  if g_MySelf = nil then
    Exit;
  if not (Sender is TNpcItemBoxButton) then
    Exit;

  DButton := TNpcItemBoxButton(Sender);
  SelIndex := DButton.m_nIndex;

  if g_boItemMoving then begin
    Flag := False;
    if not (g_MovingItem.ItemType in [mtBagItem]) then
      Exit;

    if (g_MovingItem.Item.S.Name = '') or (g_WaitingUseItem.Item.S.Name <> '') then
      Exit;

    StdModes := TStringList.Create;
    try
      StdModes.Delimiter := ',';
      StdModes.DelimitedText := DButton.m_StdModes;

      for I := 0 to StdModes.Count - 1 do begin
        if StdModes[I] = '*' then begin
          Flag := True;
          Break;
        end
        else begin
          nStdMode := StrToIntDef(StdModes[I], -1);
          if g_MovingItem.Item.s.StdMode = nStdMode then begin
            Flag := True;
            Break;
          end;
        end;
      end;
    finally
      StdModes.Free;
    end;

    if Flag then begin
      if g_MovingItem.ItemType = mtBagItem then begin
        ItemClickSound(g_MovingItem.Item.S);
        g_WaitingUseItem := g_MovingItem;
        g_WaitingUseItem.Index := SelIndex;

        frmMain.SendMoveToItemBox(SelIndex, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
        g_MovingItem.Item.S.Name := '';
        g_boItemMoving := False;
      end;
    end;
  end
  else begin
    if (g_MovingItem.Item.S.Name <> '') or (g_WaitingUseItem.Item.S.Name <> '') then
      Exit;
    if (SelIndex >= 0) and (g_ItemBoxItems[SelIndex].S.Name <> '') then begin
      ItemClickSound(g_ItemBoxItems[SelIndex].S);
      g_MovingItem.Index := SelIndex;
      g_MovingItem.Item := g_ItemBoxItems[SelIndex];
      g_MovingItem.ItemType := mtItemBoxItem;
      g_ItemBoxItems[SelIndex].S.Name := '';
      g_boItemMoving := True;
    end;
  end;
end;

procedure TFrmDlg.ItemBoxButtonMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  Button:TNpcItemBoxButton;
  Index, nX, nY:Integer;
