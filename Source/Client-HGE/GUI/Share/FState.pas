  if (DBoxDlg <> nil) then begin
{$IF IsMultiThreadRender = 1}
    DBackground.Lock;
    try
{$IFEND}
      DBoxDlg.Update;
{$IF IsMultiThreadRender = 1}
    finally
      DBackground.UnLock;
    end;
{$IFEND}
  end;
  if (DItemBoxDlg <> nil) then begin
{$IF IsMultiThreadRender = 1}
    DBackground.Lock;
    try
{$IFEND}
      DItemBoxDlg.Update;
{$IF IsMultiThreadRender = 1}
    finally
      DBackground.UnLock;
    end;
{$IFEND}
  end; *)
