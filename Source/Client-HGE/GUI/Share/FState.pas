            else begin
              for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                ArrHintWindows[I] := THintWindow.Create;
              end;

              GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_UserState1.UseItems[U_HAT], nX, nY, False, False, DrawLeft);

              for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                HintWindow := THintWindow(ArrHintWindows[I]);
                if HintWindow.Count > 0 then begin
                  HintList.Add(HintWindow);
                  HintWindow.Show(0, 0);
                end
                else
                  HintWindow.Free;
              end;

            end;
          end;
        end;

        nWidth := 0;
        nHeight := 0;
        for I := 0 to HintList.Count - 1 do begin
          HintWindow := THintWindow(HintList.Items[I]);
          nWidth := nWidth + HintWindow.Width;
          nHeight := Max(HintWindow.Height, nHeight);
        end;

        if g_ClientConfig.boHintWithMouse then begin
          if CtrlRect.Left >= (SCREENWIDTH - D.Width) then begin
            nX := CtrlRect.Left; // HintWindow.Width;
            DrawLeft := True;
          end
          else begin
            nX := CtrlRect.Right;
            DrawLeft := False;
          end;
        end
        else begin
          if vtRect.Left >= (SCREENWIDTH - D.Width) div 2 then begin
            nX := vtRect.Left - nWidth; // HintWindow.Width;
            DrawLeft := True;
          end
          else begin
            nX := vtRect.Right;
            DrawLeft := False;
          end;
        end;

        if nX + nWidth > SCREENWIDTH then
          nX := SCREENWIDTH - nWidth;

        if nY + nHeight > SCREENHEIGHT then
          nY := SCREENHEIGHT - nHeight;

        if nX < 0 then
          nX := 0;
        if nY < 0 then
          nY := 0;

        if DrawLeft then begin
          for I := HintList.Count - 1 downto 0 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            HintWindow.X := nX;
            HintWindow.Y := nY;
            Inc(nX, HintWindow.Width);
            HintWindows.Add(HintWindow);
          end;
        end
        else begin
          for I := 0 to HintList.Count - 1 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            HintWindow.X := nX;
            HintWindow.Y := nY;
            Inc(nX, HintWindow.Width);
            HintWindows.Add(HintWindow);
          end;
        end;
        HintList.Free;
      end;
    end
    else if (sel = U_HELMET) and (g_UserState1.UseItems[U_HAT].S.Name <> '') then begin
      sel := U_HAT;
      g_boShowBagInfo := False;
      D := TDxControl(Sender);

      while True do begin
        if (D.Owner <> nil) and (D.Owner is TDxControlEngine) then
          break;
        D := D.Owner;
      end;
      with D do begin
        CtrlRect := TDxControl(Sender).VirtualRect;
        vtRect := VirtualRect;
        nY := CtrlRect.Bottom;
        nX := CtrlRect.Left;
        DrawLeft := False;

        HatItem := g_UserState1.UseItems[sel];
        HintWindows.Clear;
        HintList := TList.Create;

        TzHintWindows := GetTzItemHintWindowEx(0, pTHumFeature(@g_UserState1.Feature.Buffer).btGender, g_MySelf, @HatItem, False);
        if TzHintWindows <> nil then begin
          for I := 0 to TzHintWindows.Count - 1 do begin
            THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
            HintList.Add(TzHintWindows.Items[I]);
          end;
          TzHintWindows.Free;
        end
        else begin
          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            ArrHintWindows[I] := THintWindow.Create;
          end;

          GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @HatItem, nX, nY, False, False, DrawLeft);

          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            HintWindow := THintWindow(ArrHintWindows[I]);
            if HintWindow.Count > 0 then begin
              HintList.Add(HintWindow);
              HintWindow.Show(0, 0);
            end
            else
              HintWindow.Free;
          end;
        end;

        nWidth := 0;
        nHeight := 0;

        for I := 0 to HintList.Count - 1 do begin
          HintWindow := THintWindow(HintList.Items[I]);
          nWidth := nWidth + HintWindow.Width;
          nHeight := Max(HintWindow.Height, nHeight);
        end;

        if CtrlRect.Left >= (SCREENWIDTH - Width) then begin
          nX := CtrlRect.Left; // HintWindow.Width;
          DrawLeft := True;
        end
        else begin
          nX := CtrlRect.Right;
          DrawLeft := False;
        end;

        if nX + nWidth > SCREENWIDTH then
          nX := SCREENWIDTH - nWidth;

        if nY + nHeight > SCREENHEIGHT then
          nY := SCREENHEIGHT - nHeight;

        if nX < 0 then
          nX := 0;
        if nY < 0 then
          nY := 0;
        if DrawLeft then begin
          for I := HintList.Count - 1 downto 0 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            HintWindow.X := nX;
            HintWindow.Y := nY;

            // 旧模式斗笠显示黄色字 chongchong 2013-12-17
            if g_ClientConfig.boUseOldSerialWindows then begin
              for J := 0 to HintWindow.Count - 1 do begin
                HintLines := HintWindow.Items[J];
                for K := 0 to HintLines.Count - 1 do begin
                  HintText := HintLines.Objects[K] as THintText;
                  HintText.Color := clYellow;
                end;
              end;
            end;

            Inc(nX, HintWindow.Width);
            HintWindows.Add(HintWindow);
          end;
        end
        else begin
          for I := 0 to HintList.Count - 1 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            HintWindow.X := nX;
            HintWindow.Y := nY;

            // 旧模式斗笠显示黄色字 chongchong 2013-12-17
            if g_ClientConfig.boUseOldSerialWindows then begin
              for J := 0 to HintWindow.Count - 1 do begin
                HintLines := HintWindow.Items[J];
                for K := 0 to HintLines.Count - 1 do begin
                  HintText := HintLines.Objects[K] as THintText;
                  HintText.Color := clYellow;
                end;
              end;
            end;

            Inc(nX, HintWindow.Width);
            HintWindows.Add(HintWindow);
          end;
        end;
        HintList.Free;
      end;
    end;
  end;
  g_LastHintMakeIndex := g_MouseUserStateItem.MakeIndex;
end;

procedure TFrmDlg.MinMapDlgDirectPaint(Sender:TObject);
{$J+}
const
  IsShowSelfRadar:Boolean = False;
const
  ShowSelfRadarTick:LongWord = 0;
  {$J-}
var
  vtRect:TRect;
  MapRect:TRect;
  PaintRect:TRect;
  nX, nY:Integer;
  nMapX, nMapY:Integer;
  Actor:TActor;
  Color:TColor;
  sText:string;
  I:Integer;
  MapDescInfo:pTMapDescInfo;
  DescList:TList;
  nMinX, nMinY, nMaxX, nMaxY:Integer;
  srcBits:Pointer;
  srcPitch:Integer;
  srcPoint:Pointer; //HZQ 20230525 PInteger
begin
  if g_MySelf = nil then
    Exit;

  if (g_nMiniMapIndex < 0) or (g_nViewMinMapLv <= 0) then
    Exit;

  if (g_nMiniMapIndex <> FMiniMapLoadIndex) or (MyGetTickCount - FMiniMapLoadSurfaceTime >= 2 * 1000) then begin
    // 修复小地图错误 chongchong 2015-01-05
    { TODO -c修正 -ochongchong : 小地图扩展再修改 【2013-4-23】}
    case g_nMiniMapIndex of
      9900..9999:
        FMiniMapSurface := g_WBmpMapImages.Images[g_nMiniMapIndex - 9900]; // 预留
      // mmap10.wil从10001-15000开始
      10000..14999:
        FMiniMapSurface := g_WMMapImages10.Images[g_nMiniMapIndex - 10000];

      // mmap11.wil从15001-20000开始
      15000..19999:
        FMiniMapSurface := g_WMMapImages11.Images[g_nMiniMapIndex - 15000];

      // mmap12.wil从20001-24999开始
      20000..24999:
        FMiniMapSurface := g_WMMapImages12.Images[g_nMiniMapIndex - 20000];
      else
        FMiniMapSurface := g_WMMapImages.Images[g_nMiniMapIndex];
    end;

    if FMiniMapSurface <> nil then begin
      FMiniMapLoadIndex := g_nMiniMapIndex;
      FMiniMapLoadSurfaceTime := MyGetTickCount;
      // 修复小地图有透明区域 chongchong 2015-10-30
      if FMiniMapSurface.Lock(srcBits, srcPitch, True) then begin
        try
          for nY := 0 to FMiniMapSurface.Height - 1 do begin
            for nX := 0 to FMiniMapSurface.Width - 1 do begin
              srcPoint := Pointer(UINT_PTR(srcBits) + UINT(srcPitch * nY + nX * 4)); //HZQ 20250525
              PDWord(srcPoint)^ := PDWord(srcPoint)^ or $FF000000; //HZQ 20250525
            end;
          end;
        finally
          FMiniMapSurface.Unlock;
        end;
      end;
    end;
  end;

  if (FMiniMapSurface = nil) then
    Exit;

  vtRect := DMinMapDlg.VirtualRect;
  g_nMapWidth := FMiniMapSurface.Width;
  g_nMapHeight := FMiniMapSurface.Height;

  case g_nViewMinMapLv of
    1:begin // 局部
        ActorXYToMapXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
        MapRect := Bounds(_Max(0, nX - DMinMapDlg.Width div 2), _Max(0, nY - DMinMapDlg.Height div 2), DMinMapDlg.Width, DMinMapDlg.Height);

        if g_boMinMapTransparent then begin
          GameCanvas.DrawAlpha(vtRect.Left, vtRect.Top, MapRect, FMiniMapSurface, 120);
        end
        else begin
          GameCanvas.Draw(vtRect.Left, vtRect.Top, MapRect, FMiniMapSurface);
        end;
      end;
    2:begin // 全景地图
        MapRect := vtRect;
        if g_boMinMapTransparent then
          GameCanvas.StretchDraw(MapRect, FMiniMapSurface.ClientRect, FMiniMapSurface, 120)
        else
          GameCanvas.StretchDraw(MapRect, FMiniMapSurface.ClientRect, FMiniMapSurface);
      end;
  end;

  // 加入小地图寻路功能 2019-05-17 11:47:26
  if g_ClientConfig.boMinMapUseFindPath and (Length(LegendMap.RunPath) > 0) then begin
    for I := 0 to Length(LegendMap.RunPath) - 1 do begin
      ActorXYToMapXY(LegendMap.RunPath[I].X, LegendMap.RunPath[I].Y, nMapX, nMapY);

      if g_nViewMinMapLv = 1 then begin
        nMapX := nMapX - MapRect.Left;
        nMapY := nMapY - MapRect.Top;
      end
      else begin
        MapToScreen(FMiniMapSurface.Width, vtRect.Right - vtRect.Left, nMapX, nMapX);
        MapToScreen(FMiniMapSurface.Height, vtRect.Bottom - vtRect.Top, nMapY, nMapY);
      end;

      nX := vtRect.Left + nMapX;
      nY := vtRect.Top + nMapY;

      if PtInRect(vtRect, Point(nX, nY)) then begin
        PaintRect := Bounds(nX - 1, nY - 1, 2, 2);
        GameCanvas.FillRect(PaintRect, clRed);
      end;
    end;
  end;

  if g_ConfigDlg.ConfigCheckeds[ckShowRadarPlayer] or g_ConfigDlg.ConfigCheckeds[ckShowRadarNpc] or g_ConfigDlg.ConfigCheckeds[ckShowRadarAttackNpc] or g_ConfigDlg.ConfigCheckeds[ckShowRadarActor] or (g_ConfigDlg is TMirConfigDlg) then begin

    for nX := g_MySelf.m_nCurrX - 12 to g_MySelf.m_nCurrX + 12 do begin
      for nY := g_MySelf.m_nCurrY - 12 to g_MySelf.m_nCurrY + 12 do begin
        Actor := PlayScene.FindActorXY(nX, nY);
        if (Actor <> nil) and (g_MySelf <> Actor) and (not Actor.m_boDeath) then begin
          if g_nViewMinMapLv = 1 then begin
            ActorXYToMapXY(Actor.m_nCurrX, Actor.m_nCurrY, nMapX, nMapY);
            nMapX := nMapX - MapRect.Left;
            nMapY := nMapY - MapRect.Top;
          end
          else begin
            ActorXYToMapXY(Actor.m_nCurrX, Actor.m_nCurrY, nMapX, nMapY);
            MapToScreen(FMiniMapSurface.Width, MapRect.Right - MapRect.Left, nMapX, nMapX);
            MapToScreen(FMiniMapSurface.Height, MapRect.Bottom - MapRect.Top, nMapY, nMapY);
          end;

          { TODO -ochongchong -c修改 : 修改小地图雷达 人怪 npc颜色【2013-07-19】 }
          {
          case Actor.m_btRace of
            45, RC_PEACENPC: Color := clLime; // clLime;    //和平NPC
            RC_ANIMAL: Color := clRed;        // 攻击NPC
            // , , 50, 45, 12: Color := clLime; //clLime;
            0: Color := clYellow;
          else
            Color := clRed;                   // clRed;
          end;
          }
          if (Actor is TNpcActor) then // 系统NPC
            Color := GetRGB(g_ClientConfig.btMinMapColorNPC)
          else if Actor.ClassType = THumActor then // 其他玩家
            Color := GetRGB(g_ClientConfig.btMinMapColorOther)
          else if Actor.ClassType = THeroActor then {// 英雄} begin
            if Actor = g_MyHero then
              Color := GetRGB(g_ClientConfig.btMinMapColorHero) // 自己英雄的颜色
            else
              Color := GetRGB(g_ClientConfig.btMinMapColorOther); // 其他玩家英雄的颜色和玩家一样
          end
          else begin
            case Actor.m_btRealRace of
              RC_PLAYOBJECT: // 玩家
                Color := GetRGB(g_ClientConfig.btMinMapColorOther);
              55, // 练功师
              RC_PEACENPC, RC_ANIMAL:
                Color := GetRGB(g_ClientConfig.btMinMapColorNPC);
              RC_GUARD, // 弓箭手
              RC_ARCHERGUARD: // 大刀守卫
                Color := GetRGB(g_ClientConfig.btMinMapColorGuard);
              else begin
                  if g_BossList.IndexOf(Actor.m_sUserName) >= 0 then
                    Color := GetRGB(g_ClientConfig.btMinMapColorBoss)
                  else
                    Color := GetRGB(g_ClientConfig.btMinMapColorMonster);
                end;
            end;
          end;

          // ---------玩家
          if ((Actor.m_btRace in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarPlayer] or (g_ConfigDlg is TMirConfigDlg))) or // ---------特殊npc (和平npc)
          ((Actor.m_btRace in [RC_ANIMAL, 55]) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarNpc] or (g_ConfigDlg is TMirConfigDlg))) or // --------攻击npc
          (((Actor.m_btRace = RC_PEACENPC) or (Actor.m_btRealRace in [RC_GUARD {弓箭手}, RC_ARCHERGUARD {大刀}])) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarAttackNpc] or (g_ConfigDlg is TMirConfigDlg))) or // ---------怪物
          ((not (Actor.m_btRace in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PEACENPC, RC_ANIMAL, 55])) and (not (Actor.m_btRealRace in [RC_GUARD {弓箭手}, RC_ARCHERGUARD {大刀}])) and (g_ConfigDlg.ConfigCheckeds[ckShowRadarActor] or (g_ConfigDlg is TMirConfigDlg))) then begin
            if (g_MyHero <> nil) and (g_MyHero = Actor) then
              Color := GetRGB(g_ClientConfig.btMinMapColorHero);

            { TODO -ochongchong -c添加 : 修改小地图雷达 人怪 npc颜色 【2013-07-19】 }
            {
              PaintRect := Bounds(vtRect.Left + nMapX - 2, vtRect.Top + nMapY - 2, 4, 4);
              GameCanvas.FillRect(PaintRect, Color);
            }
            if (not g_ClientConfig.boMinMapCloseRadar) then begin
              if g_ClientConfig.btMinMapType = 1 then
                PaintRect := Bounds(vtRect.Left + nMapX - MINMAP_RECT_SIZE div 2, vtRect.Top + nMapY - MINMAP_RECT_SIZE div 2, MINMAP_RECT_SIZE, MINMAP_RECT_SIZE)
              else
                PaintRect := Bounds(vtRect.Left + nMapX - MINMAP_RECT_SIZE2 div 2, vtRect.Top + nMapY - MINMAP_RECT_SIZE2 div 2, MINMAP_RECT_SIZE2, MINMAP_RECT_SIZE2);
              GameCanvas.FillRect(PaintRect, Color);
            end;
          end;

        end;
      end;
    end;
  end;

  if g_nViewMinMapLv = 1 then begin
    ActorXYToMapXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nMapX, nMapY);
    nMapX := nMapX - MapRect.Left;
    nMapY := nMapY - MapRect.Top;
  end
  else begin
    ActorXYToMapXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nMapX, nMapY);
    MapToScreen(FMiniMapSurface.Width, MapRect.Right - MapRect.Left, nMapX, nMapX);
    MapToScreen(FMiniMapSurface.Height, MapRect.Bottom - MapRect.Top, nMapY, nMapY);
  end;

  if g_clientconfig.dwMinMapFlagFlash < 200 then
    IsShowSelfRadar := True
  else if tick_diff(ShowSelfRadarTick, MyGetTickCount) >= g_clientconfig.dwMinMapFlagFlash then begin
    IsShowSelfRadar := not IsShowSelfRadar;
    ShowSelfRadarTick := MyGetTickCount;
  end;

  { TODO -ochongchong -c添加 : 小地图中人物矩形闪烁效果 2013-07-18 }
  if IsShowSelfRadar then begin
    if g_ClientConfig.btMinMapType = 1 then
      PaintRect := Bounds(vtRect.Left + nMapX - MINMAP_RECT_SIZE div 2, vtRect.Top + nMapY - MINMAP_RECT_SIZE div 2, MINMAP_RECT_SIZE, MINMAP_RECT_SIZE)
    else
      PaintRect := Bounds(vtRect.Left + nMapX - MINMAP_RECT_SIZE2 div 2, vtRect.Top + nMapY - MINMAP_RECT_SIZE2 div 2, MINMAP_RECT_SIZE2, MINMAP_RECT_SIZE2);

    GameCanvas.FillRect(PaintRect, GetRGB(g_ClientConfig.btMinMapColorSelf));
  end;

  if g_ConfigDlg.ConfigCheckeds[ckShowMapDesc] then begin
    if g_MapDesc.Get(g_sMapTitle, g_nViewMinMapLv >= 2, DescList) and (DescList.Count > 0) then begin

      if g_nViewMinMapLv = 1 then begin
        MapXYToActorXY(MapRect.Left, MapRect.Top, nMinX, nMinY);
        MapXYToActorXY(MapRect.Right, MapRect.Bottom, nMaxX, nMaxY);
        for I := 0 to DescList.Count - 1 do begin
          MapDescInfo := DescList[I];
          if (MapDescInfo.nX >= nMinX) and (MapDescInfo.nX <= nMaxX) and (MapDescInfo.nY >= nMinY) and (MapDescInfo.nY <= nMaxY) then begin
            ActorXYToMapXY(MapDescInfo.nX, MapDescInfo.nY, nMapX, nMapY);
            nMapX := nMapX - MapRect.Left;
            nMapY := nMapY - MapRect.Top;
            sText := MapDescInfo.sDescName;
            nX := _Max(vtRect.Left, vtRect.Left + nMapX - CurrentFont.TextWidth(sText) div 2);
            nY := _Max(vtRect.Top, vtRect.Top + nMapY);
            if nX + CurrentFont.TextWidth(sText) > vtRect.Right then
              nX := vtRect.Right - CurrentFont.TextWidth(sText);
            if nY + g_CurrentFontHeight > vtRect.Bottom then
              nY := vtRect.Bottom - g_CurrentFontHeight;
            BoldTextOut(nX, nY, sText, MapDescInfo.FColor);
          end;
        end;
      end
      else if g_nViewMinMapLv = 2 then begin
        for I := 0 to DescList.Count - 1 do begin
          MapDescInfo := DescList[I];
          ActorXYToMapXY(MapDescInfo.nX, MapDescInfo.nY, nMapX, nMapY);
          MapToScreen(FMiniMapSurface.Width, DMinMapDlg.Width, nMapX, nMapX);
          MapToScreen(FMiniMapSurface.Height, DMinMapDlg.Height, nMapY, nMapY);
          sText := MapDescInfo.sDescName;

          nX := _Max(vtRect.Left, vtRect.Left + nMapX - CurrentFont.TextWidth(sText) div 2);
          nY := _Max(vtRect.Top, vtRect.Top + nMapY);
          if nX + CurrentFont.TextWidth(sText) > vtRect.Right then
            nX := vtRect.Right - CurrentFont.TextWidth(sText);
          if nY + g_CurrentFontHeight > vtRect.Bottom then
            nY := vtRect.Bottom - g_CurrentFontHeight;
          BoldTextOut(nX, nY, sText, MapDescInfo.FColor);
        end;
      end;
    end;
  end;

  if (g_ClientVersion = cvMirNewUI205) then
    BoldTextOut(vtRect.Left, vtRect.Bottom - g_CurrentFontHeight, g_sMapTitle, clWhite);

  if g_boShowMiniMapXY then begin
    if g_nViewMinMapLv = 1 then begin
      nMapX := (g_nMinMapX - vtRect.Left + MapRect.Left);
      nMapY := (g_nMinMapY - vtRect.Top + MapRect.Top);
      MapXYToActorXY(nMapX, nMapY, nMapX, nMapY);
      sText := IntToStr(nMapX) + ':' + IntToStr(nMapY);
    end
    else if g_nViewMinMapLv = 2 then begin
      nMapX := Round((g_nMinMapX - vtRect.Left) * FMiniMapSurface.Width / DMinMapDlg.Width);
      nMapY := Round((g_nMinMapY - vtRect.Top) * FMiniMapSurface.Height / DMinMapDlg.Height);
      // ScreenToMap(FMiniMapSurface.Width, Width, g_nMinMapX - Left, nMapX);
      // ScreenToMap(FMiniMapSurface.Height, Height, g_nMinMapY - Top, nMapY);

      MapXYToActorXY(nMapX, nMapY, nMapX, nMapY);
      sText := IntToStr(nMapX) + ':' + IntToStr(nMapY);
    end;
    BoldTextOut(vtRect.Right - CurrentFont.TextWidth(sText), vtRect.Bottom - g_CurrentFontHeight, sText, clWhite);
  end
  else if (g_ClientVersion = cvMirNewUI205) then begin
    sText := IntToStr(g_MySelf.m_nCurrX) + ':' + IntToStr(g_MySelf.m_nCurrY);
    BoldTextOut(vtRect.Right - CurrentFont.TextWidth(sText), vtRect.Bottom - g_CurrentFontHeight, sText, clWhite);
  end;
end;

procedure TFrmDlg.SelectChrWindowsPaint205(Sender:TObject);
var
  n, nX, nY, nImageIndex, nWidth, nHeight:Integer;
  /////////////////////////////////////////////////
  nBaseImageIndex, nBaseX, nBaseY:Integer;
  nFixedX, nFixedY:Integer;
  /////////////////////////////////////////////////
  d, E, BaseTexture:TTexture;
  vtRect:TRect;
  DSelectChrWindows:TDxImageForm;
  CurSelChar:PSelChar;

  // 根据基准坐标 获取偏移值 piaoyun 2013-10-16

  procedure GetFrameFixedOffset(nBaseX, nBaseY, _nX, _nY:Integer);
  begin
    nX := _nX - nBaseX;
    nY := _nY - nBaseY;
  end;

  // 获取修正后的特效偏移值 piaoyun 2013-10-16

  procedure GetFixedOffsetBySelChar(SelChar:PSelChar);
  begin
    case SelChar.UserChr.Job of
      0: {// 战} begin
          if SelChar.UserChr.sex = 0 then begin
            nFixedX := 26;
            nFixedY := -127;
          end
          else begin
            nFixedX := -60;
            nFixedY := 50;
          end;
        end;
      1: {// 法} begin
          if SelChar.UserChr.sex = 0 then begin
            nFixedX := -25;
            nFixedY := -25;
          end
          else begin
            nFixedX := 7;
            nFixedY := -73;
          end;
        end;
      2: {// 道} begin
          if SelChar.UserChr.sex = 0 then begin
            nFixedX := -48;
            nFixedY := -105;
          end
          else begin
            nFixedX := 21;
            nFixedY := -21;
          end;
        end;
    end;
  end;

  procedure GetOffsetA(SelChar:PSelChar);
  begin
    if (SelChar.UserChr.Job = 1) then begin
      case SelChar.UserChr.sex of
        0: {//------------OK} begin
            nX := -1;
            nY := -17;
            if SelChar.Unfreezing or SelChar.Freezing or (not SelChar.Selected) then
              nY := 17;
            // 修正图片抖动
              //if SelChar.AniIndex in [0] then
              //  nX := nX + 1;
          end;
      end;
    end // 道士
    else if (SelChar.UserChr.Job = 2) then begin
      case SelChar.UserChr.sex of
        0:begin
            nX := nX - 4;
          end;
        1:begin
            if SelChar.Unfreezing or SelChar.Freezing or (not SelChar.Selected) then
              nY := nY + 1
            else
              nY := nY + 4;
          end;
      end;
    end;
  end;

begin
  // Valid: Boolean;         // 是否是有效人物
  // Selected: Boolean;      // 是否选择
  // FreezeState: Boolean;   // 是否是禁用状态
  // Unfreezing: Boolean;    // 是否正在启用人物
  // Freezing: Boolean;      // 是否正在禁用人物

  DSelectChrWindows := TDxImageForm(Sender);

  vtRect := DSelectChrWindows.VirtualRect;
  nWidth := vtRect.Right - vtRect.Left;
  nHeight := vtRect.Bottom - vtRect.Top;
  n := DSelectChrWindows.Tag + SelectChrScene.m_nChrPage * 2;
  CurSelChar := @SelectChrScene.ChrArr[n];
  if {(n in [0..2]) and}  CurSelChar.Valid then begin
    // 石化 ------> 活动特效
    if CurSelChar.Selected and CurSelChar.Unfreezing then begin
      // 取基准图片帧序
      nBaseImageIndex := 20 + CurSelChar.UserChr.job * 80 + CurSelChar.UserChr.sex * 40;
      // 取基准图片帧纹理
      BaseTexture := g_WNSelectImages.GetCachedImage(nBaseImageIndex, nBaseX, nBaseY);

      // 取当前图片帧序
      nImageIndex := 20 + CurSelChar.UserChr.job * 80 + CurSelChar.UserChr.sex * 40;
      // 取当前图片帧纹理
      d := g_WNSelectImages.GetCachedImage(nImageIndex + CurSelChar.AniIndex, nX, nY);

      // 根据基准X,Y 修正X,Y偏移
      GetFrameFixedOffset(nBaseX, nBaseY, nX, nY);

      // 男法师处理
      if (CurSelChar.UserChr.Job = 1) and (CurSelChar.UserChr.sex = 0) then begin
        GetOffsetA(CurSelChar);
        if d <> nil then
          GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + (nHeight - d.Height) + nY, d);
      end // 男道士处理
      else if (CurSelChar.UserChr.Job = 2) and (CurSelChar.UserChr.sex = 0) then begin
        GetOffsetA(CurSelChar);
        if d <> nil then
          GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);
      end // 女道士处理
      else if (CurSelChar.UserChr.Job = 2) and (CurSelChar.UserChr.sex = 1) then begin
        GetOffsetA(CurSelChar);
        if d <> nil then
          //GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + (nHeight - d.Height) + nY, d);
          GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);
      end
      else begin
        // 开始绘制
        if d <> nil then
          GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);
      end;

      E := g_WNSelectImages.GetCachedImage(480 + CurSelChar.EffIndex, nX, nY);
      if E <> nil then begin
        // 男战士
        if (CurSelChar.UserChr.Job = 0) and (CurSelChar.UserChr.sex = 0) then
          GameCanvas.DrawAlpha(vtRect.Left + 146 + nX, vtRect.Top + 110 + nY, E, 255) // 女战士
        else if (CurSelChar.UserChr.Job = 0) and (CurSelChar.UserChr.sex = 1) then
          GameCanvas.DrawAlpha(vtRect.Left + 175 + nX, vtRect.Top + 110 + nY, E, 255) // 男法师
        else if (CurSelChar.UserChr.Job = 1) and (CurSelChar.UserChr.sex = 0) then
          GameCanvas.DrawAlpha(vtRect.Left + 160 + nX, vtRect.Top + 110 + nY, E, 255) // 女法师
        else if (CurSelChar.UserChr.Job = 1) and (CurSelChar.UserChr.sex = 1) then
          GameCanvas.DrawAlpha(vtRect.Left + 175 + nX, vtRect.Top + 110 + nY, E, 255) // 男道士
        else if (CurSelChar.UserChr.Job = 2) and (CurSelChar.UserChr.sex = 0) then
          GameCanvas.DrawAlpha(vtRect.Left + 175 + nX, vtRect.Top + 110 + nY, E, 255) // 女道士
        else if (CurSelChar.UserChr.Job = 2) and (CurSelChar.UserChr.sex = 1) then
          GameCanvas.DrawAlpha(vtRect.Left + 146 + nX, vtRect.Top + 110 + nY, E, 255)
      end;

      if MyGetTickCount - CurSelChar.StartTime > 100 then begin
        CurSelChar.StartTime := MyGetTickCount;
        CurSelChar.AniIndex := CurSelChar.AniIndex + 1;
      end;
      if MyGetTickCount - CurSelChar.startefftime > 100 then begin
        CurSelChar.startefftime := MyGetTickCount;
        CurSelChar.EffIndex := CurSelChar.EffIndex + 1;
        if CurSelChar.effIndex > 9 then
          CurSelChar.effIndex := 9;
      end;
      if CurSelChar.AniIndex > 9 then begin
        CurSelChar.Unfreezing := False;
        CurSelChar.FreezeState := False;
        CurSelChar.AniIndex := 0;
      end;
    end
    else if not CurSelChar.Selected and (not CurSelChar.FreezeState) and (not CurSelChar.Freezing) then begin
      CurSelChar.Freezing := True;
      CurSelChar.AniIndex := 0;
      CurSelChar.StartTime := MyGetTickCount;
    end;

    // 活动 ------> 石化特效
    if CurSelChar.Freezing and not CurSelChar.Selected then begin
      // 取基准图片帧序
      nBaseImageIndex := 20 + CurSelChar.UserChr.job * 80 + CurSelChar.UserChr.sex * 40 { + FREEZEFRAME - 0 - 2};

      // 取基准图片帧纹理
      BaseTexture := g_WNSelectImages.GetCachedImage(nBaseImageIndex, nBaseX, nBaseY);

      // 取当前图片帧序
      nImageIndex := 20 + CurSelChar.UserChr.job * 80 + CurSelChar.UserChr.sex * 40;
      // 取当前图片帧纹理
      d := g_WNSelectImages.GetCachedImage(nImageIndex + FREEZEFRAME - CurSelChar.AniIndex - 2, nX, nY);

      // 根据基准X,Y 修正X,Y偏移
      GetFrameFixedOffset(nBaseX, nBaseY, nX, nY);

      // 男法师处理
      if (CurSelChar.UserChr.Job = 1) and (CurSelChar.UserChr.sex = 0) then begin
        GetOffsetA(CurSelChar);
        if d <> nil then
          GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + (nHeight - d.Height) + nY, d);
      end
      else if (CurSelChar.UserChr.Job = 2) and (CurSelChar.UserChr.sex = 0) then begin
        GetOffsetA(CurSelChar);
        if d <> nil then
          //GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + (nHeight - d.Height) + nY, d);
          GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);
      end // 女道士处理
      else if (CurSelChar.UserChr.Job = 2) and (CurSelChar.UserChr.sex = 1) then begin
        GetOffsetA(CurSelChar);
        if d <> nil then
          //GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + (nHeight - d.Height) + nY, d);
          GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);
      end
      else begin

        // 开始绘制
        if d <> nil then
          GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);
      end;

      if MyGetTickCount - CurSelChar.StartTime > 50 then begin
        CurSelChar.StartTime := MyGetTickCount;
        CurSelChar.AniIndex := CurSelChar.AniIndex + 1;
      end;

      if CurSelChar.AniIndex > FREEZEFRAME - 2 then begin
        CurSelChar.Freezing := False;
        CurSelChar.FreezeState := True;
        CurSelChar.AniIndex := 0;
      end;
    end;

    if (not CurSelChar.Unfreezing) and (not CurSelChar.Freezing) then begin

      if not CurSelChar.FreezeState then begin
        // 取基准图片帧序
        nBaseImageIndex := 0 + CurSelChar.UserChr.job * 80 + 0 + CurSelChar.UserChr.sex * 40;
        // 取基准图片帧纹理
        BaseTexture := g_WNSelectImages.GetCachedImage(nBaseImageIndex, nBaseX, nBaseY);

        // 取当前图片帧序
        nImageIndex := 0 + CurSelChar.UserChr.job * 80 + CurSelChar.AniIndex + CurSelChar.UserChr.sex * 40;
        // 取当前图片帧纹理
        d := g_WNSelectImages.GetCachedImage(nImageIndex, nX, nY);

        // 根据基准X,Y 修正X,Y偏移
        GetFrameFixedOffset(nBaseX, nBaseY, nX, nY);

        // 开始绘制
        if d <> nil then
          GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);

        //////////////////////////绘制角色特效///////////////////////////////
        // 取基准图片帧序
        nBaseImageIndex := 320 + CurSelChar.UserChr.job * 40 + 0 + CurSelChar.UserChr.sex * 20;
        // 取基准图片帧纹理
        BaseTexture := g_WNSelectImages.GetCachedImage(nBaseImageIndex, nBaseX, nBaseY);

        // 取当前图片帧序
        nImageIndex := 320 + CurSelChar.UserChr.job * 40 + CurSelChar.AniIndex + CurSelChar.UserChr.sex * 20;
        // 取当前图片帧纹理
        d := g_WNSelectImages.GetCachedImage(nImageIndex, nX, nY);

        // 根据基准X,Y 修正X,Y偏移
        GetFrameFixedOffset(nBaseX, nBaseY, nX, nY);

        // 获取二次修正偏移
        GetFixedOffsetBySelChar(CurSelChar);

        if d <> nil then
          GameCanvas.DrawBlend(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX + nFixedX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY + nFixedY, d);
      end
      else begin
        //nImageIndex := 140 - 80 + CurSelChar.UserChr.job * 40 + CurSelChar.UserChr.sex * 120;
        {nImageIndex := 20 + CurSelChar.UserChr.job * 80 + CurSelChar.UserChr.sex * 40;
        d := g_WNSelectImages.Images[nImageIndex];
        if d <> nil then
          GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + (nHeight - d.Height) + nY, d);
        }
        // 取基准图片帧序
        nBaseImageIndex := 20 + CurSelChar.UserChr.job * 80 + CurSelChar.UserChr.sex * 40;
        // 取基准图片帧纹理
        BaseTexture := g_WNSelectImages.GetCachedImage(nBaseImageIndex, nBaseX, nBaseY);

        // 取当前图片帧序
        nImageIndex := 20 + CurSelChar.UserChr.job * 80 + CurSelChar.UserChr.sex * 40;
        // 取当前图片帧纹理
        d := g_WNSelectImages.GetCachedImage(nImageIndex, nX, nY);

        // 根据基准X,Y 修正X,Y偏移
        GetFrameFixedOffset(nBaseX, nBaseY, nX, nY);

        if (CurSelChar.UserChr.Job = 1) and (CurSelChar.UserChr.sex = 0) then begin
          GetOffsetA(CurSelChar);
          if d <> nil then
            GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + (nHeight - d.Height) + nY, d);
        end // 男道士处理
        else if (CurSelChar.UserChr.Job = 2) and (CurSelChar.UserChr.sex = 0) then begin
          GetOffsetA(CurSelChar);
          if d <> nil then
            //GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + (nHeight - d.Height) + nY, d);
            GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);
        end // 女道士处理
        else if (CurSelChar.UserChr.Job = 2) and (CurSelChar.UserChr.sex = 1) then begin
          GetOffsetA(CurSelChar);
          if d <> nil then
            //GameCanvas.Draw(vtRect.Left + nX, vtRect.Top + (nHeight - d.Height) + nY, d);
            GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);
        end
        else begin
          // 开始绘制
          if d <> nil then
            GameCanvas.Draw(vtRect.Left + (nWidth - BaseTexture.Width) div 2 + nX, vtRect.Top + (nHeight - BaseTexture.Height) div 2 + nY, d);
        end;
      end;

      if CurSelChar.Selected then begin
        if MyGetTickCount - CurSelChar.StartTime > 300 then begin
          CurSelChar.StartTime := MyGetTickCount;
          CurSelChar.AniIndex := CurSelChar.AniIndex + 1;
          if CurSelChar.AniIndex > SELECTEDFRAME - 5 then
            CurSelChar.AniIndex := 0;
        end;
        if MyGetTickCount - CurSelChar.moretime > 25 then begin
          CurSelChar.moretime := MyGetTickCount;
          if CurSelChar.DarkLevel > 0 then
            CurSelChar.DarkLevel := CurSelChar.DarkLevel - 1;
        end;
      end;
    end;
  end;
end;

procedure TFrmDlg.SelectChrWindowsPaint(Sender:TObject);
var
  n, nX, nY, nImageIndex, nWidth, nHeight:Integer;
  d, E:TTexture;
  vtRect:TRect;
  DSelectChrWindows:TDxImageForm;
begin
  // Valid: Boolean;         //是否是有效人物
  // Selected: Boolean;      //是否选择
  // FreezeState: Boolean; //是否是禁用状态
  // Unfreezing: Boolean; //是否正在启用人物
  // Freezing: Boolean; //是否正在禁用人物
  if g_ClientVersion = cvMirNewUI205 then begin
    SelectChrWindowsPaint205(Sender);
    Exit;
  end;

  DSelectChrWindows := TDxImageForm(Sender);
  with SelectChrScene do begin
    vtRect := DSelectChrWindows.VirtualRect;
    nWidth := vtRect.Right - vtRect.Left;
    nHeight := vtRect.Bottom - vtRect.Top;
    n := DSelectChrWindows.Tag + m_nChrPage * 2;
    if {(n in [0..2]) and}  ChrArr[n].Valid then begin
      nX := 0;
      nY := 0;
      if ChrArr[n].UserChr.Job = 0 then begin
        nX := -20;
      end;

      if ChrArr[n].UserChr.sex = 0 then begin
        if ChrArr[n].UserChr.Job = 1 then
          nY := -16
        else
          nY := -12;
      end;

      if ChrArr[n].Selected and ChrArr[n].Unfreezing then begin
        nImageIndex := 140 - 80 + ChrArr[n].UserChr.job * 40 + ChrArr[n].UserChr.sex * 120;
        d := g_WChrSelImages.Images[nImageIndex + ChrArr[n].AniIndex];
        E := g_WChrSelImages.Images[4 + ChrArr[n].EffIndex];

        if d <> nil then
          GameCanvas.Draw(vtRect.Left + (nWidth - d.Width) div 2 + nX, vtRect.Top + (nHeight - d.Height) div 2 + nY, d);

        if E <> nil then
          GameCanvas.DrawBlend(vtRect.Left + (nWidth - E.Width) div 2, vtRect.Top + (nHeight - E.Height) div 2 + nY, E);

        if MyGetTickCount - ChrArr[n].StartTime > 50 then begin
          ChrArr[n].StartTime := MyGetTickCount;
          ChrArr[n].AniIndex := ChrArr[n].AniIndex + 1;
        end;
        if MyGetTickCount - ChrArr[n].startefftime > 50 then begin
          ChrArr[n].startefftime := MyGetTickCount;
          ChrArr[n].EffIndex := ChrArr[n].EffIndex + 1;
          if ChrArr[n].effIndex > EFFECTFRAME - 1 then
            ChrArr[n].effIndex := EFFECTFRAME - 1;
        end;
        if ChrArr[n].AniIndex > FREEZEFRAME - 1 then begin
          ChrArr[n].Unfreezing := False;
          ChrArr[n].FreezeState := False;
          ChrArr[n].AniIndex := 0;
        end;
      end
      else if not ChrArr[n].Selected and (not ChrArr[n].FreezeState) and (not ChrArr[n].Freezing) then begin
        ChrArr[n].Freezing := True;
        ChrArr[n].AniIndex := 0;
        ChrArr[n].StartTime := MyGetTickCount;
      end;

      if ChrArr[n].Freezing and not ChrArr[n].Selected then begin
        nImageIndex := 140 - 80 + ChrArr[n].UserChr.job * 40 + ChrArr[n].UserChr.sex * 120;
        d := g_WChrSelImages.Images[nImageIndex + FREEZEFRAME - ChrArr[n].AniIndex - 1];

        if d <> nil then
          GameCanvas.Draw(vtRect.Left + (nWidth - d.Width) div 2 + nX, vtRect.Top + (nHeight - d.Height) div 2 + nY, d);

        if MyGetTickCount - ChrArr[n].StartTime > 50 then begin
          ChrArr[n].StartTime := MyGetTickCount;
          ChrArr[n].AniIndex := ChrArr[n].AniIndex + 1;
        end;

        if ChrArr[n].AniIndex > FREEZEFRAME - 1 then begin
          ChrArr[n].Freezing := False;
          ChrArr[n].FreezeState := True;
          ChrArr[n].AniIndex := 0;
        end;
      end;

      if (not ChrArr[n].Unfreezing) and (not ChrArr[n].Freezing) then begin
        if not ChrArr[n].FreezeState then begin
          nImageIndex := 120 - 80 + ChrArr[n].UserChr.job * 40 + ChrArr[n].AniIndex + ChrArr[n].UserChr.sex * 120;
          d := g_WChrSelImages.Images[nImageIndex];

          // 修正女道士、女法师选择角色后会偏移
          if (ChrArr[n].UserChr.sex = 1) then begin
            if (ChrArr[n].UserChr.job = 1) then begin
              nX := nX - 8;
              nY := nY - 4;
            end
            else if (ChrArr[n].UserChr.job = 2) then begin
              nX := nX - 3;
              nY := nY - 7;
            end;
          end;

          if d <> nil then begin
            if d <> nil then begin
              GameCanvas.Draw(vtRect.Left + (nWidth - d.Width) div 2 + nX, vtRect.Top + (nHeight - d.Height) div 2 + nY, d);
            end;
          end;
        end
        else begin
          nImageIndex := 140 - 80 + ChrArr[n].UserChr.job * 40 + ChrArr[n].UserChr.sex * 120;
          d := g_WChrSelImages.Images[nImageIndex];
          if d <> nil then
            GameCanvas.Draw(vtRect.Left + (nWidth - d.Width) div 2 + nX, vtRect.Top + (nHeight - d.Height) div 2 + nY, d);
        end;

        if ChrArr[n].Selected then begin
          if MyGetTickCount - ChrArr[n].StartTime > 300 then begin
            ChrArr[n].StartTime := MyGetTickCount;
            ChrArr[n].AniIndex := ChrArr[n].AniIndex + 1;
            if ChrArr[n].AniIndex > SELECTEDFRAME - 1 then
              ChrArr[n].AniIndex := 0;
          end;
          if MyGetTickCount - ChrArr[n].moretime > 25 then begin
            ChrArr[n].moretime := MyGetTickCount;
            if ChrArr[n].DarkLevel > 0 then
              ChrArr[n].DarkLevel := ChrArr[n].DarkLevel - 1;
          end;
        end;
      end;
    end;
  end;
end;

