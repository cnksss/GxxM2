procedure WriteOutStr(Msg:string);
var
  flname:string;
  fhandle:TextFile;
begin

  flname := '.\Test.txt';
  if FileExists(flname) then begin
    AssignFile(fhandle, flname);
    Append(fhandle);
  end
  else begin
    AssignFile(fhandle, flname);
    Rewrite(fhandle);
  end;
  Writeln(fhandle, TimeToStr(Time) + ' ' + Msg);
  CloseFile(fhandle);
end;

constructor TNpcButton.Create(AOwner:TDxControl);
begin
  inherited Create(AOwner);
  m_sPostText := '';
  m_sCmd := '';
  m_nStartImageIndex := 0;
  m_nStopImageCount := 0;
  m_nImageIndex := 0;

  m_dwPlayImageTick := MyGetTickCount;
  m_dwPlayImageTime := 300;

  m_boBlend := False;

  m_nShowBG := 0;

  m_TextureOffset := Point(0, 0);
end;

destructor TNpcButton.Destroy;
begin
  inherited;
end;

procedure TNpcButton.Update();
begin
  inherited;
  if (AddData1 > 0) and (AddData2 >= AddData1) then
    Exit;

  if m_nStopImageCount > m_nStartImageIndex then begin
    // DebugOutStr(Format('TNpcButton.UpDate %d %d',[MyGetTickCount - m_dwPlayImageTick,m_dwPlayImageTime]));
    if MyGetTickCount - m_dwPlayImageTick > m_dwPlayImageTime then begin
      m_dwPlayImageTick := MyGetTickCount;
      Inc(m_nImageIndex);
      if (m_nImageIndex < 0) or (m_nImageIndex > m_nStopImageCount) then begin
        m_nImageIndex := m_nStartImageIndex;

        if AddData1 > 0 then
          AddData2 := AddData2 + 1;
        // DebugOutStr(Format('2 TNpcButton.UpDate %d %d',[MyGetTickCount - m_dwPlayImageTick,m_dwPlayImageTime]));
      end;
      ImageIndex.Up := m_nImageIndex;
    end;
  end;
end;

constructor TNpcLabel.Create(AOwner:TDxControl);
