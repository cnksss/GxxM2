                end;
              end;
            end;

            Inc(nX, HintWindow.Width);
            HintWindows.Add(HintWindow);
          end;
        end
        else begin
          for I := 0 to HintList.Count - 1 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            HintWindow.X := nX;
            HintWindow.Y := nY;

            // 旧模式斗笠显示黄色字 chongchong 2013-12-17
            if g_ClientConfig.boUseOldSerialWindows then begin
