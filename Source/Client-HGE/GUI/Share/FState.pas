procedure TFrmDlg.DMenuBuyClick(Sender:TObject; X, Y:Integer);
var
  pg:PTClientGoods;
  nC:Integer;
begin
  if MyGetTickCount < LastestClickTime then
    Exit;
  if (menuindex >= 0) and (menuindex < MenuList.Count) then begin
    LastestClickTime := MyGetTickCount + 5000;
    pg := PTClientGoods(MenuList[MenuIndex]);

    if pg.SubMenu > 0 then begin
      // 请求二级物品列表回来
      FrmMain.SendGetDetailItem(g_nCurMerchant, 0, pg.Name, False);
      MenuTopLine := 0;
      CurDetailItem := pg.Name;
    end else begin
      if BoStorageMenu then begin
        {$IF PRIVATE_CLIENT = 0}
        {.$I VMProtectBegin.inc}
        {$IFEND}
        if pg.Count > 1 then begin
          // 重叠物品
          DMessageDlg('请输入要取回的数量：', [mbOk, mbAbort]);
          nC := StrToIntDef(Trim(DlgEditText), 1);
          if nC <= 0 then
            nC := 1;
          if nC > pg.Count then
            nC := pg.Count;
        end else begin
          nC := 1;
        end;
        g_IsWaitStorageBackItem := True;
        frmMain.SendTakeBackStorageItem(g_nCurMerchant, pg.Price {MakeIndex}, nC, pg.RealName);
        {$IF PRIVATE_CLIENT = 0}
        {.$I VMProtectEnd.inc}
        {$IFEND}
        Exit;
      end;

      if BoMakeDrugMenu then begin
        frmMain.SendMakeDrugItem(g_nCurMerchant, pg.Name);
        Exit;
      end;
      if pg.Count > 1 then begin // 重叠物品
        DMessageDlg('请输入要购买的数量：', [mbOk, mbAbort]);
        nC := StrToIntDef(Trim(DlgEditText), 1);
        if nC <= 0 then
          nC := 1;
        if nC > pg.Count then
          nC := pg.Count;
      end else begin
        nC := 1;
      end;
      frmMain.SendBuyItem(g_nCurMerchant, pg.Stock, nC, pg.RealName, False)
    end;
  end;
end;

procedure TFrmDlg.DMenuPrevClick(Sender:TObject; X, Y:Integer);
begin
  if not BoDetailMenu then begin
    if MenuTop > 0 then
      Dec(MenuTop, MAXMENU - 1);
    if MenuTop < 0 then
      MenuTop := 0;
  end
  else begin
    if MenuTopLine > 0 then begin
      MenuTopLine := _MAX(0, MenuTopLine - 10);
      frmMain.SendGetDetailItem(g_nCurMerchant, MenuTopLine, CurDetailItem, False);
    end;
  end;
end;

procedure TFrmDlg.DMenuNextClick(Sender:TObject; X, Y:Integer);
begin
  // DScreen.AddChatBoardString(Format('1 DMenuNextClick %d %d',[MenuTop,MenuList.Count]), clRed, clWhite);
  if not BoDetailMenu then begin
    // DScreen.AddChatBoardString(Format('2 DMenuNextClick %d %d',[MenuTop,MenuList.Count]), clRed, clWhite);
    if MenuTop + MAXMENU < MenuList.Count then
      Inc(MenuTop, MAXMENU - 1);
  end
  else begin
    MenuTopLine := MenuTopLine + 10;
    frmMain.SendGetDetailItem(g_nCurMerchant, MenuTopLine, CurDetailItem, False);
    // DScreen.AddChatBoardString(Format('3 DMenuNextClick %d %d %s',[MenuTopLine,MenuList.Count,CurDetailItem]), clRed, clWhite);
  end;
end;

procedure TFrmDlg.SoldOutGoods(nMakeIndex, nItemCount:Integer; sData:string; IsFromTradingDlg:Boolean);
var
  I, II:Integer;
  pg:PTClientGoods;
  gname, gsub, gprice, gstock, gcount, gGrade:string;
  Item:PTClientItem;
begin
  // DScreen.AddChatBoardString('nMakeIndex:' + inttostr(nMakeIndex)+' nItemCount:' + inttostr(nItemCount)+ ' sData:' + sData, clYellow, clRed);
  if not IsFromTradingDlg then begin
    MenuList.Lock;
    try
      for I := 0 to MenuList.Count - 1 do begin
        pg := PTClientGoods(MenuList[I]);
        if {(pg.Grade >= 0) and}(pg.Stock = nMakeIndex) then begin
          // DScreen.AddChatBoardString('pg.Stock:' + inttostr(pg.Stock)+' I:' + inttostr(I), clYellow, clRed);
          if nItemCount <= 0 then begin
            if sData = '' then begin
              Dispose(pg);
              MenuList.Delete(I);
              if I < g_MenuItemList.Count then
                g_MenuItemList.Delete(I);
              if menuindex > MenuList.Count - 1 then
                menuindex := MenuList.Count - 1;
              // DScreen.AddChatBoardString('1 SoldOutGoods nMakeIndex:' + inttostr(nMakeIndex) + 'I:' + inttostr(I) + ' sData:' + sData, clYellow, clRed);
            end
            else begin
              if sData[1] = '+' then begin
                sData := Copy(sData, 2, Length(sData) - 1);
                sData := GetValidStr3_Ex(sData, gname, '/');
                sData := GetValidStr3_Ex(sData, gprice, '/');
                sData := GetValidStr3_Ex(sData, gstock, '/');
                sData := GetValidStr3_Ex(sData, gGrade, '/');
                sData := GetValidStr3_Ex(sData, gcount, '/');
                if (gname <> '') and (gprice <> '') and (gstock <> '') then begin
                  { Dispose(pg);
                   MenuList.Delete(I);
                   if I < g_MenuItemList.Count then g_MenuItemList.Delete(I);
                   if menuindex > MenuList.Count - 1 then menuindex := MenuList.Count - 1;
                   New(pg);}

                  pg.Name := gname;
                  pg.SubMenu := 0;
                  pg.Price := StrToIntDef(gprice, 0);
                  pg.Stock := StrToIntDef(gstock, 0);
                  pg.Grade := Round(StrToIntDef(gGrade, 0) / 1000);
                  pg.Count := StrToIntDef(gcount, 1);
                end
                else begin
                  Dispose(pg);
                  MenuList.Delete(I);
                  if I < g_MenuItemList.Count then
                    g_MenuItemList.Delete(I);
                  if menuindex > MenuList.Count - 1 then
                    menuindex := MenuList.Count - 1;
                end;
              end
              else begin
                // DScreen.AddChatBoardString('2 SoldOutGoods nMakeIndex:' + inttostr(nMakeIndex) + 'nItemCount:' + inttostr(nItemCount) + ' sData:' + sData, clYellow, clRed);
                sData := GetValidStr3_Ex(sData, gname, '/');
                sData := GetValidStr3_Ex(sData, gsub, '/');
                sData := GetValidStr3_Ex(sData, gprice, '/');
                sData := GetValidStr3_Ex(sData, gstock, '/');
                sData := GetValidStr3_Ex(sData, gcount, '/');
                if (gname <> '') and (gprice <> '') and (gstock <> '') then begin
                  // DScreen.AddChatBoardString('3 SoldOutGoods nMakeIndex:' + inttostr(nMakeIndex) + 'nItemCount:' + inttostr(nItemCount) + ' sData:' + sData, clYellow, clRed);
                  pg.Name := gname;
                  pg.SubMenu := StrToIntDef(gsub, 0);
                  pg.Price := StrToIntDef(gprice, 0);
                  pg.Stock := StrToIntDef(gstock, 0);
                  pg.Count := StrToIntDef(gcount, 1);
                  pg.Grade := -1;

                end
                else begin
                  Dispose(pg);
                  MenuList.Delete(I);
                  if I < g_MenuItemList.Count then
                    g_MenuItemList.Delete(I);
                  if menuindex > MenuList.Count - 1 then
                    menuindex := MenuList.Count - 1;
                  // DScreen.AddChatBoardString('4 SoldOutGoods nMakeIndex:' + inttostr(nMakeIndex) + 'nItemCount:' + inttostr(nItemCount) + ' sData:' + sData, clYellow, clRed);
                end
              end;
            end;
          end
          else begin
            pg.Count := nItemCount;
            pg.Price := StrToIntDef(sData, pg.Price);
          end;
          Break;
        end;
      end;
    finally
      MenuList.UnLock;
    end;
  end
  else begin
    g_MenuItemList.Lock;
    try
      for I := 0 to g_MenuItemList.Count - 1 do begin
        Item := g_MenuItemList.Items[I];
        if ((Item.MakeIndex = -1) and (Item.s.Expand2 = nMakeIndex)) or (Item.MakeIndex = nMakeIndex) then begin
          if nItemCount <= 0 then begin
            if sData = '' then begin
              g_MenuItemList.Delete(I);

              if g_MenuItemList.Count = 0 then begin
                if Length(Item.s.DBName) > 0 then begin
                  for II := 0 to MenuList.Count - 1 do begin
                    pg := PTClientGoods(MenuList[II]);
                    if SameText(pg.Name, Item.s.DBName) then begin
                      Dispose(pg);
                      MenuList.Delete(II);
                      Break;
                    end;
                  end;
                end;
              end;

              Dispose(Item);
            end
            else begin
              if sData[1] = '+' then begin
                sData := Copy(sData, 2, Length(sData) - 1);
                sData := GetValidStr3_Ex(sData, gname, '/');
                sData := GetValidStr3_Ex(sData, gprice, '/');
                sData := GetValidStr3_Ex(sData, gstock, '/');
                sData := GetValidStr3_Ex(sData, gGrade, '/');
                sData := GetValidStr3_Ex(sData, gcount, '/');
                if (gname <> '') and (gprice <> '') and (gstock <> '') then begin
                  if Item.MakeIndex = -1 then begin
                    Item.s.Name := gname;
                    Item.Dura := StrToIntDef(gcount, 1);
                    Item.DuraMax := StrToIntDef(gprice, 0);
                    Item.s.Expand2 := StrToIntDef(gstock, 0);
                  end
                  else begin
                    Item.s.Name := gname;
                    Item.MakeIndex := StrToIntDef(gstock, 0);
                    Item.Dura := StrToIntDef(gcount, 1);
                    Item.s.Expand1 := StrToIntDef(gprice, 0);
                  end;
                end
                else begin
                  if I < g_MenuItemList.Count then
                    g_MenuItemList.Delete(I);
                end;
              end
              else begin
                // DScreen.AddChatBoardString('2 SoldOutGoods nMakeIndex:' + inttostr(nMakeIndex) + 'nItemCount:' + inttostr(nItemCount) + ' sData:' + sData, clYellow, clRed);
                sData := GetValidStr3_Ex(sData, gname, '/');
                sData := GetValidStr3_Ex(sData, gsub, '/');
                sData := GetValidStr3_Ex(sData, gprice, '/');
                sData := GetValidStr3_Ex(sData, gstock, '/');
                sData := GetValidStr3_Ex(sData, gcount, '/');
                if (gname <> '') and (gprice <> '') and (gstock <> '') then begin
                  if Item.MakeIndex = -1 then begin
                    Item.s.Name := gname;
                    Item.Dura := StrToIntDef(gcount, 1);
                    Item.DuraMax := StrToIntDef(gprice, 0);
                    Item.s.Expand2 := StrToIntDef(gstock, 0);
                  end
                  else begin
                    Item.s.Name := gname;
                    Item.MakeIndex := StrToIntDef(gstock, 0);
                    Item.Dura := StrToIntDef(gcount, 1);
                    Item.s.Expand1 := StrToIntDef(gprice, 0);
                  end;
                end
                else begin
                  if I < g_MenuItemList.Count then
                    g_MenuItemList.Delete(I);
                end
              end;
            end;
          end
          else begin
            if Item.MakeIndex = -1 then begin
              Item.Dura := nItemCount;
              Item.DuraMax := StrToIntDef(sData, Item.DuraMax);
            end
            else begin
              Item.Dura := nItemCount;
              Item.s.Expand1 := StrToIntDef(sData, Item.s.Expand1);
            end;
          end;
          Break;
        end;
      end;
    finally
      g_MenuItemList.UnLock;
    end;
  end;
end;

procedure TFrmDlg.DelStorageItem(itemserverindex, nCount:Integer);
var
  I:Integer;
  pg:PTClientGoods;
begin
  MenuList.Lock;
  try
    for I := 0 to MenuList.Count - 1 do begin
      pg := PTClientGoods(MenuList[I]);
      if (pg.Price = itemserverindex) then begin
        if nCount <= 0 then begin
          MenuList.Delete(I);
          if I < g_SaveItemList.Count then
            g_SaveItemList.Delete(I);
          if menuindex > MenuList.Count - 1 then
            menuindex := MenuList.Count - 1;
          Dispose(pg);
        end
        else begin
          pg.Count := nCount;
        end;
        Break;
      end;
    end;
  finally
    MenuList.UnLock;
  end;
end;

function GetPostTextLabel(NpcLabel:TNpcLabel; var S:string; var FocuseCtrl:TDxControl):Boolean;
var
  I, Value:Integer;
  AOnwer, Ctrl:TDxControl;
  IsPosAll:Boolean;
  SL:TStringList;
  NpcEdit:TNpcInputEdit;
begin
  Result := False;
  S := '';
  FocuseCtrl := nil;
  AOnwer := NpcLabel.Owner;

  if Length(NpcLabel.m_sPostText) = 0 then begin
    Result := True;
    Exit;
  end;

  SL := TStringList.Create;
  try
    IsPosAll := NpcLabel.m_sPostText = '*';
    if not IsPosAll then begin
      SL.Delimiter := ',';
      SL.DelimitedText := NpcLabel.m_sPostText;
    end;
    for I := AOnwer.ComponentCount - 1 downto 0 do begin
      Ctrl := AOnwer.Components[I];
      if (Ctrl.Visible) then begin
        if (Ctrl is TNpcInputEdit) then begin
          NpcEdit := Ctrl as TNpcInputEdit;

          if IsPosAll or (SL.IndexOf(IntToStr(NpcEdit.m_ID)) >= 0) then begin
            if NpcEdit.m_IsNumber then begin
              if not TryStrToInt(NpcEdit.Text, Value) then begin
                S := NpcEdit.m_ValidityTips;
                FocuseCtrl := NpcEdit;
                Exit;
              end;
              if (NpcEdit.m_MinValue <> 0) or (NpcEdit.m_MaxValue <> 0) then begin
                if ((Value < NpcEdit.m_MinValue) or (Value > NpcEdit.m_MaxValue)) and (Length(NpcEdit.m_ValidityTips) > 0) then begin
                  S := NpcEdit.m_ValidityTips;
                  FocuseCtrl := NpcEdit;
                  Exit;
                end;
              end;
            end
            else begin
              if (NpcEdit.m_MinValue <> 0) or (NpcEdit.m_MaxValue <> 0) then begin
                if (NpcEdit.m_MinValue > 0) and (Length(NpcEdit.Text) < NpcEdit.m_MinValue) and (Length(NpcEdit.m_ValidityTips) > 0) then begin
                  S := NpcEdit.m_ValidityTips;
                  FocuseCtrl := NpcEdit;
                  Exit;
                end;

                if (NpcEdit.m_MaxValue > 0) and (Length(NpcEdit.Text) > NpcEdit.m_MaxValue) and (Length(NpcEdit.m_ValidityTips) > 0) then begin
                  S := NpcEdit.m_ValidityTips;
                  FocuseCtrl := NpcEdit;
                  Exit;
                end;
              end;

              if GetInputBoxInFilterList(NpcEdit.Text) then begin
                S := DecodeResStr(SInputNumFilter);
                FocuseCtrl := NpcEdit;
                Exit;
              end;
            end;

            S := S + #13 + IntToStr(NpcEdit.m_ID) + ':' + NpcEdit.Text;
          end;
        end;
      end;
    end;
    Result := True;
  finally
    SL.Free;
  end;
end;

