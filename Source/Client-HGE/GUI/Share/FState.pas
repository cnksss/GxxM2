  vtRect:TRect;
  ItemName, sLine1, sLine2, sLine3:string;
  I, nX, nY:Integer;
  IsUseableLine2, IsUseableLine3:Boolean;
  HintWindow:THintWindow;
  ShowHintLists:array of THintLines;
  ShowHintLines:THintLines;

  function ShowHint(sMsg:string; Color:TColor):THintLines;
  begin
    SetLength(ShowHintLists, Length(ShowHintLists) + 1);
    ShowHintLists[Length(ShowHintLists) - 1] := THintLines.Create;
    ShowHintLists[Length(ShowHintLists) - 1].Add(sMsg, Color, GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke(True));
    Result := ShowHintLists[Length(ShowHintLists) - 1];
  end;

begin
  DScreen.ClearHint;
  HintWindows.Clear;
  vtRect := _ListViewMenuDlg.VirtualRect;

  lx := X - vtRect.Left;
  ly := Y - vtRect.Top;

  if (lx >= 0) and (lx <= _ListViewMenuDlg.Width) and (ly >= 0) then begin
    idx := ly div _ListViewMenuDlg.ItemHeight + MenuTop;
    if idx < MenuList.Count then begin
      PlaySound(s_glass_button_click);
      menuindex := idx;
    end
    else
      menuindex := -1;
  end
  else
    menuindex := -1;

  if BoStorageMenu then begin
    if (menuindex >= 0) and (menuindex < g_SaveItemList.Count) then begin
      g_MouseItem := PTClientItem(g_SaveItemList[menuindex])^;
      if (g_ClientConfig.btSuspensionShowItem > 0) or (g_ClientVersion > cvSerial) then begin
        ShowMouseItemInfo(g_MySelf, @g_MouseItem, vtRect.Left + 240, vtRect.Top + (menuindex - MenuTop) * _ListViewMenuDlg.ItemHeight, True);
      end
      else begin
        GetMouseItemInfo(g_MySelf, @g_MouseItem, True, ItemName, sLine1, sLine2, sLine3, IsUseableLine2, IsUseableLine3);

        ShowHintLines := ShowHint(ItemName, clYellow);
        ShowHintLines.Add(sLine1, clWhite, GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke(True));
        if sLine2 <> '' then
          ShowHint(sLine2, clWhite);
        if sLine3 <> '' then
          ShowHint(sLine3, clWhite);

        HintWindow := THintWindow.Create;
        for I := 0 to Length(ShowHintLists) - 1 do begin
          HintWindow.Add(ShowHintLists[I]);
        end;

        nX := vtRect.Left + 240;
        nY := vtRect.Top + (menuindex - MenuTop) * _ListViewMenuDlg.ItemHeight;
        ShowMouseItemInfo(g_MySelf, @g_MouseItem, nX, nY, True, HintWindow);
      end;
    end
    else begin
      DScreen.ClearHint;
      HintWindows.Clear;
    end;
  end
  else begin
    if (menuindex >= 0) and (menuindex < g_MenuItemList.Count) and (PTClientGoods(MenuList[menuindex]).SubMenu = 0) then begin
      g_MouseItem := PTClientItem(g_MenuItemList[menuindex])^;
      BoNoDisplayMaxDura := True;
      if (g_ClientConfig.btSuspensionShowItem > 0) or (g_ClientVersion > cvSerial) then begin
        ShowMouseItemInfo(g_MySelf, @g_MouseItem, vtRect.Left + 240, vtRect.Top + (menuindex - MenuTop) * _ListViewMenuDlg.ItemHeight, True);
      end
      else begin
        GetMouseItemInfo(g_MySelf, @g_MouseItem, True, ItemName, sLine1, sLine2, sLine3, IsUseableLine2, IsUseableLine3);

        ShowHintLines := ShowHint(ItemName, clYellow);
        ShowHintLines.Add(sLine1, clWhite, GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke(True));

        if sLine2 <> '' then
          ShowHint(sLine2, clWhite);
        if sLine3 <> '' then
          ShowHint(sLine3, clWhite);

        HintWindow := THintWindow.Create;
        for I := 0 to Length(ShowHintLists) - 1 do begin
          HintWindow.Add(ShowHintLists[I]);
        end;
        nX := vtRect.Left + 240;
        nY := vtRect.Top + (menuindex - MenuTop) * _ListViewMenuDlg.ItemHeight;

        ShowMouseItemInfo(g_MySelf, @g_MouseItem, nX, nY, True, HintWindow);
      end;
    end
    else begin
      DScreen.ClearHint;
      HintWindows.Clear;
    end;
  end;
end;

