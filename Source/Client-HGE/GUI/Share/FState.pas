procedure TFrmDlg.DDiceDlgProcess(Sender:TObject);

  procedure ShowDice();
  var
    I, nTemp:Integer;
    boFinished:Boolean;
  begin
    if m_nDiceCount = 1 then begin
      if m_Dice[0].nRunIndex < 20 then begin
        if MyGetTickCount - m_Dice[0].dwPlayTick > 100 then begin
          Inc(m_Dice[0].nRunIndex);

          // Items.wzl 383-386播放完4张动画后，从376-381中随机选一个
          nTemp := m_Dice[0].nRunIndex mod 5;
          if nTemp = 0 then begin
            m_Dice[0].nPlayPoint := Random(6) + 1;
          end
          else begin
            m_Dice[0].nPlayPoint := nTemp + 7;
          end;

          m_Dice[0].dwPlayTick := MyGetTickCount();
        end;

        Exit;
      end;

      // 最后定位到服务器给的点数
      m_Dice[0].nPlayPoint := m_Dice[0].nDicePoint;

      if MyGetTickCount - m_Dice[0].dwPlayTick >= 1500 then
        TDxImageForm(Sender).Visible := False;

      Exit;
    end;

    boFinished := True;
    for I := 0 to m_nDiceCount - 1 do begin
      if m_Dice[I].nRunIndex < m_Dice[I].nRunCount then begin
        if MyGetTickCount - m_Dice[I].dwPlayTick > 100 then begin
          Inc(m_Dice[I].nRunIndex);

          nTemp := m_Dice[I].nRunIndex mod 5;
          if nTemp = 0 then begin
            m_Dice[I].nPlayPoint := Random(6) + 1;
          end
          else begin
            m_Dice[I].nPlayPoint := nTemp + 7;
          end;

          m_Dice[I].dwPlayTick := MyGetTickCount();
        end;

        boFinished := False;
      end
      else begin
        m_Dice[I].nPlayPoint := m_Dice[I].nDicePoint;
        if MyGetTickCount - m_Dice[I].dwPlayTick < 1500 then begin
          boFinished := False
        end;
      end;
    end;

    if boFinished then
      TDxImageForm(Sender).Visible := False;
  end;

var
  I:Integer;
begin
  if (m_nDiceCount > 0) then begin
    m_boPlayDice := True;

    for I := 0 to m_nDiceCount - 1 do begin
      m_Dice[I].nX := ((TDxImageForm(Sender).Width div 2 + 6) - ((m_nDiceCount * 32 + m_nDiceCount) div 2)) + (I * 32 + I);
      m_Dice[I].nY := TDxImageForm(Sender).Height div 2 - 14;
    end;
    ShowDice();
  end;
end;

