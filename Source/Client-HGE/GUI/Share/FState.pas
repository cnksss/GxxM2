function TFrmDlg.CreateNpcQRButtonFromText(sText:string; AOwner:TDxControl; nX, nY:Integer; nDID:Integer):TNpcGraphicButton;
var
  sCmd, sQRCodeStr, sN, sQRCodeSize, sLeft, sTop:string;
  nQRCodeSize, nLeft, nTop:Integer;
begin
  Result := nil;
  sText := GetValidStr3_Ex(sText, sCmd, ':');

  if sText = '' then Exit;

  if sText <> '' then begin
    sText := GetValidStr3_Ex(sText, sN, ':');
    sText := GetValidStr3_Ex(sText, sQRCodeSize, ':');
    sText := GetValidStr3_Ex(sText, sLeft, ':');
    sQRCodeStr := GetValidStr3_Ex(sText, sTop, ':');

    nQRCodeSize := Str_ToInt(sQRCodeSize, 64);
    nLeft := Str_ToInt(sLeft, 0);
    nTop := Str_ToInt(sTop, 0);

    if sQRCodeStr <> '' then begin
      //sQRCodeStr := StringReplace(sQRCodeStr, '%', '/', [rfReplaceAll]);
      Result := TNpcGraphicButton.Create(AOwner);
      Result.ControlID := nDID;
      //Result.Left := Ord(nDID = 0) * nX + nLeft;
      //Result.Top := Ord(nDID = 0) * nY + nTop;
      Result.Left := nLeft;
      Result.Top := nTop;
      Result.Designing := False; //IsDesigning;
      Result.GraphicTexture := MShare.CreateQRCodeTexture(sQRCodeStr, nQRCodeSize, clWhite);
      if Result.GraphicTexture <> nil then begin
        Result.Width := Result.GraphicTexture.Width;
        Result.Height := Result.GraphicTexture.Height;
      end;
    end;
  end;
end;

