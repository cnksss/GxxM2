  HintWindows.Clear;

  HintWindow := THintWindow.Create;

  boLinkUpdate := (g_UpdateEngine <> nil) and g_UpdateEngine.CheckConnect;
  if boLinkUpdate then begin
    sLinkStatus := '连接正常';
    btColor := 250;
  end
  else begin
    sLinkStatus := '连接失败';
    btColor := 249;
  end;

  HintLines := THintLines.Create;
  HintLines.Add(DecodeResStr(SUpdateStatus) + sLinkStatus, GetRGB(btColor), GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke());
  HintWindow.Add(HintLines);

  HintLines := THintLines.Create;
  HintLines.Add(DecodeResStr(SUpdateCurrentSpeed) + g_UpdateSpeedStr, GetRGB(btColor), GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke());
  HintWindow.Add(HintLines);

  if g_UpdateTotalSize >= 1024 * 1024 * 1024 then
    S := Format('%.2fG', [g_UpdateTotalSize / 1024 / 1024 / 1024])
  else if g_UpdateTotalSize >= 1024 * 1024 then
    S := Format('%.2fM', [g_UpdateTotalSize / 1024 / 1024])
  else if g_UpdateTotalSize >= 1024 then
    S := Format('%.2fK', [g_UpdateTotalSize / 1024])
  else
    S := Format('%.2fB', [g_UpdateTotalSize * 1.0]);

  HintLines := THintLines.Create;
  HintLines.Add(DecodeResStr(SUpdateTotalSize) + S, GetRGB(btColor), GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke());
  HintWindow.Add(HintLines);

  if not boLinkUpdate then begin
    if (g_nUpdateGatePort > 0) then begin
      HintLines := THintLines.Create;
      HintLines.Add(DecodeResStr(SUpdateTryAgain), GetRGB(btColor), GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke());
      HintWindow.Add(HintLines);
    end
    else begin
      HintLines := THintLines.Create;
      HintLines.Add(DecodeResStr(SUpdateNotOpen), GetRGB(btColor), GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke());
      HintWindow.Add(HintLines);
    end;
  end;

  HintLines := THintLines.Create;
  HintLines.Add(DecodeResStr(SUpdateChangeServer), GetRGB(151), GetHintFontSize, GetHintFontStyle([]), GetHintFontStroke());
  HintWindow.Add(HintLines);

  HintWindow.Show(DUpdateStatusDlg.Left, DUpdateStatusDlg.Top + DUpdateStatusDlg.Height, False, False);
  HintWindows.Add(HintWindow);
end;

