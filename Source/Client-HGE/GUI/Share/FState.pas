  function AddShowHintList(PropType:THintPropertyType; HintTextType:Integer):THintLines; overload;
  var
    ArrHintLines:PArrHintLines;
  begin
    ArrHintLines := @ShowHints[PropType];
    SetLength(ArrHintLines^, Length(ArrHintLines^) + 1);
    ArrHintLines^[Length(ArrHintLines^) - 1] := THintLines.Create;
    Result := ArrHintLines^[Length(ArrHintLines^) - 1];
    if (HintTextType >= Integer(Low(THintTextType))) and (HintTextType <= Integer(High(THintTextType))) then
      Result.Alignment := g_ConfigClient.ItemHintTextConfig[THintTextType(HintTextType)].Alignment
    else
      Result.Alignment := g_ConfigClient.OtherHintAlignment;

    if PropType = hptItemIcon then begin
      Result.IsItemIconText := True;
    end;
  end;

