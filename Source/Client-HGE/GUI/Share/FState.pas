function TFrmDlg.FindActiveControl(Sender:TObject; X, Y:Integer):TDxControl;
var
  I:Integer;
  D:TDxControl;
  AOwner:TDxControl;
begin
  Result := nil;
  AOwner := TDxControl(Sender);
  if AOwner.Visible and (AOwner.Enabled or ((not AOwner.Enabled) and AOwner.Designing)) and AOwner.CanDraw and PointInRect(Point(X, Y), AOwner.VisibleRect) then begin
    if AOwner.InRange(X, Y) then
      Result := AOwner;
    for I := AOwner.ControlCount - 1 downto 0 do begin
