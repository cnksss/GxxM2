procedure TFrmDlg.DBelt1MouseDown(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  nC, nIdx:Integer;
begin
  nIdx := TDxImageButton(Sender).tag;
  if (nIdx in [0..5]) and (g_ItemArr[nIdx].S.Name <> '') and (mbRight = Button) and (not g_boItemMoving) and (g_MyHero <> nil) then begin
    if not g_ClientConfig.boBagRightkey then begin
      // 鼠标右键点击[人物背包]中的物品将该物品放入[英雄背包]中。
      g_WaitingUseItem.Item := g_ItemArr[nIdx];
      g_WaitingUseItem.ItemType := mtBagItem;
      g_ItemArr[nIdx].s.Name := '';
      g_MovingItem.Item.S.Name := '';
      g_boItemMoving := False;
      frmMain.SendMasterBagToHeroBag(g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.s.Name);
      ItemClickSound(g_ItemArr[nIdx].s);
    end;
  end
  else if (not g_boItemMoving) and (g_ItemArr[nIdx].S.Name <> '') and (ssShift in Shift) and IsUnOverLapItem(@g_ItemArr[nIdx]) then begin
    g_boLockBeltShortcut := True;
    DMessageDlg('请输入要拆分的数量：', [mbOk, mbAbort]);
    nC := StrToIntDef(Trim(DlgEditText), -1);
    if nC > 0 then begin
      g_WaitingUseItem.ItemType := mtBagItem;
      g_WaitingUseItem.Index := nIdx;
      g_WaitingUseItem.Item := g_ItemArr[nIdx];
      g_ItemArr[nIdx].s.Name := '';
      frmMain.SendPackageItem(g_WaitingUseItem.Item.MakeIndex, nC, g_WaitingUseItem.Item.S.Name);
    end;
  end;
end;

procedure TFrmDlg.DBelt1Click(Sender:TObject; X, Y:Integer);
var
  nIdx:Integer;
  temp:TClientItem;
begin
  if g_boLockBeltShortcut then begin
    g_boLockBeltShortcut := False;
    Exit;
  end;
  nIdx := TDxImageButton(Sender).tag;
  if nIdx in [0..5] then begin
    if not g_boItemMoving then begin
      if g_ItemArr[nIdx].S.Name <> '' then begin
        ItemClickSound(g_ItemArr[nIdx].S);
        g_dwMoveItemTick := MyGetTickCount;
        g_boItemMoving := True;
        g_MovingItem.Index := nIdx;
        g_MovingItem.Item := g_ItemArr[nIdx];
        g_MovingItem.ItemType := mtBagItem;
        g_ItemArr[nIdx].S.Name := '';
      end;
    end
    else begin
      if (g_MovingItem.Index = -97) or (g_MovingItem.Index = -98) or (g_MovingItem.ItemType in [mtHeroBagItem, mtHeroUseItem, mtBagGold, mtDealGold, mtGameGoldDeal, mtChallengeGold]) then
        Exit;
      if (g_MovingItem.Item.S.StdMode <= 3) or ((g_MovingItem.Item.s.StdMode = 31) and (g_MovingItem.Item.s.Source = -2)) or (g_MovingItem.Item.s.StdMode = 49) {聚灵珠让放到快捷栏} or (g_MovingItem.Item.s.StdMode = 95) {攻击类物品放到快捷栏} then begin
        // ItemClickSound (MovingItem.Item.S.StdMode);
        if g_ItemArr[nIdx].S.Name <> '' then begin
          if (g_MovingItem.ItemType = mtBagItem) and IsOverLapItem(@g_ItemArr[nIdx], @g_MovingItem.Item) then begin // 开始重叠物品
            g_WaitingUseItem := g_MovingItem;
            g_MovingItem.Item.S.Name := '';
            g_boItemMoving := False;
            frmMain.SendOverLapItem(g_WaitingUseItem.Item.MakeIndex, g_ItemArr[nIdx].MakeIndex, g_WaitingUseItem.Item.s.Name);
          end
          else begin
            if g_MovingItem.ItemType = mtItemBoxItem then begin
              Exit;
            end;

            temp := g_ItemArr[nIdx];
            g_ItemArr[nIdx] := g_MovingItem.Item;
            g_MovingItem.Index := nIdx;
            g_MovingItem.Item := temp;
          end;
        end
        else begin
          if g_MovingItem.ItemType = mtItemBoxItem then begin
            if g_WaitingUseItem.Item.s.Name = '' then begin
              g_WaitingUseItem := g_MovingItem;
              frmMain.SendMoveItemBoxToBag(g_MovingItem.Index, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
              g_MovingItem.Item.S.Name := '';
              g_boItemMoving := False;
            end;
          end;
          g_ItemArr[nIdx] := g_MovingItem.Item;
          g_MovingItem.Item.S.Name := '';
          g_boItemMoving := False;
        end;
      end;
    end;
  end;
end;

procedure TFrmDlg.DBelt1DblClick(Sender:TObject; X, Y:Integer);
var
  idx:Integer;
begin
  idx := TDxImageButton(Sender).tag;
  if idx in [0..5] then begin
    if g_ItemArr[idx].S.Name <> '' then begin
      if (g_ItemArr[idx].S.StdMode <= 4) or (g_ItemArr[idx].S.StdMode = 31) or (g_ItemArr[idx].S.StdMode = 60) or (g_ItemArr[idx].s.StdMode = 49) or (g_ItemArr[idx].s.StdMode = 95) {攻击类物品放到快捷栏} then begin
        g_ConfigDlg.ProtectEnabled := False;
        try
          frmMain.EatItem(idx);
        finally
          g_ConfigDlg.ProtectEnabled := True;
        end;
      end;
    end
    else begin
      if g_boItemMoving and (g_MovingItem.Index = idx) and (g_MovingItem.Item.S.StdMode <= 4) or (g_MovingItem.Item.S.StdMode = 31) or (g_MovingItem.Item.S.StdMode = 60) or (g_MovingItem.Item.S.StdMode = 49) or (g_MovingItem.Item.s.StdMode = 95) {攻击类物品放到快捷栏} then begin
        g_ConfigDlg.ProtectEnabled := False;
        try
          frmMain.EatItem(-1);
        finally
          g_ConfigDlg.ProtectEnabled := True;
        end;
      end;
    end;
  end;
end;

