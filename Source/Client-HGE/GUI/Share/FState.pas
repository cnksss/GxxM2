  if Btn.m_LightFrameIndex >= BodyEffectImageCount then
    Btn.m_LightFrameIndex := 0;

  if (GameImages <> nil) and (BodyEffectStartOffSet >= 0) then begin
    d := GameImages.GetCachedImage(BodyEffectStartOffSet + Btn.m_LightFrameIndex, nX, nY);
    nX := nX + EffectOffsetX;
    nY := nY + EffectOffsetY;
    if d <> nil then begin
      R.Left := DrawLeft + (DrawWidth - d.Width) div 2 + nX - 1;
      R.Top := DrawTop + (DrawHeight - d.Height) div 2 + nY + 1;
      if DrawSrc <> nil then begin
        if boNew then
          Btn.DrawRect(R, d.ClientRect, Btn.VisibleRect, d, Blend_SrcAlphaColor) //          Btn.DrawBlend(DrawLeft + (DrawWidth - d.Width) div 2 + nX - 1, DrawTop + (DrawHeight - d.Height) div 2 + nY + 1, DrawSrc^, d)
        else
          GameCanvas.DrawBlend(DrawLeft + (DrawWidth - d.Width) div 2 + nX - 1, DrawTop + (DrawHeight - d.Height) div 2 + nY + 1, DrawSrc^, d)
      end else begin
        if boNew then
          Btn.DrawRect(R, Btn.VirtualRect, Btn.VisibleRect, d, Blend_SrcAlphaColor)
        else
          GameCanvas.DrawBlend(DrawLeft + (DrawWidth - d.Width) div 2 + nX - 1, DrawTop + (DrawHeight - d.Height) div 2 + nY + 1, d.ClientRect, d);
      end;
    end;
  end;
end;

procedure TFrmDlg.NpcItemButtonDirectPaint(Sender:TObject);
var
  Btn:TNpcItemButton;
  sMsg:string;
  vtRect, vbRect, R, SrcRect, ParentRect:TRect;
  GameImages:TGameImages;
  D, DBorder:TTexture;
  Index, nValue:Integer;
begin
  Btn := TNpcItemButton(Sender);
  vtRect := Btn.VirtualRect;
  vbRect := Btn.VisibleRect;
  ParentRect := TDxControl(Btn.Owner).VirtualRect;

  DBorder := nil;
  if Btn.m_boShowBorder then begin
    if Btn.ImageIndex.Image <> nil then begin
      DBorder := Btn.ImageIndex.Image.Images[Btn.ImageIndex.Up];
      if (DBorder <> nil) and (DBorder.Width > 4) and (DBorder.Height > 4) then begin
        R.Left := vtRect.Left + (vtRect.Right - vtRect.Left - DBorder.Width) div 2;
        R.Top := vtRect.Top + (vtRect.Bottom - vtRect.Top - DBorder.Width) div 2;

        if Btn.Tag = 1 then begin
          // 修正任务框下面一块加入图片时绘制超出范围 chongchong 2015-09-03
          R.Right := R.Left + DBorder.Width;
          R.Bottom := R.Top + DBorder.Height;

          SrcRect := Rect(0, 0, DBorder.Width, DBorder.Height);

          if R.Left < ParentRect.Left then begin
            SrcRect.Left := SrcRect.Left + (ParentRect.Left - R.Left);
            R.Left := ParentRect.Left;
          end;

          if R.Right > ParentRect.Right then begin
            SrcRect.Right := SrcRect.Right - (R.Right - ParentRect.Right);
            R.Right := ParentRect.Right;
          end;

          if R.Top < ParentRect.Top then begin
            SrcRect.Top := SrcRect.Top + (ParentRect.Top - R.Top);
            R.Top := ParentRect.Top;
          end;

          if R.Bottom > ParentRect.Bottom then begin
            SrcRect.Bottom := SrcRect.Bottom - (R.Bottom - ParentRect.Bottom);
            R.Bottom := ParentRect.Bottom;
          end;

          GameCanvas.Draw(R.Left, R.Top, SrcRect, DBorder, Btn.BlendMode);
          NpcItemButtonPaintLight(Btn, R.Left, R.Top, DBorder.Width, DBorder.Height, @SrcRect);
        end else if Btn.Tag = 2 then begin
          SrcRect := Rect(0, 0, vbRect.Right - (vbRect.Left - vtRect.Left), vbRect.Bottom - (vtRect.Bottom - vbRect.Bottom));

          Btn.DrawRect(R, vtRect, Btn.VisibleRect, DBorder, Btn.BlendMode);
          NpcItemButtonPaintLight(Btn, R.Left, R.Top, DBorder.Width, DBorder.Height, nil, True);
        end else begin
          GameCanvas.Draw(R.Left, R.Top, DBorder);
          NpcItemButtonPaintLight(Btn, R.Left, R.Top, DBorder.Width, DBorder.Height, nil);
        end;
      end;
    end;

    //Blend_GrayScale
    GameImages := g_WBagItemImages.Looks[pTClientItem(g_StdItemList.Items[Btn.m_nFaceIndex]).S.Looks];
    Index := pTClientItem(g_StdItemList.Items[Btn.m_nFaceIndex]).S.Looks mod 10000;
    if GameImages <> nil then begin
      if Btn.m_nGray = 0 then begin   //HZQ 20230809 增加装备置灰选项
          D := GameImages.Images[Index];
      end else begin
          D := GameImages.Grays[Index];
      end;
      if (D <> nil) and (D.Width > 4) and (D.Height > 4) then begin
        if DBorder = nil then begin
          R.Left := vtRect.Left + (vtRect.Right - vtRect.Left - D.Width) div 2;
          R.Top := vtRect.Top + (vtRect.Bottom - vtRect.Top - D.Width) div 2;
        end else begin
          R.Left := vtRect.Left + (vtRect.Right - vtRect.Left - DBorder.Width) div 2 + (DBorder.Width - D.Width) div 2;
          R.Top := vtRect.Top + (vtRect.Bottom - vtRect.Top - DBorder.Width) div 2 + (DBorder.Height - D.Height) div 2;
        end;

        if Btn.Tag = 1 then begin
          // 修正任务框下面一块加入图片时绘制超出范围 chongchong 2015-09-03
          R.Right := R.Left + D.Width;
          R.Bottom := R.Top + D.Height;

          SrcRect := Rect(0, 0, D.Width, D.Height);

          if R.Left < ParentRect.Left then begin
            SrcRect.Left := SrcRect.Left + (ParentRect.Left - R.Left);
            R.Left := ParentRect.Left;
          end;

          if R.Right > ParentRect.Right then begin
            SrcRect.Right := SrcRect.Right - (R.Right - ParentRect.Right);
            R.Right := ParentRect.Right;
          end;

          if R.Top < ParentRect.Top then begin
            SrcRect.Top := SrcRect.Top + (ParentRect.Top - R.Top);
            R.Top := ParentRect.Top;
          end;

          if R.Bottom > ParentRect.Bottom then begin
            SrcRect.Bottom := SrcRect.Bottom - (R.Bottom - ParentRect.Bottom);
            R.Bottom := ParentRect.Bottom;
          end;

          GameCanvas.Draw(R.Left, R.Top, SrcRect, D, Btn.BlendMode);
          NpcItemButtonPaintLight(Btn, R.Left, R.Top, D.Width, D.Height, @SrcRect);
        end else if Btn.Tag = 2 then begin
          //          R.Right := R.Left + D.Width;
          //          R.Bottom := R.Top + D.Height;
          //          SrcRect := Rect(0, 0, D.Width, D.Height);

          Btn.DrawRect(R, vtRect, Btn.VisibleRect, D, Btn.BlendMode);
          NpcItemButtonPaintLight(Btn, R.Left, R.Top, D.Width, D.Height, nil, True);
        end else begin
          GameCanvas.Draw(R.Left, R.Top, D);
          NpcItemButtonPaintLight(Btn, R.Left, R.Top, D.Width, D.Height, nil);
        end;
      end;
    end;

    if Btn.m_nCount > 0 then begin
      sMsg := IntToStr(Btn.m_nCount);

      if Btn.Tag = 1 then begin
        R.Left := vtRect.Right - CurrentFont.TextWidth(sMsg) - 4;
        R.Top := vtRect.Bottom - g_CurrentFontHeight - 2;
        R.Right := vtRect.Right - 4;
        R.Bottom := vtRect.Bottom - 2;

        if (R.Left >= ParentRect.Left) and (R.Right <= ParentRect.Right) and (R.Top >= ParentRect.Top) and (R.Bottom <= ParentRect.Bottom) then
          BoldTextOut(R.Left, R.Top, sMsg, clSkyBlue);
      end else if Btn.Tag = 2 then begin
        //数量文字不超出容器范围 By 一支笔 at:2022-03-16 11:22:30
        nValue := (vtRect.Right - vtRect.Left - CurrentFont.TextWidth(sMsg) - 4);
        if (vbRect.Left - vtRect.Left) > nValue then
          R.Left := vbRect.Left - vtRect.Left - nValue
        else
          R.Left := 0;

        nValue := (vtRect.Bottom - vtRect.Top - g_CurrentFontHeight - 2);
        if (vbRect.Top - vtRect.Top) > nValue then
          R.Top := vbRect.Top - vtRect.Top - nValue
        else
          R.Top := 0;

        R.Bottom := g_CurrentFontHeight - (vtRect.Bottom - vbRect.Bottom);
        R.Right := CurrentFont.TextWidth(sMsg) - (vtRect.Right - vbRect.Right);

        CurrentFont.TextRect(vtRect.Right - CurrentFont.TextWidth(sMsg) - 4 + R.Left, vtRect.Bottom - g_CurrentFontHeight - 2 + R.Top, R, sMsg, clSkyBlue);
      end else begin
        BoldTextOut(vtRect.Right - CurrentFont.TextWidth(sMsg) - 4, vtRect.Bottom - g_CurrentFontHeight - 2, sMsg, clSkyBlue);
      end;
    end;
  end else if Btn.m_nCount > 0 then begin
    sMsg := IntToStr(Btn.m_nCount);
    if Btn.Tag = 1 then begin
      R.Left := vtRect.Right - CurrentFont.TextWidth(sMsg) - 2;
      R.Top := vtRect.Bottom - g_CurrentFontHeight;

      R.Right := vtRect.Right - 2;
      R.Bottom := vtRect.Bottom;

      if (R.Left >= ParentRect.Left) and (R.Right <= ParentRect.Right) and (R.Top >= ParentRect.Top) and (R.Bottom <= ParentRect.Bottom) then
        BoldTextOut(R.Left, R.Top, sMsg, clSkyBlue);
    end else begin
      BoldTextOut(vtRect.Right - CurrentFont.TextWidth(sMsg) - 2, vtRect.Bottom - g_CurrentFontHeight, sMsg, clSkyBlue);
    end;
  end;
end;

