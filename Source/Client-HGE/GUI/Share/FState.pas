procedure TFrmDlg.DChallengeGridGridSelect(Sender:TObject; ACol, ARow:Integer; Button:TMouseButton; Shift:TShiftState);
var
  nIdx:Integer;
  Grid:TDxImageGrid;
  valstr:string;
  sGold:string;
  nTemp:Integer;
begin
  if not g_boGameGoldDealing then begin
    Grid := TDxImageGrid(Sender);
    nIdx := ACol + ARow * Grid.ColCount;

    // 挑战附加币控制 piaoyun 2013-07-22
    case g_btChallengeGoldIndex of
      0:
        sGold := g_sGameDiamondName; // 金刚石
      1:
        sGold := g_sGameGoldName; // 元宝
      2:
        sGold := g_sGameGirdName; // 灵符
    end;

    if nIdx in [0..4] then begin
      if nIdx = 4 then begin
        DMessageDlg(Format('请输入%s数量，在0-9999之间', [{g_sGameDiamondName} sGold]), [mbOk, mbAbort]);
        valstr := Trim(DlgEditText);
        nTemp := StrToIntDef(valstr, 0);
        {if (nTemp <= (g_nChallengeGameDiamond + g_nGameDiamond)) and
          (nTemp > 0) then
        begin
          frmMain.SendChangeChallengeGameDiamond(nTemp);
          g_dwChallengeActionTick := MyGetTickCount + 4000;
        end;  }
        // 挑战附加币控制 piaoyun 2013-07-22
        case g_btChallengeGoldIndex of
          0:begin
              if Int64(g_nGameDiamond) + g_nChallengeGameDiamond > nTemp then begin
                g_nGameDiamond := Cardinal((Int64(g_nGameDiamond) + g_nChallengeGameDiamond) - nTemp);
                g_nChallengeGameDiamond := nTemp;
                frmMain.SendChangeChallengeGameDiamond(g_nChallengeGameDiamond);
              end;
            end;
          1:begin
              if Int64(g_MySelf.m_nGameGold) + g_nChallengeGameDiamond > nTemp then {//HZQ20230525} begin
                g_MySelf.m_nGameGold := Cardinal(Int64(g_MySelf.m_nGameGold) + g_nChallengeGameDiamond - nTemp); //HZQ20230525
                g_nChallengeGameDiamond := nTemp;
                frmMain.SendChangeChallengeGameDiamond(g_nChallengeGameDiamond);
              end;
            end;
          2:begin
              if Int64(g_nGameGird) + g_nChallengeGameDiamond > nTemp then begin
                g_nGameGird := Cardinal((Int64(g_nGameGird) + g_nChallengeGameDiamond) - nTemp);
                g_nChallengeGameDiamond := nTemp;
                frmMain.SendChangeChallengeGameDiamond(g_nChallengeGameDiamond);
              end;
            end;
        end;
        g_dwChallengeActionTick := MyGetTickCount + 4000;
      end
      else begin
        if not g_boItemMoving then begin
          if g_ChallengeItems[nIdx].S.Name <> '' then begin
            g_dwMoveItemTick := MyGetTickCount;
            g_boItemMoving := True;
            g_MovingItem.Index := nIdx;
            g_MovingItem.Item := g_ChallengeItems[nIdx];
            g_MovingItem.ItemType := mtChallengeItem;
            g_ChallengeItems[nIdx].S.Name := '';
            ItemClickSound(g_ChallengeItems[nIdx].S);
          end;
        end
        else begin
          if g_MovingItem.ItemType in [mtBagItem, mtChallengeItem] then begin
            ItemClickSound(g_MovingItem.Item.S);
            if g_MovingItem.ItemType = mtBagItem then begin
              g_boItemMoving := False;
              g_ChallengeDlgItem := g_MovingItem.Item;
              frmMain.SendAddChallengeItem(g_ChallengeDlgItem);
              g_dwChallengeActionTick := MyGetTickCount + 4000;
              g_MovingItem.Item.S.Name := '';
            end
            else begin
              AddChallengeItem(g_MovingItem.Item);
              g_MovingItem.Item.S.Name := '';
              g_boItemMoving := False;
            end;
          end;
        end;
      end;
    end;
    ArrangeItembag;
  end;
end;

