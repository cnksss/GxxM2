procedure TFrmDlg.DGuildDlgDirectPaint(Sender:TObject);
var
  I, n, bx, by:Integer;
  vtRect:TRect;
  H:Integer;
begin
  if not (Sender is TDxControl) then
    Exit;
  vtRect := (Sender as TDxControl).VirtualRect;

  bx := vtRect.Left;
  by := vtRect.Top;
  H := vtRect.Bottom - vtRect.Top;

  for I := GuildTopLine to GuildStrs.Count - 1 do begin
    n := I - GuildTopLine;
    if n * 14 > H then
      Break;

    if Integer(GuildStrs.Objects[I]) <> 0 then
      CurrentFont.TextOut(bx, by + n * 14, GuildStrs[I], TColor(GuildStrs.Objects[I]))
    else begin
      if BoGuildChat then
        CurrentFont.TextOut(bx, by + n * 14, GuildStrs[I], GetRGB(2))
      else
        CurrentFont.TextOut(bx, by + n * 14, GuildStrs[I], clSilver);
    end;
  end;
end;

