procedure TFrmDlg.DNPC_IMG_PAINT(Sender:TObject); stdcall;
var
  D, DBorder:TTexture;
  Btn:TNpcButton;
  vRect:TRect;
  vtRect:TRect;
  vbRect:TRect;
begin
  Btn := Sender as TNpcButton;

  if Btn.Tag <> 1 then begin
    DBorder := nil;
    if Btn.m_nShowBG <> 0 then begin
      vRect := Btn.Owner.VisibleRect;
      if Btn.Owner.Left < 0 then
        vRect.Left := vRect.Left + Btn.Owner.Left;
      if Btn.Owner.Top < 0 then
        vRect.Top := vRect.Top + Btn.Owner.Top;
      vRect.Left := vRect.Left + Btn.Left;
      vRect.Top := vRect.Top + Btn.Top;

      if Btn.m_nShowBG > 0 then
        DBorder := g_WNewopUIImages.Images[250]
      else
        DBorder := g_WNewopUIImages.Images[251];

      if DBorder <> nil then begin
        GameCanvas.Draw(vRect.Left, vRect.Top, DBorder);
      end;
    end;

    D := Btn.ImageIndex.Image.Images[Btn.ImageIndex.Up];
    if D <> nil then begin
      vRect := Btn.Owner.VisibleRect;
      if Btn.Owner.Left < 0 then
        vRect.Left := vRect.Left + Btn.Owner.Left;
      if Btn.Owner.Top < 0 then
        vRect.Top := vRect.Top + Btn.Owner.Top;
      vRect.Left := vRect.Left + Btn.Left;
      vRect.Top := vRect.Top + Btn.Top;

      if DBorder <> nil then begin
        vRect.Left := vRect.Left + (DBorder.Width - D.Width) div 2;
        vRect.Top := vRect.Top + (DBorder.Height - D.Height) div 2;
      end;

      // 按钮点击偏移 chongchong 2015-01-21
      if Btn.m_sCmd <> '' then begin
        if Btn.MouseDowned then begin
          vRect.Left := vRect.Left + 1;
          vRect.Top := vRect.Top + 1;
        end;
      end;

      if Btn.Tag = 0 then begin
        GameCanvas.Draw(vRect.Left, vRect.Top, D, Btn.BlendMode);
        Exit;
      end;
    end;
  end
  else begin
    DBorder := nil;

    vbRect := Btn.VisibleRect;
    if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
      Exit;
    vtRect := Btn.VirtualRect;
    vRect := vtRect;

    if Btn.m_nShowBG <> 0 then begin
      if Btn.m_nShowBG > 0 then
        DBorder := g_WNewopUIImages.Images[250]
      else
        DBorder := g_WNewopUIImages.Images[251];

      if DBorder <> nil then begin
        Btn.DrawRect(vRect, vtRect, vbRect, DBorder, 2);
      end;
    end;

    vRect := vtRect;

    D := Btn.ImageIndex.Image.Images[Btn.ImageIndex.Up];
    if D <> nil then begin
      if DBorder <> nil then begin
        vRect.Left := vRect.Left + (DBorder.Width - D.Width) div 2;
        vRect.Top := vRect.Top + (DBorder.Height - D.Height) div 2;
      end;

      // 按钮点击偏移 chongchong 2015-01-21
      if Btn.m_sCmd <> '' then begin
        if Btn.MouseDowned then begin
          vRect.Left := vRect.Left + 1;
          vRect.Top := vRect.Top + 1;
        end;
      end;

      Btn.DrawRect(vRect, vtRect, vbRect, D, Btn.BlendMode);
    end;
  end;
end;

procedure TFrmDlg.DNPC_IMGEX_PAINT(Sender:TObject); stdcall;
var
  Texture:TTexture;
  Btn:TNpcButton;
  vRect:TRect;
  vtRect:TRect;
  vbRect:TRect;
begin
  Btn := Sender as TNpcButton;
  if Btn.MouseDowned then
    Texture := Btn.ImageIndex.Image.Images[Btn.ImageIndex.Down]
  else if Btn.MouseMoveed then
    Texture := Btn.ImageIndex.Image.Images[Btn.ImageIndex.Hot]
  else
    Texture := Btn.ImageIndex.Image.Images[Btn.ImageIndex.Up];

  if Texture = nil then
    Exit;

  if Btn.Tag <> 1 then begin
    vRect := Btn.Owner.VisibleRect;
    if Btn.Owner.Left < 0 then
      vRect.Left := vRect.Left + Btn.Owner.Left;
    if Btn.Owner.Top < 0 then
      vRect.Top := vRect.Top + Btn.Owner.Top;
    vRect.Left := vRect.Left + Btn.Left;
    vRect.Top := vRect.Top + Btn.Top;

    GameCanvas.Draw(vRect.Left, vRect.Top, Texture, Btn.BlendMode);

    Exit;
  end;

  vbRect := Btn.VisibleRect;
  if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
    Exit;
  vtRect := Btn.VirtualRect;
  vRect := vtRect;

  if vRect.Bottom - vtRect.Top > Texture.Height then begin
    vRect.Top := vRect.Top + (vRect.Bottom - vRect.Top - Texture.Height);
  end;
  Btn.DrawRect(vRect, vtRect, vbRect, Texture, Btn.BlendMode);
end;

