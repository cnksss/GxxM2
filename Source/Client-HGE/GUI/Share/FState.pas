procedure TFrmDlg.SWWeaponMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  I, J, K, sel, nX, nY, nWidth, nHeight:Integer;
  vtRect:TRect;
  CtrlRect:TRect;
  D:TDxControl;
  DrawLeft:Boolean;
  HintWindow:THintWindow;
  HintList:TList;
  TzHintWindows:TList;
  HatItem:TClientItem;
  HintLines:THintLines;
  HintText:THintText;
  ArrHintWindows:TArrHintWindows;
begin
  sel := TDxImageButton(Sender).Tag;
  if (sel = U_HELMET) and (g_UseItems[U_HELMET].S.Name = '') and (g_UseItems[U_HAT].S.Name <> '') then // 优先显示斗笠 GetMouseItemInfoWindow
    sel := U_HAT;

  if (sel < 0) or (g_UseItems[sel].S.Name = '') then begin
    g_boShowBagInfo := False;
    g_MouseStateItem.s.Name := '';
    DScreen.ClearHint;
    HintWindows.Clear;
    Exit;
  end;

  g_MouseStateItem := g_UseItems[sel];

  { TODO -c注释 -opiaoyun : 添加注释 装备栏信息显示悬浮新模式 【2013-4-24】}
  // 免得不停的重新创建提示窗口 chongchong 2015-01-22
  if (g_MouseStateItem.MakeIndex <> g_LastHintMakeIndex) then begin
    if (g_ClientConfig.btSuspensionShowItem > 0) or (g_ClientVersion > cvSerial) then {cvHero} begin
      g_boShowBagInfo := False;

      D := TDxControl(Sender);

      while True do begin
        if (D.Owner <> nil) and (D.Owner is TDxControlEngine) then
          break;
        D := D.Owner;
      end;

      with D do begin
        if g_ClientConfig.boHintWithMouse then begin
          CtrlRect := TDxControl(Sender).VirtualRect;
          vtRect := VirtualRect;
          nY := CtrlRect.Bottom;
          nX := CtrlRect.Left;
          DrawLeft := False;
        end
        else begin
          vtRect := VirtualRect;
          nY := vtRect.Top + 40; // + 40;

          DrawLeft := vtRect.Right + 160 > SCREENWIDTH;
          if DrawLeft then
            nX := vtRect.Left // + 40
          else
            nX := vtRect.Right;
        end;

        if Length(g_MouseStateItem.s.Name) = 0 then begin
          HintWindows.Show(nX, nY, GetUseItemName(sel), clWhite, False, DrawLeft);
        end
        else begin
          HintWindows.Clear;
          HintList := TList.Create;

          // 两列显示 piaoyun 2013-09-16
          if not g_ClientConfig.boSingleHint then begin
            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              ArrHintWindows[I] := THintWindow.Create;
            end;

            GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_MouseStateItem, nX, nY, False, False, DrawLeft);

            for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
              HintWindow := THintWindow(ArrHintWindows[I]);
              if HintWindow.Count > 0 then begin
                HintList.Add(HintWindow);
                HintWindow.Show(0, 0);
              end
              else
                HintWindow.Free;
            end;

            if not g_ClientConfig.boTZSupportRenameItem then
              TzHintWindows := GetTzItemHintWindow(0, g_MySelf.m_btSex, g_MouseStateItem.s.DBName)
            else
              TzHintWindows := GetTzItemHintWindow(0, g_MySelf.m_btSex, g_MouseStateItem.s.Name);

            if TzHintWindows <> nil then begin
              for I := 0 to TzHintWindows.Count - 1 do begin
                THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
                HintList.Add(TzHintWindows.Items[I]);
              end;
              TzHintWindows.Free;
            end;

            if (sel = U_HELMET) and (g_UseItems[U_HAT].S.Name <> '') then begin
              for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                ArrHintWindows[I] := THintWindow.Create;
              end;

              GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_UseItems[U_HAT], nX, nY, False, False, DrawLeft);

              for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                HintWindow := THintWindow(ArrHintWindows[I]);
                if HintWindow.Count > 0 then begin
                  HintList.Add(HintWindow);
                  HintWindow.Show(0, 0);
                end
                else
                  HintWindow.Free;
              end;

              if not g_ClientConfig.boTZSupportRenameItem then
                TzHintWindows := GetTzItemHintWindow(0, g_MySelf.m_btSex, g_UseItems[U_HAT].S.DBName)
              else
                TzHintWindows := GetTzItemHintWindow(0, g_MySelf.m_btSex, g_UseItems[U_HAT].S.Name);

              if TzHintWindows <> nil then begin
                for I := 0 to TzHintWindows.Count - 1 do begin
                  THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
                  HintList.Add(TzHintWindows.Items[I]);
                end;
                TzHintWindows.Free;
              end;
            end;
          end
          else begin
            // 单列显示 piaoyun 2013-09-16
            TzHintWindows := GetTzItemHintWindowEx(0, g_MySelf.m_btSex, g_MySelf, @g_MouseStateItem, False);
            if TzHintWindows <> nil then begin
              for I := 0 to TzHintWindows.Count - 1 do begin
                THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
                HintList.Add(TzHintWindows.Items[I]);
              end;
              TzHintWindows.Free;
            end
            else begin
              for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                ArrHintWindows[I] := THintWindow.Create;
              end;

              GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_MouseStateItem, nX, nY, False, False, DrawLeft);

              for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                HintWindow := THintWindow(ArrHintWindows[I]);
                if HintWindow.Count > 0 then begin
                  HintList.Add(HintWindow);
                  HintWindow.Show(0, 0);
                end
                else
                  HintWindow.Free;
              end;
            end;

            if (sel = U_HELMET) and (g_UseItems[U_HAT].S.Name <> '') then begin
              TzHintWindows := GetTzItemHintWindowEx(0, g_MySelf.m_btSex, g_MySelf, @g_UseItems[U_HAT], False);
              if TzHintWindows <> nil then begin
                for I := 0 to TzHintWindows.Count - 1 do begin
                  THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
                  HintList.Add(TzHintWindows.Items[I]);
                end;
                TzHintWindows.Free;
              end
              else begin
                for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                  ArrHintWindows[I] := THintWindow.Create;
                end;

                GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @g_UseItems[U_HAT], nX, nY, False, False, DrawLeft);

                for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
                  HintWindow := THintWindow(ArrHintWindows[I]);
                  if HintWindow.Count > 0 then begin
                    HintList.Add(HintWindow);
                    HintWindow.Show(0, 0);
                  end
                  else
                    HintWindow.Free;
                end;
              end;
            end;
          end;

          nWidth := 0;
          nHeight := 0;

          for I := 0 to HintList.Count - 1 do begin
            HintWindow := THintWindow(HintList.Items[I]);
            nWidth := nWidth + HintWindow.Width;
            nHeight := Max(HintWindow.Height, nHeight);
          end;

          if g_ClientConfig.boHintWithMouse then begin
            if CtrlRect.Left >= (SCREENWIDTH - Width) then begin
              nX := CtrlRect.Left; // HintWindow.Width;
              DrawLeft := True;
            end
            else begin
              nX := CtrlRect.Right;
              DrawLeft := False;
            end;
          end
          else begin
            if vtRect.Left >= (SCREENWIDTH - Width) div 2 then begin
              nX := vtRect.Left - nWidth; // HintWindow.Width;
              DrawLeft := True;
            end
            else begin
              nX := vtRect.Right;
              DrawLeft := False;
            end;
          end;

          if nX + nWidth > SCREENWIDTH then
            nX := SCREENWIDTH - nWidth;

          if nY + nHeight > SCREENHEIGHT then
            nY := SCREENHEIGHT - nHeight;

          // 当套装太多时，装备右边只显示了一部分 chongchong 2018-05-13
          if nX < 0 then
            nX := 0;

          if nY < 0 then
            nY := 0;

          if DrawLeft then begin
            for I := HintList.Count - 1 downto 0 do begin
              HintWindow := THintWindow(HintList.Items[I]);
              HintWindow.X := nX;
              HintWindow.Y := nY;
              Inc(nX, HintWindow.Width);
              HintWindows.Add(HintWindow);
            end;
          end
          else begin
            for I := 0 to HintList.Count - 1 do begin
              HintWindow := THintWindow(HintList.Items[I]);
              HintWindow.X := nX;
              HintWindow.Y := nY;
              Inc(nX, HintWindow.Width);
              HintWindows.Add(HintWindow);
            end;
          end;

          HintList.Free;
        end;
      end
    end
    else if (sel = U_HELMET) and (g_UseItems[U_HAT].S.Name <> '') then begin
      sel := U_HAT;
      g_boShowBagInfo := False;
      D := TDxControl(Sender);

      while True do begin
        if (D.Owner <> nil) and (D.Owner is TDxControlEngine) then
          break;
        D := D.Owner;
      end;
      with D do begin
        CtrlRect := TDxControl(Sender).VirtualRect;
        vtRect := VirtualRect;
        nY := CtrlRect.Bottom;
        nX := CtrlRect.Left;
        DrawLeft := False;

        HatItem := g_UseItems[sel];
        HintWindows.Clear;
        HintList := TList.Create;

        TzHintWindows := GetTzItemHintWindowEx(0, g_MySelf.m_btSex, g_MySelf, @HatItem, False);
        if TzHintWindows <> nil then begin
          for I := 0 to TzHintWindows.Count - 1 do begin
            THintWindow(TzHintWindows.Items[I]).Show(nX, nY, False, DrawLeft);
            HintList.Add(TzHintWindows.Items[I]);
          end;
          TzHintWindows.Free;
        end
        else begin
          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            ArrHintWindows[I] := THintWindow.Create;
          end;

          GetMouseItemInfoWindow(ArrHintWindows, g_MySelf, @HatItem, nX, nY, False, False, DrawLeft);

          for I := Low(ArrHintWindows) to High(ArrHintWindows) do begin
            HintWindow := THintWindow(ArrHintWindows[I]);
            if HintWindow.Count > 0 then begin
              HintList.Add(HintWindow);
              HintWindow.Show(0, 0);
            end
            else
              HintWindow.Free;
          end;
        end;

        nWidth := 0;
        nHeight := 0;

        for I := 0 to HintList.Count - 1 do begin
          HintWindow := THintWindow(HintList.Items[I]);
          nWidth := nWidth + HintWindow.Width;
          nHeight := Max(HintWindow.Height, nHeight);
        end;

        if CtrlRect.Left >= (SCREENWIDTH - Width) then begin
          nX := CtrlRect.Left; // HintWindow.Width;
          DrawLeft := True;
        end
        else begin
          nX := CtrlRect.Right;
          DrawLeft := False;
        end;

        if nX + nWidth > SCREENWIDTH then
          nX := SCREENWIDTH - nWidth;

        if nY + nHeight > SCREENHEIGHT then
          nY := SCREENHEIGHT - nHeight;

        if nX < 0 then
