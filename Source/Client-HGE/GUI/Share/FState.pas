procedure TFrmDlg.DButtonShopBuyClick(Sender:TObject; X, Y:Integer);
var
  BuyCount:Integer;
  MaxCount:Integer;
begin
  if g_MouseShopItems.StdItem.DBName <> '' then begin
    if g_MouseShopItems.boBulkBuy then begin
      MaxCount := g_MouseShopItems.nBulkBuyCount;

      if DMessageDlg('请输入要购买 ' + ProcessItemName(g_MouseShopItems.StdItem.Name) + ' 的数量[1-' + IntToStr(MaxCount) + ']：', [mbOk, mbAbort], '') = mrAbort then
        Exit;

      BuyCount := StrToIntDef(Trim(DlgEditText), -1);
      if (BuyCount <= 0) or (BuyCount > MaxCount) then begin
        DMessageDlg('输入购买数量错误', [mbOk]);
        Exit;
      end;

      if mrOk = DMessageDlg('是否确认购买 ' + ProcessItemName(g_MouseShopItems.StdItem.Name) + ' ×' + IntToStr(BuyCount) + ' ？', [mbOk, mbCancel]) then begin
        frmMain.SendBuyShopItem(g_MouseShopItems.StdItem.DBName, BuyCount, g_MouseShopItems.GameMoney);
      end;
    end
    else begin
      if mrOk = DMessageDlg('是否确认购买 ' + ProcessItemName(g_MouseShopItems.StdItem.Name) + ' ？', [mbOk, mbCancel]) then begin
        frmMain.SendBuyShopItem(g_MouseShopItems.StdItem.DBName, 1, g_MouseShopItems.GameMoney);
      end;
    end;
  end;
end;

procedure TFrmDlg.DButtonShopBuyGiveClick(Sender:TObject; X, Y:Integer);
var
  Msg:TDefaultMessage;
  BuyCount:Integer;
begin
  if g_MouseShopItems.StdItem.DBName <> '' then begin
    if g_MouseShopItems.boBulkBuy then begin
      if DMessageDlg('请输入要赠送 ' + g_MouseShopItems.StdItem.Name + ' 的数量[1-99]：', [mbOk, mbAbort], '') = mrAbort then
        Exit;

      BuyCount := StrToIntDef(Trim(DlgEditText), -1);
      if (BuyCount <= 0) or (BuyCount >= 100) then begin
        DMessageDlg('输入赠送数量错误', [mbOk]);
        Exit;
      end;

      if mrOk = DMessageDlg('请输入 ' + g_MouseShopItems.StdItem.Name + ' 要赠送的人物名称：', [mbOk, mbAbort]) then begin
        Msg := MakeDefaultMsg(CM_BUYSHOPITEMGIVE, BuyCount, g_MouseShopItems.GameMoney, 0, 0);
        FrmMain.SendSocket(EncodeMessage(Msg) + g_MouseShopItems.StdItem.DBName + '/' + EncodeString(Trim(DlgEditText)));
      end;
    end
    else begin
      if mrOk = DMessageDlg('请输入 ' + g_MouseShopItems.StdItem.Name + ' 要赠送的人物名称：', [mbOk, mbAbort]) then begin
        Msg := MakeDefaultMsg(CM_BUYSHOPITEMGIVE, 1, g_MouseShopItems.GameMoney, 0, 0);
        FrmMain.SendSocket(EncodeMessage(Msg) + g_MouseShopItems.StdItem.DBName + '/' + EncodeString(Trim(DlgEditText)));
      end;
    end;
  end;
end;

