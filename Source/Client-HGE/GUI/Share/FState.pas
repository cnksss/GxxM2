procedure TFrmDlg.UpDate;
var
  I, nCount:Integer;
  ViewItem:pTViewItem;
  boDelete:Boolean;
  boDeleteTop:Boolean;
begin
  { TODO -ochongchong -c添加 : 小地图中人物矩形闪烁效果 2013-07-18 }
  if (g_MySelf <> nil) and (DChatMemo <> nil) then begin
    boDelete := False;
    if DChatMemo.Lines.Count > 200 then begin
      DChatMemo.Lock;
      try
        nCount := 0;
        while DChatMemo.Lines.Count > 100 do begin
          if nCount > 30 then
            break;
          DChatMemo.Delete(0);
          Inc(nCount);
          boDelete := True;
        end;
        if boDelete then
          DChatMemo.RemoveDelete;
      finally
        DChatMemo.UnLock;
      end;
    end;

    if DChatMemo.TopLines.Count > 0 then begin
      DChatMemo.Lock;
      try
        boDeleteTop := False;
        for I := DChatMemo.TopLines.Count - 1 downto 0 do begin // 删除聊天框固顶信息
          ViewItem := TDxLines(DChatMemo.TopLines).Items[I];
          if MyGetTickCount > ViewItem.TimeTick then begin
            DChatMemo.DeleteTop(I);
            boDeleteTop := True;
          end;
        end;
        if boDeleteTop then
          DChatMemo.RemoveDeleteTop;
      finally
        DChatMemo.UnLock;
      end;
    end;
  end;

  DBackground.Update;
  (*
  if (DMerchantDlg <> nil) then begin
{$IF IsMultiThreadRender = 1}
