procedure TFrmDlg.GetMouseItemInfo(Actor:TActor; MouseItem:pTClientItem; Secret:Boolean; var iname, line1, line2, line3:string; var IsUseableLine2, IsUseableLine3:Boolean);

  function GetDuraStr(Dura, maxdura:Integer):string;
  begin
    if not BoNoDisplayMaxDura then
      Result := IntToStr(Round(Dura / 1000)) + '/' + IntToStr(Round(maxdura / 1000))
    else
      Result := IntToStr(Round(Dura / 1000));
  end;

  function GetDura100Str(Dura, maxdura:Integer):string;
  begin
    if not BoNoDisplayMaxDura then
      Result := IntToStr(Round(Dura / 100)) + '/' + IntToStr(Round(maxdura / 100))
    else
      Result := IntToStr(Round(Dura / 100));
  end;

  // 53类宝石持久显示 piaoyun 2013-08-26

  function GetDuraStdMode53Str(Dura, maxdura:Integer):string;
  var
    N1, N2:Integer;
    S1, S2:string;
  begin
    N1 := Dura * g_ClientConfig.nHMPDivDura;
    N2 := N1 div 10000;
    if N2 > 0 then
      S1 := IntToStr(N2) + '万'
    else
      S1 := IntToStr(N2);

    N1 := maxdura * g_ClientConfig.nHMPDivDura;
    N2 := N1 div 10000;
    if N2 > 0 then
      S2 := IntToStr(N2) + '万'
    else
      S2 := IntToStr(N2);

    Result := S1 + '/' + S2;
  end;

  function GetMagicItemDuraStr(Dura, maxdura:Integer):string;
  begin
    if not BoNoDisplayMaxDura then
      Result := IntToStr(Round(Dura / g_nMagicItemRate)) + '/' + IntToStr(Round(maxdura / g_nMagicItemRate))
    else
      Result := IntToStr(Round(Dura / g_nMagicItemRate));
  end;

  function GetMagicJob(Job, AniCount:Integer):string;
  begin
    Result := '';
    if AniCount >= 95 then begin
      case AniCount of
        95:
          Result := '英雄';
        96:
          Result := '内功';
        97:
          Result := '连击';
        98:
          Result := '合击';
      end;
    end;
    case Job of
      0:
        Result := Result + '战士秘籍';
      1:
        Result := Result + '法师秘籍';
      2:
        Result := Result + '道士秘籍';
      else
        Result := Result + '通用秘籍';
    end;
  end;

