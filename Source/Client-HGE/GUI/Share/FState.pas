procedure TFrmDlg.DSellDlgOkClick(Sender:TObject; X, Y:Integer);
var
  IsExit:Boolean;
begin

  IsExit := False;

  if (g_SellDlgItemSellWait.S.Name <> '') then begin
    if MyGetTickCount - g_dwSellDlgItemSellWaitTick > 5000 then
      g_SellDlgItemSellWait.S.Name := ''
    else
      IsExit := True;
  end;

  if (not IsExit) and (MyGetTickCount >= LastestClickTime) then begin
    case SpotDlgMode of
      dmSell:
        frmMain.SendSellItem(g_nCurMerchant, g_SellDlgItem.MakeIndex, g_SellDlgItem.S.Name);
      dmRepair:
        frmMain.SendRepairItem(g_nCurMerchant, g_SellDlgItem.MakeIndex, g_SellDlgItem.S.Name);
      dmStorage:begin
          g_IsWaitItemToStorage := True;
          frmMain.SendStorageItem(g_nCurMerchant, g_SellDlgItem.MakeIndex, g_SellDlgItem.S.Name, FNpcStoragePage);
        end;
      dmUpgrade:
        frmMain.SendUpgradeItem(g_nCurMerchant, g_SellDlgItem.MakeIndex, g_SellDlgItem.S.Name);
      dmPleaseDrink:
        frmMain.SendPleaseNpcDrink(g_nCurMerchant, g_SellDlgItem.MakeIndex); // 给NPC喝酒
    end;
    g_SellDlgItemSellWait := g_SellDlgItem;
    g_SellDlgItem.S.Name := ''; //这里加过壳后好像就不执行了 不加壳的话就没问题
    LastestClickTime := MyGetTickCount + 5000;
    g_sSellPriceStr := '';
    g_dwSellDlgItemSellWaitTick := MyGetTickCount;
  end;

end;

