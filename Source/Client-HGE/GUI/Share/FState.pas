procedure TFrmDlg.DDGoldClick(Sender:TObject; X, Y:Integer);
var
  DGold:Integer;
  valstr:string;
begin
  if g_MySelf = nil then
    Exit;
  if not g_boDealEnd and (MyGetTickCount > g_dwDealActionTick) then begin
    if not g_boItemMoving then begin
      if g_nDealGold > 0 then begin
        PlaySound(s_money);
        g_boItemMoving := True;
        g_MovingItem.Index := -97;
        g_MovingItem.ItemType := mtDealGold;
        g_MovingItem.Item.S.Name := g_sGoldName {'金币'};
      end;
    end
    else begin
      if (g_MovingItem.ItemType in [mtBagGold, mtDealGold]) then begin
        if (g_MovingItem.ItemType = mtBagGold) then begin
          if g_MovingItem.Item.S.Name = g_sGoldName {'金币'} then begin
            g_boItemMoving := False;
            g_MovingItem.Item.S.Name := '';
            DMessageDlg('请输入要' + g_sGoldName {金币} + '数量：', [mbOk, mbAbort]);
            valstr := Trim(DlgEditText);
            DGold := StrToIntDef(valstr, 0);
            if (DGold > 0) and (DGold <= (g_nDealGold + Int64(g_MySelf.m_nGold))) then begin
              frmMain.SendChangeDealGold(DGold);
              g_dwDealActionTick := MyGetTickCount + 4000;
            end;
          end;
        end;
        g_boItemMoving := False;
        g_MovingItem.Item.S.Name := '';
      end;
    end;
  end;
end;

