procedure TFrmDlg.OnGetGroupAttackProgress(Sender:TObject; var IsShowGroupAttack, IsShowContinueAttack:Boolean; var nGroupAttackProgress:Integer; var IsContinueFlash:Boolean);
begin
  if (g_MyHero <> nil) then begin
    IsShowGroupAttack := ((g_HeroUseItems[U_BUJUK].S.Name <> '') and (g_HeroUseItems[U_BUJUK].S.StdMode = 25) and (g_HeroUseItems[U_BUJUK].S.Shape = 9)) or (g_ClientConfig.boNoNeedFirDragon);

    if g_MyHero.m_nMaxAngryValue <= 0 then
      nGroupAttackProgress := 0
    else
      nGroupAttackProgress := Round(g_MyHero.m_nAngryValue / g_MyHero.m_nMaxAngryValue * 100);
  end
  else begin
    IsShowGroupAttack := False;
    nGroupAttackProgress := 0;
  end;

  IsContinueFlash := g_boCanUseContinuous;
  IsShowContinueAttack := (g_MySelf <> nil) and g_MySelf.m_boTrainingNG and (g_ContinuousMagicList.Count > 0);
end;

