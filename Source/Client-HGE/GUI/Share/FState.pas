procedure TFrmDlg.DNPC_PLAYIMG_PAINT(Sender:TObject);
var
  Texture:TTexture;
  PX, PY:Integer;
  Btn:TNpcButton;
  R1, R2, ParentRect, SrcRect, R:TRect;

begin
  Btn := Sender as TNpcButton;

  Btn.m_TextureOffset := Point(0, 0);

  if (Btn.AddData1 > 0) and (Btn.AddData1 = Btn.AddData2) then
    Exit;

  Texture := Btn.ImageIndex.Image.GetCachedImage(Btn.ImageIndex.Up, PX, PY);

  Btn.m_TextureOffset := Point(PX, PY);

  if Texture <> nil then begin
    // 按钮点击偏移 chongchong 2015-01-21
    if Btn.m_sCmd <> '' then begin
      if Btn.MouseDowned then begin
        Inc(PX);
        Inc(PY);
      end;
    end;

    R1 := Btn.VirtualRect; //按钮真实矩形
    R2 := Btn.VisibleRect; //按钮可视矩形

    if Btn.Tag = 1 then begin
      //只在矩形内画动画 By 一支笔 at:2022-03-16 11:20:59
      ParentRect := Btn.Owner.VirtualRect;
      SrcRect := Texture.ClientRect;

      R.Left := R1.Left + PX;
      R.Top := R1.Top + PY;
      R.Right := R1.Right + PX;
      R.Bottom := R1.Bottom + PY;

      if R.Right > ParentRect.Right then begin
        SrcRect.Right := ParentRect.Right - R.Left;
      end;

      if R.Bottom > ParentRect.Bottom then begin
        SrcRect.Bottom := ParentRect.Bottom - R.Top;
      end;

      if R.Left < ParentRect.Left then begin
        SrcRect.Left := SrcRect.Left + (ParentRect.Left - R.Left);
        R.Left := ParentRect.Left;
      end;

      if R.Top < ParentRect.Top then begin
        SrcRect.Top := SrcRect.Top + (ParentRect.Top - R.Top);
        R.Top := ParentRect.Top;
      end;

      GameCanvas.Draw(R.Left, R.Top, SrcRect, Texture, Btn.BlendMode);
    end
    else begin
      // 修正AddDlg加入到人物状态中，并且包含PlayImg时，人物状态不停的往左边或上面移，PlayImg不跟随一起动 2020-03-24 23:36:25
      RecalcDraw(R1, R2, True, PX, PY, Texture, Btn.BlendMode, False);
    end;
  end;
  //  GameCanvas.FrameRect(R2, clRed);
end;

