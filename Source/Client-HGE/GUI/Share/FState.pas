procedure TFrmDlg.DGameGoldDealMenuDlgPaint(Sender:TObject);
var
  I:Integer;
  d:TTexture;
  vtRect:TRect;
  ARect:TRect;
  nTextWidth:Integer;
  sDealState:string;
  DealStateColor:TColor;
  X1, X2, X3, X4, Y1, Y2, ItemHeight:Integer;
  TextColor:TColor;
begin
  if g_MySelf = nil then
    Exit;

  with CurrentFont do begin
    vtRect := TDxImageForm(Sender).VirtualRect;

    if g_ClientVersion <> cvMirNewUI205 then begin
      X1 := vtRect.Left + 18;
      X2 := vtRect.Left + 178;
      X3 := vtRect.Left + 174;
      X4 := vtRect.Left + 190;
      Y1 := vtRect.Top + 32;
      Y2 := vtRect.Top + 30;

      TextColor := clWhite;

      TextOut(X1, vtRect.Top + 11, '交易明细', TextColor);
      TextOut(X2, vtRect.Top + 11, '物品列表', TextColor);

      ItemHeight := 16;
    end
    else begin
      X1 := vtRect.Left + 28;
      X2 := vtRect.Left + 194;
      X3 := vtRect.Left + 190;
      X4 := vtRect.Left + 206;

      Y1 := vtRect.Top + 45;
      Y2 := vtRect.Top + 43;

      TextColor := Def205FontColor;

      TextOut(X1, vtRect.Top + 20, '交易明细', TextColor);
      TextOut(X2, vtRect.Top + 20, '物品列表', TextColor);

      ItemHeight := 15;
    end;

    if (g_GameGoldDeal.SellChrName <> '') and (g_GameGoldDeal.BuyChrName <> '') then begin
      if (g_MySelf <> nil) and (g_GameGoldDeal.SellChrName = g_MySelf.m_sUserName) or (g_GameGoldDeal.BuyChrName = g_MySelf.m_sUserName) then begin
        TextOut(X1, Y1, '卖方角色：', TextColor);
        TextOut(X1, Y1 + 18, '买方角色：', TextColor);
        TextOut(X1, Y1 + 18 * 2, '元宝数量：', TextColor);
        TextOut(X1, Y1 + 18 * 3, '提交日期：', TextColor);
        TextOut(X1, Y1 + 18 * 4, '交易状态：', TextColor);

        nTextWidth := TextWidth('0') * 10;
        TextOut(X1 + nTextWidth, Y1, g_GameGoldDeal.SellChrName, clLime);
        TextOut(X1 + nTextWidth, Y1 + 18, g_GameGoldDeal.BuyChrName, clLime);
        TextOut(X1 + nTextWidth, Y1 + 18 * 2, IntToStr(g_GameGoldDeal.GameGold), clAqua);
        TextOut(X1 + nTextWidth, Y1 + 18 * 3, FormatDateTime('mm-dd hh:mm', g_GameGoldDeal.SellDateTime), TextColor);

        case g_GameGoldDeal.DealState of
          s_Normal:begin
              sDealState := '正常';
              DealStateColor := clWhite;
            end;
          s_Cancel:begin
              sDealState := '已取消';
              DealStateColor := clRed;
            end;
          s_Expired:begin
              sDealState := '已过期';
              DealStateColor := clRed;
            end;
          s_Succeed:begin
              sDealState := '正常';
              DealStateColor := clWhite;
            end;
          else
            DealStateColor := clWhite;
        end;

        TextOut(X1 + nTextWidth, Y1 + 18 * 4, sDealState, DealStateColor);

        for I := 0 to g_GameGoldDeal.ItemCount - 1 do begin
          if g_GameGoldDealRemoteItems[I].S.Name <> '' then begin
            d := g_WDnItemImages.Images[g_GameGoldDealRemoteItems[I].S.looks]; //
            if d <> nil then begin
              ARect := Bounds(X3, Y2 + I * ItemHeight, _MIN(d.Width, 16), _MIN(d.Height, 14));
              GameCanvas.StretchDraw(ARect, d.ClientRect, d);
            end;
            if I = GameGoldDealMenuIndex then
              TextOut(X4, Y2 + I * ItemHeight, ProcessItemName(g_GameGoldDealRemoteItems[I].S.Name), clRed)
            else
              TextOut(X4, Y2 + I * ItemHeight, ProcessItemName(g_GameGoldDealRemoteItems[I].S.Name), TextColor);
          end;
        end;

        if g_GameGoldDeal.GameDiamond > 0 then begin
          TextOut(vtRect.Left + 190, Y2 + g_GameGoldDeal.ItemCount * ItemHeight, g_sGameDiamondName + '(' + IntToStr(g_GameGoldDeal.GameDiamond) + ')', TextColor);
        end;
      end;
    end;
  end;
end;

