procedure TFrmDlg.CancelItemMoving; // 右键取消移动物品
var
  idx, n:Integer;
begin
  if g_boItemMoving then begin
    if (g_MovingItem.ItemType in [mtHeroBagItem, mtHeroUseItem]) then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;
      if idx < 0 then begin
        n := -(idx + 1);
        if n in [Low(TUseItems)..High(TUseItems)] then begin
          g_HeroUseItems[n] := g_MovingItem.Item;
        end;
      end
      else if idx in [0..MAX_HERO_BAG_ITEM - 1] then begin
        if g_HeroItemArr[idx].S.Name = '' then begin
          g_HeroItemArr[idx] := g_MovingItem.Item;
        end
        else begin
          AddHeroItemBag(g_MovingItem.Item);
        end;
      end;
      g_MovingItem.Item.S.Name := '';
      ArrangeHeroItembag;
    end
    else if g_MovingItem.ItemType = mtUpgradeItem then begin
      g_boItemMoving := False;
      if g_MovingItem.Index in [0..2] then begin
        g_UpgradeItemArr[g_MovingItem.Index] := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
      end
      else begin
        AddItemBag(g_MovingItem.Item);
        g_MovingItem.Item.S.Name := '';
        ArrangeItembag;
      end;
    end
    else if g_MovingItem.ItemType = mtChallengeItem then begin
      g_boItemMoving := False;
      if g_MovingItem.Index in [0..3] then begin
        g_ChallengeItems[g_MovingItem.Index] := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
      end
      else begin
        AddItemBag(g_MovingItem.Item);
        g_MovingItem.Item.S.Name := '';
        ArrangeItembag;
      end;
    end
    else if (g_MovingItem.ItemType in [mtBagItem, mtUseItem]) then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;

      // 正常应该是右键点框内的物品2下返回到包裹
      if idx = -99 then begin
        for n := 0 to GetMaxBagCount - 1 do begin
          if (g_ItemArr[n].S.Name = '') and (g_ItemArr[n].MakeIndex = g_MovingItem.Item.MakeIndex) then begin
            g_ItemArr[n] := g_MovingItem.Item;
            Break;
          end;
        end;
      end
      else if idx < 0 then begin
        n := -(idx + 1);
        if n in [Low(TUseItems)..High(TUseItems)] then begin
          g_UseItems[n] := g_MovingItem.Item;
        end;
      end
      else if idx in [0..GetMaxBagCount - 1] then begin
        if g_ItemArr[idx].S.Name = '' then begin
          g_ItemArr[idx] := g_MovingItem.Item;
        end
        else begin
          AddItemBag(g_MovingItem.Item);
        end;
      end;
      g_MovingItem.Item.S.Name := '';
      ArrangeItembag;
    end
    else if g_MovingItem.ItemType = mtDealItem then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;
      if (idx <= -20) and (idx > -30) then begin
        AddDealItem(g_MovingItem.Item);
      end;
    end
    else if g_MovingItem.ItemType = mtHeroM2ShopItem then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;
      if idx in [0..19] then begin
        g_HeroM2ShopItems[idx] := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
        ArrangeItembag;
      end;
    end
    else if g_MovingItem.ItemType = mtJewelryItem then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;
      if idx in [Low(TJewelryBoxItems)..High(TJewelryBoxItems)] then begin
        g_JewelryBoxItems[idx] := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
      end;
    end
    else if g_MovingItem.ItemType = mtHeroJewelryItem then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;
      if idx in [Low(TJewelryBoxItems)..High(TJewelryBoxItems)] then begin
        g_HeroJewelryBoxItems[idx] := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
      end;
    end
    else if g_MovingItem.ItemType = mtItemBoxItem then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;
      if idx in [Low(TItemBoxItems)..High(TItemBoxItems)] then begin
        g_ItemBoxItems[idx] := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
      end;
    end
    else if g_MovingItem.ItemType = mtGodBlessItem then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;
      if idx in [Low(TGodBlessItems)..High(TGodBlessItems)] then begin
        g_GodBlessItems[idx] := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
      end;
    end
    else if g_MovingItem.ItemType = mtHeroGodBlessItem then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;
      if idx in [Low(TGodBlessItems)..High(TGodBlessItems)] then begin
        g_HeroGodBlessItems[idx] := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
      end;
    end
    else if g_MovingItem.ItemType = mtGamePetBagItem then begin
      g_boItemMoving := False;
      idx := g_MovingItem.Index;
      if idx in [0..MAX_GAMEPET_BAG_COUNT - 1] then begin
        if g_PetItemArr[idx].S.Name = '' then begin
          g_PetItemArr[idx] := g_MovingItem.Item;
        end
        else begin
          AddPetItemBag(g_MovingItem.Item);
        end;
      end;
      g_MovingItem.Item.S.Name := '';
      ArrangePetItembag;
      ;
    end
    else begin
      {idx := g_MovingItem.Index;
      if idx < 0 then begin
        if (idx <= -20) and (idx > -30) then begin
          AddDealItem(g_MovingItem.Item);
        end else begin
          n := -(idx + 1);
          if n in [Low(TUseItems)..High(TUseItems)] then begin
            g_UseItems[n] := g_MovingItem.Item;
          end;
        end;
      end
      else if idx in [0..MAX_BAG_ITEM - 1] then begin
        if g_ItemArr[idx].S.Name = '' then begin
          g_ItemArr[idx] := g_MovingItem.Item;
        end else begin
          AddItemBag(g_MovingItem.Item);
        end;
      end;
      g_MovingItem.Item.S.Name := '';
      ArrangeItembag;}
    end;
  end;
end;

