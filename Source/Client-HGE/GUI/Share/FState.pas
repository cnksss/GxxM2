              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONARMRINGR, U_FASHIONARMRINGL:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONRINGL:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONRIGHTHAND:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONBELT:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONBOOTS:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
            U_FASHIONCHARM:
              flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          end;

          if flag then begin
            if where in [U_RINGR, U_RINGL] then begin
              if (g_UseItems[U_RINGR].S.Name = '') then
                where := U_RINGR;
              if (g_UseItems[U_RINGL].S.Name = '') then
                where := U_RINGL;
              if (g_UseItems[U_RINGR].S.Name <> '') and (g_UseItems[U_RINGL].S.Name <> '') then begin
                // 修复双击戴戒指只穿右边，不戴左边 chongchong 2013-11-11
                if FIsRingLeft then
                  where := U_RINGL
                else
                  where := U_RINGR;
                FIsRingLeft := not FIsRingLeft;
              end;
            end;

            if where in [U_ARMRINGR, U_ARMRINGL] then begin
              if g_MovingItem.Item.s.StdMode = 25 then
                where := U_ARMRINGL
              else begin
                if g_UseItems[U_ARMRINGR].S.Name = '' then
                  where := U_ARMRINGR;
                if g_UseItems[U_ARMRINGL].S.Name = '' then
                  where := U_ARMRINGL;
                if (g_UseItems[U_ARMRINGR].S.Name <> '') and (g_UseItems[U_ARMRINGL].S.Name <> '') then begin
                  // 修复双击戴手镯只穿右边，不戴左边 chongchong 2013-11-11
                  if FIsArmRingLeft then
                    where := U_ARMRINGL
                  else
                    where := U_ARMRINGR;
                  FIsArmRingLeft := not FIsArmRingLeft;
                end;
              end;
            end;

            if where in [U_FASHIONRINGR, U_FASHIONRINGL] then begin
              if (g_UseItems[U_FASHIONRINGR].S.Name = '') then
                where := U_FASHIONRINGR;
              if g_UseItems[U_FASHIONRINGL].S.Name = '' then
                where := U_FASHIONRINGL;
              if (g_UseItems[U_FASHIONRINGR].S.Name <> '') and (g_UseItems[U_FASHIONRINGL].S.Name <> '') then begin
                // 修复双击戴戒指只穿右边，不戴左边 chongchong 2013-11-11
                if FIsFashionRingLeft then
                  where := U_FASHIONRINGL
                else
                  where := U_FASHIONRINGR;
                FIsFashionRingLeft := not FIsFashionRingLeft;
              end;
            end;

            if where in [U_FASHIONARMRINGR, U_FASHIONARMRINGL] then begin
              if g_UseItems[U_FASHIONARMRINGR].S.Name = '' then
                where := U_FASHIONARMRINGR;
              if g_UseItems[U_FASHIONARMRINGL].S.Name = '' then
                where := U_FASHIONARMRINGL;
              if (g_UseItems[U_FASHIONARMRINGR].S.Name <> '') and (g_UseItems[U_FASHIONARMRINGL].S.Name <> '') then begin
                if FIsFashionArmRingLeft then
                  where := U_FASHIONARMRINGL
                else
                  where := U_FASHIONARMRINGR;
                FIsFashionArmRingLeft := not FIsFashionArmRingLeft;
              end;
            end;

            g_WaitingUseItem := g_MovingItem;
            g_WaitingUseItem.Index := where;
            frmMain.SendTakeOnItem(where, g_MovingItem.Item.MakeIndex, g_MovingItem.Item.S.Name);
            g_MovingItem.Item.S.Name := '';
            g_boItemMoving := False;
          end;
        end else if (g_MovingItem.ItemType = mtBagItem) and (g_MySelf.m_nJewelryBoxStatus = jbsOpen)
          //HZQ 20230525 右戒指笔误
        and (g_MovingItem.Item.s.OverLap and 2 <> 0) and (where in [U_HELMET {头盔}, U_NECKLACE {项链}, U_ARMRINGL {左手镯}, U_ARMRINGR {右手镯}, U_RINGL {左戒指}, U_RINGR {右戒指}]) then begin
          if (g_MovingItem.Item.s.Expand1 = 0) or (g_MovingItem.Item.s.Expand1 = 7) then begin
            WantUseToIndex := 0;
            for I := Low(g_JewelryBoxItems) to High(g_JewelryBoxItems) do begin
              if g_JewelryBoxItems[I].S.Name = '' then begin
                WantUseToIndex := I;
                Break;
              end;
            end;
          end else if g_MovingItem.Item.s.Expand1 in [1..6] then begin
            WantUseToIndex := g_MovingItem.Item.s.Expand1 - 1;
          end else begin
            WantUseToIndex := -1; //HZQ 20230525
          end;

          if WantUseToIndex >= 0 then begin //HZQ 20230525
            g_WaitingUseItem := g_MovingItem;
            g_WaitingUseItem.Index := WantUseToIndex;
            frmMain.SendTakeOnJewelry(WantUseToIndex, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
            g_MovingItem.Item.S.Name := '';
            g_boItemMoving := False;
          end;
        end else if (g_MovingItem.ItemType = mtBagItem) and g_MySelf.m_boShowGodBless
          and (g_MovingItem.Item.s.OverLap and 4 <> 0) then begin
          if g_MovingItem.Item.s.Expand1 = 13 then begin
            WantUseToIndex := -1;
            for I := Low(g_GodBlessItems) to High(g_GodBlessItems) do begin
              if (g_GodBlessItems[I].S.Name = '') and (g_GodBlessItemsState[I] = 1) then begin
                WantUseToIndex := I;
                Break;
              end;
            end;

            if WantUseToIndex = -1 then begin
              for I := Low(g_GodBlessItems) to High(g_GodBlessItems) do begin
                if g_GodBlessItemsState[I] = 1 then begin
                  WantUseToIndex := I;
                  Break;
                end;
              end;
            end;

            if WantUseToIndex >= 0 then begin
              g_WaitingUseItem := g_MovingItem;
              g_WaitingUseItem.Index := WantUseToIndex;
              frmMain.SendTakeOnGodBless(False, WantUseToIndex, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
              g_MovingItem.Item.S.Name := '';
              g_boItemMoving := False;
            end;
          end
          else if g_MovingItem.Item.s.Expand1 in [1..12] then begin
            if (g_GodBlessItemsState[g_MovingItem.Item.s.Expand1 - 1] = 1) then begin
              WantUseToIndex := g_MovingItem.Item.s.Expand1 - 1;

              g_WaitingUseItem := g_MovingItem;
              g_WaitingUseItem.Index := WantUseToIndex;
              frmMain.SendTakeOnGodBless(False, WantUseToIndex, g_WaitingUseItem.Item.MakeIndex, g_WaitingUseItem.Item.S.Name);
              g_MovingItem.Item.S.Name := '';
              g_boItemMoving := False;
            end;
          end;
        end;
      end;
    end;
  end;
end;

procedure TFrmDlg.DItemGridGridPaint(Sender:TObject; ACol, ARow:Integer; Rect:TRect; State:TGridDrawState);
{$J+}
const
  nAniBagCompareImgIndex:Integer = -1;
  nAniBagCompareImgPlayTick:LongWord = 0;
  {$J-}
var
  I, nIdx:Integer;
  DItemGrid:TDxImageGrid;
  R:TRect;
  BagItem:PTClientItem;
  UseItem:PTClientItem;
  nWhere, nWhere1, nWhere2:Integer;
  Flag:Boolean;
  d:TTexture;
  boShowUP:Boolean;
  dwCurTick:DWORD;
begin
  DItemGrid := TDxImageGrid(Sender);
  nIdx := ACol + ARow * DItemGrid.ColCount + 6;
  if nIdx in [6..DItemGrid.ColCount * DItemGrid.RowCount + 6 - 1] then begin
    nIdx := nIdx + FCurrentBagPage * DItemGrid.ColCount * DItemGrid.RowCount; //MAX_EXT_ONE_PAGE_ITEM_COUNT
    BagItem := @g_ItemArr[nIdx];
    R := Bounds(Rect.Left, Rect.Top, DItemGrid.ColWidth, DItemGrid.RowHeight);

    if nIdx >= GetMaxBagCount then begin
      d := g_WNewopUIImages.Images[1636];
      if d <> nil then
        GameCanvas.Draw(R.Left + ((R.Right - R.Left) - d.Width) div 2 + BagItem.s.BagEffect.OffsetX - 1, R.Top + ((R.Bottom - R.Top) - d.Height) div 2, d.ClientRect, d);
      Exit;
    end;

    DrawGridItem(R, BagItem, @g_ItemArrEffect[nIdx]);

    if (Length(BagItem.s.Name) > 0) and g_ClientConfig.boBagFastItemCompare and g_ConfigDlg.ConfigCheckeds[ckBagFastItemCompare] and (not (BagItem.s.StdMode in [93 {宠物加负重}])) then begin
      boShowUP := False;

      Flag := False;
      nWhere := GetTakeOnPosition(BagItem.S.StdMode, BagItem.S.Shape);

      UseItem := nil;
      if (g_MySelf.m_nJewelryBoxStatus = jbsOpen) and (BagItem.s.OverLap and 2 <> 0)
        //HZQ 20230525 右戒指笔误
      and (nWhere in [U_HELMET {头盔}, U_NECKLACE {项链}, U_ARMRINGL {左手镯}, U_ARMRINGR {右手镯}, U_RINGL {左戒指}, U_RINGR {右戒指}]) then begin
        if BagItem.s.Expand1 in [1..6] then begin
          UseItem := @g_JewelryBoxItems[BagItem.s.Expand1 - 1];
        end
        else if BagItem.s.Expand1 in [0, 7] then begin
          for I := Low(g_JewelryBoxItems) to High(g_JewelryBoxItems) do begin
            UseItem := @g_JewelryBoxItems[I];
            boShowUP := CompareItem(BagItem, UseItem, g_MySelf.m_btJob);
            if boShowUP then begin
              UseItem := nil;
              Break;
            end;
          end;
        end;
      end
      else if g_MySelf.m_boShowGodBless and (BagItem.s.OverLap and 4 <> 0) then begin
        if BagItem.s.Expand1 in [1..12] then begin
          if (g_GodBlessItemsState[BagItem.s.Expand1 - 1] = 1) then begin
            UseItem := @g_GodBlessItems[BagItem.s.Expand1 - 1];
          end;
        end
        else if BagItem.s.Expand1 in [13] then begin
          for I := Low(g_GodBlessItems) to High(g_GodBlessItems) do begin
            UseItem := @g_GodBlessItems[I];
            boShowUP := CompareItem(BagItem, UseItem, g_MySelf.m_btJob);
            if boShowUP then begin
              UseItem := nil;
              Break;
            end;
          end;
        end;
      end;

      if UseItem <> nil then begin
        boShowUP := CompareItem(BagItem, UseItem, g_MySelf.m_btJob);
      end;

      if (not boShowUP) and ((BagItem.S.OverLap = 0) or (BagItem.S.OverLap and 1 = 1)) then begin
        case nWhere of
          U_DRESS, U_FASHIONDRESS:begin
              if not ((nWhere = U_FASHIONDRESS) and (g_ClientConfig.boUseOldSerialWindows)) then begin
                Flag := True;
              end;
            end;
          U_WEAPON:
            Flag := True;
          U_NECKLACE:
            Flag := True;
          U_RIGHTHAND:
            Flag := True;
          U_HELMET:
            Flag := True;
          U_RINGR, U_RINGL:
            Flag := True;
          U_ARMRINGR, U_ARMRINGL:
            Flag := True;

          { 1.76界面下面一排不允许装备 chongchong 2013-09-16 }
          U_BUJUK:begin
              if g_ClientConfig.boUseOldSerialWindows and (g_ClientConfig.boStateWindowsType = 0) then begin
                Flag := not g_ClientConfig.boDisableDuFuTakeArmRingL;
                if Flag then
                  nWhere := U_ARMRINGL;
              end
              else begin
                Flag := True;
              end;
            end;
          U_BELT:
            Flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;
          U_BOOTS:
            Flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;
          U_CHARM:
            Flag := (not g_ClientConfig.boUseOldSerialWindows) or (g_ClientConfig.boStateWindowsType <> 0); // True;

          U_HAT:
            Flag := True;
          U_DRUM:
            Flag := (not g_ClientConfig.boUseOldSerialWindows);
          U_HORSE:begin
              Flag := True;
              if g_ClientConfig.boUseOldSerialWindows then begin
                nWhere := U_RIGHTHAND;
              end;
            end;
          U_SHIELD:
            Flag := True; // 盾牌 chongchong 2013-09-16
          U_JADE:
            Flag := (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONWEAPON:
            Flag := (not g_ClientConfig.boUseOldSerialWindows);

          U_FASHIONNECKLACE:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONHELMET:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONARMRINGR, U_FASHIONARMRINGL:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONRINGL:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONRIGHTHAND:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONBELT:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONBOOTS:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
          U_FASHIONCHARM:
            Flag := g_ClientConfig.boFashionJewelryOpen and (not g_ClientConfig.boUseOldSerialWindows);
        end;

        if Flag then begin
          nWhere1 := nWhere;
          nWhere2 := -1;

          if nWhere in [U_RINGR, U_RINGL] then begin
            nWhere1 := U_RINGR;
            nWhere2 := U_RINGL;
          end
          else if nWhere in [U_ARMRINGR, U_ARMRINGL] then begin
            if BagItem.s.StdMode = 25 then
              nWhere1 := U_ARMRINGL
            else begin
              nWhere1 := U_ARMRINGR;
              nWhere2 := U_ARMRINGL;
            end;
          end
          else if nWhere in [U_FASHIONRINGR, U_FASHIONRINGL] then begin
            nWhere1 := U_FASHIONRINGR;
            nWhere2 := U_FASHIONRINGL;
          end
          else if nWhere in [U_FASHIONARMRINGR, U_FASHIONARMRINGL] then begin
            nWhere1 := U_FASHIONARMRINGR;
            nWhere2 := U_FASHIONARMRINGL;
          end;

          if nWhere1 > -1 then begin
            UseItem := @g_UseItems[nWhere1];

            boShowUP := CompareItem(BagItem, UseItem, g_MySelf.m_btJob);
          end;

          if (not boShowUP) and (nWhere2 > -1) then begin
            UseItem := @g_UseItems[nWhere2];

            boShowUP := CompareItem(BagItem, UseItem, g_MySelf.m_btJob);
          end;
        end;
      end;

      if boShowUP and (g_WNewopUIImages <> nil) then begin
        if not g_ConfigClient.boShowAniBagCompareImg then begin
          d := g_WNewopUIImages.Images[1182];
        end else begin
          dwCurTick := MyGetTickCount;
          if nAniBagCompareImgIndex < g_ConfigClient.nShowAniBagCompareImgIndex then begin
            nAniBagCompareImgIndex := g_ConfigClient.nShowAniBagCompareImgIndex;
            nAniBagCompareImgPlayTick := dwCurTick; //MyGetTickCount;
          end else if nAniBagCompareImgIndex >= g_ConfigClient.nShowAniBagCompareImgIndex + g_ConfigClient.nShowAniBagCompareImgCount then begin
            nAniBagCompareImgIndex := g_ConfigClient.nShowAniBagCompareImgIndex;
            nAniBagCompareImgPlayTick := dwCurTick; //MyGetTickCount;
          end;

          if tick_diff(nAniBagCompareImgPlayTick, dwCurTick{MyGetTickCount}) >= Cardinal(g_ConfigClient.nShowAniBagCompareImgPlayTime) then begin
            Inc(nAniBagCompareImgIndex);
            nAniBagCompareImgPlayTick := dwCurTick; //MyGetTickCount;

            if nAniBagCompareImgIndex >= g_ConfigClient.nShowAniBagCompareImgIndex + g_ConfigClient.nShowAniBagCompareImgCount then
              nAniBagCompareImgIndex := g_ConfigClient.nShowAniBagCompareImgIndex;
          end;

          d := g_WNewopUIImages.Images[nAniBagCompareImgIndex];
        end;

        if d <> nil then begin
          GameCanvas.Draw(R.Right - d.Width - 1, R.Bottom - d.Height - 1, d);
        end;
      end;
    end;
  end;
end;

procedure TFrmDlg.DGoldClick(Sender:TObject; X, Y:Integer);
begin
  if g_MySelf = nil then
    Exit;
  if not g_boItemMoving then begin
    if g_MySelf.m_nGold > 0 then begin
      PlaySound(s_money);
      g_boItemMoving := True;
      g_MovingItem.Index := -98;
      g_MovingItem.ItemType := mtBagGold;
      g_MovingItem.Item.S.Name := g_sGoldName {'金币'};
    end;
  end else begin
    if (g_MovingItem.ItemType in [mtBagGold, mtDealGold, mtChallengeGold]) then begin
      g_boItemMoving := False;
      g_MovingItem.Item.S.Name := '';
      if g_MovingItem.ItemType = mtDealGold then begin
        DealZeroGold;
      end else if g_MovingItem.ItemType = mtChallengeGold then begin
        ChallengeZeroGold;
      end;
    end;
  end;
end;

procedure TFrmDlg.ClearMerchantSay;
var
  I:Integer;
  DxControl:TDxControl;
begin
  for I := DMerchantDlg.ControlCount - 1 downto 0 do begin
    DxControl := DMerchantDlg.Control[I];
    if (DxControl is TNpcButton) or (DxControl is TNpcLabel) or (DxControl is TNpcItemButton) or (DxControl is TNpcUserItemButton) or (DxControl is TNpcItemBoxButton) or (DxControl is TNpcProgressBoxButton) or (DxControl is TNpcInputEdit) or (DxControl is TCountDownLabel) or (DxControl is TImgCountDownButton) then begin
      DxControl.Free;
    end;
  end;
end;

procedure TFrmDlg.ClearMerchantSay(Owner:TDxControl);
var
  I {, J}:Integer;
  DxControl:TDxControl;
begin
  for I := Owner.ControlCount - 1 downto 0 do begin
    DxControl := Owner.Control[I];
    if (DxControl is TNpcButton) or (DxControl is TNpcLabel) or (DxControl is TNpcItemButton)
      or (DxControl is TNpcUserItemButton) or (DxControl is TNpcItemBoxButton) or (DxControl is TNpcProgressBoxButton)
      or (DxControl is TNpcInputEdit) or (DxControl is TCountDownLabel) or (DxControl is TNpcGraphicButton) //HZQ 20230606
    or (DxControl is TImgCountDownButton) then begin
      DxControl.Free;
    end;
    if DxControl is TNpcScrollBox then begin
      ClearMerchantSay(DxControl);
    end;
  end;
  if Owner is TNpcScrollBox then
    Owner.Free;
end;

