procedure TFrmDlg.DBotFuncClick(Sender:TObject; X, Y:Integer);
var
  d:TDxImageButton;
  vtRect:TRect;
  sMsg:string;
begin
  d := TDxImageButton(Sender);
  if d.Tag in [0..4] then
    g_NotFilterMsg[d.Tag] := not d.Checked;
  case d.Tag of
    0:begin
        if g_NotFilterMsg[d.Tag] then begin
          sMsg := '允许接受公聊信息';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btShowWhisperFColor), GetRGB(g_ClientConfig.btShowWhisperBColor));
        end
        else begin
          sMsg := '拒绝接受公聊信息';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btCloseWhisperFColor), GetRGB(g_ClientConfig.btCloseWhisperBColor));
        end;
      end;
    1:begin
        if g_NotFilterMsg[d.Tag] then begin
          sMsg := '允许接受（黄色字体）喊话';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btShowWhisperFColor), GetRGB(g_ClientConfig.btShowWhisperBColor));
        end
        else begin
          sMsg := '拒绝接受（黄色字体）喊话';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btCloseWhisperFColor), GetRGB(g_ClientConfig.btCloseWhisperBColor));
        end;
      end;
    2:begin
        if g_NotFilterMsg[d.Tag] then begin
          sMsg := '允许接受私聊信息';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btShowWhisperFColor), GetRGB(g_ClientConfig.btShowWhisperBColor));
        end
        else begin
          sMsg := '拒绝接受私聊信息';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btCloseWhisperFColor), GetRGB(g_ClientConfig.btCloseWhisperBColor));
        end;
      end;
    3:begin
        if g_NotFilterMsg[d.Tag] then begin
          sMsg := '允许接受行会喊话信息';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btShowWhisperFColor), GetRGB(g_ClientConfig.btShowWhisperBColor));
        end
        else begin
          sMsg := '拒绝接受行会喊话信息';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btCloseWhisperFColor), GetRGB(g_ClientConfig.btCloseWhisperBColor));
        end;
      end;
    4:begin
        if g_NotFilterMsg[d.Tag] then begin
          g_dwAutoSayMsgTick := MyGetTickCount;
          g_sAutoSayMsg := DEdChat.Text;
          sMsg := '自动喊话功能开启(间隔:1分钟)，聊天框文字已记录为喊话内容';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btShowWhisperFColor), GetRGB(g_ClientConfig.btShowWhisperBColor));
        end
        else begin
          sMsg := '自动喊话功能已关闭';
          DScreen.AddChatBoardString(sMsg, GetRGB(g_ClientConfig.btCloseWhisperFColor), GetRGB(g_ClientConfig.btCloseWhisperBColor));
        end;
      end;
    5:begin
        vtRect := d.VirtualRect;
        DSpecialCmdMenu.Left := vtRect.Left;
        DSpecialCmdMenu.Top := vtRect.Top - DSpecialCmdMenu.Height;
        DSpecialCmdMenu.Visible := True;
      end;
  end;
end;

procedure TFrmDlg.DBotFuncMouseMove(Sender:TObject; Shift:TShiftState; X, Y:Integer);
var
  nHintX, nHintY:Integer;
  vtRect:TRect;
  sMsg:string;
  d:TDxImageButton;
begin

  d := TDxImageButton(Sender);
  vtRect := d.VirtualRect;
  case d.Tag of
    0:
      if g_NotFilterMsg[d.Tag] then
        sMsg := '允许所有公聊信息'
      else
        sMsg := '拒绝所有公聊信息';
    1:
      if g_NotFilterMsg[d.Tag] then
        sMsg := '允许所有喊话信息'
      else
        sMsg := '拒绝所有喊话信息';
    2:
      if g_NotFilterMsg[d.Tag] then
        sMsg := '允许所有私聊信息'
      else
        sMsg := '拒绝所有私聊信息';
    3:
      if g_NotFilterMsg[d.Tag] then
        sMsg := '允许行会聊天信息'
      else
        sMsg := '拒绝行会聊天信息';
    4:
      sMsg := '自动喊话开关';
    5:
      sMsg := '特殊命令';
  end;
  nHintX := vtRect.Left - CurrentFont.TextWidth(sMsg) - 24;
  nHintY := vtRect.Top;
  HintWindows.Show(nHintX, nHintY, sMsg, clWhite {clYellow}, False);
end;

