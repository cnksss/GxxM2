function TShowGuildList.GetShowGuilds(Index:Integer):PShowGuildInfo;
begin
  Result := nil;
  if (Index >= 0) and (Index < FList.Count) then
    Result := Flist.Items[Index];
end;

procedure TShowGuildList.DoSort;

  procedure QuickSort(L, R:Integer);
  var
    I, J:Integer;
    P:PShowGuildInfo;
  begin
    repeat
      I := L;
      J := R;
      P := FList.Items[L + (R - L) div 2];
      repeat
        while (PShowGuildInfo(FList.Items[I]).OnlineCount > P.OnlineCount) or ((PShowGuildInfo(FList.Items[I]).OnlineCount = P.OnlineCount) and (PShowGuildInfo(FList.Items[I]).Count > P.Count)) do begin
          Inc(I);
        end;

        while (PShowGuildInfo(FList.Items[J]).OnlineCount < P.OnlineCount) or ((PShowGuildInfo(FList.Items[J]).OnlineCount = P.OnlineCount) and (PShowGuildInfo(FList.Items[J]).Count < P.Count)) do begin
          Dec(J);
        end;

        if I <= J then begin
          FList.Exchange(I, J);
          Inc(I);
          Dec(J);
        end;
      until I > J;
      if L < J then
        QuickSort(L, J);
      L := I;
    until I >= R;
  end;

begin
  if FList.Count > 1 then
    QuickSort(0, FList.Count - 1);
end;

