procedure TFrmDlg.DrawGridItem(ARect:TRect; Item:PTClientItem; Effect:Pointer; IsDrawLight:Boolean);
var
  d:TTexture;
  DrawEffect:pTDrawItemEffect;
  GameImages:TGameImages;
  sMsg:string;
  nEffectStartOffSet, nX, nY:Integer;
  BodyEffectStartOffSet:Integer;
  BodyEffectImageCount:Integer;
  EffectOffsetX, EffectOffsetY:Integer;
  DR, SR:TRect;
begin
  if (Item <> nil) and (Item.s.Name <> '') then begin
    DrawEffect := pTDrawItemEffect(Effect);
    d := g_WBagItemImages.Images[Item.s.looks];
    if d <> nil then begin
      SR := Rect(0, 0, d.Width, d.Height);
      DR := SR;
      OffsetRect(DR, ARect.Left + ((ARect.Right - ARect.Left) - d.Width) div 2, ARect.Top + ((ARect.Bottom - ARect.Top) - d.Height) div 2 + 1);
      //      InflateRect(DR, -3, -3);
      GameCanvas.StretchDraw(DR, SR, d);
    end;
    //      GameCanvas.Draw(ARect.Left + ((ARect.Right - ARect.Left) - d.Width) div 2 {-1 修正装备栏物品靠左 chongchong 2015-09-07}, ARect.Top + ((ARect.Bottom - ARect.Top) - d.Height) div 2 + 1, d.ClientRect, d);

        // 默认店铺绘制时不要外观发光特效 chongchong 2014-04-17
    if IsDrawLight then begin
      if (Effect <> nil) and (Item.btHeroM2Light in [1, 2]) then begin // HeroM2 SetItemsLight
        if MyGetTickCount - DrawEffect.dwHeroM2DrawTick >= 180 then begin
          DrawEffect.dwHeroM2DrawTick := MyGetTickCount;
          Inc(DrawEffect.btHeroM2DrawCount);
        end;
        if Item.btHeroM2Light = 1 then begin
          if DrawEffect.btHeroM2DrawCount >= 6 then
            DrawEffect.btHeroM2DrawCount := 0;
        end
        else begin
          if DrawEffect.btHeroM2DrawCount >= 9 then
            DrawEffect.btHeroM2DrawCount := 0;
        end;
        if Item.btHeroM2Light = 1 then begin
          GameImages := g_WMain2Images;
          nEffectStartOffSet := 260;
        end
        else begin
          GameImages := g_WMainImages;
          nEffectStartOffSet := 640;
        end;

        // 背包栏中小格内观绘制时会飘动 chongchong 2015-05-04
        //if Item.s.EffectDrawCenter then
        begin
          d := GameImages.Images[nEffectStartOffSet + DrawEffect.btHeroM2DrawCount];
          if d <> nil then
            GameCanvas.DrawBlend(ARect.Left + ((ARect.Right - ARect.Left) - d.Width) div 2 + Item.s.BagEffect.OffsetX - 1, ARect.Top + ((ARect.Bottom - ARect.Top) - d.Height) div 2 + Item.s.BagEffect.OffsetY + 1, d.ClientRect, d);
        end;
        {
        else
        begin
          d := GameImages.GetCachedImage(nEffectStartOffSet + DrawEffect.btHeroM2DrawCount, nX, nY);
          if d <> nil then
            GameCanvas.DrawBlend(ARect.Left + nX + Item.s.EffectOffsetX,
              ARect.Top + nY + Item.s.EffectOffsetY,
              d.ClientRect,
              d);
        end;
        }
      end;

      // DB库的首饰包裹特效扩展 piaoyun 2013-08-01
      if Item.s.Light > 0 then begin
        // 修正这个鸟东东没有给初值，有时候会乱搞一通 chongchong 2015-01-05
        BodyEffectStartOffSet := -1;

        GameImages := g_WMain2Images;
        EffectOffsetX := 0;
        EffectOffsetY := 0;
        BodyEffectImageCount := 0; //HZQ 20230525

        case Item.s.Light of
          1: {//1时读取  Prguse2.wzl 230-249   2时读250-257   3时读260-265} begin
              BodyEffectStartOffSet := 230;
              BodyEffectImageCount := 20;
            end;
          2:begin
              BodyEffectStartOffSet := 250;
              BodyEffectImageCount := 8;
            end;
          3:begin
              BodyEffectStartOffSet := 260;
              BodyEffectImageCount := 6;
            end;
          4..8: {//4时读取Prguse3.wzl750-751   5=752-753  6=754-755 7-756-757  8=758-759} begin
              GameImages := g_WMain3Images;
              BodyEffectStartOffSet := 750 + ((Item.s.Light - 4) * 2);
              BodyEffectImageCount := 2;
            end;
          //////////////// 增加9-14特效 piaoyun 2013-08-17 //////////////////////
          9:begin
              GameImages := g_WStateItemImages.Indexs[0];
              BodyEffectStartOffSet := 3580;
              BodyEffectImageCount := 3605 - 3580;
            end;
          10:begin
              GameImages := g_WStateItemImages.Indexs[0];
              BodyEffectStartOffSet := 3910;
              BodyEffectImageCount := 3919 - 3910;
            end;
          11:begin

              BodyEffectStartOffSet := 640;
              BodyEffectImageCount := 15;
              EffectOffsetX := 16;
              EffectOffsetY := 20;
            end;
          12:begin
              GameImages := g_StateEffectImages;
              BodyEffectStartOffSet := 680;
              BodyEffectImageCount := 705 - 680;
              EffectOffsetX := 16;
              EffectOffsetY := 20;
            end;
          13:begin
              GameImages := g_StateEffectImages;
              BodyEffectStartOffSet := 720;
              BodyEffectImageCount := 25;
              EffectOffsetX := 16;
              EffectOffsetY := 20;
            end;
          14:begin
              GameImages := g_WMainImages;
              BodyEffectStartOffSet := 640;
              BodyEffectImageCount := 8;
              EffectOffsetX := 16;
              EffectOffsetY := 20;
            end;
          ////////////////////////////////////////////////////////////////////////
          100..199:begin
              if not (Item.s.StdMode in [5, 6 {武器}, 68, 69 {时装武器}, 10, 11 {衣服}, 66, 67 {时装衣服}]) then begin
                GameImages := g_WHeadgearEffect;
                BodyEffectStartOffSet := (Item.s.Light - 100) * 20;
                BodyEffectImageCount := 20;
              end;
            end;
          200..299:begin
              if not (Item.s.StdMode in [5, 6 {武器}, 68, 69 {时装武器}, 10, 11 {衣服}, 66, 67 {时装衣服}]) then begin
                GameImages := g_WHeadgearEffect2;
                BodyEffectStartOffSet := (Item.s.Light - 200) * 20;
                BodyEffectImageCount := 20;
              end;
            end;
          300..399:begin
              if not (Item.s.StdMode in [5, 6 {武器}, 68, 69 {时装武器}, 10, 11 {衣服}, 66, 67 {时装衣服}]) then begin
                GameImages := g_WHeadgearEffect3;
                BodyEffectStartOffSet := (Item.s.Light - 300) * 20;
                BodyEffectImageCount := 20;
              end;
            end;
          400..499:begin
              if not (Item.s.StdMode in [5, 6 {武器}, 68, 69 {时装武器}, 10, 11 {衣服}, 66, 67 {时装衣服}]) then begin
                GameImages := g_WHeadgearEffect4;
                BodyEffectStartOffSet := (Item.s.Light - 400) * 20;
                BodyEffectImageCount := 20;
              end;
            end;
          500..599:begin
              if not (Item.s.StdMode in [5, 6 {武器}, 68, 69 {时装武器}, 10, 11 {衣服}, 66, 67 {时装衣服}]) then begin
                GameImages := g_WHeadgearEffect5;
                BodyEffectStartOffSet := (Item.s.Light - 500) * 20;
                BodyEffectImageCount := 20;
              end;
            end;
          600..699:begin
              if not (Item.s.StdMode in [5, 6 {武器}, 68, 69 {时装武器}, 10, 11 {衣服}, 66, 67 {时装衣服}]) then begin
                GameImages := g_WHeadgearEffect6;
                BodyEffectStartOffSet := (Item.s.Light - 600) * 20;
                BodyEffectImageCount := 20;
              end;
            end;
        end;

        if MyGetTickCount - DrawEffect.dwDrawTick >= 200 then begin
          DrawEffect.dwDrawTick := MyGetTickCount;
          Inc(DrawEffect.btDrawCount);
        end;

        if DrawEffect.btDrawCount >= BodyEffectImageCount then
          DrawEffect.btDrawCount := 0;

        if (GameImages <> nil) and (BodyEffectStartOffSet >= 0) then begin
          d := GameImages.GetCachedImage(BodyEffectStartOffSet + DrawEffect.btDrawCount, nX, nY);
          nX := nX + EffectOffsetX;
          nY := nY + EffectOffsetY;
          if d <> nil then
            GameCanvas.DrawBlend(ARect.Left + ((ARect.Right - ARect.Left) - d.Width) div 2 + nX - 1, ARect.Top + ((ARect.Bottom - ARect.Top) - d.Height) div 2 + nY + 1, d.ClientRect, d);
        end;
      end;

      //////////////////////////////////////////////////////////////////////
      // 首饰数据库特效和扩展特效共存 chongchong 2018-02-07
      if (Effect <> nil) and (Item.s.BagEffect.FileIndex >= 0) and (Item.s.BagEffect.FileIndex < g_EffectImageList.Count) and (Item.s.BagEffect.ImageCount > 0) then begin

        if MyGetTickCount - DrawEffect.dwDrawTick >= Item.s.BagEffect.Time then begin
          DrawEffect.dwDrawTick := MyGetTickCount;
          Inc(DrawEffect.btDrawCount);
        end;

        if DrawEffect.btDrawCount >= Item.s.BagEffect.ImageCount then
          DrawEffect.btDrawCount := 0;

        GameImages := TGameImages(g_EffectImageList.Objects[Item.s.BagEffect.FileIndex]);
        if GameImages <> nil then begin
          d := GameImages.GetCachedImage(Item.s.BagEffect.ImageStart + DrawEffect.btDrawCount, nX, nY);
          // d := GameImages.Images[Item.s.BagEffect.ImageStart + DrawEffect.btDrawCount];
          if d <> nil then begin
            // 背包栏中小格内观绘制时会飘动 chongchong 2015-05-04
            if Item.s.BagEffect.IsDrawCenter then begin
              if Item.s.BagEffect.IsDrawNoBlend then begin
