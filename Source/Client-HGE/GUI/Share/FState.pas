procedure TFrmDlg.DMenuDlgDirectPaint(Sender:TObject);
var
  I, lh, m, menuline:Integer;
  pg:PTClientGoods;
  R1, R2, R3:TRect;
  sMsg:string;
  nLeft, nTop:Integer;
begin
  nTop := _ListViewMenuDlg.ViewRect.Top;
  nLeft := _ListViewMenuDlg.ViewRect.Left;

  MenuList.Lock;
  try
    if not BoStorageMenu then begin
      _DLableMenuDlgC1.Caption := '物品列表';
      _DLableMenuDlgC2.Caption := '费用';
      _DLableMenuDlgC3.Caption := '持久';
      lh := _ListViewMenuDlg.ItemHeight;
      menuline := _MIN(_ListViewMenuDlg.ShowItemCount, MenuList.Count - MenuTop);
      // DebugOutStr('MenuTop = '+IntToStr(MenuTop));
      // DebugOutStr('MenuTop + menuline - 1 = '+IntToStr(MenuTop + menuline - 1));
      for I := MenuTop to MenuTop + menuline - 1 do begin
        m := I - MenuTop;

        pg := PTClientGoods(MenuList[I]);

        if I = menuindex then begin
          // DebugOutStr('i = MenuIndex');
            { TODO -opiaoyun -c修复 : 修复购买物品点击时前面的红点Char(7) 【2013-5-26】}
          R1 := _ListViewMenuDlg.ColRects[0];
          R2 := _ListViewMenuDlg.ColRects[1];
          R3 := _ListViewMenuDlg.ColRects[2];

          CurrentFont.TextOut(nLeft + R1.Left + 2, (nTop + m * lh), '·' {Char(7)} + pg.Name, clRed);

          if pg.Count > 1 then begin
            sMsg := 'x' + IntToStr(pg.Count);
            CurrentFont.TextOut(nLeft + R1.Right - CurrentFont.TextWidth(sMsg) - 5, (nTop + m * lh), sMsg, clSkyBlue);
          end;

          CurrentFont.TextOut(nLeft + R2.Left + 2, (nTop + m * lh), IntToStr(pg.Price) + ' ' + g_sGoldName, clRed);

          if pg.SubMenu >= 1 then
            CurrentFont.TextOut(nLeft + R3.Left + 2, (nTop + m * lh), '>>>>', clRed) // 有二级列表则添加一个符号
          else if pg.Grade <> -1 then
            CurrentFont.TextOut(nLeft + R3.Left + 2, (nTop + m * lh), IntToStr(pg.Grade), clRed);
        end
        else begin
          R1 := _ListViewMenuDlg.ColRects[0];
          R2 := _ListViewMenuDlg.ColRects[1];
          R3 := _ListViewMenuDlg.ColRects[2];

          CurrentFont.TextOut(nLeft + R1.Left + 2, (nTop + m * lh), ' ' + pg.Name, clWhite);

          if pg.Count > 1 then begin
            sMsg := 'x' + IntToStr(pg.Count);
            CurrentFont.TextOut(nLeft + R1.Right - CurrentFont.TextWidth(sMsg) - 5, (nTop + m * lh), sMsg, clSkyBlue);
          end;

          CurrentFont.TextOut(nLeft + R2.Left + 2, (nTop + m * lh), IntToStr(pg.Price) + ' ' + g_sGoldName, clWhite);

          if pg.SubMenu >= 1 then
            CurrentFont.TextOut(nLeft + R3.Left + 2, (nTop + m * lh), ' ', clWhite) // 有二级列表则添加一个符号
          else if pg.Grade <> -1 then
            CurrentFont.TextOut(nLeft + R3.Left + 2, (nTop + m * lh), IntToStr(pg.Grade), clWhite);
        end;
      end;
    end
    else begin
      _DLableMenuDlgC1.Caption := '物品列表';
      _DLableMenuDlgC2.Caption := '持久';
      _DLableMenuDlgC3.Caption := '';

      lh := _ListViewMenuDlg.ItemHeight;
      menuline := _MIN(_ListViewMenuDlg.ShowItemCount, MenuList.Count - MenuTop);

      for I := MenuTop to MenuTop + menuline - 1 do begin
        m := I - MenuTop;
        pg := PTClientGoods(MenuList[I]);

        R1 := _ListViewMenuDlg.ColRects[0];
        R2 := _ListViewMenuDlg.ColRects[1];
        R3 := _ListViewMenuDlg.ColRects[2];

        if I = menuindex then begin
          CurrentFont.TextOut(nLeft + R1.Left + 2, (nTop + m * lh), pg.Name, clRed);
        end
        else begin
          CurrentFont.TextOut(nLeft + R1.Left + 2, (nTop + m * lh), pg.Name, clWhite);
        end;
        if pg.Count > 1 then begin
          sMsg := 'x' + IntToStr(pg.Count);
          CurrentFont.TextOut(nLeft + R1.Right - CurrentFont.TextWidth(sMsg) - 5, (nTop + m * lh), sMsg, clSkyBlue);
        end;

        if pg.SubMenu >= 1 then
          CurrentFont.TextOut(nLeft + R1.Left + 2, (nTop + m * lh), #31, clWhite);

        CurrentFont.TextOut(nLeft + R2.Left + 2, (nTop + m * lh), IntToStr(pg.Stock) + '/' + IntToStr(pg.Grade), clWhite);
      end;
    end;
  finally
    MenuList.UnLock;
  end;
end;

