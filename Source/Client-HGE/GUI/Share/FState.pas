procedure TFrmDlg.DMinMapDlgMouseUp(Sender:TObject; Button:TMouseButton; Shift:TShiftState; X, Y:Integer);
var
  nX, nY, nMapX, nMapY:Integer;
  vtRect, MapRect:TRect;
  d:TTexture;
begin
  if Button = mbRight then begin
    g_boMinMapTransparent := not g_boMinMapTransparent;
    Exit;
  end;

  if g_nMiniMapIndex < 0 then
    Exit;

  if not g_ClientConfig.boMinMapUseFindPath then
    Exit;

  // 加入小地图寻路功能 2019-05-17 11:47:26
  if (g_MySelf <> nil) and (not g_MySelf.m_boDeath) then begin
    { TODO -c修正 -ochongchong : 小地图扩展再修改 【2013-4-23】}
    case g_nMiniMapIndex of
      9900..9999:
        d := g_WBmpMapImages.Images[g_nMiniMapIndex - 9900]; // 预留
      // mmap10.wil从10001-15000开始
      10000..14999:
        d := g_WMMapImages10.Images[g_nMiniMapIndex - 10000];

      // mmap11.wil从15001-20000开始
      15000..19999:
        d := g_WMMapImages11.Images[g_nMiniMapIndex - 15000];

      // mmap12.wil从20001-24999开始
      20000..24999:
        d := g_WMMapImages12.Images[g_nMiniMapIndex - 20000];

      else
        d := g_WMMapImages.Images[g_nMiniMapIndex];
    end;

    if (d = nil) then
      Exit;

    vtRect := DMinMapDlg.VirtualRect;
    case g_nViewMinMapLv of
      1:begin // 局部
          ActorXYToMapXY(g_MySelf.m_nCurrX, g_MySelf.m_nCurrY, nX, nY);
          MapRect := Bounds(_Max(0, nX - DMinMapDlg.Width div 2), _Max(0, nY - DMinMapDlg.Height div 2), DMinMapDlg.Width, DMinMapDlg.Height);
        end;
      2:begin // 全景地图
          MapRect := vtRect;
        end;
    end;

    if Button = mbLeft then begin
      if (abs(g_MySelf.m_nCurrX - nX) <= 1) and (abs(g_MySelf.m_nCurrY - nY) <= 1) then begin
        LegendMap.Stop;
      end
      else begin
        if LegendMap.StartFind then begin
          if (LegendMap.EndX <> nX) or (LegendMap.EndY <> nY) then begin
            LegendMap.Stop;
          end
          else
            Exit;
        end;
        LegendMap.Stop;

        if g_nViewMinMapLv = 1 then begin
          nMapX := (X - vtRect.Left + MapRect.Left);
          nMapY := (Y - vtRect.Top + MapRect.Top);
          MapXYToActorXY(nMapX, nMapY, nX, nY);
        end
        else if g_nViewMinMapLv = 2 then begin
          nMapX := Round((X - vtRect.Left) * d.Width / DMinMapDlg.Width);
          nMapY := Round((Y - vtRect.Top) * d.Height / DMinMapDlg.Height);

          MapXYToActorXY(nMapX, nMapY, nX, nY);
        end;

        LegendMap.BeginX := g_MySelf.m_nCurrX;
        LegendMap.BeginY := g_MySelf.m_nCurrY;
        LegendMap.EndX := nX;
        LegendMap.EndY := nY;
        frmMain.SendClientMessage(CM_AUTOFINDPATHINFO, 0, 0, 0, 1, '');
        DScreen.AddChatBoardString(Format(DecodeResStr(SFindPathHint), [nX, nY]), GetRGB(154), clWhite);
      end;
    end;
  end;
end;

