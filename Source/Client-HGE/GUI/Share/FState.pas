begin
  {$IF IsMultiThreadRender = 1}
  DBackground.Lock;
  try
    {$IFEND}
    ColorList := TList.Create;
    ItemList := TList.Create;
    ImageList := TList.Create;
    LabelList := TList.Create;
    InputList := TList.Create;

    ClearMerchantSay(AOwner);
    Str := Text;
    nX := X;
    nY := Y;
    if (AOwner is TDxImageForm) and ChangeOwnerSize then
      TDxImageForm(AOwner).AutoSize := True;

    nMaxWidth := 0;
    nMaxHeight := 0;
    // showmessage(Text);
    while True do begin
      if Str = '' then Break;

      Str := GetValidStr3_Ex(Str, sTemp, '\');
      Data := sTemp;
      if Data <> '' then begin
        fdata := '';

        // 替换有颜色的{} {MirYQ/AUTOCOLOR=254,251,168,191,250,70,245,249,253}
        nPos1 := Pos('{', Data);
        nPos2 := Pos('/', Data);
        nPos3 := Pos('}', Data);
        if (nPos1 > 0) and (nPos2 > 0) and (nPos3 > 0) then begin
          bo1D := False;
          bo2D := False;
          for I := 1 to Length(Data) do begin
            if Data[I] = '{' then begin
              bo1D := True;
              nPos1 := I;
              Continue;
            end;

            if (Data[I] = '/') then begin
              if bo1D then begin
                bo2D := True;
                nPos2 := I;
                Continue;
              end else begin
                bo1D := False;
                bo2D := False;
              end;
            end;
            if (Data[I] = '}') then begin
              if bo1D and bo2D then begin
                sColor := Copy(Data, nPos2 + 1, I - nPos2 - 1); //Copy(Data, nPos2 + 1, I);
                if CompareLStr(sColor, C_FCOLOR, Length(C_FCOLOR)) or CompareLStr(sColor, C_SCOLOR, Length(C_SCOLOR)) then begin
                  Data[nPos1] := '<';
                  Data[I] := '>';
                  bo1D := False;
                  bo2D := False;
                  Continue;
                end else if CompareLStr(sColor, C_AUTOCOLOR, Length(C_AUTOCOLOR)) then begin
                  Data[nPos1] := '<';
                  Data[I] := '>';
                  bo1D := False;
                  bo2D := False;
                  Continue;
                end else begin
                  bo1D := False;
                  bo2D := False;
                end;
              end else begin
                bo1D := False;
                bo2D := False;
              end;
            end;
          end;
        end;

        while (Pos('<', Data) > 0) and (Pos('>', Data) > 0) and (Data <> '') do begin
          fdata := '';
          cmdstr := '';
          cmdparam := '';
          btFontSize := 9;
          sFontName := '宋体';
          FontStyle := [];
          if Data[1] <> '<' then
            Data := '<' + GetValidStr3_Ex(Data, fdata, '<');

          // 如果出这样的 <<$STR(A1041)>/FCOLOR=254> 就比较蛋疼了。。
          Data := ArrestStringEx(Data, '<', '>', cmdstr);

          if Length(cmdstr) > 0 then begin
            if not CompareLStr(cmdStr, C_IMGQR, Length(C_IMGQR)) then begin //HZQ 20230606 前置判断如果是IMGQR命令，不再处理字符
              if UpperCase(cmdstr) = 'C' then begin
                Continue;
              end;

              if UpperCase(cmdstr) = '/C' then begin
                Continue;
              end;

              {/FCOLOR=232}
              if cmdstr[1] = '/' then begin
                cmdstr := '';
              end else begin
                cmdparam := GetValidStr3_Ex(cmdstr, cmdstr, '/');
              end;
            end;
            // cmdstr 标题   cmdparam 命令
          end else begin
            CloseDMenuDlg;
            CloseDSellDlg;
          end;

          if Length(fdata) > 0 then begin
            // DecodeColor(fdata, '', nil);
            nX := nX + NewNpcLabel(fdata, '', clWhite, clGreen, clWhite, sFontName, btFontSize, FontStyle, nil);
          end;

          UseColor := clRed;

          if (Length(cmdparam) > 0) and (cmdparam[1] <> '@') then begin
            sTemp := cmdparam;
            while {Pos(',', cmdparam) > 0}  sTemp <> '' do begin
              sTemp := GetValidStr3_Ex(sTemp, cmdparam, ':');
              if CompareLStr(cmdparam, C_FCOLOR, Length(C_FCOLOR)) or CompareLStr(cmdparam, C_SCOLOR, Length(C_SCOLOR)) then begin
                cmdparam := Trim(cmdparam);
                sColor := Trim(Copy(cmdparam, Length(C_FCOLOR) + 1, Length(cmdparam) - Length(C_FCOLOR)));
                btColor := StrToIntDef(sColor, 100);
                UseColor := GetRGB(btColor);
                cmdparam := '';
              end else if CompareLStr(cmdparam, C_AUTOCOLOR, Length(C_AUTOCOLOR)) then begin
                cmdparam := Trim(cmdparam);
                sColor := Trim(Copy(cmdparam, Length(C_AUTOCOLOR) + 1, Length(cmdparam) - Length(C_AUTOCOLOR)));
                GetColorList(sColor);
                if ColorList.Count > 0 then
                  UseColor := TColor(ColorList.Items[0]);
                cmdparam := '';
              end else if CompareLStr(cmdparam, C_FNAME, Length(C_FNAME)) then begin
                cmdparam := Trim(cmdparam);
                sFontName := Trim(Copy(cmdparam, Length(C_FNAME) + 1, Length(cmdparam) - Length(C_FNAME)));
                cmdparam := '';
              end else if CompareLStr(cmdparam, C_FSIZE, Length(C_FSIZE)) then begin
                cmdparam := Trim(cmdparam);
                sColor := Trim(Copy(cmdparam, Length(C_FSIZE) + 1, Length(cmdparam) - Length(C_FSIZE)));
                btFontSize := StrToIntDef(sColor, 9);
                cmdparam := '';
              end else if CompareLStr(cmdparam, C_FBOLD, Length(C_FBOLD)) then begin
                FontStyle := FontStyle + [fsBold];
                cmdparam := '';
              end;
            end;
            // nPos := Pos('FCOLOR=', cmdparam);
          end;

          if (Length(cmdstr) > 0) and (Length(cmdparam) > 0) and (cmdparam[1] = '@') then begin
            // 超链接按钮 -- 文字、颜色  -- piaoyun 2013-07-04
            FontStyle := FontStyle + [fsUnderline];
            nX := nX + NewNpcLabel(cmdstr, cmdparam, GetRGB(g_ClientConfig.btNPCLabelNormalColor), GetRGB(g_ClientConfig.btNpcLabelMouseMoveColor), {clGreen}
              GetRGB(g_ClientConfig.btNpcLabelMouseDownColor) {clRed}, sFontName, btFontSize, FontStyle, AOnClick);
          end else begin
            if (cmdstr <> '') then begin
              nX := nX + NewNpcLabel(cmdstr, '', UseColor, clGreen, UseColor, sFontName, btFontSize, FontStyle, nil);
            end;
          end;
        end;
        if Length(Data) > 0 then
          nX := nX + NewNpcLabel(Data, '', clWhite, clGreen, clWhite, '宋体', 9, [], nil);
        // DecodeColor(Data, '', nil);
      // Data := '';
      end;
      nX := X;
      nY := nY + OneLineHeight; // 16 2020-03-03 23:31:46
    end;

    if ChangeOwnerSize then begin
      if (nMaxWidth > AOwner.Width) or (nMaxHeight > AOwner.Height) then begin
        if AOwner is TDxImageForm then
          TDxImageForm(AOwner).AutoSize := False;
        AOwner.Width := _Max(nMaxWidth, AOwner.Width);
        AOwner.Height := _Max(nMaxHeight, AOwner.Height);
      end;
    end;
    ColorList.Free;

    Components := TList.Create;
    for I := AOwner.ComponentCount - 1 downto 0 do begin
      Components.Add(AOwner.Components[I]);
      AOwner.RemoveComponent(AOwner.Components[I]);
    end;

    for I := 0 to Components.Count - 1 do begin
      AOwner.InserComponent(Components[I]);
    end;

    //开始处理滚动容器

    for I := {0 to } Components.Count - 1 downto 0 do begin
      if TDxControl(Components.Items[I]) is TNpcScrollBox then begin
        nX := 9999999;
        nY := 9999999;
        for J := 0 to TNpcScrollBox(Components.Items[I]).m_List.Count - 1 do begin
          for K := 0 to Components.Count - 1 do begin
            if TDxControl(Components.Items[K]).ControlID = StrToIntDef(TNpcScrollBox(Components.Items[I]).m_List.Strings[J], -1) then begin
              if TDxControl(Components.Items[K]) is TNpcItemButton then
                TDxControl(Components.Items[K]).Tag := 2
              else if (TDxControl(Components.Items[K]) is TNpcButton) or (TDxControl(Components.Items[K]) is TNpcProgressBoxButton) then
                TDxControl(Components.Items[K]).Tag := 1;

              nX := _MIN(TDxControl(Components.Items[K]).Left, nX);
              nY := _MIN(TDxControl(Components.Items[K]).Top, nY);
              TDxControl(Components.Items[K]).Owner.RemoveComponent(Components.Items[K]);
              TNpcScrollBox(Components.Items[I]).InserComponent(Components.Items[K]);
              if TDxControl(Components.Items[K]) is TNpcScrollBox then
                TNpcScrollBox(Components.Items[K]).MouseScroll := False;
            end;
          end;
          //ControlID
        end;
        TNpcScrollBox(Components.Items[I]).OffSetX := nX;
        TNpcScrollBox(Components.Items[I]).OffsetY := nY;
      end;
    end;
    //结束
    Components.Free;

    for I := 0 to ImageList.Count - 1 do begin
      TDxImageButton(ImageList.Items[I]).BringToFront;
    end;
    ImageList.Free;

    for I := 0 to ItemList.Count - 1 do begin
      TDxImageButton(ItemList.Items[I]).BringToFront;
    end;
    ItemList.Free;

    for I := 0 to LabelList.Count - 1 do begin
      TDxLabel(LabelList.Items[I]).BringToFront;
      if (TNpcLabel(LabelList.Items[I]).m_sCmd = '') and (Length(TNpcLabel(LabelList.Items[I]).Hint) = 0) then
        TDxLabel(LabelList.Items[I]).Enabled := False;
    end;
    LabelList.Free;

    for I := 0 to InputList.Count - 1 do begin
      TNpcInputEdit(InputList.Items[I]).BringToFront;
    end;
    InputList.Free;

    {$IF IsMultiThreadRender = 1}
  finally
    DBackground.UnLock;
  end;
  {$IFEND}
end;

procedure TFrmDlg.AddMissionMemo1(Page:Byte; Text:string);
var
  I:Integer;
  nPos:Integer;
  DMemo:TDxTreeView;
  TextList:TStringList;
  sText, sCmd:string;
  TreeNode:TDxTreeNode;
  ChildTreeNode:TDxTreeNode;

  function NewNpcLabel(ACaption, ACmd:string; Up, Hot, Down:TColor; Style:TFontStyles):TDxTreeNode;
  var
    DLabel:TMissionLabel;
  begin
    DLabel := TMissionLabel.Create;
    DLabel.Caption := ACaption;
    DLabel.CaptionColor.Up.Color := Up;
    DLabel.CaptionColor.Hot.Color := Hot;
    DLabel.CaptionColor.Down.Color := Down;
    DLabel.CaptionColor.Up.Style := Style;
    DLabel.CaptionColor.Hot.Style := Style;
    DLabel.CaptionColor.Down.Style := Style;
    DLabel.m_sCmd := ACmd;
    // NpcLabel.Width := CurrentFont.TextWidth(ACaption);
    // NpcLabel.Height := g_CurrentFontHeight;

    Result := DLabel;
  end;

begin
  DMemo := GetMissionTreeView(Page);
  if DMemo = nil then
    Exit;

  DMemo.Clear;

  // DScreen.AddChatBoardString(Text, clYellow, clRed);

  TextList := TStringList.Create;
  ExtractStrings(['\'], [' '], PChar(Text), TextList);

  for I := TextList.Count - 1 downto 0 do begin
    TextList[I] := Trim(TextList[I]);
    if TextList[I] = '' then begin
      TextList.Delete(I);
    end;
  end;

  TreeNode := nil;
  for I := 0 to TextList.Count - 1 do begin
    sText := TextList[I];
    sText := Trim(sText);
    if sText[1] = '<' then
      sText := Copy(sText, 2, Length(sText) - 1);
    if sText[Length(sText)] = '>' then
      sText := Copy(sText, 1, Length(sText) - 1);
    sCmd := '';
    nPos := Pos('/@', sText);
    if nPos > 0 then begin
      sCmd := Copy(sText, nPos + 1, Length(sText) - nPos);
      sText := Copy(sText, 1, nPos - 1);
    end;

    if sCmd <> '' then begin
      if TreeNode = nil then begin
        TreeNode := NewNpcLabel('', '', clWhite, $44F5F2, clRed, []); // clYellow
        DMemo.Add(TreeNode);
      end;
      ChildTreeNode := NewNpcLabel(sText, sCmd, clWhite, $44F5F2, clRed, []);
      // clYellow
      TreeNode.Add(ChildTreeNode);
    end
    else begin
      TreeNode := NewNpcLabel(sText, sCmd, clWhite, $44F5F2, clRed, []);
      // clYellow
      DMemo.Add(TreeNode);
    end;
  end;
  if DMemo.Count > 0 then begin
    DMemo.Items[0].Expand := True;
  end;

  TextList.Free;
end;

