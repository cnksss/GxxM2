procedure TFrmDlg.SaveMagicButtons;
var
  I, nCount:Integer;
  Ctrl:TMagicButton;
  S:string;
  IniFile:TIniFile;
  SL:TStringList;
begin
  if g_ConfigClient.boDisableDrogMagicIcon then
    Exit;
  if not g_ConfigClient.boSaveMagicIconPosition then
    Exit;

  S := g_sSelfFilePath + 'Config\';
  if not DirectoryExists(S) then
    ForceDirectories(S);

  if (g_MySelf <> nil) and (g_MySelf.m_sUserName <> '') then begin
    g_sPlugUserName := ProcessFileNameSpecialChar(g_MySelf.m_sUserName);
  end;

  S := g_sSelfFilePath + Format(MAGIC_ICONS_INI_FILE, [g_sPlugServerName, g_sPlugUserName]);

  nCount := 0;
  IniFile := TIniFile.Create(S);
  try
    SL := TStringList.Create;
    try
      IniFile.ReadSections(SL);
      for I := 0 to SL.Count - 1 do begin
        IniFile.EraseSection(SL[I]);
      end;
    finally
      SL.Free;
    end;

    IniFile.WriteInteger('Setup', 'Count', 0);

    for I := 0 to FScreenMagicBtnList.Count - 1 do begin
      Ctrl := TMagicButton(FScreenMagicBtnList[I]);
      if Ctrl.m_Magic <> nil then begin
        S := 'Magic' + IntToStr(nCount + 1);

        IniFile.WriteInteger(S, 'MagicID', Ctrl.m_Magic.Def.wMagicId);
        IniFile.WriteInteger(S, 'X', Ctrl.Left);
        IniFile.WriteInteger(S, 'Y', Ctrl.Top);
        Inc(nCount);
      end;
    end;

    IniFile.WriteInteger('Setup', 'Count', nCount);
  finally
    IniFile.Free;
  end;
end;

procedure TFrmDlg.LoadMagicButtons;
var
  I, II, nCount:Integer;
  S:string;
  IniFile:TIniFile;
  MagicID, nX, nY:Integer;
  pcm:PTClientMagic;
begin
  if g_ConfigClient.boDisableDrogMagicIcon then
    Exit;
  if not g_ConfigClient.boSaveMagicIconPosition then
    Exit;

  S := g_sSelfFilePath + 'Config\';
  if not DirectoryExists(S) then
    ForceDirectories(S);

  if (g_MySelf <> nil) and (g_MySelf.m_sUserName <> '') then begin
    g_sPlugUserName := ProcessFileNameSpecialChar(g_MySelf.m_sUserName);
  end;

  S := g_sSelfFilePath + Format(MAGIC_ICONS_INI_FILE, [g_sPlugServerName, g_sPlugUserName]);

  //nCount := 0; HZQ20250525
  IniFile := TIniFile.Create(S);
  try
    nCount := IniFile.ReadInteger('Setup', 'Count', 0);

    for I := 0 to nCount - 1 do begin
      S := 'Magic' + IntToStr(I + 1);

      MagicID := IniFile.ReadInteger(S, 'MagicID', 0);
      nX := IniFile.ReadInteger(S, 'X', 0) + 16;
      nY := IniFile.ReadInteger(S, 'Y', 0) + 15;

      g_MagicList.Lock;
      try
        for II := 0 to g_MagicList.Count - 1 do begin
          pcm := g_MagicList.Items[II];

          if pcm.Def.wMagicId = MagicID then begin
            if nX < 0 then
              nX := 0
            else if nX > SCREENWIDTH - 32 then
              nX := SCREENWIDTH - 32;

            if nY < 0 then
              nX := 0
            else if nY > SCREENHEIGHT - 32 then
              nY := SCREENHEIGHT - 32;

            FrmDlg.AddScreenMagicButton(pcm, nX, nY, False);

            Break;
          end;
        end;
      finally
        g_MagicList.UnLock;
      end;
    end;
  finally
    IniFile.Free;
  end;
end;

{ TMagicButton }

procedure TMagicButton.Paint;
var
  vtRect:TRect;
  vbRect:TRect;
  d:TTexture;
  sKey:string;
  nIcoIndex:Integer;
  Icon:TGameImages;
begin
  inherited;
  if m_Magic = nil then
    Exit;

  vbRect := VisibleRect;
  if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
    Exit;
  vtRect := VirtualRect;

  nIcoIndex := GetNewMagicLevelIconOffset(m_Magic, Icon);

  { TODO -opiaoyun -c技能 : 技能图标扩展一个g_WMagIcon2Images 2013-06-24 }
  if MouseDowned then begin
    if Icon = nil then begin
      if nIcoIndex < 2000 then
        d := g_WMagIconImages.Images[nIcoIndex + 1]
      else
        d := g_WMagIcon2Images.Images[nIcoIndex - 2000 + 1];
    end
    else
      d := Icon.Images[nIcoIndex + 1];
  end
  else begin
    if Icon = nil then begin
      if nIcoIndex < 2000 then
        d := g_WMagIconImages.Images[nIcoIndex]
      else
        d := g_WMagIcon2Images.Images[nIcoIndex - 2000];
    end
    else
      d := Icon.Images[nIcoIndex];
  end;

  if d <> nil then begin
    GameCanvas.Draw(vtRect.Left, vtRect.Top, d);

    // 技能冷却时间 chongchong 2016-10-10
    if (m_Magic.dwInterval > 0) and (MyGetTickCount > m_Magic.dwLastUseTick) then begin
      if (MyGetTickCount <= m_Magic.dwLastUseTick + m_Magic.dwInterval) then begin
        nIcoIndex := Round(29 / ((m_Magic.dwInterval) / (MyGetTickCount - m_Magic.dwLastUseTick)));

        d := g_WNewopUIImages.Images[1380 + nIcoIndex];

        if d <> nil then begin
          GameCanvas.Draw(vtRect.Left - 1, vtRect.Top, d);
        end;
      end;
    end;

    // 红色遮罩效果（技能使用间隔) chongchong 2016-10-10
    if g_boLatestSpell and ((MyGetTickCount - g_dwLatestSpellTick) < g_dwMagicDelayTime) then begin
      nIcoIndex := Round(29 / ((g_dwMagicDelayTime) / (MyGetTickCount - g_dwLatestSpellTick)));
      d := g_WNewopUIImages.Images[1410 + nIcoIndex];

      if d <> nil then begin
        GameCanvas.Draw(vtRect.Left - 1, vtRect.Top, d);
      end;
    end;
  end;

  case m_Magic.Key of
    'E':
      sKey := 'C+F1';
    'F':
      sKey := 'C+F2';
    'G':
      sKey := 'C+F3';
    'H':
      sKey := 'C+F4';
    'I':
      sKey := 'C+F5';
    'J':
      sKey := 'C+F6';
    'K':
      sKey := 'C+F7';
    'L':
      sKey := 'C+F8';

    '1':
      sKey := 'F1';
    '2':
      sKey := 'F2';
    '3':
      sKey := 'F3';
    '4':
      sKey := 'F4';
    '5':
      sKey := 'F5';
    '6':
      sKey := 'F6';
    '7':
      sKey := 'F7';
    '8':
      sKey := 'F8';
    else // 字母快捷键不显示 2020-03-31 22:34:49
      if m_Magic.Key in ['a'..'z'] then
        sKey := Chr(Ord(m_Magic.Key) - 32)
      else
        sKey := '';
  end;

  if sKey <> '' then
    BoldTextOut(vtRect.Left + (Width - CurrentFont.TextWidth(sKey)), vtRect.Top + (Height - g_CurrentFontHeight), sKey, clLime); // 技能按键
end;

