procedure TFrmDlg.DSellDlgSpotClick(Sender:TObject; X, Y:Integer);
var
  temp:TClientItem;
begin
  if g_SellDlgItemSellWait.s.Name <> '' then
    Exit;
  g_sSellPriceStr := '';
  if not g_boItemMoving then begin
    if g_SellDlgItem.S.Name <> '' then begin
      ItemClickSound(g_SellDlgItem.S);
      g_boItemMoving := True;
      g_MovingItem.Index := -99;
      g_MovingItem.Item := g_SellDlgItem;
      g_MovingItem.ItemType := mtBagItem; // 2个同样的装备，先装备一个到身上，再放到NPC出售，把身上的装备放到背包，NPC出售返回到背包看不到 chongchong 2018-05-04
      g_SellDlgItem.S.Name := '';
    end;
  end
  else begin
    if (g_MovingItem.Index = -97) or (g_MovingItem.Index = -98) or (g_MovingItem.ItemType in [mtHeroBagItem, mtHeroUseItem, mtBagGold, mtDealGold, mtGameGoldDeal, mtChallengeGold]) then
      Exit;
    if (g_MovingItem.Index >= 0) or (g_MovingItem.Index = -99) then begin
      ItemClickSound(g_MovingItem.Item.S);
      if g_SellDlgItem.S.Name <> '' then begin
        temp := g_SellDlgItem;
        g_SellDlgItem := g_MovingItem.Item;
        g_MovingItem.Index := -99;
        g_MovingItem.Item := temp
      end
      else begin
        g_SellDlgItem := g_MovingItem.Item;
        g_MovingItem.Item.S.Name := '';
        g_boItemMoving := False;
      end;
      g_boQueryPrice := True;
      g_dwQueryPriceTime := MyGetTickCount;
    end;
  end;
end;

procedure TFrmDlg.DSellDlgSpotDirectPaint(Sender:TObject);
var
  d:TTexture;
  vtRect:TRect;
  vbRect:TRect;
  PaintRect:TRect;
  DSellDlgSpot:TDxImageButton;
  nX, nY:Integer;
  sMsg:string;
begin
  if g_SellDlgItem.S.Name <> '' then begin
    DSellDlgSpot := TDxImageButton(Sender);
    d := g_WBagItemImages.Images[g_SellDlgItem.S.looks];

    if d <> nil then
      with DSellDlgSpot do begin
        vbRect := VisibleRect;
        if (vbRect.Bottom <= vbRect.Top) or (vbRect.Right <= vbRect.Left) then
          Exit;
        vtRect := VirtualRect;
        // PaintRect := ReallyRect(vbRect, vtRect);
        // if (PaintRect.Bottom <= PaintRect.Top) or (PaintRect.Right <= PaintRect.Left) then Exit;

        PaintRect := Bounds(vbRect.Left + (Width - d.Width) div 2, vbRect.Top + (Height - d.Height) div 2, d.Width, d.Height);
        DSellDlgSpot.DrawRect(PaintRect, d);

        if IsUnOverLapItem(@g_SellDlgItem) then begin // 重叠物品
          nX := (vtRect.Right - vtRect.Left - 36) div 2;
          nY := (vtRect.Bottom - vtRect.Top - 32) div 2;

          sMsg := 'x' + IntToStr(g_SellDlgItem.Dura + 1);

          BoldTextOut(vtRect.Left + nX + (36 - CurrentFont.TextWidth(sMsg) - 2), vtRect.Top + nY + (32 - g_CurrentFontHeight), sMsg, clSkyBlue);
          // CurrentFont.TextOut(ARect.Left + ((ARect.Right - ARect.Left) - CurrentFont.TextWidth(sMsg) - 2),
           // ARect.Top + ((ARect.Bottom - ARect.Top) - g_CurrentFontHeight), sMsg, clSkyBlue {GetRGB(Item.s.Color)});
        end;
      end;
  end;
end;

