procedure TFrmDlg.DropMovingItem;
begin
  if g_boItemMoving then begin
    g_boItemMoving := False;
    if g_MovingItem.Item.S.Name <> '' then begin
      if g_MovingItem.ItemType = mtHeroBagItem then begin
        frmMain.SendHeroDropItem(g_MovingItem.Item.S.Name, g_MovingItem.Item.MakeIndex);
      end
      else if g_MovingItem.ItemType = mtGamePetBagItem then begin
        frmMain.SendPetDropItem(g_MovingItem.Item.S.Name, g_MovingItem.Item.MakeIndex);
      end
      else begin
        frmMain.SendDropItem(g_MovingItem.Item.S.Name, g_MovingItem.Item.MakeIndex);
      end;
      AddDropItem(g_MovingItem.Item);
      g_MovingItem.Item.S.Name := '';
    end;
  end;
end;

procedure TFrmDlg.DBackgroundBackgroundClick(Sender:TObject);
var
  dropgold:Integer;
  valstr:string;
  Item:TClientItem;
begin
  {$IF PRIVATE_CLIENT = 1}
  {.$I AddVmpFeatureCode_M.inc}
  {$IFEND}

  if g_boItemMoving then begin
    DBackground.WantReturn := True;
    if (g_MovingItem.Item.S.Name = g_sGoldName) then begin
      if (g_MovingItem.ItemType = mtBagGold) then begin
        g_boItemMoving := False;
        g_MovingItem.Item.S.Name := '';

        DMessageDlg('请输入' + g_sGoldName + '数量？', [mbOk, mbAbort]);
        valstr := Trim(DlgEditText);
        dropgold := StrToIntDef(valstr, 0);

        frmMain.SendDropGold(dropgold);
      end;
    end
    else if IsUnOverLapItem(@g_MovingItem.Item) then begin
      g_boItemMoving := False;
      Item := g_MovingItem.Item;
      g_MovingItem.Item.S.Name := '';
      // DialogSize := 1;
      if g_ClientConfig.boDropOverLapItem then begin
        dropgold := Item.Dura + 1;
      end
      else begin
        DMessageDlg('你想放下多少“' + ProcessItemName(Item.s.Name) + '”数量?', [mbOk, mbAbort]);
        valstr := Trim(DlgEditText);
        dropgold := StrToIntDef(valstr, 0);
      end;
      if dropgold > 0 then begin
        if (g_MovingItem.ItemType = mtHeroBagItem) then begin
          g_boCheckDropItem := True;
          g_DropMoveItemTick := MyGetTickCount;
          frmMain.SendHeroDropItem(Item.s.Name, Item.MakeIndex, dropgold);
          AddDropItem(Item);
        end
        else if (g_MovingItem.ItemType = mtBagItem) then begin
          g_boCheckDropItem := True;
          g_DropMoveItemTick := MyGetTickCount;
          frmMain.SendDropItem(Item.s.Name, Item.MakeIndex, dropgold);
          AddDropItem(Item);
        end
        else if g_MovingItem.ItemType = mtGamePetBagItem then begin
          g_boCheckDropItem := True;
          g_DropMoveItemTick := MyGetTickCount;
          frmMain.SendPetDropItem(g_MovingItem.Item.S.Name, g_MovingItem.Item.MakeIndex);
          AddDropItem(Item);
        end
        else begin
          g_MovingItem.Item := Item;
          g_boItemMoving := True;
        end;
      end
      else begin
        g_MovingItem.Item := Item;
        g_boItemMoving := True;
      end;
    end // 武器和首饰盒中的物品不允许直接丢弃 chongchong 2013-10-21
    else if (g_MovingItem.Index >= 0) and (not (g_MovingItem.ItemType in [mtJewelryItem, mtHeroJewelryItem, mtItemBoxItem, mtGodBlessItem, mtHeroGodBlessItem])) then begin
      g_boCheckDropItem := True;
      g_DropMoveItemTick := MyGetTickCount;
      DropMovingItem;
    end;
  end;
end;

