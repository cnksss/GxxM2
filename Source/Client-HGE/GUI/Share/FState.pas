destructor TNpcLabel.Destroy;
begin
  m_AutoColors.Free;
  inherited;
end;

procedure TNpcLabel.Update();
begin
  inherited;
  if m_AutoColors.Count > 0 then begin
    if MyGetTickCount - m_dwAutoColorTick > 600 then begin
      m_dwAutoColorTick := MyGetTickCount;
      if (m_nColorIndex < 0) or (m_nColorIndex >= m_AutoColors.Count) then
        m_nColorIndex := 0;
      CaptionColor.Up.Color := TColor(m_AutoColors.Items[m_nColorIndex]);
      CaptionColor.Disabled.Color := TColor(m_AutoColors.Items[m_nColorIndex]);
      Inc(m_nColorIndex);
    end;
  end;
end;

constructor TCountDownLabel.Create(AOwner:TDxControl);
begin
  inherited Create(AOwner);
  m_sCmd := '';
  m_CountDownValue := 0;
  m_OldCountDownValue := 0;
  m_LoopCount := 1;
  m_UpdateTick := MyGetTickCount;
end;

destructor TCountDownLabel.Destroy;
begin

  inherited;
end;

procedure TCountDownLabel.UpdateCaption;
var
  nTime, nDay, nHour, nMinute, nSecond:Integer;
begin
  nTime := m_CountDownValue;
  nDay := nTime div 86400;

  if m_boChineseFormat then begin
    nTime := nTime - nDay * 86400;
    nHour := nTime div 3600;
    nTime := nTime - nHour * 3600;
    nMinute := nTime div 60;
    nSecond := nTime mod 60;
    Caption := Format('%.2d天%.2d时%.2d分%.2d秒', [nDay, nHour, nMinute, nSecond]);
  end
  else begin
    nHour := nTime div 3600;
    nTime := nTime - nHour * 3600;
    nMinute := nTime div 60;
    nSecond := nTime mod 60;
    Caption := Format('%.2d:%.2d:%.2d', [nHour, nMinute, nSecond]);
  end;

end;

procedure TCountDownLabel.Update();
begin
  inherited;

  if (m_LoopCount = 0) then begin
    Caption := '00:00:00';
    Exit;
  end;

  if (m_CountDownValue <= 0) then begin
    m_LoopCount := 0;
    Caption := '00:00:00';
    if (Length(m_sCmd) > 0) and Assigned(FClickEvent) then begin
      FClickEvent(Self, 0, 0);
      //frmMain.SendMerchantDlgSelect(g_nCurMerchant, m_sCmd);
    end;
    Exit;
  end;

  if MyGetTickCount - m_UpdateTick >= 1000 then begin
    m_UpdateTick := m_UpdateTick + 1000;
    Dec(m_CountDownValue);
    UpdateCaption;

    if m_CountDownValue = 0 then begin
      if (Length(m_sCmd) > 0) and Assigned(FClickEvent) then begin
        FClickEvent(Self, 0, 0);
        //frmMain.SendMerchantDlgSelect(g_nCurMerchant, m_sCmd);
      end;

      m_CountDownValue := m_OldCountDownValue + 1;

      if m_LoopCount > 0 then
        Dec(m_LoopCount);
    end;
  end;
end;

