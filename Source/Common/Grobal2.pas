      RC_HEROOBJECT, RC_NPC, RC_GUARD, RC_GUARD2, RC_PEACENPC, RC_ANIMAL, RC_MOONOBJECT, RC_ARCHERGUARD, RC_TRUCKOBJECT,
      RC_MOVE_ARCHERGUARD, 23, // 变异骷髅
