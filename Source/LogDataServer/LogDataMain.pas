procedure TProcessUserSessionThread.ProcessUserSession(
  UserSession: PControlSessionInfo);
var
  I, UserCmd, nDay: Integer;
  UserData, sLogDir: string;
  SearchDay: TDate;
  Year, Month, Day: Word;

  SR: TSearchRec;
  sFileName: string;
  SearchInfo: PTControlSearchInfo;

  SendBuf: array[0..500] of TControlLogData;
  SendCurrent: pTControlLogData;
  SendAllCount, SendCurrCount: Integer;
begin
  UserCmd := 0;
  UserData := '';

  UserSession.MsgList.Lock;
  try
    if UserSession.MsgList.Count > 0 then
    begin
      UserCmd := Integer(UserSession.MsgList.Objects[0]);
      UserData := UserSession.MsgList.Strings[0];

      UserSession.MsgList.Delete(0);
    end;
  finally
    UserSession.MsgList.UnLock;
  end;

  if (UserCmd = 0) or (UserData = '') then Exit;

  if UserCmd <> CMSG_SEARCH_LOG then Exit;
  if Length(UserData) <> SizeOf(TControlSearchInfo) then Exit;

  SendAllCount := 0;
  SendCurrCount := 0;
  SendCurrent := @SendBuf[0];

  SearchInfo := PTControlSearchInfo(UserData);

  EnterCriticalSection(g_ControlSessionCS);
  try
    if UserSession.Socket <> nil then
    begin
      SendControlMsg(UserSession.Socket, SMSG_SEARCH_START, nil, 0);
    end;
  finally
    LeaveCriticalSection(g_ControlSessionCS);
  end;

  if not UserSession.IsRunning then Exit;
                                                 
  nDay := GetDayCount(SearchInfo.SearchEndDay, SearchInfo.SearchStartDay);
  if nDay > 30 then nDay := 30;

  OutputDebugString(PChar('远程查询数据;' + FormatDateTime('yyyy-mm-dd', SearchInfo.SearchStartDay)));

  for I := 0 to nDay do
  begin
    SearchDay := SearchInfo.SearchStartDay + I;
    DecodeDate(SearchDay, Year, Month, Day);
    sLogDir := IncludeTrailingBackslash(sBaseDir) + IntToStr(Year) + '-' + IntToString(Month) + '-' + IntToString(Day);

    if not UserSession.IsRunning then Exit;
    if DirectoryExists(sLogDir) then
    begin
      if FindFirst(sLogDir + '\*.nlf', faAnyFile, SR) = 0 then
      begin
        repeat
          if not UserSession.IsRunning then
          begin
            FindClose(SR);
            Exit;
          end;

          EnterCriticalSection(g_ControlSessionCS);
          try
            if UserSession.Socket = nil then Exit;
          finally
            LeaveCriticalSection(g_ControlSessionCS);
          end;

          if SR.Attr and faDirectory = faDirectory then Continue;
          if not SameText(Copy(SR.Name, 1, 4), 'log-') then Continue;

          sFileName := sLogDir + '\' + SR.Name;
          try
            ProcessSearchAndSend(UserSession, SearchInfo, sFileName, @SendBuf[0], SendCurrent, SendAllCount, SendCurrCount);
          except
            on E: Exception do
            begin
              FErrorMessage := E.Message;
              Synchronize(ShowError);
            end;
          end;
        until FindNext(SR) <> 0;   

        FindClose(SR);
      end;
    end;

    EnterCriticalSection(g_ControlSessionCS);
    try
      if UserSession.Socket = nil then Exit;
    finally
      LeaveCriticalSection(g_ControlSessionCS);
    end;
  end;

  EnterCriticalSection(g_ControlSessionCS);
  try
    if UserSession.Socket <> nil then
    begin
      if SendCurrCount > 0 then
      begin
        SendControlMsg(UserSession.Socket, SMSG_SEARCH_LOG, PAnsiChar(@SendBuf[0]), SendCurrCount * SizeOf(TControlLogData));
      end;

      SendControlMsg(UserSession.Socket, SMSG_SEARCH_LOG_END, nil, 0);
    end;
  finally
    LeaveCriticalSection(g_ControlSessionCS);
  end;

  if SendCurrCount > 0 then
  begin
    Sleep(300);
  end;
end;


procedure TProcessUserSessionThread.Execute;
var
  I: Integer;
  UserSession: PControlSessionInfo;
begin
  inherited;

  while not Terminated do
  begin
    for I := 0 to Length(g_ControlSessionArray) - 1 do
    begin
      UserSession := @g_ControlSessionArray[I];
      ProcessUserSession(UserSession);
    end;
    Sleep(1);
  end;
end;


