  if FProcessUserSessionThread <> nil then
  begin
    FProcessUserSessionThread.Terminate;
    FProcessUserSessionThread.WaitFor;
    FProcessUserSessionThread.Free;
  end;

  if (FFileHandle <> INVALID_HANDLE_VALUE) then
