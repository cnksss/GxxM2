procedure TFrmLogData.srvrsckt1ClientRead(Sender: TObject; Socket: TCustomWinSocket);
var
  {I, nCount,} nSockIndex: Integer;
  UserSession: PControlSessionInfo;
  ControlMsgHeader: PControlMsgHeader;
  dwCmd: LongWord;
  sData: string;
begin
  nSockIndex := Socket.nIndex;
  if (nSockIndex >= 0) and (nSockIndex < Length(g_ControlSessionArray)) then
  begin
    UserSession := @g_ControlSessionArray[nSockIndex];
    UserSession.RecvText := UserSession.RecvText + Socket.ReceiveText;
    UserSession.RecvTick := GetTickCount;

    while Length(UserSession.RecvText) >= SizeOf(TControlMsgHeader) do
    begin
      ControlMsgHeader := @UserSession.RecvText[1];
      if ControlMsgHeader.dwCode <> ControlMsgHeaderIdent then
      begin
        UserSession.RecvText := '';
        Break;
      end;

      if Length(UserSession.RecvText) < SizeOf(TControlMsgHeader) + ControlMsgHeader.nLength then Break;

      if ControlMsgHeader.nLength = 0 then
        sData := ''
      else
        sData := Copy(UserSession.RecvText, SizeOf(TControlMsgHeader) + 1, ControlMsgHeader.nLength);

      UserSession.RecvText := Copy(UserSession.RecvText, SizeOf(TControlMsgHeader) + ControlMsgHeader.nLength + 1, MaxInt);

      case ControlMsgHeader.dwCmd of
        CMSG_CHECK_PASSWORD:
          begin
            if SameText(sData, MD5Print(MD5String(g_sControlPassword))) then
            begin
              dwCmd := SMSG_CHECK_PASSWORD_OK;
              UserSession.IsPasswordOK := True;
            end
            else
            begin
              dwCmd := SMSG_CHECK_PASSWORD_FAIL;
              UserSession.DelayCloseTick := GetTickCount + 1000;
              UserSession.DelayClose := True;
            end;
            SendControlMsg(Socket, dwCmd, nil, 0);
          end;
        CMSG_SEARCH_LOG:
          begin
            if UserSession.IsPasswordOK and (ControlMsgHeader.nLength > 0) then
            begin
              UserSession.IsRunning := True;
              
              UserSession.MsgList.Lock;
              try
                UserSession.MsgList.AddObject(sData, TObject(ControlMsgHeader.dwCmd));
              finally
                UserSession.MsgList.UnLock;
              end;
            end;
          end;
        CMSG_HEARTBEAT:
          begin
            // 心跳包不处理
          end;
      end;
    end;
  end;
end;


procedure TFrmLogData.tmr1Timer(Sender: TObject);
var
  I: Integer;
  UserSession: PControlSessionInfo;
begin
  EnterCriticalSection(g_ControlSessionCS);
  try
    for I := 0 to Length(g_ControlSessionArray) - 1 do
    begin
      UserSession := @g_ControlSessionArray[I];

      if UserSession.Socket <> nil then
      begin
        if (tick_diff(UserSession.ConnectTick, GetTickCount) >= 5000) and (not UserSession.IsPasswordOK) then
        begin
          UserSession.ConnectTick := GetTickCount;
          UserSession.Socket.Close;
        end
        else if UserSession.DelayClose and (tick_diff(UserSession.DelayCloseTick, GetTickCount) >= 0) then
        begin
          UserSession.ConnectTick := GetTickCount;
          UserSession.Socket.Close;
        end
        else if tick_diff(UserSession.RecvTick, GetTickCount) >= 120000 then     // 120秒钟没有收到数据包，连接超时，断开
        begin
          UserSession.ConnectTick := GetTickCount;
          UserSession.Socket.Close;
        end
        else if tick_diff(UserSession.RecvTick, GetTickCount) >= 60000 then     // 60秒钟没有收到数据包，发一个包过去
        begin
          if tick_diff(UserSession.SendHeartbeatTick, GetTickCount) >= 50000 then
          begin
            UserSession.SendHeartbeatTick := GetTickCount;
            SendControlMsg(UserSession.Socket, SMSG_HEARTBEAT, nil, 0);
          end;
        end;
      end;
    end;
  finally
    LeaveCriticalSection(g_ControlSessionCS);
  end;
end;

