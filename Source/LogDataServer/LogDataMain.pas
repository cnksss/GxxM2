procedure TFrmLogData.WriteLogFile();
var
  Year, Month, Day, Hour, Min, Sec, MSec: Word;
  sLogDir, sLogFile: string;
  //s2E8: string;

  sText: string;
  s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15: string;
  B: Byte;
  N: Integer;
  Dt: TDateTime;
  Action: LongWord;

  P, P2: PByte;
  Len: Integer;
begin
  EnterCriticalSection(FCS);
  try
    if LogMsgList.Count <= 0 then exit;

    TempLogMsgList.AddStrings(LogMsgList);
    LogMsgList.Clear;
  finally
    LeaveCriticalSection(FCS);
  end;

  DecodeDate(Date, Year, Month, Day);
  DecodeTime(Time, Hour, Min, Sec, MSec); //ExtractFilePath(ParamStr(0)) +
  sLogDir := sBaseDir + IntToStr(Year) + '-' + IntToString(Month) + '-' + IntToString(Day);

  if not DirectoryExists(sLogDir) then
  begin
    ForceDirectories(sLogDir);
  end;

  sLogFile := sLogDir + '\Log-' + IntToString(Hour) + 'h' + IntToString((Min div 10) * 2) + 'm.nlf';
  statMain.Panels[0].Text := sLogFile;

  if not SameText(sLogFile, FLogFileName) then
  begin
    if (FFileHandle <> INVALID_HANDLE_VALUE) then
    begin
      CloseHandle(FFileHandle);
    end;

    FLogFileName := sLogFile;

    if not FileExists(FLogFileName) then
      FFileHandle := CreateFile(PChar(FLogFileName), GENERIC_WRITE, FILE_SHARE_READ, nil, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)
    else
      FFileHandle := CreateFile(PChar(FLogFileName), GENERIC_WRITE, FILE_SHARE_READ, nil, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0);

    FileSeek(FFileHandle, 0, soFromEnd);
  end
  else if (FFileHandle = INVALID_HANDLE_VALUE) then
  begin
    if (FFileHandle <> INVALID_HANDLE_VALUE) then
    begin
      CloseHandle(FFileHandle);
    end;
    
    if not FileExists(sLogFile) then
      FFileHandle := CreateFile(PChar(sLogFile), GENERIC_WRITE, FILE_SHARE_READ, nil, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)
    else
      FFileHandle := CreateFile(PChar(sLogFile), GENERIC_WRITE, FILE_SHARE_READ, nil, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0);

    FileSeek(FFileHandle, 0, soFromEnd);
  end;

  if (FFileHandle <> INVALID_HANDLE_VALUE) then begin
    P2 := @FBuffer[0];
    P := P2;

    while TempLogMsgList.Count > 0 do begin
      sText := TempLogMsgList.Strings[0];
      TempLogMsgList.Delete(0);

      sText := GetValidStr3_Ex(sText, s01, #9);
      sText := GetValidStr3_Ex(sText, s02, #9);
      sText := GetValidStr3_Ex(sText, s03, #9);
      sText := GetValidStr3_Ex(sText, s04, #9);
      sText := GetValidStr3_Ex(sText, s05, #9);
      sText := GetValidStr3_Ex(sText, s06, #9);
      sText := GetValidStr3_Ex(sText, s07, #9);
      sText := GetValidStr3_Ex(sText, s08, #9);
      sText := GetValidStr3_Ex(sText, s09, #9);
      sText := GetValidStr3_Ex(sText, s10, #9);
      sText := GetValidStr3_Ex(sText, s11, #9);
      sText := GetValidStr3_Ex(sText, s12, #9);
      sText := GetValidStr3_Ex(sText, s13, #9);
      sText := GetValidStr3_Ex(sText, s14, #9);
      sText := GetValidStr3_Ex(sText, s15, #9);

      Action := StrToIntDef(S04, 0);
      if Action = 0 then Continue;

      N := StrToIntDef(S02, 0);     // nServerNumber
      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));

      N := StrToIntDef(S03, 0);     // nServerIndex
      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));

      N := Action;                  // nAction
      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));

      N := Length(S05);             // sMapName
      if N >= 200 then N := 200;

      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));
      if N > 0 then
      begin
        Move(S05[1], P^, N);
        Inc(P, N);
      end;

      N := StrToIntDef(S06, -1);    // nMapX
      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));

      N := StrToIntDef(S07, -1);    // nMapY
      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));

      N := Length(S08);             // sObjectName
      if N >= 200 then N := 200;

      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));
      if N > 0 then
      begin
        Move(S08[1], P^, N);
        Inc(P, N);
      end;

      B := StrToIntDef(S09, 0);     // ActorType
      if (B < Integer(Low(TLogActorType))) or (B > Integer(High(TLogActorType))) then
      begin
        B := Integer(latNone);
      end;
      Move(B, P^, SizeOf(B));
      Inc(P, SizeOf(B));

      N := Length(S10);             // sItemName
      if N >= 200 then N := 200;

      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));
      if N > 0 then
      begin
        Move(S10[1], P^, N);
        Inc(P, N);
      end;

      N := StrToIntDef(S11, -1);    // nItemIndex
      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));

      N := Length(S12);             // sActObjectName
      if N >= 200 then N := 200;
      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));
      if N > 0 then
      begin
        Move(S12[1], P^, N);
        Inc(P, N);
      end;

      N := StrToIntDef(S13, -1);    // nData1
      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));

      N := StrToIntDef(S14, -1);    // nData2
      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));

      N := Length(S15);             // sLogDesc
      if N >= 200 then N := 200;

      Move(N, P^, SizeOf(N));
      Inc(P, SizeOf(N));
      if N > 0 then
      begin
        Move(S15[1], P^, N);
        Inc(P, N);
      end;

      Dt := Now;                    // LogDataTime
      Move(Dt, P^, SizeOf(Dt));
      Inc(P, SizeOf(Dt));

      Len := Integer(P) - Integer(P2);

      if Len >= SizeOf(FBuffer) - 2000 then
      begin
        FileWrite(FFileHandle, FBuffer[0], Len);
        P2 := @FBuffer[0];
        P := P2;
      end;
    end;

    Len := Integer(P) - Integer(P2);
    if Len >= 0 then begin
      FileWrite(FFileHandle, FBuffer[0], Len);
      //P2 := @FBuffer[0];
      //P := P2;
    end;
    
  end;
end;

