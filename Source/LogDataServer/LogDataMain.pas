function GetActionChecked(SearchInfo: PTControlSearchInfo; nAction: LongWord): Boolean;
var
  W1: Word;
  B1, B2: Byte;
begin
  // 日志类型暂时只用了Word
  W1 := LoWord(nAction);
  B1 := LoByte(W1);
  B2 := HiByte(W1);

  Result := SearchInfo.SearchActions[B1] or SearchInfo.SearchActions[B2];
end;

function GetSearch(nWhere: Integer; sObjName, sActObjName, sItemName: string; nActObjType: Integer; nItemID: Integer; LogData: pTControlLogData): Boolean;
//var
  //I: Integer;
begin
  Result := True;
  if nWhere <= 0 then Exit;

  if nWhere and 1 = 1 then
    Result := AnsiContainsText(LogData.sObjectName, sObjName);
  if not Result then Exit;

  if nWhere and 2 = 2 then
    Result := Integer(LogData.ObjectType) = nActObjType;
  if not Result then Exit;
  
  if nWhere and 4 = 4 then
    Result := AnsiContainsText(LogData.sActObjectName, sActObjName);
  if not Result then Exit;

  if nWhere and 8 = 8 then
    Result := AnsiContainsText(LogData.sItemName, sItemName);
  if not Result then Exit;

  if nWhere and 16 = 16 then
    Result := LogData.nItemIndex = nItemID;
end;

procedure TProcessUserSessionThread.ProcessSearchAndSend(
  UserSession: PControlSessionInfo;
  SearchInfo: PTControlSearchInfo;
  LogFileName: string;
  SendBufStart: pTControlLogData;
  var SendBufCurrent: pTControlLogData;
  var SendAllCount, SendCurrCount: Integer);
var
  nLen: Integer;
  nServerNumber: Integer;
  nServerIndex: Integer;
  nAction: LongWord;
  sMapName: string;
  nX, nY: Integer;
  sObjectName: string;
  sItemName: string;
  nItemIndex: Integer;
  sActObjectName: string;
  nData1, nData2: Integer;
  sLogDesc: string;
  Dt: TDateTime;
  btActorType: Byte;
  LogData: TControlLogData;

  FileStream: TFileStream;
begin
  FileStream := TFileStream.Create(LogFileName, fmOpenRead or fmShareDenyNone);
  try
    FileStream.Seek(0, soFromBeginning);
    while FileStream.Position < FileStream.Size do
    begin
      if FileStream.Read(nServerNumber, SizeOf(nServerNumber)) <> SizeOf(nServerNumber) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if FileStream.Read(nServerIndex, SizeOf(nServerIndex)) <> SizeOf(nServerIndex) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if FileStream.Read(nAction, SizeOf(nAction)) <> SizeOf(nAction) then
      begin
        // FileStream.Free;
        Exit;
      end;

      sMapName := '';
      if FileStream.Read(nLen, SizeOf(nLen)) <> SizeOf(nLen) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if nLen > 0 then
      begin
        SetLength(sMapName, nLen);

        if FileStream.Read(sMapName[1], nLen) <> nLen then
        begin
          // FileStream.Free;
          Exit;
        end;
      end;

      if FileStream.Read(nX, SizeOf(nX)) <> SizeOf(nX) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if FileStream.Read(nY, SizeOf(nY)) <> SizeOf(nY) then
      begin
        // FileStream.Free;
        Exit;
      end;

      sObjectName := '';
      if FileStream.Read(nLen, SizeOf(nLen)) <> SizeOf(nLen) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if nLen > 0 then
      begin
        SetLength(sObjectName, nLen);
        if FileStream.Read(sObjectName[1], nLen) <> nLen then
        begin
          // FileStream.Free;
          Exit;
        end;
      end;

      if FileStream.Read(btActorType, SizeOf(btActorType)) <> SizeOf(btActorType) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if (btActorType < Integer(Low(TLogActorType))) or (btActorType > Integer(High(TLogActorType))) then
      begin
        btActorType := Integer(latNone);
      end;

      sItemName := '';
      if FileStream.Read(nLen, SizeOf(nLen)) <> SizeOf(nLen) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if nLen > 0 then
      begin
        SetLength(sItemName, nLen);
        if FileStream.Read(sItemName[1], nLen) <> nLen then
        begin
          // FileStream.Free;
          Exit;
        end;
      end;

      if FileStream.Read(nItemIndex, SizeOf(nItemIndex)) <> SizeOf(nItemIndex) then
      begin
        // FileStream.Free;
        Exit;
      end;

      sActObjectName := '';
      if FileStream.Read(nLen, SizeOf(nLen)) <> SizeOf(nLen) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if nLen > 0 then
      begin
        SetLength(sActObjectName, nLen);
        if FileStream.Read(sActObjectName[1], nLen) <> nLen then
        begin
          // FileStream.Free;
          Exit;
        end;
      end;

      if FileStream.Read(nData1, SizeOf(nData1)) <> SizeOf(nData1) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if FileStream.Read(nData2, SizeOf(nData2)) <> SizeOf(nData2) then
      begin
        // FileStream.Free;
        Exit;
      end;

      sLogDesc := '';
      if FileStream.Read(nLen, SizeOf(nLen)) <> SizeOf(nLen) then
      begin
        // FileStream.Free;
        Exit;
      end;

      if nLen > 0 then
      begin
        SetLength(sLogDesc, nLen);
        if FileStream.Read(sLogDesc[1], nLen) <> nLen then
        begin
          // FileStream.Free;
          Exit;
        end;
      end;

      if FileStream.Read(Dt, SizeOf(Dt)) <> SizeOf(Dt) then
      begin
        // FileStream.Free;
        Exit;
      end;

      EnterCriticalSection(g_ControlSessionCS);
      try
        if UserSession.Socket = nil then
        begin
          // FileStream.Free;
          Exit;
        end;
      finally
        LeaveCriticalSection(g_ControlSessionCS);
      end;

      if not UserSession.IsRunning then Exit;

      LogData.nAct := nAction;
      LogData.sMapName := sMapName;
      LogData.nX := nX;
      LogData.nY := nY;
      LogData.sObjectName := sObjectName;
      LogData.ObjectType := TLogActorType(btActorType);
      LogData.sItemName := sItemName;
      LogData.nItemIndex := nItemIndex;
      LogData.sActObjectName := sActObjectName;
      LogData.nData1 := nData1;
      LogData.nData2 := nData2;
      LogData.LogDesc := sLogDesc;
      LogData.Date := Dt;

      if GetActionChecked(SearchInfo, nAction) and
        GetSearch(SearchInfo.SearchWhere, SearchInfo.SearchObjName, SearchInfo.SearchActObjName, SearchInfo.SearchItemName, SearchInfo.SearchActObjType, SearchInfo.SearchItemID, @LogData) then
      begin
        LogData.nIndx := SendAllCount;
        Inc(SendAllCount);

        if SendCurrCount < 200 then
        begin
          SendBufCurrent^ := LogData;
        end
        else
        begin
          EnterCriticalSection(g_ControlSessionCS);
          try
            if (UserSession.Socket <> nil) and (UserSession.IsRunning) then
            begin
              SendControlMsg(UserSession.Socket, SMSG_SEARCH_LOG, PAnsiChar(SendBufStart), SendCurrCount * SizeOf(TControlLogData));
            end
            else
            begin
              Exit;
            end;
          finally
            LeaveCriticalSection(g_ControlSessionCS);
          end;

          Sleep(300);
          SendBufCurrent := SendBufStart;
          SendCurrCount := 0;
          SendBufCurrent^ := LogData;
        end;

        Inc(SendCurrCount);
        Inc(SendBufCurrent);
      end;
    end;
  finally
    FileStream.Free;
  end;
end;

