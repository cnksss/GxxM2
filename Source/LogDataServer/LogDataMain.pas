procedure TFrmLogData.StartTimerTimer(Sender: TObject);
var
  Conf: TIniFile;
  //boMinimize: Boolean;
begin
  StartTimer.Enabled := False;
  Conf := TIniFile.Create('.\LogData.ini');
  if Conf <> nil then begin
    sBaseDir := Conf.ReadString('Setup', 'BaseDir', sBaseDir);
    sServerName := Conf.ReadString('Setup', 'Caption', sServerName);
    sServerName := Conf.ReadString('Setup', 'ServerName', sServerName);
    nServerPort := Conf.ReadInteger('Setup', 'Port', nServerPort);

    g_nControlPort := Conf.ReadInteger('Setup', 'ControlPort', g_nControlPort);
    g_sControlPassword := Conf.ReadString('Setup', 'ControlPassword', g_sControlPassword);

    Conf.Free;
  end;

  if sServerName <> '' then begin
      Caption := Format('%s - [%s]', [sCaption, sServerName]);
  end else begin
      Caption := sCaption;
  end;
  
  ShowMainLog('日志服务正在启动...');
  IdUDPServerLog.DefaultPort := nServerPort;
  try
    IdUDPServerLog.Active := True;
    SendGameCenterMsg(SG_STARTOK, '日志服务器启动完成...');
    ShowMainLog('日志服务器启动完成...');
  except
    on E: Exception do
    begin
      ShowMainLog('日志服务器启动失败; ' + E.Message);
    end;
  end;

  if (g_nControlPort > 0) then
  begin
    ShowMainLog('远程查询端口[' + IntToStr(g_nControlPort) + ']正在启动...');
    srvrsckt1.Address := '0.0.0.0';
    srvrsckt1.Port := g_nControlPort;
    try
      srvrsckt1.Active := True;
      ShowMainLog('远程查询端口[' + IntToStr(g_nControlPort) + ']启动完成...');

      FProcessUserSessionThread := TProcessUserSessionThread.Create(False);
      FProcessUserSessionThread.FreeOnTerminate := False;
    except
      on E: Exception do
      begin
        ShowMainLog('远程查询端口[' + IntToStr(g_nControlPort) + ']启动失败; ' + E.Message);
      end;
    end;
  end;
end;

