procedure UnLoadFilterItemList;
var
  i: Integer;
begin
  if g_FilterItemList = nil then
    Exit;
  for i := 0 to g_FilterItemList.Count - 1 do
  begin
    Dispose(pTFilterItem(g_FilterItemList.Items[i]));
  end;
  FreeAndNil(g_FilterItemList);
  g_NameFilterListText := '';
  g_NameFilterListTextLen := 0;
  g_NameFilterListTextCRC := 0;
end;

procedure LoadFilterItemList;
var
  i: Integer;
  LoadList: TStringList;
  sFileName: string;
  S: AnsiString;
  FilterItem: pTFilterItem;
  sLineText, sItemType, sItemName, sHint, sPick, sShow, sShowSpecial, sAutoMove, sGroupIndex: string;
  nType: Integer;
begin
  UnLoadFilterItemList;
  g_FilterItemList := TGList.Create;
  sFileName := g_Config.sEnvirDir + 'FilterItemList.txt';

  LoadList := TStringList.Create;

  if FileExists(sFileName) then
  begin
    try
      LoadList.LoadFromFile(sFileName);
    except
      LoadList.Clear;
    end;
    for i := 0 to LoadList.Count - 1 do
    begin
      sLineText := Trim(LoadList.Strings[i]);
      if sLineText = '' then
        Continue;
      if (sLineText <> '') and (sLineText[1] = ';') then
        Continue;
      sLineText := GetValidStr3(sLineText, sItemType, [' ', #9]);
      sLineText := GetValidStr3(sLineText, sItemName, [' ', #9]);
      sLineText := GetValidStr3(sLineText, sHint, [' ', #9]);
      sLineText := GetValidStr3(sLineText, sPick, [' ', #9]);
      sLineText := GetValidStr3(sLineText, sShow, [' ', #9]);
      sLineText := GetValidStr3(sLineText, sShowSpecial, [' ', #9]);
      sLineText := GetValidStr3(sLineText, sAutoMove, [' ', #9]);
      sLineText := GetValidStr3(sLineText, sGroupIndex, [' ', #9]);
      nType := StrToIntDef(sItemType, -1);
      if (nType in [1 .. 7]) and (sItemName <> '') then
      begin
        New(FilterItem);
        FilterItem.ItemType := TFilterItemType(nType);
        FilterItem.sItemName := sItemName;
        FilterItem.boHintMsg := sHint = '1';
        FilterItem.boPickup := sPick = '1';
        FilterItem.boShowName := sShow = '1';
        FilterItem.boShowSpecial := sShowSpecial = '1';
        FilterItem.boAutoMove := sAutoMove = '1';
        FilterItem.btGroupIndex := StrToIntDef(sGroupIndex, 255);
        g_FilterItemList.Add(FilterItem);
      end;
    end;
  end;

  S := LoadList.Text;
  g_NameFilterListTextLen := Length(S);
  g_NameFilterListText := zLibCompressString(S);
  g_NameFilterListTextCRC := BufferCrc(PAnsiChar(g_NameFilterListText), Length(g_NameFilterListText));
  LoadList.Free;
end;

procedure SaveFilterItemList();
var
  i: Integer;
  SaveList: TStringList;
  sFileName: string;
  S: AnsiString;
  FilterItem: pTFilterItem;
begin
  if g_FilterItemList = nil then
    Exit;
  SaveList := TStringList.Create;
  for i := 0 to g_FilterItemList.Count - 1 do
  begin
    FilterItem := pTFilterItem(g_FilterItemList.Items[i]);
    SaveList.Add(IntToStr(Integer(FilterItem.ItemType)) + #9 + FilterItem.sItemName + #9 +
      IntToStr(BoolToInt(FilterItem.boHintMsg)) + #9 + IntToStr(BoolToInt(FilterItem.boPickup)) + #9 +
      IntToStr(BoolToInt(FilterItem.boShowName)) + #9 + IntToStr(BoolToInt(FilterItem.boShowSpecial)) + #9 +
      IntToStr(BoolToInt(FilterItem.boAutoMove)) + #9 + IntToStr(FilterItem.btGroupIndex));
  end;

  S := SaveList.Text;
  g_NameFilterListTextLen := Length(S);
  g_NameFilterListText := zLibCompressString(S);
  g_NameFilterListTextCRC := BufferCrc(PAnsiChar(g_NameFilterListText), Length(g_NameFilterListText));

  sFileName := g_Config.sEnvirDir + 'FilterItemList.txt';
  try
    SaveList.SaveToFile(sFileName);
  except

  end;
  SaveList.Free;
end;

