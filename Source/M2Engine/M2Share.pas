function LoadMonDropLimitList(): Boolean;
var
  i: Integer;
  LoadList: TStringList;
  sLineText: string;
  sFileName: string;
  sItemName, sCountLimit, sDropCount, sNoDropCount, sLastClearDate, sClearDay: string;
  nCountLimit, nDropCount, nNoDropCount: Integer;
  nLastClearDate, nClearDay: Integer;
  MonDrop: pTMonDrop;
begin
  Result := False;
  sFileName := g_Config.sEnvirDir + 'MonDropLimitList.txt';
  LoadList := TStringList.Create;
  if FileExists(sFileName) then
  begin
    { TODO -ochongchong -c内存泄露 : 去内存泄露 【2013-07-18】 }
    for i := 0 to g_MonDropLimitList.Count - 1 do
    begin
      MonDrop := pTMonDrop(g_MonDropLimitList.Objects[i]);
      Dispose(MonDrop);
    end;

    g_MonDropLimitList.Clear;
    LoadList.LoadFromFile(sFileName);
    for i := 0 to LoadList.Count - 1 do
    begin
      sLineText := Trim(LoadList.Strings[i]);
      if (sLineText = '') or (sLineText[1] = ';') then
        Continue;
      sLineText := GetValidStr3(sLineText, sItemName, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sCountLimit, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sDropCount, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sNoDropCount, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sLastClearDate, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sClearDay, [' ', '/', ',', #9]);

      nCountLimit := StrToIntDef(sCountLimit, -1);
      nDropCount := StrToIntDef(sDropCount, 0);
      nNoDropCount := StrToIntDef(sNoDropCount, 0);
      nLastClearDate := StrToIntDef(sLastClearDate, 0);
      nClearDay := StrToIntDef(sClearDay, 0);

      if (sItemName <> '') and (nCountLimit >= 0) then
      begin
        New(MonDrop);
        MonDrop.sItemName := sItemName;
        MonDrop.nDropCount := nDropCount;
        MonDrop.nNoDropCount := nNoDropCount;
        MonDrop.nCountLimit := nCountLimit;
        MonDrop.LastClearDate := nLastClearDate;
        MonDrop.ClearDay := nClearDay;

        g_MonDropLimitList.AddObject(sItemName, TObject(MonDrop));
      end;
    end;
    Result := True;
  end
  else
    LoadList.SaveToFile(sFileName);

  LoadList.Free;
end;

