procedure SendGameCenterMsg(wIdent: Word; sSENDMSG: AnsiString);
var
  SendData: TCopyDataStruct;
  nParam: DWORD;
begin
  nParam := MakeULong(Word(tM2Server), wIdent);
  SendData.cbData := Length(sSENDMSG) + 1;
  GetMem(SendData.lpData, SendData.cbData);
  FillChar(SendData.lpData^, SendData.cbData, 0);

  // modify chongchong 2020-12-22
  // StrCopy(SendData.lpData, PAnsiChar(sSENDMSG));
  if sSENDMSG <> '' then
  begin
    Move(sSENDMSG[1], SendData.lpData^, (Length(sSENDMSG) + 1) * SizeOf(AnsiChar));
  end;

  SendMessage(g_dwGameCenterHandle, WM_COPYDATA, nParam, NativeInt(@SendData));
  FreeMem(SendData.lpData);
end;

function GetIPAddr: string;
var
  A, B, C, D: Byte;
begin
  while True do
  begin
    A := Random(High(Byte));
    B := Random(High(Byte));
    C := Random(High(Byte));
    D := Random(High(Byte));
    if (A = 0) then
      Continue;
    if (A = 127) and (B = 0) and (C = 0) then
      Continue;
    if (A = 192) and (B = 168) then
      Continue;
    if (A = 255) and (B = 255) then
      Continue;
    Result := Format('%d.%d.%d.%d', [A, B, C, D]);
    Break;
  end;
end;

function GetIPLocal(sIPaddr: AnsiString): AnsiString;
var
  sLocal: array [0 .. 254] of AnsiChar;
  nLocalSize: DWORD;
begin
  Result := '未知';
  if g_PluginManager.IsCheckGetIPLocalHook then
  begin
    nLocalSize := SizeOf(sLocal);
    if g_PluginManager.HookGetIPLocal(PAnsiChar(sIPaddr), @sLocal, nLocalSize) then
    begin
      SetLength(Result, nLocalSize);
      Move(sLocal[0], Result[1], nLocalSize);
    end;
  end;
end;

