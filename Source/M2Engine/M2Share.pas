{ TSortItemList }

constructor TSortItemList.Create;
begin
  FItemList := TList.Create;
  InitializeCriticalSection(FCS);
end;

destructor TSortItemList.Destroy;
begin
  Clear;
  FItemList.Free;
  DeleteCriticalSection(FCS);
  inherited;
end;

procedure TSortItemList.Add(ItemIdx: Integer; ItemName: string);
var
  Item: PSortItem;
begin
  New(Item);
  Item.ItemIdx := ItemIdx;
  Item.ItemName := ItemName;
  FItemList.Add(Item);
end;

procedure TSortItemList.Clear;
var
  i: Integer;
begin
  for i := 0 to FItemList.Count - 1 do
  begin
    Dispose(PSortItem(FItemList.Items[i]));
  end;
  FItemList.Clear;
end;

function TSortItemList.GetCount: Integer;
begin
  Result := FItemList.Count;
end;

function TSortItemList.FindItem(ItemIdx: Integer): PSortItem;
var
  L, h, i, C: Integer;
begin
  Result := nil;
  L := 0;
  h := Count - 1;
  while L <= h do
  begin
    i := (L + h) shr 1;
    C := PSortItem(FItemList.Items[i]).ItemIdx - ItemIdx;
    if C < 0 then
      L := i + 1
    else
    begin
      h := i - 1;
      if C = 0 then
      begin
        Result := FItemList.Items[i];
        Break;
      end;
    end;
  end;
end;

function TSortItemList.GetItems(Index: Integer): PSortItem;
begin
  Result := FItemList.Items[Index];
end;

procedure TSortItemList.Sort;

  function SortCompare(Index1, Index2: Integer): Integer;
  var
    Item1, Item2: PSortItem;
  begin
    Item1 := FItemList.Items[Index1];
    Item2 := FItemList.Items[Index2];
    Result := Item1.ItemIdx - Item2.ItemIdx;
  end;

  procedure QuickSort(L, R: Integer);
  var
    i, J, P: Integer;
  begin
    repeat
      i := L;
      J := R;
      P := (L + R) shr 1;
      repeat
        while SortCompare(i, P) < 0 do
          Inc(i);
        while SortCompare(J, P) > 0 do
          Dec(J);
        if i <= J then
        begin
          FItemList.Exchange(i, J);
          if P = i then
            P := J
          else if P = J then
            P := i;
          Inc(i);
          Dec(J);
        end;
      until i > J;
      if L < J then
        QuickSort(L, J);
      L := i;
    until i >= R;
  end;

begin
  if FItemList.Count > 0 then
    QuickSort(0, FItemList.Count - 1);
end;

procedure TSortItemList.Lock;
begin
  EnterCriticalSection(FCS);
end;

procedure TSortItemList.UnLock;
begin
  LeaveCriticalSection(FCS);
end;

procedure CloseTargetSuperShiled(wHitMode: Integer; MagicLevel: Integer; Target: TBaseObject);
var
  SmartObj: TSmartObject;
  Rate: Integer;
  boClose: Boolean;
begin
  if (Target <> nil) and (Target.m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER, RC_HEROOBJECT]) then
  begin
    SmartObj := TSmartObject(Target);
    if not SmartObj.m_boSuperShiled then
      Exit;

    boClose := False;

    if (wHitMode = 4) then
    begin
      if not g_Config.UseSkillCloseSuperShileds[0] then
        Exit;
      Rate := g_Config.UseSkillCloseSuperShileds_Rate[0] + MagicLevel * g_Config.UseSkillCloseSuperShileds_RateAdd[0];

      boClose := Random(100) < Rate;
    end
    else if (wHitMode = 7) then
    begin
      if not g_Config.UseSkillCloseSuperShileds[1] then
        Exit;
      Rate := g_Config.UseSkillCloseSuperShileds_Rate[1] + MagicLevel * g_Config.UseSkillCloseSuperShileds_RateAdd[1];

      boClose := Random(100) < Rate;
    end
    else if (wHitMode = 11) or (wHitMode = 19) then
    begin
      if not g_Config.UseSkillCloseSuperShileds[2] then
        Exit;
      Rate := g_Config.UseSkillCloseSuperShileds_Rate[2] + MagicLevel * g_Config.UseSkillCloseSuperShileds_RateAdd[2];

      boClose := Random(100) < Rate;
    end
    else if (wHitMode = 15) then
    begin
      if not g_Config.UseSkillCloseSuperShileds[3] then
        Exit;
      Rate := g_Config.UseSkillCloseSuperShileds_Rate[3] + MagicLevel * g_Config.UseSkillCloseSuperShileds_RateAdd[3];

      boClose := Random(100) < Rate;
    end
    else if (wHitMode in [12 .. 14]) then
    begin
      if not g_Config.UseSkillCloseSuperShileds[4] then
        Exit;
      Rate := g_Config.UseSkillCloseSuperShileds_Rate[4] + MagicLevel * g_Config.UseSkillCloseSuperShileds_RateAdd[4];

      boClose := Random(100) < Rate;
    end;

    if boClose then
    begin
      SmartObj.CloseSuperShiled;
    end;
  end;
end;

