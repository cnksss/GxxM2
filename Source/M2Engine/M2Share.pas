          MonSuperAbil.boUnParalysis := sUnParalysis = '1';
          MonSuperAbil.boUnPosion := sUnPosion = '1';
          MonSuperAbil.boUnFireCross := sUnFireCross = '1';
          MonSuperAbil.boUnTamming := sUnTamming = '1';
          MonSuperAbil.boUnRevival := sUnRevival = '1';
          MonSuperAbil.boUnMagicShield := sUnMagicShield = '1';

