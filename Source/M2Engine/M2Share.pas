procedure LoadMagicACList;
var
  i: Integer;
  sFileName, sSectionName: string;
  MagicACInfo: PMagicACInfo;
  IniFile: TIniFileEx;
begin
  sFileName := g_Config.sEnvirDir + 'MagicListAC.ini';
  IniFile := TIniFileEx.Create(sFileName);
  for i := 0 to UserEngine.m_MagicACList.Count - 1 do
  begin
    MagicACInfo := UserEngine.m_MagicACList.Items[i];
    sSectionName := IntToStr(MagicACInfo.wMagicId);
    MagicACInfo.boEnabled := IniFile.ReadBool(sSectionName, 'Enabled', MagicACInfo.boEnabled);
    MagicACInfo.btHum := IniFile.ReadInteger(sSectionName, 'Hum', MagicACInfo.btHum);
    MagicACInfo.btMon := IniFile.ReadInteger(sSectionName, 'Mon', MagicACInfo.btMon);
    MagicACInfo.btHero := IniFile.ReadInteger(sSectionName, 'Hero', MagicACInfo.btHero);

    MagicACInfo.btDefenceHum := IniFile.ReadInteger(sSectionName, 'DefenceHum', MagicACInfo.btDefenceHum);
    MagicACInfo.btDefenceMon := IniFile.ReadInteger(sSectionName, 'DefenceMon', MagicACInfo.btDefenceMon);
    MagicACInfo.btDefenceHero := IniFile.ReadInteger(sSectionName, 'DefenceHero', MagicACInfo.btDefenceHero);
  end;
  IniFile.Free;
end;

procedure SaveMagicACList;
var
  i: Integer;
  sFileName, sSectionName: string;
  MagicACInfo: PMagicACInfo;
  IniFile: TIniFileEx;
begin
  sFileName := g_Config.sEnvirDir + 'MagicListAC.ini';
  IniFile := TIniFileEx.Create(sFileName);
  for i := 0 to UserEngine.m_MagicACList.Count - 1 do
  begin
    MagicACInfo := UserEngine.m_MagicACList.Items[i];
    sSectionName := IntToStr(MagicACInfo.wMagicId);
    IniFile.WriteBool(sSectionName, 'Enabled', MagicACInfo.boEnabled);
    IniFile.WriteInteger(sSectionName, 'Hum', MagicACInfo.btHum);
    IniFile.WriteInteger(sSectionName, 'Mon', MagicACInfo.btMon);
    IniFile.WriteInteger(sSectionName, 'Hero', MagicACInfo.btHero);

    IniFile.WriteInteger(sSectionName, 'DefenceHum', MagicACInfo.btDefenceHum);
    IniFile.WriteInteger(sSectionName, 'DefenceMon', MagicACInfo.btDefenceMon);
    IniFile.WriteInteger(sSectionName, 'DefenceHero', MagicACInfo.btDefenceHero);
  end;
  IniFile.Free;
end;

procedure LoadLowestSellingPriceList;
