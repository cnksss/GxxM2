    end;
  end;

  function GetFixVarEx(sData: string; var VarInfo: TVarInfo): Boolean;
  var
    sName: string;
  begin
    Result := False;
    if (Length(sData) > 1) and (sData[1] = '$') then
    begin
      sName := sData;
      if CompareLStr(sName, '$STR(', Length('$STR(')) then
      begin // $STR(S0)
        sData := ArrestStringEx(sName, '(', ')', sName);
        Result := GetFixVar(sName, VarInfo);
      end
      else { // if CompareLStr(sName, '$STR(', Length('$STR(')) then begin }
        if CompareLStr(sName, '$HUMAN(', Length('$HUMAN(')) then
        begin
          VarInfo.VarAttr := aDynamic;
          Result := True;
        end
        else if CompareLStr(sName, '$GUILD(', Length('$GUILD(')) then
        begin
          VarInfo.VarAttr := aDynamic;
          Result := True;
        end
        else if CompareLStr(sName, '$GLOBAL(', Length('$GLOBAL(')) then
        begin
          VarInfo.VarAttr := aDynamic;
          Result := True;
        end
        else
        begin
          VarInfo.VarAttr := aConst;
          Result := True;
        end;
    end;
  end;

  function ArrestBuffer(S: string; SearchAfter, ArrestBefore: Char): string;
  var
    Source: PChar;
    SrcLen: Integer;
    cChar: Char;
    nLen: Integer;
    buffer: PChar;
    BufferA: PChar;
    nLength: Integer;
  begin
    Result := '';
    if S = '' then
      Exit;
    Source := @S[1];
    SrcLen := Length(S);
    nLen := 0;
    nLength := 0;
    BufferA := nil;
    buffer := Source;
    while True do
    begin
      if nLen >= SrcLen then
        Break;
      cChar := buffer^;
      if cChar = SearchAfter then
      begin
        BufferA := buffer + 1;
        if BufferA^ <> '$' then
        begin
          BufferA := nil;
        end
        else
        begin
          Inc(buffer);
          Inc(nLen);
          Continue;
        end;
      end;
      if (BufferA <> nil) and (cChar = ArrestBefore) then
      begin
        nLength := NativeInt(buffer) - NativeInt(BufferA);
        if nLength > 1 then
        begin
          Break;
        end
        else
        begin
          BufferA := nil;
        end;
      end;
      Inc(buffer);
      Inc(nLen);
    end;
    if (nLength > 0) and (BufferA <> nil) then
    begin
      SetLength(Result, nLength);
      Move(BufferA^, Result[1], nLength);
    end;
  end;

var
  sData: string;
begin
  Result.VarType := vNone;
  Result.VarAttr := aNone;
  if (Length(sText) > 0) then
  begin
    if GetFixVar(sText, Result) then
      Exit;
    sData := sText;
    if not GetFixVarEx(sData, Result) then
    begin
      if (Pos('<', sData) > 0) and (Pos('>', sData) > 0) then
      begin
        sData := ArrestBuffer(sData, '<', '>');
        GetFixVarEx(sData, Result);
      end;
    end;
  end;
end;

function GetValNameNo(sText: string): Integer;
var
  sValNo: string;
  nValNo: Integer;
  Chr1: Char;
begin
  Result := -1;
  sText := Trim(sText);
  if Length(sText) >= 2 then
  begin
    Chr1 := UpCase(sText[1]);
    sValNo := Copy(sText, 2, Length(sText) - 1);

    case Ord(Chr1) of
      Ord('P'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 1000) then
            Result := nValNo;
        end;

      Ord('D'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 1000) then
            Result := nValNo + 1000;
        end;

      Ord('M'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 1000) then
            Result := nValNo + 2000;
        end;

      Ord('N'):
        begin
          // 这里加入$开头的，不算16进制，即N$1不能算到N1中，而要算到自定义变量中 chongchong 2017-09-17
          if (Length(sValNo) > 0) and (sValNo[1] = '$') then
          begin
            Exit;
          end;

          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 1000) then
            Result := nValNo + 3000;
        end;

      Ord('I'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 1000) then
            Result := nValNo + 4000;
        end;

      Ord('G'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 1000) then
            Result := nValNo + 5000;
        end;

      Ord('A'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 1000) then
            Result := nValNo + 6000;
        end;

      Ord('S'):
        begin
          // 这里加入$开头的，不算16进制，即S$1不能算到S1中，而要算到自定义变量中 chongchong 2017-09-17
          if (Length(sValNo) > 0) and (sValNo[1] = '$') then
          begin
            Exit;
          end;

          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 1000) then
            Result := nValNo + 7000;
        end;

      // 私有变量U-数字型; T-字符串型 chongchong 2014-10-18
      Ord('U'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 500) then
            Result := nValNo + 8000;
        end;

      Ord('T'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 500) then
            Result := nValNo + 8500;
        end;

      // 私有变量J-数字型（1天1清）chongchong 2018-07-19 16:57:29
      Ord('J'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 500) then
            Result := nValNo + 9000;
        end;

      // 私有变量J-数字型（1天1清）chongchong 2018-07-19 16:57:29
      Ord('Z'):
        begin
          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 500) then
            Result := nValNo + 9500;
        end;


      //L变量
      Ord('L'):
        begin
          // 这里加入$开头的，不算16进制，即N$1不能算到N1中，而要算到自定义变量中 chongchong 2017-09-17
          if (Length(sValNo) > 0) and (sValNo[1] = '$') then
          begin
            Exit;
          end;

          nValNo := StrToIntDef(sValNo, -1);
          if (nValNo >= 0) and (nValNo < 1000) then
            Result := nValNo + 10000;
        end;
    end;
  end;
end;

function ExtractVar(sText: string; var VarName: Char; var VarIndex: Integer): Boolean;
var
  sVarIndex: string;
begin
  Result := False;
  sText := Trim(sText);
  if Length(sText) >= 2 then
  begin
    VarName := UpCase(sText[1]);
    sVarIndex := Copy(sText, 2, Length(sText) - 1);
    VarIndex := StrToIntDef(sVarIndex, -1);

    case Ord(VarName) of
      Ord('P'):
        Result := (VarIndex >= 0) and (VarIndex < 1000);
      Ord('D'):
        Result := (VarIndex >= 0) and (VarIndex < 1000);
      Ord('M'):
        Result := (VarIndex >= 0) and (VarIndex < 1000);
      Ord('N'):
        begin
          // 这里加入$开头的，不算16进制，即N$1不能算到N1中，而要算到自定义变量中 chongchong 2017-09-17
          if (Length(sVarIndex) > 0) and (sVarIndex[1] = '$') then
          begin
            Exit;
          end;

          Result := (VarIndex >= 0) and (VarIndex < 1000);
        end;

      Ord('I'):
        Result := (VarIndex >= 0) and (VarIndex < 1000);
      Ord('G'):
        Result := (VarIndex >= 0) and (VarIndex < 1000);
      Ord('A'):
        Result := (VarIndex >= 0) and (VarIndex < 1000);
      Ord('S'):
        begin
          // 这里加入$开头的，不算16进制，即S$1不能算到S1中，而要算到自定义变量中 chongchong 2017-09-17
          if (Length(sVarIndex) > 0) and (sVarIndex[1] = '$') then
          begin
            Exit;
          end;

          Result := (VarIndex >= 0) and (VarIndex < 1000);
        end;
        //L变量
      Ord('L'):
        begin
          // 这里加入$开头的，不算16进制，即S$1不能算到S1中，而要算到自定义变量中 chongchong 2017-09-17
          if (Length(sVarIndex) > 0) and (sVarIndex[1] = '$') then
          begin
            Exit;
          end;

          Result := (VarIndex >= 0) and (VarIndex < 1000);
        end;

      // 私有变量U-数字型; T-字符串型 chongchong 2014-10-18
      Ord('U'):
        Result := (VarIndex >= 0) and (VarIndex < 500);

      Ord('T'):
        Result := (VarIndex >= 0) and (VarIndex < 500);

      // 私有变量J-数字型（1天1清）chongchong 2018-07-19 16:57:29
      Ord('J'):
        Result := (VarIndex >= 0) and (VarIndex < 500);

      // 私有变量J-数字型（1天1清）chongchong 2018-07-19 16:57:29
      Ord('Z'):
        Result := (VarIndex >= 0) and (VarIndex < 500);
    end;
  end;
end;

