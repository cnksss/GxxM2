procedure Reset_g_WarrContinueMagicIDList;
var
  i, MagicID: Integer;
  SL: TStringList;
  Magic: pTMagic;
begin
  g_WarrContinueMagicIDList.Clear;
  SL := TStringList.Create;
  try
    SL.Delimiter := ',';
    SL.DelimitedText := g_Config.sDisableWarrContinueHitIDs;

    for i := 0 to SL.Count - 1 do
    begin
      MagicID := StrToIntDef(SL.Strings[i], 0);
