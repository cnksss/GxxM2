procedure RebuildDropItemsEffect;
var
  i: Integer;
  ItemEffect: pTItemEffect;
  InBuf: array [0 .. 102400] of AnsiChar;
  DropItemEffect: PDropItemEffect;
  DropItemEffectCount: Integer;
begin
  DropItemEffect := @InBuf[0];
  DropItemEffectCount := 0;

  for i := 0 to g_ItemEffects.Count - 1 do
  begin
    ItemEffect := g_ItemEffects.Items[i];

    if (ItemEffect <> nil) and (ItemEffect.FileIndex5 >= 0) and (ItemEffect.ImageCount5 > 0) then
    begin
      DropItemEffect.ItemEffectIndex := ItemEffect.Index;

      DropItemEffect.ImageCount := ItemEffect.ImageCount5;
      DropItemEffect.FileIndex := ItemEffect.FileIndex5;
      DropItemEffect.StartIndex := ItemEffect.StartIndex5;
      DropItemEffect.OffsetX := ItemEffect.OffSetX5;
      DropItemEffect.OffsetY := ItemEffect.OffSetY5;
      DropItemEffect.DrawCenter := ItemEffect.DrawCenter5;
      DropItemEffect.NoBlend := ItemEffect.NoBlendMode5;
      DropItemEffect.Time := ItemEffect.Time5;
      DropItemEffect.BelowItem := ItemEffect.boEfectBelowItem5;

      Inc(DropItemEffect);
      Inc(DropItemEffectCount);

      if (DropItemEffectCount + 1) * SizeOf(TDropItemEffect) >= Length(InBuf) then
        Break;
    end;
  end;

  g_DropItemEffectListTextLen := DropItemEffectCount * SizeOf(TDropItemEffect);

  if g_DropItemEffectListTextLen > 0 then
  begin
    g_DropItemEffectListText := zLibCompressBuffer(@InBuf[0], g_DropItemEffectListTextLen);
    g_DropItemEffectListTextCRC := BufferCrc(PAnsiChar(g_DropItemEffectListText), Length(g_DropItemEffectListText));
  end
  else
  begin
    g_DropItemEffectListText := '';
    g_DropItemEffectListTextCRC := 0;
  end;
end;
