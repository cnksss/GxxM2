procedure RecallGamePetAbil(GamePetData: pTClientGamePetData);
var
  i, nRace, nAppr: Integer;
  BaseObject: TBaseObject;
  MonInfo: pTMonInfo;
  GamePetConfig: pTGamePetConfig;
begin
  nRace := -1;
  nAppr := -1;

  if UserEngine.FindMonster(GamePetData.sName, i) then
  begin
    MonInfo := UserEngine.MonsterList.Items[i];
    nRace := MonInfo.btRace;
    nAppr := MonInfo.wAppr;
  end;

  if nRace = 0 then
    Exit;

  BaseObject := UserEngine.CreateBaseObjectByRace(GamePetData.sName, nRace, 0, 0);
  if BaseObject <> nil then
  begin
    UserEngine.MonInitialize(BaseObject, GamePetData.sName);
    UserEngine.SetMonIcons(BaseObject);
    BaseObject.m_boMonGetRandomItems := True;
    BaseObject.m_boGamePet := True;

    BaseObject.m_Abil.Level := GamePetData.GamePetAbility.Level;
    BaseObject.m_Abil.MaxExp := BaseObject.GetLevelExp(BaseObject.m_Abil.Level);
    BaseObject.m_WAbil := BaseObject.m_Abil;

    BaseObject.RecalcAbilitys;

    GamePetData.GamePetAbility.AC1 := BaseObject.m_WAbil.AC1;
    GamePetData.GamePetAbility.AC2 := BaseObject.m_WAbil.AC2;

    GamePetData.GamePetAbility.MAC1 := BaseObject.m_WAbil.MAC1;
    GamePetData.GamePetAbility.MAC2 := BaseObject.m_WAbil.MAC2;

    GamePetData.GamePetAbility.DC1 := BaseObject.m_WAbil.DC1;
    GamePetData.GamePetAbility.DC2 := BaseObject.m_WAbil.DC2;

    GamePetData.GamePetAbility.MC1 := BaseObject.m_WAbil.MC1;
    GamePetData.GamePetAbility.MC2 := BaseObject.m_WAbil.MC2;

    GamePetData.GamePetAbility.SC1 := BaseObject.m_WAbil.SC1;
    GamePetData.GamePetAbility.SC2 := BaseObject.m_WAbil.SC2;

    GamePetData.GamePetAbility.MaxHP := BaseObject.m_WAbil.MaxHP;
    GamePetData.GamePetAbility.MaxMP := BaseObject.m_WAbil.MaxMP;

    GamePetData.GamePetAbility.MaxExp := BaseObject.m_WAbil.MaxExp;

    GamePetData.ShowConfig.wAppr := nAppr;
    GamePetConfig := GetGamePetConfig(GamePetData.sName);
    if GamePetConfig <> nil then
    begin
      GamePetData.ShowConfig.ShowFile1 := GamePetConfig.ShowFile1;
      GamePetData.ShowConfig.ShowStart1 := GamePetConfig.ShowStart1;
      GamePetData.ShowConfig.ShowCount1 := GamePetConfig.ShowCount1;
      GamePetData.ShowConfig.ShowTime1 := GamePetConfig.ShowTime1;
      GamePetData.ShowConfig.ShowOffsetX1 := GamePetConfig.ShowOffsetX1;
      GamePetData.ShowConfig.ShowOffsetY1 := GamePetConfig.ShowOffsetY1;

      GamePetData.ShowConfig.ShowFile2 := GamePetConfig.ShowFile2;
      GamePetData.ShowConfig.ShowStart2 := GamePetConfig.ShowStart2;
      GamePetData.ShowConfig.ShowCount2 := GamePetConfig.ShowCount2;
      GamePetData.ShowConfig.ShowTime2 := GamePetConfig.ShowTime2;
      GamePetData.ShowConfig.ShowOffsetX2 := GamePetConfig.ShowOffsetX2;
      GamePetData.ShowConfig.ShowOffsetY2 := GamePetConfig.ShowOffsetY2;
    end;

    BaseObject.Free;
  end;
end;

