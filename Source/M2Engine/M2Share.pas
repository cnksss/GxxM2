  Result := True;
end;

function LoadPreviewItemMonList(): Boolean;
var
  i: Integer;
  LoadList: TStringList;
  dwValue: LongWord;
  sFileName, sMonName, sRefreshTime, sLineText: string;
begin
  Result := False;
  g_PreviewItemMonList.Clear;
  sFileName := g_Config.sEnvirDir + 'PreviewItemMonList.txt';
  if not FileExists(sFileName) then
    Exit;

  LoadList := TStringList.Create;
  try
    LoadList.LoadFromFile(sFileName);

    g_PreviewItemMonList.Lock;
    try
      for i := 0 to LoadList.Count - 1 do
      begin
        sLineText := LoadList.Strings[i];
        sLineText := GetValidStr3(sLineText, sMonName, [' ', #9]);
        sLineText := GetValidStr3(sLineText, sRefreshTime, [' ', #9]);
        dwValue := StrToIntDef(sRefreshTime, 0);
        g_PreviewItemMonList.AddObject(sMonName, TObject(dwValue));
      end;
    finally
      g_PreviewItemMonList.UnLock;
    end;

    Result := True;
  finally
    LoadList.Free;
  end;
end;

function SavePreviewItemMonList(): Boolean;
var
  i: Integer;
  SL: TStringList;
  sFileName: string;
  sLineText: string;
  dwRefreshTime: Word;
begin
  sFileName := g_Config.sEnvirDir + 'PreviewItemMonList.txt';
  SL := TStringList.Create;
  try
    g_PreviewItemMonList.Lock;
    try
      for i := 0 to g_PreviewItemMonList.Count - 1 do
      begin
        dwRefreshTime := DWORD(g_PreviewItemMonList.Objects[i]);
        sLineText := g_PreviewItemMonList.Strings[i] + #9 + IntToStr(dwRefreshTime);
        SL.Add(sLineText);
      end;
    finally
      g_PreviewItemMonList.UnLock;
    end;

    SL.SaveToFile(sFileName);
  finally
    SL.Free;
  end;

  Result := True;
end;

