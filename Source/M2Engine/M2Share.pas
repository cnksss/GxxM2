function IsValidMagicInSkillPowerItem(MagicID: Integer): Boolean;
begin
  Result := not(MagicID in [2, 4, 8, 14 .. 21, 29, 28, 30, 31, 32, 34, 38, 41, 48, 49, 50, 55, 68, 67, 70 .. 80]);
end;

procedure LoadSkillPowerItemList; // 技能威力百分比
var
  i, ii: Integer;
  LoadList: TStringList;
  sFileName, sItemName: string;
  SkillPowerItem: pTSkillPowerItem;
  IniFile: TIniFileEx;
begin
  sFileName := g_Config.sEnvirDir + 'SkillPowerItemList.txt';

  if FileExists(sFileName) then
  begin
    g_SkillPowerItemList.Lock;
    try
      for i := 0 to g_SkillPowerItemList.Count - 1 do
      begin
        Dispose(pTSkillPowerItem(g_SkillPowerItemList.Objects[i]));
      end;
      g_SkillPowerItemList.Clear;
      LoadList := TStringList.Create;
      IniFile := TIniFileEx.Create(sFileName);
      IniFile.ReadSections(LoadList);
      for i := 0 to LoadList.Count - 1 do
      begin
        // Application.ProcessMessages;
        sItemName := LoadList.Strings[i];
        if (sItemName = '') or (sItemName[1] = ';') then
          Continue;
        New(SkillPowerItem);
        FillChar(SkillPowerItem.AttackSkillPercent, SizeOf(SkillPowerItem.AttackSkillPercent), 0);
        FillChar(SkillPowerItem.DefenseSkillPercent, SizeOf(SkillPowerItem.DefenseSkillPercent), 0);
        for ii := 1 to High(SkillPowerItem.AttackSkillPercent) do
        begin
          // Application.ProcessMessages;
          if not IsValidMagicInSkillPowerItem(ii) then
            Continue;
          SkillPowerItem.AttackSkillPercent[ii] := IniFile.ReadInteger(sItemName, 'Attack' + IntToStr(ii), 0);
          SkillPowerItem.DefenseSkillPercent[ii] := IniFile.ReadInteger(sItemName, 'Defense' + IntToStr(ii), 0);
        end;
        g_SkillPowerItemList.AddObject(sItemName, TObject(SkillPowerItem));
      end;

      g_SkillPowerItemList.Sorted := True;
      IniFile.Free;
      LoadList.Free;
    finally
      g_SkillPowerItemList.UnLock;
    end;
  end;
end;

procedure SaveSkillPowerItemList;
var
  i, ii: Integer;
  sFileName: string;
  SkillPowerItem: pTSkillPowerItem;
  IniFile: TIniFileEx;
  SectionName: string;
begin
  sFileName := g_Config.sEnvirDir + 'SkillPowerItemList.txt';
  if FileExists(sFileName) then
  begin
    DeleteFile(sFileName);
  end;
  IniFile := TIniFileEx.Create(sFileName);
  g_SkillPowerItemList.Lock;
  try
    for i := 0 to g_SkillPowerItemList.Count - 1 do
    begin
      // 修复读取装备技能威力慢的问题 原因在SectionName中的[]没作处理 chongchong 2013-11-24
      SectionName := g_SkillPowerItemList.Strings[i];

      SkillPowerItem := pTSkillPowerItem(g_SkillPowerItemList.Objects[i]);
      // Application.ProcessMessages;
      for ii := 1 to High(SkillPowerItem.AttackSkillPercent) do
      begin
        // Application.ProcessMessages;
        if not IsValidMagicInSkillPowerItem(ii) then
          Continue;

        if SkillPowerItem.AttackSkillPercent[ii] <> 0 then
          IniFile.WriteInteger(SectionName, 'Attack' + IntToStr(ii), SkillPowerItem.AttackSkillPercent[ii]);
        if SkillPowerItem.DefenseSkillPercent[ii] <> 0 then
          IniFile.WriteInteger(SectionName, 'Defense' + IntToStr(ii), SkillPowerItem.DefenseSkillPercent[ii]);
      end;
    end;
  finally
    g_SkillPowerItemList.UnLock;
  end;
  IniFile.Free;
end;

function GetSkillPowerItem(const sItemName: string): pTSkillPowerItem;
var
  i: Integer;
begin
  Result := nil;
  g_SkillPowerItemList.Lock;
  try
    i := g_SkillPowerItemList.IndexOf(sItemName);
    if i >= 0 then
    begin
      Result := pTSkillPowerItem(g_SkillPowerItemList.Objects[i]);
    end;
  finally
    g_SkillPowerItemList.UnLock;
  end;
end;

