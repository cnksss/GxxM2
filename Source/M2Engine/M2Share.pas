function LoadLineNotice(FileName: string): Boolean;
var
  i, nPos: Integer;
  sText, sColor, sFColor, sBColor, sFrameColor: string;
  sFontSize: string;
  LoadList: TStringList;
  NoticeColor: pTNoticeColor;
  MsgColor: TMsgColor;
begin
  Result := False;
  if FileExists(FileName) then
  begin
    for i := 0 to LineNoticeList.Count - 1 do
    begin
      Dispose(pTNoticeColor(LineNoticeList.Objects[i]));
    end;
    LineNoticeList.Clear;
    LoadList := TStringList.Create;
    LoadList.LoadFromFile(FileName);
    i := 0;
    while (True) do
    begin
      if LoadList.Count <= i then
        Break;
      sText := Trim(LoadList.Strings[i]);
      if sText = '' then
      begin
        LoadList.Delete(i);
        Continue;
      end;
      // if Length(sText) > 500 then sText := Copy(sText, 1, 500);
      LoadList.Strings[i] := sText;
      Inc(i);
    end;

    for i := 0 to LoadList.Count - 1 do
    begin
      sText := LoadList.Strings[i];
      New(NoticeColor);
      NoticeColor.LineNoticeColor := nil;
      NoticeColor.IsFixedColor := False;
      NoticeColor.IsMove := False;
      NoticeColor.boShowFrame := True;
      NoticeColor.btFrameColor := 190;
      NoticeColor.btFontSize := 11;
      NoticeColor.boFontBold := True;

      sFrameColor := '';
      case sText[1] of
        'R':
          begin
            sText := Copy(sText, 2, Length(sText) - 1);
            NoticeColor.FColor := GetRGB(g_Config.btRedMsgFColor);
            NoticeColor.BColor := GetRGB(g_Config.btRedMsgBColor);
            NoticeColor.btFColor := g_Config.btRedMsgFColor;
            NoticeColor.btBColor := g_Config.btRedMsgBColor;
            NoticeColor.IsFixedColor := True;
            NoticeColor.MsgColor := c_Red;
          end;
        'G':
          begin
            sText := Copy(sText, 2, Length(sText) - 1);
            NoticeColor.FColor := GetRGB(g_Config.btGreenMsgFColor);
            NoticeColor.BColor := GetRGB(g_Config.btGreenMsgBColor);
            NoticeColor.btFColor := g_Config.btGreenMsgFColor;
            NoticeColor.btBColor := g_Config.btGreenMsgBColor;
            NoticeColor.IsFixedColor := True;
            NoticeColor.MsgColor := c_Green;
          end;
        'B':
          begin
            sText := Copy(sText, 2, Length(sText) - 1);
            NoticeColor.FColor := GetRGB(g_Config.btBlueMsgFColor);
            NoticeColor.BColor := GetRGB(g_Config.btBlueMsgBColor);
            NoticeColor.btFColor := g_Config.btBlueMsgFColor;
            NoticeColor.btBColor := g_Config.btBlueMsgBColor;
            NoticeColor.IsFixedColor := True;
            NoticeColor.MsgColor := c_Blue;
          end;
        '[':
          begin
            nPos := Pos(']', sText);
            if (nPos > 0) then
            begin
              sColor := Copy(sText, 2, nPos - 2);
              sText := Copy(sText, nPos + 1, Length(sText) - nPos);

              // 公告可指定字体 chongchong 2014-06-04
              sText := GetValidStr3_Ex(sText, sFontSize, #9);
              if Length(sText) = 0 then
              begin
                sText := sFontSize;
                NoticeColor.btFontSize := 11;
                NoticeColor.boFontBold := True;
              end
              else
              begin
                if Length(sFontSize) > 0 then
                begin
                  if SameText(sFontSize[Length(sFontSize)], 'b') then
                  begin
                    NoticeColor.btFontSize := StrToIntDef(Copy(sFontSize, 1, Length(sFontSize) - 1), 11);
                    NoticeColor.boFontBold := True;
                  end
                  else
                  begin
                    NoticeColor.btFontSize := StrToIntDef(sFontSize, 11);
                    NoticeColor.boFontBold := False;
                  end;
                end
                else
                begin
                  NoticeColor.btFontSize := 11;
                  NoticeColor.boFontBold := True;
                end;
              end;

              sColor := Trim(sColor);
              nPos := Pos(',', sColor);
              if nPos > 0 then
              begin
                sFColor := Trim(Copy(sColor, 1, nPos - 1));
                sColor := Trim(Copy(sColor, nPos + 1, MAXINT));
                nPos := Pos(',', sColor);
                if nPos = 0 then
                begin
                  sBColor := sColor;
                  NoticeColor.boShowFrame := False;
                end
                else
                begin
                  sBColor := Trim(Copy(sColor, 1, nPos - 1));
                  sFrameColor := Trim(Copy(sColor, nPos + 1, MAXINT));

                  NoticeColor.boShowFrame := True;
                  NoticeColor.btFrameColor := StrToIntDef(sFrameColor, 190);
                end;
                // MainOutMessage('[sFColor:' + sFColor + ' sBColor:' + sBColor);
                NoticeColor.btFColor := StrToIntDef(sFColor, $FF);
                NoticeColor.btBColor := StrToIntDef(sBColor, $38);
                NoticeColor.FColor := GetRGB(NoticeColor.btFColor);
                NoticeColor.BColor := GetRGB(NoticeColor.btBColor);
                NoticeColor.IsFixedColor := True;
                NoticeColor.MsgColor := c_White;
              end
              else
              begin
                NoticeColor.FColor := GetRGB(g_Config.btRedMsgFColor);
                NoticeColor.BColor := GetRGB(g_Config.btRedMsgBColor);
                NoticeColor.btFColor := g_Config.btRedMsgFColor;
                NoticeColor.btBColor := g_Config.btRedMsgBColor;
                NoticeColor.MsgColor := TMsgColor(g_Config.nLineNoticeColor);
                NoticeColor.LineNoticeColor := @g_Config.nLineNoticeColor;
              end;
            end
            else
            begin
              NoticeColor.FColor := GetRGB(g_Config.btRedMsgFColor);
              NoticeColor.BColor := GetRGB(g_Config.btRedMsgBColor);
              NoticeColor.btFColor := g_Config.btRedMsgFColor;
              NoticeColor.btBColor := g_Config.btRedMsgBColor;
              NoticeColor.MsgColor := TMsgColor(g_Config.nLineNoticeColor);
              NoticeColor.LineNoticeColor := @g_Config.nLineNoticeColor;
            end;
          end;
        '<':
          begin
            nPos := Pos('>', sText);
            if (nPos > 0) then
            begin
              // <252,255,190> 10b 公告内容 255为背景色 2
              sColor := Copy(sText, 2, nPos - 2);
              sText := Copy(sText, nPos + 1, Length(sText) - nPos);

              // 公告可指定字体 chongchong 2014-06-04
              sText := GetValidStr3_Ex(sText, sFontSize, #9);
              if Length(sText) = 0 then
              begin
                sText := sFontSize;
                NoticeColor.btFontSize := 11;
                NoticeColor.boFontBold := True;
              end
              else
              begin
                if Length(sFontSize) > 0 then
                begin
                  if SameText(sFontSize[Length(sFontSize)], 'b') then
                  begin
                    NoticeColor.btFontSize := StrToIntDef(Copy(sFontSize, 1, Length(sFontSize) - 1), 11);
                    NoticeColor.boFontBold := True;
                  end
                  else
                  begin
                    NoticeColor.btFontSize := StrToIntDef(sFontSize, 11);
                    NoticeColor.boFontBold := False;
                  end;
                end
                else
                begin
                  NoticeColor.btFontSize := 11;
                  NoticeColor.boFontBold := True;
                end;
              end;

              sColor := Trim(sColor);
              nPos := Pos(',', sColor);
              if nPos > 0 then
              begin
                sFColor := Trim(Copy(sColor, 1, nPos - 1));
                sColor := Trim(Copy(sColor, nPos + 1, MAXINT));
                nPos := Pos(',', sColor);
                if nPos = 0 then
                begin
                  sBColor := sColor;
                  NoticeColor.boShowFrame := False;
                end
                else
                begin
                  sBColor := Trim(Copy(sColor, 1, nPos - 1));
                  sFrameColor := Trim(Copy(sColor, nPos + 1, MAXINT));

                  NoticeColor.boShowFrame := True;
                  NoticeColor.btFrameColor := StrToIntDef(sFrameColor, 190);
                end;

                // MainOutMessage('<sFColor:' + sFColor + ' sBColor:' + sBColor);
                NoticeColor.btFColor := StrToIntDef(sFColor, $FF);
                NoticeColor.btBColor := StrToIntDef(sBColor, $38);
                NoticeColor.FColor := GetRGB(NoticeColor.btFColor);
                NoticeColor.BColor := GetRGB(NoticeColor.btBColor);
                NoticeColor.IsFixedColor := True;
                NoticeColor.IsMove := True;
              end
              else
              begin
                NoticeColor.FColor := GetRGB(g_Config.btRedMsgFColor);
                NoticeColor.BColor := GetRGB(g_Config.btRedMsgBColor);
                NoticeColor.btFColor := g_Config.btRedMsgFColor;
                NoticeColor.btBColor := g_Config.btRedMsgBColor;
                NoticeColor.MsgColor := TMsgColor(g_Config.nLineNoticeColor);
                NoticeColor.LineNoticeColor := @g_Config.nLineNoticeColor;
              end;
            end
            else
            begin
              NoticeColor.FColor := GetRGB(g_Config.btRedMsgFColor);
              NoticeColor.BColor := GetRGB(g_Config.btRedMsgBColor);
              NoticeColor.btFColor := g_Config.btRedMsgFColor;
              NoticeColor.btBColor := g_Config.btRedMsgBColor;
              NoticeColor.MsgColor := TMsgColor(g_Config.nLineNoticeColor);
              NoticeColor.LineNoticeColor := @g_Config.nLineNoticeColor;
            end;
          end;
      else
        begin
          MsgColor := TMsgColor(g_Config.nLineNoticeColor);
          NoticeColor.MsgColor := MsgColor;
          case MsgColor of
            c_Red:
              begin
                NoticeColor.FColor := GetRGB(g_Config.btRedMsgFColor);
                NoticeColor.BColor := GetRGB(g_Config.btRedMsgBColor);
                NoticeColor.btFColor := g_Config.btRedMsgFColor;
                NoticeColor.btBColor := g_Config.btRedMsgBColor;
                NoticeColor.LineNoticeColor := @g_Config.nLineNoticeColor;
              end;
            c_Green:
              begin
                // sText := Copy(sText, 2, Length(sText) - 1);
                NoticeColor.FColor := GetRGB(g_Config.btGreenMsgFColor);
                NoticeColor.BColor := GetRGB(g_Config.btGreenMsgBColor);
                NoticeColor.btFColor := g_Config.btGreenMsgFColor;
                NoticeColor.btBColor := g_Config.btGreenMsgBColor;
                NoticeColor.LineNoticeColor := @g_Config.nLineNoticeColor;
              end;
            c_Blue:
              begin
                NoticeColor.FColor := GetRGB(g_Config.btBlueMsgFColor);
                NoticeColor.BColor := GetRGB(g_Config.btBlueMsgBColor);
                NoticeColor.btFColor := g_Config.btBlueMsgFColor;
                NoticeColor.btBColor := g_Config.btBlueMsgBColor;
                NoticeColor.LineNoticeColor := @g_Config.nLineNoticeColor;
              end;
          end;
        end;
      end;
      LineNoticeList.AddObject(sText, TObject(NoticeColor));
    end;

    LoadList.Free;
    Result := True;
  end;
end;

