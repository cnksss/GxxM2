procedure MainOutMessage(Msg: string; IsAddTime: Boolean; StyleNo: Integer);
begin
  if not g_Config.boShowExceptionMsg then
  begin
    if (Length(Msg) > 2) and ((Msg[2] = 'E') or (Msg[1] = 'A')) then
      Exit;
  end;

  EnterCriticalSection(LogMsgCriticalSection);
  try
    if IsAddTime then
      MainLogMsgList.AddObject(FormatDateTime(' > yyyy/mm/dd hh:nn:ss', Now) + ' ' + Msg, TObject(StyleNo))
    else
      MainLogMsgList.AddObject(Msg, TObject(StyleNo));
  finally
    LeaveCriticalSection(LogMsgCriticalSection);
  end;
end;

function GetExVersionNO(nVersionDate: Integer; var nOldVerstionDate: Integer): Integer;
