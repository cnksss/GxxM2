procedure UserItemToClientItem(UserItem: pTUserItem; StdItem: pTStdItem; ClientItem: PTClientItem;
  IsAddValue, IsProcessStdMode50: Boolean);
begin
  FillChar(ClientItem^, SizeOf(TClientItem), #0);

  ClientItem.S := StdItem^;

  if IsAddValue then
    ItemUnit.GetItemAddValue(UserItem, ClientItem.S);

  // 取自定义物品名称
  if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
    ClientItem.S.Name := UserItem.Name;

  ClientItem.MakeIndex := UserItem.MakeIndex;
  ClientItem.Dura := UserItem.Dura;
  ClientItem.DuraMax := UserItem.DuraMax;

  ClientItem.IsBind := UserItem.boIsBind;

  ClientItem.btUpgradeCount := UserItem.btUpgradeCount; // 升级次数
  ClientItem.btHeroM2Light := UserItem.btHeroM2Light; // HeroM2 SetItemsLight

  Move(UserItem.btValue, ClientItem.btValue, SizeOf(UserItem.btValue));
  Move(UserItem.btNewValue, ClientItem.NewValue, SizeOf(UserItem.btNewValue));

  // 防止武器升级后，通过查找内存可以知道是否成功成功 chongchong 2014-12-09
  // ClientItem.btValue[10] := 0;
  // 装备凹槽 chongchong 2015-01-03
  ClientItem.btFluteCount := UserItem.btFluteCount;
  Move(UserItem.Flutes, ClientItem.Flutes, SizeOf(UserItem.Flutes));

  Move(UserItem.Progress, ClientItem.Progress, SizeOf(UserItem.Progress));
  Move(UserItem.CustomProperty, ClientItem.CustomProperty, SizeOf(UserItem.CustomProperty));

  if not InDisableShowItemFromList(UserItem.wIndex) then
    Move(UserItem.ItemFrom, ClientItem.ItemFrom, SizeOf(UserItem.ItemFrom))
  else
  begin
    FillChar(ClientItem.ItemFrom, SizeOf(ClientItem.ItemFrom), 0);
    ClientItem.ItemFrom.DateTime := UserItem.ItemFrom.DateTime;
  end;

  ClientItem.wInsuranceCount := UserItem.wInsuranceCount;

  if IsProcessStdMode50 then
  begin
    if StdItem.StdMode = 50 then
    begin
      ClientItem.S.Name := ClientItem.S.Name + ' #' + IntToStr(UserItem.Dura);
    end;
    if (UserItem.btValue[8] <> 0) and (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26]) then
    begin
      ClientItem.S.Shape := 130;
    end;
  end;
end;

procedure AddClientModule(BaseObject: TBaseObject; sData: string);
var
  i, ii: Integer;
  LoadList: TStringList;
  sMD5: string;
  sFileName: string;
  sLineText: string;
  ModuleInfo: pTModuleInfo;
  boFind: Boolean;
  boSave: Boolean;
  boSaveOK: Boolean;
begin
  LoadList := TStringList.Create;
  LoadList.Text := sData;
  boSave := False;
  boSaveOK := False;
  for i := 0 to LoadList.Count - 1 do
  begin
    sLineText := LoadList.Strings[i];
    sLineText := GetValidStr3_Ex(sLineText, sMD5, '|');
    sLineText := GetValidStr3_Ex(sLineText, sFileName, '|');
    if Length(sMD5) = 32 then
    begin
      MainOutMessage(Format('%s 提交外挂模块 %s|%s', [BaseObject.m_sCharName, sMD5, sFileName]));
      boFind := False;

      for ii := g_BlackModuleList.Count - 1 downto 0 do
      begin
        ModuleInfo := g_BlackModuleList.Items[ii];
        if ModuleInfo.sMD5 = sMD5 then
        begin
          boSaveOK := True;
          g_BlackModuleList.Delete(ii);
          Dispose(ModuleInfo);
        end;
      end;

      for ii := 0 to g_ModuleList.Count - 1 do
      begin
        ModuleInfo := g_ModuleList.Items[ii];
        if ModuleInfo.sMD5 = sMD5 then
        begin
          boFind := True;
          Break;
        end;
      end;
      if not boFind then
      begin
        boSave := True;
        New(ModuleInfo);
        ModuleInfo.sMD5 := sMD5;
        ModuleInfo.sFileName := sFileName;
        ModuleInfo.boMode := True;
        g_ModuleList.Add(ModuleInfo);
      end;
    end;
  end;
  LoadList.Free;
  if boSave then
    SaveClientModules();
  if boSaveOK then
    SaveClientBlackModules();
end;

procedure LoadClientModules();
var
  i: Integer;
  LoadList: TStringList;
  sMD5: string;
  sFileName: string;
  sLineText: string;
  sMode: string;
  ModuleInfo: pTModuleInfo;
  StrModuleList: AnsiString;
begin
  StrModuleList := '';
  g_ModuleListTextLen := 0;
  g_ModuleListText := '';
  g_ModuleListTextCRC := 0;

  sFileName := g_Config.sEnvirDir + 'ModuleList.txt';
  if not FileExists(sFileName) then
    Exit;

  for i := 0 to g_ModuleList.Count - 1 do
  begin
    Dispose(pTModuleInfo(g_ModuleList.Items[i]));
  end;
  g_ModuleList.Clear;

  LoadList := TStringList.Create;
  try
    LoadList.LoadFromFile(sFileName);
    for i := 0 to LoadList.Count - 1 do
    begin
      sLineText := Trim(LoadList.Strings[i]);
      if (sLineText = '') or (sLineText[1] = ';') then
        Continue;
      sLineText := GetValidStr3_Ex(sLineText, sMD5, '|');
      sLineText := GetValidStr3_Ex(sLineText, sFileName, '|');
      sLineText := GetValidStr3_Ex(sLineText, sMode, '|');
      if Length(sMD5) = 32 then
      begin
        New(ModuleInfo);
        ModuleInfo.sMD5 := sMD5;
        ModuleInfo.sFileName := sFileName;
        ModuleInfo.boMode := sMode = '1';
        g_ModuleList.Add(ModuleInfo);

        StrModuleList := StrModuleList + sMD5 + sLineBreak;
      end;
    end;
  finally
    LoadList.Free;
  end;

  g_ModuleListTextLen := Length(StrModuleList);
  g_ModuleListText := zLibCompressString(StrModuleList);
  g_ModuleListTextCRC := BufferCrc(PAnsiChar(g_ModuleListText), Length(g_ModuleListText));
end;

procedure SaveClientModules();
var
  i: Integer;
  SaveList: TStringList;
  ModuleInfo: pTModuleInfo;
  sFileName: string;
  StrModuleList: AnsiString;
begin
  StrModuleList := '';
  sFileName := g_Config.sEnvirDir + 'ModuleList.txt';
  SaveList := TStringList.Create;
  for i := 0 to g_ModuleList.Count - 1 do
  begin
    ModuleInfo := g_ModuleList.Items[i];
    StrModuleList := StrModuleList + ModuleInfo.sMD5 + sLineBreak;
    SaveList.Add(ModuleInfo.sMD5 + '|' + ModuleInfo.sFileName + '|' + IntToStr(BoolToInt(ModuleInfo.boMode)));
  end;

  g_ModuleListTextLen := Length(StrModuleList);
  g_ModuleListText := zLibCompressString(StrModuleList);
  g_ModuleListTextCRC := BufferCrc(PAnsiChar(g_ModuleListText), Length(g_ModuleListText));

  try
    SaveList.SaveToFile(sFileName);
  except
  end;
  SaveList.Free;
end;

