function GetItemTypeOfBind(Item: pTStdItem; Loop: Integer): TUnBindItemType;

  function GetItemfUnBindType(Item: pTStdItem): TUnBindItemType;
  var
    nAC, nMAC: Int64;
  begin
    Result := t_UnKnow;
    if (Item.StdMode <= 3) or (Item.StdMode = 25) then
    begin
      if Item.StdMode = 0 then
      begin
        // 21亿支持 chongchong 2015-02-09
        nAC := Item.AC1;
        nMAC := Item.MAC1;
        if (Item.Shape = 0) and (nAC > 0) and (nMAC = 0) then
        begin // 红药
          Result := t_HP;
        end
        else if (Item.Shape = 0) and (nAC = 0) and (nMAC > 0) then
        begin
          Result := t_MP;
        end
        else if (Item.Shape = 1) and (nAC > 0) and (nMAC > 0) then
        begin
          Result := t_Special;
        end;
      end
      else if (Item.StdMode = 25) then
      begin
        if Item.Shape = 5 then
          Result := t_Bujuk
        else
          Result := t_Poison;
      end
      else
      begin
        Result := t_Book;
      end;
    end;
  end;

var
  i: Integer;
  StdItem: pTStdItem;
begin
  Result := t_UnKnow;

  for i := 0 to UserEngine.StdItemList.Count - 1 do
  begin
    StdItem := UserEngine.StdItemList.Items[i];
    if (StdItem.AniCount = Item.Shape) then
    begin
      if (StdItem.StdMode = 31) then
      begin
        if Loop >= 4 then
          Exit;
        Inc(Loop);
        Result := GetItemTypeOfBind(StdItem, Loop);
        if Result <> t_UnKnow then
          Exit;
      end
      else if (StdItem.StdMode <= 3) or (StdItem.StdMode = 25) then
      begin
        Result := GetItemfUnBindType(StdItem);
        Exit;
      end;
    end;
  end;
end;

function GetItemTypeOfUnBind(Item: pTStdItem): TUnBindItemType;
var
  nAC, nMAC: Int64;
begin
  Result := t_UnKnow;
  if (Item.StdMode <= 3) or (Item.StdMode = 25) then
  begin
    if Item.StdMode = 0 then
    begin
      // 21亿支持 chongchong 2015-02-09
      nAC := Item.AC1;
      nMAC := Item.MAC1;

      if (Item.Shape = 0) and (nAC > 0) and (nMAC = 0) then
      begin // 红药
        Result := t_HP;
      end
      else if (Item.Shape = 0) and (nAC = 0) and (nMAC > 0) then
      begin
        Result := t_MP;
      end
      else if (Item.Shape = 1) and (nAC > 0) and (nMAC > 0) then
      begin
        Result := t_Special;
      end;
    end
    else if (Item.StdMode = 25) then
    begin
      if Item.Shape = 5 then
        Result := t_Bujuk
      else
        Result := t_Poison;
    end
    else
    begin
      Result := t_Book;
    end;
    Exit;
  end;

  if (Item.StdMode = 31) then
    Result := GetItemTypeOfBind(Item, 1);
end;

function LoadBindItemTypeFromUnbindList(): Boolean;

  procedure AddBindItemType(sItemName: string; nShape: Integer; nCount: Integer);
  var
    i: Integer;
    StdItem: pTStdItem;
    UnBindItem: pTUnBindItem;
    UnBindItemType: TUnBindItemType;
  begin
    if g_MultiThreadRun then
      UserEngine.StdItemList.LockR(11);
    try
      for i := 0 to UserEngine.StdItemList.Count - 1 do
      begin
        StdItem := UserEngine.StdItemList.Items[i];
        if (CompareText(StdItem.Name, sItemName) = 0) then
        begin
          UnBindItemType := GetItemTypeOfUnBind(StdItem);
          if UnBindItemType <> t_UnKnow then
          begin
            New(UnBindItem);
            FillChar(UnBindItem^, SizeOf(TUnBindItem), 0);
            UnBindItem.sItemName := StdItem.Name;
            UnBindItem.nStdMode := StdItem.StdMode;
            UnBindItem.nShape := StdItem.AniCount;
            UnBindItem.UnBindItemType := UnBindItemType;
            UnBindItem.nCount := nCount;
            g_BindItemTypeList.Add(UnBindItem);
            Break;
          end;
        end;
      end;
    finally
      if g_MultiThreadRun then
        UserEngine.StdItemList.UnLockR;
    end;
  end;

var
  i: Integer;
  CRC: LongWord;
  UnBindItem: pTUnBindItem;
  InBuf: array [0 .. 102400] of AnsiChar;
  InBytes: Integer;
  buffer: PAnsiChar;
  UnbindItemInfo: pTUnbindItemInfo;
begin
  if UserEngine <> nil then
  begin
    if g_BindItemTypeList <> nil then
    begin
      for i := 0 to g_BindItemTypeList.Count - 1 do
      begin
        Dispose(pTUnBindItem(g_BindItemTypeList.Items[i]));
      end;
      g_BindItemTypeList.Clear;
    end;
    if g_BindItemTypeList = nil then
      g_BindItemTypeList := TList.Create;

    // 解包物品扩展 chongchong 2014-05-15
    for i := 0 to g_UnbindList.Count - 1 do
    begin
      UnbindItemInfo := g_UnbindList.Items[i];
      AddBindItemType(UnbindItemInfo.sItemName, UnbindItemInfo.nShape, UnbindItemInfo.nCount);
    end;
  end;

  g_UnBindItemListText := '';
  g_UnBindItemListTextLen := 0;
  // g_UnBindItemListTextCRC := 0;

  InBytes := g_BindItemTypeList.Count * SizeOf(TUnBindItem);
  buffer := @InBuf;
  for i := 0 to g_BindItemTypeList.Count - 1 do
  begin
    UnBindItem := g_BindItemTypeList.Items[i];
    Move(UnBindItem^, buffer^, SizeOf(TUnBindItem));
    buffer := buffer + SizeOf(TUnBindItem);
  end;

  g_UnBindItemListTextLen := InBytes;
  g_UnBindItemListText := zLibCompressBuffer(@InBuf[0], InBytes);
  CRC := BufferCrc(PAnsiChar(g_UnBindItemListText), Length(g_UnBindItemListText));
  Result := CRC <> g_UnBindItemListTextCRC;
  g_UnBindItemListTextCRC := CRC;
end;

function GetBindItemType(nShape: Integer): TUnBindItemType;
var
  i: Integer;
  UnBindItem: pTUnBindItem;
begin
  Result := t_UnKnow;
  if g_BindItemTypeList <> nil then
  begin
    for i := 0 to g_BindItemTypeList.Count - 1 do
    begin
      UnBindItem := g_BindItemTypeList.Items[i];
      if (UnBindItem.nStdMode = 0) and (UnBindItem.nShape = nShape) then
      begin
        Result := UnBindItem.UnBindItemType;
        Break;
      end;
    end;
  end;
end;

procedure LoadSpecialCmdList();
var
  i: Integer;
  ClientCmd: pTClientCmd;
  LoadList: TStringList;
  sFileName: string;
  sLineText, sCaption, sCmd: string;
  InBuf: array [0 .. 102400] of AnsiChar;
  InBytes: Integer;
  buffer: PAnsiChar;
begin
  InBytes := 0;
  g_SpecialCmdListText := '';
  g_SpecialCmdListTextLen := 0;
  g_SpecialCmdListTextCRC := 0;

  sFileName := g_Config.sEnvirDir + 'SpecialCmdList.txt';
  LoadList := TStringList.Create;

  if g_SpecialCmdList <> nil then
  begin
    for i := 0 to g_SpecialCmdList.Count - 1 do
      Dispose(pTClientCmd(g_SpecialCmdList.Items[i]));

    g_SpecialCmdList.Clear;
  end;

  if g_SpecialCmdList = nil then
    g_SpecialCmdList := TList.Create;

  if FileExists(sFileName) then
  begin
    LoadList.LoadFromFile(sFileName);

    buffer := @InBuf;
    for i := 0 to LoadList.Count - 1 do
    begin
      sLineText := Trim(LoadList.Strings[i]);
      if (sLineText = '') or (sLineText[1] = ';') then
        Continue;

      sLineText := GetValidStr3(sLineText, sCaption, [ { ' ', ',', } #9]);
      sLineText := GetValidStr3(sLineText, sCmd, [ { ' ', ',', } #9]);
      if sCaption <> '' then
      begin
        New(ClientCmd);
        ClientCmd.sCaption := sCaption;
        ClientCmd.sCmd := sCmd;
        g_SpecialCmdList.Add(ClientCmd);
        Move(ClientCmd^, buffer^, SizeOf(TClientCmd));
        buffer := buffer + SizeOf(TClientCmd);
        Inc(InBytes, SizeOf(TClientCmd));
      end;
    end;
  end;

  g_SpecialCmdListTextLen := InBytes;
  g_SpecialCmdListText := EncodeBuffer(@InBuf, InBytes);
  g_SpecialCmdListTextCRC := BufferCrc(PAnsiChar(g_SpecialCmdListText), Length(g_SpecialCmdListText));
  LoadList.Free;
end;

