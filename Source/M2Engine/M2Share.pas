procedure LoadFoundryItemList();
var
  i, ii: Integer;
  sFileName: string;
  sLineText: string;
  sItemName: string;
  sItemCount: string;
  sItemRate: string;
  sNeedItemName: string;
  sNeedItemCount: string;
  sDeleteItem: string;
  nItemCount: Integer;
  nItemRate: Integer;
  nNeedItemCount: Integer;
  nDeleteItem: Integer;
  FoundryItem: pTFoundryItem;
  FoundryNeedItem: pTFoundryNeedItem;
  LoadList: TStringList;
begin
  if g_FoundryItemList <> nil then
  begin
    for i := 0 to g_FoundryItemList.Count - 1 do
    begin
      FoundryItem := g_FoundryItemList.Items[i];
      for ii := 0 to FoundryItem.ItemList.Count - 1 do
      begin
        FoundryNeedItem := FoundryItem.ItemList.Items[ii];
        Dispose(FoundryNeedItem);
      end;
      FoundryItem.ItemList.Free;
      Dispose(FoundryItem);
    end;
    FreeAndNil(g_FoundryItemList);
  end;
  g_FoundryItemList := TList.Create;

  sFileName := g_Config.sEnvirDir + 'FoundryList.txt';
  if FileExists(sFileName) then
  begin
    LoadList := TStringList.Create;
    try
      LoadList.LoadFromFile(sFileName);
    except

    end;
    for i := 0 to LoadList.Count - 1 do
    begin
      sLineText := Trim(LoadList.Strings[i]);
      if (sLineText = '') or (sLineText[1] = ';') then
        Continue;
      sLineText := GetValidStr3_Ex(sLineText, sItemName, ' ');
      sLineText := GetValidStr3_Ex(sLineText, sItemCount, ' ');
      sLineText := GetValidStr3_Ex(sLineText, sItemRate, ' ');
      nItemCount := StrToIntDef(sItemCount, 0);
      nItemRate := StrToIntDef(sItemRate, -1);
      if (sItemName <> '') and (nItemCount > 0) and (nItemRate >= 0) then
      begin
        New(FoundryItem);
        FoundryItem.sItemName := sItemName;
        FoundryItem.nItemCount := nItemCount;
        FoundryItem.nItemRate := nItemRate;
        FoundryItem.ItemList := TList.Create;
        g_FoundryItemList.Add(FoundryItem);
        while True do
        begin
          sLineText := GetValidStr3_Ex(sLineText, sNeedItemName, ' ');
          sLineText := GetValidStr3_Ex(sLineText, sNeedItemCount, ' ');
          sLineText := GetValidStr3_Ex(sLineText, sDeleteItem, ' ');
          nNeedItemCount := StrToIntDef(sNeedItemCount, 0);
          nDeleteItem := StrToIntDef(sDeleteItem, -1);
          if (sNeedItemName <> '') and (nNeedItemCount > 0) and (nDeleteItem in [0, 1]) then
          begin
            New(FoundryNeedItem);
            FoundryNeedItem.sItemName := sNeedItemName;
            FoundryNeedItem.nItemCount := nNeedItemCount;
            FoundryNeedItem.btDelete := nDeleteItem;
            FoundryItem.ItemList.Add(FoundryNeedItem);
          end
          else
            Break;
        end;
      end;
    end;
    LoadList.Free;
  end;
end;

