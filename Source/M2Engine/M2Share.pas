procedure LoadGlobalVal;
var
  i, nLoadInteger: Integer;
  sLoadString: string;
begin
  FillChar(g_Config.GlobalVal, SizeOf(g_Config.GlobalVal), 0);

  for i := Low(g_Config.GlobalVal) to High(g_Config.GlobalVal) do
  begin
    nLoadInteger := GlobalValConfig.ReadInteger('Setup', 'GlobalVal' + IntToStr(i), -1);
    if nLoadInteger < 0 then
      GlobalValConfig.WriteInteger('Setup', 'GlobalVal' + IntToStr(i), g_Config.GlobalVal[i])
    else
      g_Config.GlobalVal[i] := nLoadInteger;

    g_Config.OldGlobalVal[i] := g_Config.GlobalVal[i];
  end;

  FillChar(g_Config.GlobalAVal, SizeOf(g_Config.GlobalAVal), #0);
  for i := Low(g_Config.GlobalAVal) to High(g_Config.GlobalAVal) do
  begin
    sLoadString := GlobalValConfig.ReadString('Setup', 'GlobalStrVal' + IntToStr(i), '');
    if sLoadString = '' then
      GlobalValConfig.WriteString('Setup', 'GlobalStrVal' + IntToStr(i), '')
    else
      g_Config.GlobalAVal[i] := sLoadString;

    g_Config.OldGlobalAVal[i] := g_Config.GlobalAVal[i];
  end;
end;

procedure RebuildCustomItemPropertyConfig;
var
  i: Integer;
  S: AnsiString;
begin
  SetLength(S, SizeOf(g_CustomItemPropertyChecks));
  Move(g_CustomItemPropertyChecks[1], S[1], SizeOf(g_CustomItemPropertyChecks));

  for i := Low(g_CustomItemPropertyBindNames) to High(g_CustomItemPropertyBindNames) do
  begin
    S := S + g_CustomItemPropertyBindNames[i] + sLineBreak;
  end;

  g_CustomItemPropertyLen := Length(S);
  g_CustomItemPropertyText := zLibCompressBuffer(PAnsiChar(S), g_CustomItemPropertyLen);
  g_CustomItemPropertyCRC := BufferCrc(PAnsiChar(g_CustomItemPropertyText), Length(g_CustomItemPropertyText));
end;

procedure LoadCustomItemPropertyConfig;
var
  i: Integer;
begin
  for i := Low(g_CustomItemPropertyBindNames) to High(g_CustomItemPropertyBindNames) do
  begin
    g_CustomItemPropertyChecks[i] := Config.ReadBool('Setup', 'CustomItemPropertyCheck' + IntToStr(i),
      g_CustomItemPropertyChecks[i]);
    g_CustomItemPropertyBindNames[i] := Config.ReadString('Setup', 'CustomItemPropertyBindName' + IntToStr(i),
      g_CustomItemPropertyBindNames[i]);
  end;

  RebuildCustomItemPropertyConfig;
end;

procedure LoadBaseAbilConfig;
var
  nJob, nLevel: Integer;
  sFileName, sSection, sLevel: string;
  Ini: TIniFileEx;
  BaseAbil: PBaseAbilInfo;
begin
  FillChar(g_BaseAbilConfig, SizeOf(g_BaseAbilConfig), 0);

  g_BaseAbilConfig.UseDefault := True;

  sFileName := g_sSelfFilePath + sBaseAbilConfigFileName;
  (*
    if not FileExists(sFileName) then
    begin

    end;
  *)

  Ini := TIniFileEx.Create(sFileName);
  try
    g_BaseAbilConfig.UseDefault := Ini.ReadBool('Setup', 'UseDefault', True);

    for nJob := JOB_WARR to JOB_TAOS do
    begin
      g_BaseAbilConfig.HumAbil[nJob].AutoCalcLevel1000 := True;

      sSection := 'Hum_' + IntToStr(nJob);

      g_BaseAbilConfig.HumAbil[nJob].AutoCalcLevel1000 := Ini.ReadBool(sSection, 'AutoCalcLevel1000', True);

      for nLevel := Low(g_BaseAbilConfig.HumAbil[nJob].Base) to High(g_BaseAbilConfig.HumAbil[nJob].Base) do
      begin
        BaseAbil := @g_BaseAbilConfig.HumAbil[nJob].Base[nLevel];

        sLevel := IntToStr(nLevel + 1);

        BaseAbil.AC1 := Ini.ReadInteger(sSection, 'AC1_' + sLevel, BaseAbil.AC1);
        BaseAbil.AC2 := Ini.ReadInteger(sSection, 'AC2_' + sLevel, BaseAbil.AC2);
        BaseAbil.MAC1 := Ini.ReadInteger(sSection, 'MAC1_' + sLevel, BaseAbil.MAC1);
        BaseAbil.MAC2 := Ini.ReadInteger(sSection, 'MAC2_' + sLevel, BaseAbil.MAC2);
        BaseAbil.DC1 := Ini.ReadInteger(sSection, 'DC1_' + sLevel, BaseAbil.DC1);
        BaseAbil.DC2 := Ini.ReadInteger(sSection, 'DC2_' + sLevel, BaseAbil.DC2);
        BaseAbil.MC1 := Ini.ReadInteger(sSection, 'MC1_' + sLevel, BaseAbil.MC1);
        BaseAbil.MC2 := Ini.ReadInteger(sSection, 'MC2_' + sLevel, BaseAbil.MC2);
        BaseAbil.SC1 := Ini.ReadInteger(sSection, 'SC1_' + sLevel, BaseAbil.SC1);
        BaseAbil.SC2 := Ini.ReadInteger(sSection, 'SC2_' + sLevel, BaseAbil.SC2);
        BaseAbil.MaxHP := Ini.ReadInteger(sSection, 'MaxHP_' + sLevel, BaseAbil.MaxHP);
        BaseAbil.MaxMP := Ini.ReadInteger(sSection, 'MaxMP_' + sLevel, BaseAbil.MaxMP);

        BaseAbil.MaxWeight := Ini.ReadInteger(sSection, 'MaxWeight_' + sLevel, BaseAbil.MaxWeight);
        BaseAbil.MaxWearWeight := Ini.ReadInteger(sSection, 'MaxWearWeight_' + sLevel, BaseAbil.MaxWearWeight);
        BaseAbil.MaxHandWeight := Ini.ReadInteger(sSection, 'MaxHandWeight_' + sLevel, BaseAbil.MaxHandWeight);
      end;

      BaseAbil := @g_BaseAbilConfig.HumAbil[nJob].Add;
      BaseAbil.AC1 := Ini.ReadInteger(sSection, 'AddAC1', BaseAbil.AC1);
      BaseAbil.AC2 := Ini.ReadInteger(sSection, 'AddAC2', BaseAbil.AC2);
      BaseAbil.MAC1 := Ini.ReadInteger(sSection, 'AddMAC1', BaseAbil.MAC1);
      BaseAbil.MAC2 := Ini.ReadInteger(sSection, 'AddMAC2', BaseAbil.MAC2);
      BaseAbil.DC1 := Ini.ReadInteger(sSection, 'AddDC1', BaseAbil.DC1);
      BaseAbil.DC2 := Ini.ReadInteger(sSection, 'AddDC2', BaseAbil.DC2);
      BaseAbil.MC1 := Ini.ReadInteger(sSection, 'AddMC1', BaseAbil.MC1);
      BaseAbil.MC2 := Ini.ReadInteger(sSection, 'AddMC2', BaseAbil.MC2);
      BaseAbil.SC1 := Ini.ReadInteger(sSection, 'AddSC1', BaseAbil.SC1);
      BaseAbil.SC2 := Ini.ReadInteger(sSection, 'AddSC2', BaseAbil.SC2);
      BaseAbil.MaxHP := Ini.ReadInteger(sSection, 'AddMaxHP', BaseAbil.MaxHP);
      BaseAbil.MaxMP := Ini.ReadInteger(sSection, 'AddMaxMP', BaseAbil.MaxMP);

      BaseAbil.MaxWeight := Ini.ReadInteger(sSection, 'AddMaxWeight', BaseAbil.MaxWeight);
      BaseAbil.MaxWearWeight := Ini.ReadInteger(sSection, 'AddMaxWearWeight', BaseAbil.MaxWearWeight);
      BaseAbil.MaxHandWeight := Ini.ReadInteger(sSection, 'AddMaxHandWeight', BaseAbil.MaxHandWeight);
    end;

    for nJob := JOB_WARR to JOB_TAOS do
    begin
      g_BaseAbilConfig.HeroAbil[nJob].AutoCalcLevel1000 := True;

      sSection := 'Hero_' + IntToStr(nJob);

      g_BaseAbilConfig.HeroAbil[nJob].AutoCalcLevel1000 := Ini.ReadBool(sSection, 'AutoCalcLevel1000', True);

      for nLevel := Low(g_BaseAbilConfig.HeroAbil[nJob].Base) to High(g_BaseAbilConfig.HeroAbil[nJob].Base) do
      begin
        BaseAbil := @g_BaseAbilConfig.HeroAbil[nJob].Base[nLevel];

        sLevel := IntToStr(nLevel + 1);

        BaseAbil.AC1 := Ini.ReadInteger(sSection, 'AC1_' + sLevel, BaseAbil.AC1);
        BaseAbil.AC2 := Ini.ReadInteger(sSection, 'AC2_' + sLevel, BaseAbil.AC2);
        BaseAbil.MAC1 := Ini.ReadInteger(sSection, 'MAC1_' + sLevel, BaseAbil.MAC1);
        BaseAbil.MAC2 := Ini.ReadInteger(sSection, 'MAC2_' + sLevel, BaseAbil.MAC2);
        BaseAbil.DC1 := Ini.ReadInteger(sSection, 'DC1_' + sLevel, BaseAbil.DC1);
        BaseAbil.DC2 := Ini.ReadInteger(sSection, 'DC2_' + sLevel, BaseAbil.DC2);
        BaseAbil.MC1 := Ini.ReadInteger(sSection, 'MC1_' + sLevel, BaseAbil.MC1);
        BaseAbil.MC2 := Ini.ReadInteger(sSection, 'MC2_' + sLevel, BaseAbil.MC2);
        BaseAbil.SC1 := Ini.ReadInteger(sSection, 'SC1_' + sLevel, BaseAbil.SC1);
        BaseAbil.SC2 := Ini.ReadInteger(sSection, 'SC2_' + sLevel, BaseAbil.SC2);
        BaseAbil.MaxHP := Ini.ReadInteger(sSection, 'MaxHP_' + sLevel, BaseAbil.MaxHP);
        BaseAbil.MaxMP := Ini.ReadInteger(sSection, 'MaxMP_' + sLevel, BaseAbil.MaxMP);

        BaseAbil.MaxWeight := Ini.ReadInteger(sSection, 'MaxWeight_' + sLevel, BaseAbil.MaxWeight);
        BaseAbil.MaxWearWeight := Ini.ReadInteger(sSection, 'MaxWearWeight_' + sLevel, BaseAbil.MaxWearWeight);
        BaseAbil.MaxHandWeight := Ini.ReadInteger(sSection, 'MaxHandWeight_' + sLevel, BaseAbil.MaxHandWeight);
      end;

      BaseAbil := @g_BaseAbilConfig.HeroAbil[nJob].Add;
      BaseAbil.AC1 := Ini.ReadInteger(sSection, 'AddAC1', BaseAbil.AC1);
      BaseAbil.AC2 := Ini.ReadInteger(sSection, 'AddAC2', BaseAbil.AC2);
      BaseAbil.MAC1 := Ini.ReadInteger(sSection, 'AddMAC1', BaseAbil.MAC1);
      BaseAbil.MAC2 := Ini.ReadInteger(sSection, 'AddMAC2', BaseAbil.MAC2);
      BaseAbil.DC1 := Ini.ReadInteger(sSection, 'AddDC1', BaseAbil.DC1);
      BaseAbil.DC2 := Ini.ReadInteger(sSection, 'AddDC2', BaseAbil.DC2);
      BaseAbil.MC1 := Ini.ReadInteger(sSection, 'AddMC1', BaseAbil.MC1);
      BaseAbil.MC2 := Ini.ReadInteger(sSection, 'AddMC2', BaseAbil.MC2);
      BaseAbil.SC1 := Ini.ReadInteger(sSection, 'AddSC1', BaseAbil.SC1);
      BaseAbil.SC2 := Ini.ReadInteger(sSection, 'AddSC2', BaseAbil.SC2);
      BaseAbil.MaxHP := Ini.ReadInteger(sSection, 'AddMaxHP', BaseAbil.MaxHP);
      BaseAbil.MaxMP := Ini.ReadInteger(sSection, 'AddMaxMP', BaseAbil.MaxMP);

      BaseAbil.MaxWeight := Ini.ReadInteger(sSection, 'AddMaxWeight', BaseAbil.MaxWeight);
      BaseAbil.MaxWearWeight := Ini.ReadInteger(sSection, 'AddMaxWearWeight', BaseAbil.MaxWearWeight);
      BaseAbil.MaxHandWeight := Ini.ReadInteger(sSection, 'AddMaxHandWeight', BaseAbil.MaxHandWeight);
    end;
  finally
    Ini.Free;
  end;
end;

procedure ResetMagicCDList();
var
  i: Integer;
  CustomMagicConfig: TCustomMagicConfig;
begin
{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun then
    g_MagicCDList.Lock;
  try
{$IFEND}
    g_MagicCDList.Clear;

    // 通用技能
    g_MagicCDList.Add(74, g_Config.dwRecallCopySelfWaitTime * 1000); // 分身术
    g_MagicCDList.Add(72, g_Config.nSkill72CD * 1000); // 乾坤大挪移
    g_MagicCDList.Add(75, g_Config.nLastSuperShiledTime * 1000); // 护体神盾
    g_MagicCDList.Add(114, g_Config.nSkill114HitWaitTime * 1000); // 倚天辟地
    // 战士
