procedure LoadItemDescList;
var
  i: Integer;
  sFileName: string;
  S: AnsiString;
begin
  g_ItemDescList.Clear;
  sFileName := g_Config.sEnvirDir + 'ItemDescList.txt';
  if FileExists(sFileName) then
  begin
    // showmessage(sFileName);
    try
      g_ItemDescList.LoadFromFile(sFileName);
    except

    end;
    // showmessage('1 '+g_ItemDescList.Text);
    for i := g_ItemDescList.Count - 1 downto 0 do
    begin
      if Trim(g_ItemDescList.Strings[i]) = '' then
      begin
        g_ItemDescList.Delete(i);
        Continue;
      end;
      if g_ItemDescList.Strings[i][1] = ';' then
      begin
        g_ItemDescList.Delete(i);
        Continue;
      end;
    end;
  end;

  S := g_ItemDescList.Text;
  g_ItemDescListTextLen := Length(S);
  g_ItemDescListText := zLibCompressString(S);
  g_ItemDescListTextCRC := BufferCrc(PAnsiChar(g_ItemDescListText), Length(g_ItemDescListText));
end;

procedure SaveItemDescList;
var
  sFileName: string;
  S: AnsiString;
begin
  sFileName := g_Config.sEnvirDir + 'ItemDescList.txt';
  try
    S := g_ItemDescList.Text;
    g_ItemDescListTextLen := Length(S);
    g_ItemDescListText := zLibCompressString(S);
    g_ItemDescListTextCRC := BufferCrc(PAnsiChar(g_ItemDescListText), Length(g_ItemDescListText));

    g_ItemDescList.SaveToFile(sFileName);
  except

  end;
end;

