procedure LoadPoisonWeaponList; // HeroM2毒素武器
var
  i: Integer;
  LoadList: TStringList;
  sFileName, sLineText: string;
  sItemName: string;
  sRate: string;
  sDamageHealth: string;
  sBaseTime: string;
  sRandomTime: string;
  PoisonWeapon: pTPoisonWeapon;
  nDamageHealth: Integer;
  nBaseTime: Integer;
begin
  sFileName := g_Config.sEnvirDir + 'UserData\PoisonWeapon.txt';

  if FileExists(sFileName) then
  begin
    g_PoisonWeaponList.Lock;
    try
      for i := 0 to g_PoisonWeaponList.Count - 1 do
      begin
        PoisonWeapon := pTPoisonWeapon(g_PoisonWeaponList.Objects[i]);
        Dispose(PoisonWeapon);
      end;
      g_PoisonWeaponList.Clear;

      LoadList := TStringList.Create;
      try
        LoadList.LoadFromFile(sFileName);
        for i := 0 to LoadList.Count - 1 do
        begin
          sLineText := LoadList.Strings[i];
          if (sLineText = '') or (sLineText[1] = ';') then
            Continue;
          sLineText := GetValidStr3(sLineText, sItemName, [' ', #9]);
          sLineText := GetValidStr3(sLineText, sRate, [' ', #9]);
          sLineText := GetValidStr3(sLineText, sDamageHealth, [' ', #9]);
          sLineText := GetValidStr3(sLineText, sBaseTime, [' ', #9]);
          sLineText := GetValidStr3(sLineText, sRandomTime, [' ', #9]);
          nDamageHealth := StrToInt64Def(sDamageHealth, 0);
          nBaseTime := StrToInt64Def(sBaseTime, 0);
          if (sItemName <> '') and (nDamageHealth > 0) and (nBaseTime > 0) and (g_PoisonWeaponList.IndexOf(sItemName) < 0) then
          begin
            New(PoisonWeapon);
            PoisonWeapon.sItemName := sItemName;
            PoisonWeapon.nRate := StrToIntDef(sRate, 0);
            PoisonWeapon.nDamageHealth := nDamageHealth;
            PoisonWeapon.nBaseTime := nBaseTime;
            PoisonWeapon.nRandomTime := StrToInt64Def(sRandomTime, 0);
            g_PoisonWeaponList.AddObject(sItemName, TObject(PoisonWeapon));
          end;
        end;

        g_PoisonWeaponList.Sorted := True;
      finally
        { TODO -ochongchong -c内存泄露 : 去内存泄露 【2013-07-18】 }
        LoadList.Free;
      end;
    finally
      g_PoisonWeaponList.UnLock;
    end;
  end
  else
  begin
    LoadList := TStringList.Create;
    try
      LoadList.Add(';武器名称 成功几率 减HP值 基本时间 扩展时间');
      LoadList.Add(';成功率100以下时设置多少就是多少的成功率例如:80就是80%的成功率50就是50%的成功率');
      LoadList.Add(';扩展时间是一个随即值,假如设置为10那么它的值就是1-10之间的值. 持续时间=基本时间+扩展时间所产生的随机值');
      LoadList.Add(';例如:木剑 90 10 10 5');
      try
        LoadList.SaveToFile(sFileName);
      except

      end;
    finally
      LoadList.Free;
    end;
  end;
end;

