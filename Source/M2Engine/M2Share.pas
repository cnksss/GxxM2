procedure LoadExp();
var
  i: Integer;
  LoadInteger: Integer;
  LoadString: string;
  Int64Value: Int64;
begin
  LoadInteger := ExpConfig.ReadInteger('Exp', 'HighLevel', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Exp', 'HighLevel', g_Config.nHighLevel)
  else
    g_Config.nHighLevel := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Exp', 'HighLevelGetExp', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Exp', 'HighLevelGetExp', g_Config.nHighLevelGetExp)
  else
    g_Config.nHighLevelGetExp := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Exp', 'MaxUpLevelCount', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Exp', 'MaxUpLevelCount', g_Config.nMaxUpLevelCount)
  else
    g_Config.nMaxUpLevelCount := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Exp', 'LimitChangeExp', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteBool('Exp', 'LimitChangeExp', g_Config.boLimitChangeExp)
  else
    g_Config.boLimitChangeExp := LoadInteger <> 0;

  LoadInteger := ExpConfig.ReadInteger('Exp', 'KillMonExpMultiple', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Exp', 'KillMonExpMultiple', g_Config.dwKillMonExpMultiple)
  else
    g_Config.dwKillMonExpMultiple := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Exp', 'HighLevelKillMonFixExp', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteBool('Exp', 'HighLevelKillMonFixExp', g_Config.boHighLevelKillMonFixExp)
  else
    g_Config.boHighLevelKillMonFixExp := LoadInteger <> 0;

  LoadInteger := ExpConfig.ReadInteger('Exp', 'UseFixExp', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteBool('Exp', 'UseFixExp', g_Config.boUseFixExp)
  else
    g_Config.boUseFixExp := LoadInteger <> 0;

  LoadInteger := ExpConfig.ReadInteger('Exp', 'BaseExp', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Exp', 'BaseExp', g_Config.nBaseExp)
  else
    g_Config.nBaseExp := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Exp', 'AddExp', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Exp', 'AddExp', g_Config.nAddExp)
  else
    g_Config.nAddExp := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Exp', 'HighLevelGroupFixExp', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteBool('Exp', 'HighLevelGroupFixExp', g_Config.boHighLevelGroupFixExp)
  else
    g_Config.boHighLevelGroupFixExp := LoadInteger <> 0;

  for i := 1 to MAXCHANGELEVEL do
  begin
    LoadString := ExpConfig.ReadString('Exp', 'Level' + IntToStr(i), '');
    Int64Value := StrToInt64Def(LoadString, 0);
    LoadInteger := Max(0, Min(Int64Value, High(LongWord)));
    if LoadInteger = 0 then
    begin
      ExpConfig.WriteString('Exp', 'Level' + IntToStr(i), IntToStr(g_dwOldNeedExps[i]));
      g_Config.dwNeedExps[i] := g_dwOldNeedExps[i];
    end
    else
    begin
      g_Config.dwNeedExps[i] := LongWord(LoadInteger);
    end;
  end;

  for i := 1 to MAXCHANGELEVEL do
  begin
    LoadString := ExpConfig.ReadString('Exp', 'LevelExpRate' + IntToStr(i), '');
    if LoadString = '' then
    begin
      ExpConfig.WriteInteger('Exp', 'LevelExpRate' + IntToStr(i), 0);
    end;
    g_Config.LevelExpRates[i] := ExpConfig.ReadInteger('Exp', 'LevelExpRate' + IntToStr(i), 0);
  end;

  for i := 1 to MAXCHANGELEVEL do
  begin
    LoadString := ExpConfig.ReadString('HeroExp', 'Level' + IntToStr(i), '');
    Int64Value := StrToInt64Def(LoadString, 0);
    LoadInteger := Max(0, Min(Int64Value, High(LongWord)));

    if LoadInteger = 0 then
    begin
      ExpConfig.WriteString('HeroExp', 'Level' + IntToStr(i), IntToStr(g_dwOldHeroNeedExps[i]));
      g_Config.dwHeroNeedExps[i] := g_dwOldHeroNeedExps[i];
    end
    else
    begin
      g_Config.dwHeroNeedExps[i] := LongWord(LoadInteger)
    end;
  end;

  for i := 1 to MAXCHANGELEVEL do
  begin
    LoadString := ExpConfig.ReadString('GamePetExp', 'Level' + IntToStr(i), '');
    Int64Value := StrToInt64Def(LoadString, 0);
    LoadInteger := Max(0, Min(Int64Value, High(LongWord)));

    if LoadInteger = 0 then
    begin
      ExpConfig.WriteString('GamePetExp', 'Level' + IntToStr(i), IntToStr(g_dwOldHeroNeedExps[i]));
      g_Config.dwPetNeedExps[i] := g_dwOldHeroNeedExps[i];
    end
    else
    begin
      g_Config.dwPetNeedExps[i] := LongWord(LoadInteger)
    end;
  end;

  // 药力值 20080623
  for i := 1 to MAXCHANGELEVEL do
  begin
    LoadString := ExpConfig.ReadString('MedicineExp', 'Level' + IntToStr(i), '');
    LoadInteger := StrToIntDef(LoadString, 0);
    if LoadInteger = 0 then
    begin
      ExpConfig.WriteString('MedicineExp', 'Level' + IntToStr(i), IntToStr(g_dwMedicineExps[i]));
      g_Config.dwMedicineLevelNeedExps[i] := g_dwMedicineExps[i];
    end
    else
    begin
      if (LoadInteger > 0) then
        g_Config.dwMedicineLevelNeedExps[i] := LoadInteger
      else
        g_Config.dwMedicineLevelNeedExps[i] := g_dwMedicineExps[i];
    end;
  end;

  // ----------------------------------------------------------------------------
  // 酒气护体 20080625
  for i := 1 to 100 do
  begin
    LoadString := ExpConfig.ReadString('WineExp', 'Level' + IntToStr(i), '');
    LoadInteger := StrToIntDef(LoadString, 0);
    if LoadInteger = 0 then
    begin
      ExpConfig.WriteString('WineExp', 'Level' + IntToStr(i), IntToStr(g_dwWineLevelNeedExps[i]));
      g_Config.dwWineLevelNeedExps[i] := g_dwWineLevelNeedExps[i];
    end
    else
    begin
      if (LoadInteger > 0) then
        g_Config.dwWineLevelNeedExps[i] := LoadInteger
      else
        g_Config.dwWineLevelNeedExps[i] := g_dwWineLevelNeedExps[i];
    end;
  end;

  LoadInteger := ExpConfig.ReadInteger('Setup', 'IncAlcoholTime', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Setup', 'IncAlcoholTime', g_Config.nIncAlcoholTime)
  else
    g_Config.nIncAlcoholTime := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Setup', 'DecDrinkTime', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Setup', 'DecDrinkTime', g_Config.nDecDrinkTime)
  else
    g_Config.nDecDrinkTime := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Setup', 'MaxAlcoholValue', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Setup', 'MaxAlcoholValue', g_Config.nMaxAlcoholValue)
  else
    g_Config.nMaxAlcoholValue := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Setup', 'IncAlcoholValue', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Setup', 'IncAlcoholValue', g_Config.nIncAlcoholValue)
  else
    g_Config.nIncAlcoholValue := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Setup', 'DecMedicineValue', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Setup', 'DecMedicineValue', g_Config.nDecMedicineValue)
  else
    g_Config.nDecMedicineValue := LoadInteger;

  LoadInteger := ExpConfig.ReadInteger('Setup', 'DecMedicineTime', -1);
  if LoadInteger < 0 then
    ExpConfig.WriteInteger('Setup', 'DecMedicineTime', g_Config.nDecMedicineTime)
  else
    g_Config.nDecMedicineTime := LoadInteger;

  // 分经验 - 组队不需要在同一屏幕 chongchong 2013-08-17
  if ExpConfig.ReadInteger('Setup', 'ShareExpGroupSameScreen', -1) < 0 then
    ExpConfig.WriteBool('Setup', 'ShareExpGroupSameScreen', g_Config.boShareExpGroupSameScreen);
  g_Config.boShareExpGroupSameScreen := ExpConfig.ReadBool('Setup', 'ShareExpGroupSameScreen',
    g_Config.boShareExpGroupSameScreen);

  // 分经验 - 组队不需要在同一地图 chongchong 2013-08-17
  if ExpConfig.ReadInteger('Setup', 'ShareExpGroupSameMap', -1) < 0 then
    ExpConfig.WriteBool('Setup', 'ShareExpGroupSameMap', g_Config.boShareExpGroupSameMap);
  g_Config.boShareExpGroupSameMap := ExpConfig.ReadBool('Setup', 'ShareExpGroupSameMap', g_Config.boShareExpGroupSameMap);

  // 分经验 - 英雄不需要在同一地图 chongchong 2013-08-17
  if ExpConfig.ReadInteger('Setup', 'ShareExpHeroSameMap', -1) < 0 then
    ExpConfig.WriteBool('Setup', 'ShareExpHeroSameMap', g_Config.boShareExpHeroSameMap);
  g_Config.boShareExpHeroSameMap := ExpConfig.ReadBool('Setup', 'ShareExpHeroSameMap', g_Config.boShareExpHeroSameMap);

  // 英雄最高等级限制 - 最高等级 chongchong 2013-08-17
  if ExpConfig.ReadInteger('Setup', 'HeroHighLevel', -1) < 0 then
    ExpConfig.WriteInteger('Setup', 'HeroHighLevel', g_Config.dwHeroHighLevel);
  g_Config.dwHeroHighLevel := ExpConfig.ReadInteger('Setup', 'HeroHighLevel', g_Config.dwHeroHighLevel);

  // 英雄最高等级限制 - 杀怪经验 chongchong 2013-08-17
  if ExpConfig.ReadInteger('Setup', 'HeroHighLevelGetExp', -1) < 0 then
    ExpConfig.WriteInteger('Setup', 'HeroHighLevelGetExp', g_Config.dwHeroHighLevelGetExp);
  g_Config.dwHeroHighLevelGetExp := ExpConfig.ReadInteger('Setup', 'HeroHighLevelGetExp', g_Config.dwHeroHighLevelGetExp);

  // 英雄1000级后固定经升级验值 chongchong 2013-08-17
  g_Config.dwHeroLevel1000FixedExp := ExpConfig.ReadInteger('Setup', 'HeroLevel1000FixedExp', g_Config.dwHeroLevel1000FixedExp);
end;

