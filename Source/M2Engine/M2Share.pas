procedure SendRunData();
{$J+}
const
  OnlyOne: Boolean = False;
{$J-}
var
  tmpOSStr, tmpsignStr, tmpDataStr: string;
  tmprequestSS, tmpresponseSS: TStringStream;
resourcestring
  RUN_DATA = '{"serverInfo":"%s", ' //
    + '"gamePath":"%s", ' //
    + '"m2Version":"%s", ' //
    + '"gameEdtion":"%s", ' //
    + '"serverRunningMinutes":%d, ' //
    + '"playerRegisteCount":%d, ' //
    + '"onlinePCCount":%d, ' //
    + '"onlineH5Count":%d, ' //
    + '"offlinePCCount":%d, ' //
    + '"offlineH5Count":%d, ' //
    + '"dummyCount":%d, ' //
    + '"playerPCPV":%d, ' //
    + '"playerPCUV":%d, ' //
    + '"playerH5UV":%d, ' //
    + '"playerH5PV":%d}'; //
begin
  while True do
  begin
    if not OnlyOne then
    begin
      tmpOSStr := GetOSString { RunDOS('systeminfo.exe') };
      OnlyOne := True;
    end
    else
      tmpOSStr := '';

    tmpDataStr := Format(RUN_DATA, [tmpOSStr, //
      g_sSelfFilePath.Replace('\', '/'), //
      g_Version, //
      g_Config.sServerName, //
      MinutesBetween(Now, __startTime), //
      g_AllCount, //
      g_OnlinePCCount, //
      g_OnlineH5Count, //
      g_OffinePCCount, //
      g_OffileH5Count, //
      g_DummyCount, //
      g_PCUserPV, //
      g_PCUserUV, //
      g_H5UserPV, //
      g_H5UserUV]);

    tmpsignStr := THashMD5.GetHashString('gxxWin' + tmpDataStr);
    tmprequestSS := TStringStream.Create(tmpDataStr, TEncoding.UTF8);
    tmpresponseSS := TStringStream.Create('', TEncoding.UTF8);
    ReportData.Request.CustomHeaders.Clear;
    ReportData.Request.CustomHeaders.AddValue('sign', tmpsignStr);

    try
      ReportData.Post('http://www.gxxm2.com:8088/report', tmprequestSS, tmpresponseSS);
    except
    end;

    tmpresponseSS.Free;
    tmprequestSS.Free;

    Sleep(1000 {$IFNDEF DEBUG} * 60{$ENDIF} * 5);
  end;
end;

