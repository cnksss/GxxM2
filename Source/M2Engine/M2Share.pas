function LoadMonSayMsg(): Boolean;
var
  i, ii: Integer;
  sStatus, sRate, sColor, sMonName, sSayMsg: string;
  nStatus, nRate, nColor: Integer;
  LoadList: TStringList;
  sLineText: string;
  MonSayMsg: pTMonSayMsg;
  sFileName: string;
  MonSayList: TList;
  boSearch: Boolean;
begin
  Result := False;
  sFileName := g_Config.sEnvirDir + 'MonSayMsg.txt';
  if FileExists(sFileName) then
  begin
    { TODO -ochongchong -c内存泄露 : 去内存泄露【2013-07-17】 }
    for i := 0 to g_MonSayMsgList.Count - 1 do
    begin
      MonSayList := TList(g_MonSayMsgList.Objects[i]);
      if Assigned(MonSayList) then
      begin
        for ii := 0 to MonSayList.Count - 1 do
        begin
          Dispose(pTMonSayMsg(MonSayList.Items[ii]));
        end;
        MonSayList.Free;
      end;
    end;

    g_MonSayMsgList.Clear;
    LoadList := TStringList.Create;
    LoadList.LoadFromFile(sFileName);
    for i := 0 to LoadList.Count - 1 do
    begin
      sLineText := Trim(LoadList.Strings[i]);
      if (sLineText <> '') and (sLineText[1] < ';') then
      begin
        sLineText := GetValidStr3(sLineText, sStatus, [' ', '/', ',', #9]);
        sLineText := GetValidStr3(sLineText, sRate, [' ', '/', ',', #9]);
        sLineText := GetValidStr3(sLineText, sColor, [' ', '/', ',', #9]);
        sLineText := GetValidStr3(sLineText, sMonName, [' ', '/', ',', #9]);
        sLineText := GetValidStr3(sLineText, sSayMsg, [' ', '/', ',', #9]);
        if (sStatus <> '') and (sRate <> '') and (sColor <> '') and (sMonName <> '') and (sSayMsg <> '') then
        begin
          nStatus := StrToIntDef(sStatus, -1);
          nRate := StrToIntDef(sRate, -1);
          nColor := StrToIntDef(sColor, -1);
          if (nStatus >= 0) and (nRate >= 0) and (nColor >= 0) then
          begin
            New(MonSayMsg);
            case nStatus of
              0:
                MonSayMsg.State := s_KillHuman;
              1:
                MonSayMsg.State := s_UnderFire;
              2:
                MonSayMsg.State := s_Die;
              3:
                MonSayMsg.State := s_MonGen;
            else
              MonSayMsg.State := s_UnderFire;
            end;
            case nColor of
              0:
                MonSayMsg.Color := c_Red;
              1:
                MonSayMsg.Color := c_Green;
              2:
                MonSayMsg.Color := c_Blue;
              3:
                MonSayMsg.Color := c_White;
            else
              MonSayMsg.Color := c_White;
            end;
            MonSayMsg.nRate := nRate;
            MonSayMsg.sSayMsg := sSayMsg;
            boSearch := False;
            for ii := 0 to g_MonSayMsgList.Count - 1 do
            begin
              if CompareText(g_MonSayMsgList.Strings[ii], sMonName) = 0 then
              begin
                TList(g_MonSayMsgList.Objects[ii]).Add(MonSayMsg);
                boSearch := True;
                Break;
              end;
            end;
            if not boSearch then
            begin
              MonSayList := TList.Create;
              MonSayList.Add(MonSayMsg);
              g_MonSayMsgList.AddObject(sMonName, TObject(MonSayList));
            end;
          end;
        end;
      end;
    end;

    g_MonSayMsgList.Sorted := True;
    LoadList.Free;
    Result := True;
  end;
end;

function LoadMonHPProgress(): Boolean;
var
  i: Integer;
  LoadList: TStringList;
  sFileName: string;
  sLineText: string;
  sMonName, sHPBGIndex, sHPBGX, sHPBGY, sImageIndex, sImageX, sImageY, sHPIndex, sHPX, sHPY, sShowLevel, sLevelX, sLevelY,
    sShowMonName, sMonNameX, sMonNameY, sShowHPValue, sHPValueX, sHPValueY, sShowHPPercent, sHPPercentX, sHPPercentY,
    sShowExpHinter, sExpHinterX, sExpHinterY, sHPBlockCount, sHPBlockOffsetX, sHPBlockOffsetY: string;
  sHorizAlign: string;
  MonHPProgress: pTMonHPProgress;
begin
  Result := False;
  sFileName := g_Config.sEnvirDir + 'MonHPProgress.txt';
  if not FileExists(sFileName) then
  begin
    LoadList := TStringList.Create;

    LoadList.Add(';怪物名称  背景编号  背景偏移X  背景偏移Y  图像编号  图像偏移X  图像偏移Y  ' + '血条编号  血条偏移X  血条偏移Y  显示等级(-1~255)  等级偏移X  等级偏移Y  ' +
      '怪物显名(-1~255)  名字偏移X  名字偏移Y  显示血值(-1~255)  血值偏移X  血值偏移Y  ' + '显示血量百分比(-1~255)  百分比偏移X  百分比偏移Y  ' +
      '显示怪物归属(-1~255)  归属偏移X  归属偏移Y  水平对齐(0:左;1:中;2:右)  血管数量  血管数量偏移X  血管数量偏移Y');

    LoadList.SaveToFile(sFileName);
    LoadList.Free;
    Exit;
  end;

  for i := 0 to g_MonHPProgressList.Count - 1 do
  begin
    MonHPProgress := pTMonHPProgress(g_MonHPProgressList.Objects[i]);
    Dispose(MonHPProgress);
  end;
  g_MonHPProgressList.Clear;

  LoadList := TStringList.Create;
  LoadList.LoadFromFile(sFileName);
  for i := 0 to LoadList.Count - 1 do
  begin
    sLineText := Trim(LoadList.Strings[i]);
    if (sLineText <> '') and (sLineText[1] <> ';') then
    begin
      sLineText := GetValidStr3(sLineText, sMonName, [' ', '/', ',', #9]);

      sLineText := GetValidStr3(sLineText, sHPBGIndex, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPBGX, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPBGY, [' ', '/', ',', #9]);

      sLineText := GetValidStr3(sLineText, sImageIndex, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sImageX, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sImageY, [' ', '/', ',', #9]);

      sLineText := GetValidStr3(sLineText, sHPIndex, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPX, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPY, [' ', '/', ',', #9]);

      sLineText := GetValidStr3(sLineText, sShowLevel, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sLevelX, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sLevelY, [' ', '/', ',', #9]);

      sLineText := GetValidStr3(sLineText, sShowMonName, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sMonNameX, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sMonNameY, [' ', '/', ',', #9]);

      sLineText := GetValidStr3(sLineText, sShowHPValue, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPValueX, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPValueY, [' ', '/', ',', #9]);

      sLineText := GetValidStr3(sLineText, sShowHPPercent, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPPercentX, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPPercentY, [' ', '/', ',', #9]);

      sLineText := GetValidStr3(sLineText, sShowExpHinter, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sExpHinterX, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sExpHinterY, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHorizAlign, [' ', '/', ',', #9]);

      sLineText := GetValidStr3(sLineText, sHPBlockCount, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPBlockOffsetX, [' ', '/', ',', #9]);
      sLineText := GetValidStr3(sLineText, sHPBlockOffsetY, [' ', '/', ',', #9]);

      if (sMonName <> '') and (g_MonHPProgressList.IndexOf(sMonName) < 0) then
      begin
        New(MonHPProgress);
        g_MonHPProgressList.AddObject(sMonName, TObject(MonHPProgress));

        MonHPProgress.nHPBGIndex := StrToIntDef(sHPBGIndex, 0);
        MonHPProgress.nHPBGX := StrToIntDef(sHPBGX, 0);
        MonHPProgress.nHPBGY := StrToIntDef(sHPBGY, 0);

        MonHPProgress.nImageIndex := StrToIntDef(sImageIndex, 0);
        MonHPProgress.nImageX := StrToIntDef(sImageX, 0);
        MonHPProgress.nImageY := StrToIntDef(sImageY, 0);

        MonHPProgress.nHPIndex := StrToIntDef(sHPIndex, 0);
        MonHPProgress.nHPX := StrToIntDef(sHPX, 0);
        MonHPProgress.nHPY := StrToIntDef(sHPY, 0);

        MonHPProgress.boShowLevel := StrToIntDef(sShowLevel, -1);
