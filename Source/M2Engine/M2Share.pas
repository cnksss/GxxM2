          end;

        // 私有变量 J-数字型(1天1清) chongchong 2014-10-18
        9000 .. 9499:
          begin
            VarInfo.VarType := vInteger;
            VarInfo.VarAttr := aFixVar;
          end;

        // 私有变量 Z-数字型(1天1清) chongchong 2014-10-18
        9500 .. 9999:
          begin
            VarInfo.VarType := vString;
            VarInfo.VarAttr := aFixVar;
          end;
      end;
      Exit;
    end;
    if (Length(sName) > 2) and (UpCase(sName[1]) = 'L') and (sName[2] = '$') then
    begin
      VarInfo.VarType := vString;
      VarInfo.VarAttr := aFixVar;
      Result := True;
    end
    else if (Length(sName) > 2) and (UpCase(sName[1]) = 'S') and (sName[2] = '$') then
    begin
      VarInfo.VarType := vString;
      VarInfo.VarAttr := aFixVar;
