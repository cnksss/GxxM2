procedure LoadPlayMonsterConfigList();
var
  i, ii: Integer;
  Level, NewLevel: Byte;
  Ini: TIniFile;
  Monster: pTMonInfo;
  sFileName: string;
  sUseSkill: string;
  MonsterConfig: pTPlayMonsterConfig;
begin
  if g_PlayMonsterConfigList <> nil then
  begin
    for i := 0 to g_PlayMonsterConfigList.Count - 1 do
    begin
      MonsterConfig := g_PlayMonsterConfigList.Items[i];
      MonsterConfig.Magics.Free;
      Dispose(MonsterConfig);
    end;
    FreeAndNil(g_PlayMonsterConfigList);
  end;
  g_PlayMonsterConfigList := TList.Create;

{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun then
    UserEngine.MonsterList.LockR(5);
  try
{$IFEND}
    for i := 0 to UserEngine.MonsterList.Count - 1 do
    begin
      Monster := UserEngine.MonsterList.Items[i];
      if Monster.btRace = RC_PLAYMOSTER then
      begin
        New(MonsterConfig);
        FillChar(MonsterConfig^, SizeOf(TPlayMonsterConfig), 0);
        MonsterConfig.Name := Monster.sName;
        MonsterConfig.Magics := TStringList.Create;
        g_PlayMonsterConfigList.Add(MonsterConfig);
        sFileName := g_Config.sEnvirDir + 'MonUseItems\' + Monster.sName + '.txt';
        if FileExists(sFileName) then
        begin
          Ini := TIniFile.Create(sFileName);
          if Ini <> nil then
          begin
            MonsterConfig.Job := Ini.ReadInteger('Info', 'Job', 0);
            MonsterConfig.Gender := Ini.ReadInteger('Info', 'Gender', 0);
            MonsterConfig.Hair := Ini.ReadInteger('Info', 'Hair', 0);

            // MonsterConfig.DropItem := Ini.ReadBool('Info', 'DropItem', True);
            // MonsterConfig.nDieDropItemRate := Ini.ReadInteger('Info', 'DieDropItemRate', 0);

            MonsterConfig.boDieDropUseItem := Ini.ReadBool('Info', 'DropUseItem', True);
            MonsterConfig.nDieDropUseItemRate := Ini.ReadInteger('Info', 'DieDropUseItemRate', 30);

            MonsterConfig.boDieDropBagItem := Ini.ReadBool('Info', 'DieDropBagItem', True);

            // MonsterConfig.boButchItem := Ini.ReadBool('Info', 'ButchItem', False);

            MonsterConfig.boButchUseItem := Ini.ReadBool('Info', 'ButchUseItem', False); // 挖取身上物品
            MonsterConfig.nButchUseItemRate := Ini.ReadInteger('Info', 'ButchUseItemRate', 10); // 挖取身上物品几率

            MonsterConfig.boButchListItem := Ini.ReadBool('Info', 'ButchListItem', False); // 挖取列表物品

            MonsterConfig.boButchItemTrigger := Ini.ReadBool('Info', 'ButchItemTrigger', False); // 挖取触发

            MonsterConfig.nButchChargeMode := Ini.ReadInteger('Info', 'ButchChargeMode', 0); // 挖取收费模式
            if (MonsterConfig.nButchChargeMode < 0) or (MonsterConfig.nButchChargeMode > 3) then
              MonsterConfig.nButchChargeMode := 0;
            MonsterConfig.nButchChargeCount := Ini.ReadInteger('Info', 'ButchChargeCount', 0); // 挖取收费值
            MonsterConfig.boOnlyButchItemDelGold := Ini.ReadBool('Info', 'OnlyButchItemDelGold', True);

            MonsterConfig.boProtectMode := Ini.ReadBool('Info', 'GetRestrictRange', False);
            MonsterConfig.nProtectRange := Ini.ReadInteger('Info', 'RestrictRange', 10);
            MonsterConfig.NonUseSpellPoint := Ini.ReadBool('Info', 'NonUseSpellPoint', False);

            MonsterConfig.boRunWithAttack := Ini.ReadBool('Info', 'RunWithAttack', False);
            MonsterConfig.nRunWithAttackRate := Ini.ReadInteger('Info', 'RunWithAttackRate', 10);
            MonsterConfig.boNoAttackMode := Ini.ReadBool('Info', 'NoAttackMode', False);

            sUseSkill := Ini.ReadString('Info', 'UseSkill', '');

            ExtractStrings([',', ' '], [], PChar(Trim(sUseSkill)), MonsterConfig.Magics);
            for ii := MonsterConfig.Magics.Count - 1 downto 0 do
            begin
              if (MonsterConfig.Magics.Strings[ii] = '') or (MonsterConfig.Magics.Strings[ii] = ';') or
                (UserEngine.FindMagic(MonsterConfig.Magics.Strings[ii]) = nil) then
                MonsterConfig.Magics.Delete(ii);
            end;

            for ii := 0 to MonsterConfig.Magics.Count - 1 do
            begin
              Level := Ini.ReadInteger(MonsterConfig.Magics.Strings[ii], 'Level', 0);
              NewLevel := Ini.ReadInteger(MonsterConfig.Magics.Strings[ii], 'NewLevel', 0);
              MonsterConfig.Magics.Objects[ii] := TObject(MakeWord(Level, NewLevel));
            end;

            for ii := Low(THumanUseItems) to High(THumanUseItems) do
            begin
              MonsterConfig.UseItems[ii] := Ini.ReadString('UseItems', 'UseItems' + IntToStr(ii), '');
            end;

            MonsterConfig.IsChanged := False;
            Ini.Free;
          end;
        end;
      end;
    end;
{$IF MULTI_THREAD = 1}
  finally
    if g_MultiThreadRun then
      UserEngine.MonsterList.UnLockR;
  end;
{$IFEND}
end;

procedure SavePlayMonsterConfigList();
var
  i, ii, Level: Integer;
  Ini: TIniFile;
  sFileName: string;
  sUseSkill: string;
  MonsterConfig: pTPlayMonsterConfig;
begin
  if g_PlayMonsterConfigList <> nil then
  begin
    for i := 0 to g_PlayMonsterConfigList.Count - 1 do
    begin
      MonsterConfig := g_PlayMonsterConfigList.Items[i];

      if not MonsterConfig.IsChanged then
        Continue;

      sFileName := g_Config.sEnvirDir + 'MonUseItems\' + MonsterConfig.Name + '.txt';

      Ini := TIniFile.Create(sFileName);
      if Ini <> nil then
      begin
        Ini.WriteInteger('Info', 'Job', MonsterConfig.Job);
        Ini.WriteInteger('Info', 'Gender', MonsterConfig.Gender);
        Ini.WriteInteger('Info', 'Hair', MonsterConfig.Hair);

        // Ini.WriteBool('Info', 'DropItem', MonsterConfig.DropItem);
        // Ini.WriteInteger('Info', 'DieDropItemRate', MonsterConfig.nDieDropItemRate);
        // Ini.WriteBool('Info', 'ButchItem', MonsterConfig.boButchItem);

        Ini.WriteBool('Info', 'DropUseItem', MonsterConfig.boDieDropUseItem);
        Ini.WriteInteger('Info', 'DieDropUseItemRate', MonsterConfig.nDieDropUseItemRate);

        Ini.WriteBool('Info', 'DieDropBagItem', MonsterConfig.boDieDropBagItem);

        Ini.WriteBool('Info', 'ButchUseItem', MonsterConfig.boButchUseItem); // 挖取身上物品
        Ini.WriteInteger('Info', 'ButchUseItemRate', MonsterConfig.nButchUseItemRate); // 挖取身上物品几率

        Ini.WriteBool('Info', 'ButchListItem', MonsterConfig.boButchListItem); // 挖取列表物品

        Ini.WriteBool('Info', 'ButchItemTrigger', MonsterConfig.boButchItemTrigger); // 挖取触发

        Ini.WriteInteger('Info', 'ButchChargeMode', MonsterConfig.nButchChargeMode); // 挖取收费模式
        Ini.WriteInteger('Info', 'ButchChargeCount', MonsterConfig.nButchChargeCount); // 挖取收费值
        Ini.WriteBool('Info', 'OnlyButchItemDelGold', MonsterConfig.boOnlyButchItemDelGold);

        Ini.WriteBool('Info', 'GetRestrictRange', MonsterConfig.boProtectMode);
        Ini.WriteInteger('Info', 'RestrictRange', MonsterConfig.nProtectRange);

        Ini.WriteBool('Info', 'NonUseSpellPoint', MonsterConfig.NonUseSpellPoint);
        Ini.WriteBool('Info', 'RunWithAttack', MonsterConfig.boRunWithAttack);
        Ini.WriteInteger('Info', 'RunWithAttackRate', MonsterConfig.nRunWithAttackRate);

        Ini.WriteBool('Info', 'NoAttackMode', MonsterConfig.boNoAttackMode);

        sUseSkill := '';
        for ii := 0 to MonsterConfig.Magics.Count - 1 do
        begin
          sUseSkill := sUseSkill + MonsterConfig.Magics.Strings[ii] + ',';
        end;
        Ini.WriteString('Info', 'UseSkill', sUseSkill);

        for ii := 0 to MonsterConfig.Magics.Count - 1 do
        begin
          Level := Integer(MonsterConfig.Magics.Objects[ii]);
          Ini.WriteInteger(MonsterConfig.Magics.Strings[ii], 'Level', LoByte(Level));
          Ini.WriteInteger(MonsterConfig.Magics.Strings[ii], 'NewLevel', HiByte(Level));
        end;

        for ii := Low(THumanUseItems) to High(THumanUseItems) do
        begin
          Ini.WriteString('UseItems', 'UseItems' + IntToStr(ii), MonsterConfig.UseItems[ii]);
        end;
        Ini.Free;
      end;

      MonsterConfig.IsChanged := False;
    end;
  end;
end;

