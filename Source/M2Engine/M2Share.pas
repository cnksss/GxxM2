function LoadRememberItemList(): Boolean;
var
  i: Integer;
  LoadList: TStringList;
  sFileName: string;
  sLineText, sMakeIndex, sItemName, sMapName, sID, sX, sY: string;
  nMakeIndex, nIndex, nID: Integer;
  nCurrX: Integer;
  nCurrY: Integer;
  ItemEvent: pTItemEvent;
begin
  Result := False;

  for i := 0 to g_RememberItemList.Count - 1 do
  begin
    Dispose(pTItemEvent(g_RememberItemList.Objects[i]));
  end;
  g_RememberItemList.Clear;

  sFileName := g_Config.sEnvirDir + 'RememberItemList.txt';
  if not FileExists(sFileName) then
    Exit;

  LoadList := TStringList.Create;
  try
    LoadList.LoadFromFile(sFileName);
    for i := 0 to LoadList.Count - 1 do
    begin
      sLineText := Trim(LoadList.Strings[i]);
      if (sLineText = '') or (sLineText[1] = ';') then
        Continue;
      sLineText := GetValidStr3(sLineText, sItemName, [' ', ',', #9]);
      sLineText := GetValidStr3(sLineText, sMakeIndex, [' ', ',', #9]);
      sLineText := GetValidStr3(sLineText, sID, [',', #9]);
      sLineText := GetValidStr3(sLineText, sMapName, [' ', ',', #9]);
      sLineText := GetValidStr3(sLineText, sX, [' ', ',', #9]);
      sLineText := GetValidStr3(sLineText, sY, [' ', ',', #9]);
      nMakeIndex := StrToIntDef(sMakeIndex, -1);
      nCurrX := StrToIntDef(sX, -1);
      nCurrY := StrToIntDef(sY, -1);
      nID := StrToIntDef(sID, -1);
      if (nMakeIndex > 0) and (sMapName <> '') and (nCurrX >= 0) and (nCurrY >= 0) and (nID in [0 .. 5]) then
      begin
        nIndex := g_RememberItemList.IndexOf(sMakeIndex);
        if nIndex >= 0 then
        begin
          ItemEvent := pTItemEvent(g_RememberItemList.Objects[nIndex]);
          ItemEvent.RememberItem[nID].sMapName := sMapName;
          ItemEvent.RememberItem[nID].nCurrX := nCurrX;
          ItemEvent.RememberItem[nID].nCurrY := nCurrY;
        end
        else
        begin
          New(ItemEvent);
          ItemEvent.sItemName := sItemName;
          ItemEvent.nMakeIndex := nMakeIndex;
          FillChar(ItemEvent.RememberItem, SizeOf(TRememberItem) * 6, #0);
          ItemEvent.RememberItem[nID].sMapName := sMapName;
          ItemEvent.RememberItem[nID].nCurrX := nCurrX;
          ItemEvent.RememberItem[nID].nCurrY := nCurrY;
          g_RememberItemList.AddObject(sMakeIndex, TObject(ItemEvent));
        end;
      end;
    end;
  finally
    LoadList.Free;
  end;
  g_RememberItemList.Sort;
  Result := True;
end;

function SaveRememberItemList(): Boolean;
var
  i, ii: Integer;
  SaveList: TStringList;
  sFileName: string;
  ItemEvent: pTItemEvent;
begin
  sFileName := g_Config.sEnvirDir + 'RememberItemList.txt';
  SaveList := TStringList.Create;
  // g_RememberItemList.SortString(0, g_RememberItemList.Count - 1);
  for i := 0 to g_RememberItemList.Count - 1 do
  begin
    ItemEvent := pTItemEvent(g_RememberItemList.Objects[i]);
    for ii := Low(ItemEvent.RememberItem) to High(ItemEvent.RememberItem) do
