function FindCustomMoneyBindName(CustomMoney: pTCustomMoney): pTCustomMoney;
var
  i: Integer;
  CheckMoney: pTCustomMoney;
begin
  Result := CustomMoney;
  for i := 0 to g_CustomMoneyList.Count - 1 do
  begin
    CheckMoney := g_CustomMoneyList.Items[i];
    if (CheckMoney.nGroup = CustomMoney.nGroup) and (CheckMoney.nIndex < CustomMoney.nIndex) then
    begin
      CustomMoney := CheckMoney;
      Result := CheckMoney;
    end;
  end;
end;

function GetCustomMoneyBindArr(CustomMoney: pTCustomMoney; var MoneyArray: TDynamicCustomMoneyArray): Integer;
var
  i, J: Integer;
  CheckMoney: pTCustomMoney;
begin
  J := 0;
  for i := 0 to g_CustomMoneyList.Count - 1 do
  begin
    CheckMoney := g_CustomMoneyList.Items[i];
    if (CheckMoney.nGroup = CustomMoney.nGroup) and (CheckMoney.nIndex >= CustomMoney.nIndex) then
    begin
      SetLength(MoneyArray, J + 1);
      MoneyArray[J].sName := CheckMoney.sName;
      MoneyArray[J].nGroup := CheckMoney.nGroup;
      MoneyArray[J].nIndex := CheckMoney.nIndex;
      Inc(J);
    end;
  end;
  TArray.Sort<TCustomMoney>(MoneyArray, TDelegatedComparer<TCustomMoney>.Construct(
    function(const Left, Right: TCustomMoney): Integer
    begin
      Result := (Left.nIndex - Right.nIndex);
    end));
  Result := J;
end;

function GetCustomMoneyIndexByName(sName: string; btType: Byte): Integer;
var
  i: Integer;
  Money: pTCustomMoney;
begin
  // nIdx := nIndex - 5;
  Result := -1;
  for i := 0 to g_CustomMoneyList.Count - 1 do
  begin
    Money := pTCustomMoney(g_CustomMoneyList.Items[i]);
    if Money.sName = sName then
    begin
      Result := Money.nIndex + 5;
      case btType of
        0:
          if Money.boCanMyShop then
            Exit;
        // 1: if Money.boCanGameShop then Exit;
        2:
          if Money.boCanAuction then
            Exit;
        3:
          if Money.boCanSellPlayer then
            Exit;
      end;
      Result := -1;
      Exit;
    end;
  end;
end;

function IsLogCustomMoney(nIndex: Integer): Boolean;
var
  i: Integer;
  Money: pTCustomMoney;
begin
  // nIdx := nIndex - 5;
  Result := False;
  for i := 0 to g_CustomMoneyList.Count - 1 do
  begin
    Money := pTCustomMoney(g_CustomMoneyList.Items[i]);
    if Money.nIndex = nIndex then
    begin
      Result := Money.boLog;
      Exit;
    end;
  end;
end;

function GetCustomMoneyNameByRule(nIndex: Integer; btType: Byte): string;
var
  i: Integer;
  Money: pTCustomMoney;
  nIdx: Integer;
begin
  nIdx := nIndex - 5;
  Result := '';
  for i := 0 to g_CustomMoneyList.Count - 1 do
  begin
    Money := pTCustomMoney(g_CustomMoneyList.Items[i]);
    if Money.nIndex = nIdx then
    begin
      Result := Money.sName;
      case btType of
        0:
          if Money.boCanMyShop then
            Exit;
        // 1: if Money.boCanGameShop then Exit;
        2:
          if Money.boCanAuction then
            Exit;
        3:
          if Money.boCanSellPlayer then
            Exit;
      end;
      Result := '';
      Exit;
    end;
  end;
end;

