        SaveList.Add(ItemEvent.sItemName + #9 + IntToStr(ItemEvent.nMakeIndex) + #9 + IntToStr(ii) + #9 + ItemEvent.RememberItem
          [ii].sMapName + #9 + IntToStr(ItemEvent.RememberItem[ii].nCurrX) + #9 + IntToStr(ItemEvent.RememberItem[ii].nCurrY));
      end;
    end;
  end;
  try
    SaveList.SaveToFile(sFileName);
  except
  end;

  SaveList.Free;
  Result := True;
end;

