procedure AddGameDataLog(LogAction1, LogAction2: Byte; LogActor: TBaseObject; ItemName: string; ItemMakeIndex: Integer;
TargetName: string; Data1: Integer; Data2: Integer; LogDesc: string);
const
  LogActorTypeNames: array [TLogActorType] of Char = ('0', '1', '2', '3', '4', '5', '6');
var
  W: Word;
  sMsg: string;
  WS: WideString;
  LogActorType: TLogActorType;
begin
  if LogActor = nil then
    Exit;

  if LogActor.m_btRaceServer = RC_PLAYOBJECT then
  begin
    if LogActor.m_boDummyObject then
      LogActorType := latDummyHuman
    else
      LogActorType := latHuman
  end
  else if LogActor.m_btRaceServer = RC_HEROOBJECT then
  begin
    if LogActor.m_boDummyObject then
      LogActorType := latDummyHero
    else
      LogActorType := latHero
  end
  else if LogActor.m_btRaceServer = RC_PLAYMOSTER then
  begin
    LogActorType := latPlayMonster;
  end
  else
    LogActorType := latMonster;

  // 防止日志描述过长
  WS := LogDesc;
  if Length(WS) > 100 then
    WS := Copy(WS, 1, 100);

  W := MakeWord(LogAction1, LogAction2);
  sMsg := IntToStr(W) + #9 + LogActor.m_sMapName + #9 + IntToStr(LogActor.m_nCurrX) + #9 + IntToStr(LogActor.m_nCurrY) + #9 +
    LogActor.m_sCharName + #9 + LogActorTypeNames[LogActorType] + #9 + ItemName + #9 + IntToStr(ItemMakeIndex) + #9 + TargetName +
    #9 + IntToStr(Data1) + #9 + IntToStr(Data2) + #9 + WS;

  try
    {
      // 调用插件中的日志处理函数，返回值为True 时直接退出函数，False 时使用默认函数处理游戏日志
      if g_PluginManager.HookAddGameDataLog(PChar(sMsg), Length(sMsg)) then
      begin
      Exit;
      end;
    }

    EnterCriticalSection(LogMsgCriticalSection);
    try
      LogStringList.Add(sMsg);
    finally
      LeaveCriticalSection(LogMsgCriticalSection);
    end;
  except
  end;
end;

