function LoadAutoLoadOffline(): Boolean;
var
  i: Integer;
  OffLineData: pTOffLineData;
  LoadList: TStringList;
  sLineText, sFileName, sCharName: string;
begin
  Result := False;
  if UserEngine <> nil then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      UserEngine.m_AutoLoadOfflineList.LockW(1);
    try
{$IFEND}
      if UserEngine.m_boStartAutoLoadOffline then
      begin
        MainOutMessage(Format('脱机人物已经登录，剩余(%d).', [UserEngine.m_AutoLoadOfflineList.Count]));
        Exit;
      end;
      for i := 0 to UserEngine.m_AutoLoadOfflineList.Count - 1 do
      begin
        Dispose(pTOffLineData(UserEngine.m_AutoLoadOfflineList.Items[i]));
      end;
      UserEngine.m_AutoLoadOfflineList.Clear;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        UserEngine.m_AutoLoadOfflineList.UnLockW;
    end;
{$IFEND}
    sFileName := g_Config.sEnvirDir + 'AutoLoadOffline.txt';
    LoadList := TStringList.Create;
    if FileExists(sFileName) then
    begin
      LoadList.LoadFromFile(sFileName);
      for i := 0 to LoadList.Count - 1 do
      begin
        sLineText := Trim(LoadList.Strings[i]);
        if (sLineText = '') or (sLineText[1] = ';') then
          Continue;
        sLineText := GetValidStr3(sLineText, sCharName, [' ', #9]);
        New(OffLineData);
        OffLineData.sAccount := sLineText;
        OffLineData.sCharName := sCharName;
        OffLineData.boStartLogin := False;
        OffLineData.dwStartLoginTick := MyGetTickCount;
        OffLineData.SessInfo := nil;

{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          UserEngine.m_AutoLoadOfflineList.LockW(2);
        try
{$IFEND}
          UserEngine.m_AutoLoadOfflineList.Add(OffLineData);
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            UserEngine.m_AutoLoadOfflineList.UnLockW;
        end;
{$IFEND}
      end;
    end;
    LoadList.Free;
    UserEngine.m_boStartAutoLoadOffline := UserEngine.m_AutoLoadOfflineList.Count > 0;
    if UserEngine.m_boStartAutoLoadOffline then
      MainOutMessage('正在登录脱机人物...');
    Result := True;
  end;
end;

