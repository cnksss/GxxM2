destructor TPlayObject.Destroy;
var
  I, II: Integer;
  VisibleMapEvent: pTVisibleMapEvent;
  HashItem: HashList.PHashItem;
  List: TList;
begin
  if (g_PluginManager <> nil) then
    g_PluginManager.HookPlayerFree(Self);
  if (g_HighLevelHuman = Self) then
    g_HighLevelHuman := nil;
  if (g_HighPKPointHuman = Self) then
    g_HighPKPointHuman := nil;
  if (g_HighDCHuman = Self) then
    g_HighDCHuman := nil;
  if (g_HighMCHuman = Self) then
    g_HighMCHuman := nil;
  if (g_HighSCHuman = Self) then
    g_HighSCHuman := nil;
  if (g_HighOnlineHuman = Self) then
    g_HighOnlineHuman := nil;
  HashItem := m_VisibleEvents.First;
  while HashItem <> nil do
  begin
    VisibleMapEvent := HashItem.Item;
    HashItem := m_VisibleEvents.Next(HashItem);
    if VisibleMapEvent <> nil then
      Dispose(VisibleMapEvent);
  end;
  FreeAndNil(m_VisibleEvents);
  FreeAndNil(m_MasterList);
  for I := 0 to m_MasterNoList.Count - 1 do
  begin
    Dispose(pTMasterRankInfo(m_MasterNoList.Items[I]));
  end;
  FreeAndNil(m_MasterNoList);
  for I := 0 to m_DynamicVarList.Count - 1 do
  begin
    Dispose(pTDynamicVar(m_DynamicVarList.Items[I]));
  end;
  FreeAndNil(m_DynamicVarList);
  FreeAndNil(m_CanJmpScriptLableList);
  FreeAndNil(m_CanRequestStdItemList);
  for I := 0 to m_DealItemList.Count - 1 do
  begin
    Dispose(pTUserItem(m_DealItemList.Items[I]));
  end;
  FreeAndNil(m_DealItemList);
  for I := 0 to m_ChallengeItemList.Count - 1 do
  begin
    Dispose(pTUserItem(m_ChallengeItemList.Items[I]));
  end;
  FreeAndNil(m_ChallengeItemList);
  for I := Low(m_StorageItemList) to High(m_StorageItemList) do
  begin
    for II := 0 to m_StorageItemList[I].Count - 1 do
      Dispose(pTUserItem(m_StorageItemList[I].Items[II]));
    FreeAndNil(m_StorageItemList[I]);
  end;
  for I := 0 to m_BigStorageItemList.Count - 1 do
  begin
    Dispose(pTUserItem(m_BigStorageItemList.Items[I]));
  end;
  FreeAndNil(m_BigStorageItemList);
  for I := 0 to m_GamePetBagItems.Count - 1 do
  begin
    Dispose(pTUserItem(m_GamePetBagItems.Items[I]));
  end;
  FreeAndNil(m_GamePetBagItems);
  for I := 0 to m_GamePetList.Count - 1 do
  begin
    Dispose(pTGamePetData(m_GamePetList.Items[I]));
  end;
  FreeAndNil(m_GamePetList);
  FreeAndNil(m_GroupMembers);
  FreeAndNil(m_BlockWhisperList);
  for I := 0 to m_TimeLabelList.Count - 1 do
  begin
    Dispose(pTTimeLabel(m_TimeLabelList.Items[I]));
  end;
  FreeAndNil(m_TimeLabelList);
  FreeAndNil(m_OldGroupItem);
  FreeAndNil(m_GroupItem);
  FreeAndNil(m_IntegerList); // N
  FreeAndNil(m_StringList); // S
  FreeAndNil(m_ArrayList); // L

  FreeAndNil(m_MoneyList); // N
  FreeAndNil(m_BoxConfig.ItemList);
  FreeAndNil(m_NeedFoundryItemList);
  for I := 0 to m_ClientBufList.Count - 1 do
  begin
    Dispose(PClientBufInfo(m_ClientBufList.Items[I]));
  end;
  FreeAndNil(m_ClientBufList);
  for I := 0 to m_ArrBufList.Count - 1 do
  begin
    Dispose(PArrBufInfo(m_ArrBufList.Items[I]));
  end;
  FreeAndNil(m_ArrBufList);
  for I := 0 to m_HeroM2ShopList.Count - 1 do
  begin
    Dispose(pTHeroM2ShopItemInfo(m_HeroM2ShopList.Items[I]));
  end;
  FreeAndNil(m_HeroM2ShopList);
  FreeAndNil(m_HeroM2ShopOpenList);
  if m_BoxConfig.Box <> nil then
  begin
    Dispose(m_BoxConfig.Box);
    m_BoxConfig.Box := nil;
  end;
  ClearNpcInputText;
  ClearSendJoinUserList;
  m_SendJoinUserList.Free;
  for I := 0 to m_MonItems.Count - 1 do
  begin
    List := TList(m_MonItems.Objects[I]);
    if List <> nil then
    begin
      ClearMonItemList(List);
    end;
    List.Free;
  end;

  m_MonItems.Free;
  m_sInviteGroupHuman.Free;

  if m_WantAddSellPlayerInfo <> nil then
  begin
    FreeMem(m_WantAddSellPlayerInfo);
    m_WantAddSellPlayerInfo := nil;
  end;
  FWantAddSellPlayer := nil;
  m_WarrCuntinueHit.Free;
  inherited;
end;

procedure TPlayObject.Disappear;
begin
  if m_boReadyRun then
    DisappearA;

  if m_boTransparent and m_boHideMode then
    m_wStatusTimeArr[STATE_TRANSPARENT { 0x70 } ] := 0; // 004CA8F7

  if m_GroupOwner <> nil then
    m_GroupOwner.DelGroupMember(Self);

