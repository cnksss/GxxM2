procedure TPlayObject.ClientAddAuctionItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function CheckGameMoney(Prices: Integer): Boolean;
  begin
    Result := False;
    case g_Config.nAuctionBroadcastCurrencyType of
      0:
        Result := m_nGameGold >= Prices; // 游戏币
      1:
        Result := m_nGamePoint >= Prices; // 游戏点
      2:
        Result := m_nGold >= Prices; // 金币数量
      3:
        Result := m_nGameDiamond >= Prices; // 金刚石
      4:
        Result := m_nGameGird >= Prices; // 灵符
    end;
  end;
  procedure DecMyGameMoney(Prices: Integer; MakeIndex: Integer);
  begin
    case g_Config.nAuctionBroadcastCurrencyType of
      0:
        begin
          m_nGameGold := m_nGameGold - Prices;
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_GameGoldChange, LOG_ActionNone, Self, g_Config.sGameGoldName, MakeIndex, '拍卖行', m_nGameGold,
              -Prices, '广播扣费');
          end;
        end;
      1:
        begin
          m_nGamePoint := m_nGamePoint - Prices;
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_GamePointChange, LOG_ActionNone, Self, g_Config.sGamePointName, MakeIndex, '拍卖行', m_nGamePoint,
              -Prices, '广播扣费');
          end;
        end;
      2:
        begin
          m_nGold := m_nGold - Prices;
          GoldChanged();
          if g_boGameLogGold then
          begin
            AddGameDataLog(LOG_GoldChange, LOG_ActionNone, Self, sSTRING_GOLDNAME, MakeIndex, '拍卖行', m_nGold, -Prices, '广播扣费');
          end;
        end;
      3:
        begin
          m_nGameDiamond := m_nGameDiamond - Prices;
          NewGamePointChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_GameDiamondChange, LOG_ActionNone, Self, g_Config.sGameDiamondName, MakeIndex, '拍卖行',
              m_nGameDiamond, -Prices, '广播扣费');
          end;
        end;
      4:
        begin
          m_nGameGird := m_nGameGird - Prices;
          NewGamePointChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_GameGirdChange, LOG_ActionNone, Self, g_Config.sGameGirdName, MakeIndex, '拍卖行', m_nGameGird,
              -Prices, '广播扣费');
          end;
        end;
    end;
  end;
  procedure SpliteByte(Value: Byte; var a, b: Byte);
  begin
    a := Value and $0F;
    b := (Value shr 4) and $0F;
  end;

var
  I, nMakeIndex, AuctionTime, btCurrencyType: Integer;
  StartPrice, SellPrice: LongWord;
  TimeIndex, btSendBroadcast: Byte;
  AuctionID: Integer;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  sText, sMoneyName: string;
  nServerCurrencyType: Integer;
  ItemName: string;
  AcutionItemPrices: TAcutionItemPricesLime;
begin
  if g_OnlineMsgControl.boDisableSell then
    Exit;
  nMakeIndex := ProcessMsg.nParam1;
  SpliteByte(LoByte(ProcessMsg.wParam), TimeIndex, btSendBroadcast);
  btCurrencyType := HiByte(ProcessMsg.wParam);
  StartPrice := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  SellPrice := StrToIntDef(ProcessMsg.sMsg, 0);
  if g_nKey_Auction = 0 then
    Exit;
  if (btCurrencyType < 0) { or (btCurrencyType > 4) } then
  begin
    m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 9, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  case btCurrencyType of
    0:
      nServerCurrencyType := 2; // 元宝
    1:
      nServerCurrencyType := 16; // 游戏点
    2:
      nServerCurrencyType := 1; // 金币
    3:
      nServerCurrencyType := 4; // 金刚石
    4:
      nServerCurrencyType := 8; // 灵符
  else
    nServerCurrencyType := btCurrencyType;
  end;

  if nServerCurrencyType and g_Config.nAuctionCurrencyTypeEx = 0 then
  begin
    m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 10, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if StartPrice <= 0 then
  begin
    m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 1, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if SellPrice <= 0 then
  begin
    m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 2, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if StartPrice >= SellPrice then
  begin
    m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 3, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if g_M2DataDB.AuctionDB.GetMyAuctioningItemsCount(m_sCharName) + g_M2DataDB.AuctionDB.GetMySellFailItemsCount(m_sCharName) +
    g_M2DataDB.AuctionDB.GetMyBuyOKItemsCount(m_sCharName) >= g_Config.nAuctioningItemsCount then
  begin
    m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 4, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if btSendBroadcast = 1 then
  begin
    if not CheckGameMoney(g_Config.nAuctionBroadcastPrice) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 6, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;
  end;
  if m_PEnvir.m_boNoAuction then
  begin
    m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 8, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  case TimeIndex of
    0:
      AuctionTime := 1;
    1:
      AuctionTime := 8;
    2:
      AuctionTime := 24;
  else
    AuctionTime := 1;
  end;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if UserItem.MakeIndex = nMakeIndex then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem <> nil then
      begin
        // 不允许拍卖
        if not g_ItemRules.GetEx(UserItem.wIndex, 27, AcutionItemPrices) then
        begin
          m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 5, 0, 0);
          SendSocket(@m_DefMsg, '');
          Exit;
        end;
        if UserItem.boIsBind then
        begin
          m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 7, 0, 0);
          SendSocket(@m_DefMsg, '');
          Exit;
        end;
        if (btCurrencyType in [0 .. 4]) and (AcutionItemPrices.Min[btCurrencyType] <> 0) and
          (StartPrice < AcutionItemPrices.Min[btCurrencyType]) then
        begin
          m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 11, 0, 0);
          SendSocket(@m_DefMsg, '');
          Exit;
        end;
        if (btCurrencyType in [0 .. 4]) and (AcutionItemPrices.Max[btCurrencyType] <> 0) and
          (SellPrice > AcutionItemPrices.Max[btCurrencyType]) then
        begin
          m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 12, 0, 0);
          SendSocket(@m_DefMsg, '');
          Exit;
        end;
        if (UserItem.btValue[13] = 1) and (Length(UserItem.Name) > 0) then
          ItemName := ProcessItemName(UserItem.Name)
        else
          ItemName := StdItem.Name;
        AuctionID := g_M2DataDB.AuctionDB.AddAuctionItem(m_sCharName, AuctionTime, StartPrice, SellPrice, btCurrencyType,
          UserItem, StdItem);
        if AuctionID > 0 then
        begin
          if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
          begin
            // 注释日志 chongchong 2017-10-09
            AddGameDataLog(LOG_ItemPutInto, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '拍卖行');
          end;
          m_ItemList.Delete(I);
          Dispose(UserItem);
          m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          if btSendBroadcast = 1 then
          begin
            DecMyGameMoney(g_Config.nAuctionBroadcastPrice, nMakeIndex);
            sText := g_Config.sAuctionBroadcastText;
            sText := AnsiReplaceText(sText, '%user', m_sCharName);
            sText := AnsiReplaceText(sText, '%item', ItemName);
            sText := AnsiReplaceText(sText, '%price', IntToStr(StartPrice));
            case btCurrencyType of
              0:
                sMoneyName := g_Config.sGameGoldName;
              1:
                sMoneyName := g_Config.sGamePointName;
              2:
                sMoneyName := sSTRING_GOLDNAME;
              3:
                sMoneyName := g_Config.sGameDiamondName;
              4:
                sMoneyName := g_Config.sGameGirdName;
            else
              sMoneyName := GetCustomMoneyNameByRule(btCurrencyType, 2);
            end;
            sText := AnsiReplaceText(sText, '%mname', sMoneyName);
            UserEngine.AddAuctionBroadcastMessage(sText, AuctionID);
          end;
          Exit;
        end;
      end;
    end;
  end;
  m_DefMsg := MakeDefaultMsg(SM_ADDAUCTIONITEM_RET, nMakeIndex, 99, 0, 0);
  SendSocket(@m_DefMsg, '');
end;

