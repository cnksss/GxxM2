procedure TPlayObject.SendUseItems;
var
  I, nC: Integer;
  ClientItem: pTClientItem;
  StdItem: pTStdItem;
  InBuf: array [0 .. (SizeOf(TClientItem) + 1) * MAX_USE_ITEM_COUNT] of AnsiChar; // 身上装备最多30个。这里多留10个
  InBytes: Integer;
  Buffer: PAnsiChar;
begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  InBytes := 0;
  nC := 0;
  for I := Low(THumanUseItems) to High(THumanUseItems) do
  begin
    if m_UseItems[I].wIndex > 0 then
    begin
      StdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
      if StdItem <> nil then
      begin
        Inc(nC);
        Inc(InBytes, SizeOf(TClientItem) + 1);
        Buffer := @InBuf;
        Buffer := Buffer + (InBytes - (SizeOf(TClientItem) + 1));
        Buffer^ := AnsiChar(I);
        Inc(Buffer);
        ClientItem := pTClientItem(Buffer);
        UserItemToClientItem(@m_UseItems[I], StdItem, ClientItem, True, False);
      end;
    end;
  end;

  m_boSendUseItemsOK := True;
  if InBytes > 0 then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDUSEITEMS, 0, InBytes, 0, nC);
    SendSocketEx(@m_DefMsg, InBuf, InBytes);
  end;
end;

procedure TPlayObject.SendUseIcons(BaseObject: TBaseObject);
var
  I, nC: Integer;
  InBuf: array [0 .. (SizeOf(TActorIcon) + 1) * MAX_ICON_COUNT] of AnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
  IsShowIcons: Boolean;
begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  nC := 0;
  InBytes := 0;
  if BaseObject = Self then
  begin
    IsShowIcons := True;
  end
  else
  begin // 非人物和英雄在任何情况下都显示顶戴
    IsShowIcons := ((m_PEnvir <> nil) and (m_PEnvir.m_nSecretFlag and SecretFlag_HideActorIcons = 0) and
      (m_PEnvir.m_nSecretFlag2 and SecretFlag_HideActorIcons = 0)) or
      not(BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]);
  end;

  if IsShowIcons then
  begin
    Buffer := @InBuf;
    for I := Low(TActorIconArray) to High(TActorIconArray) do
    begin
      if BaseObject.m_ActorIcons[I].nFileIndex >= 0 then
      begin
        if (not BaseObject.m_ActorIcons[I].boOnlySelfVisible) or
          (BaseObject.m_ActorIcons[I].boOnlySelfVisible and (Self = BaseObject)) then
        begin
          Inc(nC);
          Inc(InBytes, SizeOf(TActorIcon) + 1);
          Buffer^ := AnsiChar(I);
          Inc(Buffer);
          Move(BaseObject.m_ActorIcons[I], Buffer^, SizeOf(TActorIcon));
          Buffer := Buffer + SizeOf(TActorIcon);
        end;
      end;
    end;
  end;
  m_DefMsg := MakeDefaultMsg(SM_SENDUSERICON, NativeInt(BaseObject), InBytes, 0, nC);
  SendSocketEx(@m_DefMsg, InBuf, InBytes);
end;

procedure TPlayObject.SendUseEffects(BaseObject: TBaseObject);
var
  I, nC: Integer;
  sSendMsg: AnsiString;
  BaseObjectEffect: pTBaseObjectEffect;
  InBuf: array [0 .. 102400] of AnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  nC := 0;
  sSendMsg := '';
  InBytes := 0;
  Buffer := @InBuf;
  BaseObject.m_BaseObjectEffects.LockR(3);
  try
    for I := 0 to BaseObject.m_BaseObjectEffects.Count - 1 do
    begin
      BaseObjectEffect := BaseObject.m_BaseObjectEffects.Items[I];
      if (BaseObjectEffect.ActorEffect.nEffectFileIndex >= 0) and (BaseObjectEffect.ActorEffect.nLoopCount <> 0) then
      begin
        Inc(nC);
        Inc(InBytes, SizeOf(TActorEffect));
        Move(BaseObjectEffect.ActorEffect, Buffer^, SizeOf(TActorEffect));
        Inc(Buffer, SizeOf(TActorEffect));
        // 修改当播放特效超过一定数量时，可能导致内存出错 2019-01-04 13:48:35
        if (nC + 1) * SizeOf(TActorEffect) >= Length(InBuf) then
          Break;
      end;
    end;
  finally
    BaseObject.m_BaseObjectEffects.UnLockR;
  end;

  if nC > 0 then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDUSEREFFECT, NativeInt(BaseObject), InBytes, 0, nC);
    SendSocketEx(@m_DefMsg, InBuf, InBytes);
  end
  else
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDUSEREFFECT, NativeInt(BaseObject), 0, 0, 0);
    SendSocket(@m_DefMsg, '');
  end;
end;

procedure TPlayObject.SendUseMagic;
var
  I: Integer;
  sSendMsg: AnsiString;
  UserMagic: pTUserMagic;
  ClientMagic: pTClientMagic;
  InBuf: PAnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
  CustomMagicConfig: TCustomMagicConfig;
  nC: Integer;
begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  nC := 0;
  sSendMsg := '';
  if m_MagicList.Count > 0 then
  begin
    InBytes := m_MagicList.Count * SizeOf(TClientMagic);
    GetMem(InBuf, InBytes + 1);
    try
      Buffer := InBuf;
      for I := 0 to m_MagicList.Count - 1 do
      begin
        Inc(nC);
        UserMagic := m_MagicList.Items[I];
        ClientMagic := pTClientMagic(Buffer);
        UserMagicToClientMagic(UserMagic, ClientMagic);
        ClientMagic.dwInterval := GetMagicCD(UserMagic.wMagIdx);
        ClientMagic.dwRealInterval := ClientMagic.dwInterval;
        CustomMagicConfig := GetCustomMagicConfig(UserMagic.wMagIdx);
        if (CustomMagicConfig <> nil) then
        begin
          // 有提示的自定义技能不转圈 2019-09-22 00:44:27
          if Length(CustomMagicConfig.ServerConfig.FailMsg) > 0 then
            ClientMagic.dwInterval := 0;
          if MyGetTickCount - m_CustomSkillUseTick[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID] < ClientMagic.dwInterval then
            ClientMagic.dwLastUseTick := MyGetTickCount - m_CustomSkillUseTick[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID]
          else
            ClientMagic.dwLastUseTick := 0;
        end
        else
          ClientMagic.dwLastUseTick := 0;
        Buffer := Buffer + SizeOf(TClientMagic);
      end;
      sSendMsg := zLibCompressBuffer(InBuf, InBytes);
    finally
      FreeMem(InBuf);
    end;

    if sSendMsg <> '' then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SENDMYMAGIC, 0, Length(sSendMsg), 0, nC);
      SendSocket(@m_DefMsg, sSendMsg);
    end;
  end;
end;

procedure TPlayObject.ClientTakeOnItemsEx(btWhere: Byte; nItemIdx: Integer; sItemName: string);
var
  I, n14: Integer;
  UserItem, TakeOffItem: pTUserItem;
  TakeOffItemEx: TUserItem;
  UserItem01: TUserItem;
  StdItem, StdItem20: pTStdItem;
  StdItem58: TStdItem;
  sUserItemName: string;
  boFind: Boolean;
  boMysteriousMan: Boolean; // 神秘人
begin
  StdItem := nil;
  UserItem := nil;
  UserItem01.wIndex := 0;
  boFind := False;
  n14 := -1;
  boMysteriousMan := m_boMysteriousMan;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if UserItem.MakeIndex = nItemIdx then
    begin
      // 取自定义物品名称
      sUserItemName := '';
      if UserItem.btValue[13] = 1 then
        sUserItemName := UserItem.Name;
      if sUserItemName = '' then
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem <> nil then
      begin
        if CompareText(sUserItemName, sItemName) = 0 then
        begin
          n14 := I;
          UserItem01 := UserItem^;
          boFind := True;
          Break;
        end;
      end;
    end;
    UserItem := nil;
  end;

  if (StdItem <> nil) and (UserItem <> nil) and boFind then
  begin
    if CheckUserItems(btWhere, StdItem) then
    begin
      StdItem58 := StdItem^;
      ItemUnit.GetItemAddValue(UserItem, StdItem58);
      if CheckTakeOnItems(btWhere, @StdItem58) and CheckItemBindUse(UserItem) then
      begin
        TakeOffItem := nil;
        if btWhere in [Low(THumanUseItems) .. High(THumanUseItems)] then
        begin
          if m_UseItems[btWhere].wIndex > 0 then
          begin
            StdItem20 := UserEngine.GetStdItem(m_UseItems[btWhere].wIndex);
            if (StdItem20 <> nil) and (StdItem20.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) then
            begin
              if (not m_boUserUnLockDurg) and (m_UseItems[btWhere].btValue[7] <> 0) then
              begin
                SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
                Exit;
              end;
            end;

            if not m_boUserUnLockDurg and ((StdItem20.Reserved and 2) <> 0) then
            begin
              SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
              Exit;
            end;

            if (StdItem20.Reserved and 4) <> 0 then
            begin
              SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
              Exit;
            end;

            if InDisableTakeOffList(m_UseItems[btWhere].wIndex) or
              (GetUserItemBindValue(@m_UseItems[btWhere], ubNoTakeOff) and m_UseItems[btWhere].boIsBind) then
            begin
              SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
              Exit;
            end;

            if (m_UseItems[btWhere].btValue[13] = 1) and (m_UseItems[btWhere].Name <> '') then
              sUserItemName := m_UseItems[btWhere].Name
            else
              sUserItemName := UserEngine.GetStdItemName(m_UseItems[btWhere].wIndex);

            m_nCurrentItemMakeIndex := m_UseItems[btWhere].MakeIndex;
            m_nCurrentItemPos := btWhere;
            m_sCurrentItemName := UserEngine.GetStdItemName(m_UseItems[btWhere].wIndex);
            m_sCurrentItemNewName := sUserItemName;
            m_PickUpOrDropItem := m_UseItems[btWhere];
            m_boStopTakeOff := False;
            g_FunctionNPC.GotoLable(Self, '@BeginTakeOff', False);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
            if m_boStopTakeOff then
              Exit;
          end;

          if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
            sUserItemName := UserItem.Name
          else
            sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);

          m_nCurrentItemMakeIndex := UserItem.MakeIndex;
          m_nCurrentItemPos := btWhere;
          m_sCurrentItemName := UserEngine.GetStdItemName(UserItem.wIndex);
          m_sCurrentItemNewName := sUserItemName;
          m_PickUpOrDropItem := UserItem^;
          m_boStopTakeOn := False;
          g_FunctionNPC.GotoLable(Self, '@BeginTakeOn', False);
          m_PickUpOrDropItem.MakeIndex := 0;
          m_PickUpOrDropItem.wIndex := 0;
          m_nCurrentItemMakeIndex := 0;
          m_nCurrentItemPos := 0;
          m_sCurrentItemName := '';
          m_sCurrentItemNewName := '';
          if m_boStopTakeOff then
            Exit;

          if m_UseItems[btWhere].wIndex > 0 then
          begin
            if (StdItem <> nil) //
              and (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) //
              and m_boUserUnLockDurg //
              and (m_UseItems[btWhere].btValue[7] <> 0) then // 使用过神水的神秘装备下次可以脱下来
            begin
              m_boUserUnLockDurg := False;
              m_UseItems[btWhere].btValue[7] := 0;
            end;
            New(TakeOffItem);
            TakeOffItem^ := m_UseItems[btWhere];
          end;

          if (UserItem.btValue[8] <> 0) and (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) then
            UserItem.btValue[8] := 0;

          if TakeOffItem <> nil then
          begin
            m_UseItems[btWhere].wIndex := 0;
            { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
            StdItem := UserEngine.GetStdItem(TakeOffItem.wIndex);
            if StdItem <> nil then
              ProcessUseItemSkill(btWhere, StdItem, False);
          end;

          m_UseItems[btWhere] := UserItem^;
          DelBagItem(n14);
          if (StdItem58.Need in [101, 102]) and (not m_UseItems[btWhere].boStartTime) then
          begin
            m_UseItems[btWhere].nLimitTime := StdItem58.NeedLevel;
            m_UseItems[btWhere].boStartTime := True;
            SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem58.Name, StdItem58.NeedLevel]), c_Red, t_System);
          end;
          { TODO -ochongchong -c修改 : 装备后，添加特定技能 【2013-08-27】 }
          ProcessUseItemSkill(btWhere, StdItem, True);
          // DelBagItem(UserItem01.MakeIndex, StdItem.Name);
          if TakeOffItem <> nil then
          begin
            TakeOffItemEx := TakeOffItem^;
            { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
            StdItem := UserEngine.GetStdItem(TakeOffItem.wIndex);
            if StdItem <> nil then
              ProcessUseItemSkill(btWhere, StdItem, False);

            if AddItemToBag(TakeOffItem) then
            begin
              SendAddItem(TakeOffItem);
            end
            else
            begin
              DropItemDown(TakeOffItem, 3, False, Self, nil);
              Dispose(TakeOffItem);
            end;

            if g_FunctionNPC <> nil then
            begin
              m_nScriptGotoCount := 0;
              if (TakeOffItemEx.btValue[13] = 1) and (TakeOffItemEx.Name <> '') then
                sUserItemName := TakeOffItemEx.Name
              else
                sUserItemName := UserEngine.GetStdItemName(TakeOffItemEx.wIndex);

              m_nCurrentItemMakeIndex := TakeOffItemEx.MakeIndex;
              m_nCurrentItemPos := btWhere;
              m_sCurrentItemName := UserEngine.GetStdItemName(TakeOffItemEx.wIndex);
              m_sCurrentItemNewName := sUserItemName;
              m_nScriptGotoCount := 0;
              m_PickUpOrDropItem := TakeOffItemEx;
              g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(btWhere), False);
              g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
              m_PickUpOrDropItem.MakeIndex := 0;
              m_PickUpOrDropItem.wIndex := 0;
              m_nCurrentItemMakeIndex := 0;
              m_nCurrentItemPos := 0;
              m_sCurrentItemName := '';
              m_sCurrentItemNewName := '';
            end;
          end;

          RecalcAbilitys();
          SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
          SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
          SendDefMessage(SM_TAKEONITEM, nItemIdx, btWhere, 0, 0, sItemName);
          FeatureChanged();
          if (btWhere = U_HELMET) or (boMysteriousMan <> m_boMysteriousMan) then
            RefShowName;

          if g_FunctionNPC <> nil then
          begin
            m_nCurrentItemMakeIndex := UserItem.MakeIndex;
            m_nCurrentItemPos := btWhere;
            m_sCurrentItemName := StdItem58.Name;
            m_sCurrentItemNewName := sItemName;
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@TakeOn' + IntToStr(btWhere), False);
            g_FunctionNPC.GotoLable(Self, '@TakeOnEx', False);
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
          end;
        end;
      end;
    end;
  end;
end;

