        m_UpgradeItem := nil;
        m_UpgradeItemIsPegBag := False;
      end;
      m_ItemBoxItems[Index] := 0;
      m_DefMsg := MakeDefaultMsg(SM_RETURNBOXITEM, Index, 0, 0, 0);
      SendSocket(@m_DefMsg, '');
