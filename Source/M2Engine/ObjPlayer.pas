    if g_Config.boPasswordLockSystem then
    begin
      if m_boPasswordLocked then
        m_boCanGetBackItem := not g_Config.boLockGetBackItemAction;

      if g_Config.boLockHumanLogin and m_boLockLogon and m_boPasswordLocked then
      begin
        m_boCanDeal := not g_Config.boLockDealAction;
        m_boCanDrop := not g_Config.boLockDropAction;
        m_boCanUseItem := not g_Config.boLockUserItemAction;
        m_boCanWalk := not g_Config.boLockWalkAction;
        m_boCanRun := not g_Config.boLockRunAction;
        m_boCanHit := not g_Config.boLockHitAction;
        m_boCanSpell := not g_Config.boLockSpellAction;
        m_boCanSendMsg := not g_Config.boLockSendMsgAction;
        m_boObMode := g_Config.boLockInObModeAction;
        m_boAdminMode := g_Config.boLockInObModeAction;
        SysMsg(g_sActionIsLockedMsg + ' 开锁命令: @' + g_GameCommand.UnLock.sCmd, c_Red, t_Hint);
        SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sActionIsLockedMsg + '\ \' + '开锁命令: @' +
          g_GameCommand.UnLock.sCmd + '\' + '加锁命令: @' + g_GameCommand.Lock.sCmd + '\' + '设置密码命令: @' +
          g_GameCommand.SETPASSWORD.sCmd + '\' + '修改密码命令: @' + g_GameCommand.CHGPASSWORD.sCmd);
      end;
      // {$IFEND}
    end;
    Code := 71;
    if not m_boDummyObject then
    begin
      for I := 0 to Length(m_SkillUseTick) - 1 do
      begin
        m_SkillUseTick[I] := 0;
      end;
    end;
    Code := 72;
    // 重置泡点方面计时
    m_dwIncGamePointTick := MyGetTickCount();
    m_dwIncGameGoldTick := MyGetTickCount();
    m_dwAutoGetExpTick := MyGetTickCount();
    m_dwDecGamePointTick := MyGetTickCount();
    Code := 73;
    { 副本地图 ---- 登录后保持原地图 }
    if m_PEnvir.m_boFB then
    begin
      if (m_PEnvir.m_dwFBCreateTime = m_dwFBCreateTime) and (m_PEnvir.m_boFBCreate) then
        m_FBEnvir := m_PEnvir
      else
      begin
        Envir := g_MapManager.FindMap(m_sHomeMap);
        if Envir <> nil then
        begin
          EnterAnotherMap(Envir, m_nHomeX, m_nHomeY);
          m_FBEnvir := nil;
          SendDefMessage(SM_FBTIME, 0, 0, 0, 2, '');
          SendDefMessage(SM_FBTIME, 0, 0, 0, 1, '');
          SendDefMessage(SM_FBTIME, 0, 0, 0, 3, '');
        end;
      end;
    end
    else
    begin
      // 上线后，人物不在副本地图，将倒计时清空 chongchong 2013-12-10
      SendDefMessage(SM_FBTIME, 0, 0, 0, 2, '');
      SendDefMessage(SM_FBTIME, 0, 0, 0, 1, '');
      SendDefMessage(SM_FBTIME, 0, 0, 0, 3, '');
    end;

    if not m_PEnvir.m_boMirror then
      SendDefMessage(SM_FBTIME, 0, 0, 0, 4, '');

    Code := 74;
    // 用户登录后，立马把周边的对象发送到客户端 chongchong 2014-10-22
    m_dwSearchTick := MyGetTickCount();
    SearchViewRange;

    if (Length(m_sMobileNumber) > 0) //
      and (Length(m_sMobileVerifyCode) > 0) //
      and (Tick_Diff(m_dwMobileVerifyTick, MyGetTickCount) < g_SendSMSConfig.VerifyCodeTimeOutTime * 1000) then
      SendMsg(Self, RM_INPUTMOBILE_VerifyCode, 0, 0, 0, 0, '');

    if (g_PluginManager <> nil) then
      g_PluginManager.HookPlayerLogin4(Self);
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg + IntToStr(Code));
      MainOutMessage(E.Message);
    end;
  end;

  if not m_boTempAdminMode then
  begin
    m_dwTempAdminModeTick := MyGetTickCount;
    m_boTempAdminMode := True;
  end;

  // 补发充值元宝 By 一支笔 at:2021-12-23 15:48:56
  nC := g_PayInfoList.IndexOf(m_sUserID);
  while nC > -1 do
  begin
    PayInfo := pTPayInfo(g_PayInfoList.Objects[nC]);
    if PayInfo <> nil then
    begin
      m_nInteger[0] := PayInfo.Price;
      m_nInteger[1] := PayInfo.PayType;
      m_nInteger[2] := Integer(PayInfo.IsTest);
      g_FunctionNPC.GotoLable(Self, '@PayMentSuccessful', False);
      m_nInteger[0] := 0;
      m_nInteger[1] := 0;
      m_nInteger[2] := 0;
    end;
    Dispose(PayInfo);
    g_PayInfoList.Delete(nC);
    SavePayInfo();
    nC := g_PayInfoList.IndexOf(m_sUserID);
  end;

  // M2获取用户注册信息 chongchong 2015-11-13
  FrmIDSoc.SendGetAccountInfo(m_sUserID, m_sCharName);
  g_M2DataDB.UserShopDB.UpdateHumanBusiness(m_sCharName, True);
end;

// 获取宝箱内物品 piaoyun 2013-08-23
// 物品类型(0,1,2,3)  0,表示可得物品,1,表示不可得物品,2表示中间一隔物品,3表示永远不可得物品
procedure TPlayObject.GetBoxItems;
// 对经验、金刚石、声望进行特殊处理
  function GetNewName(ClientItem: TClientItem): string;
  const
    STR = '{#;>';
  begin
    if ClientItem.S.StdMode = 255 then
    begin
      if ClientItem.S.Name = '经验' then
        Result := ClientItem.S.Name + STR + IntToStr(ClientItem.S.Price)
      else if ClientItem.S.Name = g_Config.sCreditPointName then
        Result := ClientItem.S.Name + STR + IntToStr(ClientItem.S.Price)
      else if ClientItem.S.Name = g_Config.sGameDiamondName then
        Result := ClientItem.S.Name + STR + IntToStr(ClientItem.S.Price)
    end
    else
    begin
      // 宝箱物品支持物品数量 +  chongchong 2014-01-06
      Result := ClientItem.S.Name + STR + IntToStr(ClientItem.S.Price);
    end;
  end;

var
  I: Integer;
  nCount: Integer;
  Idx: Integer;
  CanGetIndex: Integer;
  InBuf: array [0 .. SizeOf(TClientItem) * 9] of AnsiChar;
  ItemCount: Integer;
  ClientItem: pTClientItem;
begin
  while True do
  begin
    CanGetIndex := Random(9);
    if CanGetIndex <> 4 then
      Break;
  end;

  ClientItem := @InBuf;
  ItemCount := 0;
  for I := 0 to 8 do
  begin
    nCount := 0;
    FillChar(ClientItem^, SizeOf(TClientItem), 0);
    // 处理中宫--客户端设计4为中间格子，类型九宫格设计                  !
    if I = 4 then
    begin
      g_BoxsList.GetBoxsItem(m_BoxConfig.StdItem.Source, 2, m_BoxConfig.ItemList.Count + 1, ClientItem);
      m_BoxConfig.ItemList.AddObject(GetNewName(ClientItem^), TObject(2));
    end
    else // 处理周边格子
    begin
      while True do
      begin
        if nCount > 1000 then
          Break;
        Idx := Random(4);
        if (Idx <> 2) then
        begin
          // 确保除了中宫外，最少有一个可得物品 piaoyun 2013-08-23
          if (CanGetIndex = I) then
            Idx := 0;
          g_BoxsList.GetBoxsItem(m_BoxConfig.StdItem.Source, Idx, m_BoxConfig.ItemList.Count + 1, ClientItem);
          if ClientItem.S.Name <> '' then
          begin
            m_BoxConfig.ItemList.AddObject(GetNewName(ClientItem^), TObject(Idx));
            Break;
          end;
        end;
        Inc(nCount);
      end;
    end;
    Inc(ClientItem);
    Inc(ItemCount);
  end;
  // 中间一格
  m_BoxConfig.nIndex := 4;
  m_DefMsg := MakeDefaultMsg(SM_OPENBOX_SUCCESS, ItemCount, Random(8), 0, 0);
  SendSocketEx(@m_DefMsg, @InBuf, ItemCount * SizeOf(TClientItem));
end;

