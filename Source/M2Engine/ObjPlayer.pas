procedure TPlayObject.RunNotice;
var
  Msg: TProcessMessage;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.RunNotice';
begin
  if m_boEmergencyClose or m_boKickFlag or m_boSoftClose then
  begin
    if m_boKickFlag then
      SendDefMessage(SM_OUTOFCONNECTION, 0, 0, 0, 0, '');
    MakeGhost();
  end
  else
  begin
    try
      if not m_boSendNotice then
      begin
        SendNotice(False);
        m_boSendNotice := True;
        m_dwWaitLoginNoticeOKTick := MyGetTickCount();
      end
      else
      begin
        if MyGetTickCount - m_dwWaitLoginNoticeOKTick > 60 * 1000 then
          m_boEmergencyClose := True;

        if (not FIsSendRunNotice) and (FSendClientDataFileTick <> 0) and
          (Tick_Diff(FSendClientDataFileTick, MyGetTickCount) >= 500) then
          SendNotice(True);

        while GetMessage(@Msg) do
        begin
          if Msg.wIdent = CM_CLIENTDATAFILE then
          begin
            if Msg.nParam1 = 0 then
              SendClientDataFile(Msg.sMsg);
            m_dwWaitLoginNoticeOKTick := MyGetTickCount();
          end
          else if Msg.wIdent = CM_LOGINNOTICEOK then
          begin
            if LongWord(MakeLong(Msg.nParam2, Msg.nParam3)) <> FRecbNoticeCode then
            begin
              MakeGhost;
              Exit;
            end;
            m_boIsMobile := Msg.sMsg <> '';
            m_nViewRange := 0;
            m_wScreenWidth := LoWord(Msg.nParam1);
            m_wScreenHeight := HiWord(Msg.nParam1);
            m_ClientUIType := TClientUIType(LoByte(Msg.wParam)); // 登录器版本
            m_wClientViewRange := HiByte(Msg.wParam); // 客户端视觉 分辨率越大，就越高
            m_nViewRange := Max(m_nViewRange, m_wClientViewRange);
            if m_nViewRange <= 0 then
              m_nViewRange := 12;
            // 修正1024*768时，地上物品刷新显示不对 chongchong 2014-12-07
            // 修正UI（隐藏掉主UI）无遮挡地图及怪物时，从上往下跑怪物要跑多点才出 2019-09-03 23:58:52
            if ((m_wScreenWidth <= 800) and (m_wScreenHeight <= 600)) then
            begin
              if (m_nViewRange < 12) then
                m_nViewRange := 12; // 12改为14 2019-09-04 00:00:43
            end
            else
            begin
              // 视觉范围原来是 +2，现在改成 +1，再看效果 chongchong 2015-11-19
              // 视觉范围改成 +3 2019-09-04 00:00:43
              Inc(m_nViewRange, 1);
            end;
            // 限定视觉范围的最大值 2019-09-08 01:29:29
            if m_nViewRange > 40 then
              m_nViewRange := 40;
            g_nSendRefMsgRange := Max(g_nSendRefMsgRange, m_nViewRange);
            // 可视范围Y扩展 主要是用于UI无遮挡下面的怪物显示 2019-09-04 00:39:53
            m_nViewRangeExtY := C_VIEWRANGEEXTY;
            m_boLoginNoticeOK := True;
            m_dwClientTick := Msg.nParam1;
            Break;
          end;
        end;
      end;
    except
      MainOutMessage(sExceptionMsg);
    end;
  end;
end;

procedure TPlayObject.WinExp(dwExp: LongWord);
begin
  if dwExp > 0 then
  begin
    // 系统指定杀怪经验倍数
    dwExp := g_Config.dwKillMonExpMultiple * dwExp;
    // 人物指定的杀怪经验倍数
    dwExp := LongWord(m_nKillMonExpMultiple) * dwExp;
    // 套装规则修改：套装倍数计算 chongchong 2013-07-27
    // 人物指定的杀怪经验倍数 (NPC)
    if (m_nKillMonExpRate > 0) then
    begin
      // m_nKillMonExpRate 人物指定的杀怪经验倍数 (NPC)
      if (m_SuiteExpMultiple > 0) and (m_SuiteExpMultiple > m_nKillMonExpRate) then // 如果套装的倍数大于NPC设置的倍数，则以套装的倍数为准
        dwExp := Round(m_SuiteExpMultiple / 100 * dwExp)
      else
        dwExp := Round(m_nKillMonExpRate / 100 * dwExp);
    end
    else
    begin
      if m_SuiteExpMultiple > 0 then
        dwExp := Round(m_SuiteExpMultiple / 100 * dwExp);
    end;
    // 地图上指定杀怪经验倍数
    if m_PEnvir.m_boEXPRATE then
      dwExp := Round((m_PEnvir.m_nEXPRATE / 100) * dwExp);
    // 物品经验倍数
    if m_boExpItem then
      dwExp := Round(m_rExpItem * dwExp);
    // 人物杀的怪，先计算最高经验限制 chongchong 2016-04-19
    if not m_boExpFromFromHero then
    begin
      { TODO -ochongchong -c修改 : 英雄1000以后使用固定经验 }
      if m_Abil.Level >= g_Config.nHighLevel then
        dwExp := Max(g_Config.nHighLevelGetExp, 0);
    end;
    GetExp(GetLevelExpRate(dwExp));
  end;
end;

procedure TPlayObject.GetExp(dwExp: LongWord; IsAdjustHero: Boolean; FromNPC: Boolean; IsIncBead: Boolean;
  IsFromChangeExp: Boolean);
var
  dwAddExp: LongWord;
  lwExp: LongWord;
  nMaxLevel: LongWord;
  nMaxUpLevelCount: Integer;
  IsLeveUped: Boolean;
  OldLevel: LongWord;
label
  RefExp;
begin
  if g_Config.btMaxLevel = 0 then
    nMaxLevel := MAXUPLEVEL
  else if g_Config.btMaxLevel = 1 then
    nMaxLevel := High(Integer)
  else
    nMaxLevel := High(LongWord);

  lwExp := dwExp;
  { TODO -ochongchong -c修改 : 分经验 - 英雄不需要在同一地图 2013-08-17 }
  if (m_MyHero <> nil) //
    and (m_boExpFromFromHero) // 经验来源是英雄
    and (not g_Config.boShareExpHeroSameMap) // 经验分享必须在一个地图
    and (m_MyHero.m_PEnvir <> m_PEnvir) then
  begin
    THeroObject(m_MyHero).GetExp(lwExp, False, IsIncBead); // 经验全分给英雄
    Exit;
  end;

  if IsAdjustHero then
  begin
    if (m_MyHero <> nil) //
      and (not m_MyHero.m_boDeath) //
      and (g_Config.boShareExpHeroSameMap or (m_MyHero.m_PEnvir = m_PEnvir)) then // 经验分享必须在一个地图
    begin
      if FromNPC then
      begin
        lwExp := Round(dwExp * (g_Config.nHeroNotKillMonExpRate / 100));
        THeroObject(m_MyHero).GetExp(lwExp, FromNPC, IsIncBead);
        { TODO -ochongchong -c修改 : 人物获取全部经验 【2013-08-24】 }
        if g_Config.boHumanGetAllExp then
          lwExp := dwExp
        else
        begin
          lwExp := dwExp - lwExp;
          dwExp := lwExp;
        end;
      end
      else
      begin
        if g_Config.boHeroGetAllExp then
        begin
          lwExp := dwExp;
          THeroObject(m_MyHero).GetExp(lwExp, False, IsIncBead);
        end
        else
        begin
          lwExp := Round(dwExp * (g_Config.nHeroKillMonExpRate / 100));
          THeroObject(m_MyHero).GetExp(lwExp, False, IsIncBead);
          { TODO -ochongchong -c修改 : 人物获取全部经验 【2013-08-24】 }
          if g_Config.boHumanGetAllExp then
            lwExp := dwExp
          else
          begin
            lwExp := dwExp - lwExp;
            dwExp := lwExp;
          end;
        end;
      end;
    end;
  end;

  // 人物经验受最高经验限制 chongchong 2016-04-19
  if (not IsFromChangeExp) and (m_Abil.Level >= g_Config.nHighLevel) then
  begin
    dwExp := Max(g_Config.nHighLevelGetExp, 0);
    lwExp := Min(lwExp, g_Config.nHighLevelGetExp);
  end;

  nMaxUpLevelCount := 0;
  IsLeveUped := False;
  OldLevel := m_Abil.Level;
RefExp:
  Inc(nMaxUpLevelCount);
  dwAddExp := m_Abil.MaxExp - m_Abil.Exp;
  if (lwExp >= dwAddExp) and (m_Abil.MaxExp > m_Abil.Exp) then
  begin
    if m_Abil.Level < nMaxLevel then
    begin
      Inc(m_Abil.Level);
      lwExp := lwExp - dwAddExp;
      m_Abil.Exp := 0;
      AddBodyLuck(dwAddExp * 0.002);
      IsLeveUped := True;
      // HasLevelUp(m_Abil.Level - 1, True, False);
      m_Abil.MaxExp := GetLevelExp(m_Abil.Level);
      IncHealthSpell(2000, 2000, False);
      if lwExp > 0 then
      begin
        if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
        begin
          goto RefExp;
          Exit;
        end
        else
          Inc(m_Abil.Exp, lwExp);
      end;
    end;
  end
  else
  begin
    if m_Abil.MaxExp > m_Abil.Exp then
    begin
      Inc(m_Abil.Exp, lwExp);
      AddBodyLuck(lwExp * 0.002);
    end
    else
    begin
      Inc(m_Abil.Level);
      Dec(m_Abil.Exp, m_Abil.MaxExp);
      IsLeveUped := True;
      // 优化数据包流量占用 chongchong 2015-11-20
      // HasLevelUp(m_Abil.Level - 1, True, False);
      m_Abil.MaxExp := GetLevelExp(m_Abil.Level);
      IncHealthSpell(2000, 2000, False);
      if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
      begin
        goto RefExp;
        Exit;
      end;
    end;
  end;

  m_dwGetExp := dwExp;
  // 聚灵珠加经验 chongchong 2013-12-10
  if IsIncBead then
    IncBeadExp(dwExp, FromNPC);

  SendMsg(Self, RM_WINEXP, 0, dwExp, 0, 0, '');
  if g_FunctionNPC <> nil then
  begin
    m_nScriptGotoCount := 0;
    g_FunctionNPC.GotoLable(Self, '@GetExp', False);
    if (not FromNPC) then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@KillMonGetExp', False);
    end;
  end;

  // 这里总的变一次
  if IsLeveUped then
  begin
    AddGameDataLog(LOG_LevelChange, LOG_ActionNone, Self, '等级', 0, '0', m_Abil.Level, OldLevel);
    RecalcLevelAbilitys(False);
    RecalcAbilitys();
    SendRefMsg(RM_LEVELUP, m_btDirection, m_nCurrX, m_nCurrY, 0, '');
    LevelUpFunc();
    SendRefMsg(RM_HEALTHSPELLCHANGED, 0, 0, 0, 0, ''); // 刷新HP
  end;
end;

procedure TPlayObject.IncExp(dwExp: LongWord);
var
  dwAddExp: LongWord;
  lwExp: LongWord;
  OldLevel, nMaxLevel: LongWord;
  nMaxUpLevelCount: Integer;
  Int64Value: Int64;
label
  RefExp;
begin
  if g_Config.btMaxLevel = 0 then
    nMaxLevel := MAXUPLEVEL
  else if g_Config.btMaxLevel = 1 then
    nMaxLevel := High(Integer)
  else
    nMaxLevel := High(LongWord);
  lwExp := dwExp;
  nMaxUpLevelCount := 0;
  OldLevel := m_Abil.Level;
RefExp:
  Inc(nMaxUpLevelCount);
  dwAddExp := m_Abil.MaxExp - m_Abil.Exp;
  if (lwExp >= dwAddExp) and (m_Abil.MaxExp > m_Abil.Exp) then
  begin
    if m_Abil.Level < nMaxLevel then
    begin
      Inc(m_Abil.Level);
      lwExp := lwExp - dwAddExp;
      m_Abil.Exp := 0;
      HasLevelUp(m_Abil.Level - 1);
      IncHealthSpell(2000, 2000);
      if lwExp > 0 then
      begin
        if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
        begin
          goto RefExp;
          Exit;
        end
        else
        begin
          Int64Value := Int64(m_Abil.Exp) + lwExp;
          m_Abil.Exp := Min(Int64Value, High(LongWord));
        end;
      end;
    end;
  end
  else
  begin
    if m_Abil.MaxExp > m_Abil.Exp then
    begin
      Int64Value := Int64(m_Abil.Exp) + lwExp;
      m_Abil.Exp := Min(Int64Value, High(LongWord));
    end
    else
    begin
      Inc(m_Abil.Level);
      Dec(m_Abil.Exp, m_Abil.MaxExp);
      HasLevelUp(m_Abil.Level - 1);
      IncHealthSpell(2000, 2000);
      if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
      begin
        goto RefExp;
        Exit;
      end
      // 升级完后，还有经验，加到人物身上 chongchong 2016-05-17
      else
      begin
        if lwExp > 0 then
        begin
          Int64Value := Int64(m_Abil.Exp) + lwExp;
          m_Abil.Exp := Min(Int64Value, High(LongWord));
        end;
      end;
    end;
  end;
  SendMsg(Self, RM_WINEXP, 0, dwExp, 0, 0, '');
  if g_FunctionNPC <> nil then
  begin
    m_dwGetExp := dwExp;
    m_nScriptGotoCount := 0;
    g_FunctionNPC.GotoLable(Self, '@GetExp', False);
  end;

  if OldLevel <> m_Abil.Level then
    AddGameDataLog(LOG_LevelChange, LOG_ActionNone, Self, '等级', 0, '0', m_Abil.Level, OldLevel);
end;

procedure TPlayObject.WinExpNG(dwExp: LongWord);
begin
  if (dwExp > 0) and (m_boTrainingNG) then
  begin
    // 系统指定杀怪经验倍数
    dwExp := g_Config.dwKillMonExpMultiple * dwExp;
    // 人物指定的杀怪经验倍数
    dwExp := LongWord(m_nKillMonExpMultiple) * dwExp;
    // 套装规则修改：套装倍数计算 chongchong 2013-07-27
    // 人物指定的杀怪经验倍数 (NPC中设置)
    // dwExp := Round((m_nKillMonExpRate / 100) * dwExp);
    if (m_nKillMonExpRate > 0) then
    begin
      // m_nKillMonExpRate 人物指定的杀怪经验倍数 (NPC)
      if (m_SuiteExpMultiple > 0) and (m_SuiteExpMultiple > m_nKillMonExpRate) then // 如果套装的倍数大于NPC设置的倍数，则以套装的倍数为准
        dwExp := Round(m_SuiteExpMultiple / 100 * dwExp)
      else
        dwExp := Round(m_nKillMonExpRate / 100 * dwExp);
    end
    else
    begin
      if m_SuiteExpMultiple > 0 then
        dwExp := Round(m_SuiteExpMultiple / 100 * dwExp);
    end;
    // 地图上指定杀怪经验倍数
    if m_PEnvir.m_boEXPRATE then
      dwExp := Round((m_PEnvir.m_nEXPRATE / 100) * dwExp);
    // 物品经验倍数
    if m_boExpItem then
      dwExp := Round(m_rExpItem * dwExp);
    // 内功杀怪经验倍数
    dwExp := abs(Round(dwExp * g_Config.nNGKillMonExpMultiple / 100));
    if not m_boExpFromFromHero then
    begin
      if m_AbilNG.Level >= MAXNG_LEVEL then
        dwExp := Max(g_Config.nHighLevelGetExp, 0);
    end;
    GetExpNG(dwExp);
  end;
end;

procedure TPlayObject.GetExpNG(dwExp: LongWord; IsAdjustHero: Boolean);
var
  dwAddExp: LongWord;
  OldLevel, lwExp: LongWord;
  nMaxUpLevelCount: Integer;
label
  RefExp;
begin
  if not m_boTrainingNG then
    Exit;
  if dwExp = 0 then
    Exit;
  lwExp := dwExp;
  { TODO -ochongchong -c修改 : 分经验 - 英雄不需要在同一地图 2013-08-17 }
  if (m_MyHero <> nil) and (m_boExpFromFromHero) and // 经验来源是英雄
    (not g_Config.boShareExpHeroSameMap) and // 经验分享必须在一个地图
    (m_MyHero.m_PEnvir <> m_PEnvir) then
  begin
    THeroObject(m_MyHero).GetExpNG(lwExp); // 经验全分给英雄
    Exit;
  end;
  if IsAdjustHero then
  begin
    if (m_MyHero <> nil) and (not m_MyHero.m_boDeath) and (g_Config.boShareExpHeroSameMap or (m_MyHero.m_PEnvir = m_PEnvir)) then
    // 经验分享必须在一个地图
    begin
      if g_Config.boHeroGetAllExp then
      begin
        lwExp := dwExp;
        THeroObject(m_MyHero).GetExpNG(lwExp);
      end
      else
      begin
        lwExp := Round(dwExp * (g_Config.nHeroKillMonExpRate / 100));
        THeroObject(m_MyHero).GetExpNG(lwExp);
        { TODO -ochongchong -c修改 : 人物获取全部经验 【2013-08-24】 }
        if not g_Config.boHumanGetAllExp then
        begin
          lwExp := dwExp - lwExp;
          dwExp := lwExp;
        end;
      end;
    end
    else
      lwExp := dwExp;
  end;

  if m_AbilNG.Level >= MAXNG_LEVEL then
  begin
    dwExp := Max(g_Config.nHighLevelGetExp, 0);
    lwExp := Max(lwExp, g_Config.nHighLevelGetExp);
  end;

  if m_AbilNG.Level >= g_Config.nNGMaxLevelLimte then
    Exit;

  nMaxUpLevelCount := 0;
  OldLevel := m_AbilNG.Level;
RefExp:
  Inc(nMaxUpLevelCount);
  dwAddExp := m_AbilNG.MaxExp - m_AbilNG.Exp;
  if (lwExp >= dwAddExp) and (m_AbilNG.MaxExp > m_AbilNG.Exp) then
  begin
    if m_AbilNG.Level < MAXNG_LEVEL then
    begin
      Inc(m_AbilNG.Level);
      lwExp := lwExp - dwAddExp;
      m_AbilNG.Exp := 0;
      HasLevelUpNG(m_AbilNG.Level - 1);
      if lwExp > 0 then
      begin
        if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
        begin
          goto RefExp;
          Exit;
        end
        else
        begin
          Inc(m_AbilNG.Exp, lwExp);
        end;
      end;
    end;
  end
  else
  begin
    if m_AbilNG.MaxExp > m_AbilNG.Exp then
    begin
      Inc(m_AbilNG.Exp, lwExp);
      // AddBodyLuck(lwExp * 0.002);
    end
    else
    begin
      Inc(m_AbilNG.Level);
      Dec(m_AbilNG.Exp, m_AbilNG.MaxExp);
      HasLevelUpNG(m_AbilNG.Level - 1);
      if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
      begin
        goto RefExp;
        Exit;
      end;
    end;
  end;
  m_dwGetExp := dwExp;
  // IncBeadExp(dwExp);
  SendMsg(Self, RM_WINEXP, 1, dwExp, 0, 0, '');

  if OldLevel <> m_AbilNG.Level then
    AddGameDataLog(LOG_LevelChange, LOG_ActionNone, Self, '内功等级', 0, '0', m_AbilNG.Level, OldLevel);
end;

procedure TPlayObject.IncExpNG(dwExp: LongWord);
var
  dwAddExp: LongWord;
  OldLevel, lwExp: LongWord;
  nMaxUpLevelCount: Integer;
label
  RefExp;
begin
  if m_boTrainingNG then
  begin
    lwExp := dwExp;
    nMaxUpLevelCount := 0;
    OldLevel := m_AbilNG.Level;
  RefExp:
    Inc(nMaxUpLevelCount);
    dwAddExp := m_AbilNG.MaxExp - m_AbilNG.Exp;

    if (lwExp >= dwAddExp) and (m_AbilNG.MaxExp > m_AbilNG.Exp) then
    begin
      if m_AbilNG.Level < MAXNG_LEVEL then
      begin
        Inc(m_AbilNG.Level);
        lwExp := lwExp - dwAddExp;
        m_AbilNG.Exp := 0;
        HasLevelUpNG(m_AbilNG.Level - 1);
        if lwExp > 0 then
        begin
          if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
          begin
            goto RefExp;
            Exit;
          end
          else
            Inc(m_AbilNG.Exp, lwExp);
        end;
      end;
    end
    else
    begin
      if m_AbilNG.MaxExp > m_AbilNG.Exp then
      begin
        Inc(m_AbilNG.Exp, lwExp);
      end
      else
      begin
        Inc(m_AbilNG.Level);
        Dec(m_AbilNG.Exp, m_AbilNG.MaxExp);
        HasLevelUpNG(m_AbilNG.Level - 1);
        if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
        begin
          goto RefExp;
