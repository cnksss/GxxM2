procedure TPlayObject.ServerSendHealthSpellChangedStruck(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  BaseObject: TBaseObject;
  NewMessageBodyWL: TNewMessageBodyWL;
begin
  // 修正护身只掉蓝时显示错误 chongchong 2017-09-28
  // 由于 TBaseObject.DamageHealth 中要用 SendRefMsg(RM_HEALTHSPELLCHANGED_STRUCK, 0, 0, 0, 0, '', 0); 将 ProcessMsg.wParam > 0 改为 ProcessMsg.wParam >= 0
  BaseObject := TBaseObject(ProcessMsg.BaseObject);
  if (BaseObject <> nil) { and (ProcessMsg.wParam >= 0) } then
  begin
    NewMessageBodyWL.lParam1 := BaseObject.m_WAbil.HP;
    NewMessageBodyWL.lParam2 := BaseObject.m_WAbil.MaxHP;
    NewMessageBodyWL.lTag1 := ProcessMsg.wParam; // 当前血量改变

    // 修正浑水摸鱼地图，英雄受到攻击后，等级为0 2020-05-12 22:21:22
    if (BaseObject.m_PEnvir <> nil) //
      and (BaseObject.m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) //
      and (TObject(ProcessMsg.BaseObject) <> Self) //
      and (TObject(ProcessMsg.BaseObject) <> m_MyHero) then
      NewMessageBodyWL.lTag2 := 0
    else if (BaseObject.m_PEnvir <> nil) //
      and (BaseObject.m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) //
      and (TObject(ProcessMsg.BaseObject) <> Self) //
      and (TObject(ProcessMsg.BaseObject) <> m_MyHero) then
      NewMessageBodyWL.lTag2 := 0
    else
      NewMessageBodyWL.lTag2 := BaseObject.m_WAbil.Level;

    NewMessageBodyWL.lTag3 := BaseObject.m_WAbil.MaxMP;
    NewMessageBodyWL.lTag4 := BaseObject.m_nCharStatus; // 受攻击者状态
    // 这个消息只是施毒用，施毒不要把人物施毒发过去，不然挂机时【配置受人物攻击随机】，人物掉一次血随机一次
    // NewMessageBodyWL.lTag5 := ProcessMsg.nParam3;
    NewMessageBodyWL.lTag5 := 0;

    NewMessageBodyWL.BlastHitType := bhtNone;
    NewMessageBodyWL.ResID := ProcessMsg.nParam1; // Cursor 2023-06-08 14:08:24 HumanHP命令参数5
    NewMessageBodyWL.ResStartIdx := ProcessMsg.nParam2; // Cursor 2023-06-08 14:08:24 HumanHP命令参数6

    m_DefMsg := MakeDefaultMsg(SM_HEALTHSPELLCHANGED, NativeInt(ProcessMsg.BaseObject), LoWord(BaseObject.m_WAbil.MP),
      HiWord(BaseObject.m_WAbil.MP), MakeWord(BaseObject.m_btJob, 1)); // 改为参数1 修复客户端不显示对方血值BUG piaoyun 2013-09-07
    SendSocketEx(@m_DefMsg, @NewMessageBodyWL, SizeOf(TNewMessageBodyWL));
  end;
end;

procedure TPlayObject.ServerSendStruck(ProcessMsg: pTProcessMessage; var boResult: Boolean);
(*
  {$J+}
  const
  LastMsgTick: LongWord = 0;
  {$J-}
*)
var
  ErrCode: Integer;
  NewMessageBodyWL: TNewMessageBodyWL;
  AttackFrom, TempObject: TBaseObject;
begin
  // MainOutMessage('间隔04:' + IntToStr(MyGetTickCount - g_Debug_Spell_Tick));
  ErrCode := 0;
  try
    if ProcessMsg.wParam { nPower } > 0 then
    begin
      ErrCode := 1;
      if TObject(ProcessMsg.BaseObject) = Self then
      begin
        ErrCode := 2;
        AttackFrom := TBaseObject(ProcessMsg.nParam3);
        if AttackFrom <> nil then
        begin
          ErrCode := 3;
          if (AttackFrom.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (AttackFrom <> Self) then
          begin
            ErrCode := 40;
            // A英雄攻击B英雄时，A英雄的主人也要灰名 chongchong 2017-12-08
            if AttackFrom.m_Master <> nil then
            begin
              SetPKFlag(AttackFrom.m_Master);
            end;
            // A英雄攻击B英雄时，A英雄自己灰名 chongchong 2017-12-08
            ErrCode := 41;
            SetPKFlag(AttackFrom { AttackBaseObject } );
          end;
          ErrCode := 5;
          if (TBaseObject(ProcessMsg.nParam3) <> Self) then
            SetLastHiter(TBaseObject(ProcessMsg.nParam3) { AttackBaseObject } );
          ErrCode := 6;
        end;
        ErrCode := 7;
        // if PKLevel >= 2 then m_dw5D4 := MyGetTickCount();
        if (g_CastleManager.IsCastleMember(Self) <> nil) and (TBaseObject(ProcessMsg.nParam3) <> nil) then
        begin
          TBaseObject(ProcessMsg.nParam3).bo2B0 := True;
          TBaseObject(ProcessMsg.nParam3).m_dw2B4Tick := MyGetTickCount();
        end;
        ErrCode := 8;
        m_nHealthTick := 0;
        m_nSpellTick := 0;
        Dec(m_nPerHealth);
        Dec(m_nPerSpell);
        m_dwStruckTick := MyGetTickCount();
      end;
      TempObject := TBaseObject(ProcessMsg.BaseObject);
      ErrCode := 9;
      if TempObject <> nil then
      begin
        ErrCode := 10;
        { 人物不弯腰 }
        if (((TempObject = Self) and g_Config.boDisableSelfStruck) or ((TempObject.m_btRaceServer = RC_PLAYOBJECT) and
          g_Config.boDisableStruck)) or
        { TODO -ochongchong -c修改 : 英雄无弯腰动作和英雄自己不弯腰 【2013-08-17】 }
          (((TempObject = m_MyHero) and g_Config.boHeroDisableSelfStruck) or ((TempObject.m_btRaceServer = RC_HEROOBJECT) and
          g_Config.boHeroDisableStruck)) or
        { 魔法攻击练功师不弯腰 chongchong 2017-09-15 }
          (TempObject.m_btRaceServer = 55) or ((TempObject.m_Master <> nil) and (TempObject.m_btRaceServer <> RC_HEROOBJECT) and
          g_Config.boSlaveDisableStruck) then
        begin
          ErrCode := 11;
          // 修复别人的护身显示不正常 chongchong 2014-10-27 15:49:55
          ErrCode := 14;
          NewMessageBodyWL.lParam1 := TempObject.m_WAbil.HP;
          NewMessageBodyWL.lParam2 := TempObject.m_WAbil.MaxHP;
          NewMessageBodyWL.lTag1 := ProcessMsg.wParam; // 当前血量改变
          // 修正浑水摸鱼地图，英雄受到攻击后，等级为0 2020-05-12 22:21:22
          if (TempObject.m_PEnvir <> nil) and (TempObject.m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and
            (TempObject <> Self) and (TempObject <> m_MyHero) then
            NewMessageBodyWL.lTag2 := 0
          else if (TempObject.m_PEnvir <> nil) and (TempObject.m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and
            (TempObject <> Self) and (TempObject <> m_MyHero) then
            NewMessageBodyWL.lTag2 := 0
          else
            NewMessageBodyWL.lTag2 := TempObject.m_WAbil.Level;
          NewMessageBodyWL.lTag3 := TempObject.m_WAbil.MaxMP;
          NewMessageBodyWL.lTag4 := TempObject.m_nCharStatus; // 受攻击者状态
          // 攻击者
          // NewMessageBodyWL.lTag5 := ProcessMsg.nParam3;
          NewMessageBodyWL.lTag5 := 0;
          if ProcessMsg.nParam3 <> 0 then
          begin
            AttackFrom := TBaseObject(ProcessMsg.nParam3);
            if (AttackFrom.m_btRaceServer = RC_PLAYOBJECT) or
              ((AttackFrom.Master <> nil) and (AttackFrom.Master.m_btRaceServer = RC_PLAYOBJECT)) then
              NewMessageBodyWL.lTag5 := NativeInt(AttackFrom);
          end;

          if ProcessMsg.sMsg = BlastHitTypeValues[bhtBlastHit] then
            NewMessageBodyWL.BlastHitType := bhtBlastHit
          else if ProcessMsg.sMsg = BlastHitTypeValues[bhtFatalBlow1] then
            NewMessageBodyWL.BlastHitType := bhtFatalBlow1
          else if ProcessMsg.sMsg = BlastHitTypeValues[bhtFatalBlow2] then
            NewMessageBodyWL.BlastHitType := bhtFatalBlow2
          else if ProcessMsg.sMsg = BlastHitTypeValues[bhtFatalBlow3] then
            NewMessageBodyWL.BlastHitType := bhtFatalBlow3
          else if ProcessMsg.sMsg = BlastHitTypeValues[bhtFatalBlow4] then
            NewMessageBodyWL.BlastHitType := bhtFatalBlow4
          else
            NewMessageBodyWL.BlastHitType := bhtNone;

          ErrCode := 15;
          m_DefMsg := MakeDefaultMsg(SM_HEALTHSPELLCHANGED, NativeInt(TempObject), LoWord(TempObject.m_WAbil.MP),
            HiWord(TempObject.m_WAbil.MP), MakeWord(TempObject.m_btJob, 1)); // 改为参数1 修复客户端不显示对方血值BUG piaoyun 2013-09-07
          ErrCode := 16;
          SendSocketEx(@m_DefMsg, @NewMessageBodyWL, SizeOf(TNewMessageBodyWL));
        end
        else
        begin
          // MainOutMessage('struck: '+ IntToStr(MyGetTickCount - LastMsgTick));
          // LastMsgTick := MyGetTickCount;
          ErrCode := 21;
          m_DefMsg := MakeDefaultMsg(SM_STRUCK, NativeInt(TempObject), LoWord(ProcessMsg.wParam), HiWord(ProcessMsg.wParam),
            MakeWord(BoolToInt(ProcessMsg.wIdent = RM_STRUCK_MAG), BoolToInt(ProcessMsg.sMsg = '1')));
          ErrCode := 22;
          // 修复别人的护身显示不正常 chongchong 2014-10-27 15:49:55
          NewMessageBodyWL.lParam1 := TempObject.m_WAbil.HP;
          NewMessageBodyWL.lParam2 := TempObject.m_WAbil.MaxHP;
          { TODO -ochongchong -c修改 : 修改打怪下血的飘血效果,经常显示出为几次伤害叠加的效果 【2013-07-24】 }
          // NewMessageBodyWL.lTag1 := ProcessMsg.nParam3;        // 攻击者地址
          NewMessageBodyWL.lTag1 := ProcessMsg.wParam; // 当前血量改变
          // 修正浑水摸鱼地图，英雄受到攻击后，等级为0 2020-05-12 22:21:22
          if (TempObject.m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and (TempObject <> Self) and
            (TempObject <> m_MyHero) then
            NewMessageBodyWL.lTag2 := 0
          else if (TempObject.m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and (TempObject <> Self) and
            (TempObject <> m_MyHero) then
            NewMessageBodyWL.lTag2 := 0
          else
            NewMessageBodyWL.lTag2 := TempObject.m_WAbil.Level; // 受攻击者等级 chongchong 2014-10-27 10:46:50

          NewMessageBodyWL.lTag3 := TempObject.m_WAbil.MaxMP; // 受攻击者最大mp chongchong 2014-10-27 15:43:34
          NewMessageBodyWL.lTag4 := TempObject.m_nCharStatus; // 受攻击者状态
          // 攻击者
          // NewMessageBodyWL.lTag5 := ProcessMsg.nParam3;
          NewMessageBodyWL.lTag5 := 0;
          if ProcessMsg.nParam3 <> 0 then
          begin
            AttackFrom := TBaseObject(ProcessMsg.nParam3);
            if (AttackFrom.m_btRaceServer = RC_PLAYOBJECT) or
              ((AttackFrom.Master <> nil) and (AttackFrom.Master.m_btRaceServer = RC_PLAYOBJECT)) then
              NewMessageBodyWL.lTag5 := NativeInt(AttackFrom);
          end;

          if ProcessMsg.sMsg = BlastHitTypeValues[bhtBlastHit] then
            NewMessageBodyWL.BlastHitType := bhtBlastHit
          else if ProcessMsg.sMsg = BlastHitTypeValues[bhtFatalBlow1] then
            NewMessageBodyWL.BlastHitType := bhtFatalBlow1
          else if ProcessMsg.sMsg = BlastHitTypeValues[bhtFatalBlow2] then
            NewMessageBodyWL.BlastHitType := bhtFatalBlow2
          else if ProcessMsg.sMsg = BlastHitTypeValues[bhtFatalBlow3] then
            NewMessageBodyWL.BlastHitType := bhtFatalBlow3
          else if ProcessMsg.sMsg = BlastHitTypeValues[bhtFatalBlow4] then
            NewMessageBodyWL.BlastHitType := bhtFatalBlow4
          else
            NewMessageBodyWL.BlastHitType := bhtNone;
          NewMessageBodyWL.ResID := -1;
          NewMessageBodyWL.ResStartIdx := -1;

          ErrCode := 23;
          SendSocketEx(@m_DefMsg, @NewMessageBodyWL, SizeOf(TNewMessageBodyWL));
        end;
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TPlayObject:ServerSendStruck, ErrorCode=' + IntToStr(ErrCode));
      MainOutMessage(E.Message);
    end;
  end;
end;

procedure TPlayObject.ServerSendMagicshieldStruck(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  NewMessageBodyWL: TNewMessageBodyWL;
  ErrCode: Integer;
  AttackFrom: TBaseObject;
  BaseObject: TBaseObject;
begin
  ErrCode := 10;
  try
    BaseObject := TBaseObject(ProcessMsg.BaseObject);
