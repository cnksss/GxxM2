procedure TPlayObject.ClientDealTry(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  DealObject: TPlayObject;
  BaseObject: TBaseObject;
begin
  if g_OnlineMsgControl.boDisableTrading then
    Exit;
  if g_Config.boDisableDeal then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sDisableDealItemsMsg);
    Exit;
  end;
  if m_PEnvir.m_boNoDeal then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sMapDisableDealMsg);
    Exit;
  end;
  if m_boDealing then
    Exit;
  if MyGetTickCount - m_DealLastTick < g_Config.dwTryDealTime { 3000 } then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sPleaseTryDealLaterMsg);
    Exit;
  end;
  if not m_boCanDeal then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotTryDealMsg);
    Exit;
  end;
  if m_boIsMobile and (ProcessMsg.nParam1 <> 0) then
    BaseObject := TBaseObject(ProcessMsg.nParam1)
  else
    BaseObject := GetPoseCreate();
  if (BaseObject <> nil) and (BaseObject <> Self) and (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
  begin
    DealObject := TPlayObject(BaseObject);
    if ((BaseObject.GetPoseCreate = Self) or m_boIsMobile) and (not DealObject.m_boDealing) then
    begin
      if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        if (DealObject.m_boAllowDeal and DealObject.m_boCanDeal) then
        begin
          DealObject.SysMsg(m_sCharName + g_sOpenedDealMsg, c_Green, t_Hint);
          SysMsg(DealObject.m_sCharName + g_sOpenedDealMsg, c_Green, t_Hint);
          OpenDealDlg(DealObject);
          DealObject.OpenDealDlg(Self);
        end
        else
        begin
          SysMsg(g_sPoseDisableDealMsg { '对方禁止进入交易' } , c_Red, t_Hint);
        end;
      end;
    end
    else
    begin
      SendDefMessage(SM_DEALTRY_FAIL, 0, 0, 0, 0, '');
    end;
  end
  else
  begin
    SendDefMessage(SM_DEALTRY_FAIL, 0, 0, 0, 0, '');
  end;
end;

procedure TPlayObject.ClientDealAddItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  bo11: Boolean;
  UserItem: pTUserItem;
  sUserItemName: string;
  nMakeIndex: Integer;
  sItemName: string;
begin
  if (m_DealCreat = nil) or (not m_boDealing) then
    Exit;
  nMakeIndex := ProcessMsg.nParam1;
  sItemName := ProcessMsg.sMsg;
  if Pos(' ', sItemName) >= 0 then
  begin // 折分物品名称(信件物品的名称后面加了使用次数)
    GetValidStr3_Ex(sItemName, sItemName, ' ');
  end;
  bo11 := False;
  if not m_DealCreat.m_boDealOK then
  begin
    for I := m_ItemList.Count - 1 downto 0 do
    begin
      if m_ItemList.Count <= 0 then
        Break;
      UserItem := m_ItemList.Items[I];
      if UserItem = nil then
        Continue;
      if UserItem.MakeIndex = nMakeIndex then
      begin
        // 取自定义物品名称
        sUserItemName := '';
        if UserItem.btValue[13] = 1 then
          sUserItemName := UserItem.Name;
        if sUserItemName = '' then
          sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
        if (CompareText(sUserItemName, sItemName) = 0) and (m_DealItemList.Count < 12) then
        begin
          if (GetUserItemBindValue(UserItem, ubNoDeal) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 1) then
          begin
            g_ManageNPC.MessageBox(Self, g_sCanotUserDealItem);
            Break;
          end;
          m_DealItemList.Add(UserItem);
          SendAddDealItem(UserItem);
          m_ItemList.Delete(I);
          bo11 := True;
          Break;
        end;
      end;
    end;
  end;
  if not bo11 then
    SendDefMessage(SM_DEALADDITEM_FAIL, 0, 0, 0, 0, '');
end;

