function TPlayObject.GetMasterNoList: Boolean;
var
  I: Integer;
  LoadList: TStringList;
  sFileName: string;
  s01, s02, s03: string;
  MasterRankInfo: pTMasterRankInfo;
begin
  Result := False;
  try
    sFileName := g_Config.sEnvirDir + 'MasterNo';
    if not DirectoryExists(sFileName) then
      CreateDir(sFileName); // 目录不存在,则创建
    if m_sMasterName <> '' then
    begin // 有师傅,取排名
      sFileName := sFileName + '\' + m_sMasterName + '.txt';
      LoadList := TStringList.Create;
      if FileExists(sFileName) then
      begin
        LoadList.LoadFromFile(sFileName);
        if LoadList.Count > 0 then
        begin // 20080629
          for I := 0 to LoadList.Count - 1 do
          begin
            s01 := Trim(LoadList.Strings[I]);
            if (s01 <> '') and (s01[1] <> ';') then
            begin
              s01 := GetValidStr3(s01, s02, [' ', #9]); // 徒弟名
              s01 := GetValidStr3(s01, s03, [' ', #9]); // 排行
              if s02 <> '' then
              begin
                if CompareText(m_sCharName, s02) = 0 then
                begin
                  m_nMasterNo := Str_ToInt(s03, 0);
                  Result := True;
                  Break;
                end;
              end;
            end; // if (s01 <> '') and (s01[1] <> ';') then begin
          end; // for
        end;
      end; // if FileExists(sFileName)
      LoadList.Free;
    end
    else if m_boMaster then
    begin // 有徒弟,取列表内容
      sFileName := sFileName + '\' + m_sCharName + '.txt';
      LoadList := TStringList.Create;
      if FileExists(sFileName) then
      begin
        LoadList.LoadFromFile(sFileName);
        if LoadList.Count > 0 then
        begin // 20080629
          for I := 0 to LoadList.Count - 1 do
          begin
            s01 := Trim(LoadList.Strings[I]);
            if (s01 <> '') and (s01[1] <> ';') then
            begin
              s01 := GetValidStr3(s01, s02, [' ', #9]); // 徒弟名
              s01 := GetValidStr3(s01, s03, [' ', #9]); // 排行
              if s02 <> '' then
              begin
                New(MasterRankInfo);
                MasterRankInfo.ID := StrToIntDef(s03, 0);
                MasterRankInfo.sChrName := s02;
                m_MasterNoList.Add(MasterRankInfo);
              end;
            end; // if (s01 <> '') and (s01[1] <> ';') then begin
          end; // for
        end;
        Result := True;
      end; // if FileExists(sFileName)
      LoadList.Free;
    end;
  except
    MainOutMessage('{异常} TPlayObject.GetMasterNoList');
  end;
end;

// 保存师徒文件 chongchong 2014-10-11
procedure TPlayObject.SaveMasterNoList();
var
  I: Integer;
  SaveList: TStringList;
  sFileName: string;
  MasterRankInfo: pTMasterRankInfo;
begin
  try
    sFileName := g_Config.sEnvirDir + 'MasterNo';
    if not DirectoryExists(sFileName) then
      CreateDir(sFileName); // 目录不存在,则创建
    if m_boMaster then
    begin // 有徒弟才能保存列表
      sFileName := sFileName + '\' + m_sCharName + '.txt';
      SaveList := TStringList.Create();
      MasterNoListQuickSort(True); // 排序
      if m_MasterNoList.Count > 0 then
      begin // 20080629
        for I := 0 to m_MasterNoList.Count - 1 do
        begin
          MasterRankInfo := m_MasterNoList.Items[I];
          SaveList.Add(MasterRankInfo.sChrName + ' ' + IntToStr(MasterRankInfo.ID));
        end;
      end;
      SaveList.SaveToFile(sFileName);
      SaveList.Free;
    end;
  except
    MainOutMessage('{异常} TPlayObject.SaveMasterNoList');
  end;
end;

