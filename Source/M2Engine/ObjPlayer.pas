// 师徒数据排序  chongchong 2014-10-11(用于徒弟出师,收徒后进行排名的排序)
procedure TPlayObject.MasterNoListQuickSort(Order: Boolean);

  function SCompare(List: TList; Index1, Index2: Integer): Integer;
  var
    RankInfo1, RankInfo2: pTMasterRankInfo;
  begin
    RankInfo1 := List.Items[Index1];
    RankInfo2 := List.Items[Index2];
    Result := RankInfo1.ID - RankInfo2.ID;
  end;

  procedure QuickSort(List: TList; L, R: Integer);
  var
    I, J, P: Integer;
  begin
    repeat
      I := L;
      J := R;
      P := (L + R) shr 1;
      repeat
        while SCompare(List, I, P) < 0 do
          Inc(I);
        while SCompare(List, J, P) > 0 do
          Dec(J);
        if I <= J then
        begin
          if I <> J then
          begin
            List.Exchange(I, J);
          end;

          if P = I then
            P := J
          else if P = J then
            P := I;
          Inc(I);
          Dec(J);
        end;
      until I > J;
      if L < J then
        QuickSort(List, L, J);
      L := I;
    until I >= R;
  end;

var
  I: Integer;
  MasterRankInfo: pTMasterRankInfo;
begin
  if m_MasterNoList.Count > 1 then
  begin
    QuickSort(m_MasterNoList, 0, m_MasterNoList.Count - 1);
    if m_MasterNoList.Count > 0 then
    begin // 20080629
      for I := 0 to m_MasterNoList.Count - 1 do
      begin
        MasterRankInfo := pTMasterRankInfo(m_MasterNoList.Items[I]);
        MasterRankInfo.ID := I + 1;
      end;
    end;
  end;
end;

