procedure TPlayObject.ClientHeroChangeMagicKey(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  HeroObject: THeroObject;
  MagicAttr: TMagicAttr;
  I, J: Integer;
  UserMagic: pTUserMagic;
  CopyMon: TCopyMon;
begin
  if m_MyHero = nil then
    Exit;
  HeroObject := THeroObject(m_MyHero);
  MagicAttr := TMagicAttr(ProcessMsg.wParam);
  with HeroObject do
  begin
    for I := 0 to m_MagicList.Count - 1 do
    begin
      UserMagic := m_MagicList.Items[I];
      if (UserMagic.MagicInfo.wMagicId = ProcessMsg.nParam1) and (UserMagic.MagicAttr = MagicAttr) then
      begin
        if UserMagic.btKey = 0 then
          UserMagic.btKey := VK_F1
        else
          UserMagic.btKey := 0;
        Break;
      end;
    end;
    { 实时开关英雄分身技能 chongchong 2013-09-15 }
    for I := 0 to m_SlaveList.Count - 1 do
    begin
      if TBaseObject(m_SlaveList.Items[I]).m_btRaceServer = RC_PLAYMOSTER then
      begin
        CopyMon := m_SlaveList.Items[I];
        { 实时开启、关闭分身技能 }
        for J := 0 to CopyMon.m_MagicList.Count - 1 do
        begin
          UserMagic := CopyMon.m_MagicList.Items[J];
          if (UserMagic.MagicInfo.wMagicId = ProcessMsg.nParam1) and (UserMagic.MagicAttr = MagicAttr) then
          begin
            if UserMagic.btKey = 0 then
              UserMagic.btKey := VK_F1
            else
              UserMagic.btKey := 0;
          end;
        end;
      end;
    end;
  end;
end;

procedure TPlayObject.ClientHeroProTect(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nX, nY: Integer;
begin
  nX := ProcessMsg.nParam2;
  nY := ProcessMsg.nParam3;
  if m_boOffLine or m_boWaitHeroDate or m_boGhost { or m_boDeath } then
    Exit;
  if (m_MyHero <> nil) and (m_MyHero.m_boDeath or m_MyHero.m_boGhost) then
    Exit;
  if (THeroObject(m_MyHero) <> nil) and (m_MyHero.m_WAbil.Level >= g_Config.nNeedGuardLevel) then
  begin
    { TODO -ochongchong -c添加 : 禁止英雄安全区守护 【2013-08-11】 }
    if g_Config.boHeroDisableSafeZoneProtect and
    { (not THeroObject(m_MyHero).m_boProtectStatus) and 不取消守护 }
      InSafeZone(m_PEnvir, nX, nY) then
    begin
      THeroObject(m_MyHero).SysMsg('系统不允许英雄在安全区守护', c_Red, t_Hint);
      Exit;
    end;
    if { (not THeroObject(m_MyHero).m_boProtectStatus) and 不取消守护 } (not m_PEnvir.CanWalk(nX, nY, True)) then
    begin
      THeroObject(m_MyHero).SysMsg(g_sHeroProtectNoWalk, 255, 249, t_Hint);
      Exit;
    end;
    if m_PEnvir.m_boNoHeroProtect { and (not THeroObject(m_MyHero).m_boProtectStatus) 不取消守护 } then
    begin
      THeroObject(m_MyHero).SysMsg('当前地图禁止守护', c_Red, t_Hint);
      Exit;
    end;
    THeroObject(m_MyHero).m_boProtectStatus := True; // not THeroObject(m_MyHero).m_boProtectStatus 不取消守护;
    if THeroObject(m_MyHero).m_boProtectStatus then
    begin
      if (m_PEnvir <> m_MyHero.m_PEnvir) or ((abs(m_nCurrX - m_MyHero.m_nCurrX) >= g_Config.nHeroProtectFlyRange) or
        (abs(m_nCurrY - m_MyHero.m_nCurrY) >= g_Config.nHeroProtectFlyRange)) then
        THeroObject(m_MyHero).SpaceMove(m_PEnvir.sMapName, nX, nY, 1);
      THeroObject(m_MyHero).m_dwProtectTargetTick := MyGetTickCount;
      THeroObject(m_MyHero).m_nProtectTargetX := nX;
      THeroObject(m_MyHero).m_nProtectTargetY := nY;
      THeroObject(m_MyHero).m_boSlaveRelax := False; // 解除休息
      if THeroObject(m_MyHero).m_btAttackMode <> 0 then
      begin
        THeroObject(m_MyHero).m_btAttackMode := 0; // 切换到攻击模式
        m_MyHero.SendMsg(m_MyHero, RM_HERO_ATTACK_MODE, 0, MakeWord(255, 252), 0, 0, '');
      end;
      THeroObject(m_MyHero).ResetTempMoveStatus;
      THeroObject(m_MyHero).SysMsg(Format(g_sHeroProtect, [nX, nY]), 255, 252, t_Hint);
      THeroObject(m_MyHero).m_boProtectOK := False;
    end;
    { 不取消守护
      else
      begin
      THeroObject(m_MyHero).m_nProtectTargetX := -1;
      THeroObject(m_MyHero).m_nProtectTargetY := -1;
      THeroObject(m_MyHero).SysMsg(g_sHeroNotProtect, c_Green, t_Hint);
      end;
    }
  end;
end;

procedure TPlayObject.ClientSlaveTarget(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  sMsg, sLockObjName: string;
  BaseObject, BBObj: TBaseObject;
  IsClientSendObj: Boolean;
  nX, nY: Integer;
  Index, I: Integer;
  Code: Integer;
  btDir: Byte;
begin
  if not g_Config.boSlaveLockTarget then
    Exit;
  Code := 0;
  try
    BaseObject := TBaseObject(ProcessMsg.nParam1);
    IsClientSendObj := BaseObject <> nil;
    if BaseObject <> nil then
    begin
      if not m_PEnvir.IsValidObjectEx(m_nCurrX, m_nCurrY, 10, BaseObject) then
        BaseObject := nil;
    end;
    nX := ProcessMsg.nParam2;
    nY := ProcessMsg.nParam3;
    if m_boOffLine or m_boGhost then
      Exit;
    if (BaseObject = nil) and (m_TargetCret <> nil) then
      BaseObject := m_TargetCret;
    if (BaseObject = nil) then
      BaseObject := TBaseObject(m_PEnvir.GetMovingObject(nX, nY, False));
    if BaseObject = nil then
      Exit;
    if (abs(BaseObject.m_nCurrX - m_nCurrX) > g_Config.nHeroTargetRangeLimit) or
      (abs(BaseObject.m_nCurrY - m_nCurrY) > g_Config.nHeroTargetRangeLimit) then
    begin
      if g_sLockTargetRangeLimit <> '' then
      begin
        SysMsg(g_sLockTargetRangeLimit, 255, 249, t_Hint)
      end;
      Exit;
    end;
    // 修复英雄锁定假人费劲的问题 chongchong 2014-01-17
    if IsClientSendObj or CretInNearXY(BaseObject, nX, nY, 2) then
    begin
      if g_Config.boSlaveNoLockHuman then
      begin
        if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
          Exit;
      end;
      Code := 7;
      if (BaseObject <> Self) and (BaseObject <> m_MyHero) then
      begin
        Code := 8;
        if (BaseObject.m_btRaceServer < RC_NPC) or (BaseObject.m_btRaceServer > RC_PEACENPC) then
        begin
          // if (BaseObject.m_btRaceServer <> 110) and     // 城门
          // (BaseObject.m_btRaceServer <> 111) then     // 城墙
          begin
            Code := 9;
            if g_Config.boSafeNoAllowTargetBB and (BaseObject.m_Master <> nil) and BaseObject.InSafeZone and
              IsProperFriend(BaseObject) then
              Exit;
            // 英雄只锁定主人攻击掉血的目标 chongchong 2015-08-04
            if not IsProperTarget(BaseObject) then
              Exit;
            // 禁止锁定其他宝宝 chongchong 2016-05-04
            if BaseObject.Master = Self then
              Exit;
            if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              if g_Config.boSlaveNotAttackHuman then
                Exit;
            end
            else if (BaseObject.m_btRaceServer = RC_HEROOBJECT) then
            begin
              if g_Config.boSlaveNotAttackHero then
                Exit;
            end;
            m_boSlaveRelax := False; // 解除休息
            for Index := 0 to m_SlaveList.Count - 1 do
            begin
              BBObj := m_SlaveList.Items[Index];
              if BBObj = nil then
                Continue;
              if BBObj.m_boDeath or BBObj.m_boGhost then
                Continue;
              Code := 12;
              // 锁定攻击目标，当宝宝和主要相隔较远时，宝宝先飞过来 chongchong 2013-12-21
              BBObj.DelTargetCreat;
              if (BBObj.m_PEnvir <> m_PEnvir) or (abs(m_nCurrX - BBObj.m_nCurrX) > 20) or (abs(m_nCurrY - BBObj.m_nCurrY) > 20)
              then
              begin
                Code := 13;
                btDir := GetNextDirection(m_nCurrX, m_nCurrY, BaseObject.m_nCurrX, BaseObject.m_nCurrY);
                GetBackPosition(btDir, BaseObject.m_nCurrX, BaseObject.m_nCurrY, nX, nY, 2);
                // GetBackPosition(nX, nY);
                if not m_PEnvir.CanWalk(nX, nY, True) then
                begin
                  for I := 0 to 7 do
                  begin
                    if m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, I, 1, nX, nY) then
                    begin
                      if m_PEnvir.CanWalk(nX, nY, True) then
                      begin
                        Break;
                      end;
                    end;
                  end;
                end;
                Code := 14;
                BBObj.SpaceMove(m_PEnvir.sMapName, nX, nY, 1);
              end;
              { TODO -ochongchong -c增加 : 根据攻击模式来判断是否可以锁定对象 【2013-08-25】 }
              SetTargetCreat(BaseObject);
              if BBObj <> BaseObject then
              begin
                BBObj.SetTargetCreat(BaseObject);
                BBObj.m_boTarget := True;
              end;
            end;
            // 不能控制宠物锁定目标 2019-05-07 11:38:52
            if (m_MyGamePet <> nil) and (not m_MyGamePet.m_boDeath) and (not m_MyGamePet.m_boGhost) and
              (g_Config.boEnabledPetAttack or (m_boEnabledPetAttack = 1)) then
            begin
              Code := 12;
              // 锁定攻击目标，当宝宝和主要相隔较远时，宝宝先飞过来 chongchong 2013-12-21
              m_MyGamePet.DelTargetCreat;
              if (m_MyGamePet.m_PEnvir <> m_PEnvir) or (abs(m_nCurrX - m_MyGamePet.m_nCurrX) > 20) or
                (abs(m_nCurrY - m_MyGamePet.m_nCurrY) > 20) then
              begin
                Code := 13;
                btDir := GetNextDirection(m_nCurrX, m_nCurrY, BaseObject.m_nCurrX, BaseObject.m_nCurrY);
                GetBackPosition(btDir, BaseObject.m_nCurrX, BaseObject.m_nCurrY, nX, nY, 2);
                // GetBackPosition(nX, nY);
                if not m_PEnvir.CanWalk(nX, nY, True) then
                begin
                  for I := 0 to 7 do
                  begin
                    if m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, I, 1, nX, nY) then
                    begin
                      if m_PEnvir.CanWalk(nX, nY, True) then
                      begin
                        Break;
                      end;
                    end;
                  end;
                end;
                Code := 14;
                m_MyGamePet.SpaceMove(m_PEnvir.sMapName, nX, nY, 1);
              end;
              { TODO -ochongchong -c增加 : 根据攻击模式来判断是否可以锁定对象 【2013-08-25】 }
              SetTargetCreat(BaseObject);
              if m_MyGamePet <> BaseObject then
              begin
                m_MyGamePet.SetTargetCreat(BaseObject);
                m_MyGamePet.m_boTarget := True;
              end;
            end;
            if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and
              (m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName) > 0) then
            begin
              sLockObjName := m_PEnvir.m_sSecretShowName;
            end
            else if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and
              (m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName2) > 0) then
            begin
              sLockObjName := m_PEnvir.m_sSecretShowName2;
            end
            else
            begin
              Code := 20;
              sLockObjName := BaseObject.m_sCharName;
              if not(BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
              begin
                for I := Length(sLockObjName) downto 1 do
                begin
{$IF CompilerVersion >= 22}
                  if not CharInSet(sLockObjName[I], ['0' .. '9']) then
{$ELSE}
                  if not(sLockObjName[I] in ['0' .. '9']) then
{$IFEND}
                  begin
                    sLockObjName := Copy(sLockObjName, 1, I);
                    Break;
                  end;
                end;
                if Length(sLockObjName) = 0 then
                  sLockObjName := BaseObject.m_sCharName;
              end;
            end;
            Code := 21;
            if (BaseObject.m_btRaceServer = RC_HEROOBJECT) and (BaseObject.m_Master <> nil) then
            begin
              if ((m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName) > 0)) or
                ((m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName2) > 0)) then
              begin
                sMsg := '攻击目标: %s';
                SysMsg(Format(sMsg, [sLockObjName]), 255, 249, t_Hint)
              end
              else
              begin
                sMsg := '攻击目标: %s 的英雄:%s';
                SysMsg(Format(sMsg, [BaseObject.m_Master.m_sCharName, sLockObjName]), 255, 249, t_Hint)
              end;
            end
            else
            begin
              sMsg := '攻击目标: %s';
              SysMsg(Format(sMsg, [sLockObjName]), 255, 249, t_Hint)
            end;
            Exit;
          end;
        end;
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage('TPlayObject.ClientSlaveTarget' + IntToStr(Code));
      MainOutMessage(E.Message);
    end;
  end;
end;

