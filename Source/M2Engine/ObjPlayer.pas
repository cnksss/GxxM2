procedure TPlayObject.ClientTakeOnJewelry(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  sUserItemName: string;
  nMakeIndex: Integer;
  sItemName, sTakeOffItemName: string;
  StdItem, StdItem2: pTStdItem;
  JewelryIndex: Integer;
  OldJewelryItem: pTUserItem;
  TakeOffItem: TUserItem;
begin
  nMakeIndex := ProcessMsg.nParam1;
  JewelryIndex := ProcessMsg.nParam2;
  sItemName := DecodeString(ProcessMsg.sMsg);
  if m_boOffLine or m_boGhost or (not(JewelryIndex in [Low(THumanJewelryBoxItems) .. High(THumanJewelryBoxItems)])) then
  begin
    SendDefMessage(SM_TAKEONJEWELRY_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  OldJewelryItem := nil;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if UserItem.MakeIndex = nMakeIndex then
    begin
      // 取自定义物品名称
      if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
        sUserItemName := UserItem.Name
      else
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (StdItem <> nil) and (CompareText(sUserItemName, sItemName) = 0) then
      begin
        { TODO -ochongchong -c新增 : 物品规则 - 英雄物品【2013-07-27】 }
        if g_ItemRules.Get(UserItem.wIndex, 16) then
        begin
          SendDefMessage(SM_TAKEONJEWELRY_FAIL, 0, 0, 0, 0, '');
          SysMsg(g_sOnlyHeroDress, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
          Exit;
        end;
        if (StdItem.Overlap and 2 <> 0) and ((StdItem.Expand1 = JewelryIndex + 1) or (StdItem.Expand1 in [0, 7])) and
          (GetTakeOnPosition(StdItem.StdMode) in [U_HELMET { 头盔 } , U_NECKLACE { 项链 } , U_ARMRINGL { 左手镯 } , U_ARMRINGR { 右手镯 } ,
          U_RINGL { 左戒指 } , U_RINGL { 右戒指 } ]) then
        begin
          if not CheckTakeOnItems(U_JEWELRYITEM1 + JewelryIndex, StdItem) then
          begin
            SendDefMessage(SM_TAKEONJEWELRY_FAIL, 0, 0, 0, 0, '');
            Exit;
          end;
          if m_JewelryBoxItems[JewelryIndex].wIndex > 0 then
          begin
            if InDisableTakeOffList(m_JewelryBoxItems[JewelryIndex].wIndex) or
              (GetUserItemBindValue(@m_JewelryBoxItems[JewelryIndex], ubNoTakeOff) and m_JewelryBoxItems[JewelryIndex].boIsBind)
            then
            begin
              SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
              SendDefMessage(SM_TAKEONJEWELRY_FAIL, 0, 0, 0, 0, '');
              Exit;
            end;
            if (m_JewelryBoxItems[JewelryIndex].btValue[13] = 1) and (m_JewelryBoxItems[JewelryIndex].Name <> '') then
              sUserItemName := m_JewelryBoxItems[JewelryIndex].Name
            else
              sUserItemName := UserEngine.GetStdItemName(m_JewelryBoxItems[JewelryIndex].wIndex);
            m_nCurrentItemMakeIndex := m_JewelryBoxItems[JewelryIndex].MakeIndex;
            m_nCurrentItemPos := JewelryIndex + U_JEWELRYITEM1;
            m_sCurrentItemName := UserEngine.GetStdItemName(m_JewelryBoxItems[JewelryIndex].wIndex);
            m_sCurrentItemNewName := sUserItemName;
            m_PickUpOrDropItem := m_JewelryBoxItems[JewelryIndex];
            m_boStopTakeOff := False;
            g_FunctionNPC.GotoLable(Self, '@BeginTakeOff', False);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
            if m_boStopTakeOff then
            begin
              SendDefMessage(SM_TAKEONJEWELRY_FAIL, 0, 0, 0, 0, '');
              Exit;
            end;
          end;
          if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
            sUserItemName := UserItem.Name
          else
            sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
          m_nCurrentItemMakeIndex := UserItem.MakeIndex;
          m_nCurrentItemPos := JewelryIndex + U_JEWELRYITEM1;
          m_sCurrentItemName := UserEngine.GetStdItemName(UserItem.wIndex);
          m_sCurrentItemNewName := sUserItemName;
          m_PickUpOrDropItem := UserItem^;
          m_boStopTakeOn := False;
          g_FunctionNPC.GotoLable(Self, '@BeginTakeOn', False);
          m_PickUpOrDropItem.MakeIndex := 0;
          m_PickUpOrDropItem.wIndex := 0;
          m_nCurrentItemMakeIndex := 0;
          m_nCurrentItemPos := 0;
          m_sCurrentItemName := '';
          m_sCurrentItemNewName := '';
          if m_boStopTakeOn then
          begin
            SendDefMessage(SM_TAKEONJEWELRY_FAIL, 0, 0, 0, 0, '');
            Exit;
          end;
          if m_JewelryBoxItems[JewelryIndex].wIndex > 0 then
          begin
            New(OldJewelryItem);
            OldJewelryItem^ := m_JewelryBoxItems[JewelryIndex];
            TakeOffItem := OldJewelryItem^;
            // 将首饰盒的物品放到包裹中
            if AddItemToBag(OldJewelryItem) then
            begin
              SendAddItem(OldJewelryItem);
            end
            else
            begin
              Dispose(OldJewelryItem);
              SendDefMessage(SM_TAKEONJEWELRY_FAIL, 0, 0, 0, 0, '');
              Exit;
            end;
            if (g_FunctionNPC <> nil) then
            begin
              if (TakeOffItem.btValue[13] = 1) and (TakeOffItem.Name <> '') then
                sTakeOffItemName := TakeOffItem.Name
              else
                sTakeOffItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
              m_nCurrentItemMakeIndex := TakeOffItem.MakeIndex;
              m_nCurrentItemPos := JewelryIndex + U_JEWELRYITEM1;
              m_sCurrentItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
              m_sCurrentItemNewName := sTakeOffItemName;
              m_nScriptGotoCount := 0;
              m_PickUpOrDropItem := TakeOffItem;
              g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(JewelryIndex + U_JEWELRYITEM1), False);
              g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
              m_PickUpOrDropItem.MakeIndex := 0;
              m_PickUpOrDropItem.wIndex := 0;
              m_nCurrentItemMakeIndex := 0;
              m_nCurrentItemPos := 0;
              m_sCurrentItemName := '';
              m_sCurrentItemNewName := '';
            end;
          end;
          // 删除包裹中的原物品
          m_ItemList.Delete(I);
          if OldJewelryItem <> nil then
          begin
            m_JewelryBoxItems[JewelryIndex].wIndex := 0;
            StdItem2 := UserEngine.GetStdItem(OldJewelryItem.wIndex);
            if StdItem2 <> nil then
              ProcessUseItemSkill(U_JEWELRYITEM1 + JewelryIndex, StdItem2, False);
          end;
          // 将包裹中的物品放到首饰盒中
          m_JewelryBoxItems[JewelryIndex] := UserItem^;
          SendDefMessage(SM_TAKEONJEWELRY_OK, 0, 0, 0, 0, '');
          ProcessUseItemSkill(U_JEWELRYITEM1 + JewelryIndex, StdItem, True);
          if (StdItem.Need in [101, 102]) and (not UserItem.boStartTime) then
          begin
            UserItem.nLimitTime := StdItem.NeedLevel;
            UserItem.boStartTime := True;
            SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System);
          end;
          if g_FunctionNPC <> nil then
          begin
            m_nScriptGotoCount := 0;
            m_nCurrentItemMakeIndex := UserItem.MakeIndex;
            m_nCurrentItemPos := JewelryIndex + U_JEWELRYITEM1;
            m_sCurrentItemName := StdItem.Name;
            m_sCurrentItemNewName := sUserItemName;
            g_FunctionNPC.GotoLable(Self, '@TakeOn' + IntToStr(JewelryIndex + U_JEWELRYITEM1), False);
            g_FunctionNPC.GotoLable(Self, '@TakeOnEx', False);
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
          end;
          Dispose(UserItem);
          RecalcAbilitys();
          WeightChanged;
          SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
          SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
          FeatureChanged;
          Exit;
        end;
      end;
    end;
  end;
  SendDefMessage(SM_TAKEONJEWELRY_FAIL, 0, 0, 0, 0, '');
end;

procedure TPlayObject.ClientTakeOffJewelry(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  // nMakeIndex: Integer;
  JewelryIndex: Integer;
  OldJewelryItem: pTUserItem;
  StdItem: pTStdItem;
  sTakeOffItemName: string;
begin
  // nMakeIndex := ProcessMsg.nParam1;
  JewelryIndex := ProcessMsg.nParam2;
  // sItemName := DecodeString(ProcessMsg.sMsg);
  if m_boOffLine or m_boGhost or (not(JewelryIndex in [Low(THumanJewelryBoxItems) .. High(THumanJewelryBoxItems)])) then
  begin
    SendDefMessage(SM_TAKEOFFJEWELRY_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  if m_JewelryBoxItems[JewelryIndex].wIndex > 0 then
  begin
    if InDisableTakeOffList(m_JewelryBoxItems[JewelryIndex].wIndex) or
      (GetUserItemBindValue(@m_JewelryBoxItems[JewelryIndex], ubNoTakeOff) and m_JewelryBoxItems[JewelryIndex].boIsBind) then
    begin
      SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
      SendDefMessage(SM_TAKEOFFJEWELRY_FAIL, 0, 0, 0, 0, '');
      Exit;
    end;
    New(OldJewelryItem);
    OldJewelryItem^ := m_JewelryBoxItems[JewelryIndex];
    // 将首饰盒的物品移到包裹中
    if AddItemToBag(OldJewelryItem) then
    begin
      SendAddItem(OldJewelryItem);
      m_JewelryBoxItems[JewelryIndex].wIndex := 0;
      StdItem := UserEngine.GetStdItem(OldJewelryItem.wIndex);
      if (g_FunctionNPC <> nil) then
      begin
        if (OldJewelryItem.btValue[13] = 1) and (OldJewelryItem.Name <> '') then
          sTakeOffItemName := OldJewelryItem.Name
        else if StdItem <> nil then
          sTakeOffItemName := StdItem.Name;
        m_nCurrentItemMakeIndex := OldJewelryItem.MakeIndex;
        m_nCurrentItemPos := U_JEWELRYITEM1 + JewelryIndex;
        m_sCurrentItemName := StdItem.Name;
        m_sCurrentItemNewName := sTakeOffItemName;
        m_nScriptGotoCount := 0;
        m_PickUpOrDropItem := OldJewelryItem^;
        g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(U_JEWELRYITEM1 + JewelryIndex), False);
        g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
        m_PickUpOrDropItem.MakeIndex := 0;
        m_PickUpOrDropItem.wIndex := 0;
        m_nCurrentItemMakeIndex := 0;
        m_nCurrentItemPos := 0;
        m_sCurrentItemName := '';
        m_sCurrentItemNewName := '';
      end;
      if StdItem <> nil then
        ProcessUseItemSkill(U_JEWELRYITEM1 + JewelryIndex, StdItem, False);
      SendDefMessage(SM_TAKEOFFJEWELRY_OK, 0, 0, 0, 0, '');
      RecalcAbilitys();
      SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
      SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
      FeatureChanged;
      Exit;
    end
    else
    begin
      Dispose(OldJewelryItem);
    end;
  end;
  SendDefMessage(SM_TAKEOFFJEWELRY_FAIL, 0, 0, 0, 0, '');
end;

