procedure TPlayObject.SendJoinUserListToClient;
var
  I: Integer;
  InBuf: array [0 .. 10240] of AnsiChar;
  GuildJoinUser, GuildJoinUser2: PGuildJoinUser;
begin
  if m_SendJoinUserList.Count = 0 then
  begin
    m_DefMsg := MakeDefaultMsg(SM_GUILDGETJOINUSERLIST, NativeInt(Self), 0, m_nJoinUserPage, 0);
    SendSocket(@m_DefMsg, '');
  end
  else
  begin
    GuildJoinUser := @InBuf;
    for I := 0 to m_SendJoinUserList.Count - 1 do
    begin
      GuildJoinUser2 := m_SendJoinUserList.Items[I];

      GuildJoinUser^ := GuildJoinUser2^;
      Inc(GuildJoinUser);
    end;

    m_DefMsg := MakeDefaultMsg(SM_GUILDGETJOINUSERLIST, NativeInt(Self), m_SendJoinUserList.Count * SizeOf(TGuildJoinUser),
      m_nJoinUserPage, m_SendJoinUserList.Count);

    SendSocketEx(@m_DefMsg, @InBuf, m_SendJoinUserList.Count * SizeOf(TGuildJoinUser));
  end;
end;

function TPlayObject.ClientUseItmeToWealthAnimalMon(nItemIdx, nX, nY: Integer; TargeTBaseObject: TBaseObject): Boolean;

  function CheckWealthAnimalMon(Rate: Byte; nDamage { 杀伤力 } : Integer; var boToMon: Boolean): Boolean;
  var
    WealthAnimalMon: TBaseObject;
  begin
    SendRefMsg(RM_SPELL, 10, nX, nY, 60000, '');

    Result := False;
    // if m_boShowCattleGas then
    begin
      WealthAnimalMon := TargeTBaseObject;
      if WealthAnimalMon <> nil then
      begin
        if (not WealthAnimalMon.m_boDeath) and (not WealthAnimalMon.m_boGhost) then
        begin
          if IsProperTarget(WealthAnimalMon) then
          begin
            if (WealthAnimalMon.m_btRaceServer = 79) then
            begin // 目标为富贵兽
              Result := True;
              if Random(Rate) = 0 then
              begin // 是否机率可以打怪掉血
                WealthAnimalMon.SetLastHiter(Self);
                TWealthAnimalMon(WealthAnimalMon).StruckDamage1(nDamage, Self); // 富贵兽掉血
              end;

              if WealthAnimalMon.m_boCrazyMode then
                boToMon := True;

              WealthAnimalMon.SendDelayMsg(TBaseObject(RM_STRUCK), RM_10101, nDamage, WealthAnimalMon.m_WAbil.HP,
                WealthAnimalMon.m_WAbil.MaxHP, NativeInt(Self), '', Max(abs(m_nCurrX - WealthAnimalMon.m_nCurrX),
                abs(m_nCurrY - WealthAnimalMon.m_nCurrY)) * 50);

              SendRefMsg(RM_MAGICFIRE, 0, MakeWord(8, 99), MakeLong(WealthAnimalMon.m_nCurrX, WealthAnimalMon.m_nCurrY),
                Integer(WealthAnimalMon), ''); // 发消息给客户端显示打中怪的效果
            end;
          end;
        end;
      end;
    end;

    if not Result then
    begin
      SendRefMsg(RM_MAGICFIREFAIL, 0, 0, 0, 0, '');
      // if m_boShowCattleGas then SysMsg('你周围并没有富贵兽', c_Blue, t_Say);
    end;
  end;

var
  I, UserItemIndex: Integer;
  TempUserItem, UserItem: pTUserItem;
  UserItem34: TUserItem;
  StdItem: pTStdItem;
  boEatOK, boChangeDura, boChangeWeight, boUseItmeToMon1: Boolean;
  NewWeight: Byte;
begin
  Result := False;
  if (nX < 0) or (nY < 0) or m_boDeath or m_boGhost or (nItemIdx <= 0) or (not m_boCanUseItem) then
  begin
    SendDefMessage(SM_EAT_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;

  boEatOK := False;
  boChangeDura := False;
  boChangeWeight := False;

  UserItem := nil;
  UserItemIndex := 0;
  NewWeight := 0;

  for I := m_ItemList.Count - 1 downto 0 do
  begin
    if m_ItemList.Count <= 0 then
      Break;

    TempUserItem := m_ItemList.Items[I];
    if TempUserItem = nil then
      Continue;

    if TempUserItem.MakeIndex = nItemIdx then
    begin
      UserItemIndex := I;
      UserItem := TempUserItem;
      Break;
    end;
  end;

  if UserItem <> nil then
    StdItem := UserEngine.GetStdItem(UserItem.wIndex)
  else
    StdItem := nil;

  if StdItem <> nil then
  begin
    UserItem34 := UserItem^;

    if (StdItem.StdMode = 95) and CheckWealthAnimalMon(StdItem.Reserved, StdItem.AC1, boUseItmeToMon1) then
    begin
      if UserItem.Dura >= 1000 then
        Dec(UserItem.Dura, 1000)
      else
        UserItem.Dura := 0;

      if UserItem.Dura <= 0 then
      begin
        m_ItemList.Delete(UserItemIndex);
        Dispose(UserItem);
        boEatOK := True;
      end
      else
      begin
        boChangeDura := True;

        boChangeWeight := True;
        NewWeight := OverLapItemWeight(StdItem, UserItem.Dura);
      end;
    end;
  end;

  if boEatOK then
  begin
    WeightChanged();
    SendDefMessage(SM_EAT_OK, nItemIdx, 0, 0, 0, '');

    if StdItem.NeedIdentify = 1 then
      AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, UserItem34.MakeIndex, '0', 0, 0, '物品用完');
  end
  else
  begin
    if boChangeDura then
      SendDefMessage(SM_EAT_FAIL, UserItem34.MakeIndex, UserItem34.Dura, UserItem34.DuraMax,
        MakeWord(Integer(boChangeWeight), NewWeight), '')
    else
      SendDefMessage(SM_EAT_FAIL, 0, 0, 0, 0, '');
  end;
end;

