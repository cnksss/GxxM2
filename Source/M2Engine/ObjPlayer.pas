    if g_Config.boShowRefreshBagMsg then
      THeroObject(m_MyHero).SysMsg('包裹刷新成功.', 255, 253, t_Hint);
  end
  else
  begin
    if g_Config.boShowRefreshBagMsg then
      THeroObject(m_MyHero).SysMsg('操作过于频繁，请稍后在试.', 255, 253, t_Hint);
  end;
end;

procedure TPlayObject.ClientOpenDoor(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  Door: TDoorObject;
  Castle: TUserCastle;
begin
  Door := m_PEnvir.GetDoor(ProcessMsg.nParam2, ProcessMsg.nParam3);
  if Door = nil then
    Exit;
  Castle := g_CastleManager.IsCastleEnvir(m_PEnvir);
  if (Castle = nil) or (Castle.m_DoorStatus <> Door.m_Status) or (m_btRaceServer <> RC_PLAYOBJECT) or
    ((Castle <> nil) and Castle.CheckInPalace(m_nCurrX, m_nCurrY, Self)) then
  begin
    UserEngine.OpenDoor(m_PEnvir, m_nViewRange, ProcessMsg.nParam2, ProcessMsg.nParam3);
  end;
end;

