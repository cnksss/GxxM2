procedure TPlayObject.ClientGuildGetJoinUserList(ProcessMsg: pTProcessMessage; var boResult: Boolean);
const
  PageCount = 8;
var
  I: Integer;
  WantAddMember: PWantAddMember;
  GuildJoinUser: PGuildJoinUser;
  MyGuild: TGUild;
  PlayObject: TPlayObject;
  StartIndex, EndIndex: Integer;
  sSendNames: string;
begin
  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    Exit;

  ClearSendJoinUserList;
  MyGuild := TGUild(m_MyGuild);
  sSendNames := '';
  StartIndex := ProcessMsg.nParam1 * PageCount;
  if StartIndex >= MyGuild.WantAddMemberCount then
  begin
    StartIndex := ((MyGuild.WantAddMemberCount + PageCount - 1) div PageCount - 1) * PageCount;
    if StartIndex < 0 then
      StartIndex := 0;
  end;

  EndIndex := Min(StartIndex + PageCount - 1, MyGuild.WantAddMemberCount - 1);
  m_nJoinUserPage := StartIndex div PageCount;
  for I := StartIndex to EndIndex do
  begin
    WantAddMember := MyGuild.WantAddMemebers[I];
    New(GuildJoinUser);
    m_SendJoinUserList.Add(GuildJoinUser);
    GuildJoinUser.sUserName := WantAddMember.UserName;
    PlayObject := UserEngine.GetPlayObject(GuildJoinUser.sUserName);
    if PlayObject <> nil then
    begin
      GuildJoinUser.btSex := PlayObject.m_btGender;
      GuildJoinUser.btJob := PlayObject.m_btJob;
      GuildJoinUser.nLevel := PlayObject.m_Abil.Level;
      GuildJoinUser.dtLastLogin := Now;
      GuildJoinUser.boOnline := not PlayObject.m_boOffLine;
    end
    else
    begin
      sSendNames := sSendNames + WantAddMember.UserName + '/';
      GuildJoinUser.btSex := WantAddMember.Sex;
      GuildJoinUser.btJob := WantAddMember.Job;
      GuildJoinUser.nLevel := WantAddMember.Level;
      GuildJoinUser.dtLastLogin := WantAddMember.AddTime;
      GuildJoinUser.boOnline := False;
    end;
  end;

  if m_SendJoinUserList.Count > 0 then
  begin
    if Length(sSendNames) > 0 then
      DataEngine.QueryHumanInfo(Self, nil, sSendNames, qhiGuildJoinUserList)
    else
      SendJoinUserListToClient;
  end
  else
  begin
    m_DefMsg := MakeDefaultMsg(SM_GUILDGETJOINUSERLIST, NativeInt(Self), 0, m_nJoinUserPage, 0);
    SendSocket(@m_DefMsg, '');
  end;
end;

procedure TPlayObject.ClientGuildAcceptUserJoin(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I, nCode: Integer;
  MyGuild, UserGuild: TGUild;
  S: string;
  Users: TStringList;
  Player: TPlayObject;
begin
  nCode := 0;
  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    nCode := 1
  else if TGUild(m_MyGuild).IsFull then
    nCode := 2
  else
  begin
    MyGuild := TGUild(m_MyGuild);
    Users := TStringList.Create;
    try
      Users.Delimiter := '/';
      Users.DelimitedText := DecodeString(ProcessMsg.sMsg);
      for I := 0 to Users.Count - 1 do
      begin
        S := Users.Strings[I];
        if Length(S) > 0 then
        begin
          if MyGuild.FindWantAddMemberIndex(S) >= 0 then
          begin
            if not MyGuild.IsFull then
            begin
              Player := UserEngine.GetPlayObject(S);
              if Player = nil then
              begin
                UserGuild := g_GuildManager.MemberOfGuild(S);
                if UserGuild = nil then
                begin
                  if g_Config.boNationGuildCheck then
                  begin
                    SysMsg('加入失败，用户 ' + S + ' 不在线，无法检查是否为同国家人员', c_Red, t_Hint);
                    Exit;
                  end
                  else
                  begin
                    MyGuild.AddMember2(S);
                  end;
                end
                else
                begin
                  nCode := 3;
                  SysMsg('加入失败，用户 ' + S + ' 已经是行会 ' + UserGuild.sGuildName + ' 成员', c_Green, t_Hint);
                end;
              end
              else
              begin
                if Player.m_MyGuild = nil then
                begin
                  if (g_Config.boNationGuildCheck) and (m_btNation <> Player.m_btNation) then
                  begin
                    SysMsg('加入失败，用户 ' + S + ' 是不同国家的人', c_Red, t_Hint);
                  end
                  else
                  begin
                    m_boStopHumanJoinGuild := False;
                    if g_FunctionNPC <> nil then
                    begin
                      m_sJoinGuildUserName := Player.m_sCharName;
                      m_nScriptGotoCount := 0;
                      g_FunctionNPC.GotoLable(Self, '@BeforeJoinGuild', False);
                      m_sJoinGuildUserName := '';
                    end;
                    if m_boStopHumanJoinGuild then
                    begin
                      nCode := 5;
                      SysMsg('行会满员，用户 ' + S + '加入失败！', c_Red, t_Hint);
                    end
                    else
                    begin
                      MyGuild.AddMember(Player);
                      Player.m_MyGuild := MyGuild;
                      Player.m_sGuildRankName := MyGuild.GetRankName2(Player, Player.m_nGuildRankNo);
                      Player.RefShowName();
                      Player.SendDefMessage(SM_GUILDUSERJOIN_OK, 0, 0, 0, 0, MyGuild.sGuildName);
                      if g_FunctionNPC <> nil then
                      begin
                        Player.m_nScriptGotoCount := 0;
                        g_FunctionNPC.GotoLable(Player, '@JoinGuild', False);
                      end;
                    end;
                  end;
                end
                else
                begin
                  nCode := 4;
                  SysMsg('加入失败，用户 ' + S + ' 已经是行会 ' + TGUild(Player.m_MyGuild).sGuildName + ' 成员', c_Red, t_Hint);
                end;
              end;
              MyGuild.DeleteWantAddMember(S);
            end
            else
            begin
              nCode := 5;
              SysMsg('行会满员，用户 ' + S + '加入失败！', c_Red, t_Hint);
            end;
          end
          else
          begin
            nCode := 6;
            SysMsg('用户已经不在申请列表中 ' + S + '，刷新后再试！', c_Red, t_Hint);
          end;
        end;
      end;
    finally
      Users.Free;
    end;
  end;

  if nCode = 0 then
    SendDefMessage(SM_GUILDACCEPTUSERJOIN_OK, nCode, 0, 0, 0, '')
  else
    SendDefMessage(SM_GUILDACCEPTUSERJOIN_FAIL, nCode, 0, 0, 0, '')
end;

