function TPlayObject.ReadBook(StdItem: pTStdItem): Boolean;
var
  Magic: pTMagic;
  UserMagic: pTUserMagic;
  PlayObject: TPlayObject;
  IsLevelOK: Boolean;
begin
  Result := False;
  Magic := UserEngine.FindMagic(StdItem.Name);
  if Magic <> nil then
  begin
    if not IsTrainingSkill(Magic.wMagicId, Magic.MagicAttr) then
    begin
      if (Magic.btJob = 99) or (Magic.btJob = m_btJob) then
      begin
        // 修正内功技能书，依据内功等级来判断而非普通等级 chongchong 2016-03-07
        if (Pos('静之', Magic.sDescr) > 0) or (Pos('怒之', Magic.sDescr) > 0) then
          IsLevelOK := m_boTrainingNG and (m_AbilNG.Level >= Magic.TrainLevel[0])
        else
          IsLevelOK := m_Abil.Level >= Magic.TrainLevel[0];

        if IsLevelOK then
        begin
          New(UserMagic);
          UserMagic.MagicInfo := Magic;
          UserMagic.MagicAttr := Magic.MagicAttr;
          UserMagic.wMagIdx := Magic.wMagicId;
          UserMagic.btKey := 0;
          UserMagic.btLevel := 0;
          UserMagic.btNewLevel := 0;
          UserMagic.nTranPoint := 0;
          UserMagic.boUsesItemAdd := False;
          m_MagicList.Add(UserMagic);
          RecalcAbilitys();
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            PlayObject := Self;
            PlayObject.SendAddMagic(UserMagic);
            if g_FunctionNPC <> nil then
            begin
              m_nScriptGotoCount := 0;
              m_nLearnMagicID := Magic.wMagicId;
              g_FunctionNPC.GotoLable(Self, '@LearnMagic', False);
              m_nLearnMagicID := 0;
            end;
          end;
          Result := True;
        end;
      end;
    end;
  end;
end;

procedure TPlayObject.SendAddMagic(UserMagic: pTUserMagic);
var
  ClientMagic: TClientMagic;
  CustomMagicConfig: TCustomMagicConfig;
begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  UserMagicToClientMagic(UserMagic, @ClientMagic);
  ClientMagic.dwInterval := GetMagicCD(UserMagic.wMagIdx);
  ClientMagic.dwRealInterval := ClientMagic.dwInterval;
  ClientMagic.dwLastUseTick := 0;

  CustomMagicConfig := GetCustomMagicConfig(UserMagic.wMagIdx);
  if CustomMagicConfig <> nil then
  begin
    // 有提示的自定义技能不转圈 2019-09-22 00:44:27
    if Length(CustomMagicConfig.ServerConfig.FailMsg) > 0 then
      ClientMagic.dwInterval := 0;
  end;
  m_DefMsg := MakeDefaultMsg(SM_ADDMAGIC, 0, 0, 0, 1);
  SendSocketEx(@m_DefMsg, @ClientMagic, SizeOf(TClientMagic));
end;

function TPlayObject.GetMaxBagCount: Integer;
begin
  // 修改将物品放到交易中，然后又买几个物品把背包塞满，取消交易后，装备一个物品，可以将绑定物品顶到地上 2020-08-13 16:09:14
  Result := DEF_MAX_BAG_ITEM + m_btExtBagOpenItemCount - m_DealItemList.Count;
end;

procedure TPlayObject.SendDelMagic(UserMagic: pTUserMagic);
var
  CustomMagicConfig: TCustomMagicConfig;
begin
  // 防止删除内功假象 -- piaoyun 2013-07-14
  if m_boOffLine or m_boDummyObject then
  begin
    if UserMagic = m_MagicSuperShiledSkill then
      m_MagicSuperShiledSkill := nil
    else if UserMagic = m_MagicOneSwordSkill then
      m_MagicOneSwordSkill := nil
    else if UserMagic = m_MagicPowerHitSkill then
      m_MagicPowerHitSkill := nil
    else if UserMagic = m_MagicErgumSkill then
      m_MagicErgumSkill := nil
    else if UserMagic = m_MagicBanwolSkill then
      m_MagicBanwolSkill := nil
    else if UserMagic = m_MagicFireSwordSkill then
      m_MagicFireSwordSkill := nil
    else if UserMagic = m_MagicCrsSkill then
      m_MagicCrsSkill := nil
    else if UserMagic = m_Magic42Skill then
      m_Magic42Skill := nil
    else if UserMagic = m_Magic43Skill then
      m_Magic43Skill := nil
    else if UserMagic = m_MagicSwordSkill then
      m_MagicSwordSkill := nil
    else if UserMagic = m_Magic66Skill then
      m_Magic66Skill := nil
    else if UserMagic = m_Magic113Skill then
      m_Magic113Skill := nil
    else if UserMagic = m_Magic115Skill then
      m_Magic115Skill := nil;
    Exit;
  end;

  // 解决刺杀剑法删除需要小退 -- piaoyun 2013-07-20
  if (UserMagic.MagicAttr = mtHum) { 基本技能 } and (UserMagic.wMagIdx = SKILL_ERGUM) { 刺杀剑术ID } then
  begin
    ThrustingOnOff(False);
    // SendSocket(nil, '+ULNG');
    SendOpenMagic(SKILL_ERGUM, False, 0);
  end
  else if CheckIsCustomMagic(UserMagic.wMagIdx) then
  begin
    CustomMagicConfig := GetCustomMagicConfig(UserMagic.wMagIdx);
    if (CustomMagicConfig <> nil) //
      and (CustomMagicConfig.ClientBaseConfig.MagicSwitchMode = msmSwitch) //
      and (m_boCustomSkill[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID]) then
    begin
      if (CustomMagicConfig.ClientBaseConfig.MagicWarrNGOption = mngoLongHit) //
        or CustomMagicConfig.ClientBaseConfig.MagicAutoOpen then
      begin
        m_boCustomSkill[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID] := False;
        SendOpenMagic(UserMagic.wMagIdx, False, 0);
      end;
    end;
  end;

  m_DefMsg := MakeDefaultMsg(SM_DELMAGIC, UserMagic.wMagIdx, Word(UserMagic.MagicAttr), 0, 1);
  SendSocket(@m_DefMsg, '');
  // 删除技能时记录的技能指针对应也清一下 2020-06-15
  if UserMagic = m_MagicSuperShiledSkill then
    m_MagicSuperShiledSkill := nil
  else if UserMagic = m_MagicOneSwordSkill then
    m_MagicOneSwordSkill := nil
  else if UserMagic = m_MagicPowerHitSkill then
    m_MagicPowerHitSkill := nil
  else if UserMagic = m_MagicErgumSkill then
    m_MagicErgumSkill := nil
  else if UserMagic = m_MagicBanwolSkill then
    m_MagicBanwolSkill := nil
  else if UserMagic = m_MagicFireSwordSkill then
    m_MagicFireSwordSkill := nil
  else if UserMagic = m_MagicCrsSkill then
    m_MagicCrsSkill := nil
  else if UserMagic = m_Magic42Skill then
    m_Magic42Skill := nil
  else if UserMagic = m_Magic43Skill then
    m_Magic43Skill := nil
  else if UserMagic = m_MagicSwordSkill then
    m_MagicSwordSkill := nil
  else if UserMagic = m_Magic66Skill then
    m_Magic66Skill := nil
  else if UserMagic = m_Magic113Skill then
    m_Magic113Skill := nil
  else if UserMagic = m_Magic115Skill then
    m_Magic115Skill := nil;
end;

function TPlayObject.EatUseItems(nShape: Integer): Boolean;
var
  Castle: TUserCastle;
begin
  Result := False;
  case nShape of //
    1:
      begin
        if m_boImprison then
        begin
          SysMsg('禁止使用此命令！', c_Red, t_Hint);
          Exit;
        end;

        SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');
        BaseObjectMove(m_sHomeMap, '', '');
        Result := True;
      end;
    2:
      begin
        if m_boImprison then
        begin
          SysMsg('禁止使用此命令！', c_Red, t_Hint);
          Exit;
        end;

        if g_Config.boDisableMoveParalysisHuman and (m_wStatusTimeArr[POISON_STONE] <> 0) then
        begin
          SysMsg('麻痹状态不允许随机传送。', g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
          Exit;
        end;

        if not m_PEnvir.m_boNORANDOMMOVE then
        begin
          SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');
          BaseObjectMove(m_sMapName, '', '');
          Result := True;
        end;
      end;
    3:
      begin
        if m_boImprison then
        begin
          SysMsg('禁止使用此命令！', c_Red, t_Hint);
          Exit;
        end;

        SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');
        if PKLevel < 2 then
          BaseObjectMove(m_sHomeMap, IntToStr(m_nHomeX), IntToStr(m_nHomeY))
        else
          BaseObjectMove(g_Config.sRedHomeMap, IntToStr(g_Config.nRedHomeX), IntToStr(g_Config.nRedHomeY));

        Result := True;
      end;
    4:
      begin
        if WeaptonMakeLuck() then
          Result := True;
      end;
    5:
      begin
        if m_boImprison then
        begin
          SysMsg('禁止使用此命令！', c_Red, t_Hint);
          Exit;
        end;

        if m_MyGuild <> nil then
        begin
          if not m_boInFreePKArea then
          begin
            Castle := g_CastleManager.IsCastleMember(Self);
            if (Castle <> nil) and Castle.IsMasterGuild(TGUild(m_MyGuild)) then
              BaseObjectMove(Castle.m_sHomeMap, IntToStr(Castle.GetHomeX), IntToStr(Castle.GetHomeY))
            else
              SysMsg('无效', c_Red, t_Hint);
            Result := True;
          end
          else
            SysMsg('此处无法使用', c_Red, t_Hint);
        end;
      end;
    9:
      begin
        if RepairWeapon() then
          Result := True;
      end;
    10:
      begin
        if SuperRepairWeapon() then
          Result := True;
      end;
    11:
      begin
        if WinLottery() then
          Result := True;
      end;
  end;
end;

{
  function TPlayObject.EatAttackItem(StdItem: PTStdItem; UserItem: PTUserItem; Target: TBaseObject; TargetX, TargetY: Integer): Boolean;
  var
  nMagicAttackRage: Integer;
  nDamage: Integer;
  begin
  if g_Config.boViewRangeCanMagicAttack then
  begin
  nMagicAttackRage := m_nViewRange;
  end
  else
  begin
  nMagicAttackRage := g_Config.nMagicAttackRage;
  end;
  if Target <> nil then
  begin
  if not (m_PEnvir.IsValidObjectEx(m_nCurrX, m_nCurrY, nMagicAttackRage, Target)) then
  begin
  Exit;
  end;
  end
  else
  begin
  if (abs(m_nCurrX - TargetX) > nMagicAttackRage) or (abs(m_nCurrY - TargetY) > nMagicAttackRage) then
  begin
  SendScreenMsg(g_MagicAttackOutRange, 220, 0, 30, 40);
  Exit;
  end;
  Target := m_PEnvir.GetMovingObject(TargetX, TargetY, True);
  if (Target = nil) or (Target.m_boDeath) or (Target.m_boGhost) or
  (not IsProperTarget(Target)) then
  begin
  Exit;
  end
  end;
  // 不能攻击人物，英雄，假人
  if Target.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
  Exit;
  end;
  // 不可以攻击人物或人物英雄的宝宝
  if (Target.Master <> nil) and (Target.Master.m_btRaceServer = RC_PLAYOBJECT) then
  begin
  Exit;
  end;
  if StdItem.Source <> Target.m_wAttackSource then
  begin
  SysMsg('该物品不支持攻击怪物 ' + DelNumber(Target.m_sCharName), 255, 253, t_Hint);
  Exit;
  end;
  // 几率不到，也减持久
  Randomize;
  if Random(StdItem.Reserved) <> 0 then
  begin
  Result := True;
  Exit;
  end;
  nDamage := StdItem.HP;
  if StdItem.Shape = 1  then
  begin
  nDamage := Target.GetHitStruckDamage(Self, nDamage, nil); // 忽视目标防御
  end
  else if StdItem.Shape = 2 then
  begin
  nDamage := Target.GetMagStruckDamage(Self, nDamage);      // 忽视目标防御
  end;
  // 怪物伤害封顶 XXXXXXXXXXXXXXXXXX chongchong 2016-01-30
  nDamage := Target.GetAttackPowerMax(nDamage);
  if nDamage > 0 then
  begin
  Target.SetLastHiter(Self);
  Target.DamageHealth(nDamage, Self);
  if g_FunctionNPC <> nil then
  begin
  m_nScriptGotoCount := 0;
  g_FunctionNPC.GotoLable(Self, '@UseItemAttack', False)
  end;
  if (Target.m_btRaceServer in [55]) then
  Target.SendDelayMsg(Target, RM_STRUCK, nDamage, Target.m_WAbil.HP, Target.m_WAbil.MaxHP, NativeInt(Self), '0', 100)
  else
  begin
  // 算物理攻击 chongchong 2017-04-15
  Target.SendRefMsg(RM_STRUCK, nDamage, Target.m_WAbil.HP, Target.m_WAbil.MaxHP, NativeInt(Self), '0', 100);
  end;
  end;
  Result := True;
  end;
}
