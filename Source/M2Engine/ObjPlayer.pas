function TPlayObject.DecMoney(nIndex: Integer; nValue: Integer; var nReturn: Integer): Integer;
var
  nOldMoney, nIdx: Integer;
  Money: pTCustomMoney;
begin
  Result := 0;
  Money := FindCustomMoney(nIndex);
  if Money = nil then
  begin
    MainOutMessage(Format('用户:[%s]使用不存在的自定义货币ID[%s]', [m_sCharName, Money.sName]));
    Exit;
  end;

  nIdx := m_MoneyList.GetIndex(UpperCase(Money.sName));
  if nIdx >= 0 then
  begin
    nOldMoney := Integer(m_MoneyList.Objects[nIdx]);
    nReturn := _MAX(nOldMoney - nValue, 0);
    Result := nOldMoney - nReturn;
    m_MoneyList.Objects[nIdx] := TObject(nReturn);

    if nReturn <> nOldMoney then
      SendDefMessage(SM_MONEY, nReturn, 0, 0, 0, Money.sName);
  end;
end;

