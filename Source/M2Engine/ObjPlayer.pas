procedure TPlayObject.ServerSendLogon(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nObjCount: Integer;
  SL: TStringList;
  I: Integer;
  Color: Word;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  S: string;
begin
  if m_PEnvir.m_boDARK then
    nObjCount := 1
  else
  begin
    case m_nBright of
      1:
        nObjCount := 0;
      0, 2:
        nObjCount := 2;
      3:
        nObjCount := 1;
    else
      nObjCount := 1;
    end;
  end;
  if m_PEnvir.m_boDAY then
    nObjCount := 0;
  m_DefMsg := MakeDefaultMsg(SM_NEWMAP, NativeInt(Self), m_nCurrX, m_nCurrY, nObjCount);
  // SendSocket(@m_DefMsg, EncodeString(m_PEnvir.MapName));
  if (not SameText(m_PEnvir.MapName, m_PEnvir.sMapName)) then
  begin
    SendSocket(@m_DefMsg, EncodeString(m_PEnvir.MapName + sLineBreak + m_PEnvir.sMapName));
  end
  else
  begin
    SendSocket(@m_DefMsg, EncodeString(m_PEnvir.MapName));
  end;
  SendMsg(Self, RM_CHANGELIGHT, 0, 0, 0, 0, '');
  SendLogon(); // 客户端登录
  ProcessMsg.nParam1 := NativeInt(Self);
  ProcessMsg.nParam2 := m_nCurrX;
  ProcessMsg.nParam3 := m_nCurrY;
  ClientQueryUserName(ProcessMsg, boResult);
  if not m_boDummyObject then
  begin
    SendServerConfig();
    SendEnableClientUploadPickItems;
  end;
  RefUserState();
  SendMapDescription(); // 发送地图描述
  SendMapCanRun(); // 发送当前地图角色能否运行
  SendGoldInfo(True); // 发送金币
  SendGameGlory; // 发送荣誉
  // 移到SendClientDataFile中
  // SendUnbindList();                                                                               // 发送绑定物品类型
  SendNewGamePointInfo(True); // 发送新游戏点 - 金刚石、灵符等
  SendAcupointLevels(); // 发送打通穴道需要的内功等级 piaoyun 2013-08-16
  if (not m_boDummyObject) then
  begin
    SendJewelryBox(False);
    SendUpdateGodBless(False);
    SendUpdateFengHao(False);
    SendGamePetList;
    SendGamePetBagItemList;
    SendStorageOpenStatus;
    if (m_ActiveFengHao >= 0) and (m_ActiveFengHao < m_FengHaoItems.Count) and (g_FunctionNPC <> nil) then
    begin
      UserItem := m_FengHaoItems.Items[m_ActiveFengHao];
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@ActiveTitle_' + IntToStr(StdItem.Shape), False);
      end;
    end;
  end;
  // SendDefMessage(SM_SENDUSERMOVECMD, 0, 0, 0, 0, g_GameCommand.USERMOVE.sCmd); // 发送用户传送命令到客户端
  SendDefMessage(SM_ATTATCKMODE, m_btAttatckMode, 0, 0, 0, ''); // 攻击模式
  if m_boSaveKillMonExpRate and (m_nKillMonExpRate <> 100) then
  begin
    if m_dwKillMonExpRateTime = 0 then
    begin
      // SysMsg(Format(g_sKillMonExpRateForeverMsg, [m_nKillMonExpRate / 100]), g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint)
      if Length(g_sKillMonExpRateForeverMsg) > 0 then
      begin
        S := StringReplace(g_sKillMonExpRateForeverMsg, '%g', FloatToStr(m_nKillMonExpRate / 100), [rfReplaceAll]);
        SysMsg(S, g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint)
      end;
    end
    else
    begin
      // SysMsg(Format(g_sKillMonExpRateMsg, [m_nKillMonExpRate / 100, m_dwKillMonExpRateTime]), g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint)
      if Length(g_sKillMonExpRateMsg) > 0 then
      begin
        S := StringReplace(g_sKillMonExpRateMsg, '%g', FloatToStr(m_nKillMonExpRate / 100), [rfReplaceAll]);
        S := StringReplace(S, '%d', IntToStr(m_dwKillMonExpRateTime), [rfReplaceAll]);
        SysMsg(S, g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
      end;
    end;
  end;
  if m_boAttackHumSavePowerRate and (m_nAttackHumPowerRate <> 100) and m_boAttackMonSavePowerRate and
    (m_nAttackMonPowerRate <> 100) and (m_nAttackHumPowerRate = m_nAttackMonPowerRate) and
    (m_dwAttackHumPowerRateTime = m_dwAttackMonPowerRateTime) then
  begin
    if m_dwAttackHumPowerRateTime = 0 then
    begin
      // SysMsg(Format(g_sChangePowerRateForeverMsg, [m_nPowerRate / 100]), g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint)
      if Length(g_sChangePowerRateForeverMsg) > 0 then
      begin
        S := StringReplace(g_sChangePowerRateForeverMsg, '%g', FloatToStr(m_nAttackHumPowerRate / 100), [rfReplaceAll]);
        SysMsg(S, g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint)
      end;
    end
    else
    begin
      // SysMsg(Format(g_sChangePowerRateMsg, [m_nPowerRate / 100, m_dwPowerRateTime]), g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint)
      if Length(g_sChangePowerRateMsg) > 0 then
      begin
        S := StringReplace(g_sChangePowerRateMsg, '%g', FloatToStr(m_nAttackHumPowerRate / 100), [rfReplaceAll]);
        S := StringReplace(S, '%d', IntToStr(m_dwAttackHumPowerRateTime), [rfReplaceAll]);
        SysMsg(S, g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
      end;
    end;
  end
  else
  begin
    if m_boAttackHumSavePowerRate and (m_nAttackHumPowerRate <> 100) then
    begin
      if m_dwAttackHumPowerRateTime = 0 then
      begin
        if Length(g_sChangeAttackHumPowerRateForeverMsg) > 0 then
        begin
          S := StringReplace(g_sChangeAttackHumPowerRateForeverMsg, '%g', FloatToStr(m_nAttackHumPowerRate / 100),
            [rfReplaceAll]);
          SysMsg(S, g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint)
        end;
      end
      else
      begin
        if Length(g_sChangeAttackHumPowerRateMsg) > 0 then
        begin
          S := StringReplace(g_sChangeAttackHumPowerRateMsg, '%g', FloatToStr(m_nAttackHumPowerRate / 100), [rfReplaceAll]);
          S := StringReplace(S, '%d', IntToStr(m_dwAttackHumPowerRateTime), [rfReplaceAll]);
          SysMsg(S, g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
        end;
      end;
    end;
    if m_boAttackMonSavePowerRate and (m_nAttackMonPowerRate <> 100) then
    begin
      if m_dwAttackMonPowerRateTime = 0 then
      begin
        if Length(g_sChangeAttackMonPowerRateForeverMsg) > 0 then
        begin
          S := StringReplace(g_sChangeAttackMonPowerRateForeverMsg, '%g', FloatToStr(m_nAttackMonPowerRate / 100),
            [rfReplaceAll]);
          SysMsg(S, g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint)
        end;
      end
      else
      begin
        if Length(g_sChangeAttackMonPowerRateMsg) > 0 then
        begin
          S := StringReplace(g_sChangeAttackMonPowerRateMsg, '%g', FloatToStr(m_nAttackMonPowerRate / 100), [rfReplaceAll]);
          S := StringReplace(S, '%d', IntToStr(m_dwAttackMonPowerRateTime), [rfReplaceAll]);
          SysMsg(S, g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
        end;
      end;
    end;
  end;
  if m_boSaveKillMonBurstRate and (m_dwKillMonBurstRate <> 0) then
  begin
    if m_dwKillMonBurstRateTime = 0 then
    begin
      if Length(g_sKillMonBurstRateForeverMsg) > 0 then
        SysMsg(Format(g_sKillMonBurstRateForeverMsg, [m_dwKillMonBurstRate / 100]), g_Config.btGreenMsgFColor,
          g_Config.btGreenMsgBColor, t_Hint)
    end
    else
    begin
      if Length(g_sKillMonBurstRateMsg) > 0 then
        SysMsg(Format(g_sKillMonBurstRateMsg, [m_dwKillMonBurstRate / 100, m_dwKillMonBurstRateTime]), g_Config.btGreenMsgFColor,
          g_Config.btGreenMsgBColor, t_Hint);
    end;
  end;
  if m_dwHighLevelKillMonFixExpTime > 0 then
  begin
    SysMsg(Format(g_sHighLevelKillMonFixExpMsg, [m_dwHighLevelKillMonFixExpTime]), g_Config.btGreenMsgFColor,
      g_Config.btGreenMsgBColor, t_Hint)
  end;
  // 上线提示 (元宝增加) chongchong 2014-01-07
  SL := TStringList.Create;
  try
    if UserEngine.GetLogonMessage(m_sCharName, SL) then
    begin
      for I := 0 to SL.Count - 1 do
      begin
        Color := Word(SL.Objects[I]);
        SysMsg(SL[I], LoByte(Color), HiByte(Color), t_Hint);
      end;
    end;
  finally
    SL.Free;
  end;
  m_IsSendUserLogon := True;
end;

