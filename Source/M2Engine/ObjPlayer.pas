          m_CurrentItemOverlapCount := UserItem.Dura + 1
        else
          m_CurrentItemOverlapCount := 0;
        m_nCurrentItemMakeIndex := UserItem.MakeIndex;
        m_sCurrentItemName := UserEngine.GetStdItemName(UserItem.wIndex);
        if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
          m_sCurrentItemNewName := UserItem.Name
        else
          m_sCurrentItemNewName := UserEngine.GetStdItemName(UserItem.wIndex);
        m_btCurItemMoneyTypeValue := nMoneyType;
        case nMoneyType of
          0:
            m_sCurItemMoneyType := g_Config.sGameGoldName;
          1:
            m_sCurItemMoneyType := g_Config.sGamePointName;
          2:
