                0, 0, '');
              m_ChallengeCreat.m_ChallengeLastTick := MyGetTickCount();
              bo09 := True;
              m_ChallengeLastTick := MyGetTickCount();
            end;
          end;
        1: // 元宝[游戏币]
          begin
            if (m_nGameGold + m_nChallengeGameDiamonds) >= ProcessMsg.nParam1 then
            begin
              m_nGameGold := (m_nGameGold + m_nChallengeGameDiamonds) - ProcessMsg.nParam1;
              m_nChallengeGameDiamonds := ProcessMsg.nParam1;
              SendDefMessage(SM_CHALLENGECHGGAMEDIAMOND_OK, m_nChallengeGameDiamonds, LoWord(m_nGameGold),
                HiWord(m_nGameGold), 0, '');
              TPlayObject(m_ChallengeCreat).SendDefMessage(SM_CHALLENGEREMOTECHGGAMEDIAMOND, m_nChallengeGameDiamonds, 0,
                0, 0, '');
              m_ChallengeCreat.m_ChallengeLastTick := MyGetTickCount();
              bo09 := True;
              m_ChallengeLastTick := MyGetTickCount();
            end;
          end;
        2: // 灵符
          begin
            if (m_nGameGird + m_nChallengeGameDiamonds) >= ProcessMsg.nParam1 then
            begin
              m_nGameGird := (m_nGameGird + m_nChallengeGameDiamonds) - ProcessMsg.nParam1;
              m_nChallengeGameDiamonds := ProcessMsg.nParam1;
              SendDefMessage(SM_CHALLENGECHGGAMEDIAMOND_OK, m_nChallengeGameDiamonds, LoWord(m_nGameGird),
                HiWord(m_nGameGird), 0, '');
              TPlayObject(m_ChallengeCreat).SendDefMessage(SM_CHALLENGEREMOTECHGGAMEDIAMOND, m_nChallengeGameDiamonds, 0,
                0, 0, '');
              m_ChallengeCreat.m_ChallengeLastTick := MyGetTickCount();
              bo09 := True;
              m_ChallengeLastTick := MyGetTickCount();
            end;
          end;
      end;
    end;
  end;
  if not bo09 then
  begin
    case g_Config.btChallengeGoldIndex of
      0:
        SendDefMessage(SM_CHALLENGECHGGAMEDIAMOND_FAIL, m_nChallengeGameDiamonds, LoWord(m_nGameDiamond),
          HiWord(m_nGameDiamond), 0, '');
      1:
