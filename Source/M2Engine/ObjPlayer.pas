function TPlayObject.GamePetAddMagic(MagicID: Integer; MagicName: string; var MagicIndex: Integer; IsCanBreak: Boolean)
  : TGamePetAddMagicResultType;
var
  GamePetData: pTGamePetData;
  I: Integer;
begin
  Result := gpr_Fail;
  if (m_MyGamePetIndex >= 0) and (m_MyGamePetIndex < m_GamePetList.Count) then
  begin
    GamePetData := m_GamePetList.Items[m_MyGamePetIndex];
    for I := Low(GamePetData.wMagics) to High(GamePetData.wMagics) do
    begin
      if GamePetData.wMagics[I] = MagicID then
      begin
        Exit;
      end;
    end;
    for I := Low(GamePetData.wMagics) to High(GamePetData.wMagics) do
    begin
      if GamePetData.wMagics[I] = 0 then
      begin
        if IsCanBreak and (g_FunctionNPC <> nil) then
        begin
          m_nGamePetMagicID := MagicID - 1;
          m_nGamePetMagicIndex := I;
          m_sGamePetMagicName := MagicName;
          m_boGamePetBreakTrainingMagic := False;
          g_FunctionNPC.GotoLable(Self, '@GamePetTrainingMagic', False);
          m_nGamePetMagicID := 0;
          m_nGamePetMagicIndex := 0;
          m_sGamePetMagicName := '';
          if m_boGamePetBreakTrainingMagic then
          begin
            Result := gpr_Break;
            Break;
          end;
        end;
        GamePetData.wMagics[I] := MagicID;
        Result := gpr_OK;
        MagicIndex := I;
        Break;
      end;
    end;
  end;
end;

function TPlayObject.GamePetToBag(GamePetIndex: Integer): Boolean;
var
  GamePetData: pTGamePetData;
  UserItem: pTUserItem;
  Index: Integer;
begin
  Result := False;
  if (GamePetIndex >= 0) and (GamePetIndex < m_GamePetList.Count) then
  begin
    GamePetData := m_GamePetList.Items[GamePetIndex];
    New(UserItem);
    if UserEngine.CopyToUserItemFromName('宠物蛋', UserItem) then
    begin
      UserItem.btValue[13] := 1;
      UserItem.Name := GamePetData.sName;
      GamePetDataToUserItem(GamePetData, UserItem);
      RecallGamePetAbilToUserItem(GamePetData.sName, GamePetData.Level, UserItem);
      UserItem.btNewValue[28] := LoWord(GamePetData.DieTick);
      UserItem.btNewValue[29] := HiWord(GamePetData.DieTick);
      if GamePetIndex = m_MyGamePetIndex then
      begin
        if m_MyGamePet <> nil then
        begin
          ObjectToUserItem(m_MyGamePet, UserItem);
          Index := m_SlaveList.IndexOf(m_MyGamePet);
          if Index >= 0 then
            m_SlaveList.Delete(Index);
          m_sMyGamePetName := m_MyGamePet.m_sCharName;
          m_MyGamePet.m_Master := nil;
          m_MyGamePet.MakeGhost;
          m_MyGamePet := nil;
          if g_FunctionNPC <> nil then
          begin
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@GamePetRetake', False);
          end;
        end;
        m_LastMyGamePetIndex := m_MyGamePetIndex;
        m_MyGamePetIndex := -1;
        SendCurrentRecalGamePetIndex(m_MyGamePetIndex);
        RecalcAbilitys;
        SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
        SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
      end;
      Dispose(GamePetData);
      m_GamePetList.Delete(GamePetIndex);
      SendDelGamePet(GamePetIndex);
      // 召唤第二个宝宝，然后把第一个宝宝放到背包中，要改索引 2019-05-09 22:43:52
      if (m_MyGamePet <> nil) and (GamePetIndex < m_MyGamePetIndex) then
      begin
        Dec(m_MyGamePetIndex);
        SendCurrentRecalGamePetIndex(m_MyGamePetIndex);
      end;
      m_ItemList.Add(UserItem);
      SendAddItem(UserItem);
      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        m_nBagItemMakeIndex := UserItem.MakeIndex;
        m_sBagItemName := UserItem.Name;
        g_FunctionNPC.GotoLable(Self, '@PetToEgg', False);
        m_nBagItemMakeIndex := 0;
        m_sBagItemName := '';
      end;
      Result := True;
    end
    else
    begin
      Dispose(UserItem);
    end;
  end;
end;

