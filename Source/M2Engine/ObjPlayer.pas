procedure TPlayObject.ChallengeCancel;
begin
  if not m_boChallengeing then
    Exit;

  m_boChallengeing := False;
  m_boChallengeOK := False;
  m_boChallengeStart := False;
  SendDefMessage(SM_CHALLENGECANCEL, 0, 0, 0, 0, '');
  if m_ChallengeCreat <> nil then
    TPlayObject(m_ChallengeCreat).ChallengeCancel;

  m_ChallengeCreat := nil;
  GetBackChallengeItems();
  SysMsg(g_sChallengeActionCancelMsg { '交易取消' } , c_Green, t_Hint);
  m_ChallengeLastTick := MyGetTickCount();
end;

procedure TPlayObject.ChallengeCancelA;
begin
  m_Abil.HP := m_WAbil.HP;
  ChallengeCancel();
end;

function TPlayObject.CheckMoney(sMoneyName: string; nValue: Integer): Boolean;
var
  nMoney, nIdx: Integer;
  // Money: pTCustomMoney;
begin
  Result := False;
  // Money := FindCustomMoney(sMoneyName);
  if FindCustomMoney(sMoneyName) = nil then
  begin
    MainOutMessage(Format('用户:[%s]使用不存在的自定义货币[%s]', [m_sCharName, sMoneyName]));
    Exit;
  end;

  nIdx := m_MoneyList.GetIndex(UpperCase(sMoneyName));
  if nIdx >= 0 then
  begin
    nMoney := Integer(m_MoneyList.Objects[nIdx]);
    Result := nMoney >= nValue;
  end;
end;

