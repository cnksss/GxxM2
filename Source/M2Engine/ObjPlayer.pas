procedure TPlayObject.SendPreviewMonItem(Mon: TBaseObject);
var
  I, nCount, Index: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  dwGold, dwCurGold: LongWord;
  sSendMsg, sTempItem: AnsiString;
  Item: TPreviewMonItem;
begin
  if Mon = nil then
    Exit;

  nCount := 0;
  sSendMsg := '';
  dwGold := Mon.m_nGold;
  SetLength(sTempItem, SizeOf(TPreviewMonItem));

  if dwGold > 0 then
  begin
    I := 0;
    while (True) do
    begin
      if dwGold > g_Config.nMonOneDropGoldCount then
      begin
        dwCurGold := g_Config.nMonOneDropGoldCount;
        dwGold := dwGold - g_Config.nMonOneDropGoldCount;
      end
      else
      begin
        dwCurGold := dwGold;
        dwGold := 0;
      end;

      if dwCurGold > 0 then
      begin
        FillChar(Item, SizeOf(TPreviewMonItem), 0);

        Item.sName := sSTRING_GOLDNAME;
        Item.btColor := g_Config.btThrowAwayItemColor;
        Item.boValueItem := False;
        Item.wLooks := GetGoldShape(dwCurGold);
        Item.nCount := dwCurGold;

        Move(Item, sTempItem[1], Length(sTempItem));
        sSendMsg := sSendMsg + sTempItem;

        Inc(nCount);
        if (Mon.m_btPreviewMonItemnMaxCount > 0) and (nCount >= Mon.m_btPreviewMonItemnMaxCount) then
          Break;
      end
      else
        Break;

      Inc(I);
      if I >= 17 then
        Break;
    end;
  end;

{$IF NEED_KEY = 1}
  if g_nKey_PreviewMonItem = 0 then
    Exit;
{$IFEND}
  if (Mon.m_btPreviewMonItemnMaxCount = 0) or (nCount < Mon.m_btPreviewMonItemnMaxCount) then
  begin
    if Mon.m_ItemList.Count > 0 then
    begin
      for I := 0 to Mon.m_ItemList.Count - 1 do
      begin
        UserItem := Mon.m_ItemList[I];
        // 禁止透视
        if not g_ItemRules.Get(UserItem.wIndex, 30) then
        begin
          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if StdItem <> nil then
          begin
            FillChar(Item, SizeOf(TPreviewMonItem), 0);

            Item.sName := StdItem.Name;
            Item.boValueItem := GetDropItemValue(UserItem, StdItem) <> 0;

            if UserItem.wNewLooks > 0 then
              Item.wLooks := UserItem.wNewLooks
            else
              Item.wLooks := StdItem.Looks;

            if CheckOverLapItem(StdItem) then
              Item.nCount := UserItem.Dura + 1
            else
              Item.nCount := 1;

            if StdItem.Color = 251 then
              Item.btColor := g_Config.btThrowAwayItemColor
            else
              Item.btColor := StdItem.Color;

            Item.EffectIndex := UserItem.wEffect;
            if Item.EffectIndex = 0 then
            begin
              Index := g_DropEffectItemList.IndexOf(StdItem.Name);
              if Index >= 0 then
              begin
                Item.EffectIndex := Integer(g_DropEffectItemList.Objects[Index]);
              end;
            end;

            Move(Item, sTempItem[1], Length(sTempItem));
            sSendMsg := sSendMsg + sTempItem;

            Inc(nCount);

            if (Mon.m_btPreviewMonItemnMaxCount > 0) and (nCount >= Mon.m_btPreviewMonItemnMaxCount) then
              Break;
          end;
        end;
      end;
    end;
  end;

  m_DefMsg := MakeDefaultMsg(SM_PREVIEW_MON_ITEM_RET, NativeInt(Mon), 0, nCount, g_Config.nPreviewMonItemShowTime);
  SendSocket(@m_DefMsg, sSendMsg);
end;

end.
