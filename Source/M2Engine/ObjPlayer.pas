        4:
          begin
            if g_boGameLogGameGold then
            begin
              if IsSelled then
                AddGameDataLog(LOG_ItemSellPrice, LOG_GameGirdChange, latHuman, '0', 0, 0, g_Config.sGameGirdName, MakeIndex,
                  PlayerName, '拍卖行', 0, Prices, '已卖出')
              else
