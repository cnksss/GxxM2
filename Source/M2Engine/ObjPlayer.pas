      m_MyHero.m_WAbil.Exp := m_MyHero.m_Abil.Exp;
      m_MyHero.m_WAbil.MaxExp := m_MyHero.m_Abil.MaxExp;
      m_MyHero.m_WAbil.Level := m_MyHero.m_Abil.Level;
      SendSocket(@m_DefMsg, zLibCompressBuffer(@m_MyHero.m_WAbil, SizeOf(TAbility)));
      // 扩展准确、敏捷为65536 chongchong 2018-01-11
      (*
        SendDefMessage(SM_HEROSUBABILITY,
        MakeLong(MakeWord(m_MyHero.m_nAntiMagic, 0), 0),
        MakeWord(m_MyHero.m_btHitPoint, m_MyHero.m_btSpeedPoint),
        MakeWord(m_MyHero.m_btAntiPoison, m_MyHero.m_nPoisonRecover),
        MakeWord(m_MyHero.m_nHealthRecover, m_MyHero.m_nSpellRecover),
        IntToStr(THeroObject(m_MyHero).m_nNPRecoverTime) + '/' + IntToStr(THeroObject(m_MyHero).m_nNPRecoverPoint));
      *)
      SendDefMessage(SM_HEROSUBABILITY, MakeLong(MakeWord(m_MyHero.m_nAntiMagic, 0), m_MyHero.m_btSpeedPoint),
        m_MyHero.m_btHitPoint, MakeWord(m_MyHero.m_btAntiPoison, m_MyHero.m_nPoisonRecover),
        MakeWord(m_MyHero.m_nHealthRecover, m_MyHero.m_nSpellRecover), IntToStr(THeroObject(m_MyHero).m_nNPRecoverTime) + '/' +
        IntToStr(THeroObject(m_MyHero).m_nNPRecoverPoint));
