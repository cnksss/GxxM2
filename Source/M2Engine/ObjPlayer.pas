procedure TPlayObject.DoClientClose(IsLockPlayObjectList: Boolean);
var
  I: Integer;
  PlayObject: TPlayObject;
  IsChanged: Boolean;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  ErrCode: Integer;
begin
  ErrCode := 0;
  try
    { 副本地图 -- 当创建人下线时退出副本 chongchong 2013-09-11 }
    if g_Config.boFBExitCreaterOffline and (m_FBEnvir <> nil) and (m_FBEnvir.m_FBMasterObject = Self) and m_FBEnvir.m_boFBCreate
    then
    begin
      m_FBEnvir.m_FBMasterObject := nil; // 副本地图修改 chongchong 2016-12-16
      m_FBEnvir.m_boFBCreate := False;
    end;
    ErrCode := 1;
    // 人物死亡后过十秒钟才收英雄 chongchong 2013-12-10
    if (m_MyHero <> nil) and (g_Config.boOffLineHero) then
    begin
      if not(m_boSellPlayering and g_Config.boSellPlayerAutoRecallHero) then
      begin
        THeroObject(m_MyHero).LogOut;
      end;
    end;
    ErrCode := 2;
    // 骑马 下线处理 chongchong 2013-10-14
    if m_boOnHorse then
    begin
      if m_HorseOtherHum <> nil then
      begin
        m_HorseOtherHum.m_HorseOtherHum := nil;
        if not m_boHorseMaster then
        begin
          m_boOnHorse := False;
          m_dwDownHorseTick := MyGetTickCount;
          m_HorseOtherHum.DoTalkStatusChanged;
        end
        else if m_boHorseMaster and m_HorseOtherHum.m_boOnHorse then
        begin
          m_HorseOtherHum.m_boOnHorse := False;
          m_HorseOtherHum.m_dwDownHorseTick := MyGetTickCount;
          m_HorseOtherHum.DoTalkStatusChanged;
          m_HorseOtherHum.TriggerHorseScript;
          m_HorseOtherHum.SendTakeOffHorse;
        end;
        m_HorseOtherHum := nil;
      end;
    end;
    ErrCode := 3;
    IsChanged := False;
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun and IsLockPlayObjectList then
      UserEngine.m_PlayObjectList.LockR(91);
    try
{$IFEND}
      for I := UserEngine.m_PlayObjectList.Count - 1 downto 0 do
      begin
        PlayObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
        if (PlayObject = nil) or (PlayObject.m_boGhost) or (PlayObject.m_boOffLine) or (PlayObject.m_boDummyObject) then
          Continue;
        ErrCode := 4;
        { 当施毒人下线后，他施展出去的毒全部消失 【2013-07-31】 }
        if (PlayObject.m_PoisonHitter = Self) then
        begin
          IsChanged := False;
          if (PlayObject.m_wStatusTimeArr[POISON_DECHEALTH] <> 0) or (PlayObject.m_nStatusPowerTime[POISON_DECHEALTH] <> 0) then
          begin
            PlayObject.m_wStatusTimeArr[POISON_DECHEALTH] := 0;
            PlayObject.m_nStatusPowerTime[POISON_DECHEALTH] := 0;
            IsChanged := True;
          end;
          if (PlayObject.m_wStatusTimeArr[POISON_DAMAGEARMOR] <> 0) or (PlayObject.m_nStatusPowerTime[POISON_DAMAGEARMOR] <> 0)
          then
          begin
            PlayObject.m_wStatusTimeArr[POISON_DAMAGEARMOR] := 0;
            PlayObject.m_nStatusPowerTime[POISON_DAMAGEARMOR] := 0;
            IsChanged := True;
          end;
          if (PlayObject.m_wStatusTimeArr[POISON_DONTMOVE] <> 0) or (PlayObject.m_nStatusPowerTime[POISON_DONTMOVE] <> 0) then
          begin
            PlayObject.m_wStatusTimeArr[POISON_DONTMOVE] := 0;
            PlayObject.m_nStatusPowerTime[POISON_DONTMOVE] := 0;
            IsChanged := True;
          end;
          if (PlayObject.m_wStatusTimeArr[POISON_STONE] <> 0) or (PlayObject.m_nStatusPowerTime[POISON_STONE] <> 0) then
          begin
            PlayObject.m_wStatusTimeArr[POISON_STONE] := 0;
            PlayObject.m_nStatusPowerTime[POISON_STONE] := 0;
            IsChanged := True;
          end;
        end;
        ErrCode := 5;
        // 修正人物状态不对 chongchong 2014-09-22
        if IsChanged then
        begin
          PlayObject.m_nCharStatus := PlayObject.GetCharStatus();
          PlayObject.StatusChanged();
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun and IsLockPlayObjectList then
        UserEngine.m_PlayObjectList.UnLockR;
    end;
{$IFEND}
    { TODO -ochongchong -c新增 : 物品规则 - 下线必掉【2013-07-27】 }
    ErrCode := 6;
    // 爆出装备的物品
    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      if (m_UseItems[I].wIndex > 0) and g_ItemRules.Get(m_UseItems[I].wIndex, 22) then
      begin
        if DropItemDown(@m_UseItems[I], 2, True, nil, Self) then
        begin
          { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
          // m_UseItems[I].wIndex := 0;
          StdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
          m_UseItems[I].wIndex := 0;
          if StdItem <> nil then
            ProcessUseItemSkill(I, StdItem, False);
        end;
      end;
    end;
    for I := Low(THumanItemBoxItems) to High(THumanItemBoxItems) do
    begin
      if (m_JewelryBoxItems[I].wIndex > 0) and g_ItemRules.Get(m_JewelryBoxItems[I].wIndex, 22) then
      begin
        if DropItemDown(@m_JewelryBoxItems[I], 2, True, nil, Self) then
        begin
          { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
          // m_JewelryBoxItems[I].wIndex := 0;
          StdItem := UserEngine.GetStdItem(m_JewelryBoxItems[I].wIndex);
          m_JewelryBoxItems[I].wIndex := 0;
          if StdItem <> nil then
            ProcessUseItemSkill(U_JEWELRYITEM1 + I, StdItem, False);
        end;
      end;
    end;
    for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
    begin
      if (m_GodBlessItems[I].wIndex > 0) and g_ItemRules.Get(m_GodBlessItems[I].wIndex, 22) then
      begin
        if DropItemDown(@m_GodBlessItems[I], 2, True, nil, Self) then
        begin
          { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
          // m_GodBlessItems[I].wIndex := 0;
          StdItem := UserEngine.GetStdItem(m_GodBlessItems[I].wIndex);
          m_GodBlessItems[I].wIndex := 0;
          if StdItem <> nil then
            ProcessUseItemSkill(U_GODBLESSITEM1 + I, StdItem, False);
        end;
      end;
    end;
    ErrCode := 7;
    // 爆出包裹的物品
    for I := m_ItemList.Count - 1 downto 0 do
    begin
      UserItem := m_ItemList.Items[I];
      if g_ItemRules.Get(UserItem.wIndex, 22) then
      begin
        if DropItemDown(UserItem, 2, True, nil, Self) then
        begin
          m_ItemList.Delete(I);
          Dispose(UserItem);
        end;
      end;
    end;
    if (not m_boSoftClose) and (not m_boDummyObject) then
    begin
      AddGameDataLog(LOG_PlayerLogOff, LOG_ActionNone, Self, m_sUserID, 0, m_sIPaddr);
    end;
  except
    on E: Exception do
    begin
      MainOutMessage('TPlayObject.DoClientClose, code = ' + IntToStr(ErrCode) + E.Message);
    end;
  end;
end;

{ TODO -ochongchong -c修改 : 处理装备对应的技能，装备上会自动加技能，去掉备删技能 【2013-08-28】 }
procedure TPlayObject.ProcessUseItemSkill(btWhere: Byte; StdItem: pTStdItem; IsTakeOn: Boolean);
  function FindItem(Index: Integer; IsMagicID: Boolean): Boolean;
  var
    where: Integer;
    StdItem2: pTStdItem;
  begin
    Result := False;
    for where := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      if m_UseItems[where].wIndex = 0 then
        Continue;
      StdItem2 := UserEngine.GetStdItem(m_UseItems[where].wIndex);
      if (StdItem2 = nil) then
        Continue;
      // 时装，时装武器学习技能用AniCount判断 chongchong 2014-04-17
      if where in [U_WEAPON, U_RIGHTHAND, U_DRESS, U_FASHIONDRESS, U_FASHIONWEAPON, U_SHIELD] then
      begin
        case Index of
          1:
            if StdItem2.AniCount in [115, 151, 154] then
              Result := True;
          2:
            if StdItem2.AniCount in [116, 152, 155] then
              Result := True;
          3:
            if StdItem2.AniCount = 200 then
              Result := True;
          4:
            if StdItem2.AniCount = 201 then
              Result := True;
        end;
      end
      else
      begin
        case Index of
          1:
            if StdItem2.Shape in [115, 151, 154] then
              Result := True;
          2:
            if StdItem2.Shape in [116, 152, 155] then
              Result := True;
          3:
            if StdItem2.Shape = 200 then
              Result := True;
          4:
            if StdItem2.Shape = 201 then
              Result := True;
        end;
      end;
      if Result then
        Exit;
    end;
    for where := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
    begin
      if (m_JewelryBoxItems[where].wIndex <= 0) or (m_JewelryBoxItems[where].Dura <= 0) then
        Continue;
      StdItem2 := UserEngine.GetStdItem(m_JewelryBoxItems[where].wIndex);
      if (StdItem2 = nil) then
        Continue;
      case Index of
        1:
          if StdItem2.Shape in [115, 151, 154] then
            Result := True;
        2:
          if StdItem2.Shape in [116, 152, 155] then
            Result := True;
        3:
          if StdItem2.Shape = 200 then
            Result := True;
        4:
          if StdItem2.Shape = 201 then
            Result := True;
      end;
      if Result then
        Exit;
    end;
    for where := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
    begin
      if (m_GodBlessItems[where].wIndex <= 0) or (m_GodBlessItems[where].Dura <= 0) then
        Continue;
      StdItem2 := UserEngine.GetStdItem(m_GodBlessItems[where].wIndex);
      if (StdItem2 = nil) then
        Continue;
      case Index of
        1:
          if StdItem2.Shape in [115, 151, 154] then
            Result := True;
        2:
          if StdItem2.Shape in [116, 152, 155] then
            Result := True;
        3:
          if StdItem2.Shape = 200 then
            Result := True;
        4:
          if StdItem2.Shape = 201 then
            Result := True;
      end;
      if Result then
        Exit;
    end;
  end;

var
  UserItem: pTUserItem;
  Expand3, Expand4: Integer;
begin
  {
    1. 火球术
    2. 治愈术
    3. 流星火雨
    4. 倚天辟地
  }
  if IsTakeOn then
  begin
    // 时装，时装武器学习技能用AniCount判断 chongchong 2014-04-17
    if btWhere in [U_WEAPON, U_RIGHTHAND, U_DRESS, U_FASHIONDRESS, U_FASHIONWEAPON, U_SHIELD] then
    begin
      case StdItem.AniCount of
        115, 151, 154:
          AddItemSkill(1, False, 1, False);
        116, 152, 155:
          AddItemSkill(2, False, 1, False);
        200:
          AddItemSkill(3, False, 1, False);
        201:
          AddItemSkill(4, False, 1, False);
        210: // 自定义装备技能
          begin
            // 排除掉马牌 chongchong 2016-03-06
            if StdItem.StdMode <> 28 then
            begin
              UserItem := @m_UseItems[btWhere];
              if UserItem.wNewExpand3 > 0 then
              begin
                Expand3 := UserItem.wNewExpand3;
                Expand4 := UserItem.wNewExpand4;
              end
              else
              begin
                Expand3 := StdItem.Expand3;
                Expand4 := StdItem.Expand4;
              end;
              AddItemSkill(Expand3, True, Expand4 div 10, (Expand4 mod 10) <> 0);
            end;
          end;
      end;
    end
    else
    begin
      case StdItem.Shape of
        115, 151, 154:
          AddItemSkill(1, False, 1, False);
        116, 152, 155:
          AddItemSkill(2, False, 1, False);
        200:
          AddItemSkill(3, False, 1, False);
        201:
          AddItemSkill(4, False, 1, False);
        210: // 自定义装备技能
          begin
            // 排除掉马牌 chongchong 2016-03-06
            if StdItem.StdMode <> 28 then
            begin
              if (btWhere <= High(THumanUseItems)) then
                UserItem := @m_UseItems[btWhere]
              else if (btWhere >= U_JEWELRYITEM1) and (btWhere <= U_JEWELRYITEM6) then
                UserItem := @m_JewelryBoxItems[btWhere - U_JEWELRYITEM1]
              else if (btWhere >= U_GODBLESSITEM1) and (btWhere <= U_GODBLESSITEM12) then
                UserItem := @m_GodBlessItems[btWhere - U_GODBLESSITEM1]
              else
                UserItem := nil;
              if (UserItem <> nil) and (UserItem.wNewExpand3 > 0) then
              begin
                Expand3 := UserItem.wNewExpand3;
                Expand4 := UserItem.wNewExpand4;
              end
              else
              begin
                Expand3 := StdItem.Expand3;
                Expand4 := StdItem.Expand4;
              end;
              AddItemSkill(Expand3, True, Expand4 div 10, (Expand4 mod 10) <> 0);
            end;
          end;
      end;
    end;
  end
  else
  begin
    // 时装，时装武器删除学习技能用 AniCount判断 chongchong 2014-04-17
    if btWhere in [U_WEAPON, U_RIGHTHAND, U_DRESS, U_FASHIONDRESS, U_FASHIONWEAPON, U_SHIELD] then
    begin
      case StdItem.AniCount of
        115, 151, 154:
          if not FindItem(1, False) then
            DelItemSkill(1, False);
        116, 152, 155:
          if not FindItem(2, False) then
            DelItemSkill(2, False);
        200:
          if not FindItem(3, False) then
            DelItemSkill(3, False);
        201:
          if not FindItem(4, False) then
            DelItemSkill(4, False);
        210: // 自定义装备技能
          begin
            // 排除掉马牌 chongchong 2016-03-06
            if StdItem.StdMode <> 28 then
            begin
              UserItem := @m_UseItems[btWhere];
              if UserItem.wNewExpand3 > 0 then
              begin
                Expand3 := UserItem.wNewExpand3;
                // Expand4 := UserItem.wNewExpand4;
              end
              else
              begin
                Expand3 := StdItem.Expand3;
                // Expand4 := StdItem.Expand4;
              end;
              if not FindItem(Expand3, True) then
                DelItemSkill(Expand3, True);
            end;
          end;
      end;
    end
    else
    begin
      case StdItem.Shape of
        115, 151, 154:
          if not FindItem(1, False) then
            DelItemSkill(1, False);
        116, 152, 155:
          if not FindItem(2, False) then
            DelItemSkill(2, False);
        200:
          if not FindItem(3, False) then
            DelItemSkill(3, False);
        201:
          if not FindItem(4, False) then
            DelItemSkill(4, False);
        210: // 自定义装备技能
          begin
            // 排除掉马牌 chongchong 2016-03-06
            if StdItem.StdMode <> 28 then
            begin
              if (btWhere <= High(THumanUseItems)) then
                UserItem := @m_UseItems[btWhere]
              else if (btWhere >= U_JEWELRYITEM1) and (btWhere <= U_JEWELRYITEM6) then
                UserItem := @m_JewelryBoxItems[btWhere - U_JEWELRYITEM1]
              else if (btWhere >= U_GODBLESSITEM1) and (btWhere <= U_GODBLESSITEM12) then
                UserItem := @m_GodBlessItems[btWhere - U_GODBLESSITEM1]
              else
                UserItem := nil;
              if (UserItem <> nil) and (UserItem.wNewExpand3 > 0) then
              begin
                Expand3 := UserItem.wNewExpand3;
                // Expand4 := UserItem.wNewExpand4;
              end
              else
              begin
                Expand3 := StdItem.Expand3;
                // Expand4 := StdItem.Expand4;
              end;
              if not FindItem(Expand3, True) then
                DelItemSkill(Expand3, True);
            end;
          end;
      end;
    end;
  end;
end;

