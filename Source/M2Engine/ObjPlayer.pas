procedure TPlayObject.ClientTurn(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function ClientChangeDir(wIdent: Word; nX, nY, nDir: Integer; var dwDelayTime: LongWord): Boolean; // 4CAEB8
  var
    dwCheckTime: LongWord;
  begin
    Result := False;
    if not(nDir in [DR_UP .. DR_UPLEFT]) then
    begin
      Result := True;
      Exit;
    end;

    dwDelayTime := 0;
    if m_boDeath or (not CanMove) then
      Exit; // 防麻

    if g_Config.boSpeedControl and (not CheckActionStatus(wIdent, dwDelayTime)) then
    begin
      m_boFilterAction := False;
      Exit;
    end;

    m_boFilterAction := True;
    dwCheckTime := MyGetTickCount - m_dwTurnTick;
    if g_Config.boSpeedControl and (dwCheckTime < g_Config.dwTurnIntervalTime) then
    begin
      dwDelayTime := g_Config.dwTurnIntervalTime - dwCheckTime;
      Exit;
    end;

    if (nX = m_nCurrX) and (nY = m_nCurrY) then
    begin
      if m_boShopStall then
      begin // 摆摊
        if not(m_btDirection in [1, 3, 5, 7]) then
        begin
          nDir := m_btDirection + 1;
          if nDir > 7 then
            nDir := 1;
          m_btDirection := nDir;
          // SendRefMsg(RM_TURN, m_btDirection, m_nCurrX, m_nCurrY, 0, '');
        end
        else
        begin
          m_dwTurnTick := MyGetTickCount();
          Result := True;
          Exit;
        end;
      end
      else
      begin
        // 修正外挂隐身 不停的刷 CM_TURN 2019-07-15 11:46:59
        if m_btDirection <> nDir then
          m_btDirection := nDir
        else
          Exit;
      end;

      if Walk(RM_TURN) then
      begin
        m_dwTurnTick := MyGetTickCount();
        Result := True;
      end;
    end;
  end;

var
  dwDelayTime: LongWord;
  nMsgCount: Integer;
  nX, nY: Integer;
begin
  StopCollect;
  DoClientAction(catTurn);
  if ClientChangeDir(ProcessMsg.wIdent, ProcessMsg.nParam1 { x } , ProcessMsg.nParam2 { y } , ProcessMsg.wParam { dir } ,
    dwDelayTime) then
  begin
    m_dwActionTick := MyGetTickCount;
    {
      nParam: 成功1 / 失败0
      nTag: 是否包含附加数据
      nRecog: 附加数据
    }

    SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');

    // 骑马同步坐标 chongchong 2014-05-15
    if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
    begin
      // GetBackPosition(nX, nY);
      nX := m_nCurrX;
      nY := m_nCurrY;
      if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
        TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
      begin
        TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
        TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
        TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
        TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
      end;
    end;
  end
  else
  begin
    if dwDelayTime = 0 then
    begin
      SendSocketStatusFail;

      // 骑马同步坐标 chongchong 2014-05-15
      if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
      begin
        // GetBackPosition(nX, nY);
        nX := m_nCurrX;
        nY := m_nCurrY;
        if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
          TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
        begin
          TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
          TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
          TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
          TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
        end;
      end;
    end
    else
    begin
      nMsgCount := GetTurnMsgCount();
      if nMsgCount >= g_Config.nMaxTurnMsgCount then
      begin
        Inc(m_nOverSpeedCount);
        if m_nOverSpeedCount > g_Config.nOverSpeedKickCount then
        begin
          if g_Config.boKickOverSpeed then
          begin
            SysMsg(g_sKickClientUserMsg { '请勿使用非法软件！' } , c_Red, t_Hint);
            m_boEmergencyClose := True;
            m_boPlayOffLine := False; // 关闭下线触发
          end;

          if g_Config.boViewHackMessage then
            MainOutMessage(Format(g_sBunOverSpeed, [1, m_sCharName, dwDelayTime, nMsgCount]));
        end;

        // 如果超速则发送攻击失败信息
        SendSocketStatusFail;

        // 骑马同步坐标 chongchong 2014-05-15
        if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
        begin
          // GetBackPosition(nX, nY);
          nX := m_nCurrX;
          nY := m_nCurrY;
          if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
            TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
          begin
            TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
            TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
            TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
            TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
          end;
        end;
      end
      else
      begin
        if dwDelayTime < g_Config.dwDropOverSpeed then
        begin
          SendSocketStatusFail;
          if g_Config.boViewHackMessage then
            MainOutMessage(Format(g_sBunOverSpeed, [2, m_sCharName, dwDelayTime, nMsgCount]));

          // 骑马同步坐标 chongchong 2014-05-15
          if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
          begin
            // GetBackPosition(nX, nY);
            nX := m_nCurrX;
            nY := m_nCurrY;
            if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
              TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
            begin
              TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
              TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
              TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
              TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
            end;
          end;
        end
        else
        begin
          dwDelayTime := Min(dwDelayTime, g_Config.nMaxTurnDeliveryTime);
          if dwDelayTime > 0 then
          begin
            SendDelayMsg(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2, ProcessMsg.nParam3,
              '', dwDelayTime);
          end;
          boResult := False;
        end;
      end;
    end;
  end;
end;

procedure TPlayObject.ClientWalk(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function ClientWalkXY(wIdent: Word; nX, nY: Integer; boLateDelivery: Boolean; var dwDelayTime: LongWord; dwTimeTick: LongWord)
    : Boolean; // 004CAF08
  var
    n14: Integer;
    dwCheckTime: LongWord;
    dwWalkIntervalTime: Integer;
    Hero: THeroObject;
    nHeroDir, nCount: Integer;
  begin
    Result := False;
    dwDelayTime := 0;
    if (not m_boCanWalk) or m_boDeath or (m_wStatusTimeArr[STATE_FROZEN] <> 0) or (not CanParaly(1)) then
      Exit;

    {
      if m_boContinuous and (m_btJob in [1, 2]) then
      begin // 正在连击 如果是法师或道士 停止连击
      m_boContinuous := False;
      SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
      end;
    }

    if g_Config.boCheckActionCount then
      Inc(m_nMoveCount);

    if not boLateDelivery then
    begin
      if g_Config.boSpeedControl and (g_Config.dwWalkIntervalTime > 0) and not CheckActionStatus(wIdent, dwDelayTime) then
      begin
        m_boFilterAction := False;
        Exit;
      end;

      dwWalkIntervalTime := g_Config.dwWalkIntervalTime;
      if m_nMoveSpeed <> 0 then // 行走速度  自动调整变速后时间间隔
        dwWalkIntervalTime := Max(dwWalkIntervalTime - (g_Config.dwIncMoveSpeedDecInterval * m_nMoveSpeed), 0);

      m_boFilterAction := True;
      if g_Config.boSpeedControl and (dwWalkIntervalTime > 0) then
      begin
        dwCheckTime := dwTimeTick - m_dwMoveTick; // MyGetTickCount

        if dwCheckTime < dwWalkIntervalTime then
        begin
          Inc(m_dwMoveCount);
          dwDelayTime := Max(dwWalkIntervalTime - dwCheckTime, 0);
          if dwDelayTime > dwWalkIntervalTime div 3 then
          begin
            if m_dwMoveCount >= 4 then
            begin
              m_dwMoveTick := MyGetTickCount();
              m_dwMoveCount := 0;
              dwDelayTime := dwWalkIntervalTime div 3;
              if g_Config.boViewHackMessage then
                MainOutMessage(Format('[走路复位] %s 延时:%d', [m_sCharName, dwDelayTime]));
            end
            else
            begin
              m_dwMoveCount := 0;
              if g_Config.boViewHackMessage then
                MainOutMessage(Format('[走路超速] %s 延时:%d', [m_sCharName, dwDelayTime]));
            end;
            Exit;
          end
          else
            Exit;
        end;
      end;
    end;

    m_dwMoveTick := MyGetTickCount();
    m_bo316 := False;
    n14 := GetNextDirection(m_nCurrX, m_nCurrY, nX, nY);
    if m_MyHero <> nil then
    begin
      Hero := THeroObject(m_MyHero);
      if (not Hero.m_boProtectStatus) //
        and (Hero.m_btAttackMode <> 2) //
        and (Hero.m_TargetCret = nil) //
        and (abs(m_nCurrX - Hero.m_nCurrX) <= 2) //
        and (abs(m_nCurrY - Hero.m_nCurrY) <= 2) //
        and (GetNextDirection(m_nCurrX, m_nCurrY, Hero.m_nCurrX, Hero.m_nCurrY) = n14) then
      begin
        nHeroDir := GetNextDirection(Hero.m_nCurrX, Hero.m_nCurrY, m_nCurrX, m_nCurrY);

        if (nHeroDir in [DR_UPRIGHT, DR_DOWNLEFT]) //
          and (abs(m_nCurrX - Hero.m_nCurrX) = 2) //
          and (abs(m_nCurrY - Hero.m_nCurrY) = 1) then
        begin
          nHeroDir := (nHeroDir + 1) mod 8;
          nHeroDir := GetDifferenceDirection(nHeroDir);
        end
        else if (nHeroDir in [DR_UPLEFT, DR_DOWNRIGHT]) //
          and (abs(m_nCurrX - Hero.m_nCurrX) = 1) //
          and (abs(m_nCurrY - Hero.m_nCurrY) = 2) then
        begin
          nHeroDir := (nHeroDir + 1) mod 8;
          nHeroDir := GetDifferenceDirection(nHeroDir);
        end
        else
          nHeroDir := (nHeroDir + 1) mod 8;

        if not Hero.WalkTo(nHeroDir, False) then
        begin
          nCount := 0;
          while True do
          begin
            nHeroDir := Random(8);
            if nHeroDir <> GetDifferenceDirection(n14) then
            begin
              Hero.WalkTo(nHeroDir, False);
              Break;
            end;

            Inc(nCount);
            if nCount >= 10 then
              Break;
          end;
        end;
      end;
    end;

    if WalkTo(n14, False) then
    begin
      // MainOutMessage(Format('方向: %d，走位: %d, %d --> %d, %d', [n14, nOldX, nOldY, nX, nY]));
      if m_bo316 or ((m_nCurrX = nX) and (m_nCurrY = nY)) then
        Result := True
      else
      begin
        // MainOutMessage(Format('方向: %d，走位: %d, %d --> %d, %d; 实际: %d, %d', [n14, nOldX, nOldY, nX, nY, m_nCurrX, m_nCurrY]));
      end;
      Dec(m_nHealthTick, 10);
    end
    else
    begin
      m_dwMoveCount := 0;
      m_dwMoveCountA := 0;
    end;
  end;

var
  dwDelayTime: LongWord;
  nMsgCount: Integer;
  boRunHuman, boRunMon, boRunNpc, boRunGuard: Boolean;
  nX, nY { , nOldX, nOldY } : Integer;
begin
  if m_boShopStall then
    Exit; // 正在摆摊

  StopCollect;

  // 修复人物在跑动过程中，被英雄野蛮冲撞后出现错位 chongchong 2018-07-06 00:33:23
  if m_dwPushedTick <> 0 then
  begin
    if Tick_Diff(m_dwPushedTick, MyGetTickCount) <= 500 then
    begin
      m_dwPushedTick := 0;
      SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
      Exit;
    end;
    m_dwPushedTick := 0;
  end;

  // 修复在跑步过程中，使用随机传送卷卡位 chongchong 2017-11-21
  // 原因在于 CM_EAT 是按了1-6键马上使用，而cm_walk/cm_run在消息中中转导致在 cm_eat后面，本来应该先cm_walk/cm_run，再cm_eat随机，在客户的原因导致数据包顺序错误 chongchong 2017-11-21
  if MyGetTickCount - m_dwMapMoveTick < 100 then
  begin
    SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
    Exit;
  end;

  DoClientAction(catWalk);
  if ClientWalkXY(ProcessMsg.wIdent, ProcessMsg.nParam1 { x } , ProcessMsg.nParam2 { y } , ProcessMsg.boLateDelivery, dwDelayTime,
    ProcessMsg.dwTimeTick) then
  begin
    m_dwActionTick := MyGetTickCount;
    GetMapCanRun(boRunHuman, boRunMon, boRunNpc, boRunGuard);
    SendDefMessage(SM_ACTION_RET, MakeLong(MakeWord(Byte(boRunHuman), Byte(boRunMon)), MakeWord(Byte(boRunNpc), Byte(boRunGuard))
      ), 1, 1, 0, '');

    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@Walk', False);
    end;

    // 骑马 同步坐标 chongchong 2013-10-15
    if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
    begin
      nX := m_nCurrX;
      nY := m_nCurrY;
      if ((abs(m_nCurrX - m_HorseOtherHum.m_nCurrX) >= 3) or (abs(m_nCurrY - m_HorseOtherHum.m_nCurrY) >= 3)) then
      begin
        if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
          TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
        begin
          TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
          TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
          TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
          TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
        end;
      end
      else
      begin
        TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
        TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 1, nX, nY, m_btDirection, '');
      end;
    end;
    // Inc(n5F8);
  end
  else
  begin
    // MainOutMessage(Format('走失败: %d, %d --> %d, %d', [nOldX, nOldY, nX, nY]));
    if dwDelayTime = 0 then
    begin
      SendSocketStatusFail;
      // m_dwMoveTick := MyGetTickCount() - g_Config.dwWalkIntervalTime;
      // 骑马同步坐标 chongchong 2014-05-15
      if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
      begin
        nX := m_nCurrX;
        nY := m_nCurrY;
        if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
          TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
        begin
          TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
          TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
          TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
          TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
        end;
      end;
    end
    else
    begin
      nMsgCount := GetWalkMsgCount();
      if nMsgCount >= g_Config.nMaxWalkMsgCount then
      begin
        Inc(m_nOverSpeedCount);
        if (m_nOverSpeedCount > g_Config.nOverSpeedKickCount) and g_Config.boKickOverSpeed then
        begin
          SysMsg(g_sKickClientUserMsg { '请勿使用非法软件！' } , c_Red, t_Hint);
          m_boEmergencyClose := True;
          m_boPlayOffLine := False; // 关闭下线触发
        end;

        // MainOutMessage('走恢复坐标');
        SendSocketStatusFail;
        // m_dwMoveTick := MyGetTickCount() - g_Config.dwWalkIntervalTime;

        // 如果超速则发送攻击失败信息
        if g_Config.boViewHackMessage then
          MainOutMessage(Format(g_sWalkOverSpeed, [1, m_sCharName, dwDelayTime, nMsgCount]));

        // 骑马同步坐标 chongchong 2014-05-15
        if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
        begin
          // GetBackPosition(nX, nY);
          nX := m_nCurrX;
          nY := m_nCurrY;
          if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
            TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
          begin
            TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
            TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
            TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
            TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
          end;
        end;
      end
      else
      begin
        if (dwDelayTime > g_Config.dwDropOverSpeed) and (g_Config.btSpeedControlMode = 1) and m_boFilterAction then
        begin
          // MainOutMessage('走恢复坐标');
          SendSocketStatusFail;

          // m_dwMoveTick := MyGetTickCount() - g_Config.dwWalkIntervalTime;
          if g_Config.boViewHackMessage then
            MainOutMessage(Format(g_sWalkOverSpeed, [2, m_sCharName, dwDelayTime, nMsgCount]));

          // 骑马同步坐标 chongchong 2014-05-15
          if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
          begin
            // GetBackPosition(nX, nY);
            nX := m_nCurrX;
            nY := m_nCurrY;
            if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
              TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
            begin
              TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
              TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
              TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
              TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
            end;
          end;
        end
        else
        begin
          // 修复错位 chongchog 2014-10-25
          // MainOutMessage(Format('延时走: 目标位置%d, %d', [ProcessMsg.nParam1, ProcessMsg.nParam2]));
          SendDelayMsg(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2, ProcessMsg.nParam3, '',
            Min(dwDelayTime, g_Config.nMaxWalkDeliveryTime));
          boResult := False;
        end;
      end;
    end;
  end;
end;

procedure TPlayObject.ClientSitDown(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function ClientGetButchItem(BaseObject: TBaseObject; nX, nY: Integer; btDir: Byte; boLateDelivery: Boolean;
    var dwDelayTime: LongWord): Boolean; // 004DB7E0
  var
    n10, n14, nBodyLeathery, nError: Integer;
    dwCheckTime: LongWord;
    boButch: Boolean;
  resourcestring
    sExceptionMsg = '[Exception] TPlayObject.ClientGetButchItem ';
  begin
    Result := False;
    dwDelayTime := 0;
    m_boButch := True;
    nError := 0;
    try
      if g_Config.boSpeedControl and (not boLateDelivery) then
      begin
        if (g_Config.dwDigUpIntervalTime > 0) and not CheckActionStatus(CM_SITDOWN, dwDelayTime) then
        begin
          m_boFilterAction := False;
          Exit;
        end;

        m_boFilterAction := True;
        dwCheckTime := MyGetTickCount - m_dwSitDownTick;
        if dwCheckTime < g_Config.dwDigUpIntervalTime then
        begin
          dwDelayTime := g_Config.dwDigUpIntervalTime - dwCheckTime;
          Exit;
        end;
      end;

      Result := True;
      m_btDirection := btDir;
      m_dwSitDownTick := MyGetTickCount;
      m_dwActionTick := MyGetTickCount;
      m_dwButchTick := MyGetTickCount;
      m_dwMoveTick := MyGetTickCount(); // 防止挖地暗杀
      m_dwMagicAttackTick := MyGetTickCount(); // 防止挖地暗杀
      m_dwAttackTick := MyGetTickCount(); // 防止挖地暗杀
      GetFrontPosition(nX, nY);

      nError := 4;
      if (BaseObject <> nil) //
        and (abs(nX - m_nCurrX) <= 2) //
        and (abs(nY - m_nCurrY) <= 2) //
        and ((nX <> m_nCurrX) or (nY <> m_nCurrY)) then
      begin
        nError := 5;
        // 检查对象是否有效 ............
        if m_PEnvir.IsValidObjectEx(nX, nY, 2, BaseObject) then
        begin
          nError := 6;
          // 人形怪也可能能挖肉 chongchong 2014-06-04 加 or (BaseObject.m_btRaceServer = RC_PLAYMOSTER)
          if BaseObject.m_boDeath //
            and (not BaseObject.m_boSkeleton) //
            and (BaseObject.m_boAnimal or (BaseObject.m_btRaceServer = RC_PLAYMOSTER) or (BaseObject.m_wExploreItem = 1)) then
          begin
            nError := 7;
            nBodyLeathery := 201;
            boButch := True;
            if BaseObject.m_btRaceServer = RC_PLAYMOSTER then
            begin
              boButch := TSmartObject(BaseObject).m_boButch;
              if boButch then
                nBodyLeathery := TSmartObject(BaseObject).m_nBodyLeathery;
            end;

            nError := 8;
            if boButch then
            begin
              nError := 9;
              n10 := Random(16) + 5;
              n14 := Random(nBodyLeathery) + 100;
              Dec(BaseObject.m_nBodyLeathery, n10);
              Dec(BaseObject.m_nMeatQuality, n14);
              nError := 10;
              if BaseObject.m_nMeatQuality < 0 then
                BaseObject.m_nMeatQuality := 0;

              { TODO -ochongchong -c新增 : 挖肉时延长尸体消失时间 【2013-08-18】 }
              dwCheckTime := g_Config.dwMakeGhostTime div 2;
              if (MyGetTickCount > BaseObject.m_dwDeathTick) and ((MyGetTickCount - BaseObject.m_dwDeathTick) > dwCheckTime) then
              begin
                if BaseObject.m_dwDeathTickEx > dwCheckTime then
                begin
                  Inc(BaseObject.m_dwDeathTick, dwCheckTime);
                  Dec(BaseObject.m_dwDeathTickEx, dwCheckTime);
                end
                else if BaseObject.m_dwDeathTickEx > 0 then
                begin
                  Inc(BaseObject.m_dwDeathTick, BaseObject.m_dwDeathTickEx);
                  BaseObject.m_dwDeathTickEx := 0;
                end;
              end;

              if BaseObject.m_nBodyLeathery <= 0 then
              begin
                nError := 11;
                if (BaseObject.m_btRaceServer >= RC_ANIMAL) and (BaseObject.m_btRaceServer < RC_MONSTER) then
                begin
                  BaseObject.m_boSkeleton := True;
                  nError := 12;
                  BaseObject.ApplyMeatQuality();
                  nError := 13;
                  BaseObject.SendRefMsg(RM_SKELETON, BaseObject.m_btDirection, BaseObject.m_nCurrX, BaseObject.m_nCurrY, 0, '');
                  nError := 14;
                end;

                nError := 30;
                // 人形怪挖取单独来搞 chongchong 2015-01-13
                if (BaseObject.m_btRaceServer = RC_PLAYMOSTER) and (BaseObject is THumMon) then
                begin
                  nError := 31;
                  if not THumMon(BaseObject).TakeItemsToPlayer(Self) then
                    SysMsg(sYouFoundNothing { 未发现任何物品！ } , c_Red, t_Hint)
                  else
                    SendRefMsg(RM_STRUCKEFFECT, 0, 1, 0, 0, '');
                end
                else
                begin
                  nError := 32;
                  if not TakeBagItems(BaseObject) then
                    SysMsg(sYouFoundNothing { 未发现任何物品！ } , c_Red, t_Hint)
                  else if BaseObject.m_wExploreItem = 1 then
                    SendRefMsg(RM_STRUCKEFFECT, 0, 1, 0, 0, '');
                  nError := 16;
                end;
                BaseObject.m_nBodyLeathery := 50;
              end;

              nError := 17;
              m_dwDeathTick := MyGetTickCount();
              // 挖取怪物时触发 chongchong 2014-01-05
              if g_FunctionNPC <> nil then
              begin
                m_nScriptGotoCount := 0;
                g_FunctionNPC.GotoLable(Self, '@ButchCloneItem' + BaseObject.m_sCharName, False);
              end;
            end;
          end;
        end;
      end;
    except
      on E: Exception do
      begin
        MainOutMessage(sExceptionMsg + IntToStr(nError));
        MainOutMessage(E.Message);
      end;
    end;
    SendRefMsg(RM_BUTCH, m_btDirection, m_nCurrX, m_nCurrY, 0, '');
  end;

var
  dwDelayTime: LongWord;
  nMsgCount: Integer;
begin
  if m_boShopStall then
    Exit; // 正在摆摊

  StopCollect;

  if ClientGetButchItem(TBaseObject(ProcessMsg.nParam3), ProcessMsg.nParam1, ProcessMsg.nParam2, ProcessMsg.wParam,
    ProcessMsg.boLateDelivery, dwDelayTime) then
  begin
    m_dwActionTick := MyGetTickCount();
    SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
  end
  else
  begin
    if dwDelayTime = 0 then
    begin
      SendSocketStatusFail;
    end
    else
    begin
      nMsgCount := GetSiteDownMsgCount();
      if nMsgCount >= g_Config.nMaxSitDonwMsgCount then
      begin
        Inc(m_nOverSpeedCount);
        if m_nOverSpeedCount > g_Config.nOverSpeedKickCount then
        begin
          if g_Config.boKickOverSpeed then
          begin
            SysMsg(g_sKickClientUserMsg { '请勿使用非法软件！' } , c_Red, t_Hint);
            m_boEmergencyClose := True;
            m_boPlayOffLine := False; // 关闭下线触发
          end;

          if g_Config.boViewHackMessage then
            MainOutMessage(Format(g_sBunOverSpeed, [1, m_sCharName, dwDelayTime, nMsgCount]));
        end;
        // 如果超速则发送攻击失败信息
        SendSocketStatusFail;
      end
      else
      begin
        if dwDelayTime < g_Config.dwDropOverSpeed then
        begin
          SendSocketStatusFail;
          if g_Config.boViewHackMessage then
            MainOutMessage(Format(g_sBunOverSpeed, [2, m_sCharName, dwDelayTime, nMsgCount]));
        end
        else
        begin
          SendDelayMsg(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2, ProcessMsg.nParam3, '',
            Min(dwDelayTime, g_Config.nMaxDigUpDeliveryTime));
          boResult := False;
        end;
      end;
    end;
  end;
end;

procedure TPlayObject.ClientRun(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function ClientRunXY(wIdent: Word; nX, nY: Integer; boLateDelivery: Boolean; var dwDelayTime: LongWord;
    dwTimeTick: LongWord): Boolean;
  var
    nDir: Integer;
    dwCheckTime: LongWord;
    dwRunIntervalTime: Integer;
    Hero: THeroObject;
    nHeroDir, nCount: Integer;
    bo29: Boolean;
  begin
    Result := False;
    dwDelayTime := 0;

    if m_boDeath //
      or (not m_boCanRun) //
      or m_boCobwebWindingStatus { 被网罩住不能跑 }
      or (m_wStatusTimeArr[STATE_FROZEN] <> 0) //
      or (not CanParaly(0)) //
      or (m_nChangeAppr >= 0) then
      Exit;

    {
      if m_boContinuous and (m_btJob in [1, 2]) then
      begin // 正在连击 如果是法师或道士 停止连击
      m_boContinuous := False;
      SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
      end;
    }

    if g_Config.boCheckActionCount then
      Inc(m_nMoveCount);

    if not boLateDelivery then
    begin
      if g_Config.boSpeedControl and (g_Config.dwRunIntervalTime > 0) then
      begin
        if not CheckActionStatus(wIdent, dwDelayTime) then
        begin
          m_boFilterAction := False;
          Exit;
        end;
      end;

      dwRunIntervalTime := g_Config.dwRunIntervalTime;
      if m_nMoveSpeed <> 0 then // 行走速度 自动调整变速后时间间隔
        dwRunIntervalTime := Max(dwRunIntervalTime - (g_Config.dwIncMoveSpeedDecInterval * m_nMoveSpeed), 0);

      m_boFilterAction := True;
      if g_Config.boSpeedControl and (dwRunIntervalTime > 0) then
      begin
        dwCheckTime := dwTimeTick - m_dwMoveTick; // MyGetTickCount

        if dwCheckTime < dwRunIntervalTime then
        begin
          Inc(m_dwMoveCount);
          dwDelayTime := Max(dwRunIntervalTime - dwCheckTime, 0);
          if dwDelayTime > dwRunIntervalTime div 3 then
          begin
            if m_dwMoveCount >= 4 then
            begin
              m_dwMoveTick := MyGetTickCount();
              m_dwMoveCount := 0;
              dwDelayTime := dwRunIntervalTime div 3;
              if g_Config.boViewHackMessage then
                MainOutMessage(Format('[跑步复位] %s 延时:%d', [m_sCharName, dwDelayTime]));
            end
            else
              m_dwMoveCount := 0;
            Exit;
          end
          else
            Exit;
        end;
      end;
    end;

    m_dwMoveTick := MyGetTickCount();
    m_bo316 := False;
    nDir := GetNextDirection(m_nCurrX, m_nCurrY, nX, nY);
    if m_MyHero <> nil then
    begin
      Hero := THeroObject(m_MyHero);
      if (not Hero.m_boProtectStatus) //
        and (Hero.m_btAttackMode <> 2) //
        and (Hero.m_TargetCret = nil) //
        and (abs(m_nCurrX - Hero.m_nCurrX) <= 2) //
        and (abs(m_nCurrY - Hero.m_nCurrY) <= 2) //
        and (GetNextDirection(m_nCurrX, m_nCurrY, Hero.m_nCurrX, Hero.m_nCurrY) = nDir) then
      begin
        nHeroDir := GetNextDirection(Hero.m_nCurrX, Hero.m_nCurrY, m_nCurrX, m_nCurrY);

        if (nHeroDir in [DR_UPRIGHT, DR_DOWNLEFT]) //
          and (abs(m_nCurrX - Hero.m_nCurrX) = 2) //
          and (abs(m_nCurrY - Hero.m_nCurrY) = 1) then
        begin
          nHeroDir := (nHeroDir + 1) mod 8;
          nHeroDir := GetDifferenceDirection(nHeroDir);
        end
        else if (nHeroDir in [DR_UPLEFT, DR_DOWNRIGHT]) //
          and (abs(m_nCurrX - Hero.m_nCurrX) = 1) //
          and (abs(m_nCurrY - Hero.m_nCurrY) = 2) then
        begin
          nHeroDir := (nHeroDir + 1) mod 8;
          nHeroDir := GetDifferenceDirection(nHeroDir);
        end
        else
          nHeroDir := (nHeroDir + 1) mod 8;

        if not Hero.WalkTo(nHeroDir, False) then
        begin
          nCount := 0;
          while True do
          begin
            nHeroDir := Random(8);
            if nHeroDir <> GetDifferenceDirection(nDir) then
            begin
              Hero.WalkTo(nHeroDir, False);
              Break;
            end;
            Inc(nCount);

            if nCount >= 10 then
              Break;
          end;
        end;
      end;
    end;

    if RunTo(nDir, False) then
    begin
      if m_boTransparent and (m_boHideMode) then
      begin
        bo29 := True;
        if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
          bo29 := TSmartObject(Self).m_nHideModeEx = 0;

        // 隐身术跑一步就取消 2020-03-23 17:17:16
        if (m_wStatusTimeArr[STATE_TRANSPARENT { 0 0x70 } ] > 0) and bo29 then
        begin
          m_wStatusTimeArr[STATE_TRANSPARENT { 0 0x70 } ] := 0;
          m_boHideMode := False;
          m_nCharStatus := GetCharStatus();
          StatusChanged();
        end;
        (*
          m_wStatusTimeArr[STATE_TRANSPARENT {0 0x70}] := 1;
          m_dwDecStatusArrTick[STATE_TRANSPARENT] := 0;     // 2020-03-23 17:00:02
        *)
      end;

      Result := True;
      if (m_nCurrX <> nX) or (m_nCurrY <> nY) then
      begin
        // 防止在跑的过程中，按下快捷键立即上马后，会出现停顿 chongchong 2015-07-04
        // 服务器记录客户在马上，而客户端还没有收到已上马，跑步算两格
        if g_Config.boHorseRun3Grid //
          and (MyGetTickCount - m_dwClientTakeHorseTick <= 1500) //
          and m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nX, nY, True) then
        begin
          m_nCurrX := nX;
          m_nCurrY := nY;
        end
        else // 防止反弹卡位
        begin
          // 防止过图卡位 chongchong 2017-11-21
          if MyGetTickCount - m_dwMapMoveTick < 200 then
          begin
            SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
            Exit;
          end
          else
          begin
            SendRefMsg(RM_TURN2, m_btDirection, m_nCurrX, m_nCurrY, 0, '');
          end;
        end;
      end;

      Dec(m_nHealthTick, 60);
      Dec(m_nSpellTick, 10);
      m_nSpellTick := Max(0, m_nSpellTick);
      Dec(m_nPerHealth);
      Dec(m_nPerSpell);
    end
    else
    begin
      m_dwMoveCount := 0;
      m_dwMoveCountA := 0;
    end;
  end;

var
  dwDelayTime: LongWord;
  nMsgCount: Integer;
  boRunHuman, boRunMon, boRunNpc, boRunGuard: Boolean;
  // nOldX, nOldY: Integer;
  nX, nY: Integer;
begin
  if m_boShopStall then
    Exit; // 正在摆摊

  StopCollect;

  // 修复人物在跑动过程中，被英雄野蛮冲撞后出现错位 chongchong 2018-07-06 00:33:23
  if m_dwPushedTick <> 0 then
  begin
    if Tick_Diff(m_dwPushedTick, MyGetTickCount) <= 500 then
    begin
      SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
      m_dwPushedTick := 0;
      Exit;
    end;
    m_dwPushedTick := 0;
  end;

  // 修复在跑步过程中，使用随机传送卷卡位 chongchong 2017-11-21
  // 原因在于 CM_EAT 是按了1-6键马上使用，而cm_walk/cm_run在消息中中转导致在 cm_eat后面，本来应该先cm_walk/cm_run，再cm_eat随机，在客户的原因导致数据包顺序错误 chongchong 2017-11-21
  if MyGetTickCount - m_dwMapMoveTick < 100 then
  begin
    SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
    Exit;
  end;

  DoClientAction(catRun);

  // 骑马 同步坐标 chongchong 2013-10-15
  if (m_boOnHorse and (not m_boHorseMaster)) then
  begin
    SetTargetXY(ProcessMsg.nParam1 { x } , ProcessMsg.nParam2 { y } );
    RunToTargetXY;
    SendDefMessage(SM_ACTION_RET, MakeLong(MakeWord(1, 0), MakeWord(0, 0)), 1, 1, 0, '');
    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@Run', False);
    end;
    Exit;
  end;

  // MainOutMessage('-------------------------------------------------');
  // MainOutMessage(Format('跑:%d, %d --> %d, %d', [m_nCurrX, m_nCurrY, ProcessMsg.nParam1, ProcessMsg.nParam2]));
  // nOldX := m_nCurrX;
  // nOldY := m_nCurrY;
  if ClientRunXY(ProcessMsg.wIdent, ProcessMsg.nParam1 { x } , ProcessMsg.nParam2 { y } , ProcessMsg.boLateDelivery, dwDelayTime,
    ProcessMsg.dwTimeTick) then
  begin
    m_dwActionTick := MyGetTickCount;
    // MainOutMessage(Format('跑成功: 当前位置%d, %d', [m_nCurrX, m_nCurrY]));
    GetMapCanRun(boRunHuman, boRunMon, boRunNpc, boRunGuard);
    SendDefMessage(SM_ACTION_RET, MakeLong(MakeWord(Byte(boRunHuman), Byte(boRunMon)), MakeWord(Byte(boRunNpc), Byte(boRunGuard))
      ), 1, 1, 0, '');
    {
      if SameText(m_sCharName, 'xxxx') then
      begin
      MainOutMessage('xxxx跑步成功' + IntToStr(MyGetTickCount));
      end;
    }
    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@Run', False);
    end;

    // 骑马 同步坐标 chongchong 2013-10-15
    if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
    begin
      // GetBackPosition(nX, nY);
      nX := m_nCurrX;
      nY := m_nCurrY;
      if ((abs(m_nCurrX - m_HorseOtherHum.m_nCurrX) >= 5) or (abs(m_nCurrY - m_HorseOtherHum.m_nCurrY) >= 5)) then
      begin
        if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
          TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
        begin
          TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
          TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
          TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
          TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
        end;
      end
      else
      begin
        TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
        TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 2, nX, nY, m_btDirection, '');
      end;
    end;
    // Inc(n5F8);
  end
  else
  begin
    // MainOutMessage(Format('跑失败: %d, %d -> %d, %d', [nOldX, nOldY, ProcessMsg.nParam1 {x}, ProcessMsg.nParam2 {y}]));
    if dwDelayTime = 0 then
    begin
      SendSocketStatusFail;
      // MainOutMessage('跑恢复坐标');
      // m_dwMoveTick := MyGetTickCount() - g_Config.dwRunIntervalTime;
      // 骑马同步坐标 chongchong 2014-05-15
      if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
      begin
        // GetBackPosition(nX, nY);
        nX := m_nCurrX;
        nY := m_nCurrY;
        if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
          TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
        begin
          TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
          TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
          TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
          TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
        end;
      end;
    end
    else
    begin
      nMsgCount := GetRunMsgCount();
      if nMsgCount >= g_Config.nMaxRunMsgCount then
      begin
        Inc(m_nOverSpeedCount);
        if m_nOverSpeedCount > g_Config.nOverSpeedKickCount then
        begin
          if g_Config.boKickOverSpeed then
          begin
            SysMsg(g_sKickClientUserMsg { '请勿使用非法软件！' } , c_Red, t_Hint);
            m_boEmergencyClose := True;
            m_boPlayOffLine := False;
          end;

          if g_Config.boViewHackMessage then
          begin
            // MainOutMessage('[跑步超速] ' + m_sCharName + ' Time: ' + IntToStr(dwDelayTime) + ' Count: '+ IntToStr(nMsgCount));
            MainOutMessage(Format(g_sRunOverSpeed, [1, m_sCharName, dwDelayTime, nMsgCount]));
          end;
        end;
        // 如果超速则发送攻击失败信息
        SendSocketStatusFail;
        // MainOutMessage('跑恢复坐标');
        // m_dwMoveTick := MyGetTickCount() - g_Config.dwRunIntervalTime;
        // 骑马同步坐标 chongchong 2014-05-15
        if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
        begin
          // GetBackPosition(nX, nY);
          nX := m_nCurrX;
          nY := m_nCurrY;
          if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
            TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
          begin
            TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
            TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
            TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
            TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
          end;
        end;
      end
      else
      begin
        if (dwDelayTime > g_Config.dwDropOverSpeed) and (g_Config.btSpeedControlMode = 1) and m_boFilterAction then
        begin
          SendSocketStatusFail;
          // MainOutMessage('跑恢复坐标');
          // m_dwMoveTick := MyGetTickCount() - g_Config.dwRunIntervalTime;
          if g_Config.boViewHackMessage then
            MainOutMessage(Format(g_sRunOverSpeed, [2, m_sCharName, dwDelayTime, nMsgCount]));

          // 骑马同步坐标 chongchong 2014-05-15
          if m_boOnHorse and m_boHorseMaster and (m_HorseOtherHum <> nil) then
          begin
            // GetBackPosition(nX, nY);
            nX := m_nCurrX;
            nY := m_nCurrY;
            if TPlayObject(m_HorseOtherHum).m_PEnvir.MoveToMovingObject(TPlayObject(m_HorseOtherHum).m_nCurrX,
              TPlayObject(m_HorseOtherHum).m_nCurrY, m_HorseOtherHum, nX, nY, False) then
            begin
              TPlayObject(m_HorseOtherHum).m_nCurrX := nX;
              TPlayObject(m_HorseOtherHum).m_nCurrY := nY;
              TPlayObject(m_HorseOtherHum).m_btDirection := m_btDirection;
              TPlayObject(m_HorseOtherHum).SendMsg(m_HorseOtherHum, RM_SYNCSCREEN, 3, nX, nY, m_btDirection, '');
            end;
          end;
        end
        else
        begin
          // 修复错位 chongchog 2014-10-25
          // MainOutMessage(Format('延时跑: 目标位置%d, %d', [ProcessMsg.nParam1, ProcessMsg.nParam2]));
          SendDelayMsg(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2, ProcessMsg.nParam3, '',
            Min(dwDelayTime, g_Config.nMaxRunDeliveryTime));
          boResult := False;
        end;
      end;
    end;
  end;
end;

procedure TPlayObject.ClientHorseRun(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function ClientHorseRunXY(wIdent: Word; nX, nY: Integer; boLateDelivery: Boolean; var dwDelayTime: LongWord;
    dwTimeTick: LongWord): Boolean;
  var
    n14: Integer;
    dwCheckTime: LongWord;
    dwRunIntervalTime: Integer;
  begin
    Result := False;
    dwDelayTime := 0;
    if not m_boCanRun then
      Exit;

    if m_boDeath //
      or (not m_boCanRun) //
      or m_boCobwebWindingStatus { 被网罩住不能跑 }
      or (m_wStatusTimeArr[STATE_FROZEN] <> 0) //
      or (not CanParaly(0)) //
      or (m_nChangeAppr >= 0) then
      Exit;

    if g_Config.boCheckActionCount then
      Inc(m_nMoveCount);
    if g_Config.boSpeedControl and (not boLateDelivery) then
    begin
      if not CheckActionStatus(wIdent, dwDelayTime) then
      begin
        m_boFilterAction := False;
        Exit;
      end;

      dwRunIntervalTime := g_Config.dwRunIntervalTime;
      if m_nMoveSpeed <> 0 then // 行走速度  自动调整变速后时间间隔
        dwRunIntervalTime := Max(dwRunIntervalTime - (g_Config.dwIncMoveSpeedDecInterval * m_nMoveSpeed), 0);

      m_boFilterAction := True;
      dwCheckTime := dwTimeTick - m_dwMoveTick; // MyGetTickCount
      if dwCheckTime < dwRunIntervalTime then
      begin
        Inc(m_dwMoveCount);
        dwDelayTime := Max(dwRunIntervalTime - dwCheckTime, 0);
        if dwDelayTime > g_Config.dwDropOverSpeed then
        begin
          if m_dwMoveCount >= 4 then
          begin
            m_dwMoveTick := MyGetTickCount();
            m_dwMoveCount := 0;
            dwDelayTime := g_Config.dwDropOverSpeed;
            if g_Config.boViewHackMessage then
              MainOutMessage(Format('[马跑步复位] %s 延时:%d', [m_sCharName, dwDelayTime]));
          end
          else
          begin
            m_dwMoveCount := 0;
            if g_Config.boViewHackMessage then
              MainOutMessage(Format('[马跑步超速] %s 延时:%d', [m_sCharName, dwDelayTime]));
          end;
          Exit;
        end
        else
          Exit;
      end;
    end;

    m_dwMoveTick := MyGetTickCount();
    m_bo316 := False;
    n14 := GetNextDirection(m_nCurrX, m_nCurrY, nX, nY);
    if HorseRunTo(n14, False) then
    begin
      if m_boTransparent and (m_boHideMode) then
      begin
        // 隐身术动一下就取消隐身 2020-03-23 17:17:16
        if m_wStatusTimeArr[STATE_TRANSPARENT { 0 0x70 } ] > 0 then
        begin
          m_wStatusTimeArr[STATE_TRANSPARENT { 0 0x70 } ] := 0;
          m_boHideMode := False;
          m_nCharStatus := GetCharStatus();
          StatusChanged();
        end;
      end;

      if m_bo316 or ((m_nCurrX = nX) and (m_nCurrY = nY)) then
        Result := True;

      Dec(m_nHealthTick, 60);
      Dec(m_nSpellTick, 10);
      m_nSpellTick := Max(0, m_nSpellTick);
      Dec(m_nPerHealth);
      Dec(m_nPerSpell);
    end
    else
    begin
      m_dwMoveCount := 0;
      m_dwMoveCountA := 0;
    end;
  end;

var
  dwDelayTime: LongWord;
  nMsgCount: Integer;
  boRunHuman, boRunMon, boRunNpc, boRunGuard: Boolean;
begin
  if m_boShopStall then
    Exit; // 正在摆摊
  StopCollect;
  if ClientHorseRunXY(ProcessMsg.wIdent, ProcessMsg.nParam1 { x } , ProcessMsg.nParam2 { y } , ProcessMsg.boLateDelivery,
    dwDelayTime, ProcessMsg.dwTimeTick) then
  begin
    m_dwActionTick := MyGetTickCount;
    GetMapCanRun(boRunHuman, boRunMon, boRunNpc, boRunGuard);
    SendDefMessage(SM_ACTION_RET, MakeLong(MakeWord(Byte(boRunHuman), Byte(boRunMon)), MakeWord(Byte(boRunNpc), Byte(boRunGuard))
      ), 1, 1, 0, '');
  end
  else
  begin
    if dwDelayTime = 0 then
    begin
      SendSocketStatusFail;
      // m_dwMoveTick := MyGetTickCount() - g_Config.dwRunIntervalTime;
    end
    else
    begin
      nMsgCount := GetRunMsgCount();
      if nMsgCount >= g_Config.nMaxRunMsgCount then
      begin
        Inc(m_nOverSpeedCount);
        if m_nOverSpeedCount > g_Config.nOverSpeedKickCount then
        begin
          if g_Config.boKickOverSpeed then
          begin
            SysMsg(g_sKickClientUserMsg { '请勿使用非法软件！' } , c_Red, t_Hint);
            m_boEmergencyClose := True;
            m_boPlayOffLine := False; // 关闭下线触发
          end;
          if g_Config.boViewHackMessage then
          begin
            // MainOutMessage('[跑步超速] ' + m_sCharName + ' Time: ' + IntToStr(dwDelayTime) + ' Count: '+ IntToStr(nMsgCount));
            MainOutMessage(Format(g_sRunOverSpeed, [1, m_sCharName, dwDelayTime, nMsgCount]));
          end;
        end;
        // 如果超速则发送攻击失败信息
        SendSocketStatusFail;
        // m_dwMoveTick := MyGetTickCount() - g_Config.dwRunIntervalTime;
        if g_Config.boViewHackMessage then
          MainOutMessage(Format(g_sRunOverSpeed, [2, m_sCharName, dwDelayTime, nMsgCount]));
      end
      else
      begin
        SendDelayMsg(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2, ProcessMsg.nParam3, '',
          Min(dwDelayTime, g_Config.nMaxRunDeliveryTime));
        boResult := False;
      end;
    end;
  end;
end;

procedure TPlayObject.ClientHit(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function PileStones(nX, nY: Integer): Boolean;
  var
    I: Integer;
    MapCellInfo: pTMapCellinfo;
    Event: TGameEvent;
    PileEvent: TGameEvent;
    GameObject: TGameObject;
    s1C: string;
    bo10: Boolean;
  begin
    Result := False;
    s1C := '';
    Event := nil;
    bo10 := False;
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      m_PEnvir.LockR(4);
    try
{$IFEND}
      if m_PEnvir.m_boMINE and m_PEnvir.GetMapCellInfo(nX, nY, MapCellInfo) then
      begin
        bo10 := True;
        if (MapCellInfo.ObjList <> nil) then
        begin
          for I := 0 to {$IF USEOBJLIST = 1}Length(MapCellInfo.ObjList){$ELSE}MapCellInfo.ObjList.Count{$IFEND} - 1 do
          begin
            GameObject :=
{$IF USEOBJLIST = 1}TGameObject(MapCellInfo.ObjList[I]){$ELSE}TGameObject(MapCellInfo.ObjList.Items[I]){$IFEND};
            if (GameObject <> nil) and (GameObject.m_ObjGame = Obj_Event) then
            begin
              Event := TGameEvent(GameObject);
            end;
          end;
        end;
      end;
      if (Event = nil) and bo10 and (MapCellInfo.chFlag <> 0) then
      begin // 动态创建TStoneMineEvent
        Event := TStoneMineEvent.Create(m_PEnvir, nX, nY, ET_STONEMINE);
        if m_PEnvir.AddToMapMineEvent(nX, nY, Event) = Event then
          g_EventManager.AddEvent(Event, False)
        else
          FreeAndNil(Event);
      end;
      if (Event <> nil) and (Event.m_nEventType = ET_STONEMINE) then
      begin
        if TStoneMineEvent(Event).m_nMineCount > 0 then
        begin
          Dec(TStoneMineEvent(Event).m_nMineCount);
          if Random(g_Config.nMakeMineHitRate { 4 } ) = 0 then
          begin
            PileEvent := TGameEvent(m_PEnvir.GetEvent(m_nCurrX, m_nCurrY));
            if PileEvent = nil then
            begin
              PileEvent := TPileStones.Create(m_PEnvir, m_nCurrX, m_nCurrY, ET_PILESTONES, 5 * 60 * 1000);
              g_EventManager.AddEvent(PileEvent);
            end
            else
            begin
              if PileEvent.m_nEventType = ET_PILESTONES then
                TPileStones(PileEvent).AddEventParam;
            end;
            if Random(g_Config.nMakeMineRate { 12 } ) = 0 then
            begin
              MakeMine();
            end;
            OnMapNotifyEvent(Self, meDoMine); // 挖矿事件触发
            s1C := '1';
            DoDamageWeapon(Random(15) + 5);
            Result := True;
          end;
        end
        else
        begin
          if (MyGetTickCount - TStoneMineEvent(Event).m_dwAddStoneMineTick) > 10 * 60 * 1000 then
            TStoneMineEvent(Event).AddStoneMine();
        end;
      end;
      SendRefMsg(RM_HEAVYHIT, m_btDirection, m_nCurrX, m_nCurrY, 0, s1C);
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        m_PEnvir.UnLockR;
    end;
{$IFEND}
  end;

  function ClientHitXY(wIdent: Word; nX, nY, nDir: Integer; boLateDelivery: Boolean; var dwDelayTime: LongWord;
    dwTimeTick: LongWord): Boolean;
  var
    n14, n18: Integer;
    StdItem: pTStdItem;
    dwAttackTime, dwCheckTime, dwHitIntervalTime: LongWord;
    _nIndex: Integer;
    CustomMagicConfig: TCustomMagicConfig;
    _IsBreak, _IsNoTime: Boolean;
  resourcestring
    sExceptionMsg = '[Exception] TPlayObject.ClientHitXY';
  begin
    Result := False;
    dwDelayTime := 0;
    try
      if m_boDeath or (not m_boCanHit) or (m_wStatusTimeArr[STATE_FROZEN] <> 0) or (not CanParaly(2)) then
      begin
        if m_boContinuous then
        begin // 检测连击是否完成
          if m_nCurrContinuousMagicIndex >= Length(m_CurrContinuousMagic) then
          begin // 连击结束
            m_boContinuous := False;
            SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
            if g_FunctionNPC <> nil then
            begin
              m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(Self, '@ContinueMagicFinished', False);
            end;
          end;
        end;
        Exit;
      end;

      if g_Config.boCheckActionCount then
        Inc(m_nAttackCount);

      if not m_boContinuous then // 不在连击状态
      begin
        if not boLateDelivery then
        begin
          if g_Config.boSpeedControl and (g_Config.dwHitIntervalTime > 0) and not CheckActionStatus(wIdent, dwDelayTime) then
          begin
            m_boFilterAction := False;
            Exit;
          end;

          m_boFilterAction := True;
          dwHitIntervalTime := g_Config.dwHitIntervalTime;
          // 修改速度计算去掉这个，下面有chongchong 2016-12-14
          // dwHitIntervalTime := Max(0, g_Config.dwHitIntervalTime - m_nHitSpeed * g_Config.dwIncSpeedDecInterval); // 防止负数出错
          if m_nAttackSpeed <> 0 then // 攻击速度  自动调整变速后时间间隔
            dwHitIntervalTime := Max(dwHitIntervalTime - (g_Config.dwIncSpeedDecInterval * m_nAttackSpeed), 0);

          dwAttackTime := dwHitIntervalTime;
          if g_Config.boSpeedControl and (dwAttackTime > 0) then
          begin
            dwCheckTime := dwTimeTick - m_dwAttackTick; // MyGetTickCount
            if dwCheckTime < dwAttackTime then
            begin
              Inc(m_dwAttackCount);
              dwDelayTime := Max(dwAttackTime - dwCheckTime, 0);
              if dwDelayTime > dwAttackTime div 3 then
              begin
                if m_dwAttackCount >= 4 then
                begin
                  m_dwAttackTick := MyGetTickCount();
                  m_dwAttackCount := 0;
                  dwDelayTime := dwAttackTime div 3; // g_Config.dwDropOverSpeed;
                  if g_Config.boViewHackMessage then
                    MainOutMessage(Format('[攻击复位] %s 延时:%d', [m_sCharName, dwDelayTime]));
                end
                else
                begin
                  m_dwAttackCount := 0;
                  if g_Config.boViewHackMessage then
                    MainOutMessage(Format('[攻击超速] %s 延时:%d', [m_sCharName, dwDelayTime]));
                end;
                Exit;
              end
              else
                Exit;
            end;
          end;
        end;
      end;

      if (nX = m_nCurrX) and (nY = m_nCurrY) then
      begin
        Result := True;
        m_dwAttackTick := MyGetTickCount();
        if not m_boContinuous then // 不在连击状态
        begin
          if (wIdent = CM_HEAVYHIT) and (m_UseItems[U_WEAPON].Dura > 0) then
          begin // 挖矿
            GetFrontPosition(n14, n18);
            if not m_PEnvir.CanWalk(n14, n18, False) then
            begin // sub_004B2790
              StdItem := UserEngine.GetStdItem(m_UseItems[U_WEAPON].wIndex);
              if (StdItem <> nil) and (StdItem.Shape = 19) then
              begin
                if PileStones(n14, n18) then
                begin
                  // SendSocket(nil, '=DIG');
                  SendOpenMagic(0, True, 0);
                end;
                Dec(m_nHealthTick, 30);
                Dec(m_nSpellTick, 50);
                m_nSpellTick := Max(0, m_nSpellTick);
                Dec(m_nPerHealth, 2);
                Dec(m_nPerSpell, 2);
                Exit;
              end;
            end;
          end;
        end;

        // 2020-11-05 00:02:18
        m_NoTriggerAttackStruckScript := False;
        if wIdent = CM_101HIT then
          AttackDir(nil, 16, nDir); // 三绝杀
        if wIdent = CM_102HIT then
          AttackDir(nil, 17, nDir); // 断岳斩
        if wIdent = CM_103HIT then
          AttackDir(nil, 18, nDir); // 横扫千军
        if wIdent = CM_HIT then
          AttackDir(nil, 0, nDir);
        if wIdent = CM_HEAVYHIT then
          AttackDir(nil, 1, nDir);
        if wIdent = CM_BIGHIT then
          AttackDir(nil, 2, nDir);
        if wIdent = CM_POWERHIT then
          AttackDir(nil, 3, nDir);
        if wIdent = CM_LONGHIT then
          AttackDir(nil, 4, nDir); // 刺杀
        if wIdent = CM_WIDEHIT then
          AttackDir(nil, 5, nDir);
        if wIdent = CM_FIREHIT then
          AttackDir(nil, 7, nDir);
        if wIdent = CM_CRSHIT then
          AttackDir(nil, 8, nDir); // 双龙斩 抱月弯刀
        if wIdent = CM_TWNHIT then
          AttackDir(nil, 9, nDir); // 破空剑 龙影剑法
        if wIdent = CM_43HIT then
          AttackDir(nil, 10, nDir); // 雷霆剑法    ID=43
        if wIdent = CM_66HIT then
          AttackDir(nil, 11, nDir); // 开天斩重击    ID=66
        if wIdent = CM_66HIT1 then
          AttackDir(nil, 19, nDir); // 开天斩轻击    ID=66
        if wIdent = CM_SWORDHIT then
          AttackDir(nil, 15, nDir); // 逐日剑法
        if wIdent = CM_113HIT then
          AttackDir(nil, 20, nDir); // 断空斩
        if wIdent = CM_115HIT then
          AttackDir(nil, 21, nDir); // 血魄一击

        // 自定义技能 chongchong 2015-03-23
        if (wIdent >= CM_CUSTOM_HIT001) and (wIdent < CM_CUSTOM_HIT001 + CUSTOM_MAGIC_COUNT) then
          AttackDir(nil, wIdent, nDir);

        if not m_boContinuous then
        begin // 不在连击状态
          // 攻杀剑法判断武器持久 + (m_UseItems[U_WEAPON].wIndex <> 0) chongchong 2013-12-06
          if (m_UseItems[U_WEAPON].Dura > 0) and (m_UseItems[U_WEAPON].wIndex <> 0) then
          begin // 攻杀剑术
            if (m_MagicPowerHitSkill <> nil) then
            begin
              if m_btAttackSkillPointCount = m_btAttackSkillCount then
              begin
                m_boPowerHit := True;
                // SendSocket(nil, '+PWR');
                SendOpenMagic(SKILL_YEDO, True, 0);
              end;

              Dec(m_btAttackSkillCount);
              if m_btAttackSkillCount <= 0 then
              begin
                n14 := 7 - m_MagicPowerHitSkill.btLevel;
                // 修正攻杀剑术修到6级后，就不能使用了2019-12-21 17:58:41
                if n14 <= 1 then
                  m_btAttackSkillCount := 3
                else
                  m_btAttackSkillCount := n14;
                m_btAttackSkillPointCount := Random(m_btAttackSkillCount);
              end;
            end;

            if not m_boPowerHit then
            begin
              for _nIndex := Low(m_CustomSkill) to High(m_CustomSkill) do
              begin
                _IsBreak := False;
                _IsNoTime := False;
                if m_CustomSkill[_nIndex] <> nil then
                begin
                  CustomMagicConfig := GetCustomMagicConfig(_nIndex + CUSTOM_MAGIC_START_ID);
                  if (CustomMagicConfig <> nil) and CustomMagicConfig.IsMagicWarr and
                    (CustomMagicConfig.ClientBaseConfig.MagicSwitchMode = msmPowerHit) then
                  begin
                    if m_CustomSkillPointCount[_nIndex] = m_CustomSkillCount[_nIndex] then
                    begin
                      if MyGetTickCount - m_CustomSkillUseTick[_nIndex] >= GetMagicCD(_nIndex + CUSTOM_MAGIC_START_ID) then
                      begin
                        m_boCustomSkill[_nIndex] := True;
                        m_CustomSkillUseTick[_nIndex] := MyGetTickCount;
                        // SendSocket(nil, '+CUSSKILL2_' + IntToStr(_nIndex));
                        SendOpenMagic(_nIndex + CUSTOM_MAGIC_START_ID, True, 1);
                        _IsBreak := True;
                      end
                      else
                        _IsNoTime := True;
                    end;

                    if not _IsNoTime then
                    begin
                      if m_CustomSkillCount[_nIndex] > 0 then
                        Dec(m_CustomSkillCount[_nIndex]);

                      if m_CustomSkillCount[_nIndex] <= 0 then
                      begin
                        m_CustomSkillCount[_nIndex] := 9 - m_CustomSkill[_nIndex].btLevel;
                        m_CustomSkillPointCount[_nIndex] := Random(m_CustomSkillCount[_nIndex]);
                      end;
                    end;

                    if _IsBreak then
                      Break;
                  end;
                end;
              end;
            end;
          end;
        end;

        Dec(m_nHealthTick, 30);
        Dec(m_nSpellTick, 100);
        m_nSpellTick := Max(0, m_nSpellTick);
        Dec(m_nPerHealth, 2);
        Dec(m_nPerSpell, 2);

        // 修复四连击有时候没打出四个 + ((wIdent = CM_101HIT) or (wIdent = CM_102HIT) or (wIdent = CM_103HIT)) chongchong 2013-12-03
        if m_boContinuous and ((wIdent = CM_100HIT) or (wIdent = CM_101HIT) or (wIdent = CM_102HIT) or (wIdent = CM_103HIT)) then
        begin // 检测连击是否完成
          Inc(m_nCurrContinuousMagicIndex);
          if m_nCurrContinuousMagicIndex >= Length(m_CurrContinuousMagic) then // 连击结束
          begin
            m_boContinuous := False;
            SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
            if g_FunctionNPC <> nil then
            begin
              m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(Self, '@ContinueMagicFinished', False);
            end;
          end;
        end;
      end;
      {
        // 修复错位 chongchong 2014-10-24
        else
        begin
        SendMsg(Self, RM_SYNCSCREEN, 3, m_nCurrX, m_nCurrY, m_btDirection, '');
        end;
      }
    except
      on E: Exception do
      begin
        MainOutMessage(sExceptionMsg);
        MainOutMessage(E.Message);
      end;
    end;
  end;

var
  nMsgCount: Integer;
  dwDelayTime: LongWord;
  _Target: TBaseObject;
  _nX, _nY, _Index: Integer;
  MonHPProgress: pTMonHPProgress;
begin
  // 正在摆摊
  if m_boShopStall then
    Exit;

  StopCollect;

  // 双人骑马 chongchong 2013-10-15
  if (m_btRaceServer = RC_PLAYOBJECT) and m_boOnHorse and (m_HorseOtherHum <> nil) then
    Exit;

  // 变身后 2020-08-22 12:24:05
  if m_nChangeAppr >= 0 then
    Exit;

  DoClientAction(catHit);

  m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, ProcessMsg.wParam, 1, _nX, _nY);

  _Target := m_PEnvir.GetMovingObject(_nX, _nY, True);
  if (_Target = nil) then
  begin
    m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, ProcessMsg.wParam, 2, _nX, _nY);
    _Target := m_PEnvir.GetMovingObject(_nX, _nY, True);
  end;

  if ClientHitXY(ProcessMsg.wIdent { ident } , ProcessMsg.nParam1 { x } , ProcessMsg.nParam2 { y } , ProcessMsg.wParam { dir } ,
    ProcessMsg.boLateDelivery, dwDelayTime, ProcessMsg.dwTimeTick) then
  begin
    m_dwActionTick := MyGetTickCount;
    SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
  end
  else
  begin
    if dwDelayTime = 0 then
    begin
      SendSocketStatusFail;
      m_dwAttackTick := MyGetTickCount() - g_Config.dwHitIntervalTime;
    end
    else
    begin
      nMsgCount := GetHitMsgCount();
      if nMsgCount >= g_Config.nMaxHitMsgCount then
      begin
        Inc(m_nOverSpeedCount);
        if m_nOverSpeedCount > g_Config.nOverSpeedKickCount then
        begin
          if g_Config.boKickOverSpeed then
          begin
            SysMsg(g_sKickClientUserMsg { '请勿使用非法软件！' } , c_Red, t_Hint);
            m_boEmergencyClose := True;
            m_boPlayOffLine := False; // 关闭下线触发
          end;

          if g_Config.boViewHackMessage then
          begin
            // MainOutMessage('[攻击超速] ' + m_sCharName + ' Time: ' + IntToStr(dwDelayTime) + ' Count: '+ IntToStr(nMsgCount));
            MainOutMessage(Format(g_sHitOverSpeed, [1, m_sCharName, dwDelayTime, nMsgCount]));
          end;
        end;
        // 如果超速则发送攻击失败信息
        SendSocketStatusFail;
      end
      else
      begin
        if (dwDelayTime > g_Config.dwDropOverSpeed) and (g_Config.btSpeedControlMode = 1) and m_boFilterAction then
        begin
          SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
          if g_Config.boViewHackMessage then
            MainOutMessage(Format(g_sHitOverSpeed, [2, m_sCharName, dwDelayTime, nMsgCount]));
        end
        else
        begin
          SendDelayMsg(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2, ProcessMsg.nParam3, '',
            Min(dwDelayTime, g_Config.nMaxHitDeliveryTime));
          boResult := False;
        end;
      end;
    end;
  end;

  if (_Target <> nil) and (_Target.m_btRaceServer >= RC_ANIMAL) then
  begin
    _Index := g_MonHPProgressList.IndexOf(_Target.m_sCharName);
    if _Index >= 0 then
    begin
      MonHPProgress := pTMonHPProgress(g_MonHPProgressList.Objects[_Index]);
      if (_Target.m_ExpHitter <> nil) then
      begin
        if _Target.m_ExpHitter.Master <> nil then
          MonHPProgress.m_ExpHinterName := _Target.m_ExpHitter.Master.m_sCharName
        else
          MonHPProgress.m_ExpHinterName := _Target.m_ExpHitter.m_sCharName;
      end
      else
        MonHPProgress.m_ExpHinterName := '';

      m_DefMsg := MakeDefaultMsg(SM_SENDBIGHPPROGRESS, NativeInt(_Target), 0, 0, 0);
      SendSocketEx(@m_DefMsg, PAnsiChar(MonHPProgress), SizeOf(TMonHPProgress));
    end;
  end;
end;

procedure TPlayObject.ClientSpell(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function ClientSpellXY(wIdent: Word; nKey: Integer; nTargetX, nTargetY: Integer; TargeTBaseObject: TBaseObject;
    boLateDelivery: Boolean; var dwDelayTime: LongWord; dwTimeTick: LongWord): Boolean; // 004CBCEC
  var
    UserMagic: pTUserMagic;
    nSpellPoint: Integer;
    BaseObject, TempObject: TBaseObject;
    dwCheckTime: LongWord;
    boIsWarrSkill: Boolean;
    dwMagicHitIntervalTime: Integer;
    SendMessage: pTSendMessage;
    I, nX, nY: Integer;
    boFind: Boolean;
    _NewLevel: Integer;
    NewMagic: pTUserMagic;
    IsOK: Boolean;
    boAttack: Boolean;
    Index: Integer;
    MonHPProgress: pTMonHPProgress;
    CustomMagicConfig: TCustomMagicConfig;
    S, sMagicName: string;
  begin
    Result := False;
    dwDelayTime := 0;
    dwMagicHitIntervalTime := 0;
    if m_boDeath //
      or (not m_boCanSpell) //
      or (not m_boCanSpellState) //
      or (m_wStatusTimeArr[STATE_FROZEN] <> 0) //
      or (not CanParaly(3)) then
    begin // 防麻
      if m_boContinuous then
      begin // 检测连击是否完成
        if m_nCurrContinuousMagicIndex >= Length(m_CurrContinuousMagic) then
        begin // 连击结束
          m_boContinuous := False;
          SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
          if g_FunctionNPC <> nil then
          begin
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@ContinueMagicFinished', False);
          end;
        end;
      end;
      Exit;
    end;
    if nKey = 60000 then
    begin
      dwMagicHitIntervalTime := g_Config.dwMagicHitIntervalTime;
      if m_nSpellSpeed <> 0 then // 魔法攻击速度  自动调整变速后时间间隔
