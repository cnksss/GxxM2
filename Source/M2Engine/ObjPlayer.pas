  begin
    SysMsg(g_sTryModeCanotUseStorage { '试玩模式不可以使用仓库功能！' } , c_Red, t_Hint);
    SendDefMessage(SM_STORAGE_FAIL, 0, 0, Integer(IsBigStorage), 0, '');
