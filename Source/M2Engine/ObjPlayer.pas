procedure TPlayObject.ServerSendDeath(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  CharDesc: TCharDesc;
  Feature: array [0 .. 255] of AnsiChar;
  sSendMsg: AnsiString;
begin
  if ProcessMsg.nParam3 = 1 then
  begin
    CharDesc.Feature := 0;
    // CharDesc.Feature := TBaseObject(ProcessMsg.BaseObject).GetFeature(Self, @Feature);
    CharDesc.Status := TBaseObject(ProcessMsg.BaseObject).m_nCharStatus;
    m_DefMsg := MakeDefaultMsg(SM_NOWDEATH, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
      MakeWord(ProcessMsg.wParam, TBaseObject(ProcessMsg.BaseObject).m_nLight));
  end
  else
  begin
    CharDesc.Feature := TBaseObject(ProcessMsg.BaseObject).GetFeature(Self, @Feature);
    CharDesc.Status := TBaseObject(ProcessMsg.BaseObject).m_nCharStatus;
    m_DefMsg := MakeDefaultMsg(SM_DEATH, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
      MakeWord(ProcessMsg.wParam, TBaseObject(ProcessMsg.BaseObject).m_nLight));
  end;
  if CharDesc.Feature > 0 then
  begin
    SetLength(sSendMsg, SizeOf(TCharDesc) + CharDesc.Feature);
    Move(CharDesc, sSendMsg[1], SizeOf(TCharDesc));
    Move(Feature[0], sSendMsg[1 + SizeOf(TCharDesc)], CharDesc.Feature);
    SendSocketEx(@m_DefMsg, PAnsiChar(sSendMsg), Length(sSendMsg));
  end
  else
    SendSocketEx(@m_DefMsg, @CharDesc, SizeOf(TCharDesc));
end;

procedure TPlayObject.ServerSendDisppear(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I64: Int64;
