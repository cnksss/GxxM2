procedure TPlayObject.SendSocket(DefMsg: pTDefaultMessage; sMsg: AnsiString);
var
  SocketThread: TSocketThread;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.SendSocket..';
begin
  if DefMsg = nil then
    MainOutMessage('SendSocket DefMsg is nil');

  if m_boDummyObject then
    Exit;

  if m_boOffLine and (MyGetTickCount - m_nOffOnlineTick > 1000 * 30) then
    Exit; // 如果挂机超过30秒后不在发送数据到客户端

  SocketThread := RunSocket.GetSocket(m_nGateIdx);
  if SocketThread = nil then
    Exit;

  try
    SocketThread.Add(GM_DATA, m_nSocket, m_nGSocketIdx, 0, DefMsg, PAnsiChar(sMsg), Length(sMsg));
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg);
      MainOutMessage(E.Message);
    end;
  end;
end;

procedure TPlayObject.SendSocketEx(DefMsg: pTDefaultMessage; Buffer: PAnsiChar; BufferLen: Integer);
var
  SocketThread: TSocketThread;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.SendSocketEx..';
begin
  if DefMsg = nil then
    MainOutMessage('SendSocketEx DefMsg is nil');

  if m_boDummyObject then
    Exit;

  if m_boOffLine and (MyGetTickCount - m_nOffOnlineTick > 1000 * 30) then
    Exit; // 如果挂机超过30秒后不在发送数据到客户端

  SocketThread := RunSocket.GetSocket(m_nGateIdx);
  if SocketThread = nil then
    Exit;

  try
    // DefMsg.DataLen := Length(sMsg);
    SocketThread.Add(GM_DATA, m_nSocket, m_nGSocketIdx, 0, DefMsg, Buffer, BufferLen);
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg);
      MainOutMessage(E.Message);
    end;
  end;
end;

