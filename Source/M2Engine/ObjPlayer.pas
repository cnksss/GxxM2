procedure TPlayObject.ServerSendUserName(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  BaseObject: TBaseObject;
begin
  m_DefMsg := MakeDefaultMsg(SM_USERNAME, NativeInt(ProcessMsg.BaseObject),
    GetCharColor(TBaseObject(ProcessMsg.BaseObject)), 0, 0);
  BaseObject := TBaseObject(ProcessMsg.BaseObject);
  if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and TSmartObject(BaseObject)
    .m_boMysteriousMan and (m_btPermission >= 10) then
