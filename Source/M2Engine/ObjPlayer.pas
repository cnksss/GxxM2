  else
    SendSocket(@m_DefMsg, ProcessMsg.sMsg);
end;

procedure TPlayObject.ServerSendLevelUp(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  if TBaseObject(ProcessMsg.BaseObject).m_btRaceServer = RC_PLAYOBJECT then
  begin
    m_DefMsg := MakeDefaultMsg(SM_LEVELUP, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
      ProcessMsg.wParam);
    SendSocket(@m_DefMsg, '');
    if TObject(ProcessMsg.BaseObject) = Self then
    begin
      m_DefMsg := MakeDefaultMsg(SM_ABILITY, m_nGold, MakeWord(m_btJob, 99), LoWord(m_nGameGold), HiWord(m_nGameGold));
      m_WAbil.Exp := m_Abil.Exp;
      m_WAbil.MaxExp := m_Abil.MaxExp;
      m_WAbil.Level := m_Abil.Level;
      SendSocket(@m_DefMsg, zLibCompressBuffer(@m_WAbil, SizeOf(TAbility)));
      // 扩展准确、敏捷为65536 chongchong 2018-01-11
      (*
        SendDefMessage(SM_SUBABILITY,
        MakeLong(MakeWord(m_nAntiMagic, 0), 0),
        MakeWord(m_btHitPoint, m_btSpeedPoint),
        MakeWord(m_btAntiPoison, m_nPoisonRecover),
        MakeWord(m_nHealthRecover, m_nSpellRecover),
        IntToStr(m_nNPRecoverTime) + '/' + IntToStr(m_nNPRecoverPoint));
      *)
      SendDefMessage(SM_SUBABILITY, MakeLong(MakeWord(m_nAntiMagic, 0), m_btSpeedPoint), m_btHitPoint,
        MakeWord(m_btAntiPoison, m_nPoisonRecover), MakeWord(m_nHealthRecover, m_nSpellRecover),
        IntToStr(m_nNPRecoverTime) + '/' + IntToStr(m_nNPRecoverPoint));
    end;
  end
  else if TBaseObject(ProcessMsg.BaseObject).m_btRaceServer = RC_HEROOBJECT then
  begin
    m_DefMsg := MakeDefaultMsg(SM_HEROLEVELUP, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
      ProcessMsg.wParam);
    SendSocket(@m_DefMsg, '');
    if (m_MyHero <> nil) and (TObject(ProcessMsg.BaseObject) = m_MyHero) then
    begin
