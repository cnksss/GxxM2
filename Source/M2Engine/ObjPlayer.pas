              SendMsg(Self, RM_MAGIC_HINT_MSG, 1, 0, 0, 0, sKTZSpiritsSummoned);
            nSpellPoint := GetSpellPoint(UserMagic);
            if m_WAbil.MP >= nSpellPoint then
            begin
              if nSpellPoint > 0 then
              begin
                DamageSpell(nSpellPoint);
                HealthSpellChanged();
              end;
              if m_bo66SkillCls then
              begin
                // SendSocket(nil, '+KTZ');
                SendOpenMagic(SKILL_66, True, 0);
              end
              else
              begin
                // 开天斩轻击 piaoyun 2013-08-24
                // SendSocket(nil, '+QKTZ');
                SendOpenMagic(SKILL_66, True, 1);
              end;
            end;
          end
          else if Length(sKTZSpiritsFail) > 0 then
          begin
            SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, sKTZSpiritsFail);
          end;
        end
        else
        begin
          if g_sSkillOpenFailNotReleased <> '' then
          begin
            S := StringReplace(g_sSkillOpenFailNotReleased, '%openmagic', sMagicName, [rfIgnoreCase]);
            S := StringReplace(S, '%curmagic', UserMagic.MagicInfo.sMagicName, [rfIgnoreCase]);
            // SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, S);
            SysMsg(S, c_Red, t_Hint);
          end;
          Exit;
        end;
      end;
      Result := True;
    end
    else if UserMagic.wMagIdx = SKILL_113 then // 断空斩
    begin
      if m_Magic113Skill <> nil then
      begin
        if m_WarrCuntinueHit.CanOpenMagic(SKILL_113, sMagicName) then
        begin
          if Allow113HitSkill then
          begin
            if Length(sDKZSpiritsSummoned) > 0 then
              SendMsg(Self, RM_MAGIC_HINT_MSG, 1, 0, 0, 0, sDKZSpiritsSummoned);
            nSpellPoint := GetSpellPoint(UserMagic);
            if m_WAbil.MP >= nSpellPoint then
            begin
              if nSpellPoint > 0 then
              begin
                DamageSpell(nSpellPoint);
                HealthSpellChanged();
              end;
              // SendSocket(nil, '+DKZ');
              SendOpenMagic(SKILL_113, True, 0);
            end;
          end
          else if Length(sDKZSpiritsFail) > 0 then
          begin
            SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, sDKZSpiritsFail);
          end;
        end
        else
        begin
          if g_sSkillOpenFailNotReleased <> '' then
          begin
            S := StringReplace(g_sSkillOpenFailNotReleased, '%openmagic', sMagicName, [rfIgnoreCase]);
            S := StringReplace(S, '%curmagic', UserMagic.MagicInfo.sMagicName, [rfIgnoreCase]);
            // SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, S);
            SysMsg(S, c_Red, t_Hint);
          end;
          Exit;
        end;
      end;
      Result := True;
    end
    else if UserMagic.wMagIdx = SKILL_115 then // 血魄一击
    begin
      if m_Magic115Skill <> nil then
      begin
        if m_WarrCuntinueHit.CanOpenMagic(SKILL_115, sMagicName) then
        begin
          if Allow115HitSkill then
          begin
            if not g_Config.boSkill115UseNG then
            begin
              nSpellPoint := GetSpellPoint(UserMagic);
              if m_WAbil.MP >= nSpellPoint then
              begin
                if nSpellPoint > 0 then
                begin
                  DamageSpell(nSpellPoint);
                  HealthSpellChanged();
                end;
                // SendSocket(nil, '+XHYJ');
                SendOpenMagic(SKILL_115, True, 0);
              end;
            end
            else
            begin
              // SendSocket(nil, '+XHYJ');
              SendOpenMagic(SKILL_115, True, 0);
            end;
          end;
        end
        else
        begin
          if g_sSkillOpenFailNotReleased <> '' then
          begin
            S := StringReplace(g_sSkillOpenFailNotReleased, '%openmagic', sMagicName, [rfIgnoreCase]);
            S := StringReplace(S, '%curmagic', UserMagic.MagicInfo.sMagicName, [rfIgnoreCase]);
            // SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, S);
            SysMsg(S, c_Red, t_Hint);
          end;
          Exit;
        end;
      end;
      Result := True;
    end
    else if UserMagic.wMagIdx = SKILL_75 then // 护体神盾
    begin
      if (m_MagicSuperShiledSkill <> nil) then
      begin
        if m_WarrCuntinueHit.CanOpenMagic(SKILL_75, sMagicName) then
        begin
          if MyGetTickCount - m_dwLastSuperShiledTimeTick > GetMagicCD(SKILL_75) then
          begin
            m_dwLastSuperShiledTimeTick := MyGetTickCount();
            OpenSuperShiled;
          end
          else
          begin
            SysMsg(Format('请在%d秒后使用该技能', [(GetMagicCD(SKILL_75) - (MyGetTickCount - m_dwLastSuperShiledTimeTick)) div 1000]),
              c_Red, t_System);
          end;
        end
        else
        begin
          if g_sSkillOpenFailNotReleased <> '' then
          begin
            S := StringReplace(g_sSkillOpenFailNotReleased, '%openmagic', sMagicName, [rfIgnoreCase]);
            S := StringReplace(S, '%curmagic', UserMagic.MagicInfo.sMagicName, [rfIgnoreCase]);
            // SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, S);
            SysMsg(S, c_Red, t_Hint);
          end;
          Exit;
        end;
        Result := True;
      end;
    end
    else if UserMagic.wMagIdx = SKILL_100 then // 追心刺
    begin
      Result := True;
      BaseObject := nil;
      TargeTBaseObject := GetPoseCreate();
      if TargeTBaseObject <> nil then
      begin
        nTargetX := TargeTBaseObject.m_nCurrX;
        nTargetY := TargeTBaseObject.m_nCurrY;
      end;
      // 检查目标角色，与目标座标误差范围，如果在误差范围内则修正目标座标
      if CretInNearXY(TargeTBaseObject, nTargetX, nTargetY, g_Config.nMagicLockRange) then
      begin
        BaseObject := TargeTBaseObject;
        nTargetX := BaseObject.m_nCurrX;
        nTargetY := BaseObject.m_nCurrY;
        // SysMsg('SKILL_100:'+BaseObject.m_sCharName, c_Red, t_System);
      end;

      m_nSpellMagicID := UserMagic.wMagIdx;
      m_sSpellMagicName := UserMagic.MagicInfo.sMagicName;
      if TargeTBaseObject <> nil then
      begin
        if TargeTBaseObject is TCopyMon then // 分身RaceServer检测改为151
          m_sSpellMagicTargetRace := 151
        else
          m_sSpellMagicTargetRace := TargeTBaseObject.m_btRaceServer;
        m_sSpellMagicTarget := TargeTBaseObject.m_sCharName;
      end
      else
      begin
        m_sSpellMagicTargetRace := 65535;
        m_sSpellMagicTarget := '';
      end;

      m_IsSpellStopMagic := False;
      if g_FunctionNPC <> nil then
        g_FunctionNPC.GotoLable(Self, '@BeginMagic', False);

      if m_IsSpellStopMagic then
        Exit;

      m_btDirection := GetNextDirection(m_nCurrX, m_nCurrY, nTargetX, nTargetY);
      if BaseObject <> nil then
      begin
        // 2011-09-24增加 检测消息队列中是否存在其他动作，存在则删除，否则可能会出现动作混乱
        boFind := False;
{$IF LockProcessMsg = 1}
        try
          EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
          I := 0;
          while (True) do
          begin
            if m_MsgList.Count <= I then
              Break;

            SendMessage := m_MsgList.Items[I];
            case SendMessage.wIdent of
              CM_SPELL, CM_SITDOWN, CM_TURN, CM_WALK, CM_HORSERUN, CM_RUN, CM_HIT, // 3014
              CM_HEAVYHIT, // 3015
              CM_BIGHIT, // 3016
              CM_POWERHIT, // 3018
              CM_LONGHIT, // 3019
              CM_WIDEHIT, // 3024
              CM_CRSHIT, CM_TWNHIT, CM_FIREHIT, CM_43HIT, CM_66HIT, CM_66HIT1, CM_SWORDHIT, CM_60HIT, CM_61HIT, CM_62HIT,
              { TODO -opiaoyun -c修改 : 战士连击技能修复【2013-07-13】 }
              CM_100HIT, // 追心刺
              CM_101HIT, // 三绝杀
              CM_102HIT, // 断岳斩
              CM_103HIT, // 横扫千军}
              CM_113HIT, // 断空斩
              CM_115HIT, // 血魄一击
              CM_CUSTOM_HIT001 .. (CM_CUSTOM_HIT001 + CUSTOM_MAGIC_COUNT - 1):
                begin
                  if not boFind then
                  begin
                    boFind := True;
                    SendSocketStatusFail;
                  end;
                  m_MsgList.Delete(I);
                  if SendMessage.Buff <> nil then
                    FreeMem(SendMessage.Buff);
                  // Dispose(SendMessage);
                  FreeMem(SendMessage, SizeOf(TSendMessage));
                  Continue;
                end;
            end;
            Inc(I);
          end;
{$IF LockProcessMsg = 1}
        finally
          LeaveCriticalSection(ProcessMsgCriticalSection);
        end;
{$IFEND}
        // 连击技能[追心刺]不增加经验值 -- piaoyun 2013-08-16
        DoMotaebo100(BaseObject, UserMagic);
      end
      else // 空释放连击技能  chongchong 2013-11-22
        DoMotaebo100(nil, UserMagic);

      if m_boContinuous then
      begin // 检测连击是否完成
        Inc(m_nCurrContinuousMagicIndex);
        if m_nCurrContinuousMagicIndex >= Length(m_CurrContinuousMagic) then
        begin
          m_boContinuous := False; // 连击结束
          SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
          if g_FunctionNPC <> nil then
          begin
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@ContinueMagicFinished', False);
          end;
        end;
      end;
    end
    else
    begin
      // 非自定义战士技能 chongchong 2015-03-19
      if CheckIsCustomMagic(UserMagic.wMagIdx) and (UserMagic.MagicInfo.btEffectType = 0) then
      begin
        if m_CustomSkill[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID] <> nil then
        begin
          nSpellPoint := GetSpellPoint(UserMagic);
          // 技能已经开启，关闭时不要判断 2020-08-13 21:59:58
          if m_boCustomSkill[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID] then
            IsOK := True
          else
          begin
            CustomMagicConfig := GetCustomMagicConfig(UserMagic.wMagIdx);
            if (CustomMagicConfig <> nil) and (CustomMagicConfig.ServerConfig.IsAttackUseNG) then
            begin
              IsOK := m_boTrainingNG and (m_AbilNG.NH >= nSpellPoint);
              if not IsOK then
              begin
                SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '没有学习内力，无法使用' + UserMagic.MagicInfo.sMagicName);
              end;
            end
            else
            begin
              IsOK := m_WAbil.MP >= nSpellPoint;
            end;
          end;
          if IsOK then
          begin
            if m_WarrCuntinueHit.CanOpenMagic(UserMagic.wMagIdx, sMagicName) then
            begin
              if AllowCustomSkill(UserMagic.wMagIdx, True) then
              begin
                SendOpenMagic(UserMagic.wMagIdx, True, 0);
              end;
            end
            else
            begin
              if g_sSkillOpenFailNotReleased <> '' then
              begin
                S := StringReplace(g_sSkillOpenFailNotReleased, '%openmagic', sMagicName, [rfIgnoreCase]);
                S := StringReplace(S, '%curmagic', UserMagic.MagicInfo.sMagicName, [rfIgnoreCase]);
                // SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, S);
                SysMsg(S, c_Red, t_Hint);
              end;
              Exit;
            end;
          end
        end;
        Result := True;
      end
      else
      begin
        BaseObject := nil;
        // 检查目标角色，与目标座标误差范围，如果在误差范围内则修正目标座标
        if CretInNearXY(TargeTBaseObject, nTargetX, nTargetY, g_Config.nMagicLockRange) then
        begin
          BaseObject := TargeTBaseObject;
          nTargetX := BaseObject.m_nCurrX;
          nTargetY := BaseObject.m_nCurrY;
        end;

        CustomMagicConfig := nil;
        if CheckIsCustomMagic(UserMagic.wMagIdx) then
          CustomMagicConfig := GetCustomMagicConfig(UserMagic.wMagIdx);

        if (CustomMagicConfig <> nil) and CustomMagicConfig.ServerConfig.NoChangeDir then
          m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, m_btDirection, 1, nTargetX, nTargetY)
        else
          m_btDirection := GetNextDirection(m_nCurrX, m_nCurrY, nTargetX, nTargetY);
        Result := True;

        m_NoTriggerAttackStruckScript := False;
        if not DoSpell(UserMagic, nTargetX, nTargetY, BaseObject, True) then
          SendRefMsg(RM_MAGICFIREFAIL, 0, 0, 0, 0, '');

        if (BaseObject <> nil) and (BaseObject.m_btRaceServer >= RC_ANIMAL) and (UserMagic <> nil) then
        begin
          boAttack := True;
          if (CustomMagicConfig <> nil) and (CustomMagicConfig.ServerConfig.OperateMode = momProtect) then
            boAttack := False
          else if UserMagic.wMagIdx in [2 { 治愈术 } , 29 { 群体治愈术 } , SKILL_UNAMYOUNSUL { 解毒 } , SKILL_49 { 净化术 } ,
            SKILL_75 { 护体神盾 } , SKILL_SHIELD { 魔法盾 } , SKILL_50 { 无极真气 } , SKILL_SKELLETON { 召唤骷髅 } , SKILL_SINSU { 召唤神兽 } ,
            SKILL_76 { 召唤圣兽 } , SKILL_55 { 召唤月灵 } , SKILL_CLOAK { 隐身术 } , SKILL_BIGCLOAK { 集体隐身术 } , SKILL_73 { 道力盾 } ,
            SKILL_87 { 武力盾 } , SKILL_88 { 新武力盾 } , SKILL_89 { 新道力盾] } ] then
            boAttack := False;

          if boAttack then
          begin
            Index := g_MonHPProgressList.IndexOf(BaseObject.m_sCharName);
            if Index >= 0 then
            begin
              MonHPProgress := pTMonHPProgress(g_MonHPProgressList.Objects[Index]);
              if (BaseObject.m_ExpHitter <> nil) then
              begin
                if BaseObject.m_ExpHitter.Master <> nil then
                  MonHPProgress.m_ExpHinterName := BaseObject.m_ExpHitter.Master.m_sCharName
                else
                  MonHPProgress.m_ExpHinterName := BaseObject.m_ExpHitter.m_sCharName;
              end
              else
                MonHPProgress.m_ExpHinterName := '';

              m_DefMsg := MakeDefaultMsg(SM_SENDBIGHPPROGRESS, NativeInt(BaseObject), 0, 0, 0);
              SendSocketEx(@m_DefMsg, PAnsiChar(MonHPProgress), SizeOf(TMonHPProgress));
            end;
          end;
        end;

        if m_boContinuous then
        begin // 检测连击是否完成
          Inc(m_nCurrContinuousMagicIndex);
          if m_nCurrContinuousMagicIndex >= Length(m_CurrContinuousMagic) then
          begin // 连击结束
            m_boContinuous := False;
            SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
            if g_FunctionNPC <> nil then
            begin
              m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(Self, '@ContinueMagicFinished', False);
            end;
          end;
        end;
      end;
    end;
  end;

var
  dwDelayTime: LongWord;
  nMsgCount: Integer;
begin
  if m_boShopStall then
    Exit; // 正在摆摊
  // 开关技能不要中断进度 2019-07-09 16:50:48
  if not(ProcessMsg.wParam in [SKILL_ERGUM, SKILL_BANWOL, SKILL_FIRESWORD, SKILL_40, SKILL_42, SKILL_43, SKILL_56, SKILL_66,
    SKILL_113, SKILL_115]) then
  begin
    StopCollect;
    if m_boOnHorse then
    begin
      SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
      Exit;
    end;
  end;
{$IF DEBUG_SPELL_DEAY = 1}
  MainOutMessage(IntToStr(MyGetTickCount));
{$IFEND}
  // 双人骑马 chongchong 2013-10-15
  if (m_btRaceServer = RC_PLAYOBJECT) and m_boOnHorse and (m_HorseOtherHum <> nil) then
    Exit;
  // 变身后 2020-08-22 12:24:05
  if m_nChangeAppr >= 0 then
    Exit;
  DoClientAction(catSpell);
  // g_Debug_Spell_Tick := MyGetTickCount;
  if ClientSpellXY(ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2, TBaseObject(ProcessMsg.nParam3),
    ProcessMsg.boLateDelivery, dwDelayTime, ProcessMsg.dwTimeTick) then
  begin
    {
      if (m_MyHero <> nil) and (THeroObject(m_MyHero).m_btAngryValue > 0) and (THeroObject(m_MyHero).m_boUseGroupSpell) then
      begin
      if (THeroObject(m_MyHero).m_btAttackMode <> 0) and (THeroObject(m_MyHero).m_btAttackMode <> 3)  then
      begin
      THeroObject(m_MyHero).m_btAttackMode := 0; // 切换到攻击模式
      m_MyHero.SendMsg(m_MyHero, RM_HERO_ATTACK_MODE, 0, MakeWord(255, 252), 0, 0, '');
      end;
      if (m_TargetCret <> nil) and IsProperTarget(m_TargetCret) then
      begin
      THeroObject(m_MyHero).SetTargetCreat(m_TargetCret);
      THeroObject(m_MyHero).m_nTargetX := m_TargetCret.m_nCurrX;
      THeroObject(m_MyHero).m_nTargetY := m_TargetCret.m_nCurrY;
      THeroObject(m_MyHero).m_boTarget := True;
      end;
      end;
    }
    m_dwActionTick := MyGetTickCount;
    SendDefMessage(SM_ACTION_RET, 0, 1, 0, 0, '');
    // Inc(n5F8);
  end
  else
  begin
    if dwDelayTime = 0 then
    begin
      SendSocketStatusFail;
      m_dwMagicAttackTick := MyGetTickCount() - g_Config.dwMagicHitIntervalTime;
    end
    else
    begin
      nMsgCount := GetSpellMsgCount();
      if nMsgCount >= g_Config.nMaxSpellMsgCount then
      begin
        Inc(m_nOverSpeedCount);
        if m_nOverSpeedCount > g_Config.nOverSpeedKickCount then
        begin
          if g_Config.boKickOverSpeed then
          begin
            SysMsg(g_sKickClientUserMsg { '请勿使用非法软件！' } , c_Red, t_Hint);
            m_boEmergencyClose := True;
            m_boPlayOffLine := False; // 关闭下线触发
          end;
          if g_Config.boViewHackMessage then
          begin
            // MainOutMessage('[魔法超速] ' + m_sCharName + ' Time: ' + IntToStr(dwDelayTime) + ' Count: '+ IntToStr(nMsgCount));
            MainOutMessage(Format(g_sSpellOverSpeed, [1, m_sCharName, dwDelayTime, nMsgCount]));
          end;
        end;
        // 如果超速则发送攻击失败信息
        SendSocketStatusFail;
        m_dwMagicAttackTick := MyGetTickCount() - g_Config.dwMagicHitIntervalTime;
      end
      else
      begin
        if (dwDelayTime > g_Config.dwDropOverSpeed) and (g_Config.btSpeedControlMode = 1) and m_boFilterAction then
        begin
          SendSocketStatusFail;
          m_dwMagicAttackTick := MyGetTickCount() - g_Config.dwMagicHitIntervalTime;
          if g_Config.boViewHackMessage then
            MainOutMessage(Format(g_sSpellOverSpeed, [2, m_sCharName, dwDelayTime, nMsgCount]));
        end
        else
        begin
          m_dwMagicAttackTick := MyGetTickCount() - g_Config.dwMagicHitIntervalTime;
          SendDelayMsg(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2, ProcessMsg.nParam3, '',
            Min(dwDelayTime, g_Config.nMaxMagicHitDeliveryTime));
          boResult := False;
        end;
      end;
    end;
  end;
end;

procedure TPlayObject.ClientQueryUserName(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  uname: string;
  TagColor: Integer;
  Def: TDefaultMessage;
  Target: TBaseObject;
  X, Y: Integer;
begin
  Target := TBaseObject(ProcessMsg.nParam1);
  X := ProcessMsg.nParam2;
  Y := ProcessMsg.nParam3;
  if CretInNearXY(Target, X, Y) then
  begin
    TagColor := GetCharColor(Target);
    Def := MakeDefaultMsg(SM_USERNAME, NativeInt(Target), TagColor, 0, 0);
    uname := Target.GetShowName(m_btPermission >= 10);
    SendSocket(@Def, uname);
  end
  else
    SendDefMessage(SM_GHOST, NativeInt(Target), 0, 0, 0, '');
end;

procedure TPlayObject.ClientDropItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  DropItem: pTUserItem;
  UserItem: pTUserItem;
  UpdateItem: TUserItem;
  StdItem: pTStdItem;
  sUserItemName: string;
  boDropItemOK: Boolean;
  boUpdateItem: Boolean;
  sItemName: string;
  nItemIdx, nCount: Integer;
  wIndex: Integer;
begin
  sItemName := ProcessMsg.sMsg;
  nItemIdx := ProcessMsg.nParam1;
  nCount := ProcessMsg.nParam2;
  boDropItemOK := False;
  boUpdateItem := False;
  if g_OnlineMsgControl.boDisableDropItem then
  begin
    SendDefMessage(SM_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    Exit;
  end;
  // 当前地图禁止丢物品(连金币都不可以)   piaoyun 2013-09-05
  if m_PEnvir.m_boNOTHROWITEM then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotDropItemMsg);
    SendDefMessage(SM_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    Exit;
  end;
  if g_Config.boInSafeDisableDrop and InSafeZone then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotDropInSafeZoneMsg);
    SendDefMessage(SM_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    Exit;
  end;
  if not m_boCanDrop then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotDropItemMsg);
    SendDefMessage(SM_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    Exit;
  end;
  if Pos(' ', sItemName) > 0 then
  begin // 折分物品名称(信件物品的名称后面加了使用次数)
    GetValidStr3_Ex(sItemName, sItemName, ' ');
  end;
  if (MyGetTickCount - m_DealLastTick) > 3000 then
  begin
    for I := m_ItemList.Count - 1 downto 0 do
    begin
      if m_ItemList.Count <= 0 then
        Break;
      UserItem := m_ItemList.Items[I];
      if (UserItem <> nil) and (UserItem.MakeIndex = nItemIdx) then
      begin
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem = nil then
          Continue;
        if (GetUserItemBindValue(UserItem, ubNoDrop) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 0) then
        begin
          g_ManageNPC.MessageBox(Self, g_sCanotUserDropItem);
          Break;
        end;
        // sItem:=UserEngine.GetStdItemName(UserItem.wIndex);
        // 取自定义物品名称
        sUserItemName := '';
        if UserItem.btValue[13] = 1 then
          sUserItemName := UserItem.Name;
        if sUserItemName = '' then
          sUserItemName := StdItem.Name;
        if CompareText(sUserItemName, sItemName) = 0 then
        begin
          if CheckOverLapItem(StdItem) and (nCount > 0) then
          begin
            if nCount < UserItem.Dura + 1 then
            begin
              if g_Config.boControlDropItem and (StdItem.Price < g_Config.nCanDropPrice) then
              begin
                boDropItemOK := False;
              end
              else if g_ItemRules.Get(UserItem.wIndex, 24) then
              begin
                UserItem.Dura := UserItem.Dura - nCount;
                UpdateItem := UserItem^;
                boUpdateItem := True;
                boDropItemOK := False;
              end
              // 绑定物品丢弃消失 chongchong 2015-01-29
              else if (GetUserItemBindValue(UserItem, ubDropDelete) and UserItem.boIsBind) then
              begin
                UserItem.Dura := UserItem.Dura - nCount;
                UpdateItem := UserItem^;
                boUpdateItem := True;
                boDropItemOK := False;
              end
              else
              begin
                New(DropItem);
                if UserEngine.CopyToUserItemFromName(StdItem.Name, DropItem) then
                begin
                  DropItem.Dura := nCount - 1;
                  DropItem.boIsBind := UserItem.boIsBind;
                  DropItem.btBindOption := UserItem.btBindOption;
                  // 修正物品可以丢到npc脚下 chongchong 2014-10-27
                  if DropItemDown(DropItem, 6, False, nil, Self) then
                  begin
                    UserItem.Dura := UserItem.Dura - nCount;
                    UpdateItem := UserItem^;
                    boUpdateItem := True;
                    boDropItemOK := False;
                  end;
                end;
                Dispose(DropItem);
              end;
              Break;
            end;
          end;
          if g_Config.boControlDropItem and (StdItem.Price < g_Config.nCanDropPrice) then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemDrop, LOG_ItemDisappear, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, '低于指定价格，消失');
            end;
            m_ItemList.Delete(I);
            Dispose(UserItem);
            boDropItemOK := True;
            Break;
          end;
          // 物品规则  丢弃消失 chongchong 2013-10-18
          if g_ItemRules.Get(UserItem.wIndex, 24) then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemDrop, LOG_ItemDisappear, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, '丢弃消失');
            end;
            m_ItemList.Delete(I);
            Dispose(UserItem);
            boDropItemOK := True;
            Break;
          end
          // 绑定物品丢弃消失 chongchong 2015-01-29
          else if (GetUserItemBindValue(UserItem, ubDropDelete) and UserItem.boIsBind) then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemDrop, LOG_ItemDisappear, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, '绑定丢弃消失');
            end;
            m_ItemList.Delete(I);
            Dispose(UserItem);
            boDropItemOK := True;
            Break;
          end
          else
          begin
            // 修正物品可以丢到npc脚下 chongchong 2014-10-27
            if DropItemDown(UserItem, 6, False, nil, Self) then
            begin
              wIndex := UserItem.wIndex;
              m_PickUpOrDropItem := UserItem^;
              m_ItemList.Delete(I);
              Dispose(UserItem);
              boDropItemOK := True;

              { TODO -ochongchong -c新增 : 物品规则 - 触发提示【2013-07-27】 }
              if g_ItemRules.Get(m_PickUpOrDropItem.wIndex, 21) then
              begin
                m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
                m_nPickUpOrDropItemMakeIndex := m_PickUpOrDropItem.MakeIndex;
                m_nScriptGotoCount := 0;
                if (g_FunctionNPC <> nil) then
                  g_FunctionNPC.GotoLable(Self, '@DropItem', False);
              end;

              if (g_FunctionNPC <> nil) and g_ItemRules.Get(m_PickUpOrDropItem.wIndex, 25) then
              begin
                m_nScriptGotoCount := 0;
                m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
                m_nPickUpOrDropItemMakeIndex := m_PickUpOrDropItem.MakeIndex;
                if (g_FunctionNPC <> nil) then
                  g_FunctionNPC.GotoLable(Self, '@DropItems' + IntToStr(wIndex - 1), False);
              end;
              // 扔物品触发2次 DropItemDown里面有一次 chongchong 2018-08-02 12:21:13
              // OnMapNotifyEvent(Self, meDropItem, StdItem.Name); // 扔物品事件
              Break;
            end;
          end;
        end;
      end;
    end;
    if boDropItemOK then
    begin
      SendDefMessage(SM_DROPITEM_SUCCESS, nItemIdx, 0, 0, 0, sItemName);
      WeightChanged();
    end
    else
    begin
      SendDefMessage(SM_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    end;
    if boUpdateItem then
    begin
      SendUpdateItemDura(-1, UpdateItem.MakeIndex, False, UpdateItem.Dura);
    end;
  end;
end;

procedure TPlayObject.ClientPickUpItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function IsSelf(BaseObject: TBaseObject): Boolean;
  begin
    if (BaseObject = nil) or (Self = BaseObject) then
      Result := True
    else
      Result := False;
  end;
  function IsOfGroup(BaseObject: TBaseObject): Boolean;
  var
    I: Integer;
    GroupMember: TPlayObject;
  begin
    Result := False;
    if m_GroupOwner = nil then
      Exit;
    if m_GroupOwner.m_GroupMembers = nil then
      Exit;
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      m_GroupOwner.m_GroupMembers.LockR(41);
    try
{$IFEND}
      for I := 0 to m_GroupOwner.m_GroupMembers.Count - 1 do
      begin
        GroupMember := TPlayObject(m_GroupOwner.m_GroupMembers.Objects[I]);
        if GroupMember = BaseObject then
        begin
          Result := True;
          Break;
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        m_GroupOwner.m_GroupMembers.UnLockR;
    end;
{$IFEND}
  end;

var
  nError: Integer;
  UserItem: pTUserItem;
  OverLapItem: pTUserItem;
  ItemObject: TItemObject;
  StdItem: pTStdItem;
  wIndex: Integer;
  Msg: string;
  ItemObj: TBaseObject;
  AddWeight: Integer;
  nCount: Integer;
  oldGold: LongWord;
begin
  nError := 0;
  try
    if (m_nCurrX <> ProcessMsg.nParam2) or (m_nCurrY <> ProcessMsg.nParam3) then
      Exit;
    boResult := False;
    nError := 1;
    if m_boDealing then
      Exit;
    ItemObject := m_PEnvir.GetItem(m_nCurrX, m_nCurrY);
    nError := 2;
    if (ItemObject = nil) or (ItemObject.m_boGhost) then
      Exit;
    nError := 3;
    // 双人骑马 - 被邀请的人不能捡物 chongchong 2013-10-16
    if m_boOnHorse and (not m_boHorseMaster) then
    begin
      SysMsg(g_sHorseNotPickup, c_Red, t_Hint);
      Exit;
    end;
    nError := 4;
    // m_dwPickUpTick := MyGetTickCount;
    if (MyGetTickCount - ItemObject.m_dwCanPickUpTick) > ItemObject.m_dwFloorItemCanPickUpTime then
    begin
      ItemObject.m_OfBaseObject := nil;
    end;
    nError := 5;
    ItemObj := TBaseObject(ItemObject.m_OfBaseObject);
    nError := 501;
    if ItemObject.m_btReserved = 1 then // 仅自己可捡，队友不行
    begin
      nError := 502;
      if not IsSelf(ItemObj) then
      begin
        SysMsg(g_sCanotPickUpItem { '在一定时间以内无法捡起此物品！' } , c_Red, t_Hint);
        Exit;
      end;
    end
    else
    begin
      nError := 503;
      if not IsSelf(ItemObj) and not IsOfGroup(ItemObj) then
      begin
        SysMsg(g_sCanotPickUpItem { '在一定时间以内无法捡起此物品！' } , c_Red, t_Hint);
        Exit;
      end;
    end;
    nError := 6;
    { TODO -ochongchong -c新增 : 物品规则 - 禁止捡起【2013-08-18】 }
    if (Length(ItemObject.m_sName) > 0) and g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
    begin
      Msg := AnsiReplaceStr(g_sDisablePickUp, '%Item', ItemObject.m_sName);
      SysMsg(Msg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
      Exit;
    end;
    nError := 7;
    if CompareText(ItemObject.m_sName, sSTRING_GOLDNAME) = 0 then
    begin
      nError := 8;
      if m_PEnvir.DeleteFromMap(m_nCurrX, m_nCurrY, ItemObject) then
      begin
        nCount := ItemObject.m_nCount;
        if ItemObject.m_boGhost then
          Exit;
        ItemObject.MakeGhost;
        oldGold := m_nGold;

        if IncGold(nCount) then
        begin
          nError := 10;
          SendRefMsg(RM_ITEMHIDE, 0, NativeInt(ItemObject), m_nCurrX, m_nCurrY, '');
          if g_boGameLogGold then // 004C5E8C
          begin
            AddGameDataLog(LOG_ItemPickup, LOG_GoldChange, Self, sSTRING_GOLDNAME, NativeInt(ItemObject),
              '捡取:' + IntToStr(ItemObject.m_nCount), m_nGold, oldGold, '');
          end;
          nError := 11;
          GoldChanged;
          nError := 12;
          m_nScatterItemX := m_nCurrX;
          m_nScatterItemY := m_nCurrY;
          m_sScatterItemName := sSTRING_GOLDNAME;
          nError := 13;
          { TODO -ochongchong -c新增 : 物品规则 - 触发提示【2013-07-27】 }
          if (g_FunctionNPC <> nil) and g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 21) then
          begin
            m_nScriptGotoCount := 0;
            m_sPickUpOrDropItemName := ProcessItemName(ItemObject.m_sName);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nPickUpOrDropItemMakeIndex := ItemObject.m_UserItem.MakeIndex;
            if (g_FunctionNPC <> nil) then
              g_FunctionNPC.GotoLable(Self, '@PickUpItem', False);
          end;
          nError := 14;
          m_nScriptGotoCount := 0;
          m_sPickUpOrDropItemName := ProcessItemName(ItemObject.m_sName);
          m_PickUpOrDropItem.MakeIndex := 0;
          m_PickUpOrDropItem.wIndex := 0;
          m_nPickUpOrDropItemMakeIndex := ItemObject.m_UserItem.MakeIndex;
          if (g_FunctionNPC <> nil) then
            g_FunctionNPC.GotoLable(Self, '@PickUpItemEx', False);
          nError := 15;
          OnMapNotifyEvent(Self, mePickUpItem, ItemObject.m_sName); // 捡物品事件
        end
        else if m_PEnvir.AddToMap(m_nCurrX, m_nCurrY, ItemObject) <> ItemObject then
        begin
          nError := 16;
          ItemObject.MakeGhost;
        end;
      end;
      Exit;
    end;
    nError := 17;
    if IsEnoughBag then
    begin
      nError := 18;
      StdItem := UserEngine.GetStdItem(ItemObject.m_UserItem.wIndex);
      wIndex := ItemObject.m_UserItem.wIndex;
      nError := 19;
      // 修正捡物品时，叠加物品重量计算错误
      // UserEngine.GetStdItemWeight(ItemObject.m_UserItem.wIndex)
      AddWeight := OverLapItemWeight(StdItem, ItemObject.m_UserItem.Dura);
      if (StdItem = nil) or (not IsAddWeightAvailable(AddWeight)) then
      begin
        Exit;
      end;
      nError := 20;
      nError := 21;
      if m_PEnvir.DeleteFromMap(m_nCurrX, m_nCurrY, ItemObject) then
      begin
        nError := 22;
        // 捡起的物品为绑定物品时，不要叠加到现有物品上面 chongchong 2014-09-26
        if ItemObject.m_UserItem.boIsBind then
          OverLapItem := nil
        else
          OverLapItem := OverLapItems(Self, StdItem, ItemObject.m_UserItem.Dura);
        nError := 23;
        if OverLapItem <> nil then
        begin
          nError := 24;
          UserItem := OverLapItem;
          WeightChanged;
          nError := 25;
          ItemObject.MakeGhost;
          nError := 26;
          SendRefMsg(RM_ITEMHIDE, 0, NativeInt(ItemObject), m_nCurrX, m_nCurrY, '');
        end
        else
        begin
          nError := 27;
          New(UserItem);
          UserItem^ := ItemObject.m_UserItem;
          m_ItemList.Add(UserItem);
          nError := 28;
          SendAddItem(UserItem);
          WeightChanged;
          nError := 29;
          ItemObject.MakeGhost;
          nError := 30;
          SendRefMsg(RM_ITEMHIDE, 0, NativeInt(ItemObject), m_nCurrX, m_nCurrY, '');
        end;
        nError := 31;
        if (not IsCheapStuff(StdItem.StdMode)) and (StdItem.NeedIdentify = 1) then
        begin
          AddGameDataLog(LOG_ItemPickup, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0');
        end;
        nError := 32;
        m_nScatterItemX := m_nCurrX;
        m_nScatterItemY := m_nCurrY;
        m_sScatterItemName := StdItem.Name;
        nError := 33;
        { TODO -ochongchong -c新增 : 物品规则 - 触发提示【2013-07-27】 }
        if (g_FunctionNPC <> nil) and g_ItemRules.Get(UserItem.wIndex, 21) then
        begin
          m_nScriptGotoCount := 0;
          m_sPickUpOrDropItemName := ProcessItemName(ItemObject.m_sName);
          m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          m_PickUpOrDropItem := UserItem^;
          if (g_FunctionNPC <> nil) then
            g_FunctionNPC.GotoLable(Self, '@PickUpItem', False);
        end;
        nError := 34;
        if (g_FunctionNPC <> nil) and g_ItemRules.Get(UserItem.wIndex, 25) then
        begin
          m_nScriptGotoCount := 0;
          m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          m_PickUpOrDropItem := UserItem^;
          if (g_FunctionNPC <> nil) then
            g_FunctionNPC.GotoLable(Self, '@PickUpItems' + IntToStr(wIndex - 1), False);
        end;
        nError := 35;
        m_nScriptGotoCount := 0;
        m_sPickUpOrDropItemName := ProcessItemName(ItemObject.m_sName);
        m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
        m_PickUpOrDropItem := UserItem^;
        nError := 36;
        if (g_FunctionNPC <> nil) then
          g_FunctionNPC.GotoLable(Self, '@PickUpItemEx', False);
        nError := 37;
        OnMapNotifyEvent(Self, mePickUpItem, StdItem.Name); // 捡物品事件
        boResult := True;
      end;
    end;
  except
    MainOutMessage(Format('[Exception] TPlayObject.ClientPickUpItem, Code = %d', [nError]));
  end;
end;

procedure TPlayObject.ClientTakeOnItems(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  btWhere: Byte;
  nItemIdx: Integer;
  sItemName: string;
  I, n14, n18, OldValue: Integer;
  UserItem, TakeOffItem: pTUserItem;
  TakeOffItemEx: TUserItem;
  StdItem, StdItem20, StdItemTemp: pTStdItem;
  StdItem58: TStdItem;
  sUserItemName: string;
  boMysteriousMan: Boolean;
  nError: Integer;
  { label
    FailExit; }
  procedure DoExit;
  begin
    if n18 <= 0 then
    begin
      if n18 = -99 then
      begin
        try
          DelBagItem(n14);
          RecalcAbilitys();
          SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
          SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
          SendMsg(Self, RM_DURACHANGE, btWhere, m_UseItems[btWhere].Dura, m_UseItems[btWhere].DuraMax, 0, '');
          if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
          begin
            AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0,
              '物品使用->' + StdItem20.Name);
          end;
        except
          MainOutMessage('[Exception] TPlayObject:ClientTakeOnItems.DoExit()');
        end;
      end;
      SendDefMessage(SM_TAKEON_FAIL, n18, 0, 0, ProcessMsg.wParam, '');
    end;
  end;

begin
  btWhere := ProcessMsg.nParam2;
  nItemIdx := ProcessMsg.nParam1;
  sItemName := ProcessMsg.sMsg;
  StdItem := nil;
  UserItem := nil;
  StdItem20 := nil;
  n14 := -1;
  boMysteriousMan := m_boMysteriousMan;
  nError := 2;
  try
    nError := 3;
    for I := 0 to m_ItemList.Count - 1 do
    begin
      nError := 4;
      UserItem := m_ItemList.Items[I];
      if (UserItem <> nil) and (UserItem.MakeIndex = nItemIdx) then
      begin
        nError := 5;
        // 取数据库物品名称
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
        nError := 6;
        { TODO -ochongchong -c新增 : 物品规则 - 英雄物品【2013-07-27】 }
        if (Length(sUserItemName) > 0) and g_ItemRules.Get(UserItem.wIndex, 16) then
        begin
          SendDefMessage(SM_TAKEON_FAIL, n18, 0, 0, ProcessMsg.wParam, '');
          SysMsg(g_sOnlyHeroDress, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
          Exit;
        end;
        // 取自定义物品名称
        if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
          sUserItemName := UserItem.Name;
        nError := 7;
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          if CompareText(sUserItemName, sItemName) = 0 then
          begin
            n14 := I;
            Break;
          end;
        end;
      end;
      UserItem := nil;
    end;
    nError := 8;
    n18 := 0;
    if (StdItem { 包裹 } <> nil) and (UserItem <> nil) then
    begin
      nError := 9;
      if CheckUserItems(btWhere, StdItem) and ((StdItem.Overlap = 0) or (StdItem.Overlap and 1 <> 0)) then
      begin
        nError := 10;
        StdItem58 := StdItem^;
        nError := 11;
        ItemUnit.GetItemAddValue(UserItem, StdItem58);
        nError := 12;
        if CheckTakeOnItems(btWhere, @StdItem58) and CheckItemBindUse(UserItem) then
        begin
          nError := 13;
          TakeOffItem := nil;
          nError := 14;
          if btWhere in [Low(THumanUseItems) .. High(THumanUseItems)] then
          begin
            nError := 15;
            if m_UseItems[btWhere].wIndex > 0 then
            begin
              nError := 16;
              StdItem20 := UserEngine.GetStdItem(m_UseItems[btWhere].wIndex);
              nError := 17;
              if (StdItem20 <> nil) and (StdItem20.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) then
              begin
                nError := 18;
                if (not m_boUserUnLockDurg) and (m_UseItems[btWhere].btValue[7] <> 0) then
                begin
                  nError := 19;
                  SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
                  n18 := -4;
                  // goto FailExit;
                  DoExit;
                  Exit;
                end;
              end;
              nError := 20;
              if not m_boUserUnLockDurg and ((StdItem20.Reserved and 2) <> 0) then
              begin
                nError := 21;
                SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
                n18 := -4;
                // goto FailExit;
                DoExit;
                Exit;
              end; // 004DAE78
              nError := 22;
              if (StdItem20.Reserved and 4) <> 0 then
              begin
                SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
                n18 := -4;
                // goto FailExit;
                DoExit;
                Exit;
              end;
              nError := 23;
              if InDisableTakeOffList(m_UseItems[btWhere].wIndex) or
                (GetUserItemBindValue(@m_UseItems[btWhere], ubNoTakeOff) and m_UseItems[btWhere].boIsBind) then
              begin
                SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
                // goto FailExit;
                DoExit;
                Exit;
              end;
              if (m_UseItems[btWhere].btValue[13] = 1) and (m_UseItems[btWhere].Name <> '') then
                sUserItemName := m_UseItems[btWhere].Name
              else
                sUserItemName := UserEngine.GetStdItemName(m_UseItems[btWhere].wIndex);
              m_nCurrentItemMakeIndex := m_UseItems[btWhere].MakeIndex;
              m_nCurrentItemPos := btWhere;
              m_sCurrentItemName := UserEngine.GetStdItemName(m_UseItems[btWhere].wIndex);
              m_sCurrentItemNewName := sUserItemName;
              m_PickUpOrDropItem := m_UseItems[btWhere];
              m_boStopTakeOff := False;
              g_FunctionNPC.GotoLable(Self, '@BeginTakeOff', False);
              m_PickUpOrDropItem.MakeIndex := 0;
              m_PickUpOrDropItem.wIndex := 0;
              m_nCurrentItemMakeIndex := 0;
              m_nCurrentItemPos := 0;
              m_sCurrentItemName := '';
              m_sCurrentItemNewName := '';
              if m_boStopTakeOff then
              begin
                DoExit;
                Exit;
              end;
              nError := 24;
              // 处理53类宝石 piaoyun 2013-08-26
              if StdItem20.StdMode = 53 then
              begin
                case StdItem20.AniCount of
                  1:
                    begin
                      // 气血石
                      nError := 25;
                      if (StdItem58.StdMode = 7) and (StdItem58.Shape in [1, 3]) then
                      begin
                        OldValue := m_UseItems[btWhere].Dura;
                        nError := 26;
                        m_UseItems[btWhere].Dura := Min(m_UseItems[btWhere].Dura + UserItem.Dura, m_UseItems[btWhere].DuraMax);
                        n18 := -99;
                        DoExit;
                        if (StdItem20.NeedIdentify = 1) then
                        begin
                          AddGameDataLog(LOG_ItemUpdate, LOG_ActionNone, Self, StdItem20.Name, m_UseItems[btWhere].MakeIndex, '0',
                            m_UseItems[btWhere].Dura, OldValue, '补充HP: +' + IntToStr(m_UseItems[btWhere].Dura - OldValue));
                        end;
                        Exit;
                      end
                      else if (StdItem58.StdMode = 7) and (StdItem58.Shape in [1, 2, 3]) then
                      begin
                        nError := 27;
                        SysMsg(Format('当前放入宝石类型不匹配，补充[%s]持久失败', [StdItem20.DBName]), g_Config.btRedMsgFColor,
                          g_Config.btRedMsgBColor, t_Hint);
                        n18 := -98;
                        DoExit;
                        Exit;
                      end;
                    end;
                  2:
                    begin
                      // 幻魔石
                      nError := 28;
                      if (StdItem58.StdMode = 7) and (StdItem58.Shape in [2, 3]) then
                      begin
                        OldValue := m_UseItems[btWhere].Dura;
                        nError := 29;
                        m_UseItems[btWhere].Dura := Min(m_UseItems[btWhere].Dura + UserItem.Dura, m_UseItems[btWhere].DuraMax);
                        n18 := -99;
                        DoExit;
                        if (StdItem20.NeedIdentify = 1) then
                        begin
                          AddGameDataLog(LOG_ItemUpdate, LOG_ActionNone, Self, StdItem20.Name, m_UseItems[btWhere].MakeIndex, '0',
                            m_UseItems[btWhere].Dura, OldValue, '补充MP: +' + IntToStr(m_UseItems[btWhere].Dura - OldValue));
                        end;
                        Exit;
                      end
                      else if (StdItem58.StdMode = 7) and (StdItem58.Shape in [1, 2, 3]) then
                      begin
                        nError := 30;
                        SysMsg(Format('当前放入宝石类型不匹配，补充[%s]持久失败', [StdItem20.DBName]), g_Config.btRedMsgFColor,
                          g_Config.btRedMsgBColor, t_Hint);
                        n18 := -98;
                        DoExit;
                        Exit;
                      end;
                    end;
                  3:
                    begin
                      // 魔血石
                      nError := 31;
                      if (StdItem58.StdMode = 7) and (StdItem58.Shape = 3) then
                      begin
                        OldValue := m_UseItems[btWhere].Dura;
                        nError := 32;
                        m_UseItems[btWhere].Dura := Min(m_UseItems[btWhere].Dura + UserItem.Dura, m_UseItems[btWhere].DuraMax);
