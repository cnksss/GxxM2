procedure TPlayObject.ServerSendRush(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  CharDesc: TCharDesc;
  nObjCount: Integer;
  s1C: string;
  nIndex: Integer;
begin
  case ProcessMsg.wIdent of
    RM_PUSH:
      m_DefMsg := MakeDefaultMsg(SM_BACKSTEP, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1 { x } ,
        ProcessMsg.nParam2 { y } , MakeWord(ProcessMsg.wParam { dir } , 1 { Step } ));
    RM_RUSH:
      m_DefMsg := MakeDefaultMsg(SM_RUSH, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
        MakeWord(ProcessMsg.wParam, TBaseObject(ProcessMsg.BaseObject).m_nLight));
    RM_RUSHKUNG:
      m_DefMsg := MakeDefaultMsg(SM_RUSHKUNG, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
        MakeWord(ProcessMsg.wParam, TBaseObject(ProcessMsg.BaseObject).m_nLight));
    RM_100HIT: // 追心刺
      m_DefMsg := MakeDefaultMsg(SM_100HIT, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
        MakeWord(ProcessMsg.wParam, ProcessMsg.nParam3));
    RM_MAGICMOVE: // 十步一杀
      m_DefMsg := MakeDefaultMsg(SM_MAGICMOVE, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
        MakeWord(ProcessMsg.wParam, TBaseObject(ProcessMsg.BaseObject).m_nLight));
    RM_CUSTOM_MAGICMOVE: // 自定义技能 瞬移
      begin
        nIndex := ProcessMsg.nParam3 - CUSTOM_MAGIC_START_ID;
        if (nIndex >= 0) then
        begin
          nIndex := SM_CUSTOM_MAGICMOVE001 + nIndex;
          if (nIndex >= SM_CUSTOM_MAGICMOVE001) and (nIndex < SM_CUSTOM_MAGICMOVE001 + CUSTOM_MAGIC_COUNT) then
          begin
            m_DefMsg := MakeDefaultMsg(nIndex, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
              MakeWord(ProcessMsg.wParam, TBaseObject(ProcessMsg.BaseObject).m_nLight));
          end;
        end;
      end;
    RM_CUSTOM_PUSH: // 自定义技能 追心刺推动方式
      begin
        nIndex := HiWord(ProcessMsg.wParam) - CUSTOM_MAGIC_START_ID;
        ProcessMsg.wParam := LoWord(ProcessMsg.wParam);
        if (nIndex >= 0) then
        begin
          nIndex := SM_CUSTOM_PUSH001 + nIndex;
          if (nIndex >= SM_CUSTOM_PUSH001) and (nIndex < SM_CUSTOM_PUSH001 + CUSTOM_MAGIC_COUNT) then
          begin
            m_DefMsg := MakeDefaultMsg(nIndex, NativeInt(ProcessMsg.BaseObject), ProcessMsg.nParam1, ProcessMsg.nParam2,
              MakeWord(ProcessMsg.wParam, ProcessMsg.nParam3)
              { MakeWord(ProcessMsg.wParam, TBaseObject(ProcessMsg.BaseObject).m_nLight) } );
          end;
        end;
      end;
  end;
  CharDesc.Feature := 0;
  CharDesc.Status := TBaseObject(ProcessMsg.BaseObject).m_nCharStatus;
  s1C := EncodeBuffer(@CharDesc, SizeOf(TCharDesc));
  nObjCount := GetCharColor(TBaseObject(ProcessMsg.BaseObject));
  if (ProcessMsg.wIdent = RM_100HIT) or (ProcessMsg.wIdent = RM_CUSTOM_PUSH) then
  begin
    if ProcessMsg.sMsg <> '' then
      s1C := s1C + '|' + ProcessMsg.sMsg;
  end
  else
  begin
    if ProcessMsg.sMsg <> '' then
      s1C := s1C + (EncodeString(ProcessMsg.sMsg + '/' + IntToStr(nObjCount)));
  end;
  SendSocket(@m_DefMsg, s1C);
  if (TObject(ProcessMsg.BaseObject) = Self) and (m_btRaceServer = RC_PLAYOBJECT) and
    ((ProcessMsg.wIdent = RM_PUSH) or (ProcessMsg.wIdent = RM_RUSH)) then
    SendMapCanRun;
end;

