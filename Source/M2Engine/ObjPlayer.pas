procedure TPlayObject.ClientStartContinuous(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nSpellPoint, nMagicCount: Integer;
  I, II, tmpNum1, tmpNum2, tmpNum3: Integer;
  MagicList: TList;
  UserMagic: pTUserMagic;
  nParam, nTag: Word;
  boMagicOrderChange: Boolean;
  procedure AddContinuousMagic;
  var
    I: Integer;
    UserMagic: pTUserMagic;
  begin
    for I := 0 to m_MagicList.Count - 1 do
    begin
      UserMagic := m_MagicList.Items[I];
      if (UserMagic.MagicAttr = mtContinuous) then
      begin
        MagicList.Add(UserMagic);
      end;
    end;
  end;

  function GetRandomMagic: pTUserMagic;
  var
    Index: Integer;
  begin
    Result := nil;
    if MagicList.Count > 0 then
    begin
      while True do
      begin
        if MagicList.Count = 1 then
        begin
          Index := 0;
          Break;
        end;
        Index := Random(MagicList.Count);
        if (Index >= 0) and (Index < MagicList.Count) then
          Break;
      end;

      if (Index >= 0) and (Index < MagicList.Count) then
      begin
        Result := MagicList.Items[Index];
        MagicList.Delete(Index);
      end;
    end;
  end;

begin
  if ProcessMsg.wParam <> 0 then
  begin
    tmpNum1 := MyGetTickCount - m_dwUseContinuousMagicTick;
    tmpNum2 := g_Config.nUseContinuousMagicTime - m_nContinuousMagic_DecTime;
    tmpNum3 := Max(0, tmpNum2 - tmpNum1 div 1000);

    if tmpNum3 >= 1 then
      SysMsg(Format('连击技冷却时间还有 %d 秒', []), c_Green, t_Hint)
    else
      SysMsg('连击技冷却时间小于一秒', c_Green, t_Hint);
    Exit;
  end;

  if m_boSendCanUseContinuous then
  begin
    m_dwUseContinuousMagicTick := MyGetTickCount;

    MagicList := TList.Create;
    AddContinuousMagic;
    if (MagicList.Count > 0) then
    begin
      SetLength(m_CurrContinuousMagic, 0);
      m_nCurrContinuousMagicIndex := 0;
      boMagicOrderChange := False;
      if m_boOpenLastContinuous then // 第四个连击开启
        nMagicCount := Length(m_ContinuousMagicOrder)
      else
        nMagicCount := Length(m_ContinuousMagicOrder) - 1;

      for I := 0 to nMagicCount - 1 do
      begin // 检测是否有重复的连击
        if m_ContinuousMagicOrder[I] > 1 then
        begin
          for II := I + 1 to nMagicCount - 1 do
          begin
            if m_ContinuousMagicOrder[I] = m_ContinuousMagicOrder[II] then
            begin
              m_ContinuousMagicOrder[I] := 0;
              boMagicOrderChange := True;
              Break;
            end;
          end;
        end;
      end;

      for I := 0 to nMagicCount - 1 do
      begin // 去掉固定的连击技能
        if m_ContinuousMagicOrder[I] > 1 then
        begin
          for II := 0 to MagicList.Count - 1 do
          begin
            UserMagic := MagicList.Items[II];
            if UserMagic.wMagIdx = m_ContinuousMagicOrder[I] then
            begin
              MagicList.Delete(II);
              Break;
            end;
          end;
        end;
      end;

      nSpellPoint := 0;
      // 根据魔法、或者内力计算能释放多少连击 piaoyun 2013-09-13
      for I := 0 to nMagicCount - 1 do
      begin
        if m_ContinuousMagicOrder[I] > 0 then
        begin
          if m_ContinuousMagicOrder[I] = 1 then
          begin // 获取随机的连击技能
            UserMagic := GetRandomMagic;
            if (UserMagic <> nil) then
            begin
              nSpellPoint := nSpellPoint + GetSpellPoint(UserMagic);
              if (nSpellPoint > 0) and
                ((m_WAbil.MP >= nSpellPoint) or (g_Config.boContinuousAttackUseNG and (m_AbilNG.NH >= nSpellPoint))) then
              begin
                SetLength(m_CurrContinuousMagic, Length(m_CurrContinuousMagic) + 1);
                m_CurrContinuousMagic[Length(m_CurrContinuousMagic) - 1] := UserMagic^;
              end;
            end
          end
          else
          begin
            UserMagic := FindContinuousMagic(m_ContinuousMagicOrder[I]);
            if (UserMagic <> nil) then
            begin
              nSpellPoint := nSpellPoint + GetSpellPoint(UserMagic);
              if (nSpellPoint > 0) and
                ((m_WAbil.MP >= nSpellPoint) or (g_Config.boContinuousAttackUseNG and (m_AbilNG.NH >= nSpellPoint))) then
              begin
                SetLength(m_CurrContinuousMagic, Length(m_CurrContinuousMagic) + 1);
                m_CurrContinuousMagic[Length(m_CurrContinuousMagic) - 1] := UserMagic^;
              end;
            end
          end;
        end;
      end;

      if boMagicOrderChange then
        SendMsg(Self, RM_CONTINUOUSMAGICORDER, 0, 0, 0, 0, ''); // 连击顺序

      if Length(m_CurrContinuousMagic) > 0 then
      begin
        // 根据魔法、或者内力计算能释放多少连击并扣除相应点数 piaoyun 2013-09-13
        if g_Config.boContinuousAttackUseNG then
        begin
          if (nSpellPoint > 0) and (m_AbilNG.NH >= nSpellPoint) then
          begin
            m_AbilNG.NH := Max(0, m_AbilNG.NH - nSpellPoint);
            RefAbilNH;
            m_boContinuous := True;
          end;
        end
        else if (nSpellPoint > 0) and (m_WAbil.MP >= nSpellPoint) then
        begin
          DamageSpell(nSpellPoint);
          HealthSpellChanged();
          m_boContinuous := True;
        end;

        if m_boContinuous then
        begin
          if Length(m_CurrContinuousMagic) >= 2 then
            nParam := MakeWord(m_CurrContinuousMagic[0].wMagIdx, m_CurrContinuousMagic[1].wMagIdx)
          else
            nParam := MakeWord(m_CurrContinuousMagic[0].wMagIdx, 0);

          if Length(m_CurrContinuousMagic) >= 4 then
            nTag := MakeWord(m_CurrContinuousMagic[2].wMagIdx, m_CurrContinuousMagic[3].wMagIdx)
          else if Length(m_CurrContinuousMagic) >= 3 then
            nTag := MakeWord(m_CurrContinuousMagic[2].wMagIdx, 0)
          else
            nTag := 0;

          SendMsg(Self, RM_CONTINUOUSMAGIC_OK, 0, nParam, nTag, 0, '');
          if g_Config.boContinuousAttackUseNG then
            SysMsg(Format(g_sStartContinuesAttackNG, [Length(m_CurrContinuousMagic)]), c_Green, t_Hint)
          else
            SysMsg(Format(g_sStartContinuesAttackMP, [Length(m_CurrContinuousMagic)]), c_Green, t_Hint);
        end
        else
        begin
          SendMsg(Self, RM_CONTINUOUSMAGIC_FAIL, -1, Integer(g_Config.boContinuousAttackUseNG), 0, 0, '');
          m_boContinuous := False;
          m_boSendCanUseContinuous := False; // 发送可以使用连击的信息
        end;
      end
      else
      begin
        SendMsg(Self, RM_CONTINUOUSMAGIC_FAIL, -1, Integer(g_Config.boContinuousAttackUseNG), 0, 0, '');
        m_boContinuous := False;
        m_boSendCanUseContinuous := False; // 发送可以使用连击的信息
      end;
    end;
    MagicList.Free;
  end;
end;

procedure TPlayObject.ClientStopContinuous(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  m_boContinuous := False;
  m_boSendCanUseContinuous := False; // 发送可以使用连击的信息
end;

procedure TPlayObject.ClientChangeContinuousMagicOrder(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  boChange: Boolean;
  I: Integer;
begin
  if ProcessMsg.wParam = 1 then
  begin
    if m_MyHero <> nil then
    begin
      THeroObject(m_MyHero).m_ContinuousMagicOrder[0] := LoByte(ProcessMsg.nParam2);
      THeroObject(m_MyHero).m_ContinuousMagicOrder[1] := HiByte(ProcessMsg.nParam2);
      THeroObject(m_MyHero).m_ContinuousMagicOrder[2] := LoByte(ProcessMsg.nParam3);
      THeroObject(m_MyHero).m_ContinuousMagicOrder[3] := HiByte(ProcessMsg.nParam3);
      if THeroObject(m_MyHero).GetContinuousMagicCount <= 0 then
      begin // 没有连击技能
        THeroObject(m_MyHero).m_ContinuousMagicOrder[0] := 0;
        THeroObject(m_MyHero).m_ContinuousMagicOrder[1] := 0;
        THeroObject(m_MyHero).m_ContinuousMagicOrder[2] := 0;
        THeroObject(m_MyHero).m_ContinuousMagicOrder[3] := 0;
        m_MyHero.SendMsg(m_MyHero, RM_CONTINUOUSMAGICORDER, 0, 0, 0, 0, ''); // 连击顺序
      end
      else
      begin
        boChange := False;
        for I := 0 to Length(THeroObject(m_MyHero).m_ContinuousMagicOrder) - 1 do
        begin
          if THeroObject(m_MyHero).m_ContinuousMagicOrder[I] > 1 then
          begin
            if THeroObject(m_MyHero).FindContinuousMagic(THeroObject(m_MyHero).m_ContinuousMagicOrder[I]) = nil then
            begin // 没有发连击技能
              THeroObject(m_MyHero).m_ContinuousMagicOrder[I] := 0;
              boChange := True;
            end;
          end;
        end;
        if boChange then
          m_MyHero.SendMsg(m_MyHero, RM_CONTINUOUSMAGICORDER, 0, 0, 0, 0, ''); // 连击顺序
      end;
    end;
  end
  else
  begin
    m_ContinuousMagicOrder[0] := LoByte(ProcessMsg.nParam2);
    m_ContinuousMagicOrder[1] := HiByte(ProcessMsg.nParam2);
    m_ContinuousMagicOrder[2] := LoByte(ProcessMsg.nParam3);
    m_ContinuousMagicOrder[3] := HiByte(ProcessMsg.nParam3);
    if GetContinuousMagicCount <= 0 then
    begin // 没有连击技能
      m_ContinuousMagicOrder[0] := 0;
      m_ContinuousMagicOrder[1] := 0;
      m_ContinuousMagicOrder[2] := 0;
      m_ContinuousMagicOrder[3] := 0;
      SendMsg(Self, RM_CONTINUOUSMAGICORDER, 0, 0, 0, 0, ''); // 连击顺序
    end
    else
    begin
      boChange := False;
      for I := 0 to Length(m_ContinuousMagicOrder) - 1 do
      begin
        if m_ContinuousMagicOrder[I] > 1 then
        begin
          if FindContinuousMagic(m_ContinuousMagicOrder[I]) = nil then
          begin // 没有发连击技能
            m_ContinuousMagicOrder[I] := 0;
            boChange := True;
          end;
        end;
      end;
      if boChange then
        SendMsg(Self, RM_CONTINUOUSMAGICORDER, 0, 0, 0, 0, ''); // 连击顺序
    end;
  end;
end;

