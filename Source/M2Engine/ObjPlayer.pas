procedure TPlayObject.ClientRetrieveMyAuctionItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  AuctionRecord: TAuctionRecord;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
begin
  if ProcessMsg.nParam2 = 0 then
  begin
    if not g_M2DataDB.AuctionDB.GetAuctionRecord(ProcessMsg.nParam1, AuctionRecord) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 1, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if not SameText(AuctionRecord.HumanName, m_sCharName) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 2, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if (Length(AuctionRecord.LastBidder) > 0) or (AuctionRecord.IsItemGive) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 3, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if not IsEnoughBag then
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 4, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if g_M2DataDB.AuctionDB.RetrieveAuctionItem(AuctionRecord.AuctionID) then
    begin
      New(UserItem);
      UserItem^ := AuctionRecord.ActionItem;
      m_ItemList.Add(UserItem);
      SendAddItem(UserItem);
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 0, 0, 0);
      SendSocket(@m_DefMsg, '');

      StdItem := UserEngine.GetStdItem(AuctionRecord.ActionItem.wIndex);
      if StdItem <> nil then
      begin
        if StdItem.NeedIdentify = 1 then
          AddGameDataLog(LOG_ItemTakeBack, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '拍卖行');

        m_sCurrentItemName := StdItem.DBName;
        m_sCurrentItemNewName := StdItem.Name;
        m_CurrentItemOverlapCount := ifthen(StdItem.Overlap > 0, UserItem.Dura + 1, 1);
        m_nCurrentItemMakeIndex := UserItem.MakeIndex;
      end;
    end
    else
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 99, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;
  end
  else
  begin
    if not g_M2DataDB.AuctionDB.GetAuctionRecord(ProcessMsg.nParam1, AuctionRecord) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 1, 1, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if (not SameText(AuctionRecord.LastBidder, m_sCharName)) or (AuctionRecord.TradingStatus <> 2) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 2, 1, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if AuctionRecord.IsItemGive then
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 3, 1, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if not IsEnoughBag then
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 4, 1, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if g_M2DataDB.AuctionDB.RetrieveAuctionItem(AuctionRecord.AuctionID) then
    begin
      New(UserItem);
      UserItem^ := AuctionRecord.ActionItem;
      m_ItemList.Add(UserItem);
      SendAddItem(UserItem);
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 0, 1, 0);
      SendSocket(@m_DefMsg, '');

      StdItem := UserEngine.GetStdItem(AuctionRecord.ActionItem.wIndex);
      if StdItem <> nil then
      begin
        if StdItem.NeedIdentify = 1 then
          AddGameDataLog(LOG_ItemTakeBack, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '拍卖行');

        m_sCurrentItemName := StdItem.DBName;
        m_sCurrentItemNewName := StdItem.Name;
        m_CurrentItemOverlapCount := ifthen(StdItem.Overlap > 0, UserItem.Dura + 1, 1);
        m_nCurrentItemMakeIndex := UserItem.MakeIndex;
      end;
    end
    else
    begin
      m_DefMsg := MakeDefaultMsg(SM_RETRIEVEMYAUCTIONITEM_RET, ProcessMsg.nParam1, 99, 1, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;
  end;

  m_sAuctionItemHumanName := AuctionRecord.HumanName; // 物品拍卖者
  m_nAuctionItemMoneyType := AuctionRecord.CurrencyType; // 货币类型
  m_nAuctionItemFinaPrice := AuctionRecord.LastBidPrice;
  g_FunctionNPC.GotoLable(Self, '@AuctionItemTakeBack', False);
  m_sAuctionItemHumanName := ''; // 物品拍卖者
  m_nAuctionItemMoneyType := 0; // 货币类型
  m_nAuctionItemFinaPrice := 0;
  m_sCurrentItemName := '';
  m_sCurrentItemNewName := '';
  m_CurrentItemOverlapCount := 0;
  m_nCurrentItemMakeIndex := 0;
end;

procedure TPlayObject.ClientAuctionAttentionItem(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 关注/取消关注
var
  AuctionInfo: TAuctionInfo;
begin
  // 关注物品
  if ProcessMsg.nParam2 = 1 then
  begin
    if not g_M2DataDB.AuctionDB.GetAuctionInfo(ProcessMsg.nParam1, AuctionInfo) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionAttentionItem_RET, ProcessMsg.nParam1, 1, 1, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;
    if g_M2DataDB.AuctionDB.AddAttentionItem(m_sCharName, ProcessMsg.nParam1) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionAttentionItem_RET, ProcessMsg.nParam1, 1, 0, 0);
      SendSocket(@m_DefMsg, '');
    end
    else
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionAttentionItem_RET, ProcessMsg.nParam1, 1, 2, 0);
      SendSocket(@m_DefMsg, '');
    end;
  end
  else
  begin
    if (not AuctionInfo.IsItemGive) and SameText(AuctionInfo.LastBidder, m_sCharName) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionAttentionItem_RET, ProcessMsg.nParam1, 0, 2, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;
    if g_M2DataDB.AuctionDB.DeleteAttentionItem(m_sCharName, ProcessMsg.nParam1) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionAttentionItem_RET, ProcessMsg.nParam1, 0, 0, 0);
      SendSocket(@m_DefMsg, '');
    end
    else
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionAttentionItem_RET, ProcessMsg.nParam1, 0, 3, 0);
      SendSocket(@m_DefMsg, '');
    end;
  end;
end;

procedure TPlayObject.ClientAuctionItemBid(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 参与物品竞价
  function CheckGameMoney(nCurrencyType: Integer; Prices: LongWord): Boolean;
  begin
    case nCurrencyType of
      0:
        Result := m_nGameGold >= Prices; // 游戏币
      1:
        Result := m_nGamePoint >= Prices; // 游戏点
      2:
        Result := m_nGold >= Prices; // 金币数量
      3:
        Result := m_nGameDiamond >= Prices; // 金刚石
      4:
        Result := m_nGameGird >= Prices; // 灵符
    else
      Result := CheckMoney(nCurrencyType - 5, Prices);
    end;
  end;
  procedure IncPlayerGameMoney(PlayerName: string; MakeIndex, nCurrencyType, Prices: LongWord; IsSelled: Boolean;
    var OutPlayer: TPlayObject);
  var
    nValue: Int64;
    nBack: Integer;
    Player: TPlayObject;
    GoldType: TDBChangeGoldType;
  begin
    Player := UserEngine.GetPlayObject(PlayerName);
    OutPlayer := Player;
    if Player <> nil then
    begin
      case nCurrencyType of
        0:
          begin
            nValue := Int64(Player.m_nGameGold) + Prices;
            if nValue > High(LongWord) then
              nValue := High(LongWord);
            Player.m_nGameGold := nValue;
            Player.GameGoldChanged;
          end;
        1:
          begin
            nValue := Int64(Player.m_nGamePoint) + Prices;
            if nValue > High(LongWord) then
              nValue := High(LongWord);
            Player.m_nGamePoint := nValue;
            Player.GameGoldChanged;
          end;
        2:
          begin
            nValue := Int64(Player.m_nGold) + Prices;
            if nValue > g_Config.nHumanMaxGold then
              nValue := g_Config.nHumanMaxGold;
            Player.m_nGold := nValue;
            Player.GoldChanged();
          end;
        3:
          begin
            nValue := Int64(Player.m_nGameDiamond) + Prices;
            if nValue > High(LongWord) then
              nValue := High(LongWord);
            Player.m_nGameDiamond := nValue;
            Player.NewGamePointChanged;
          end;
        4:
          begin
            nValue := Int64(Player.m_nGameGird) + Prices;
            if nValue > High(LongWord) then
              nValue := High(LongWord);
            Player.m_nGameGird := nValue;
            Player.NewGamePointChanged;
          end;
      else
        Player.IncMoney(nCurrencyType - 5, Prices, nBack)
      end;
      case nCurrencyType of
        0:
          begin
            if g_boGameLogGameGold then
            begin
              if IsSelled then
                AddGameDataLog(LOG_ItemSellPrice, LOG_GameGoldChange, Player, g_Config.sGameGoldName, MakeIndex, '拍卖行',
                  Player.m_nGameGold, Prices, '已卖出')
              else
                AddGameDataLog(LOG_GameGoldChange, LOG_ActionNone, Player, g_Config.sGameGoldName, MakeIndex, '拍卖行',
                  Player.m_nGameGold, Prices, '退竞拍费用')
            end;
          end;
        1: // 排除
          begin
            if g_boGameLogGameGold then
            begin
              if IsSelled then
                AddGameDataLog(LOG_ItemSellPrice, LOG_GamePointChange, Player, g_Config.sGamePointName, MakeIndex, '拍卖行',
                  Player.m_nGamePoint, Prices, '已卖出')
              else
                AddGameDataLog(LOG_GamePointChange, LOG_ActionNone, Player, g_Config.sGamePointName, MakeIndex, '拍卖行',
                  Player.m_nGamePoint, Prices, '退竞拍费用')
            end;
          end;
        2:
          begin
            if g_boGameLogGold then
            begin
              if IsSelled then
                AddGameDataLog(LOG_ItemSellPrice, LOG_GoldChange, Player, sSTRING_GOLDNAME, MakeIndex, '拍卖行', Player.m_nGold,
                  Prices, '已卖出')
              else
                AddGameDataLog(LOG_GoldChange, LOG_ActionNone, Player, sSTRING_GOLDNAME, MakeIndex, '拍卖行', Player.m_nGold,
                  Prices, '退竞拍费用')
            end;
          end;
        3:
          begin
            if g_boGameLogGameGold then
            begin
              if IsSelled then
                AddGameDataLog(LOG_ItemSellPrice, LOG_GameDiamondChange, Player, g_Config.sGameDiamondName, MakeIndex, '拍卖行',
                  Player.m_nGameDiamond, Prices, '已卖出')
              else
                AddGameDataLog(LOG_GameDiamondChange, LOG_ActionNone, Player, g_Config.sGameDiamondName, MakeIndex, '拍卖行',
                  Player.m_nGameDiamond, Prices, '退竞拍费用')
            end;
          end;
        4:
          begin
            if g_boGameLogGameGold then
            begin
              if IsSelled then
                AddGameDataLog(LOG_ItemSellPrice, LOG_GameGirdChange, Player, g_Config.sGameGirdName, MakeIndex, '拍卖行',
                  Player.m_nGameGird, Prices, '已卖出')
              else
                AddGameDataLog(LOG_GameGirdChange, LOG_ActionNone, Player, g_Config.sGameGirdName, MakeIndex, '拍卖行',
                  Player.m_nGameGird, Prices, '退竞拍费用')
            end;
          end;
      end;
    end
    else
    begin
      case nCurrencyType of
        0:
          GoldType := cgtGameGold;
        1:
          GoldType := cgtGamePoint;
        2:
          GoldType := cgtGold;
        3:
          GoldType := cgtGameDiamond;
        4:
          GoldType := cgtGameGird;
      else
        GoldType := cgtCustomMoney;
      end;
      // 玩家离线了自定义货币的处理 最后制作 By 一支笔 at:2022-03-10 21:42:16
      DataEngine.HumanChangeGold(Player, nil, GoldType, m_sCharName, PlayerName, Prices,
        GetCustomMoneyNameByRule(nCurrencyType, 3));
      case nCurrencyType of
        0:
          begin
            if g_boGameLogGameGold then
            begin
              if IsSelled then
