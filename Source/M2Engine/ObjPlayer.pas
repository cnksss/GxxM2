procedure TPlayObject.SendQuerySellPlayerShopItem(SearchInfo: PSellPlayerSearchInfo; Page: Integer; IsNewOpen: Boolean);
  procedure QuickSortListByPrices(List: TList; L, R: Integer; IsAsc: Boolean);
  var
    I, J, P: Integer;
    SellPlayerItem: PSellPlayerItem;
  begin
    repeat
      I := L;
      J := R;
      P := (L + R) shr 1;
      SellPlayerItem := List.Items[P];
      repeat
        if IsAsc then
        begin
          while PSellPlayerItem(List[I]).Prices < SellPlayerItem.Prices do
            Inc(I);
          while PSellPlayerItem(List[J]).Prices > SellPlayerItem.Prices do
            Dec(J);
        end
        else
        begin
          while PSellPlayerItem(List[I]).Prices > SellPlayerItem.Prices do
            Inc(I);
          while PSellPlayerItem(List[J]).Prices < SellPlayerItem.Prices do
            Dec(J);
        end;
        if I <= J then
        begin
          List.Exchange(I, J);
          if P = I then
          begin
            P := J;
            SellPlayerItem := List.Items[P];
          end
          else if P = J then
          begin
            P := I;
            SellPlayerItem := List.Items[P];
          end;
          Inc(I);
          Dec(J);
        end;
      until I > J;
      if L < J then
        QuickSortListByPrices(List, L, J, IsAsc);
      L := I;
    until I >= R;
  end;
  procedure QuickSortListByLevel(List: TList; L, R: Integer; IsAsc: Boolean);
  var
    I, J, P: Integer;
    SellPlayerItem: PSellPlayerItem;
  begin
    repeat
      I := L;
      J := R;
      P := (L + R) shr 1;
      SellPlayerItem := List.Items[P];
      repeat
        if IsAsc then
        begin
          while PSellPlayerItem(List[I]).Level < SellPlayerItem.Level do
            Inc(I);
          while PSellPlayerItem(List[J]).Level > SellPlayerItem.Level do
            Dec(J);
        end
        else
        begin
          while PSellPlayerItem(List[I]).Level > SellPlayerItem.Level do
            Inc(I);
          while PSellPlayerItem(List[J]).Level < SellPlayerItem.Level do
            Dec(J);
        end;
        if I <= J then
        begin
          List.Exchange(I, J);
          if P = I then
          begin
            P := J;
            SellPlayerItem := List.Items[P];
          end
          else if P = J then
          begin
            P := I;
            SellPlayerItem := List.Items[P];
          end;
          Inc(I);
          Dec(J);
        end;
      until I > J;
      if L < J then
        QuickSortListByLevel(List, L, J, IsAsc);
      L := I;
    until I >= R;
  end;

const
  ONE_PAGE_COUNT = 5;
var
  I, MaxPage, nCount: Integer;
  List: TList;
  SellPlayerInfo: PSellPlayerInfo;
  SellPlayerItem, SendSellPlayerItem: PSellPlayerItem;
  Player: TPlayObject;
  InBuf: array [0 .. SizeOf(TSellPlayerItem) * ONE_PAGE_COUNT] of AnsiChar;
  ViewStorage: Word;
  NewOpen: Word;
begin
  if Page < 0 then // Page小于0时，表示点击搜索按钮
  begin
    m_QuerySellPlayerItem_Keyword := SearchInfo.PlayerName;
    m_QuerySellPlayerItem_JobType := SearchInfo.Job;
    m_QuerySellPlayerItem_MoneyType := SearchInfo.MoneyType;
    m_QuerySellPlayerItem_SortType := SearchInfo.SortType;
    m_QuerySellPlayerItem_MinPrice := SearchInfo.PricesMin;
    m_QuerySellPlayerItem_MaxPrice := SearchInfo.PricesMax;
    m_QuerySellPlayerItem_MinLevel := SearchInfo.LevelMin;
    m_QuerySellPlayerItem_MaxLevel := SearchInfo.LevelMax;
    Page := 0;
  end;
{$IF NEED_KEY = 1}
  if g_nKey_SellPlayer = 0 then
    Exit;
{$IFEND}
  List := TList.Create;
  try
    List.Capacity := 1000;
    for I := 0 to g_SellPlayerList.Count - 1 do
    begin
      SellPlayerInfo := g_SellPlayerList.Items[I];
      // 指定买家不是自己
      if (not SellPlayerInfo.SetUser) or (SellPlayerInfo.SetUser and SameText(SellPlayerInfo.SetUserName, m_sCharName)) then
      begin
        // 判断关键字是否符号
        if (m_QuerySellPlayerItem_Keyword <> '') and (Pos(m_QuerySellPlayerItem_Keyword, SellPlayerInfo.Player) = 0) then
          Continue;
        // 货币类型不符
        if (m_QuerySellPlayerItem_MoneyType > 0) and (SellPlayerInfo.SellPricesType <> m_QuerySellPlayerItem_MoneyType - 1) then
          Continue;
        // 价格不符
        if (m_QuerySellPlayerItem_MinPrice > 0) and (SellPlayerInfo.SellPrices < m_QuerySellPlayerItem_MinPrice) then
          Continue;
        if (m_QuerySellPlayerItem_MaxPrice > 0) and (SellPlayerInfo.SellPrices > m_QuerySellPlayerItem_MaxPrice) then
          Continue;
        Player := UserEngine.GetPlayObject(SellPlayerInfo.Player);
        if Player = nil then
          Continue;
        // 职业不符
        if (m_QuerySellPlayerItem_JobType > 0) and (Player.m_btJob <> m_QuerySellPlayerItem_JobType - 1) then
          Continue;
        // 等级不符
        if (m_QuerySellPlayerItem_MinLevel > 0) and (Player.m_Abil.Level < m_QuerySellPlayerItem_MinLevel) then
          Continue;
        if (m_QuerySellPlayerItem_MaxLevel > 0) and (Player.m_Abil.Level > m_QuerySellPlayerItem_MaxLevel) then
          Continue;
        New(SellPlayerItem);
        SellPlayerItem.Index := 0;
        SellPlayerItem.PlayerName := SellPlayerInfo.Player;
        SellPlayerItem.Job := Player.m_btJob;
        SellPlayerItem.Level := Player.m_Abil.Level;
        SellPlayerItem.Prices := SellPlayerInfo.SellPrices;
        SellPlayerItem.MoneyType := SellPlayerInfo.SellPricesType;
        List.Add(SellPlayerItem);
      end;
    end;
    nCount := 0;
    MaxPage := 0;
    if List.Count > 0 then
    begin
      if m_QuerySellPlayerItem_SortType <= 1 then
        QuickSortListByPrices(List, 0, List.Count - 1, m_QuerySellPlayerItem_SortType = 0)
      else
        QuickSortListByLevel(List, 0, List.Count - 1, m_QuerySellPlayerItem_SortType = 2);
      MaxPage := (List.Count + ONE_PAGE_COUNT - 1) div ONE_PAGE_COUNT;
      if Page >= MaxPage then
        Page := MaxPage - 1;
      SendSellPlayerItem := @InBuf;
      for I := Page * ONE_PAGE_COUNT to List.Count - 1 do
      begin
        SellPlayerItem := List.Items[I];
        SendSellPlayerItem^ := SellPlayerItem^;
        SendSellPlayerItem.Index := I + 1;
        Inc(nCount);
        Inc(SendSellPlayerItem);
        if nCount >= ONE_PAGE_COUNT then
          Break;
      end;
    end;
    ViewStorage := 0;
    if g_Config.boSellPlayerViewStorage then
      ViewStorage := 1;
    if g_Config.boSellPlayerViewStorageEx then
      ViewStorage := ViewStorage or 2;
    if g_Config.boSellPlayerAutoRecallHero then
      ViewStorage := ViewStorage or 4;
    if IsNewOpen then
      NewOpen := $8000
    else
      NewOpen := $0000;
    NewOpen := NewOpen or g_Config.nSellPlayerCurrencyTypeEx;
    m_DefMsg := MakeDefaultMsg(SM_OPEN_SELL_PLAY_SHOP_DLG, MakeLong(ViewStorage, MaxPage), Page, NewOpen, nCount);
    // SM_QUERYUSERSHOPITEMS
    SendSocketEx(@m_DefMsg, @InBuf, nCount * SizeOf(TSellPlayerItem));
  finally
    for I := 0 to List.Count - 1 do
    begin
      SellPlayerItem := List.Items[I];
      Dispose(SellPlayerItem);
    end;
    List.Free;
  end;
end;

