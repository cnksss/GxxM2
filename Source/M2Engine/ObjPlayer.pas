procedure TPlayObject.DelBoxItem(Index: Integer; NpcName, LogDesc: string; Count: Integer = 0);
{$IF NEED_KEY <> 2}
var
  I: Integer;
  UserItem: pTUserItem;
  nMakeIndex: Integer;
  StdItem: pTStdItem;
  IsOverlapItem, IsDeleteItem: Boolean;
{$IFEND}
begin
{$IF NEED_KEY <> 2}
  if (not Index in [Low(m_ItemBoxItems) .. High(m_ItemBoxItems)]) then
    Exit;
  nMakeIndex := m_ItemBoxItems[Index];
  if nMakeIndex = 0 then
    Exit;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := pTUserItem(m_ItemList[I]);
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem = nil then
      Continue;
    if UserItem.MakeIndex = nMakeIndex then
    begin
      if Count = 0 then
        IsDeleteItem := True
      else
      begin
        IsOverlapItem := CheckOverLapItem(StdItem);
        if IsOverlapItem then
        begin
          if Count < UserItem.Dura + 1 then // 比物品数量小
            IsDeleteItem := False
          else
            IsDeleteItem := True;
        end
        else
          IsDeleteItem := True;
      end;
      if IsDeleteItem then
      begin
        if m_UpgradeItem = UserItem then
        begin
          m_UpgradeItem := nil;
          m_UpgradeItemIsPegBag := False;
        end;
        m_ItemList.Delete(I);
        Dispose(UserItem);
        m_ItemBoxItems[Index] := 0;
        m_DefMsg := MakeDefaultMsg(SM_DELBOXITEM, Index, 0, 0, 0);
        SendSocket(@m_DefMsg, '');
        WeightChanged();
        if StdItem.NeedIdentify = 1 then
        begin
          // 注释日志 chongchong 2017-10-09
          AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, Self, StdItem.Name, nMakeIndex, NpcName, 0, 0, LogDesc);
        end;
      end
      else
      begin
        UserItem.Dura := UserItem.Dura - Count;
        UpdateBoxItem(Index);
        WeightChanged();
        if StdItem.NeedIdentify = 1 then
        begin
          // 注释日志 chongchong 2017-10-09
          AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, NpcName, UserItem.Dura,
            -Count, LogDesc);
        end
      end;
      Exit;
    end;
  end;
{$IFEND}
end;

