  private
    FPlayer: TPlayObject;
    FLastUseMagicID: Word;
    FLastUseMagicTick: LongWord;
  public
    constructor Create(APlayer: TPlayObject);
    property Player: TPlayObject read FPlayer;
    function CanOpenMagic(MagicID: Word; var MagicName: string): Boolean;
    function CanUseMagic(MagicID: Word): Boolean;
    procedure UseMagic(MagicID: Word);
  end;

implementation

uses
  M2Share, Guild, HUtil32, ObjNpc, IdSrvClient, ItmUnit, GameEvent, ObjMon, ObjHero, LocalDB, Castle, SndaShop, GameGoldDealDB,
  ItemEffects, Magic, RunSock, HandleCommands, ObjSmartMon, uCustomMagicUtils, uAliyunSendSMSThread, uCombatPowerUtils;

{ TWarrContinueHitManager }
constructor TWarrContinueHitManager.Create(APlayer: TPlayObject);
begin
  FPlayer := APlayer;
  FLastUseMagicTick := 0;
  inherited Create();
end;

function TWarrContinueHitManager.CanOpenMagic(MagicID: Word; var MagicName: string): Boolean;
begin
  Result := True;
end;

function TWarrContinueHitManager.CanUseMagic(MagicID: Word): Boolean;
var
  I: Integer;
  TempID: Integer;
  IsFound: Boolean;
begin
  Result := True;
  if not g_Config.boDisableWarrContinueHit then
    Exit;

  if FLastUseMagicID = 0 then
    Exit;

  if FLastUseMagicID = MagicID then
    Exit;

  IsFound := False;
  for I := 0 to g_WarrContinueMagicIDList.Count - 1 do
  begin
    TempID := Integer(g_WarrContinueMagicIDList.Objects[I]);
    if TempID = MagicID then
    begin
      IsFound := True;
      Break;
    end;
  end;

  if IsFound then
    Result := Tick_Diff(FLastUseMagicTick, MyGetTickCount) >= g_Config.nWarrContinueHitMinInterval;
end;

procedure TWarrContinueHitManager.UseMagic(MagicID: Word);
var
  I: Integer;
  TempID: Integer;
  IsFound: Boolean;
begin
  IsFound := False;
  for I := 0 to g_WarrContinueMagicIDList.Count - 1 do
  begin
    TempID := Integer(g_WarrContinueMagicIDList.Objects[I]);
    if TempID = MagicID then
    begin
      IsFound := True;
      Break;
    end;
  end;
  if IsFound then
  begin
    FLastUseMagicID := MagicID;
    FLastUseMagicTick := MyGetTickCount;
  end;
end;

