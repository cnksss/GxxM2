procedure TPlayObject.SendViewSellPlayerFengHao(Player: TPlayObject);
var
  I: Integer;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  sSendMsg: AnsiString;
  nC: Integer;
  InBuf: PAnsiChar;
  InBufMemSize: Integer;
  InBytes: Integer;
  Buffer: PAnsiChar;
  PClientItem: pTClientItem;
begin
  sSendMsg := '';
  InBytes := 0;
  nC := 0;
  InBufMemSize := Player.m_FengHaoItems.Count * (SizeOf(TClientItem) + 1) + 1;
  try
    GetMem(InBuf, InBufMemSize);
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TPlayObject:ClientQuerySellPlayerInfo Error');
      MainOutMessage(E.Message);
      Exit;
    end;
  end;
  try
    for I := 0 to Player.m_FengHaoItems.Count - 1 do
    begin
      UserItem := Player.m_FengHaoItems.Items[I];
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem <> nil then
      begin
        Inc(nC);
        Inc(InBytes, SizeOf(TClientItem) + 1);
        Buffer := InBuf;
        Buffer := Buffer + (InBytes - (SizeOf(TClientItem) + 1));
        Buffer^ := AnsiChar(I);
        Inc(Buffer);
        PClientItem := pTClientItem(Buffer);
        UserItemToClientItem(UserItem, StdItem, PClientItem, True, False);
      end;
    end;
    sSendMsg := zLibCompressBuffer(InBuf, InBytes);
    m_DefMsg := MakeDefaultMsg(SM_VIEW_SELL_PLAYER_INFO_FENGHAO, Integer(Player.m_ActiveFengHao), Length(sSendMsg), 0, nC);
    SendSocket(@m_DefMsg, sSendMsg);
  finally
    FreeMem(InBuf, InBufMemSize);
  end;
end;

procedure TPlayObject.SendViewSellPlayerMagicList(Player: TPlayObject);
var
  I: Integer;
  sSendMsg: AnsiString;
  UserMagic: pTUserMagic;
  ClientMagic: pTClientMagic;
  InBuf: PAnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
  nC: Integer;
begin
  nC := 0;
  sSendMsg := '';
  if Player.m_MagicList.Count > 0 then
  begin
    InBytes := Player.m_MagicList.Count * SizeOf(TClientMagic);
    GetMem(InBuf, InBytes + 1);
    try
      Buffer := InBuf;
      for I := 0 to Player.m_MagicList.Count - 1 do
      begin
        Inc(nC);
        UserMagic := Player.m_MagicList.Items[I];
        ClientMagic := pTClientMagic(Buffer);
        UserMagicToClientMagic(UserMagic, ClientMagic);
        ClientMagic.dwInterval := 0;
        ClientMagic.dwRealInterval := ClientMagic.dwInterval;
        Buffer := Buffer + SizeOf(TClientMagic);
      end;
      sSendMsg := zLibCompressBuffer(InBuf, InBytes);
    finally
      FreeMem(InBuf);
    end;
  end;
  m_DefMsg := MakeDefaultMsg(SM_VIEW_SELL_PLAYER_INFO_MAGICLIST, 0, Length(sSendMsg), 0, nC);
  SendSocket(@m_DefMsg, sSendMsg);
end;

procedure TPlayObject.SendViewSellPlayerGamePetList(Player: TPlayObject);
var
  I: Integer;
  sSendMsg: AnsiString;
  GamePetData: pTGamePetData;
  ClientGamePetData: pTClientGamePetData;
  InBuf: array [0 .. 102400] of AnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
begin
  sSendMsg := '';
  if Player.m_GamePetList.Count > 0 then
  begin
    InBytes := Player.m_GamePetList.Count * SizeOf(TClientGamePetData);
    Buffer := @InBuf;
    for I := 0 to Player.m_GamePetList.Count - 1 do
    begin
      GamePetData := Player.m_GamePetList.Items[I];
      ClientGamePetData := pTClientGamePetData(Buffer);
      ClientGamePetData.sName := GamePetData.sName;
      ClientGamePetData.GamePetAbility.Level := GamePetData.Level;
      ClientGamePetData.GamePetAbility.Exp := GamePetData.Exp;
      Move(GamePetData.wMagics, ClientGamePetData.wMagics, SizeOf(GamePetData.wMagics));
      RecallGamePetAbil(ClientGamePetData);
      if GamePetData.HP > ClientGamePetData.GamePetAbility.MaxHP then
        ClientGamePetData.GamePetAbility.HP := ClientGamePetData.GamePetAbility.MaxHP
      else
        ClientGamePetData.GamePetAbility.HP := GamePetData.HP;
      if GamePetData.MP > ClientGamePetData.GamePetAbility.MaxMP then
        ClientGamePetData.GamePetAbility.MP := ClientGamePetData.GamePetAbility.MaxMP
      else
        ClientGamePetData.GamePetAbility.MP := GamePetData.MP;
      Buffer := Buffer + SizeOf(TClientGamePetData);
    end;
    sSendMsg := zLibCompressBuffer(@InBuf, InBytes);
  end;
  m_DefMsg := MakeDefaultMsg(SM_VIEW_SELL_PLAYER_GAMEPET_LIST, 0, Length(sSendMsg), 0, Player.m_GamePetList.Count);
  SendSocket(@m_DefMsg, sSendMsg);
end;

