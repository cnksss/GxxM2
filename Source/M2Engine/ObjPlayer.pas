function TPlayObject.CheckItemBindUse(UserItem: pTUserItem): Boolean;
var
  I: Integer;
  ItemBind: pTItemBind;
begin
  Result := True;
  g_ItemBindAccount.Lock;
  try
    for I := 0 to g_ItemBindAccount.Count - 1 do
    begin
      ItemBind := g_ItemBindAccount.Items[I];
      if ItemBind <> nil then
      begin
        if (ItemBind.nMakeIdex = UserItem.MakeIndex) and (ItemBind.nItemIdx = UserItem.wIndex) then
        begin
          Result := False;
          if CompareText(ItemBind.sBindName, m_sUserID) = 0 then
            Result := True
          else
            SysMsg(g_sItemIsNotThisAccount, c_Red, t_Hint);

          Exit;
        end;
      end;
    end;
  finally
    g_ItemBindAccount.UnLock;
  end;

  g_ItemBindIPaddr.Lock;
  try
    for I := 0 to g_ItemBindIPaddr.Count - 1 do
    begin
      ItemBind := g_ItemBindIPaddr.Items[I];
      if ItemBind <> nil then
      begin
        if (ItemBind.nMakeIdex = UserItem.MakeIndex) and (ItemBind.nItemIdx = UserItem.wIndex) then
        begin
          Result := False;
          if CompareText(ItemBind.sBindName, m_sIPaddr) = 0 then
            Result := True
          else
            SysMsg(g_sItemIsNotThisIPaddr, c_Red, t_Hint);

          Exit;
        end;
      end;
    end;
  finally
    g_ItemBindIPaddr.UnLock;
  end;

  g_ItemBindCharName.Lock;
  try
    for I := 0 to g_ItemBindCharName.Count - 1 do
    begin
      ItemBind := g_ItemBindCharName.Items[I];
      if ItemBind <> nil then
      begin
        if (ItemBind.nMakeIdex = UserItem.MakeIndex) and (ItemBind.nItemIdx = UserItem.wIndex) then
        begin
          Result := False;
          if CompareText(ItemBind.sBindName, m_sCharName) = 0 then
            Result := True
          else
            SysMsg(g_sItemIsNotThisCharName, c_Red, t_Hint);

          Break;
        end;
      end;
    end;
  finally
    g_ItemBindCharName.UnLock;
  end;
end;

procedure TPlayObject.ScatterBagItems(ItemOfCreat: TBaseObject; KillMe: TBaseObject);
var
  I, DropWide, nRate, nDelCount: Integer;
  pu: pTUserItem;
  boDropall: Boolean;
  StdItem: pTStdItem;
  DelItems: string;
  IsDeleted: Boolean;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.ScatterBagItems';
begin
  if m_PEnvir.m_boNODROPITEM then
    Exit; // 地图禁止死亡掉物品 piaoyun 2013-07-25

  if m_boAngryRing or m_boNODROPITEM or (m_boDummyObject and (not m_boDropBagItem)) or
    (m_Abil.Level < g_Config.nScatterBagItemsMinLevel) then
    Exit; // 不死戒指

  DelItems := '';
  nDelCount := 0;
  boDropall := False;
  DropWide := 2;
  if g_Config.boDieRedScatterBagAll and (PKLevel >= 2) then
    boDropall := True;

  // 增加爆率
  nRate := g_Config.nDieScatterBagRate { 3 };
  if (m_CurrTarget <> nil) and (m_CurrTarget.m_WAbil.NewValue[6] > 0) then
    nRate := Max(nRate - nRate * m_CurrTarget.m_WAbil.NewValue[6] div 100, 0);

  IsDeleted := False;
  // 非红名掉1/3 //红名全掉
  try
    { -ochongchong -c新增 : 物品规则 - 死亡消失【2013-07-27】 }
    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      if (m_UseItems[I].wIndex > 0) and g_ItemRules.Get(m_UseItems[I].wIndex, 18) then
      begin
        { -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
        StdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
        if StdItem = nil then
          Continue;

        if (m_UseItems[I].btValue[13] = 1) and (m_UseItems[I].Name <> '') then
          DelItems := DelItems + Format('%s/%d/', [m_UseItems[I].Name, m_UseItems[I].MakeIndex])
        else
          DelItems := DelItems + Format('%s/%d/', [StdItem.Name, m_UseItems[I].MakeIndex]);

        IsDeleted := True;
        m_UseItems[I].wIndex := 0;
        ProcessUseItemSkill(I, StdItem, False);

        if StdItem.NeedIdentify = 1 then
          AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[I].MakeIndex, '0', StdItem.Reserved, 0,
            '死亡消失-装备物品');
      end;
    end;

    if IsDeleted then
      RecalcAbilitys;

    for I := m_ItemList.Count - 1 downto 0 do
    begin
      pu := m_ItemList.Items[I];

      if g_ItemRules.Get(pu.wIndex, 18) then
      begin
        StdItem := UserEngine.GetStdItem(pu.wIndex);
        if StdItem = nil then
          Continue;

        if (pu.btValue[13] = 1) and (pu.Name <> '') then
          DelItems := DelItems + Format('%s/%d/', [pu.Name, pu.MakeIndex])
        else
          DelItems := DelItems + Format('%s/%d/', [StdItem.Name, pu.MakeIndex]);

        if StdItem.NeedIdentify = 1 then
          AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, pu.MakeIndex, '0', StdItem.Reserved, 0,
            '死亡消失-背包物品');

        m_ItemList.Delete(I);
        Dispose(pu);
      end;
    end;

    for I := m_ItemList.Count - 1 downto 0 do
    begin
      if m_ItemList.Count <= 0 then
        Break;

      pu := pTUserItem(m_ItemList[I]);
      StdItem := UserEngine.GetStdItem(pu.wIndex);
      if StdItem = nil then
        Continue;

      if (GetUserItemBindValue(pu, ubNoScatter) and pu.boIsBind) or g_ItemRules.Get(pu.wIndex, 13) then
        Continue; // 禁止爆出

      // 防暴几率 chongchong 2015-04-16
      if Random(100) < pu.btNewValue[12] then
        Continue;

      if boDropall or (Random(nRate { 3 } ) = 0) or g_ItemRules.Get(pu.wIndex, 6) then
      begin
        if pu <> nil then
        begin
          if pu.wInsuranceCount > 0 then
          begin
            Dec(pu.wInsuranceCount);
            SendUpdateItemInsuranceCount(-1, pu.MakeIndex, False, pu.wInsuranceCount);
            m_sDropInsuranceItemName := StdItem.Name;
            m_nDropInsuranceItemCount := pu.wInsuranceCount;
            m_nDropInsuranceItemCurrency := StdItem.InsuranceCurrency;
            m_nDropInsuranceItemGold := StdItem.InsuranceGold;
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@DropInsuranceItem', False);
            Continue;
          end;

          if DropItemDown(pu, DropWide, True, ItemOfCreat, Self) then
          begin
            { -oCursor -c新增 : 角色死亡掉落触发 }
            if g_ItemRules.Get(pu.wIndex, 39) then
            begin
              m_sCurrentOperateUserName := m_sCharName;
              m_sCurrentItemName := ProcessItemName(StdItem.Name);
              try
                g_FunctionNPC.GotoLable(Self, '@HumDropItem', False);
              finally
                m_sCurrentOperateUserName := EmptyStr;
                m_sCurrentItemName := EmptyStr;
              end;
            end;

            if (pu.btValue[13] = 1) and (pu.Name <> '') then
              DelItems := DelItems + Format('%s/%d/', [pu.Name, pu.MakeIndex])
            else
              DelItems := DelItems + Format('%s/%d/', [StdItem.Name, pu.MakeIndex]);
            Inc(nDelCount);

            m_ItemList.Delete(I);
            Dispose(pu);
          end;
        end;
      end;
    end;

    if DelItems <> '' then
      SendMsg(Self, RM_SENDDELITEMLIST, 0, nDelCount, 0, 0, DelItems);
  except
    MainOutMessage(sExceptionMsg);
  end;
end;

procedure TPlayObject.RecallHuman(sHumName: string);
var
  PlayObject: TPlayObject;
  nX, nY, n18, n1C: Integer;
begin
  PlayObject := UserEngine.GetPlayObject(sHumName);
  if PlayObject <> nil then
  begin
    if not PlayObject.m_boDeath then
    begin
      GetFrontPosition(nX, nY);
      if sub_4C5370(nX, nY, 3, n18, n1C) then
      begin
        PlayObject.SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');
        PlayObject.SpaceMove(m_sMapName, n18, n1C, 0);
      end;
    end
    else
      SysMsg('召唤失败！', c_Red, t_Hint);
  end
  else
    SysMsg(Format(g_sNowNotOnLineOrOnOtherServer, [sHumName]), c_Red, t_Hint);
end;

function TPlayObject.ReQuestGuildWar(sGuildName: string): Boolean;
var
  Guild: TGUild;
  WarGuild: pTWarGuild;
begin
  Result := False;

  if nServerIndex <> 0 then
  begin
    SysMsg('这个命令不能在本服务器上使用！', c_Red, t_Hint);
    Exit;
  end;

  if not IsGuildMaster then
  begin
    SysMsg(Format('你不是掌门人，不能对行会[%s]宣战！', [sGuildName]), c_Red, t_Hint);
    Exit;
  end;

  Guild := g_GuildManager.FindGuild(sGuildName);
  if Guild = nil then
  begin
    SysMsg(Format('宣战目标行会[%s]并不存在！', [sGuildName]), c_Red, t_Hint);
    Exit;
  end;

  if (m_MyGuild <> nil) and SameText(TGUild(m_MyGuild).sGuildName, sGuildName) then
  begin
    SysMsg('你不能对自己的行会宣战！', c_Red, t_Hint);
    Exit;
  end;

  WarGuild := TGUild(m_MyGuild).AddWarGuild(Guild);
  if WarGuild <> nil then
  begin
    if Guild.AddWarGuild(TGUild(m_MyGuild)) = nil then
      WarGuild.dwWarTick := 0;
    Result := True;
  end;
end;

function TPlayObject.CheckDenyLogon(): Boolean;
begin
  Result := False;

  if GetDenyIPaddrList(m_sIPaddr) or GetDenyIPLocalList(m_sIPLocal) then
  begin
    SysMsg(g_sYourIPaddrDenyLogon, c_Red, t_Hint);
    Result := True;
  end
  else if GetDenyMachineIDList(m_sMachineID) then
  begin
    SysMsg(g_sYourMachineIDDenyLogon, c_Red, t_Hint);
    Result := True;
  end
  else if GetDenyAccountList(m_sUserID) then
  begin
    SysMsg(g_sYourAccountDenyLogon, c_Red, t_Hint);
    Result := True;
  end
  else if GetDenyChrNameList(m_sCharName) then
  begin
    SysMsg(g_sYourCharNameDenyLogon, c_Red, t_Hint);
    Result := True;
  end;

  if Result then
    m_boEmergencyClose := True;
end;

