                m_sCurrentOperateUserName := EmptyStr;
                m_sCurrentItemName := EmptyStr;
              end;
            end;

            Inc(nDropUseItemsMaxCount);
            if (m_JewelryBoxItems[I].btValue[13] = 1) and (m_JewelryBoxItems[I].Name <> '') then
              DelItems := DelItems + Format('%s/%d/', [m_JewelryBoxItems[I].Name, m_JewelryBoxItems[I].MakeIndex])
            else
              DelItems := DelItems + Format('%s/%d/', [StdItem.Name, m_JewelryBoxItems[I].MakeIndex]);

            m_JewelryBoxItems[I].wIndex := 0;
            ProcessUseItemSkill(U_JEWELRYITEM1 + I, StdItem, False);
            Inc(nDelCount);
            if StdItem.NeedIdentify = 1 then
              AddGameDataLog(LOG_ItemFall, LOG_ActionNone, Self, StdItem.Name, m_JewelryBoxItems[I].MakeIndex, '0', 0,
                StdItem.Reserved, '首饰盒');

            if (DropUserItem.btValue[13] = 1) and (DropUserItem.Name <> '') then
              sUserItemName := DropUserItem.Name
            else
              sUserItemName := StdItem.Name;

            m_nCurrentItemMakeIndex := DropUserItem.MakeIndex;
            m_nCurrentItemPos := U_JEWELRYITEM1 + I;
            m_sCurrentItemName := StdItem.Name;
            m_sCurrentItemNewName := sUserItemName;
            m_PickUpOrDropItem := DropUserItem;
            g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(U_JEWELRYITEM1 + I), False);
            g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
          end;
        end;
      end;
    end;

    if DelItems <> '' then
      SendMsg(Self, RM_SENDDELITEMLIST, 0, nDelCount, 0, 0, DelItems);
  except
    MainOutMessage(sExceptionMsg);
  end;
end;

procedure TPlayObject.DropGodBlessItems(BaseObject: TBaseObject);
var
  I: Integer;
  nRate, nNewRate, nDropUseItemsMaxCount, nDelCount: Integer;
  StdItem: pTStdItem;
  DelItems, sUserItemName: string;
  Castle: TUserCastle; // 攻城区域
  DropUserItem: TUserItem;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.DropUseItems';
begin
  DelItems := '';
  nDelCount := 0;
  try
    if m_PEnvir.m_boNODROPITEM and (m_btRaceServer = RC_PLAYOBJECT) then
      Exit; // 地图禁止死亡掉物品 piaoyun 2013-07-25

    if m_boAngryRing or m_boNoDropUseItem or m_PEnvir.m_boNODROPUSEITEMS or (m_boDummyObject and (not m_boDropUseItem)) or
      (m_btRaceServer <> RC_PLAYOBJECT) then
      Exit;

    // 攻城区域不掉装备 piaoyun 2013-07-25
    if g_Config.boWarNoDropUseItem and (m_btRaceServer = RC_PLAYOBJECT) then
    begin
      // 检测攻城区域
      Castle := g_CastleManager.InCastleWarArea(Self);
      if (Castle <> nil) and Castle.m_boUnderWar { 攻城 } then
        Exit;
    end;

    for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
    begin
      StdItem := UserEngine.GetStdItem(m_GodBlessItems[I].wIndex);

      { 当仅reserved值为 8 时，死亡时装备消失 }
      if (m_GodBlessItems[I].wIndex > 0) and (StdItem <> nil) then
      begin
        if StdItem.Reserved and 8 <> 0 then
        begin
          DropUserItem := m_GodBlessItems[I];
          if (m_GodBlessItems[I].btValue[13] = 1) and (m_GodBlessItems[I].Name <> '') then
            DelItems := DelItems + Format('%s/%d/', [m_GodBlessItems[I].Name, m_GodBlessItems[I].MakeIndex])
          else
            DelItems := DelItems + Format('%s/%d/', [StdItem.Name, m_GodBlessItems[I].MakeIndex]);

          if StdItem.NeedIdentify = 1 then
            AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_GodBlessItems[I].MakeIndex, '0', 0,
              StdItem.Reserved, '掉落-Reserved');

          m_GodBlessItems[I].wIndex := 0;
          ProcessUseItemSkill(U_GODBLESSITEM1 + I, StdItem, False);
          Inc(nDelCount);
          if (DropUserItem.btValue[13] = 1) and (DropUserItem.Name <> '') then
            sUserItemName := DropUserItem.Name
          else
            sUserItemName := StdItem.Name;

          m_nCurrentItemMakeIndex := DropUserItem.MakeIndex;
          m_nCurrentItemPos := U_GODBLESSITEM1 + I;
          m_sCurrentItemName := StdItem.Name;
          m_sCurrentItemNewName := sUserItemName;
          m_PickUpOrDropItem := DropUserItem;
          g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(U_GODBLESSITEM1 + I), False);
          g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
          m_PickUpOrDropItem.MakeIndex := 0;
          m_PickUpOrDropItem.wIndex := 0;
          m_nCurrentItemMakeIndex := 0;
          m_nCurrentItemPos := 0;
          m_sCurrentItemName := '';
          m_sCurrentItemNewName := '';
        end;
      end;
    end;

    if m_boDummyObject then
      nRate := m_nDieDropUseItemRate
    else
    begin
      if PKLevel > 2 then
        nRate := g_Config.nDieRedDropUseItemRate { 15 }
      else
        nRate := g_Config.nDropGodBlessItemRate { 30 };
    end;

    // 增加爆率
    if (not g_Config.boDropUseItem) and (m_CurrTarget <> nil) and (m_CurrTarget.m_WAbil.NewValue[6] > 0) then
      nRate := Max(nRate - nRate * m_CurrTarget.m_WAbil.NewValue[6] div 100, 0);

    nDropUseItemsMaxCount := 0;
    for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
    begin
      StdItem := UserEngine.GetStdItem(m_GodBlessItems[I].wIndex);
      if StdItem = nil then
        Continue;

      if (GetUserItemBindValue(@m_GodBlessItems[I], ubNoScatter) and m_GodBlessItems[I].boIsBind) or
        g_ItemRules.Get(m_GodBlessItems[I].wIndex, 13) then
        Continue; // 禁止爆出

      if g_ItemRules.Get(m_GodBlessItems[I].wIndex, 6) then
      begin
        if DropItemDown(@m_GodBlessItems[I], 2, True, BaseObject, Self) then
        begin
          DropUserItem := m_GodBlessItems[I];
          Inc(nDropUseItemsMaxCount);
          StdItem := UserEngine.GetStdItem(m_GodBlessItems[I].wIndex);
          if StdItem <> nil then
          begin
            if (StdItem.Reserved and 10 = 0) then
            begin
              { -oCursor -c新增 : 角色死亡掉落触发 }
              if g_ItemRules.Get(DropUserItem.wIndex, 39) then
              begin
                m_sCurrentOperateUserName := m_sCharName;
                m_sCurrentItemName := ProcessItemName(StdItem.Name);
                try
                  g_FunctionNPC.GotoLable(Self, '@HumDropItem', False);
                finally
                  m_sCurrentOperateUserName := EmptyStr;
                  m_sCurrentItemName := EmptyStr;
                end;
              end;

              if (m_GodBlessItems[I].btValue[13] = 1) and (m_GodBlessItems[I].Name <> '') then
                DelItems := DelItems + Format('%s/%d/', [m_GodBlessItems[I].Name, m_GodBlessItems[I].MakeIndex])
              else
                DelItems := DelItems + Format('%s/%d/', [StdItem.Name, m_GodBlessItems[I].MakeIndex]);

              m_GodBlessItems[I].wIndex := 0;
              ProcessUseItemSkill(U_GODBLESSITEM1 + I, StdItem, False);
              Inc(nDelCount);
            end;

            if (DropUserItem.btValue[13] = 1) and (DropUserItem.Name <> '') then
              sUserItemName := DropUserItem.Name
            else
              sUserItemName := StdItem.Name;

            m_nCurrentItemMakeIndex := DropUserItem.MakeIndex;
            m_nCurrentItemPos := U_GODBLESSITEM1 + I;
            m_sCurrentItemName := StdItem.Name;
            m_sCurrentItemNewName := sUserItemName;
            m_PickUpOrDropItem := DropUserItem;
            g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(U_GODBLESSITEM1 + I), False);
            g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
          end;
        end;
        Continue;
      end;

      // 防暴几率 chongchong 2015-04-16
      if Random(100) < m_GodBlessItems[I].btNewValue[12] then
        Continue;

      if g_Config.boDropUseItem then
      begin
        if PKLevel > 2 then
          nNewRate := Round(g_Config.DieDropUseItemRates[I] / (g_Config.nDieRedDropUseItemOneRate / 10))
        else
          nNewRate := g_Config.DieDropUseItemRates[I];

        // 增加爆率
        nNewRate := nNewRate + nRate;
        if (m_CurrTarget <> nil) and (m_CurrTarget.m_WAbil.NewValue[6] > 0) then
          nNewRate := Max(nNewRate - nNewRate * m_CurrTarget.m_WAbil.NewValue[6] div 100, 0);

        if (Random(nNewRate) <> 0) then
          Continue;
      end
      else if (Random(nRate) <> 0) then
        Continue;

      if InDisableTakeOffList(m_GodBlessItems[I].wIndex) or (GetUserItemBindValue(@m_GodBlessItems[I], ubNoTakeOff) and
        m_GodBlessItems[I].boIsBind) then
        Continue; // 检查是否在禁止取下列表,如果在列表中则不掉此物品

      if m_PEnvir.m_boDELDROPITEM then
      begin
        StdItem := UserEngine.GetStdItem(m_GodBlessItems[I].wIndex);
        if StdItem <> nil then
        begin
          if (StdItem.Reserved and 10 = 0) then
          begin
            DropUserItem := m_GodBlessItems[I];
            DelItems := DelItems + Format('%s/%d/', [StdItem.Name, m_GodBlessItems[I].MakeIndex]);
            m_GodBlessItems[I].wIndex := 0;
            ProcessUseItemSkill(U_GODBLESSITEM1 + I, StdItem, False);

            Inc(nDelCount);
            if (DropUserItem.btValue[13] = 1) and (DropUserItem.Name <> '') then
              sUserItemName := DropUserItem.Name
            else
              sUserItemName := StdItem.Name;

            m_nCurrentItemMakeIndex := DropUserItem.MakeIndex;
            m_nCurrentItemPos := U_GODBLESSITEM1 + I;
            m_sCurrentItemName := StdItem.Name;
            m_sCurrentItemNewName := sUserItemName;
            m_PickUpOrDropItem := DropUserItem;
            g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(U_GODBLESSITEM1 + I), False);
            g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
          end;
        end;
      end
      else
      begin
        if (PKLevel <= 2) and (nDropUseItemsMaxCount >= g_Config.nDropUseItemsMaxCount) then
          Continue; // 控制非红名人物死亡时最多掉落几件身上物品

        if m_GodBlessItems[I].wInsuranceCount > 0 then
        begin
          Inc(nDropUseItemsMaxCount);
          Dec(m_GodBlessItems[I].wInsuranceCount);
          SendUpdateItemInsuranceCount(U_GODBLESSITEM1 + I, m_GodBlessItems[I].MakeIndex, False,
            m_GodBlessItems[I].wInsuranceCount);
          m_sDropInsuranceItemName := StdItem.Name;
          m_nDropInsuranceItemCount := m_GodBlessItems[I].wInsuranceCount;
          m_nDropInsuranceItemCurrency := StdItem.InsuranceCurrency;
          m_nDropInsuranceItemGold := StdItem.InsuranceGold;

          if (g_FunctionNPC <> nil) then
          begin
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@DropInsuranceItem', False);
          end;
          Continue;
        end;

        if DropItemDown(@m_GodBlessItems[I], 2, True, BaseObject, Self) then
        begin
          DropUserItem := m_GodBlessItems[I];
          Inc(nDropUseItemsMaxCount);
          StdItem := UserEngine.GetStdItem(m_GodBlessItems[I].wIndex);
          if StdItem <> nil then
          begin
            { -oCursor -c新增 : 角色死亡掉落触发 }
            if g_ItemRules.Get(DropUserItem.wIndex, 39) then
            begin
              m_sCurrentOperateUserName := m_sCharName;
              m_sCurrentItemName := ProcessItemName(StdItem.Name);
              try
                g_FunctionNPC.GotoLable(Self, '@HumDropItem', False);
              finally
                m_sCurrentOperateUserName := EmptyStr;
                m_sCurrentItemName := EmptyStr;
              end;
            end;

            if (StdItem.Reserved and 10 = 0) then
            begin
              if (m_GodBlessItems[I].btValue[13] = 1) and (m_GodBlessItems[I].Name <> '') then
                DelItems := DelItems + Format('%s/%d/', [m_GodBlessItems[I].Name, m_GodBlessItems[I].MakeIndex])
              else
                DelItems := DelItems + Format('%s/%d/', [StdItem.Name, m_GodBlessItems[I].MakeIndex]);

              m_GodBlessItems[I].wIndex := 0;
              ProcessUseItemSkill(U_GODBLESSITEM1 + I, StdItem, False);
              Inc(nDelCount);
            end;

            if (DropUserItem.btValue[13] = 1) and (DropUserItem.Name <> '') then
              sUserItemName := DropUserItem.Name
            else
              sUserItemName := StdItem.Name;

            m_nCurrentItemMakeIndex := DropUserItem.MakeIndex;
            m_nCurrentItemPos := U_GODBLESSITEM1 + I;
            m_sCurrentItemName := StdItem.Name;
            m_sCurrentItemNewName := sUserItemName;
            m_PickUpOrDropItem := DropUserItem;
            g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(U_GODBLESSITEM1 + I), False);
            g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
          end;
        end;
      end;
    end;

    if DelItems <> '' then
      SendMsg(Self, RM_SENDDELITEMLIST, 0, nDelCount, 0, 0, DelItems);
  except
    MainOutMessage(sExceptionMsg);
  end;
end;

{ TODO -ochongchong -c修改 : 组队成员不在同一地图或屏幕可分享经验 【2013-08-17】 }
procedure TPlayObject.GainExp(dwExp: LongWord);
var
  I, n, sumlv: Integer;
  PlayObject: TPlayObject;
  nCheckCode: Integer;
  PlayerList: TList;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.GainExp';
const
  bonus: array [0 .. MAX_BONUS_VALUE] of real = (1, 1.2, 1.3, 1.4, 1.5, 1.6, 1.7, 1.8, 1.9, 2, 2.1, 2.2);
begin
  nCheckCode := 0;
  n := 0;
  sumlv := 0;
  try
    if dwExp > 0 then
    begin
      if (m_GroupOwner <> nil) and (m_GroupOwner.m_GroupMembers <> nil) then
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          m_GroupOwner.m_GroupMembers.LockR(30);
        try
{$IFEND}
          if (m_GroupOwner.m_GroupMembers.Count > 0) then
          begin
            sumlv := 0;
            n := 0;
            nCheckCode := 1;
            for I := 0 to m_GroupOwner.m_GroupMembers.Count - 1 do
            begin
              PlayObject := TPlayObject(m_GroupOwner.m_GroupMembers.Objects[I]);
              if PlayObject <> nil then
              begin
                if (not PlayObject.m_boDeath) //
                  and ((m_PEnvir = PlayObject.m_PEnvir) or g_Config.boShareExpGroupSameMap) //
                  and (((abs(m_nCurrX - PlayObject.m_nCurrX) <= m_nViewRange) // -
                  and (abs(m_nCurrY - PlayObject.m_nCurrY) <= m_nViewRange)) // -
                  or g_Config.boShareExpGroupSameScreen) then
                begin
                  sumlv := sumlv + PlayObject.m_Abil.Level;
                  Inc(n);
                end;
              end;
            end;
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            m_GroupOwner.m_GroupMembers.UnLockR;
        end;
{$IFEND}
        nCheckCode := 2;
        if (sumlv > 0) and (n > 1) then
        begin
          if n in [0 .. MAX_BONUS_VALUE] then
            dwExp := Round(dwExp * bonus[n]);

          nCheckCode := 3;
          PlayerList := TList.Create;
          try
{$IF MULTI_THREAD = 1}
            if g_MultiThreadRun then
              m_GroupOwner.m_GroupMembers.LockR(31);
            try
{$IFEND}
              for I := 0 to m_GroupOwner.m_GroupMembers.Count - 1 do
              begin
                PlayObject := TPlayObject(m_GroupOwner.m_GroupMembers.Objects[I]);
                if PlayObject <> nil then
                begin
                  if (not PlayObject.m_boDeath) //
                    and ((m_PEnvir = PlayObject.m_PEnvir) or g_Config.boShareExpGroupSameMap) //
                    and (((abs(m_nCurrX - PlayObject.m_nCurrX) <= m_nViewRange) // -
                    and (abs(m_nCurrY - PlayObject.m_nCurrY) <= m_nViewRange)) // -
                    or g_Config.boShareExpGroupSameScreen) then
                    PlayerList.Add(PlayObject);
                end;
              end;
{$IF MULTI_THREAD = 1}
            finally
              if g_MultiThreadRun then
                m_GroupOwner.m_GroupMembers.UnLockR;
            end;
{$IFEND}
            for I := 0 to PlayerList.Count - 1 do
            begin
              PlayObject := PlayerList.Items[I];
              if g_Config.boHighLevelKillMonFixExp and g_Config.boHighLevelGroupFixExp then
              begin // 02/08 增加，在高等级经验不变时，把组队的经验平均分配
                nCheckCode := 4;
                PlayObject.WinExp(Round(dwExp / n));
                nCheckCode := 5;
              end
              else
              begin
                nCheckCode := 6;
                PlayObject.WinExp(Round(dwExp / sumlv * PlayObject.m_Abil.Level));
                nCheckCode := 7;
              end;
            end;
          finally
            PlayerList.Free;
          end;
        end
        else
          WinExp(dwExp);
      end
      else
        WinExp(dwExp);
    end;
  except
    MainOutMessage(sExceptionMsg + ' ' + IntToStr(nCheckCode));
  end;
end;

