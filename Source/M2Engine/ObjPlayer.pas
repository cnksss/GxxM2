procedure TPlayObject.ClientHeroTakeOnItems(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 英雄穿装备
var
  I, n14, n18: Integer;
  UserItem, TakeOffItem: pTUserItem;
  TakeOffItemEx: TUserItem;
  StdItem, StdItem20: pTStdItem;
  StdItem58: TStdItem;
  sUserItemName: string;
  HeroObject: THeroObject;
  btWhere: Byte;
  nMakeIndex: Integer;
  sItemName: string;
  OldValue: Integer;
label
  FailExit;
  procedure DoExit();
  begin
    if n18 <= 0 then
    begin
      if n18 = -99 then
      begin
        try
          HeroObject.DelBagItem(n14);
          HeroObject.SendDelItem(UserItem);
          HeroObject.RecalcAbilitys();
          HeroObject.SendMsg(HeroObject, RM_ABILITY, 0, 0, 0, 0, '');
          HeroObject.SendMsg(HeroObject, RM_SUBABILITY, 0, 0, 0, 0, '');
          HeroObject.SendMsg(HeroObject, RM_DURACHANGE, btWhere, HeroObject.m_UseItems[btWhere].Dura,
            HeroObject.m_UseItems[btWhere].DuraMax, 0, '');
          if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
          begin
            AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, HeroObject, StdItem.Name, UserItem.MakeIndex, '0', 0, 0,
              '物品使用->' + StdItem20.Name);
          end;
        except
          MainOutMessage('[Exception] TPlayObject:ClientTakeOnItems.DoExit()');
        end;
      end;
      SendDefMessage(SM_HEROTAKEON_FAIL, n18, 0, 0, 0, '');
    end;
  end;

begin
  if m_MyHero = nil then
    Exit;
  StdItem := nil;
  UserItem := nil;
  n14 := -1;
  btWhere := ProcessMsg.nParam2;
  nMakeIndex := ProcessMsg.nParam1;
  sItemName := ProcessMsg.sMsg;
  HeroObject := THeroObject(m_MyHero);
  for I := 0 to HeroObject.m_ItemList.Count - 1 do
  begin
    UserItem := HeroObject.m_ItemList.Items[I];
    if (UserItem <> nil) and (UserItem.MakeIndex = nMakeIndex) then
    begin
      // 取自定义物品名称
      if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
        sUserItemName := UserItem.Name
      else
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem <> nil then
      begin
        if CompareText(sUserItemName, sItemName) = 0 then
        begin
          n14 := I;
          Break;
        end;
      end;
    end;
    UserItem := nil;
  end;
  n18 := 0;
  if (StdItem <> nil) and (UserItem <> nil) then
  begin
    if CheckUserItems(btWhere, StdItem) and ((StdItem.Overlap = 0) or (StdItem.Overlap and 1 <> 0)) then
    begin
      StdItem58 := StdItem^;
      ItemUnit.GetItemAddValue(UserItem, StdItem58);
      if HeroObject.CheckTakeOnItems(btWhere, @StdItem58) and HeroObject.CheckItemBindUse(UserItem) then
      begin
        TakeOffItem := nil;
        if btWhere in [Low(THumanUseItems) .. High(THumanUseItems)] then
        begin
          if g_ItemRules.Get(UserItem.wIndex, 7) then
          begin
            SysMsg('物品禁止英雄使用', c_Red, t_Hint);
            goto FailExit;
          end;
          if HeroObject.m_UseItems[btWhere].wIndex > 0 then
          begin
            StdItem20 := UserEngine.GetStdItem(HeroObject.m_UseItems[btWhere].wIndex);
            if (StdItem20 <> nil) and (StdItem20.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) then
            begin
              if (not HeroObject.m_boUserUnLockDurg) and (HeroObject.m_UseItems[btWhere].btValue[7] <> 0) then
              begin
                HeroObject.SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
                n18 := -4;
                goto FailExit;
              end;
            end;
            if not HeroObject.m_boUserUnLockDurg and (StdItem20 <> nil) and ((StdItem20.Reserved and 2) <> 0) then
            begin
              HeroObject.SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
              n18 := -4;
              goto FailExit;
            end; // 004DAE78
            if (StdItem20 <> nil) and ((StdItem20.Reserved and 4) <> 0) then
            begin
              HeroObject.SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
              n18 := -4;
              goto FailExit;
            end;
            if InDisableTakeOffList(HeroObject.m_UseItems[btWhere].wIndex) or
              (GetUserItemBindValue(@HeroObject.m_UseItems[btWhere], ubNoTakeOff) and HeroObject.m_UseItems[btWhere].boIsBind)
            then
            begin
              HeroObject.SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
              goto FailExit;
            end;
            if (HeroObject.m_UseItems[btWhere].btValue[13] = 1) and (HeroObject.m_UseItems[btWhere].Name <> '') then
              sUserItemName := HeroObject.m_UseItems[btWhere].Name
            else
              sUserItemName := UserEngine.GetStdItemName(HeroObject.m_UseItems[btWhere].wIndex);
            HeroObject.m_nCurrentItemMakeIndex := HeroObject.m_UseItems[btWhere].MakeIndex;
            HeroObject.m_nCurrentItemPos := btWhere;
            HeroObject.m_sCurrentItemName := UserEngine.GetStdItemName(HeroObject.m_UseItems[btWhere].wIndex);
            HeroObject.m_sCurrentItemNewName := sUserItemName;
            HeroObject.m_PickUpOrDropItem := HeroObject.m_UseItems[btWhere];
            HeroObject.m_boStopTakeOff := False;
            g_FunctionNPC.GotoLable(Self, '@HeroBeginTakeOff', False);
            HeroObject.m_PickUpOrDropItem.MakeIndex := 0;
            HeroObject.m_PickUpOrDropItem.wIndex := 0;
            HeroObject.m_nCurrentItemMakeIndex := 0;
            HeroObject.m_nCurrentItemPos := 0;
            HeroObject.m_sCurrentItemName := '';
            HeroObject.m_sCurrentItemNewName := '';
            if HeroObject.m_boStopTakeOff then
              goto FailExit;
            // 处理53类宝石 piaoyun 2013-08-26
            if (StdItem20 <> nil) and (StdItem20.StdMode = 53) then
            begin
              case StdItem20.AniCount of
                1:
                  begin
                    // 气血石
                    if (StdItem58.StdMode = 7) and (StdItem58.Shape in [1, 3]) then
                    begin
                      OldValue := HeroObject.m_UseItems[btWhere].Dura;
                      HeroObject.m_UseItems[btWhere].Dura := Min(HeroObject.m_UseItems[btWhere].Dura + UserItem.Dura,
                        HeroObject.m_UseItems[btWhere].DuraMax);
                      n18 := -99;
                      DoExit;
                      if (StdItem20.NeedIdentify = 1) then
                      begin
                        AddGameDataLog(LOG_ItemUpdate, LOG_ActionNone, HeroObject, StdItem20.Name,
                          HeroObject.m_UseItems[btWhere].MakeIndex, '0', HeroObject.m_UseItems[btWhere].Dura, OldValue,
                          '补充HP: +' + IntToStr(HeroObject.m_UseItems[btWhere].Dura - OldValue));
                      end;
                      Exit;
                    end
                    else if (StdItem58.StdMode = 7) and (StdItem58.Shape in [1, 2, 3]) then
                    begin
                      SysMsg(Format('当前放入宝石类型不匹配，补充[%s]持久失败', [StdItem20.DBName]), g_Config.btRedMsgFColor,
                        g_Config.btRedMsgBColor, t_Hint);
                      n18 := -98;
                      DoExit;
                      Exit;
                    end;
                  end;
                2:
                  begin
                    // 幻魔石
                    if (StdItem58.StdMode = 7) and (StdItem58.Shape in [2, 3]) then
                    begin
                      OldValue := HeroObject.m_UseItems[btWhere].Dura;
                      HeroObject.m_UseItems[btWhere].Dura := Min(HeroObject.m_UseItems[btWhere].Dura + UserItem.Dura,
                        HeroObject.m_UseItems[btWhere].DuraMax);
                      n18 := -99;
                      DoExit;
                      if (StdItem20.NeedIdentify = 1) then
                      begin
                        AddGameDataLog(LOG_ItemUpdate, LOG_ActionNone, HeroObject, StdItem20.Name,
                          HeroObject.m_UseItems[btWhere].MakeIndex, '0', HeroObject.m_UseItems[btWhere].Dura, OldValue,
                          '补充MP: +' + IntToStr(HeroObject.m_UseItems[btWhere].Dura - OldValue));
                      end;
                      Exit;
                    end
                    else if (StdItem58.StdMode = 7) and (StdItem58.Shape in [1, 2, 3]) then
                    begin
                      SysMsg(Format('当前放入宝石类型不匹配，补充[%s]持久失败', [StdItem20.DBName]), g_Config.btRedMsgFColor,
                        g_Config.btRedMsgBColor, t_Hint);
                      n18 := -98;
                      DoExit;
                      Exit;
                    end;
                  end;
                3:
                  begin
                    // 魔血石
                    if (StdItem58.StdMode = 7) and (StdItem58.Shape = 3) then
                    begin
                      OldValue := HeroObject.m_UseItems[btWhere].Dura;
                      HeroObject.m_UseItems[btWhere].Dura := Min(HeroObject.m_UseItems[btWhere].Dura + UserItem.Dura,
                        HeroObject.m_UseItems[btWhere].DuraMax);
                      n18 := -99;
                      DoExit;
                      if (StdItem20.NeedIdentify = 1) then
                      begin
                        AddGameDataLog(LOG_ItemUpdate, LOG_ActionNone, HeroObject, StdItem20.Name,
                          HeroObject.m_UseItems[btWhere].MakeIndex, '0', HeroObject.m_UseItems[btWhere].Dura, OldValue,
                          '补充HPMP: +' + IntToStr(HeroObject.m_UseItems[btWhere].Dura - OldValue));
                      end;
                      Exit;
                    end
                    else if (StdItem58.StdMode = 7) and (StdItem58.Shape in [1, 2, 3]) then
                    begin
                      SysMsg(Format('当前放入宝石类型不匹配，补充[%s]持久失败', [StdItem20.DBName]), g_Config.btRedMsgFColor,
                        g_Config.btRedMsgBColor, t_Hint);
                      n18 := -98;
                      DoExit;
                      Exit;
                    end;
                  end;
              end;
            end
            // 火龙补品 chongchong 2017-07-10
            else if StdItem58.StdMode = 97 then
            begin
              OldValue := HeroObject.m_UseItems[btWhere].Dura;
              if (StdItem20 <> nil) and (StdItem20.StdMode = 25) and (StdItem20.Shape = 9) then
              begin
                HeroObject.m_UseItems[btWhere].Dura := Min(HeroObject.m_UseItems[btWhere].Dura + UserItem.Dura,
                  HeroObject.m_UseItems[btWhere].DuraMax);
                n18 := -99;
              end
              else
              begin
                n18 := -98;
              end;
              DoExit;
              if n18 = -99 then
              begin
                if (StdItem20.NeedIdentify = 1) then
                begin
                  AddGameDataLog(LOG_ItemUpdate, LOG_ActionNone, HeroObject, StdItem20.Name,
                    HeroObject.m_UseItems[btWhere].MakeIndex, '0', HeroObject.m_UseItems[btWhere].Dura, OldValue,
                    '补充容量: +' + IntToStr(HeroObject.m_UseItems[btWhere].Dura - OldValue));
                end;
              end;
              Exit;
            end;
            if (StdItem <> nil) and (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) and
              HeroObject.m_boUserUnLockDurg and (HeroObject.m_UseItems[btWhere].btValue[7] <> 0) then
            begin // 使用过神水的神秘装备下次可以脱下来
              HeroObject.m_boUserUnLockDurg := False;
              HeroObject.m_UseItems[btWhere].btValue[7] := 0;
            end;
            New(TakeOffItem);
            TakeOffItem^ := HeroObject.m_UseItems[btWhere];
          end // if HeroObject.m_UseItems[btWhere].wIndex > 0 then
          else
          begin
            // 火龙补品不让单独穿戴 chongchong 2017-07-10
            if StdItem58.StdMode = 97 then
            begin
              n18 := -1;
              DoExit;
              Exit;
            end;
          end;
          if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
            sUserItemName := UserItem.Name
          else
            sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
          HeroObject.m_nCurrentItemMakeIndex := UserItem.MakeIndex;
          HeroObject.m_nCurrentItemPos := btWhere;
          HeroObject.m_sCurrentItemName := UserEngine.GetStdItemName(UserItem.wIndex);
          HeroObject.m_sCurrentItemNewName := sUserItemName;
          HeroObject.m_PickUpOrDropItem := UserItem^;
          HeroObject.m_boStopTakeOn := False;
          g_FunctionNPC.GotoLable(Self, '@HeroBeginTakeOn', False);
          HeroObject.m_PickUpOrDropItem.MakeIndex := 0;
          HeroObject.m_PickUpOrDropItem.wIndex := 0;
          HeroObject.m_nCurrentItemMakeIndex := 0;
          HeroObject.m_nCurrentItemPos := 0;
          HeroObject.m_sCurrentItemName := '';
          HeroObject.m_sCurrentItemNewName := '';
          if HeroObject.m_boStopTakeOn then
          begin
            if TakeOffItem <> nil then
              Dispose(TakeOffItem);
            goto FailExit;
          end;
          if (UserItem.btValue[8] <> 0) and (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) then
          begin
            UserItem.btValue[8] := 0;
          end;
          HeroObject.m_UseItems[btWhere] := UserItem^;
          HeroObject.DelBagItem(n14);
          if (StdItem58.Need in [101, 102]) and (not HeroObject.m_UseItems[btWhere].boStartTime) then
          begin
            HeroObject.m_UseItems[btWhere].nLimitTime := StdItem58.NeedLevel;
            HeroObject.m_UseItems[btWhere].boStartTime := True;
            HeroObject.SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem58.Name, StdItem58.NeedLevel]), c_Red, t_System);
          end;
          if TakeOffItem <> nil then
          begin
            TakeOffItemEx := TakeOffItem^;
            if HeroObject.AddItemToBag(TakeOffItem) then
            begin
              HeroObject.SendAddItem(TakeOffItem);
              if StdItem20.NeedIdentify = 1 then
              begin
                AddGameDataLog(LOG_ItemTakeOff, LOG_ActionNone, HeroObject, StdItem20.Name, TakeOffItem.MakeIndex, '0');
              end;
            end
            else
            begin
              HeroObject.DropItemDown(TakeOffItem, 3, False, HeroObject, nil);
              Dispose(TakeOffItem);
            end;
            if (g_FunctionNPC <> nil) then
            begin
              m_nScriptGotoCount := 0;
              if (TakeOffItemEx.btValue[13] = 1) and (TakeOffItemEx.Name <> '') then
                sItemName := TakeOffItemEx.Name
              else
                sItemName := UserEngine.GetStdItemName(TakeOffItemEx.wIndex);
              HeroObject.m_nCurrentItemMakeIndex := TakeOffItemEx.MakeIndex;
              HeroObject.m_nCurrentItemPos := btWhere;
              HeroObject.m_sCurrentItemName := StdItem20.Name;
              HeroObject.m_sCurrentItemNewName := sItemName;
              HeroObject.m_PickUpOrDropItem := TakeOffItemEx;
              g_FunctionNPC.GotoLable(Self, '@HeroTakeOff' + IntToStr(btWhere), False);
              g_FunctionNPC.GotoLable(Self, '@HeroTakeOffEx', False);
              HeroObject.m_PickUpOrDropItem.MakeIndex := 0;
              HeroObject.m_PickUpOrDropItem.wIndex := 0;
              HeroObject.m_nCurrentItemMakeIndex := 0;
              HeroObject.m_nCurrentItemPos := 0;
              HeroObject.m_sCurrentItemName := '';
              HeroObject.m_sCurrentItemNewName := '';
            end;
          end;
          if StdItem.NeedIdentify = 1 then
          begin
            AddGameDataLog(LOG_ItemTakeOn, LOG_ActionNone, HeroObject, StdItem.Name, UserItem.MakeIndex, '0');
          end;
          HeroObject.RecalcAbilitys();
          HeroObject.SendMsg(HeroObject, RM_ABILITY, 0, 0, 0, 0, '');
          HeroObject.SendMsg(HeroObject, RM_SUBABILITY, 0, 0, 0, 0, '');
          // SendDefMessage(SM_HEROTAKEON_OK, GetFeatureToLong, GetFeatureEx, 0, 0, '');
          HeroObject.SendDefMessage(SM_HEROTAKEON_OK, 0, 0, 0, 0, '');
          HeroObject.FeatureChanged();
          n18 := 1;
          if g_FunctionNPC <> nil then
          begin
            HeroObject.m_nCurrentItemMakeIndex := UserItem.MakeIndex;
            HeroObject.m_nCurrentItemPos := btWhere;
            HeroObject.m_sCurrentItemName := StdItem58.Name;
            HeroObject.m_sCurrentItemNewName := sUserItemName;
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@HeroTakeOn' + IntToStr(btWhere), False);
            g_FunctionNPC.GotoLable(Self, '@HeroTakeOnEx', False);
            HeroObject.m_nCurrentItemMakeIndex := 0;
            HeroObject.m_nCurrentItemPos := 0;
            HeroObject.m_sCurrentItemName := '';
            HeroObject.m_sCurrentItemNewName := '';
          end;
        end;
      end
      else
        n18 := -1;
    end
    else
      n18 := -1;
  end;
FailExit:
  if n18 <= 0 then
    HeroObject.SendDefMessage(SM_HEROTAKEON_FAIL, n18, 0, 0, 0, '');
end;

procedure TPlayObject.ClientHeroTakeOffItems(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 英雄脱装备
var
  n10: Integer;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  sUserItemName: string;
  boMysteriousMan: Boolean; // 神秘人
  HeroObject: THeroObject;
  btWhere: Byte;
  nMakeIndex: Integer;
  sItemName: string;
label
  FailExit;
begin
  if m_MyHero = nil then
    Exit;
  btWhere := ProcessMsg.nParam2;
  nMakeIndex := ProcessMsg.nParam1;
  sItemName := ProcessMsg.sMsg;
  n10 := 0;
  HeroObject := THeroObject(m_MyHero);
  boMysteriousMan := HeroObject.m_boMysteriousMan; // 神秘人
  if (btWhere in [Low(THumanUseItems) .. High(THumanUseItems)]) then
