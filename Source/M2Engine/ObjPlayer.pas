procedure TPlayObject.ClientQueryUserShops(ProcessMsg: pTProcessMessage; var boResult: Boolean);
const
  ONE_PAGE_COUNT = 8;
var
  I, nCount: Integer;
  ShopList: TUserShopList;
  UserShop: pTUserShop;
  UserObject: TPlayObject;
  ShopListCount: Integer;
  InBuf: array [0 .. SizeOf(TClientUserShop) * ONE_PAGE_COUNT] of AnsiChar;
  ClientUserShop: PClientUserShop;
begin
  { TODO -ochongchong -c新增 : 密码保护系统 - 系统锁定时，根据选项来控制是否禁止商店 【2013-07-23】 }
  if m_boLockLogon and m_boPasswordLocked and g_Config.boLockStall then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if MyGetTickCount - m_dwQueryUserShopTime < g_Config.nMyShopOperateInterval then
    Exit;
  m_dwQueryUserShopTime := MyGetTickCount;
  m_QueryUserShop_Keyword := ProcessMsg.sMsg;
  m_QueryUserShop_IsKeywordHumanName := ProcessMsg.wParam = 1;
  m_QueryUserShop_SortType := ProcessMsg.nParam2;
  ShopListCount := g_M2DataDB.UserShopDB.GetAllShopCount(m_QueryUserShop_Keyword, m_QueryUserShop_IsKeywordHumanName);
  ShopList := TUserShopList.Create;
  try
    g_M2DataDB.UserShopDB.GetAllShop(0, m_QueryUserShop_Keyword, m_QueryUserShop_IsKeywordHumanName, m_QueryUserShop_SortType,
      ShopList);
    nCount := 0;
    ClientUserShop := @InBuf;
    for I := 0 to ShopList.Count - 1 do
    begin
      UserShop := ShopList.Items[I];
      UserObject := UserEngine.GetPlayObject(UserShop.sMasterName);
      // if g_Config.boOfflineCloseMyShop and (UserObject = nil) then Continue;
      ClientUserShop.sShopName := UserShop.sShopName;
      ClientUserShop.sMasterName := UserShop.sMasterName;
      ClientUserShop.dCreateDate := UserShop.dCreateDate;
      ClientUserShop.nSellingItemCount := UserShop.SellItemCount;
      ClientUserShop.nSelledItemCount := UserShop.SelledItemCount;
      ClientUserShop.nStorageItemCount := UserShop.StorageItemCount;
      if UserObject <> nil then
      begin
        if UserObject.m_boShopStall then
          ClientUserShop.btState := 1
        else
          ClientUserShop.btState := 0;
      end
      else
        ClientUserShop.btState := 2;
      ClientUserShop.nCareValue := UserShop.nCareValue;
      Inc(ClientUserShop);
      Inc(nCount);
      if nCount >= ONE_PAGE_COUNT then
        Break;
    end;
  finally
    ShopList.Free;
  end;
  m_DefMsg := MakeDefaultMsg(SM_QUERYUSERSHOPS, ShopListCount, 0, BoolToInt(g_Config.boOfflineCloseMyShop), nCount);
  SendSocketEx(@m_DefMsg, @InBuf, nCount * SizeOf(TClientUserShop));
end;

procedure TPlayObject.SendQuerySelectShopInfo(sCharName: string; boOpenDlg: Boolean = False);
var
  UserShop: TUserShop;
  ClientUserShop: TClientUserShop;
  UserObject: TPlayObject;
begin
  if g_M2DataDB.UserShopDB.GetUserShopInfo(sCharName, UserShop) then
  begin
    if not SameText(m_sCharName, sCharName) then
      g_M2DataDB.UserShopDB.IncUserShopCareValue(sCharName);
    ClientUserShop.sShopName := UserShop.sShopName;
    ClientUserShop.sMasterName := UserShop.sMasterName;
    ClientUserShop.dCreateDate := UserShop.dCreateDate;
    ClientUserShop.nSellingItemCount := UserShop.SellItemCount;
    ClientUserShop.nSelledItemCount := UserShop.SelledItemCount;
    ClientUserShop.nStorageItemCount := UserShop.StorageItemCount;
    ClientUserShop.boBusiness := UserShop.boBusiness;
    ClientUserShop.nCareValue := UserShop.nCareValue;
    if CompareText(sCharName, m_sCharName) = 0 then
    begin
      UserObject := Self;
      // UserShop.dLastDate := Now;
    end
    else
    begin
      UserObject := UserEngine.GetPlayObject(sCharName);
    end;
    if UserObject <> nil then
    begin
      if UserObject.m_boShopStall then
        ClientUserShop.btState := 1
      else
        ClientUserShop.btState := 0;
    end
    else
      ClientUserShop.btState := 2;
    m_DefMsg := MakeDefaultMsg(SM_QUERYSELECTSHOPINFO, 0, BoolToInt(g_Config.boOfflineCloseMyShop), BoolToInt(boOpenDlg),
      Word(SameText(sCharName, m_sCharName)));
    SendSocketEx(@m_DefMsg, @ClientUserShop, SizeOf(TClientUserShop));
    Exit;
  end;
  if CompareText(sCharName, m_sCharName) = 0 then
  begin
    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@QueryMyShopFail', False);
    end;
    Exit;
  end;
  m_DefMsg := MakeDefaultMsg(SM_QUERYSELECTSHOPINFO_FAIL, 0, 0, 0, 0);
  SendSocket(@m_DefMsg, EncodeString(sCharName));
end;

procedure TPlayObject.ClientQuerySelectShopInfo(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  sName: string;
  BaseObject: TBaseObject;
begin
  if MyGetTickCount - m_dwQueryUserShopTime < 100 then
    Exit;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  sName := ProcessMsg.sMsg;
  // MainOutMessage('正在查询[' + sName + ']的商铺数据', False);
  if (ProcessMsg.nParam1 <> 0) then
  begin
    BaseObject := TBaseObject(ProcessMsg.nParam1);
    if BaseObject <> nil then
    begin
      // MainOutMessage('检测到真名[' + BaseObject.m_sCharName + ']', False);
      if not m_PEnvir.IsValidObjectEx(m_nCurrX, m_nCurrY, 10, BaseObject) then
      begin
        // MainOutMessage(BaseObject.m_sCharName + ' 的距离过远 使用假名', False);
        BaseObject := nil;
      end;
    end;
    if (BaseObject <> nil) and (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
      sName := BaseObject.m_sCharName;
  end;
  m_dwQueryUserShopTime := MyGetTickCount;
  SendQuerySelectShopInfo(sName, True);
end;

