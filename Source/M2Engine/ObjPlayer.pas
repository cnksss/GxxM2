function TPlayObject.CheckActionStatus(wIdent: Word; var dwDelayTime: LongWord): Boolean;
var
  dwCheckTime: LongWord;
  dwActionIntervalTime: LongWord;
begin
  Result := False;
  dwDelayTime := 0;

  // 检查人物弯腰停留时间
  if not g_Config.boDisableStruck then
  begin
    dwCheckTime := MyGetTickCount - m_dwStruckTick;
    if g_Config.dwStruckTime > dwCheckTime then
    begin
      dwDelayTime := g_Config.dwStruckTime - dwCheckTime;
      m_btOldDir := m_btDirection;
      Exit;
    end;
  end;

  // 检查二个不同操作之间所需间隔时间
  dwCheckTime := MyGetTickCount - m_dwActionTick;
  if m_boTestSpeedMode then
    SysMsg('间隔: ' + IntToStr(dwCheckTime), c_Blue, t_Notice);

  if m_wOldIdent = wIdent then
  begin // 当二次操作一样时，则将 boFirst 设置为 真 ，退出由调用函数本身检查二个相同操作之间的间隔时间
    Result := True;
    Exit;
  end;

  if not g_Config.boControlActionInterval then
  begin
    Result := True;
    Exit;
  end;

  dwActionIntervalTime := g_Config.dwActionIntervalTime;
  case wIdent of
    CM_LONGHIT:
      begin
        // 跑位刺杀
        if g_Config.boControlRunLongHit and (m_wOldIdent = CM_RUN) and (m_btOldDir <> m_btDirection) then
          dwActionIntervalTime := g_Config.dwRunLongHitIntervalTime;
      end;
    CM_HIT:
      begin
        // 走位攻击
        if g_Config.boControlWalkHit and (m_wOldIdent = CM_WALK) and (m_btOldDir <> m_btDirection) then
          dwActionIntervalTime := g_Config.dwWalkHitIntervalTime;

        // 跑位攻击
        if g_Config.boControlRunHit and (m_wOldIdent = CM_RUN) and (m_btOldDir <> m_btDirection) then
          dwActionIntervalTime := g_Config.dwRunHitIntervalTime;
      end;
    CM_RUN:
      begin
        // 跑位刺杀
        if g_Config.boControlRunLongHit and (m_wOldIdent = CM_LONGHIT) and (m_btOldDir <> m_btDirection) then
          dwActionIntervalTime := g_Config.dwRunLongHitIntervalTime;

        // 跑位攻击
        if g_Config.boControlRunHit and (m_wOldIdent = CM_HIT) and (m_btOldDir <> m_btDirection) then
          dwActionIntervalTime := g_Config.dwRunHitIntervalTime;

        // 跑位魔法
        if g_Config.boControlRunMagic and (m_wOldIdent = CM_SPELL) and (m_btOldDir <> m_btDirection) then
          dwActionIntervalTime := g_Config.dwRunMagicIntervalTime;
      end;
    CM_WALK:
      begin
        // 走位攻击
        if g_Config.boControlWalkHit and (m_wOldIdent = CM_HIT) and (m_btOldDir <> m_btDirection) then
        begin
          dwActionIntervalTime := g_Config.dwWalkHitIntervalTime;
        end;
        // 跑位刺杀
        if g_Config.boControlRunLongHit and (m_wOldIdent = CM_LONGHIT) and (m_btOldDir <> m_btDirection) then
        begin
          dwActionIntervalTime := g_Config.dwRunLongHitIntervalTime;
        end;
      end;
    CM_SPELL:
      begin
        // 跑位魔法
        if g_Config.boControlRunMagic and (m_wOldIdent = CM_RUN) and (m_btOldDir <> m_btDirection) then
        begin
          dwActionIntervalTime := g_Config.dwRunMagicIntervalTime;
        end;
      end;
    CM_SITDOWN:
      begin
        if m_boButch then
        begin
          dwCheckTime := dwActionIntervalTime;
          Result := True;
        end;
      end;
  end;

  // 将几个攻击操作合并成一个攻击操作代码
  if (wIdent = CM_HIT) or (wIdent = CM_HEAVYHIT) or (wIdent = CM_BIGHIT) or (wIdent = CM_POWERHIT) or
  // (wIdent = CM_LONGHIT) or
    (wIdent = CM_WIDEHIT) or (wIdent = CM_FIREHIT) or
  { (wIdent = CM_CRSHIT) or
    (wIdent = CM_TWNHIT) or
    (wIdent = CM_43HIT) or
    (wIdent = CM_SWORDHIT) or
    (wIdent = CM_66HIT)
  }
    ((wIdent >= CM_CUSTOM_HIT001) and (wIdent < CM_CUSTOM_HIT001 + CUSTOM_MAGIC_COUNT)) then
    wIdent := CM_HIT;

  if dwCheckTime >= dwActionIntervalTime then
  begin
    m_dwActionTick := MyGetTickCount();
    Result := True;
  end
  else
    dwDelayTime := dwActionIntervalTime - dwCheckTime;

  m_wOldIdent := wIdent;
  m_btOldDir := m_btDirection;
end;

procedure TPlayObject.SetScriptLabel(sLabel: string);
begin
  m_CanJmpScriptLableList.Clear;
  m_CanJmpScriptLableList.Add(sLabel);
end;

// 取得当前脚本可以跳转的标签
procedure TPlayObject.GetScriptLabel(sMsg: string);
var
  sText: string;
  sData: string;
  sCmdStr, sLabel, sTemp: string;
  nPos: Integer;
begin
  m_CanJmpScriptLableList.Clear;
  // m_CanRequestStdItemList.Clear;      // 抽奖脚本没有时间分析，先这样搞下chongchong 2017-01-17
  while (True) do
  begin
    if sMsg = '' then
      Break;

    sMsg := GetValidStr3_Ex(sMsg, sText, '\');
    if sText <> '' then
    begin
      sData := '';
      while (Pos('<', sText) > 0) and (Pos('>', sText) > 0) and (sText <> '') do
      begin
        if sText[1] <> '<' then
          sText := '<' + GetValidStr3_Ex(sText, sData, '<');

        sText := ArrestStringEx(sText, '<', '>', sCmdStr);
        if CompareLStr(sCmdStr, 'ItemShow:', 9) then
        begin
          sTemp := Copy(sCmdStr, 10, MaxInt);
          nPos := Pos(':', sTemp);
          if nPos > 0 then
          begin
            sTemp := Copy(sTemp, 1, nPos - 1);
            nPos := StrToIntDef(sTemp, -1);
            if nPos >= 0 then
              m_CanRequestStdItemList.Add(Pointer(nPos));
          end;
        end;

        sLabel := GetValidStr3_Ex(sCmdStr, sCmdStr, '/');
        if sLabel <> '' then
        begin
          if (Length(sLabel) >= 2) and (sLabel[2] = '@') and (sLabel[Length(sLabel)] = ')') then
          begin
            nPos := Pos('(', sLabel); // 检测 <输入/@@InputInteger1(请输入元宝数量：)>
            if (nPos > 0) then
              sLabel := Copy(sLabel, 1, nPos - 1);
          end;

          if (Length(sLabel) > 0) and (sLabel[1] = '@') then
            m_CanJmpScriptLableList.Add(Trim(sLabel));
        end;
      end;
    end;
  end;
end;

function TPlayObject.LableIsCanJmp(sLabel: string): Boolean;
var
  I: Integer;
begin
  Result := False;
  if CompareText(sLabel, '@main') = 0 then
  begin
    Result := True;
    Exit;
  end;

  if CompareText(sLabel, m_sYesLable) = 0 then
  begin
    Result := True;
    Exit;
  end;

  if CompareText(sLabel, m_sNoLable) = 0 then
  begin
    Result := True;
    Exit;
  end;

  if CompareText(sLabel, '@HeroMap') = 0 then
  begin
    Result := True;
    Exit;
  end;

  for I := 0 to m_CanJmpScriptLableList.Count - 1 do
  begin
    if (CompareText(sLabel, m_CanJmpScriptLableList.Strings[I]) = 0) then
    begin
      Result := True;
      Break;
    end;
  end;

  if CompareText(sLabel, m_sPlayDiceLabel) = 0 then
  begin
    m_sPlayDiceLabel := '';
    Result := True;
    Exit;
  end;

  // 铸造物品 跳转标签检测
  if not Result then
  begin
    if CompareLStr(sLabel, '@FOUNDRYITEM_', Length('@FOUNDRYITEM_')) then
    begin
      for I := 0 to m_CanJmpScriptLableList.Count - 1 do
      begin
        if CompareLStr(m_CanJmpScriptLableList.Strings[I], '@FOUNDRYITEM_', Length('@FOUNDRYITEM_')) then
        begin
          Result := True;
          Exit;
        end;
      end;
    end;

    if CompareLStr(sLabel, '@SHOWITEM_', Length('@SHOWITEM_')) then
    begin
      for I := 0 to m_CanJmpScriptLableList.Count - 1 do
      begin
        if CompareLStr(m_CanJmpScriptLableList.Strings[I], '@SHOWITEM_', Length('@SHOWITEM_')) then
        begin
          Result := True;
          Exit;
        end;
      end;
    end;
  end;
end;

procedure TPlayObject.RecalcAbilitys;
var
  I, II, CurHP, CurMP: Integer;
  NoBunusHitPoint, NoBonusSpeedPoint: Integer;
  BonusTick: pTNakedAbility;
  NoBoundAbil: TNoBoundAbility;
  GamePetData: pTGamePetData;
  StdItem: pTStdItem;
  Int64Value: Int64;
  BBObj: TBaseObject;
  nMaxValue: LongWord;
  nTemp: Integer;
  OldNewValue7, OldNewValue8: Integer;
begin
  CurHP := m_WAbil.HP;
  CurMP := m_WAbil.MP;
  inherited RecalcAbilitys;

  if g_Config.btMaxLevel = 0 then
    nMaxValue := MAXUPLEVEL
  else if g_Config.btMaxLevel = 1 then
    nMaxValue := High(Integer)
  else
    nMaxValue := High(LongWord);

  BonusTick := nil;
  case m_btJob of
    0:
      BonusTick := @g_Config.BonusAbilofWarr;
    1:
      BonusTick := @g_Config.BonusAbilofWizard;
    2:
      BonusTick := @g_Config.BonusAbilofTaos;
  end;

  NoBunusHitPoint := m_btHitPoint - m_BonusAbil.Hit div BonusTick.Hit;
  NoBonusSpeedPoint := m_btSpeedPoint - m_BonusAbil.Speed div BonusTick.Speed;
  NoBoundAbil.AC1 := m_WAbil.AC1;
  NoBoundAbil.AC2 := m_WAbil.AC2;
  NoBoundAbil.MAC1 := m_WAbil.MAC1;
  NoBoundAbil.MAC2 := m_WAbil.MAC2;
  NoBoundAbil.DC1 := m_WAbil.DC1;
  NoBoundAbil.DC2 := m_WAbil.DC2;
  NoBoundAbil.MC1 := m_WAbil.MC1;
  NoBoundAbil.MC2 := m_WAbil.MC2;
  NoBoundAbil.SC1 := m_WAbil.SC1;
  NoBoundAbil.SC2 := m_WAbil.SC2;
  NoBoundAbil.MaxHP := m_WAbil.MaxHP;
  NoBoundAbil.MaxMP := m_WAbil.MaxMP;

  m_DefMsg := MakeDefaultMsg(SM_ABILITY_NOBONUS, 0, 0, NoBunusHitPoint, NoBonusSpeedPoint);
  SendSocketEx(@m_DefMsg, @NoBoundAbil, SizeOf(NoBoundAbil));
  RecalcAdjusBonus();

  // 修正通过属性点分配增加HP/MP，满血后用神圣战甲术或更换装备，血值会减少 chongchong 2014-03-18
  {
    产生问题的原因在于：RecalcAbilitys中的下面两行代码，在计算MaxHP/MaxMP时，
    还未调用RecalcAdjusBonus中的将属性分配点加到MaxHP/MaxMP中
    // 限制最高属性
    if m_WAbil.HP > m_WAbil.MaxHP then m_WAbil.HP := m_WAbil.MaxHP;
    if m_WAbil.MP > m_WAbil.MaxMP then m_WAbil.MP := m_WAbil.MaxMP;
  }
  Int64Value := m_WAbil.MaxWeight + m_dwAddMaxWeight;
  if Int64Value >= High(m_WAbil.MaxWeight) then
    Int64Value := High(m_WAbil.MaxWeight);

  m_WAbil.MaxWeight := Int64Value;
  OldNewValue7 := m_WAbil.NewValue[7];
  OldNewValue8 := m_WAbil.NewValue[8];
  if (m_MyGamePet <> nil) then
  begin
    if g_Config.nPetAbilToMasterRate > 0 then
    begin
      if g_Config.boPetHPToMaster then
      begin
        Int64Value := m_WAbil.MaxHP + Round(m_MyGamePet.m_WAbil.MaxHP / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.MaxHP := Min(Int64Value, nMaxValue);
      end;

      if g_Config.boPetDCToMaster then
      begin
        Int64Value := m_WAbil.DC1 + Round(m_MyGamePet.m_WAbil.DC1 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.DC1 := Min(Int64Value, High(m_WAbil.DC1));
        Int64Value := m_WAbil.DC2 + Round(m_MyGamePet.m_WAbil.DC2 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.DC2 := Min(Int64Value, High(m_WAbil.DC2));
      end;

      if g_Config.boPetMCToMaster then
      begin
        Int64Value := m_WAbil.MC1 + Round(m_MyGamePet.m_WAbil.MC1 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.MC1 := Min(Int64Value, High(m_WAbil.MC1));
        Int64Value := m_WAbil.MC2 + Round(m_MyGamePet.m_WAbil.MC2 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.MC2 := Min(Int64Value, High(m_WAbil.MC2));
      end;

      if g_Config.boPetSCToMaster then
      begin
        Int64Value := m_WAbil.SC1 + Round(m_MyGamePet.m_WAbil.SC1 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.SC1 := Min(Int64Value, High(m_WAbil.SC1));
        Int64Value := m_WAbil.SC2 + Round(m_MyGamePet.m_WAbil.SC2 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.SC2 := Min(Int64Value, High(m_WAbil.SC2));
      end;

      if g_Config.boPetACToMaster then
      begin
        Int64Value := m_WAbil.AC1 + Round(m_MyGamePet.m_WAbil.AC1 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.AC1 := Min(Int64Value, High(m_WAbil.AC1));
        Int64Value := m_WAbil.AC2 + Round(m_MyGamePet.m_WAbil.AC2 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.AC2 := Min(Int64Value, High(m_WAbil.AC2));
      end;

      if g_Config.boPetMACToMaster then
      begin
        Int64Value := m_WAbil.MAC1 + Round(m_MyGamePet.m_WAbil.MAC1 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.MAC1 := Min(Int64Value, High(m_WAbil.MAC1));
        Int64Value := m_WAbil.MAC2 + Round(m_MyGamePet.m_WAbil.MAC2 / 100 * g_Config.nPetAbilToMasterRate);
        m_WAbil.MAC2 := Min(Int64Value, High(m_WAbil.MAC2));
      end;
    end;

    if (m_MyGamePetIndex >= 0) and (m_MyGamePetIndex < m_GamePetList.Count) then
    begin
      GamePetData := m_GamePetList.Items[m_MyGamePetIndex];
      for I := 0 to MAX_GamePet_MAGIC_COUNT - 1 do
      begin
        if GamePetData.wMagics[I] > 0 then
        begin
          StdItem := UserEngine.GetStdItem(GamePetData.wMagics[I]);
          if (StdItem <> nil) and (StdItem.StdMode = 93) then
          begin
            {
              AC：准确
              AC2： 敏捷
              MAC：幸运
              MAC2：攻击速度
              DC：中毒恢复
              DC2：毒物躲避
              MC：魔法恢复
              MC2：魔法躲避
              SC：体力恢复
              SC2：
              DuraMax：负重(穿戴)
              Overlap：负重（背包）
            }

            // 扩展准确、敏捷为65536 chongchong 2018-01-11
            // 准确
            if StdItem.AC1 <> 0 then
            begin
              Int64Value := Int64(m_btHitPoint) + StdItem.AC1;
              if g_Config.btMaxHitPoint = 1 then
                m_btHitPoint := Min(Int64Value, High(Word))
              else
                m_btHitPoint := Min(Int64Value, High(Byte));
            end;

            // 敏捷
            if StdItem.AC2 <> 0 then
            begin
              Int64Value := Int64(m_btSpeedPoint) + StdItem.AC2;
              if g_Config.btMaxHitPoint = 1 then
              begin
                m_btSpeedPoint := Min(Int64Value, High(Word));
              end
              else
              begin
                m_btSpeedPoint := Min(Int64Value, High(Byte));
              end;
            end;

            // 幸运
            if StdItem.MAC1 <> 0 then
            begin
              Int64Value := Int64(m_nLuck) + StdItem.MAC1;
              m_nLuck := Min(Int64Value, High(Integer));
            end;

            // 攻击速度
            if StdItem.MAC2 <> 0 then
            begin
              Int64Value := Int64(m_nHitSpeed) + StdItem.MAC2;
              m_nHitSpeed := Min(Int64Value, High(Integer));
            end;

            // 中毒恢复
            if StdItem.DC1 <> 0 then
            begin
              Int64Value := Int64(m_nPoisonRecover) + StdItem.DC1;
              m_nPoisonRecover := Min(Int64Value, High(Integer));
            end;

            // 毒躲避
            if StdItem.DC2 <> 0 then
            begin
              Int64Value := Int64(m_btAntiPoison) + StdItem.DC2;
              m_btAntiPoison := Min(Int64Value, High(Byte));
            end;

            // 魔法恢复
            if StdItem.MC1 <> 0 then
            begin
              Int64Value := Int64(m_nSpellRecover) + StdItem.MC1;
              m_nSpellRecover := Min(Int64Value, High(Integer));
            end;

            // 魔法躲避
            if StdItem.MC2 <> 0 then
            begin
              Int64Value := Int64(m_nAntiMagic) + StdItem.MC2;
              m_nAntiMagic := Min(Int64Value, High(Integer));
            end;

            // 体力恢复
            if StdItem.SC1 <> 0 then
            begin
              Int64Value := Int64(m_nHealthRecover) + StdItem.SC1;
              m_nHealthRecover := Min(Int64Value, High(Integer));
            end;

            // 加负重
            if StdItem.DuraMax <> 0 then
            begin
              Int64Value := Int64(m_WAbil.MaxWearWeight) + StdItem.DuraMax;
              m_WAbil.MaxWearWeight := Min(Int64Value, High(Integer));
            end;

            // 加背包重量
            if StdItem.Overlap <> 0 then
            begin
              Int64Value := Int64(m_WAbil.MaxWeight) + StdItem.Overlap;
              m_WAbil.MaxWeight := Min(Int64Value, High(Integer));
            end;

            for II := 0 to Length(StdItem.Elements) - 1 do
            begin
              // 攻击伤害、体力增加、魔法增加、合击伤害、致命一击伤害增加 chongchong 2015-06-30
              if II in [1, 7, 8, 10, 22] then
              begin
                Int64Value := Int64(m_WAbil.NewValue[II]) + StdItem.Elements[II];
                m_WAbil.NewValue[II] := Min(Int64Value, High(LongWord))
              end
              else
              begin
                Int64Value := Int64(m_WAbil.NewValue[II]) + StdItem.Elements[II];
                m_WAbil.NewValue[II] := Min(Int64Value, 100);
              end;
            end;
          end;
        end;
      end;
    end;
  end;

  // 宠物技能加的属性没有算 这里再算一下 2020-08-07 22:39:49
  if m_WAbil.NewValue[7] > OldNewValue7 then
  begin
    Int64Value := Int64(m_WAbil.MaxHP) + Round(m_WAbil.MaxHP * ((m_WAbil.NewValue[7] - OldNewValue7) / 100));
    m_WAbil.MaxHP := Min(nMaxValue, Int64Value);
  end;

  if m_WAbil.NewValue[8] > OldNewValue8 then
  begin
    Int64Value := Int64(m_WAbil.MaxMP) + Round(m_WAbil.MaxMP * ((m_WAbil.NewValue[8] - OldNewValue8) / 100));
    m_WAbil.MaxMP := Min(nMaxValue, Int64Value);
  end;

  if CurHP <= m_WAbil.MaxHP then
    m_WAbil.HP := CurHP
  else
    m_WAbil.HP := m_WAbil.MaxHP;

  if CurMP <= m_WAbil.MaxMP then
    m_WAbil.MP := CurMP
  else
    m_WAbil.MP := m_WAbil.MaxMP;

  // 修正npc加攻击速度不能和装备速度叠加 chongchong 2018-05-18
  nTemp := m_nNpcAttackSpeed + m_nHitSpeed;
  if nTemp >= High(m_nAttackSpeed) then
    nTemp := High(m_nAttackSpeed)
  else if nTemp <= Low(m_nAttackSpeed) then
    nTemp := Low(m_nAttackSpeed);

  m_nAttackSpeed := nTemp;
  RecalcPlayCombatPower(Self);
  RefGameSpeed;

  // 人物属性重算，就重算宝宝属性叠加 2019-07-06 18:28:13
  for I := 0 to m_SlaveList.Count - 1 do
  begin
    BBObj := m_SlaveList.Items[I];
    if BBObj = nil then
      Continue;

    if BBObj.m_boDeath or BBObj.m_boGhost then
      Continue;

    if BBObj.m_boAddMasterAttrToSelf then
    begin
      BBObj.RecalcAbilitys;
    end;
  end;

  if (g_FunctionNPC <> nil) and (not m_boDummyObject) then
  begin
    m_nScriptGotoCount := 0;
    g_FunctionNPC.GotoLable(Self, '@RecalcAbilitys', False);
  end;
end;

// 搜寻可视范围内对象(物品，人物、怪物等) -- piaoyun 2013-07-04
procedure TPlayObject.SearchViewRange;
var
  I, Index: Integer;
  nStartX: Integer;
  nEndX: Integer;
  nStartY: Integer;
  nEndY: Integer;
  n18: Integer;
  n1C: Integer;
  nIdx: Integer;
  MapCellInfo: pTMapCellinfo;
  GameObject: TGameObject;
  BaseObject: TBaseObject;
  // MapItem: TItemObject;
  MapEvent: TGameEvent;
  ItemObject: TItemObject;
  VisibleBaseObject: pTVisibleBaseObject;
  VisibleMapItem: pTVisibleMapItem;
  VisibleMapEvent: pTVisibleMapEvent;
  nCheckCode: Integer;
  boFixedHideMode: Boolean;
  SmartObject: TSmartObject;
  dwRunTick: LongWord;
  HashItem: HashList.PHashItem;
  NextItem: HashList.PHashItem;
  SetImageInfo: TSetImageInfo;
  sSendMsg: AnsiString;
  CustomMagicStatus: PCustomMagicStatus;
resourcestring
  sExceptionMsg1 = '[Exception] TPlayObject.SearchViewRange Code:%d';
  sExceptionMsg2 = '[Exception] TPlayObject.SearchViewRange 1-%d %s %s %d %d %d';
begin
  if m_boOffLine then
  begin
    ClearObject;
    Exit;
  end;

  dwRunTick := MyGetTickCount;
  nCheckCode := 2;
  try
    m_VisibleItems.Lock;
    try
      for I := 0 to m_VisibleItems.Count - 1 do
      begin
        VisibleMapItem := m_VisibleItems[I].Item;
        if VisibleMapItem <> nil then
        begin
          VisibleMapItem.nVisibleFlag := 0;
        end;
      end;
    finally
      m_VisibleItems.UnLock;
    end;

    m_VisibleEvents.Lock;
    try
      nCheckCode := 3;
      HashItem := m_VisibleEvents.First;
      while HashItem <> nil do
      begin
        VisibleMapEvent := HashItem.Item;
        HashItem := m_VisibleEvents.Next(HashItem);
        if VisibleMapEvent <> nil then
          VisibleMapEvent.nVisibleFlag := 0;
      end;
      nCheckCode := 4;
    finally
      m_VisibleEvents.UnLock;
    end;

    m_VisibleActors.Lock;
    try
      for I := 0 to m_VisibleActors.Count - 1 do
      begin
        VisibleBaseObject := m_VisibleActors[I].Item;
        if VisibleBaseObject <> nil then
          VisibleBaseObject.nVisibleFlag := 0;
      end;
    finally
      m_VisibleActors.UnLock;
    end;
    nCheckCode := 5;
  except
    MainOutMessage(Format(sExceptionMsg1, [nCheckCode]));
    KickException();
  end;

  nCheckCode := 6;
  // 这个地方说不定可以改改????????
  // m_nViewRange来源于客户端传送，客户端只传了水平的视觉范围，没有垂直的视觉范围
  // 垂直视觉范围单独优化 chongchong 2014-12-07
  // m_nViewRange := Max(m_nViewRange, m_wClientViewRange)
  if m_PEnvir <> nil then
  begin
    nStartX := m_nCurrX - m_nViewRange;
    nEndX := m_nCurrX + m_nViewRange;
    nStartY := m_nCurrY - m_nViewRange;
    nEndY := m_nCurrY + m_nViewRange + m_nViewRangeExtY;
    try
      nCheckCode := 7;
      for n18 := nStartX to nEndX do
      begin
        nCheckCode := 8;
        for n1C := nStartY to nEndY do
        begin
          nCheckCode := 9;
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            m_PEnvir.LockW(3);
          try
{$IFEND}
            if m_PEnvir.GetMapCellInfo(n18, n1C, MapCellInfo) and (MapCellInfo.ObjList <> nil) then
            begin
              nCheckCode := 10;
              nIdx := 0;
              while (True) do
              begin
                nCheckCode := 11;
{$IF USEOBJLIST = 1}
                if Length(MapCellInfo.ObjList) <= nIdx then
                  Break;
                GameObject := TGameObject(MapCellInfo.ObjList[nIdx]);
{$ELSE}
                if MapCellInfo.ObjList.Count <= nIdx then
                  Break;
                GameObject := TGameObject(MapCellInfo.ObjList.Items[nIdx]);
{$IFEND}
                nCheckCode := 12;
                if GameObject = nil then
                begin
{$IF USEOBJLIST = 1}
                  for Index := nIdx to Length(MapCellInfo.ObjList) - 2 do
                    MapCellInfo.ObjList[Index] := MapCellInfo.ObjList[Index + 1];

                  SetLength(MapCellInfo.ObjList, Length(MapCellInfo.ObjList) - 1);
                  if Length(MapCellInfo.ObjList) <= 0 then
                  begin
                    MapCellInfo.ObjList := nil;
                    Break;
                  end;
{$ELSE}
                  MapCellInfo.ObjList.Delete(nIdx);
                  if MapCellInfo.ObjList.Count <= 0 then
                  begin
                    FreeAndNil(MapCellInfo.ObjList);
                    Break;
                  end;
{$IFEND}
                  Continue;
                end
                else if GameObject.m_ObjGame = obj_Actor then
                begin
                  nCheckCode := 14;
                  if (not m_boDenyRefStatus) and ((MyGetTickCount - GameObject.m_dwAddTime) >= 60 * 1000) then
                  begin
{$IF USEOBJLIST = 1}
                    for Index := nIdx to Length(MapCellInfo.ObjList) - 2 do
                      MapCellInfo.ObjList[Index] := MapCellInfo.ObjList[Index + 1];

                    SetLength(MapCellInfo.ObjList, Length(MapCellInfo.ObjList) - 1);
                    if Length(MapCellInfo.ObjList) <= 0 then
                    begin
                      MapCellInfo.ObjList := nil;
                      Break;
                    end;
{$ELSE}
                    MapCellInfo.ObjList.Delete(nIdx);
                    if MapCellInfo.ObjList.Count <= 0 then
                    begin
                      FreeAndNil(MapCellInfo.ObjList);
                      Break;
                    end;
{$IFEND}
                    Continue;
                  end;

                  nCheckCode := 15;
                  BaseObject := TBaseObject(GameObject);
                  nCheckCode := 16;
                  if (BaseObject.m_PEnvir <> nil) and (BaseObject.m_PEnvir <> m_PEnvir) then
                  begin
                    MainOutMessage(Format('%s(%d/%d) 发现非本地图角色(%s 所在地图:%s(%d/%d))', [m_PEnvir.sMapDesc, n18, n1C,
                      BaseObject.m_sCharName, BaseObject.m_PEnvir.sMapDesc, BaseObject.m_nCurrX, BaseObject.m_nCurrY]));
{$IF USEOBJLIST = 1}
                    for Index := nIdx to Length(MapCellInfo.ObjList) - 2 do
                      MapCellInfo.ObjList[Index] := MapCellInfo.ObjList[Index + 1];

                    SetLength(MapCellInfo.ObjList, Length(MapCellInfo.ObjList) - 1);
                    if Length(MapCellInfo.ObjList) <= 0 then
                    begin
                      MapCellInfo.ObjList := nil;
                      Break;
                    end;
{$ELSE}
                    MapCellInfo.ObjList.Delete(nIdx);
                    if MapCellInfo.ObjList.Count <= 0 then
                    begin
                      FreeAndNil(MapCellInfo.ObjList);
                      Break;
                    end;
{$IFEND}
                    Continue;
                  end;

                  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
                    boFixedHideMode := TSmartObject(BaseObject).m_dwChangeModeExTick[1] > 0
                  else
                    boFixedHideMode := False;

                  if (not BaseObject.m_boGhost) and (not BaseObject.m_boFixedHideMode) and (BaseObject.m_PEnvir = m_PEnvir) and
                    (((not BaseObject.m_boObMode) and (not boFixedHideMode)) or (BaseObject.m_Master = Self)) then
                  // H.ChangeModeEx 2 1000 主人看不到英雄 2019-04-26 10:37:30
                  begin // 20120830增加(BaseObject.m_PEnvir=m_PEnvir)
                    nCheckCode := 17;
                    if (m_btRaceServer < RC_ANIMAL) //
                      or (m_Master <> nil) //
                      or m_boCrazyMode //
                      or m_boWantRefMsg //
                      or ((BaseObject.m_Master <> nil) and (abs(BaseObject.m_nCurrX - m_nCurrX) <= 3) // -
                      and (abs(BaseObject.m_nCurrY - m_nCurrY) <= 3)) //
                      or (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
                    begin
                      if BaseObject <> Self then // 自己不加入到可视对象列表中，，优化数据包。 2021-03-23
                      begin
                        nCheckCode := 18;
                        UpdateVisibleGay(BaseObject);
                        nCheckCode := 19;
                      end;
                    end;
                  end;
                end
                else { // 004B99E2 if GameObject.m_ObjGame = obj_Actor then begin }
                  if (GameObject.m_ObjGame = Obj_Item) then
                  begin
                    nCheckCode := 20;
                    ItemObject := TItemObject(GameObject);
                    nCheckCode := 21;
                    if not ItemObject.m_boGhost then
                    begin
                      UpdateVisibleItem(n18, n1C, ItemObject);
                    end;
                    nCheckCode := 23;
                  end
                  else if GameObject.m_ObjGame in [Obj_Event, Obj_MapEffect] then
                  begin
                    nCheckCode := 37;
                    MapEvent := TGameEvent(GameObject);
                    if MapEvent.m_boVisible then
                    begin
                      if (MapEvent is TMapEffectEvent) then
                      begin
                        if (TMapEffectEvent(MapEvent).m_ViewPlayer = nil) or (TMapEffectEvent(MapEvent).m_ViewPlayer = Self) then
                          UpdateVisibleEvent(n18, n1C, MapEvent);
                      end
                      else
                      begin
                        nCheckCode := 38;
                        UpdateVisibleEvent(n18, n1C, MapEvent);
                      end;
                    end;
                    nCheckCode := 39;
                  end;
                Inc(nIdx);
              end;
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              m_PEnvir.UnLockW;
          end;
{$IFEND}
        end;
      end;
    except
      on E: Exception do
      begin
        MainOutMessage(Format(sExceptionMsg2, [nCheckCode, m_sCharName, m_sMapName, m_nCurrX, m_nCurrY, nCheckCode]));
        MainOutMessage(E.Message);
        KickException();
      end;
    end;
  end;

  nCheckCode := 40;
  try
    m_VisibleActors.Lock;
    try
      for I := m_VisibleActors.Count - 1 downto 0 do
      begin
        VisibleBaseObject := m_VisibleActors[I].Item;
        if VisibleBaseObject <> nil then
        begin
          if (VisibleBaseObject.nVisibleFlag = 0) then
          begin
            nCheckCode := 43;
            if (not m_boOffLine) and (not m_boDummyObject) then
            begin
              nCheckCode := 44;
              BaseObject := TBaseObject(VisibleBaseObject.BaseObject);
              nCheckCode := 45;
              // 修正人物回城石+小退同时执行留一个假的人物影子 {and (not BaseObject.m_boGhost)} chongchong 2018-04-11
              if not BaseObject.m_boFixedHideMode { and (not BaseObject.m_boGhost) } then
              begin // 01/21 修改防止人物退出时发送重复的消息占用带宽，人物进入隐身模式时人物不消失问题
                nCheckCode := 46;
                SendMsg(BaseObject, RM_DISAPPEAR, 0, 0, 0, 0, '');
              end;
              nCheckCode := 47;
            end;
            m_VisibleActors.Delete(I);
            nCheckCode := 48;
            Dispose(VisibleBaseObject);
            nCheckCode := 49;
            Continue;
          end
          else if (m_btRaceServer = RC_PLAYOBJECT) and (VisibleBaseObject.nVisibleFlag = 2) then
          begin
            nCheckCode := 51;
            BaseObject := TBaseObject(VisibleBaseObject.BaseObject);
            nCheckCode := 52;

            if BaseObject <> Self then
            begin
              nCheckCode := 53;
              if BaseObject.m_boDeath then
              begin
                nCheckCode := 54;
                if BaseObject.m_boSkeleton then
                begin
                  nCheckCode := 55;
                  SendMsg(BaseObject, RM_SKELETON, BaseObject.m_btDirection, BaseObject.m_nCurrX, BaseObject.m_nCurrY, 0, '');
                  nCheckCode := 56;
                end
                else
                begin // 004B9DA8
                  nCheckCode := 57;
                  SendMsg(BaseObject, RM_DEATH, BaseObject.m_btDirection, BaseObject.m_nCurrX, BaseObject.m_nCurrY, 0, '');
                  nCheckCode := 58;
                end;
              end
              else
              begin
                nCheckCode := 59;
                SendMsg(BaseObject, RM_TURN, BaseObject.m_btDirection, BaseObject.m_nCurrX, BaseObject.m_nCurrY, 1,
                  BaseObject.GetShowName(m_btPermission >= 10));
                nCheckCode := 60;
              end;

              if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
              begin
                SmartObject := TSmartObject(BaseObject);
                if SmartObject.m_wHeroM2DressEffect > 0 then
                  SendMsg(BaseObject, RM_HEROM2SENDDRESSEFFECT, 0, SmartObject.m_wHeroM2DressEffect, 0, 0, '');

                // 发送游戏速度
                if (SmartObject.m_nMoveSpeed <> 0) or (SmartObject.m_nAttackSpeed <> 0) or (SmartObject.m_nSpellSpeed <> 0) then
                  SendMsg(BaseObject, RM_CHANGESPEED, SmartObject.m_nMoveSpeed, NativeInt(SmartObject),
                    SmartObject.m_nAttackSpeed, SmartObject.m_nSpellSpeed, '');

                // 发送脚本命令魔法特效
                SendMsg(SmartObject, RM_SENDUSEREFFECT, 0, NativeInt(SmartObject), 0, 0, '');
                if (SmartObject.m_boShowPhantom) then
                  SendMsg(SmartObject, RM_SHOWPHANTOM, SmartObject.m_btPhantomAlpha, NativeInt(SmartObject), 0, 0, '');
              end
              else if (BaseObject.m_btRaceServer = RC_NPC) // 加入天下第一 chongchong 2015-01-15
                and (BaseObject is TNormNpc) //
                and (BaseObject.m_wAppr = 273) //
                and (TNormNpc(BaseObject).m_nEffigyState.Value1 > 0) then
              begin
                SetImageInfo.EffigyState := TNormNpc(BaseObject).m_nEffigyState;
                SetImageInfo.ChrName := TNormNpc(BaseObject).m_sCharName + '\' + TNormNpc(BaseObject).m_sAddName;
                SendMsg(BaseObject, RM_SETNPCIMAGE, NativeInt(BaseObject), TNormNpc(BaseObject).m_nEffigyOffset,
                  Integer(TNormNpc(BaseObject).m_boGrayShow), Integer(TNormNpc(BaseObject).m_boScaleShow),
                  EncodeBuffer(@SetImageInfo, SizeOf(SetImageInfo)));
              end;
              {
                else if BaseObject.m_boPreviewMonItem and (BaseObject.m_dwPreviewMonItemPlayer = Self) then
                begin
                SendMsg(BaseObject, RM_PREVIEW_MON_ITEM, 0, 0, 0, 0, '');
                end;
              }

              // 发送人物喊话信息颜色
              if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and (TPlayObject(BaseObject).m_btHearMsgColor <> 255) then
                SendMsg(BaseObject, RM_HEARCOLOR, TPlayObject(BaseObject).m_btHearMsgColor, NativeInt(BaseObject), 0, 0, '');

              // 发送人物顶戴花翎
              if BaseObject.UseIconsCount > 0 then
              begin
                if ((BaseObject.m_PEnvir <> nil) // -
                  and (BaseObject.m_PEnvir.m_nSecretFlag // -
                  and SecretFlag_HideActorIcons = 0) // -
                  and (BaseObject.m_PEnvir.m_nSecretFlag2 // -
                  and SecretFlag_HideActorIcons = 0)) // -
                  or not(BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
                  SendMsg(BaseObject, RM_SENDUSERICON, 0, NativeInt(BaseObject), 0, 0, '');
              end;

              // 蜘蛛网罩住
              if BaseObject.m_boCobwebWindingStatus and BaseObject.m_boDuanJin then
                SendMsg(BaseObject, RM_OPENCOBWEBWINDING, 0, NativeInt(BaseObject), 1, 0, '')
              else if BaseObject.m_boCobwebWindingStatus then
                SendMsg(BaseObject, RM_OPENCOBWEBWINDING, 0, NativeInt(BaseObject), 0, 0, '');

              // 毒烟 chongchong 2013-11-10
              if BaseObject.m_boToxicSmoke then
                SendMsg(BaseObject, RM_OPENTOXICSMOKE, 0, NativeInt(BaseObject), 0, 0, '');

              // 永恒冰冻
              if BaseObject.m_boForeverFrozen then
                SendMsg(BaseObject, RM_EFFECTSTEP, 9999, 0, 0, 0, '');

              // 发送自定义技能自定义状态
              if BaseObject.m_CustomMagicStatusList.Count > 0 then
              begin
                CustomMagicStatus := BaseObject.m_CustomMagicStatusList[0];
                SendMsg(BaseObject, RM_EFFECTSTEP, 9991, CustomMagicStatus.MagicID, CustomMagicStatus.MagicLevel, 0, '');
              end;

              if (BaseObject.m_MagicSelfPlay.SelfKeep_File >= 0) //
                and (BaseObject.m_MagicSelfPlay.SelfKeep_PlayCount > 0) //
                and (BaseObject.m_MagicSelfPlay.SelfKeep_KeepTime > 0) //
                and (Tick_Diff(BaseObject.m_MagicSelfPlayTick, MyGetTickCount) < BaseObject.m_MagicSelfPlay.SelfKeep_KeepTime *
                1000 - 2000) then
              begin
                BaseObject.m_MagicSelfPlay.SelfKeep_KeepTime :=
                  (BaseObject.m_MagicSelfPlay.SelfKeep_KeepTime * 1000 - Tick_Diff(BaseObject.m_MagicSelfPlayTick, MyGetTickCount)
                  ) div 1000;

                SetLength(sSendMsg, SizeOf(BaseObject.m_MagicSelfPlay));
                Move(BaseObject.m_MagicSelfPlay, sSendMsg[1], Length(sSendMsg));
                SendMsg(BaseObject, RM_CUSTOM_MAGIC_SELFKEEP_PLAY, Length(sSendMsg), 0, 0, 0, sSendMsg);
              end;

              // 内力
              if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) //
                and TSmartObject(BaseObject).m_boTrainingNG then
                SendMsg(Self, RM_REFABILNG, 0, NativeInt(BaseObject), TSmartObject(BaseObject).m_AbilNG.NH,
                  TSmartObject(BaseObject).m_AbilNG.MaxNH, '');

              // 摆摊商铺名称
              if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and (TPlayObject(BaseObject).m_boShopStall) and
                (TPlayObject(BaseObject).m_sShopName <> '') then
                SendMsg(Self, RM_SENDSHOPNAME, 0, NativeInt(BaseObject), 0, 0, TPlayObject(BaseObject).m_sShopName);

              if g_PluginManager <> nil then
                g_PluginManager.HookPlayerViewRangeNewObject(Self, BaseObject, BaseObject.m_nCurrX, BaseObject.m_nCurrY);
            end;
          end;
        end; // if VisibleBaseObject <> nil then begin
      end;
    finally
      m_VisibleActors.UnLock;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg2, [nCheckCode, m_sCharName, m_sMapName, m_nCurrX, m_nCurrY, nCheckCode]));
      KickException();
    end;
  end;

  try
    m_VisibleItems.Lock;
    try
      for I := m_VisibleItems.Count - 1 downto 0 do
      begin
        VisibleMapItem := m_VisibleItems[I].Item;
        if (VisibleMapItem <> nil) then
        begin
          if (VisibleMapItem.nVisibleFlag = 0) then
          begin // (VisibleMapItem.nVisibleFlag = 3)已经发送过隐藏物品封包
            if not VisibleMapItem.boSendHideMsg then
            begin
              SendMsg(Self, RM_ITEMHIDE, 0, NativeInt(VisibleMapItem.BaseObject), VisibleMapItem.nX, VisibleMapItem.nY, '');
            end;
            m_VisibleItems.Delete(I);
            Dispose(VisibleMapItem);
            Continue;
          end
          else if VisibleMapItem.nVisibleFlag = 2 then
          begin
            SendMsg(Self, RM_ITEMSHOW, VisibleMapItem.wLooks, NativeInt(VisibleMapItem.BaseObject), VisibleMapItem.nX,
              VisibleMapItem.nY, IntToStr(VisibleMapItem.btColor2) + '/' + IntToStr(VisibleMapItem.OverlapCountAndEffect) + '/' +
              IntToStr(NativeInt(VisibleMapItem.boValue)) + '/' + VisibleMapItem.sName);
          end;
        end;
      end;
    finally
      m_VisibleItems.UnLock;
    end;

    HashItem := m_VisibleEvents.First;
    while HashItem <> nil do
    begin
      NextItem := HashItem;
      VisibleMapEvent := HashItem.Item;
      HashItem := m_VisibleEvents.Next(HashItem);
      if (VisibleMapEvent <> nil) then
      begin
        // ??????????修复引擎假人卡死1 piaoyun 2013-11-13
        if (VisibleMapEvent.nVisibleFlag = 0) then
        begin
          // 排除假人、离线人物
          if (not m_boOffLine) and (not m_boDummyObject) then
            SendMsg(Self, RM_HIDEEVENT, 0, NativeInt(VisibleMapEvent.BaseObject), VisibleMapEvent.nX, VisibleMapEvent.nY, '');
          m_VisibleEvents.Remove(NextItem);
          Dispose(VisibleMapEvent);
          Continue;
        end
        // ??????????修复引擎假人卡死2 piaoyun 2013-11-13
        else if (VisibleMapEvent.nVisibleFlag = 2) { 排除假人、离线人物 } and (not m_boOffLine) and (not m_boDummyObject) then
        begin
          MapEvent := TGameEvent(VisibleMapEvent.BaseObject);
          if MapEvent is TMapMagicGameEvent then
          begin
            if TMapMagicGameEvent(MapEvent).KeepVisible or (MyGetTickCount - TMapMagicGameEvent(MapEvent).VisibleTick <= 2000)
            then
              SendMsg(Self, RM_SHOWEVENT, MakeWord(MapEvent.m_nEventType, MapEvent.m_nEventParam), NativeInt(MapEvent),
                MapEvent.m_nX, MapEvent.m_nY, '');
          end
          else
            SendMsg(Self, RM_SHOWEVENT, MakeWord(MapEvent.m_nEventType, MapEvent.m_nEventParam), NativeInt(MapEvent),
              MapEvent.m_nX, MapEvent.m_nY, '');
        end;
      end;
    end;
  except
    MainOutMessage(m_sCharName + ',' + m_sMapName + ',' + IntToStr(m_nCurrX) + ',' + IntToStr(m_nCurrY) + ',' +
      ' SearchViewRange 3');
    KickException();
  end;
end;

function TPlayObject.GetShowName(boSuperUser: Boolean): string;
var
  sShowName: string;
  sCharName: string;
  sGuildName: string;
  sDearName: string;
  sMasterName: string;
  Castle: TUserCastle;
  ErrCode: Integer;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.GetShowName, ErrCode %d  %s';
begin
  // 是否显示神秘人 piaoyun 2013-08-17
  if m_boMysteriousMan and (not boSuperUser) and g_Config.boShowMysteriousMan then
  begin
    Result := g_Config.sMysteriousManName;
    Exit;
  end;

  if (m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and (not boSuperUser) and (Length(m_PEnvir.m_sSecretShowName) > 0)
  then
  begin
    Result := m_PEnvir.m_sSecretShowName;
    Exit;
  end;

  if (m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and (not boSuperUser) and
    (Length(m_PEnvir.m_sSecretShowName2) > 0) then
  begin
    Result := m_PEnvir.m_sSecretShowName2;
    Exit;
  end;

  // 双人骑马时显示名字为邀请人在前面，被邀请人在后面 chongchong 2013-10-16
  if m_boOnHorse and (m_HorseOtherHum <> nil) then
  begin
    if m_boHorseMaster then
      Result := m_sCharName + '  ' + m_HorseOtherHum.m_sCharName
    else
      Result := m_HorseOtherHum.m_sCharName + '  ' + m_sCharName;
    Exit;
  end;

  ErrCode := 0;
  try
    sCharName := '';
    sGuildName := '';
    sDearName := '';
    sMasterName := '';
    if m_MyGuild <> nil then
    begin
      ErrCode := 1;
      Castle := g_CastleManager.IsCastleMember(Self);
      if Castle <> nil then
      begin
        ErrCode := 2;
        sGuildName := AnsiReplaceText(g_sCastleGuildName, '%castlename', Castle.m_sName);
        sGuildName := AnsiReplaceText(sGuildName, '%guildname', TGUild(m_MyGuild).sGuildName);
        sGuildName := AnsiReplaceText(sGuildName, '%rankname', m_sGuildRankName);
      end
      else
      begin
        ErrCode := 3;
        Castle := g_CastleManager.InCastleWarArea(Self);
        // 01/25 多城堡
        // if g_Config.boShowGuildName or (UserCastle.m_boUnderWar and (m_boInFreePKArea or UserCastle.InCastleWarArea(m_PEnvir,m_nCurrX,m_nCurrY))) then begin
        if g_Config.boShowGuildName or (((Castle <> nil) and Castle.m_boUnderWar) or m_boInFreePKArea) then
        begin
          ErrCode := 4;
          sGuildName := AnsiReplaceText(g_sNoCastleGuildName, '%guildname', TGUild(m_MyGuild).sGuildName);
          sGuildName := AnsiReplaceText(sGuildName, '%rankname', m_sGuildRankName);
        end;
      end;
    end;

    // 不要改 ChrName，不然蛋疼了。个人商店有问题
    // sCharName := m_sCharName;
    if not g_Config.boShowRankLevelName then
    begin
      if m_btReLevel > 0 then
      begin
        ErrCode := 5;
        case m_btJob of
          0:
            sCharName := AnsiReplaceText(g_sWarrReNewName, '%chrname', m_sCharName);
          1:
            sCharName := AnsiReplaceText(g_sWizardReNewName, '%chrname', m_sCharName);
          2:
            sCharName := AnsiReplaceText(g_sTaosReNewName, '%chrname', m_sCharName);
        end;
      end
      else
        sCharName := m_sCharName;
    end
    else
    begin
      ErrCode := 6;
      sCharName := AnsiReplaceText(m_sRankLevelName, '%s', m_sCharName); // Format(m_sRankLevelName, [m_sCharName]);
    end;

    if m_sMasterName <> '' then
    begin
      if m_boMaster then
      begin
        ErrCode := 7;
        sMasterName := Format(g_sMasterName, [m_sMasterName]);
      end
      else
      begin
        ErrCode := 8;
        sMasterName := WideStringReplace(g_sNoMasterName, '%s', m_sMasterName, []);
        sMasterName := WideStringReplace(sMasterName, '%n', MoneyToCharacter(m_nMasterNo), []);
      end;
    end;

    if m_sDearName <> '' then
    begin
      if m_btGender = 0 then
      begin
        ErrCode := 9;
        // sDearName:= m_sDearName + '的老公';
        sDearName := Format(g_sManDearName, [m_sDearName]);
      end
      else
      begin
        ErrCode := 10;
        sDearName := Format(g_sWoManDearName, [m_sDearName]); // + '的老婆';
      end;
    end;

    ErrCode := 11;
    sShowName := AnsiReplaceText(g_sHumanShowName, '%chrname', sCharName);
    sShowName := AnsiReplaceText(sShowName, '%guildname', sGuildName);
    sShowName := AnsiReplaceText(sShowName, '%dearname', sDearName);
    sShowName := AnsiReplaceText(sShowName, '%mastername', sMasterName);
    Result := sShowName;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg, [ErrCode, m_sCharName]));
      MainOutMessage(E.Message);
    end;
  end;
end;

function TPlayObject.CheckItemsNeed(StdItem: pTStdItem): Boolean;
var
  Castle: TUserCastle;
begin
  Result := True;
  Castle := g_CastleManager.IsCastleMember(Self);
  case StdItem.Need of
    6:
      begin
        if (m_MyGuild = nil) then
        begin
          Result := False;
        end;
      end;
    60:
      begin
        if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
        begin
          Result := False;
        end;
      end;
    7:
      begin
        if Castle = nil then
        begin
          Result := False;
        end;
      end;
    70:
      begin
        if (Castle = nil) or (m_nGuildRankNo <> 1) then
        begin
          Result := False;
        end;
      end;
    8:
      begin
        if m_nMemberType = 0 then
          Result := False;
      end;
    81:
      begin
        if (m_nMemberType <> LoWord(StdItem.NeedLevel)) or (m_nMemberLevel < HiWord(StdItem.NeedLevel)) then
          Result := False;
      end;
    82:
      begin
        if (m_nMemberType < LoWord(StdItem.NeedLevel)) or (m_nMemberLevel < HiWord(StdItem.NeedLevel)) then
          Result := False;
      end;
  end;
end;

procedure TPlayObject.CheckMarry;
var
  boIsfound: Boolean;
  sUnMarryFileName: string;
  LoadList: TStringList;
  I: Integer;
  sSayMsg: string;
begin
  boIsfound := False;
  sUnMarryFileName := g_Config.sEnvirDir + 'UnMarry.txt';
  if FileExists(sUnMarryFileName) then
  begin
    LoadList := TStringList.Create;
    LoadList.LoadFromFile(sUnMarryFileName);
    if LoadList.Count > 0 then
    begin
      for I := LoadList.Count - 1 downto 0 do
      begin
        if LoadList.Count <= 0 then
          Break;
        if CompareText(LoadList.Strings[I], m_sCharName) = 0 then
        begin
          LoadList.Delete(I);
          boIsfound := True;
          Break;
        end;
      end;
    end;
    LoadList.SaveToFile(sUnMarryFileName);
    LoadList.Free;
  end;

  if boIsfound then
  begin
    if m_btGender = 0 then
    begin
      sSayMsg := AnsiReplaceText(g_sfUnMarryManLoginMsg, '%d', m_sDearName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sDearName);
    end
    else
    begin
      sSayMsg := AnsiReplaceText(g_sfUnMarryWoManLoginMsg, '%d', m_sCharName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
    end;
    SysMsg(sSayMsg, c_Red, t_Hint);
    m_sDearName := '';
    RefShowName;
  end;

  m_DearHuman := UserEngine.GetPlayObject(m_sDearName);
  if m_DearHuman <> nil then
  begin
    m_DearHuman.m_DearHuman := Self;
    if m_btGender = 0 then
    begin
      sSayMsg := AnsiReplaceText(g_sManLoginDearOnlineSelfMsg, '%d', m_sDearName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_DearHuman.m_PEnvir.sMapDesc);
      sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_DearHuman.m_nCurrX));
      sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_DearHuman.m_nCurrY));
      SysMsg(sSayMsg, c_Blue, t_Hint);
      sSayMsg := AnsiReplaceText(g_sManLoginDearOnlineDearMsg, '%d', m_sDearName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_PEnvir.sMapDesc);
      sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_nCurrX));
      sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_nCurrY));
      m_DearHuman.SysMsg(sSayMsg, c_Blue, t_Hint);
    end
    else
    begin
      sSayMsg := AnsiReplaceText(g_sWoManLoginDearOnlineSelfMsg, '%d', m_sDearName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_DearHuman.m_PEnvir.sMapDesc);
      sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_DearHuman.m_nCurrX));
      sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_DearHuman.m_nCurrY));
      SysMsg(sSayMsg, c_Blue, t_Hint);
      sSayMsg := AnsiReplaceText(g_sWoManLoginDearOnlineDearMsg, '%d', m_sDearName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
      sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_PEnvir.sMapDesc);
      sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_nCurrX));
      sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_nCurrY));
      m_DearHuman.SysMsg(sSayMsg, c_Blue, t_Hint);
    end;
  end
  else
  begin
    if m_btGender = 0 then
      SysMsg(g_sManLoginDearNotOnlineMsg, c_Red, t_Hint)
    else
      SysMsg(g_sWoManLoginDearNotOnlineMsg, c_Red, t_Hint);
  end;
end;

procedure TPlayObject.CheckMaster;
var
  boIsfound: Boolean;
  sSayMsg, S: string;
  I: Integer;
  Human: TPlayObject;
  MasterRankInfo: pTMasterRankInfo;
  MasterTDList: TStringList;
  nOldPoint: Integer;
  IsUnForceMasterListChanged: Boolean;
begin
  IsUnForceMasterListChanged := False;
  // 处理强行脱离师徒关系
  g_UnForceMasterList.Lock;
  try
    if g_UnForceMasterList.Count > 0 then
    begin
      for I := g_UnForceMasterList.Count - 1 downto 0 do
      begin
        if g_UnForceMasterList.Count <= 0 then
          Break;
        S := g_UnForceMasterList.Strings[I];
        if (Length(S) = 0) or ((Length(S) > 0) and (S[1] = ';')) then
          Continue;
        {
          if CompareText(g_UnForceMasterList.Strings[I], m_sCharName) = 0 then
          begin
          g_UnForceMasterList.Delete(I);
          SaveUnForceMasterList();
          boIsfound := True;
          Break;
          end;
        }
        // 多师徒 - 强制脱师 chongchong 2014-10-12
        if CompareText(g_UnForceMasterList.Names[I], m_sCharName) = 0 then
        begin
          if m_boMaster then
          begin
            sSayMsg := AnsiReplaceText(g_sfUnMasterLoginMsg, '%s', g_UnForceMasterList.ValueFromIndex[I]);
            // 多师徒 - 出师 chongchong 2014-10-11
            DelMaster(g_UnForceMasterList.ValueFromIndex[I], True);
            // 多师徒 - 师傅触发 chongchong 2014-10-11
            if g_FunctionNPC <> nil then
            begin
              m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(Self, '@ForceUnMasterEnd', False);
            end;
          end
          else
          begin
            // 这个地方是错的，不能逐出师门
            sSayMsg := AnsiReplaceText(g_sfUnMasterListLoginMsg, '%d', m_sMasterName);
            sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sMasterName);
          end;
          g_UnForceMasterList.Delete(I);
          IsUnForceMasterListChanged := True;
          SysMsg(sSayMsg, c_Red, t_Hint);
          m_sMasterName := '';
          RefShowName;
        end;
      end;
    end;
  finally
    g_UnForceMasterList.UnLock;
  end;

  if IsUnForceMasterListChanged then
    SaveUnForceMasterList();

  // 徒弟上线 chongchong 2015-01-05
  if (m_sMasterName <> '') and (not m_boMaster) and (m_Abil.Level >= g_Config.nMasterOKLevel) then
  begin
    Human := UserEngine.GetPlayObject(m_sMasterName);
    if (Human <> nil) and (not Human.m_boDeath) and (not Human.m_boGhost) then
    begin
      sSayMsg := AnsiReplaceText(g_sYourMasterListUnMasterOKMsg, '%n', MoneyToCharacter(m_nMasterNo));
      sSayMsg := AnsiReplaceText(sSayMsg, '%d', m_sCharName);
      Human.SysMsg(sSayMsg, c_Red, t_Hint);
      SysMsg(g_sYouAreUnMasterOKMsg, c_Red, t_Hint);
      // 多师徒 - 出师 chongchong 2014-10-11
      Human.DelMaster(m_sCharName, False);
      // 将师父上的名字去掉
      if m_sCharName = Human.m_sMasterName then
      begin
        Human.m_sMasterName := '';
        Human.RefShowName;
      end;

      if Human.m_MasterList.Count > 0 then
      begin
        for I := Human.m_MasterList.Count - 1 downto 0 do
        begin
          if Human.m_MasterList.Count <= 0 then
            Break;

          if Human.m_MasterList.Items[I] = Self then
          begin
            Human.m_MasterList.Delete(I);
            Break;
          end;
        end;
      end;

      m_sMasterName := '';
      RefShowName;
      if Int64(Human.m_WAbil.CreditPoint) + g_Config.nMasterOKCreditPoint <= High(Integer) then
      begin
        nOldPoint := Human.m_WAbil.CreditPoint;
        Inc(Human.m_WAbil.CreditPoint, g_Config.nMasterOKCreditPoint);
        AddGameDataLog(LOG_CreditPointChange, LOG_ActionNone, Human, g_Config.sCreditPointName, 0, '0', Human.m_WAbil.CreditPoint,
          nOldPoint, '徒弟出师 +' + IntToStr(g_Config.nMasterOKCreditPoint));
      end;

      if g_Config.nMasterOKBonusPoint <> 0 then
      begin
        nOldPoint := Human.m_nBonusPoint;
        Inc(Human.m_nBonusPoint, g_Config.nMasterOKBonusPoint);
        AddGameDataLog(LOG_AbilPointChange, LOG_ActionNone, Human, '未分配属性点', 0, '0', Human.m_nBonusPoint, nOldPoint,
          '徒弟出师 +' + IntToStr(g_Config.nMasterOKBonusPoint));
      end;
      Human.SendMsg(Human, RM_ADJUST_BONUS, 0, 0, 0, 0, '');

      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@UnMasterEnd1', False); // 徒弟触发 2014-10-11
        Human.m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Human, '@UnMasterEnd', False); // 师傅触发 2014-10-11
      end;
      {
        if g_FunctionNPC <> nil then
        begin // 出师触发
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Human, '@MasterOK', False);
        end;
      }
    end
    else
    begin
      // 如果师父不在线则保存到记录表中
      g_UnMasterList.Lock;
      try
        boIsfound := False;
        for I := 0 to g_UnMasterList.Count - 1 do
        begin
          if (CompareText(g_UnMasterList.Names[I], m_sMasterName) = 0) and
            (CompareText(g_UnMasterList.ValueFromIndex[I], m_sCharName) = 0) then
          begin
            boIsfound := True;
            Break;
          end;
        end;

        if not boIsfound then
          g_UnMasterList.Add(m_sMasterName + #9 + m_sCharName);
      finally
        g_UnMasterList.UnLock;
      end;

      if not boIsfound then
        SaveUnMasterList();

      SysMsg(g_sYouAreUnMasterOKMsg, c_Red, t_Hint);
      m_sMasterName := '';
      RefShowName;
      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@UnMasterEnd1', False); // 徒弟触发 2014-10-11
      end;
    end;
  end;

  // 师傅处理徒弟级满出师记录 (可能有几个徒弟出师)
  boIsfound := False;
  MasterTDList := TStringList.Create;
  try
    g_UnMasterList.Lock;
    try
      if g_UnMasterList.Count > 0 then
      begin
        for I := g_UnMasterList.Count - 1 downto 0 do
        begin
          if CompareText(g_UnMasterList.Names[I], m_sCharName) = 0 then
          begin
            MasterTDList.Add(g_UnMasterList.ValueFromIndex[I]);
            g_UnMasterList.Delete(I);
            SaveUnMasterList();
            boIsfound := True;
            Break;
          end;
        end;
      end;
    finally
      g_UnMasterList.UnLock;
    end;

    if boIsfound and m_boMaster then
    begin
      if MasterTDList.Count <= 1 then
        SysMsg(g_sUnMasterLoginMsg, c_Red, t_Hint)
      else
        SysMsg(g_sUnMastersLoginMsg, c_Red, t_Hint);

      for I := 0 to MasterTDList.Count - 1 do
        DelMaster(MasterTDList.Strings[I], False); // 出师 20080603

      m_sMasterName := '';
      RefShowName;
      if Int64(m_WAbil.CreditPoint) + g_Config.nMasterOKCreditPoint <= High(Integer) then
      begin
        nOldPoint := m_WAbil.CreditPoint;
        Inc(m_WAbil.CreditPoint, g_Config.nMasterOKCreditPoint);
        SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, ''); // 声望值变化通知到客户端
        AddGameDataLog(LOG_CreditPointChange, LOG_ActionNone, Self, g_Config.sCreditPointName, 0, '0', m_WAbil.CreditPoint,
          nOldPoint, '徒弟出师 +' + IntToStr(g_Config.nMasterOKCreditPoint));
      end;

      if g_Config.nMasterOKBonusPoint > 0 then
      begin
        nOldPoint := m_nBonusPoint;
        Inc(m_nBonusPoint, g_Config.nMasterOKBonusPoint);
        AddGameDataLog(LOG_AbilPointChange, LOG_ActionNone, Self, '未分配属性点', 0, '0', m_nBonusPoint, nOldPoint,
          '徒弟出师 +' + IntToStr(g_Config.nMasterOKBonusPoint));
      end;
      SendMsg(Self, RM_ADJUST_BONUS, 0, 0, 0, 0, '');

      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@UnMasterEnd', False); // 师傅触发 2014-10-11
      end;
      {
        if g_FunctionNPC <> nil then
        begin // 出师触发
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@MasterOK', False);
        end;
      }
    end;
  finally
    MasterTDList.Free;
  end;

  // 多师徒 chongchong 2014-10-11
  // if m_sMasterName = '' then Exit;
  if m_boMaster then
  begin
    // 师父上线通知各徒弟 chongchong 2014-10-12
    for I := 0 to m_MasterNoList.Count - 1 do
    begin
      MasterRankInfo := m_MasterNoList.Items[I];
      m_MasterHuman := UserEngine.GetPlayObject(MasterRankInfo.sChrName);
      if m_MasterHuman <> nil then
      begin
        m_MasterHuman.m_MasterHuman := Self;
        m_MasterList.Add(m_MasterHuman);
        // 师傅上线告诉自己徒弟位置 chongchong 2014-10-12
        sSayMsg := AnsiReplaceText(g_sMasterOnlineSelfMsg, '%n', MoneyToCharacter(MasterRankInfo.ID));
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', MasterRankInfo.sChrName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_MasterHuman.m_PEnvir.sMapDesc);
        sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_MasterHuman.m_nCurrX));
        sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_MasterHuman.m_nCurrY));
        SysMsg(sSayMsg, c_Blue, t_Hint);
        // 师傅上线告诉徒弟师傅自己的位置 chongchong 2014-10-12
        sSayMsg := AnsiReplaceText(g_sMasterOnlineMasterListMsg, '%d', m_sMasterName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_PEnvir.sMapDesc);
        sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_nCurrX));
        sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_nCurrY));
        m_MasterHuman.SysMsg(sSayMsg, c_Blue, t_Hint);
      end
      else
      begin
        // 师傅上线告诉自己的某徒弟不在线 chongchong 2014-10-12
        sSayMsg := AnsiReplaceText(g_sMasterNotOnlineMsg, '%n', MoneyToCharacter(MasterRankInfo.ID));
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', MasterRankInfo.sChrName);
        SysMsg(sSayMsg, c_Red, t_Hint);
      end;
    end;
  end
  else
  begin
    // 徒弟上线通知
    if m_sMasterName <> '' then
    begin
      m_MasterHuman := UserEngine.GetPlayObject(m_sMasterName);
      if m_MasterHuman <> nil then
      begin
        if m_MasterHuman.m_sMasterName = m_sCharName then
          m_MasterHuman.m_MasterHuman := Self;

        m_MasterHuman.m_MasterList.Add(Self);
        // 徒弟上线告诉自己师傅的位置 chongchong 2014-10-12
        sSayMsg := AnsiReplaceText(g_sMasterListOnlineSelfMsg, '%d', m_sMasterName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_MasterHuman.m_PEnvir.sMapDesc);
        sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_MasterHuman.m_nCurrX));
        sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_MasterHuman.m_nCurrY));
        SysMsg(sSayMsg, c_Blue, t_Hint);
        // 徒弟上线告诉师傅自己的位置 chongchong 2014-10-12
        sSayMsg := AnsiReplaceText(g_sMasterListOnlineMasterMsg, '%n', MoneyToCharacter(m_nMasterNo));
        sSayMsg := AnsiReplaceText(sSayMsg, '%d', m_sMasterName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_PEnvir.sMapDesc);
        sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_nCurrX));
        sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_nCurrY));
        m_MasterHuman.SysMsg(sSayMsg, c_Blue, t_Hint);
      end
      else
        SysMsg(g_sMasterListNotOnlineMsg, c_Red, t_Hint);
    end;
  end;
end;

procedure TPlayObject.MakeGhost;
var
  I: Integer;
  sSayMsg: string;
  Human: TPlayObject;
  GamePetData: pTGamePetData;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.MakeGhost';
begin
  try
    m_CurrTarget := nil;
    m_CurrTargetEx := nil;
    if g_Config.boUseHeroM2Shop then
    begin // 仿HeroM2摆摊
      for I := 0 to m_HeroM2ShopOpenList.Count - 1 do
      begin
        Human := TPlayObject(m_HeroM2ShopOpenList.Items[I]);
        if not Human.m_boGhost then
          Human.SendDefMessage(SM_HEROM2SENDCLOSESHOP, NativeInt(Self), 0, 0, 0, '');
      end;
      m_HeroM2ShopOpenList.Clear;
    end;

    if m_MyHero <> nil then
      THeroObject(m_MyHero).LogOut;

    m_MyHero := nil;
    m_dwRecallHeroTick := MyGetTickCount;
    if (g_HighLevelHuman = Self) then
      g_HighLevelHuman := nil;
    if (g_HighPKPointHuman = Self) then
      g_HighPKPointHuman := nil;
    if (g_HighDCHuman = Self) then
      g_HighDCHuman := nil;
    if (g_HighMCHuman = Self) then
      g_HighMCHuman := nil;
    if (g_HighSCHuman = Self) then
      g_HighSCHuman := nil;
    if (g_HighOnlineHuman = Self) then
      g_HighOnlineHuman := nil;

    // 人物下线后通知配偶，并把对方的相关记录清空
    if m_DearHuman <> nil then
    begin
      if m_btGender = 0 then
      begin
        sSayMsg := AnsiReplaceText(g_sManLongOutDearOnlineMsg, '%d', m_sDearName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_PEnvir.sMapDesc);
        sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_nCurrX));
        sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_nCurrY));
        m_DearHuman.SysMsg(sSayMsg, c_Red, t_Hint);
      end
      else
      begin
        sSayMsg := AnsiReplaceText(g_sWoManLongOutDearOnlineMsg, '%d', m_sDearName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_PEnvir.sMapDesc);
        sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_nCurrX));
        sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_nCurrY));
        m_DearHuman.SysMsg(sSayMsg, c_Red, t_Hint);
      end;
      m_DearHuman.m_DearHuman := nil;
      m_DearHuman := nil;
    end;

    if (m_MasterHuman <> nil) or (m_MasterList.Count > 0) then
    begin
      if m_boMaster then
      begin
        for I := 0 to m_MasterList.Count - 1 do
        begin
          Human := TPlayObject(m_MasterList.Items[I]);
          sSayMsg := AnsiReplaceText(g_sMasterLongOutMasterListOnlineMsg, '%s', m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_PEnvir.sMapDesc);
          sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_nCurrX));
          sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_nCurrY));
          Human.SysMsg(sSayMsg, c_Red, t_Hint);
          Human.m_MasterHuman := nil;
        end;
      end
      else
      begin
        if m_MasterHuman = nil then
          Exit;

        sSayMsg := AnsiReplaceText(g_sMasterListLongOutMasterOnlineMsg, '%n', MoneyToCharacter(m_nMasterNo));
        sSayMsg := AnsiReplaceText(sSayMsg, '%d', m_sMasterName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%m', m_PEnvir.sMapDesc);
        sSayMsg := AnsiReplaceText(sSayMsg, '%x', IntToStr(m_nCurrX));
        sSayMsg := AnsiReplaceText(sSayMsg, '%y', IntToStr(m_nCurrY));
        m_MasterHuman.SysMsg(sSayMsg, c_Red, t_Hint);
        // 如果为大徒弟则将对方的记录清空
        if m_MasterHuman.m_sMasterName = m_sCharName then
          m_MasterHuman.m_MasterHuman := nil;

        for I := m_MasterHuman.m_MasterList.Count - 1 downto 0 do
        begin // for i := 0 to m_MasterHuman.m_MasterList.Count - 1 do begin
          if m_MasterHuman.m_MasterList.Count <= 0 then
            Break;

          if m_MasterHuman.m_MasterList.Items[I] = Self then
          begin
            m_MasterHuman.m_MasterList.Delete(I);
            Break;
          end;
        end;
      end;
    end;

    if (m_MyGamePetIndex >= 0) and (m_MyGamePetIndex < m_GamePetList.Count) and (m_MyGamePet <> nil) then
    begin
      GamePetData := m_GamePetList.Items[m_MyGamePetIndex];
      GamePetData.Level := m_MyGamePet.m_WAbil.Level;
      GamePetData.HP := m_MyGamePet.m_WAbil.HP;
      GamePetData.MP := m_MyGamePet.m_WAbil.MP;
      GamePetData.Exp := m_MyGamePet.m_WAbil.Exp;
      m_MyGamePet.m_Master := nil;
      m_MyGamePet.MakeGhost;
      // 将当前宠物置空 2019-12-06 11:25:57
      m_MyGamePet := nil;
      m_MyGamePetIndex := -1;
    end;

    if m_MyGamePet <> nil then
    begin
      m_MyGamePet.m_Master := nil;
      m_MyGamePet.MakeGhost;
      // 将当前宠物置空 2019-12-06 11:25:57
      m_MyGamePet := nil;
      m_MyGamePetIndex := -1;
    end;
    g_M2DataDB.UserShopDB.UpdateHumanBusiness(m_sCharName, False);
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg);
      MainOutMessage(E.Message);
    end;
  end;
  inherited;
end;

