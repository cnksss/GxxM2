procedure TPlayObject.ClientTakeOffItems(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  btWhere: Byte;
  nItemIdx: Integer;
  sItemName: string;
  n10: Integer;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  sUserItemName: string;
  boMysteriousMan: Boolean;
label
  FailExit;
begin
  btWhere := ProcessMsg.nParam2;
  nItemIdx := ProcessMsg.nParam1;
  sItemName := ProcessMsg.sMsg;
  n10 := 0;
  boMysteriousMan := m_boMysteriousMan;
  if not m_boDealing and (btWhere in [Low(THumanUseItems) .. High(THumanUseItems)]) then
  begin
    if m_UseItems[btWhere].wIndex > 0 then
    begin
      if m_UseItems[btWhere].MakeIndex = nItemIdx then
      begin
        StdItem := UserEngine.GetStdItem(m_UseItems[btWhere].wIndex);
        if (StdItem <> nil) then
        begin
          if (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) then
          begin
            if (not m_boUserUnLockDurg) and (m_UseItems[btWhere].btValue[7] <> 0) then
            begin
              SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
              n10 := -4;
              goto FailExit;
            end;
          end;
          if not m_boUserUnLockDurg and ((StdItem.Reserved and 2) <> 0) then
          begin
            SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
            n10 := -4;
            goto FailExit;
          end;
          if (StdItem.Reserved and 4) <> 0 then
          begin
            SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
            n10 := -4;
            goto FailExit;
          end;
          if InDisableTakeOffList(m_UseItems[btWhere].wIndex) or
            (GetUserItemBindValue(@m_UseItems[btWhere], ubNoTakeOff) and m_UseItems[btWhere].boIsBind) then
          begin
            SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
            goto FailExit;
          end;
          if (m_UseItems[btWhere].btValue[13] = 1) and (m_UseItems[btWhere].Name <> '') then
            sUserItemName := m_UseItems[btWhere].Name
          else
            sUserItemName := UserEngine.GetStdItemName(m_UseItems[btWhere].wIndex);
          m_nCurrentItemMakeIndex := m_UseItems[btWhere].MakeIndex;
          m_nCurrentItemPos := btWhere;
          m_sCurrentItemName := UserEngine.GetStdItemName(m_UseItems[btWhere].wIndex);
          m_sCurrentItemNewName := sUserItemName;
          m_PickUpOrDropItem := m_UseItems[btWhere];
          m_boStopTakeOff := False;
          g_FunctionNPC.GotoLable(Self, '@BeginTakeOff', False);
          m_PickUpOrDropItem.MakeIndex := 0;
          m_PickUpOrDropItem.wIndex := 0;
          m_nCurrentItemMakeIndex := 0;
          m_nCurrentItemPos := 0;
          m_sCurrentItemName := '';
          m_sCurrentItemNewName := '';
          if m_boStopTakeOff then
          begin
            n10 := -4;
            goto FailExit;
          end;
          // 取自定义物品名称
          if (m_UseItems[btWhere].btValue[13] = 1) and (m_UseItems[btWhere].Name <> '') then
            sUserItemName := m_UseItems[btWhere].Name
          else
            sUserItemName := StdItem.Name;
          if CompareText(sUserItemName, sItemName) = 0 then
          begin
            if (StdItem <> nil) and (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) and m_boUserUnLockDurg and
              (m_UseItems[btWhere].btValue[7] <> 0) then
            begin // 使用过神水的神秘装备下次可以脱下来
              m_boUserUnLockDurg := False;
              m_UseItems[btWhere].btValue[7] := 0;
            end;
            New(UserItem);
            UserItem^ := m_UseItems[btWhere];
            if AddItemToBag(UserItem) then
            begin
              m_UseItems[btWhere].wIndex := 0;
              { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
              ProcessUseItemSkill(btWhere, StdItem, False);
              if StdItem.NeedIdentify = 1 then
              begin
                AddGameDataLog(LOG_ItemTakeOff, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0');
              end;
              SendAddItem(UserItem);
              RecalcAbilitys();
              SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
              SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
              SendDefMessage(SM_TAKEOFF_OK, 0, 0, 0, 0, '');
              FeatureChanged();
              n10 := 1; // 修改n10赋值，否则下面的判断不可能成立
              if boMysteriousMan <> m_boMysteriousMan then
                RefShowName;
              if g_FunctionNPC <> nil then
              begin
                m_nCurrentItemMakeIndex := UserItem.MakeIndex;
                m_nCurrentItemPos := btWhere;
                m_sCurrentItemName := StdItem.Name;
                m_sCurrentItemNewName := sUserItemName;
                m_nScriptGotoCount := 0;
                m_PickUpOrDropItem := UserItem^;
                g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(btWhere), False);
                g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
                m_PickUpOrDropItem.MakeIndex := 0;
                m_PickUpOrDropItem.wIndex := 0;
                m_nCurrentItemMakeIndex := 0;
                m_nCurrentItemPos := 0;
                m_sCurrentItemName := '';
                m_sCurrentItemNewName := '';
              end;
            end
            else
            begin
              Dispose(UserItem);
              n10 := -3;
            end;
          end;
        end;
      end;
    end
    else
      n10 := -2;
  end
  else
    n10 := -1;
FailExit:
  if n10 <= 0 then
    SendDefMessage(SM_TAKEOFF_FAIL, n10, 0, 0, 0, '');
end;

{ TODO -ochongchong -c增加 吃药时间间隔按职业和药品类型分【2013-07-16】 }
procedure TPlayObject.ClientUseItems(ProcessMsg: pTProcessMessage; var boResult: Boolean);
// 解包物品扩展 chongchong 2014-05-15
  function GetUnbindItemInfo(nShape: Integer): PTUnbindItemInfo;
  var
    I: Integer;
    UnbindItemInfo: PTUnbindItemInfo;
  begin
    Result := nil;
    for I := 0 to g_UnbindList.Count - 1 do
    begin
      UnbindItemInfo := g_UnbindList.Items[I];
      if UnbindItemInfo.nShape = nShape then
      begin
        Result := g_UnbindList[I];
        Break;
      end;
    end;
  end;
  function GetUnBindItems(BindItem: pTUserItem; sItemName: string; nCount: Integer; IsDuraMax: Boolean): Boolean;
  var
    I: Integer;
    OverLapItem: pTUserItem;
    UserItem: pTUserItem;
    StdItem: pTStdItem;
    nDura: Integer;
  begin
    Result := False;
    StdItem := UserEngine.GetStdItem(sItemName);
    for I := 0 to nCount - 1 do
    begin
      if IsDuraMax then
        nDura := StdItem.DuraMax - 1
      else
        nDura := 0;
      if StdItem <> nil then
        OverLapItem := OverLapItems(Self, StdItem, nDura)
      else
        OverLapItem := nil;
      if (OverLapItem = nil) then
      begin
        New(UserItem);
        if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
        begin
          UserItem.ItemFrom := BindItem.ItemFrom;
          if IsDuraMax then
            UserItem.Dura := UserItem.DuraMax - 1;
          m_ItemList.Add(UserItem);
          SendAddItem(UserItem);
          Result := True;
        end
        else
        begin
          Dispose(UserItem);
          Break;
        end;
      end;
    end;
  end;
  function FoundUserItem(MakeIndex: Integer; var FindItem: pTUserItem; var FindIndex: Integer): Boolean;
  var
    I: Integer;
    UserItem: pTUserItem;
  begin
    Result := False;
    for I := 0 to m_ItemList.Count - 1 do
    begin
      UserItem := m_ItemList.Items[I];
      if (UserItem <> nil) and (UserItem.MakeIndex = MakeIndex) then
      begin
        Result := True;
        FindIndex := I;
        FindItem := UserItem;
        Break;
      end;
    end;
  end;

var
  nMakeIndex: Integer;
  I, II: Integer;
  boEatOK: Boolean;
  boChangeDura, boChangeWeight: Boolean;
  NewWeight: Byte;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  UserItem34: TUserItem;
  OverLapStdItem: pTStdItem;
  OverLapItem: pTUserItem;
  nError: Integer;
  dwClientUseItemsTick: PLongWord;
  dwUseIntervalTime, HeroGetExp: LongWord;
  UseBox: PTBox;
  nCount, NeedBagCount: Integer;
  UnbindItemInfo: PTUnbindItemInfo;
  GamePetData: pTGamePetData;
  MonInfo: pTMonInfo;
  DecDura: Integer;
  nTempValue: LongWord;
  MagicIndex: Integer;
  FindItem: pTUserItem;
  FindIndex: Integer;
  RetType: TGamePetAddMagicResultType;
resourcestring
  sExceptionMsg1 = '[Exception] TPlayObject.ClientUseItems %d';
begin
  boEatOK := False;
  boChangeDura := False;
  boChangeWeight := False;
  NewWeight := 0;
  StdItem := nil;
  nError := 0;
  nMakeIndex := ProcessMsg.nParam1;
  // 地图参数 piaoyun 2013-07-25
  if m_PEnvir.m_boMISSION then
  begin
    SysMsg('本地图不允许使用任何物品！', c_Red, t_System);
    SendDefMessage(SM_EAT_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  DoClientAction(catUseItem);
  if ProcessMsg.wIdent = CM_EAT then
    dwClientUseItemsTick := @m_dwClientUseItemsTick // 手动使用物品
  else
    dwClientUseItemsTick := @m_dwClientAutoUseItemsTick; // 内挂自动吃药
  try
    nError := 1;
    m_CurrUserItem := nil;
    nError := 2;
    // if not m_boDeath then
    begin
      for I := m_ItemList.Count - 1 downto 0 do
      begin
        if m_ItemList.Count <= 0 then
          Break;
        UserItem := m_ItemList.Items[I];
        nError := 3;
        if (UserItem = nil) or (UserItem.MakeIndex <> nMakeIndex) then
          Continue;
        nError := 4;
        UserItem34 := UserItem^;
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem = nil then
          Continue;
        // 不是31类物品，人物死亡不支持使用
        if m_boDeath and (StdItem.StdMode <> 31) then
          Break;
        nError := 411;
        if (StdItem.StdMode = 31) and (((StdItem.Reserved = 0) and m_boDeath) or ((StdItem.Reserved <> 0) and (not m_boDeath)))
        then
        begin
          Break;
        end;
        nError := 412;
        // 传送系列物品使用不要间隔 chongchong 2018-07-11 17:19:18
        if ((StdItem.StdMode = 2) and (StdItem.Shape in [1, 2, 3])) or // 传送石系列
          ((StdItem.StdMode = 3) and (StdItem.Shape in [1, 2, 3, 5])) then // 传送卷系列
        begin
          dwUseIntervalTime := 0
        end
        else
        begin
          dwUseIntervalTime := g_Config.dwUseItemIntervalTime; // 非药品使用时间间隔
          if StdItem.StdMode = 0 then
          begin
            nError := 413;
            if m_btJob = 0 then // 战士
            begin
              if StdItem.Shape = 0 then // 普通样品
                dwUseIntervalTime := g_Config.dwUseOrdinaryTime_Human_Warrior
              else if StdItem.Shape in [1, 101, 102] then // 特殊样品
                dwUseIntervalTime := g_Config.dwUseSpecialTime_Human_Warrior;
            end
            else if m_btJob in [1, 2] then // 道士/法师
            begin
              if StdItem.Shape = 0 then // 普通样品
                dwUseIntervalTime := g_Config.dwUseOrdinaryTime_Human_TaoistAndWizard
              else if StdItem.Shape in [1, 101, 102] then // 特殊样品
                dwUseIntervalTime := g_Config.dwUseSpecialTime_Human_TaoistAndWizard;
            end;
          end
          else if StdItem.StdMode = 95 then
          begin
            dwUseIntervalTime := g_Config.dwUseAttackItemIntervalTime;
          end;
        end;
        if not(m_boCanUseItem and (MyGetTickCount - dwClientUseItemsTick^ > dwUseIntervalTime) and (m_WAbil.HP > 0)) then
        begin
          nError := 414;
          // 使用物品超速排除吃药 chongchong 2013-12-11
          if m_boCanUseItem and (m_WAbil.HP > 0) and g_Config.boViewHackMessage and
            (not((StdItem.StdMode in [0, 1]) or ((StdItem.StdMode = 3) and (StdItem.Shape = 12)))) then
            MainOutMessage(Format(g_sUseItemOverSpeed, [m_sCharName, MyGetTickCount - dwClientUseItemsTick^]));
          // 排除死亡可用的物品 chongchong 2015-08-20
          if not((StdItem.StdMode = 31) and (StdItem.Reserved <> 0) and m_boDeath) then
            Break;
        end;
        nError := 415;
        dwClientUseItemsTick^ := MyGetTickCount();
        if m_PEnvir.m_boFight4Zone then
        begin
          if ProcessMsg.wIdent = CM_EAT then
            SendDefMessage(SM_EAT_FAIL, 0, 0, 0, 0, '')
          else
            SendDefMessage(SM_AUTOEAT_FAIL, 0, 0, 0, 0, '');
          // SysMsg('当前地图禁止使用物品！', c_Red, t_Hint);
          // SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, '当前地图不允许使用物品！'); //Format(g_sCanotMapUseItemMsg, [sItemName])
          Exit;
        end;
        nError := 5;
        if not m_PEnvir.AllowStdItems(UserItem34.wIndex) then
        begin
          if ProcessMsg.wIdent = CM_EAT then
            SendDefMessage(SM_EAT_FAIL, 0, 0, 0, 0, '')
          else
            SendDefMessage(SM_AUTOEAT_FAIL, 0, 0, 0, 0, '');
          nError := 6;
          // SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, Format(g_sCanotMapUseItemMsg, [StdItem.Name]));
          SysMsg(Format(g_sCanotMapUseItemMsg, [StdItem.Name]), g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
          nError := 7;
          Exit;
        end;
        nError := 101;
        case StdItem.StdMode of
          0, 1, 3:
            begin // 药  , 2
              nError := 8;
              if CheckOverLapItem(StdItem) and (UserItem.Dura > 0) then
              begin
                nError := 9;
                if EatItems(StdItem) then
                begin
                  UserItem.Dura := UserItem.Dura - 1;
                  UserItem34 := UserItem^;
                  boChangeDura := True;
                  boEatOK := False;
                  WeightChanged();
                  boChangeWeight := True;
                  NewWeight := OverLapItemWeight(StdItem, UserItem.Dura);
                end;
                nError := 10;
              end
