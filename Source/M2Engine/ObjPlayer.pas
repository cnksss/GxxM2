{ 取商铺中的商品列表 }
procedure TPlayObject.ClientGetShopItems(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nShopType, nPage: Integer;
  I, nIndex, nCount, nC: Integer;
  pStdItem: pTStdItem;
  ShopItem: pTShopItem;
  ShopClientItem: pTShopClientItem;
  ItemList: TList;
  InBuf: array [0 .. 102400] of AnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
begin
  nShopType := ProcessMsg.nParam1;
  nPage := ProcessMsg.nParam2;
  if not((nShopType in [0 .. 5]) and (nPage >= 0)) then
    Exit;
  if g_SndaShopList = nil then
    Exit;
  { TODO -ochongchong -c新增 : 密码保护系统 - 系统锁定时，根据选项来控制是否禁止商铺 【2013-07-22】 }
  if m_boLockLogon and m_boPasswordLocked and g_Config.boLockShop { and (nShopType = 5) } then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if m_PEnvir.m_boNoShop then
  begin
    SysMsg(g_sMapCannotShopMsg, c_Red, t_Hint);
    m_DefMsg := MakeDefaultMsg(SM_SENGSHOPITEMS, MakeLong(0, 0), 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if g_boStopRun then
    Exit;
  ItemList := g_SndaShopList.Items[nShopType];
  if ItemList.Count = 0 then
    Exit;
  nIndex := Min(ItemList.Count - 1, nPage);
  if nShopType < 5 then
    nCount := Min(ItemList.Count - 1, nIndex + 9)
  else
    nCount := Min(ItemList.Count - 1, nIndex + 4);
  nC := (nCount - nIndex + 1);
  InBytes := nC * SizeOf(TShopClientItem);
  if InBytes > 0 then
  begin
    Buffer := @InBuf;
    for I := nIndex to nCount do
    begin
      ShopItem := ItemList.Items[I];
      pStdItem := UserEngine.GetStdItem(ShopItem.StdItem.Name);
      if pStdItem <> nil then
      begin
        // 物品如果在物品规则增加了禁止寄售后，商铺出售就会显示错乱 chongchong 2013-11-13
        (*
          { TODO -ochongchong -c新增 : 物品规则 - 禁止寄售【2013-07-27】 }
          if (Length(pStdItem.Name) > 0) and g_ItemRules.Get(pStdItem.Name, 8) then
          Continue;
        *)
        ShopClientItem := pTShopClientItem(Buffer);
        // Move(ShopItem.StdItem, ShopClientItem.StdItem, SizeOf(TStdItem));
        ShopClientItem.StdItem := ShopItem.StdItem;
        ShopItem.StdItem := pStdItem^;
        ShopItem.StdItem.Price := ShopClientItem.StdItem.Price;
        ShopClientItem.StdItem := ShopItem.StdItem;
        // ShopClientItem.btHeroM2Light := 0;
        ShopClientItem.GameMoney := ShopItem.GameMoney;
        ShopClientItem.ImageIndex := ShopItem.ImageIndex;
        ShopClientItem.ImageCount := ShopItem.ImageCount;
        ShopClientItem.Memo1 := ShopItem.Memo1;
        ShopClientItem.Memo2 := ShopItem.Memo2;
        ShopClientItem.ItemCount := ShopItem.ItemCount;
        ShopClientItem.boBulkBuy := ShopItem.boBulkBuy;
        ShopClientItem.nBulkBuyCount := ShopItem.nBulkBuyCount;
        Buffer := Buffer + SizeOf(TShopClientItem);
      end;
    end;
    if InBytes > 0 then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SENGSHOPITEMS, MakeLong(nC, InBytes), nShopType, nIndex, ItemList.Count);
      SendSocketEx(@m_DefMsg, InBuf, InBytes);
    end;
  end;
end;

procedure TPlayObject.ClientBuyShopItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function CheckGameMoney(ShopItem: pTShopItem; nItemPrice: Int64): Boolean;
  begin
    Result := False;
    case ShopItem.GameMoney of
      0:
        Result := Int64(m_nGameGold) >= nItemPrice;
      1:
        Result := Int64(m_nGold) >= nItemPrice;
      2:
        Result := Int64(m_nGamePoint) >= nItemPrice;
      3:
        Result := Int64(m_nGameDiamond) >= nItemPrice;
      4:
        Result := Int64(m_nGameGird) >= nItemPrice;
    end;
  end;
  procedure DecGameMoney(ShopItem: pTShopItem; BuyCount: Integer; nItemPrice: Int64);
  var
    sMoneyType: string;
  begin
    m_sString[0] := ShopItem.StdItem.DBName;
    m_nMval[0] := nItemPrice;
    m_nMval[1] := ShopItem.GameMoney;
    m_nMval[2] := ShopItem.ItemCount;
    m_nMval[3] := BuyCount;
    case ShopItem.GameMoney of
      0:
        begin
          sMoneyType := g_Config.sGameGoldName;
          DecGameGold(nItemPrice);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GameGoldChange, Self, ShopItem.StdItem.DBName, 0, g_Config.sGameGoldName,
              m_nGameGold, -nItemPrice, '购买商铺物品-扣费');
          end;
        end;
      1:
        begin
          sMoneyType := sSTRING_GOLDNAME;
          if DecGold(nItemPrice) then
            GoldChanged;

          if g_boGameLogGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GoldChange, Self, ShopItem.StdItem.DBName, 0, sSTRING_GOLDNAME, m_nGold,
              -nItemPrice, '购买商铺物品-扣费');
          end;
        end;
      2:
        begin
          sMoneyType := g_Config.sGamePointName;
          DecGamePoint(nItemPrice);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GamePointChange, Self, ShopItem.StdItem.DBName, 0, g_Config.sGamePointName,
              m_nGamePoint, -nItemPrice, '购买商铺物品-扣费');
          end;
        end;
      3:
        begin
          sMoneyType := g_Config.sGameDiamondName;
          DecGameDiamond(nItemPrice);
          NewGamePointChanged();
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GameDiamondChange, Self, ShopItem.StdItem.DBName, 0, g_Config.sGameDiamondName,
              m_nGameDiamond, -nItemPrice, '购买商铺物品-扣费');
          end;
        end;
      4:
        begin
          sMoneyType := g_Config.sGameGirdName;
          DecGameGird(nItemPrice);
          NewGamePointChanged();
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GameGirdChange, Self, ShopItem.StdItem.DBName, 0, g_Config.sGameGirdName,
              m_nGameGird, -nItemPrice, '购买商铺物品-扣费');
          end;
        end;
    end;
    m_sString[1] := sMoneyType;
    if g_FunctionNPC <> nil then
    begin
      try
        g_FunctionNPC.GotoLable(Self, '@BuyShopItem', False);
      except
      end;
    end;
  end;

var
  n01, nItemCount, nGameMoney, nItemPrice, nShopCount, nBuyCount, nGiveItemCount: Integer;
  nTotalPrice: Int64;
  UserItem: pTUserItem;
  ShopItem: pTShopItem;
  StdItem: pTStdItem;
  OverLapItem: pTUserItem;
  I: Integer;
  IsBuyOK: Boolean;
  OverLapCount: Integer;
  NeedBagCount: Integer;
  TempItem: TUserItem;
  nBuyGameMoney: Byte;
begin
  n01 := 0;
  nGameMoney := 0;
  if g_OnlineMsgControl.boDisableBuy then
    Exit;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if m_PEnvir.m_boNoShop then
  begin
    SysMsg(g_sMapCannotShopMsg, c_Red, t_Hint);
    Exit;
  end;
  nBuyCount := ProcessMsg.wParam;
  nBuyGameMoney := ProcessMsg.nParam1;
  if g_SndaShopList <> nil then
  begin
    ShopItem := g_SndaShopList.GetEx(ProcessMsg.sMsg, nBuyGameMoney);
    if ShopItem = nil then
      ShopItem := g_SndaShopList.Get(ProcessMsg.sMsg);
    if ShopItem <> nil then
    begin
      if not ShopItem.boBulkBuy then
        nBuyCount := 1
      else
      begin
        if (nBuyCount <= 0) then
          nBuyCount := 1
        else if nBuyCount > ShopItem.nBulkBuyCount then
          nBuyCount := ShopItem.nBulkBuyCount;
      end;
      if not g_ItemRules.Get(UserEngine.GetStdItemIdx(ShopItem.StdItem.Name), 14) then
        nItemPrice := Round(ShopItem.StdItem.Price / 100 * m_nShopItemPriceRate)
      else
        nItemPrice := ShopItem.StdItem.Price;
      nGameMoney := ShopItem.GameMoney;
      // 交易数量  chongchong 2013-12-28
      nShopCount := ShopItem.ItemCount * nBuyCount;
      nTotalPrice := Int64(nItemPrice) * nBuyCount;
      if (nTotalPrice > 0) and (CheckGameMoney(ShopItem, nTotalPrice)) then
      begin
        nItemCount := ShopItem.StdItem.Need;
        nGiveItemCount := nItemCount * nBuyCount;
        if CompareLStr(ProcessMsg.sMsg, sSTRING_GOLDNAME, Length(sSTRING_GOLDNAME)) then
        begin
          if IncGold(nGiveItemCount) then
            GoldChanged();

          DecGameMoney(ShopItem, nBuyCount, nTotalPrice);
          SysMsg(Format('获得%d%s！', [nGiveItemCount, sSTRING_GOLDNAME]), c_Red, t_Hint);
          if g_boGameLogGold then
          begin
            AddGameDataLog(LOG_ItemBuy, LOG_GoldChange, Self, ProcessMsg.sMsg, 0, '0', m_nGold, LongWord(nGiveItemCount),
              '获得购买商铺物品');
          end;
          Exit;
        end
        else if CompareLStr(ProcessMsg.sMsg, g_Config.sGameGoldName, Length(g_Config.sGameGoldName)) then
        begin
          IncGameGold(nGiveItemCount);
          GameGoldChanged();
          DecGameMoney(ShopItem, nBuyCount, nTotalPrice);
          SysMsg(Format('获得%d个%s！', [nGiveItemCount, g_Config.sGameGoldName]), c_Red, t_Hint);
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuy, LOG_GameGoldChange, Self, ProcessMsg.sMsg, 0, '0', m_nGameGold, LongWord(nGiveItemCount),
              '获得购买商铺物品');
          end;
          Exit;
        end
        else if CompareLStr(ProcessMsg.sMsg, g_Config.sGamePointName, Length(g_Config.sGamePointName)) then
        begin
          IncGamePoint(nGiveItemCount);
          GameGoldChanged();
          DecGameMoney(ShopItem, nBuyCount, nTotalPrice);
          SysMsg(Format('获得%d点%s！', [nGiveItemCount, g_Config.sGamePointName]), c_Red, t_Hint);
          if g_boGameLogGamePoint then
          begin
            AddGameDataLog(LOG_ItemBuy, LOG_GamePointChange, Self, ProcessMsg.sMsg, 0, '0', m_nGamePoint,
              LongWord(nGiveItemCount), '获得购买商铺物品');
          end;
          Exit;
        end
        else if CompareLStr(ProcessMsg.sMsg, g_Config.sCreditPointName, Length(g_Config.sCreditPointName)) then
        begin
          if m_WAbil.CreditPoint + LongWord(nGiveItemCount) > High(Integer) then
          begin
            m_WAbil.CreditPoint := High(Integer);
          end
          else
          begin
            Inc(m_WAbil.CreditPoint, LongWord(nGiveItemCount));
          end;
          SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
          DecGameMoney(ShopItem, nBuyCount, nTotalPrice);
          SysMsg(Format('获得%d点声望！', [LongWord(nGiveItemCount)]), c_Red, t_Hint);
          // 声望日志
          AddGameDataLog(LOG_ItemBuy, LOG_CreditPointChange, Self, ProcessMsg.sMsg, 0, '0', m_WAbil.CreditPoint,
            LongWord(nGiveItemCount), '获得购买购买商铺物品');
          Exit;
        end
        else if CompareLStr(ProcessMsg.sMsg, g_Config.sGameDiamondName, Length(g_Config.sGameDiamondName)) then
        begin // 金刚石
          IncGameDiamond(nGiveItemCount);
          NewGamePointChanged();
          DecGameMoney(ShopItem, nBuyCount, nTotalPrice);
          SysMsg(Format('获得%d个%s！', [nGiveItemCount, g_Config.sGameDiamondName]), c_Red, t_Hint);
          AddGameDataLog(LOG_ItemBuy, LOG_GameDiamondChange, Self, ProcessMsg.sMsg, 0, '0', m_nGameDiamond,
            LongWord(nGiveItemCount), '获得购买商铺物品');
          Exit;
        end
        else if CompareLStr(ProcessMsg.sMsg, g_Config.sGameGirdName, Length(g_Config.sGameGirdName)) then
        begin // 灵符
          IncGameGird(nGiveItemCount);
          NewGamePointChanged();
          DecGameMoney(ShopItem, nBuyCount, nTotalPrice);
          SysMsg(Format('获得%d张%s！', [nGiveItemCount, g_Config.sGameGirdName]), c_Red, t_Hint);
          AddGameDataLog(LOG_ItemBuy, LOG_GameGirdChange, Self, ProcessMsg.sMsg, 0, '0', m_nGameGird, LongWord(nGiveItemCount),
            '获得购买商铺物品');
          Exit;
        end
        else if CompareLStr(ProcessMsg.sMsg, '经验', Length('经验')) then
        begin
          GetExp(nGiveItemCount);
          DecGameMoney(ShopItem, nBuyCount, nTotalPrice);
          SysMsg(Format('获得%d经验！', [nGiveItemCount]), c_Red, t_Hint);
          Exit;
        end;
        StdItem := UserEngine.GetStdItem(ProcessMsg.sMsg);
        if StdItem <> nil then
        begin
          // 修正商城购买叠加物品时不叠加及数量错误 chongchong 2014-04-15
          if CheckOverLapItem(StdItem) then
          begin
            // 修正叠加物品购买没有判断包裹空间是否够用 chongchong 2014-04-16
            if UserEngine.CopyToUserItemFromName(ProcessMsg.sMsg, @TempItem) then
            begin
              NeedBagCount := nShopCount div TempItem.DuraMax;
              if nShopCount mod TempItem.DuraMax <> 0 then
                Inc(NeedBagCount);
              if IsEnoughBagEx(NeedBagCount) then
              begin
                while nShopCount > 0 do
                begin
                  OverLapCount := OverLapBagItemCount(Self, StdItem, OverLapItem);
                  if (OverLapCount > 0) and (OverLapItem <> nil) then
                  begin
                    OverLapCount := Min(OverLapCount, nShopCount);
                    OverLapItem.Dura := OverLapItem.Dura + OverLapCount;
                    // Min(OverLapItem.Dura + OverLapCount, OverLapItem.DuraMax - 1);
                    Dec(nShopCount, OverLapCount);
                    SendUpdateItemDura(-1, OverLapItem.MakeIndex, False, OverLapItem.Dura);
                  end
                  else
                  begin
                    New(UserItem);
                    if UserEngine.CopyToUserItemFromName(ProcessMsg.sMsg, UserItem) then
                    begin
                      UserItem.ItemFrom.ItemForm := ifShopBuy;
                      UserItem.ItemFrom.sMakerName := m_sCharName;
                      UserItem.ItemFrom.DateTime := Now();
                      if UserItem.DuraMax > nShopCount then
                      begin
                        UserItem.Dura := nShopCount - 1;
                        nShopCount := 0;
                      end
                      else
                      begin
                        UserItem.Dura := UserItem.DuraMax - 1;
                        nShopCount := nShopCount - UserItem.DuraMax;
                      end;
                      m_ItemList.Add(UserItem);
                      SendAddItem(UserItem);
                    end
                    else
                      Break;
                  end;
                end;
                DecGameMoney(ShopItem, nBuyCount, nTotalPrice);
                Exit;
              end
              else
                n01 := -3;
            end
            else
              n01 := -1;
          end
          else
          begin
            IsBuyOK := False;
            // 店铺同一物品一次卖多个 chongchong 2013-12-28
            if IsEnoughBagEx(nShopCount) then
            begin
              for I := 0 to nShopCount - 1 do
              begin
                New(UserItem);
                if UserEngine.CopyToUserItemFromName(ProcessMsg.sMsg, UserItem) then
                begin
                  UserItem.ItemFrom.ItemForm := ifShopBuy;
                  UserItem.ItemFrom.sMakerName := m_sCharName;
                  UserItem.ItemFrom.DateTime := Now();
                  if CheckOverLapItem(StdItem) then
                    UserItem.Dura := Min(StdItem.DuraMax, Max(ShopItem.StdItem.Need, 1)) - 1; // UserItem.DuraMax - 1;
                  m_ItemList.Add(UserItem);
                  SendAddItem(UserItem);
                  IsBuyOK := True;
                  if (StdItem.NeedIdentify = 1) then
                  begin
                    AddGameDataLog(LOG_ItemBuy, LOG_ActionNone, Self, ProcessMsg.sMsg, UserItem.MakeIndex, '0', 0, -nTotalPrice,
                      '生成商铺购买物品');
                  end;
                  n01 := 1;
                end
                else
                  Dispose(UserItem);
              end;
            end
            else
              n01 := -3;
            // 修复商铺一次购买多个物品多次扣费 chongchong 2014-03-06
            if IsBuyOK then
              DecGameMoney(ShopItem, nBuyCount, nTotalPrice);
          end;
        end
        else
          n01 := -1;
      end
      else
        n01 := -2;
    end
    else
      n01 := -1;
  end;
  if n01 <= 0 then
    SendDefMessage(SM_BUYSHOPITEM_FAIL, n01, nGameMoney, 0, 0, '')
  else
    WeightChanged;
end;

