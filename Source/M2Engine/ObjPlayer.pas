procedure TPlayObject.ClientChgItemToMyShop(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 修改我的商店中的物品
var
  UserShopItem: TSimpleUserShopItem;
  UserShop: TUserShop;
  StdItem: pTStdItem;
  boAllowSell: Boolean;
  boOK: Boolean;
  boNeedRef: Boolean;
  nMakeIndex, nPos, nItemType, nMoneyType, nPrice: Integer;
  sItemName: string;
  LowestSellingPrice: PLowestSellingPrice;
  HighestSellingPrice: PHighestSellingPrice;
begin
  nMakeIndex := ProcessMsg.nParam1;
  nPos := HiByte(ProcessMsg.wParam) mod 2;
  nItemType := HiByte(ProcessMsg.wParam) div 2;
  nMoneyType := LoByte(ProcessMsg.wParam);
  nPrice := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  sItemName := ProcessMsg.sMsg;

  if MyGetTickCount - m_dwQueryUserShopItemTime < g_Config.nMyShopOperateInterval then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -1, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  m_dwQueryUserShopItemTime := MyGetTickCount;
  if not m_PEnvir.m_boAllowUseMyshop then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -10, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  if not(nPos in [0, 1]) then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -2, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  if not g_M2DataDB.UserShopDB.GetUserShopInfo(m_sCharName, UserShop) then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -3, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  case nMoneyType of
    0: // 元宝
      begin
        if not g_Config.boMyShopGameGold then
        begin
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          SysMsg('添加物品失败，不支持的货币类型 ' + g_Config.sGameGoldName, 255, 253, t_Hint);
          Exit;
        end;
      end;
    1: // 游戏点
      begin
        if not g_Config.boMyShopGamePoint then
        begin
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          SysMsg('添加物品失败，不支持的货币类型 ' + g_Config.sGamePointName, 255, 253, t_Hint);
          Exit;
        end;
      end;
    2: // 金币
      begin
        if not g_Config.boMyShopGold then
        begin
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          SysMsg('添加物品失败，不支持的货币类型 ' + sSTRING_GOLDNAME, 255, 253, t_Hint);
          Exit;
        end;
      end;
    3: // 金币石
      begin
        if not g_Config.boMyShopGameDiamond then
        begin
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          SysMsg('添加物品失败，不支持的货币类型 ' + g_Config.sGameDiamondName, 255, 253, t_Hint);
          Exit;
        end;
      end;
    4: // 灵符
      begin
        if not g_Config.boMyShopGameGird then
        begin
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          SysMsg('添加物品失败，不支持的货币类型 ' + g_Config.sGameGirdName, 255, 253, t_Hint);
          Exit;
        end;
      end;
  end;

  if nPos = 0 then
  begin
    if nPrice <= 0 then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -4, 0, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    LowestSellingPrice := GetLowestSellingPrice(sItemName);
    if LowestSellingPrice <> nil then
    begin
      case nMoneyType of
        0:
          begin
            if (nPrice < LowestSellingPrice.nGameGoldPice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGameGoldPice) + g_Config.sGameGoldName + ']，请重新定价',
                255, 253, t_Hint);
              Exit;
            end;
          end;
        1:
          begin
            if (nPrice < LowestSellingPrice.nGamePointPrice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGamePointPrice) + g_Config.sGamePointName + ']，请重新定价',
                255, 253, t_Hint);
              Exit;
            end;
          end;
        2:
          begin
            if (nPrice < LowestSellingPrice.nGoldPrice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGoldPrice) + sSTRING_GOLDNAME + ']，请重新定价', 255,
                253, t_Hint);
              Exit;
            end;
          end;
        3:
          begin
            if (nPrice < LowestSellingPrice.nGameDiamondPice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGameDiamondPice) + g_Config.sGameDiamondName +
                ']，请重新定价', 255, 253, t_Hint);
              Exit;
            end;
          end;
        4:
          begin
            if (nPrice < LowestSellingPrice.nGameGameGirdPrice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGameGameGirdPrice) + g_Config.sGameGirdName +
                ']，请重新定价', 255, 253, t_Hint);
              Exit;
            end;
          end;
      end;
    end;

    HighestSellingPrice := GetHighestSellingPrice(sItemName);
    if HighestSellingPrice <> nil then
    begin
      case nMoneyType of
        0:
          begin
            if (nPrice > HighestSellingPrice.nGameGoldPice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGameGoldPice) + g_Config.sGameGoldName + ']，请重新定价',
                255, 253, t_Hint);
              Exit;
            end;
          end;
        1:
          begin
            if (nPrice > HighestSellingPrice.nGamePointPrice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGamePointPrice) + g_Config.sGamePointName + ']，请重新定价',
                255, 253, t_Hint);
              Exit;
            end;
          end;
        2:
          begin
            if (nPrice > HighestSellingPrice.nGoldPrice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGoldPrice) + sSTRING_GOLDNAME + ']，请重新定价', 255,
                253, t_Hint);
              Exit;
            end;
          end;
        3:
          begin
            if (nPrice > HighestSellingPrice.nGameDiamondPice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGameDiamondPice) + g_Config.sGameDiamondName +
                ']，请重新定价', 255, 253, t_Hint);
              Exit;
            end;
          end;
        4:
          begin
            if (nPrice > HighestSellingPrice.nGameGameGirdPrice) then
            begin
              m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              SysMsg('添加出售物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGameGameGirdPrice) + g_Config.sGameGirdName +
                ']，请重新定价', 255, 253, t_Hint);
              Exit;
            end;
          end;
      end;
    end;
  end;

  boOK := False;
  boNeedRef := False;
  boAllowSell := (nPos = 0);
  if g_M2DataDB.UserShopDB.GetHumanItemWithMakeIndex(True, m_sCharName, sitSellingAndStorage, nMakeIndex, UserShopItem) then
  begin
    sItemName := UserEngine.GetStdItemName(UserShopItem.wIndex);
    if (UserShopItem.btAllowSell <> 0) <> boAllowSell then
    begin
      // 检测是否存满
      if boAllowSell then
      begin
        if UserShop.SellItemCount >= g_Config.nMaxMyShopSellingItemCount then
        begin
          m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -7, g_Config.nMaxMyShopSellingItemCount, 0, 0);
          SendSocket(@m_DefMsg, '');
          Exit;
        end;
      end
      else if UserShop.StorageItemCount >= g_Config.nMaxMyShopStorageItemCount then
      begin
        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -8, g_Config.nMaxMyShopStorageItemCount, 0, 0);
        SendSocket(@m_DefMsg, '');
        Exit;
      end;

      if UserShopItem.btAllowSell <> 0 then
      begin
        if (GetUserItemBindValue(UserShopItem.btBindOption, ubNoStorage) and UserShopItem.boIsBind) or
          g_ItemRules.Get(UserShopItem.wIndex, 9) then
        begin // 禁止存仓库
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -6, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          Exit
        end;

        UserShopItem.btItemType := nItemType;
        UserShopItem.btMoneyType := nMoneyType;
        UserShopItem.nPrice := nPrice;
        UserShopItem.btAllowSell := 0;
        if g_M2DataDB.UserShopDB.UpdateItem(UserShop.ShopID, UserShopItem.ItemID, UserShopItem.btItemType,
          UserShopItem.btAllowSell, UserShopItem.btMoneyType, UserShopItem.nPrice) then
        begin
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_OK, 0, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          boNeedRef := True;
          boOK := True;
          StdItem := UserEngine.GetStdItem(UserShopItem.wIndex);
          if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
            AddGameDataLog(LOG_ItemMove, LOG_ActionNone, Self, StdItem.Name, UserShopItem.MakeIndex, '个人商店', 0, 0, '店铺->店铺仓库')
        end;
      end
      else
      begin
        if (GetUserItemBindValue(UserShopItem.btBindOption, ubNoSell) and UserShopItem.boIsBind) or
          g_ItemRules.Get(UserShopItem.wIndex, 8) then
        begin // 禁止出售
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -5, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          Exit
        end;

        UserShopItem.btItemType := nItemType;
        UserShopItem.btMoneyType := nMoneyType;
        UserShopItem.nPrice := nPrice;
        UserShopItem.btAllowSell := 1;
        if g_M2DataDB.UserShopDB.UpdateItem(UserShop.ShopID, UserShopItem.ItemID, UserShopItem.btItemType,
          UserShopItem.btAllowSell, UserShopItem.btMoneyType, UserShopItem.nPrice) then
        begin
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_OK, 0, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          boOK := True;
          boNeedRef := True;
          StdItem := UserEngine.GetStdItem(UserShopItem.wIndex);
          if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
            AddGameDataLog(LOG_ItemMove, LOG_ActionNone, Self, StdItem.Name, UserShopItem.MakeIndex, '个人商店', 0, 0, '店铺仓库->店铺')
        end;
      end;
    end
    else
    begin
      if not g_Config.boProhibitModifyPrices then // 禁止修改价格 Cursor 2023-05-30 11:32:03
      begin
        UserShopItem.btItemType := nItemType;
        UserShopItem.btMoneyType := nMoneyType;
        UserShopItem.nPrice := nPrice;
        if g_M2DataDB.UserShopDB.UpdateItem(UserShop.ShopID, UserShopItem.ItemID, UserShopItem.btItemType,
          UserShopItem.btAllowSell, UserShopItem.btMoneyType, UserShopItem.nPrice) then
        begin
          m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_OK, 0, 0, 0, 0);
          SendSocket(@m_DefMsg, '');
          boOK := True;
        end;
      end
      else
      begin
        m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -12, 0, 0, 0);
        SendSocket(@m_DefMsg, '');
        Exit
      end;
    end;
  end;

  if not boOK then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDCHANGEMYSHOPITEM_FAIL, -4, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
  end
  else
  begin
    if boNeedRef then
    begin
      if nPos = 0 then
        SendQueryMyShopItem(0, m_MyShopItem_ItemType, m_MyShopItem_MoneyType, m_MyShopItem_SortType, m_MyShopItem_MinPrice,
          m_MyShopItem_MaxPrice, m_sMyShopItem_Keyword)
      else
        SendQueryMyShopItem(2, m_MyShopItem_ItemType, m_MyShopItem_MoneyType, m_MyShopItem_SortType, m_MyShopItem_MinPrice,
          m_MyShopItem_MaxPrice, m_sMyShopItem_Keyword);
    end;
    SendQuerySelectShopInfo(m_sCharName);
  end;
end;

procedure TPlayObject.ClientMoveMyShopItem(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 个人商店取回物品
var
  I: Integer;
  UserShopItem: TSimpleUserShopItem;
  UserShop: TUserShop;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  boOK: Boolean;
  nMakeIndex, nOldPos, nNewPos: Integer;
  sItemName: string;
  LowestSellingPrice: PLowestSellingPrice;
  HighestSellingPrice: PHighestSellingPrice;
  ShopItemType: TShopItemType;
  RefreshIndexArr: array [0 .. 1] of Integer;
begin
  nMakeIndex := ProcessMsg.nParam1;
  nOldPos := ProcessMsg.nParam2;
  nNewPos := ProcessMsg.nParam3;
  sItemName := ProcessMsg.sMsg;
  RefreshIndexArr[0] := -1;
  RefreshIndexArr[1] := -1;
  if (MyGetTickCount - m_dwQueryUserShopItemTime < g_Config.nMyShopOperateInterval) or m_WaitClientMoveMyShopItem then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -1, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if not m_PEnvir.m_boAllowUseMyshop then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -10, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if (not(nOldPos in [0, 1])) or (not(nNewPos in [0 .. 2])) or (nOldPos = nNewPos) then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -2, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if not g_M2DataDB.UserShopDB.GetUserShopInfo(m_sCharName, UserShop) then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -3, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;
  m_WaitClientMoveMyShopItem := True;
  try
    m_dwQueryUserShopItemTime := MyGetTickCount;
    boOK := False;
    ShopItemType := sitSelling;
    // 0 出售 1仓库 2取回
    case nOldPos of
      0:
        begin
          ShopItemType := sitSelling;
        end;
      1:
        begin
          ShopItemType := sitStorage;
        end;
    end;
    if g_M2DataDB.UserShopDB.GetHumanItemWithMakeIndex(True, m_sCharName, ShopItemType, nMakeIndex, UserShopItem) then
    begin
      sItemName := UserEngine.GetStdItemName(UserShopItem.wIndex);
      if (g_FunctionNPC <> nil) then
      begin
        New(UserItem);
        g_M2DataDB.LoadItemFromDB(UserItem, UserShopItem.ShopID, USERSHOP_ITEM_TYPE, UserShopItem.ItemID);
        StdItem := UserEngine.GetStdItem(UserShopItem.wIndex);
        if (StdItem <> nil) and CheckOverLapItem(StdItem) then
          m_CurrentItemOverlapCount := UserItem.Dura + 1
        else
          m_CurrentItemOverlapCount := 0;
        m_nCurrentItemMakeIndex := UserItem.MakeIndex;
        m_sCurrentItemName := UserEngine.GetStdItemName(UserItem.wIndex);
        if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
          m_sCurrentItemNewName := UserItem.Name
        else
          m_sCurrentItemNewName := UserEngine.GetStdItemName(UserItem.wIndex);
        m_btCurItemMoneyTypeValue := UserShopItem.btMoneyType;
        case UserShopItem.btMoneyType of
          0:
            m_sCurItemMoneyType := g_Config.sGameGoldName;
          1:
            m_sCurItemMoneyType := g_Config.sGamePointName;
          2:
            m_sCurItemMoneyType := sSTRING_GOLDNAME;
          3:
            m_sCurItemMoneyType := g_Config.sGameDiamondName;
          4:
            m_sCurItemMoneyType := g_Config.sGameGirdName;
        end;
        m_nCurItemPrices := UserShopItem.nPrice;
        // m_sCurrentOperateUserName := sCharName;
        m_boStopShopItem := False;
        g_FunctionNPC.GotoLable(Self, '@BeginShopItemDown', False);
        m_nCurrentItemMakeIndex := 0;
        m_sCurrentItemName := '';
        m_sCurrentItemNewName := '';
        m_btCurItemMoneyTypeValue := 0;
        m_sCurItemMoneyType := '';
        m_nCurItemPrices := 0;
        // m_sCurrentOperateUserName := '';
        m_CurrentItemOverlapCount := 0;
        Dispose(UserItem);
        if m_boStopShopItem then
        begin
          Exit;
        end;
      end;
      case nNewPos of // 移动到正在出售
        0:
          begin
            if UserShopItem.btAllowSell = 0 then
            begin
              if (GetUserItemBindValue(UserShopItem.btBindOption, ubNoSell) and UserShopItem.boIsBind) or
                g_ItemRules.Get(UserShopItem.wIndex, 8) then
              begin // 禁止出售
                m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -4, 0, 0, 0);
                SendSocket(@m_DefMsg, '');
                Exit
              end;
              if g_ItemRules.Get(UserShopItem.wIndex, 9) then
              begin // 禁止存入个人商店
                m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -11, 0, 0, 0);
                SendSocket(@m_DefMsg, '');
                Exit
              end;
              if UserShopItem.nPrice <= 0 then
              begin
                m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -5, 0, 0, 0);
                SendSocket(@m_DefMsg, '');
                Exit;
              end;
              case UserShopItem.btMoneyType of
                0: // 元宝
                  begin
                    if not g_Config.boMyShopGameGold then
                    begin
                      m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                      SendSocket(@m_DefMsg, '');
                      SysMsg('移到正在出售失败，不支持的货币类型 ' + g_Config.sGameGoldName, 255, 253, t_Hint);
                      Exit;
                    end;
                  end;
                1: // 游戏点
                  begin
                    if not g_Config.boMyShopGamePoint then
                    begin
                      m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                      SendSocket(@m_DefMsg, '');
                      SysMsg('移到正在出售失败，不支持的货币类型 ' + g_Config.sGamePointName, 255, 253, t_Hint);
                      Exit;
                    end;
                  end;
                2: // 金币
                  begin
                    if not g_Config.boMyShopGold then
                    begin
                      m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                      SendSocket(@m_DefMsg, '');
                      SysMsg('移到正在出售失败，不支持的货币类型 ' + sSTRING_GOLDNAME, 255, 253, t_Hint);
                      Exit;
                    end;
                  end;
                3: // 金币石
                  begin
                    if not g_Config.boMyShopGameDiamond then
                    begin
                      m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                      SendSocket(@m_DefMsg, '');
                      SysMsg('移到正在出售失败，不支持的货币类型 ' + g_Config.sGameDiamondName, 255, 253, t_Hint);
                      Exit;
                    end;
                  end;
                4: // 灵符
                  begin
                    if not g_Config.boMyShopGameGird then
                    begin
                      m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                      SendSocket(@m_DefMsg, '');
                      SysMsg('移到正在出售失败，不支持的货币类型 ' + g_Config.sGameGirdName, 255, 253, t_Hint);
                      Exit;
                    end;
                  end;
              end;
              // 检测最低售价 - 元宝
              LowestSellingPrice := GetLowestSellingPrice(sItemName);
              if LowestSellingPrice <> nil then
              begin
                case UserShopItem.btMoneyType of
                  0:
                    begin
                      if (UserShopItem.nPrice < LowestSellingPrice.nGameGoldPice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGameGoldPice) + g_Config.sGameGoldName +
                          ']，请重新定价', 255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                  1:
                    begin
                      if (UserShopItem.nPrice < LowestSellingPrice.nGamePointPrice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGamePointPrice) + g_Config.sGamePointName +
                          ']，请重新定价', 255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                  2:
                    begin
                      if (UserShopItem.nPrice < LowestSellingPrice.nGoldPrice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGoldPrice) + sSTRING_GOLDNAME + ']，请重新定价',
                          255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                  3:
                    begin
                      if (UserShopItem.nPrice < LowestSellingPrice.nGameDiamondPice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGameDiamondPice) + g_Config.sGameDiamondName
                          + ']，请重新定价', 255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                  4:
                    begin
                      if (UserShopItem.nPrice < LowestSellingPrice.nGameGameGirdPrice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGameGameGirdPrice) + g_Config.sGameGirdName +
                          ']，请重新定价', 255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                end;
              end;
              HighestSellingPrice := GetHighestSellingPrice(sItemName);
              if HighestSellingPrice <> nil then
              begin
                case UserShopItem.btMoneyType of
                  0:
                    begin
                      if (UserShopItem.nPrice > HighestSellingPrice.nGameGoldPice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGameGoldPice) + g_Config.sGameGoldName +
                          ']，请重新定价', 255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                  1:
                    begin
                      if (UserShopItem.nPrice > HighestSellingPrice.nGamePointPrice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGamePointPrice) + g_Config.sGamePointName +
                          ']，请重新定价', 255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                  2:
                    begin
                      if (UserShopItem.nPrice > HighestSellingPrice.nGoldPrice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGoldPrice) + sSTRING_GOLDNAME + ']，请重新定价',
                          255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                  3:
                    begin
                      if (UserShopItem.nPrice > HighestSellingPrice.nGameDiamondPice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGameDiamondPice) + g_Config.sGameDiamondName
                          + ']，请重新定价', 255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                  4:
                    begin
                      if (UserShopItem.nPrice > HighestSellingPrice.nGameGameGirdPrice) then
                      begin
                        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
                        SendSocket(@m_DefMsg, '');
                        SysMsg('移到正在出售失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGameGameGirdPrice) + g_Config.sGameGirdName
                          + ']，请重新定价', 255, 253, t_Hint);
                        Exit;
                      end;
                    end;
                end;
              end;
              // 检测是否存满
              if UserShop.SellItemCount >= g_Config.nMaxMyShopSellingItemCount then
              begin
                m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -8, g_Config.nMaxMyShopSellingItemCount, 0, 0);
                SendSocket(@m_DefMsg, '');
                Exit;
              end;
              UserShopItem.dCreateDate := Now;
              UserShopItem.btAllowSell := 1;
              RefreshIndexArr[0] := 0;
              RefreshIndexArr[1] := 2;
              if g_M2DataDB.UserShopDB.UpdateItem(UserShop.ShopID, UserShopItem.ItemID, UserShopItem.btItemType,
                UserShopItem.btAllowSell, UserShopItem.btMoneyType, UserShopItem.nPrice) then
              begin
                m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_OK, 0, 0, 0, 0);
                SendSocket(@m_DefMsg, '');
                boOK := True;
                StdItem := UserEngine.GetStdItem(UserShopItem.wIndex);
                if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
                begin
                  AddGameDataLog(LOG_ItemMove, LOG_ActionNone, Self, StdItem.Name, UserShopItem.MakeIndex, '个人商店', 0, 0,
                    '店铺仓库->店铺')
                end;
              end;
            end;
          end;
        1:
          begin // 移动到仓库
            if UserShopItem.btAllowSell <> 0 then
            begin
              if (GetUserItemBindValue(UserShopItem.btBindOption, ubNoStorage) and UserShopItem.boIsBind) or
                g_ItemRules.Get(UserShopItem.wIndex, 9) then
              begin // 禁止存仓库
                m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -6, 0, 0, 0);
                SendSocket(@m_DefMsg, '');
                Exit
              end;

              // 检测是否存满
              if UserShop.StorageItemCount >= g_Config.nMaxMyShopStorageItemCount then
              begin
                m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -9, g_Config.nMaxMyShopStorageItemCount, 0, 0);
                SendSocket(@m_DefMsg, '');
                Exit;
              end;

              UserShopItem.btAllowSell := 0;
              if g_M2DataDB.UserShopDB.UpdateItem(UserShop.ShopID, UserShopItem.ItemID, UserShopItem.btItemType,
                UserShopItem.btAllowSell, UserShopItem.btMoneyType, UserShopItem.nPrice) then
              begin
                m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_OK, 0, 0, 0, 0);
                SendSocket(@m_DefMsg, '');
                boOK := True;
                RefreshIndexArr[0] := 0;
                RefreshIndexArr[1] := 2;
                StdItem := UserEngine.GetStdItem(UserShopItem.wIndex);
                if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
                begin
                  AddGameDataLog(LOG_ItemMove, LOG_ActionNone, Self, StdItem.Name, UserShopItem.MakeIndex, '个人商店', 0, 0,
                    '店铺->店铺仓库')
                end;
              end;
            end;
          end;
        2:
          begin // 移动到包裹
            New(UserItem);
            // UserItem^ := UserShopItem.UserItem;
            if AddItemToBag(UserItem) then
            begin
              g_M2DataDB.LoadItemFromDB(UserItem, UserShopItem.ShopID, USERSHOP_ITEM_TYPE, UserShopItem.ItemID);
              if g_M2DataDB.UserShopDB.DeleteItem(UserShop.ShopID, UserShopItem.ItemID) then
              begin
                m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_OK, 0, 0, 0, 0);
                SendSocket(@m_DefMsg, '');
                SendAddItem(UserItem);
                if UserShopItem.btAllowSell <> 0 then
                  RefreshIndexArr[0] := 0
                else
                  RefreshIndexArr[0] := 2;
                boOK := True;
                StdItem := UserEngine.GetStdItem(UserShopItem.wIndex);
                if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
                begin
                  if UserShopItem.btAllowSell <> 0 then
                  begin
                    AddGameDataLog(LOG_ItemTakeBack, LOG_ActionNone, Self, StdItem.Name, UserShopItem.MakeIndex, '个人商店');
                  end
                  else
                  begin
                    AddGameDataLog(LOG_ItemTakeBack, LOG_ActionNone, Self, StdItem.Name, UserShopItem.MakeIndex, '个人商店仓库');
                  end;
                end;
              end;
            end
            else
            begin
              Dispose(UserItem);
              m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -7, 0, 0, 0);
              SendSocket(@m_DefMsg, '');
              Exit;
            end;
          end;
      end;
    end;
    if not boOK then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -99, 0, 0, 0);
      SendSocket(@m_DefMsg, '');
    end
    else
    begin
      for I := Low(RefreshIndexArr) to High(RefreshIndexArr) do
      begin
        if RefreshIndexArr[I] <> -1 then
          SendQueryMyShopItem(RefreshIndexArr[I], m_MyShopItem_ItemType, m_MyShopItem_MoneyType, m_MyShopItem_SortType,
            m_MyShopItem_MinPrice, m_MyShopItem_MaxPrice, m_sMyShopItem_Keyword);
      end;
      SendQuerySelectShopInfo(m_sCharName);
    end;
  finally
    m_WaitClientMoveMyShopItem := False;
  end;
end;

procedure TPlayObject.ClientShopStallStatus(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  UserShop: TUserShop;
begin
  if MyGetTickCount - m_dwQueryUserShopTime < 100 then
    Exit;
  m_dwQueryUserShopTime := MyGetTickCount;
  if g_M2DataDB.UserShopDB.GetUserShopInfo(m_sCharName, UserShop) then
  begin
    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@ShopStall', False);
    end;
  end;
end;

procedure TPlayObject.ClientBuyUserShopItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function CheckGameMoney(UserShopItem: pTSimpleUserShopItem): Boolean;
  begin
    case UserShopItem.btMoneyType of
      0:
        Result := m_nGameGold >= UserShopItem.nPrice; // 游戏币
      1:
        Result := m_nGamePoint >= UserShopItem.nPrice; // 游戏点
      2:
        Result := m_nGold >= UserShopItem.nPrice; // 金币数量
      3:
        Result := m_nGameDiamond >= UserShopItem.nPrice; // 金刚石
      4:
        Result := m_nGameGird >= UserShopItem.nPrice; // 灵符
    else
      Result := CheckMoney(UserShopItem.btMoneyType - 5, UserShopItem.nPrice);
    end;
  end;

  procedure DecGameMoney(UserShopItem: pTSimpleUserShopItem; ShopUserName: string);
  var
    nValue: Integer;
  begin
    case UserShopItem.btMoneyType of
      0:
        begin
          // OldValue := m_nGameGold;
          DecGameGold(UserShopItem.nPrice);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GameGoldChange, Self, g_Config.sGameGoldName, UserShopItem.MakeIndex,
              ShopUserName, m_nGameGold, -UserShopItem.nPrice, '个人商店');
          end;
        end;
      1: // 排除
        begin
          // OldValue := m_nGamePoint;
          DecGamePoint(UserShopItem.nPrice);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GamePointChange, Self, g_Config.sGamePointName, UserShopItem.MakeIndex,
              ShopUserName, m_nGamePoint, -UserShopItem.nPrice, '个人商店');
          end;
        end;
      2:
        begin
          // OldValue := m_nGold;
          if DecGold(UserShopItem.nPrice) then
            GoldChanged;

          if g_boGameLogGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GoldChange, Self, sSTRING_GOLDNAME, UserShopItem.MakeIndex, ShopUserName,
              m_nGold, -UserShopItem.nPrice, '个人商店');
          end;
        end;
      3:
        begin
          // OldValue := m_nGameDiamond;
          DecGameDiamond(UserShopItem.nPrice);
          NewGamePointChanged();
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GameDiamondChange, Self, g_Config.sGameDiamondName, UserShopItem.MakeIndex,
              ShopUserName, m_nGameDiamond, -UserShopItem.nPrice, '个人商店');
          end;
        end;
      4:
        begin
          // OldValue := m_nGameGird;
          DecGameGird(UserShopItem.nPrice);
          NewGamePointChanged();
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GameGirdChange, Self, g_Config.sGameGirdName, UserShopItem.MakeIndex,
              ShopUserName, m_nGameGird, -UserShopItem.nPrice, '个人商店');
          end;
        end;
    else
      DecMoney(UserShopItem.btMoneyType - 5, UserShopItem.nPrice, nValue);
    end;
  end;

var
  UserShop: TUserShop;
  UserObject: TPlayObject;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  nMakeIndex: Integer;
  sCharName: string;
  ClientMoneyType: Byte;
  ClientPrice: Integer;
  UserShopItem: TSimpleUserShopItem;
begin
  if g_OnlineMsgControl.boDisableBuy then
    Exit;

  { TODO -ochongchong -c新增 : 密码保护系统 - 系统锁定时，根据选项来控制是否禁止使用店铺 【2013-07-23】 }
  if m_boLockLogon and m_boPasswordLocked and g_Config.boLockStall then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;

  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;

  nMakeIndex := ProcessMsg.nParam1;
  sCharName := ProcessMsg.sMsg;
  // ProcessMsg.nParam2=0 用户店铺购买 ProcessMsg.nParam2=1 搜索物品列表购买
  if MyGetTickCount - m_dwQueryUserShopTime < 100 then
    Exit;

  m_dwQueryUserShopTime := MyGetTickCount;
  if not m_PEnvir.m_boAllowUseMyshop then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -10, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  if not g_M2DataDB.UserShopDB.GetUserShopInfo(sCharName, UserShop) then
  begin
    m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -1, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  if g_M2DataDB.UserShopDB.GetHumanItemWithMakeIndex(False, sCharName, sitSelling, nMakeIndex, UserShopItem) then
  begin
    if UserShopItem.sBuyName <> '' then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -3, 0, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if UserShopItem.btAllowSell <> 1 then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -4, 0, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if UserShopItem.nPrice <= 0 then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -5, UserShopItem.btMoneyType, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if not CheckGameMoney(@UserShopItem) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -5, UserShopItem.btMoneyType, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    case UserShopItem.btMoneyType of
      0: // 元宝
        begin
          if not g_Config.boMyShopGameGold then
          begin
            m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
            SendSocket(@m_DefMsg, '');
            SysMsg('购买物品失败，不支持的货币类型 ' + g_Config.sGameGoldName, 255, 253, t_Hint);
            Exit;
          end;
        end;
      1: // 游戏点
        begin
          if not g_Config.boMyShopGamePoint then
          begin
            m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
            SendSocket(@m_DefMsg, '');
            SysMsg('购买物品失败，不支持的货币类型 ' + g_Config.sGamePointName, 255, 253, t_Hint);
            Exit;
          end;
        end;
      2: // 金币
        begin
          if not g_Config.boMyShopGold then
          begin
            m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
            SendSocket(@m_DefMsg, '');
            SysMsg('购买物品失败，不支持的货币类型 ' + sSTRING_GOLDNAME, 255, 253, t_Hint);
            Exit;
          end;
        end;
      3: // 金币石
        begin
          if not g_Config.boMyShopGameDiamond then
          begin
            m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
            SendSocket(@m_DefMsg, '');
            SysMsg('购买物品失败，不支持的货币类型 ' + g_Config.sGameDiamondName, 255, 253, t_Hint);
            Exit;
          end;
        end;
      4: // 灵符
        begin
          if not g_Config.boMyShopGameGird then
          begin
            m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
            SendSocket(@m_DefMsg, '');
            SysMsg('购买物品失败，不支持的货币类型 ' + g_Config.sGameGirdName, 255, 253, t_Hint);
            Exit;
          end;
        end;
    else
      if GetCustomMoneyNameByRule(UserShopItem.btMoneyType, 0) = '' then
      begin
        m_DefMsg := MakeDefaultMsg(SM_SENDADDTOMYSHOP_FAIL, -11, 0, 0, 0);
        SendSocket(@m_DefMsg, '');
        SysMsg('购买物品失败，不支持的货币类型 ' + GetCustomMoneyName(UserShopItem.btMoneyType), 255, 253, t_Hint);
        Exit;
      end;
    end;

    if not IsEnoughBag then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -6, 0, 0, 0);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    // 修正：a先开别人(b)的商店进入物品列表。当b修改商品后，a直接购买会以新的价格购买而没有任何提示
    // if not IsOldClient then
    begin
      ClientPrice := MakeLong(ProcessMsg.nParam3, ProcessMsg.wParam);
      ClientMoneyType := ProcessMsg.nParam2 and $0F;
      // 还原物品来源类型 chongchong 2016-08-29
      ProcessMsg.nParam2 := (ProcessMsg.nParam2 and $F0) shr 4;
      if (ClientMoneyType <> UserShopItem.btMoneyType) or (ClientPrice <> UserShopItem.nPrice) then
      begin
        m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -8, 0, 0, 0);
        SendSocket(@m_DefMsg, '');
        Exit;
      end;
    end;

    StdItem := UserEngine.GetStdItem(UserShopItem.wIndex);
    UserObject := UserEngine.GetPlayObject(sCharName);
    if UserObject <> nil then
    begin
      // 在不在线都不取款，让玩家手动取款
      // IncGameMoney(UserObject, UserShopItem, nTGameGoldCount, nTGamePointCount, nTGoldCount, nTGameDiamondCount, nTGameGirdCount, StdItem);
      // UserShopItem.boGetMoney := True;
    end
    else
    begin
      if g_Config.boOfflineCloseMyShop then
      begin
        m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -7, 0, 0, 0);
        SendSocket(@m_DefMsg, '');
        Exit;
      end;
    end;

    New(UserItem);
    // UserItem^ := UserShopItem.UserItem;
    g_M2DataDB.LoadItemFromDB(UserItem, UserShopItem.ShopID, USERSHOP_ITEM_TYPE, UserShopItem.ItemID);
    AddItemToBag(UserItem);
    SendAddItem(UserItem);
    if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
    begin
      AddGameDataLog(LOG_ItemSell, LOG_ActionNone, latHuman, m_sMapName, m_nCurrX, m_nCurrY, StdItem.Name, UserItem.MakeIndex,
        sCharName, m_sCharName, 0, 0, '个人商店, 待取款');
      AddGameDataLog(LOG_ItemBuy, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, sCharName, 0, 0, '个人商店');
    end;

    DecGameMoney(@UserShopItem, sCharName);
    UserShopItem.sBuyName := m_sCharName;
    g_M2DataDB.UserShopDB.BuyItem(UserShop.ShopID, UserShopItem.ItemID, m_sCharName);
    m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_OK, nMakeIndex, ProcessMsg.nParam2, 0, 0);
    SendSocket(@m_DefMsg, '');

    if (g_FunctionNPC <> nil) then
    begin
      if (StdItem <> nil) and CheckOverLapItem(StdItem) then
        m_CurrentItemOverlapCount := UserItem.Dura + 1
      else
        m_CurrentItemOverlapCount := 0;

      m_nCurrentItemMakeIndex := UserItem.MakeIndex;
      m_sCurrentItemName := UserEngine.GetStdItemName(UserItem.wIndex);

      if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
        m_sCurrentItemNewName := UserItem.Name
      else
        m_sCurrentItemNewName := UserEngine.GetStdItemName(UserItem.wIndex);

      m_btCurItemMoneyTypeValue := UserShopItem.btMoneyType;
      case UserShopItem.btMoneyType of
        0:
          m_sCurItemMoneyType := g_Config.sGameGoldName;
        1:
          m_sCurItemMoneyType := g_Config.sGamePointName;
        2:
          m_sCurItemMoneyType := sSTRING_GOLDNAME;
        3:
          m_sCurItemMoneyType := g_Config.sGameDiamondName;
        4:
          m_sCurItemMoneyType := g_Config.sGameGirdName;
      else
        m_sCurItemMoneyType := GetCustomMoneyNameByRule(UserShopItem.btMoneyType, 0);
      end;

      m_nCurItemPrices := UserShopItem.nPrice;
      m_sCurrentOperateUserName := sCharName;
      g_FunctionNPC.GotoLable(Self, '@BuyUserItem', False);
      if (UserObject <> nil) and (not UserObject.m_boOffLine)then begin
        UserObject.m_sCurrentOperateUserName := sCharName;
        UserObject.m_nCurrentItemMakeIndex := UserItem.MakeIndex;
        UserObject.m_sCurrentItemName := m_sCurrentItemName;
        UserObject.m_sCurrentItemNewName := m_sCurrentItemNewName;
        UserObject.m_CurrentItemOverlapCount := m_CurrentItemOverlapCount;
        UserObject.m_nCurItemPrices := m_nCurItemPrices;
        UserObject.m_btCurItemMoneyTypeValue := m_btCurItemMoneyTypeValue;
        UserObject.m_sCurItemMoneyType := m_sCurItemMoneyType;
        g_FunctionNPC.GotoLable(UserObject, '@SelledUserItem', False);
        SendMyShopItems(1, UserObject.m_MyShopItem_SelledIndex);
        SendQuerySelectShopInfo(UserObject.m_sCharName);
      end;


      m_nCurrentItemMakeIndex := 0;
      m_sCurrentItemName := '';
      m_sCurrentItemNewName := '';
      m_btCurItemMoneyTypeValue := 0;
      m_sCurItemMoneyType := '';
      m_nCurItemPrices := 0;
      m_sCurrentOperateUserName := '';
      m_CurrentItemOverlapCount := 0;
      if UserObject <> nil then begin
        UserObject.m_sCurrentOperateUserName := '';
        UserObject.m_nCurrentItemMakeIndex := 0;
        UserObject.m_sCurrentItemName := '';
        UserObject.m_sCurrentItemNewName := '';
        UserObject.m_CurrentItemOverlapCount := 0;
        UserObject.m_nCurItemPrices := 0;
        UserObject.m_btCurItemMoneyTypeValue := 0;
        UserObject.m_sCurItemMoneyType := '';
      end;
    end;

    if UserObject <> nil then
    begin
      case UserShopItem.btMoneyType of
        0:
          begin
            // 向卖家发送信息
            UserObject.SysMsg(Format(g_sUserShopSellerMsg, [m_sCharName, UserShopItem.nPrice, g_Config.sGameGoldName,
              UserEngine.GetStdItemName(UserShopItem.wIndex)]), 255, 253, t_Hint);
            // 向买家发送信息
            SysMsg(Format(g_sUserShopBuyerMsg, [UserShopItem.sMasterName, UserEngine.GetStdItemName(UserShopItem.wIndex),
              UserShopItem.nPrice, g_Config.sGameGoldName]), 255, 253, t_Hint);
          end;
        1:
          begin
            UserObject.SysMsg(Format(g_sUserShopSellerMsg, [m_sCharName, UserShopItem.nPrice, g_Config.sGamePointName,
              UserEngine.GetStdItemName(UserShopItem.wIndex)]), 255, 253, t_Hint);
            SysMsg(Format(g_sUserShopBuyerMsg, [UserShopItem.sMasterName, UserEngine.GetStdItemName(UserShopItem.wIndex),
              UserShopItem.nPrice, g_Config.sGamePointName]), 255, 253, t_Hint);
          end;
        2:
          begin
            // 向卖家发送信息
            UserObject.SysMsg(Format(g_sUserShopSellerMsg, [m_sCharName, UserShopItem.nPrice, sSTRING_GOLDNAME,
              UserEngine.GetStdItemName(UserShopItem.wIndex)]), 255, 253, t_Hint);
            // 向买家发送信息
            SysMsg(Format(g_sUserShopBuyerMsg, [UserShopItem.sMasterName, UserEngine.GetStdItemName(UserShopItem.wIndex),
              UserShopItem.nPrice, sSTRING_GOLDNAME]), 255, 253, t_Hint);
          end;
        3:
          begin
            // 向卖家发送信息
            UserObject.SysMsg(Format(g_sUserShopSellerMsg, [m_sCharName, UserShopItem.nPrice, g_Config.sGameDiamondName,
              UserEngine.GetStdItemName(UserShopItem.wIndex)]), 255, 253, t_Hint);
            // 向买家发送信息
            SysMsg(Format(g_sUserShopBuyerMsg, [UserShopItem.sMasterName, UserEngine.GetStdItemName(UserShopItem.wIndex),
              UserShopItem.nPrice, g_Config.sGameDiamondName]), 255, 253, t_Hint);
          end;
        4:
          begin
            // 向卖家发送信息
            UserObject.SysMsg(Format(g_sUserShopSellerMsg, [m_sCharName, UserShopItem.nPrice, g_Config.sGameGirdName,
              UserEngine.GetStdItemName(UserShopItem.wIndex)]), 255, 253, t_Hint);
            // 向买家发送信息
            SysMsg(Format(g_sUserShopBuyerMsg, [UserShopItem.sMasterName, UserEngine.GetStdItemName(UserShopItem.wIndex),
              UserShopItem.nPrice, g_Config.sGameGirdName]), 255, 253, t_Hint);
          end;
      else
        // 向卖家发送信息
        UserObject.SysMsg(Format(g_sUserShopSellerMsg, [m_sCharName, UserShopItem.nPrice,
          GetCustomMoneyNameByRule(UserShopItem.btMoneyType, 0), UserEngine.GetStdItemName(UserShopItem.wIndex)]), 255,
          253, t_Hint);
        // 向买家发送信息
        SysMsg(Format(g_sUserShopBuyerMsg, [UserShopItem.sMasterName, UserEngine.GetStdItemName(UserShopItem.wIndex),
          UserShopItem.nPrice, GetCustomMoneyNameByRule(UserShopItem.btMoneyType, 0)]), 255, 253, t_Hint);
      end;

      UserObject.SendQueryMyShopItem(0, UserObject.m_MyShopItem_ItemType, UserObject.m_MyShopItem_MoneyType,
        UserObject.m_MyShopItem_SortType, UserObject.m_MyShopItem_MinPrice, UserObject.m_MyShopItem_MaxPrice,
        UserObject.m_sMyShopItem_Keyword);

      UserObject.SendQueryMyShopItem(1, UserObject.m_MyShopItem_ItemType, UserObject.m_MyShopItem_MoneyType,
        UserObject.m_MyShopItem_SortType, UserObject.m_MyShopItem_MinPrice, UserObject.m_MyShopItem_MaxPrice,
        UserObject.m_sMyShopItem_Keyword);

      UserObject.SendQuerySelectShopInfo(UserObject.m_sCharName);
    end
    else // 购买离线玩家的商品
    begin
      case UserShopItem.btMoneyType of // 向买家发送信息
        0:
          SysMsg(Format(g_sUserShopBuyerMsg, [UserShopItem.sMasterName, UserEngine.GetStdItemName(UserShopItem.wIndex),
            UserShopItem.nPrice, g_Config.sGameGoldName]), 255, 253, t_Hint);
        2:
          SysMsg(Format(g_sUserShopBuyerMsg, [UserShopItem.sMasterName, UserEngine.GetStdItemName(UserShopItem.wIndex),
            UserShopItem.nPrice, sSTRING_GOLDNAME]), 255, 253, t_Hint);
      end;
    end;
    Exit;
  end;

  m_DefMsg := MakeDefaultMsg(SM_SENDBUYUSERSHOPITEM_FAIL, -99, 0, 0, 0);
  SendSocket(@m_DefMsg, '');
end;

procedure TPlayObject.ClientDeleteMyShopSelledItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  procedure IncGameMoney(UserShopItem: pTSimpleUserShopItem; var nTGameGoldCount, nTGamePointCount, nTGoldCount,
    nTGameDiamondCount, nTGameGirdCount, nTCustomMoneyCount: Integer);
  var
    nValue: Integer;
  begin
    case UserShopItem.btMoneyType of
      0:
        begin
          // OldValue := m_nGameGold;
          // 离线购买物品、上线后取款扣税 piaoyun 2013-07-21
          nTGameGoldCount := Trunc(g_Config.dwSellOffGameGoldTaxRate / 100 * UserShopItem.nPrice);
          IncGameGold(UserShopItem.nPrice - nTGameGoldCount);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GameGoldChange, Self, g_Config.sGameGoldName, UserShopItem.MakeIndex,
              UserShopItem.sBuyName, m_nGameGold, UserShopItem.nPrice - nTGameGoldCount, '个人商店取款');
          end;
        end;
      1:
        begin
          // OldValue := m_nGamePoint;
          nTGamePointCount := Trunc(g_Config.dwSellOffGamePointTaxRate / 100 * UserShopItem.nPrice);
          IncGamePoint(UserShopItem.nPrice - nTGamePointCount);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GamePointChange, Self, g_Config.sGamePointName, UserShopItem.MakeIndex,
              UserShopItem.sBuyName, m_nGamePoint, UserShopItem.nPrice - nTGamePointCount, '个人商店取款');
          end;
        end;
      2:
        begin
          // OldValue := m_nGold;
          nTGoldCount := Trunc(g_Config.dwSellOffGoldTaxRate / 100 * UserShopItem.nPrice);
          if IncGold(UserShopItem.nPrice - nTGoldCount) then
            GoldChanged;

          if g_boGameLogGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GoldChange, Self, sSTRING_GOLDNAME, UserShopItem.MakeIndex, UserShopItem.sBuyName,
              m_nGold, UserShopItem.nPrice - nTGoldCount, '个人商店取款');
          end;
        end;
      3:
        begin
          // OldValue := m_nGameDiamond;
          nTGameDiamondCount := Trunc(g_Config.dwSellOffGameDiamondTaxRate / 100 * UserShopItem.nPrice);
          IncGameDiamond(UserShopItem.nPrice - nTGameDiamondCount);
          NewGamePointChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GameDiamondChange, Self, g_Config.sGameDiamondName, UserShopItem.MakeIndex,
              UserShopItem.sBuyName, m_nGameDiamond, UserShopItem.nPrice - nTGameDiamondCount, '个人商店取款');
          end;
        end;
      4:
        begin
          // OldValue := m_nGameGird;
          nTGameGirdCount := Trunc(g_Config.dwSellOffGameGirdTaxRate / 100 * UserShopItem.nPrice);
          IncGameGird(UserShopItem.nPrice - nTGameGirdCount);
          NewGamePointChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GameGirdChange, Self, g_Config.sGameGirdName, UserShopItem.MakeIndex,
              UserShopItem.sBuyName, m_nGameGird, UserShopItem.nPrice - nTGameGirdCount, '个人商店取款');
          end;
        end;
    else
      nTCustomMoneyCount := 0; // UserShopItem.nPrice;
      IncMoney(UserShopItem.btMoneyType - 5, UserShopItem.nPrice - nTCustomMoneyCount, nValue);
    end;
  end;

var
  UserShop: TUserShop;
  UserShopItem: TSimpleUserShopItem;
  nTGameGoldCount, nTGamePointCount, nTGoldCount, nTGameDiamondCount, nTGameGirdCount, nTCustomMoneyCount: Integer; // 税收
  IsDelete: Boolean;
  StdItem: pTStdItem;
begin
  if MyGetTickCount - m_dwQueryUserShopItemTime < g_Config.nMyShopOperateInterval then
  begin
    // m_DefMsg := MakeDefaultMsg(SM_SENDMOVEMYSHOPITEM_FAIL, -5, 0, 0, 0);
    // SendSocket(@m_DefMsg, '');
    Exit;
  end;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  nTGameGoldCount := 0;
  nTGoldCount := 0;
  m_dwQueryUserShopItemTime := MyGetTickCount;
  if not g_M2DataDB.UserShopDB.GetUserShopInfo(m_sCharName, UserShop) then
  begin
    Exit;
  end;
  if g_M2DataDB.UserShopDB.GetHumanItemWithMakeIndex(True, m_sCharName, sitSelled, ProcessMsg.nParam1, UserShopItem) then
  begin
    IsDelete := False;
    if UserShopItem.boGetMoney then
    begin
      g_M2DataDB.UserShopDB.DeleteItem(UserShop.ShopID, UserShopItem.ItemID);
      IsDelete := True;
    end
    else
    begin
      UserShopItem.boGetMoney := True;
      g_M2DataDB.UserShopDB.GetMoneyItem(UserShop.ShopID, UserShopItem.ItemID);
      if (g_FunctionNPC <> nil) then
      begin
        StdItem := UserEngine.GetStdItem(UserShopItem.wIndex);
        if (StdItem <> nil) and CheckOverLapItem(StdItem) then
          m_CurrentItemOverlapCount := UserShopItem.Dura + 1
        else
          m_CurrentItemOverlapCount := 0;
        m_nCurrentItemMakeIndex := UserShopItem.MakeIndex;
        if StdItem <> nil then
          m_sCurrentItemName := StdItem.Name
        else
          m_sCurrentItemName := '';
        if StdItem <> nil then
          m_sCurrentItemNewName := StdItem.Name
        else
          m_sCurrentItemNewName := '';
        m_btCurItemMoneyTypeValue := UserShopItem.btMoneyType;
        case UserShopItem.btMoneyType of
          0:
            m_sCurItemMoneyType := g_Config.sGameGoldName;
          1:
            m_sCurItemMoneyType := g_Config.sGamePointName;
          2:
            m_sCurItemMoneyType := sSTRING_GOLDNAME;
          3:
            m_sCurItemMoneyType := g_Config.sGameDiamondName;
          4:
            m_sCurItemMoneyType := g_Config.sGameGirdName;
        else
          m_sCurItemMoneyType := GetCustomMoneyNameByRule(UserShopItem.btMoneyType, 0);
        end;
        m_nCurItemPrices := UserShopItem.nPrice;
        m_sCurrentOperateUserName := UserShopItem.sBuyName;
        g_FunctionNPC.GotoLable(Self, '@SellUserItemWithdrawals', False);
        m_nCurrentItemMakeIndex := 0;
        m_sCurrentItemName := '';
        m_sCurrentItemNewName := '';
        m_btCurItemMoneyTypeValue := 0;
        m_sCurItemMoneyType := '';
        m_nCurItemPrices := 0;
        m_sCurrentOperateUserName := '';
        m_CurrentItemOverlapCount := 0;
      end;
      IncGameMoney(@UserShopItem, nTGameGoldCount, nTGamePointCount, nTGoldCount, nTGameDiamondCount, nTGameGirdCount,
        nTCustomMoneyCount);
    end;
    SendMyShopItems(1, m_MyShopItem_SelledIndex);
    SendQuerySelectShopInfo(m_sCharName);
    // 删除操作不提示信息 piaoyun 2013-07-21
    if not IsDelete then
    begin
      case UserShopItem.btMoneyType of
        0:
          SysMsg(Format(g_sUserShopGetMoney, [nTGameGoldCount, g_Config.sGameGoldName, UserShopItem.nPrice - nTGameGoldCount,
            g_Config.sGameGoldName]), 255, 253, t_Hint);
        1:
          SysMsg(Format(g_sUserShopGetMoney, [nTGamePointCount, g_Config.sGamePointName, UserShopItem.nPrice - nTGamePointCount,
            g_Config.sGamePointName]), 255, 253, t_Hint);
        2:
          SysMsg(Format(g_sUserShopGetMoney, [nTGoldCount, sSTRING_GOLDNAME, UserShopItem.nPrice - nTGoldCount, sSTRING_GOLDNAME]
            ), 255, 253, t_Hint);
        3:
          SysMsg(Format(g_sUserShopGetMoney, [nTGameDiamondCount, g_Config.sGameDiamondName,
            UserShopItem.nPrice - nTGameDiamondCount, g_Config.sGameDiamondName]), 255, 253, t_Hint);
        4:
          SysMsg(Format(g_sUserShopGetMoney, [nTGameGirdCount, g_Config.sGameGirdName, UserShopItem.nPrice - nTGameGirdCount,
            g_Config.sGameGirdName]), 255, 253, t_Hint);
      else
        SysMsg(Format(g_sUserShopGetMoney, [nTCustomMoneyCount, GetCustomMoneyNameByRule(UserShopItem.btMoneyType, 0),
          UserShopItem.nPrice - nTCustomMoneyCount, GetCustomMoneyNameByRule(UserShopItem.btMoneyType, 0)]), 255, 253, t_Hint);
      end;
    end;
  end;
end;

