procedure TPlayObject.SendGroupMembers(IsLockMember: Boolean = True);
var
  I, nCount: Integer;
  PlayObject: TPlayObject;
  InfBuf: PAnsiChar;
  GroupMember: PGroupMember;
begin
  InfBuf := GetMemory((m_GroupMembers.Count + 1) * SizeOf(TGroupMember));
  try
    nCount := 0;
    GroupMember := PGroupMember(InfBuf);
    // 队长放在第一个 chongchong 2014-12-04
    if m_GroupOwner <> nil then
    begin
      GroupMember.sCharName := m_GroupOwner.m_sCharName;
      GroupMember.sMapName := m_GroupOwner.m_sMapName;
      GroupMember.sMapDesc := m_GroupOwner.m_PEnvir.sMapDesc;
      GroupMember.Job := m_GroupOwner.m_btJob;
      GroupMember.Gender := m_GroupOwner.m_btGender;
      GroupMember.IsCaptain := True;
      GroupMember.nRecogId := NativeInt(m_GroupOwner);
      GroupMember.Level := m_GroupOwner.m_Abil.Level;
      GroupMember.HP := m_GroupOwner.m_WAbil.HP;
      GroupMember.MaxHP := m_GroupOwner.m_WAbil.MaxHP;
      GroupMember.MP := m_GroupOwner.m_WAbil.MP;
      GroupMember.MaxMP := m_GroupOwner.m_WAbil.MaxMP;
      Inc(GroupMember);
      Inc(nCount);
    end;
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun and IsLockMember then
      m_GroupMembers.LockR(40);
    try
{$IFEND}
      for I := 0 to m_GroupMembers.Count - 1 do
      begin
        PlayObject := TPlayObject(m_GroupMembers.Objects[I]);
        if (PlayObject <> nil) and (PlayObject <> m_GroupOwner) then
        begin
          GroupMember.sCharName := PlayObject.m_sCharName;
          GroupMember.sMapName := PlayObject.m_sMapName;
          GroupMember.sMapDesc := PlayObject.m_PEnvir.sMapDesc;
          GroupMember.Job := PlayObject.m_btJob;
          GroupMember.Gender := PlayObject.m_btGender;
          GroupMember.IsCaptain := False;
          GroupMember.nRecogId := NativeInt(PlayObject);
          GroupMember.Level := PlayObject.m_Abil.Level;
          GroupMember.HP := PlayObject.m_WAbil.HP;
          GroupMember.MaxHP := PlayObject.m_WAbil.MaxHP;
          GroupMember.MP := PlayObject.m_WAbil.MP;
          GroupMember.MaxMP := PlayObject.m_WAbil.MaxMP;
          Inc(GroupMember);
          Inc(nCount);
        end;
      end;

      m_DefMsg := MakeDefaultMsg(SM_GROUPMEMBERS, nCount, 0, 0, 0);
      for I := 0 to m_GroupMembers.Count - 1 do
      begin
        PlayObject := TPlayObject(m_GroupMembers.Objects[I]);
        if PlayObject <> nil then
        begin
          PlayObject.SendSocketEx(@m_DefMsg, InfBuf, nCount * SizeOf(TGroupMember));
          // PlayObject.SendDefMessage(SM_GROUPMEMBERS, nCount, 0, 0, 0, sSendMsg);
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun and IsLockMember then
        m_GroupMembers.UnLockR;
    end;
{$IFEND}
  finally
    FreeMem(InfBuf);
  end;
end;

function TPlayObject.GetMagicInfo(nMagicID: Integer): pTUserMagic;
var
  I: Integer;
  UserMagic: pTUserMagic;
begin
  Result := nil;
  for I := 0 to m_MagicList.Count - 1 do
  begin
    UserMagic := m_MagicList.Items[I];
    if UserMagic = nil then
      Continue;

    if UserMagic.MagicInfo = nil then
      Continue;

    if (UserMagic.MagicInfo.wMagicId = nMagicID) and (UserMagic.MagicAttr = mtHum) then
    begin
      Result := UserMagic;
      Exit;
    end;
  end;

  for I := 0 to m_MagicList.Count - 1 do
  begin
    UserMagic := m_MagicList.Items[I];
    if UserMagic = nil then
      Continue;

    if UserMagic.MagicInfo = nil then
      Continue;

    if (UserMagic.MagicInfo.wMagicId = nMagicID) then
    begin
      Result := UserMagic;
      Break;
    end;
  end;
end;

function TPlayObject.GetMagicInfo(sMagicName: string): pTUserMagic;
var
  I: Integer;
  UserMagic: pTUserMagic;
begin
  Result := nil;
  for I := 0 to m_MagicList.Count - 1 do
  begin
    UserMagic := m_MagicList.Items[I];
    if UserMagic = nil then
      Continue;

    if UserMagic.MagicInfo = nil then
      Continue;

    if CompareText(UserMagic.MagicInfo.sMagicName, sMagicName) = 0 then
    begin
      Result := UserMagic;
      Break;
    end;
  end;
end;

function TPlayObject.DoMotaebo(nDir: Byte; nMagicLevel: Integer): Boolean;
// 野蛮冲撞推动同等级--函数扩展 piaoyun 2013-07-25
  function CanMotaeboEx(BaseObject: TBaseObject): Boolean;
  begin
    // 宠物无实体模式 2019-11-15 22:18:42
    if (BaseObject <> nil) and (BaseObject.m_Master <> nil) and (BaseObject.m_boGamePet) and g_Config.boPetNoEntity then
    begin
      Result := True;
      Exit;
    end;

    Result := (m_Abil.Level >= BaseObject.m_Abil.Level) and (not BaseObject.m_boStickMode) and IsProperTarget(BaseObject);
  end;

  function CanMotaebo(BaseObject: TBaseObject): Boolean;
  var
    nC: Integer;
    nTempX, nTempY: Integer;
  begin
    Result := False;
    if BaseObject.m_boImprison then
    begin
      nTempX := BaseObject.m_nCurrX;
      nTempY := BaseObject.m_nCurrY;

      BaseObject.m_PEnvir.GetNextPosition(BaseObject.m_nCurrX, BaseObject.m_nCurrY, m_btDirection, 1, nTempX, nTempY);

      if (nTempX < BaseObject.m_nImprisonPos.X - BaseObject.m_nImprisonRange) or
        (nTempX > BaseObject.m_nImprisonPos.X + BaseObject.m_nImprisonRange) or
        (nTempY < BaseObject.m_nImprisonPos.Y - BaseObject.m_nImprisonRange) or
        (nTempY > BaseObject.m_nImprisonPos.Y + BaseObject.m_nImprisonRange) then
        Exit;
    end;

    if BaseObject.m_boDeath or BaseObject.m_boGhost then
      Exit;

    // 野蛮冲撞推动同等级角色
    if g_Config.boDoMotaeboPushSameLevel then
    begin
      Result := CanMotaeboEx(BaseObject);
      Exit;
    end;

    // 宠物无实体模式 2019-11-15 22:18:42
    if (BaseObject.m_Master <> nil) and (BaseObject.m_boGamePet) and g_Config.boPetNoEntity then
    begin
      Result := True;
      Exit;
    end;

    if (m_Abil.Level > BaseObject.m_Abil.Level) and (not BaseObject.m_boStickMode) then
    begin
      nC := m_Abil.Level - BaseObject.m_Abil.Level;
      if (Random(20) < nMagicLevel * 4 + 6 + nC) and IsProperTarget(BaseObject) then
        Result := True;
    end;
  end;

var
  bo35: Boolean;
  I, n20, n24, n28: Integer;
  PoseCreate: TBaseObject;
  tmpObj_A, tmpObj_B: TBaseObject;
  nX, nY: Integer;
resourcestring
  sExceptionMsg1 = '[Exception] TPlayObject.DoMotaebo GotoLable1';
  sExceptionMsg2 = '[Exception] TPlayObject.DoMotaebo GotoLable2';
begin
  Result := False;
  bo35 := True;
  m_btDirection := nDir;
  tmpObj_B := nil;
  n24 := nMagicLevel + 1;
  n28 := n24;

  if g_Config.boBarbaricSeptum or FSpaceMotaeboEnabled or (FSpaceMotaeboTime = 0) then
    PoseCreate := GetPoseCreate(nMagicLevel + 1) // 增加隔位野蛮功能 Cursor 2023-07-03 19:40:23
  else
    PoseCreate := GetPoseCreate();

  if PoseCreate <> nil then
  begin
    for I := 0 to Max(2, nMagicLevel + 1) do
    begin
      PoseCreate := GetPoseCreate();
      if PoseCreate <> nil then
      begin
        n28 := 0;
        if not CanMotaebo(PoseCreate) then
          Break;

        GetFrontPosition(nX, nY);
        if m_boImprison then
        begin
          if (nX < m_nImprisonPos.X - m_nImprisonRange) or (nX > m_nImprisonPos.X + m_nImprisonRange) or
            (nY < m_nImprisonPos.Y - m_nImprisonRange) or (nY > m_nImprisonPos.Y + m_nImprisonRange) then
            Break;
        end;

        // 推动第二格的角色
        if (nMagicLevel >= 3) and m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, m_btDirection, 2, nX, nY) then
        begin
          tmpObj_A := m_PEnvir.GetMovingObject(nX, nY, True);

          if (tmpObj_A <> nil) //
            and CanMotaebo(tmpObj_A) //
            and not((tmpObj_A <> nil) // -
            and (tmpObj_A.m_Master <> nil) // -
            and (tmpObj_A.m_boGamePet) // -
            and g_Config.boPetNoEntity) then
            tmpObj_A.CharPushed(m_btDirection, 1);
        end;

        // 推动第一格的角色
        tmpObj_B := PoseCreate;
        if not((PoseCreate.m_Master <> nil) and (PoseCreate.m_boGamePet) and g_Config.boPetNoEntity) //
          and (PoseCreate.CharPushed(m_btDirection, 1) <> 1) then
          Break;
      end;

      // 自己也往前走动
      GetFrontPosition(nX, nY);
      if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nX, nY, False) then
      begin
        m_nCurrX := nX;
        m_nCurrY := nY;
        SendRefMsg(RM_RUSH, nDir, m_nCurrX, m_nCurrY, 0, '');
        bo35 := False;
        Result := True;
      end;
      Dec(n24);
    end;
  end
  else
  begin
    bo35 := False;
    for I := 0 to Max(2, nMagicLevel + 1) do
    begin
      GetFrontPosition(nX, nY);
      if m_boImprison then
      begin
        if (nX < m_nImprisonPos.X - m_nImprisonRange) or (nX > m_nImprisonPos.X + m_nImprisonRange) or
          (nY < m_nImprisonPos.Y - m_nImprisonRange) or (nY > m_nImprisonPos.Y + m_nImprisonRange) then
        begin
          bo35 := True;
          Break;
        end;
      end;

      if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nX, nY, False) then
      begin
        m_nCurrX := nX;
        m_nCurrY := nY;
        SendRefMsg(RM_RUSH, nDir, m_nCurrX, m_nCurrY, 0, '');
        Dec(n28);
      end
      else
      begin
        if m_PEnvir.CanWalk(nX, nY, True) then
          n28 := 0
        else
        begin
          bo35 := True;
          Break;
        end;
      end;
    end;
  end;

  if (tmpObj_B <> nil) //
    and not((tmpObj_B.m_Master <> nil) and (tmpObj_B.m_boGamePet) and g_Config.boDisableAllAttackPet) then
  begin
    n24 := Max(0, n24);
    n20 := Random((n24 + 1) * 10) + ((n24 + 1) * 10);
    if not CanCloseDefense then // 忽视目标防御
      n20 := tmpObj_B.GetHitStruckDamage(Self, n20, nil);

    n20 := tmpObj_B.NewAbilPower(2, n20); // 物伤减少
    n20 := GetMagicPercentPower(27, n20, tmpObj_B);
    n20 := NewAbilPower(1, n20); // 元素增加攻击伤害
    n20 := tmpObj_B.StruckDamage(n20, Self, 27);

    tmpObj_B.SendRefMsg(RM_STRUCK, n20, tmpObj_B.m_WAbil.HP, tmpObj_B.m_WAbil.MaxHP, NativeInt(Self), '');

    if tmpObj_B.m_btRaceServer <> RC_PLAYOBJECT then
      tmpObj_B.SendMsg(tmpObj_B, RM_STRUCK, n20, tmpObj_B.m_WAbil.HP, tmpObj_B.m_WAbil.MaxHP, NativeInt(Self), '');

    m_wCurrMagicId := 27;
    m_CurrTarget := tmpObj_B;
    if (tmpObj_B <> Self) and (g_FunctionNPC <> nil) then
    begin
      m_nLastPKPower := n20 + tmpObj_B.m_MagicShieldDecMP;
      m_nScriptGotoCount := 0;
      try
        g_FunctionNPC.GotoLable(Self, '@MagicAttack', False);
        tmpObj_B.GiveHitterExp(Self, True, 0);
      except
        MainOutMessage(sExceptionMsg1);
      end;

      if m_PEnvir.m_boHITMON and (m_PEnvir.m_sHITMON <> '') then
      begin
        m_nScriptGotoCount := 0;
        try
          g_FunctionNPC.GotoLable(Self, m_PEnvir.m_sHITMON, False);
        except
          MainOutMessage(sExceptionMsg1);
        end;
      end;
    end;

    tmpObj_B.m_CurrTarget := Self;
    tmpObj_B.m_wCurrMagicId := 27;
    if (tmpObj_B <> Self) and (tmpObj_B.m_btRaceServer = RC_PLAYOBJECT) and (g_FunctionNPC <> nil) then
    begin
      TPlayObject(tmpObj_B).m_nScriptGotoCount := 0;
      tmpObj_B.m_nStruckHP := n20;
      TPlayObject(tmpObj_B).m_nScriptGotoCount := 0;
      try
        g_FunctionNPC.GotoLable(TPlayObject(tmpObj_B), '@MagicStruck', False);
      except
        MainOutMessage(sExceptionMsg2);
      end;
    end;

    // 假人说话
    if (tmpObj_B <> nil) //
      and (tmpObj_B.m_btRaceServer = RC_PLAYOBJECT) //
      and tmpObj_B.m_boDummyObject //
      and (Random(TPlayObject(tmpObj_B).m_nSayRate) = 0) //
      and (tmpObj_B.Ask <> '') then
      tmpObj_B.SendRefMsg(RM_HEAR, 0, TPlayObject(tmpObj_B).GetHearMsgFColor, g_Config.btHearMsgBColor, 0,
        tmpObj_B.m_sCharName + ':' + tmpObj_B.Ask);

    if (m_btRaceServer = RC_PLAYOBJECT) //
      and m_boDummyObject //
      and (Random(m_nSayRate) = 0) //
      and (Ask <> '') then
      SendRefMsg(RM_HEAR, 0, GetHearMsgFColor, g_Config.btHearMsgBColor, 0, m_sCharName + ':' + Ask);
  end;

  if bo35 then
  begin
    GetFrontPosition(nX, nY);
    SendRefMsg(RM_RUSHKUNG, m_btDirection, nX, nY, 0, '');
    SysMsg(sMateDoTooweak { 冲撞力不够！ } , c_Red, t_Hint);
  end;
  m_dwDoMotaeboTick := MyGetTickCount();

  if n28 > 0 then
  begin
    n24 := Max(0, n24);
    n20 := Random(n24 * 10) + ((n24 + 1) * 3);
    if not CanCloseDefense then // 忽视目标防御
      n20 := GetHitStruckDamage(Self, n20, nil);

    n20 := NewAbilPower(1, n20); // 元素增加攻击伤害
    StruckDamage(n20, nil, 27);
    SendRefMsg(RM_STRUCK, n20, m_WAbil.HP, m_WAbil.MaxHP, NativeInt(Self), '');
  end;
end;

function TPlayObject.DoMotaebo100(BaseObject: TBaseObject; UserMagic: pTUserMagic): Boolean; // 追心刺
  function CanMotaebo(BaseObject: TBaseObject): Boolean;
  begin
    Result := False;
    if ((m_Abil.Level > BaseObject.m_Abil.Level) or (g_Config.boDoMotaebo100PushSameLevel and
      (BaseObject.m_Abil.Level = m_Abil.Level))) and (not BaseObject.m_boStickMode) then
    begin
      // 追心刺修改: CanMotaebo函数中不能加几率，不然这里可以推，下面的CanMotaebo(BaseObject_30)又不能推，就会出现 穿过目标导致目标卡位 chongchong 2017-11-18
      // nC := m_Abil.Level - BaseObject.m_Abil.Level;
      // if Random(20) < ((UserMagic.btLevel * 4) + 6 + nC) then
      begin
        if IsProperTarget(BaseObject) then
          Result := True;
      end;
    end;
  end;

var
  I, n20: Integer;
  PoseCreate: TBaseObject;
  BaseObject_30: TBaseObject;
  BaseObject_34: TBaseObject;
  nX, nY: Integer;
  nOldX, nOldY: Integer;
  sAsk: string;
  sPushedInfo: string;
  PushedObject: TPushedObject;
  PushedObjectList: TList;
  nSelfStep: Integer;
resourcestring
  sExceptionMsg1 = '[Exception] TPlayObject.DoMotaebo100 GotoLable1';
  sExceptionMsg2 = '[Exception] TPlayObject.DoMotaebo100 GotoLable2';
begin
  Result := False;
  BaseObject_34 := nil;
  nSelfStep := 0;
  sPushedInfo := '';
  PushedObjectList := TList.Create;
  try
    PoseCreate := GetPoseCreate();
    if (PoseCreate <> nil) then
    begin
      for I := 0 to g_Config.nDoMotaebo100PushDistance - 1 do
      begin // Max(2, nMagicLevel + 1)
        PoseCreate := GetPoseCreate();
        if PoseCreate <> nil then
        begin
          // 追心刺修改: CanMotaebo函数中不能加几率，不然这里可以推，下面的CanMotaebo(BaseObject_30)又不能推，就会出现 穿过目标导致目标卡位 chongchong 2017-11-18
          if not CanMotaebo(PoseCreate) then
          begin
            // 不管是否能推动目标，都让目标有伤害 2019-08-06 17:01:39
            BaseObject_34 := PoseCreate;
            Break;
          end;

          if (UserMagic.btLevel >= 3) and m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, m_btDirection, 2, nX, nY) then
          begin // 推动第二格的角色
            BaseObject_30 := m_PEnvir.GetMovingObject(nX, nY, True);
            if (BaseObject_30 <> nil) and CanMotaebo(BaseObject_30) then
            begin
              nOldX := BaseObject_30.m_nCurrX;
              nOldY := BaseObject_30.m_nCurrY;
              BaseObject_30.CharPushed_Skill100(m_btDirection, 1);
              if (nOldX <> BaseObject_30.m_nCurrX) or (nOldY <> BaseObject_30.m_nCurrY) then
              begin
                if PushedObjectList.IndexOf(BaseObject_30) < 0 then
                begin
                  BaseObject_30.m_btPushedStep := 1;
                  PushedObjectList.Add(BaseObject_30);
                end
                else
                  BaseObject_30.m_btPushedStep := m_btPushedStep + 1;
              end;
            end;
          end;

          BaseObject_34 := PoseCreate;
          nOldX := PoseCreate.m_nCurrX;
          nOldY := PoseCreate.m_nCurrY;
          if PoseCreate.CharPushed_Skill100(m_btDirection, 1) <> 1 then
            Break; // 推动第一格的角色

          if (nOldX <> PoseCreate.m_nCurrX) or (nOldY <> PoseCreate.m_nCurrY) then
          begin
            if PushedObjectList.IndexOf(PoseCreate) < 0 then
            begin
              PoseCreate.m_btPushedStep := 1;
              PushedObjectList.Add(PoseCreate);
            end
            else
              PoseCreate.m_btPushedStep := PoseCreate.m_btPushedStep + 1;
          end;

          GetFrontPosition(nX, nY);
          if m_boImprison then
          begin
            if (nX < m_nImprisonPos.X - m_nImprisonRange) or (nX > m_nImprisonPos.X + m_nImprisonRange) or
              (nY < m_nImprisonPos.Y - m_nImprisonRange) or (nY > m_nImprisonPos.Y + m_nImprisonRange) then
              Break;
          end;

          if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nX, nY, False) then
          begin // 自己也往前走动
            m_nCurrX := nX;
            m_nCurrY := nY;
            Result := True;
            Inc(nSelfStep);
          end;
        end; // 004C32D7  if PoseCreate <> nil  then begin
      end; // 004C32DD for i:=0 to Max(2,nMagicLevel + 1) do begin
    end
    else
    begin // 004C32E8 if PoseCreate <> nil  then begin
      for I := 0 to g_Config.nDoMotaebo100PushDistance - 1 do
      begin
        GetFrontPosition(nX, nY); // sub_004B2790
        if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nX, nY, False) then
        begin
          m_nCurrX := nX;
          m_nCurrY := nY;
          Inc(nSelfStep);
        end
        else if not m_PEnvir.CanWalk(nX, nY, True) then
          Break;
      end;
    end;

    for I := 0 to PushedObjectList.Count - 1 do
    begin
      PoseCreate := TBaseObject(PushedObjectList.Items[I]);
      PushedObject.nRecogId := NativeInt(PoseCreate);
      PushedObject.nCurrX := PoseCreate.m_nCurrX;
      PushedObject.nCurrY := PoseCreate.m_nCurrY;
      PushedObject.btDir := PoseCreate.m_btDirection;
      PushedObject.btStep := PoseCreate.m_btPushedStep;
      sPushedInfo := sPushedInfo + EncodeBuffer(@PushedObject, SizeOf(TPushedObject)) + '/';
    end;
  finally
    PushedObjectList.Free;
  end;
  SendRefMsg(RM_100HIT, m_btDirection, m_nCurrX, m_nCurrY, nSelfStep, sPushedInfo);

  // 战技连击锁定 chongchong 2013-11-11
  if (BaseObject <> nil) and (Random(100) < g_Config.btWarrContinuousStatusLocks[0]) and IsProperTarget(BaseObject) then
  begin
    BaseObject.OpenContinuousMagicLock(g_Config.nWarrContinuousStatusLockTimes[0]);
    // BaseObject.MakePosion(POISON_STONE, 2, 0);
  end;

  // 修复追心刺技能对比自己级别高的对象施展无伤害 chongchong 2017-09-02
  if (BaseObject_34 = nil) and (BaseObject <> nil) { and (BaseObject.m_btRaceServer = 55) } then
    BaseObject_34 := BaseObject;

  if (BaseObject_34 <> nil) and IsProperTarget(BaseObject_34) then
  begin
    // 破魔法盾chongchong 2013-11-15
    if (Random(100) <= g_Config.Skill100BreakDefenceUpRate) and (BaseObject_34.m_wStatusTimeArr[STATE_BUBBLEDEFENCEUP] <> 0) then
    begin
      BaseObject_34.m_wStatusTimeArr[STATE_BUBBLEDEFENCEUP] := 0; // m_boAbilMagBubbleDefence := False;
      BaseObject_34.m_dwStatusArrTick[STATE_BUBBLEDEFENCEUP { 0x214 } ] := MyGetTickCount();
      BaseObject_34.m_nCharStatus := BaseObject_34.GetCharStatus();
      BaseObject_34.StatusChanged();
      BaseObject_34.SendRefMsg(RM_BROKENSHIELD, BaseObject_34.m_btDirection, BaseObject_34.m_nCurrX,
        BaseObject_34.m_nCurrY, 0, '');
    end;

    // 破新武力盾chongchong 2013-11-15
    if (Random(100) <= g_Config.Skill100BreakDefenceUpRate) and (BaseObject_34.m_wStatusTimeArr[STATE_NEWHITBUBBLEDEFENCEUP] <> 0)
    then
    begin
      BaseObject_34.m_wStatusTimeArr[STATE_NEWHITBUBBLEDEFENCEUP] := 0; // m_boAbilMagBubbleDefence := False;
      BaseObject_34.m_dwStatusArrTick[STATE_NEWHITBUBBLEDEFENCEUP { 0x214 } ] := MyGetTickCount();
      BaseObject_34.m_nCharStatus := BaseObject_34.GetCharStatus();
      BaseObject_34.StatusChanged();
      BaseObject_34.SendRefMsg(RM_BROKENSHIELD, BaseObject_34.m_btDirection, BaseObject_34.m_nCurrX,
        BaseObject_34.m_nCurrY, 0, '');
    end;

    // 破新道力盾chongchong 2013-11-15
    if (Random(100) <= g_Config.Skill100BreakDefenceUpRate) and (BaseObject_34.m_wStatusTimeArr[STATE_NEWMAGBUBBLEDEFENCEUP] <> 0)
    then
    begin
      BaseObject_34.m_wStatusTimeArr[STATE_NEWMAGBUBBLEDEFENCEUP] := 0; // m_boAbilMagBubbleDefence := False;
      BaseObject_34.m_dwStatusArrTick[STATE_NEWMAGBUBBLEDEFENCEUP { 0x214 } ] := MyGetTickCount();
      BaseObject_34.m_nCharStatus := BaseObject_34.GetCharStatus();
      BaseObject_34.StatusChanged();
      BaseObject_34.SendRefMsg(RM_BROKENSHIELD, BaseObject_34.m_btDirection, BaseObject_34.m_nCurrX,
        BaseObject_34.m_nCurrY, 0, '');
    end;

    n20 := GetAttackPower(m_WAbil.DC1, Integer((m_WAbil.DC2 - m_WAbil.DC1)));
    n20 := GetNewLevelPower(n20, UserMagic); // 取强化技能攻击伤害
    n20 := Round(n20 * (g_Config.SkillContinuousPowerRates[0] / 100)); // 攻击力倍数
    // 技能每提升一级伤害增加
    n20 := Min(LongWord(n20 + Round(n20 * (UserMagic.btLevel * g_Config.nContinuousAttackLevelRate / 100))), High(Integer));
    n20 := GetSkillContinuousBlastHitPower(Self, BaseObject_34, UserMagic, n20); // 连击暴击
    n20 := GetPowerRateAdd(BaseObject_34, n20); // 物伤减少
    n20 := GetMagicPercentPower(100, n20, BaseObject_34); // 装备技能威力 2020-11-06 22:12:27
    if Random(100) < g_Config.SkillContinuousCloseDefenseRates[0] then
      n20 := BaseObject_34.GetHitStruckDamage(Self, n20, nil); // 忽视目标防御

    n20 := BaseObject_34.NewAbilPower(2, n20); // 物伤减少
    n20 := BaseObject_34.GetAttackPowerMax(n20); // 伤害土封顶
    n20 := BaseObject_34.StruckDamage(n20, Self, 100);
    BaseObject_34.SendRefMsg(RM_STRUCK, n20, BaseObject_34.m_WAbil.HP, BaseObject_34.m_WAbil.MaxHP, NativeInt(Self), '');
    if BaseObject_34.m_btRaceServer <> RC_PLAYOBJECT then
    begin
      BaseObject_34.SendMsg(BaseObject_34, RM_STRUCK, n20, BaseObject_34.m_WAbil.HP, BaseObject_34.m_WAbil.MaxHP,
        NativeInt(Self), '');
    end;

    m_wCurrMagicId := 100;
    m_CurrTarget := BaseObject_34;
    if (BaseObject_34 <> Self) and (g_FunctionNPC <> nil) then
    begin
      m_nLastPKPower := n20 + BaseObject_34.m_MagicShieldDecMP;
      m_nScriptGotoCount := 0;
      try
        g_FunctionNPC.GotoLable(Self, '@MagicAttack', False);
        BaseObject_34.GiveHitterExp(Self, True, 0);
      except
        MainOutMessage(sExceptionMsg1);
      end;

      if m_PEnvir.m_boHITMON and (m_PEnvir.m_sHITMON <> '') then
      begin
        m_nScriptGotoCount := 0;
        try
          g_FunctionNPC.GotoLable(Self, m_PEnvir.m_sHITMON, False);
        except
          MainOutMessage(sExceptionMsg1);
        end;
      end;
    end;

    BaseObject_34.m_CurrTarget := Self;
    BaseObject_34.m_wCurrMagicId := 100;
    if (BaseObject_34 <> Self) and (BaseObject_34.m_btRaceServer = RC_PLAYOBJECT) and (g_FunctionNPC <> nil) then
    begin
      BaseObject_34.m_nStruckHP := n20;
      TPlayObject(BaseObject_34).m_nScriptGotoCount := 0;
      try
        g_FunctionNPC.GotoLable(TPlayObject(BaseObject_34), '@MagicStruck', False);
      except
        MainOutMessage(sExceptionMsg2);
      end;
    end;

    // 假人说话
    if (BaseObject_34 <> nil) and (BaseObject_34.m_btRaceServer = RC_PLAYOBJECT) and BaseObject_34.m_boDummyObject and
      (Random(TPlayObject(BaseObject_34).m_nSayRate) = 0) then
    begin
      sAsk := BaseObject_34.Ask;
      if sAsk <> '' then
        BaseObject_34.SendRefMsg(RM_HEAR, 0, TPlayObject(BaseObject_34).GetHearMsgFColor, g_Config.btHearMsgBColor, 0,
          BaseObject_34.m_sCharName + ':' + sAsk);
    end;

    if (m_btRaceServer = RC_PLAYOBJECT) and m_boDummyObject and (Random(m_nSayRate) = 0) then
    begin
      sAsk := Ask;
      if sAsk <> '' then
        SendRefMsg(RM_HEAR, 0, GetHearMsgFColor, g_Config.btHearMsgBColor, 0, m_sCharName + ':' + sAsk);
    end;
  end;
end;

function TPlayObject.PileStones(nX, nY: Integer): Boolean;
var
  I: Integer;
  MapCellInfo: pTMapCellinfo;
  Event: TGameEvent;
  PileEvent: TGameEvent;
  GameObject: TGameObject;
  s1C: string;
  bo10: Boolean;
begin
  Result := False;
  s1C := '';
  Event := nil;
  bo10 := False;
{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun then
    m_PEnvir.LockR(2);
  try
{$IFEND}
    if m_PEnvir.m_boMINE and m_PEnvir.GetMapCellInfo(nX, nY, MapCellInfo) then
    begin
      bo10 := True;
      if (MapCellInfo.ObjList <> nil) then
      begin
        for I := 0 to {$IF USEOBJLIST = 1}Length(MapCellInfo.ObjList){$ELSE}MapCellInfo.ObjList.Count{$IFEND} - 1 do
        begin
          GameObject :=
{$IF USEOBJLIST = 1}TGameObject(MapCellInfo.ObjList[I]){$ELSE}TGameObject(MapCellInfo.ObjList.Items[I]){$IFEND};
          if (GameObject <> nil) and (GameObject.m_ObjGame = Obj_Event) then
            Event := TGameEvent(GameObject);
        end;
      end;
    end;

    if (Event = nil) and bo10 and (MapCellInfo.chFlag <> 0) then
    begin // 动态创建TStoneMineEvent
      Event := TStoneMineEvent.Create(m_PEnvir, nX, nY, ET_STONEMINE);
      if m_PEnvir.AddToMapMineEvent(nX, nY, Event) = Event then
        g_EventManager.AddEvent(Event, False)
      else
        FreeAndNil(Event);
    end;

    if (Event <> nil) and (Event.m_nEventType = ET_STONEMINE) then
    begin
      if TStoneMineEvent(Event).m_nMineCount > 0 then
      begin
        Dec(TStoneMineEvent(Event).m_nMineCount);
        if Random(g_Config.nMakeMineHitRate { 4 } ) = 0 then
        begin
          PileEvent := TGameEvent(m_PEnvir.GetEvent(m_nCurrX, m_nCurrY));
          if PileEvent = nil then
          begin
            PileEvent := TPileStones.Create(m_PEnvir, m_nCurrX, m_nCurrY, ET_PILESTONES, 5 * 60 * 1000);
            g_EventManager.AddEvent(PileEvent);
          end
          else if PileEvent.m_nEventType = ET_PILESTONES then
            TPileStones(PileEvent).AddEventParam;

          if Random(g_Config.nMakeMineRate { 12 } ) = 0 then
            MakeMine();

          s1C := '1';
          DoDamageWeapon(Random(15) + 5);
          Result := True;
        end;
      end
      else if (MyGetTickCount - TStoneMineEvent(Event).m_dwAddStoneMineTick) > 10 * 60 * 1000 then
        TStoneMineEvent(Event).AddStoneMine();
    end;
    SendRefMsg(RM_HEAVYHIT, m_btDirection, m_nCurrX, m_nCurrY, 0, s1C);
{$IF MULTI_THREAD = 1}
  finally
    if g_MultiThreadRun then
      m_PEnvir.UnLockR;
  end;
{$IFEND}
end;

procedure TPlayObject.SendSaveItemList(nBaseObject: NativeInt; Index: Integer);
var
  I, nC: Integer;
  ClientItem: pTClientItem;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  InBuf: array [0 .. 324000] of AnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  if (Index < Low(m_StorageItemList)) or (Index > High(m_StorageItemList)) then
    Exit;

  FStoragePageIndex := Index;
  if not m_boStorageOpen[Index] then
  begin
    SysMsg('未开启仓库' + IntToStr(Index + 1), c_Red, t_Hint);
    Exit;
  end;

  InBytes := 0;
  nC := 0;
  for I := 0 to m_StorageItemList[Index].Count - 1 do
  begin
    UserItem := m_StorageItemList[Index].Items[I];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem <> nil then
    begin
      Inc(nC);
      Inc(InBytes, SizeOf(TClientItem));
      Buffer := @InBuf;
      Buffer := Buffer + (InBytes - SizeOf(TClientItem));
      ClientItem := pTClientItem(Buffer);
      UserItemToClientItem(UserItem, StdItem, ClientItem, True, False);
    end;
  end;

  m_DefMsg := MakeDefaultMsg(SM_SAVEITEMLIST, nBaseObject, LoWord(InBytes), HiWord(InBytes), nC);
  SendSocketEx(@m_DefMsg, @InBuf, InBytes);
end;

procedure TPlayObject.SendSaveBigStorageItemList(nBaseObject: NativeInt; nPage: Integer); // 发送无限仓库物品
  function GetPageCount(nListCount: Integer): Integer;
  begin
    Result := 0;
    if nListCount > 0 then
    begin
      Result := nListCount div 50;
      if (nListCount mod 50) > 0 then
        Inc(Result);
    end;
  end;

var
  I, nC, nIndex: Integer;
  ClientItem: pTClientItem;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  InBuf: array [0 .. 81920] of AnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  nC := 0;
  nIndex := 0;
  if nPage = 0 then
    nIndex := 0;

  if nPage > 0 then
    nIndex := nPage * 50;

  if nIndex > m_BigStorageItemList.Count - 1 then
  begin
    m_nBigStoragePage := GetPageCount(m_BigStorageItemList.Count);
    if nIndex = 0 then
    begin
      m_DefMsg := MakeDefaultMsg(SM_SAVEITEMLIST, nBaseObject, 0, 0, 0);
      SendSocket(@m_DefMsg, '');
    end;
    Exit;
  end;

  InBytes := 0;
  for I := nIndex to m_BigStorageItemList.Count - 1 do
  begin
    UserItem := m_BigStorageItemList.Items[I];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem <> nil then
    begin
      Inc(nC);
      Inc(InBytes, SizeOf(TClientItem));
      Buffer := @InBuf[0];
      Buffer := Buffer + (InBytes - SizeOf(TClientItem));
      ClientItem := pTClientItem(Buffer);
      UserItemToClientItem(UserItem, StdItem, ClientItem, True, False);
      if nC >= 50 then
        Break;
    end;
  end;

  m_DefMsg := MakeDefaultMsg(SM_SAVEITEMLIST, nBaseObject, LoWord(InBytes), HiWord(InBytes), nC);
  SendSocketEx(@m_DefMsg, @InBuf, InBytes);
end;

procedure TPlayObject.SendStorageViewItemList(NPC: NativeInt; nPage: Integer; IsExtStorage, IsTakeBackItem: Boolean;
  PosX, PosY: Integer); // 发送可视仓库物品 chongchong 2015-01-26
const
  ONEPAGECOUNT = 49;
var
  I, nC, nIndex: Integer;
  sSendMsg: AnsiString;
  ClientItem: pTClientItem;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  InBuf: array [0 .. 81920] of AnsiChar;
  Buffer: PAnsiChar;
  ItemList: TList;
  nPageCount, nMaxCount: Integer;
  Header: PTStorageViewItemListHeader;
  function GetPageCount(nListCount: Integer): Integer;
  begin
    Result := 0;
    if nListCount > 0 then
    begin
      Result := nListCount div ONEPAGECOUNT;
      if (nListCount mod ONEPAGECOUNT) > 0 then
        Inc(Result);
    end;
  end;

begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  sSendMsg := '';
  nC := 0;
  nIndex := 0;
  {
    // 修复打开npc对话框，然后双击使用触发物品，打开仓库OpenStorageView后，npc对话框中的不能点击 2019-07-01 11:09:52
    if (Npc = NativeInt(g_FunctionNPC)) or
    (Npc = NativeInt(g_ManageNPC)) or
    (Npc = NativeInt(g_RobotNPC)) or
    (Npc = NativeInt(g_MissionNPC)) or
    (Npc = NativeInt(g_BatterNPC))  then
    begin
    Npc := 0;
    end;
  }

  if IsExtStorage then
  begin
    if g_Config.boInfinityStorage or (m_nInfinityStorageExtCount > 0) then
    begin
      nMaxCount := g_Config.nInfinityStorageCount + m_nInfinityStorageExtCount;
      if nMaxCount = 0 then
      begin
        SysMsg('未开启无限仓库', c_Red, t_Hint);
        Exit;
      end;
    end
    else
    begin
      SysMsg('未开启无限仓库', c_Red, t_Hint);
      Exit;
    end;

    ItemList := m_BigStorageItemList;
    nPageCount := GetPageCount(ItemList.Count);
    if nPage = 0 then
      nIndex := 0;

    if nPage > 0 then
    begin
      if nPage >= nPageCount then
        nPage := nPageCount - 1;
      nIndex := nPage * ONEPAGECOUNT;
    end;
  end
  else
  begin
    if not m_boStorageOpen[nPage] then
    begin
      SysMsg('未开启仓库' + IntToStr(nPage + 1), c_Red, t_Hint);
      Exit;
    end;

    ItemList := m_StorageItemList[nPage];
    nMaxCount := MAX_STORE_ITEM;
    nPageCount := Length(m_StorageItemList);
    if nPage < 0 then
      nPage := 0;

    if nPage > 0 then
    begin
      if nPage >= nPageCount then
        nPage := nPageCount - 1;
    end;
    nIndex := 0;
  end;

  Buffer := @InBuf;
  Header := PTStorageViewItemListHeader(Buffer);
  Header.Count := ItemList.Count;
  Header.MaxCount := nMaxCount;
  Header.Page := nPage + 1;
  Header.MaxPage := nPageCount;
  Header.PosX := PosX;
  Header.PosY := PosY;
  if ItemList.Count = 0 then
  begin
    sSendMsg := zLibCompressBuffer(InBuf, SizeOf(TStorageViewItemListHeader) + nC * SizeOf(TClientItem));
    m_DefMsg := MakeDefaultMsg(SM_STORAGEVIEWITEMLIST, NPC, Length(sSendMsg), Integer(IsExtStorage),
      MakeWord(nC, Integer(IsTakeBackItem)));
    SendSocket(@m_DefMsg, sSendMsg);
    Exit;
  end;

  Inc(Buffer, SizeOf(TStorageViewItemListHeader));
  for I := nIndex to ItemList.Count - 1 do
  begin
    UserItem := ItemList.Items[I];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);

    if StdItem <> nil then
    begin
      ClientItem := pTClientItem(Buffer);
      UserItemToClientItem(UserItem, StdItem, ClientItem, True, False);
      Inc(nC);
      Inc(Buffer, SizeOf(TClientItem));
      if nC >= ONEPAGECOUNT then
        Break;
    end
    else
      MainOutMessage(Format('[提示] [%s]未发现无限仓库物品(idx:%d)', [m_sCharName, UserItem.wIndex]));
  end;

  sSendMsg := zLibCompressBuffer(InBuf, SizeOf(TStorageViewItemListHeader) + nC * SizeOf(TClientItem));
  m_DefMsg := MakeDefaultMsg(SM_STORAGEVIEWITEMLIST, NPC, Length(sSendMsg), Integer(IsExtStorage),
    MakeWord(nC, Integer(IsTakeBackItem)));

  SendSocket(@m_DefMsg, sSendMsg);
end;

