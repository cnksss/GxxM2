                begin
                  ErrNum := 19;
                  Dispose(OldItem);
                  SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
                  Exit;
                end;
                ErrNum := 20;
                if (g_FunctionNPC <> nil) then
                begin
                  if (TakeOffItem.btValue[13] = 1) and (TakeOffItem.Name <> '') then
