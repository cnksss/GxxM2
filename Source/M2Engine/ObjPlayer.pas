procedure TPlayObject.SendNotice(IsRealSendNotice: Boolean);
var
  LoadList: TStringList;
  I: Integer;
  sNoticeMsg, S: AnsiString;
  SendCode: LongWord;
  len: Integer;
  a, b, c: DWORD;
  k: Integer;
begin
  if IsRealSendNotice then
  begin
    LoadList := TStringList.Create;
    NoticeManager.GetNoticeMsg('Notice', LoadList);
    sNoticeMsg := '';
    for I := 0 to LoadList.Count - 1 do
    begin
      S := LoadList.Strings[I];
      S := WideReplaceText(S, '<$username>', m_sCharName);
      S := WideReplaceText(S, '<$userid>', m_sUserID);
      sNoticeMsg := sNoticeMsg + S + sLineBreak;
    end;
    LoadList.Free;
    sNoticeMsg := zLibCompressString(sNoticeMsg);
    // VMProtectBegin('VMProtect_SendNotice');
    Randomize;
    SendCode := Random(High(Integer));
    len := Length(sNoticeMsg);
    // k为string类型数据(url) 的下标, 起始值从1开始
    k := 1;
    a := SendCode;
    b := $609CD4C4; // 9E3779B9
    c := $14A54394; // E6359A60
    while len >= 12 do
    begin
      a := a + DWORD(Ord(sNoticeMsg[k + 0]) + (Ord(sNoticeMsg[k + 1]) shl 8) + (Ord(sNoticeMsg[k + 2]) shl 16) +
        (Ord(sNoticeMsg[k + 3]) shl 24));
      b := b + DWORD(Ord(sNoticeMsg[k + 4]) + (Ord(sNoticeMsg[k + 5]) shl 8) + (Ord(sNoticeMsg[k + 6]) shl 16) +
        (Ord(sNoticeMsg[k + 7]) shl 24));
      c := c + DWORD(Ord(sNoticeMsg[k + 8]) + (Ord(sNoticeMsg[k + 9]) shl 8) + (Ord(sNoticeMsg[k + 10]) shl 16) +
        (Ord(sNoticeMsg[k + 11]) shl 24));
      // a -= b; a -= c; a ^= c >> 13;
      a := a - b;
      a := a - c;
      a := a xor (c shr 13);
      // b -= c; b += a; b ^= a << 8;
      b := b + c;
      b := b - a;
      b := b xor (a shl 8);
      // c -= a; c += b; c ^= b >> 15;
      c := c - a;
      c := c + b;
      c := c xor (b shr 3);
      Inc(k, 12);
      Dec(len, 12);
    end;
    c := c + DWORD(Length(sNoticeMsg));
    if len >= 11 then
      c := c + DWORD(Ord(sNoticeMsg[k + 10]) shl 24);
    if len >= 10 then
      c := c + DWORD(Ord(sNoticeMsg[k + 9]) shl 16);
    if len >= 9 then
      c := c + DWORD(Ord(sNoticeMsg[k + 8]) shl 8);
    if len >= 8 then
      b := b + DWORD(Ord(sNoticeMsg[k + 7]) shl 24);
    if len >= 7 then
      b := b + DWORD(Ord(sNoticeMsg[k + 6]) shl 16);
    if len >= 6 then
      b := b + DWORD(Ord(sNoticeMsg[k + 5]) shl 8);
    if len >= 5 then
      b := b + DWORD(Ord(sNoticeMsg[k + 4]));
    if len >= 4 then
      a := a + DWORD(Ord(sNoticeMsg[k + 3]) shl 24);
    if len >= 3 then
      a := a + DWORD(Ord(sNoticeMsg[k + 2]) shl 16);
    if len >= 2 then
      a := a + DWORD(Ord(sNoticeMsg[k + 1]) shl 8);
    if len >= 1 then
      a := a + DWORD(Ord(sNoticeMsg[k + 0]));
    // a -= b; a -= c; a ^= c >> 13;
    a := a - b;
    a := a - c;
    a := a xor (c shr 13);
    // b -= c; b += a; b ^= a << 8;
    b := b + c;
    b := b - a;
    b := b xor (a shl 8);
    // c -= a; c += b; c ^= b >> 15;
    c := c - a;
    c := c + b;
    c := c xor (b shr 3);
    FRecbNoticeCode := c;
    // VMProtectEnd();
    m_DefMsg := MakeDefaultMsg(SM_SENDNOTICE, 2000, Length(sNoticeMsg), LoWord(SendCode), HiWord(SendCode));
    SendSocket(@m_DefMsg, sNoticeMsg);
    FIsSendRunNotice := True;
  end
  else
  begin
    // g_boUseClientPickItems := DefMsg.Param = 1;
    m_DefMsg := MakeDefaultMsg(SM_SENDNOTICE, 0, 0, 0, 0);
    SendSocket(@m_DefMsg, '');
  end;
end;

procedure TPlayObject.UserLogon;
var
  nC: Integer;
  btAttatckMode: Byte;
  boChange: Boolean;
  I: Integer;
  II: Integer;
  UserItem: pTUserItem;
  UserItem1: pTUserItem;
  StdItem: pTStdItem;
  s14: string;
  sItem: string;
  sIPaddr: string;
  Envir: TEnvirnoment;
  Code: Integer;
  UserMagic: pTUserMagic;
  CustomMagicConfig: TCustomMagicConfig;
  PayInfo: pTPayInfo;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.UserLogon; Code=';
  sCheckIPaddrFail = '登录IP地址不匹配！';
begin
  ChangeMyShopType;
  if (g_PluginManager <> nil) then
    g_PluginManager.HookPlayerLogin1(Self);

  Code := 1;
  sIPaddr := '';
  try
    if g_Config.boTestServer then
    begin
      if m_Abil.Level < g_Config.nTestLevel then
        m_Abil.Level := g_Config.nTestLevel;

      if m_nGold < g_Config.nTestGold then
        m_nGold := g_Config.nTestGold;
    end;

    Code := 2;
    if g_Config.boTestServer or (g_Config.boServiceMode) then
      m_nPayMent := 3;

    m_dwMapMoveTick := MyGetTickCount();
    m_dLogonTime := Now();
    m_dwLogonTick := MyGetTickCount();
    Code := 3;
    Initialize();
    Code := 4;
    SendMissionNPC; // 任务NPC
    Code := 5;
    SendMsg(Self, RM_LOGON, 0, 0, 0, 0, '');
    Code := 6;
    if (m_Abil.Level <= 7) and (GetRangeHumanCount >= 80) then
      MapRandomMove(m_PEnvir.sMapName, 0);

    Code := 7;
    if m_boDieInFight3Zone then
      MapRandomMove(m_PEnvir.sMapName, 0);

    Code := 8;
    UserEngine.GetHumPermission(m_sCharName, sIPaddr, m_btPermission);
    Code := 9;
    GetStartPoint();
    Code := 10;
    if not m_boDummyObject then
    begin
      Code := 11;
      if m_MagicList.Count > 0 then
      begin
        for I := 0 to m_MagicList.Count - 1 do
        begin
          if m_MagicList.Count <= 0 then
            Break;

          if pTUserMagic(m_MagicList.Items[I]) <> nil then
            sub_4C713C(pTUserMagic(m_MagicList.Items[I]));
        end;
      end;

      Code := 12;
      if m_boNewHuman then
      begin
        Code := 13;
        New(UserItem);
        if UserEngine.CopyToUserItemFromName(g_Config.sCandle, UserItem) then
        begin
          UserItem.ItemFrom.ItemForm := ifSysGive;
          UserItem.ItemFrom.sMakerName := m_sCharName;
          UserItem.ItemFrom.DateTime := Now();
          m_ItemList.Add(UserItem);
        end
        else
          Dispose(UserItem);

        Code := 14;
        New(UserItem);
        if UserEngine.CopyToUserItemFromName(g_Config.sBasicDrug, UserItem) then
        begin
          UserItem.ItemFrom.ItemForm := ifSysGive;
          UserItem.ItemFrom.sMakerName := m_sCharName;
          UserItem.ItemFrom.DateTime := Now();
          m_ItemList.Add(UserItem);
        end
        else
          Dispose(UserItem);
        Code := 15;

        New(UserItem);
