      begin
        ErrCode := 20;
        m_DefMsg := MakeDefaultMsg(SM_STRUCK, NativeInt(ProcessMsg.BaseObject), LoWord(ProcessMsg.wParam),
          HiWord(ProcessMsg.wParam), MakeWord(BoolToInt(ProcessMsg.wIdent = RM_STRUCK_MAG), BoolToInt(ProcessMsg.sMsg = '1')));
        ErrCode := 21;
        // 修复别人的护身显示不正常 chongchong 2014-10-27 15:49:55
        NewMessageBodyWL.lParam1 := BaseObject.m_WAbil.HP;
        NewMessageBodyWL.lParam2 := BaseObject.m_WAbil.MaxHP;
        { TODO -ochongchong -c修改 : 修改打怪下血的飘血效果,经常显示出为几次伤害叠加的效果 【2013-07-24】 }
        // NewMessageBodyWL.lTag1 := ProcessMsg.nParam3;        // 攻击者地址
        NewMessageBodyWL.lTag1 := ProcessMsg.wParam; // 当前血量改变
        // 修正浑水摸鱼地图，英雄受到攻击后，等级为0 2020-05-12 22:21:22
        if (BaseObject.m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and (TObject(ProcessMsg.BaseObject) <> Self) and
          (TObject(ProcessMsg.BaseObject) <> m_MyHero) then
          NewMessageBodyWL.lTag2 := 0
        else if (BaseObject.m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and
