procedure TPlayObject.ClientUpdateActiveFengHao(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem, TempUserItem: pTUserItem;
  StdItem: pTStdItem;
  SmartObject: TSmartObject;
  IsHero: Boolean;
begin
  IsHero := Boolean(ProcessMsg.nParam3);
  if IsHero then
    SmartObject := TSmartObject(m_MyHero)
  else
    SmartObject := Self;
  if SmartObject = nil then
    Exit;
  if ProcessMsg.nParam1 = -1 then
  begin
    if (SmartObject.m_ActiveFengHao >= 0) and (SmartObject.m_ActiveFengHao < SmartObject.m_FengHaoItems.Count) and
      (g_FunctionNPC <> nil) then
    begin
      UserItem := SmartObject.m_FengHaoItems.Items[SmartObject.m_ActiveFengHao];
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem <> nil then
      begin
        m_nScriptGotoCount := 0;
        if not IsHero then
          g_FunctionNPC.GotoLable(Self, '@UnactiveTitle_' + IntToStr(StdItem.Shape), False)
        else
          g_FunctionNPC.GotoLable(Self, '@HeroUnactiveTitle_' + IntToStr(StdItem.Shape), False);
      end;
    end;
    SmartObject.m_ActiveFengHao := -1;
  end
  else
  begin
    for I := 0 to SmartObject.m_FengHaoItems.Count - 1 do
    begin
      UserItem := SmartObject.m_FengHaoItems.Items[I];
      if UserItem.MakeIndex = ProcessMsg.nParam1 then
      begin
        if SmartObject.m_ActiveFengHao <> I then
        begin
          if (SmartObject.m_ActiveFengHao >= 0) and (SmartObject.m_ActiveFengHao < SmartObject.m_FengHaoItems.Count) and
            (g_FunctionNPC <> nil) then
          begin
            TempUserItem := SmartObject.m_FengHaoItems.Items[SmartObject.m_ActiveFengHao];
            StdItem := UserEngine.GetStdItem(TempUserItem.wIndex);
            if StdItem <> nil then
            begin
              m_nScriptGotoCount := 0;
              if not IsHero then
                g_FunctionNPC.GotoLable(Self, '@UnactiveTitle_' + IntToStr(StdItem.Shape), False)
              else
                g_FunctionNPC.GotoLable(Self, '@HeroUnactiveTitle_' + IntToStr(StdItem.Shape), False)
            end;
          end;
          SmartObject.m_ActiveFengHao := I;
          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if StdItem <> nil then
          begin
            m_nScriptGotoCount := 0;
            if not IsHero then
              g_FunctionNPC.GotoLable(Self, '@ActiveTitle_' + IntToStr(StdItem.Shape), False)
            else
              g_FunctionNPC.GotoLable(Self, '@HeroActiveTitle_' + IntToStr(StdItem.Shape), False)
          end;
        end;
        Break;
      end;
    end;
  end;
  m_DefMsg := MakeDefaultMsg(SM_ACTIVEFENGHAOITEM, SmartObject.m_ActiveFengHao, 0, Word(IsHero), 0);
  SendSocket(@m_DefMsg, '');
  SmartObject.RecalcAbilitys;
  SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
  SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
  SmartObject.FeatureChanged;
end;

