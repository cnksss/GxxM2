procedure TPlayObject.PKDie(PlayObject: TPlayObject);
var
  sChrName: string;
  nWinLevel, nLostLevel, nWinExp, nLostExp: Integer;
  boWinLEvel, boLostLevel, boWinExp, boLostExp, IsLevelChanged: Boolean;
begin
  nWinLevel := g_Config.nKillHumanWinLevel;
  nLostLevel := g_Config.nKilledLostLevel;
  nWinExp := g_Config.nKillHumanWinExp;
  nLostExp := g_Config.nKillHumanLostExp;
  boWinLEvel := g_Config.boKillHumanWinLevel;
  boLostLevel := g_Config.boKilledLostLevel;
  boWinExp := g_Config.boKillHumanWinExp;
  boLostExp := g_Config.boKilledLostExp;
  if m_PEnvir.m_boPKWINLEVEL then
  begin
    boWinLEvel := True;
    nWinLevel := m_PEnvir.m_nPKWINLEVEL;
  end;

  if m_PEnvir.m_boPKLOSTLEVEL then
  begin
    boLostLevel := True;
    nLostLevel := m_PEnvir.m_nPKLOSTLEVEL;
  end;

  if m_PEnvir.m_boPKWINEXP then
  begin
    boWinExp := True;
    nWinExp := m_PEnvir.m_nPKWINEXP;
  end;

  if m_PEnvir.m_boPKLOSTEXP then
  begin
    boLostExp := True;
    nLostExp := m_PEnvir.m_nPKLOSTEXP;
  end;

  if PlayObject.m_Abil.Level - m_Abil.Level > g_Config.nHumanLevelDiffer then
  begin
    if not PlayObject.IsGoodKilling(Self) then
    begin
      if PlayObject.m_boDummyObject then
        PlayObject.IncPkPoint(g_Config.nDummyAddPKPoint)
      else
        PlayObject.IncPkPoint(g_Config.nKillHumanAddPKPoint { 100 } );

      PlayObject.SysMsg(g_sYouMurderedMsg { '你犯了谋杀罪！' } , c_Red, t_Hint);

      // 是否显示神秘人 piaoyun 2013-08-17
      if (m_LastHiter.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) //
        and TSmartObject(m_LastHiter).m_boMysteriousMan //
        and g_Config.boShowMysteriousMan then
        sChrName := g_Config.sMysteriousManName
      else
        sChrName := m_LastHiter.m_sCharName;

      SysMsg(Format(g_sYouKilledByMsg, [sChrName]), c_Red, t_Hint);
      PlayObject.AddBodyLuck(-g_Config.nKillHumanDecLuckPoint { 500 } );

      { -ochongchong -c修改 : 杀人武器诅咒机率 【2013-08-17】 }
      if Random(g_Config.dwKillHumanWeaponUnlockRate) = 0 then
        PlayObject.MakeWeaponUnlock;
    end
    else
      PlayObject.SysMsg(g_sYouProtectedByLawOfDefense { '[你受到正当规则保护。]' } , c_Green, t_Hint);
    Exit;
  end;

  if boWinLEvel then
  begin
    if g_Config.btMaxLevel = 0 then
    begin
      if PlayObject.m_Abil.Level + nWinLevel <= MAXUPLEVEL then
        Inc(PlayObject.m_Abil.Level, nWinLevel)
      else
        PlayObject.m_Abil.Level := MAXUPLEVEL;
    end
    else if g_Config.btMaxLevel = 1 then
    begin
      if PlayObject.m_Abil.Level + nWinLevel <= High(Integer) then
        Inc(PlayObject.m_Abil.Level, nWinLevel)
      else
        PlayObject.m_Abil.Level := High(Integer);
    end
    else
    begin
      if PlayObject.m_Abil.Level + nWinLevel <= High(LongWord) then
        Inc(PlayObject.m_Abil.Level, nWinLevel)
      else
        PlayObject.m_Abil.Level := High(LongWord);
    end;

    if boLostLevel then
    begin
      if PKLevel >= 2 then
      begin
        if m_Abil.Level >= nLostLevel * 2 then
          Dec(m_Abil.Level, nLostLevel * 2);
      end
      else if m_Abil.Level >= nLostLevel then
        Dec(m_Abil.Level, nLostLevel);
    end;
    PlayObject.HasLevelUp(PlayObject.m_Abil.Level - nWinLevel);
  end
  else if boLostLevel then
  begin
    if PKLevel >= 2 then
    begin
      if m_Abil.Level >= nLostLevel * 2 then
        Dec(m_Abil.Level, nLostLevel * 2);
    end
    else if m_Abil.Level >= nLostLevel then
      Dec(m_Abil.Level, nLostLevel);

    PlayObject.HasLevelUp(m_Abil.Level);
  end;

  if boWinExp or boLostExp then
  begin
    if boWinExp then
      PlayObject.WinExp(nWinExp);

    if boLostExp then
    begin
      IsLevelChanged := False;
      if m_Abil.Exp >= LongWord(nLostExp) then
      begin
        if m_Abil.Exp >= LongWord(nLostExp) then
          Dec(m_Abil.Exp, LongWord(nLostExp))
        else
          m_Abil.Exp := 0;
      end
      else
      begin
        if m_Abil.Level >= 1 then
        begin
          Dec(m_Abil.Level);
          IsLevelChanged := True;
          Inc(m_Abil.Exp, GetLevelExp(m_Abil.Level));
          if m_Abil.Exp >= LongWord(nLostExp) then
            Dec(m_Abil.Exp, LongWord(nLostExp))
          else
            m_Abil.Exp := 0;
        end
        else
        begin
          m_Abil.Level := 0;
          m_Abil.Exp := 0;
        end;
      end;

      if IsLevelChanged then
        HasLevelUp(m_Abil.Level)
      else
        SendMsg(Self, RM_WINEXP, 0, 0, 0, 0, '');
    end;
  end;
end;

// 触发函数
function TPlayObject.DieGotoLable(): Boolean;
begin
  if (m_LastHiter <> nil) and (m_btRaceServer = RC_PLAYOBJECT) then
  begin
    if m_LastHiter.m_Master <> nil then
    begin
      if m_LastHiter.m_Master.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(m_LastHiter.m_Master).KillPlayFunc;
    end
    else if m_LastHiter.m_btRaceServer = RC_PLAYOBJECT then
      TPlayObject(m_LastHiter).KillPlayFunc;

    Result := DieFunc(); // 死亡触发
    Exit;
  end;
  Result := DieFunc(); // 死亡触发
end;

