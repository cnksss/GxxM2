procedure TPlayObject.ClientHeroTakeOnJewelry(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  sUserItemName: string;
  nMakeIndex: Integer;
  sItemName: string;
  StdItem: pTStdItem;
  JewelryIndex: Integer;
  OldJewelryItem: pTUserItem;
  TakeOffItem: TUserItem;
begin
  if m_MyHero = nil then
    Exit;
  nMakeIndex := ProcessMsg.nParam1;
  JewelryIndex := ProcessMsg.nParam2;
  sItemName := DecodeString(ProcessMsg.sMsg);
  if m_MyHero.m_boOffLine or m_MyHero.m_boGhost or
    (not(JewelryIndex in [Low(THumanJewelryBoxItems) .. High(THumanJewelryBoxItems)])) then
  begin
    SendDefMessage(SM_TAKEONJEWELRY_FAIL, 1, 0, 0, 0, '');
    Exit;
  end;
  for I := 0 to m_MyHero.m_ItemList.Count - 1 do
  begin
    UserItem := m_MyHero.m_ItemList.Items[I];
    if UserItem.MakeIndex = nMakeIndex then
    begin
      // 取自定义物品名称
      if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
        sUserItemName := UserItem.Name
      else
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (StdItem <> nil) and (CompareText(sUserItemName, sItemName) = 0) then
      begin
        if (StdItem.Overlap and 2 <> 0) and ((StdItem.Expand1 = JewelryIndex + 1) or (StdItem.Expand1 in [0, 7])) and
          (GetTakeOnPosition(StdItem.StdMode) in [U_HELMET { 头盔 } , U_NECKLACE { 项链 } , U_ARMRINGL { 左手镯 } , U_ARMRINGR { 右手镯 } ,
          U_RINGL { 左戒指 } , U_RINGL { 右戒指 } ]) then
        begin
          if not THeroObject(m_MyHero).CheckTakeOnItems(U_JEWELRYITEM1 + JewelryIndex, StdItem) then
          begin
            SendDefMessage(SM_TAKEONJEWELRY_FAIL, 1, 0, 0, 0, '');
            Exit;
          end;
          if g_ItemRules.Get(UserItem.wIndex, 7) then
          begin
            SysMsg('物品禁止英雄使用', c_Red, t_Hint);
            SendDefMessage(SM_TAKEONJEWELRY_FAIL, 1, 0, 0, 0, '');
            Exit;
          end;
          if THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex].wIndex > 0 then
          begin
            if InDisableTakeOffList(THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex].wIndex) or
              (GetUserItemBindValue(@THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex], ubNoTakeOff) and THeroObject(m_MyHero)
              .m_JewelryBoxItems[JewelryIndex].boIsBind) then
            begin
              SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
              SendDefMessage(SM_TAKEONJEWELRY_FAIL, 1, 0, 0, 0, '');
              Exit;
            end;
            if (THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex].btValue[13] = 1) and
              (THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex].Name <> '') then
              sUserItemName := THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex].Name
            else
              sUserItemName := UserEngine.GetStdItemName(THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex].wIndex);
            THeroObject(m_MyHero).m_nCurrentItemMakeIndex := THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex].MakeIndex;
            THeroObject(m_MyHero).m_nCurrentItemPos := JewelryIndex + U_JEWELRYITEM1;
            THeroObject(m_MyHero).m_sCurrentItemName :=
              UserEngine.GetStdItemName(THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex].wIndex);
            THeroObject(m_MyHero).m_sCurrentItemNewName := sUserItemName;
            THeroObject(m_MyHero).m_PickUpOrDropItem := THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex];
            THeroObject(m_MyHero).m_boStopTakeOff := False;
            g_FunctionNPC.GotoLable(Self, '@HeroBeginTakeOff', False);
            THeroObject(m_MyHero).m_PickUpOrDropItem.MakeIndex := 0;
            THeroObject(m_MyHero).m_PickUpOrDropItem.wIndex := 0;
            THeroObject(m_MyHero).m_nCurrentItemMakeIndex := 0;
            THeroObject(m_MyHero).m_nCurrentItemPos := 0;
            THeroObject(m_MyHero).m_sCurrentItemName := '';
            THeroObject(m_MyHero).m_sCurrentItemNewName := '';
            if THeroObject(m_MyHero).m_boStopTakeOff then
            begin
              SendDefMessage(SM_TAKEONJEWELRY_FAIL, 1, 0, 0, 0, '');
              Exit;
            end;
          end;
          if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
            sUserItemName := UserItem.Name
          else
            sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
          THeroObject(m_MyHero).m_nCurrentItemMakeIndex := UserItem.MakeIndex;
          THeroObject(m_MyHero).m_nCurrentItemPos := JewelryIndex + U_JEWELRYITEM1;
          THeroObject(m_MyHero).m_sCurrentItemName := UserEngine.GetStdItemName(UserItem.wIndex);
          THeroObject(m_MyHero).m_sCurrentItemNewName := sUserItemName;
          THeroObject(m_MyHero).m_PickUpOrDropItem := UserItem^;
          THeroObject(m_MyHero).m_boStopTakeOn := False;
          g_FunctionNPC.GotoLable(Self, '@HeroBeginTakeOn', False);
          THeroObject(m_MyHero).m_PickUpOrDropItem.MakeIndex := 0;
          THeroObject(m_MyHero).m_PickUpOrDropItem.wIndex := 0;
          THeroObject(m_MyHero).m_nCurrentItemMakeIndex := 0;
          THeroObject(m_MyHero).m_nCurrentItemPos := 0;
          THeroObject(m_MyHero).m_sCurrentItemName := '';
          THeroObject(m_MyHero).m_sCurrentItemNewName := '';
          if THeroObject(m_MyHero).m_boStopTakeOn then
          begin
            SendDefMessage(SM_TAKEONJEWELRY_FAIL, 1, 0, 0, 0, '');
            Exit;
          end;
          if THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex].wIndex > 0 then
          begin
            New(OldJewelryItem);
            OldJewelryItem^ := THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex];
            TakeOffItem := OldJewelryItem^;
            // 将首饰盒的物品放到包裹中
            if m_MyHero.AddItemToBag(OldJewelryItem) then
            begin
              THeroObject(m_MyHero).SendAddItem(OldJewelryItem);
            end
            else
            begin
              Dispose(OldJewelryItem);
              SendDefMessage(SM_TAKEONJEWELRY_FAIL, 1, 0, 0, 0, '');
              Exit;
            end;
            if (g_FunctionNPC <> nil) then
            begin
              m_nScriptGotoCount := 0;
              THeroObject(m_MyHero).m_PickUpOrDropItem := TakeOffItem;
              if (TakeOffItem.btValue[13] = 1) and (TakeOffItem.Name <> '') then
                sItemName := TakeOffItem.Name
              else
                sItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
              THeroObject(m_MyHero).m_nCurrentItemMakeIndex := TakeOffItem.MakeIndex;
              THeroObject(m_MyHero).m_nCurrentItemPos := U_JEWELRYITEM1 + JewelryIndex;
              THeroObject(m_MyHero).m_sCurrentItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
              THeroObject(m_MyHero).m_sCurrentItemNewName := sItemName;
              g_FunctionNPC.GotoLable(Self, '@HeroTakeOff' + IntToStr(U_JEWELRYITEM1 + JewelryIndex), False);
              g_FunctionNPC.GotoLable(Self, '@HeroTakeOffEx', False);
              THeroObject(m_MyHero).m_PickUpOrDropItem.MakeIndex := 0;
              THeroObject(m_MyHero).m_PickUpOrDropItem.wIndex := 0;
              THeroObject(m_MyHero).m_nCurrentItemMakeIndex := 0;
              THeroObject(m_MyHero).m_nCurrentItemPos := 0;
              THeroObject(m_MyHero).m_sCurrentItemName := '';
              THeroObject(m_MyHero).m_sCurrentItemNewName := '';
            end;
          end;
          // 删除包裹中的原物品
          m_MyHero.m_ItemList.Delete(I);
          // 将包裹中的物品放到首饰盒中
          THeroObject(m_MyHero).m_JewelryBoxItems[JewelryIndex] := UserItem^;
          SendDefMessage(SM_TAKEONJEWELRY_OK, 1, 0, 0, 0, '');
          if (StdItem.Need in [101, 102]) and (not UserItem.boStartTime) then
          begin
            UserItem.nLimitTime := StdItem.NeedLevel;
            UserItem.boStartTime := True;
            SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System);
          end;
          if g_FunctionNPC <> nil then
          begin
            THeroObject(m_MyHero).m_nCurrentItemMakeIndex := UserItem.MakeIndex;
            THeroObject(m_MyHero).m_nCurrentItemPos := U_JEWELRYITEM1 + JewelryIndex;
            THeroObject(m_MyHero).m_sCurrentItemName := StdItem.Name;
            THeroObject(m_MyHero).m_sCurrentItemNewName := sUserItemName;
            g_FunctionNPC.GotoLable(Self, '@HeroTakeOn' + IntToStr(JewelryIndex + U_JEWELRYITEM1), False);
            g_FunctionNPC.GotoLable(Self, '@HeroTakeOnEx', False);
            THeroObject(m_MyHero).m_nCurrentItemMakeIndex := 0;
            THeroObject(m_MyHero).m_nCurrentItemPos := 0;
            THeroObject(m_MyHero).m_sCurrentItemName := '';
            THeroObject(m_MyHero).m_sCurrentItemNewName := '';
          end;
          Dispose(UserItem);
          m_MyHero.RecalcAbilitys();
          m_MyHero.WeightChanged;
          m_MyHero.SendMsg(m_MyHero, RM_ABILITY, 0, 0, 0, 0, '');
          m_MyHero.SendMsg(m_MyHero, RM_SUBABILITY, 0, 0, 0, 0, '');
          m_MyHero.FeatureChanged;
          Exit;
        end;
      end;
    end;
  end;
  SendDefMessage(SM_TAKEONJEWELRY_FAIL, 1, 0, 0, 0, '');
end;

