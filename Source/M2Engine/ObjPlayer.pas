  GuildName: string;
begin
  nC := 0;
  GuildName := DecodeString(ProcessMsg.sMsg);
  Guild := g_GuildManager.FindGuild(GuildName);

  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    nC := 1
  else if Guild = nil then
    nC := 2
  else if Guild.IsRequestAllListGuild(TGUild(m_MyGuild)) then
    nC := 3
  else if Guild.IsAllyGuild(TGUild(m_MyGuild)) then
    nC := 4
  else if (not Guild.EnabledAlly) then
    nC := 5
  else if m_MyGuild = Guild then
    nC := 6
  else if TGUild(m_MyGuild).IsWarGuild(Guild) then // Cursor 2023-05-27 16:56:26 （不能和敌对行会，以及联盟行会的敌对行会结盟）
    nC := 7
  else
    Guild.AddRequestAllListGuild(TGUild(m_MyGuild));

  SendDefMessage(SM_GUILDREQUESTALLY_RET, nC, 0, 0, 0, GuildName);
end;

