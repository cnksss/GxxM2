function TPlayObject.Operate(ProcessMsg: pTProcessMessage): Boolean;
resourcestring
  HookErrorFilterStart = '[Exception] HookPlayObjectFilterStartOperateMessage';
  HookErrorFilterStop = '[Exception] HookPlayObjectFilterStopOperateMessage';
var
  boReturn: BOOL;
  ProcessMessage: TProcessMessage;

  function ProcessPlayObjectMessage(ProcessMsg: pTProcessMessage; var boResult: Boolean): Boolean;
  begin
    Result := False;
    if (ProcessMsg.wIdent > 0) and (ProcessMsg.wIdent <= MAXCLIENTMESSAGECOUNT) then
    begin
      Result := True;
      if Assigned(PlayObjectMessageArray[ProcessMsg.wIdent]) then // 3010  20001   20065   20410  3017
      begin
        try
          PlayObjectMessageArray[ProcessMsg.wIdent](ProcessMsg, boResult);
        except
          MainOutMessage('ProcessPlayObjectMessage Error; wIdent:' + IntToStr(ProcessMsg.wIdent));
        end;
      end;
    end;
  end;

  function CanFilter(wIdent: Word): Boolean;
  begin
    Result := True;
    case wIdent of
      RM_HEAR, RM_WHISPER, RM_CRY, RM_SYSMESSAGE, RM_SYSMESSAGE_EX, RM_GROUPMESSAGE, RM_GUILDMESSAGE, RM_DELAYMESSAGE,
        RM_CENTERMESSAGE, RM_TOPCHATBOARDMESSAGE, RM_MOVEMESSAGE, RM_MOVEMESSAGE_NEW, RM_SCREENMESSAGE, RM_CHANGESPEED,
        RM_SERVERCONFIG:
        Result := False;
    end;
  end;

begin
  Result := True;
  if (ProcessMsg = nil) or (ProcessMsg.wIdent = 0) then
  begin
    Result := False;
    Exit;
  end;

  ProcessMessage := ProcessMsg^;
  boReturn := False;
  if g_PluginManager <> nil then
  begin
    g_PluginManager.HookPlayerProcessMsgBegin(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2,
      ProcessMsg.nParam3, TBaseObject(ProcessMsg.BaseObject), ProcessMsg.dwDeliveryTime, PAnsiChar(AnsiString(ProcessMsg.sMsg)),
      boReturn);

    if boReturn and CanFilter(ProcessMessage.wIdent) then
      Exit;
  end;

  if CanFilter(ProcessMessage.wIdent) then
  begin
    if not ProcessPlayObjectMessage(ProcessMsg, Result) then
      Result := inherited Operate(ProcessMsg);
  end
  else if not ProcessPlayObjectMessage(@ProcessMessage, Result) then
    Result := inherited Operate(@ProcessMessage);

  boReturn := False;
  if g_PluginManager <> nil then
  begin
    g_PluginManager.HookPlayerProcessMsgEnd(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2,
      ProcessMsg.nParam3, TBaseObject(ProcessMsg.BaseObject), ProcessMsg.dwDeliveryTime, PAnsiChar(AnsiString(ProcessMsg.sMsg)),
      boReturn);
  end;
end;

procedure TPlayObject.Run();
var
  tObjCount: Integer;
  nInteger: Integer;
  wHour: Word;
  wMin: Word;
  wSec: Word;
  wMSec: Word;
  ProcessMsg: TProcessMessage;
  boInSafeArea: Boolean;
  I, II: Integer;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  BaseObject: TBaseObject;
  PlayObject: TPlayObject;
  PushedObject: TBaseObject;
  boTakeItem: Boolean;
  Castle: TUserCastle;
  BaseObjectList: TList;
  dwStationTick: LongWord;
  TimeLabel: pTTimeLabel;
  dwAttackTime: LongWord;
  dwCheckActionCountTime: LongWord;
  dwActionTime, nDelayTime: LongWord;
  boRefNameColor: Boolean;
  nError: Integer;
  nX, nY: Integer;
  CurTick: LongWord;
  Int64Value: Int64;
  OldGoldCount: LongWord;
  CustomMagicConfig: TCustomMagicConfig;
  m_MirrorMapHasTick: Integer;
  ClientBufInfo: PClientBufInfo;
  ArrBufInfo: PArrBufInfo;
  CloseArr: array of Integer;
  sExitMap: string;
  nDay: Integer;
  GuardinaLevelStatue: TGameObject;
  ItemObject: TItemObject;
  MagciCD: LongWord;
resourcestring
  sPayMentExpire = '您的帐户充值时间已到期！';
  sDisConnectMsg = '游戏被强行中断！';
  sExceptionMsg1 = '[Exception] TPlayObject.Run -> Operate 1 Code=%d';
  sExceptionMsg2 = '[Exception] TPlayObject.Run -> Operate 2 # %s Ident:%d Sender:%d wP:%d nP1:%d nP2:%d np3:%d Msg:%s';
  sExceptionMsg3 = '[Exception] TPlayObject.Run -> GetHighHuman';
  sExceptionMsg4 = '[Exception] TPlayObject.Run -> ClearObj';
  sExceptionMsg5 = '[Exception] TPlayObject.Run -> 5';
  sExceptionMsg6 = '[Exception] TPlayObject.Run -> GotoLabel:%s';
  sExceptionMsg7 = '[Exception] TPlayObject.Run -> Code: %d';
  sExceptionMsg8 = '[Exception] TPlayObject.TimeMap -> Code: %d GotoLabel:%s';
  sHookErrorRun = '[Exception] HookPlayObjectRun';
  sUsePluginMsg = '请勿使用非法软件修改游戏速度!';
begin
  if m_boDelayClose and (Tick_Diff(m_dwDelayCloseTick, MyGetTickCount) >= m_dwDelayCloseTime) then
  begin
    DoClientClose;
    SendDefMessage(SM_SOFTCLOSE, 0, 0, 0, 0, '');
    m_boSoftClose := True;
    m_boOffLine := False;
    m_boReconnection := False;
    m_boPlayOffLine := False; // 关闭下线触发
  end;

  if g_boExitServer then
  begin
    m_boEmergencyClose := True;
    m_boOffLine := False;
    m_boPlayOffLine := False; // 关闭下线触发
  end;

  nDay := Trunc(Now);
  if nDay <> m_nClearDayVarTime then
  begin
    if HourOf(Now) >= g_Config.btPlayerVarJClearTime then
    begin
      m_nClearDayVarTime := nDay;
      FillChar(m_JVal, SizeOf(m_JVal), 0);
      FillChar(m_ZVal, SizeOf(m_ZVal), 0);

      if g_Config.boOpenCombatPowerCalc and g_Config.boOpenCombatPowerVarCalc then
        RecalcPlayCombatPower(Self);
    end;
  end;

  if m_boFixedHideMode then
    m_boFixedHideMode := False;

  if not m_boDummyObject then
  begin
    ProcessSafeZoneHint;
    if m_boCollecting then
    begin
      CurTick := MyGetTickCount;
      if CurTick - m_dwCollectTick >= m_dwCollectTime * 1000 then
        StopCollect
      else if CurTick - m_dwLastSendCollectTick >= 200 then
      begin
        m_dwLastSendCollectTick := CurTick;
        // (CurTick - m_dwCollectTick) / (m_dwCollectTime * 1000) * 100;
        SendMsg(Self, RM_UPDATECOLLECT, 0, 1, Round((CurTick - m_dwCollectTick) / (m_dwCollectTime * 10)), 0, '');
      end;
    end;

    if not g_Config.boGroupUseOldMode then
    begin
      for I := m_sInviteGroupHuman.Count - 1 downto 0 do
      begin
        CurTick := LongWord(m_sInviteGroupHuman.Objects[I]);
        if MyGetTickCount - CurTick >= 15000 then
        begin
          SysMsg(m_sInviteGroupHuman.Strings[I] + ' 未响应组队请求', c_Red, t_System);
          m_sInviteGroupHuman.Delete(I);
        end;
      end;
    end;
  end;

  if (Length(m_sVerifyCode) > 0) and (MyGetTickCount - m_dwVerifyCodeTick >= g_Config.nVerifyCodeTimeOut * 1000) then
  begin
    m_sVerifyCode := '';
    m_boVerifyCodeCheckOK := False;
    m_nVerifyCodeRefreshCount := 0;
    m_nVerifyCodeErrorCount := 0;
    m_VerifyCodeGotoNpc := nil;
    m_sVerifyCodeGotoLabel := '';
  end;

  if (Length(m_sMobileNumber) > 0) //
    and (Length(m_sMobileVerifyCode) > 0) //
    and (Tick_Diff(m_dwMobileVerifyTick, MyGetTickCount) >= g_SendSMSConfig.VerifyCodeTimeOutTime * 1000) then
  begin
    m_sMobileVerifyCode := '';
    m_nMobileResendCount := 0;
    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@MobileVerifyCodeTimeOut', False);
    end;
  end;

  if m_boFindUsePlugin and (Tick_Diff(m_dwFindUsePluginTick, MyGetTickCount) >= m_dwFindUsePluginTime) then
  begin
    SysMsg(sUsePluginMsg, c_Red, t_Hint);
    m_boFindUsePlugin := False;
    m_boOffLine := False;
    m_boPlayOffLine := False;
    m_boEmergencyClose := True;
    m_boKickFlag := True;
  end;
  boRefNameColor := False;

  nError := 0;
  try
    nError := 1;
    if MyGetTickCount - m_dwCheckRunTick > 10 * 1000 then
    begin
      nError := 1001;
      m_dwCheckRunTick := MyGetTickCount();
      nError := 1002;
      if m_GroupOwner = Self then
      begin
        nError := 1003;
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          m_GroupMembers.LockW(27);
        try
{$IFEND}
          for I := m_GroupMembers.Count - 1 downto 0 do
          begin
            if m_GroupMembers.Count <= 0 then
              Break;

            nError := 1004;
            PlayObject := TPlayObject(m_GroupMembers.Objects[I]);
            if PlayObject <> nil then
            begin
              nError := 1005;
              if PlayObject.m_boDeath or (PlayObject.m_boGhost) then
              begin
                nError := 1006;
                PlayObject.LeaveGroup(False);
                m_GroupMembers.Delete(I);
              end;
            end;
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            m_GroupMembers.UnLockW;
        end;
{$IFEND}
      end; // 清组队已死亡成员 结束

      nError := 2;
      // 检查交易双方 状态
      if (m_DealCreat <> nil) and (m_DealCreat.m_boGhost) then
        m_DealCreat := nil;

      if g_Config.boUseHeroM2Shop then // 仿HeroM2摆摊
        for I := m_HeroM2ShopOpenList.Count - 1 downto 0 do
        begin
          PlayObject := TPlayObject(m_HeroM2ShopOpenList.Items[I]);
          if PlayObject.m_boGhost then
            m_HeroM2ShopOpenList.Delete(I);
        end;
    end;

    nError := 3;
    if MyGetTickCount - m_dwVerifyTick > 30 * 1000 then
    begin
      m_dwVerifyTick := MyGetTickCount();
      if not m_boDenyRefStatus then
        m_PEnvir.VerifyMapTime(m_nCurrX, m_nCurrY, Self); // 刷新在地图上位置的时间
    end;

    // 清组队已死亡成员
    if m_GroupOwner <> nil then
    begin
      if m_GroupOwner.m_boDeath or m_GroupOwner.m_boGhost then
      begin
        m_GroupOwner := nil;
        m_GroupMembers.Clear;
      end;
    end;

    nError := 4;
    if m_boDealing and not m_boIsMobile then
    begin // 检测交易对象
      if ((not m_DealCreat.m_boIsMobile) and (GetPoseCreate <> m_DealCreat)) or (m_DealCreat = Self) or (m_DealCreat = nil) then
        DealCancel();
    end;

    // 骑马 - 地图不允许骑马 chongchong 2013-10-13
    if (m_PEnvir.m_boNOHORSE) and (m_boOnHorse) then // 不允许骑马
    begin // 下马
      m_boOnHorse := False;
      m_boCanOnHorse := False;
      m_dwCanOnHorseTime := 0;
      m_dwDownHorseTick := MyGetTickCount;
      DoTalkStatusChanged;
      TriggerHorseScript;
      if m_boHorseMaster then
      begin
        if m_HorseOtherHum <> nil then
        begin
          m_HorseOtherHum.m_HorseOtherHum := nil;
          if m_HorseOtherHum.m_boOnHorse then
          begin
            m_HorseOtherHum.m_boOnHorse := False;
            m_HorseOtherHum.m_boCanOnHorse := False;
            m_HorseOtherHum.m_dwCanOnHorseTime := 0;
            m_HorseOtherHum.m_dwDownHorseTick := MyGetTickCount;
            m_HorseOtherHum.DoTalkStatusChanged;
            m_HorseOtherHum.TriggerHorseScript;
            m_HorseOtherHum.SendTakeOffHorse;
          end;
        end;
      end;
      SendTakeOffHorse;
    end;

    // 这个鬼地方莫名总是报错，将List换成 array chongchong 2018-06-09
    nError := 1333;
    if MyGetTickCount - m_dwCheckClientTick > 500 then
    begin
      m_dwCheckClientTick := MyGetTickCount();
      SetLength(CloseArr, 0);
      m_ClientBufList.LockR(1);
      try
        for I := m_ClientBufList.Count - 1 downto 0 do
        begin
          ClientBufInfo := m_ClientBufList[I];
          if ((ClientBufInfo.Time > 0) and (Tick_Diff(ClientBufInfo.StartTick, MyGetTickCount) >= ClientBufInfo.Time)) then
          begin
            SetLength(CloseArr, Length(CloseArr) + 1);
            CloseArr[Length(CloseArr) - 1] := ClientBufInfo.ClientBufID;
          end;
        end;
      finally
        m_ClientBufList.UnLockR;
      end;

      if g_FunctionNPC <> nil then
      begin
        for I := 0 to Length(CloseArr) - 1 do
        begin
          m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Self, '@CloseClientBuff' + IntToStr(CloseArr[I]), False); // Buff倒计时触发
        end;
      end;

      m_ClientBufList.LockW(2);
      try
        for I := m_ClientBufList.Count - 1 downto 0 do
        begin
          ClientBufInfo := m_ClientBufList[I];
          if ((ClientBufInfo.Time > 0) and (Tick_Diff(ClientBufInfo.StartTick, MyGetTickCount) >= ClientBufInfo.Time)) then
          begin
            Dispose(ClientBufInfo);
            m_ClientBufList.Delete(I);
          end;
        end;
      finally
        m_ClientBufList.UnLockW;
      end;

      SetLength(CloseArr, 0);
      m_ArrBufList.LockR(1);
      try
        for I := m_ArrBufList.Count - 1 downto 0 do
        begin
          ArrBufInfo := m_ArrBufList[I];
          if ((ArrBufInfo.Time > 0) and (Tick_Diff(ArrBufInfo.StartTick, MyGetTickCount) >= ArrBufInfo.Time)) then
          begin
            SetLength(CloseArr, Length(CloseArr) + 1);
            CloseArr[Length(CloseArr) - 1] := ArrBufInfo.ClientBufID;
          end;
        end;
      finally
        m_ArrBufList.UnLockR;
      end;

      if g_FunctionNPC <> nil then
      begin
        for I := 0 to Length(CloseArr) - 1 do
        begin
          m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Self, '@CloseArrBuff' + IntToStr(CloseArr[I]), False); // Buff倒计时触发
        end;
      end;

      m_ArrBufList.LockW(2);
      try
        for I := m_ArrBufList.Count - 1 downto 0 do
        begin
          ArrBufInfo := m_ArrBufList[I];
          if ((ArrBufInfo.Time > 0) and (Tick_Diff(ArrBufInfo.StartTick, MyGetTickCount) >= ArrBufInfo.Time)) then
          begin
            Dispose(ArrBufInfo);
            m_ArrBufList.Delete(I);
          end;
        end;
      finally
        m_ArrBufList.UnLockW;
      end;

      // 人物也要自动捡物 2020-03-28 01:34:58
      if (not m_boDeath) and (not m_boGhost) and (not m_boOnHorse) and (not m_boShopStall) and m_boSelfAutoPickItem then
      begin
        if not m_PEnvir.m_boNoAutoRangePickItem then // 禁止范围拾取
        begin
          if m_btSelfAutoPickItemRange > 0 then
            PickRangeItem(m_boSelfAutoPickAll, m_boAutoPickPlayDropItem, m_boAutoPickPlayScatterItem,
              m_dwAutoPickScatterToPickTime)
          else
          begin
            ItemObject := m_PEnvir.GetItem(m_nCurrX, m_nCurrY);
            if (ItemObject <> nil) and (not ItemObject.m_boGhost) and CheckCanPickItem(ItemObject) then
              DoPickUpItem(m_nCurrX, m_nCurrY, ItemObject, False, False, False);
          end;
        end;
      end;
    end;

    nError := 5;
    if m_boExpire then
    begin // 帐户充值时间已到期 中断游戏
      SysMsg(sPayMentExpire, c_Red, t_Hint);
      SysMsg(sDisConnectMsg, c_Red, t_Hint);
      m_boEmergencyClose := True;
      m_boOffLine := False;
      m_boExpire := False;
      m_boPlayOffLine := False; // 关闭下线触发
    end;

    nError := 6;
