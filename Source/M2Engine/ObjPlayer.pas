function TPlayObject.GetFeature_New: TFeature_New;

  function MakeInt64(L, H: Cardinal): Int64;
  var
    LI: Large_Integer;
  begin
    LI.LowPart := L;
    LI.HighPart := H;
    Result := LI.QuadPart;
  end;

  function MakeHumInt64_Value1(Dress, Weapon, DressEff: Word; Shield, Hair: Byte): Int64;
  begin
    Result := MakeInt64(MakeLong(Dress, Weapon), MakeLong(DressEff, MakeWord(Hair, Shield)))
  end;

  function MakeHumInt64_Value2(DressEffectIndex, WeaponEffectIndex: SmallInt; DressEffectOffSet, WeaponEffectOffSet: Word): Int64;
  begin
    Result := MakeInt64(MakeLong(DressEffectIndex, WeaponEffectIndex), MakeLong(DressEffectOffSet, WeaponEffectOffSet))
  end;

var
  btGender, btHair, btShield: Byte;
  ItemIndex: Integer;
  wDress, wWeapon: Word;
  StdItem: pTStdItem;
  ItemEffect: pTItemEffect;
  nDressEffectIndex, nWeaponEffectIndex: SmallInt;
  wDressEffectOffSet, wWeaponEffectOffSet: Word;
  boShowHair: Boolean;
begin
  boShowHair := True;
  btGender := m_btGender;
  btHair := 0;

  wDress := 0;
  wWeapon := 0;
  btShield := 0;
  nDressEffectIndex := -1;
  wDressEffectOffSet := 0;
  nWeaponEffectIndex := -1;
  wWeaponEffectOffSet := 0;

  // 衣服
  if m_boShowFashion and (not g_Config.boHideTabSheet2) and (m_UseItems[U_FASHIONDRESS].wIndex > 0) then
    ItemIndex := U_FASHIONDRESS
  else
    ItemIndex := U_DRESS;

  if m_UseItems[ItemIndex].wIndex > 0 then
  begin
    StdItem := UserEngine.GetStdItem(m_UseItems[ItemIndex].wIndex);
    if StdItem <> nil then
    begin
      // 个位用来表示是否显示发型，Expand5 div 10用来表示使提示框文字使用哪个图片作为背景 2019-12-15 10:05:20
      boShowHair := StdItem.Expand5 mod 10 = 0;

      if m_UseItems[ItemIndex].wNewShape > 0 then
        wDress := m_UseItems[ItemIndex].wNewShape * 2
      else
        wDress := StdItem.Shape * 2;

      ItemEffect := pTItemEffect(StdItem.Effect);
      if ItemEffect <> nil then
      begin
        nDressEffectIndex := ItemEffect.FileIndex2;
        if ItemEffect.NoSex2 then
          wDressEffectOffSet := ItemEffect.StartIndex2
        else
          wDressEffectOffSet := ItemEffect.StartIndex2 + 600 * m_btGender
      end;
      if m_UseItems[ItemIndex].wEffect > 0 then
      begin
        ItemEffect := g_ItemEffects.Get(m_UseItems[ItemIndex].wEffect);
        if ItemEffect <> nil then
        begin
          nDressEffectIndex := ItemEffect.FileIndex2;
          if ItemEffect.NoSex2 then
            wDressEffectOffSet := ItemEffect.StartIndex2
          else
            wDressEffectOffSet := ItemEffect.StartIndex2 + 600 * m_btGender
        end;
      end;
    end;
  end;

  wDress := wDress + m_btGender;

  // 武器
  if m_boShowFashion and (not g_Config.boHideTabSheet2) and (m_UseItems[U_FASHIONWEAPON].wIndex > 0) then
    ItemIndex := U_FASHIONWEAPON
  else
    ItemIndex := U_WEAPON;

  if m_UseItems[ItemIndex].wIndex > 0 then
  begin
    StdItem := UserEngine.GetStdItem(m_UseItems[ItemIndex].wIndex);
    if StdItem <> nil then
    begin
      if m_UseItems[ItemIndex].wNewShape > 0 then
        wWeapon := m_UseItems[ItemIndex].wNewShape * 2
      else
        wWeapon := StdItem.Shape * 2;

      ItemEffect := pTItemEffect(StdItem.Effect);
      if ItemEffect <> nil then
      begin
        nWeaponEffectIndex := ItemEffect.FileIndex2;
        wWeaponEffectOffSet := ItemEffect.StartIndex2;
      end;

      if m_UseItems[ItemIndex].wEffect > 0 then
      begin
        ItemEffect := g_ItemEffects.Get(m_UseItems[ItemIndex].wEffect);
        if ItemEffect <> nil then
        begin
          nWeaponEffectIndex := ItemEffect.FileIndex2;
          if ItemEffect.NoSex2 then
            wWeaponEffectOffSet := ItemEffect.StartIndex2
          else
            wWeaponEffectOffSet := ItemEffect.StartIndex2 + 600 * m_btGender
        end;
      end;
      // 把DB库中武器 AniCount 字段 发送过去 piaoyun 2013-07-28
      if (StdItem.AniCount >= 1000) and (StdItem.AniCount <= { 1015 } 2000) then
      begin
        nWeaponEffectIndex := -1;
        wWeaponEffectOffSet := StdItem.AniCount;
      end;
    end;
  end;

  wWeapon := wWeapon + m_btGender;

  // 盾牌 chongchong 2013-09-16
  if m_UseItems[U_SHIELD].wIndex > 0 then
  begin
    StdItem := UserEngine.GetStdItem(m_UseItems[U_SHIELD].wIndex);
    if StdItem <> nil then
    begin
      if m_UseItems[U_SHIELD].wNewShape > 0 then
        btShield := m_UseItems[U_SHIELD].wNewShape
      else
        btShield := StdItem.Shape;
    end;
  end;

  // 头盔
  if m_UseItems[U_HELMET].wIndex > 0 then
  begin
    StdItem := UserEngine.GetStdItem(m_UseItems[U_HELMET].wIndex);
    if StdItem <> nil then
    begin
      case StdItem.Shape of
        1:
          btHair := 4;
        2:
          btHair := 5;
      end;
    end;
  end;

  // 斗笠
  if m_UseItems[U_HAT].wIndex > 0 then
  begin
    StdItem := UserEngine.GetStdItem(m_UseItems[U_HAT].wIndex);
    if StdItem <> nil then
    begin
      // 修正戴面巾时光头 chongchong 2013-11-09
      if { (StdItem.Shape <> -1) and } (StdItem.Shape <> 1000) then // 等于-1则不显示，按照原始发型发过去 1000为面巾，也发原始发型 2013-07-31
        btHair := 100 + StdItem.Shape;
    end;
  end;

  // 根据注册参数客可知默认 2：男 3：女
  if btHair = 0 then
  begin
    if boShowHair then
      btHair := m_btHair
    else
      btHair := 0;
  end;

  { TODO -opiaoyun -c修正 : 斗笠显示问题【2013-07-31】 }
  if btHair < 6 then
  begin
    if not boShowHair then
    begin
      btHair := 0;
    end
    else
    begin
      case btGender of
        0:
          begin
            case m_btHair of
              1 .. 6:
                btHair := 2;
            end;
          end;
        1:
          begin
            case m_btHair of
              0:
                btHair := 1;
              1 .. 6:
                btHair := 3;
            end;
          end;
      end;
    end;
  end;

  Result.Value1 := MakeHumInt64_Value1(wDress, wWeapon, m_wDressEffType, btShield, btHair);
  Result.Value2 := MakeHumInt64_Value2(nDressEffectIndex, nWeaponEffectIndex, wDressEffectOffSet, wWeaponEffectOffSet);
end;

function TPlayObject.CanUseCallMonMagic(MagicID: Integer): Boolean;
var
  I: Integer;
  nCount: Integer;
  Magic: pTUserMagic;
begin
  Result := False;
  Magic := FindMagic(MagicID);
  if Magic = nil then
    Exit;

  // 召唤骷髅
  if MagicID = SKILL_SKELLETON then
  begin
    nCount := g_Config.nBoneFammCount;
    for I := Low(g_Config.BoneFammArray) to High(g_Config.BoneFammArray) do
    begin
      if g_Config.BoneFammArray[I].nHumLevel = 0 then
        Break;
      if m_Abil.Level >= g_Config.BoneFammArray[I].nHumLevel then
      begin
        nCount := g_Config.BoneFammArray[I].nCount;
      end;
    end;

    Result := PlayerCanMakeSlave(bb_BoneFamm, nCount);
  end

  // 召唤神兽
  else if MagicID = SKILL_SINSU then
  begin
    nCount := g_Config.nDogzCount;

    for I := Low(g_Config.DogzArray) to High(g_Config.DogzArray) do
    begin
      if g_Config.DogzArray[I].nHumLevel = 0 then
        Break;
      if m_Abil.Level >= g_Config.DogzArray[I].nHumLevel then
      begin
        nCount := g_Config.DogzArray[I].nCount;
      end;
    end;

    Result := PlayerCanMakeSlave(bb_Dogz, nCount);
  end

  // 召唤圣兽
  else if MagicID = SKILL_76 then
  begin
    nCount := g_Config.nBigDogzCount;

    for I := Low(g_Config.BigDogzArray) to High(g_Config.BigDogzArray) do
    begin
      if g_Config.BigDogzArray[I].nHumLevel = 0 then
        Break;
      if m_Abil.Level >= g_Config.BigDogzArray[I].nHumLevel then
      begin
        nCount := g_Config.BigDogzArray[I].nCount;
      end;
    end;

    Result := PlayerCanMakeSlave(bb_BigDogz, nCount);
  end

  // 召唤月灵
  else if MagicID = SKILL_55 then
  begin
    nCount := g_Config.nMonthSpiritCount;

    for I := Low(g_Config.MonthSpiritArray) to High(g_Config.MonthSpiritArray) do
    begin
      if g_Config.MonthSpiritArray[I].nHumLevel = 0 then
        Break;
      if m_Abil.Level >= g_Config.MonthSpiritArray[I].nHumLevel then
      begin
        nCount := g_Config.MonthSpiritArray[I].nCount;
      end;
    end;

    Result := PlayerCanMakeSlave(bb_MonthSpirit, nCount);
  end
end;

procedure TPlayObject.SendClientDataFile(sMsg: AnsiString);
var
  DataCRC: TClientDataCRC;
begin
  if m_boDummyObject then
    Exit;
  if m_boOffLine and (MyGetTickCount - m_nOffOnlineTick > 1000 * 30) then
    Exit;

  DecodeString(sMsg, @DataCRC, SizeOf(TClientDataCRC));

  // 一次全丢过来
  if DataCRC.ModulesCRC <> g_ModuleListTextCRC then
    SendClientModules(10);

  if DataCRC.MonstersCRC <> g_CustomMonsterListTextCRC then
    SendCustomMonsterConfig(20);

  if DataCRC.StdItemsCRC <> g_StdItemListTextCRC then
    SendStdItemList(30);

  if DataCRC.ItemDescCRC <> g_ItemDescListTextCRC then
    SendItemDescList(40);

  if DataCRC.ItemDescTopCRC <> g_ItemDescTopListTextCRC then
    SendItemDescTopList(45);

  if DataCRC.TzItemDescCRC <> g_TzItemDescListTextCRC then
    SendTzItemDescList(50);

  if DataCRC.FilterItemsCRC <> g_NameFilterListTextCRC then
    SendFilterItemList(60);

  if DataCRC.EffectImagesCRC <> g_EffectImageListTextCRC then
    SendEffectImageList(70);

  if DataCRC.SpecialCmdsCRC <> g_SpecialCmdListTextCRC then
    SendSpecialCmdList(75);

  if DataCRC.MagicsCRC <> g_CustomMagicListTextCRC then
    SendCustomMagicConfig(80);

  if DataCRC.NpcsCRC <> g_CustomNpcListTextCRC then
    SendCustomNpcConfig(85);

  if DataCRC.PlugClientsCRC <> g_PlugFileMD5ListTextCRC then
    SendPlugClientList(90);

  if DataCRC.DropItemEffectListCRC <> g_DropItemEffectListTextCRC then
    SendDropItemEffectList(92);

  if DataCRC.EnabledAuctionItemListCRC <> g_EnabledAuctionItemListTextCRC then
    SendEnabledAuctionItemList(93);

  if DataCRC.CustomItemPropertyCRC <> g_CustomItemPropertyCRC then
    SendCustomItemPropertyConfig(94);

  if DataCRC.CustomItemPropertyTextVarListCRC <> g_CustomItemPropertyTextVarListTextCRC then
    SendCustomItemPropertyTextVarList(95);

  if DataCRC.ArrButtonConfigCRC <> g_ArrButtonConfigCRC then
    SendArrButtonConfig(98);

  SendCustomMoney(99);

  SendClientBlackModules(100);

  SendUnbindList();

  SendInputBoxFilterList();

  SendDefMessage(SM_SENDUSERMOVECMD, 0, 0, 0, 0, g_GameCommand.USERMOVE.sCmd); // 发送用户传送命令到客户端

  FSendClientDataFileTick := MyGetTickCount;
  // SendNotice(True);
end;

function TPlayObject.GetItemInfo(S: string): string;
var
  nC: Integer;
  s10: string;
  TempStr: WideString;
  I: Integer;
  UserItem: pTUserItem;
  Index, ItemIndex: Integer;

  RunCount: Integer;
begin
  nC := 0;
  RunCount := 0;
  TempStr := S;
  while (True) do
  begin
    if TagCount(TempStr, '}') < 1 then
      Break;

    TempStr := ArrestStringEx(TempStr, '{', '}', s10);
    Index := Pos('/', s10);
    if Index > 0 then
    begin
      s10 := Copy(s10, Index + 1, MaxInt);
      ItemIndex := StrToIntDef(s10, -1);
      if ItemIndex > 0 then
      begin
        if m_PickUpOrDropItem.MakeIndex = ItemIndex then
        begin
          SetSayItem(@m_PickUpOrDropItem);
        end
        else
        begin
          for I := 0 to m_ItemList.Count - 1 do
          begin
            UserItem := m_ItemList.Items[I];
            if (UserItem <> nil) and (UserItem.MakeIndex = ItemIndex) then
            begin
              SetSayItem(UserItem);
              Break;
            end;
          end;
        end;
      end;
      Inc(nC);
    end
    else
    begin
      // 防卡死 chongchong 2015-03-06
      Inc(RunCount);
      if RunCount > 20 then
        Break;
    end;

    if nC >= 5 then
      Break;
  end;
  Result := S;
end;

