procedure TPlayObject.ClientRequestAuctionItemsByIndex(ProcessMsg: pTProcessMessage; var boResult: Boolean);
const
  MAG_COUNT = 10;
var
  I, ID, nCount, nPageIndex: Integer;
  SL: TStringList;
  AuctionInfo: TAuctionInfo;
  InBuf: array [0 .. SizeOf(TRefreshAuctionItem) * MAG_COUNT] of AnsiChar;
  Item: pTRefreshAuctionItem;
begin
  nPageIndex := ProcessMsg.nParam2;
  if (ProcessMsg.nParam1 >= 0) and (ProcessMsg.nParam1 <= 2) then
  begin
    if MyGetTickCount - FRequestAuctionItemsByIndexTicks[ProcessMsg.nParam1] <= 1000 then
    begin
      m_DefMsg := MakeDefaultMsg(SM_RequestAuctionItems_ByIndex_RET, ProcessMsg.nParam1, 0, 1, nPageIndex);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;
  end
  else
  begin
    m_DefMsg := MakeDefaultMsg(SM_RequestAuctionItems_ByIndex_RET, ProcessMsg.nParam1, 0, 1, nPageIndex);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  FRequestAuctionItemsByIndexTicks[ProcessMsg.nParam1] := MyGetTickCount;
  SL := TStringList.Create;
  try
    SL.Delimiter := ',';
    SL.DelimitedText := DecodeString(ProcessMsg.sMsg);
    nCount := 0;
    Item := @InBuf;

    for I := 0 to SL.Count - 1 do
    begin
      ID := StrToIntDef(SL.Strings[I], 0);
      if ID > 0 then
      begin
        if g_M2DataDB.AuctionDB.GetAuctionInfo(ID, AuctionInfo) then
        begin
          Item.AuctionID := ID;
          Item.LastBidPrice := AuctionInfo.LastBidPrice;
          Item.TradingStatus := AuctionInfo.TradingStatus;
          Item.IsItemGive := AuctionInfo.IsItemGive;
          Item.IsItemCanRetrieve := (not AuctionInfo.IsItemGive) and SameText(AuctionInfo.LastBidder, m_sCharName) and
            (Item.TradingStatus <> 0);
          Item.IsCancelAttention := AuctionInfo.IsItemGive or (not SameText(AuctionInfo.LastBidder, m_sCharName));
          Inc(Item);
          Inc(nCount);
          if nCount >= MAG_COUNT then
            Break;
        end;
      end;
    end;
    m_DefMsg := MakeDefaultMsg(SM_RequestAuctionItems_ByIndex_RET, ProcessMsg.nParam1, nCount, 0, nPageIndex);
    SendSocketEx(@m_DefMsg, @InBuf, nCount * SizeOf(TRefreshAuctionItem));
  finally
    SL.Free;
  end;
end;

procedure TPlayObject.ClientAddItemToJar(ProcessMsg: pTProcessMessage; var boResult: Boolean);
// 解包物品扩展 chongchong 2014-05-15
  function GetUnbindItemInfo(nShape: Integer): PTUnbindItemInfo;
  var
    I: Integer;
    UnbindItemInfo: PTUnbindItemInfo;
  begin
    Result := nil;
    for I := 0 to g_UnbindList.Count - 1 do
    begin
      UnbindItemInfo := g_UnbindList.Items[I];
      if UnbindItemInfo.nShape = nShape then
      begin
        Result := g_UnbindList[I];
        Break;
      end;
    end;
  end;

var
  I: Integer;
  UserItem: pTUserItem;
  sUserItemName, sItemName: string;
  StdItem, StdItem1: pTStdItem;
  ItemIndex: Integer;
  UnbindItemInfo: PTUnbindItemInfo;
  IsHero: Boolean;
  SmartObject: TSmartObject;
begin
  UserItem := nil;
  StdItem := nil;
  StdItem1 := nil;
  sItemName := DecodeString(ProcessMsg.sMsg);
  IsHero := ProcessMsg.nParam2 = 1;
  if IsHero and (m_MyHero = nil) then
  begin
    SendDefMessage(SM_AddItemToJar_RET, 0, Integer(IsHero), 0, 0, '');
    Exit;
  end;
  if IsHero then
    SmartObject := TSmartObject(m_MyHero)
  else
    SmartObject := Self;
  ItemIndex := 0;
  if SmartObject.CanAddItemToJar then
  begin
    for I := 0 to SmartObject.m_ItemList.Count - 1 do
    begin
      UserItem := SmartObject.m_ItemList.Items[I];
      if (UserItem <> nil) and (UserItem.MakeIndex = ProcessMsg.nParam1) then
      begin
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          // 取自定义物品名称
          sUserItemName := '';
          if UserItem.btValue[13] = 1 then
            sUserItemName := UserItem.Name
          else
            sUserItemName := StdItem.Name;
          if SameText(sUserItemName, sItemName) then
          begin
            StdItem1 := UserEngine.GetStdItem(SmartObject.m_UseItems[U_BUJUK].wIndex);
            ItemIndex := I;
            Break;
          end;
        end;
      end;
      UserItem := nil;
    end;
    if (StdItem <> nil) and (StdItem1 <> nil) and (UserItem <> nil) and (not UserItem.boIsBind) and
      (StdItem.AniCount = StdItem1.Shape) and (not(StdItem.StdMode in [5, 6, 10, 11, 66, 67 { 时装衣服 } , 68, 69 { 时装武器 } ])) then
    begin
      UnbindItemInfo := GetUnbindItemInfo(StdItem1.Shape);
      if UnbindItemInfo <> nil then
      begin
        if SameText(StdItem.DBName, UnbindItemInfo.sItemName) then
        begin
          SmartObject.DelBagItem(ItemIndex);
          Inc(SmartObject.m_UseItems[U_BUJUK].Dura, 1000);
          if SmartObject.m_UseItems[U_BUJUK].Dura > SmartObject.m_UseItems[U_BUJUK].DuraMax then
            SmartObject.m_UseItems[U_BUJUK].Dura := SmartObject.m_UseItems[U_BUJUK].DuraMax;
          SmartObject.SendMsg(SmartObject, RM_DURACHANGE, U_BUJUK, SmartObject.m_UseItems[U_BUJUK].Dura,
            SmartObject.m_UseItems[U_BUJUK].DuraMax, 0, '');
          SendDefMessage(SM_AddItemToJar_RET, 1, Integer(IsHero), 0, 0, '');
          Exit;
        end;
      end;
    end;
  end;
  SendDefMessage(SM_AddItemToJar_RET, 0, Integer(IsHero), 0, 0, '');
end;

procedure TPlayObject.ClientGameLevelItemGet(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  StdItem: pTStdItem;
  I, II: Integer;
  nItemCount, OverLapItemsCount: Integer;
  UserItem, OverLapItem: pTUserItem;
  IsTakeAllItem: Boolean;
  ItemCounts: TRefreshGuardianLevelItemCounts;
begin
  if not m_boGuardinaLevelCanGetItem then
  begin
    Exit;
  end;
  IsTakeAllItem := True;
  for I := 0 to 3 do
  begin
    nItemCount := m_nGuardinaLevelHasItems[I];
    if nItemCount <= 0 then
      Continue;
    StdItem := UserEngine.GetStdItem(m_sGuardinaLevelGetItem[I]);
    if StdItem = nil then
      Continue;
    if CheckOverLapItem(StdItem) then
    begin
      while True do
      begin
        if nItemCount <= 0 then
          Break;
        // GIVE 叠加物品 不自动重叠到已有的物品上面 chongchong 2014-04-09
        OverLapItemsCount := OverLapBagItemCount(Self, StdItem, OverLapItem);
        if OverLapItemsCount > 0 then
        begin
          if OverLapItemsCount > nItemCount then
          begin
            OverLapItem.Dura := OverLapItem.Dura + nItemCount;
            nItemCount := 0;
            m_nGuardinaLevelHasItems[I] := 0;
          end
          else
          begin
            OverLapItem.Dura := OverLapItem.Dura + OverLapItemsCount;
            nItemCount := nItemCount - OverLapItemsCount;
            m_nGuardinaLevelHasItems[I] := m_nGuardinaLevelHasItems[I] - OverLapItemsCount;
          end;
          SendUpdateItemDura(-1, OverLapItem.MakeIndex, False, OverLapItem.Dura);
          m_nLastGiveItemMakeIndex := OverLapItem.MakeIndex;
        end
        // GIVE 叠加物品 不自动重叠到已有的物品上面 ----------------------------
        else if IsEnoughBag then
        begin
          New(UserItem);
          if UserEngine.CopyToUserItemFromName(StdItem.Name, UserItem) then
          begin
            if UserItem.DuraMax > nItemCount then
            begin
              UserItem.Dura := nItemCount - 1;
              nItemCount := 0;
              m_nGuardinaLevelHasItems[I] := 0;
            end
            else
            begin
              UserItem.Dura := UserItem.DuraMax - 1;
              nItemCount := nItemCount - UserItem.DuraMax;
              m_nGuardinaLevelHasItems[I] := m_nGuardinaLevelHasItems[I] - UserItem.DuraMax;
            end;
            { TODO -ochongchong -c修改 : 脚本制造的装备不给特殊属性 【2013-08-01】 }
            UserEngine.RandomItemNewAbil(u_Script, UserItem);
            UserItem.ItemFrom.ItemForm := ifScript;
            UserItem.ItemFrom.sMakerName := m_sCharName;
            UserItem.ItemFrom.DateTime := Now();
            m_ItemList.Add(UserItem);
            SendAddItem(UserItem);
            if (UserItem.boStartTime) then
            begin
              if StdItem.Need = 103 then
                SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System)
              else
                SysMsg(Format('您的限时物品[%s]开始计时，到期时间%s', [StdItem.Name, GetIncMinuteTime(UserItem.ItemFrom.DateTime,
                  StdItem.NeedLevel)]), c_Red, t_System)
            end;
            m_nLastGiveItemMakeIndex := UserItem.MakeIndex;
          end
          else
          begin
            Dispose(UserItem);
            m_nGuardinaLevelHasItems[I] := 0;
          end;
        end
        else
        begin
          IsTakeAllItem := False;
          Break;
        end;
      end;
    end
    else
    begin
      for II := 0 to nItemCount - 1 do
      begin // nItemCount 为0时出死循环
        if IsEnoughBag then
        begin
          New(UserItem);
          if UserEngine.CopyToUserItemFromName(StdItem.Name, UserItem) then
          begin
            { TODO -ochongchong -c修改 : 脚本制造的装备不给特殊属性 【2013-08-01】 }
            UserEngine.RandomItemNewAbil(u_Script, UserItem);
            UserItem.ItemFrom.ItemForm := ifScript;
            UserItem.ItemFrom.sMakerName := m_sCharName;
            UserItem.ItemFrom.DateTime := Now();
            m_ItemList.Add(UserItem);
            SendAddItem(UserItem);
            m_nGuardinaLevelHasItems[I] := m_nGuardinaLevelHasItems[I] - 1;
            if (UserItem.boStartTime) then
            begin
              if StdItem.Need = 103 then
                SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System)
              else
                SysMsg(Format('您的限时物品[%s]开始计时，到期时间%s', [StdItem.Name, GetIncMinuteTime(UserItem.ItemFrom.DateTime,
                  StdItem.NeedLevel)]), c_Red, t_System)
            end;
            m_nLastGiveItemMakeIndex := UserItem.MakeIndex;
          end
          else
          begin
            Dispose(UserItem);
            m_nGuardinaLevelHasItems[I] := 0;
          end;
        end
        else
        begin
          IsTakeAllItem := False;
          Break;
        end;
      end;
    end
  end;
  if IsTakeAllItem then
  begin
    m_boGuardinaLevelCanGetItem := False;
  end;
  if not m_boGuardinaLevelCanGetItem then
  begin
    m_DefMsg := MakeDefaultMsg(SM_GameLevelItemGetRet, 0, 1, 0, 0); // 10126
    SendSocket(@m_DefMsg, '');
    if g_FunctionNPC <> nil then
    begin
      g_FunctionNPC.GotoLable(Self, '@GuardinaLevelCanGetItemOK', False)
    end;
  end
  else
  begin
    ItemCounts.GetItemCounts0 := m_nGuardinaLevelHasItems[0];
    ItemCounts.GetItemCounts1 := m_nGuardinaLevelHasItems[1];
    ItemCounts.GetItemCounts2 := m_nGuardinaLevelHasItems[2];
    ItemCounts.GetItemCounts3 := m_nGuardinaLevelHasItems[3];
    m_DefMsg := MakeDefaultMsg(SM_GameLevelItemGetRet, SizeOf(ItemCounts), 0, 0, 0); // 10126
    SendSocketEx(@m_DefMsg, @ItemCounts, SizeOf(ItemCounts));
  end;
end;

