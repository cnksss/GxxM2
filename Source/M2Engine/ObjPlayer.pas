procedure TPlayObject.SendDelFengHaoItem(Index: Integer; IsHero: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  SmartObject: TSmartObject;
  StdItem: pTStdItem;
begin
  if IsHero then
    SmartObject := TSmartObject(m_MyHero)
  else
    SmartObject := Self;
  if SmartObject = nil then
    Exit;
  if Index < 0 then
  begin
    if (SmartObject.m_ActiveFengHao >= 0) and (SmartObject.m_ActiveFengHao < SmartObject.m_FengHaoItems.Count) and
      (g_FunctionNPC <> nil) then
    begin
      UserItem := SmartObject.m_FengHaoItems.Items[SmartObject.m_ActiveFengHao];
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem <> nil then
      begin
        m_nScriptGotoCount := 0;
        if not IsHero then
          g_FunctionNPC.GotoLable(Self, '@UnactiveTitle_' + IntToStr(StdItem.Shape), False)
        else
          g_FunctionNPC.GotoLable(Self, '@HeroUnactiveTitle_' + IntToStr(StdItem.Shape), False)
      end;
    end;
    SmartObject.m_ActiveFengHao := -1;
    for I := 0 to SmartObject.m_FengHaoItems.Count - 1 do
      Dispose(pTUserItem(SmartObject.m_FengHaoItems.Items[I]));
    SmartObject.m_FengHaoItems.Clear;
    m_DefMsg := MakeDefaultMsg(SM_CLEARFENGHAOITEM, 0, 0, Word(IsHero), 0);
    SendSocket(@m_DefMsg, '');
  end
  else if Index < SmartObject.m_FengHaoItems.Count then
  begin
    if SmartObject.m_ActiveFengHao = Index then
    begin
      if (SmartObject.m_ActiveFengHao >= 0) and (SmartObject.m_ActiveFengHao < SmartObject.m_FengHaoItems.Count) and
        (g_FunctionNPC <> nil) then
      begin
        UserItem := SmartObject.m_FengHaoItems.Items[SmartObject.m_ActiveFengHao];
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          m_nScriptGotoCount := 0;
          if not IsHero then
            g_FunctionNPC.GotoLable(Self, '@UnactiveTitle_' + IntToStr(StdItem.Shape), False)
          else
            g_FunctionNPC.GotoLable(Self, '@HeroUnactiveTitle_' + IntToStr(StdItem.Shape), False)
        end;
      end;
      SmartObject.m_ActiveFengHao := -1;
    end;
    Dispose(SmartObject.m_FengHaoItems.Items[Index]);
    SmartObject.m_FengHaoItems.Delete(Index);
    m_DefMsg := MakeDefaultMsg(SM_DELFENGHAOITEM, SmartObject.m_ActiveFengHao, Index, Word(IsHero), 0);
    SendSocket(@m_DefMsg, '');
  end;
  SmartObject.RecalcAbilitys;
  SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
  SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
  SmartObject.FeatureChanged;
end;

