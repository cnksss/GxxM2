// 挑战成功触发 piaoyun 2013-07-22
procedure TPlayObject.ChallengeVictory();
var
  I: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  PlayObject: TPlayObject;
  OldGameDiamond: LongWord;
begin
  if (not m_boChallengeStart) or (m_ChallengeCreat = nil) then
  begin
    m_boChallengeStart := False;
    m_ChallengeCreat := nil;
    Exit;
  end;

  for I := 0 to m_ChallengeItemList.Count - 1 do
  begin
    UserItem := m_ChallengeItemList.Items[I];
    AddItemToBag(UserItem);
    SendAddItem(UserItem);
  end;

  for I := 0 to m_ChallengeCreat.m_ChallengeItemList.Count - 1 do
  begin
    UserItem := m_ChallengeCreat.m_ChallengeItemList.Items[I];
    AddItemToBag(UserItem);
    SendAddItem(UserItem);
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem <> nil then
    begin
      if not IsCheapStuff(StdItem.StdMode) then
      begin
        // 004DDF49
        if StdItem.NeedIdentify = 1 then
        begin
          AddGameDataLog(LOG_ItemChallenge, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, m_ChallengeCreat.m_sCharName,
            0, 0, Format('%s->%s', [m_ChallengeCreat.m_sCharName, m_sCharName]));
        end;
      end;
    end;
  end;

  if (m_nChallengeGolds > 0) or (m_ChallengeCreat.m_nChallengeGolds > 0) then
  begin
    Inc(m_nGold, m_nChallengeGolds);
    OldGameDiamond := m_nGold;
    Inc(m_nGold, m_ChallengeCreat.m_nChallengeGolds);
    if g_boGameLogGold and (m_ChallengeCreat.m_nChallengeGolds > 0) then
    begin
      AddGameDataLog(LOG_ItemChallenge, LOG_GoldChange, m_ChallengeCreat, sSTRING_GOLDNAME, 0, m_sCharName,
        m_ChallengeCreat.m_nGold, m_ChallengeCreat.m_nGold + m_ChallengeCreat.m_nChallengeGolds,
        Format('%s输: %d', [m_ChallengeCreat.m_sCharName, m_ChallengeCreat.m_nChallengeGolds]));
      AddGameDataLog(LOG_ItemChallenge, LOG_GoldChange, Self, sSTRING_GOLDNAME, 0, m_ChallengeCreat.m_sCharName, m_nGold,
        OldGameDiamond, Format('%s赢: %d', [m_sCharName, m_ChallengeCreat.m_nChallengeGolds]));
    end;
  end;

  if (m_nChallengeGameDiamonds > 0) or (m_ChallengeCreat.m_nChallengeGameDiamonds > 0) then
  begin
    // 挑战附加币控制 piaoyun 2013-07-22
    case g_Config.btChallengeGoldIndex of
      0: // 金刚石
        begin
          Inc(m_nGameDiamond, m_nChallengeGameDiamonds);
          OldGameDiamond := m_nGameDiamond;
          Inc(m_nGameDiamond, m_ChallengeCreat.m_nChallengeGameDiamonds);
          if m_ChallengeCreat.m_nChallengeGameDiamonds > 0 then
          begin
            AddGameDataLog(LOG_ItemChallenge, LOG_GameDiamondChange, m_ChallengeCreat, g_Config.sGameDiamondName, 0, m_sCharName,
              m_ChallengeCreat.m_nGameDiamond, m_ChallengeCreat.m_nGameDiamond + m_ChallengeCreat.m_nChallengeGameDiamonds,
              Format('%s输: %d', [m_ChallengeCreat.m_sCharName, m_ChallengeCreat.m_nChallengeGameDiamonds]));
            AddGameDataLog(LOG_ItemChallenge, LOG_GameDiamondChange, Self, g_Config.sGameDiamondName, 0,
              m_ChallengeCreat.m_sCharName, m_nGameDiamond, OldGameDiamond,
              Format('%s赢: %d', [m_sCharName, m_ChallengeCreat.m_nChallengeGameDiamonds]));
          end;
        end;
      1: // 元宝
        begin
          Inc(m_nGameGold, m_nChallengeGameDiamonds);
          OldGameDiamond := m_nGameGold;
          Inc(m_nGameGold, m_ChallengeCreat.m_nChallengeGameDiamonds);
          if g_boGameLogGameGold and (m_ChallengeCreat.m_nChallengeGameDiamonds > 0) then
          begin
            AddGameDataLog(LOG_ItemChallenge, LOG_GameDiamondChange, m_ChallengeCreat, g_Config.sGameGoldName, 0, m_sCharName,
              m_ChallengeCreat.m_nGameGold, m_ChallengeCreat.m_nGameGold + m_ChallengeCreat.m_nChallengeGameDiamonds,
              Format('%s输: %d', [m_ChallengeCreat.m_sCharName, m_ChallengeCreat.m_nChallengeGameDiamonds]));
            AddGameDataLog(LOG_ItemChallenge, LOG_GameGoldChange, Self, g_Config.sGameGoldName, 0, m_ChallengeCreat.m_sCharName,
              m_nGameGold, OldGameDiamond, Format('%s赢: %d', [m_sCharName, m_ChallengeCreat.m_nChallengeGameDiamonds]));
          end;
        end;
      2: // 灵符
        begin
          Inc(m_nGameGird, m_nChallengeGameDiamonds);
          OldGameDiamond := m_nGameGird;
          Inc(m_nGameGird, m_ChallengeCreat.m_nChallengeGameDiamonds);
          if m_ChallengeCreat.m_nChallengeGameDiamonds > 0 then
          begin
            AddGameDataLog(LOG_ItemChallenge, LOG_GameDiamondChange, m_ChallengeCreat, g_Config.sGameGirdName, 0, m_sCharName,
              m_ChallengeCreat.m_nGameGird, m_ChallengeCreat.m_nGameGird + m_ChallengeCreat.m_nChallengeGameDiamonds,
              Format('%s输: %d', [m_ChallengeCreat.m_sCharName, m_ChallengeCreat.m_nChallengeGameDiamonds]));
            AddGameDataLog(LOG_ItemChallenge, LOG_GameGirdChange, Self, g_Config.sGameGirdName, 0, m_ChallengeCreat.m_sCharName,
              m_nGameGird, OldGameDiamond, Format('%s赢: %d', [m_sCharName, m_ChallengeCreat.m_nChallengeGameDiamonds]));
          end;
        end;
    end;
    // 发送金币、元宝信息到客户端
    GoldChanged();
    // 发送灵符、金刚石信息到客户端
    NewGamePointChanged;
  end;

  PlayObject := TPlayObject(m_ChallengeCreat);
  PlayObject.m_ChallengeCreat := nil;
  PlayObject.m_ChallengeItemList.Clear;
  PlayObject.m_nChallengeGolds := 0;
  PlayObject.m_nChallengeGameDiamonds := 0;
  m_ChallengeCreat := nil;
  m_ChallengeItemList.Clear;
  m_nChallengeGolds := 0;
  m_nChallengeGameDiamonds := 0;
  // 挑战功能修复2：挑战成功后变量初始化 -- piaoyun 2013-07-22
  PlayObject.m_boChallengeStart := False;
  PlayObject.m_boChallengeing := False;
  PlayObject.m_boChallengeOK := False;
  m_boChallengeStart := False;
  m_boChallengeing := False;
  m_boChallengeOK := False;
  // MoveToHome; // 胜利者回城
  MoveRandomToHome;
  // 挑战胜利，血蓝加满
  m_WAbil.HP := m_WAbil.MaxHP;
  m_WAbil.MP := m_WAbil.MaxMP;
  HealthSpellChanged();
  SysMsg(g_sChallengeWinMsg, c_Red, t_Hint);
  if g_FunctionNPC <> nil then
  begin
    m_nScriptGotoCount := 0;
    g_FunctionNPC.GotoLable(Self, '@Challenge_Win', False);
  end;
end;

procedure TPlayObject.ClientGuildAlly;
var
  n8: Integer;
  BaseObjectC: TBaseObject;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.ClientGuildAlly';
begin
  try
    n8 := -1;
    BaseObjectC := GetPoseCreate();

    if (BaseObjectC <> nil) //
      and (BaseObjectC.m_MyGuild <> nil) //
      and (BaseObjectC.m_btRaceServer = RC_PLAYOBJECT) //
      and (BaseObjectC.GetPoseCreate = Self) then
    begin
      if (TGUild(BaseObjectC.m_MyGuild) <> nil) and (TGUild(BaseObjectC.m_MyGuild).m_boEnableAuthAlly) then
      begin
        if BaseObjectC.IsGuildMaster and IsGuildMaster then
        begin
          if (TGUild(m_MyGuild) <> nil) //
            and not TGUild(m_MyGuild).IsWarGuild(TGUild(BaseObjectC.m_MyGuild)) //
            and not TGUild(BaseObjectC.m_MyGuild).IsWarGuild(TGUild(m_MyGuild)) then
          begin
            TGUild(m_MyGuild).AllyGuild(TGUild(BaseObjectC.m_MyGuild));
            TGUild(BaseObjectC.m_MyGuild).AllyGuild(TGUild(m_MyGuild));

            TGUild(m_MyGuild).RefMemberName;
            TGUild(BaseObjectC.m_MyGuild).RefMemberName;

            TGUild(m_MyGuild).SendGuildMsg(TGUild(BaseObjectC.m_MyGuild).sGuildName + '行会已经和您的行会联盟成功。');
            TGUild(BaseObjectC.m_MyGuild).SendGuildMsg(TGUild(m_MyGuild).sGuildName + '行会已经和您的行会联盟成功。');
            n8 := 0;
          end
          else
            n8 := -2;
        end
        else
          n8 := -3;
      end
      else
        n8 := -4;
    end;

    if n8 = 0 then
      SendDefMessage(SM_GUILDMAKEALLY_OK, 0, 0, 0, 0, '')
    else
      SendDefMessage(SM_GUILDMAKEALLY_FAIL, n8, 0, 0, 0, '');
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg);
      MainOutMessage(E.Message);
    end;
  end;
end;

procedure TPlayObject.ClientGuildBreakAlly(sGuildName: string); // 004DF604
var
  n10: Integer;
  Guild: TGUild;
begin
  if not IsGuildMaster() then
    Exit;

  Guild := g_GuildManager.FindGuild(sGuildName);
  if (Guild <> nil) and (m_MyGuild <> nil) then
  begin
    if TGUild(m_MyGuild).IsAllyGuild(Guild) then
    begin
      TGUild(m_MyGuild).DelAllyGuild(Guild);
      Guild.DelAllyGuild(TGUild(m_MyGuild));
      TGUild(m_MyGuild).SendGuildMsg(Guild.sGuildName + ' 行会与您的行会解除联盟成功！');
      Guild.SendGuildMsg(TGUild(m_MyGuild).sGuildName + ' 行会解除了与您行会的联盟！');
      TGUild(m_MyGuild).RefMemberName();
      Guild.RefMemberName();
      n10 := 0;
    end
    else
      n10 := -2;
  end
  else
    n10 := -3;

  if n10 = 0 then
    SendDefMessage(SM_GUILDBREAKALLY_OK, 0, 0, 0, 0, '')
  else
    SendDefMessage(SM_GUILDMAKEALLY_FAIL, 0, 0, 0, 0, '');
end;

procedure TPlayObject.RecalcAdjusBonus();
{ 修改：piaoyun 兼容老客户端修正属性点计算错误 2013-5-11 }
  procedure AdjustAb(Abil: { WORD } Byte; Val: Word; var lov, hiv: Word);
  var
    Lo, Hi: Byte;
    I: Integer;
  begin
    Lo := LoByte(Abil);
    Hi := HiByte(Abil);
    lov := 0;
    hiv := 0;

    for I := 1 to Val do
    begin
      if Lo + 1 < Hi then
      begin
        Inc(Lo);
        Inc(lov);
      end
      else
      begin
        Inc(Hi);
        Inc(hiv);
      end;
    end;
  end;

  procedure AdjustAb2(Abil: Integer; Val: Word; var lov, hiv: Word);
  var
    Lo, Hi: Byte;
    I: Integer;
  begin
    Lo := LoWord(Abil);
    Hi := HiWord(Abil);
    lov := 0;
    hiv := 0;

    for I := 1 to Val do
    begin
      if Lo + 1 < Hi then
      begin
        Inc(Lo);
        Inc(lov);
      end
      else
      begin
        Inc(Hi);
        Inc(hiv);
      end;
    end;
  end;

var
  BonusTick: pTNakedAbility;
  NakedAbil: pTNakedAbility;
  adc, amc, asc, aac, amac: Integer;
  ldc, lmc, lsc, lac, lmac, hdc, hmc, hsc, hac, hmac: Word;
  nMaxAC: Integer;
  Int64Value: Int64;
begin
  BonusTick := nil;
  NakedAbil := nil;
  case m_btJob of
    0:
      begin
        BonusTick := @g_Config.BonusAbilofWarr;
        NakedAbil := @g_Config.NakedAbilofWarr;
      end;
    1:
      begin
        BonusTick := @g_Config.BonusAbilofWizard;
        NakedAbil := @g_Config.NakedAbilofWizard;
      end;
    2:
      begin
        BonusTick := @g_Config.BonusAbilofTaos;
        NakedAbil := @g_Config.NakedAbilofTaos;
      end;
  end;
  adc := m_BonusAbil.DC div BonusTick.DC;
  amc := m_BonusAbil.MC div BonusTick.MC;
  asc := m_BonusAbil.SC div BonusTick.SC;
  aac := m_BonusAbil.AC div BonusTick.AC;
  amac := m_BonusAbil.MAC div BonusTick.MAC;

  // 服务器最终计算和客户端增加属性点时实时计算结果没法完全一致 chongchong 2014-10-12
  // 修正附加属性点面板中增加的数值下限与上限显示反了
  // 如开始值为 魔法防御 10 - 10，加了属性点后变成了 12-10
  AdjustAb2(NakedAbil.DC, adc, ldc, hdc);
  AdjustAb2(NakedAbil.MC, amc, lmc, hmc);
  AdjustAb2(NakedAbil.SC, asc, lsc, hsc);
  AdjustAb2(NakedAbil.AC, aac, lac, hac);
  AdjustAb2(NakedAbil.MAC, amac, lmac, hmac);
  // lac  := 0;  hac := aac;
  // lmac := 0;  hmac := amac;
  if g_Config.btMaxAC = 0 then
    nMaxAC := High(Word)
  else
    nMaxAC := High(Integer);

  Int64Value := Int64(m_WAbil.DC1) + ldc;
  m_WAbil.DC1 := Min(nMaxAC, Int64Value);
  Int64Value := Int64(m_WAbil.DC2) + hdc;
  m_WAbil.DC2 := Min(nMaxAC, Int64Value);
  Int64Value := Int64(m_WAbil.MC1) + lmc;
  m_WAbil.MC1 := Min(nMaxAC, Int64Value);
  Int64Value := Int64(m_WAbil.MC2) + hmc;
  m_WAbil.MC2 := Min(nMaxAC, Int64Value);
  Int64Value := Int64(m_WAbil.SC1) + lsc;
  m_WAbil.SC1 := Min(nMaxAC, Int64Value);
  Int64Value := Int64(m_WAbil.SC2) + hsc;
  m_WAbil.SC2 := Min(nMaxAC, Int64Value);
  Int64Value := Int64(m_WAbil.AC1) + lac;
  m_WAbil.AC1 := Min(nMaxAC, Int64Value);
  Int64Value := Int64(m_WAbil.AC2) + hac;
  m_WAbil.AC2 := Min(nMaxAC, Int64Value);
  Int64Value := Int64(m_WAbil.MAC1) + lmac;
  m_WAbil.MAC1 := Min(nMaxAC, Int64Value);
  Int64Value := Int64(m_WAbil.MAC2) + hmac;
  m_WAbil.MAC2 := Min(nMaxAC, Int64Value);

  if g_Config.btMaxLevel = 0 then
  begin
    Int64Value := Int64(m_WAbil.MaxHP) + m_BonusAbil.HP div BonusTick.HP;
    m_WAbil.MaxHP := Min(High(Word), Int64Value);
    Int64Value := Int64(m_WAbil.MaxMP) + m_BonusAbil.MP div BonusTick.MP;
    m_WAbil.MaxMP := Min(High(Word), Int64Value);
  end
  else if g_Config.btMaxLevel = 1 then
  begin
    Int64Value := Int64(m_WAbil.MaxHP) + m_BonusAbil.HP div BonusTick.HP;
    m_WAbil.MaxHP := Min(High(Integer), Int64Value);
    Int64Value := Int64(m_WAbil.MaxMP) + m_BonusAbil.MP div BonusTick.MP;
    m_WAbil.MaxMP := Min(High(Integer), Int64Value);
  end
  else
  begin
    Int64Value := Int64(m_WAbil.MaxHP) + m_BonusAbil.HP div BonusTick.HP;
    m_WAbil.MaxHP := Min(High(LongWord), Int64Value);
    Int64Value := Int64(m_WAbil.MaxMP) + m_BonusAbil.MP div BonusTick.MP;
    m_WAbil.MaxMP := Min(High(LongWord), Int64Value);
  end;
end;

