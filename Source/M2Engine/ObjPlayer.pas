procedure TPlayObject.SendViewSellPlayerInfo(Player: TPlayObject);
var
  I: Integer;
  SellPlayerInfo: TSellPlayerUserInfo;
  StdItem: pTStdItem;
  ClientItem: TClientItem;
  UserItem: pTUserItem;
  sTempMsg: string;
  sSendMsg: AnsiString;
  s10, s14: string;
  IsBreakParseVar: Boolean;
  nC, nPos: Integer;
  nStartPos: Integer;
  HumFeature: THumFeature;
begin
  FillChar(SellPlayerInfo, SizeOf(TSellPlayerUserInfo), #0);
  Player.GetFeature(Player, @HumFeature);
{$IF NEED_KEY = 1}
  if g_nKey_SellPlayer = 0 then
    Exit;
{$IFEND}
  // -------------------------------------------------------------------------------------------
  SellPlayerInfo.NAMECOLOR := GetCharColor(Player);
  SellPlayerInfo.Gender := HumFeature.btGender;
  SellPlayerInfo.Job := HumFeature.btJob;
  SellPlayerInfo.Hair := HumFeature.btHair;
  SellPlayerInfo.OldHair := HumFeature.btOldHair;
  SellPlayerInfo.UserName := Player.m_sCharName;
  if Player.m_MyGuild <> nil then
    SellPlayerInfo.GuildName := TGUild(Player.m_MyGuild).sGuildName;
  SellPlayerInfo.GuildRankName := Player.m_sGuildRankName;
  for I := Low(THumanUseItems) to High(THumanUseItems) do
  begin
    UserItem := @Player.m_UseItems[I];
    if UserItem.wIndex > 0 then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem = nil then
        Continue;
      UserItemToClientItem(UserItem, StdItem, @ClientItem, True, False);
      SellPlayerInfo.UseItems[I] := ClientItem;
    end;
  end;
  SellPlayerInfo.JewelryBoxStatus := Player.m_nJewelryBoxStatus;
  for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
  begin
    UserItem := @Player.m_JewelryBoxItems[I];
    if UserItem.wIndex > 0 then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem = nil then
        Continue;
      UserItemToClientItem(UserItem, StdItem, @ClientItem, True, False);
      SellPlayerInfo.JewelryItems[I] := ClientItem;
    end;
  end;
  SellPlayerInfo.ShowGodBless := Player.m_boShowGodBless;
  Move(Player.m_GodBlessItemsState, SellPlayerInfo.GodBlessItemsState, SizeOf(TGodBlessItemsState));
  for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
  begin
    UserItem := @Player.m_GodBlessItems[I];
    if UserItem.wIndex > 0 then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem = nil then
        Continue;
      UserItemToClientItem(UserItem, StdItem, @ClientItem, True, False);
      SellPlayerInfo.GodBlessItems[I] := ClientItem;
    end;
  end;
  // ------------------------------------------------------------
  SellPlayerInfo.Abil := Player.m_WAbil;
  SellPlayerInfo.Abil.Exp := Player.m_Abil.Exp;
  SellPlayerInfo.Abil.MaxExp := Player.m_Abil.MaxExp;
  SellPlayerInfo.Abil.Level := Player.m_Abil.Level;
  SellPlayerInfo.GameGold := Player.m_nGameGold;
  SellPlayerInfo.GamePoint := Player.m_nGamePoint;
  SellPlayerInfo.GameGird := Player.m_nGameGird;
  SellPlayerInfo.GameDiamond := Player.m_nGameDiamond;
  SellPlayerInfo.GameGlory := Player.m_nGameGlory;
  SellPlayerInfo.Alcohol := Player.m_Alcohol.Alcohol;
  SellPlayerInfo.MedicineValue := Player.m_Alcohol.MedicineValue;
  SellPlayerInfo.MoveSpeed := Player.m_nMoveSpeed;
  SellPlayerInfo.AttackSpeed := Player.m_nAttackSpeed;
  SellPlayerInfo.SpellSpeed := Player.m_nSpellSpeed;
  SellPlayerInfo.HitPoint := Player.m_btHitPoint;
  SellPlayerInfo.SpeedPoint := Player.m_btSpeedPoint;
  SellPlayerInfo.AntiMagic := Player.m_nAntiMagic;
  SellPlayerInfo.AntiPoison := Player.m_btAntiPoison;
  SellPlayerInfo.PoisonRecover := Player.m_nPoisonRecover;
  SellPlayerInfo.HealthRecover := Player.m_nHealthRecover;
  SellPlayerInfo.SpellRecover := Player.m_nSpellRecover;
  // ------------------------------------------------------------------------------------------
  SellPlayerInfo.IsTrainingNG := Player.m_boTrainingNG;
  SellPlayerInfo.NPRecoverTime := Player.m_nNPRecoverTime;
  SellPlayerInfo.AbilNG.Level := Player.m_AbilNG.Level;
  SellPlayerInfo.AbilNG.NH := Player.m_AbilNG.NH;
  SellPlayerInfo.AbilNG.MaxNH := Player.m_AbilNG.MaxNH;
  SellPlayerInfo.AbilNG.Exp := Player.m_AbilNG.Exp;
  SellPlayerInfo.AbilNG.MaxExp := Player.m_AbilNG.MaxExp;
  SellPlayerInfo.AbilNG.NGDamage := Player.GetNGAddPower;
  SellPlayerInfo.AbilNG.UnNGDamage := Player.GetNGDecPower;
  SellPlayerInfo.Meridians := Player.m_HumMeridians;
  SellPlayerInfo.OpenLastContinuous := Player.m_boOpenLastContinuous;
  SellPlayerInfo.ContinuousMagicOrder[0] := Player.m_ContinuousMagicOrder[0];
  SellPlayerInfo.ContinuousMagicOrder[1] := Player.m_ContinuousMagicOrder[1];
  SellPlayerInfo.ContinuousMagicOrder[2] := Player.m_ContinuousMagicOrder[2];
  SellPlayerInfo.ContinuousMagicOrder[3] := Player.m_ContinuousMagicOrder[3];
  sSendMsg := zLibCompressBuffer(@SellPlayerInfo, SizeOf(TSellPlayerUserInfo));
  m_DefMsg := MakeDefaultMsg(SM_VIEW_SELL_PLAYER_INFO, 0, Length(sSendMsg), 0, 0);
  SendSocket(@m_DefMsg, sSendMsg);
  // ------------------------------------------------------------------------------------------
  SendViewSellPlayerFengHao(Player);
  // ------------------------------------------------------------------------------------------
  SendViewSellPlayerMagicList(Player);
  // ------------------------------------------------------------------------------------------
  SendViewSellPlayerGamePetList(Player);
  // ------------------------------------------------------------------------------------------
  SendViewSellPlayerGamePetBagItemList(Player);
  // ------------------------------------------------------------------------------------------
  if g_FunctionNPC <> nil then
  begin
    sTempMsg := g_SellPlayerInfoText;
    IsBreakParseVar := False;
    s14 := sTempMsg;
    nC := 0;
    nStartPos := 1;
    while (True) do
    begin
      // if TagCount(s14, '>') < 1 then Break;  $ $
      s14 := sTempMsg;
      if (Pos('>', s14) <= 0) or (Pos('$', s14) <= 0) or (nStartPos >= Length(s14)) then
        Break;
      nPos := ArrestVariable(s14, '<', '$', '>', nStartPos, s10);
      if s10 = '' then
        Break;
      // MainOutMessage('SendMerChantSayMsg:' + IntToStr(nPos) + ' ' + s10);
      // MainOutMessage('SendMerChantSayMsg:' + IntToStr(Length(PosArray)));
      if not g_FunctionNPC.GetVariableText(Player, sTempMsg, s10, IsBreakParseVar, nPos) then
      begin
        nStartPos := nPos + 2;
      end;
      Inc(nC);
      if nC >= 1001 then
        Break;
    end;
  end;
  sSendMsg := sTempMsg;
  m_DefMsg := MakeDefaultMsg(SM_VIEW_SELL_PLAYER_OTHER_INFO, 0, Length(sSendMsg), g_Config.nSellPlayerViewOtherInfoTextOffsetX,
    g_Config.nSellPlayerViewOtherInfoTextOffsetY);
  SendSocket(@m_DefMsg, sSendMsg);
end;

procedure TPlayObject.SendViewSellPlayerBagItems(Player: TPlayObject);
var
  I, nCount: Integer;
  sSendMsg: AnsiString;
  ClientItem: pTClientItem;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  InBuf: PAnsiChar;
  SellPlayerMoney: PSellPlayerMoney;
begin
  FillChar(Player.m_ItemBoxItems, SizeOf(m_ItemBoxItems), #0);
  Player.m_ItemBoxAddIndex := -1;
  sSendMsg := '';
  nCount := 0;

  GetMem(InBuf, Player.m_ItemList.Count * SizeOf(TClientItem) + SizeOf(TSellPlayerMoney));
  try
    SellPlayerMoney := PSellPlayerMoney(InBuf);
    SellPlayerMoney.sUserName := Player.m_sCharName;
    SellPlayerMoney.nGameGold := Player.m_nGameGold;
    SellPlayerMoney.nGamePoint := Player.m_nGamePoint;
    SellPlayerMoney.nGold := Player.m_nGold;
    SellPlayerMoney.nGameDiamond := Player.m_nGameDiamond;
    SellPlayerMoney.nGameGird := Player.m_nGameGird;
    ClientItem := pTClientItem(NativeInt(InBuf) + SizeOf(TSellPlayerMoney));
    for I := 0 to Player.m_ItemList.Count - 1 do
    begin
      UserItem := Player.m_ItemList.Items[I];
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem <> nil then
      begin
        Inc(nCount);
        UserItemToClientItem(UserItem, StdItem, ClientItem, True, True);
        Inc(ClientItem);
      end;
    end;
    sSendMsg := zLibCompressBuffer(InBuf, nCount * SizeOf(TClientItem) + SizeOf(TSellPlayerMoney));
  finally
    FreeMem(InBuf);
  end;

  m_DefMsg := MakeDefaultMsg(SM_VIEW_SELL_PLAYER_BAG_ITEMS, MakeLong(Player.m_btExtBagOpenItemCount, Player.m_btExtBagPageCount),
    Length(sSendMsg), 0, nCount);

  SendSocket(@m_DefMsg, sSendMsg);
end;

procedure TPlayObject.SendViewSellPlayerStorageItems(Player: TPlayObject; IsExtStorage, IsBeginShow: Boolean; nPage: Integer);
const
  ONEPAGECOUNT = 49;
var
  I, nC, nIndex: Integer;
  sSendMsg: AnsiString;
  ClientItem: pTClientItem;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  InBuf: array [0 .. 81920] of AnsiChar;
  Buffer: PAnsiChar;
  ItemList: TList;
  nPageCount, nMaxCount: Integer;
  Header: PTSellPlayerStorageViewHeader;
  HeaderExt: PTSellPlayerStorageExtViewHeader;
  HeaderSize: Integer;

  function GetPageCount(nListCount: Integer): Integer;
  begin
    Result := 0;
    if nListCount > 0 then
    begin
      Result := nListCount div ONEPAGECOUNT;
      if (nListCount mod ONEPAGECOUNT) > 0 then
        Inc(Result);
    end;
  end;

begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  sSendMsg := '';
  nC := 0;
  nIndex := 0;
  Buffer := @InBuf;

  if IsExtStorage then
  begin
    if g_Config.boInfinityStorage or (m_nInfinityStorageExtCount > 0) then
    begin
      nMaxCount := g_Config.nInfinityStorageCount + Player.m_nInfinityStorageExtCount;
      if nMaxCount = 0 then
      begin
        SysMsg(Player.m_sCharName + '未开启无限仓库', c_Red, t_Hint);
        Exit;
      end;
    end
    else
    begin
      SysMsg(Player.m_sCharName + '未开启无限仓库', c_Red, t_Hint);
      Exit;
    end;

    ItemList := Player.m_BigStorageItemList;
    nPageCount := GetPageCount(ItemList.Count);
    if nPage = 0 then
      nIndex := 0;

    if nPage > 0 then
    begin
      if nPage >= nPageCount then
        nPage := nPageCount - 1;
      nIndex := nPage * ONEPAGECOUNT;
    end;

    HeaderExt := PTSellPlayerStorageExtViewHeader(Buffer);
    HeaderExt.sName := Player.m_sCharName;
    HeaderExt.IsBeginShow := IsBeginShow;
    HeaderExt.Count := ItemList.Count;
    HeaderExt.MaxCount := nMaxCount;
    HeaderExt.Page := nPage + 1;
    HeaderExt.MaxPage := nPageCount;
    HeaderSize := SizeOf(TSellPlayerStorageExtViewHeader);
  end
  else
  begin
    if not Player.m_boStorageOpen[nPage] then
    begin
      SysMsg(Player.m_sCharName + '未开启仓库' + IntToStr(nPage + 1), c_Red, t_Hint);
      Exit;
    end;

    ItemList := Player.m_StorageItemList[nPage];
    nMaxCount := MAX_STORE_ITEM;
    nPageCount := Length(Player.m_StorageItemList);
    if nPage < 0 then
      nPage := 0;

    if nPage > 0 then
    begin
      if nPage >= nPageCount then
        nPage := nPageCount - 1;
    end;

    nIndex := 0;
    Header := PTSellPlayerStorageViewHeader(Buffer);
    Header.sName := Player.m_sCharName;
    Header.IsBeginShow := IsBeginShow;
    Move(Player.m_boStorageOpen[0], Header.StorageOpen[0], SizeOf(Header.StorageOpen));
    Header.Count := ItemList.Count;
    Header.MaxCount := nMaxCount;
    Header.Page := nPage + 1;
    HeaderSize := SizeOf(TSellPlayerStorageViewHeader);
  end;

  if ItemList.Count = 0 then
  begin
    sSendMsg := zLibCompressBuffer(InBuf, HeaderSize + nC * SizeOf(TClientItem));
    m_DefMsg := MakeDefaultMsg(SM_VIEW_SELL_PLAYER_STORAGE_ITEMS, 0, Length(sSendMsg), Integer(IsExtStorage), nC);
    SendSocket(@m_DefMsg, sSendMsg);
    Exit;
  end;

  Inc(Buffer, HeaderSize);
  for I := nIndex to ItemList.Count - 1 do
  begin
    UserItem := ItemList.Items[I];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem <> nil then
    begin
      ClientItem := pTClientItem(Buffer);
      UserItemToClientItem(UserItem, StdItem, ClientItem, True, False);
      Inc(nC);
      Inc(Buffer, SizeOf(TClientItem));
      if nC >= ONEPAGECOUNT then
        Break;
    end;
  end;

  sSendMsg := zLibCompressBuffer(InBuf, HeaderSize + nC * SizeOf(TClientItem));
  m_DefMsg := MakeDefaultMsg(SM_VIEW_SELL_PLAYER_STORAGE_ITEMS, 0, Length(sSendMsg), Integer(IsExtStorage), nC);
  SendSocket(@m_DefMsg, sSendMsg);
end;

procedure TPlayObject.SendViewSellPlayerHeroInfo(Player: TPlayObject);
var
  I: Integer;
  UserState: TUserStateInfo;
  StdItem: pTStdItem;
  ClientItem: TClientItem;
  UserItem: pTUserItem;
  sSendMsg: AnsiString;
  SmartObject: TSmartObject;
  HeroObj: TBaseObject;
  nC: Integer;
  InBuf: PAnsiChar;
  InBufMemSize: Integer;
  InBytes: Integer;
  Buffer: PAnsiChar;
  PClientItem: pTClientItem;
begin
  if Player = nil then
    Exit;
  HeroObj := Player.m_MyHero;
  if HeroObj = nil then
  begin
    SysMsg(Player.m_sCharName + '的英雄不存在或未召唤', c_Red, t_Hint);
    Exit;
  end;
  m_sLastQueryUserName := HeroObj.m_sCharName;
  FillChar(UserState, SizeOf(TUserStateInfo), #0);
  UserState.RaceServer := HeroObj.m_btRaceServer;
  { if IsOldClient then
    UserState.Feature.Feature := BaseObject.GetFeatureOld(BaseObject)
    else }
  UserState.Feature.Feature := HeroObj.GetFeature(HeroObj, @UserState.Feature.Buffer);
  UserState.NAMECOLOR := GetCharColor(HeroObj);
  // 是否显示神秘人 piaoyun 2013-08-17
  UserState.UserName := HeroObj.m_sCharName;
  if (HeroObj.m_Master <> nil) then
  begin
    UserState.GuildName := HeroObj.m_Master.m_sCharName;
    if g_Config.boHeroShowMasterName and (g_Config.sHeroSuffixName <> '') then
      UserState.GuildRankName := g_Config.sHeroSuffixName
    else
      UserState.GuildRankName := '的英雄';
  end;
  if HeroObj.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(HeroObj);
    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      UserItem := @SmartObject.m_UseItems[I];
      if UserItem.wIndex > 0 then
      begin
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem = nil then
          Continue;
        UserItemToClientItem(UserItem, StdItem, @ClientItem, True, False);
        UserState.UseItems[I] := ClientItem;
      end;
    end;
    UserState.JewelryBoxStatus := SmartObject.m_nJewelryBoxStatus;
    // if SmartObject.m_nJewelryBoxStatus = JewelryBoxOpen then
    begin
      for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
      begin
        UserItem := @SmartObject.m_JewelryBoxItems[I];
        if UserItem.wIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if StdItem = nil then
            Continue;
          UserItemToClientItem(UserItem, StdItem, @ClientItem, True, False);
          UserState.JewelryItems[I] := ClientItem;
        end;
      end;
    end;
    UserState.ShowGodBless := SmartObject.m_boShowGodBless;
    Move(SmartObject.m_GodBlessItemsState, UserState.GodBlessItemsState, SizeOf(TGodBlessItemsState));
    for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
    begin
      UserItem := @SmartObject.m_GodBlessItems[I];
      if UserItem.wIndex > 0 then
      begin
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem = nil then
          Continue;
        UserItemToClientItem(UserItem, StdItem, @ClientItem, True, False);
        UserState.GodBlessItems[I] := ClientItem;
      end;
    end;
  end;
  sSendMsg := zLibCompressBuffer(@UserState, SizeOf(TUserStateInfo));
  m_DefMsg := MakeDefaultMsg(SM_SENDUSERSTATE, 0, Length(sSendMsg), 0, 0);
  SendSocket(@m_DefMsg, sSendMsg);
  if HeroObj.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
  begin
    SmartObject := TSmartObject(HeroObj);
    sSendMsg := '';
    InBytes := 0;
    nC := 0;
    InBufMemSize := SmartObject.m_FengHaoItems.Count * (SizeOf(TClientItem) + 1) + 1;
    try
      GetMem(InBuf, InBufMemSize);
    except
      on E: Exception do
      begin
        MainOutMessage('[Exception] TTPlayObject::SendViewSellPlayerHeroInfo Error');
        MainOutMessage(E.Message);
        Exit;
      end;
    end;
    try
      for I := 0 to SmartObject.m_FengHaoItems.Count - 1 do
      begin
        UserItem := SmartObject.m_FengHaoItems.Items[I];
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          Inc(nC);
          Inc(InBytes, SizeOf(TClientItem) + 1);
          Buffer := InBuf;
          Buffer := Buffer + (InBytes - (SizeOf(TClientItem) + 1));
          Buffer^ := AnsiChar(I);
          Inc(Buffer);
          PClientItem := pTClientItem(Buffer);
          UserItemToClientItem(UserItem, StdItem, PClientItem, True, False);
        end;
      end;
      sSendMsg := zLibCompressBuffer(InBuf, InBytes);
      m_DefMsg := MakeDefaultMsg(SM_SENDUSERSTATE_FENGHAO, Integer(SmartObject.m_ActiveFengHao), Length(sSendMsg), 0, nC);
      SendSocket(@m_DefMsg, sSendMsg);
    finally
      FreeMem(InBuf, InBufMemSize);
    end;
  end;
end;

procedure TPlayObject.ClientBuySellPlayer(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function CheckGameMoney(SellPlayerInfo: PSellPlayerInfo): Boolean;
  begin
    Result := False;
    case SellPlayerInfo.SellPricesType of
      0:
        Result := m_nGameGold >= SellPlayerInfo.SellPrices; // 游戏币
      1:
        Result := m_nGamePoint >= SellPlayerInfo.SellPrices; // 游戏点
      2:
        Result := m_nGold >= SellPlayerInfo.SellPrices; // 金币数量
      3:
        Result := m_nGameDiamond >= SellPlayerInfo.SellPrices; // 金刚石
      4:
        Result := m_nGameGird >= SellPlayerInfo.SellPrices; // 灵符
    else
      CheckMoney(SellPlayerInfo.SellPricesType - 5, 3);
    end;
  end;
  procedure DecGameMoney(SellPlayerInfo: PSellPlayerInfo);
  var
    nValue: Integer;
  begin
    case SellPlayerInfo.SellPricesType of
      0:
        begin
          DecGameGold(SellPlayerInfo.SellPrices);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_PlayerTrading, LOG_GameGoldChange, Self, g_Config.sGameGoldName, 0, SellPlayerInfo.Player,
              m_nGameGold, -SellPlayerInfo.SellPrices, '购买角色');
          end;
        end;
      1: // 排除
        begin
          // OldValue := m_nGamePoint;
          DecGamePoint(SellPlayerInfo.SellPrices);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_PlayerTrading, LOG_GamePointChange, Self, g_Config.sGamePointName, 0, SellPlayerInfo.Player,
              m_nGamePoint, -SellPlayerInfo.SellPrices, '购买角色');
          end;
        end;
      2:
        begin
          // OldValue := m_nGold;
          if DecGold(SellPlayerInfo.SellPrices) then
            GoldChanged;

          if g_boGameLogGold then
          begin
            AddGameDataLog(LOG_PlayerTrading, LOG_GoldChange, Self, sSTRING_GOLDNAME, 0, SellPlayerInfo.Player, m_nGold,
              -SellPlayerInfo.SellPrices, '购买角色');
          end;
        end;
      3:
        begin
          // OldValue := m_nGameDiamond;
          DecGameDiamond(SellPlayerInfo.SellPrices);
          NewGamePointChanged();
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_PlayerTrading, LOG_GameDiamondChange, Self, g_Config.sGameDiamondName, 0, SellPlayerInfo.Player,
              m_nGameDiamond, -SellPlayerInfo.SellPrices, '购买角色');
          end;
        end;
      4:
        begin
          // OldValue := m_nGameGird;
          DecGameGird(SellPlayerInfo.SellPrices);
          NewGamePointChanged();
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_PlayerTrading, LOG_GameGirdChange, Self, g_Config.sGameGirdName, 0, SellPlayerInfo.Player,
              m_nGameGird, -SellPlayerInfo.SellPrices, '购买角色');
          end;
        end;
    else
      DecMoney(SellPlayerInfo.SellPricesType - 5, SellPlayerInfo.SellPrices, nValue);
    end;
  end;

var
  SellPlayer: string;
  Index, MoneyType, Prices: Integer;
  SellPlayerInfo: PSellPlayerInfo;
begin


  SellPlayer := DecodeString(ProcessMsg.sMsg);
  Prices := ProcessMsg.nParam1;
  MoneyType := ProcessMsg.nParam2;
  if not g_SellPlayerList.Search(SellPlayer, Index) then
  begin
    SendDefMessage(SM_SELL_PLAYER_BUY_RET, -1, 0, 0, 0, '');
    Exit;
  end;
  SellPlayerInfo := g_SellPlayerList.Items[Index];
  if (SellPlayerInfo.SellPricesType <> MoneyType) or (SellPlayerInfo.SellPrices <> Prices) then
  begin
    SendDefMessage(SM_SELL_PLAYER_BUY_RET, -5, 0, 0, 0, ProcessMsg.sMsg);
    Exit;
  end;
  // 正在出售中
  if SellPlayerInfo.IsBuying then
  begin
    SendDefMessage(SM_SELL_PLAYER_BUY_RET, -2, 0, 0, 0, '');
    Exit;
  end;

  m_boStopBuyUser := False;
  if g_FunctionNPC <> nil then
  begin
    m_nScriptGotoCount := 0;
    g_FunctionNPC.GotoLable(Self, '@BeginBuyUser', False);
  end;
  if m_boStopBuyUser then begin
    Exit;
  end;

  if SameText(SellPlayerInfo.Player, SellPlayer) and
    ((not SellPlayerInfo.SetUser) or SameText(SellPlayerInfo.SetUserName, m_sCharName)) then
  begin
    if not CheckGameMoney(SellPlayerInfo) then
    begin
      SendDefMessage(SM_SELL_PLAYER_BUY_RET, -3, SellPlayerInfo.SellPricesType, 0, 0, '');
    end
    else
    begin
      DecGameMoney(SellPlayerInfo);
      SellPlayerInfo.IsBuying := True;
      DataEngine.BuyPlayer(Self, SellPlayerInfo.Account, SellPlayerInfo.Player, SellPlayerInfo.SellPricesType,
        SellPlayerInfo.SellPrices, SellPlayerInfo.Delegater);

      m_sPlayerBuyUser := SellPlayerInfo.Player; //购买的角色名
      m_sPlayerBuyUserDelegater := SellPlayerInfo.Delegater; //角色出售委托人
      m_nPlayerBuyPrices := SellPlayerInfo.SellPrices;     //角色出售价格
      case SellPlayerInfo.SellPricesType of
        0:
          m_sPlayerBuyMoneyType := g_Config.sGameGoldName;
        1:
          m_sPlayerBuyMoneyType := g_Config.sGamePointName;
        2:
          m_sPlayerBuyMoneyType := sSTRING_GOLDNAME;
        3:
          m_sPlayerBuyMoneyType := g_Config.sGameDiamondName;
        4:
          m_sPlayerBuyMoneyType := g_Config.sGameGirdName;
      else
        m_sPlayerBuyMoneyType := GetCustomMoneyNameByRule(SellPlayerInfo.SellPricesType, 0);
      end;
      m_btPlayerBuyMoneyTypeValue := SellPlayerInfo.SellPricesType; //角色出售货币类型值

      g_FunctionNPC.GotoLable(Self, '@PlayerBuyIn', False);

      m_sPlayerBuyUser := ''; //购买的角色名
      m_sPlayerBuyUserDelegater := ''; //角色出售委托人
      m_nPlayerBuyPrices := 0;     //角色出售价格
      m_sPlayerBuyMoneyType := ''; //角色出售货币类型文本
      m_btPlayerBuyMoneyTypeValue := 0; //角色出售货币类型值
    end;
  end
  else
  begin
    SendDefMessage(SM_SELL_PLAYER_BUY_RET, -4, 0, 0, 0, '');
  end;
end;

procedure TPlayObject.ClientUploadPickItmes(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  S, Msg: AnsiString;
  nCount: Integer;
  Hash: LongWord;
begin
{$IF NEED_KEY = 1}
  if g_nKey_UseClientPickItems = 0 then
    Exit;
{$IFEND}
  Hash := ProcessMsg.nParam1;
  nCount := ProcessMsg.nParam2;
  if nCount <= 0 then
  begin
    if m_ClientPickItems <> nil then
    begin
      m_ClientPickItems.Clear;
    end;
    Msg := StringReplace(g_sUploadPickItmesToServer, '%count', '0', [rfIgnoreCase]);
    SysMsg(Msg, c_Green, t_Hint);
    Exit;
  end;
  if nCount > MAX_UPLOAD_PICKITEMS then
  begin
    Exit;
  end;
  S := ProcessMsg.sMsg;
  if (Length(S) = 0) then
  begin
    if m_ClientPickItems <> nil then
    begin
      m_ClientPickItems.Clear;
    end;
    Msg := StringReplace(g_sUploadPickItmesToServer, '%count', '0', [rfIgnoreCase]);
    SysMsg(Msg, c_Green, t_Hint);
    Exit;
  end;
  if (DJBHash(@S[1], Length(S)) <> Hash) then
  begin
    Exit;
  end;
  S := zLibDecodeString(S);
  if Length(S) <> nCount * SizeOf(Word) then
  begin
    Exit;
  end;
  if m_ClientPickItems = nil then
  begin
    m_ClientPickItems := TClientPickItems.Create;
  end;
  m_ClientPickItems.SetData(@S[1], Length(S));
  Msg := StringReplace(g_sUploadPickItmesToServer, '%count', IntToStr(nCount), [rfIgnoreCase]);
  SysMsg(Msg, c_Green, t_Hint);
end;

