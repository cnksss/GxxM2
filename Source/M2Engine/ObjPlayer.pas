procedure TPlayObject.ClientGuildDelMemberEx(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 逐出行会
var
  Code: Integer;
  UserName, Master1, Master2, GuildName: string;
  Player: TPlayObject;
begin
  UserName := DecodeString(ProcessMsg.sMsg);
  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    Code := 1
  else
  begin
    TGUild(m_MyGuild).GetGuildMasterName(Master1, Master2);
    if (UserName = Master1) then
      Code := 2
    else
    begin
      if TGUild(m_MyGuild).DelMember(UserName) then
      begin
        Player := UserEngine.GetPlayObject(UserName);
        GuildName := TGUild(m_MyGuild).sGuildName;
        if Player <> nil then
        begin
          Player.m_MyGuild := nil;
          Player.m_sGuildRankName := '';
          Player.m_nGuildRankNo := 0;
          Player.RefShowName();
          Player.SysMsg('您被管理员逐出行会 ' + GuildName, c_Red, t_Hint);
          if (g_FunctionNPC <> nil) then
          begin
            Player.m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Player, '@ExitGuild', False);
          end;
        end;
        Code := 0;
      end
      else
        Exit;
    end;
  end;

  if Code = 0 then
  begin
    if m_nGuildRankNo = 1 then
    begin
      if SameText(m_sCharName, Master1) then
        SendDefMessage(SM_GuildDelMemberEx_RET, Code, 2, 0, 0, UserName)
      else
        SendDefMessage(SM_GuildDelMemberEx_RET, Code, 1, 0, 0, UserName)
    end
    else
      SendDefMessage(SM_GuildDelMemberEx_RET, Code, 0, 0, 0, UserName);
  end
  else
    SendDefMessage(SM_GuildDelMemberEx_RET, Code, 0, 0, 0, UserName)
end;

procedure TPlayObject.ClientGuildMemberMoveToRank(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 移动行会成员
var
  I, Code, ToRankNo, UserRankNo: Integer;
  UserName, Master1, Master2: string;
  Player: TPlayObject;
  GuildRank, MasterGuildRank, ToGuildRank: pTGuildRank;
  GroupIndex: Integer;
begin
  UserName := DecodeString(ProcessMsg.sMsg);
  ToRankNo := ProcessMsg.nParam1;
  GroupIndex := ProcessMsg.nParam2;

  Code := 0;
  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    Code := 1
  else
  begin
    if TGUild(m_MyGuild).GetRankName(UserName, UserRankNo) = '' then
      Code := 2
    else if UserRankNo = ToRankNo then
      Code := 3
    else
    begin
      MasterGuildRank := nil;
      ToGuildRank := nil;
      for I := 0 to TGUild(m_MyGuild).m_RankList.Count - 1 do
      begin
        GuildRank := TGUild(m_MyGuild).m_RankList.Items[I];
        if GuildRank.nRankNo = 1 then
        begin
          MasterGuildRank := GuildRank;
          if ToGuildRank <> nil then
            Break;
        end;
        if GuildRank.nRankNo = ToRankNo then
        begin
          ToGuildRank := GuildRank;
          if MasterGuildRank <> nil then
            Break;
        end;
      end;

      if ToGuildRank = nil then
        Code := 4
      else
      begin
        Player := UserEngine.GetPlayObject(UserName);
        if ToRankNo = 1 then
        begin
          if MasterGuildRank <> nil then
          begin
            if TGUild(m_MyGuild).DelMember(UserName) then
            begin
              if MasterGuildRank.MemberList.Count = 2 then
              begin
                if SameText(MasterGuildRank.MemberList[0], m_sCharName) then
                begin
                  MasterGuildRank.MemberList.Delete(0);
                  MasterGuildRank.MemberList.InsertObject(0, UserName, Player);
                end
                else
                begin
                  MasterGuildRank.MemberList.Delete(1);
                  MasterGuildRank.MemberList.AddObject(UserName, Player);
                end;
                TGUild(m_MyGuild).AddMember(Self);
                m_sGuildRankName := TGUild(m_MyGuild).GetRankName2(Self, m_nGuildRankNo);
                RefShowName();
              end
              else
              begin
                MasterGuildRank.MemberList.AddObject(UserName, Player);
                TGUild(m_MyGuild).UpdateGuildFile;
              end;
            end;

            if Player <> nil then
            begin
              Player.m_sGuildRankName := TGUild(m_MyGuild).GetRankName2(Player, Player.m_nGuildRankNo);
              Player.RefShowName();
            end;
          end;
        end
        else
        begin
          if (MasterGuildRank <> nil) and (MasterGuildRank.MemberList.Count = 1) and SameText(m_sCharName, UserName) then
            Code := 5
          else
          begin
            if TGUild(m_MyGuild).DelMember(UserName) then
            begin
              ToGuildRank.MemberList.AddObject(UserName, Player);
              if Player <> nil then
              begin
                Player.m_sGuildRankName := TGUild(m_MyGuild).GetRankName2(Player, Player.m_nGuildRankNo);
                Player.RefShowName();
              end;

              TGUild(m_MyGuild).UpdateGuildFile;
            end;
          end;
        end;
      end
    end;
  end;

  if Code = 0 then
  begin
    if m_nGuildRankNo = 1 then
    begin
      TGUild(m_MyGuild).GetGuildMasterName(Master1, Master2);
      if SameText(m_sCharName, Master1) then
        SendDefMessage(SM_GuildMemberMoveToRank_RET, Code, 2, 0, 0, UserName)
      else
        SendDefMessage(SM_GuildMemberMoveToRank_RET, Code, 1, 0, 0, UserName)
    end
    else
      SendDefMessage(SM_GuildMemberMoveToRank_RET, Code, 0, 0, 0, UserName);

    ProcessMsg.wParam := 1;
    ProcessMsg.nParam1 := GroupIndex;
    ClientGuildMemberList(ProcessMsg, boResult);
  end
  else
    SendDefMessage(SM_GuildMemberMoveToRank_RET, Code, 0, 0, 0, UserName)
end;

