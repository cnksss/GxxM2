procedure TPlayObject.ClientGuildJoinTo(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  GuildName, ExisWantGuildName: string;
  I, Code: Integer;
  Guild, TempGuild: TGUild;
  myJob: Integer;
  // GuildMaster1, GuildMaster2: TPlayObject;
begin
  case m_btJob of
    0:
      myJob := 1;
    1:
      myJob := 2
  else
    myJob := 4;
  end;
  GuildName := DecodeString(ProcessMsg.sMsg);
  if m_MyGuild <> nil then
    Code := 1
  else
  begin
    Guild := g_GuildManager.FindGuild(GuildName);
    if Guild = nil then
      Code := 2
    else if Guild.JoinJob = 0 then
      Code := 3
    else if (m_Abil.Level < Guild.JoinLevel) then
      Code := 4
    else if (myJob and Guild.JoinJob = 0) then
      Code := 5
    else if Guild.IsFull then
      Code := 6
    else
    begin
      ExisWantGuildName := '';
      for I := 0 to g_GuildManager.GuildList.Count - 1 do
      begin
        TempGuild := g_GuildManager.GuildList.Items[I];
        if TempGuild.FindWantAddMemberIndex(m_sCharName) <> -1 then
        begin
          ExisWantGuildName := TempGuild.sGuildName;
          Break;
        end;
      end;
      if Length(ExisWantGuildName) <> 0 then
        Code := 7
      else
      begin
        Guild.AddWantAddMember(Self);
        Code := 0;
      end;
    end;
  end;

  if Code = 0 then
    SendDefMessage(SM_GUILDJOINTO_OK, Code, 0, 0, 0, GuildName)
  else
    SendDefMessage(SM_GUILDJOINTO_FAIL, Code, 0, 0, 0, ExisWantGuildName);
end;

procedure TPlayObject.ClientGuildCancelJoinTo(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  Code: Integer;
  GuildName: string;
  Guild: TGUild;
begin
  GuildName := DecodeString(ProcessMsg.sMsg);
  Guild := g_GuildManager.FindGuild(GuildName);
  if Guild = nil then
    Code := 1
  else if Guild.FindWantAddMemberIndex(m_sCharName) = -1 then
    Code := 2
  else
  begin
    Guild.DeleteWantAddMember(m_sCharName);
    Code := 0;
  end;

  if Code = 0 then
    SendDefMessage(SM_GUILDCANCELJOINTO_OK, Code, 0, 0, 0, '')
  else
    SendDefMessage(SM_GUILDCANCELJOINTO_FAIL, Code, 0, 0, 0, '')
end;

