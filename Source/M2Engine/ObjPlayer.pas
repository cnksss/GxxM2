procedure TPlayObject.ClientResponseGorupJoin(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  sInviteHuman: string;
  Player: TPlayObject;
  Index: Integer;
begin
  sInviteHuman := DecodeString(ProcessMsg.sMsg);
  if Length(sInviteHuman) = 0 then
    Exit;
  if g_Config.boGroupUseOldMode then
    Exit;
  Player := UserEngine.GetPlayObject(sInviteHuman);
  if (Player = nil) or (Player.m_boDeath) or (Player.m_boGhost) or (Player.m_boDummyObject) then
  begin
    // 邀请人已经下线
    SysMsg('邀请人 ' + sInviteHuman + ' 已经下线，组队失败', c_Red, t_System);
    Exit;
  end;
  Index := Player.m_sInviteGroupHuman.IndexOf(m_sCharName);
  if ProcessMsg.wParam = 0 then
  begin
    if Index >= 0 then
    begin
      Player.m_sInviteGroupHuman.Delete(Index);
      Player.SysMsg(m_sCharName + ' 未响应组队请求', c_Red, t_System);
    end;
    Exit;
  end
  else if Index >= 0 then
  begin
    Player.m_sInviteGroupHuman.Delete(Index);
    if (m_GroupOwner <> nil) then
    begin
      Player.SysMsg(m_sCharName + ' 已经加入队伍', c_Red, t_System);
      Exit;
    end;
    if Player.m_GroupOwner = nil then
    begin
{$IF MULTI_THREAD = 1}
      if g_MultiThreadRun then
        Player.m_GroupMembers.LockW(45);
      try
{$IFEND}
        Player.m_GroupMembers.Clear;
        Player.m_GroupMembers.AddObject(sInviteHuman, Player);
        Player.m_GroupMembers.AddObject(m_sCharName, Self);
{$IF MULTI_THREAD = 1}
      finally
        if g_MultiThreadRun then
          Player.m_GroupMembers.UnLockW;
      end;
{$IFEND}
      Player.JoinGroup(Player);
      JoinGroup(Player);
      Player.m_boAllowGroup := True;
      Player.SendDefMessage(SM_CREATEGROUP_OK, 0, 0, 0, 0, '');
      Player.SendGroupMembers();
      if g_FunctionNPC <> nil then
      begin
        Player.m_sString[0] := sInviteHuman;
        Player.m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Player, '@GroupCreate', False);
      end;
    end
    else if Player.m_GroupOwner <> Player then
    begin
      SysMsg('邀请人 ' + sInviteHuman + ' 已经加入其他队伍，组队失败', c_Red, t_System);
      Exit;
    end
    else
    begin
{$IF MULTI_THREAD = 1}
      if g_MultiThreadRun then
        Player.m_GroupMembers.LockW(46);
      try
{$IFEND}
        Player.m_GroupMembers.AddObject(m_sCharName, Self);
{$IF MULTI_THREAD = 1}
      finally
        if g_MultiThreadRun then
          Player.m_GroupMembers.UnLockW;
      end;
{$IFEND}
      JoinGroup(Player);
      Player.SendDefMessage(SM_GROUPADDMEM_OK, 0, 0, 0, 0, '');
      Player.SendGroupMembers();
      if (g_FunctionNPC <> nil) then
      begin
        Player.m_sString[0] := m_sCharName;
        Player.m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Player, '@GroupAddMember', False);
      end;
    end;
  end
  else
  begin
    SysMsg('响应组队超时，组队失败', c_Red, t_System);
    Exit;
  end;
end;

