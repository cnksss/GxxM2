procedure TPlayObject.ClientGuildMemberList(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  GuildRank: pTGuildRank;
  I, II: Integer;
  sSendMsg, sUserName: AnsiString;
  Player: TPlayObject;
  IsFound: Boolean;
begin
  if m_MyGuild = nil then
    Exit;
  if g_Config.boOpenNewGuild then
  begin
    IsFound := False;
    for I := 0 to TGUild(m_MyGuild).m_RankList.Count - 1 do
    begin
      GuildRank := TGUild(m_MyGuild).m_RankList.Items[I];
      if GuildRank = nil then
        Continue;
      if GuildRank.nRankNo = 99 then
        IsFound := True;
      sSendMsg := sSendMsg + '#' + IntToStr(GuildRank.nRankNo) + '/*' + GuildRank.sRankName + '/';
      for II := 0 to GuildRank.MemberList.Count - 1 do
      begin
        if Length(sSendMsg) > 8000 then
          Break;
        sUserName := GuildRank.MemberList.Strings[II];
        Player := UserEngine.GetPlayObject(sUserName);
        if (Player <> nil) and (not Player.m_boOffLine) then
          sSendMsg := sSendMsg + sUserName + #9 + '1/'
        else
          sSendMsg := sSendMsg + sUserName + #9 + '0/';
      end;
    end;
    if not IsFound then
    begin
      sSendMsg := sSendMsg + '#99/*所有成员/';
    end;
  end
  else
  begin
    for I := 0 to TGUild(m_MyGuild).m_RankList.Count - 1 do
    begin
      GuildRank := TGUild(m_MyGuild).m_RankList.Items[I];
      if GuildRank = nil then
        Continue;
      sSendMsg := sSendMsg + '#' + IntToStr(GuildRank.nRankNo) + '/*' + GuildRank.sRankName + '/';
      for II := 0 to GuildRank.MemberList.Count - 1 do
      begin
        if Length(sSendMsg) > 5000 then
          Break;
        sSendMsg := sSendMsg + GuildRank.MemberList.Strings[II] + '/';
      end;
    end;
  end;
  m_DefMsg := MakeDefaultMsg(SM_SENDGUILDMEMBERLIST, 0, Integer(g_Config.boOpenNewGuild), ProcessMsg.nParam1, 1);
  SendSocket(@m_DefMsg, EncodeString(sSendMsg));
end;

procedure TPlayObject.ClientGuildAddMember(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nC: Integer;
  MemberObject: TPlayObject;
begin
  nC := 1; // '你没有权利使用这个命令。'
  if IsGuildMaster then
  begin
    MemberObject := UserEngine.GetPlayObject(ProcessMsg.sMsg);
    if MemberObject <> nil then
    begin
      if (MemberObject.GetPoseCreate = Self) and (MemberObject.GetPoseCreate <> nil) then
      begin
        if MemberObject.m_boAllowGuild then
        begin
          if not TGUild(m_MyGuild).IsMember(ProcessMsg.sMsg) then
          begin
            if (MemberObject.m_MyGuild = nil) { and (TGUild(m_MyGuild).m_RankList.Count < 400) } then
            begin
              if not TGUild(m_MyGuild).IsFull then
              begin
                if (g_Config.boNationGuildCheck) and (m_btNation <> MemberObject.m_btNation) then
                begin
                  nC := 7;
                end
                else
                begin
                  m_boStopHumanJoinGuild := False;
                  if g_FunctionNPC <> nil then
                  begin
                    m_sJoinGuildUserName := MemberObject.m_sCharName;
                    m_nScriptGotoCount := 0;
                    g_FunctionNPC.GotoLable(Self, '@BeforeJoinGuild', False);
                    m_sJoinGuildUserName := '';
                  end;
                  if m_boStopHumanJoinGuild then
                    nC := 6
                  else
                  begin
                    TGUild(m_MyGuild).AddMember(MemberObject);
                    MemberObject.m_MyGuild := m_MyGuild;
                    MemberObject.m_sGuildRankName := TGUild(m_MyGuild).GetRankName2(MemberObject, MemberObject.m_nGuildRankNo);
                    MemberObject.RefShowName();
                    MemberObject.SysMsg('你已加入行会: ' + TGUild(m_MyGuild).sGuildName + ' 当前封号为: ' + MemberObject.m_sGuildRankName,
                      c_Green, t_Hint);
                    if g_FunctionNPC <> nil then
                    begin
                      MemberObject.m_nScriptGotoCount := 0;
                      g_FunctionNPC.GotoLable(MemberObject, '@JoinGuild', False);
                    end;
                    nC := 0;
                  end;
                end;
              end
              else
                nC := 6;
            end
            else
              nC := 4; // '对方已经加入其他行会。'
          end
          else
            nC := 3; // 004DEEF4 '对方已经加入我们的行会。'
        end
        else
        begin // 004DEEFD
          nC := 5; // '对方不允许加入行会。'
          MemberObject.SysMsg('你拒绝加入行会。 [允许命令为 @' + g_GameCommand.LETGUILD.sCmd + ']', c_Red, t_Hint);
        end;
      end
      else
        nC := 2; // 004DEF15 '想加入进来的成员应该来面对掌门人。'
    end
    else
      nC := 2;
  end;
  if nC = 0 then
  begin
    SendDefMessage(SM_GUILDADDMEMBER_OK, 0, 0, 0, 0, '');
  end
  else
  begin
    SendDefMessage(SM_GUILDADDMEMBER_FAIL, nC, 0, 0, 0, '');
  end;
end;

