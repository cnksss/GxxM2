procedure TPlayObject.ClientGamePetRecall(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 召唤宠物
var
  GamePetData: pTGamePetData;
  BaseObject: TBaseObject;
  nX, nY: Integer;
  nTime: Integer;
begin
  if m_PEnvir.m_boNoCallPet and (g_sDisableCallGamePetOnMap <> '') then
  begin
    SysMsg(g_sDisableCallGamePetOnMap, c_Red, t_Hint);
    Exit;
  end;
  if (ProcessMsg.nParam2 = m_GamePetList.Count) and (ProcessMsg.nParam1 >= 0) and (ProcessMsg.nParam1 < m_GamePetList.Count) then
  begin
    if m_MyGamePetIndex = ProcessMsg.nParam1 then
      Exit;
    GamePetData := m_GamePetList.Items[ProcessMsg.nParam1];
    if Tick_Diff(GamePetData.DieTick, MyGetTickCount) <= g_Config.nGamePetRecallTime * 1000 then
    begin
      nTime := Round(g_Config.nGamePetRecallTime - Tick_Diff(GamePetData.DieTick, MyGetTickCount) / 1000);
      if nTime <= 0 then
        nTime := 1;
      SysMsg('你的宠物太虚弱，请等待' + IntToStr(nTime) + '秒后重新召唤', 255, 253, t_Hint);
      Exit;
    end;
    if (m_MyGamePetIndex >= 0) and (m_MyGamePetIndex < m_GamePetList.Count) and (m_MyGamePet <> nil) then
    begin
      GamePetData := m_GamePetList.Items[m_MyGamePetIndex];
      GamePetData.Level := m_MyGamePet.m_WAbil.Level;
      GamePetData.HP := m_MyGamePet.m_WAbil.HP;
      GamePetData.MP := m_MyGamePet.m_WAbil.MP;
      GamePetData.Exp := m_MyGamePet.m_WAbil.Exp;
      if (not m_MyGamePet.m_boGhost) and (not m_MyGamePet.m_boDeath) then
        GamePetData.DieTick := 0
      else
        GamePetData.DieTick := MyGetTickCount;
      m_sMyGamePetName := m_MyGamePet.m_sCharName;
      // 将主人置空 2019-12-06 11:25:57
      m_MyGamePet.m_Master := nil;
      m_MyGamePet.MakeGhost;
      m_MyGamePet := nil;
      m_MyGamePetIndex := -1;
      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@GamePetRetake', False);
      end;
    end;
    if m_MyGamePet <> nil then
    begin
      m_MyGamePet.m_Master := nil;
      m_MyGamePet.MakeGhost;
      m_MyGamePet := nil;
      m_MyGamePetIndex := -1;
    end;
    GamePetData := m_GamePetList.Items[ProcessMsg.nParam1];
    GetFrontPosition(nX, nY);
    BaseObject := UserEngine.RegenMonsterByName(m_PEnvir.sMapName, nX, nY, GamePetData.sName);
    if BaseObject <> nil then
    begin
      BaseObject.m_Master := Self; // 设置宝宝主人 -- piaoyun 2013-6-23
      BaseObject.m_dwMasterRoyaltyStartTick := MyGetTickCount;
      BaseObject.m_dwMasterRoyaltyTime := High(LongWord) - 10000;
      BaseObject.m_Abil.Level := GamePetData.Level;
      BaseObject.m_WAbil.Level := GamePetData.Level;
      BaseObject.m_Abil.Exp := GamePetData.Exp;
      BaseObject.m_WAbil.Exp := GamePetData.Exp;
      BaseObject.m_boGamePet := True;
      BaseObject.RecalcAbilitys;
      BaseObject.m_Abil.MaxExp := BaseObject.GetLevelExp(BaseObject.m_Abil.Level);
      if GamePetData.HP <= BaseObject.m_WAbil.MaxHP then
        BaseObject.m_WAbil.HP := GamePetData.HP;
      if GamePetData.MP <= BaseObject.m_WAbil.MaxHP then
        BaseObject.m_WAbil.MP := GamePetData.MP;
      if BaseObject.m_WAbil.HP <= 10 then
        BaseObject.m_WAbil.HP := 10;
      m_MyGamePet := BaseObject;
      m_MyGamePetIndex := ProcessMsg.nParam1;
      m_LastMyGamePetIndex := m_MyGamePetIndex;
      SendCurrentRecalGamePetIndex(ProcessMsg.nParam1);
      m_sMyGamePetName := m_MyGamePet.m_sCharName;
      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@GamePetRecall', False);
      end;
      RecalcAbilitys;
      SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
      SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
    end;
  end;
end;

function TPlayObject.DoGamePetRetake: Boolean;
var
  GamePetData: pTGamePetData;
begin
  Result := False;
  if (m_MyGamePetIndex >= 0) and (m_MyGamePetIndex < m_GamePetList.Count) and (m_MyGamePet <> nil) then
  begin
    GamePetData := m_GamePetList.Items[m_MyGamePetIndex];
    GamePetData.Level := m_MyGamePet.m_WAbil.Level;
    GamePetData.HP := m_MyGamePet.m_WAbil.HP;
    GamePetData.MP := m_MyGamePet.m_WAbil.MP;
    GamePetData.Exp := m_MyGamePet.m_WAbil.Exp;
    if (not m_MyGamePet.m_boGhost) and (not m_MyGamePet.m_boDeath) then
      GamePetData.DieTick := 0
    else
      GamePetData.DieTick := MyGetTickCount;
    m_sMyGamePetName := m_MyGamePet.m_sCharName;
    // 将主人置空 2019-12-06 11:25:57
    m_MyGamePet.m_Master := nil;
    m_MyGamePet.MakeGhost;
    m_MyGamePet := nil;
    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@GamePetRetake', False);
    end;
    // 宠物回收后，刷新属性 2020-06-20 21:53:54
    SendUpdatePetAbilityEx(GamePetData);
    m_MyGamePetIndex := -1;
    SendCurrentRecalGamePetIndex(m_MyGamePetIndex);
    RecalcAbilitys;
    SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
    SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
  end;
  if m_MyGamePet <> nil then
  begin
    // 将主人置空 2019-12-06 11:25:57
    m_MyGamePet.m_Master := nil;
    m_MyGamePet.MakeGhost;
    m_MyGamePet := nil;
    m_MyGamePetIndex := -1;
  end;
end;

procedure TPlayObject.ClientGamePetRetake(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 收回宠物
begin
  if (ProcessMsg.nParam2 = m_GamePetList.Count) and (ProcessMsg.nParam1 >= 0) and (ProcessMsg.nParam1 < m_GamePetList.Count) then
  begin
    DoGamePetRetake;
  end;
end;

procedure TPlayObject.ClientGamePetFree(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 放生宠物
var
  GamePetData: pTGamePetData;
begin
  if (ProcessMsg.nParam2 = m_GamePetList.Count) and (ProcessMsg.nParam1 >= 0) and (ProcessMsg.nParam1 < m_GamePetList.Count) then
  begin
    if (ProcessMsg.nParam1 >= 0) and (ProcessMsg.nParam1 < m_GamePetList.Count) then
    begin
      GamePetData := m_GamePetList.Items[ProcessMsg.nParam1];
      if (ProcessMsg.nParam1 = m_MyGamePetIndex) then
      begin
        if m_MyGamePet <> nil then
        begin
          {
            m_MyGamePet.m_Master := nil;
            m_MyGamePet.m_boGamePet := False;
            m_MyGamePet.RecalcAbilitys;
          }
          m_sMyGamePetName := m_MyGamePet.m_sCharName;
          // 将主人置空 2019-12-06 11:25:57
          m_MyGamePet.m_Master := nil;
          m_MyGamePet.MakeGhost;
          m_MyGamePet := nil;
          if g_FunctionNPC <> nil then
          begin
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@GamePetRetake', False);
          end;
        end;
        Dispose(GamePetData);
        m_GamePetList.Delete(ProcessMsg.nParam1);
        m_MyGamePetIndex := -1;
        m_LastMyGamePetIndex := -1;
        SendCurrentRecalGamePetIndex(m_MyGamePetIndex);
        RecalcAbilitys;
        SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
        SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
      end
      else
      begin
        Dispose(GamePetData);
        m_GamePetList.Delete(ProcessMsg.nParam1);
        if ProcessMsg.nParam1 < m_MyGamePetIndex then
        begin
          m_MyGamePetIndex := m_MyGamePetIndex - 1;
          m_LastMyGamePetIndex := m_MyGamePetIndex;
          SendCurrentRecalGamePetIndex(m_MyGamePetIndex);
        end;
      end;
      SendDelGamePet(ProcessMsg.nParam1);
    end;
  end;
end;

procedure TPlayObject.ClientPetUseItems(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 宠物吃药
// 解包物品扩展 chongchong 2014-05-15
  function GetUnbindItemInfo(nShape: Integer): PTUnbindItemInfo;
  var
    I: Integer;
    UnbindItemInfo: PTUnbindItemInfo;
  begin
    Result := nil;
    for I := 0 to g_UnbindList.Count - 1 do
    begin
      UnbindItemInfo := g_UnbindList.Items[I];
      if UnbindItemInfo.nShape = nShape then
      begin
        Result := g_UnbindList.Items[I];
        Break;
      end;
    end;
  end;
  function OverLapItems(StdItem: pTStdItem; wDura: Word): pTUserItem; // 叠加物品
  var
    I: Integer;
    UserItem: pTUserItem;
    pStdItem: pTStdItem;
  begin
    Result := nil;
    if CheckOverLapItem(StdItem) then
    begin
      wDura := wDura + 1;
      for I := 0 to m_GamePetBagItems.Count - 1 do
      begin
        UserItem := m_GamePetBagItems.Items[I];
        // 绑定物品不能和非绑定物品叠加到一起 chongchong 2014-09-26
        if not UserItem.boIsBind then
        begin
          pStdItem := UserEngine.GetStdItem(UserItem.wIndex);
          // MainOutMessage(Format('UserItem.Dura:%d UserItem.DuraMax:%d wDura:%d',[UserItem.Dura, UserItem.DuraMax, wDura]));
          if (pStdItem <> nil) and (pStdItem = StdItem) and (UserItem.Dura + wDura < UserItem.DuraMax) then
          begin
            UserItem.Dura := UserItem.Dura + wDura;
            SendUpdatePetItem(UserItem);
            Result := UserItem;
            Break;
          end;
        end;
      end;
    end;
  end;
  function GetUnBindItems(BindUserItem: pTUserItem; sItemName: string; nCount: Integer; IsDuraMax: Boolean): Boolean;
  var
    I: Integer;
    OverLapItem: pTUserItem;
    UserItem: pTUserItem;
    StdItem: pTStdItem;
    nDura: Integer;
  begin
    Result := False;
    StdItem := UserEngine.GetStdItem(sItemName);
    for I := 0 to nCount - 1 do
    begin
      if IsDuraMax then
        nDura := StdItem.DuraMax - 1
      else
        nDura := 0;
      if StdItem <> nil then
        OverLapItem := OverLapItems(StdItem, nDura)
      else
        OverLapItem := nil;
      if (OverLapItem = nil) then
      begin
        New(UserItem);
        if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
        begin
          UserItem.ItemFrom := BindUserItem.ItemFrom;
          if IsDuraMax then
            UserItem.Dura := UserItem.DuraMax - 1;
          m_GamePetBagItems.Add(UserItem);
          SendAddPetItem(UserItem);
          Result := True;
        end
        else
        begin
          Dispose(UserItem);
          Break;
        end;
      end;
    end;
  end;
  function FoundUserItem(UserItem: pTUserItem): Boolean;
  var
    I: Integer;
  begin
    Result := False;
    for I := 0 to m_GamePetBagItems.Count - 1 do
    begin
      if (UserItem = m_GamePetBagItems.Items[I]) then
      begin
        Result := True;
        Break;
      end;
    end;
  end;
  function MyGamePetEatItems(StdItem: pTStdItem): Boolean;
  begin
    Result := False;
    if m_PEnvir.m_boNODRUG then
    begin
      SysMsg(sCanotUseDrugOnThisMap, c_Red, t_Hint);
      Exit;
    end;
    case StdItem.Shape of
      1:
        begin
          m_MyGamePet.IncHealthSpell(StdItem.AC1, StdItem.MAC1);
          Result := True;
        end;
      2:
        begin
          m_boUserUnLockDurg := True;
          Result := True;
        end;
    else
      begin
        if (StdItem.AC1 > 0) then
        begin
          Inc(m_MyGamePet.m_nIncHealth, StdItem.AC1);
        end;
        if (StdItem.MAC1 > 0) then
        begin
          Inc(m_MyGamePet.m_nIncSpell, StdItem.MAC1);
        end;
        Result := True;
      end;
    end;
  end;

var
  I, MagicIndex: Integer;
  boEatOK: Boolean;
  boChangeDura: Boolean;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  UserItem34: TUserItem;
  OverLapStdItem: pTStdItem;
  OverLapItem: pTUserItem;
  nItemIdx: Integer;
  sItemName: string;
  dwUseIntervalTime: LongWord; // 物品使用时间间隔
  UnbindItemInfo: PTUnbindItemInfo;
  nCount, NeedBagCount: Integer;
  RetType: TGamePetAddMagicResultType;
begin
  if (m_MyGamePet = nil) or (m_MyGamePetIndex <> ProcessMsg.nParam2) then
  begin
    SendDefMessage(SM_PETUSEITEM_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  nItemIdx := ProcessMsg.nParam1;
  sItemName := ProcessMsg.sMsg;
  boEatOK := False;
  boChangeDura := False;
  for I := m_GamePetBagItems.Count - 1 downto 0 do
  begin
    if m_GamePetBagItems.Count <= 0 then
      Break;
    UserItem := m_GamePetBagItems.Items[I];
    if (UserItem = nil) or (UserItem.MakeIndex <> nItemIdx) then
      Continue;
    UserItem34 := UserItem^;
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem = nil then
      Continue;
    dwUseIntervalTime := g_Config.dwPetUseItemIntervalTime; // 非药品使用时间间隔
    if not((not m_MyGamePet.m_boDeath) and (MyGetTickCount - m_MyGamePet.m_dwClientUseItemsTick > dwUseIntervalTime) and
      (m_MyGamePet.m_WAbil.HP > 0)) then
    begin
      Break;
    end;
    m_MyGamePet.m_dwClientUseItemsTick := MyGetTickCount();
    case StdItem.StdMode of
      0:
        begin
          if CheckOverLapItem(StdItem) and (UserItem.Dura > 0) then
          begin
            if MyGamePetEatItems(StdItem) then
            begin
              UserItem.Dura := UserItem.Dura - 1;
              UserItem34 := UserItem^;
              boChangeDura := True;
              boEatOK := False;
            end;
          end
          else if MyGamePetEatItems(StdItem) then
          begin
            UserItem34 := UserItem^;
            m_GamePetBagItems.Delete(I);
            Dispose(UserItem);
            boEatOK := True;
          end;
          Break;
        end;
      49:
        begin // 聚灵珠
          if (UserItem.Dura >= UserItem.DuraMax) and ((StdItem.AC2 <= 0) or (m_MyGamePet.m_Abil.Level <= StdItem.AC2)) then
          begin
            case StdItem.AniCount of
              0:
                begin // 元宝提取经验
                  if m_nGameGold >= StdItem.Need then
                  begin
                    DecGameGold(StdItem.Need);
                    GameGoldChanged;
                    m_MyGamePet.IncGamePetExt(UserItem.DuraMax * 10000);
                    UserItem34 := UserItem^;
                    m_GamePetBagItems.Delete(I);
                    Dispose(UserItem);
                    boEatOK := True;
                  end
                  else
                  begin
                    boEatOK := False;
                    SysMsg(Format('%s不足无法释放%s的经验值！', [g_Config.sGameGoldName, StdItem.Name]), 255, 253, t_Hint);
                  end;
                end;
              1:
                begin // 金币提取经验
                  if m_nGold >= StdItem.Need then
                  begin
                    Dec(m_nGold, StdItem.Need);
                    GoldChanged;
                    m_MyGamePet.IncGamePetExt(UserItem.DuraMax * 10000);
                    m_GamePetBagItems.Delete(I);
                    UserItem34 := UserItem^;
                    Dispose(UserItem);
                    boEatOK := True;
                  end
                  else
                  begin
                    boEatOK := False;
                    SysMsg(Format('%s不足无法释放%s的经验值！', [sSTRING_GOLDNAME, StdItem.Name]), 255, 253, t_Hint);
                  end;
                end;
            else
              boEatOK := False;
            end;
          end
          else
          begin
            boEatOK := False;
            SysMsg(Format('宠物等级超过%s的释放等级！', [StdItem.Name]), 255, 253, t_Hint);
          end;
        end;
      31:
        begin // 解包物品
          UnbindItemInfo := GetUnbindItemInfo(StdItem.Shape);
          if (UnbindItemInfo <> nil) then
          begin
            OverLapStdItem := UserEngine.GetStdItem(UnbindItemInfo.sItemName);
            if (OverLapStdItem <> nil) and (UnbindItemInfo.nCount <= 0) then
              OverLapItem := OverLapItems(OverLapStdItem, 5)
            else
              OverLapItem := nil;
            if (OverLapItem <> nil) and (OverLapStdItem <> nil) then
            begin
              UserItem34 := UserItem^;
              m_GamePetBagItems.Delete(I);
              Dispose(UserItem);
              boEatOK := True;
            end
            else
            begin
              if UnbindItemInfo.nCount <= 0 then
                nCount := 6
              else
                nCount := UnbindItemInfo.nCount;
              NeedBagCount := nCount;
              if OverLapStdItem <> nil then
              begin
                if CheckOverLapItem(OverLapStdItem) then
                  NeedBagCount := (nCount + OverLapStdItem.DuraMax - 1) div OverLapStdItem.DuraMax
              end;
              if (m_GamePetBagItems.Count + NeedBagCount - 1) <= MAX_GAMEPET_BAG_COUNT then
              begin
                // 解包叠加物品时，一次只搞一个 chongchong 2016-03-22
                GetUnBindItems(UserItem, UnbindItemInfo.sItemName, nCount, False { UnbindItemInfo.nCount > 0 } );
                Dispose(UserItem);
                m_GamePetBagItems.Delete(I);
                boEatOK := True;
              end;
            end;
          end
          else
          begin
          end;
        end;
      93:
        begin
          if GetGamePetMagicCount >= MAX_GamePet_MAGIC_COUNT then
          begin
            boEatOK := False;
            SysMsg('最多只能学习8个技能！', 255, 253, t_Hint);
          end
          else
          begin
            RetType := GamePetAddMagic(UserItem.wIndex, StdItem.Name, MagicIndex, True);
            if RetType = gpr_OK then
            begin
              m_GamePetBagItems.Delete(I);
              SendSetPetMagic(m_MyGamePetIndex, MagicIndex, UserItem.wIndex);
              Dispose(UserItem);
              boEatOK := True;
              if (g_FunctionNPC <> nil) then
              begin
                m_nGamePetMagicID := UserItem.wIndex - 1;
                m_nGamePetMagicIndex := MagicIndex;
                m_sGamePetMagicName := StdItem.Name;
                g_FunctionNPC.GotoLable(Self, '@GamePetAddMagic', False);
                m_nGamePetMagicID := 0;
                m_nGamePetMagicIndex := 0;
                m_sGamePetMagicName := '';
              end;
              RecalcAbilitys;
              SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
              SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
            end
            else if RetType = gpr_Fail then
            begin
              boEatOK := False;
              SysMsg('该技能只能学一个！', 255, 253, t_Hint);
            end;
          end;
          Break;
        end;
    end;
    Break;
  end;
  if boEatOK then
  begin
    SendDefMessage(SM_PETUSEITEM_OK, 0, 0, 0, 0, '');
  end
  else
  begin
    if boChangeDura then
      SendDefMessage(SM_PETUSEITEM_FAIL, UserItem34.MakeIndex, UserItem34.Dura, UserItem34.DuraMax, 0, '')
    else
      SendDefMessage(SM_PETUSEITEM_FAIL, 0, 0, 0, 0, '');
  end;
end;

procedure TPlayObject.ClientBagItemToPetBag(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  sUserItemName: string;
  nItemIdx: Integer;
  sItemName: string;
  // StdItem: pTStdItem;
  // AddWeight: Integer;
begin
  if not g_Config.boOpenGamePet then
    Exit;
  if m_GamePetList.Count = 0 then
    Exit;
  nItemIdx := ProcessMsg.nParam1;
  sItemName := DecodeString(ProcessMsg.sMsg);
  if m_boOffLine or m_boGhost { or (m_MyGamePet = nil) } then
  begin
    SendDefMessage(SM_BAGITEMTOPETBAG_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  if IsEnoughPetBag then
  begin
    for I := 0 to m_ItemList.Count - 1 do
    begin
      UserItem := m_ItemList.Items[I];
      if UserItem.MakeIndex = nItemIdx then
      begin
        if g_ItemRules.Get(UserItem.wIndex, 31) then // 禁止宠物背包
        begin
          SysMsg('物品禁止放入宠物背包', c_Red, t_Hint);
          SendDefMessage(SM_BAGITEMTOPETBAG_FAIL, 0, 0, 0, 0, '');
          Exit;
        end;
        // 取自定义物品名称
        sUserItemName := '';
        if UserItem.btValue[13] = 1 then
          sUserItemName := UserItem.Name;
        if sUserItemName = '' then
          sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
        if CompareText(sUserItemName, sItemName) = 0 then
        begin
          m_ItemList.Delete(I);
          if AddItemToPetBag(UserItem) then
          begin
            WeightChanged;
            // THeroObject(m_MyHero).WeightChanged;
            SendDefMessage(SM_BAGITEMTOPETBAG_OK, 0, 0, 0, 0, '');
            Exit;
          end;
        end;
        Break;
      end;
    end;
  end;
  SendDefMessage(SM_BAGITEMTOPETBAG_FAIL, 0, 0, 0, 0, '');
end;

