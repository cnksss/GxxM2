procedure TPlayObject.DropUseItems(BaseObject: TBaseObject);
var
  I, DropWide, nDelCount: Integer;
  nRate, nNewRate, nDropUseItemsMaxCount: Integer;
  StdItem: pTStdItem;
  DelItems, sUserItemName: string;
  Castle: TUserCastle; // 攻城区域
  IsSendUseItems: Boolean;
  DropUserItem: TUserItem;
resourcestring
  sExceptionMsg = '[Exception] TPlayObject.DropUseItems';
begin
  DelItems := '';
  nDelCount := 0;
  try
    // 地图禁止死亡掉物品 piaoyun 2013-07-25
    if m_PEnvir.m_boNODROPITEM and (m_btRaceServer = RC_PLAYOBJECT) then
      Exit;

    if m_boAngryRing //
      or m_boNoDropUseItem //
      or m_PEnvir.m_boNODROPUSEITEMS //
      or (m_boDummyObject and (not m_boDropUseItem)) //
      or (m_btRaceServer <> RC_PLAYOBJECT) then
      Exit;

    // 攻城区域不掉装备 piaoyun 2013-07-25
    if g_Config.boWarNoDropUseItem and (m_btRaceServer = RC_PLAYOBJECT) then
    begin
      Castle := g_CastleManager.InCastleWarArea(Self);
      if (Castle <> nil) and Castle.m_boUnderWar { 攻城 } then
        Exit;
    end;

    IsSendUseItems := False;
    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      StdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
      { 当仅reserved值为 8 时，死亡时装备消失 }
      if (m_UseItems[I].wIndex > 0) and (StdItem <> nil) then
      begin
        if StdItem.Reserved and 8 <> 0 then
        begin
          DropUserItem := m_UseItems[I];
          if StdItem.NeedIdentify = 1 then
            AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[I].MakeIndex, '0', 0,
              StdItem.Reserved, '掉落-Reserved');
          m_UseItems[I].wIndex := 0;

          { chongchong 去掉特定装备后，删除特定技能 【2013-08-27】 }
          ProcessUseItemSkill(I, StdItem, False);
          IsSendUseItems := True;
          if (DropUserItem.btValue[13] = 1) and (DropUserItem.Name <> '') then
            sUserItemName := DropUserItem.Name
          else
            sUserItemName := StdItem.Name;

          m_nCurrentItemMakeIndex := DropUserItem.MakeIndex;
          m_nCurrentItemPos := I;
          m_sCurrentItemName := StdItem.Name;
          m_sCurrentItemNewName := sUserItemName;
          m_PickUpOrDropItem := DropUserItem;
          g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(I), False);
          g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
          m_PickUpOrDropItem.MakeIndex := 0;
          m_PickUpOrDropItem.wIndex := 0;
          m_nCurrentItemMakeIndex := 0;
          m_nCurrentItemPos := 0;
          m_sCurrentItemName := '';
          m_sCurrentItemNewName := '';
        end;
      end;
    end;

    if IsSendUseItems then
      SendUseItems;

    if m_boDummyObject then
      nRate := m_nDieDropUseItemRate
    else
    begin
      if PKLevel > 2 then
        nRate := g_Config.nDieRedDropUseItemRate { 15 }
      else
        nRate := g_Config.nDieDropUseItemRate { 30 };
    end;

    // 增加爆率
    if (not g_Config.boDropUseItem) and (m_CurrTarget <> nil) and (m_CurrTarget.m_WAbil.NewValue[6] > 0) then
      nRate := Max(nRate - nRate * m_CurrTarget.m_WAbil.NewValue[6] div 100, 0);

    nDropUseItemsMaxCount := 0;
    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      StdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
      if StdItem = nil then
        Continue;

      // 禁止爆出
      if (GetUserItemBindValue(@m_UseItems[I], ubNoScatter) //
        and m_UseItems[I].boIsBind) //
        or g_ItemRules.Get(m_UseItems[I].wIndex, 13) then
        Continue;

      // 死亡必爆 chongchong 2017-04-19
      if g_ItemRules.Get(m_UseItems[I].wIndex, 6) then
      begin
        StdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
        if StdItem <> nil then
        begin
          if StdItem.Reserved and 10 = 0 then
          begin
            DropUserItem := m_UseItems[I];
            DropWide := 2;
            if DropItemDown(@m_UseItems[I], DropWide, True, BaseObject, Self) then
            begin
              { -oCursor -c新增 : 角色死亡掉落触发 }
              if g_ItemRules.Get(m_UseItems[I].wIndex, 39) then
              begin
                m_sCurrentOperateUserName := m_sCharName;
                m_sCurrentItemName := ProcessItemName(StdItem.Name);
                try
                  g_FunctionNPC.GotoLable(Self, '@HumDropItem', False);
                finally
                  m_sCurrentOperateUserName := EmptyStr;
                  m_sCurrentItemName := EmptyStr;
                end;
              end;

              if (m_UseItems[I].btValue[13] = 1) and (m_UseItems[I].Name <> '') then
                DelItems := DelItems + Format('%s/%d/', [m_UseItems[I].Name, m_UseItems[I].MakeIndex])
              else
                DelItems := DelItems + Format('%s/%d/', [StdItem.Name, m_UseItems[I].MakeIndex]);

              m_UseItems[I].wIndex := 0;
              Inc(nDelCount);
            end;

            { chongchong 去掉特定装备后，删除特定技能 【2013-08-27】 }
            ProcessUseItemSkill(I, StdItem, False);
            if (DropUserItem.btValue[13] = 1) and (DropUserItem.Name <> '') then
              sUserItemName := DropUserItem.Name
            else
              sUserItemName := StdItem.Name;

            m_nCurrentItemMakeIndex := DropUserItem.MakeIndex;
            m_nCurrentItemPos := I;
            m_sCurrentItemName := StdItem.Name;
            m_sCurrentItemNewName := sUserItemName;
            m_PickUpOrDropItem := DropUserItem;
            g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(I), False);
            g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
          end;
        end;
        Continue;
      end;

      // 防暴几率 chongchong 2015-04-16
      if Random(100) < m_UseItems[I].btNewValue[12] then
        Continue;

      if g_Config.boDropUseItem then
      begin
        if PKLevel > 2 then
          nNewRate := Round(g_Config.DieDropUseItemRates[I] / (g_Config.nDieRedDropUseItemOneRate / 10))
        else
          nNewRate := g_Config.DieDropUseItemRates[I];
        nNewRate := nNewRate + nRate;
        // 增加爆率
        if (m_CurrTarget <> nil) and (m_CurrTarget.m_WAbil.NewValue[6] > 0) then
          nNewRate := Max(nNewRate - nNewRate * m_CurrTarget.m_WAbil.NewValue[6] div 100, 0);

        if (Random(nNewRate) <> 0) and (not g_ItemRules.Get(m_UseItems[I].wIndex, 6)) then
          Continue;
      end
      else if (Random(nRate) <> 0) and (not g_ItemRules.Get(m_UseItems[I].wIndex, 6)) then
        Continue;

      // 检查是否在禁止取下列表,如果在列表中则不掉此物品
      if InDisableTakeOffList(m_UseItems[I].wIndex) //
        or (GetUserItemBindValue(@m_UseItems[I], ubNoTakeOff) and m_UseItems[I].boIsBind) then
        Continue;

      if m_PEnvir.m_boDELDROPITEM then
      begin
        StdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
        if StdItem <> nil then
        begin
          if StdItem.Reserved and 10 = 0 then
          begin
            if m_UseItems[I].wInsuranceCount > 0 then
            begin
              Dec(m_UseItems[I].wInsuranceCount);
              SendUpdateItemInsuranceCount(I, m_UseItems[I].MakeIndex, False, m_UseItems[I].wInsuranceCount);
              m_sDropInsuranceItemName := StdItem.Name;
              m_nDropInsuranceItemCount := m_UseItems[I].wInsuranceCount;
              m_nDropInsuranceItemCurrency := StdItem.InsuranceCurrency;
              m_nDropInsuranceItemGold := StdItem.InsuranceGold;
              if (g_FunctionNPC <> nil) then
              begin
                m_nScriptGotoCount := 0;
                g_FunctionNPC.GotoLable(Self, '@DropInsuranceItem', False);
              end;
              Continue;
            end;

            DropUserItem := m_UseItems[I];
            m_UseItems[I].wIndex := 0;
            DelItems := DelItems + Format('%s/%d/', [StdItem.Name, m_UseItems[I].MakeIndex]);
            Inc(nDelCount);
            { chongchong 去掉特定装备后，删除特定技能 【2013-08-27】 }
            ProcessUseItemSkill(I, StdItem, False);
            if (DropUserItem.btValue[13] = 1) and (DropUserItem.Name <> '') then
              sUserItemName := DropUserItem.Name
            else
              sUserItemName := StdItem.Name;

            m_nCurrentItemMakeIndex := DropUserItem.MakeIndex;
            m_nCurrentItemPos := I;
            m_sCurrentItemName := StdItem.Name;
            m_sCurrentItemNewName := sUserItemName;
            m_PickUpOrDropItem := DropUserItem;
            g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(I), False);
            g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
          end;
        end;
      end
      else
      begin
        // 控制非红名人物死亡时最多掉落几件身上物品
        if (PKLevel <= 2) and (nDropUseItemsMaxCount >= g_Config.nDropUseItemsMaxCount) then
          Continue;

        if m_UseItems[I].wInsuranceCount > 0 then
        begin
          Inc(nDropUseItemsMaxCount);
          Dec(m_UseItems[I].wInsuranceCount);
          SendUpdateItemInsuranceCount(I, m_UseItems[I].MakeIndex, False, m_UseItems[I].wInsuranceCount);
          m_sDropInsuranceItemName := StdItem.Name;
          m_nDropInsuranceItemCount := m_UseItems[I].wInsuranceCount;
          m_nDropInsuranceItemCurrency := StdItem.InsuranceCurrency;
          m_nDropInsuranceItemGold := StdItem.InsuranceGold;
          if (g_FunctionNPC <> nil) then
          begin
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@DropInsuranceItem', False);
          end;
          Continue;
        end;

        if DropItemDown(@m_UseItems[I], 2, True, BaseObject, Self) then
        begin
          DropUserItem := m_UseItems[I];
          Inc(nDropUseItemsMaxCount);
          StdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
          if StdItem <> nil then
          begin
            if (StdItem.Reserved and 10 = 0) then
            begin
              { -oCursor -c新增 : 角色死亡掉落触发 }
              if g_ItemRules.Get(m_UseItems[I].wIndex, 39) then
              begin
                m_sCurrentOperateUserName := m_sCharName;
                m_sCurrentItemName := ProcessItemName(StdItem.Name);
                try
                  g_FunctionNPC.GotoLable(Self, '@HumDropItem', False);
                finally
                  m_sCurrentOperateUserName := EmptyStr;
                  m_sCurrentItemName := EmptyStr;
                end;
              end;

              if (m_UseItems[I].btValue[13] = 1) and (m_UseItems[I].Name <> '') then
                DelItems := DelItems + Format('%s/%d/', [m_UseItems[I].Name, m_UseItems[I].MakeIndex])
              else
                DelItems := DelItems + Format('%s/%d/', [StdItem.Name, m_UseItems[I].MakeIndex]);

              { chongchong 去掉特定装备后，删除特定技能 【2013-08-27】 }
              ProcessUseItemSkill(I, StdItem, False);
              m_UseItems[I].wIndex := 0;
              Inc(nDelCount);
            end;

            if (DropUserItem.btValue[13] = 1) and (DropUserItem.Name <> '') then
              sUserItemName := DropUserItem.Name
            else
              sUserItemName := StdItem.Name;

            m_nCurrentItemMakeIndex := DropUserItem.MakeIndex;
            m_nCurrentItemPos := I;
            m_sCurrentItemName := StdItem.Name;
            m_sCurrentItemNewName := sUserItemName;
            m_PickUpOrDropItem := DropUserItem;
            g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(I), False);
            g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            m_nCurrentItemMakeIndex := 0;
            m_nCurrentItemPos := 0;
            m_sCurrentItemName := '';
            m_sCurrentItemNewName := '';
          end;
        end;
      end;
    end;

    if DelItems <> '' then
      SendMsg(Self, RM_SENDDELITEMLIST, 0, nDelCount, 0, 0, DelItems);
  except
    MainOutMessage(sExceptionMsg);
  end;
end;

