procedure TPlayObject.SendUpgradeItem();
var
  ClientItem: TClientItem;
  StdItem: pTStdItem;
begin
  if m_UpgradeItem <> nil then
  begin
    StdItem := UserEngine.GetStdItem(m_UpgradeItem.wIndex);
    if StdItem <> nil then
    begin
      UserItemToClientItem(m_UpgradeItem, StdItem, @ClientItem, True, True);
      m_DefMsg := MakeDefaultMsg(SM_UPGRADEDLGITEM_GIVE, 0, 0, 0, 0);
      SendSocketEx(@m_DefMsg, @ClientItem, SizeOf(TClientItem));
    end
    else
    begin
      m_DefMsg := MakeDefaultMsg(SM_UPGRADEDLGITEM_GIVE, 0, 0, 0, 0);
      SendSocket(@m_DefMsg, '');
    end;
  end;
end;

procedure TPlayObject.DoQueryBagItems(NoMove1_6: Boolean);
var
  I, nCount: Integer;
  sSendMsg: AnsiString;
  ClientItem: pTClientItem;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  InBuf: PAnsiChar;
  CurPage: Byte;
begin
  sSendMsg := '';
  // 摆摊中有物品不让刷新 chongchong 2015-05-27
  if m_HeroM2ShopList.Count > 0 then
    Exit;

  // 刷新包裹清OK框物品 chongchong 2015-05-27
  FillChar(m_ItemBoxItems, SizeOf(m_ItemBoxItems), #0);
  m_ItemBoxAddIndex := -1;
  nCount := 0;
  CurPage := 0;
  if (MyGetTickCount - m_dwQueryBagItemsTick > 3000) or (not m_boQueryBagItemsOK) then
  begin
    m_dwQueryBagItemsTick := MyGetTickCount;
    GetMem(InBuf, m_ItemList.Count * SizeOf(TClientItem));
    try
      ClientItem := pTClientItem(InBuf);
      for I := 0 to m_ItemList.Count - 1 do
      begin
        UserItem := m_ItemList.Items[I];
        if (UserItem = nil) or (UserItem = m_UpgradeItem) then
          Continue;
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          Inc(nCount);
          UserItemToClientItem(UserItem, StdItem, ClientItem, True, True);
          Inc(ClientItem);
        end;
      end;
      sSendMsg := zLibCompressBuffer(InBuf, nCount * SizeOf(TClientItem));
    finally
      FreeMem(InBuf);
    end;

    m_DefMsg := MakeDefaultMsg(SM_BAGITEMS, MakeLong(MakeWord(Byte(NoMove1_6), m_btExtBagOpenItemCount),
      MakeWord(CurPage, m_btExtBagPageCount)), Length(sSendMsg), 0, nCount);
    SendSocket(@m_DefMsg, sSendMsg);
    if not m_boQueryBagItemsOK then
      m_boQueryBagItemsOK := True
    else if g_Config.boShowRefreshBagMsg then
      SysMsg('包裹刷新成功.', 255, 253, t_Hint);
  end
  else if g_Config.boShowRefreshBagMsg then
    SysMsg('操作过于频繁，请稍后在试.', 255, 253, t_Hint);

  if not m_boQueryBagItemsOK then
    m_boQueryBagItemsOK := True;
end;

