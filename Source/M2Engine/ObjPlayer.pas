                    nTempValue := MakeLong(UserItem.btNewValue[1], UserItem.btNewValue[12]);
                    if nTempValue <> GamePetData.MP then
                      GamePetData.MP := nTempValue;
                    m_GamePetList.Add(GamePetData);
                    SendAddGamePet(GamePetData);
                    if g_FunctionNPC <> nil then
                    begin
                      m_nScriptGotoCount := 0;
                      m_nBagItemMakeIndex := UserItem.MakeIndex;
                      m_sBagItemName := UserItem.Name;
                      g_FunctionNPC.GotoLable(Self, '@EggToPet', False);
                      m_nBagItemMakeIndex := 0;
                      m_sBagItemName := '';
                    end;
                    UserItem34 := UserItem^;
                    m_ItemList.Delete(I);
                    Dispose(UserItem);
                    boEatOK := True;
                  end;
                end
                else
                begin
                  boEatOK := False;
                  SysMsg('你的宠物已经达到最大数量，请先回收一个到包裹', 255, 253, t_Hint);
                end;
              end
              else
              begin
                boEatOK := False;
                SysMsg('未找到对应的怪物', 255, 253, t_Hint);
              end;
            end;
          93:
            begin
              if m_MyGamePet <> nil then
              begin
                if GetGamePetMagicCount >= MAX_GamePet_MAGIC_COUNT then
                begin
                  boEatOK := False;
                  SysMsg('最多只能学习8个技能！', 255, 253, t_Hint);
                end
                else
                begin
                  RetType := GamePetAddMagic(UserItem.wIndex, StdItem.Name, MagicIndex, True);
                  if RetType = gpr_OK then
                  begin
                    UserItem34 := UserItem^;
                    SendSetPetMagic(m_MyGamePetIndex, MagicIndex, UserItem.wIndex);
                    m_ItemList.Delete(I);
                    Dispose(UserItem);
                    boEatOK := True;
                    if (g_FunctionNPC <> nil) then
                    begin
                      m_nGamePetMagicID := UserItem34.wIndex - 1;
                      m_nGamePetMagicIndex := MagicIndex;
                      m_sGamePetMagicName := StdItem.Name;
                      g_FunctionNPC.GotoLable(Self, '@GamePetAddMagic', False);
                      m_nGamePetMagicID := 0;
                      m_nGamePetMagicIndex := 0;
                      m_sGamePetMagicName := '';
                    end;
                    RecalcAbilitys;
                    SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
                    SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
                  end
                  else if RetType = gpr_Fail then
                  begin
                    boEatOK := False;
                    SysMsg('该技能只能学一个！', 255, 253, t_Hint);
                  end;
                end;
              end
              else
              begin
                boEatOK := False;
                SysMsg('先召唤宠物才能学习宠物技能', 255, 253, t_Hint);
              end;
            end;
          {
            95:
            begin
            if ProcessMsg.wIdent = CM_EAT then
            begin
            if ProcessMsg.wParam = 0 then
            begin
            TargetID := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
            TargetX := 0;
            TargetY := 0;
            end
            else
            begin
            TargetID := 0;
            TargetX := ProcessMsg.nParam2;
            TargetY := ProcessMsg.nParam3;
            end;
            if EatAttackItem(StdItem, UserItem, TBaseObject(TargetID), TargetX, TargetY) then
            begin
            if UserItem.Dura >= 1000 then
            begin
            Dec(UserItem.Dura, 1000);
            end
            else
            begin
            UserItem.Dura := 0;
            end;
            if UserItem.Dura <= 0 then
            begin
            m_ItemList.Delete(I);
            Dispose(UserItem);
            boEatOK := True;
            end
            else
            begin
            UserItem34 := UserItem^;
            boChangeDura := True;
            end;
            end;
            end;
            end;
          }
          // 祝福罐 chongchong 2017-07-08
          96:
            begin
              nError := 900;
              if StdItem.Horse = 0 then
              begin
                if UserItem.DuraMax < 1000 then
                begin
                  UserItem34 := UserItem^;
                  m_ItemList.Delete(I);
                  Dispose(UserItem);
                  boEatOK := True;
                end
                else if (UserItem.Dura >= 1000) and (m_ItemList.Count + 1 <= GetMaxBagCount) then
                begin
                  Dec(UserItem.Dura, 1000);
                  Dec(UserItem.DuraMax, 1000); // 20080324 减少存物品数量
                  if UserItem.DuraMax <= 0 then
                  begin
                    UserItem34 := UserItem^;
                    m_ItemList.Delete(I);
                    Dispose(UserItem);
                    boEatOK := True;
                  end
                  else
                  begin
                    boChangeDura := True;
                  end;
                  UserItem34 := UserItem^;
                  // 需要修改UnbindList.txt,加入 祝福油  20071229  3---为 祝福罐的外观值
                  // 解包叠加物品时，一次只搞一个 chongchong 2016-03-22
                  UnbindItemInfo := GetUnbindItemInfo(StdItem.Shape);
                  if UnbindItemInfo <> nil then
                  begin
                    GetUnBindItems(UserItem, UnbindItemInfo.sItemName, 1, False { UnbindItemInfo.nCount > 0 } );
                  end;
                end;
              end
              else
              begin
                if (UserItem.Dura >= 1000) and (m_ItemList.Count + 1 <= GetMaxBagCount) then
                begin
                  Dec(UserItem.Dura, 1000);
                  boChangeDura := True;
                  UserItem34 := UserItem^;
                  // 需要修改UnbindList.txt,加入 祝福油  20071229  3---为 祝福罐的外观值
                  // 解包叠加物品时，一次只搞一个 chongchong 2016-03-22
                  UnbindItemInfo := GetUnbindItemInfo(StdItem.Shape);
                  if UnbindItemInfo <> nil then
                  begin
                    GetUnBindItems(UserItem, UnbindItemInfo.sItemName, 1, False { UnbindItemInfo.nCount > 0 } );
                  end;
                end;
              end;
            end;
        end;
        Break;
      end;
    end;
    nError := 1000;
    if boEatOK then
    begin
      WeightChanged();
      // SendMsg(Self, RM_EAT_OK, 0, 0, 0, 0, '');
      if ProcessMsg.wIdent = CM_EAT then
        SendDefMessage(SM_EAT_OK, nMakeIndex, 0, 0, 0, '')
      else
        SendDefMessage(SM_AUTOEAT_OK, nMakeIndex, 0, 0, 0, '');
      if StdItem.NeedIdentify = 1 then
      begin
        AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, UserItem34.MakeIndex, '0', 0, 0, '物品用完');
      end;
    end
    else
    begin
      if boChangeDura then
      begin
        if ProcessMsg.wIdent = CM_EAT then
          SendDefMessage(SM_EAT_FAIL, UserItem34.MakeIndex, UserItem34.Dura, UserItem34.DuraMax,
            MakeWord(Integer(boChangeWeight), NewWeight), '')
        else
          SendDefMessage(SM_AUTOEAT_FAIL, UserItem34.MakeIndex, UserItem34.Dura, UserItem34.DuraMax,
            MakeWord(Integer(boChangeWeight), NewWeight), '');
      end
      else
      begin
        if ProcessMsg.wIdent = CM_EAT then
          SendDefMessage(SM_EAT_FAIL, 0, 0, 0, 0, '')
        else
          SendDefMessage(SM_AUTOEAT_FAIL, 0, 0, 0, 0, '');
      end;
    end;
    nError := 1001;
  except
    MainOutMessage(Format(sExceptionMsg1, [nError]));
  end;
end;

procedure TPlayObject.ClientMagicKeyChange(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserMagic: pTUserMagic;
  nSkillIdx, nKey: Integer;
  MagicAttr: TMagicAttr;
begin
  nSkillIdx := ProcessMsg.nParam1;
  nKey := ProcessMsg.nParam2;
  MagicAttr := TMagicAttr(ProcessMsg.wParam);
  for I := 0 to m_MagicList.Count - 1 do
  begin
    UserMagic := m_MagicList.Items[I];
    if (UserMagic.MagicInfo.wMagicId = nSkillIdx) and (UserMagic.MagicAttr = MagicAttr) then
    begin
      if MagicAttr in [mtDefense, mtAttack] then
      begin
        if UserMagic.btKey = 0 then
          UserMagic.btKey := VK_F1
        else
          UserMagic.btKey := 0;
      end
      else
        UserMagic.btKey := nKey;
      Break;
    end;
  end;
end;

procedure TPlayObject.ClientClickNpc(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  NPC: NativeInt; // integer //HZQ 修复64位模式下NPC点击无反应的问题
  NormNpc: TNormNpc;
begin
  NPC := ProcessMsg.nParam1;
  if not m_boCanDeal then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotTryDealMsg);
    Exit;
  end;
  if { m_boDeath or } m_boGhost then
    Exit;
  NormNpc := UserEngine.FindMerchant(TObject(NPC));
  if NormNpc = nil then
    NormNpc := UserEngine.FindNPC(TObject(NPC));
