procedure TPlayObject.ClientGroupMode(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  procedure ClientGroupClose;
  begin
    if m_GroupOwner = nil then
    begin
      m_boAllowGroup := False;
      Exit;
    end;
    if m_GroupOwner <> Self then
    begin
      m_GroupOwner.DelGroupMember(Self);
      m_boAllowGroup := False;
      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@GroupClose', False);
      end;
    end
    else
    begin
      SysMsg('如果你想退出，使用编组功能（删除按钮）', c_Red, t_Hint);
    end;
  end;

begin
  if ProcessMsg.nParam2 = 0 then
    ClientGroupClose()
  else
    m_boAllowGroup := True;
  if m_boAllowGroup then
    SendDefMessage(SM_GROUPMODECHANGED, 0, 1, 0, 0, '')
  else
    SendDefMessage(SM_GROUPMODECHANGED, 0, 0, 0, 0, '');
end;

procedure TPlayObject.ClientCreateGroup(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  GroupObject: TPlayObject;
  sHumName: string;
begin
  sHumName := Trim(ProcessMsg.sMsg);
  if m_boDeath then
  begin
    SendDefMessage(SM_CREATEGROUP_FAIL, -1, 0, 0, 0, '');
    Exit;
  end;
  GroupObject := UserEngine.GetPlayObject(sHumName);
  if m_GroupOwner <> nil then
  begin
    SendDefMessage(SM_CREATEGROUP_FAIL, -1, 0, 0, 0, '');
    Exit;
  end;
  if (GroupObject = nil) or (GroupObject = Self) or GroupObject.m_boDeath or GroupObject.m_boGhost then
  begin
    SendDefMessage(SM_CREATEGROUP_FAIL, -2, 0, 0, 0, '');
    Exit;
  end;
  if (GroupObject.m_GroupOwner <> nil) then
  begin
    SendDefMessage(SM_CREATEGROUP_FAIL, -3, 0, 0, 0, '');
    Exit;
  end;
  if (not GroupObject.m_boAllowGroup) then
  begin
    SendDefMessage(SM_CREATEGROUP_FAIL, -4, 0, 0, 0, '');
    Exit;
  end;
  if (g_Config.boNationGroupCheck) then
  begin
    if m_btNation <> GroupObject.m_btNation then
    begin
      SendDefMessage(SM_CREATEGROUP_FAIL, -5, 0, 0, 0, '');
      Exit;
    end;
  end;
  m_boAllowStartGroup := True;
  if g_FunctionNPC <> nil then
  begin
    m_nScriptGotoCount := 0;
    g_FunctionNPC.GotoLable(Self, '@StartGroup', False);
  end;
  if not m_boAllowStartGroup then
    Exit;
  if g_Config.boGroupUseOldMode then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      m_GroupMembers.LockW(45);
    try
{$IFEND}
      m_GroupMembers.Clear;
      m_GroupMembers.AddObject(m_sCharName, Self);
      m_GroupMembers.AddObject(sHumName, GroupObject);
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        m_GroupMembers.UnLockW;
    end;
{$IFEND}
    JoinGroup(Self);
    GroupObject.JoinGroup(Self);
    m_boAllowGroup := True;
    SendDefMessage(SM_CREATEGROUP_OK, 0, 0, 0, 0, '');
    SendGroupMembers();
    if g_FunctionNPC <> nil then
    begin
      m_sString[0] := sHumName;
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@GroupCreate', False);
    end;
  end
  else
  begin
    if m_sInviteGroupHuman.IndexOf(GroupObject.m_sCharName) >= 0 then
    begin
      SysMsg('已向 ' + GroupObject.m_sCharName + ' 发送过组队邀请', c_Red, t_System);
      Exit;
    end
    else
    begin
      m_sInviteGroupHuman.AddObject(GroupObject.m_sCharName, TObject(MyGetTickCount));
      m_DefMsg := MakeDefaultMsg(SM_REQUEST_GORUP_JOIN, 0, 0, 0, 0);
      GroupObject.SendSocket(@m_DefMsg, EncodeString(m_sCharName));
    end;
  end;
end;

procedure TPlayObject.ClientAddGroupMember(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  MemberObject: TPlayObject;
  sHumName: string;
begin
  sHumName := Trim(ProcessMsg.sMsg);
  if m_boDeath then
  begin
    SendDefMessage(SM_GROUPADDMEM_FAIL, -1, 0, 0, 0, '');
    Exit;
  end;
  MemberObject := UserEngine.GetPlayObject(sHumName);
  if m_GroupOwner <> Self then
  begin
    SendDefMessage(SM_GROUPADDMEM_FAIL, -1, 0, 0, 0, '');
    Exit;
  end;
  if m_GroupMembers.Count > g_Config.nGroupMembersMax then
  begin
    SendDefMessage(SM_GROUPADDMEM_FAIL, -5, 0, 0, 0, '');
    Exit;
  end;
  if (MemberObject = nil) or (MemberObject = Self) or MemberObject.m_boDeath or MemberObject.m_boGhost then
  begin
    SendDefMessage(SM_GROUPADDMEM_FAIL, -2, 0, 0, 0, '');
    Exit;
  end;
  if (MemberObject.m_GroupOwner <> nil) then
  begin
    SendDefMessage(SM_GROUPADDMEM_FAIL, -3, 0, 0, 0, '');
    Exit;
  end;
  if (not MemberObject.m_boAllowGroup) then
  begin
    SendDefMessage(SM_GROUPADDMEM_FAIL, -4, 0, 0, 0, '');
    Exit;
  end;
  if IsGroupMember(MemberObject) then
  begin
    SendDefMessage(SM_GROUPADDMEM_FAIL, -3, 0, 0, 0, '');
    Exit;
  end;
  if (g_Config.boNationGroupCheck) then
  begin
    if m_btNation <> MemberObject.m_btNation then
    begin
      SendDefMessage(SM_GROUPADDMEM_FAIL, -6, 0, 0, 0, '');
      Exit;
    end;
  end;
  if g_Config.boGroupUseOldMode then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      m_GroupMembers.LockW(46);
    try
{$IFEND}
      m_GroupMembers.AddObject(sHumName, MemberObject);
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        m_GroupMembers.UnLockW;
    end;
{$IFEND}
    MemberObject.JoinGroup(Self);
    SendDefMessage(SM_GROUPADDMEM_OK, 0, 0, 0, 0, '');
    SendGroupMembers();
    if (g_FunctionNPC <> nil) then
    begin
      m_sString[0] := sHumName;
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@GroupAddMember', False);
    end;
  end
  else
  begin
    if m_sInviteGroupHuman.IndexOf(MemberObject.m_sCharName) >= 0 then
    begin
      SysMsg('已向 ' + MemberObject.m_sCharName + ' 发送过组队邀请', c_Red, t_System);
      Exit;
    end
    else
    begin
      m_sInviteGroupHuman.AddObject(MemberObject.m_sCharName, TObject(MyGetTickCount));
      m_DefMsg := MakeDefaultMsg(SM_REQUEST_GORUP_JOIN, 0, 0, 0, 0);
      MemberObject.SendSocket(@m_DefMsg, EncodeString(m_sCharName));
    end;
  end;
end;

procedure TPlayObject.ClientDelGroupMember(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  MemberObject: TPlayObject;
  sHumName: string;
begin
  sHumName := Trim(ProcessMsg.sMsg);
  MemberObject := UserEngine.GetPlayObject(sHumName);
  if m_GroupOwner <> Self then
  begin
    SendDefMessage(SM_GROUPDELMEM_FAIL, -1, 0, 0, 0, '');
    Exit;
  end;
  if MemberObject = nil then
  begin
    SendDefMessage(SM_GROUPDELMEM_FAIL, -2, 0, 0, 0, '');
    Exit;
  end;
  if not IsGroupMember(MemberObject) then
  begin
    SendDefMessage(SM_GROUPDELMEM_FAIL, -3, 0, 0, 0, '');
    Exit;
  end;
  DelGroupMember(MemberObject);
  SendDefMessage(SM_GROUPDELMEM_OK, 0, 0, 0, 0, sHumName);
  if (g_FunctionNPC <> nil) then
  begin
    m_sString[0] := sHumName;
    m_nScriptGotoCount := 0;
    g_FunctionNPC.GotoLable(Self, '@GroupDelMember', False);
  end;
end;

