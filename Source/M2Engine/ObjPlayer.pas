  end;
  procedure DecMyGameMoney(MakeIndex, nCurrencyType, Prices: LongWord; IsBuyed: Boolean);
  var
    nValue: Integer;
  begin
    case nCurrencyType of
      0:
        begin
          m_nGameGold := m_nGameGold - Prices;
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            if IsBuyed then
              AddGameDataLog(LOG_ItemBuyPrice, LOG_GameGoldChange, Self, g_Config.sGameGoldName, MakeIndex, '拍卖行', m_nGameGold,
                -Prices, '竞拍成功')
            else
              AddGameDataLog(LOG_GameGoldChange, LOG_ActionNone, Self, g_Config.sGameGoldName, MakeIndex, '拍卖行', m_nGameGold,
                -Prices, '竞拍扣费');
          end;
        end;
      1:
        begin
          m_nGamePoint := m_nGamePoint - Prices;
          GameGoldChanged;
          if g_boGameLogGamePoint then
          begin
            if IsBuyed then
              AddGameDataLog(LOG_ItemBuyPrice, LOG_GamePointChange, Self, g_Config.sGamePointName, MakeIndex, '拍卖行', m_nGamePoint,
                -Prices, '竞拍成功')
            else
              AddGameDataLog(LOG_GamePointChange, LOG_ActionNone, Self, g_Config.sGamePointName, MakeIndex, '拍卖行', m_nGamePoint,
                -Prices, '竞拍扣费');
          end;
        end;
      2:
        begin
          m_nGold := m_nGold - Prices;
          GoldChanged();
          if g_boGameLogGold then
          begin
            if IsBuyed then
              AddGameDataLog(LOG_ItemBuyPrice, LOG_GoldChange, Self, sSTRING_GOLDNAME, MakeIndex, '拍卖行', m_nGold, -Prices, '竞拍成功')
            else
              AddGameDataLog(LOG_GoldChange, LOG_ActionNone, Self, sSTRING_GOLDNAME, MakeIndex, '拍卖行', m_nGold, -Prices, '竞拍扣费');
          end;
        end;
      3:
        begin
          m_nGameDiamond := m_nGameDiamond - Prices;
          NewGamePointChanged;
          if g_boGameLogGameGold then
          begin
            if IsBuyed then
              AddGameDataLog(LOG_ItemBuyPrice, LOG_GameDiamondChange, Self, g_Config.sGameDiamondName, MakeIndex, '拍卖行',
                m_nGameDiamond, -Prices, '竞拍成功')
            else
              AddGameDataLog(LOG_GameDiamondChange, LOG_ActionNone, Self, g_Config.sGameDiamondName, MakeIndex, '拍卖行',
                m_nGameDiamond, -Prices, '竞拍扣费');
          end;
        end;
      4:
        begin
          m_nGameGird := m_nGameGird - Prices;
          NewGamePointChanged;
          if g_boGameLogGameGold then
          begin
            if IsBuyed then
              AddGameDataLog(LOG_ItemBuyPrice, LOG_GameGirdChange, Self, g_Config.sGameGirdName, MakeIndex, '拍卖行', m_nGameGird,
                -Prices, '竞拍成功')
            else
              AddGameDataLog(LOG_GameGirdChange, LOG_ActionNone, Self, g_Config.sGameGirdName, MakeIndex, '拍卖行', m_nGameGird,
                -Prices, '竞拍扣费');
          end;
        end;
    else
      DecMoney(nCurrencyType - 5, Prices, nValue);
    end;
  end;

var
  nPrices: LongWord;
  StdItem: pTStdItem;
  Player: TPlayObject;
  nAuctionTaxRate: Integer;
  AuctionRecord: TAuctionRecord;
begin
  if g_OnlineMsgControl.boDisableBuy then
    Exit;

  if not g_M2DataDB.AuctionDB.GetAuctionRecord(ProcessMsg.nParam1, AuctionRecord) then
  begin
    m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 1, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
      AuctionRecord.CurrencyType);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  if AuctionRecord.TradingStatus <> 0 then
  begin
    m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 2, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
      AuctionRecord.CurrencyType);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  if SameText(AuctionRecord.HumanName, m_sCharName) then
  begin
    m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 3, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
      AuctionRecord.CurrencyType);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  // 不允许拍卖
  StdItem := UserEngine.GetStdItem(AuctionRecord.ActionItem.wIndex);
  if (StdItem <> nil) and (not g_ItemRules.Get(AuctionRecord.ActionItem.wIndex, 27)) then
  begin
    m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 4, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
      AuctionRecord.CurrencyType);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  if m_PEnvir.m_boNoAuction then
  begin
    m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 8, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
      AuctionRecord.CurrencyType);
    SendSocket(@m_DefMsg, '');
    Exit;
  end;

  // 购买之前触发 Cursor 2023-06-05 19:12:45
  g_FunctionNPC.GotoLable(Self, '@BeginAuctionBuy', False);
  if not m_boAuctionEnabled then
  begin
    m_boAuctionEnabled := True;
    Exit;
  end;

  if ProcessMsg.wIdent = CM_AuctionItemBid then
  begin
    nPrices := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
    if nPrices < AuctionRecord.StartingPrice then
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 5, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
        AuctionRecord.CurrencyType);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if nPrices <= AuctionRecord.LastBidPrice then
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 6, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
        AuctionRecord.CurrencyType);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;
  end
  else
    nPrices := AuctionRecord.SellingPrice;

  if nPrices >= AuctionRecord.SellingPrice then
  begin
    // 一口价购买了物品
    if not CheckGameMoney(AuctionRecord.CurrencyType, AuctionRecord.SellingPrice) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 7, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
        AuctionRecord.CurrencyType);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if g_M2DataDB.AuctionDB.JoinItemBid(m_sCharName, ProcessMsg.nParam1, AuctionRecord.SellingPrice, True) then
    begin
      // 退前面竞拍人的钱
      if (Length(AuctionRecord.LastBidder) > 0) and (AuctionRecord.LastBidPrice > 0) then
      begin
        IncPlayerGameMoney(AuctionRecord.LastBidder, AuctionRecord.ActionItem.MakeIndex, AuctionRecord.CurrencyType,
          AuctionRecord.LastBidPrice, False, Player);

        if (Player <> nil) and (Player <> Self) and (g_FunctionNPC <> nil) then
        begin
          Player.m_nScriptGotoCount := 0;

          if StdItem <> nil then
            Player.m_sAuctionItemName := StdItem.Name
          else
            Player.m_sAuctionItemName := '';

          Player.m_sAuctionItemHumanName := AuctionRecord.HumanName; // 物品拍卖者
          Player.m_sAuctionItemBidHumanName := m_sCharName; // 竞拍出价者
          Player.m_nAuctionItemStartPrice := AuctionRecord.StartingPrice; // 底价
          Player.m_nAuctionItemSellPrice := AuctionRecord.SellingPrice; // 一口价
          Player.m_nAuctionItemInvalidPrice := AuctionRecord.LastBidPrice; // 失效价格 (我的出价)
          Player.m_nAuctionItemFinaPrice := nPrices; // 成交价 (最新出价)
          Player.m_nAuctionItemMoneyType := AuctionRecord.CurrencyType; // 货币类型
          Player.m_boAuctionItemSelled := True; // 物品是否被秒杀/出售
          g_FunctionNPC.GotoLable(Player, '@AuctionInvalidItem', False);
          Player.m_sAuctionItemName := '';
          Player.m_sAuctionItemHumanName := ''; // 物品拍卖者
          Player.m_sAuctionItemBidHumanName := ''; // 竞拍出价者
          Player.m_nAuctionItemStartPrice := 0; // 底价
          Player.m_nAuctionItemSellPrice := 0; // 一口价
          Player.m_nAuctionItemInvalidPrice := 0; // 失效价
          Player.m_nAuctionItemFinaPrice := 0; // 成交价
          Player.m_nAuctionItemMoneyType := 0; // 货币类型
          Player.m_boAuctionItemSelled := False; // 物品是否被秒杀/出售
        end;
      end;

      if StdItem.NeedIdentify = 1 then
        AddGameDataLog(LOG_ItemSell, LOG_ActionNone, latHuman, m_sMapName, m_nCurrX, m_nCurrY, StdItem.Name,
          AuctionRecord.ActionItem.MakeIndex, AuctionRecord.HumanName, '拍卖行', 0, 0, '买入:' + m_sCharName);

      // 加拍卖者的钱
      case AuctionRecord.CurrencyType of
        0:
          nAuctionTaxRate := g_Config.dwAuctionGameGoldTaxRate; // 元宝
        1:
          nAuctionTaxRate := g_Config.dwAuctionGamePointTaxRate; // 游戏点
        2:
          nAuctionTaxRate := g_Config.dwAuctionGoldTaxRate; // 金币
        3:
          nAuctionTaxRate := g_Config.dwAuctionGameDiamondTaxRate; // 金刚石
        4:
          nAuctionTaxRate := g_Config.dwAuctionGameGirdTaxRate; // 灵符
      else
        nAuctionTaxRate := 0; // 自定义货币拍卖行收税 By 一支笔 at:2022-03-10 21:43:53
      end;

      nPrices := AuctionRecord.SellingPrice - Round((AuctionRecord.SellingPrice / 100 * nAuctionTaxRate));
      IncPlayerGameMoney(AuctionRecord.HumanName, AuctionRecord.ActionItem.MakeIndex, AuctionRecord.CurrencyType, nPrices,
        True, Player);

      if StdItem.NeedIdentify = 1 then
        AddGameDataLog(LOG_ItemBuy, LOG_ActionNone, Self, StdItem.Name, AuctionRecord.ActionItem.MakeIndex, '拍卖行', 0, 0,
          '待取回, 卖出:' + AuctionRecord.HumanName);

      // 减自己的钱
      DecMyGameMoney(AuctionRecord.ActionItem.MakeIndex, AuctionRecord.CurrencyType, AuctionRecord.SellingPrice, True);
      if (g_FunctionNPC <> nil) then
      begin
        Player := UserEngine.GetPlayObject(AuctionRecord.HumanName);
        if (Player <> nil) then
        begin
          Player.m_nScriptGotoCount := 0;
          if StdItem <> nil then
            Player.m_sAuctionItemName := StdItem.Name
          else
            Player.m_sAuctionItemName := '';

          Player.m_sAuctionItemHumanName := AuctionRecord.HumanName; // 物品拍卖者
          Player.m_sAuctionItemBidHumanName := m_sCharName; // 竞拍出价者
          Player.m_nAuctionItemStartPrice := AuctionRecord.StartingPrice; // 底价
          Player.m_nAuctionItemSellPrice := AuctionRecord.SellingPrice; // 一口价
          Player.m_nAuctionItemInvalidPrice := 0; // 失效价
          Player.m_nAuctionItemFinaPrice := AuctionRecord.SellingPrice; // 成交价
          Player.m_nAuctionItemMoneyType := AuctionRecord.CurrencyType; // 货币类型
          Player.m_boAuctionItemSelled := True; // 物品是否被秒杀/出售
          g_FunctionNPC.GotoLable(Player, '@AuctionSellItem', False);
          Player.m_sAuctionItemName := '';
          Player.m_sAuctionItemHumanName := ''; // 物品拍卖者
          Player.m_sAuctionItemBidHumanName := ''; // 竞拍出价者
          Player.m_nAuctionItemStartPrice := 0; // 底价
          Player.m_nAuctionItemSellPrice := 0; // 一口价
          Player.m_nAuctionItemInvalidPrice := 0; // 失效价
          Player.m_nAuctionItemFinaPrice := 0; // 成交价
          Player.m_nAuctionItemMoneyType := 0; // 货币类型
          Player.m_boAuctionItemSelled := False; // 物品是否被秒杀/出售
        end;

        m_nScriptGotoCount := 0;
        if StdItem <> nil then
          m_sAuctionItemName := StdItem.Name
        else
          m_sAuctionItemName := '';

        m_sAuctionItemHumanName := AuctionRecord.HumanName; // 物品拍卖者
        m_sAuctionItemBidHumanName := m_sCharName; // 竞拍出价者
        m_nAuctionItemStartPrice := AuctionRecord.StartingPrice; // 底价
        m_nAuctionItemSellPrice := AuctionRecord.SellingPrice; // 一口价
        m_nAuctionItemInvalidPrice := 0; // 失效价
        m_nAuctionItemFinaPrice := AuctionRecord.SellingPrice; // 成交价
        m_nAuctionItemMoneyType := AuctionRecord.CurrencyType; // 货币类型
        m_boAuctionItemSelled := True; // 物品是否被秒杀/出售
        g_FunctionNPC.GotoLable(Self, '@AuctionBuyItem', False);
        m_sAuctionItemName := '';
        m_sAuctionItemHumanName := ''; // 物品拍卖者
        m_sAuctionItemBidHumanName := ''; // 竞拍出价者
        m_nAuctionItemStartPrice := 0; // 底价
        m_nAuctionItemSellPrice := 0; // 一口价
        m_nAuctionItemInvalidPrice := 0; // 失效价
        m_nAuctionItemFinaPrice := 0; // 成交价
        m_nAuctionItemMoneyType := 0; // 货币类型
        m_boAuctionItemSelled := False; // 物品是否被秒杀/出售
      end;
      m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 0, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
        AuctionRecord.CurrencyType);
      SendSocket(@m_DefMsg, '');
    end
    else
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 99, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
        AuctionRecord.CurrencyType);
      SendSocket(@m_DefMsg, '');
    end;
  end
  else
  begin
    if not CheckGameMoney(AuctionRecord.CurrencyType, nPrices) then
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 7, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
        AuctionRecord.CurrencyType);
      SendSocket(@m_DefMsg, '');
      Exit;
    end;

    if g_M2DataDB.AuctionDB.JoinItemBid(m_sCharName, ProcessMsg.nParam1, nPrices, False) then
    begin
      // 退前面竞拍人的钱
      if (Length(AuctionRecord.LastBidder) > 0) and (AuctionRecord.LastBidPrice > 0) then
      begin
        IncPlayerGameMoney(AuctionRecord.LastBidder, AuctionRecord.ActionItem.MakeIndex, AuctionRecord.CurrencyType,
          AuctionRecord.LastBidPrice, False, Player);

        if (Player <> nil) and (Player <> Self) and (g_FunctionNPC <> nil) then
        begin
          Player.m_nScriptGotoCount := 0;
          if StdItem <> nil then
            Player.m_sAuctionItemName := StdItem.Name
          else
            Player.m_sAuctionItemName := '';

          Player.m_sAuctionItemHumanName := AuctionRecord.HumanName; // 物品拍卖者
          Player.m_sAuctionItemBidHumanName := m_sCharName; // 竞拍出价者
          Player.m_nAuctionItemStartPrice := AuctionRecord.StartingPrice; // 底价
          Player.m_nAuctionItemSellPrice := AuctionRecord.SellingPrice; // 一口价
          Player.m_nAuctionItemInvalidPrice := AuctionRecord.LastBidPrice; // 失效价格 (我的出价)
          Player.m_nAuctionItemFinaPrice := nPrices; // 成交价 (最新出价)
          Player.m_nAuctionItemMoneyType := AuctionRecord.CurrencyType; // 货币类型
          Player.m_boAuctionItemSelled := False; // 物品是否被秒杀/出售
          g_FunctionNPC.GotoLable(Player, '@AuctionInvalidItem', False);
          Player.m_sAuctionItemName := '';
          Player.m_sAuctionItemHumanName := ''; // 物品拍卖者
          Player.m_sAuctionItemBidHumanName := ''; // 竞拍出价者
          Player.m_nAuctionItemStartPrice := 0; // 底价
          Player.m_nAuctionItemSellPrice := 0; // 一口价
          Player.m_nAuctionItemInvalidPrice := 0; // 失效价
          Player.m_nAuctionItemFinaPrice := 0; // 成交价
          Player.m_nAuctionItemMoneyType := 0; // 货币类型
          Player.m_boAuctionItemSelled := False; // 物品是否被秒杀/出售
        end;
      end;
      // 减自己的钱
      DecMyGameMoney(AuctionRecord.ActionItem.MakeIndex, AuctionRecord.CurrencyType, nPrices, False);
      m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 0, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
        AuctionRecord.CurrencyType);
      SendSocket(@m_DefMsg, '');
    end
    else
    begin
      m_DefMsg := MakeDefaultMsg(SM_AuctionItemBid_RET, ProcessMsg.nParam1, 99, Integer(ProcessMsg.wIdent = CM_AuctionItemBid),
        AuctionRecord.CurrencyType);
      SendSocket(@m_DefMsg, '');
    end;
  end;
