    PlayObjectMessageArray[CM_QUERYSELECTSHOPINFO] := ClientQuerySelectHeroM2ShopInfo
  else
    PlayObjectMessageArray[CM_QUERYSELECTSHOPINFO] := ClientQuerySelectShopInfo;
