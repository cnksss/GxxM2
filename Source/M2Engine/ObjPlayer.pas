  if (StdItem.StdMode in [10, 66]) and (m_btGender <> 0) then
  begin
    SysMsg(sWearNotOfWoMan, c_Red, t_Hint);
    Exit;
  end;

  if (StdItem.StdMode in [11, 67]) and (m_btGender <> 1) then
