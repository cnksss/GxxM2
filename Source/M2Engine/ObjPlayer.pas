procedure TPlayObject.SendGamePetList;
var
  I: Integer;
  sSendMsg: AnsiString;
  GamePetData: pTGamePetData;
  ClientGamePetData: pTClientGamePetData;
  InBuf: array [0 .. 102400] of AnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
begin
  if m_boOffLine or m_boDummyObject then
    Exit;
  sSendMsg := '';
  if m_GamePetList.Count > 0 then
  begin
    InBytes := m_GamePetList.Count * SizeOf(TClientGamePetData);
    Buffer := @InBuf;
    for I := 0 to m_GamePetList.Count - 1 do
    begin
      GamePetData := m_GamePetList.Items[I];
      ClientGamePetData := pTClientGamePetData(Buffer);
      ClientGamePetData.sName := GamePetData.sName;
      ClientGamePetData.GamePetAbility.Level := GamePetData.Level;
      ClientGamePetData.GamePetAbility.Exp := GamePetData.Exp;
      Move(GamePetData.wMagics, ClientGamePetData.wMagics, SizeOf(GamePetData.wMagics));
      RecallGamePetAbil(ClientGamePetData);
      if GamePetData.HP > ClientGamePetData.GamePetAbility.MaxHP then
        ClientGamePetData.GamePetAbility.HP := ClientGamePetData.GamePetAbility.MaxHP
      else
        ClientGamePetData.GamePetAbility.HP := GamePetData.HP;
      if GamePetData.MP > ClientGamePetData.GamePetAbility.MaxMP then
        ClientGamePetData.GamePetAbility.MP := ClientGamePetData.GamePetAbility.MaxMP
      else
        ClientGamePetData.GamePetAbility.MP := GamePetData.MP;
      Buffer := Buffer + SizeOf(TClientGamePetData);
    end;
    sSendMsg := zLibCompressBuffer(@InBuf, InBytes);
    if sSendMsg <> '' then
    begin
      m_DefMsg := MakeDefaultMsg(SM_GAMEPETLIST, 0, Length(sSendMsg), 0, m_GamePetList.Count);
      SendSocket(@m_DefMsg, sSendMsg);
    end;
  end;
end;

