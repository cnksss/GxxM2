    Exit;
  end;
  if (m_ChallengeCreat = nil) or (not m_boChallengeing) or m_boChallengeStart then
    Exit;
  if Pos(' ', sItemName) >= 0 then
  begin // 折分物品名称(信件物品的名称后面加了使用次数)
    GetValidStr3_Ex(sItemName, sItemName, ' ');
  end;
  bo11 := False;
  if not m_ChallengeCreat.m_boChallengeOK then
  begin
    for I := m_ChallengeItemList.Count - 1 downto 0 do
    begin
      if m_ChallengeItemList.Count <= 0 then
        Break;
      UserItem := m_ChallengeItemList.Items[I];
      if UserItem = nil then
        Continue;
      if UserItem.MakeIndex = nItemIdx then
      begin
        // 取自定义物品名称
