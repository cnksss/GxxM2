procedure TPlayObject.ClientViewSellPlayerInfo(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  PlayerName, S: string;
  Index: Integer;
  SellPlayerInfo: PSellPlayerInfo;
  Player: TPlayObject;
begin
  if MyGetTickCount - m_dwQuerySellPlayerShopItemTime < 1000 then
    Exit;

  m_dwQuerySellPlayerShopItemTime := MyGetTickCount;
  PlayerName := DecodeString(ProcessMsg.sMsg);
  if not g_SellPlayerList.Search(PlayerName, Index) then
  begin
    S := StringReplace(g_sViewSellPlayerNotFound, '%name', PlayerName, [rfReplaceAll]);
    SysMsg(S, c_Green, t_Hint);
    Exit;
  end;

  SellPlayerInfo := g_SellPlayerList.Items[index];
  if SellPlayerInfo.SetUser and (not SameText(SellPlayerInfo.SetUserName, m_sCharName)) then
  begin
    S := StringReplace(g_sViewSellPlayerSetUser, '%name', PlayerName, [rfReplaceAll]);
    SysMsg(S, c_Green, t_Hint);
    Exit;
  end;

  Player := UserEngine.GetPlayObject(PlayerName);
  if (Player = nil) or (Player.m_boGhost) then
  begin
    S := StringReplace(g_sViewSellPlayerSetUser, '%name', PlayerName, [rfReplaceAll]);
    SysMsg(S, c_Green, t_Hint);
    Exit;
  end;

  case ProcessMsg.nParam1 of
    0:
      SendViewSellPlayerInfo(Player); // 查看角色信息
    1:
      SendViewSellPlayerBagItems(Player); // 查看角色背包
    2: // 查看角色仓库
      begin
        if g_Config.boSellPlayerViewStorage then
          SendViewSellPlayerStorageItems(Player, False, True, 0);
      end;
    3: // 查看角色无限仓库
      begin
        if g_Config.boSellPlayerViewStorageEx then
          SendViewSellPlayerStorageItems(Player, True, True, 0);
      end;
    4:
      begin
        if g_Config.boSellPlayerAutoRecallHero then
          SendViewSellPlayerHeroInfo(Player);
      end;
  end;
end;

