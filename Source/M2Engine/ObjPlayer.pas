procedure TPlayObject.StartCollect(Time: LongWord; Msg: string; CanBreak: Boolean; TriggerOK, TriggerBreak: string);
begin
  if m_boCollecting then
  begin
    if m_boCollectCanBreak and (Length(m_sCollectTriggerBreak) > 0) then
    begin
      if (g_FunctionNPC <> nil) then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, m_sCollectTriggerBreak, False);
      end;
    end
    else
    begin
      Exit;
    end;
  end;
  m_boCollecting := True;
  m_dwCollectTime := Time;
  m_dwCollectTick := MyGetTickCount;
  m_sCollectMsg := Msg;
  m_boCollectCanBreak := CanBreak;
  m_sCollectTriggerOK := TriggerOK;
  m_sCollectTriggerBreak := TriggerBreak;
  if Length(m_sCollectTriggerBreak) > 0 then
  begin
    g_FunctionNPC.AddSelectLable(m_sCollectTriggerBreak);
  end;
  if Length(m_sCollectTriggerOK) > 0 then
  begin
    g_FunctionNPC.AddSelectLable(m_sCollectTriggerOK);
  end;
  SendMsg(Self, RM_UPDATECOLLECT, 0, 1, 0, 0, '');
end;

procedure TPlayObject.StopCollect;
begin
  if not m_boCollecting then
  begin
    Exit;
  end;
  if MyGetTickCount - m_dwCollectTick >= m_dwCollectTime * 1000 then
  begin
    m_boCollecting := False;
    if (g_FunctionNPC <> nil) then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, m_sCollectTriggerOK, False);
    end;
    SendMsg(Self, RM_UPDATECOLLECT, 0, 1, 100, 0, '');
  end
  else
  begin
    if m_boCollectCanBreak then
    begin
      m_boCollecting := False;
      if (g_FunctionNPC <> nil) then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, m_sCollectTriggerBreak, False);
      end;
      SendMsg(Self, RM_UPDATECOLLECT, 0, 0, 0, 0, '');
    end;
  end;
end;

