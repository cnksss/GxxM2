procedure TPlayObject.ClientBagUseMode47Item(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I, nDestMakeIndex, nSrcMakeIndex: Integer;
  UserItem, DestItem, SrcItem: pTUserItem;
  StdItem, DestStdItem, SrcStdItem: pTStdItem;
  IsHero: Boolean;
  Obj: TSmartObject;
begin
  nDestMakeIndex := ProcessMsg.nParam1;
  nSrcMakeIndex := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  IsHero := ProcessMsg.wParam = 1;
  if IsHero and (m_MyHero = nil) then
    Exit;
  DestItem := nil;
  SrcItem := nil;
  DestStdItem := nil;
  SrcStdItem := nil;
  if IsHero then
    Obj := TSmartObject(m_MyHero)
  else
    Obj := Self;
  // 获取背包中的物品
  for I := Obj.m_ItemList.Count - 1 downto 0 do
  begin
    UserItem := Obj.m_ItemList[I];
    if UserItem = nil then
      Continue;
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem = nil then
      Continue;
    if UserItem.MakeIndex = nDestMakeIndex then
    begin
      DestItem := UserItem;
      DestStdItem := StdItem;
      if SrcItem <> nil then
        Break;
    end
    else if UserItem.MakeIndex = nSrcMakeIndex then
    begin
      if (StdItem.StdMode = 47) and (StdItem.Shape in [50, 51]) then
      begin
        SrcItem := UserItem;
        SrcStdItem := StdItem;
        if DestItem <> nil then
          Break;
      end
      else
        Break;
    end;
  end;
  if (DestItem <> nil) and (SrcItem <> nil) then
  begin
    if SrcStdItem.Shape = 50 then
    begin
      Obj.m_nUseItemMakeIndex := SrcItem.MakeIndex;
      Obj.m_sUseItemName := SrcStdItem.Name;
      if (SrcItem.btValue[13] = 1) and (SrcItem.Name <> '') then
        Obj.m_sUseItemNewName := SrcItem.Name
      else
        Obj.m_sUseItemNewName := SrcStdItem.Name;
      Obj.m_nBagItemMakeIndex := DestItem.MakeIndex;
      Obj.m_sBagItemName := DestStdItem.Name;
      if (DestItem.btValue[13] = 1) and (DestItem.Name <> '') then
        Obj.m_sBagItemNewName := DestItem.Name
      else
        Obj.m_sBagItemNewName := DestStdItem.Name;
      if g_FunctionNPC <> nil then
      begin
        if IsHero then
        begin
          m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Self, '@HeroStdmodeShow' + IntToStr(SrcStdItem.AniCount), False);
        end
        else
        begin
          m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Self, '@StdmodeShow' + IntToStr(SrcStdItem.AniCount), False);
        end;
      end;
      for I := Obj.m_ItemList.Count - 1 downto 0 do
      begin
        UserItem := Obj.m_ItemList[I];
        if UserItem.MakeIndex = nSrcMakeIndex then
        begin
          if CheckOverLapItem(SrcStdItem) and (UserItem.Dura > 0) then
          begin
            UserItem.Dura := UserItem.Dura - 1;
            if IsHero then
              THeroObject(Obj).SendUpdateItemDura(-1, UserItem.MakeIndex, UserItem.Dura)
            else
              SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura);
          end
          else
          begin
            if IsHero then
              THeroObject(Obj).SendDelItem(UserItem)
            else
              SendDelItem(UserItem);
            Dispose(UserItem);
            Obj.m_ItemList.Delete(I);
          end;
          Break;
        end;
      end;
      Obj.m_nUseItemMakeIndex := 0;
      Obj.m_sUseItemName := '';
      Obj.m_sUseItemNewName := '';
      Obj.m_nBagItemMakeIndex := 0;
      Obj.m_sBagItemName := '';
      Obj.m_sBagItemNewName := '';
    end
    else
    begin
      Obj.m_nUseItemMakeIndex := SrcItem.MakeIndex;
      Obj.m_sUseItemName := SrcStdItem.Name;
      if (SrcItem.btValue[13] = 1) and (SrcItem.Name <> '') then
        Obj.m_sUseItemNewName := SrcItem.Name
      else
        Obj.m_sUseItemNewName := SrcStdItem.Name;
      Obj.m_nBagItemMakeIndex := DestItem.MakeIndex;
      Obj.m_sBagItemName := DestStdItem.Name;
      if (DestItem.btValue[13] = 1) and (DestItem.Name <> '') then
        Obj.m_sBagItemNewName := DestItem.Name
      else
        Obj.m_sBagItemNewName := DestStdItem.Name;
      if g_FunctionNPC <> nil then
      begin
        if IsHero then
        begin
          m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Self, '@HeroStdmodeShow' + IntToStr(SrcStdItem.AniCount), False);
        end
        else
        begin
          m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Self, '@StdmodeShow' + IntToStr(SrcStdItem.AniCount), False);
        end;
      end;
      Obj.m_nUseItemMakeIndex := 0;
      Obj.m_sUseItemName := '';
      Obj.m_sUseItemNewName := '';
      Obj.m_nBagItemMakeIndex := 0;
      Obj.m_sBagItemName := '';
      Obj.m_sBagItemNewName := '';
    end;
  end;
end;

