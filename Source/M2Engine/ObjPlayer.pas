              SendDefMessage(SM_TAKEONGODBLESSITEM_OK, Integer(IsHero), 0, 0, 0, '');
              ErrNum := 25;
              ProcessUseItemSkill(U_GODBLESSITEM1 + GodBlessIndex, StdItem, True);
              ErrNum := 26;
              if g_FunctionNPC <> nil then
              begin
                m_nCurrentItemMakeIndex := UserItem.MakeIndex;
