procedure TPlayObject.ClientChangeChallengeGold(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 修改挑战金币
var
  bo09: Boolean;
begin
  // 禁止取回放入交易栏内的金币
  if (m_nChallengeGolds > 0) and g_Config.boCanNotGetBackChallenge then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sChallengeItemsDenyGetBackMsg);
    SendDefMessage(SM_CHALLENGEDELITEM_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  if (m_ChallengeCreat = nil) or (not m_boChallengeing) or m_boChallengeStart then
    Exit;
  if ProcessMsg.nParam1 < 0 then
  begin
    SendDefMessage(SM_CHALLENGECHGGOLD_FAIL, m_nChallengeGolds, LoWord(m_nGold), HiWord(m_nGold), 0, '');
    Exit;
  end;
  bo09 := False;
  if (m_ChallengeCreat <> nil) and (GetPoseCreate = m_ChallengeCreat) then
  begin
    if not m_ChallengeCreat.m_boChallengeOK then
    begin
      if (m_nGold + m_nChallengeGolds) >= ProcessMsg.nParam1 then
      begin
        m_nGold := (m_nGold + m_nChallengeGolds) - ProcessMsg.nParam1;
        m_nChallengeGolds := ProcessMsg.nParam1;
        SendDefMessage(SM_CHALLENGECHGGOLD_OK, m_nChallengeGolds, LoWord(m_nGold), HiWord(m_nGold), 0, '');
        TPlayObject(m_ChallengeCreat).SendDefMessage(SM_CHALLENGEREMOTECHGGOLD, m_nChallengeGolds, 0, 0, 0, '');
        m_ChallengeCreat.m_ChallengeLastTick := MyGetTickCount();
        bo09 := True;
        m_ChallengeLastTick := MyGetTickCount();
      end;
    end;
  end;
  if not bo09 then
  begin
    SendDefMessage(SM_CHALLENGECHGGOLD_FAIL, m_nChallengeGolds, LoWord(m_nGold), HiWord(m_nGold), 0, '');
  end;
end;

