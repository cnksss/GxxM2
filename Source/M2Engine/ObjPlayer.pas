  end;
  if m_boMessageBox then
  begin
    m_sYesLable := '';
    m_sNoLable := '';
  end;
  m_boMessageBox := False;
end;

procedure TPlayObject.ClientMerchantDlgSelect(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  NPC: TNormNpc;
  Msg: WideString;
  Index, len: Integer;
begin
  if g_OnlineMsgControl.boDisableUseNpc or m_boGhost then
    Exit;

  NPC := UserEngine.FindMerchant(TObject(ProcessMsg.nParam1));

  if NPC = nil then
    NPC := UserEngine.FindNPC(TObject(ProcessMsg.nParam1));

  if NPC = nil then
  begin
    m_sYesLable := '';
    m_sNoLable := '';
    m_boMessageBox := False;
    Exit;
  end;

  if ((NPC.m_PEnvir = m_PEnvir) and (abs(NPC.m_nCurrX - m_nCurrX) < 15) and (abs(NPC.m_nCurrY - m_nCurrY) < 15)) or
    (NPC.m_boIsHide) or ((NPC.m_PEnvir = m_PEnvir) and ((CompareText(m_sYesLable, Trim(ProcessMsg.sMsg)) = 0) or
    (CompareText(m_sNoLable, Trim(ProcessMsg.sMsg)) = 0))) then
  begin
    Msg := ProcessMsg.sMsg;
    if CompareLStr(Msg, sNF_InputString, Length(sNF_InputString)) then
    begin
      Index := Pos(#$D, Msg);
      if Index > 0 then
        Msg := Copy(Msg, Index + 1, MaxInt);
    end
    else if CompareLStr(Msg, sNF_InputInteger, Length(sNF_InputInteger)) then
    begin
      Index := Pos(#$D, Msg);
      if Index > 0 then
        Msg := Copy(Msg, Index + 1, MaxInt);
    end
    else
    begin
      // 客户端请求带@_@的视为非法请求 2020-11-03
      Index := g_NpcProcessCommand.IndexOf(Msg);
      if (Index < 0) and (Length(Msg) >= 3) and (Msg[1] = '@') and (Msg[2] = '_') and (Msg[3] = '@') then
      begin
        MainOutMessage('ClientMerchantDlgSelect接收到非法请求:' + Msg);
        Exit;
      end;
    end;

    Index := Pos(#$D, Msg);
    if Index > 0 then
      Msg := Copy(Msg, Index + 1, MaxInt);

    ClearNpcInputText;
    len := Length(AnsiString(Msg));
    if len >= g_Config.nMaxInputStringLen + 20 then
    begin
      // '@@inputstring1(请输入新的名称  请输入新的名称  请输入新的名称  请输入新的名称  请输入新的名称  请输入新的名称  请输入新的名称  ：)'#$D'aa'
      MainOutMessage('ClientMerchantDlgSelect输入消息超过长度; 游戏参数->信息设置->信息发送长度限制' + IntToStr(len));
      Exit;
    end;
    NPC.UserSelect(Self, Trim(ProcessMsg.sMsg));
  end;

  if m_boMessageBox then
  begin
    m_sYesLable := '';
    m_sNoLable := '';
  end;
  m_boMessageBox := False;
end;

procedure TPlayObject.ClientMerchantQuerySellPrice(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  UserItem18: pTUserItem;
  Merchant: TMerchant;
  sUserItemName: string;
  nMakeIndex: Integer;
  sMsg: string;
  IsFromTradingDlg: Boolean;
  WaitSetIndex: Integer;
begin
  UserItem18 := nil;
  nMakeIndex := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  IsFromTradingDlg := LoByte(Word(ProcessMsg.wParam)) = 1;
  WaitSetIndex := HiByte(Word(ProcessMsg.wParam));
  sMsg := ProcessMsg.sMsg;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if UserItem = nil then
      Continue;
    if UserItem.MakeIndex = nMakeIndex then
    begin
      // 取自定义物品名称
      sUserItemName := '';
      if UserItem.btValue[13] = 1 then
        sUserItemName := UserItem.Name;
      if sUserItemName = '' then
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
      if CompareText(sUserItemName, sMsg) = 0 then
      begin
        UserItem18 := UserItem;
        Break;
      end;
    end;
  end;
  if UserItem18 = nil then
    Exit;
  Merchant := UserEngine.FindMerchant(TObject(ProcessMsg.nParam1));
  if Merchant = nil then
    Exit;
  if ((Merchant.m_PEnvir = m_PEnvir) and (Merchant.m_boSell) and (abs(Merchant.m_nCurrX - m_nCurrX) < 15) and
    (abs(Merchant.m_nCurrY - m_nCurrY) < 15)) then
    Merchant.ClientQuerySellPrice(Self, UserItem18, IsFromTradingDlg, WaitSetIndex);
end;

procedure TPlayObject.ClientUserSellItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  Merchant: TMerchant;
  sUserItemName: string;
  nMakeIndex: Integer;
  sMsg: string;
begin
  nMakeIndex := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  sMsg := ProcessMsg.sMsg;
  for I := m_ItemList.Count - 1 downto 0 do
  begin
    UserItem := m_ItemList.Items[I];
    if (UserItem <> nil) and (UserItem.MakeIndex = nMakeIndex) then
    begin
      // 取自定义物品名称
      sUserItemName := '';
      if UserItem.btValue[13] = 1 then
        sUserItemName := UserItem.Name;
      if sUserItemName = '' then
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
      if CompareText(sUserItemName, sMsg) = 0 then
      begin
        Merchant := UserEngine.FindMerchant(TObject(ProcessMsg.nParam1));
        if (Merchant <> nil) and (Merchant.m_boSell) and
          ((Merchant.m_PEnvir = m_PEnvir) and (abs(Merchant.m_nCurrX - m_nCurrX) < 15) and
          (abs(Merchant.m_nCurrY - m_nCurrY) < 15)) then
        begin
          if Merchant.ClientSellItem(Self, UserItem, False) then
          begin
            m_ItemList.Delete(I);
            WeightChanged();
          end;
        end;
        Break;
      end;
    end;
  end; // for
end;

procedure TPlayObject.ClientTradingSellItems(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I, II: Integer;
  UserItem: pTUserItem;
  Merchant: TMerchant;
  sMsg: string;
  sOK: string;
  SL: TStringList;
  nMakeIndex: Integer;
  nOKCount, nFailCount: Integer;
begin
  sMsg := ProcessMsg.sMsg;
  sOK := '';
  nOKCount := 0;
  nFailCount := 0;
  SL := TStringList.Create;
  try
    SL.Delimiter := #9;
    SL.DelimitedText := sMsg;
    for I := 0 to SL.Count - 1 do
    begin
      nMakeIndex := StrToIntDef(SL.Strings[I], 0);
      for II := m_ItemList.Count - 1 downto 0 do
      begin
        UserItem := m_ItemList.Items[II];
        if (UserItem <> nil) and (UserItem.MakeIndex = nMakeIndex) then
        begin
          Merchant := UserEngine.FindMerchant(TObject(ProcessMsg.nParam1));
          if (Merchant <> nil) and (Merchant.m_boSell) and
            ((Merchant.m_PEnvir = m_PEnvir) and (abs(Merchant.m_nCurrX - m_nCurrX) < 15) and
            (abs(Merchant.m_nCurrY - m_nCurrY) < 15)) then
          begin
            if Merchant.ClientSellItem(Self, UserItem, True) then
            begin
              sOK := sOK + IntToStr(nMakeIndex) + #9;
              m_ItemList.Delete(II);
              Inc(nOKCount);
            end
            else
            begin
              Inc(nFailCount);
            end;
          end;
        end;
      end; // end for ii
    end; // end for i
    WeightChanged();
    SendDefMessage(SM_TradingSELLITEMS_RET, m_nGold, nOKCount, nFailCount, 0, sOK);
  finally
    SL.Free;
  end;
end;

