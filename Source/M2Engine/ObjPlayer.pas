procedure TPlayObject.ClientDropGold(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nGold: LongWord;
begin
  if ProcessMsg.nParam1 <= 0 then
    Exit;
  nGold := ProcessMsg.nParam1;
  boResult := False;
  // 地图参数禁止丢物品(连金币都不可以)   piaoyun 2013-09-05
  if m_PEnvir.m_boNOTHROWITEM then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, NativeInt(Self), 0, 0, 0, g_sCanotDropItemMsg);
    Exit;
  end;
  if g_Config.boInSafeDisableDrop and InSafeZone then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotDropInSafeZoneMsg);
    Exit;
  end;
  if g_Config.boControlDropItem and (nGold < g_Config.nCanDropGold) then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotDropGoldMsg);
    Exit;
  end;
  if not m_boCanDrop then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotDropItemMsg);
    Exit;
  end;
  if nGold >= m_nGold then
    Exit;
  Dec(m_nGold, nGold);
  if not DropGoldDown(nGold, False, nil, Self) then
    Inc(m_nGold, nGold);
  GoldChanged();
  boResult := True;
end;

