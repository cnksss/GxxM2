  IsBigStorage: Boolean;
  sMsg: string;
  NPC: TObject;
  nPage: Integer;
  function GetPageCount(nListCount: Integer): Integer;
  begin
    Result := 0;
    if nListCount > 0 then
    begin
      Result := nListCount div ONEPAGECOUNT;
      if (nListCount mod ONEPAGECOUNT) > 0 then
        Inc(Result);
    end;
  end;

begin
  NPC := TObject(ProcessMsg.nParam1);
  nItemIdx := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
