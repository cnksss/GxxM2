procedure TPlayObject.SendQueryUserShopItem(nItemType, nMoneyType, nSortType, nMinPrice, nMaxPrice: Integer;
  sCharName, sItemName: string);
const
  ONE_PAGE_COUNT = 5;
var
  I, nCount: Integer;
  UserShopItem: pTUserShopItem;
  StdItem: pTStdItem;
  ItemList: TUserShopItemList;
  AllCount: Integer;
  InBuf: array [0 .. SizeOf(TClientUserShopItem) * ONE_PAGE_COUNT] of AnsiChar;
  ClientUserShopItem: pTClientUserShopItem;
begin
  if Pos('''', sItemName) > 0 then
    Exit;
  if Length(sItemName) >= 30 then
    Exit;
  if Pos('''', sCharName) > 0 then
    Exit;
  if Length(sCharName) >= 30 then
    Exit;
  if nMinPrice > nMaxPrice then
    nMinPrice := nMaxPrice;
  Dec(nItemType);
  Dec(nMoneyType);
  if g_boStopRun then
    Exit;
  m_QueryCurShopSellItem_Keyword := sItemName;
  m_QueryCurShopSellItem_ItemType := nItemType;
  m_QueryCurShopSellItem_MoneyType := nMoneyType;
  m_QueryCurShopSellItem_MinPrice := nMinPrice;
  m_QueryCurShopSellItem_MaxPrice := nMaxPrice;
  m_QueryCurShopSellItem_SortType := nSortType;
  m_QueryCurShopSellItem_HumanName := sCharName;
  {
    g_UserShopGetSellItemsThread.AddTask(Self,
    SameText(m_QueryCurShopSellItem_HumanName, m_sCharName),
    0,
    m_QueryCurShopSellItem_HumanName,
    m_QueryCurShopSellItem_Keyword,
    m_QueryCurShopSellItem_ItemType,
    m_QueryCurShopSellItem_MoneyType,
    m_QueryCurShopSellItem_MinPrice,
    m_QueryCurShopSellItem_MaxPrice,
    m_QueryCurShopSellItem_SortType,
    sitSelling,
    SM_QUERYUSERSHOPITEMS);
  }
  AllCount := g_M2DataDB.UserShopDB.GetSellItemsCount(SameText(m_QueryCurShopSellItem_HumanName, m_sCharName),
    m_QueryCurShopSellItem_HumanName, m_QueryCurShopSellItem_Keyword, m_QueryCurShopSellItem_ItemType,
    m_QueryCurShopSellItem_MoneyType, m_QueryCurShopSellItem_MinPrice, m_QueryCurShopSellItem_MaxPrice);
  ItemList := TUserShopItemList.Create;
  try
    g_M2DataDB.UserShopDB.GetSellItems(SameText(m_QueryCurShopSellItem_HumanName, m_sCharName), 0,
      m_QueryCurShopSellItem_HumanName, m_QueryCurShopSellItem_Keyword, m_QueryCurShopSellItem_ItemType,
      m_QueryCurShopSellItem_MoneyType, m_QueryCurShopSellItem_MinPrice, m_QueryCurShopSellItem_MaxPrice,
      m_QueryCurShopSellItem_SortType, ItemList);
    nCount := 0;
    ClientUserShopItem := @InBuf;
    SafeFillChar(InBuf[0], SizeOf(InBuf), #0);
    for I := 0 to ItemList.Count - 1 do
    begin
      UserShopItem := ItemList.Items[I];
      // if g_Config.boOfflineCloseMyShop and (UserEngine.GetPlayObject(UserShopItem.sMasterName) = nil) then Continue;
      ClientUserShopItem.sShopName := UserShopItem.sShopName;
      ClientUserShopItem.sMasterName := UserShopItem.sMasterName;
      ClientUserShopItem.sBuyName := UserShopItem.sBuyName;
      ClientUserShopItem.IsMyShopeItem := SameText(UserShopItem.sMasterName, m_sCharName);
      ClientUserShopItem.btMoneyType := UserShopItem.btMoneyType;
      ClientUserShopItem.btItemType := UserShopItem.btItemType;
      ClientUserShopItem.dCreateDate := UserShopItem.dCreateDate;
      ClientUserShopItem.btAllowSell := UserShopItem.btAllowSell;
      StdItem := UserEngine.GetStdItem(UserShopItem.UserItem.wIndex);
      if StdItem <> nil then
      begin
        UserItemToClientItem(@UserShopItem.UserItem, StdItem, @ClientUserShopItem.Item, True, True);
        ClientUserShopItem.Item.S.Price := UserShopItem.nPrice;
      end;
      Inc(nCount);
      Inc(ClientUserShopItem);
      if nCount >= ONE_PAGE_COUNT then
        Break;
    end;
    m_DefMsg := MakeDefaultMsg(SM_QUERYUSERSHOPITEMS, AllCount, 0, 0, nCount);
    SendSocketEx(@m_DefMsg, @InBuf, nCount * SizeOf(TClientUserShopItem));
  finally
    ItemList.Free;
  end;
end;

