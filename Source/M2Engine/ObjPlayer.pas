procedure TPlayObject.OpenGuildDlg(PlayObject: TPlayObject);
var
  I: Integer;
  SC: string;
  Master1, Master2: string;
  WantAddGuldIndex: Integer;
  Guild: TGUild;
begin
  if m_MyGuild <> nil then
  begin
    SC := TGUild(m_MyGuild).sGuildName + #13 + ' ' + #13;
    if m_nGuildRankNo = 1 then
    begin
      TGUild(m_MyGuild).GetGuildMasterName(Master1, Master2);
      if SameText(m_sCharName, Master1) then
        SC := SC + '2' + #13
      else
        SC := SC + '1' + #13;
    end
    else
    begin
      SC := SC + '0' + #13;
    end;
    SC := SC + '<Notice>' + #13;
    for I := 0 to TGUild(m_MyGuild).NoticeList.Count - 1 do
    begin
      if Length(SC) > 5000 then
        Break;
      SC := SC + TGUild(m_MyGuild).NoticeList.Strings[I] + #13;
    end; // for
    SC := SC + '<KillGuilds>' + #13;
    for I := 0 to TGUild(m_MyGuild).GuildWarList.Count - 1 do
    begin
      if Length(SC) > 5000 then
        Break;
      SC := SC + TGUild(m_MyGuild).GuildWarList.Strings[I] + #13;
    end; // for
    SC := SC + '<AllyGuilds>' + #13;
    for I := 0 to TGUild(m_MyGuild).GuildAllyList.Count - 1 do
    begin
      if Length(SC) > 5000 then
        Break;
      SC := SC + TGUild(m_MyGuild).GuildAllyList.Strings[I] + #13;
    end; // for
    if g_Config.boOpenNewGuild then
    begin
      SC := SC + '<AttentionGuilds>' + #13;
      for I := 0 to TGUild(m_MyGuild).GuildAttentionList.Count - 1 do
      begin
        if Length(SC) > 5000 then
          Break;
        SC := SC + TGUild(m_MyGuild).GuildAttentionList.Strings[I] + #13;
      end; // for
      SC := SC + '<RequestAllyGuilds>' + #13;
      for I := 0 to TGUild(m_MyGuild).GuildRequestAllList.Count - 1 do
      begin
        if Length(SC) > 5000 then
          Break;
        SC := SC + TGUild(m_MyGuild).GuildRequestAllList.Strings[I] + #13;
      end; // for
    end;
    m_DefMsg := MakeDefaultMsg(SM_OPENGUILDDLG, MakeLong(TGUild(m_MyGuild).OnlineCount, TGUild(m_MyGuild).Count),
      Integer(g_Config.boOpenNewGuild), TGUild(m_MyGuild).m_nMemberMaxLimit, Integer(TGUild(m_MyGuild).EnabledAlly));
    SendSocket(@m_DefMsg, EncodeString(SC));
  end
  else
  begin
    if g_Config.boOpenNewGuild then
    begin
      WantAddGuldIndex := -1;
      SC := '';
      for I := 0 to g_GuildManager.GuildList.Count - 1 do
      begin
        Guild := g_GuildManager.GuildList.Items[I];
        if Guild.FindWantAddMemberIndex(m_sCharName) <> -1 then
        begin
          WantAddGuldIndex := I;
        end;
        if g_Config.boNoShowNewGuildHumanCount then
          SC := SC + Guild.sGuildName + ':0:0/'
        else
          SC := SC + Guild.sGuildName + ':' + IntToStr(Guild.OnlineCount) + ':' + IntToStr(Guild.Count) + '/';
      end;
      SendDefMessage(SM_OPENGUILDADDDLG, WantAddGuldIndex, 0, 0, 0, SC);
    end
    else
      SendDefMessage(SM_OPENGUILDDLG_FAIL, 0, 0, 0, 0, '');
  end;
end;

