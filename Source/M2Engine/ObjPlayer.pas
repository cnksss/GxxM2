procedure TPlayObject.SendDefMessage(wIdent: Word; nRecog: Int64; nParam, nTag, nSeries: Word; sMsg: AnsiString); // 004CAD6C
begin
  if m_boDummyObject then
    Exit;

  if m_boOffLine and (MyGetTickCount - m_nOffOnlineTick > 1000 * 30) then
    Exit; // 如果挂机超过30秒后不在发送数据到客户端

  m_DefMsg := MakeDefaultMsg(wIdent, nRecog, nParam, nTag, nSeries);
  if sMsg <> '' then
    SendSocket(@m_DefMsg, EncodeString(sMsg))
  else
    SendSocket(@m_DefMsg, '');
end;

procedure TPlayObject.ClientQueryAssessHero(sData: string);
var
  sHeroData: string;
  StorageHeroInfo: TStorageHeroInfo;
begin
  m_AssessHeroInfos[0].sHeroName := '';
  m_AssessHeroInfos[1].sHeroName := '';
  if sData <> '' then
  begin
    sData := GetValidStr3_Ex(sData, sHeroData, '/');
    if sHeroData <> '' then
      DecodeString(sHeroData, @m_AssessHeroInfos[0], SizeOf(TStorageHeroInfo));

    if sData <> '' then
    begin
      sData := GetValidStr3_Ex(sData, sHeroData, '/');
      DecodeString(sHeroData, @m_AssessHeroInfos[1], SizeOf(TStorageHeroInfo));
    end;

    if (m_AssessHeroInfos[0].sHeroName <> '') and (m_AssessHeroInfos[1].sHeroName <> '') then
    begin
      if m_AssessHeroInfos[0].nLevel < m_AssessHeroInfos[1].nLevel then
      begin
        StorageHeroInfo := m_AssessHeroInfos[0]; // 调换一下把主将放在数据第一个位置
        m_AssessHeroInfos[0] := m_AssessHeroInfos[1];
        m_AssessHeroInfos[1] := StorageHeroInfo;
      end;
    end;

    if (m_AssessHeroInfos[0].sHeroName <> '') and (m_AssessHeroInfos[1].sHeroName <> '') then
      sData := EncodeBuffer(@m_AssessHeroInfos[0], SizeOf(TStorageHeroInfo)) + '/' + EncodeBuffer(@m_AssessHeroInfos[1],
        SizeOf(TStorageHeroInfo))
    else
      sData := '';
  end;
  m_DefMsg := MakeDefaultMsg(SM_SENDSTORAGEHEROINFOEX, 0, 0, 0, 0);
  SendSocket(@m_DefMsg, sData);
end;

