procedure TPlayObject.ClientGuildDelMember(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nC: Integer;
  s14: string;
  IsFound: Boolean;
  MemberObject: TPlayObject;
begin
  nC := 1;
  if IsGuildMaster then
  begin
    if TGUild(m_MyGuild).IsMember(ProcessMsg.sMsg) then
    begin
      if m_sCharName <> ProcessMsg.sMsg then
      begin
        if TGUild(m_MyGuild).DelMember(ProcessMsg.sMsg) then
        begin
          MemberObject := UserEngine.GetPlayObject(ProcessMsg.sMsg);
          if MemberObject <> nil then
          begin
            MemberObject.m_MyGuild := nil;
            MemberObject.RefRankInfo(0, '');
            MemberObject.RefShowName(); // 10/31
            if (g_FunctionNPC <> nil) then
            begin
              MemberObject.m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(MemberObject, '@ExitGuild', False);
            end;
          end;
          nC := 0;
        end
        else
          nC := 4;
      end
      else
      begin
        nC := 3;
        s14 := TGUild(m_MyGuild).sGuildName;
        if TGUild(m_MyGuild).CancelGuld(ProcessMsg.sMsg) then
        begin
          g_GuildManager.DELGUILD(s14, IsFound);
          m_MyGuild := nil;
          RefRankInfo(0, '');
          RefShowName(); // 10/31
          SysMsg('行会' + s14 + '已被取消！', c_Red, t_Hint);
          nC := 0;
          if (g_FunctionNPC <> nil) then
          begin
            m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(Self, '@ExitGuild', False);
          end;
        end
      end;
    end
    else
      nC := 2;
  end;
  if nC = 0 then
  begin
    SendDefMessage(SM_GUILDDELMEMBER_OK, 0, 0, 0, 0, '');
  end
  else
  begin
    SendDefMessage(SM_GUILDDELMEMBER_FAIL, nC, 0, 0, 0, '');
  end;
end;

procedure TPlayObject.ClientGuildDelSelf(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nC: Integer;
begin
  if IsGuildMaster and (TGUild(m_MyGuild).GetGuildMasterCount = 1) then
  begin
    nC := 6
  end
  else if m_MyGuild = nil then
    nC := 5
  else
  begin
    if TGUild(m_MyGuild).DelMember(m_sCharName) then
    begin
      m_MyGuild := nil;
      RefRankInfo(0, '');
      RefShowName();
      if (g_FunctionNPC <> nil) then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@ExitGuild', False);
      end;
      nC := 0;
    end
    else
      nC := 4;
  end;

  if nC = 0 then
    SendDefMessage(SM_GUILDDELMEMBER_OK, 0, Integer(g_Config.boOpenNewGuild), 0, 0, '')
  else
    SendDefMessage(SM_GUILDDELMEMBER_FAIL, nC, 0, 0, 0, '');
end;

procedure TPlayObject.ClientGuildUnMasterSelf(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I, nC: Integer;
  GuildRank, MasterGuildRank: pTGuildRank;
begin
  nC := 3;
  if not IsGuildMaster then
  begin
    nC := 1
  end
  else
  begin
    MasterGuildRank := nil;
    for I := 0 to TGUild(m_MyGuild).m_RankList.Count - 1 do
    begin
      GuildRank := TGUild(m_MyGuild).m_RankList.Items[I];
      if GuildRank.nRankNo = 1 then
      begin
        MasterGuildRank := GuildRank;
        Break;
      end;
    end;

    if MasterGuildRank <> nil then
    begin
      if MasterGuildRank.MemberList.Count <= 1 then
        nC := 2
      else
      begin
        if SameText(MasterGuildRank.MemberList[0], m_sCharName) then
          MasterGuildRank.MemberList.Delete(0)
        else
          MasterGuildRank.MemberList.Delete(1);

        TGUild(m_MyGuild).AddMember(Self);
        m_sGuildRankName := TGUild(m_MyGuild).GetRankName2(Self, m_nGuildRankNo);
        RefShowName();
        nC := 0;
      end;
    end;
  end;

  if nC = 0 then
    SendDefMessage(SM_GUILDUNMASTERSELF_OK, 0, 0, 0, 0, '')
  else
    SendDefMessage(SM_GUILDUNMASTERSELF_FAIL, nC, 0, 0, 0, '');
end;

procedure TPlayObject.ClientGuildUpdateNotice(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  SC: string;
  sNotict: string;
begin
  sNotict := ProcessMsg.sMsg;
  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    Exit;
  TGUild(m_MyGuild).NoticeList.Clear;
  while (sNotict <> '') do
  begin
    sNotict := GetValidStr3_Ex(sNotict, SC, #$D);
    TGUild(m_MyGuild).NoticeList.Add(SC);
  end; // while
  TGUild(m_MyGuild).SaveGuildInfoFile();
  OpenGuildDlg(Self);
end;

procedure TPlayObject.ClientGuildUpdateRankInfo(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nC: Integer;
begin
  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    Exit;
  nC := TGUild(m_MyGuild).UpdateRank(ProcessMsg.sMsg);
  if nC = 0 then
  begin
    ClientGuildMemberList(ProcessMsg, boResult);
    if (g_Config.boOpenNewGuild) and (m_nGuildRankNo <> 1) then
      SendDefMessage(SM_GUILDMASTER_CANCEL, 0, 0, 0, 0, '');
  end
  else
  begin
    if nC <= -2 then
    begin
      if g_Config.boOpenNewGuild then
      begin
        ClientGuildMemberList(ProcessMsg, boResult);
      end;
      SendDefMessage(SM_GUILDRANKUPDATE_FAIL, nC, 0, 0, 0, '');
      SysMsg('行会封号修改失败', g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
    end;
  end;
end;

