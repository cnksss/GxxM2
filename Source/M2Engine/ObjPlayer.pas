function TPlayObject.QuestTakeCheckItem(CheckItem: pTUserItem): Boolean;
var
  I: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
begin
  Result := False;
  for I := m_ItemList.Count - 1 downto 0 do
  begin
    if m_ItemList.Count <= 0 then
      Break;
    UserItem := m_ItemList.Items[I];
    if UserItem = nil then
      Continue;
    if UserItem = CheckItem then
    begin
      SendDelItem(UserItem);
      m_ItemList.Delete(I);
      Dispose(UserItem);
      Result := True;
      Break;
    end;
  end;

  for I := Low(THumanUseItems) to High(THumanUseItems) do
  begin
    if @m_UseItems[I] = CheckItem then
    begin
      SendDelItem(@m_UseItems[I]);
      { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
      // m_UseItems[I].wIndex := 0;
      StdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
      m_UseItems[I].wIndex := 0;
      if (StdItem <> nil) then
        ProcessUseItemSkill(I, StdItem, False);
      Result := True;
      Break;
    end;
  end;
end;

