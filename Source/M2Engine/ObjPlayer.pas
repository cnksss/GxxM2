    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if m_PEnvir.m_boNoShop then
  begin
    SysMsg(g_sMapCannotShopMsg, c_Red, t_Hint);
    Exit;
  end;
  nBuyCount := ProcessMsg.nParam1;
  nBuyGameMoney := ProcessMsg.nParam2;
  n01 := 0;
  nGameMoney := 0;
  sMsg := ProcessMsg.sMsg;
  sMsg := GetValidStr3_Ex(sMsg, sItemName, '/');
  sGiveName := DecodeString(sMsg);
  GiveToPalyer := UserEngine.GetPlayObject(sGiveName);
  // 角色没在线
  if GiveToPalyer = nil then
  begin
    SendDefMessage(SM_BUYSHOPITEMGIVE_FAIL, -4, 0, 0, 0, sGiveName); // 赠送的人没在线
    Exit;
  end;
  if g_SndaShopList <> nil then
  begin
    ShopItem := g_SndaShopList.GetEx(sItemName, nBuyGameMoney);
    if ShopItem = nil then
      ShopItem := g_SndaShopList.Get(sItemName);
    if ShopItem <> nil then
    begin
      if not ShopItem.boBulkBuy then
        nBuyCount := 1
      else
      begin
        if (nBuyCount <= 0) then
          nBuyCount := 1
        else if nBuyCount > ShopItem.nBulkBuyCount then
          nBuyCount := ShopItem.nBulkBuyCount;
      end;
      if not g_ItemRules.Get(UserEngine.GetStdItemIdx(ShopItem.StdItem.Name), 14) then
        nItemPrice := Round(ShopItem.StdItem.Price / 100 * m_nShopItemPriceRate)
      else
        nItemPrice := ShopItem.StdItem.Price;
      nGameMoney := ShopItem.GameMoney;
      // 交易数量  chongchong 2013-12-28
      nShopCount := ShopItem.ItemCount * nBuyCount;
      nTotalPrice := Int64(nItemPrice) * nBuyCount;
      if (nTotalPrice > 0) and CheckGameMoney(ShopItem, nTotalPrice) then
      begin
        nItemCount := ShopItem.StdItem.Need;
        nGiveItemCount := nItemCount * nBuyCount;
        if CompareLStr(sItemName, sSTRING_GOLDNAME, Length(sSTRING_GOLDNAME)) then
        begin
          if GiveToPalyer.IncGold(nGiveItemCount) then
            GiveToPalyer.GoldChanged();

          DecGameMoney(ShopItem, nTotalPrice, sGiveName, sSTRING_GOLDNAME, 0);
          if g_boGameLogGold then
          begin
            AddGameDataLog(LOG_ItemBuy, LOG_GoldChange, GiveToPalyer, sSTRING_GOLDNAME, 0, m_sCharName, GiveToPalyer.m_nGold,
              nGiveItemCount, '由' + m_sCharName + '在商铺赠送');
          end;
          SysMsg(Format('[成功]赠送给 %s %d%s 成功！', [sGiveName, nGiveItemCount, sSTRING_GOLDNAME]), c_Red, t_Hint);
          GiveToPalyer.SysMsg(Format('[恭喜]你的朋友 %s 在商铺给你买了 %d%s，请查收', [m_sCharName, nGiveItemCount, sSTRING_GOLDNAME]),
            c_Blue, t_Hint);
          Exit;
        end
        else if CompareLStr(sItemName, g_Config.sGameGoldName, Length(g_Config.sGameGoldName)) then
        begin
          GiveToPalyer.IncGameGold(nGiveItemCount);
          GiveToPalyer.GameGoldChanged();
          DecGameMoney(ShopItem, nTotalPrice, sGiveName, g_Config.sGameGoldName, 0);
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuy, LOG_GameGoldChange, GiveToPalyer, g_Config.sGameGoldName, 0, m_sCharName,
              GiveToPalyer.m_nGameGold, nGiveItemCount, '由' + m_sCharName + '在商铺赠送');
          end;
          SysMsg(Format('[成功]赠送给 %s %d个%s 成功！', [sGiveName, nGiveItemCount, g_Config.sGameGoldName]), c_Red, t_Hint);
          GiveToPalyer.SysMsg(Format('[恭喜]你的朋友 %s 在商铺给你买了 %d个%s，请查收', [m_sCharName, nGiveItemCount, g_Config.sGameGoldName]),
            c_Blue, t_Hint);
          Exit;
        end
        else if CompareLStr(sItemName, g_Config.sGamePointName, Length(g_Config.sGamePointName)) then
        begin
          GiveToPalyer.IncGamePoint(nGiveItemCount);
          GiveToPalyer.GameGoldChanged();
          DecGameMoney(ShopItem, nTotalPrice, sGiveName, g_Config.sGamePointName, 0);
          AddGameDataLog(LOG_ItemBuy, LOG_GamePointChange, GiveToPalyer, g_Config.sGamePointName, 0, m_sCharName,
            GiveToPalyer.m_nGamePoint, nGiveItemCount, '由' + m_sCharName + '在商铺赠送');
          SysMsg(Format('[成功]赠送给 %s %d点%s 成功！', [sGiveName, nGiveItemCount, g_Config.sGamePointName]), c_Red, t_Hint);
          GiveToPalyer.SysMsg(Format('[恭喜]你的朋友 %s 在商铺给你买了 %d点%s，请查收', [m_sCharName, nGiveItemCount, g_Config.sGamePointName]),
            c_Blue, t_Hint);
          Exit;
        end
        else if CompareLStr(sItemName, g_Config.sCreditPointName, Length(g_Config.sCreditPointName)) then
        begin
          if GiveToPalyer.m_WAbil.CreditPoint + LongWord(nGiveItemCount) > High(Integer) then
          begin
            GiveToPalyer.m_WAbil.CreditPoint := High(Integer);
          end
          else
          begin
            Inc(GiveToPalyer.m_WAbil.CreditPoint, LongWord(nGiveItemCount));
          end;
          AddGameDataLog(LOG_ItemBuy, LOG_CreditPointChange, GiveToPalyer, g_Config.sCreditPointName, 0, m_sCharName,
            GiveToPalyer.m_WAbil.CreditPoint, nGiveItemCount, '由' + m_sCharName + '在商铺赠送');
          GiveToPalyer.SendMsg(GiveToPalyer, RM_ABILITY, 0, 0, 0, 0, '');
          DecGameMoney(ShopItem, nTotalPrice, sGiveName, g_Config.sCreditPointName, 0);
          if g_boGameLogGameGold then
          begin
            // AddGameDataLog(LOG_CreditPointChange, GiveToPalyer.m_sMapName, GiveToPalyer.m_nCurrX, GiveToPalyer.m_nCurrY, g_Config.sCreditPointName, 0, GiveToPalyer.m_sCharName, '0', GiveToPalyer.m_WAbil.CreditPoint, nGiveItemCount, '由' + m_sCharName + '在商铺赠送');
          end;
          SysMsg(Format('[成功]赠送给 %s %d点声望 成功！', [sGiveName, nGiveItemCount]), c_Red, t_Hint);
          GiveToPalyer.SysMsg(Format('[恭喜]你的朋友 %s 在商铺给你买了 %d点声望，请查收', [m_sCharName, nGiveItemCount]), c_Blue, t_Hint);
          Exit;
        end
        else if CompareLStr(sItemName, g_Config.sGameDiamondName, Length(g_Config.sGameDiamondName)) then
        begin // 金刚石
          GiveToPalyer.IncGameDiamond(nGiveItemCount);
          GiveToPalyer.NewGamePointChanged();
          DecGameMoney(ShopItem, nTotalPrice, sGiveName, g_Config.sGameDiamondName, 0);
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuy, LOG_GameDiamondChange, GiveToPalyer, g_Config.sGameDiamondName, 0, m_sCharName,
              GiveToPalyer.m_nGameDiamond, nGiveItemCount, '由' + m_sCharName + '在商铺赠送');
          end;
          SysMsg(Format('[成功]赠送给 %s %d个%s 成功！', [sGiveName, nGiveItemCount, g_Config.sGameDiamondName]), c_Red, t_Hint);
          GiveToPalyer.SysMsg(Format('[恭喜]你的朋友 %s 在商铺给你买了 %d个%s，请查收', [m_sCharName, nGiveItemCount, g_Config.sGameDiamondName]),
            c_Blue, t_Hint);
          Exit;
        end
        else if CompareLStr(sItemName, g_Config.sGameGirdName, Length(g_Config.sGameGirdName)) then
        begin // 灵符
          GiveToPalyer.IncGameGird(nGiveItemCount);
          GiveToPalyer.NewGamePointChanged();
          DecGameMoney(ShopItem, nTotalPrice, sGiveName, g_Config.sGameGirdName, 0);
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuy, LOG_GameGirdChange, GiveToPalyer, g_Config.sGameGirdName, 0, m_sCharName,
              GiveToPalyer.m_nGameGird, nGiveItemCount, '由' + m_sCharName + '在商铺赠送');
          end;
          SysMsg(Format('[成功]赠送给 %s %d张%s 成功！', [sGiveName, nGiveItemCount, g_Config.sGameGirdName]), c_Red, t_Hint);
          GiveToPalyer.SysMsg(Format('[恭喜]你的朋友 %s 在商铺给你买了 %d张%s，请查收', [m_sCharName, nGiveItemCount, g_Config.sGameGirdName]),
            c_Blue, t_Hint);
          Exit;
        end
        else if CompareLStr(sItemName, '经验', Length('经验')) then
        begin
          GiveToPalyer.GetExp(nGiveItemCount);
          DecGameMoney(ShopItem, nTotalPrice, sGiveName, g_Config.sGameGirdName, 0);
          SysMsg(Format('[成功]赠送给 %s %d经验 成功！', [sGiveName, nGiveItemCount]), c_Red, t_Hint);
          GiveToPalyer.SysMsg(Format('[恭喜]你的朋友 %s 在商铺给你买了 %d经验，请查收', [m_sCharName, nGiveItemCount]), c_Blue, t_Hint);
          Exit;
        end;
        StdItem := UserEngine.GetStdItem(sItemName);
        if StdItem <> nil then
        begin
          // 修正商城购买叠加物品时不叠加及数量错误 chongchong 2014-04-15
          if CheckOverLapItem(StdItem) then
          begin
            // 修正叠加物品购买没有判断包裹空间是否够用 chongchong 2014-04-16
            if UserEngine.CopyToUserItemFromName(sItemName, @TempItem) then
            begin
              NeedBagCount := nShopCount div TempItem.DuraMax;
              if nShopCount mod TempItem.DuraMax <> 0 then
                Inc(NeedBagCount);
              if GiveToPalyer.IsEnoughBagEx(NeedBagCount) then
              begin
                nItemMakeIndex := 0;
                while nShopCount > 0 do
                begin
                  OverLapCount := OverLapBagItemCount(GiveToPalyer, StdItem, OverLapItem);
                  if (OverLapCount > 0) and (OverLapItem <> nil) then
                  begin
                    OverLapCount := Min(OverLapCount, nShopCount);
                    OverLapItem.Dura := OverLapItem.Dura + OverLapCount;
                    // Min(OverLapItem.Dura + OverLapCount, OverLapItem.DuraMax - 1);
                    Dec(nShopCount, OverLapCount);
                    nItemMakeIndex := OverLapItem.MakeIndex;
                    GiveToPalyer.SendUpdateItemDura(-1, OverLapItem.MakeIndex, False, OverLapItem.Dura);
                  end
                  else
                  begin
                    New(UserItem);
                    if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
                    begin
                      UserItem.ItemFrom.ItemForm := ifShopBuy;
                      UserItem.ItemFrom.sMakerName := m_sCharName;
                      UserItem.ItemFrom.DateTime := Now();
                      if UserItem.DuraMax > nShopCount then
                      begin
                        UserItem.Dura := nShopCount - 1;
                        nShopCount := 0;
                      end
                      else
                      begin
                        UserItem.Dura := UserItem.DuraMax - 1;
                        nShopCount := nShopCount - UserItem.DuraMax;
                      end;
                      GiveToPalyer.m_ItemList.Add(UserItem);
                      GiveToPalyer.SendAddItem(UserItem);
                      nItemMakeIndex := UserItem.MakeIndex;
                    end
                    else
                      Break;
                  end;
                end;
                DecGameMoney(ShopItem, nTotalPrice, sGiveName, sItemName, nItemMakeIndex);
                SysMsg(Format('[成功]赠送给 %s %s 成功！', [sGiveName, sItemName]), c_Red, t_Hint);
                GiveToPalyer.SysMsg(Format('[恭喜]你的朋友 %s 在商铺给你买了 %s，请查收', [m_sCharName, sItemName]), c_Blue, t_Hint);
                GiveToPalyer.WeightChanged;
              end
              else
                n01 := -3;
            end
            else
              n01 := -1;
          end
          else
          begin
            IsBuyOK := False;
            // 店铺同一物品一次卖多个 chongchong 2013-12-28
            if GiveToPalyer.IsEnoughBagEx(nShopCount) then
            begin
              for I := 0 to nShopCount - 1 do
              begin
                New(UserItem);
                if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
                begin
                  UserItem.ItemFrom.ItemForm := ifShopBuy;
                  UserItem.ItemFrom.sMakerName := m_sCharName;
                  UserItem.ItemFrom.DateTime := Now();
                  if CheckOverLapItem(StdItem) then
                    UserItem.Dura := Min(StdItem.DuraMax, Max(ShopItem.StdItem.Need, 1)) - 1; // UserItem.DuraMax - 1;
                  GiveToPalyer.m_ItemList.Add(UserItem);
                  GiveToPalyer.SendAddItem(UserItem);
                  IsBuyOK := True;
                  if (StdItem.NeedIdentify = 1) then
                  begin
                    AddGameDataLog(LOG_ItemBuy, LOG_ActionNone, GiveToPalyer, sItemName, UserItem.MakeIndex, m_sCharName, 0, 0,
                      '由' + m_sCharName + '商铺购买赠送->' + GiveToPalyer.m_sCharName);
                  end;
                  n01 := 1;
                end
                else
                  Dispose(UserItem);
              end;
            end
            else
              n01 := -3;
            // 修复商铺一次购买多个物品多次扣费 chongchong 2014-03-06
            if IsBuyOK then
            begin
              DecGameMoney(ShopItem, nTotalPrice, sGiveName, sItemName, 0);
              SysMsg(Format('[成功]赠送给 %s %d个%s 成功！', [sGiveName, nShopCount, sItemName]), c_Red, t_Hint);
              GiveToPalyer.SysMsg(Format('[恭喜]你的朋友 %s 在商铺给你买了 %d个%s，请查收！', [m_sCharName, nShopCount, sItemName]), c_Blue, t_Hint);
              GiveToPalyer.WeightChanged;
            end;
          end;
        end
        else
          n01 := -1;
      end
      else
        n01 := -2;
    end
    else
      n01 := -1;
  end;
  if n01 <= 0 then
    SendDefMessage(SM_BUYSHOPITEMGIVE_FAIL, n01, nGameMoney, 0, 0, '');
end;

procedure TPlayObject.ClientQueryRanking(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  sData: string;
