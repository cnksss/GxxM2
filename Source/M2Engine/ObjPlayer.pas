      SendStorageViewItemList(ProcessMsg.nParam1, ProcessMsg.nParam2 - 1, Boolean(ProcessMsg.nParam3), False);
    end;
  end
  else
  begin
    SendStorageViewItemList(ProcessMsg.nParam1, ProcessMsg.nParam2 - 1, Boolean(ProcessMsg.nParam3), False);
  end;
end;

