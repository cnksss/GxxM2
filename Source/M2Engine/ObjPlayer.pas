function TPlayObject.DoItemFluteStone(nItemIndex, nStoneIndex: Integer; var ItemUserItem, StoneUserItem: pTUserItem;
  var StoneStdItem: pTStdItem; var nStoneDelIndex: Integer): Integer;
{$IF NEED_KEY <> 2}
// 获取相同Anicount宝石的数量
  function GetAnicountFluteCount(Item: pTUserItem; AniCount: Integer): Integer;
  var
    I: Integer;
    StdItem: pTStdItem;
  begin
    Result := 0;
    for I := 0 to Item.btFluteCount - 1 do
    begin
      if (I in [0 .. MAX_FLUTE_COUNT - 1]) then
      begin
        if Item.Flutes[I].GemIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(Item.Flutes[I].GemIndex);
          if (StdItem <> nil) and (StdItem.AniCount = AniCount) then
            Inc(Result, Max(1, Item.Flutes[I].GemCount));
        end;
      end;
    end;
  end;
// 获取相同idx宝石数量 chongchong 2015-05-20
  function GetIdxFluteCount(Item: pTUserItem; nItemIdx: Integer): Integer;
  var
    I: Integer;
  begin
    Result := 0;
    for I := 0 to Item.btFluteCount - 1 do
    begin
      if (I in [0 .. MAX_FLUTE_COUNT - 1]) then
      begin
        if (Item.Flutes[I].GemIndex > 0) and (Item.Flutes[I].GemIndex = nItemIdx) then
        begin
          Inc(Result, Max(1, Item.Flutes[I].GemCount));
        end;
      end;
    end;
  end;

var
  UserItem: pTUserItem;
  StdItem, ItemStdItem: pTStdItem;
  I: Integer;
  IsOK: Boolean;
{$IFEND}
begin
  Result := 1;
{$IF NEED_KEY <> 2}
  if (nItemIndex <= 0) or (nStoneIndex <= 0) then
    Exit;
  nStoneDelIndex := -1;
  try
    ItemUserItem := nil;
    StoneUserItem := nil;
    ItemStdItem := nil;
    StoneStdItem := nil;
    // 获取背包中的物品
    for I := m_ItemList.Count - 1 downto 0 do
    begin
      UserItem := m_ItemList[I];
      if UserItem = nil then
        Continue;
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem = nil then
        Continue;
      if UserItem.MakeIndex = nItemIndex then
      begin
        if CheckInlaidGemstone(StdItem.StdMode) then
        begin
          ItemUserItem := UserItem;
          ItemStdItem := StdItem;
          if StoneUserItem <> nil then
            Break;
        end
        else
          Break;
      end
      else if UserItem.MakeIndex = nStoneIndex then
      begin
        if (StdItem.StdMode = 46) and (StdItem.Shape = 3) then
        begin
          StoneUserItem := UserItem;
          StoneStdItem := StdItem;
          nStoneDelIndex := I;
          if ItemUserItem <> nil then
            Break;
        end
        else
          Break;
      end;
    end;
    if (ItemUserItem <> nil) and (StoneUserItem <> nil) then
    begin
      if (ItemUserItem.btFluteCount > 0) and (ItemUserItem.btFluteCount <= MAX_FLUTE_COUNT) then
      begin
        if (g_Config.nItemFluteStoneCount > 0) and
          (g_Config.nItemFluteStoneCount <= GetAnicountFluteCount(ItemUserItem, StoneStdItem.AniCount)) then
        begin
          Result := 2;
          Exit;
        end;
        if (g_Config.nItemFluteStoneIdxCount > 0) and
          (g_Config.nItemFluteStoneIdxCount <= GetIdxFluteCount(ItemUserItem, StoneUserItem.wIndex)) then
        begin
          Result := 3;
          Exit;
        end;
        Result := 4;
        IsOK := False;
        if g_Config.nItemFluteStoneOverlapCount > 1 then
        begin
          for I := 0 to ItemUserItem.btFluteCount - 1 do
          begin
            if (I in [0 .. MAX_FLUTE_COUNT - 1]) then
            begin
              if (Max(1, ItemUserItem.Flutes[I].GemCount) < g_Config.nItemFluteStoneOverlapCount) and
                (ItemUserItem.Flutes[I].GemIndex = StoneUserItem.wIndex) then
              begin
                if ItemUserItem.Flutes[I].GemCount = 0 then
                  ItemUserItem.Flutes[I].GemCount := 1;
                Inc(ItemUserItem.Flutes[I].GemCount);
                IsOK := True;
                if (ItemStdItem <> nil) and (ItemStdItem.NeedIdentify = 1) then
                begin
                  AddGameDataLog(LOG_ItemInlaid, LOG_ActionNone, Self, ItemStdItem.Name, ItemUserItem.MakeIndex,
                    StoneStdItem.Name);
                end;
                if StoneStdItem.NeedIdentify = 1 then
                begin
                  AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StoneStdItem.Name, StoneUserItem.MakeIndex,
                    ItemStdItem.Name, 0, 0, '镶嵌到目标物品');
                end;
                Result := 0;
                Break;
              end;
            end;
          end;
        end;
        if (not IsOK) then
        begin
          for I := 0 to ItemUserItem.btFluteCount - 1 do
          begin
            if (I in [0 .. MAX_FLUTE_COUNT - 1]) then
            begin
              if (ItemUserItem.Flutes[I].GemIndex = 0) then
              begin
                ItemUserItem.Flutes[I].GemIndex := StoneUserItem.wIndex;
                ItemUserItem.Flutes[I].GemCount := 1;
                if (ItemStdItem <> nil) and (ItemStdItem.NeedIdentify = 1) then
                begin
                  AddGameDataLog(LOG_ItemInlaid, LOG_ActionNone, Self, ItemStdItem.Name, ItemUserItem.MakeIndex,
                    StoneStdItem.Name);
                end;
                if StoneStdItem.NeedIdentify = 1 then
                begin
                  AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StoneStdItem.Name, StoneUserItem.MakeIndex,
                    ItemStdItem.Name, 0, 0, '镶嵌到目标物品');
                end;
                Result := 0;
                Break;
              end;
            end;
          end;
        end;
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TPlayObject:DoItemFluteStone ' + m_sCharName);
      MainOutMessage(E.Message);
    end;
  end;
{$IFEND}
end;

// 包裹中使用物品（镶嵌宝石) chongchong 2015-01-04
procedure TPlayObject.ClientBagUseItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
{$IF NEED_KEY <> 2}
var
  nItemIndex, nStoneIndex, nStoneDelIndex, nRet: Integer;
  ItemUserItem, StoneUserItem: pTUserItem;
  StoneUserItemIndex: Word;
  StoneStdItem: pTStdItem;
{$IFEND}
begin
{$IF NEED_KEY <> 2}
  if g_Config.boDisableRightClickFluteStone then
    Exit;
  nItemIndex := ProcessMsg.nParam1;
  nStoneIndex := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  nRet := DoItemFluteStone(nItemIndex, nStoneIndex, ItemUserItem, StoneUserItem, StoneStdItem, nStoneDelIndex);
  if nRet = 0 then
  begin
    SendUpdateItemFlute(-1, False, ItemUserItem);
    StoneUserItemIndex := StoneUserItem.wIndex - 1;
    if (StoneStdItem <> nil) and CheckOverLapItem(StoneStdItem) and (StoneUserItem.Dura > 0) then
    begin
      StoneUserItem.Dura := StoneUserItem.Dura - 1;
      m_DefMsg := MakeDefaultMsg(SM_BAGUSEITEM, nStoneIndex, StoneUserItem.Dura, StoneStdItem.DuraMax, 0);
      SendSocket(@m_DefMsg, '');
    end
    else
    begin
      SendDelItem(StoneUserItem);
      m_ItemList.Delete(nStoneDelIndex);
      Dispose(StoneUserItem);
    end;
    // WeightChanged();
    if (g_FunctionNPC <> nil) then
    begin
      m_nScriptGotoCount := 0;
      m_PickUpOrDropItem := ItemUserItem^;
      m_UseStoneItemIndex := StoneUserItemIndex;
      g_FunctionNPC.GotoLable(Self, '@BagUseStoneItemOK', False);
    end;
  end
  else
  begin
    m_DefMsg := MakeDefaultMsg(SM_BAGUSEITEM, nItemIndex, LoWord(nStoneIndex), HiWord(nStoneIndex), nRet);
    SendSocket(@m_DefMsg, '');
  end;
{$IFEND}
end;

procedure TPlayObject.ClientRemoveStone(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 卸下镶嵌的宝石 chongchong 2015-01-04
{$IF NEED_KEY <> 2}
var
  I, nIdx, nRet: Integer;
  RemoveIndex, ArmIndex: Integer;
  UserItem, RemoveItem, ArmItem: pTUserItem;
  StdItem, RemoveStdItem, ArmStdItem: pTStdItem;
  OverLapItem: pTUserItem;
  S: string;
{$IFEND}
begin
{$IF NEED_KEY <> 2}
  nRet := 1; // 材料不足
  RemoveIndex := ProcessMsg.nParam1;
  ArmIndex := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  nIdx := ProcessMsg.wParam;
  RemoveItem := nil;
  RemoveStdItem := nil;
  ArmItem := nil;
  ArmStdItem := nil;
  try
    UserItem := nil;
    if nIdx in [0 .. MAX_FLUTE_COUNT] then
    begin
      for I := m_ItemList.Count - 1 downto 0 do
      begin
        UserItem := m_ItemList[I];
        if UserItem = nil then
          Continue;
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          if (RemoveItem = nil) and (UserItem.MakeIndex = RemoveIndex) then
          begin
            RemoveItem := UserItem;
            RemoveStdItem := StdItem;
            if (not CheckOverLapItem(RemoveStdItem)) or (RemoveItem.Dura = 0) then
              m_ItemList.Delete(I);
          end
          else if (ArmItem = nil) and (UserItem.MakeIndex = ArmIndex) then
          begin
            ArmItem := UserItem;
            ArmStdItem := StdItem;
          end;
          if (ArmItem <> nil) and (RemoveItem <> nil) then
            Break;
        end;
      end;
      if (ArmItem <> nil) and (RemoveItem <> nil) and (RemoveStdItem <> nil) and (ArmStdItem <> nil) then
      begin
        if (RemoveStdItem.StdMode = 46) and (RemoveStdItem.Shape = 9) then
        begin
          if CheckInlaidGemstone(ArmStdItem.StdMode) and (ArmItem.btFluteCount > nIdx) and (ArmItem.Flutes[nIdx].GemIndex > 0)
          then
          begin
            StdItem := UserEngine.GetStdItem(ArmItem.Flutes[nIdx].GemIndex);
            if (StdItem <> nil) and (StdItem.StdMode = 46) and (StdItem.Shape = 3) then
            begin
              // 镶嵌宝石卸下消失 chongchong 2015-01-10
              if StdItem.Reserved > 0 then
              begin
                if ArmItem.Flutes[nIdx].GemCount > 1 then
                  Dec(ArmItem.Flutes[nIdx].GemCount)
                else
                begin
                  ArmItem.Flutes[nIdx].GemIndex := 0;
                  ArmItem.Flutes[nIdx].GemCount := 0;
                end;
                if CheckOverLapItem(RemoveStdItem) and (RemoveItem.Dura > 0) then
                  RemoveItem.Dura := RemoveItem.Dura - 1
                else
                  Dispose(RemoveItem);
                nRet := 0;
                S := StringReplace(g_RemoveStoneDelStone, '%item', ArmStdItem.Name, []);
                S := StringReplace(S, '%stone', StdItem.Name, []);
                if Length(S) = 0 then
                  S := ' ';
                SendDefMessage(SM_REMOVESTONE_BACK, ArmItem.MakeIndex, MakeWord(nRet, nIdx), 0, 0, S);
                Exit;
              end
              else
              begin
                if CheckOverLapItem(StdItem) and (OverLapBagItemCount(Self, StdItem, OverLapItem) > 0) then
                begin
                  OverLapItem.Dura := OverLapItem.Dura + 1;
                  if ArmItem.Flutes[nIdx].GemCount > 1 then
                    Dec(ArmItem.Flutes[nIdx].GemCount)
                  else
                  begin
                    ArmItem.Flutes[nIdx].GemIndex := 0;
                    ArmItem.Flutes[nIdx].GemCount := 0;
                  end;
                  if (g_FunctionNPC <> nil) then
                  begin
                    m_nScriptGotoCount := 0;
                    g_FunctionNPC.GotoLable(Self, '@RemoveStoneItem', False);
                  end;
                  if CheckOverLapItem(RemoveStdItem) and (RemoveItem.Dura > 0) then
                    RemoveItem.Dura := RemoveItem.Dura - 1
                  else
                    Dispose(RemoveItem);
                  nRet := 0;
                  SendDefMessage(SM_REMOVESTONE_BACK, UserItem.MakeIndex, MakeWord(nRet, nIdx), LoWord(OverLapItem.MakeIndex),
                    HiWord(OverLapItem.MakeIndex), '');
                  Exit;
                end
                else
                begin
                  New(UserItem);
                  if UserEngine.CopyToUserItemFromName(StdItem.Name, UserItem) then
                  begin
                    m_ItemList.Add(UserItem);
                    if ArmItem.Flutes[nIdx].GemCount > 1 then
                      Dec(ArmItem.Flutes[nIdx].GemCount)
                    else
                    begin
                      ArmItem.Flutes[nIdx].GemIndex := 0;
                      ArmItem.Flutes[nIdx].GemCount := 0;
                    end;
                    {
                      if RemoveStdItem.NeedIdentify = 1 then
                      AddGameLog(Self, LOG_DELITEM, RemoveStdItem.Name, RemoveItem.MakeIndex, RemoveItem.Dura, NPC.m_sCharName,
                      '0', '卸下宝石', '使用', RemoveItem);
                      if Stditem.NeedIdentify = 1 then
                      AddGameLog(Self, LOG_ADDITEM, Stditem.Name, UserItem.MakeIndex, UserItem.Dura, NPC.m_sCharName,
                      '0', '卸下宝石', '卸下', UserItem);
                    }
                    if (g_FunctionNPC <> nil) then
                    begin
                      m_nScriptGotoCount := 0;
                      g_FunctionNPC.GotoLable(Self, '@RemoveStoneItem', False);
                    end;
                    if CheckOverLapItem(RemoveStdItem) and (RemoveItem.Dura > 0) then
                      RemoveItem.Dura := RemoveItem.Dura - 1
                    else
                      Dispose(RemoveItem);
                    nRet := 0;
                    SendDefMessage(SM_REMOVESTONE_BACK, UserItem.MakeIndex, MakeWord(nRet, nIdx), 0, 0, '');
                    Exit;
                  end
                  else
                  begin
                    nRet := 3;
                    Dispose(UserItem);
                  end;
                end;
              end;
            end
            else
              nRet := 3; // 装备没有可卸下宝石
          end
          else
            nRet := 3; // 装备没有可卸下宝石
        end
        else
          nRet := 2; // 卸下宝石不对
      end;
    end;
    SendDefMessage(SM_REMOVESTONE_BACK, 0, MakeWord(nRet, nIdx), 0, nIdx, '');
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TPlayObject:ClientRemoveStone -> ' + IntToStr(nRet));
      MainOutMessage(E.Message);
    end;
  end;
{$IFEND}
end;

procedure TPlayObject.ClientClickBox(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  BaseObject: TBaseObject;
begin
  if m_boDeath or m_boGhost then
    Exit;

  if (ProcessMsg.nParam2 = 2) and (m_nChangeAppr < 0) then
  begin
    m_boOnHorse := True;
    m_boCanOnHorse := False;
    m_dwCanOnHorseTime := 0;
    m_boHorseMaster := True;
    m_HorseOtherHum := nil;
    FeatureChanged();
    RefShowName;
    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@UpHorse', False);
    end;
    m_boCanOnHorse := False;
  end
  else if ProcessMsg.nParam2 = 1 then
  begin
    BaseObject := TBaseObject(ProcessMsg.nParam1);
    if (BaseObject <> nil) //
      and (not BaseObject.m_boDeath) //
      and (not BaseObject.m_boGhost) //
      and (BaseObject.m_btRaceServer in [RC_BOX, RC_BOX2]) then
    begin
      if g_FunctionNPC <> nil then
      begin
        if (BaseObject.m_Abil.Level > 0) and ((abs(BaseObject.m_nCurrX - m_nCurrX) > BaseObject.m_Abil.Level) and
          (abs(BaseObject.m_nCurrY - m_nCurrY) > BaseObject.m_Abil.Level)) then
        begin
          m_nScriptGotoCount := 0;
          m_CurrTarget := BaseObject;
          g_FunctionNPC.GotoLable(Self, '@CollectMonFail' + IntToStr(BaseObject.m_Abil.MaxMP), False);
          Exit;
        end;
        m_nScriptGotoCount := 0;
        m_CurrTarget := BaseObject;
        g_FunctionNPC.GotoLable(Self, '@CollectMon' + IntToStr(BaseObject.m_Abil.MaxMP), False);
      end;
    end;
  end;
end;

