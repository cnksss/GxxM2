procedure TPlayObject.ClientPetOverLapItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  boOverLapOK: Boolean;
  boSourceUpDate: Boolean;
  boDestUpDate: Boolean;
  UserItem: pTUserItem;
  SourceItem, DestItem: pTUserItem;
  SourceStdItem, DestStdItem: pTStdItem;
  SourceUserItem, DestUserItem: TUserItem;
  nSourceIdx, nDestIdx: Integer;
  IsCheckOK: Boolean;
begin
  if not g_Config.boOpenGamePet then
    Exit;
  if m_GamePetList.Count = 0 then
    Exit;
  boOverLapOK := False;
  boSourceUpDate := False;
  boDestUpDate := False;
  SourceItem := nil;
  SourceStdItem := nil;
  DestItem := nil;
  DestStdItem := nil;
  nSourceIdx := ProcessMsg.nParam1;
  nDestIdx := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  // 同一个物品自己叠加到自己，就是刷物品，有人搞事情 chongchong 2020-11-03 11:03:58
  if nSourceIdx = nDestIdx then
  begin
    SendDefMessage(SM_PETOVERLAPITEM_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  for I := 0 to m_GamePetBagItems.Count - 1 do
  begin
    UserItem := m_GamePetBagItems.Items[I];
    if (UserItem.MakeIndex = nSourceIdx) then
    begin
      SourceStdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (SourceStdItem <> nil) then
      begin
        SourceItem := UserItem;
        // m_ItemList.Delete(I);
        if (SourceItem <> nil) and (DestItem <> nil) then
          Break;
        // Continue;
      end;
    end;
    if (UserItem.MakeIndex = nDestIdx) then
    begin
      DestStdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (DestStdItem <> nil) then
      begin
        DestItem := UserItem;
        if (SourceItem <> nil) and (DestItem <> nil) then
          Break;
      end;
    end;
  end;
  if (SourceItem <> nil) and (DestItem <> nil) and (SourceStdItem = DestStdItem) and CheckOverLapItem(SourceStdItem) then
  begin
    IsCheckOK := False;
    // 物品叠加时，绑定物品和非绑定物品不能重叠 2020-11-04 10:37:17
    if SourceItem.boIsBind <> DestItem.boIsBind then
      IsCheckOK := False
    else if ((not SourceItem.boIsBind) and (not DestItem.boIsBind)) then
      IsCheckOK := True
    else if SourceItem.boIsBind and DestItem.boIsBind then
    begin
      IsCheckOK := (SourceItem.btBindOption = DestItem.btBindOption);
    end;
    if IsCheckOK and (DestItem.Dura < DestItem.DuraMax - 1) then
    begin
      if DestItem.Dura + SourceItem.Dura + 1 < DestItem.DuraMax then
      begin
        DestItem.Dura := DestItem.Dura + SourceItem.Dura + 1;
        boOverLapOK := True;
        boDestUpDate := True;
        DestUserItem := DestItem^;
        if SourceStdItem.NeedIdentify = 1 then
        begin
          // 注释日志 chongchong 2017-10-09
          AddGameDataLog(LOG_ItemOverlap, LOG_ActionNone, Self, SourceStdItem.Name, DestUserItem.MakeIndex, '宠物背包',
            DestUserItem.Dura + 1, SourceItem.Dura + 1);
        end;
        for I := 0 to m_GamePetBagItems.Count - 1 do
        begin
          if SourceItem = m_GamePetBagItems.Items[I] then
          begin
            if SourceStdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, SourceStdItem.Name, SourceItem.MakeIndex, '宠物背包',
                0, 0, '叠加');
            end;
            m_GamePetBagItems.Delete(I);
            Dispose(SourceItem);
            Break;
          end;
        end;
      end
      else
      begin
        SourceItem.Dura := SourceItem.Dura - (DestItem.DuraMax - DestItem.Dura - 1);
        DestItem.Dura := DestItem.DuraMax - 1;
        boSourceUpDate := True;
        boDestUpDate := True;
        SourceUserItem := SourceItem^;
        DestUserItem := DestItem^;
      end;
    end;
  end;
  if boOverLapOK then
  begin
    SendDefMessage(SM_PETOVERLAPITEM_OK, 0, 0, 0, 0, '');
  end
  else
  begin
    SendDefMessage(SM_PETOVERLAPITEM_FAIL, 0, 0, 0, 0, '');
  end;
  if boSourceUpDate then
    SendUpdatePetItem(@SourceUserItem);
  if boDestUpDate then
    SendUpdatePetItem(@DestUserItem);
end;

procedure TPlayObject.ClientPetDropItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I, nCount: Integer;
  DropItem: pTUserItem;
  UserItem: pTUserItem;
  UpdateItem: TUserItem;
  StdItem: pTStdItem;
  sUserItemName: string;
  boDropItemOK: Boolean;
  boUpdateItem: Boolean;
  sItemName: string;
  nItemIdx: Integer;
  // wIndex: Integer;
begin
  if not g_Config.boOpenGamePet then
    Exit;
  if m_GamePetList.Count = 0 then
    Exit;
  sItemName := ProcessMsg.sMsg;
  nItemIdx := ProcessMsg.nParam1;
  nCount := ProcessMsg.nParam2;
  boDropItemOK := False;
  boUpdateItem := False;
  if g_OnlineMsgControl.boDisableDropItem then
  begin
    SendDefMessage(SM_PET_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    Exit;
  end;
  // 当前地图禁止丢物品(连金币都不可以)   piaoyun 2013-09-05
  if m_PEnvir.m_boNOTHROWITEM then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotDropItemMsg);
    SendDefMessage(SM_PET_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    Exit;
  end;
  if g_Config.boInSafeDisableDrop and InSafeZone then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotDropInSafeZoneMsg);
    SendDefMessage(SM_PET_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    Exit;
  end;
  if not m_boCanDrop then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotDropItemMsg);
    SendDefMessage(SM_PET_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    Exit;
  end;
  if Pos(' ', sItemName) > 0 then
  begin // 折分物品名称(信件物品的名称后面加了使用次数)
    GetValidStr3_Ex(sItemName, sItemName, ' ');
  end;
  if (MyGetTickCount - m_DealLastTick) > 3000 then
  begin
    for I := m_GamePetBagItems.Count - 1 downto 0 do
    begin
      if m_GamePetBagItems.Count <= 0 then
        Break;
      UserItem := m_GamePetBagItems.Items[I];
      if (UserItem <> nil) and (UserItem.MakeIndex = nItemIdx) then
      begin
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem = nil then
          Continue;
        if (GetUserItemBindValue(UserItem, ubNoDrop) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 0) then
        begin
          g_ManageNPC.MessageBox(Self, g_sCanotUserDropItem);
          Break;
        end;
        // sItem:=UserEngine.GetStdItemName(UserItem.wIndex);
        // 取自定义物品名称
        sUserItemName := '';
        if UserItem.btValue[13] = 1 then
          sUserItemName := UserItem.Name;
        if sUserItemName = '' then
          sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
        if CompareText(sUserItemName, sItemName) = 0 then
        begin
          if CheckOverLapItem(StdItem) and (nCount > 0) then
          begin
            if nCount < UserItem.Dura + 1 then
            begin
              if g_Config.boControlDropItem and (StdItem.Price < g_Config.nCanDropPrice) then
              begin
                boDropItemOK := False;
              end
              else if g_ItemRules.Get(UserItem.wIndex, 24) then
              begin
                UserItem.Dura := UserItem.Dura - nCount;
                UpdateItem := UserItem^;
                boUpdateItem := True;
                boDropItemOK := False;
              end
              // 绑定物品丢弃消失 chongchong 2015-01-29
              else if (GetUserItemBindValue(UserItem, ubDropDelete) and UserItem.boIsBind) then
              begin
                UserItem.Dura := UserItem.Dura - nCount;
                UpdateItem := UserItem^;
                boUpdateItem := True;
                boDropItemOK := False;
              end
              else
              begin
                New(DropItem);
                if UserEngine.CopyToUserItemFromName(StdItem.Name, DropItem) then
                begin
                  DropItem.Dura := nCount - 1;
                  DropItem.boIsBind := UserItem.boIsBind;
                  DropItem.btBindOption := UserItem.btBindOption;
                  // 修正物品可以丢到npc脚下 chongchong 2014-10-27
                  if DropItemDown(DropItem, 6, False, nil, Self) then
                  begin
                    UserItem.Dura := UserItem.Dura - nCount;
                    UpdateItem := UserItem^;
                    boUpdateItem := True;
                    boDropItemOK := False;
                  end;
                end;
                Dispose(DropItem);
              end;
              Break;
            end;
          end;
          if g_Config.boControlDropItem and (StdItem.Price < g_Config.nCanDropPrice) then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemDrop, LOG_ItemDisappear, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, '低于指定价格，消失');
            end;
            m_GamePetBagItems.Delete(I);
            Dispose(UserItem);
            boDropItemOK := True;
            Break;
          end;
          // 物品规则  丢弃消失 chongchong 2013-10-18
          if g_ItemRules.Get(UserItem.wIndex, 24) then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemDrop, LOG_ItemDisappear, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, '丢弃消失');
            end;
            m_GamePetBagItems.Delete(I);
            Dispose(UserItem);
            boDropItemOK := True;
            Break;
          end
          // 绑定物品丢弃消失 chongchong 2015-01-29
          else if (GetUserItemBindValue(UserItem, ubDropDelete) and UserItem.boIsBind) then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemDrop, LOG_ItemDisappear, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, '绑定丢弃消失');
            end;
            m_GamePetBagItems.Delete(I);
            Dispose(UserItem);
            boDropItemOK := True;
            Break;
          end
          else
          begin
            // 修正物品可以丢到npc脚下 chongchong 2014-10-27
            if DropItemDown(UserItem, 6, False, nil, Self) then
            begin
              // wIndex := UserItem.wIndex;
              // m_PickUpOrDropItem := UserItem^;
              m_GamePetBagItems.Delete(I);
              Dispose(UserItem);
              boDropItemOK := True;
              // 扔物品触发2次 DropItemDown里面有一次 chongchong 2018-08-02 12:21:13
              // OnMapNotifyEvent(Self, meDropItem, StdItem.Name); // 扔物品事件
              Break;
            end;
          end;
        end;
      end;
    end;
    if boDropItemOK then
    begin
      SendDefMessage(SM_PET_DROPITEM_OK, nItemIdx, 0, 0, 0, sItemName);
      WeightChanged();
    end
    else
    begin
      SendDefMessage(SM_PET_DROPITEM_FAIL, nItemIdx, 0, 0, 0, sItemName);
    end;
    if boUpdateItem then
      SendUpdatePetItem(@UpdateItem);
  end;
end;

procedure TPlayObject.ClientUpgrageDlg(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem, FoundUserItem: pTUserItem;
  Merchant: TMerchant;
  sUserItemName: string;
  StdItem: pTStdItem;
  nNpc: Int64;
  nMakeIndex: Integer;
  sItemName: string;
begin
  nNpc := ProcessMsg.nParam1;
  nMakeIndex := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  sItemName := ProcessMsg.sMsg;
  if m_UpgradeItem <> nil then
    SendDefMessage(SM_UPGRADEDLGITEM_GIVE, 0, 0, 0, 0, '');
  m_UpgradeItem := nil;
  m_UpgradeItemIsPegBag := False;
  m_UpgradeStdItem.Name := '';
  FoundUserItem := nil;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    // 取自定义物品名称
    sUserItemName := '';
    if UserItem.btValue[13] = 1 then
      sUserItemName := UserItem.Name;
    if sUserItemName = '' then
      sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
    if (UserItem.MakeIndex = nMakeIndex) and (CompareText(sUserItemName, sItemName) = 0) then
    begin
      FoundUserItem := UserItem;
      Break;
    end;
  end;
  if (FoundUserItem <> nil) then
    StdItem := UserEngine.GetStdItem(FoundUserItem.wIndex)
  else
    StdItem := nil;
  if (FoundUserItem = nil) or (StdItem = nil) then
  begin
    SendDefMessage(SM_UPGRADEDLGITEM_GIVE, 0, 0, 0, 0, '');
    Exit;
  end;
  Merchant := UserEngine.FindMerchant(TObject(nNpc));
  if (Merchant <> nil) then
  begin
    m_UpgradeItem := FoundUserItem;
    m_UpgradeStdItem := StdItem^;
    m_UpgradeItemIsPegBag := False;
    if not m_boHeroM2OpenItemBoxEx then
    begin
      Merchant.GotoLable(Self, '@UpgradeDlgItem', False);
    end
    else
    begin
      if (g_FunctionNPC <> nil) and (m_nUpgradeIndex >= 1) and (m_nUpgradeIndex <= 1000) then
      begin
        m_nInteger[0] := m_UpgradeItem.Dura;
        m_sString[0] := m_UpgradeStdItem.Name;
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@GetBoxItem' + IntToStr(m_nUpgradeIndex), False);
        // 修正在触发中修改物品名，导致原物品没有被减掉 2019-01-29 20:23:17
        {
          [@GetBoxItem1]
          #ACT
          give 圣战戒指 1
          LINKGIVEITEM
          ChangeItemName -1 新圣战戒指
          updateitem -1
          clearLinkItem
          RefreshBag
        }
        if FoundUserItem <> nil then
        begin
          SendDefMessage(SM_UPGRADEDLGITEM_TAKE, 0, 0, 0, 0, '');
          for I := 0 to m_ItemList.Count - 1 do
          begin
            if m_ItemList.Items[I] = FoundUserItem then
            begin
              m_ItemList.Delete(I);
              Dispose(FoundUserItem);
              Break;
            end;
          end;
        end
        else
        begin
          SendDefMessage(SM_UPGRADEDLGITEM_GIVE, 0, 0, 0, 0, '');
        end;
        m_UpgradeItem := nil;
        m_UpgradeStdItem.Name := '';
        m_UpgradeItemIsPegBag := False;
      end;
    end;
  end
  else
  begin
    SendDefMessage(SM_UPGRADEDLGITEM_GIVE, 0, 0, 0, 0, '');
  end;
end;

procedure TPlayObject.ClientCancelUpgrageDlg(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  if m_UpgradeItem <> nil then
  begin
    SendDefMessage(SM_UPGRADEDLGITEM_GIVE, 0, 0, 0, 0, '');
    SendUpdateItem(m_UpgradeItem);
    m_UpgradeItem := nil;
    m_UpgradeStdItem.Name := '';
    m_UpgradeItemIsPegBag := False;
    m_nUpgradeIndex := -1;
    m_boHeroM2OpenItemBoxEx := False;
  end;
end;

procedure TPlayObject.ClientChallengeTry(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 挑战
var
  UserObject: TPlayObject;
  BaseObject: TBaseObject;
begin
  if g_OnlineMsgControl.boDisableChallenge then
    Exit;
  { TODO -ochongchong -c新增 : 密码保护系统 - 系统锁定时，根据选项来控制是否禁止挑战 【2013-07-22】 }
  // 骑马时禁止发起挑战 chongchong 2013-10-17
  if (m_boLockLogon and m_boPasswordLocked and g_Config.boLockChallenge) or m_boOnHorse then
  begin
    SysMsg(g_sCanotTryChallengeMsg, c_Red, t_Hint);
    Exit;
  end;
  if (m_PEnvir <> nil) and m_PEnvir.m_boNoChallenge then
  begin
    SysMsg(g_sCanotMapChallengeMsg, c_Red, t_Hint);
    Exit;
  end;
  if g_Config.boDisableChallenge then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sDisableChallengeItemsMsg);
    Exit;
  end;
  if m_boChallengeing or m_boChallengeOK or m_boChallengeStart then
    Exit;
  if MyGetTickCount - m_ChallengeLastTick < g_Config.dwTryChallengeTime { 3000 } then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sPleaseTryChallengeLaterMsg);
    Exit;
  end;
  if not m_boAllowChallenge then
  begin
    // SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sCanotTryChallengeMsg);
    // 修改用命令关闭了挑战后的提示方式、提示信息 piaoyun 2013-07-22
    SysMsg('你拒绝挑战。[允许命令为 @' + g_GameCommand.LETCHALLENGE.sCmd + ']', c_Red, t_Hint);
    Exit;
  end;
  BaseObject := GetPoseCreate();
  if (BaseObject <> nil) and (BaseObject <> Self) and (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
  begin
    UserObject := TPlayObject(BaseObject);
    { TODO -ochongchong -c新增 : 密码保护系统 - 系统锁定时，根据选项来控制是否禁止挑战 【2013-07-22】 }
    if UserObject.m_boLockLogon and UserObject.m_boPasswordLocked and g_Config.boLockChallenge then
    begin
      SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
      Exit;
    end;
    // 骑马时禁止被挑战 chongchong 2013-10-17
    if UserObject.m_boOnHorse then
    begin
      SysMsg(g_sHorseDisableChallengeMsg { '对方骑马时禁止挑战' } , c_Red, t_Hint);
      Exit;
    end;
    if (BaseObject.GetPoseCreate = Self) and (not UserObject.m_boChallengeing) and (not UserObject.m_boChallengeOK) and
      (not UserObject.m_boChallengeStart) then
    begin
      if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        if UserObject.m_boAllowChallenge then
        begin
          UserObject.SysMsg(m_sCharName + g_sOpenedChallengeMsg, c_Green, t_Hint);
          SysMsg(m_sCharName + g_sOpenedChallengeMsg, c_Green, t_Hint);
          OpenChallengeDlg(UserObject);
          UserObject.OpenChallengeDlg(Self);
        end
        else
        begin
          SysMsg(g_sPoseDisableChallengeMsg { '对方禁止挑战' } , c_Red, t_Hint);
        end;
      end;
    end
    else
    begin
      SendDefMessage(SM_CHALLENGETRY_FAIL, 0, 0, 0, 0, '');
    end;
  end
  else
  begin
    SendDefMessage(SM_CHALLENGETRY_FAIL, 0, 0, 0, 0, '');
  end;
end;

procedure TPlayObject.ClientAddChallengeItem(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 增加挑战物品
var
  I: Integer;
  bo11: Boolean;
  UserItem: pTUserItem;
  sUserItemName: string;
  sItemName: string;
  nItemIdx: Integer;
begin
  sItemName := ProcessMsg.sMsg;
  nItemIdx := ProcessMsg.nParam1;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if (m_ChallengeCreat = nil) or (not m_boChallengeing) or m_boChallengeStart then
    Exit;
  if Pos(' ', sItemName) >= 0 then
  begin // 折分物品名称(信件物品的名称后面加了使用次数)
    GetValidStr3_Ex(sItemName, sItemName, ' ');
  end;
  bo11 := False;
  if not m_ChallengeCreat.m_boChallengeOK then
  begin
    for I := m_ItemList.Count - 1 downto 0 do
    begin
      if m_ItemList.Count <= 0 then
        Break;
      UserItem := m_ItemList.Items[I];
      if UserItem = nil then
        Continue;
      if UserItem.MakeIndex = nItemIdx then
      begin
        // 取自定义物品名称
        sUserItemName := '';
        if UserItem.btValue[13] = 1 then
          sUserItemName := UserItem.Name;
        if sUserItemName = '' then
          sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
        if (CompareText(sUserItemName, sItemName) = 0) and (m_ChallengeItemList.Count < 4) then
        begin
          if (GetUserItemBindValue(UserItem, ubNoDeal) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 10) then
          begin
            g_ManageNPC.MessageBox(Self, g_sCanotUserChallengeItem);
            Break;
          end;
          m_ChallengeItemList.Add(UserItem);
          SendAddChallengeItem(UserItem);
          m_ItemList.Delete(I);
          bo11 := True;
          Break;
        end;
      end;
    end;
  end;
  if not bo11 then
    SendDefMessage(SM_CHALLENGEADDITEM_FAIL, 0, 0, 0, 0, '');
end;

