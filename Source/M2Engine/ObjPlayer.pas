procedure TPlayObject.ClientHeroLogon(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  boIsDeputyHero: Boolean;
  btDeputyHeroJob: Byte;
  t: DWORD;
begin
  boIsDeputyHero := ProcessMsg.nParam1 = 1;
  btDeputyHeroJob := ProcessMsg.nParam2;
  { TODO -ochongchong -c新增 : 密码保护系统 - 系统锁定时，根据选项来控制是否召唤英雄 【2013-07-22】 }
  if m_boLockLogon and m_boPasswordLocked and g_Config.boLockSummonHero then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if m_boOffLine or m_boWaitHeroDate or { m_boGhost or m_boDeath or } m_PEnvir.m_boNoRecallHero then
    Exit;
  // 人物死亡后过十秒钟才收英雄 chongchong 2013-12-10
  if (m_boGhost or m_boDeath) and (MyGetTickCount - m_dwDeathTick >= g_Config.dwHeroLogonTimeMasterDie * 1000) then
    Exit;
  if boIsDeputyHero then
  begin
    if m_boFixedHero then
    begin // 评定后召唤副将的按钮才能用
      if MyGetTickCount - m_dwClickDeputyHeroBotTick > 500 then
      begin
        m_dwClickDeputyHeroBotTick := MyGetTickCount;
        if (not m_boStorageDeputyHero) then
        begin
          if (m_MyHero = nil) then
          begin
            if (m_sDeputyHeroName <> '') then
            begin
              t := MyGetTickCount - m_dwRecallDeputyHeroTick;
              if (t > g_Config.nRecallDeputyHeroTime * 1000) then
              begin
                DataEngine.LoadHeroData(Self, nil, m_sDeputyHeroName, True, btDeputyHeroJob);
              end
              else
              begin
                // SysMsg(g_sWaitRecallHero, c_Red, t_Hint);
                // 召唤英雄间隔
                SysMsg(Format(g_sRecallHeroHint, [(g_Config.nRecallDeputyHeroTime * 1000 - t) div 1000]), c_Red, t_Hint);
              end;
            end;
          end
          else if (m_MyHero <> nil) and (THeroObject(m_MyHero).m_boIsDeputy) then
          begin
            THeroObject(m_MyHero).LogOut;
          end;
        end;
      end;
    end;
  end
  else
  begin
    if MyGetTickCount - m_dwClickHeroBotTick > 500 then
    begin
      m_dwClickHeroBotTick := MyGetTickCount;
      if (m_MyHero = nil) then
      begin
        if m_boFixedHero then
        begin // 评定后只可以召唤主将
          if (m_sHeroName <> '') and (not m_boStorageHero) then
          begin
            t := MyGetTickCount - m_dwRecallHeroTick;
            if (t > g_Config.nRecallHeroTime * 1000) then
            begin
              DataEngine.LoadHeroData(Self, nil, m_sHeroName, False, 0);
            end
            else
            begin
              // SysMsg(g_sWaitRecallHero, c_Red, t_Hint);
              SysMsg(Format(g_sRecallHeroHint, [(g_Config.nRecallHeroTime * 1000 - t) div 1000]), c_Red, t_Hint);
            end;
          end;
        end
        else
        begin
          if (m_sHeroName <> '') and (not m_boStorageHero) then
          begin
            t := MyGetTickCount - m_dwRecallHeroTick;
            if (MyGetTickCount - m_dwRecallHeroTick > g_Config.nRecallHeroTime * 1000) then
            begin
              DataEngine.LoadHeroData(Self, nil, m_sHeroName, False, 0);
            end
            else
            begin
              // SysMsg(g_sWaitRecallHero, c_Red, t_Hint);
              SysMsg(Format(g_sRecallHeroHint, [(g_Config.nRecallHeroTime * 1000 - t) div 1000]), c_Red, t_Hint);
            end;
          end
          else if (m_sDeputyHeroName <> '') and (not m_boStorageDeputyHero) then
          begin
            t := MyGetTickCount - m_dwRecallHeroTick;
            if (t > g_Config.nRecallHeroTime * 1000) then
            begin
              DataEngine.LoadHeroData(Self, nil, m_sDeputyHeroName, True, 255);
            end
            else
            begin
              // SysMsg(g_sWaitRecallHero, c_Red, t_Hint);
              SysMsg(Format(g_sRecallHeroHint, [(g_Config.nRecallHeroTime * 1000 - t) div 1000]), c_Red, t_Hint);
            end;
          end;
        end;
      end
      else
      begin
        THeroObject(m_MyHero).LogOut;
      end;
    end;
  end;
end;

procedure TPlayObject.ClientMasterBagToHeroBag(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 主人包裹物品放到英雄包裹
var
  I: Integer;
  UserItem: pTUserItem;
  sUserItemName: string;
  nItemIdx: Integer;
  sItemName: string;
  StdItem: pTStdItem;
  AddWeight: Integer;
  _dwRecordBeadExp: LongWord;
begin
  nItemIdx := ProcessMsg.nParam1;
  sItemName := ProcessMsg.sMsg;
  if m_boOffLine or m_boWaitHeroDate or m_boGhost or (m_MyHero = nil) then
  begin
    SendDefMessage(SM_MASTERBAGTOHEROBAG_FAIL, 0, 0, 0, 0, '');
  end
  else
  begin
    if THeroObject(m_MyHero).IsEnoughBag then
    begin
      for I := 0 to m_ItemList.Count - 1 do
      begin
        UserItem := m_ItemList.Items[I];
        if UserItem.MakeIndex = nItemIdx then
        begin
          // 取自定义物品名称
          sUserItemName := '';
          if UserItem.btValue[13] = 1 then
            sUserItemName := UserItem.Name;
          if sUserItemName = '' then
            sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
          { TODO -ochongchong -c新增 : 物品规则 - 英雄包裹【2013-07-27】 }
          if (Length(sUserItemName) > 0) and g_ItemRules.Get(UserItem.wIndex, 15) then
          begin
            SendDefMessage(SM_MASTERBAGTOHEROBAG_FAIL, 0, 0, 0, 0, '');
            SysMsg(g_sAddToHeroBagFail, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
            Exit;
          end;
          { 英雄背包重量 chongchong 2013-09-12 }
          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if StdItem <> nil then
          begin
            AddWeight := OverLapItemWeight(StdItem, UserItem.Dura);
            // RecalcBagWeight
            if m_MyHero.m_WAbil.Weight + AddWeight > m_MyHero.m_WAbil.MaxWeight then
            begin
              SendDefMessage(SM_MASTERBAGTOHEROBAG_FAIL, 0, 0, 0, 0, '');
              SysMsg(g_sAddToHeroBagFailWeight, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
              Exit;
            end;
          end;
          if CompareText(sUserItemName, sItemName) = 0 then
          begin
            m_ItemList.Delete(I);
            m_MyHero.AddItemToBag(UserItem);
            WeightChanged;
            THeroObject(m_MyHero).WeightChanged;
            SendDefMessage(SM_MASTERBAGTOHEROBAG_OK, nItemIdx, 0, 0, 0, '');
            if StdItem <> nil then
            begin
              if (THeroObject(m_MyHero).m_dwRecordBeadExp > 0) and (StdItem.StdMode = 49) and (UserItem.Dura < UserItem.DuraMax)
              then
              begin
                _dwRecordBeadExp := THeroObject(m_MyHero).m_dwRecordBeadExp;
                THeroObject(m_MyHero).m_dwRecordBeadExp := 0;
                THeroObject(m_MyHero).IncBeadExp(_dwRecordBeadExp, False);
              end;
            end;
            if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
            begin
              AddGameDataLog(LOG_ItemMove, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, m_MyHero.m_sCharName, 0, 0,
                '人物背包->英雄背包');
            end;
            Exit;
          end;
        end;
      end;
    end;
    SendDefMessage(SM_MASTERBAGTOHEROBAG_FAIL, 0, 0, 0, 0, '');
  end;
end;

