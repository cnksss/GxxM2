// 放物品到神佑 chongchong 2013-10-21
procedure TPlayObject.ClientTakeOnGodBless(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  sUserItemName: string;
  nMakeIndex: Integer;
  sItemName: string;
  StdItem, StdItem2: pTStdItem;
  GodBlessIndex: Integer;
  OldItem: pTUserItem;
  TakeOffItem: TUserItem;
  IsHero: Boolean;
  ErrNum: Integer;
begin
  ErrNum := 0;
  try
    ErrNum := 1;
    nMakeIndex := ProcessMsg.nParam1;
    GodBlessIndex := ProcessMsg.nParam2;
    IsHero := Boolean(ProcessMsg.nParam3);
    ErrNum := 2;
    sItemName := DecodeString(ProcessMsg.sMsg);
    ErrNum := 3;
    if m_boOffLine or m_boGhost or (not(GodBlessIndex in [Low(THumanGodBlessItems) .. High(THumanGodBlessItems)])) then
    begin
      SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
      Exit;
    end;
    OldItem := nil;
    ErrNum := 4;
    if not IsHero then
    begin
      ErrNum := 5;
      if m_GodBlessItemsState[GodBlessIndex] = 0 then
        Exit;
      ErrNum := 6;
      for I := 0 to m_ItemList.Count - 1 do
      begin
        ErrNum := 7;
        UserItem := m_ItemList.Items[I];
        ErrNum := 9;
        if UserItem.MakeIndex = nMakeIndex then
        begin
          ErrNum := 9;
          // 取自定义物品名称
          sUserItemName := '';
          if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
            sUserItemName := UserItem.Name
          else
            sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
          ErrNum := 10;
          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if (StdItem <> nil) and (CompareText(sUserItemName, sItemName) = 0) then
          begin
            ErrNum := 100;
            { TODO -ochongchong -c新增 : 物品规则 - 英雄物品【2013-07-27】 }
            if g_ItemRules.Get(UserItem.wIndex, 16) then
            begin
              SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
              SysMsg(g_sOnlyHeroDress, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
              Exit;
            end;
            ErrNum := 11;
            if ((StdItem.Expand1 = GodBlessIndex + 1) or (StdItem.Expand1 = 13)) and (StdItem.Overlap and 4 <> 0) then
            begin
              ErrNum := 12;
              if not CheckTakeOnItems(U_GODBLESSITEM1 + GodBlessIndex, StdItem) then
              begin
                SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
                Exit;
              end;
              ErrNum := 13;
              if m_GodBlessItems[GodBlessIndex].wIndex > 0 then
              begin
                ErrNum := 14;
                if InDisableTakeOffList(m_GodBlessItems[GodBlessIndex].wIndex) or
                  (GetUserItemBindValue(@m_GodBlessItems[GodBlessIndex], ubNoTakeOff) and m_GodBlessItems[GodBlessIndex].boIsBind)
                then
                begin
                  SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
                  SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
                  Exit;
                end;
                if (m_GodBlessItems[GodBlessIndex].btValue[13] = 1) and (m_GodBlessItems[GodBlessIndex].Name <> '') then
                  sUserItemName := m_GodBlessItems[GodBlessIndex].Name
                else
                  sUserItemName := UserEngine.GetStdItemName(m_GodBlessItems[GodBlessIndex].wIndex);
                m_nCurrentItemMakeIndex := m_GodBlessItems[GodBlessIndex].MakeIndex;
                m_nCurrentItemPos := GodBlessIndex + U_GODBLESSITEM1;
                m_sCurrentItemName := UserEngine.GetStdItemName(m_GodBlessItems[GodBlessIndex].wIndex);
                m_sCurrentItemNewName := sUserItemName;
                m_PickUpOrDropItem := m_GodBlessItems[GodBlessIndex];
                m_boStopTakeOff := False;
                g_FunctionNPC.GotoLable(Self, '@BeginTakeOff', False);
                m_PickUpOrDropItem.MakeIndex := 0;
                m_PickUpOrDropItem.wIndex := 0;
                m_nCurrentItemMakeIndex := 0;
                m_nCurrentItemPos := 0;
                m_sCurrentItemName := '';
                m_sCurrentItemNewName := '';
                if m_boStopTakeOff then
                begin
                  SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
                  Exit;
                end;
              end;
              if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
                sUserItemName := UserItem.Name
              else
                sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
              m_nCurrentItemMakeIndex := UserItem.MakeIndex;
              m_nCurrentItemPos := GodBlessIndex + U_GODBLESSITEM1;
              m_sCurrentItemName := UserEngine.GetStdItemName(UserItem.wIndex);
              m_sCurrentItemNewName := sUserItemName;
              m_PickUpOrDropItem := UserItem^;
              m_boStopTakeOn := False;
              g_FunctionNPC.GotoLable(Self, '@BeginTakeOn', False);
              m_PickUpOrDropItem.MakeIndex := 0;
              m_PickUpOrDropItem.wIndex := 0;
              m_nCurrentItemMakeIndex := 0;
              m_nCurrentItemPos := 0;
              m_sCurrentItemName := '';
              m_sCurrentItemNewName := '';
              if m_boStopTakeOn then
              begin
                SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
                Exit;
              end;
              if m_GodBlessItems[GodBlessIndex].wIndex > 0 then
              begin
                ErrNum := 15;
