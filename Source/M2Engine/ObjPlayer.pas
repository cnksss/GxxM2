function TPlayObject.DoAddSellPlayer: Integer;
var
  Index: Integer;
begin
  if m_WantAddSellPlayerInfo = nil then
  begin
    Result := 1;
    Exit;
  end;
  m_boBreakAddSellPlayer := False;
  if g_FunctionNPC <> nil then
  begin
    m_nScriptGotoCount := 0;
    g_FunctionNPC.GotoLable(Self, '@PlayerSelling', False);
  end;
  if m_boBreakAddSellPlayer then
  begin
    FreeMem(m_WantAddSellPlayerInfo);
    m_WantAddSellPlayerInfo := nil;
    Result := 2;
    Exit;
  end;
{$IF NEED_KEY = 1}
  if g_nKey_SellPlayer <> 0 then
{$IFEND}
  begin
    g_SellPlayerList.AddSellPlayer(m_sUserID, m_sCharName, m_WantAddSellPlayerInfo.Delegater,
      m_WantAddSellPlayerInfo.SellPricesType, m_WantAddSellPlayerInfo.SellPrices, Now, m_WantAddSellPlayerInfo.IsSetUser,
      m_WantAddSellPlayerInfo.SetUserName);
    SendDefMessage(SM_ADD_SELL_PLAYER_RET, 0, 0, 0, 0, '');
    g_SellPlayerList.SaveConfig;
    m_boSellPlayering := True;
    FreeMem(m_WantAddSellPlayerInfo);
    m_WantAddSellPlayerInfo := nil;
    Result := 0;
    // 离线挂机
    m_nOffOnlineTick := MyGetTickCount;
    m_nOffOnlineTime := 0;
    m_dwOfflineGetExpTick := MyGetTickCount;
    m_nOfflineGetExpTime := 0;
    m_nOffOnlineExp := 0;
    m_boReconnection := False;
    m_boSoftClose := True;
    m_boOffLine := True;
    m_boOfflineKick := False;
    UserEngine.m_ReallyPlayObjectList.Remove(Self);
    m_boAllowChallenge := False; // 是否允许挑战
    m_boAllowDeal := False; // 禁止交易
    m_boAllowGuild := False; // 禁止加入行会
    m_boAllowGroup := False; // 禁止组队
    m_boCanMasterRecall := False; // 禁止师徒传送
    m_boCanDearRecall := False; // 禁止夫妻传送
    m_boAllowGuildReCall := False; // 禁止行会合一
    m_boAllowGroupReCall := False; // 禁止天地合一
    m_boDisableHorseInvite := True; // 禁止邀请上马 chongchong 2013-10-16
    if m_GroupOwner = Self then
      CancelGroup; // 解散小组
    if m_boDealing then // 交易中退出挂机
      DealCancel;
    if m_boChallengeing then
      ChallengeCancel();
    m_boShopStall := False;
    FeatureChanged;
    // 禁止离线宝宝
    for Index := m_SlaveList.Count - 1 downto 0 do
    begin
      TBaseObject(m_SlaveList.Items[Index]).MakeGhost;
      TBaseObject(m_SlaveList.Items[Index]).m_WAbil.HP := 0;
    end;
    ClearObject;
    if m_MyHero <> nil then
    begin
      THeroObject(m_MyHero).FollowMaster;
      THeroObject(m_MyHero).m_btAttackMode := 2;
    end
    else if g_Config.boSellPlayerAutoRecallHero then
    begin
      if m_sHeroName <> '' then
      begin
        DataEngine.LoadHeroData(Self, g_FunctionNPC, m_sHeroName, False, 0);
      end;
    end;
{$IF NEED_KEY = 1}
  end
  else
  begin
    Result := 3;
{$IFEND}
  end;
end;

procedure TPlayObject.ClientAddSellPlayer(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  Delegator: string;
  SetUser: string;
  sSendMsg: AnsiString;
  Index, ErrCode: Integer;
  DelegatorPlayer: TPlayObject;
  Info: PSellPlayerInfo;
  AskInfo: TSellPlayerAddAskInfo;
begin
  Delegator := ProcessMsg.sMsg;
  Index := Pos('|', Delegator);
  if Index >= 1 then
  begin
    SetUser := DecodeString(Copy(Delegator, Index + 1, MaxInt));
    Delegator := DecodeString(Copy(Delegator, 1, Index - 1));
  end
  else
  begin
    SetUser := '';
    Delegator := DecodeString(Delegator);
  end;
  if ProcessMsg.nParam1 <= 0 then
  begin
    ErrCode := -1;
    SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, '');
    Exit;
  end;
  if (ProcessMsg.nParam2 < 0) { or (ProcessMsg.nParam2 > 4) } then
  begin
    ErrCode := -2;
    SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, '');
    Exit;
  end;
  if SameText(Delegator, m_sCharName) then
  begin
    ErrCode := -3;
    SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, Delegator);
    Exit;
  end;
  if (ProcessMsg.nParam3 = 1) and (SetUser = '') then
  begin
    ErrCode := -5;
    SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, '');
    Exit;
  end
  else if ProcessMsg.nParam3 = 0 then
  begin
    SetUser := '';
  end;
  if g_SellPlayerList.Search(m_sCharName, Index) then
  begin
    ErrCode := -6;
    SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, '');
    Exit;
  end;
  for Index := 0 to g_SellPlayerList.Count - 1 do
  begin
    Info := g_SellPlayerList.Items[Index];
    if SameText(Info.Delegater, m_sCharName) then
    begin
      ErrCode := -7;
      SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, '');
      Exit;
    end;
  end;
  if ProcessMsg.wParam = 0 then
  begin
    DataEngine.SellPlayerDelegator(Self, m_sUserID, m_sCharName, SetUser, ProcessMsg.nParam2, ProcessMsg.nParam1);
    Exit;
    {
      Delegator := m_sOtherCharName;
      // 检查另一个角色是否存在
      if m_sOtherCharName = '' then
      begin
      ErrCode := -8;
      SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, Delegator);
      Exit;
      end
      else
      begin
      if g_SellPlayerList.Search(Delegator, Index) then
      begin
      ErrCode := -9;
      SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, Delegator);
      Exit;
      end;
      if m_WantAddSellPlayerInfo = nil then
      begin
      New(m_WantAddSellPlayerInfo);
      FillChar(m_WantAddSellPlayerInfo^, SizeOf(TWantAddSellPlayerInfo), 0);
      end;
      m_WantAddSellPlayerInfo.IsMyOtherCharDelegator := True;
      m_WantAddSellPlayerInfo.Delegater := Delegator;
      m_WantAddSellPlayerInfo.SellPricesType := ProcessMsg.nParam2;
      m_WantAddSellPlayerInfo.SellPrices := ProcessMsg.nParam1;
      m_WantAddSellPlayerInfo.IsSetUser := ProcessMsg.nParam3 = 1;
      m_WantAddSellPlayerInfo.SetUserName := SetUser;
      m_WantAddSellPlayerInfo.IsOtherPlayerConfirm := False;
      m_boBreakAddSellPlayer := False;
      if g_FunctionNPC <> nil then
      begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@BeforePlayerSelling', False);
      end;
      if m_boBreakAddSellPlayer then
      begin
      FreeMem(m_WantAddSellPlayerInfo);
      m_WantAddSellPlayerInfo := nil;
      Exit;
      end;
      AskInfo.ChrName := m_sOtherCharName;
      AskInfo.MoneyType := m_WantAddSellPlayerInfo.SellPricesType;
      AskInfo.Prices := m_WantAddSellPlayerInfo.SellPrices;
      sSendMsg := EncodeBuffer(@AskInfo, SizeOf(AskInfo));
      // 询问是否出售
      m_DefMsg := MakeDefaultMsg(SM_ADD_SELL_PLAYER_ASK, 0, 1, 0, 0);    // SM_QUERYUSERSHOPITEMS
      SendSocketEx(@m_DefMsg, @sSendMsg[1], Length(sSendMsg));
      end;
      Exit;
    }
  end
  else
  begin
    if g_SellPlayerList.Search(Delegator, Index) then
    begin
      ErrCode := -9;
      SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, Delegator);
      Exit;
    end;
    DelegatorPlayer := UserEngine.GetPlayObject(Delegator);
    if (DelegatorPlayer = nil) then
    begin
      ErrCode := -4;
      SendDefMessage(SM_ADD_SELL_PLAYER_RET, ErrCode, 0, 0, 0, Delegator);
      Exit;
    end;
    if not DelegatorPlayer.m_boEnableSellPlayerRequest then
    begin
      sSendMsg := StringReplace(g_sSellPlayerDisableDelegate, '%name', Delegator, [rfIgnoreCase]);
      SendDefMessage(SM_DLGMSG, 0, 0, 0, 0, sSendMsg);
      Exit;
    end;
    if m_WantAddSellPlayerInfo = nil then
    begin
      New(m_WantAddSellPlayerInfo);
      FillChar(m_WantAddSellPlayerInfo^, SizeOf(TWantAddSellPlayerInfo), 0);
    end;
    m_WantAddSellPlayerInfo.IsMyOtherCharDelegator := False;
    m_WantAddSellPlayerInfo.Delegater := Delegator;
    m_WantAddSellPlayerInfo.SellPricesType := ProcessMsg.nParam2;
    m_WantAddSellPlayerInfo.SellPrices := ProcessMsg.nParam1;
    m_WantAddSellPlayerInfo.IsSetUser := ProcessMsg.nParam3 = 1;
    m_WantAddSellPlayerInfo.SetUserName := SetUser;
    m_WantAddSellPlayerInfo.IsOtherPlayerConfirm := False;
    m_boBreakAddSellPlayer := False;
    m_boStopBuyUser := False;
    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@BeforePlayerSelling', False);
    end;
    if m_boBreakAddSellPlayer then
    begin
      FreeMem(m_WantAddSellPlayerInfo);
      m_WantAddSellPlayerInfo := nil;
      Exit;
    end;
    DelegatorPlayer.FWantAddSellPlayer := Self;
    AskInfo.ChrName := m_sCharName;
    AskInfo.MoneyType := m_WantAddSellPlayerInfo.SellPricesType;
    AskInfo.Prices := m_WantAddSellPlayerInfo.SellPrices;
    sSendMsg := EncodeBuffer(@AskInfo, SizeOf(AskInfo));
    // 询问是否出售
    m_DefMsg := MakeDefaultMsg(SM_ADD_SELL_PLAYER_ASK, 0, 0, 0, 0); // SM_QUERYUSERSHOPITEMS
    DelegatorPlayer.SendSocketEx(@m_DefMsg, @sSendMsg[1], Length(sSendMsg));
  end;
  // DoAddSellPlayer;
end;

procedure TPlayObject.ClientAddSellPlayerAskRet(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  IsAgree: Boolean; // 是否同意
  IsMyOtherChar: Boolean;
  Player: TPlayObject;
  AskInfo: TSellPlayerAddAskInfo;
  sSendMsg: AnsiString;
begin
  IsAgree := ProcessMsg.wParam = 1;
  IsMyOtherChar := ProcessMsg.nParam2 = 1;
  if IsMyOtherChar then
  begin
    if IsAgree then
    begin
      if (m_WantAddSellPlayerInfo <> nil) and (m_WantAddSellPlayerInfo.IsMyOtherCharDelegator) then
      begin
        DoAddSellPlayer;
      end;
    end;
  end
  else
  begin
    if FWantAddSellPlayer <> nil then // 同意其他朋友的委托
    begin
      Player := UserEngine.GetPlayObject(FWantAddSellPlayer);
      if (Player <> nil) and (Player.m_WantAddSellPlayerInfo <> nil) and
        (not Player.m_WantAddSellPlayerInfo.IsMyOtherCharDelegator) and SameText(Player.m_WantAddSellPlayerInfo.Delegater,
        m_sCharName) then
      begin
        if IsAgree then
        begin
          AskInfo.ChrName := m_sCharName;
          AskInfo.MoneyType := Player.m_WantAddSellPlayerInfo.SellPricesType;
          AskInfo.Prices := Player.m_WantAddSellPlayerInfo.SellPrices;
          Player.m_WantAddSellPlayerInfo.IsOtherPlayerConfirm := True;
          sSendMsg := EncodeBuffer(@AskInfo, SizeOf(AskInfo));
          // 询问是否出售
          m_DefMsg := MakeDefaultMsg(SM_ADD_SELL_PLAYER_ASK_CONFIRM, 0, 0, 0, 0); // SM_QUERYUSERSHOPITEMS
          Player.SendSocketEx(@m_DefMsg, @sSendMsg[1], Length(sSendMsg));
        end
        else
        begin
          Player.SysMsg(m_sCharName + ' 拒绝了你的角色出售委托请求', c_Green, t_Hint);
          FreeMem(Player.m_WantAddSellPlayerInfo);
          Player.m_WantAddSellPlayerInfo := nil;
        end;
      end;
    end;
  end;
  FWantAddSellPlayer := nil;
end;

