procedure TPlayObject.ClientPleaseDrink(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  bo19, bo20: Boolean;
  StdItem: pTStdItem;
  Merchant: TMerchant;
  nNpc, nMakeIndex1, nMakeIndex2: Integer;
begin
  nNpc := ProcessMsg.nParam1;
  nMakeIndex1 := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  nMakeIndex2 := MakeLong(ProcessMsg.wParam, StrToIntDef(DecodeString(ProcessMsg.sMsg), 0));
  if not m_boPleaseDrink then
  begin
    StdItem := nil;
    bo19 := False;
    bo20 := False;
    if (nNpc <> 0) and (nMakeIndex1 <> 0) and (nMakeIndex2 <> 0) then
    begin
      Merchant := UserEngine.FindMerchant(TObject(nNpc));
      if (Merchant <> nil) and (Merchant.m_boPleaseDrink) then
      begin // 请酒NPC
        for I := m_ItemList.Count - 1 downto 0 do
        begin
          if m_ItemList.Count <= 0 then
            Break;
          UserItem := m_ItemList.Items[I];
          if UserItem.MakeIndex = nMakeIndex1 then
          begin
            StdItem := UserEngine.GetStdItem(UserItem.wIndex);
            if StdItem = nil then
              Continue;
            if (StdItem.StdMode = 60) and (StdItem.Shape = 0) then
            begin // 是烧酒
              bo19 := True;
            end;
          end
          else if UserItem.MakeIndex = nMakeIndex2 then
          begin
            if StdItem = nil then
              Continue;
            StdItem := UserEngine.GetStdItem(UserItem.wIndex);
            if (StdItem.StdMode = 60) and (StdItem.Shape = 0) then
            begin // 是烧酒
              bo20 := True;
            end;
          end;
          if bo19 and bo20 then
            Break;
        end; // for I := m_ItemList.Count - 1 downto 0 do begin
      end;
      if bo19 and bo20 then
      begin
        for I := m_ItemList.Count - 1 downto 0 do
        begin // 删除物品
          if m_ItemList.Count <= 0 then
            Break;
          UserItem := m_ItemList.Items[I];
          if (UserItem.MakeIndex = nMakeIndex1) or (UserItem.MakeIndex = nMakeIndex2) then
          begin
            m_ItemList.Delete(I);
            Dispose(UserItem);
          end;
        end;
        m_boPleaseDrink := True; // 是否请过酒
        SendDefMessage(SM_USERPLAYDRINKITEM_OK, 0, 0, 0, 0, '');
        if Merchant <> nil then
          Merchant.GotoLable(Self, '~PlayDrink_Ok', False);
      end
      else
      begin
        SendDefMessage(SM_USERPLAYDRINKITEM_FAIL, 0, 0, 0, 0, '');
      end;
    end;
  end;
end;

procedure TPlayObject.ClientGiveNpcWine(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  Merchant: TMerchant;
  I: Integer;
  UserItem: pTUserItem;
  bo19: Boolean;
  StdItem: pTStdItem;
  nNpc, nMakeIndex: Integer;
begin
  bo19 := False;
  nNpc := ProcessMsg.nParam1;
  nMakeIndex := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  Merchant := UserEngine.FindMerchant(TObject(nNpc));
  if (Merchant <> nil) and (Merchant.m_boPleaseDrink) then
  begin // 请酒斗酒NPC
    StdItem := nil;
    for I := m_ItemList.Count - 1 downto 0 do
    begin
      if m_ItemList.Count <= 0 then
        Break;
      UserItem := m_ItemList.Items[I];
      if UserItem.MakeIndex = nMakeIndex then
      begin
        if StdItem = nil then
          Continue;
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if (StdItem.StdMode = 60) and (StdItem.Shape = 0) then
        begin // 是烧酒
          bo19 := True;
          m_ItemList.Delete(I); // 删除物品
          Dispose(UserItem);
        end;
        Break;
      end;
    end;
  end;
  if bo19 then
  begin
    SendDefMessage(SM_USERPLAYDRINK_OK, 0, 0, 0, 0, '');
    if Merchant <> nil then
      Merchant.GotoLable(Self, '~PlayDrink_Game', False);
  end
  else
    SendDefMessage(SM_USERPLAYDRINK_FAIL, 0, 0, 0, 0, '');
end;

procedure TPlayObject.ClientGuessfinger(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nNpcNum: Byte;
  NPC: TNormNpc;
  nNpc: Integer;
  nPlayNum: Byte;
begin
  nNpc := ProcessMsg.nParam1;
  nPlayNum := ProcessMsg.nParam2;
  m_btGuessfinger := 3; // 猜码结果
  // Randomize(); //随机种子
  nNpcNum := Random(3); // 随机取NPC出码值  //码值:0-石 1-剪刀 2-布
  case nPlayNum of
    0:
      begin
        case nNpcNum of
          0:
            m_btGuessfinger := 2; // 平
          1:
            m_btGuessfinger := 0; // 输
          2:
            m_btGuessfinger := 1; // 赢
        end;
      end;
    1:
      begin
        case nNpcNum of
          0:
            m_btGuessfinger := 1; // 输
          1:
            m_btGuessfinger := 2; // 平
          2:
            m_btGuessfinger := 0; // 赢
        end;
      end;
    2:
      begin
        case nNpcNum of
          0:
            m_btGuessfinger := 0; // 赢
          1:
            m_btGuessfinger := 1; // 输
          2:
            m_btGuessfinger := 2; // 平
        end;
      end;
  end;
  if (m_btGuessfinger < 3) then
  begin // 有了结果,发消息给客户端
    NPC := UserEngine.FindMerchant(TObject(nNpc));
    if NPC = nil then
      NPC := UserEngine.FindNPC(TObject(nNpc));
    if NPC <> nil then
    begin
      case m_btGuessfinger of
        0:
          NPC.GotoLable(Self, '~PlayDrink_PlayWil', False); // 玩家赢
        1:
          NPC.GotoLable(Self, '~PlayDrink_NpcWil', False); // NPC赢
      end;
    end;
    SendMsg(Self, RM_PLAYDRINKTODRINK, 0, nPlayNum, nNpcNum, m_btGuessfinger, '');
  end;
end;

procedure TPlayObject.ClientDrinkUpdateValue(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  NPC: TNormNpc;
  boDrinkLoss: Boolean;
  nNpc: Integer;
  nPlayNum, nCode: Byte;
begin
  nNpc := ProcessMsg.nParam1;
  nPlayNum := ProcessMsg.nParam2;
  nCode := ProcessMsg.nParam3;
  if m_btDrinkCount < 7 then
  begin
    boDrinkLoss := True;
    NPC := UserEngine.FindMerchant(TObject(nNpc));
    if NPC = nil then
      NPC := UserEngine.FindNPC(TObject(nNpc));
    if NPC <> nil then
    begin
      Inc(m_btDrinkCount); // 累积喝酒次数,即喝了几瓶酒
      // Randomize(); //随机种子
      case nCode of
        0:
          begin // NPC胜
            case Random(2) of
              0:
                begin // 玩家喝
                  m_DrinkValue[1] := m_DrinkValue[1] + Random(25) + 8;
                  if m_DrinkValue[1] > 100 then
                    m_DrinkValue[1] := 100;
                  nPlayNum := 0;
                  NPC.GotoLable(Self, '~PlayDrink_NpcToSelf', False);
                end;
              1:
                begin // NPC喝
                  m_DrinkValue[0] := m_DrinkValue[0] + Random(25) + 8;
                  if m_DrinkValue[0] > 100 then
                    m_DrinkValue[0] := 100;
                  nPlayNum := 1;
                  NPC.GotoLable(Self, '~PlayDrink_NpcToNpc', False);
                end;
            end;
          end;
        1:
          begin // 玩家胜
            case nPlayNum of
              0:
                begin // 玩家喝
                  m_DrinkValue[1] := m_DrinkValue[1] + Random(30) + 10;
                  if m_DrinkValue[1] > 100 then
                    m_DrinkValue[1] := 100;
                  NPC.GotoLable(Self, '~PlayDrink_SelfToSelf', False);
                end;
              1:
                begin // NPC喝
                  m_DrinkValue[0] := m_DrinkValue[0] + Random(30) + 10;
                  if m_DrinkValue[0] > 100 then
                    m_DrinkValue[0] := 100;
                  NPC.GotoLable(Self, '~PlayDrink_SelfToNpc', False);
                end;
            end;
          end;
      end; // case nCode of
    end;
    if m_DrinkValue[0] >= 92 then
    begin // NPC喝醉,斗酒失败
      NPC.GotoLable(Self, '~PlayDrink_Npc_Drunk', False);
      boDrinkLoss := False;
    end
    else if m_DrinkValue[1] >= 92 then
    begin // 玩家喝醉
      NPC.GotoLable(Self, '~PlayDrink_Self_Drunk', False);
      boDrinkLoss := False;
    end
    else if m_btDrinkCount = 6 then
    begin // 喝完酒,判断结果
      if m_DrinkValue[0] > m_DrinkValue[1] then // 玩家斗酒胜
        NPC.GotoLable(Self, '~PlayDrink_Npc_Loss', False)
      else
        NPC.GotoLable(Self, '~PlayDrink_Self_Loss', False);
      boDrinkLoss := False;
    end;
    if boDrinkLoss then // 参数0-可以继续喝 1-斗酒结束
      SendMsg(Self, RM_DRINKUPDATEVALUE, 0, nPlayNum, m_DrinkValue[0], m_DrinkValue[1], '')
    else
      SendMsg(Self, RM_DRINKUPDATEVALUE, 1, nPlayNum, m_DrinkValue[0], m_DrinkValue[1], '');
  end;
end;

