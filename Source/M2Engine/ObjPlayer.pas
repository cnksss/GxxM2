procedure TPlayObject.ClientQueryUserState(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserState: TUserStateInfo;
  // OUserState: TOUserStateInfo;
  StdItem: pTStdItem;
  ClientItem: TClientItem;
  // OClientItem: TOClientItem;
  UserItem: pTUserItem;
  // HumFeature:THumFeature;
  sSendMsg: AnsiString;
  SmartObject: TSmartObject;
  BaseObject: TBaseObject;
  nC: Integer;
  InBuf: PAnsiChar;
  InBufMemSize: Integer;
  InBytes: Integer;
  Buffer: PAnsiChar;
  PClientItem: pTClientItem;
begin
  if (m_PEnvir.m_nSecretFlag and SecretFlag_NoViewOtherItem <> 0) //
    or (m_PEnvir.m_nSecretFlag2 and SecretFlag_NoViewOtherItem <> 0) then
  begin
    SysMsg(g_sMapDisableViewOtherItem, c_Red, t_Hint);
    Exit;
  end;

  BaseObject := TBaseObject(ProcessMsg.nParam1);
  if (BaseObject = FLastQueryUser) and (MyGetTickCount - FLastQueryUserTick <= 1000) then
  begin
    Exit;
  end
  else
  begin
    FLastQueryUser := BaseObject;
    FLastQueryUserTick := MyGetTickCount;
  end;
  if not CretInNearXY(BaseObject, ProcessMsg.nParam2, ProcessMsg.nParam3) then
    Exit;
  m_sLastQueryUserName := BaseObject.m_sCharName;
  if g_FunctionNPC <> nil then
  begin
    if (BaseObject.m_btRaceServer = RC_HEROOBJECT) and (BaseObject.m_Master <> nil) and
      (BaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@QueryUserHeroState', False);
      TPlayObject(BaseObject.m_Master).m_sCurrentOperateUserName := m_sCharName;
      TPlayObject(BaseObject.m_Master).m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(TPlayObject(BaseObject.m_Master), '@UserQueryHeroState', False);
      TPlayObject(BaseObject.m_Master).m_sCurrentOperateUserName := '';
    end
    else if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@QueryUserState', False);
      TPlayObject(BaseObject).m_sCurrentOperateUserName := m_sCharName;
      TPlayObject(BaseObject).m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(TPlayObject(BaseObject), '@UserQueryState', False);
      TPlayObject(BaseObject).m_sCurrentOperateUserName := '';
    end
  end;
  FillChar(UserState, SizeOf(TUserStateInfo), #0);
  UserState.RaceServer := BaseObject.m_btRaceServer;
  { if IsOldClient then
    UserState.Feature.Feature := BaseObject.GetFeatureOld(BaseObject)
    else }
  UserState.Feature.Feature := BaseObject.GetFeature(BaseObject, @UserState.Feature.Buffer);
  UserState.NAMECOLOR := GetCharColor(BaseObject);
  // 是否显示神秘人 piaoyun 2013-08-17
  if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and TSmartObject(BaseObject)
    .m_boMysteriousMan and (m_btPermission < 10) and g_Config.boShowMysteriousMan then
  begin
    UserState.UserName := g_Config.sMysteriousManName;
  end
  else
  begin
    UserState.UserName := BaseObject.m_sCharName;
    if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    begin
      if (BaseObject.m_Master <> nil) then
      begin
        UserState.GuildName := BaseObject.m_Master.m_sCharName;
        if g_Config.boHeroShowMasterName and (g_Config.sHeroSuffixName <> '') then
          UserState.GuildRankName := g_Config.sHeroSuffixName
        else
          UserState.GuildRankName := '的英雄';
      end;
    end
    // 人形怪名字后面不要数字显示 chongchong 2015-03-08
    else if (BaseObject.m_btRaceServer = RC_PLAYMOSTER) then
    begin
      // 不是人物或英雄的分身 chongchong 2016-05-12
      if not((BaseObject is TCopyMon) and (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT)) then
      begin
        UserState.UserName := FilterShowName(UserState.UserName);
      end;
    end
    else
    begin
      if BaseObject.m_MyGuild <> nil then
      begin
        UserState.GuildName := TGUild(BaseObject.m_MyGuild).sGuildName;
      end;
      UserState.GuildRankName := BaseObject.m_sGuildRankName;
    end;
  end;
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(BaseObject);
    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      UserItem := @SmartObject.m_UseItems[I];
      if UserItem.wIndex > 0 then
      begin
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem = nil then
          Continue;
        UserItemToClientItem(UserItem, StdItem, @ClientItem, True, False);
        UserState.UseItems[I] := ClientItem;
      end;
    end;
    UserState.JewelryBoxStatus := SmartObject.m_nJewelryBoxStatus;
    // if SmartObject.m_nJewelryBoxStatus = JewelryBoxOpen then
    begin
      for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
      begin
        UserItem := @SmartObject.m_JewelryBoxItems[I];
        if UserItem.wIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if StdItem = nil then
            Continue;
          UserItemToClientItem(UserItem, StdItem, @ClientItem, True, False);
          UserState.JewelryItems[I] := ClientItem;
        end;
      end;
    end;
    UserState.ShowGodBless := SmartObject.m_boShowGodBless;
    Move(SmartObject.m_GodBlessItemsState, UserState.GodBlessItemsState, SizeOf(TGodBlessItemsState));
    for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
    begin
      UserItem := @SmartObject.m_GodBlessItems[I];
      if UserItem.wIndex > 0 then
      begin
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem = nil then
          Continue;
        UserItemToClientItem(UserItem, StdItem, @ClientItem, True, False);
        UserState.GodBlessItems[I] := ClientItem;
      end;
    end;
  end;
  sSendMsg := zLibCompressBuffer(@UserState, SizeOf(TUserStateInfo));
  m_DefMsg := MakeDefaultMsg(SM_SENDUSERSTATE, 0, Length(sSendMsg), 0, 0);
  SendSocket(@m_DefMsg, sSendMsg);
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
  begin
    SmartObject := TSmartObject(BaseObject);
    sSendMsg := '';
    InBytes := 0;
    nC := 0;
    InBufMemSize := SmartObject.m_FengHaoItems.Count * (SizeOf(TClientItem) + 1) + 1;
    try
      GetMem(InBuf, InBufMemSize);
    except
      on E: Exception do
      begin
        MainOutMessage('[Exception] TPlayObject:ClientQueryUserState Error');
        MainOutMessage(E.Message);
        Exit;
      end;
    end;
    try
      for I := 0 to SmartObject.m_FengHaoItems.Count - 1 do
      begin
        UserItem := SmartObject.m_FengHaoItems.Items[I];
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          Inc(nC);
          Inc(InBytes, SizeOf(TClientItem) + 1);
          Buffer := InBuf;
          Buffer := Buffer + (InBytes - (SizeOf(TClientItem) + 1));
          Buffer^ := AnsiChar(I);
          Inc(Buffer);
          PClientItem := pTClientItem(Buffer);
          UserItemToClientItem(UserItem, StdItem, PClientItem, True, False);
        end;
      end;
      sSendMsg := zLibCompressBuffer(InBuf, InBytes);
      m_DefMsg := MakeDefaultMsg(SM_SENDUSERSTATE_FENGHAO, Integer(SmartObject.m_ActiveFengHao), Length(sSendMsg), 0, nC);
      SendSocket(@m_DefMsg, sSendMsg);
    finally
      FreeMem(InBuf, InBufMemSize);
    end;
  end;
end;

procedure TPlayObject.ClientQueryBagItems(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I, nCount: Integer;
  sSendMsg: AnsiString;
  ClientItem: pTClientItem;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  InBuf: PAnsiChar;
  NoMove1_6: Boolean;
  CurPage: Byte;
begin
  // 摆摊中有物品不让刷新 chongchong 2015-05-27
  if m_HeroM2ShopList.Count > 0 then
  begin
    Exit;
  end;
  // 刷新包裹时清OK框物品 chongchong 2015-05-27
  FillChar(m_ItemBoxItems, SizeOf(m_ItemBoxItems), #0);
  m_ItemBoxAddIndex := -1;
  NoMove1_6 := LoByte(ProcessMsg.nParam2) <> 0;
  CurPage := HiByte(ProcessMsg.nParam2);
  if CurPage > m_btExtBagPageCount then
    CurPage := 0;
  sSendMsg := '';
  nCount := 0;
  if (MyGetTickCount - m_dwQueryBagItemsTick > g_Config.nQueryBagItemsTime * 1000) or (not m_boQueryBagItemsOK) then
  begin
    m_dwQueryBagItemsTick := MyGetTickCount;
    GetMem(InBuf, m_ItemList.Count * SizeOf(TClientItem));
    try
      ClientItem := pTClientItem(InBuf);
      for I := 0 to m_ItemList.Count - 1 do
      begin
        UserItem := m_ItemList.Items[I];
        if (UserItem = nil) or (UserItem = m_UpgradeItem) then
          Continue;
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          Inc(nCount);
          UserItemToClientItem(UserItem, StdItem, ClientItem, True, True);
          Inc(ClientItem);
        end;
      end;
      sSendMsg := zLibCompressBuffer(InBuf, nCount * SizeOf(TClientItem));
    finally
      FreeMem(InBuf);
    end;
    m_DefMsg := MakeDefaultMsg(SM_BAGITEMS, MakeLong(MakeWord(Byte(NoMove1_6), m_btExtBagOpenItemCount),
      MakeWord(CurPage, m_btExtBagPageCount)), Length(sSendMsg), 0, nCount);
    SendSocket(@m_DefMsg, sSendMsg);
    if not m_boQueryBagItemsOK then
      m_boQueryBagItemsOK := True
    else
    begin
      if g_Config.boShowRefreshBagMsg then
        SysMsg('包裹刷新成功.', 255, 253, t_Hint);
    end;
  end
  else
  begin
    if g_Config.boShowRefreshBagMsg then
      SysMsg('操作过于频繁，请稍后在试.', 255, 253, t_Hint);
  end;
  if not m_boQueryBagItemsOK then
    m_boQueryBagItemsOK := True;
end;

procedure TPlayObject.ClientQueryHeroBagItems(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  if m_MyHero = nil then
    Exit;
  if (MyGetTickCount - THeroObject(m_MyHero).m_dwQueryBagItemsTick > g_Config.nQueryBagItemsTime * 1000) then
  begin
    THeroObject(m_MyHero).m_dwQueryBagItemsTick := MyGetTickCount;
    FillChar(m_ItemBoxItems, SizeOf(m_ItemBoxItems), #0);
