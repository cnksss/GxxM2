procedure TPlayObject.SysMsg(sMsg: AnsiString; MsgColor: TMsgColor; MsgType: TMsgType; boAddPrefix: Boolean = True);
var
  Color: Word;
begin
  if m_boOffLine or m_boDummyObject then
    Exit; // 修改离线人物不发送

  if m_IsSendUserLogon then
  begin
    if g_Config.boShowPreFixMsg then
    begin
      case MsgType of
        t_Mon:
          sMsg := g_Config.sMonSayMsgpreFix + sMsg;
        t_Hint:
          sMsg := g_Config.sHintMsgPreFix + sMsg;
        t_GM:
          sMsg := g_Config.sGMRedMsgpreFix + sMsg;
        t_System:
          sMsg := g_Config.sSysMsgPreFix + sMsg;
        t_Notice:
          sMsg := g_Config.sLineNoticePreFix + sMsg;
        t_Cust:
          sMsg := g_Config.sCustMsgpreFix + sMsg;
        t_Castle:
          sMsg := g_Config.sCastleMsgpreFix + sMsg;
      end;
    end;

    case MsgColor of
      c_Green:
        Color := MakeWord(g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor);
      c_Blue:
        Color := MakeWord(g_Config.btBlueMsgFColor, g_Config.btBlueMsgBColor);
    else
      if MsgType = t_Cust then
        Color := MakeWord(g_Config.btCustMsgFColor, g_Config.btCustMsgBColor)
      else
        Color := MakeWord(g_Config.btRedMsgFColor, g_Config.btRedMsgBColor);
    end;

    m_DefMsg := MakeDefaultMsg(SM_SYSMESSAGE, NativeInt(Self), Color, 0, 1);
    SendSocket(@m_DefMsg, sMsg);
  end
  else
    inherited SysMsg(sMsg, MsgColor, MsgType, boAddPrefix);
end;

