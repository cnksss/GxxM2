// modify piaoyun 2013-07-19
procedure TPlayObject.GetMapCanRun(var boRunHuman, boRunMon, boRunNpc, boRunGuard: Boolean);
var
  boInSafeZone: Boolean;
  Castle: TUserCastle;
begin
  boRunHuman := False;
  boRunMon := False;
  boRunNpc := False;
  boRunGuard := False;
  // 攻击区全部禁止 2019-04-28 11:37:17
  if (not g_Config.boDiableHumanRun { 允许跑步穿 } ) and g_Config.boWarDisHumRun { 攻城区全部禁止 } then
  begin
    Castle := g_CastleManager.InCastleWarArea(Self);
    // 在攻城区域并且是在攻城状态，全部禁止
    if (Castle <> nil) and (Castle.m_boUnderWar) then
    begin
      Exit;
    end;
  end;

  boInSafeZone := InSafeZone;
  if g_Config.boDiableHumanRun //
    or ((m_btPermission > 9) and g_Config.boGMRunAll) //
    or (g_Config.boSafeAreaLimited and boInSafeZone) then
  begin
    boRunHuman := not m_PEnvir.m_boNoRunHuman;
    boRunMon := not m_PEnvir.m_boNoRunMon;
    if boInSafeZone then
    begin
      if (not g_Config.boSafeAreaDisNpcRun) or ((m_btPermission > 9) and g_Config.boGMRunAll) then
        boRunNpc := True
      else
        boRunNpc := False;
    end
    else
      boRunNpc := True;
    // nWarRunAll := True;
    boRunGuard := True;
  end
  else
  begin
    // 地图参数-禁止穿人 chongchong 2016-09-06
    boRunHuman := (g_Config.boRunHuman or m_PEnvir.m_boRUNHUMAN or m_boRUNHUMAN) and (not m_PEnvir.m_boNoRunHuman);
    // 地图参数-禁止穿怪 chongchong 2016-09-06
    boRunMon := (g_Config.boRunMon or m_PEnvir.m_boRUNMON or m_boRUNMON) and (not m_PEnvir.m_boNoRunMon);
    boRunNpc := g_Config.boRunNpc;
    boRunGuard := g_Config.boRunGuard;
  end;
end;

