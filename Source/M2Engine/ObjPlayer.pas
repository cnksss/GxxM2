procedure TPlayObject.ClientGuildViewMemberInfo(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 查看行会成员信息
var
  nCode, nRankNo: Integer;
  Player: TPlayObject;
  UserName: string;
  Master1, Master2: string;
  S: AnsiString;
  MemberInfo: TGuildMemeberInfo;
begin
  nCode := 0;
  UserName := DecodeString(ProcessMsg.sMsg);
  S := ProcessMsg.sMsg;

  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    nCode := 1
  else if Length(UserName) = 0 then
    nCode := 2
  else
  begin
    TGUild(m_MyGuild).GetGuildMasterName(Master1, Master2);
    Player := UserEngine.GetPlayObject(UserName);
    if Player <> nil then
    begin
      MemberInfo.sName := UserName;
      MemberInfo.boOnline := not Player.m_boOffLine;
      MemberInfo.btSex := Player.m_btGender;
      MemberInfo.btJob := Player.m_btJob;
      MemberInfo.nLevel := Player.m_Abil.Level;
      MemberInfo.dtLastLogin := Now;
      MemberInfo.boMaster := SameText(Master1, UserName) or SameText(Master2, UserName);
      MemberInfo.nRankName := TGUild(m_MyGuild).GetRankName(UserName, nRankNo);
      m_DefMsg := MakeDefaultMsg(SM_GUILDVIEWMEMBERINFO_RET, nCode, SizeOf(TGuildMemeberInfo), 0, 0);
      SendSocketEx(@m_DefMsg, @MemberInfo, SizeOf(TGuildMemeberInfo));
      Exit;
    end
    else
    begin
      DataEngine.QueryHumanInfo(Self, nil, UserName, qhiGuildMemberInfo);
      Exit;
    end;
  end;

  if nCode <> 0 then
  begin
    m_DefMsg := MakeDefaultMsg(SM_GUILDVIEWMEMBERINFO_RET, nCode, Length(S), 0, 0);
    SendSocket(@m_DefMsg, S);
  end;
end;

procedure TPlayObject.ClientGuildSetMaster1(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 转让正会长
var
  nC, nRankNo, I: Integer;
  UserName, Master1, Master2: string;
  Player: TPlayObject;
  GuildRank: pTGuildRank;
begin
  nC := 0;
  UserName := DecodeString(ProcessMsg.sMsg);
  if SameText(m_sCharName, UserName) then
    nC := 1
  else if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    nC := 2
  else
  begin
    TGUild(m_MyGuild).GetGuildMasterName(Master1, Master2);
    if not SameText(m_sCharName, Master1) then
      nC := 3
    else if TGUild(m_MyGuild).GetRankName(UserName, nRankNo) = '' then
      nC := 4
    else
    begin
      Player := UserEngine.GetPlayObject(UserName);
      for I := 0 to TGUild(m_MyGuild).m_RankList.Count - 1 do
      begin
        GuildRank := TGUild(m_MyGuild).m_RankList.Items[I];

        if (GuildRank.nRankNo = 1) and TGUild(m_MyGuild).DelMember(UserName) then
        begin
          GuildRank.MemberList.Delete(0);
          GuildRank.MemberList.InsertObject(0, UserName, Player);
          Break;
        end;
      end;

      if Player <> nil then
      begin
        Player.m_sGuildRankName := TGUild(m_MyGuild).GetRankName2(Player, Player.m_nGuildRankNo);
        Player.RefShowName();
      end;

      // 把自己改到 所有成员 下
      TGUild(m_MyGuild).AddMember(Self);
      m_sGuildRankName := TGUild(m_MyGuild).GetRankName2(Self, m_nGuildRankNo);
      RefShowName();
    end;
  end;

  if nC = 0 then
    ClientGuildMemberList(ProcessMsg, boResult);
  SendDefMessage(SM_GUILDSETMASTER1_RET, nC, 0, 0, 0, UserName);
end;

procedure TPlayObject.ClientGuildChangeAlly(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 修改是否允许联盟
var
  nC: Integer;
begin
  nC := 0;
  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    SendDefMessage(SM_GUILDCHANGEALLY_FAIL, nC, 0, 0, 0, '')
  else
    TGUild(m_MyGuild).EnabledAlly := ProcessMsg.wParam = 1;
end;

procedure TPlayObject.ClientGuildAddGuildWar(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 行会宣战
var
  Guild: TGUild;
  nC: Integer;
  GuildName: string;
begin
  nC := 0;
  GuildName := DecodeString(ProcessMsg.sMsg);
  Guild := g_GuildManager.FindGuild(GuildName);

  if (m_MyGuild = nil) or (m_nGuildRankNo <> 1) then
    nC := 1
  else if Guild = nil then
    nC := 2
  else if TGUild(m_MyGuild).IsAllyGuild(Guild) then
    nC := 3
  else if nServerIndex <> 0 then
    nC := 4
  else if TGUild(m_MyGuild).IsWarGuild(Guild) { and Guild.IsWarGuild(TGUild(m_MyGuild)) } then
    nC := 5
  else if m_MyGuild = Guild then
    nC := 7
  else
  begin
    if m_nGold < g_Config.nGuildWarPrice then
    begin
      nC := 6;
    end
    else
    begin
      if DecGold(g_Config.nGuildWarPrice) then
        GoldChanged();

      if not ReQuestGuildWar(GuildName) then
        nC := 7;
    end;
  end;

  SendDefMessage(SM_GuildAddGuildWar_RET, nC, 0, 0, 0, GuildName);
end;

procedure TPlayObject.ClientAdjustBonus(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  BonusAbil: TNakedAbility;
  nOldBonusPoint: Integer;
  nTotleUsePoint: Int64;
  // m_nTotleUsePoint: Integer;
begin
  FillChar(BonusAbil, SizeOf(TNakedAbility), #0);
  DecodeString(ProcessMsg.sMsg, @BonusAbil, SizeOf(TNakedAbility));
  if (BonusAbil.DC < 0) or (BonusAbil.DC > m_nBonusPoint) or (BonusAbil.MC < 0) or (BonusAbil.MC > m_nBonusPoint) or
    (BonusAbil.SC < 0) or (BonusAbil.SC > m_nBonusPoint) or (BonusAbil.AC < 0) or (BonusAbil.AC > m_nBonusPoint) or
    (BonusAbil.MAC < 0) or (BonusAbil.MAC > m_nBonusPoint) or (BonusAbil.HP < 0) or (BonusAbil.HP > m_nBonusPoint) or
    (BonusAbil.MP < 0) or (BonusAbil.MP > m_nBonusPoint) or (BonusAbil.Hit < 0) or (BonusAbil.Hit > m_nBonusPoint) or
    (BonusAbil.Speed < 0) or (BonusAbil.Speed > m_nBonusPoint) or (BonusAbil.X2 < 0) or (BonusAbil.X2 > m_nBonusPoint) then
  begin
    SysMsg('非法数据调整！', c_Red, t_Hint);
    Exit;
  end;

  nTotleUsePoint := Int64(BonusAbil.DC) + BonusAbil.MC + BonusAbil.SC + BonusAbil.AC + BonusAbil.MAC + BonusAbil.HP + BonusAbil.MP
    + BonusAbil.Hit + BonusAbil.Speed + BonusAbil.X2;
  if (Int64(ProcessMsg.nParam1) + nTotleUsePoint = m_nBonusPoint) and (m_nBonusPoint >= 0) and (ProcessMsg.nParam1 >= 0) and
    (m_nBonusPoint >= ProcessMsg.nParam1) then
  begin
    if nTotleUsePoint > 0 then
    begin
      nOldBonusPoint := m_nBonusPoint;
      m_nBonusPoint := ProcessMsg.nParam1;
      Inc(m_BonusAbil.DC, BonusAbil.DC);
      Inc(m_BonusAbil.MC, BonusAbil.MC);
      Inc(m_BonusAbil.SC, BonusAbil.SC);
      Inc(m_BonusAbil.AC, BonusAbil.AC);
      Inc(m_BonusAbil.MAC, BonusAbil.MAC);
      Inc(m_BonusAbil.HP, BonusAbil.HP);
      Inc(m_BonusAbil.MP, BonusAbil.MP);
      Inc(m_BonusAbil.Hit, BonusAbil.Hit);
      Inc(m_BonusAbil.Speed, BonusAbil.Speed);
      Inc(m_BonusAbil.X2, BonusAbil.X2);
      RecalcAbilitys();
      SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
      SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
      SendAdjustBonus;
      AddGameDataLog(LOG_AbilPointChange, LOG_ActionNone, Self, '使用属性点', 0, '0', m_nBonusPoint, nOldBonusPoint,
        Format('%d:%d:%d:%d:%d:%d:%d:%d:%d:%d', [BonusAbil.DC, BonusAbil.MC, BonusAbil.SC, BonusAbil.AC, BonusAbil.MAC,
        BonusAbil.HP, BonusAbil.MP, BonusAbil.Hit, BonusAbil.Speed, BonusAbil.X2]));
    end;
  end
  else
  begin
    SysMsg('非法数据调整！', c_Red, t_Hint);
  end;
end;

procedure TPlayObject.ClientPassWord(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nLen: Integer;
  sData: string;
begin
  if ProcessMsg.wParam = 0 then
  begin
    ProcessUserLineMsg(Self, '@' + g_GameCommand.UnLock.sCmd);
    Exit;
  end;

  sData := ProcessMsg.sMsg;
  nLen := Length(sData);
  if m_boSetStoragePwd then
  begin
    m_boSetStoragePwd := False;
    if (nLen > 3) and (nLen < 8) then
    begin
      m_sTempPwd := sData;
      m_boReConfigPwd := True;
      SysMsg(g_sReSetPasswordMsg, c_Green, t_Hint); { '请重复输入一次仓库密码：' }
      SendMsg(Self, RM_PASSWORD, 0, 0, 0, 0, '');
    end
    else
    begin
      SysMsg(g_sPasswordOverLongMsg, c_Red, t_Hint); { '输入的密码长度不正确！，密码长度必须在 4 - 7 的范围内，请重新设置密码。' }
    end;
    Exit;
  end;

  if m_boReConfigPwd then
  begin
    m_boReConfigPwd := False;
    if CompareStr(m_sTempPwd, sData) = 0 then
    begin
      m_sStoragePwd := sData;
      m_boPasswordLocked := True;
      m_sTempPwd := '';
      SysMsg(g_sReSetPasswordOKMsg, c_Blue, t_Hint); { '密码设置成功！！，仓库已经自动上锁，请记好您的仓库密码，在取仓库时需要使用此密码开锁。' }
    end
    else
    begin
      m_sTempPwd := '';
      SysMsg(g_sReSetPasswordNotMatchMsg, c_Red, t_Hint);
    end;
    Exit;
  end;

  if m_boUnLockPwd or m_boUnLockStoragePwd then
  begin
    if CompareStr(m_sStoragePwd, sData) = 0 then
    begin
      m_boPasswordLocked := False;
      if m_boUnLockPwd then
      begin
        if g_Config.boLockDealAction then
          m_boCanDeal := True;
        if g_Config.boLockDropAction then
          m_boCanDrop := True;
        if g_Config.boLockWalkAction then
          m_boCanWalk := True;
        if g_Config.boLockRunAction then
          m_boCanRun := True;
        if g_Config.boLockHitAction then
          m_boCanHit := True;
        if g_Config.boLockSpellAction then
          m_boCanSpell := True;
        if g_Config.boLockSendMsgAction then
          m_boCanSendMsg := True;
        if g_Config.boLockUserItemAction then
          m_boCanUseItem := True;
        if g_Config.boLockInObModeAction then
        begin
          m_boObMode := False;
          m_boAdminMode := False;
        end;
        m_boLockLogoned := True;
        SysMsg(g_sPasswordUnLockOKMsg, c_Blue, t_Hint);
      end;
      if m_boUnLockStoragePwd then
      begin
        if g_Config.boLockGetBackItemAction then
          m_boCanGetBackItem := True;
        SysMsg(g_sStorageUnLockOKMsg, c_Blue, t_Hint);
      end;
    end
    else
    begin
      Inc(m_btPwdFailCount);
      SysMsg(g_sUnLockPasswordFailMsg, c_Red, t_Hint);
      if m_btPwdFailCount > 3 then
      begin
        SysMsg(g_sStoragePasswordLockedMsg, c_Red, t_Hint);
      end;
    end;
    m_boUnLockPwd := False;
    m_boUnLockStoragePwd := False;
    Exit;
  end;

  if m_boCheckOldPwd then
  begin
    m_boCheckOldPwd := False;
    if m_sStoragePwd = sData then
    begin
      SendMsg(Self, RM_PASSWORD, 0, 0, 0, 0, '');
      SysMsg(g_sSetPasswordMsg, c_Green, t_Hint);
      m_boSetStoragePwd := True;
    end
    else
    begin
      Inc(m_btPwdFailCount);
      SysMsg(g_sOldPasswordIncorrectMsg, c_Red, t_Hint);
      if m_btPwdFailCount > 3 then
      begin
        SysMsg(g_sStoragePasswordLockedMsg, c_Red, t_Hint);
        m_boPasswordLocked := True;
      end;
    end;
  end;
end;

