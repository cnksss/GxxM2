procedure TPlayObject.ClientQuerySelectHeroM2ShopInfo(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I, II: Integer;
  BaseObject: TBaseObject;
  OnlineObject: TPlayObject;
  TempPlayer: TPlayObject;
  UserItem: pTUserItem;
  HeroM2ShopItemInfo: pTHeroM2ShopItemInfo;
  ClientItem: TClientItem;
  StdItem: pTStdItem;
  sText: string;
begin
  if MyGetTickCount - m_dwQueryUserShopTime < 100 then
    Exit;
  m_dwQueryUserShopTime := MyGetTickCount;
  BaseObject := TBaseObject(ProcessMsg.nParam1);
  if BaseObject <> nil then
  begin
    if not m_PEnvir.IsValidObjectEx(m_nCurrX, m_nCurrY, 10, BaseObject) then
      BaseObject := nil;
  end;
  if (BaseObject <> nil) and (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
    OnlineObject := BaseObject as TPlayObject
  else
    OnlineObject := nil;
  if (OnlineObject <> nil) and OnlineObject.m_boShopStall then
  begin
    sText := OnlineObject.m_sCharName + '\';
    if OnlineObject <> Self then
    begin
      if not SameText(m_sCurOpenUserHeroM2Shop, OnlineObject.m_sCharName) then
      begin
        if Length(m_sCurOpenUserHeroM2Shop) > 0 then
        begin
          TempPlayer := UserEngine.GetPlayObject(m_sCurOpenUserHeroM2Shop);
          if TempPlayer <> nil then
          begin
            TempPlayer.m_HeroM2ShopList.Remove(Self);
          end;
        end;
        m_sCurOpenUserHeroM2Shop := OnlineObject.m_sCharName;
      end;
      if OnlineObject.m_HeroM2ShopOpenList.IndexOf(Self) < 0 then
        OnlineObject.m_HeroM2ShopOpenList.Add(Self);
      for I := 0 to OnlineObject.m_HeroM2ShopList.Count - 1 do
      begin
        HeroM2ShopItemInfo := OnlineObject.m_HeroM2ShopList.Items[I];
        for II := 0 to OnlineObject.m_ItemList.Count - 1 do
        begin
          UserItem := OnlineObject.m_ItemList.Items[II];
          if HeroM2ShopItemInfo.nMakeIndex = UserItem.MakeIndex then
          begin
            StdItem := UserEngine.GetStdItem(UserItem.wIndex);
            if StdItem <> nil then
            begin
              UserItemToClientItem(UserItem, StdItem, @ClientItem, True, True);
            end;
            ClientItem.S.Price := HeroM2ShopItemInfo.nPrice;
            ClientItem.S.Reserved1 := HeroM2ShopItemInfo.nMoneyType; // 需要元宝还是金币
            ClientItem.S.Stock := HeroM2ShopItemInfo.dwAddTick;
            sText := sText + EncodeBuffer(@ClientItem, SizeOf(TClientItem)) + '/';
            Break;
          end;
        end;
      end;
    end;
    m_DefMsg := MakeDefaultMsg(SM_HEROM2SENDSHOPITEM, NativeInt(OnlineObject), 0, 0, 0);
    SendSocket(@m_DefMsg, sText);
  end;
end;

// 开始摆摊函数 piaoyun 2013-07-21
procedure TPlayObject.ServerSendHeroM2StartShopStall(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  if g_OnlineMsgControl.boDisableSell then
    Exit;
  { TODO -ochongchong -c新增 : 密码保护系统 - 系统锁定时，根据选项来控制是否禁止摆摊 【2013-07-22】 }
  if m_boLockLogon and m_boPasswordLocked and g_Config.boLockStall then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
    Exit;
  end;
  // 是否开启摆摊 piaoyun 2013-07-21
  if not g_Config.boOpenSelfShop then
  begin
    FeatureChanged();
    SysMsg('服务器暂时关闭摆摊功能！', c_Red, t_Hint);
    Exit;
  end;
  // 只允许安全区摆摊 piaoyun 2013-07-21
  if g_Config.boSafeZoneShop and not InSafeZone then
  begin
    FeatureChanged();
    SysMsg('不能在安全区以外的地方进行摆摊！', c_Red, t_Hint);
    Exit;
  end;
  // 只允许指定地图摆摊 piaoyun 2013-07-21
  if g_Config.boMapShop and not m_PEnvir.m_boAllowUseMyshop then
  begin
    FeatureChanged();
    SysMsg('本地图禁止摆摊！', c_Red, t_Hint);
    Exit;
  end;
  // 骑马 chongchong 2013-10-12
  if m_boOnHorse then
  begin
    FeatureChanged();
    SysMsg('请先下马！', c_Red, t_Hint);
    Exit;
  end;
  // 变身后 2020-08-22 12:24:05
  if m_nChangeAppr >= 0 then
  begin
    SysMsg('变身状态不允许摆摊！', c_Red, t_Hint);
    Exit;
  end;
  if m_boShopStall then
  begin
    FeatureChanged();
    SysMsg('您已经在摆摊了！', 255, 253, t_Hint);
    Exit;
  end;
  if Tick_Diff(m_dwHeroM2ShopStallTime, MyGetTickCount) <= 200 then
  begin
    SysMsg('操作过快！', 255, 253, t_Hint);
    Exit;
  end;
  m_dwHeroM2ShopStallTime := MyGetTickCount;
  // 开始摆摊
  if m_HeroM2ShopList.Count > 0 then
  begin
    StopCollect;
    m_boShopStall := True;
    if m_TargetCret <> nil then
    begin
      if m_TargetCret.m_TargetCret = Self then
        m_TargetCret.DelTargetCreat;
      m_TargetCret := nil;
    end;
    g_FunctionNPC.GotoLable(Self, '@StartMyShop', False);
    if m_boShopStall then
    begin
      // 当摆摊名字为空时，也刷到客户端 chongchong 2015-11-13
      // if m_sShopName <> '' then
      SendRefMsg(RM_SENDSHOPNAME, 0, NativeInt(Self), 0, 0, m_sShopName);
      FeatureChanged;
    end;
  end;
end;

procedure TPlayObject.ServerSendHeroM2StopShopStall(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 停止摆摊
var
  I, II: Integer;
  UserItem: pTUserItem;
  HeroM2ShopItemInfo: pTHeroM2ShopItemInfo;
begin
  if m_boShopStall then
  begin
    if Tick_Diff(m_dwHeroM2ShopStallTime, MyGetTickCount) <= 200 then
    begin
      SysMsg('操作过快！', 255, 253, t_Hint);
      Exit;
    end;
    m_dwHeroM2ShopStallTime := MyGetTickCount;
    for I := 0 to m_HeroM2ShopList.Count - 1 do
    begin
      HeroM2ShopItemInfo := m_HeroM2ShopList.Items[I];
      for II := 0 to m_ItemList.Count - 1 do
      begin
        UserItem := m_ItemList.Items[II];
        if HeroM2ShopItemInfo.nMakeIndex = UserItem.MakeIndex then
        begin
          SendUpdateItem(UserItem);
          Break;
        end;
      end;
      Dispose(HeroM2ShopItemInfo);
    end;
    m_HeroM2ShopList.Clear;
    m_boShopStall := False;
    FeatureChanged;
    g_FunctionNPC.GotoLable(Self, '@StopMyShop', False);
  end;
end;

procedure TPlayObject.ServerSendHeroM2BuyUserItem(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 购买摆摊物品
  function CheckGameMoney(ShopItem: pTHeroM2ShopItemInfo): Boolean;
  begin
    case ShopItem.nMoneyType of
      0:
        Result := m_nGameGold >= ShopItem.nPrice; // 游戏币
      1:
        Result := m_nGamePoint >= ShopItem.nPrice; // 游戏点
      2:
        Result := m_nGold >= ShopItem.nPrice; // 金币数量
      3:
        Result := m_nGameDiamond >= ShopItem.nPrice; // 金刚石
      4:
        Result := m_nGameGird >= ShopItem.nPrice; // 灵符
    else
      Result := CheckMoney(ShopItem.nMoneyType - 5, ShopItem.nPrice);
    end;
  end;
  procedure DecGameMoney(ShopItem: pTHeroM2ShopItemInfo; ShopUserName: string);
  var
    nValue: Integer;
  begin
    case ShopItem.nMoneyType of
      0:
        begin
          // OldValue := m_nGameGold;
          DecGameGold(ShopItem.nPrice);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GameGoldChange, Self, g_Config.sGameGoldName, ShopItem.nMakeIndex, ShopUserName,
              m_nGameGold, -ShopItem.nPrice, '摆摊');
          end;
        end;
      1: // 排除
        begin
          // OldValue := m_nGamePoint;
          DecGamePoint(ShopItem.nPrice);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GamePointChange, Self, g_Config.sGamePointName, ShopItem.nMakeIndex,
              ShopUserName, m_nGamePoint, -ShopItem.nPrice, '摆摊');
          end;
        end;
      2:
        begin
          // OldValue := m_nGold;
          if DecGold(ShopItem.nPrice) then
            GoldChanged;

          if g_boGameLogGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GoldChange, Self, sSTRING_GOLDNAME, ShopItem.nMakeIndex, ShopUserName, m_nGold,
              -ShopItem.nPrice, '摆摊');
          end;
        end;
      3:
        begin
          // OldValue := m_nGameDiamond;
          DecGameDiamond(ShopItem.nPrice);
          NewGamePointChanged();
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GameDiamondChange, Self, g_Config.sGameDiamondName, ShopItem.nMakeIndex,
              ShopUserName, m_nGameDiamond, -ShopItem.nPrice, '摆摊');
          end;
        end;
      4:
        begin
          // OldValue := m_nGameGird;
          DecGameGird(ShopItem.nPrice);
          NewGamePointChanged();
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemBuyPrice, LOG_GameGirdChange, Self, g_Config.sGameGirdName, ShopItem.nMakeIndex, ShopUserName,
              m_nGameGird, -ShopItem.nPrice, '摆摊');
          end;
        end;
    else
      DecMoney(ShopItem.nMoneyType - 5, ShopItem.nPrice, nValue);
    end;
  end;
  procedure IncGameMoney(ShopItem: pTHeroM2ShopItemInfo; SellUser: TPlayObject;
    var nTGameGoldCount, nTGamePointCount, nTGoldCount, nTGameDiamondCount, nTGameGirdCount, nTCustomMoneyCount: Integer);
  var
    nValue: Integer;
  begin
    case ShopItem.nMoneyType of
      0:
        begin
          // OldValue := m_nGameGold;
          // 离线购买物品、上线后取款扣税 piaoyun 2013-07-21
          nTGameGoldCount := Trunc(g_Config.dwSellOffGameGoldTaxRate / 100 * ShopItem.nPrice);
          SellUser.IncGameGold(ShopItem.nPrice - nTGameGoldCount);
          SellUser.GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GameGoldChange, SellUser, g_Config.sGameGoldName, ShopItem.nMakeIndex, m_sCharName,
              SellUser.m_nGameGold, ShopItem.nPrice - nTGameGoldCount, '摆摊');
          end;
        end;
      1:
        begin
          // OldValue := m_nGamePoint;
          nTGamePointCount := Trunc(g_Config.dwSellOffGamePointTaxRate / 100 * ShopItem.nPrice);
          SellUser.IncGamePoint(ShopItem.nPrice - nTGamePointCount);
          SellUser.GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GamePointChange, SellUser, g_Config.sGamePointName, ShopItem.nMakeIndex, m_sCharName,
              SellUser.m_nGamePoint, ShopItem.nPrice - nTGamePointCount, '摆摊');
          end;
        end;
      2:
        begin
          // OldValue := m_nGold;
          nTGoldCount := Trunc(g_Config.dwSellOffGoldTaxRate / 100 * ShopItem.nPrice);
          if SellUser.IncGold(ShopItem.nPrice - nTGoldCount) then
            SellUser.GoldChanged;

          if g_boGameLogGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GoldChange, SellUser, sSTRING_GOLDNAME, ShopItem.nMakeIndex, m_sCharName,
              SellUser.m_nGold, ShopItem.nPrice - nTGoldCount, '摆摊');
          end;
        end;
      3:
        begin
          // OldValue := m_nGameDiamond;
          nTGameDiamondCount := Trunc(g_Config.dwSellOffGameDiamondTaxRate / 100 * ShopItem.nPrice);
          SellUser.IncGameDiamond(ShopItem.nPrice - nTGameDiamondCount);
          SellUser.NewGamePointChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GameDiamondChange, SellUser, g_Config.sGameDiamondName, ShopItem.nMakeIndex,
              m_sCharName, SellUser.m_nGameDiamond, ShopItem.nPrice - nTGameDiamondCount, '摆摊');
          end;
        end;
      4:
        begin
          // OldValue := m_nGameGird;
          nTGameGirdCount := Trunc(g_Config.dwSellOffGameGirdTaxRate / 100 * ShopItem.nPrice);
          SellUser.IncGameGird(ShopItem.nPrice - nTGameGirdCount);
          SellUser.NewGamePointChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_ItemSell, LOG_GameGirdChange, SellUser, g_Config.sGameGirdName, ShopItem.nMakeIndex, m_sCharName,
              SellUser.m_nGameGird, ShopItem.nPrice - nTGameGirdCount, '摆摊');
          end;
        end;
    else
      nTCustomMoneyCount := 0; // ShopItem.nPrice;
      SellUser.IncMoney(ShopItem.nMoneyType - 5, ShopItem.nPrice - nTCustomMoneyCount, nValue);
    end;
  end;

var
  I, nMakeIndex: Integer;
  UserItem: pTUserItem;
  ShopItem: pTUserItem;
  OnlineObject: TPlayObject;
  HeroM2ShopItemInfo: pTHeroM2ShopItemInfo;
  nTGameGoldCount, nTGamePointCount, nTGoldCount, nTGameDiamondCount, nTGameGirdCount, nTCustomMoneyCount: Integer;
  nDecMoney: Integer;
  MoneyName: string;
  AddItemTick: LongWord;
begin
  if g_OnlineMsgControl.boDisableBuy then
    Exit;
  if g_OnlineMsgControl.boDisableSell then
    Exit;
  OnlineObject := UserEngine.GetPlayObject(TPlayObject(ProcessMsg.nParam1));
  if (OnlineObject = nil) or (not OnlineObject.m_boShopStall) then
  begin
    SendDefMessage(SM_HEROM2SENDCLOSESHOP, ProcessMsg.nParam1, 0, 0, 0, '');
    // SysMsg('对方没有在摆摊！', 255, 253, t_Hint);
    Exit;
  end;
  nMakeIndex := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  ShopItem := nil;
  HeroM2ShopItemInfo := nil;
  AddItemTick := StrToIntDef(DecodeString(ProcessMsg.sMsg), 0);
  for I := 0 to OnlineObject.m_HeroM2ShopList.Count - 1 do
  begin
    if pTHeroM2ShopItemInfo(OnlineObject.m_HeroM2ShopList.Items[I]).nMakeIndex = nMakeIndex then
    begin
      HeroM2ShopItemInfo := OnlineObject.m_HeroM2ShopList.Items[I];
      Break;
    end;
  end;
  if HeroM2ShopItemInfo <> nil then
  begin
    for I := 0 to OnlineObject.m_ItemList.Count - 1 do
    begin
      UserItem := OnlineObject.m_ItemList.Items[I];
      if UserItem.MakeIndex = nMakeIndex then
      begin
        ShopItem := UserItem;
        Break;
      end;
    end;
  end;
  if not((HeroM2ShopItemInfo <> nil) and (ShopItem <> nil) and (HeroM2ShopItemInfo.nPrice >= 0)) then
  begin
    SendDefMessage(SM_HEROM2DELREMOTEUSERSHOPITEM, nMakeIndex, 0, 0, 0, ''); // 删除摆摊物品
    SysMsg('你要购买的物品不存在！', 255, 253, t_Hint);
    Exit;
  end;
  if (HeroM2ShopItemInfo.dwAddTick <> AddItemTick) then
  begin
    SysMsg('物品已经更新，请重新打开后再购买', 255, 253, t_Hint);
    Exit;
  end;
  if not IsEnoughBag() then
  begin
    SysMsg('包裹已满，无法购买！', 255, 253, t_Hint);
    Exit;
  end;
  MoneyName := '';
  case HeroM2ShopItemInfo.nMoneyType of
    0:
      MoneyName := g_Config.sGameGoldName;
    1:
      MoneyName := g_Config.sGamePointName;
    2:
      MoneyName := sSTRING_GOLDNAME;
    3:
      MoneyName := g_Config.sGameDiamondName;
    4:
      MoneyName := g_Config.sGameGirdName;
  else
    MoneyName := GetCustomMoneyNameByRule(HeroM2ShopItemInfo.nMoneyType, 0);
  end;
  if not CheckGameMoney(HeroM2ShopItemInfo) then
  begin
    SysMsg(MoneyName + '不足，无法购买！', 255, 253, t_Hint);
    Exit;
  end;

  DecGameMoney(HeroM2ShopItemInfo, OnlineObject.m_sCharName);
  IncGameMoney(HeroM2ShopItemInfo, OnlineObject, nTGameGoldCount, nTGamePointCount, nTGoldCount, nTGameDiamondCount,
    nTGameGirdCount, nTCustomMoneyCount);

  case HeroM2ShopItemInfo.nMoneyType of
    0:
      nDecMoney := nTGameGoldCount;
    1:
      nDecMoney := nTGamePointCount;
    2:
      nDecMoney := nTGoldCount;
    3:
      nDecMoney := nTGameDiamondCount;
    4:
      nDecMoney := nTGameGirdCount;
  else
    nDecMoney := nTCustomMoneyCount;
  end;
  m_ItemList.Add(ShopItem);
  SendAddItem(ShopItem);
  SendDefMessage(SM_HEROM2DELREMOTEUSERSHOPITEM, nMakeIndex, 0, 0, 0, ''); // 删除摆摊物品
  OnlineObject.SendDefMessage(SM_HEROM2DELUSERSHOPITEM, nMakeIndex, 0, 0, 0, ''); // 删除摆摊物品
  if (g_FunctionNPC <> nil) then
  begin
    m_nCurrentItemMakeIndex := ShopItem.MakeIndex;
    m_sCurrentItemName := UserEngine.GetStdItemName(ShopItem.wIndex);
    if (ShopItem.btValue[13] = 1) and (ShopItem.Name <> '') then
      m_sCurrentItemNewName := ShopItem.Name
    else
      m_sCurrentItemNewName := UserEngine.GetStdItemName(ShopItem.wIndex);
    m_btCurItemMoneyTypeValue := HeroM2ShopItemInfo.nMoneyType;
    case HeroM2ShopItemInfo.nMoneyType of
      0:
        m_sCurItemMoneyType := g_Config.sGameGoldName;
      1:
        m_sCurItemMoneyType := g_Config.sGamePointName;
      2:
        m_sCurItemMoneyType := sSTRING_GOLDNAME;
      3:
        m_sCurItemMoneyType := g_Config.sGameDiamondName;
      4:
        m_sCurItemMoneyType := g_Config.sGameGirdName;
    else
      MoneyName := GetCustomMoneyNameByRule(HeroM2ShopItemInfo.nMoneyType, 0);
    end;
    m_nCurItemPrices := HeroM2ShopItemInfo.nPrice;
    m_sCurrentOperateUserName := OnlineObject.m_sCharName;
    g_FunctionNPC.GotoLable(Self, '@HeroM2BuyUserItem', False);
    m_nCurrentItemMakeIndex := 0;
    m_sCurrentItemName := '';
    m_sCurrentItemNewName := '';
    m_btCurItemMoneyTypeValue := 0;
    m_sCurItemMoneyType := '';
    m_nCurItemPrices := 0;
    m_sCurrentOperateUserName := '';
  end;
  // OnlineObject.SysMsg(m_sCharName + '购买了你的' + UserEngine.GetStdItemName(ShopItem.wIndex), 255, 252, t_Hint);
  // 给买家发信息  piaoyun 2013-07-21
  SysMsg(Format(g_sHeroM2BuyerMsg, [OnlineObject.m_sCharName, UserEngine.GetStdItemName(ShopItem.wIndex),
    HeroM2ShopItemInfo.nPrice, MoneyName]), 255, 252, t_Hint);
  // 给卖家发信息 piaoyun 2013-07-21
  OnlineObject.SysMsg(Format(g_sHeroM2SellerMsg, [m_sCharName, UserEngine.GetStdItemName(ShopItem.wIndex), MoneyName,
    HeroM2ShopItemInfo.nPrice, nDecMoney, HeroM2ShopItemInfo.nPrice - nDecMoney]), 255, 252, t_Hint);
  (*
    // 物品日志
    StdItem := UserEngine.GetStdItem(ShopItem.wIndex);
    if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
    begin
    AddGameDataLog(LOG_ItemSell, LOG_ActionNone, OnlineObject,
    StdItem.Name, ShopItem.MakeIndex, m_sCharName, 0, 0, '摆摊');
    end;
    // 物品日志
    if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
    begin
    AddGameDataLog(LOG_ItemBuy, LOG_ActionNone, Self,
    StdItem.Name, ShopItem.MakeIndex, OnlineObject.m_sCharName, 0, 0, '摆摊');
    end;
  *)
  for I := 0 to OnlineObject.m_ItemList.Count - 1 do
  begin
    UserItem := OnlineObject.m_ItemList.Items[I];
    if UserItem = ShopItem then
    begin
      OnlineObject.m_ItemList.Delete(I);
      OnlineObject.WeightChanged;
      Break;
    end;
  end;
  for I := 0 to OnlineObject.m_HeroM2ShopList.Count - 1 do
  begin
    if pTHeroM2ShopItemInfo(OnlineObject.m_HeroM2ShopList.Items[I]) = HeroM2ShopItemInfo then
    begin
      OnlineObject.m_HeroM2ShopList.Delete(I);
      Dispose(HeroM2ShopItemInfo);
      Break;
    end;
  end;
end;

{ 向仿 HeroM2 商店添加物品 }
procedure TPlayObject.ServerSendHeroM2AddUserItem(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 增加摆摊物品
var
  I, nPrice, nMoneyType: Integer;
  UserItem: pTUserItem;
  HeroM2ShopItemInfo: pTHeroM2ShopItemInfo;
  LowestSellingPrice: PLowestSellingPrice;
  HighestSellingPrice: PHighestSellingPrice;
  StdItem: pTStdItem;
  sItemName: string;
begin
  {
    if m_boShopStall then
    begin // 摆摊
    SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
    SysMsg('摆摊状态中不允许添加物品！', 255, 253, t_Hint);
    Exit;
    end;
  }
  if m_HeroM2ShopList.Count >= 20 then
  begin
    SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
    SysMsg('摆摊物品已满！', 255, 253, t_Hint);
    Exit;
  end;
  if Tick_Diff(m_dwHeroM2AddItemTime, MyGetTickCount) <= 1000 then
  begin
    SysMsg('操作过快', 255, 253, t_Hint);
    Exit;
  end;
  m_dwHeroM2AddItemTime := MyGetTickCount;
  for I := 0 to m_HeroM2ShopList.Count - 1 do
  begin
    HeroM2ShopItemInfo := m_HeroM2ShopList.Items[I];
    if HeroM2ShopItemInfo.nMakeIndex = ProcessMsg.nParam1 then
    begin
      SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
      SysMsg('添加摆摊物品失败！', 255, 253, t_Hint);
      Exit;
    end;
  end;
  nPrice := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  if nPrice <= 0 then
  begin
    SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
    SysMsg('添加摆摊物品失败,物品价格必须大于0！', 255, 253, t_Hint);
    Exit;
  end;
  StdItem := nil;
  sItemName := '';
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if (UserItem.MakeIndex = ProcessMsg.nParam1) then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem <> nil then
      begin
        sItemName := StdItem.Name;
      end;
      if (GetUserItemBindValue(UserItem, ubNoSell) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 8) then
      begin
        { TODO -ochongchong -c新增 : 物品规则 - 禁止寄售【2013-07-27】 }
        SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
        SysMsg(g_sCannotSell, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
        Exit;
      end;
      Break;
    end;
  end;
  nMoneyType := ProcessMsg.wParam;
  if (nMoneyType < 0) { or (nMoneyType > 4) } then
  begin
    SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
    SysMsg('添加摆摊物品失败，未知的货币类型', 255, 253, t_Hint);
    Exit;
  end;
  case nMoneyType of
    0: // 元宝
      begin
        if not g_Config.boMyShopGameGold then
        begin
          SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
          SysMsg('添加摆摊物品失败，物品不支持以 ' + g_Config.sGameGoldName + ' 货币出售', 255, 253, t_Hint);
          Exit;
        end;
      end;
    1: // 游戏点
      begin
        if not g_Config.boMyShopGamePoint then
        begin
          SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
          SysMsg('添加摆摊物品失败，物品不支持以 ' + g_Config.sGamePointName + ' 货币出售', 255, 253, t_Hint);
          Exit;
        end;
      end;
    2: // 金币
      begin
        if not g_Config.boMyShopGold then
        begin
          SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
          SysMsg('添加摆摊物品失败，物品不支持以 ' + sSTRING_GOLDNAME + ' 货币出售', 255, 253, t_Hint);
          Exit;
        end;
      end;
    3: // 金币石
      begin
        if not g_Config.boMyShopGameDiamond then
        begin
          SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
          SysMsg('添加摆摊物品失败，物品不支持以 ' + g_Config.sGameDiamondName + ' 货币出售', 255, 253, t_Hint);
          Exit;
        end;
      end;
    4: // 灵符
      begin
        if not g_Config.boMyShopGameGird then
        begin
          SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
          SysMsg('添加摆摊物品失败，物品不支持以 ' + g_Config.sGameGirdName + ' 货币出售', 255, 253, t_Hint);
          Exit;
        end;
      end;
  end;
  // 检测最低售价 - 元宝
  if Length(sItemName) > 0 then
  begin
    LowestSellingPrice := GetLowestSellingPrice(sItemName);
    if LowestSellingPrice <> nil then
    begin
      case nMoneyType of
        0:
          begin
            if (nPrice < LowestSellingPrice.nGameGoldPice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGameGoldPice) + g_Config.sGameGoldName + ']，请重新定价',
                255, 253, t_Hint);
              Exit;
            end;
          end;
        1:
          begin
            if (nPrice < LowestSellingPrice.nGamePointPrice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGamePointPrice) + g_Config.sGamePointName + ']，请重新定价',
                255, 253, t_Hint);
              Exit;
            end;
          end;
        2:
          begin
            if (nPrice < LowestSellingPrice.nGoldPrice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGoldPrice) + sSTRING_GOLDNAME + ']，请重新定价', 255,
                253, t_Hint);
              Exit;
            end;
          end;
        3:
          begin
            if (nPrice < LowestSellingPrice.nGameDiamondPice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGameDiamondPice) + g_Config.sGameDiamondName +
                ']，请重新定价', 255, 253, t_Hint);
              Exit;
            end;
          end;
        4:
          begin
            if (nPrice < LowestSellingPrice.nGameGameGirdPrice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能低于设置价格[' + IntToStr(LowestSellingPrice.nGameGameGirdPrice) + g_Config.sGameGirdName +
                ']，请重新定价', 255, 253, t_Hint);
              Exit;
            end;
          end;
      end;
    end;
  end;
  if Length(sItemName) > 0 then
  begin
    HighestSellingPrice := GetHighestSellingPrice(sItemName);
    if HighestSellingPrice <> nil then
    begin
      case nMoneyType of
        0:
          begin
            if (nPrice > HighestSellingPrice.nGameGoldPice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGameGoldPice) + g_Config.sGameGoldName + ']，请重新定价',
                255, 253, t_Hint);
              Exit;
            end;
          end;
        1:
          begin
            if (nPrice > HighestSellingPrice.nGamePointPrice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGamePointPrice) + g_Config.sGamePointName + ']，请重新定价',
                255, 253, t_Hint);
              Exit;
            end;
          end;
        2:
          begin
            if (nPrice > HighestSellingPrice.nGoldPrice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGoldPrice) + sSTRING_GOLDNAME + ']，请重新定价', 255,
                253, t_Hint);
              Exit;
            end;
          end;
        3:
          begin
            if (nPrice > HighestSellingPrice.nGameDiamondPice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGameDiamondPice) + g_Config.sGameDiamondName +
                ']，请重新定价', 255, 253, t_Hint);
              Exit;
            end;
          end;
        4:
          begin
            if (nPrice > HighestSellingPrice.nGameGameGirdPrice) then
            begin
              SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 增加摆摊物品失败
              SysMsg('添加摆摊物品失败，物品不能高于设置价格[' + IntToStr(HighestSellingPrice.nGameGameGirdPrice) + g_Config.sGameGirdName +
                ']，请重新定价', 255, 253, t_Hint);
              Exit;
            end;
          end;
      end;
    end;
  end;
  New(HeroM2ShopItemInfo);
  HeroM2ShopItemInfo.nMakeIndex := ProcessMsg.nParam1;
  HeroM2ShopItemInfo.nPrice := nPrice;
  HeroM2ShopItemInfo.nMoneyType := nMoneyType;
  HeroM2ShopItemInfo.dwAddTick := MyGetTickCount;
  m_HeroM2ShopList.Add(HeroM2ShopItemInfo);
  SendDefMessage(SM_HEROM2ADDUSERSHOPITEM_OK, ProcessMsg.nParam1, ProcessMsg.nParam2, ProcessMsg.nParam3, ProcessMsg.wParam, '');
  // 增加摆摊物品成功
  if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
  begin
    AddGameDataLog(LOG_ItemPutInto, LOG_ActionNone, Self, StdItem.Name, HeroM2ShopItemInfo.nMakeIndex, '摆摊')
  end;
end;

procedure TPlayObject.ServerSendHeroM2DelUserItem(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 删除摆摊物品
var
  I, II: Integer;
  UserItem: pTUserItem;
  HeroM2ShopItemInfo: pTHeroM2ShopItemInfo;
  StdItem: pTStdItem;
begin
  {
    if m_boShopStall then
    begin // 摆摊
    if ProcessMsg.nParam2 = 0 then
    begin
    SendDefMessage(SM_HEROM2DELUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 删除摆摊物品失败
    SysMsg('摆摊状态中不允许取回物品！', 255, 253, t_Hint);
    end;
    Exit;
    end;
  }
  for I := 0 to m_HeroM2ShopList.Count - 1 do
  begin
    HeroM2ShopItemInfo := m_HeroM2ShopList.Items[I];
    if HeroM2ShopItemInfo.nMakeIndex = ProcessMsg.nParam1 then
    begin
      m_HeroM2ShopList.Delete(I);
      Dispose(HeroM2ShopItemInfo);
      if ProcessMsg.nParam2 = 0 then
        SendDefMessage(SM_HEROM2DELUSERSHOPITEM_OK, ProcessMsg.nParam1, 0, 0, 0, ''); // 删除摆摊物品成功
      for II := 0 to m_ItemList.Count - 1 do
      begin
        UserItem := m_ItemList.Items[II];
        if UserItem.MakeIndex = ProcessMsg.nParam1 then
        begin
          SendUpdateItem(UserItem); // 刷新一下，原来的Price 和Reserved1字段改变了
          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
          begin
            AddGameDataLog(LOG_ItemTakeBack, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '摆摊')
          end;
          Break;
        end;
      end;
      Exit;
    end;
  end;
  if ProcessMsg.nParam2 = 0 then
  begin
    SendDefMessage(SM_HEROM2DELUSERSHOPITEM_FAIL, ProcessMsg.nParam1, 0, 0, 0, ''); // 删除摆摊物品成功
    SysMsg('取回摆摊物品失败！', 255, 253, t_Hint);
  end;
end;

