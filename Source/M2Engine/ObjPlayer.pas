procedure TPlayObject.SendAdjustBonus;
var
  AdjustBonus: TAdjustBonus;
begin
  if m_boOffLine or m_boDummyObject then
    Exit;

  case m_btJob of
    0:
      begin
        AdjustBonus.BonusTick := g_Config.BonusAbilofWarr;
        AdjustBonus.BonusAbil := m_BonusAbil;
        AdjustBonus.NakedAbil := g_Config.NakedAbilofWarr;
      end;
    1:
      begin
        AdjustBonus.BonusTick := g_Config.BonusAbilofWizard;
        AdjustBonus.BonusAbil := m_BonusAbil;
        AdjustBonus.NakedAbil := g_Config.NakedAbilofWizard;
      end;
    2:
      begin
        AdjustBonus.BonusTick := g_Config.BonusAbilofTaos;
        AdjustBonus.BonusAbil := m_BonusAbil;
        AdjustBonus.NakedAbil := g_Config.NakedAbilofTaos;
      end;
  else
    Exit;
  end;

  m_DefMsg := MakeDefaultMsg(SM_ADJUST_BONUS, m_nBonusPoint, 0, 0, 0);
  SendSocketEx(@m_DefMsg, @AdjustBonus, SizeOf(TAdjustBonus));
end;

procedure TPlayObject.SendGroupText(sMsg: string; IsLockMember: Boolean);
var
  I: Integer;
  PlayObject: TPlayObject;
  sOldMsg: string;
begin
  sOldMsg := sMsg;
  if g_Config.boShowPreFixMsg then
    sMsg := g_Config.sGroupMsgPreFix + sMsg;

  if m_GroupOwner <> nil then
  begin
    if IsLockMember then
      m_GroupOwner.m_GroupMembers.LockR(37);
    try
      for I := 0 to m_GroupOwner.m_GroupMembers.Count - 1 do
      begin
        PlayObject := TPlayObject(m_GroupOwner.m_GroupMembers.Objects[I]);
        PlayObject.SendMsg(Self, RM_GROUPMESSAGE, 0, g_Config.btGroupMsgFColor, g_Config.btGroupMsgBColor, 0, sMsg);
      end;
    finally
      if IsLockMember then
        m_GroupOwner.m_GroupMembers.UnLockR;
    end;
  end;

  if g_Config.boRecordGroupMsg and (Length(sOldMsg) > 0) then
    MainOutMessage('[组队] ' + sOldMsg);
end;

procedure TPlayObject.LeaveGroup(IsLockMember: Boolean);
resourcestring
  sExitGropMsg = '%s 已经退出了本组..';
var
  GroupOwner: TPlayObject; // 组长
begin
  SendGroupText(Format(sExitGropMsg, [m_sCharName]), IsLockMember);
  GroupOwner := m_GroupOwner; // 组长
  if m_GroupOwner <> nil then
    m_GroupOwner.m_sString[0] := m_sCharName;

  m_GroupOwner := nil;
  SendMsg(Self, RM_GROUPCANCEL, 0, 0, 0, 0, '');
  if (g_FunctionNPC <> nil) and (GroupOwner <> nil) then
  begin
    m_nScriptGotoCount := 0;
    g_FunctionNPC.GotoLable(Self, '@LeaveGroup', False);
  end;
end;

function TPlayObject.CancelGroup(IsLockMember: Boolean): Boolean;
resourcestring
  sCanceGrop = '你的小组被解散了.';
begin
  Result := True;
{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun and IsLockMember then
    m_GroupMembers.LockW(38);
  try
{$IFEND}
    if m_GroupMembers.Count <= 1 then
    begin
      SendGroupText(sCanceGrop, False);
      m_GroupMembers.Clear;
      m_GroupOwner := nil;
      Result := False;
    end;
{$IF MULTI_THREAD = 1}
  finally
    if g_MultiThreadRun and IsLockMember then
      m_GroupMembers.UnLockW;
  end;
{$IFEND}
end;

procedure TPlayObject.DelGroupMember(MemberObject: TPlayObject);
var
  I: Integer;
  PlayObject: TPlayObject;
  nMaxLevel: Integer; // 最高等级
  NewGroupOwner: TPlayObject;
begin
  // 如果是组员退组
{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun then
    m_GroupMembers.LockW(39);
  try
{$IFEND}
    if m_GroupOwner <> MemberObject then
    begin
      for I := m_GroupMembers.Count - 1 downto 0 do
      begin
        if m_GroupMembers.Count <= 0 then
          Break;

        if m_GroupMembers.Objects[I] = MemberObject then
        begin
          m_GroupMembers.Delete(I);
          MemberObject.LeaveGroup(False);
          // 修正转让队长报错M2卡死 2019-01-26 00:04:45
          if MemberObject.m_GroupMembers <> nil then
            MemberObject.m_GroupMembers.Clear;
          Break;
        end;
      end;
    end
    else
    begin
      // 如果是组长退组--> 则选出本组中级别最高的成为组长 piaoyun 2013-07-24
      if g_Config.boAutoGroupMaster and (m_GroupMembers.Count > 1) then
      begin
        // 冒泡排序 找待选组长。。。
        nMaxLevel := 0;
        NewGroupOwner := nil;
        for I := m_GroupMembers.Count - 1 downto 0 do
        begin
          PlayObject := TPlayObject(m_GroupMembers.Objects[I]);
          // 删除自己
          if (PlayObject = MemberObject) then
          begin
            m_GroupMembers.Delete(I);
            MemberObject.LeaveGroup(False);
            // PlayObject := nil;
          end
          else if (not PlayObject.m_boDeath) and (not PlayObject.m_boGhost) and (PlayObject.m_WAbil.Level > nMaxLevel) then
          begin // 取出等级最高者
            nMaxLevel := PlayObject.m_WAbil.Level;
            NewGroupOwner := PlayObject;
          end;
        end;

        if NewGroupOwner <> nil then
        begin
          // 自己入队
          NewGroupOwner.JoinGroup(NewGroupOwner, False);
          NewGroupOwner.m_GroupMembers.Clear;
          NewGroupOwner.m_GroupMembers.AddObject(NewGroupOwner.m_sCharName, NewGroupOwner);
          // 只有一个人，则玩完
          if m_GroupMembers.Count > 1 then
          begin
            // 遍历队伍
            for I := 0 to m_GroupMembers.Count - 1 do
            begin
              PlayObject := TPlayObject(m_GroupMembers.Objects[I]);
              if PlayObject <> NewGroupOwner then
              begin
                NewGroupOwner.m_GroupMembers.AddObject(m_GroupMembers[I], PlayObject);
                PlayObject.JoinGroup(NewGroupOwner, False);
              end;
              PlayObject.SysMsg(NewGroupOwner.m_sCharName + '被提升为组长', g_Config.btGreenMsgFColor,
                g_Config.btGreenMsgBColor, t_Hint);
            end;
          end
          else
          begin
            PlayObject := TPlayObject(m_GroupMembers.Objects[0]);
            PlayObject.LeaveGroup(False);
            // m_GroupMembers.Clear;
          end;

          PlayObject := NewGroupOwner;
          if not PlayObject.CancelGroup(False) then
            PlayObject.SendDefMessage(SM_GROUPCANCEL, 0, 0, 0, 0, '')
          else
            PlayObject.SendGroupMembers(False);

          // 修正转让队长报错M2卡死 2019-01-26 00:12:40
          if MemberObject.m_GroupMembers <> nil then
            MemberObject.m_GroupMembers.Clear;
          Exit;
        end;
      end
      else
      begin
        for I := m_GroupMembers.Count - 1 downto 0 do
        begin
          PlayObject := TPlayObject(m_GroupMembers.Objects[I]);
          PlayObject.LeaveGroup(False);
          // 修正转让队长报错M2卡死 2019-01-24 00:36:47
          if PlayObject.m_GroupMembers <> nil then
            PlayObject.m_GroupMembers.Clear;
        end;
        m_GroupMembers.Clear;
      end;
    end;
{$IF MULTI_THREAD = 1}
  finally
    if g_MultiThreadRun then
      m_GroupMembers.UnLockW;
  end;
{$IFEND}
  PlayObject := Self;
  if not PlayObject.CancelGroup then
    PlayObject.SendDefMessage(SM_GROUPCANCEL, 0, 0, 0, 0, '')
  else
    PlayObject.SendGroupMembers();
end;

procedure TPlayObject.HideItem(MapItem: TItemObject);
var
  VisibleMapItem: pTVisibleMapItem;
begin
  m_VisibleItems.Lock;
  try
    VisibleMapItem := m_VisibleItems.GetItemByKey(NativeInt(MapItem));
    if (VisibleMapItem <> nil) and (VisibleMapItem.BaseObject <> nil) and (VisibleMapItem.BaseObject = MapItem) then
      VisibleMapItem.boSendHideMsg := True;
  finally
    m_VisibleItems.UnLock;
  end;
end;

procedure TPlayObject.UpdateVisibleEvent(wX, wY: Integer; MapEvent: TObject);
var
  VisibleMapEvent: pTVisibleMapEvent;
  Key: string;
begin
  Key := IntToStr(NativeInt(MapEvent));
  VisibleMapEvent := m_VisibleEvents.Find(Key);
  // ?????? 修复假人卡 piaoyun 2013-11-14
  // if m_boDummyObject then Exit;
  if VisibleMapEvent = nil then
  begin
    New(VisibleMapEvent);
    VisibleMapEvent.nVisibleFlag := 2;
    VisibleMapEvent.nX := wX;
    VisibleMapEvent.nY := wY;
    VisibleMapEvent.BaseObject := MapEvent;
    m_VisibleEvents.Add(Key, VisibleMapEvent);
  end
  else if VisibleMapEvent.BaseObject = MapEvent then
    VisibleMapEvent.nVisibleFlag := 1;
end;

procedure TPlayObject.ClearObject;
var
  HashItem: HashList.PHashItem;
  VisibleMapEvent: pTVisibleMapEvent;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.ClearObject';
begin
  inherited;
  try
    HashItem := m_VisibleEvents.First;
    while HashItem <> nil do
    begin
      VisibleMapEvent := HashItem.Item;
      HashItem := m_VisibleEvents.Next(HashItem);
      if VisibleMapEvent <> nil then
        Dispose(VisibleMapEvent);
    end;
    m_VisibleEvents.Clear;
  except
    MainOutMessage(sExceptionMsg);
  end;
end;

