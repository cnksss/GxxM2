procedure TPlayObject.ClientGetM2VerifyCode(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  if (Length(m_sVerifyCode) > 0) then
  begin
    Inc(m_nVerifyCodeRefreshCount);
    if m_nVerifyCodeRefreshCount < g_Config.nVerifyCodeRefreshCount then
    begin
      m_sVerifyCode := GenerateVerifyCode;
      SendMsg(Self, RM_VERIFYCODE, 0, 0, 0, 0, '');
      SysMsg('刷新验证码成功，还可以再刷新' + IntToStr(g_Config.nVerifyCodeRefreshCount - m_nVerifyCodeRefreshCount) + '次', c_Green, t_Hint);
    end
    else
    begin
      SysMsg('刷新验证码失败，因为你已经刷新了太多次', c_Red, t_Hint);
    end;
  end;
end;

procedure TPlayObject.ClientCheckM2VerifyCode(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  if (Length(m_sVerifyCode) > 0) then
  begin
    if SameText(DecodeString(ProcessMsg.sMsg), m_sVerifyCode) then
    begin
      m_boVerifyCodeCheckOK := True;
      if (m_VerifyCodeGotoNpc <> nil) and (m_VerifyCodeGotoNpc is TNormNpc) and (Length(m_sVerifyCodeGotoLabel) > 0) then
      begin
        TNormNpc(m_VerifyCodeGotoNpc).GotoLable(Self, m_sVerifyCodeGotoLabel, False);
      end;
      m_sVerifyCode := '';
      m_boVerifyCodeCheckOK := False;
      m_nVerifyCodeRefreshCount := 0;
      m_nVerifyCodeErrorCount := 0;
      m_VerifyCodeGotoNpc := nil;
      m_sVerifyCodeGotoLabel := '';
      SendDefMessage(SM_M2VERIFYCODE_CHECK_RET, 0, 1, 0, 0, '');
    end
    else
    begin
      Inc(m_nVerifyCodeErrorCount);
      SendDefMessage(SM_M2VERIFYCODE_CHECK_RET, g_Config.nVerifyCodeFailCount - m_nVerifyCodeErrorCount, 0, 0, 0, '');
      if m_nVerifyCodeErrorCount >= g_Config.nVerifyCodeFailCount then
      begin
        m_sVerifyCode := '';
        m_boVerifyCodeCheckOK := False;
        m_nVerifyCodeRefreshCount := 0;
        m_nVerifyCodeErrorCount := 0;
        m_VerifyCodeGotoNpc := nil;
        m_sVerifyCodeGotoLabel := '';
      end;
    end;
  end;
end;

procedure TPlayObject.ClientGetMobileVerifyCode(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  if (Length(m_sMobileNumber) > 0) and (Length(m_sMobileVerifyCode) > 0) then
  begin
    if Tick_Diff(m_dwMobileVerifyTick, MyGetTickCount) <= g_SendSMSConfig.VerifySendInterval * 1000 then
    begin
      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@MobileVerifyCodeInterval', False);
      end;
      Exit;
    end;
    Inc(m_nMobileResendCount);
    if m_nMobileResendCount < g_SendSMSConfig.ResendVerifyCodeCount then
    begin
      g_AliyunSendSMSThread.AddTask(Self, nil);
    end
    else
    begin
      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@MobileVerifyCodeResendMaxCount', False);
      end;
      SysMsg('发送验证码失败，发送次数超过限制', c_Red, t_Hint);
    end;
  end;
end;

procedure TPlayObject.ClientCheckMobileVerifyCode(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  if (Length(m_sMobileVerifyCode) > 0) then
  begin
    if SameText(DecodeString(ProcessMsg.sMsg), m_sMobileVerifyCode) then
    begin
      m_sMobileVerifyCode := '';
      m_nMobileResendCount := 0;
      m_nMobileVerifyCodeErrorCount := 0;
      SendDefMessage(SM_MOBILEVERIFYCODE_CHECK_RET, 0, 1, 0, 0, '');
      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@MobileVerifyCodeOK', False);
      end;
    end
    else
    begin
      Inc(m_nMobileVerifyCodeErrorCount);
      SendDefMessage(SM_MOBILEVERIFYCODE_CHECK_RET, g_SendSMSConfig.VerifyCodeErrorCount - m_nMobileVerifyCodeErrorCount, 0,
        0, 0, '');
      if m_nMobileVerifyCodeErrorCount >= g_SendSMSConfig.VerifyCodeErrorCount then
      begin
        if g_FunctionNPC <> nil then
        begin
          m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Self, '@MobileVerifyCodeFail', False);
        end;
      end
      else
      begin
        if g_FunctionNPC <> nil then
        begin
          m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Self, '@MobileVerifyCodeSingleFail', False);
        end;
      end;
    end;
  end
  else
  begin
    SendDefMessage(SM_MOBILEVERIFYCODE_CHECK_RET, 0, 1, 0, 0, '');
  end;
end;

procedure TPlayObject.ClientCloseM2VerifyCode(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  m_sVerifyCode := '';
  m_boVerifyCodeCheckOK := False;
  m_nVerifyCodeRefreshCount := 0;
  m_nVerifyCodeErrorCount := 0;
  m_VerifyCodeGotoNpc := nil;
  m_sVerifyCodeGotoLabel := '';
end;

procedure TPlayObject.ClientQueryAllAuctionItems(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I, nPage, nPageCount, nCount: Integer;
  ItemList: TAuctionItemList;
  Item: PAuctionRecord;
  StdItem: pTStdItem;
  ItemGroup: TItemGroup;
  // TopmostAuctionID: Integer;
  AuctionRecord: TAuctionRecord;
  ItemColors: Integer;
  ResquestAllAuctionItem: TResquestAllAuctionItem;
  InBuf: array [0 .. SizeOf(TAllAuctionItem) * AUCTION_PAGE_COUNT] of AnsiChar;
  AuctionItem: pTAllAuctionItem;
begin
  if g_nKey_Auction = 0 then
    Exit;
  // TopmostAuctionID := StrToIntDef(ProcessMsg.sMsg, 0);
  DecodeBuffer(PAnsiChar(ProcessMsg.sMsg), Length(ProcessMsg.sMsg), @ResquestAllAuctionItem, SizeOf(TResquestAllAuctionItem));
  if Length(ResquestAllAuctionItem.KeyWord) > 0 then
  begin
    ItemGroup := igAll;
    ItemColors := 0;
  end
  else
  begin
    if (ProcessMsg.nParam2 >= Integer(Low(TItemGroup))) and (ProcessMsg.nParam2 <= Integer(High(TItemGroup))) then
      ItemGroup := TItemGroup(ProcessMsg.nParam2)
    else
      ItemGroup := igAll;
    ItemColors := ProcessMsg.nParam3;
    if not g_Config.boOpenAuctionItemColors then
      ItemColors := 0;
  end;
  nPage := ProcessMsg.nParam1;
  nPageCount := g_M2DataDB.AuctionDB.GetAllItemsPageCount(ResquestAllAuctionItem.KeyWord, ItemGroup, ItemColors,
    ResquestAllAuctionItem.MoneyType, ResquestAllAuctionItem.Prices1, ResquestAllAuctionItem.Prices2);
  if nPage < 1 then
    nPage := 1;
  if nPage > nPageCount then
    nPage := nPageCount;
  nCount := 0;
  AuctionItem := @InBuf;
  FillChar(InBuf[0], SizeOf(InBuf), 0);
  ItemList := TAuctionItemList.Create;
  try
    g_M2DataDB.AuctionDB.QueryAllItems(ResquestAllAuctionItem.KeyWord, ItemGroup, m_sCharName, nPage,
      { TopmostAuctionID } ResquestAllAuctionItem.ShowAuctionID, ItemColors, LoByte(ProcessMsg.wParam),
      HiByte(ProcessMsg.wParam) = 1, ResquestAllAuctionItem.MoneyType, ResquestAllAuctionItem.Prices1,
      ResquestAllAuctionItem.Prices2, ItemList);
    if ( { TopmostAuctionID } ResquestAllAuctionItem.ShowAuctionID > 0) and
      g_M2DataDB.AuctionDB.GetAuctionRecord( { TopmostAuctionID } ResquestAllAuctionItem.ShowAuctionID, AuctionRecord) then
    begin
      ItemList.Insert(@AuctionRecord);
    end;
    for I := 0 to ItemList.Count - 1 do
    begin
      Item := ItemList.Items[I];
      AuctionItem.AuctionID := Item.AuctionID;
      AuctionItem.StartingPrice := Item.StartingPrice;
      AuctionItem.SellingPrice := Item.SellingPrice;
      AuctionItem.CurrencyType := Item.CurrencyType;
      AuctionItem.LastBidPrice := Item.LastBidPrice;
      AuctionItem.TimeLeft := Item.TimeLeft;
      AuctionItem.TradingStatus := Item.TradingStatus;
      AuctionItem.IsItemGive := Item.IsItemGive;
      AuctionItem.IsAttention := Item.IsAttention;
      AuctionItem.IsItemFlash := Item.AuctionID = { TopmostAuctionID } ResquestAllAuctionItem.ShowAuctionID;
      StdItem := UserEngine.GetStdItem(Item.ActionItem.wIndex);
      if StdItem <> nil then
      begin
        UserItemToClientItem(@Item.ActionItem, StdItem, @AuctionItem.Item, True, True);
      end;
      Inc(AuctionItem);
      Inc(nCount);
      if nCount >= AUCTION_PAGE_COUNT then
        Break;
    end;
  finally
    ItemList.Free;
  end;
  m_DefMsg := MakeDefaultMsg(SM_QueryAllAuctionItems, nPage, LoWord(nPageCount), HiWord(nPageCount), nCount);
  SendSocketEx(@m_DefMsg, @InBuf, nCount * SizeOf(TAllAuctionItem));
end;

