procedure TPlayObject.ServerSendVerifyCode(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  sSendMsg: AnsiString;
  Bitmap: TBitmap;
  MS: TMemoryStream;
begin
  try
    Bitmap := TBitmap.Create;
    try
      Bitmap.Canvas.Lock;
      try
        Bitmap.Width := 170;
        Bitmap.Height := 70;
        Bitmap.Canvas.Font.Name := '微软雅黑';
        Bitmap.Canvas.Font.Size := 25;
        Bitmap.PixelFormat := pf16bit;
        MakeVerifyCode(m_sVerifyCode, Bitmap, Bitmap.Canvas.Font, -(5 + Random(7)), False);
        MS := TMemoryStream.Create;
        try
          Bitmap.SaveToStream(MS);
          sSendMsg := zLibCompressBuffer(MS.Memory, MS.Size);
          m_DefMsg := MakeDefaultMsg(SM_M2VERIFYCODE, Length(sSendMsg), LoWord(MS.Size), HiWord(MS.Size), 0);
          SendSocket(@m_DefMsg, sSendMsg);
        finally
          MS.Free;
        end;
      finally
        Bitmap.Canvas.UnLock;
      end;
    finally
      Bitmap.Free;
    end;
  except
  end;
end;

