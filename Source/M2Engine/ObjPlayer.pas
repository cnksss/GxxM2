                g_FunctionNPC.GotoLable(Self, '@HeroTakeOn' + IntToStr(GodBlessIndex + U_GODBLESSITEM1), False);
                g_FunctionNPC.GotoLable(Self, '@HeroTakeOnEx', False);
                THeroObject(m_MyHero).m_nCurrentItemMakeIndex := 0;
                THeroObject(m_MyHero).m_nCurrentItemPos := 0;
                THeroObject(m_MyHero).m_sCurrentItemName := '';
                THeroObject(m_MyHero).m_sCurrentItemNewName := '';
              end;
              ErrNum := 80;
              Dispose(UserItem);
              ErrNum := 81;
              m_MyHero.RecalcAbilitys();
              ErrNum := 82;
              m_MyHero.WeightChanged;
              ErrNum := 83;
              m_MyHero.SendMsg(m_MyHero, RM_ABILITY, 0, 0, 0, 0, '');
              ErrNum := 84;
              m_MyHero.SendMsg(m_MyHero, RM_SUBABILITY, 0, 0, 0, 0, '');
              // 护身要生效 chongchong 2018-09-16 23:46:09
              m_MyHero.FeatureChanged;
              Exit;
            end;
          end;
        end;
      end;
    end;
    ErrNum := 88;
    SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TPlayObject:ClientTakeOnGodBless ' + IntToStr(ErrNum));
      MainOutMessage(E.Message);
    end;
  end;
end;

// 神佑放到包裹 chongchong 2013-10-20
procedure TPlayObject.ClientTakeOffGodBless(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  // nMakeIndex: Integer;
  GodBlessIndex: Integer;
  IsHero: Boolean;
  OldGodBlessItem: pTUserItem;
  StdItem: pTStdItem;
  sItemName, sUserItemName: string;
begin
  // nMakeIndex := ProcessMsg.nParam1;
  GodBlessIndex := ProcessMsg.nParam2;
  IsHero := Boolean(ProcessMsg.nParam3);
  // sItemName := DecodeString(ProcessMsg.sMsg);
  if m_boOffLine or m_boGhost or (not(GodBlessIndex in [Low(THumanGodBlessItems) .. High(THumanGodBlessItems)])) then
  begin
    SendDefMessage(SM_TAKEOFFGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
    Exit;
  end;
  if not IsHero then
  begin
    if m_GodBlessItems[GodBlessIndex].wIndex > 0 then
    begin
      if InDisableTakeOffList(m_GodBlessItems[GodBlessIndex].wIndex) or
        (GetUserItemBindValue(@m_GodBlessItems[GodBlessIndex], ubNoTakeOff) and m_GodBlessItems[GodBlessIndex].boIsBind) then
      begin
        SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
        SendDefMessage(SM_TAKEOFFGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
        Exit;
      end;
      if (m_GodBlessItems[GodBlessIndex].btValue[13] = 1) and (m_GodBlessItems[GodBlessIndex].Name <> '') then
        sUserItemName := m_GodBlessItems[GodBlessIndex].Name
      else
        sUserItemName := UserEngine.GetStdItemName(m_GodBlessItems[GodBlessIndex].wIndex);
      m_nCurrentItemMakeIndex := m_GodBlessItems[GodBlessIndex].MakeIndex;
      m_nCurrentItemPos := GodBlessIndex + U_GODBLESSITEM1;
      m_sCurrentItemName := UserEngine.GetStdItemName(m_GodBlessItems[GodBlessIndex].wIndex);
      m_sCurrentItemNewName := sUserItemName;
      m_PickUpOrDropItem := m_GodBlessItems[GodBlessIndex];
      m_boStopTakeOff := False;
      g_FunctionNPC.GotoLable(Self, '@BeginTakeOff', False);
      m_PickUpOrDropItem.MakeIndex := 0;
      m_PickUpOrDropItem.wIndex := 0;
      m_nCurrentItemMakeIndex := 0;
      m_nCurrentItemPos := 0;
      m_sCurrentItemName := '';
      m_sCurrentItemNewName := '';
      if m_boStopTakeOff then
      begin
        SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
        Exit;
      end;
      New(OldGodBlessItem);
      OldGodBlessItem^ := m_GodBlessItems[GodBlessIndex];
      // 将神佑袋的物品移到包裹中
      if AddItemToBag(OldGodBlessItem) then
      begin
        SendAddItem(OldGodBlessItem);
        m_GodBlessItems[GodBlessIndex].wIndex := 0;
        SendDefMessage(SM_TAKEOFFGODBLESSITEM_OK, Integer(IsHero), 0, 0, 0, '');
        StdItem := UserEngine.GetStdItem(OldGodBlessItem.wIndex);
        if (g_FunctionNPC <> nil) and (StdItem <> nil) then
        begin
          m_nScriptGotoCount := 0;
          m_PickUpOrDropItem := OldGodBlessItem^;
          if (OldGodBlessItem.btValue[13] = 1) and (OldGodBlessItem.Name <> '') then
            sItemName := OldGodBlessItem.Name
          else
            sItemName := StdItem.Name;
          m_nCurrentItemMakeIndex := OldGodBlessItem.MakeIndex;
          m_nCurrentItemPos := GodBlessIndex + U_GODBLESSITEM1;
          m_sCurrentItemName := StdItem.Name;
          m_sCurrentItemNewName := sItemName;
          g_FunctionNPC.GotoLable(Self, '@TakeOff' + IntToStr(U_GODBLESSITEM1 + GodBlessIndex), False);
          g_FunctionNPC.GotoLable(Self, '@TakeOffEx', False);
          m_PickUpOrDropItem.MakeIndex := 0;
          m_PickUpOrDropItem.wIndex := 0;
          m_nCurrentItemMakeIndex := 0;
          m_nCurrentItemPos := 0;
          m_sCurrentItemName := '';
          m_sCurrentItemNewName := '';
        end;
        if StdItem <> nil then // 修复神佑物品脱下时不删除技能的问题
          ProcessUseItemSkill(U_GODBLESSITEM1 + GodBlessIndex, StdItem, False);
        RecalcAbilitys();
        SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
        SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
        // 护身要生效 chongchong 2018-09-16 23:46:09
        FeatureChanged;
        Exit;
      end
      else
      begin
        Dispose(OldGodBlessItem);
      end;
    end;
  end
  else
  begin
    if m_MyHero = nil then
      Exit;
    if THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex].wIndex > 0 then
    begin
      if InDisableTakeOffList(THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex].wIndex) or
        (GetUserItemBindValue(@THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex], ubNoTakeOff) and THeroObject(m_MyHero)
        .m_GodBlessItems[GodBlessIndex].boIsBind) then
      begin
        SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
        SendDefMessage(SM_TAKEOFFGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
        Exit;
      end;
      if (THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex].btValue[13] = 1) and
        (THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex].Name <> '') then
        sUserItemName := THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex].Name
      else
        sUserItemName := UserEngine.GetStdItemName(THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex].wIndex);
      THeroObject(m_MyHero).m_nCurrentItemMakeIndex := THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex].MakeIndex;
      THeroObject(m_MyHero).m_nCurrentItemPos := GodBlessIndex + U_GODBLESSITEM1;
      THeroObject(m_MyHero).m_sCurrentItemName :=
        UserEngine.GetStdItemName(THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex].wIndex);
      THeroObject(m_MyHero).m_sCurrentItemNewName := sUserItemName;
      THeroObject(m_MyHero).m_PickUpOrDropItem := THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex];
      THeroObject(m_MyHero).m_boStopTakeOff := False;
      g_FunctionNPC.GotoLable(Self, '@HeroBeginTakeOff', False);
      THeroObject(m_MyHero).m_PickUpOrDropItem.MakeIndex := 0;
      THeroObject(m_MyHero).m_PickUpOrDropItem.wIndex := 0;
      THeroObject(m_MyHero).m_nCurrentItemMakeIndex := 0;
      THeroObject(m_MyHero).m_nCurrentItemPos := 0;
      THeroObject(m_MyHero).m_sCurrentItemName := '';
      THeroObject(m_MyHero).m_sCurrentItemNewName := '';
      if THeroObject(m_MyHero).m_boStopTakeOff then
      begin
        SendDefMessage(SM_TAKEONGODBLESSITEM_FAIL, Integer(IsHero), 0, 0, 0, '');
        Exit;
      end;
      New(OldGodBlessItem);
      OldGodBlessItem^ := THeroObject(m_MyHero).m_GodBlessItems[GodBlessIndex];
      // 将神佑袋的物品移到包裹中
