procedure TPlayObject.ClientSetShowFashion(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  Value1, Value2: Boolean;
begin
  Value1 := Boolean(ProcessMsg.nParam1);
  if Value1 <> m_boShowFashion then
  begin
    m_boShowFashion := Value1;
    if (g_FunctionNPC <> nil) then
    begin
      m_nScriptGotoCount := 0;
      if m_boShowFashion then
        g_FunctionNPC.GotoLable(Self, '@ShowFashion', False)
      else
        g_FunctionNPC.GotoLable(Self, '@NotShowFashion', False)
    end;
    RecalcAbilitys;
    FeatureChanged;
  end;
  if m_MyHero <> nil then
  begin
    Value2 := Boolean(ProcessMsg.nParam2);
    if Value2 <> THeroObject(m_MyHero).m_boShowFashion then
    begin
      THeroObject(m_MyHero).m_boShowFashion := Value2;
      if (g_FunctionNPC <> nil) then
      begin
        m_nScriptGotoCount := 0;
        if Value2 then
          g_FunctionNPC.GotoLable(Self, '@HeroShowFashion', False)
        else
          g_FunctionNPC.GotoLable(Self, '@HeroNotShowFashion', False)
      end;
      THeroObject(m_MyHero).RecalcAbilitys;
      THeroObject(m_MyHero).FeatureChanged;
    end;
  end;
end;

// 包裹物品到自定义OK框 chongchong 2013-10-31
procedure TPlayObject.ClientMoveToItemBox(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  sUserItemName: string;
  nMakeIndex: Integer;
  sItemName: string;
  StdItem: pTStdItem;
  ItemBoxIndex: Integer;
  Code: Integer;
begin
  nMakeIndex := ProcessMsg.nParam1;
  ItemBoxIndex := ProcessMsg.nParam2;
  sItemName := DecodeString(ProcessMsg.sMsg);
  Code := 0;
  try
    if m_boOffLine or m_boGhost or (not(ItemBoxIndex in [Low(THumanItemBoxItems) .. High(THumanItemBoxItems)])) then
    begin
      SendDefMessage(SM_MOVETOITEMBOX_FAIL, 0, 0, 0, 0, '');
      Exit;
    end;
    Code := 1;
    for I := 0 to m_ItemList.Count - 1 do
    begin
      UserItem := m_ItemList.Items[I];
      Code := 2;
      if UserItem.MakeIndex = nMakeIndex then
      begin
        Code := 3;
        // 取自定义物品名称
        sUserItemName := '';
        if UserItem.btValue[13] = 1 then
          sUserItemName := UserItem.Name;
        if sUserItemName = '' then
          sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
        Code := 4;
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if (StdItem <> nil) and (CompareText(sUserItemName, sItemName) = 0) then
        begin
          Code := 5;
          if m_ItemBoxItems[ItemBoxIndex] > 0 then
          begin
            SendDefMessage(SM_MOVETOITEMBOX_FAIL, 0, 0, 0, 0, '');
            Exit;
          end;
          Code := 6;
          m_ItemBoxItems[ItemBoxIndex] := UserItem.MakeIndex;
          SendDefMessage(SM_MOVETOITEMBOX_OK, 0, 0, 0, 0, '');
          Code := 7;
          m_ItemBoxAddIndex := ItemBoxIndex;
          if m_ItemBoxNpc <> nil then
          begin
            Code := 9;
            m_nScriptGotoCount := 0;
            if not TNormNpc(m_ItemBoxNpc).GotoLable(Self, '@ItemIntoBox' + IntToStr(ItemBoxIndex), False) then
            begin
              Code := 10;
              if g_FunctionNPC <> nil then
              begin
                Code := 11;
                g_FunctionNPC.GotoLable(Self, '@ItemIntoBox' + IntToStr(ItemBoxIndex), False);
              end;
            end;
          end
          else
          begin
            Code := 12;
            if g_FunctionNPC <> nil then
            begin
              Code := 13;
              m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(Self, '@ItemIntoBox' + IntToStr(ItemBoxIndex), False);
            end;
          end;
          Exit;
        end;
      end;
    end;
    Code := 14;
    SendDefMessage(SM_MOVETOITEMBOX_FAIL, 0, 0, 0, 0, '');
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TPlayObject:ClientMoveToItemBox ' + IntToStr(Code));
      MainOutMessage(E.Message);
    end;
  end;
end;

// 自定义OK框物品到包裹 chongchong 2013-10-31
procedure TPlayObject.ClientMoveItemBoxToBag(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  ItemBoxIndex: Integer;
  Code: Integer;
begin
  ItemBoxIndex := ProcessMsg.nParam2;
  if m_boOffLine or m_boGhost or (not(ItemBoxIndex in [Low(THumanItemBoxItems) .. High(THumanItemBoxItems)])) then
  begin
    SendDefMessage(SM_MOVEITEMBOXTOBAG_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  Code := 0;
  try
    if m_ItemBoxItems[ItemBoxIndex] > 0 then
    begin
      m_ItemBoxItems[ItemBoxIndex] := 0;
      Code := 1;
      if m_ItemBoxNpc <> nil then
      begin
        Code := 2;
        m_nScriptGotoCount := 0;
        if not TNormNpc(m_ItemBoxNpc).GotoLable(Self, '@ItemOutBox' + IntToStr(ItemBoxIndex), False) then
        begin
          Code := 3;
          if g_FunctionNPC <> nil then
          begin
            Code := 4;
            g_FunctionNPC.GotoLable(Self, '@ItemOutBox' + IntToStr(ItemBoxIndex), False);
          end;
        end;
      end
      else
      begin
        Code := 5;
        if g_FunctionNPC <> nil then
        begin
          Code := 6;
          m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Self, '@ItemOutBox' + IntToStr(ItemBoxIndex), False);
        end;
      end;
      Code := 7;
      SendDefMessage(SM_MOVEITEMBOXTOBAG_OK, 0, 0, 0, 0, '');
    end
    else
      SendDefMessage(SM_MOVEITEMBOXTOBAG_FAIL, 0, 0, 0, 0, '');
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TPlayObject:ClientMoveItemBoxToBag ' + IntToStr(Code));
      MainOutMessage(E.Message);
    end;
  end;
end;

