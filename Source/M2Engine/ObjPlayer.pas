{ TODO -ochongchong -c新增 : 骑马 召唤/收回坐骑 【2013-10-12】 }
procedure TPlayObject.ClientTakeHorse(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  dwTime: LongWord;
begin
  if ProcessMsg.nParam1 = 1 then
  begin
    if m_boShopStall then
    begin
      SysMsg(g_sHorseStopShop, c_Red, t_Hint);
      Exit;
    end;
    // 2020-08-22 12:28:15
    if m_nChangeAppr >= 0 then
    begin
      SysMsg('变身状态不允许骑马', c_Red, t_Hint);
      Exit;
    end;
    if m_boOnHorse then
      Exit;
    if (m_btHorseType = 0) then
    begin
      SysMsg(g_sHorseBrand, c_Red, t_Hint);
      Exit;
    end;
    if m_PEnvir.m_boNOHORSE then
    begin
      SysMsg(g_sHorseMapDisable, c_Red, t_Hint);
      Exit;
    end;
    StopCollect;
    dwTime := MyGetTickCount - m_dwDownHorseTick;
    if dwTime < g_Config.dwHorseTakeTime * 1000 then
    begin
      dwTime := g_Config.dwHorseTakeTime * 1000 - dwTime;
      if dwTime mod 1000 > 0 then
        dwTime := dwTime div 1000 + 1
      else
        dwTime := dwTime div 1000;
      SysMsg(Format(g_sHorseTime, [dwTime]), c_Red, t_Hint);
      Exit;
    end;
    if (not m_boCanOnHorse) and (g_Config.dwTakeOnHorseUseTime > 1) then
    begin
      m_boCanOnHorse := True;
      m_dwCanOnHorseTime := MyGetTickCount + LongWord(g_Config.dwTakeOnHorseUseTime * 1000);
      if m_btRaceServer = RC_PLAYOBJECT then
        SendDefMessage(SM_SHOWPROGRESSBAR, NativeInt(Self), 2, CM_CLICKBOX, g_Config.dwTakeOnHorseUseTime, '正在准备坐骑...');
      Exit;
    end
    else if (g_Config.dwTakeOnHorseUseTime > 1) and (m_boCanOnHorse and (MyGetTickCount < m_dwCanOnHorseTime)) then
    begin
      SysMsg('坐骑正在恢复，暂时无法骑乘！', c_Red, t_Hint);
      Exit;
    end;
    // 在跑的过程中按快捷键上下马 chongchong 2015-07-04
    m_boOnHorse := True;
    m_dwClientTakeHorseTick := MyGetTickCount;
    m_boCanOnHorse := False;
    m_dwCanOnHorseTime := 0;
    m_boHorseMaster := True;
    m_HorseOtherHum := nil;
    FeatureChanged();
    RefShowName;
    TriggerHorseScript;
  end
  else
  begin
    if m_boOnHorse then
    begin
      if m_HorseOtherHum <> nil then
      begin
        { 骑马发起人下马，被邀请人也下马 chongchong 2013-10-14 }
        if m_boHorseMaster then
        begin
          m_HorseOtherHum.m_boOnHorse := False;
          m_HorseOtherHum.m_dwDownHorseTick := MyGetTickCount;
          m_HorseOtherHum.m_dwClientTakeHorseTick := MyGetTickCount;
        end;
        m_HorseOtherHum.m_HorseOtherHum := nil;
        m_HorseOtherHum.DoTalkStatusChanged;
        m_HorseOtherHum.TriggerHorseScript;
        if m_boHorseMaster then
          m_HorseOtherHum.SendTakeOffHorse;
      end;
      StopCollect;
      m_boOnHorse := False;
      m_dwClientTakeHorseTick := MyGetTickCount;
      m_dwDownHorseTick := MyGetTickCount;
      m_HorseOtherHum := nil;
      DoTalkStatusChanged;
      TriggerHorseScript;
      if not m_boHorseMaster then
        SendTakeOffHorse;
    end;
  end;
end;

{ TODO -ochongchong -c新增 : 骑马 邀请别人共骑 【2013-10-13】 }
procedure TPlayObject.ClientInviteHorse(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nX, nY: Integer;
  BaseObject: TBaseObject;
  StdItem: pTStdItem;
begin
  BaseObject := TBaseObject(ProcessMsg.nParam1);
  nX := ProcessMsg.nParam2;
  nY := ProcessMsg.nParam3;
  // 邀请人必须在马上，并且骑的是双人马 chongchong 2013-10-13
  if (m_boOnHorse) and (m_btHorseType in [1, 2]) then
  begin
    // 如果是被邀请骑马的人或者马上已经坐了两个人，则不能邀请
    if (not m_boHorseMaster) or (m_HorseOtherHum <> nil) then
    begin
      Exit;
    end;
    if (m_UseItems[U_HORSE].wIndex = 0) then
    begin
      // 非合击界面，马牌不放在蜡烛位置 chongchong 2014-08-12
      if m_UseItems[U_RIGHTHAND].wIndex > 0 then
      begin
        StdItem := UserEngine.GetStdItem(m_UseItems[U_RIGHTHAND].wIndex);
        if (StdItem <> nil) and (StdItem.StdMode = 28) then
        begin
          if StdItem.Source = 0 then
          begin
            SysMsg(g_sHorseNotInvitePlayer, c_Red, t_Hint);
            Exit;
          end;
        end;
      end;
    end
    else
    begin
      StdItem := UserEngine.GetStdItem(m_UseItems[U_HORSE].wIndex);
      if StdItem <> nil then
      begin
        if StdItem.Source = 0 then
        begin
          SysMsg(g_sHorseNotInvitePlayer, c_Red, t_Hint);
          Exit;
        end;
      end;
    end;
    if (BaseObject = nil) then
      BaseObject := TBaseObject(m_PEnvir.GetMovingObject(nX, nY, False));
    if BaseObject = nil then
    begin
      SysMsg(g_sHorseInviteNoPlayer, c_Red, t_Hint);
      Exit;
    end;
    if BaseObject.m_btRaceServer <> RC_PLAYOBJECT then
    begin
      SysMsg(g_sHorseInviteMustPlayer, c_Red, t_Hint);
      Exit;
    end;
    if TPlayObject(BaseObject).m_boDisableHorseInvite then
    begin
      SysMsg(g_sPoseDisableHorseInviteMsg, c_Red, t_Hint);
      Exit;
    end;
    // 2020-08-22 12:28:15
    if TPlayObject(BaseObject).m_nChangeAppr >= 0 then
    begin
      SysMsg('被邀请人在变身状态，不允许邀请', c_Red, t_Hint);
      Exit;
    end;
    if CretInNearXY(BaseObject, nX, nY) then
    begin
      if (abs(m_nCurrX - nX) > 3) or (abs(m_nCurrY - nY) > 3) then
      begin
        SysMsg(g_sHorseInviteFar, c_Red, t_Hint);
        Exit;
      end;
      if TPlayObject(BaseObject).m_boOnHorse then
      begin
        SysMsg(g_sHorseInviteOnHorse, c_Red, t_Hint);
        Exit;
      end;
      TPlayObject(BaseObject).m_InviteHorseHum := Self;
      TPlayObject(BaseObject).m_dwInviteHorseTick := MyGetTickCount;
      TPlayObject(BaseObject).SendMsg(BaseObject, RM_INVITEHORSE, 0, NativeInt(Self), 0, 0, '');
    end
    else
    begin
      SysMsg(g_sHorseInviteNoPlayer, c_Red, t_Hint);
      Exit;
    end;
  end;
end;

procedure TPlayObject.ClientResponseInviteHorse(ProcessMsg: pTProcessMessage; var boResult: Boolean);
begin
  if m_InviteHorseHum = nil then
    Exit;
  if ProcessMsg.nParam1 = 0 then
  begin
    m_InviteHorseHum.SysMsg(Format(g_sResponseHorseNo, [m_sCharName]), c_Red, t_Hint);
  end
  else
  begin
    if MyGetTickCount - m_dwInviteHorseTick > 4000 then
    begin
      // 接受邀请失败，接受超时
      SysMsg(Format(g_sResponseHorseTimeOut, [m_InviteHorseHum.m_sCharName]), c_Red, t_Hint);
      Exit;
    end;
    if m_InviteHorseHum.m_HorseOtherHum <> nil then
    begin
      // 接受邀请失败，邀请人马上已经有另一个人了
      SysMsg(Format(g_sResponseHorseOtherPlayer, [m_InviteHorseHum.m_sCharName]), c_Red, t_Hint);
      Exit;
    end;
    if (abs(m_InviteHorseHum.m_nCurrX - m_nCurrX) > 3) or (abs(m_InviteHorseHum.m_nCurrY - m_nCurrY) > 3) then
    begin
      // 与邀请人距离太远
      SysMsg(Format(g_sResponseHorseFar, [m_InviteHorseHum.m_sCharName]), c_Red, t_Hint);
      Exit;
    end;
    if m_nChangeAppr >= 0 then
    begin
      SysMsg('变身状态，不能上马', c_Red, t_Hint);
      Exit;
    end;
    m_InviteHorseHum.m_HorseOtherHum := Self;
    if m_TargetCret <> nil then
      m_TargetCret := nil;
    if m_boMagicAttack then
      m_boMagicAttack := False;
    m_boOnHorse := True;
    m_btHorseType := m_InviteHorseHum.m_btHorseType; // 骑马 - 马类型 chongchong 2013-10-13
    m_boHorseMaster := False; // 骑马 - 是否为骑马邀请人 chongchong 2013-10-13
    m_HorseOtherHum := m_InviteHorseHum; // 骑马 - 马上的另一个人 chongchong 2013-10-13
    m_HorseOtherHum.FeatureChanged;
    m_HorseOtherHum.RefShowName;
    FeatureChanged;
    RefShowName;
    if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, TPlayObject(m_HorseOtherHum).m_nCurrX,
      TPlayObject(m_HorseOtherHum).m_nCurrY, False) then
    begin
      m_nCurrX := TPlayObject(m_HorseOtherHum).m_nCurrX;
      m_nCurrY := TPlayObject(m_HorseOtherHum).m_nCurrY;
      m_btDirection := TPlayObject(m_HorseOtherHum).m_btDirection;
      SendMsg(Self, RM_SYNCSCREEN, 3, m_nCurrX, m_nCurrY, m_btDirection, '');
    end;
    if g_FunctionNPC <> nil then
    begin
      m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(Self, '@UpHorse', False);
    end;
  end;
  m_InviteHorseHum := nil;
  m_dwInviteHorseTick := 0;
end;

