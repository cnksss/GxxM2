        else
          NewMessageBodyWL.lTag2 := BaseObject.m_WAbil.Level; // 受攻击者等级 chongchong 2014-10-27 10:46:50
        NewMessageBodyWL.lTag3 := BaseObject.m_WAbil.MaxMP; // 受攻击者最大mp chongchong 2014-10-27 15:43:34
        NewMessageBodyWL.lTag4 := BaseObject.m_nCharStatus; // 受攻击者状态
