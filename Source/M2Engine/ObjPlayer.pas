          HiWord(m_nGameGold), 0, '');
      2:
        SendDefMessage(SM_CHALLENGECHGGAMEDIAMOND_FAIL, m_nChallengeGameDiamonds, LoWord(m_nGameGird),
          HiWord(m_nGameGird), 0, '');
    end;
  end;
end;

procedure TPlayObject.ClientChallengeStart(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 开始挑战
var
  boIsChallenge: Boolean;
  UserObject: TPlayObject;
begin
  if (m_ChallengeCreat = nil) or m_boChallengeOK or m_boChallengeStart then
    Exit;
  m_boChallengeOK := True;
  if ((MyGetTickCount - m_ChallengeLastTick) < g_Config.dwChallengeOKTime { 1000 } ) or
    ((MyGetTickCount - m_ChallengeCreat.m_ChallengeLastTick) < g_Config.dwChallengeOKTime { 1000 } ) then
  begin
    SysMsg(g_sChallengeOKTooFast, c_Red, t_Hint);
    ChallengeCancel();
    Exit;
  end;
  if m_ChallengeCreat.m_boChallengeOK then
  begin
    boIsChallenge := True;
    if (GetMaxBagCount - m_ItemList.Count) < m_ChallengeCreat.m_ChallengeItemList.Count then
    begin
      boIsChallenge := False;
      SysMsg(g_sYourBagSizeTooSmall, c_Red, t_Hint);
    end;
    if (m_nGoldMax - m_nGold) < m_ChallengeCreat.m_nChallengeGolds then
    begin
      SysMsg(g_sYourGoldLargeThenLimit, c_Red, t_Hint);
      boIsChallenge := False;
    end;
    if (m_ChallengeCreat.GetMaxBagCount - m_ChallengeCreat.m_ItemList.Count) < m_ChallengeItemList.Count then
    begin
      SysMsg(g_sChallengeHumanBagSizeTooSmall, c_Red, t_Hint);
      boIsChallenge := False;
    end;
    if (m_ChallengeCreat.m_nGoldMax - m_ChallengeCreat.m_nGold) < m_nChallengeGolds then
    begin
      SysMsg(g_sChallengeHumanGoldLargeThenLimit, c_Red, t_Hint);
      boIsChallenge := False;
    end;
    if boIsChallenge then
    begin
      UserObject := TPlayObject(m_ChallengeCreat);
      UserObject.SendDefMessage(SM_CHALLENGESUCCESS, 0, 0, 0, 0, '');
      UserObject.SysMsg(g_sChallengeSuccessMsg { 开始挑战 } , c_Green, t_Hint);
      UserObject.m_boChallengeing := True;
      UserObject.m_boChallengeOK := True;
      UserObject.m_boChallengeStart := True; // 开始挑战
      UserObject.m_dwChallengeStartTick := MyGetTickCount;
      SendDefMessage(SM_CHALLENGESUCCESS, 0, 0, 0, 0, '');
      SysMsg(g_sChallengeSuccessMsg { 开始挑战 } , c_Green, t_Hint);
      // 调用脚本，脚本中有 ChallengeMapMove，将2个人都传入挑战地图则不处理
      if g_FunctionNPC <> nil then
      begin
        m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Self, '@Challenge', False);
      end;
      // 不用设置了对方的状态，在[@Challenge]调用ChallengeMapMove中处理 chongchong 2017-10-18
      {
        m_boChallengeing := True;
        m_boChallengeOK := True;
        m_boChallengeStart := True; //开始挑战
        m_dwChallengeStartTick := MyGetTickCount;
      }
    end
    else
    begin
      ChallengeCancel();
    end;
  end
  else
  begin // 004DE439
    SysMsg(g_sYouChallengeOKMsg { '你已经确认交易了' } , c_Green, t_Hint);
    m_ChallengeCreat.SysMsg(g_sPoseChallengeOKMsg { '对方已经确认交易了' } , c_Green, t_Hint);
  end;
end;

procedure TPlayObject.ClientUpgradeDialog(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function CheckCanUpgrade(StdItem1, StdItem2: pTStdItem; UserItem1: pTUserItem; nRANDOM: Integer = 0): Boolean; // nRandom 59机率宝石
  var
    nC: Integer;
  begin
    Result := True;
    case StdItem2.StdMode of
      55:
        begin
          nC := StdItem2.DuraMax + nRANDOM;
          Result := (Random(100) <= nC);
        end;
      56:
        begin
          nC := StdItem2.DuraMax + nRANDOM;
          Result := (Random(100) <= nC);
        end;
      57:
        begin
          nC := StdItem2.DuraMax + nRANDOM;
          Result := (Random(100) <= nC);
        end;
      58:
        begin
          nC := StdItem2.DuraMax + nRANDOM;
          Result := (Random(100) <= nC);
        end;
      59:
        begin
          Result := True;
        end;
    end;
  end;
  function CanUpgrade(StdItem1, StdItem2: pTStdItem; UserItem1: pTUserItem): Boolean;
  var
    btLow, btHigh: Byte;
    nWhere1, nWhere2: Integer;
  begin
    Result := True;
    nWhere1 := GetTakeOnPosition(StdItem1.StdMode);
    nWhere2 := GetTakeOnPosition(StdItem2.Shape);
    case StdItem2.StdMode of
      55:
        begin
          if (nWhere1 <> nWhere2) then
          begin
            SysMsg(Format('%s只能升级%s！', [StdItem2.Name, GetUseItemName(nWhere2)]), c_Red, t_Hint);
            Result := False;
            Exit;
          end;
          if StdItem2.AniCount <= UserItem1.btUpgradeCount then
          begin
            SysMsg(Format('%s只能升级不大于%d星的装备！', [StdItem2.Name, StdItem2.AniCount]), c_Red, t_Hint);
            Result := False;
            Exit;
          end;
          if StdItem2.NeedLevel > 0 then
          begin
            btHigh := StdItem2.NeedLevel mod High(Word);
