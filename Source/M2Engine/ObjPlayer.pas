{$IF NEED_KEY <> 2}
var
  IsOK: Boolean;
  I: Integer;
  UserItem: pTUserItem;
  nMakeIndex: Integer;
{$IFEND}
begin
{$IF NEED_KEY <> 2}
  IsOK := False;
