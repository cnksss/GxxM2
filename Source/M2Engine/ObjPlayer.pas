procedure TPlayObject.ClientGetBackBox(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  UserItem: pTUserItem;
begin
  if (m_BoxConfig.Box <> nil) and (not m_BoxConfig.boOpen) and (m_BoxConfig.UserItem.wIndex > 0) and
    (m_BoxConfig.UserItem.MakeIndex = ProcessMsg.nParam1) then
  begin
    if IsEnoughBag then
    begin
      New(UserItem);
      UserItem^ := m_BoxConfig.UserItem;
      m_ItemList.Add(UserItem);
      SendAddItem(UserItem);
    end
    else
      DropItemDown(@m_BoxConfig.UserItem, 3, False, Self, nil);

    m_BoxConfig.UserItem.wIndex := 0;
    m_BoxConfig.boOpen := False;
    m_BoxConfig.boRotation := False;
    m_BoxConfig.Box := nil;
    m_BoxConfig.ItemList.Clear;
  end;
end;

// 打开宝箱
procedure TPlayObject.ClientOpenBox(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  Msg: string;
begin
  if (m_BoxConfig.Box <> nil) and (not m_BoxConfig.boOpen) then
  begin
    for I := 0 to m_ItemList.Count - 1 do
    begin
      UserItem := m_ItemList.Items[I];
      if UserItem.MakeIndex = ProcessMsg.nParam1 then
      begin
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        // 检测钥匙是否匹配
        if (StdItem <> nil) and (StdItem.StdMode = 40) and (CompareText(StdItem.Name, ProcessMsg.sMsg) = 0) and
          (m_BoxConfig.StdItem.Shape = StdItem.Shape) then
        begin
          m_BoxConfig.boOpen := True;
          m_BoxConfig.UserItem.wIndex := 0;
          // 删除钥匙
          m_ItemList.Delete(I);
          Dispose(UserItem);
          Break;
        end
        else
        begin
          Msg := StringReplace(g_BoxKeyError, '%key', StdItem.Name, []);
          Msg := StringReplace(Msg, '%box', m_BoxConfig.StdItem.Name, []);
          SysMsg(Msg, g_Config.btBlueMsgFColor, g_Config.btBlueMsgBColor, t_Hint);
        end;
      end;
    end;
    if m_BoxConfig.boOpen then
    begin
      // 获得宝箱内物品
      GetBoxItems;
      Exit;
    end; // if m_BoxConfig.boOpen then begin
  end;
  m_DefMsg := MakeDefaultMsg(SM_OPENBOX_FAIL, 0, 0, 0, 0); // 开宝箱失败
  SendSocket(@m_DefMsg, '');
end;

// 转动宝箱 piaoyun 2013-08-23
procedure TPlayObject.ClientRotationBox(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function GetIndex(I: Byte): Integer;
  var
    StartTick: DWORD;
    nIndex: Integer;
  begin
    StartTick := MyGetTickCount;
    while True do
    begin
      if MyGetTickCount - StartTick > 2000 then
      begin
        Result := -1;
        Break;
      end;
      nIndex := Random(9);
      if (Integer(m_BoxConfig.ItemList.Objects[nIndex]) in [0, I]) then
      begin
        Result := nIndex;
        Break;
      end;
    end;
  end;

begin
  if (m_BoxConfig.Box <> nil) then
  begin
    // 第一次旋转 免费
    if (m_BoxConfig.boOpen) and (not m_BoxConfig.boRotation) then
    begin
      m_BoxConfig.boRotation := True;
      // m_BoxConfig.boOpen := False;
      // 宝箱结果
      m_BoxConfig.nIndex := GetIndex(0);
    end
    else
    begin
      if m_BoxConfig.Box.BoxSet.boNext and (m_nGold >= m_BoxConfig.Box.BoxSet.nNowGold) and
        (m_nGameGold >= m_BoxConfig.Box.BoxSet.nNowGameGold) then
      begin
        Dec(m_nGold, m_BoxConfig.Box.BoxSet.nNowGold);
        Dec(m_nGameGold, m_BoxConfig.Box.BoxSet.nNowGameGold);
        if (m_BoxConfig.Box.BoxSet.nNowGold >= m_BoxConfig.Box.BoxSet.nEndGold) and
          (m_BoxConfig.Box.BoxSet.nNowGameGold >= m_BoxConfig.Box.BoxSet.nEndGameGold) then
        begin
          m_BoxConfig.nIndex := GetIndex(1);
        end
        else
        begin
          m_BoxConfig.nIndex := GetIndex(0);
        end;
        GoldChanged;
      end;
    end;
    // SysMsg(m_BoxConfig.ItemList[m_BoxConfig.nIndex],255,0,t_Hint);;
    if (m_BoxConfig.Box.BoxSet.boNext) and (m_BoxConfig.Box.BoxSet.nNowCount < m_BoxConfig.Box.BoxSet.nCount) then
    begin
      m_BoxConfig.Box.BoxSet.nNowGold := Integer(m_BoxConfig.Box.BoxSet.nGold + m_BoxConfig.Box.BoxSet.nAddGold *
        m_BoxConfig.Box.BoxSet.nNowCount);
      m_BoxConfig.Box.BoxSet.nNowGameGold := Integer(m_BoxConfig.Box.BoxSet.nGameGold + m_BoxConfig.Box.BoxSet.nAddGameGold *
        m_BoxConfig.Box.BoxSet.nNowCount);
      Inc(m_BoxConfig.Box.BoxSet.nNowCount);
      SendDefMessage(SM_SENDGETBOXITEMINDEX, m_BoxConfig.Box.BoxSet.nNowGold, LoWord(m_BoxConfig.Box.BoxSet.nNowGameGold),
        HiWord(m_BoxConfig.Box.BoxSet.nNowGameGold), m_BoxConfig.nIndex, '');
    end
    else
    begin
      m_BoxConfig.Box.BoxSet.boNext := False;
      SendDefMessage(SM_SENDGETBOXITEMINDEX, -1, Word(-1), Word(-1), m_BoxConfig.nIndex, '');
    end;
  end;
end;

procedure TPlayObject.ClientGetBoxItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function GetNameAndCount(BoxItemName: string; var sName: string; var nCount: Integer): Boolean;
  var
    I: Integer;
  begin
    Result := False;
    I := Pos('{#;>', BoxItemName);
    if I <> 0 then
    begin
      sName := Copy(BoxItemName, 1, I - 1);
      nCount := StrToIntDef(Copy(BoxItemName, I + 4, MaxInt), 0);
      Result := True;
    end;
  end;

var
  UserItem, OverLapItem: pTUserItem;
  sItemName: string;
  I, nCount, nItemIdx: Integer;
  sName: string;
  dwInt: LongWord;
  dGetCount: Integer;
  sMsg: string;
  StdItem: pTStdItem;
  OverLapItemsCount: Integer;
  Int64Value: Int64;
begin
  if (m_BoxConfig.Box <> nil) and (m_BoxConfig.boOpen) then
  begin
    sItemName := '';
    // 根据中奖号码获取物品名
    sItemName := m_BoxConfig.ItemList.Strings[m_BoxConfig.nIndex];
    nCount := 1;
    if (sItemName <> '') and GetNameAndCount(sItemName, sName, nCount) then
    begin
      nItemIdx := UserEngine.GetStdItemIdx(sName);
      StdItem := UserEngine.GetStdItem(nItemIdx);
      if CompareStr(sName, '经验') = 0 then
      begin
        Int64Value := Int64(m_Abil.Exp) + LongWord(nCount);
        if Int64Value > High(LongWord) then
          dwInt := High(LongWord) - m_Abil.Exp
        else
          dwInt := LongWord(nCount);
        GetExp(dwInt);
        SysMsg(Format('恭喜：获得经验值:%d', [dwInt]), c_Red, t_System);
      end
      else if CompareStr(sName, g_Config.sCreditPointName) = 0 then
      begin
        Inc(m_WAbil.CreditPoint, nCount);
        if m_WAbil.CreditPoint < 0 then
          m_WAbil.CreditPoint := 0;
        SysMsg(Format('恭喜：获得%s:%d，你当前声望点为:%d', [g_Config.sCreditPointName, nCount, m_WAbil.CreditPoint]), c_Red, t_System);
      end
      else if CompareStr(sName, g_Config.sGameDiamondName) = 0 then
      begin
        Inc(m_nGameDiamond, nCount);
        NewGamePointChanged;
        SysMsg(Format('恭喜：获得%s:%d，你当前金刚石为:%d', [g_Config.sGameDiamondName, nCount, m_nGameDiamond]), c_Red, t_System);
      end
      // 宝箱物品支持物品数量 +  chongchong 2014-01-06
      else
      begin
        dGetCount := 0;
        if StdItem <> nil then
        begin
          UserItem := nil;
          if CheckOverLapItem(StdItem) then
          begin
            while True do
            begin
              if nCount <= 0 then
                Break;
              // 宝箱叠加物品 不自动重叠到已有的物品上面 chongchong 2014-06-03
              OverLapItemsCount := OverLapBagItemCount(Self, StdItem, OverLapItem);
              if OverLapItemsCount > 0 then
              begin
                if OverLapItemsCount > nCount then
                begin
                  OverLapItem.Dura := OverLapItem.Dura + nCount;
                  Inc(dGetCount, nCount);
                  nCount := 0
                end
                else
                begin
                  OverLapItem.Dura := OverLapItem.Dura + OverLapItemsCount;
                  Inc(dGetCount, OverLapItemsCount);
                  nCount := nCount - OverLapItemsCount;
                end;
                UserItem := OverLapItem;
                SendUpdateItemDura(-1, OverLapItem.MakeIndex, False, OverLapItem.Dura);
                WeightChanged;
              end
              else if IsEnoughBag then
              begin
                New(UserItem);
                if UserEngine.CopyToUserItemFromName(sName, UserItem) then
                begin
                  if UserItem.DuraMax > nCount then
                  begin
                    UserItem.Dura := nCount - 1;
                    Inc(dGetCount, nCount);
                    nCount := 0;
                  end
                  else
                  begin
                    UserItem.Dura := UserItem.DuraMax - 1;
                    Inc(dGetCount, UserItem.DuraMax);
                    nCount := nCount - UserItem.DuraMax;
                  end;
                  UserItem.ItemFrom.ItemForm := ifBoxGive;
                  UserItem.ItemFrom.sMakerName := m_sCharName;
                  UserItem.ItemFrom.DateTime := Now();
                  m_ItemList.Add(UserItem);
                  SendAddItem(UserItem);
                end
                else
                begin
                  Dispose(UserItem);
                  UserItem := nil;
                  Break;
                end;
              end
              else
              begin
                New(UserItem);
                if UserEngine.CopyToUserItemFromName(sName, UserItem) then
                begin
                  if UserItem.DuraMax > nCount then
                  begin
                    UserItem.Dura := nCount - 1;
                    nCount := 0;
                  end
                  else
                  begin
                    UserItem.Dura := UserItem.DuraMax - 1;
                    nCount := nCount - UserItem.DuraMax;
                  end;
                  UserItem.ItemFrom.ItemForm := ifBoxGive;
                  UserItem.ItemFrom.sMakerName := m_sCharName;
                  UserItem.ItemFrom.DateTime := Now();
                  DropItemDown(UserItem, 3, False, Self, nil);
                end;
                Dispose(UserItem);
                UserItem := nil;
              end;
            end;
            { TODO -ochongchong -c新增 : 宝箱提示 【2013-08-27】 }
            if dGetCount > 0 then
            begin
              if g_ItemRules.Get(nItemIdx, 23) then
              begin
                sMsg := WideReplaceText(g_sBoxsItemHintMsg, '%name', m_sCharName);
                // sMsg := StringReplace(g_sBoxsItemHintMsg, '%s', sItemName, [rfReplaceAll]);
                sMsg := Format(sMsg, [sName]);
                { 发广播消息 }
                UserEngine.SendBroadCastMsg(sMsg, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_Hint);
              end;
              // 宝箱物品触发 2020-09-28 20:45:51
              if (g_FunctionNPC <> nil) and g_ItemRules.Get(nItemIdx, 29) then
              begin
                if (UserItem <> nil) then
                  m_nCurrentItemMakeIndex := UserItem.MakeIndex;
                m_sCurrentItemName := StdItem.Name;
                m_sCurrentItemNewName := StdItem.Name;
                g_FunctionNPC.GotoLable(Self, '@GetBoxsItem', False);
                m_nCurrentItemMakeIndex := 0;
                m_sCurrentItemName := '';
                m_sCurrentItemNewName := '';
              end;
              if g_FunctionNPC <> nil then
              begin
                try
                  g_FunctionNPC.GotoLable(Self, '@GetBoxsItem' + IntToStr(m_BoxConfig.StdItem.Shape), False);
                except
                end;
              end;
              SysMsg(Format('恭喜：你获得了：%s:%d', [sName, dGetCount]), g_Config.btBlueMsgFColor, g_Config.btBlueMsgBColor, t_Hint);
            end;
          end
          // 非叠加物品 chongchong 2014-06-03
          else
          begin
            for I := 0 to nCount - 1 do
            begin
              New(UserItem);
              if UserEngine.CopyToUserItemFromName(sName, UserItem) then
              begin
                m_sString[0] := sName;
                UserItem.ItemFrom.ItemForm := ifBoxGive;
                UserItem.ItemFrom.sMakerName := m_sCharName;
                UserItem.ItemFrom.DateTime := Now();
                if IsEnoughBag then
                begin
                  m_ItemList.Add(UserItem);
                  SendAddItem(UserItem);
                  Inc(dGetCount);
                  { TODO -ochongchong -c新增 : 宝箱提示 【2013-08-27】 }
                  if g_ItemRules.Get(nItemIdx, 23) then
                  begin
                    sMsg := WideReplaceText(g_sBoxsItemHintMsg, '%name', m_sCharName);
                    // sMsg := StringReplace(g_sBoxsItemHintMsg, '%s', sItemName, [rfReplaceAll]);
                    sMsg := Format(sMsg, [sName]);
                    { 发广播消息 }
                    UserEngine.SendBroadCastMsg(sMsg, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_Hint);
                  end;
                end
                else
                begin
                  DropItemDown(UserItem, 3, False, Self, nil);
                  Dispose(UserItem);
                  UserItem := nil;
                end;
                // 宝箱物品触发 2020-09-28 20:45:51
                if (g_FunctionNPC <> nil) and g_ItemRules.Get(nItemIdx, 29) then
                begin
                  if (UserItem <> nil) then
                    m_nCurrentItemMakeIndex := UserItem.MakeIndex;
                  m_sCurrentItemName := StdItem.Name;
                  m_sCurrentItemNewName := StdItem.Name;
                  g_FunctionNPC.GotoLable(Self, '@GetBoxsItem', False);
                  m_nCurrentItemMakeIndex := 0;
                  m_sCurrentItemName := '';
                  m_sCurrentItemNewName := '';
                end;
                if g_FunctionNPC <> nil then
                begin
                  try
                    g_FunctionNPC.GotoLable(Self, '@GetBoxsItem' + IntToStr(m_BoxConfig.StdItem.Shape), False);
                  except
                  end;
                end;
              end
              else
                Dispose(UserItem);
            end;
            if dGetCount > 0 then
              SysMsg(Format('恭喜：你获得了：%s:%d', [sName, dGetCount]), g_Config.btBlueMsgFColor, g_Config.btBlueMsgBColor, t_Hint);
          end;
        end;
      end;
    end;
  end;
  m_BoxConfig.boOpen := False;
  m_BoxConfig.boRotation := False;
  m_BoxConfig.UserItem.wIndex := 0;
  if m_BoxConfig.Box <> nil then
    Dispose(m_BoxConfig.Box);
  m_BoxConfig.Box := nil;
  m_BoxConfig.ItemList.Clear;
end;

procedure TPlayObject.ClientGameGoldDealSell(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  GameGoldDeal: TGameGoldDeal;
  ClientItems: array [0 .. 8] of TGameGoldDealItem;
  S: string;
  sItemName: string;
  I, II: Integer;
  nIndex, nCount: Integer;
  UserItem: pTUserItem;
  boFind: Boolean;
  DealItems: TDealItems;
  CanotDealItemList: TStringList;
  sData: string;
  IsFoundCopyItem: Boolean;
begin
  sData := ProcessMsg.sMsg;
  if not m_boGameGoldDeal then
  begin
    SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, -8, 0, 0, 0, '');
    Exit;
  end;
  nCount := 0;
  FillChar(GameGoldDeal, SizeOf(TGameGoldDeal), #0);
  FillChar(ClientItems, SizeOf(TGameGoldDealItem) * 9, #0);
  sData := GetValidStr3_Ex(sData, S, '/');
  DecodeString(S, @GameGoldDeal, SizeOf(TGameGoldDeal));
  while True do
  begin
    if (sData = '') or (nCount > 8) then
      Break;
    sData := GetValidStr3_Ex(sData, S, '/');
    DecodeString(S, @ClientItems[nCount], SizeOf(TGameGoldDealItem));
    nCount := nCount + 1;
  end;
  IsFoundCopyItem := False;
  for I := 0 to nCount - 1 do
  begin
    for II := I + 1 to nCount - 1 do
    begin
      if ClientItems[I].nMakeIndex = ClientItems[II].nMakeIndex then
      begin
        IsFoundCopyItem := True;
        Break;
      end;
    end;
    if IsFoundCopyItem then
      Break;
  end;
  if IsFoundCopyItem then
  begin
    SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, -9, 0, 0, 0, '');
    Exit;
  end;
  if nCount > 0 then
  begin
    // 寄售：先去掉这个。如果地图加了参数 SECRET 并统一为一个名字，会有问题 chongchong 2016-09-02
    if (GameGoldDeal.GameGold >= 0) and { (GameGoldDeal.SellChrName = m_sCharName) and } (GameGoldDeal.BuyChrName <> '') and
      (GameGoldDeal.BuyChrName <> m_sCharName) then
    begin // 检测名称
      if (GameGoldDeal.GameDiamond >= 0) and (GameGoldDeal.GameDiamond <= m_nGameDiamond) then
      begin
        CanotDealItemList := TStringList.Create;
        for I := 0 to nCount - 1 do
        begin // 检测提交的物品包裹中是否存在
          boFind := False;
          for II := 0 to m_ItemList.Count - 1 do
          begin
            UserItem := m_ItemList.Items[II];
            if UserItem.MakeIndex = ClientItems[I].nMakeIndex then
            begin
              if (GetUserItemBindValue(UserItem, ubNoDeal) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 1) then
              begin // 禁止交易
                sItemName := UserEngine.GetStdItemName(UserItem.wIndex);
                if CanotDealItemList.IndexOf(sItemName) < 0 then
                  CanotDealItemList.Add(sItemName);
              end;
              boFind := True;
              Break;
            end;
          end;
          if not boFind then
          begin
            SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, -9, 0, 0, 0, '');
            CanotDealItemList.Free;
            Exit;
          end;
        end;
        if CanotDealItemList.Count > 0 then
        begin
          S := '';
          for I := 0 to CanotDealItemList.Count - 1 do
          begin
            if I > 4 then
              S := S + '\';
            S := S + ' ' + CanotDealItemList.Strings[I];
          end;
          CanotDealItemList.Free;
          g_ManageNPC.MessageBox(Self, '禁止交易:\' + S);
          SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, 0, 0, 0, 0, '');
          Exit;
        end;
        CanotDealItemList.Free;
        FillChar(DealItems, SizeOf(TDealItems), #0);
        for I := 0 to nCount - 1 do
        begin
          for II := m_ItemList.Count - 1 downto 0 do
          begin
            UserItem := m_ItemList.Items[II];
            if UserItem.MakeIndex = ClientItems[I].nMakeIndex then
            begin
              DealItems[I] := UserItem^;
              Break;
            end;
          end;
        end;
        GameGoldDeal.DealState := s_Normal;
        GameGoldDeal.SellDateTime := Now;
        GameGoldDeal.ItemCount := nCount;
        nIndex := g_GameGoldDealDB.Sell(@GameGoldDeal, @DealItems);
        if nIndex = 1 then
        begin
          for I := 0 to nCount - 1 do
          begin
            for II := m_ItemList.Count - 1 downto 0 do
            begin
              UserItem := m_ItemList.Items[II];
              if UserItem.MakeIndex = ClientItems[I].nMakeIndex then
              begin
                {
                  if g_boGameLogGameGold then
                  begin
                  AddGameDataLog('28' + #9 +
                  m_sMapName + #9 +
                  IntToStr(m_nCurrX) + #9 +
                  IntToStr(m_nCurrY) + #9 +
                  m_sCharName + #9 +
                  ClientItems[I].sItemName + #9 +
                  IntToStr(UserItem.MakeIndex) + #9 +
                  '1' + #9 +
                  m_sCharName);
                  end;
                }
                m_ItemList.Delete(II);
                Dispose(UserItem);
                Break;
              end;
            end;
          end;
          // 元宝交易，卖元宝石时要扣卖家的元宝石 chongchong 2013-12-26
          if (GameGoldDeal.GameDiamond >= 0) then
          begin
            DecGameDiamond(GameGoldDeal.GameDiamond);
            NewGamePointChanged();
          end;
          SendDefMessage(SM_SELLGAMEGOLDDALITEM_OK, 0, 0, 0, 0, '');
        end
        else
          SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, nIndex, 0, 0, 0, '');
      end
      else
        SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, -7, 0, 0, 0, '');
    end
    else
      SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, -6, 0, 0, 0, '');
  end
  else
  // 允许元宝使者单独进行金刚石交易 chongchong 2014-01-05
  // SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, -5, 0, 0, 0, '');
  begin
    if (GameGoldDeal.GameDiamond = 0) then
      SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, -5, 0, 0, 0, '')
    else if (GameGoldDeal.GameDiamond > 0) then
    begin
      if (GameGoldDeal.GameDiamond <= m_nGameDiamond) then
      begin
        GameGoldDeal.DealState := s_Normal;
        GameGoldDeal.SellDateTime := Now;
        GameGoldDeal.ItemCount := 0;
        FillChar(DealItems, SizeOf(TDealItems), #0);
        nIndex := g_GameGoldDealDB.Sell(@GameGoldDeal, @DealItems);
        if nIndex = 1 then
        begin
          DecGameDiamond(GameGoldDeal.GameDiamond);
          NewGamePointChanged();
          SendDefMessage(SM_SELLGAMEGOLDDALITEM_OK, 0, 0, 0, 0, '');
        end
        else
          SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, nIndex, 0, 0, 0, '');
      end
      else
        SendDefMessage(SM_SELLGAMEGOLDDALITEM_FAIL, -7, 0, 0, 0, '');
    end;
  end;
end;

procedure TPlayObject.ClientGameGoldDealBuy(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I, nIndex, nTGameGoldCount: Integer;
  GameGoldDeal: TGameGoldDeal;
  DealItems: TDealItems;
  DealObject: TPlayObject;
  UserItem: pTUserItem;
  sItemName: string;
  StdItem: pTStdItem;
  sData: string;
begin
  if g_OnlineMsgControl.boDisableBuy then
    Exit;
  if g_OnlineMsgControl.boDisableSell then
    Exit;
  sData := ProcessMsg.sMsg;
  if not m_boGameGoldDeal then
  begin
    SendDefMessage(SM_BUYGAMEGOLDDALITEM_FAIL, -7, 0, 0, 0, '');
    Exit;
  end;
  FillChar(GameGoldDeal, SizeOf(TGameGoldDeal), #0);
  DecodeString(sData, @GameGoldDeal, SizeOf(TGameGoldDeal));
  if (GameGoldDeal.GameGold >= 0) and (GameGoldDeal.SellChrName <> '') and (GameGoldDeal.SellChrName <> m_sCharName) and
    (GameGoldDeal.BuyChrName = m_sCharName) then
  begin // 检测名称
    FillChar(DealItems, SizeOf(TDealItems), #0);
    nIndex := g_GameGoldDealDB.Buy(m_nGameGold, @GameGoldDeal, @DealItems);
    if nIndex = 1 then
    begin
      for I := 0 to GameGoldDeal.ItemCount - 1 do
      begin
        if IsEnoughBag then
        begin
          StdItem := UserEngine.GetStdItem(DealItems[I].wIndex);
          if StdItem <> nil then
          begin
            New(UserItem);
            UserItem^ := DealItems[I];
            m_ItemList.Add(UserItem);
            SendAddItem(UserItem);
            sItemName := StdItem.Name;
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemBuy, LOG_ActionNone, Self, sItemName, UserItem.MakeIndex, GameGoldDeal.SellChrName, 0, 0,
                '购买元宝寄售物品');
            end;
          end;
        end
        else
        begin
          DropItemDown(@DealItems[I], 3, False, Self, nil);
        end;
      end;
      DecGameGold(GameGoldDeal.GameGold);
      GameGoldChanged;
      if g_boGameLogGameGold then
      begin
        AddGameDataLog(LOG_GameGoldChange, LOG_ActionNone, Self, '0', 0, GameGoldDeal.SellChrName, m_nGameGold,
          -GameGoldDeal.GameGold, '购买元宝寄售物品');
      end;
      if GameGoldDeal.GameDiamond > 0 then
      begin
        IncGameDiamond(GameGoldDeal.GameDiamond);
        NewGamePointChanged;
        if g_boGameLogGameGold then
        begin
          AddGameDataLog(LOG_GameDiamondChange, LOG_ActionNone, Self, '0', 0, GameGoldDeal.SellChrName, m_nGameDiamond,
            -GameGoldDeal.GameDiamond, '购买元宝寄售物品');
        end;
      end;
      // 寄售系统扣税 chongchong 2014-01-06
      nTGameGoldCount := Round(g_Config.dwJSOfGameGoldTaxRate / 100 * GameGoldDeal.GameGold);
      DealObject := UserEngine.GetPlayObject(GameGoldDeal.SellChrName);
      if DealObject <> nil then
      begin
        DealObject.IncGameGold(GameGoldDeal.GameGold - nTGameGoldCount);
        DealObject.GameGoldChanged;
        if Length(g_sIncGameGold) > 0 then
          DealObject.SysMsg(Format(g_sIncGameGold, [GameGoldDeal.GameGold - nTGameGoldCount, g_Config.sGameGoldName]),
            g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
        if g_boGameLogGameGold then
        begin
          AddGameDataLog(LOG_ItemSell, LOG_GameGoldChange, DealObject, g_Config.sGameGoldName, 0, m_sCharName,
            DealObject.m_nGameGold, GameGoldDeal.GameGold - nTGameGoldCount, '卖出元宝寄售物品');
        end;
      end
      else
      begin
        DataEngine.HumanChangeGold(nil, nil, cgtGameGold, m_sCharName, GameGoldDeal.SellChrName,
          GameGoldDeal.GameGold - nTGameGoldCount);
        if Length(g_sIncGameGold) > 0 then
          UserEngine.AddLogonOnMessage(GameGoldDeal.SellChrName, Format(g_sIncGameGold, [GameGoldDeal.GameGold - nTGameGoldCount,
            g_Config.sGameGoldName]), g_Config.btRedMsgFColor, g_Config.btRedMsgBColor);
      end;
      SendDefMessage(SM_BUYGAMEGOLDDALITEM_OK, 0, 0, 0, 0, '');
    end
    else
      SendDefMessage(SM_BUYGAMEGOLDDALITEM_FAIL, nIndex, 0, 0, 0, '');
  end
  else
    SendDefMessage(SM_BUYGAMEGOLDDALITEM_FAIL, -5, 0, 0, 0, '');
end;

procedure TPlayObject.ClientGameGoldDealCancel(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  GameGoldDeal: TGameGoldDeal;
  DealItems: TDealItems;
  UserItem: pTUserItem;
  sItemName: string;
  StdItem: pTStdItem;
  nOldPoint: LongWord;
begin
  if not m_boGameGoldDeal then
  begin
    SendDefMessage(SM_BUYGAMEGOLDDALITEM_FAIL, -7, 0, 0, 0, '');
    Exit;
  end;
  FillChar(GameGoldDeal, SizeOf(TGameGoldDeal), #0);
  DecodeString(ProcessMsg.sMsg, @GameGoldDeal, SizeOf(TGameGoldDeal));
  if (GameGoldDeal.SellChrName <> '') and (GameGoldDeal.BuyChrName <> '') and
    ((GameGoldDeal.SellChrName = m_sCharName) or (GameGoldDeal.BuyChrName = m_sCharName)) then
  begin // 检测名称
    if (GameGoldDeal.SellChrName = m_sCharName) then
    begin // 卖家取消
      if g_GameGoldDealDB.SellerCancel(m_sCharName, m_nGameGold, @GameGoldDeal, @DealItems) then
      begin
        if GameGoldDeal.DealState = s_Expired then
        begin
          DecGameGold(1);
          GameGoldChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_GameGoldChange, LOG_ActionNone, Self, '0', 0, GameGoldDeal.BuyChrName, m_nGameGold, -1, '取消元宝寄售');
          end;
        end;
        for I := 0 to GameGoldDeal.ItemCount - 1 do
        begin
          if IsEnoughBag then
          begin
            StdItem := UserEngine.GetStdItem(DealItems[I].wIndex);
            if StdItem <> nil then
            begin
              New(UserItem);
              UserItem^ := DealItems[I];
              m_ItemList.Add(UserItem);
              SendAddItem(UserItem);
              sItemName := StdItem.Name;
              if StdItem.NeedIdentify = 1 then
              begin
                AddGameDataLog(LOG_ItemTrading, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, '取消元宝寄售');
              end;
            end;
          end
          else
          begin
            StdItem := UserEngine.GetStdItem(DealItems[I].wIndex);
            if StdItem <> nil then
            begin
              sItemName := StdItem.Name;
              if StdItem.NeedIdentify = 1 then
              begin
                AddGameDataLog(LOG_ItemDrop, LOG_ActionNone, Self, sItemName, DealItems[I].MakeIndex, '0', 0, 0, '卖家取消完宝寄售背包不足');
              end;
              DropItemDown(@DealItems[I], 3, False, Self, nil);
            end;
          end;
        end;
        if GameGoldDeal.GameDiamond > 0 then
        begin
          nOldPoint := m_nGameDiamond;
          IncGameDiamond(GameGoldDeal.GameDiamond);
          NewGamePointChanged;
          if g_boGameLogGameGold then
          begin
            AddGameDataLog(LOG_GameDiamondChange, LOG_ActionNone, Self, g_Config.sGameDiamondName, 0, '0', m_nGameDiamond,
              nOldPoint, '取回元宝寄售物品');
          end;
        end;
        SendDefMessage(SM_CANCELGAMEGOLDSELLITEM_OK, 0, 0, 0, 0, '');
      end
      else
        SendDefMessage(SM_CANCELGAMEGOLDSELLITEM_FAIL, -2, 0, 0, 0, '');
    end
    else
    begin // 买家取消
      if g_GameGoldDealDB.BuyerCancel(m_sCharName) then
      begin
        SendDefMessage(SM_CANCELGAMEGOLDDEALITEM_OK, 0, 0, 0, 0, '');
      end
      else
        SendDefMessage(SM_CANCELGAMEGOLDDEALITEM_FAIL, -2, 0, 0, 0, '');
    end;
  end
  else
    SendDefMessage(SM_CANCELGAMEGOLDDEALITEM_FAIL, -1, 0, 0, 0, '');
end;

procedure TPlayObject.ClientOverLapItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  boOverLapOK: Boolean;
  boSourceUpDate: Boolean;
  boDestUpDate: Boolean;
  UserItem: pTUserItem;
  SourceItem, DestItem: pTUserItem;
  SourceStdItem, DestStdItem: pTStdItem;
  SourceUserItem, DestUserItem: TUserItem;
  nSourceIdx, nDestIdx: Integer;
  IsCheckOK: Boolean;
begin
  boOverLapOK := False;
  boSourceUpDate := False;
  boDestUpDate := False;
  SourceItem := nil;
  SourceStdItem := nil;
  DestItem := nil;
  DestStdItem := nil;
  nSourceIdx := ProcessMsg.nParam1;
  nDestIdx := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  // 同一个物品自己叠加到自己，就是刷物品 chongchong 2019-01-20 19:07:35
  if nSourceIdx = nDestIdx then
  begin
    SendDefMessage(SM_OVERLAPITEM_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if (UserItem.wIndex > 0) and (UserItem.MakeIndex = nSourceIdx) then
    begin
      SourceStdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (SourceStdItem <> nil) then
      begin
        SourceItem := UserItem;
        // m_ItemList.Delete(I);
        if (SourceItem <> nil) and (DestItem <> nil) then
          Break;
        // Continue;
      end;
    end;
    if (UserItem.wIndex > 0) and (UserItem.MakeIndex = nDestIdx) then
    begin
      DestStdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (DestStdItem <> nil) then
      begin
        DestItem := UserItem;
        if (SourceItem <> nil) and (DestItem <> nil) then
          Break;
      end;
    end;
  end;
  if (SourceItem <> nil) and (DestItem <> nil) and (SourceStdItem = DestStdItem) and CheckOverLapItem(SourceStdItem) then
  begin
    IsCheckOK := False;
    // 物品叠加时，绑定物品和非绑定物品不能重叠 chongchong 2014-05-19
    if SourceItem.boIsBind <> DestItem.boIsBind then
      IsCheckOK := False
    else if ((not SourceItem.boIsBind) and (not DestItem.boIsBind)) then
      IsCheckOK := True
    else if SourceItem.boIsBind and DestItem.boIsBind then
    begin
      IsCheckOK := (SourceItem.btBindOption = DestItem.btBindOption);
    end;
    if IsCheckOK and (DestItem.Dura < DestItem.DuraMax - 1) then
    begin
      if DestItem.Dura + SourceItem.Dura + 1 < DestItem.DuraMax then
      begin
        DestItem.Dura := DestItem.Dura + SourceItem.Dura + 1;
        boOverLapOK := True;
        boDestUpDate := True;
        DestUserItem := DestItem^;
        if SourceStdItem.NeedIdentify = 1 then
        begin
          // 注释日志 chongchong 2017-10-09
          AddGameDataLog(LOG_ItemOverlap, LOG_ActionNone, Self, SourceStdItem.Name, DestUserItem.MakeIndex, '0',
            DestUserItem.Dura + 1, SourceItem.Dura + 1);
        end;
        for I := 0 to m_ItemList.Count - 1 do
        begin
          if SourceItem = m_ItemList.Items[I] then
          begin
            if SourceStdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, SourceStdItem.Name, SourceItem.MakeIndex, '0', 0, 0, '叠加');
            end;
            m_ItemList.Delete(I);
            Dispose(SourceItem);
            Break;
          end;
        end;
      end
      else
      begin
        SourceItem.Dura := SourceItem.Dura - (DestItem.DuraMax - DestItem.Dura - 1);
        DestItem.Dura := DestItem.DuraMax - 1;
        boSourceUpDate := True;
        boDestUpDate := True;
        SourceUserItem := SourceItem^;
        DestUserItem := DestItem^;
      end;
    end;
  end;
  WeightChanged();
  if boOverLapOK then
  begin
    SendDefMessage(SM_OVERLAPITEM_OK, 0, 0, 0, 0, '');
  end
  else
  begin
    SendDefMessage(SM_OVERLAPITEM_FAIL, 0, 0, 0, 0, '');
  end;
  if boSourceUpDate then
    SendUpdateItemDura(-1, SourceUserItem.MakeIndex, False, SourceUserItem.Dura);
  if boDestUpDate then
    SendUpdateItemDura(-1, DestUserItem.MakeIndex, False, DestUserItem.Dura);
end;

procedure TPlayObject.ClientHeroOverLapItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  boOverLapOK: Boolean;
  boSourceUpDate: Boolean;
  boDestUpDate: Boolean;
  UserItem: pTUserItem;
  SourceItem, DestItem: pTUserItem;
  SourceStdItem, DestStdItem: pTStdItem;
  SourceUserItem, DestUserItem: TUserItem;
  HeroObject: THeroObject;
  nSourceIdx, nDestIdx: Integer;
  IsCheckOK: Boolean;
begin
  HeroObject := THeroObject(m_MyHero);
  if HeroObject = nil then
    Exit;
  boOverLapOK := False;
  boSourceUpDate := False;
  boDestUpDate := False;
  SourceItem := nil;
  SourceStdItem := nil;
  DestItem := nil;
  DestStdItem := nil;
  nSourceIdx := ProcessMsg.nParam1;
  nDestIdx := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  // 同一个物品自己叠加到自己，就是刷物品 chongchong 2019-01-20 19:07:35
  if nSourceIdx = nDestIdx then
  begin
    SendDefMessage(SM_HEROOVERLAPITEM_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  for I := 0 to HeroObject.m_ItemList.Count - 1 do
  begin
    UserItem := HeroObject.m_ItemList.Items[I];
    if (UserItem.wIndex > 0) and (UserItem.MakeIndex = nSourceIdx) then
    begin
      SourceStdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (SourceStdItem <> nil) then
      begin
        SourceItem := UserItem;
        // m_ItemList.Delete(I);
        if (SourceItem <> nil) and (DestItem <> nil) then
          Break;
        // Continue;
      end;
    end;
    if (UserItem.wIndex > 0) and (UserItem.MakeIndex = nDestIdx) then
    begin
      DestStdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (DestStdItem <> nil) then
      begin
        DestItem := UserItem;
        if (SourceItem <> nil) and (DestItem <> nil) then
          Break;
      end;
    end;
  end;
  if (SourceItem <> nil) and (DestItem <> nil) and (SourceStdItem = DestStdItem) and CheckOverLapItem(SourceStdItem) then
  begin
    IsCheckOK := False;
    // 物品叠加时，绑定物品和非绑定物品不能重叠 2020-11-04 10:37:12
    if SourceItem.boIsBind <> DestItem.boIsBind then
      IsCheckOK := False
    else if ((not SourceItem.boIsBind) and (not DestItem.boIsBind)) then
      IsCheckOK := True
    else if SourceItem.boIsBind and DestItem.boIsBind then
    begin
      IsCheckOK := (SourceItem.btBindOption = DestItem.btBindOption);
    end;
    if IsCheckOK and (DestItem.Dura < DestItem.DuraMax - 1) then
    begin
      if DestItem.Dura + SourceItem.Dura + 1 < DestItem.DuraMax then
      begin
        DestItem.Dura := DestItem.Dura + SourceItem.Dura + 1;
        boOverLapOK := True;
        boDestUpDate := True;
        DestUserItem := DestItem^;
        if SourceStdItem.NeedIdentify = 1 then
        begin
          // 注释日志 chongchong 2017-10-09
          AddGameDataLog(LOG_ItemOverlap, LOG_ActionNone, HeroObject, SourceStdItem.Name, DestUserItem.MakeIndex, '0',
            DestUserItem.Dura + 1, SourceItem.Dura + 1);
        end;
        for I := 0 to HeroObject.m_ItemList.Count - 1 do
        begin
          if SourceItem = HeroObject.m_ItemList.Items[I] then
          begin
            if SourceStdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, HeroObject, SourceStdItem.Name, SourceItem.MakeIndex, '0',
                0, 0, '叠加');
            end;
            HeroObject.m_ItemList.Delete(I);
            Dispose(SourceItem);
            Break;
          end;
        end;
      end
      else
      begin
        SourceItem.Dura := SourceItem.Dura - (DestItem.DuraMax - DestItem.Dura - 1);
        DestItem.Dura := DestItem.DuraMax - 1;
        boSourceUpDate := True;
        boDestUpDate := True;
        SourceUserItem := SourceItem^;
        DestUserItem := DestItem^;
      end;
    end;
  end;
  HeroObject.WeightChanged();
  if boOverLapOK then
  begin
    HeroObject.SendDefMessage(SM_HEROOVERLAPITEM_OK, 0, 0, 0, 0, '');
  end
  else
  begin
    HeroObject.SendDefMessage(SM_HEROOVERLAPITEM_FAIL, 0, 0, 0, 0, '');
  end;
  if boSourceUpDate then
    HeroObject.SendUpdateItemDura(-1, SourceUserItem.MakeIndex, SourceUserItem.Dura);
  if boDestUpDate then
    HeroObject.SendUpdateItemDura(-1, DestUserItem.MakeIndex, DestUserItem.Dura);
end;

procedure TPlayObject.ClientPackageItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
  function PackageItem(StdItem: pTStdItem; nCount: Integer; FormItem: pTUserItem): Boolean;
  var
    UserItem: pTUserItem;
  begin
    Result := False;
    New(UserItem);
    if UserEngine.CopyToUserItemFromName(StdItem.Name, UserItem) then
    begin
      UserItem.Dura := nCount - 1;
      // 解包叠加物品时，保证与源物品的绑定属性一致 chongchong 2014-09-26
      UserItem.boIsBind := FormItem.boIsBind;
      UserItem.btBindOption := FormItem.btBindOption;
      UserItem.ItemFrom := FormItem.ItemFrom;
      m_ItemList.Add(UserItem);
      SendAddItem(UserItem);
      Result := True;
      if StdItem.NeedIdentify = 1 then
      begin
        // 注释日志 chongchong 2017-10-09
        AddGameDataLog(LOG_ItemSplit, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0', nCount, 0, '新物品');
      end;
    end
    else
    begin
      Dispose(UserItem);
    end;
  end;

var
  I: Integer;
  boPackageOK: Boolean;
  Item: pTStdItem;
  StdItem: TStdItem;
  UserItem: pTUserItem;
  PackageUserItem: TUserItem;
  ClientItem: TClientItem;
begin
  boPackageOK := False;
  if (ProcessMsg.nParam2 > 0) and IsEnoughBag then
  begin
    for I := 0 to m_ItemList.Count - 1 do
    begin
      UserItem := m_ItemList.Items[I];
      if (UserItem.MakeIndex = ProcessMsg.nParam1) and (UserItem.Dura > 0) then
      begin
        Item := UserEngine.GetStdItem(UserItem.wIndex);
        if (Item <> nil) and CheckOverLapItem(Item) then
        begin
          if ProcessMsg.nParam2 < UserItem.Dura + 1 then
          begin
            if PackageItem(Item, ProcessMsg.nParam2, UserItem) then
            begin
              StdItem := Item^;
              UserItem.Dura := UserItem.Dura - ProcessMsg.nParam2;
              PackageUserItem := UserItem^;
              boPackageOK := True;
              if StdItem.NeedIdentify = 1 then
              begin
                // 注释日志 chongchong 2017-10-09
                AddGameDataLog(LOG_ItemSplit, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0', UserItem.Dura + 1,
                  -ProcessMsg.nParam2, '源物品');
              end;
            end;
          end;
          Break;
        end;
      end;
    end;
  end;
  if boPackageOK then
  begin
    WeightChanged();
    UserItemToClientItem(@PackageUserItem, @StdItem, @ClientItem, True, True);
    m_DefMsg := MakeDefaultMsg(SM_PACKAGEITEM_OK, 0, 0, 0, 0);
    SendSocketEx(@m_DefMsg, @ClientItem, SizeOf(TClientItem));
  end
  else
  begin
    SendDefMessage(SM_PACKAGEITEM_FAIL, 0, 0, 0, 0, '');
  end;
end;

