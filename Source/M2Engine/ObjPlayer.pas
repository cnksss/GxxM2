        if (StdItem <> nil) and (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) then
        begin
          if (not HeroObject.m_boUserUnLockDurg) and (HeroObject.m_UseItems[btWhere].btValue[7] <> 0) then
          begin
            HeroObject.SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
            n10 := -4;
            goto FailExit;
          end;
        end;
        if not HeroObject.m_boUserUnLockDurg and ((StdItem.Reserved and 2) <> 0) then
        begin
          HeroObject.SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
          n10 := -4;
          goto FailExit;
        end;
        if (StdItem.Reserved and 4) <> 0 then
        begin
          HeroObject.SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
          n10 := -4;
          goto FailExit;
        end;
        if InDisableTakeOffList(HeroObject.m_UseItems[btWhere].wIndex) or
          (GetUserItemBindValue(@HeroObject.m_UseItems[btWhere], ubNoTakeOff) and HeroObject.m_UseItems[btWhere].boIsBind) then
        begin
          HeroObject.SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
          goto FailExit;
        end;
        if (HeroObject.m_UseItems[btWhere].btValue[13] = 1) and (HeroObject.m_UseItems[btWhere].Name <> '') then
          sUserItemName := HeroObject.m_UseItems[btWhere].Name
        else
          sUserItemName := UserEngine.GetStdItemName(HeroObject.m_UseItems[btWhere].wIndex);
        HeroObject.m_nCurrentItemMakeIndex := HeroObject.m_UseItems[btWhere].MakeIndex;
        HeroObject.m_nCurrentItemPos := btWhere;
        HeroObject.m_sCurrentItemName := UserEngine.GetStdItemName(HeroObject.m_UseItems[btWhere].wIndex);
        HeroObject.m_sCurrentItemNewName := sUserItemName;
        HeroObject.m_PickUpOrDropItem := HeroObject.m_UseItems[btWhere];
        HeroObject.m_boStopTakeOff := False;
        g_FunctionNPC.GotoLable(Self, '@HeroBeginTakeOff', False);
        HeroObject.m_PickUpOrDropItem.MakeIndex := 0;
        HeroObject.m_PickUpOrDropItem.wIndex := 0;
        HeroObject.m_nCurrentItemMakeIndex := 0;
        HeroObject.m_nCurrentItemPos := 0;
        HeroObject.m_sCurrentItemName := '';
        HeroObject.m_sCurrentItemNewName := '';
        if HeroObject.m_boStopTakeOff then
          goto FailExit;
        // 取自定义物品名称
        if (HeroObject.m_UseItems[btWhere].btValue[13] = 1) and (HeroObject.m_UseItems[btWhere].Name <> '') then
          sUserItemName := HeroObject.m_UseItems[btWhere].Name
        else
          sUserItemName := UserEngine.GetStdItemName(HeroObject.m_UseItems[btWhere].wIndex);
        if CompareText(sUserItemName, sItemName) = 0 then
        begin
          if (StdItem <> nil) and (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26, 75 .. 90]) and
            HeroObject.m_boUserUnLockDurg and (HeroObject.m_UseItems[btWhere].btValue[7] <> 0) then
          begin // 使用过神水的神秘装备下次可以脱下来
            HeroObject.m_boUserUnLockDurg := False;
            HeroObject.m_UseItems[btWhere].btValue[7] := 0;
          end;
          New(UserItem);
          UserItem^ := HeroObject.m_UseItems[btWhere];
          if HeroObject.AddItemToBag(UserItem) then
          begin
            HeroObject.m_UseItems[btWhere].wIndex := 0;
            HeroObject.SendAddItem(UserItem);
            HeroObject.RecalcAbilitys();
            HeroObject.SendMsg(HeroObject, RM_ABILITY, 0, 0, 0, 0, '');
            HeroObject.SendMsg(HeroObject, RM_SUBABILITY, 0, 0, 0, 0, '');
            // SendDefMessage(SM_HEROTAKEOFF_OK, GetFeatureToLong, GetFeatureEx, 0, 0, '');
            HeroObject.SendDefMessage(SM_HEROTAKEOFF_OK, 0, 0, 0, 0, '');
            HeroObject.FeatureChanged();
            if boMysteriousMan <> HeroObject.m_boMysteriousMan then // 神秘人
              HeroObject.RefShowName;
            if g_FunctionNPC <> nil then
            begin
              m_nScriptGotoCount := 0;
              HeroObject.m_nCurrentItemMakeIndex := UserItem^.MakeIndex;
              HeroObject.m_nCurrentItemPos := btWhere;
              HeroObject.m_sCurrentItemName := UserEngine.GetStdItemName(UserItem.wIndex);
              HeroObject.m_sCurrentItemNewName := sUserItemName;
              HeroObject.m_PickUpOrDropItem := UserItem^;
              g_FunctionNPC.GotoLable(Self, '@HeroTakeOff' + IntToStr(btWhere), False);
              g_FunctionNPC.GotoLable(Self, '@HeroTakeOffEx', False);
              HeroObject.m_PickUpOrDropItem.MakeIndex := 0;
              HeroObject.m_PickUpOrDropItem.wIndex := 0;
              HeroObject.m_nCurrentItemMakeIndex := 0;
              HeroObject.m_nCurrentItemPos := 0;
              HeroObject.m_sCurrentItemName := '';
              HeroObject.m_sCurrentItemNewName := '';
            end;
          end
          else
          begin
            Dispose(UserItem);
            n10 := -3;
          end;
        end;
      end;
    end
    else
      n10 := -2;
  end
  else
    n10 := -1;
FailExit:
  if n10 <= 0 then
    HeroObject.SendDefMessage(SM_HEROTAKEOFF_FAIL, n10, 0, 0, 0, '');
end;

procedure TPlayObject.ClientHeroUseItems(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 英雄吃药
var
  HeroObject: THeroObject;
  // 解包物品扩展 chongchong 2014-05-15
  function GetUnbindItemInfo(nShape: Integer): PTUnbindItemInfo;
  var
    I: Integer;
    UnbindItemInfo: PTUnbindItemInfo;
  begin
    Result := nil;
    for I := 0 to g_UnbindList.Count - 1 do
    begin
      UnbindItemInfo := g_UnbindList.Items[I];
      if UnbindItemInfo.nShape = nShape then
      begin
        Result := g_UnbindList.Items[I];
        Break;
      end;
    end;
  end;
  function GetUnBindItems(BindUserItem: pTUserItem; sItemName: string; nCount: Integer; IsDuraMax: Boolean): Boolean;
  var
    I: Integer;
    OverLapItem: pTUserItem;
    UserItem: pTUserItem;
    StdItem: pTStdItem;
    nDura: Integer;
  begin
    Result := False;
    StdItem := UserEngine.GetStdItem(sItemName);
    for I := 0 to nCount - 1 do
    begin
      if IsDuraMax then
        nDura := StdItem.DuraMax - 1
      else
        nDura := 0;
      if StdItem <> nil then
        OverLapItem := OverLapItems(HeroObject, StdItem, nDura)
      else
        OverLapItem := nil;
      if (OverLapItem = nil) then
      begin
        New(UserItem);
        if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
        begin
          UserItem.ItemFrom := BindUserItem.ItemFrom;
          if IsDuraMax then
            UserItem.Dura := UserItem.DuraMax - 1;
          HeroObject.m_ItemList.Add(UserItem);
          HeroObject.SendAddItem(UserItem);
          Result := True;
        end
        else
        begin
          Dispose(UserItem);
          Break;
        end;
      end;
    end;
  end;
  function FoundUserItem(MakeIndex: Integer; var FindItem: pTUserItem; var FindIndex: Integer): Boolean;
  var
    I: Integer;
    UserItem: pTUserItem;
  begin
    Result := False;
    for I := 0 to THeroObject(m_MyHero).m_ItemList.Count - 1 do
    begin
      UserItem := THeroObject(m_MyHero).m_ItemList.Items[I];
      if (UserItem <> nil) and (UserItem.MakeIndex = MakeIndex) then
      begin
        Result := True;
        FindIndex := I;
        FindItem := UserItem;
        Break;
      end;
    end;
  end;

var
  I: Integer;
  boEatOK: Boolean;
  boChangeDura: Boolean;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  UserItem34: TUserItem;
  OverLapStdItem: pTStdItem;
  OverLapItem: pTUserItem;
  nMakeIndex: Integer;
  sItemName: string;
  dwUseIntervalTime: LongWord; // 物品使用时间间隔
  UnbindItemInfo: PTUnbindItemInfo;
  nCount, NeedBagCount: Integer;
  FindItem: pTUserItem;
  FindIndex: Integer;
begin
  if m_MyHero = nil then
    Exit;

  HeroObject := THeroObject(m_MyHero);
  nMakeIndex := ProcessMsg.nParam1;
  sItemName := ProcessMsg.sMsg;
  boEatOK := False;
  boChangeDura := False;
  StdItem := nil;
  for I := HeroObject.m_ItemList.Count - 1 downto 0 do
  begin
    if HeroObject.m_ItemList.Count <= 0 then
      Break;

    UserItem := HeroObject.m_ItemList.Items[I];
    if (UserItem = nil) or (UserItem.MakeIndex <> nMakeIndex) then
      Continue;

    UserItem34 := UserItem^;
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem = nil then
      Continue;

    dwUseIntervalTime := g_Config.dwUseItemIntervalTime; // 非药品使用时间间隔
    if StdItem.StdMode = 0 then
    begin
      if HeroObject.m_btJob = 0 then // 战士
      begin
        if StdItem.Shape = 0 then // 普通样品
          dwUseIntervalTime := g_Config.dwUseOrdinaryTime_Hero_Warrior
        else if StdItem.Shape in [1, 101, 102] then // 特殊样品
          dwUseIntervalTime := g_Config.dwUseSpecialTime_Hero_Warrior;
      end
      else if HeroObject.m_btJob in [1, 2] then // 道士/法师
      begin
        if StdItem.Shape = 0 then // 普通样品
          dwUseIntervalTime := g_Config.dwUseOrdinaryTime_Hero_TaoistAndWizard
        else if StdItem.Shape in [1, 101, 102] then // 特殊样品
          dwUseIntervalTime := g_Config.dwUseSpecialTime_Hero_TaoistAndWizard;
      end;
    end;

    if not((not HeroObject.m_boDeath) //
      and (MyGetTickCount - HeroObject.m_dwClientUseItemsTick > dwUseIntervalTime) //
      and (HeroObject.m_WAbil.HP > 0)) then
      Break;

    if g_ItemRules.Get(UserItem.wIndex, 7) then
    begin
      SysMsg('物品禁止英雄使用', c_Red, t_Hint);
      Break;
    end;

    HeroObject.m_dwClientUseItemsTick := MyGetTickCount();
    case StdItem.StdMode of
      0, 1, 3:
        begin // 药  , 2
          if CheckOverLapItem(StdItem) and (UserItem.Dura > 0) then
          begin
            if HeroObject.EatItems(StdItem) then
            begin
              UserItem.Dura := UserItem.Dura - 1;
              UserItem34 := UserItem^;
              boChangeDura := True;
              boEatOK := False;
              HeroObject.WeightChanged();
            end;
          end
          else if HeroObject.EatItems(StdItem) then
          begin
            HeroObject.m_ItemList.Delete(I);
            Dispose(UserItem);
            boEatOK := True;
          end;
          Break;
        end;
      2:
        begin
          case StdItem.Shape of
            0:
              begin
                if HeroObject.EatItems(StdItem) then
                begin
                  HeroObject.m_ItemList.Delete(I);
                  Dispose(UserItem);
                  boEatOK := True;
                end;
                Break;
              end;
            2:
              begin
              end;
            9:
              begin
                if UserItem.Dura > 0 then
                begin
                  if UserItem.Dura < 100 then { 修复神水修复一个持久点，要100个单位 }
                    UserItem.Dura := 0;

                  if UserItem.Dura <= 0 then
                  begin
                    HeroObject.m_ItemList.Delete(I);
                    Dispose(UserItem);
                    boEatOK := True;
                  end
                  else
                    boChangeDura := True;

                  HeroObject.m_CurrUserItem := UserItem;
                  HeroObject.RepairAllItem; // 尝试修复所有装备
                  UserItem34 := UserItem^;
                  if UserItem.Dura < 100 then { 修复神水修复一个持久点，要100个单位 }
                  begin
                    UserItem.Dura := 0;
                    HeroObject.m_ItemList.Delete(I);
                    Dispose(UserItem);
                    boEatOK := True;
                  end
                  else // 刷新客户端物品
                    HeroObject.SendUpdateItemDura(-1, UserItem.MakeIndex, UserItem.Dura);
                end
                else
                begin
                  HeroObject.m_ItemList.Delete(I);
                  Dispose(UserItem);
                  boEatOK := True;
                end;
              end;
          end;
        end;
      4:
        begin // 书
          if HeroObject.ReadBook(StdItem) then
          begin
            HeroObject.m_ItemList.Delete(I);
            Dispose(UserItem);
            boEatOK := True;
            if (HeroObject.m_MagicErgumSkill <> nil) and (not HeroObject.m_boUseThrusting) then
              HeroObject.ThrustingOnOff(True);

            if (m_MagicBanwolSkill <> nil) and (not HeroObject.m_boUseHalfMoon) then
              HeroObject.HalfMoonOnOff(True);
          end;
        end;
      49:
        begin // 聚灵珠
          if (UserItem.Dura >= UserItem.DuraMax) and ((StdItem.AC2 <= 0) or (m_MyHero.m_Abil.Level <= StdItem.AC2)) then
          begin
            g_FunctionNPC.GotoLable(Self, '@HeroBeginUseBead', False); // Cursor 2023-06-06 09:16:20 加入英雄使用聚灵珠前触发

            if HeroObject.m_boUseBeadEnabled then // Cursor 2023-06-06 09:17:27 加入使用聚灵珠打断
            begin
              case StdItem.AniCount of
                0:
                  begin // 元宝提取经验
                    if m_nGameGold >= StdItem.Need then
                    begin
                      DecGameGold(StdItem.Need);
                      GameGoldChanged;
                      HeroObject.IncExp(UserItem.DuraMax * 10000);
                      HeroObject.m_ItemList.Delete(I);
                      Dispose(UserItem);
                      boEatOK := True;
                    end
                    else
                    begin
                      boEatOK := False;
                      SysMsg(Format('%s不足无法释放%s的经验值！', [g_Config.sGameGoldName, StdItem.Name]), 255, 253, t_Hint);
                    end;
                  end;
                1:
                  begin // 金币提取经验
                    if m_nGold >= StdItem.Need then
                    begin
                      Dec(m_nGold, StdItem.Need);
                      GoldChanged;
                      HeroObject.IncExp(UserItem.DuraMax * 10000);
                      HeroObject.m_ItemList.Delete(I);
                      Dispose(UserItem);
                      boEatOK := True;
                    end
                    else
                    begin
                      boEatOK := False;
                      SysMsg(Format('%s不足无法释放%s的经验值！', [sSTRING_GOLDNAME, StdItem.Name]), 255, 253, t_Hint);
                    end;
                  end;
              else
                boEatOK := False;
              end;
            end
            else
            begin
              boEatOK := False;
              HeroObject.m_boUseBeadEnabled := True;
            end;
          end
          else
          begin
            boEatOK := False;
            SysMsg(Format('英雄等级超过%s的释放等级！', [StdItem.Name]), 255, 253, t_Hint);
          end;
        end;
      60:
        begin // 酒
          if (StdItem.Shape <> 0) then
          begin // 除烧酒外
            if HeroObject.DrinkWine(UserItem, StdItem) then
            begin
              HeroObject.m_ItemList.Delete(I);
              Dispose(UserItem);
              boEatOK := True;
            end
            else
            begin
              UserItem34 := UserItem^;
              boChangeDura := True;
              boEatOK := False;
            end;
          end;
        end;
      31:
        begin
          if StdItem.Shape in [50, 51] then
          begin
            if StdItem.Shape = 50 then
            begin
              HeroObject.m_UseItemFrom := uitHeroBag;
              HeroObject.m_nUseItemMakeIndex := UserItem.MakeIndex;
              HeroObject.m_sUseItemName := StdItem.Name;

              if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
                HeroObject.m_sUseItemNewName := UserItem.Name
              else
                HeroObject.m_sUseItemNewName := StdItem.Name;

              HeroUseStdmodeFunItemEx(StdItem);
              HeroObject.m_nUseItemMakeIndex := 0;
              HeroObject.m_sUseItemName := '';
              HeroObject.m_sUseItemNewName := '';

              if FoundUserItem(nMakeIndex, FindItem, FindIndex) then
              begin
                if CheckOverLapItem(StdItem) then
                begin
                  if FindItem.Dura <= 0 then
                  begin
                    HeroObject.m_ItemList.Delete(FindIndex);
                    Dispose(FindItem);
                    boEatOK := True;
                  end
                  else
                  begin
                    FindItem.Dura := FindItem.Dura - 1;
                    boEatOK := False;
                    boChangeDura := True;
                    HeroObject.WeightChanged();
                    UserItem34 := FindItem^;
                  end;
                end
                else
                begin
                  HeroObject.m_ItemList.Delete(FindIndex);
                  Dispose(FindItem);
                  boEatOK := True;
                end;
              end
              else
                boEatOK := True;
            end
            else
            begin
              UserItem34 := UserItem^;
              HeroObject.m_UseItemFrom := uitHeroBag;
              HeroObject.m_nUseItemMakeIndex := UserItem.MakeIndex;
              HeroObject.m_sUseItemName := StdItem.Name;

              if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
                HeroObject.m_sUseItemNewName := UserItem.Name
              else
                HeroObject.m_sUseItemNewName := StdItem.Name;

              HeroUseStdmodeFunItemEx(StdItem);
              HeroObject.m_nUseItemMakeIndex := 0;
              HeroObject.m_sUseItemName := '';
              HeroObject.m_sUseItemNewName := '';
              boEatOK := not FoundUserItem(nMakeIndex, FindItem, FindIndex);

              if not boEatOK then
              begin
                if UserItem34.Dura <> FindItem^.Dura then
                  boChangeDura := True;
                UserItem34 := FindItem^;
              end;
            end;
            Break;
          end
          else
          begin
            // 解包物品
            UnbindItemInfo := GetUnbindItemInfo(StdItem.Shape);
            if (UnbindItemInfo <> nil) then
            begin
              OverLapStdItem := UserEngine.GetStdItem(UnbindItemInfo.sItemName);
              if (OverLapStdItem <> nil) and (UnbindItemInfo.nCount <= 0) then
                OverLapItem := OverLapItems(HeroObject, OverLapStdItem, 5)
              else
                OverLapItem := nil;

              if (OverLapItem <> nil) and (OverLapStdItem <> nil) then
              begin
                HeroObject.m_ItemList.Delete(I);
                Dispose(UserItem);
                boEatOK := True;
              end
              else
              begin
                if UnbindItemInfo.nCount <= 0 then
                  nCount := 6
                else
                  nCount := UnbindItemInfo.nCount;

                NeedBagCount := nCount;
                if (OverLapStdItem <> nil) and CheckOverLapItem(OverLapStdItem) then
                  NeedBagCount := (nCount + OverLapStdItem.DuraMax - 1) div OverLapStdItem.DuraMax;

                if (HeroObject.m_ItemList.Count + NeedBagCount - 1) <= HeroObject.m_nBagCount then
                begin
                  // 解包叠加物品时，一次只搞一个 chongchong 2016-03-22
                  GetUnBindItems(UserItem, UnbindItemInfo.sItemName, nCount, False { UnbindItemInfo.nCount > 0 } );
                  HeroObject.m_ItemList.Delete(I);
                  Dispose(UserItem);
                  boEatOK := True;
                end;
              end;
            end
            else if StdItem.Source = 1 then
            begin
              m_CurrUserItem := UserItem;
              if UserItem.Dura > 0 then
              begin
                HeroObject.m_UseItemFrom := uitHeroBag;
                HeroObject.m_nUseItemMakeIndex := UserItem.MakeIndex;
                HeroObject.m_sUseItemName := StdItem.Name;

                if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
                  HeroObject.m_sUseItemNewName := UserItem.Name
                else
                  HeroObject.m_sUseItemNewName := StdItem.Name;

                m_UseItemFrom := HeroObject.m_UseItemFrom;
                m_nUseItemMakeIndex := HeroObject.m_nUseItemMakeIndex;
                m_sUseItemName := HeroObject.m_sUseItemName;
                m_sUseItemNewName := HeroObject.m_sUseItemNewName;
                HeroUseStdmodeFunItem(StdItem);
                m_nUseItemMakeIndex := 0;
                m_sUseItemName := '';
                m_sUseItemNewName := '';
                HeroObject.m_nUseItemMakeIndex := 0;
                HeroObject.m_sUseItemName := '';
                HeroObject.m_sUseItemNewName := '';

                if UserItem.Dura >= 1 then
                  Dec(UserItem.Dura, 1)
                else
                  UserItem.Dura := 0;

                if UserItem.Dura <= 0 then
                begin
                  UserItem34 := UserItem^;
                  HeroObject.m_ItemList.Delete(I);
                  Dispose(UserItem);
                  boEatOK := True;
                end
                else
                begin
                  UserItem34 := UserItem^;
                  boChangeDura := True;
                end;
              end
              else
              begin
                UserItem34 := UserItem^;
                HeroObject.m_ItemList.Delete(I);
                Dispose(UserItem);
                boEatOK := True;
              end;
            end
            else
            begin
              case StdItem.Shape of
                0:
                  begin
                    HeroObject.m_UseItemFrom := uitHeroBag;
                    HeroObject.m_nUseItemMakeIndex := UserItem.MakeIndex;
                    HeroObject.m_sUseItemName := StdItem.Name;

                    if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
                      HeroObject.m_sUseItemNewName := UserItem.Name
                    else
                      HeroObject.m_sUseItemNewName := StdItem.Name;

                    m_UseItemFrom := HeroObject.m_UseItemFrom;
                    m_nUseItemMakeIndex := HeroObject.m_nUseItemMakeIndex;
                    m_sUseItemName := HeroObject.m_sUseItemName;
                    m_sUseItemNewName := HeroObject.m_sUseItemNewName;
                    HeroUseStdmodeFunItem(StdItem);
                    m_nUseItemMakeIndex := 0;
                    m_sUseItemName := '';
                    m_sUseItemNewName := '';
                    HeroObject.m_nUseItemMakeIndex := 0;
                    HeroObject.m_sUseItemName := '';
                    HeroObject.m_sUseItemNewName := '';
                    if FoundUserItem(nMakeIndex, FindItem, FindIndex) then
                    begin
                      // 叠加物品加入31 chongchong 2014-04-08 +++
                      if CheckOverLapItem(StdItem) and (FindItem.Dura > 0) then
                      begin
                        FindItem.Dura := FindItem.Dura - 1;
                        UserItem34 := FindItem^;
                        boChangeDura := True;
                        boEatOK := False;
                        HeroObject.WeightChanged();
                      end
                      else
                      begin
                        UserItem34 := FindItem^;
                        HeroObject.m_ItemList.Delete(FindIndex);
                        Dispose(FindItem);
                        boEatOK := True;
                      end;
                    end
                    else
                      boEatOK := True;
                    Break;
                  end;
                1:
                  begin
                    m_nRememberItemIndex := UserItem.MakeIndex;
                    m_sRememberItemName := StdItem.Name;
                    HeroObject.m_UseItemFrom := uitHeroBag;
                    HeroObject.m_nUseItemMakeIndex := UserItem.MakeIndex;
                    HeroObject.m_sUseItemName := StdItem.Name;

                    if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
                      HeroObject.m_sUseItemNewName := UserItem.Name
                    else
                      HeroObject.m_sUseItemNewName := StdItem.Name;

                    m_UseItemFrom := HeroObject.m_UseItemFrom;
                    m_nUseItemMakeIndex := HeroObject.m_nUseItemMakeIndex;
                    m_sUseItemName := HeroObject.m_sUseItemName;
                    m_sUseItemNewName := HeroObject.m_sUseItemNewName;

                    if HeroUseStdmodeFunItem(StdItem) then // 记忆石
                      boEatOK := False;

                    m_nUseItemMakeIndex := 0;
                    m_sUseItemName := '';
                    m_sUseItemNewName := '';
                    HeroObject.m_nUseItemMakeIndex := 0;
                    HeroObject.m_sUseItemName := '';
                    HeroObject.m_sUseItemNewName := '';
                  end;
              end;
            end;
          end;
        end;
      96: // 祝福罐 chongchong 2017-07-08
        begin
          if StdItem.Horse = 0 then
          begin
            if UserItem.DuraMax < 1000 then
            begin
              HeroObject.m_ItemList.Delete(I);
              Dispose(UserItem);
              boEatOK := True;
            end
            else if (UserItem.Dura >= 1000) and (HeroObject.m_ItemList.Count + 1 <= HeroObject.m_nBagCount) then
            begin
              Dec(UserItem.Dura, 1000);
              Dec(UserItem.DuraMax, 1000); // 20080324 减少存物品数量
              if UserItem.DuraMax <= 0 then
              begin
                HeroObject.m_ItemList.Delete(I);
                Dispose(UserItem);
                boEatOK := True;
              end
              else
                boChangeDura := True;

              UserItem34 := UserItem^;
              // 需要修改UnbindList.txt,加入 祝福油  20071229  3---为 祝福罐的外观值
              // 解包叠加物品时，一次只搞一个 chongchong 2016-03-22
              UnbindItemInfo := GetUnbindItemInfo(StdItem.Shape);
              if UnbindItemInfo <> nil then
                GetUnBindItems(UserItem, UnbindItemInfo.sItemName, 1, False { UnbindItemInfo.nCount > 0 } );
            end;
          end
          else
          begin
            if (UserItem.Dura >= 1000) and (m_ItemList.Count + 1 <= HeroObject.m_nBagCount) then
            begin
              Dec(UserItem.Dura, 1000);
              boChangeDura := True;
              UserItem34 := UserItem^;
              // 需要修改UnbindList.txt,加入 祝福油  20071229  3---为 祝福罐的外观值
              // 解包叠加物品时，一次只搞一个 chongchong 2016-03-22
              UnbindItemInfo := GetUnbindItemInfo(StdItem.Shape);
              if UnbindItemInfo <> nil then
                GetUnBindItems(UserItem, UnbindItemInfo.sItemName, 1, False { UnbindItemInfo.nCount > 0 } );
            end;
          end;
        end;
    end;
    Break;
  end;

  if boEatOK then
  begin
    HeroObject.WeightChanged();
    HeroObject.SendDefMessage(SM_HEROEAT_OK, nMakeIndex, 0, 0, 0, '');
    if StdItem.NeedIdentify = 1 then
    begin
      // 注释日志 chongchong 2017-10-09
      {
        AddGameDataLog('11' + #9 +
        HeroObject.m_sMapName + #9 +
        IntToStr(HeroObject.m_nCurrX) + #9 +
        IntToStr(HeroObject.m_nCurrY) + #9 +
        HeroObject.m_sCharName + #9 +
        // UserEngine.GetStdItemName(UserItem34.wIndex) + #9 +
        StdItem.Name + #9 +
        IntToStr(UserItem34.MakeIndex) + #9 +
        '1' + #9 +
        '0');
      }
    end;
  end
  else
  begin
    if boChangeDura then
      HeroObject.SendDefMessage(SM_HEROEAT_FAIL, UserItem34.MakeIndex, UserItem34.Dura, UserItem34.DuraMax, 0, '')
    else
      HeroObject.SendDefMessage(SM_HEROEAT_FAIL, 0, 0, 0, 0, '');
  end;
end;

// 锁定//Ident: 1105 Recog: 260806992 Param: 0 Tag: 32 Series: 0   Recog= 锁定对象   Param=X  Tag=Y
procedure TPlayObject.ClientHeroTarget(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  sMsg, sLockObjName: string;
  BaseObject: TBaseObject;
  IsClientSendObj: Boolean;
  nX, nY: Integer;
  I: Integer;
  OldLockTarget: TBaseObject;
  boLockTargetAgain: Boolean;
  Code: Integer;
  btDir: Byte;
begin
  Code := 0;
  try
    BaseObject := TBaseObject(ProcessMsg.nParam1);
    IsClientSendObj := BaseObject <> nil;
    if BaseObject <> nil then
    begin
      if not m_PEnvir.IsValidObjectEx(m_nCurrX, m_nCurrY, 20, BaseObject) then
        BaseObject := nil;
    end;
    nX := ProcessMsg.nParam2;
    nY := ProcessMsg.nParam3;
    Code := 1;
    if m_boOffLine or m_boWaitHeroDate { or m_boGhost or m_boDeath //mb的，主人死了，英雄还活着，可以锁定 } or (m_MyHero = nil) then
      Exit;
    if (m_MyHero <> nil) and (m_MyHero.m_boDeath or m_MyHero.m_boGhost) then
      Exit;
    Code := 2;
    if (BaseObject = nil) and (m_MyHero.m_TargetCret <> nil) then
      BaseObject := m_MyHero.m_TargetCret;
    Code := 3;
    if (BaseObject = nil) and (m_TargetCret <> nil) then
      BaseObject := m_TargetCret;
    Code := 4;
    if (BaseObject = nil) then
      BaseObject := TBaseObject(m_PEnvir.GetMovingObject(nX, nY, False));
    if BaseObject = nil then
      Exit;
    if (abs(BaseObject.m_nCurrX - m_nCurrX) > g_Config.nHeroTargetRangeLimit) or
      (abs(BaseObject.m_nCurrY - m_nCurrY) > g_Config.nHeroTargetRangeLimit) then
    begin
      if g_sLockTargetRangeLimit <> '' then
      begin
        SysMsg(g_sLockTargetRangeLimit, 255, 249, t_Hint)
      end;
      Exit;
    end;
    Code := 5;
    // 修复英雄锁定假人费劲的问题 chongchong 2014-01-17
    Code := 6;
    if IsClientSendObj or CretInNearXY(BaseObject, nX, nY, 2) then
    begin
      Code := 7;
      if (BaseObject <> Self) and (BaseObject <> m_MyHero) { and (m_MyHero.Master <> BaseObject.Master) } then
      begin
        Code := 8;
        if (BaseObject.m_btRaceServer < RC_NPC) or (BaseObject.m_btRaceServer > RC_PEACENPC) then
        begin
          // if (BaseObject.m_btRaceServer <> 110) and     // 城门
          // (BaseObject.m_btRaceServer <> 111) then     // 城墙
          begin
            Code := 9;
            if g_Config.boSafeNoAllowTargetBB and (BaseObject.m_Master <> nil) and BaseObject.InSafeZone and
              IsProperFriend(BaseObject) then
              Exit;
            // 英雄只锁定主人攻击掉血的目标 chongchong 2015-08-04
            if not IsProperTarget(BaseObject) then
              Exit;
            Code := 10;
            THeroObject(m_MyHero).m_boSlaveRelax := False; // 解除休息
            THeroObject(m_MyHero).m_boProtectStatus := False; // 解除守护
            if THeroObject(m_MyHero).m_btAttackMode <> 0 then
            begin
              THeroObject(m_MyHero).m_btAttackMode := 0; // 切换到攻击模式
              m_MyHero.SendMsg(m_MyHero, RM_HERO_ATTACK_MODE, 0, MakeWord(255, 252), 0, 0, '');
            end;
            Code := 11;
            boLockTargetAgain := False;
            if (THeroObject(m_MyHero).m_boTarget) then
            begin
              OldLockTarget := THeroObject(m_MyHero).m_TargetCret;
              boLockTargetAgain := THeroObject(m_MyHero).m_boTargetAgain;
            end
            else
              OldLockTarget := nil;
            Code := 12;
            // 锁定攻击目标，当英雄和主要相隔较远时，英雄先飞过来 chongchong 2013-12-21
            THeroObject(m_MyHero).DelTargetCreat;
            if (THeroObject(m_MyHero).m_PEnvir <> m_PEnvir) or
              (abs(m_nCurrX - THeroObject(m_MyHero).m_nCurrX) > g_Config.nHeroLockFlyRange) or
              (abs(m_nCurrY - THeroObject(m_MyHero).m_nCurrY) > g_Config.nHeroLockFlyRange) then
            begin
              Code := 13;
              if m_MyHero.m_btJob = 0 then
              begin
                btDir := GetNextDirection(m_nCurrX, m_nCurrY, BaseObject.m_nCurrX, BaseObject.m_nCurrY);
                GetBackPosition(btDir, BaseObject.m_nCurrX, BaseObject.m_nCurrY, nX, nY, 2);
                // GetBackPosition(nX, nY);
                if not m_PEnvir.CanWalk(nX, nY, True) then
                begin
                  for I := 0 to 7 do
                  begin
                    if m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, I, 1, nX, nY) then
                    begin
                      if m_PEnvir.CanWalk(nX, nY, True) then
                      begin
                        Break;
                      end;
                    end;
                  end;
                end;
              end
              else
              begin
                btDir := GetNextDirection(m_nCurrX, m_nCurrY, BaseObject.m_nCurrX, BaseObject.m_nCurrY);
                GetBackPosition(btDir, m_nCurrX, m_nCurrY, nX, nY, 1);
                if not m_PEnvir.CanWalk(nX, nY, True) then
                begin
                  for I := 0 to 7 do
                  begin
                    if m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, I, 1, nX, nY) then
                    begin
                      if m_PEnvir.CanWalk(nX, nY, True) then
                      begin
                        Break;
                      end;
                    end;
                  end;
                end;
              end;
              Code := 14;
              THeroObject(m_MyHero).SpaceMove(m_PEnvir.sMapName, nX, nY, 1);
            end;
            Code := 15;
            { TODO -ochongchong -c增加 : 根据攻击模式来判断是否可以锁定对象 【2013-08-25】 }
            if not THeroObject(m_MyHero).IsLcokAttackTarget(BaseObject) then
              Exit;
            Code := 16;
            SetTargetCreat(BaseObject);
            Code := 17;
            THeroObject(m_MyHero).m_boTarget := False;
            m_MyHero.SetTargetCreat(BaseObject);
            THeroObject(m_MyHero).m_nMoveIndex := -1;
            SetLength(THeroObject(m_MyHero).m_MovePath, 0);
            // 不用锁定对象后，对象马上反击 chongchong 2015-06-16
            // 夫妻模式，英雄被老公/老婆的英雄攻击时会反击 chongchong 2015-05-02
            {
              if BaseObject.IsAttackTarget(m_MyHero) then
              begin
              BaseObject.SetTargetCreat(m_MyHero);
              if (BaseObject.m_Master <> nil) and (BaseObject.m_Master.m_TargetCret = nil) then
              BaseObject.m_Master.SetTargetCreat(m_MyHero);
              end;
            }
            Code := 18;
            THeroObject(m_MyHero).m_nTargetX := BaseObject.m_nCurrX;
            THeroObject(m_MyHero).m_nTargetY := BaseObject.m_nCurrY;
            THeroObject(m_MyHero).m_boTarget := True;
            THeroObject(m_MyHero).m_boTargetAgain := (OldLockTarget = BaseObject) and (not boLockTargetAgain);
            Code := 19;
            { TODO -ochongchong -c修改 : 英雄锁定目标时提示信息修改 【2013-08-16】 }
            if THeroObject(m_MyHero).m_btAttackMode <> 0 then
            begin
              THeroObject(m_MyHero).m_btAttackMode := 0; // 切换到攻击模式
              m_MyHero.SendMsg(m_MyHero, RM_HERO_ATTACK_MODE, 0, MakeWord(255, 252), 0, 0, '');
            end;
            if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and
              (m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName) > 0) then
            begin
              sLockObjName := m_PEnvir.m_sSecretShowName;
            end
            else if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and
              (m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName2) > 0) then
            begin
              sLockObjName := m_PEnvir.m_sSecretShowName2;
            end
            else
            begin
              Code := 20;
              sLockObjName := BaseObject.m_sCharName;
              if not(BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
              begin
                for I := Length(sLockObjName) downto 1 do
                begin
{$IF CompilerVersion >= 22}
                  if not CharInSet(sLockObjName[I], ['0' .. '9']) then
{$ELSE}
                  if not(sLockObjName[I] in ['0' .. '9']) then
{$IFEND}
                  begin
                    sLockObjName := Copy(sLockObjName, 1, I);
                    Break;
                  end;
                end;
                if Length(sLockObjName) = 0 then
                  sLockObjName := BaseObject.m_sCharName;
              end;
            end;
            // 锁定目标后，马上灰名chongchong 2017-12-14
            if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              BaseObject.SetPKFlag(m_MyHero);
              BaseObject.SetPKFlag(Self);
            end
            else if ((BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT)) then
            begin
              BaseObject.Master.SetPKFlag(m_MyHero);
              BaseObject.Master.SetPKFlag(Self);
            end;
            Code := 21;
            if (BaseObject.m_btRaceServer = RC_HEROOBJECT) and (BaseObject.m_Master <> nil) then
            begin
              if ((m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName) > 0)) or
                ((m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName2) > 0)) then
              begin
                sMsg := '攻击目标: %s';
                if not THeroObject(m_MyHero).m_boTargetAgain then
                  SysMsg(Format(sMsg, [sLockObjName]), 255, 249, t_Hint)
                else
                  SysMsg(Format(sMsg, [sLockObjName]), 255, 253, t_Hint)
              end
              else
              begin
                sMsg := '攻击目标: %s 的英雄:%s';
                if not THeroObject(m_MyHero).m_boTargetAgain then
                  SysMsg(Format(sMsg, [BaseObject.m_Master.m_sCharName, sLockObjName]), 255, 249, t_Hint)
                else
                  SysMsg(Format(sMsg, [BaseObject.m_Master.m_sCharName, sLockObjName]), 255, 253, t_Hint)
              end;
            end
            else
            begin
              sMsg := '攻击目标: %s';
              if not THeroObject(m_MyHero).m_boTargetAgain then
                SysMsg(Format(sMsg, [sLockObjName]), 255, 249, t_Hint)
              else
                SysMsg(Format(sMsg, [sLockObjName]), 255, 253, t_Hint)
            end;
            Exit;
          end;
        end;
      end;
    end;
    Code := 22;
    THeroObject(m_MyHero).m_boTarget := False;
  except
    on E: Exception do
    begin
      MainOutMessage('TPlayObject.ClientHeroTarget' + IntToStr(Code));
      MainOutMessage(E.Message);
    end;
  end;
end;

procedure TPlayObject.ClientHeroDropItem(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 英雄扔物品
var
  I: Integer;
  DropItem: pTUserItem;
  UserItem: pTUserItem;
  UpdateItem: TUserItem;
  StdItem: pTStdItem;
  sUserItemName: string;
  boDropItemOK: Boolean;
  boUpdateItem: Boolean;
  sItemName: string;
  nMakeIndex, nCount: Integer;
  HeroObject: THeroObject;
begin
  if m_MyHero = nil then
    Exit;
  HeroObject := THeroObject(m_MyHero);
  boDropItemOK := False;
  boUpdateItem := False;
  sItemName := ProcessMsg.sMsg;
  nMakeIndex := ProcessMsg.nParam1;
  nCount := ProcessMsg.nParam2;
  if g_OnlineMsgControl.boDisableDropItem then
  begin
    SendDefMessage(SM_HERODROPITEM_FAIL, nMakeIndex, 0, 0, 0, sItemName);
    Exit;
  end;
  // 修复英雄在安全区可以扔物品在地上 chongchong 2015-01-28
  if g_Config.boInSafeDisableDrop and HeroObject.InSafeZone then
  begin
    g_ManageNPC.MessageBox(Self, g_sCanotDropInSafeZoneMsg);
    SendDefMessage(SM_HERODROPITEM_FAIL, nMakeIndex, 0, 0, 0, sItemName);
    Exit;
  end;
  if Pos(' ', sItemName) > 0 then
  begin // 折分物品名称(信件物品的名称后面加了使用次数)
    GetValidStr3_Ex(sItemName, sItemName, ' ');
  end;
  for I := HeroObject.m_ItemList.Count - 1 downto 0 do
  begin
    if HeroObject.m_ItemList.Count <= 0 then
      Break;
    UserItem := HeroObject.m_ItemList.Items[I];
    if (UserItem.MakeIndex = nMakeIndex) then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem = nil then
        Continue;
      if (GetUserItemBindValue(UserItem, ubNoDrop) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 0) then
      begin
        // SendDefMessage(SM_HERODROPITEM_FAIL, nMakeIndex, 0, 0, 0, sItemName);
        g_ManageNPC.MessageBox(Self, g_sCanotUserDropItem);
        Break;
      end;
      // 取自定义物品名称
      sUserItemName := '';
      if UserItem.btValue[13] = 1 then
        sUserItemName := UserItem.Name;
      if sUserItemName = '' then
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);
      if CompareText(sUserItemName, sItemName) = 0 then
      begin
        if CheckOverLapItem(StdItem) and (nCount > 0) then
        begin
          if nCount < UserItem.Dura + 1 then
          begin
            New(DropItem);
            if UserEngine.CopyToUserItemFromName(StdItem.Name, DropItem) then
            begin
              if g_Config.boControlDropItem and (StdItem.Price < g_Config.nCanDropPrice) then
              begin
                boDropItemOK := False;
              end
              else
              begin
                DropItem.Dura := nCount - 1;
                if HeroObject.DropItemDown(DropItem, 1, False, nil, HeroObject) then
                begin
                  UserItem.Dura := UserItem.Dura - nCount;
                  UpdateItem := UserItem^;
                  boUpdateItem := True;
                  boDropItemOK := False;
                  // SysMsg('boDropItemOK1', c_Red, t_Hint);
                end;
              end;
            end;
            Dispose(DropItem);
            Break;
          end;
        end;
        if g_Config.boControlDropItem and (StdItem.Price < g_Config.nCanDropPrice) then
        begin
          HeroObject.m_ItemList.Delete(I);
          Dispose(UserItem);
          boDropItemOK := True;
          // SysMsg('boDropItemOK2', c_Red, t_Hint);
          Break;
        end;
        // 物品规则  英雄丢弃消失 chongchong 2013-11-13
        if g_ItemRules.Get(UserItem.wIndex, 24) then
        begin
          HeroObject.m_ItemList.Delete(I);
          Dispose(UserItem);
          boDropItemOK := True;
          Break;
        end
        // 绑定物品丢弃消失 chongchong 2015-01-29
        else if (GetUserItemBindValue(UserItem, ubDropDelete) and UserItem.boIsBind) then
        begin
          HeroObject.m_ItemList.Delete(I);
          Dispose(UserItem);
          boDropItemOK := True;
          Break;
        end
        else if HeroObject.DropItemDown(UserItem, 1, False, nil, HeroObject) then
        begin
          HeroObject.m_ItemList.Delete(I);
          Dispose(UserItem);
          boDropItemOK := True;
          // SysMsg('boDropItemOK3', c_Red, t_Hint);
          Break;
        end;
      end;
    end;
  end;
  if boDropItemOK then
  begin
    SendDefMessage(SM_HERODROPITEM_SUCCESS, nMakeIndex, 0, 0, 0, sItemName);
    HeroObject.WeightChanged();
    // SysMsg('boDropItemOK4', c_Red, t_Hint);
  end
  else
  begin
    SendDefMessage(SM_HERODROPITEM_FAIL, nMakeIndex, 0, 0, 0, sItemName);
    // SysMsg('boDropItemOK5', c_Red, t_Hint);
  end;
  if boUpdateItem then
    HeroObject.SendUpdateItemDura(-1, UpdateItem.MakeIndex, UpdateItem.Dura);
end;

procedure TPlayObject.ClientHeroGroupAttack(ProcessMsg: pTProcessMessage; var boResult: Boolean); // 合击
var
  btDir: Byte;
  nX, nY: Integer;
  boTargetAgain: Boolean;
  boRun: Boolean;
begin
  if m_boWaitHeroDate or m_boGhost or m_boDeath or (m_MyHero = nil) then
    Exit;
  if (m_MyHero <> nil) and (m_MyHero.m_boDeath or m_MyHero.m_boGhost) then
    Exit;
  if m_boContinuous or (not m_boCanSpell) or (not m_boCanSpellState) (* or m_boCobweb {被网罩住不能使用魔法} *) or (not CanMove) then
    Exit;
  if m_boOnHorse then
    Exit;
  // 变身后 2020-08-22 12:24:05
  if m_nChangeAppr >= 0 then
    Exit;
  { TODO -ochongchong -c新增 : 增加是否允许英雄合击选项 【2013-08-11】 }
  if not g_Config.boHeroJointAttack then
    Exit;
  if THeroObject(m_MyHero).FindGroupMagic = nil then
  begin
    SysMsg('你的英雄未学习合击技能', c_Red, t_Hint);
    Exit;
  end;
  if THeroObject(m_MyHero).m_boTarget then
    boTargetAgain := THeroObject(m_MyHero).m_boTargetAgain
  else
    boTargetAgain := False;
  // 修正英雄守护模式不能使用合击技能 chongchong 2014-09-26
  // if (THeroObject(m_MyHero).m_btAttackMode <> 2) {and (not THeroObject(m_MyHero).m_boProtectStatus)} then
  begin
    if (THeroObject(m_MyHero).m_boLastGroupSpellOK and (THeroObject(m_MyHero).m_btAngryValue >= g_Config.btMaxAngryValue)) or
      (not THeroObject(m_MyHero).m_boLastGroupSpellOK and (THeroObject(m_MyHero).m_btAngryValue >= g_Config.btMaxAngryValue div 2))
    then
    begin
      boRun := (m_TargetCret <> nil) and
        (not((m_MyHero.m_PEnvir = m_PEnvir) and (abs(m_TargetCret.m_nCurrX - m_nCurrX) <= g_Config.nMagicAttackRage) and
        (abs(m_TargetCret.m_nCurrY - m_nCurrY) <= g_Config.nMagicAttackRage)));
      if boRun then
      begin
        // 修正英雄守护模式不能使用合击技能 chongchong 2014-09-26
        if (THeroObject(m_MyHero).m_boProtectStatus) and (m_MyHero.m_PEnvir = m_PEnvir) and
          ((abs(THeroObject(m_MyHero).m_nProtectTargetX - m_TargetCret.m_nCurrX) > g_Config.nGuardRange) or
          (abs(THeroObject(m_MyHero).m_nProtectTargetY - m_TargetCret.m_nCurrY) > g_Config.nGuardRange)) then
        begin
          // 合击目标超出英雄守护范围 chongchong 2014-09-26
          THeroObject(m_MyHero).m_boProtectStatus := False;
        end;
        if (m_TargetCret <> nil) then
        begin
          THeroObject(m_MyHero).DelTargetCreat;
          // 只有战士才会检测范围后空降合击 By 一支笔 at:2021-09-19 17:19:48
          if (g_Config.boHeroJointAttackFly) and (THeroObject(m_MyHero).m_btJob = 0) then
          begin
            if (abs(m_MyHero.m_nCurrX - m_TargetCret.m_nCurrX) > g_Config.nHeroJoinAttackFlyRange) or
              (abs(m_MyHero.m_nCurrY - m_TargetCret.m_nCurrY) > g_Config.nHeroJoinAttackFlyRange) then
            begin
              btDir := GetNextDirection(m_nCurrX, m_nCurrY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY);
              GetBackPosition(btDir, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY, nX, nY, 2);
              m_MyHero.SpaceMove(m_PEnvir.sMapName, nX, nY, 1);
            end;
          end
          else
            THeroObject(m_MyHero).FollowMaster;
        end;
        { TODO -ochongchong -c增加 : 根据攻击模式来判断是否可以锁定对象 【2013-08-25】 }
        // if not THeroObject(m_MyHero).IsLcokAttackTarget(m_TargetCret) then Exit;
        if THeroObject(m_MyHero).m_btAttackMode <> 0 then
        begin
          THeroObject(m_MyHero).m_btAttackMode := 0; // 切换到攻击模式
          m_MyHero.SendMsg(m_MyHero, RM_HERO_ATTACK_MODE, 0, MakeWord(255, 252), 0, 0, '');
        end;
