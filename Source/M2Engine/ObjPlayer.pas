procedure TPlayObject.ClientDealChgGold(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  bo09: Boolean;
  nGold: Integer;
begin
  // 禁止取回放入交易栏内的金币
  nGold := ProcessMsg.nParam1;
  if (m_nDealGolds > 0) and g_Config.boCanNotGetBackDeal then
  begin
    SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sDealItemsDenyGetBackMsg);
    SendDefMessage(SM_DEALDELITEM_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;
  if nGold < 0 then
  begin
    SendDefMessage(SM_DEALCHGGOLD_FAIL, m_nDealGolds, LoWord(m_nGold), HiWord(m_nGold), 0, '');
    Exit;
  end;
  bo09 := False;
  if (m_DealCreat <> nil) and (GetPoseCreate = m_DealCreat) then
  begin
    if not m_DealCreat.m_boDealOK then
    begin
      if (m_nGold + m_nDealGolds) >= nGold then
      begin
        m_nGold := (m_nGold + m_nDealGolds) - nGold;
        m_nDealGolds := nGold;
        SendDefMessage(SM_DEALCHGGOLD_OK, m_nDealGolds, LoWord(m_nGold), HiWord(m_nGold), 0, '');
        TPlayObject(m_DealCreat).SendDefMessage(SM_DEALREMOTECHGGOLD, m_nDealGolds, 0, 0, 0, '');
        m_DealCreat.m_DealLastTick := MyGetTickCount();
        bo09 := True;
        m_DealLastTick := MyGetTickCount();
      end;
    end;
  end;
  if not bo09 then
  begin
    SendDefMessage(SM_DEALCHGGOLD_FAIL, m_nDealGolds, LoWord(m_nGold), HiWord(m_nGold), 0, '');
  end;
end;

procedure TPlayObject.ClientDealEnd(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  I: Integer;
  bo11: Boolean;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  AObject: TPlayObject;
  oldGold: LongWord;
begin
  m_boDealOK := True;
  if m_DealCreat = nil then
    Exit;
  if g_OnlineMsgControl.boDisableTrading then
    Exit;
  if ((MyGetTickCount - m_DealLastTick) < g_Config.dwDealOKTime { 1000 } ) or
    ((MyGetTickCount - m_DealCreat.m_DealLastTick) < g_Config.dwDealOKTime { 1000 } ) then
  begin
    SysMsg(g_sDealOKTooFast, c_Red, t_Hint);
    DealCancel();
    Exit;
  end;
  if m_DealCreat.m_boDealOK then
  begin
    bo11 := True;
    if (GetMaxBagCount - m_ItemList.Count) < m_DealCreat.m_DealItemList.Count then
    begin
      bo11 := False;
      SysMsg(g_sYourBagSizeTooSmall, c_Red, t_Hint);
    end;
    if (m_DealCreat.m_nDealGolds <> 0) and ((g_Config.nHumanMaxGold - m_nGold) < m_DealCreat.m_nDealGolds) then
    begin
      SysMsg(g_sYourGoldLargeThenLimit, c_Red, t_Hint);
      bo11 := False;
    end;
    if (m_DealCreat.GetMaxBagCount - m_DealCreat.m_ItemList.Count) < m_DealItemList.Count then
    begin
      SysMsg(g_sDealHumanBagSizeTooSmall, c_Red, t_Hint);
      bo11 := False;
    end;
    if (m_nDealGolds <> 0) and ((g_Config.nHumanMaxGold - m_DealCreat.m_nGold) < m_nDealGolds) then
    begin
      SysMsg(g_sDealHumanGoldLargeThenLimit, c_Red, t_Hint);
      bo11 := False;
    end;
    if bo11 then
    begin
      for I := 0 to m_DealItemList.Count - 1 do
      begin
        UserItem := m_DealItemList.Items[I];
        if UserItem = nil then
          Continue;
        m_DealCreat.AddItemToBag(UserItem);
        TPlayObject(m_DealCreat).SendAddItem(UserItem);
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          if not IsCheapStuff(StdItem.StdMode) then
          begin
            // 004DDF49
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemTrading, LOG_ActionNone, m_DealCreat, StdItem.Name, UserItem.MakeIndex, m_sCharName, 0, 0,
                m_sCharName + '->' + m_DealCreat.m_sCharName);
            end;
          end;
        end;
      end; // 004DDF5A
      if m_nDealGolds > 0 then
      begin
        oldGold := m_DealCreat.m_nGold;
        Inc(m_DealCreat.m_nGold, m_nDealGolds);
        m_DealCreat.GoldChanged();
        // 004DE05E
        if g_boGameLogGold then
        begin
          if m_DealCreat.m_nDealGolds = 0 then
          begin
            AddGameDataLog(LOG_ItemTrading, LOG_GoldChange, Self, sSTRING_GOLDNAME, 0, m_DealCreat.m_sCharName, m_nGold,
              m_nGold + m_nDealGolds, m_sCharName + '->' + m_DealCreat.m_sCharName + ':' + IntToStr(m_nDealGolds));
          end;
          AddGameDataLog(LOG_ItemTrading, LOG_GoldChange, m_DealCreat, sSTRING_GOLDNAME, 0, m_sCharName, m_DealCreat.m_nGold,
            oldGold + m_DealCreat.m_nDealGolds, m_sCharName + '->' + m_DealCreat.m_sCharName + ':' + IntToStr(m_nDealGolds));
        end;
      end;
      for I := 0 to m_DealCreat.m_DealItemList.Count - 1 do
      begin
        UserItem := m_DealCreat.m_DealItemList.Items[I];
        if UserItem = nil then
          Continue;
        AddItemToBag(UserItem);
        SendAddItem(UserItem);
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          if not IsCheapStuff(StdItem.StdMode) then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemTrading, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, m_DealCreat.m_sCharName, 0,
                0, m_DealCreat.m_sCharName + '->' + m_sCharName);
            end;
          end;
        end;
      end;
      if m_DealCreat.m_nDealGolds > 0 then
      begin
        oldGold := m_nGold;
        Inc(m_nGold, m_DealCreat.m_nDealGolds);
        GoldChanged();
        if g_boGameLogGold then
        begin
          if m_nDealGolds = 0 then
          begin
            AddGameDataLog(LOG_ItemTrading, LOG_GoldChange, m_DealCreat, sSTRING_GOLDNAME, 0, m_sCharName, m_DealCreat.m_nGold,
              m_DealCreat.m_nGold + m_DealCreat.m_nDealGolds, m_DealCreat.m_sCharName + '->' + m_sCharName + ':' +
              IntToStr(m_DealCreat.m_nDealGolds));
          end;
          AddGameDataLog(LOG_ItemTrading, LOG_GoldChange, Self, sSTRING_GOLDNAME, 0, m_DealCreat.m_sCharName, m_nGold,
            oldGold + m_nDealGolds, m_DealCreat.m_sCharName + '->' + m_sCharName + ':' + IntToStr(m_DealCreat.m_nDealGolds));
        end;
      end;
      AObject := TPlayObject(m_DealCreat);
      AObject.SendDefMessage(SM_DEALSUCCESS, 0, 0, 0, 0, '');
      AObject.SysMsg(g_sDealSuccessMsg { '交易成功.' } , c_Green, t_Hint);
      AObject.m_DealCreat := nil;
      AObject.m_boDealing := False;
      AObject.m_DealItemList.Clear;
      AObject.m_nDealGolds := 0;
      AObject.m_boDealOK := False; // Jacky 增加
      SendDefMessage(SM_DEALSUCCESS, 0, 0, 0, 0, '');
      SysMsg(g_sDealSuccessMsg { '交易成功.' } , c_Green, t_Hint);
      AObject.WeightChanged;
      m_DealCreat.WeightChanged;
      m_DealCreat := nil;
      m_boDealing := False;
      m_DealItemList.Clear;
      m_nDealGolds := 0;
      m_boDealOK := False; // Jacky 增加
    end
    else
    begin // 004DE42F
      DealCancel();
    end;
  end
  else
  begin // 004DE439
    SysMsg(g_sYouDealOKMsg { '你已经确认交易了' } , c_Green, t_Hint);
    m_DealCreat.SysMsg(g_sPoseDealOKMsg { '对方已经确认交易了' } , c_Green, t_Hint);
  end;
end;

procedure TPlayObject.ClientUserStorageItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  Merchant: TMerchant;
  I: Integer;
  UserItem: pTUserItem;
  bo19: Boolean;
  StdItem: pTStdItem;
  sUserItemName: string;
  NPC: TObject;
  nItemIdx: Integer;
  sMsg: string;
  nPage: Integer;
begin
  NPC := TObject(ProcessMsg.nParam1);
  Merchant := UserEngine.FindMerchant(NPC);

  if g_OnlineMsgControl.boDisableSaveToStorage then
  begin
    SendDefMessage(SM_STORAGE_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;

  if Merchant = nil then
    Exit;

  if not(((Merchant.m_PEnvir = m_PEnvir) //
    and (abs(Merchant.m_nCurrX - m_nCurrX) < 15) //
    and (abs(Merchant.m_nCurrY - m_nCurrY) < 15)) //
    or (Merchant = g_FunctionNPC) //
    or (Merchant = g_MissionNPC)) then
    Exit;

  nItemIdx := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  sMsg := ProcessMsg.sMsg;
  nPage := ProcessMsg.wParam;
  bo19 := False;

  if Pos(' ', sMsg) >= 0 then // 折分物品名称(信件物品的名称后面加了使用次数)
    GetValidStr3_Ex(sMsg, sMsg, ' ');

  if (m_nPayMent = 1) and not g_Config.boTryModeUseStorage then
  begin
    SysMsg(g_sTryModeCanotUseStorage { '试玩模式不可以使用仓库功能！' } , c_Red, t_Hint);
    Exit;
  end;

  if Merchant.m_boBigStorage then
  begin
    for I := m_ItemList.Count - 1 downto 0 do
    begin
      if m_ItemList.Count <= 0 then
        Break;

      UserItem := m_ItemList.Items[I];
      if UserItem = nil then
        Continue;

      // 取自定义物品名称
      sUserItemName := '';
      if UserItem.btValue[13] = 1 then
        sUserItemName := UserItem.Name;

      if sUserItemName = '' then
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);

      if (UserItem.MakeIndex = nItemIdx) and (CompareText(sUserItemName, sMsg) = 0) then
      begin
        if CanSaveToBigStorage then // 修改无限仓库 -- piaoyun 2013-6-22
        begin
          if (GetUserItemBindValue(UserItem, ubNoStorage) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 2) then
          begin
            Merchant.MessageBox(Self, g_sCanotUserStorageItem);
            Break;
          end;

          m_BigStorageItemList.Add(UserItem);
          g_M2DataDB.StorageDB.AddStorageItem(m_nBigStorageID, m_sCharName, UserItem);
          m_ItemList.Delete(I);
          WeightChanged();
          SendDefMessage(SM_STORAGE_OK, 0, 0, 0, 0, '');

          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if StdItem <> nil then
          begin
            if StdItem.NeedIdentify = 1 then
              AddGameDataLog(LOG_ItemMove, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, '人物背包->无限仓库');

            m_sCurrentItemName := StdItem.DBName;
            m_sCurrentItemNewName := StdItem.Name;
            m_CurrentItemOverlapCount := ifthen(StdItem.Overlap > 0, UserItem.Dura + 1, 1);
            m_nCurrentItemMakeIndex := UserItem.MakeIndex;
          end;
        end
        else
          SendDefMessage(SM_STORAGE_FULL, 0, 0, 0, 0, '');

        bo19 := True;
        Break;
      end;
    end;
  end
  else if Merchant.m_boStorage then
  begin
    if (nPage < Low(m_StorageItemList)) or (nPage > High(m_StorageItemList)) then
    begin
      SendDefMessage(SM_STORAGE_FAIL, 0, 0, 0, 0, '');
      Exit;
    end;

    if not m_boStorageOpen[nPage] then
    begin
      SendDefMessage(SM_STORAGE_FAIL, 0, 0, 0, 0, '');
      SysMsg('未开启仓库' + IntToStr(nPage + 1), c_Red, t_Hint);
      Exit;
    end;

    for I := m_ItemList.Count - 1 downto 0 do
    begin
      if m_ItemList.Count <= 0 then
        Break;

      UserItem := m_ItemList.Items[I];
      if UserItem = nil then
        Continue;

      // 取自定义物品名称
      sUserItemName := '';
      if UserItem.btValue[13] = 1 then
        sUserItemName := UserItem.Name;

      if sUserItemName = '' then
        sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);

      if (UserItem.MakeIndex = nItemIdx) and (CompareText(sUserItemName, sMsg) = 0) then
      begin
        if CanSaveToStorage(nPage) then // 修改无限仓库 -- piaoyun 2013-6-22
        begin
          if (GetUserItemBindValue(UserItem, ubNoStorage) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 2) then
          begin
            Merchant.MessageBox(Self, g_sCanotUserStorageItem);
            Break;
          end;

          m_StorageItemList[nPage].Add(UserItem);
          m_ItemList.Delete(I);
          WeightChanged();
          SendDefMessage(SM_STORAGE_OK, 0, 0, 0, 0, '');
          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if StdItem <> nil then
          begin
            if StdItem.NeedIdentify = 1 then
              AddGameDataLog(LOG_ItemMove, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, '人物背包->普通仓库');

            m_sCurrentItemName := StdItem.DBName;
            m_sCurrentItemNewName := StdItem.Name;
            m_CurrentItemOverlapCount := ifthen(StdItem.Overlap > 0, UserItem.Dura + 1, 1);
            m_nCurrentItemMakeIndex := UserItem.MakeIndex;
          end;
        end
        else
          SendDefMessage(SM_STORAGE_FULL, 0, 0, 0, 0, '');

        bo19 := True;
        Break;
      end;
    end;
  end;

  if bo19 then
  begin
    g_FunctionNPC.GotoLable(Self, '@BeginStorageSave', False); // Cursor 2023-06-05 16:23:04 增加存仓库触发
    m_sCurrentItemName := '';
    m_sCurrentItemNewName := '';
    m_CurrentItemOverlapCount := 0;
    m_nCurrentItemMakeIndex := 0;
  end
  else
    SendDefMessage(SM_STORAGE_FAIL, 0, 0, 0, 0, '');
end;

procedure TPlayObject.ClientUserTakebackStorageItem(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  Merchant: TMerchant;
  I: Integer;
  UserItem: pTUserItem;
  OverLapItem: pTUserItem;
  bo19: Boolean;
  StdItem: pTStdItem;
  sUserItemName: string;
  nWeight: Integer;
  nDura: Integer;
  nMakeIndex: Integer;
  NPC: TObject;
  nCount, nItemIdx: Integer;
  sMsg: string;
  ItemList: TList;
  sLogDesc: string;
begin
  NPC := TObject(ProcessMsg.nParam1);
  nCount := ProcessMsg.wParam;
  nItemIdx := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  sMsg := ProcessMsg.sMsg;
  bo19 := False;

  Merchant := UserEngine.FindMerchant(NPC);
  if Merchant = nil then
    Exit;

  if not(((Merchant.m_PEnvir = m_PEnvir) //
    and (abs(Merchant.m_nCurrX - m_nCurrX) < 15) //
    and (abs(Merchant.m_nCurrY - m_nCurrY) < 15)) //
    or (Merchant = g_FunctionNPC) //
    or (Merchant = g_MissionNPC)) then
    Exit;

  if (m_nPayMent = 1) and not g_Config.boTryModeUseStorage then
  begin
    SysMsg(g_sTryModeCanotUseStorage { '试玩模式不可以使用仓库功能！' } , c_Red, t_Hint);
    Exit;
  end;

  if g_OnlineMsgControl.boDisableGetFromStorage then
  begin
    SendDefMessage(SM_TAKEBACKSTORAGEITEM_FAIL, 0, 0, 0, 0, '');
    Exit;
  end;

  if not m_boCanGetBackItem then
  begin
    SendMsg(Merchant, RM_MENU_OK, 0, NativeInt(Self), 0, 0, g_sStorageIsLockedMsg + '\ \' + '仓库开锁命令: @' +
      g_GameCommand.UNLOCKSTORAGE.sCmd + '\' + '仓库加锁命令: @' + g_GameCommand.Lock.sCmd + '\' + '设置密码命令: @' +
      g_GameCommand.SETPASSWORD.sCmd + '\' + '修改密码命令: @' + g_GameCommand.CHGPASSWORD.sCmd);
    Exit;
  end;

  if nCount <= 0 then
    nCount := 1;

  if Merchant.m_boBigGetback then
    ItemList := m_BigStorageItemList
  else if Merchant.m_boGetback then
  begin
    if (FStoragePageIndex < Low(m_StorageItemList)) or (FStoragePageIndex > High(m_StorageItemList)) then
    begin
      ItemList := m_StorageItemList[0];
    end
    else
    begin
      if not m_boStorageOpen[FStoragePageIndex] then
      begin
        SysMsg('未开启仓库' + IntToStr(FStoragePageIndex + 1), c_Red, t_Hint);
        SendDefMessage(SM_TAKEBACKSTORAGEITEM_FAIL, 0, 0, 0, 0, '');
        Exit;
      end;
      ItemList := m_StorageItemList[FStoragePageIndex];
    end;
  end
  else
    Exit;

  for I := ItemList.Count - 1 downto 0 do
  begin
    UserItem := ItemList.Items[I];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem = nil then
      Continue;

    // 取自定义物品名称
    sUserItemName := '';
    if UserItem.btValue[13] = 1 then
      sUserItemName := UserItem.Name;

    if sUserItemName = '' then
      sUserItemName := UserEngine.GetStdItemName(UserItem.wIndex);

    if (UserItem.MakeIndex = nItemIdx) and (CompareText(sUserItemName, sMsg) = 0) then
    begin
      // 修复提取包裹物品时，输入包裹数量被客户端利用 chongchong 2014-05-21
      if nCount > UserItem.Dura + 1 then
        nCount := UserItem.Dura + 1;

      nWeight := StdItem.Weight;
      if CheckOverLapItem(StdItem) then
      begin // 计算购买叠加物品
        if (nCount > 0) then
        begin
          if StdItem.Overlap = 1 then
            nWeight := Min(Max(StdItem.Weight * nCount div 10, StdItem.Weight), High(Byte))
          else
            nWeight := Min(StdItem.Weight * nCount, High(Byte));
        end;
      end;

      if ItemList = m_BigStorageItemList then
        sLogDesc := '无限仓库->人物背包'
      else
        sLogDesc := '普通仓库->人物背包';

      if IsAddWeightAvailable(nWeight) then
      begin
        if (not UserItem.boIsBind) then
          OverLapItem := OverLapItems(Self, StdItem, nCount - 1)
        else
          OverLapItem := nil;

        if (OverLapItem <> nil) then
        begin
          nDura := UserItem.Dura + 1;
          nDura := nDura - nCount;
          if nDura <= 0 then
          begin
            nCount := 0;
            ItemList.Delete(I);
            if ItemList = m_BigStorageItemList then
              g_M2DataDB.StorageDB.DeleteStorageItem(m_nBigStorageID, m_sCharName, UserItem.MakeIndex, UserItem.wIndex);

            if (StdItem.NeedIdentify = 1) then
              AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '叠加到背包', 0, 0, sLogDesc);

            Dispose(UserItem);
          end
          else
          begin
            UserItem.Dura := nDura - 1;
            nCount := nDura;
          end;

          UserItem := OverLapItem;
          bo19 := True;
          if (StdItem.NeedIdentify = 1) then
            AddGameDataLog(LOG_ItemMove, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '叠加数量', UserItem.Dura + 1,
              nCount, sLogDesc)
        end
        else
        begin
          if IsEnoughBag then
          begin
            if CheckOverLapItem(StdItem) then
            begin
              nDura := UserItem.Dura + 1;
              nDura := nDura - nCount;
              if nDura <= 0 then
              begin // 取回全部叠加物品
                nCount := 0;
                ItemList.Delete(I);
                if ItemList = m_BigStorageItemList then
                  g_M2DataDB.StorageDB.DeleteStorageItem(m_nBigStorageID, m_sCharName, UserItem.MakeIndex, UserItem.wIndex);

                AddItemToBag(UserItem);
              end
              else
              begin // 取回部分叠加物品
                New(OverLapItem);
                if UserEngine.CopyToUserItemFromName(StdItem.Name, OverLapItem) then
                begin
                  nMakeIndex := OverLapItem.MakeIndex;
                  OverLapItem^ := UserItem^;
                  OverLapItem.MakeIndex := nMakeIndex;
                  OverLapItem.Dura := nCount - 1;
                  UserItem.Dura := nDura - 1;
                  nCount := nDura;
                  AddItemToBag(OverLapItem);
                  UserItem := OverLapItem;
                end
                else
                begin
                  Dispose(OverLapItem);
                  Break;
                end;
              end;
            end
            else
            begin
              nCount := 0;
              ItemList.Delete(I);
              if ItemList = m_BigStorageItemList then
                g_M2DataDB.StorageDB.DeleteStorageItem(m_nBigStorageID, m_sCharName, UserItem.MakeIndex, UserItem.wIndex);

              AddItemToBag(UserItem);
            end;

            SendAddItem(UserItem);
            bo19 := True;

            if (StdItem.NeedIdentify = 1) then
              AddGameDataLog(LOG_ItemMove, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, sLogDesc);
          end
          else
            SendDefMessage(SM_TAKEBACKSTORAGEITEM_FULLBAG, 0, 0, 0, 0, '');
        end;

        if bo19 then
        begin
          SendDefMessage(SM_TAKEBACKSTORAGEITEM_OK, nItemIdx, nCount, 0, 0, '');

          m_sCurrentItemName := StdItem.DBName;
          m_sCurrentItemNewName := StdItem.Name;
          m_CurrentItemOverlapCount := ifthen(StdItem.Overlap > 0, UserItem.Dura + 1, 1);
          m_nCurrentItemMakeIndex := UserItem.MakeIndex;
          g_FunctionNPC.GotoLable(Self, '@BeginStorageTake', False); // Cursor 2023-06-05 16:23:04 增加取仓库触发
          m_sCurrentItemName := '';
          m_sCurrentItemNewName := '';
          m_CurrentItemOverlapCount := 0;
          m_nCurrentItemMakeIndex := 0;
        end;
      end
      else
        SysMsg(g_sCanotGetItems { '无法携带更多的东西！' } , c_Red, t_Hint);

      Break;
    end;
  end;

  if not bo19 then
    SendDefMessage(SM_TAKEBACKSTORAGEITEM_FAIL, 0, 0, 0, 0, '');
end;

