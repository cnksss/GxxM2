function TPlayObject.GetUpdateItem: pTUserItem;
var
  I: Integer;
begin
  Result := nil;
  if not m_UpgradeItemIsPegBag then
  begin
    for I := 0 to m_ItemList.Count - 1 do
    begin
      if m_ItemList.Items[I] = m_UpgradeItem then
      begin
        Result := m_UpgradeItem;
        Break;
      end;
    end;
  end
  else
  begin
    for I := 0 to m_GamePetBagItems.Count - 1 do
