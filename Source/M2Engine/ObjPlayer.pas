procedure TPlayObject.ProcessSafeZoneHint;
var
  SayText: string;
begin
  if m_boDeath or m_boGhost then
    Exit;
  // if MyGetTickCount - FLastCheckTick >= 1000 then
  begin
    // FLastCheckTick := MyGetTickCount;
    if FIsInSafeZone <> InSafeArea then
    begin
      FIsInSafeZone := not FIsInSafeZone;
      if FIsInSafeZone then
      begin
        // PK时，主人回到安全区，英雄不再攻击了chongchong 2017-12-11
        if (m_MyHero <> nil) { and (m_MyHero.m_boTarget) } then
        begin
          m_MyHero.m_boTarget := False;
          m_MyHero.DelTargetCreat;
          THeroObject(m_MyHero).FollowMaster;
        end;
      end;
      if g_Config.boHintSafeZone then
      begin
        if FIsInSafeZone then
          SayText := g_sEnterSafeZone
        else
          SayText := g_sExitSafeZone;
        SendSuperMoveMsg(SayText, g_Config.btHintSafeZoneFColor, g_Config.btHintSafeZoneBColor, g_Config.btHintSafeZoneFSize, 0,
          g_Config.dwHintSafeZoneY, 1);
      end;
      if not g_Config.boDiableHumanRun and g_Config.boSafeAreaLimited then
      begin
        SendMapCanRun;
      end;
    end;
  end;
end;

procedure TPlayObject.SendJewelryBox(IsHero: Boolean);
var
  I, nC: Integer;
  sSendMsg: AnsiString;
  ClientItem: pTClientItem;
  StdItem: pTStdItem;
  InBuf: array [0 .. 12000] of AnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
