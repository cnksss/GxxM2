procedure TPlayObject.ServerSendChangeMap(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nObjCount: Integer;
  I: Integer;
  nCount: Integer;
  Effect: PTServerWeateherEffect;
  InBuf: array [0 .. MAX_MAP_WEATEHER_EFFECT * SizeOf(TServerWeateherEffect)] of AnsiChar;
  InBytes: Integer;
  Buffer: PAnsiChar;
  PlayObject: TPlayObject;
begin
  // SysMsg(m_PEnvir.MapName, c_Red, t_Hint);
  DoClientAction(catChangeMap);
  if m_PEnvir.m_boDARK then
    nObjCount := 1
  else
  begin
    case m_nBright of
      1:
        nObjCount := 0;
      0, 2:
        nObjCount := 2;
      3:
        nObjCount := 1;
    else
      nObjCount := 1;
    end;
  end;
  if m_PEnvir.m_boDAY then
    nObjCount := 0;
  SendDefMessage(SM_CHANGEMAP, NativeInt(Self), m_nCurrX, m_nCurrY, nObjCount, ProcessMsg.sMsg);
  RefUserState();
  SendMapDescription();
  SendMapCanRun();
  if g_Config.ClientConfigs[73] and (m_GroupOwner <> nil) then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      m_GroupMembers.LockR(220);
    try
{$IFEND}
      for I := 0 to m_GroupOwner.m_GroupMembers.Count - 1 do
      begin
        PlayObject := TPlayObject(m_GroupOwner.m_GroupMembers.Objects[I]);
        if (PlayObject <> nil) and (PlayObject <> Self) then
        begin
          PlayObject.SendDefMessage(SM_GROUPMEMBER_CHANGEMAP, NativeInt(Self), m_nCurrX, m_nCurrY, 0,
            m_PEnvir.sMapDesc + sLineBreak + ProcessMsg.sMsg);
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        m_GroupMembers.UnLockR;
    end;
{$IFEND}
  end;
  // 检查有没有天气特效，没有则不发
  InBytes := 0;
  nCount := 0;
  for I := Low(m_PEnvir.m_WeatherEffect) to High(m_PEnvir.m_WeatherEffect) do
  begin
    if m_PEnvir.m_WeatherEffect[I].boIsUsed then
    begin
      Inc(nCount);
      Inc(InBytes, SizeOf(TServerWeateherEffect) + 1);
      Buffer := @InBuf;
      Buffer := Buffer + (InBytes - (SizeOf(TServerWeateherEffect) + 1));
      Buffer^ := AnsiChar(I);
      Inc(Buffer);
      Effect := PTServerWeateherEffect(Buffer);
      Effect^ := m_PEnvir.m_WeatherEffect[I];
    end;
  end;
  { TODO -opiaoyun -c修改 : 修改天气效果开启后，切换到其它地图还是开启状态 【2013-07-23】 }
  m_DefMsg := MakeDefaultMsg(SM_WEATHER, 0, 0, 0, nCount);
  SendSocketEx(@m_DefMsg, InBuf, InBytes);
  if m_PEnvir.m_boNoRecallHero then
  begin
    if m_MyHero <> nil then
      THeroObject(m_MyHero).LogOut;
  end;
  if m_PEnvir.m_boNoCallPet then
  begin
    DoGamePetRetake;
  end;
end;

