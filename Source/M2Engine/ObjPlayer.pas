  nMaxPrice := MakeLong(ProcessMsg.nParam2, ProcessMsg.nParam3);
  nPos := ProcessMsg.wIdent - CM_QUERYMYSHOPSELLINGITEMS;
  if (m_dwChangeModeExTick[9] <> 0) and (MyGetTickCount() <= m_dwChangeModeExTick[9]) then
  begin
    SysMsg(g_sCanotTryDealMsg, c_Red, t_Hint);
