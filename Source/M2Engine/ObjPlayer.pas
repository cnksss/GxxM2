procedure TPlayObject.ServerSendShowEvent(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  MessageBodyWL: TMessageBodyWL;
  EventData: TEventData;
begin
  m_DefMsg := MakeDefaultMsg(SM_SHOWEVENT, ProcessMsg.nParam1, ProcessMsg.wParam, // MakeWord(m_nEventType,m_nEventParam);
    ProcessMsg.nParam2, // m_nX
    ProcessMsg.nParam3); // m_nY
  if TGameEvent(ProcessMsg.nParam1) is TMapEffectEvent then
  begin
    MessageBodyWL.lParam1 := TMapEffectEvent(ProcessMsg.nParam1).m_nImageIndex;
    MessageBodyWL.lParam2 := MakeLong(TMapEffectEvent(ProcessMsg.nParam1).m_nImageCount,
      TMapEffectEvent(ProcessMsg.nParam1).m_btLight);
    MessageBodyWL.lTag1 := TMapEffectEvent(ProcessMsg.nParam1).m_dwSpeedTime;
    MessageBodyWL.lTag2 := MakeLong(TMapEffectEvent(ProcessMsg.nParam1).m_nFileIndex,
      TMapEffectEvent(ProcessMsg.nParam1).m_nLoopCount);
    SendSocketEx(@m_DefMsg, @MessageBodyWL, SizeOf(TMessageBodyWL));
  end
  else
  begin
    if TGameEvent(ProcessMsg.nParam1) is TCustomEffectEvent then
    begin
      EventData.Data1 := TCustomEffectEvent(ProcessMsg.nParam1).OwnerAppr;
      EventData.Data2 := TCustomEffectEvent(ProcessMsg.nParam1).AttackIndex;
      SendSocketEx(@m_DefMsg, @EventData, SizeOf(EventData));
    end
    else if TGameEvent(ProcessMsg.nParam1) is TCustomMagicEffectEvent then
    begin
      EventData.Data1 := TCustomMagicEffectEvent(ProcessMsg.nParam1).MagicID;
      EventData.Data2 := TCustomMagicEffectEvent(ProcessMsg.nParam1).NewLevel;
      SendSocketEx(@m_DefMsg, @EventData, SizeOf(EventData));
    end
    else
    begin
      EventData.Data1 := 0;
      EventData.Data2 := 0;
      if TGameEvent(ProcessMsg.nParam1) is TMapMagicGameEvent then
      begin
        if TMapMagicGameEvent(ProcessMsg.nParam1).KeepVisible then
          EventData.Data1 := 1;
      end;
      if TGameEvent(ProcessMsg.nParam1) is TSafeEvent then
        EventData.Data2 := TSafeEvent(ProcessMsg.nParam1).Dir;
      SendSocketEx(@m_DefMsg, @EventData, SizeOf(EventData));
    end;
  end;
end;

