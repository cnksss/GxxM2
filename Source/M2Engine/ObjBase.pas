              ((m_btPermission > 9) and g_Config.boGMRunAll)) { or (g_Config.boSafeAreaLimited and InSafeZone) } ) and
              (m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, m_nCurrX, m_nCurrY - 3, True)) then
            begin
              Dec(m_nCurrY, 3);
