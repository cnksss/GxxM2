function GetSkillAttackPowerNG(BaseObject: TBaseObject; UserMagic: pTUserMagic; nPower: Integer): Integer; // 计算内功攻击威力
var
  SmartObj: TSmartObject;
  nPoint: Integer;
  NZMagic: pTUserMagic; // 怒之技能
begin
  Result := nPower;
  if (BaseObject <> nil) and (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
  begin
    SmartObj := TSmartObject(BaseObject);
    // 怒之加攻击
    if (UserMagic <> nil) and (UserMagic.wMagIdx < Length(SmartObj.m_UserAttackMagics)) then
    begin
      // 技能对应的怒之
      NZMagic := SmartObj.m_UserAttackMagics[UserMagic.wMagIdx];
      if (NZMagic <> nil) and (NZMagic.btKey > 0) then
      begin
        nPoint := SmartObj.GetSpellPoint(NZMagic); // 掉内力值
        if (SmartObj.m_AbilNG.NH >= nPoint) then
        begin
          SmartObj.m_AbilNG.NH := Max(0, SmartObj.m_AbilNG.NH - nPoint);
          SmartObj.RefAbilNH;
          SmartObj.TrainSkillNG(NZMagic, Random(3) + 1); // 内功技能升级
          Result := Min(LongWord(Result + Max(Round(Result * ((NZMagic.btLevel + 1) * (g_Config.nNGSkillPowerRate / 100))), 0)),
            High(Integer)); // 计算攻击力
        end;
      end;
    end;
  end;
end;

function GetSkillDefensePowerNG(BaseObject: TBaseObject; UserMagic: pTUserMagic; nPower: Integer): Integer; // 计算内功防御威力
var
  SmartObj: TSmartObject;
  nPoint: Integer;
  JZMagic: pTUserMagic; // 静之技能
  boChangedNH: Boolean;
begin
  Result := nPower;
  if (BaseObject <> nil) and (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
  begin
    SmartObj := TSmartObject(BaseObject);
    boChangedNH := False;
    // 静之加防御
    if (UserMagic <> nil) and (UserMagic.wMagIdx < Length(SmartObj.m_UserDefenseMagics)) then
    begin
      JZMagic := SmartObj.m_UserDefenseMagics[UserMagic.wMagIdx];
      if (JZMagic <> nil) and (JZMagic.btKey > 0) then
      begin
        nPoint := SmartObj.GetSpellPoint(JZMagic); // 掉内力值
        if (SmartObj.m_AbilNG.NH >= nPoint) then
        begin
          boChangedNH := True;
          SmartObj.m_AbilNG.NH := Max(0, SmartObj.m_AbilNG.NH - nPoint);
          SmartObj.TrainSkillNG(JZMagic, Random(3) + 1); // 内功技能升级
          Result := Min(LongWord(Result + Max(Round(Result * ((JZMagic.btLevel + 1) * (g_Config.nNGSkillPowerRate / 100))), 0)),
            High(Integer)); // 计算攻击力
        end;
      end;
    end;
    if boChangedNH then
    begin
      SmartObj.RefAbilNH;
    end;
  end;
end;

function GetSkillLastPowerNG(nPower, nAttackPower, nDefensePower: Integer): Integer; // 计算静之防御威力最后威力
var
  I64: Int64;
begin
  I64 := nPower + (nAttackPower - nDefensePower);
  if I64 < 0 then
    Result := 0
  else if I64 >= High(Integer) then
    Result := High(Integer)
  else
    Result := I64;
end;

function GetSkillContinuousBlastHitPower(BaseObject, AttackTarget: TBaseObject; UserMagic: pTUserMagic; nPower: Integer): Integer;
// 计算连击暴击
var
  nMagicID, nMeridianLevel: Integer;
  ContinuousIndex: Integer; // 连击索引
  AddBlastHitRate: Integer;
begin
  Result := nPower;
  if (UserMagic <> nil) and (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
  begin
    nMeridianLevel := UserMagic.btLevel;
    if (nMeridianLevel < 1) or (nMeridianLevel > 5) then
      nMeridianLevel := 1;
    nMagicID := UserMagic.wMagIdx - 100;
    if (nMagicID < 0) or (nMagicID > 11) then
      nMagicID := 11;
    { 计算连击在每个位置的附加暴击率 chongchong 2013-08-19 }
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
      ContinuousIndex := TPlayObject(BaseObject).m_nCurrContinuousMagicIndex
    else
      ContinuousIndex := -1;
    case ContinuousIndex of
      0:
        AddBlastHitRate := g_Config.SkillContinueOrderBlastRates[0]; // 10;
      1:
        AddBlastHitRate := g_Config.SkillContinueOrderBlastRates[1]; // 15;
      2:
        AddBlastHitRate := g_Config.SkillContinueOrderBlastRates[2]; // 25;
      3:
        AddBlastHitRate := g_Config.SkillContinueOrderBlastRates[3]; // 25;
    else
      AddBlastHitRate := 0;
    end;
    { TODO -ochongchong -c新增 : 连击暴击率 = 服务器配置的暴击率 + 所在连击位的增加暴击率 【2013-08-19】 }
    if Random(100) < (g_Config.SkillContinuousBlastHitRates[nMagicID, nMeridianLevel - 1] + AddBlastHitRate) then
    begin
      Result := Min(LongWord(Round(nPower * (g_Config.SkillContinuousBlastHitPowerRates[nMagicID, nMeridianLevel - 1] / 100))),
        High(Integer));
      if (UserMagic.MagicInfo <> nil) then
        BaseObject.SysMsg(Format('您的%s出现暴击, 造成了额外的伤害', [UserMagic.MagicInfo.sMagicName]), c_Green, t_Hint);
      if BaseObject <> nil then
      begin
        BaseObject.SendRefMsg(RM_ContinuousBLASTHIT, BaseObject.m_btDirection, BaseObject.m_nCurrX, BaseObject.m_nCurrY,
          Result, '', 0);
      end;
    end;
  end;
end;

procedure OnMapNotifyEvent(BaseObject: TBaseObject; NotifyEvent: TMapNotifyEvent; sValue: string);
var
  I: Integer;
  EventList: TList;
  MapEvent: pTMapEvent;
  nMaxX, nMaxY, nMinX, nMinY: Integer;
  boValue: Boolean;
  // PlayObject: TPlayObject;
  CurrentMapName: string;
begin
  if not(BaseObject.m_btRaceServer in [RC_PLAYOBJECT { , RC_HEROOBJECT } ]) then
    Exit;
  if not g_Config.boOpenMapEvent then
    Exit;
  case NotifyEvent of
    meDropItem:
      EventList := g_MapEventListOfDropItem;
    mePickUpItem:
      EventList := g_MapEventListOfPickUpItem;
    meMine:
      EventList := g_MapEventListOfMine;
    meWalk:
      EventList := g_MapEventListOfWalk;
    meRun:
      EventList := g_MapEventListOfRun;
    meScatterItem:
      EventList := g_MapEventListOfScatterItem;
    meHorseWalk:
      EventList := g_MapEventListOfHorseWalk;
    meHorseRun:
      EventList := g_MapEventListOfHorseRun;
    meDoMine:
      EventList := g_MapEventListOfDoMine;
  else
    EventList := nil;
  end;
  if EventList = nil then
    Exit;
  // MainOutMessage('OnMapNotifyEvent 1: '+sValue);
  for I := EventList.Count - 1 downto 0 do
  begin
    MapEvent := EventList.Items[I];
    { 副本地图 -- 地图事件 chongchong 2013-09-10 }
    if BaseObject.m_PEnvir.m_boFB then
      CurrentMapName := BaseObject.m_PEnvir.m_sFBName
    else
      CurrentMapName := BaseObject.m_sMapName;
    if (CompareText(MapEvent.sMapName, CurrentMapName) = 0) or (MapEvent.sMapName = '*') then
    begin // 检测地图
      if (MapEvent.nCurrX >= 0) and (MapEvent.nCurrY >= 0) then
      begin
        if NotifyEvent in [meDropItem, meScatterItem] then
        begin
          if MapEvent.nRange > 0 then
          begin
            nMinX := MapEvent.nCurrX - MapEvent.nRange;
            nMaxX := MapEvent.nCurrX + MapEvent.nRange;
            nMinY := MapEvent.nCurrY - MapEvent.nRange;
            nMaxY := MapEvent.nCurrY + MapEvent.nRange;
            if not((BaseObject.m_nScatterItemX >= nMinX) and (BaseObject.m_nScatterItemX <= nMaxX) and
              (BaseObject.m_nScatterItemY >= nMinY) and (BaseObject.m_nScatterItemY <= nMaxY)) then
              Continue; // 检测坐标
            // if (m_nCurrX > nMaxX) or (m_nCurrX < nMinX) or (m_nCurrY > nMaxY) or (m_nCurrY < nMinY) then Continue; //检测坐标
          end
          else
          begin
            if (BaseObject.m_nScatterItemX <> MapEvent.nCurrX) or (BaseObject.m_nScatterItemY <> MapEvent.nCurrY) then
              Continue; // 检测坐标
          end;
        end
        else
        begin
          if MapEvent.nRange > 0 then
          begin
            nMinX := MapEvent.nCurrX - MapEvent.nRange;
            nMaxX := MapEvent.nCurrX + MapEvent.nRange;
            nMinY := MapEvent.nCurrY - MapEvent.nRange;
            nMaxY := MapEvent.nCurrY + MapEvent.nRange;
            if not((BaseObject.m_nCurrX >= nMinX) and (BaseObject.m_nCurrX <= nMaxX) and (BaseObject.m_nCurrY >= nMinY) and
              (BaseObject.m_nCurrY <= nMaxY)) then
              Continue; // 检测坐标
            // if (m_nCurrX > nMaxX) or (m_nCurrX < nMinX) or (m_nCurrY > nMaxY) or (m_nCurrY < nMinY) then Continue; //检测坐标
          end
          else
          begin
            if (BaseObject.m_nCurrX <> MapEvent.nCurrX) or (BaseObject.m_nCurrY <> MapEvent.nCurrY) then
              Continue; // 检测坐标
          end;
        end;
      end
      else
      begin
        // if MapEvent.Event in [meMine, meWalk, meRun] then Continue;
      end;
      // MainOutMessage('OnMapNotifyEvent: 2'+sValue);
      if MapEvent.MapFlag.nQuestUnit >= 0 then
      begin // 检测标识
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          boValue := TPlayObject(BaseObject).GetQuestFlagStatus(MapEvent.MapFlag.nQuestUnit) <> 0;
          if MapEvent.MapFlag.boValue <> boValue then
            Continue;
        end;
      end;
      if (MapEvent.Condition.sItemName <> '*') and (CompareText(MapEvent.Condition.sItemName, sValue) <> 0) then
        Continue; // 检测物品名称
      if (MapEvent.nRandomValue <> 0) and (Random(MapEvent.nRandomValue) <> 0) then
        Continue; // 检测机率
      if (MapEvent.StartScript.nLable > 0) and (MapEvent.StartScript.sLable <> '') then
      begin
        try
          if g_FunctionNPC <> nil then
          begin
            if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
            begin
              TPlayObject(BaseObject).m_nScriptGotoCount := 0;
              g_FunctionNPC.m_boMapEvent := True;
              try
                g_FunctionNPC.GotoLable(TPlayObject(BaseObject), MapEvent.StartScript.sLable, False);
              finally
                g_FunctionNPC.m_boMapEvent := False;
              end;
            end;
            (*
              else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
              begin
              if (BaseObject.m_Master <> nil) and (BaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
              begin
              try
              g_FunctionNPC.m_boMapEvent := True;
              g_FunctionNPC.GotoLable(TPlayObject(BaseObject.m_Master), MapEvent.StartScript.sLable, False);
              finally
              g_FunctionNPC.m_boMapEvent := False;
              end;
              end;
              end;
              (*
              { 宝宝不触发地图事件 (原为else改为 else if ) chongchong 2014-04-17 }
              else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
              begin
              PlayObject := TPlayObject.Create;
              PlayObject.m_CurrTarget := BaseObject;
              PlayObject.m_boSuperMan := True;
              PlayObject.m_sMapName := BaseObject.m_sMapName;
              PlayObject.m_PEnvir := BaseObject.m_PEnvir;
              //PlayObject.m_sCharName := 'QMapEvent';
              PlayObject.m_sCharName := BaseObject.m_sCharName;
              try
              g_FunctionNPC.m_boMapEvent := True;
              g_FunctionNPC.GotoLable(PlayObject, MapEvent.StartScript.sLable, False);
              finally
              g_FunctionNPC.m_boMapEvent := False;
              PlayObject.Free;
              end;
              end;
            *)
          end;
        except
          MainOutMessage('[Exception] TBaseObject:OnMapNotifyEvent');
        end;
        Break;
      end;
    end;
  end;
end;

