          begin
            nSecPwr := Min(LongWord(Round(nSecPwr * (g_Config.nSkill60AttackHumPowerRate / 100))), High(Integer));
          end
          else
          begin
            nSecPwr := Min(LongWord(Round(nSecPwr * (g_Config.nSkill60PowerRate / 100))), High(Integer));
          end;
