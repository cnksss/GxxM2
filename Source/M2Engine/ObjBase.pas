function TBaseObject.CalcGetExp(nLevel: Integer; nExp: Integer): Integer;
begin
  if g_Config.boHighLevelKillMonFixExp or (m_dwHighLevelKillMonFixExpTime > 0) or (m_Abil.Level < (nLevel + 10)) then
    Result := nExp
  else
    Result := nExp - Round((nExp / 15) * (m_Abil.Level - (nLevel + 10)));

  if Result <= 0 then
    Result := 1;
end;

