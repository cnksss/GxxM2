    if m_wDecStatusArrValue[0] > 0 then
    begin
      m_WAbil.DC1 := Max(m_WAbil.DC1 - m_wDecStatusArrValue[0], 0);;
      m_WAbil.DC2 := Max(m_WAbil.DC2 - m_wDecStatusArrValue[0], 0);
    end;

