      Int64Value := Round(m_WAbil.SC1 / 100 * (100 - m_nNewCurseDefenceUpValue));
      m_WAbil.SC1 := Max(0, Int64Value);
      Int64Value := Round(m_WAbil.SC2 / 100 * (100 - m_nNewCurseDefenceUpValue));
      m_WAbil.SC2 := Max(0, Int64Value);
