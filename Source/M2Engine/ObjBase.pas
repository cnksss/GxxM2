procedure TBaseObject.ApplyMeatQuality;
var
  I: Integer;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
begin
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if UserItem = nil then
      Continue;
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem <> nil then
    begin
      if (StdItem.StdMode = 40) and (StdItem.OverLap <= 0) then
      begin
        UserItem.Dura := m_nMeatQuality;
        // if UserItem.Dura > UserItem.DuraMax then
        // UserItem.Dura := UserItem.DuraMax;
      end;
    end;
  end;
end;

{ 将挖到的物品放入包裹（挖肉） }
function TBaseObject.TakeBagItems(BaseObject: TBaseObject): Boolean;
var
  UserItem: pTUserItem;
  OverLapItem: pTUserItem;
  PlayObject: TPlayObject;
  StdItem: pTStdItem;
  Msg, sStdItemName, sUserItemName: string;
begin
  Result := False;
  while (True) do
  begin
    if BaseObject.m_ItemList.Count <= 0 then
      Break;
    UserItem := BaseObject.m_ItemList.Items[0];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem = nil then
      Break;
    OverLapItem := OverLapItems(Self, StdItem, UserItem.Dura); // 物品重叠
    if (OverLapItem = nil) then
    begin
      UserItem.ItemFrom.ItemForm := ifButchItem;
      UserItem.ItemFrom.sMapName := m_PEnvir.sMapDesc;
      UserItem.ItemFrom.sMonName := FilterShowName(BaseObject.m_sCharName);
      UserItem.ItemFrom.sMakerName := m_sCharName;
      UserItem.ItemFrom.DateTime := Now();
      if AddItemToBag(UserItem) then
      begin
        Result := True;
        if (m_btRaceServer = RC_PLAYOBJECT) then
        begin
          PlayObject := TPlayObject(Self);
          PlayObject.SendAddItem(UserItem);
          PlayObject.m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(PlayObject, '@ButchItem', False);
          if StdItem.NeedIdentify = 1 then
          begin
            AddGameDataLog(LOG_ButchItem, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, m_sCharName, 0, 0);
          end;
          { TODO -ochongchong -c新增 : 物品规则 - 挖取提示【2013-07-27】 }
          if (Length(StdItem.Name) > 0) and g_ItemRules.Get(UserItem.wIndex, 19) then
          begin
            Msg := g_sButchItemHintMsg;
            sStdItemName := ProcessItemName(StdItem.Name);
            if (UserItem.btValue[13] = 1) and (Length(UserItem.Name) > 0) then
              sUserItemName := ProcessItemName(UserItem.Name)
            else
              sUserItemName := sStdItemName;
            if Pos('%showdbitem', LowerCase(Msg)) > 0 then
            begin
              SetSayItem(UserItem);
              Msg := WideReplaceText(Msg, '%ShowDBItem', Format('{[%s]/%d}', [sStdItemName, UserItem.MakeIndex]));
            end;
            if Pos('%showitem', LowerCase(Msg)) > 0 then
            begin
              SetSayItem(UserItem);
              Msg := WideReplaceText(Msg, '%ShowItem', Format('{[%s]/%d}', [sUserItemName, UserItem.MakeIndex]));
            end;
            Msg := AnsiReplaceText(Msg, '%s', m_sCharName);
            Msg := AnsiReplaceText(Msg, '%item', sUserItemName);
            Msg := AnsiReplaceText(Msg, '%dbitem', sStdItemName);
            Msg := AnsiReplaceText(Msg, '%name', FilterShowName(BaseObject.m_sCharName));
            Msg := AnsiReplaceText(Msg, '%m', m_PEnvir.sMapDesc);
            Msg := AnsiReplaceText(Msg, '%x', IntToStr(m_nCurrX));
            Msg := AnsiReplaceText(Msg, '%y', IntToStr(m_nCurrY));
            UserEngine.SendBroadCastMsg(Msg, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_Hint); // sysmsg
          end;
        end;
      end
      else
        Break;
    end
    else
    begin
      Result := True;
      if (m_btRaceServer = RC_PLAYOBJECT) then
      begin
        // 挖取叠加物品提示 chongchong 2015-08-05
        if (Length(StdItem.Name) > 0) then
        begin
          Msg := StdItem.Name + ' 被发现.';
          if g_Config.boAddItemMsgXRightToLeft then
            SendScreenMsg(Msg, g_Config.btAddItemMsgFColor, g_Config.btAddItemMsgBColor,
              TPlayObject(Self).m_wScreenWidth - g_Config.nAddItemMsgX, g_Config.nAddItemMsgY)
          else
            SendScreenMsg(Msg, g_Config.btAddItemMsgFColor, g_Config.btAddItemMsgBColor, g_Config.nAddItemMsgX,
              g_Config.nAddItemMsgY);
        end;
        PlayObject := TPlayObject(Self);
        PlayObject.m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(PlayObject, '@ButchItem', False);
        if StdItem.NeedIdentify = 1 then
        begin
          AddGameDataLog(LOG_ButchItem, LOG_ActionNone, PlayObject, StdItem.Name, OverLapItem.MakeIndex, m_sCharName, 0, 0, '叠加');
        end;
        { TODO -ochongchong -c新增 : 物品规则 - 挖取提示【2013-07-27】 }
        if (Length(StdItem.Name) > 0) and g_ItemRules.Get(OverLapItem.wIndex, 19) then
        begin
          Msg := g_sButchItemHintMsg;
          sStdItemName := ProcessItemName(StdItem.Name);
          if (OverLapItem.btValue[13] = 1) and (Length(OverLapItem.Name) > 0) then
            sUserItemName := ProcessItemName(OverLapItem.Name)
          else
            sUserItemName := sStdItemName;
          if Pos('%showdbitem', LowerCase(Msg)) > 0 then
          begin
            SetSayItem(OverLapItem);
            Msg := WideReplaceText(Msg, '%ShowDBItem', Format('{[%s]/%d}', [sStdItemName, OverLapItem.MakeIndex]));
          end;
          if Pos('%showitem', LowerCase(Msg)) > 0 then
          begin
            SetSayItem(UserItem);
            Msg := WideReplaceText(Msg, '%ShowItem', Format('{[%s]/%d}', [sUserItemName, OverLapItem.MakeIndex]));
          end;
          Msg := AnsiReplaceText(Msg, '%s', m_sCharName);
          Msg := AnsiReplaceText(Msg, '%item', sUserItemName);
          Msg := AnsiReplaceText(Msg, '%dbitem', sStdItemName);
          Msg := AnsiReplaceText(Msg, '%name', FilterShowName(BaseObject.m_sCharName));
          Msg := AnsiReplaceText(Msg, '%m', m_PEnvir.sMapDesc);
          Msg := AnsiReplaceText(Msg, '%x', IntToStr(m_nCurrX));
          Msg := AnsiReplaceText(Msg, '%y', IntToStr(m_nCurrY));
          UserEngine.SendBroadCastMsg(Msg, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_Hint); // SysMsg
        end;
      end;
      Dispose(UserItem);
    end;
    BaseObject.m_ItemList.Delete(0);
  end;
end;

function TBaseObject.DoAutoDropItemToBag(KillMe: TBaseObject; UserItem: pTUserItem; StdItem: pTStdItem): Boolean;
  procedure ProcessDropItem(Player: TPlayObject; StdItem: pTStdItem; CurItem: pTUserItem);
  var
    sChrName, sUserItemName, sProcessStdItemName, sProcessUserItemName: string;
  begin
    sProcessStdItemName := ProcessItemName(StdItem.Name);
    if (CurItem.btValue[13] = 1) and (CurItem.Name <> '') then
      sProcessUserItemName := ProcessItemName(CurItem.Name)
    else
      sProcessUserItemName := sProcessStdItemName;
    if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
    begin
      if g_ItemRules.Get(CurItem.wIndex, 26) then
      begin
        if TSmartObject(Self).m_boMysteriousMan and g_Config.boShowMysteriousMan then
          sChrName := g_Config.sMysteriousManName
        else
          sChrName := m_sCharName;
        // sUserItemName := Format('物品[%s]从[%s]身上掉落在地图%s(%d,%d)处', [g_sScatterItemName, sChrName, Envir.sMapDesc, m_nCurrX, m_nCurrY]);
        sUserItemName := WideReplaceText(g_sHumDropItemHint, '%Item', sProcessUserItemName);
        sUserItemName := WideReplaceText(sUserItemName, '%DBItem', sProcessStdItemName);
        sUserItemName := WideReplaceText(sUserItemName, '%Name', sChrName);
        sUserItemName := WideReplaceText(sUserItemName, '%Map', m_PEnvir.sMapDesc);
        sUserItemName := WideReplaceText(sUserItemName, '%X', IntToStr(m_nCurrX));
        sUserItemName := WideReplaceText(sUserItemName, '%Y', IntToStr(m_nCurrY));
        if Pos('%showdbitem', LowerCase(sUserItemName)) > 0 then
        begin
          SetSayItem(CurItem);
          sUserItemName := WideReplaceText(sUserItemName, '%ShowDBItem',
            Format('{[%s]/%d}', [sProcessStdItemName, CurItem.MakeIndex]));
        end;
        if Pos('%showitem', LowerCase(sUserItemName)) > 0 then
        begin
          SetSayItem(CurItem);
          sUserItemName := WideReplaceText(sUserItemName, '%ShowItem',
            Format('{[%s]/%d}', [sProcessUserItemName, CurItem.MakeIndex]));
        end;
        UserEngine.SendBroadCastMsg(sUserItemName, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_System, mfDropItem);
      end;
    end
    else if g_ItemRules.Get(CurItem.wIndex, 12) then
    begin
      // 人物或英雄的分身，不要过滤数字，因为名字可能全数字，过滤下没了 chongchong 2015-12-01
      if (Self is TCopyMon) and (Master <> nil) and (Master.m_btRaceServer = RC_PLAYOBJECT) then
        sChrName := m_sCharName
      else
        sChrName := DelNumber(m_sCharName);
      // sUserItemName := Format('物品[%s]从[%s]身上掉落在地图%s(%d,%d)处', [m_sScatterItemName, sChrName, Envir.sMapDesc, m_nCurrX, m_nCurrY]);
      sUserItemName := WideReplaceText(g_sDropItemHint, '%Item', sProcessUserItemName);
      sUserItemName := WideReplaceText(sUserItemName, '%DBItem', sProcessStdItemName);
      sUserItemName := WideReplaceText(sUserItemName, '%Name', sChrName);
      sUserItemName := WideReplaceText(sUserItemName, '%Map', m_PEnvir.sMapDesc);
      sUserItemName := WideReplaceText(sUserItemName, '%X', IntToStr(m_nCurrX));
      sUserItemName := WideReplaceText(sUserItemName, '%Y', IntToStr(m_nCurrY));
      if Pos('%showdbitem', LowerCase(sUserItemName)) > 0 then
      begin
        SetSayItem(CurItem);
        sUserItemName := WideReplaceText(sUserItemName, '%ShowDBItem',
          Format('{[%s]/%d}', [sProcessStdItemName, CurItem.MakeIndex]));
      end;
      if Pos('%showitem', LowerCase(sUserItemName)) > 0 then
      begin
        SetSayItem(CurItem);
        sUserItemName := WideReplaceText(sUserItemName, '%ShowItem',
          Format('{[%s]/%d}', [sProcessUserItemName, CurItem.MakeIndex]));
      end;
      UserEngine.SendBroadCastMsg(sUserItemName, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_System, mfDropItem);
    end;
    if g_ItemRules.Get(CurItem.wIndex, 28) then
    begin
      try
        Player.m_nScriptGotoCount := 0;
        Player.m_sCurrentItemName := ProcessItemName(StdItem.Name);
        if (CurItem.btValue[13] = 1) and (CurItem.Name <> '') then
          Player.m_sCurrentItemNewName := CurItem.Name
        else
          Player.m_sCurrentItemNewName := ProcessItemName(StdItem.Name);
        Player.m_sCurrentOperateUserName := m_sCharName;
        Player.m_UpgradeItem := CurItem;
        Player.m_UpgradeItemIsPegBag := False;
        Player.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
        Player.m_nPickUpOrDropItemMakeIndex := CurItem.MakeIndex;
        g_FunctionNPC.GotoLable(Player, '@M2DropItem', False);
      finally
        Player.m_sCurrentItemName := '';
        Player.m_sCurrentItemNewName := '';
        Player.m_sCurrentOperateUserName := '';
        Player.m_UpgradeItemIsPegBag := False;
      end;
    end;
  end;

var
  IsAddToBag: Boolean;
  KillMeMaster: TPlayObject;
  ToBagObject: TSmartObject;
  ErrCode: Integer;
  OverLapItem: pTUserItem;
  OverLapItemsCount: Integer;
begin
  Result := False;
{$IF NEED_KEY = 1}
  if (g_nKey_UseClientPickItems = 0) then
    Exit;
{$IFEND}
  ErrCode := 0;
  try
    IsAddToBag := False;
    ToBagObject := nil;
    if (not m_PEnvir.m_boNoAutoDropItemToBag) and (not IsDisableDropToBagItem(StdItem.Name)) then // 禁止物品自动入包
    begin
      ErrCode := 301;
      if KillMe.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
      begin
        ErrCode := 302;
        IsAddToBag := TSmartObject(KillMe).m_boSelfAutoDropItemToBag;
        ToBagObject := TSmartObject(KillMe);
      end
      else if (KillMe.m_Master <> nil) and (KillMe.m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
      begin
        ErrCode := 303;
        IsAddToBag := TSmartObject(KillMe.m_Master).m_boSlaveAutoDropItemToBag;
        ToBagObject := TSmartObject(KillMe.m_Master);
      end
      else if (KillMe.Master <> nil) and (KillMe.Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
      begin
        ErrCode := 3031;
        IsAddToBag := TSmartObject(KillMe.Master).m_boSlaveAutoDropItemToBag;
        ToBagObject := TSmartObject(KillMe.Master);
      end;
    end;
    if IsAddToBag and (ToBagObject.m_btRaceServer = RC_HEROOBJECT) and (THeroObject(ToBagObject).m_boAutoDropItemToMasterBag) then
    begin
      ToBagObject := TSmartObject(ToBagObject.Master);
    end;
    ErrCode := 304;
    KillMeMaster := nil;
    if KillMe.m_btRaceServer = RC_PLAYOBJECT then
      KillMeMaster := TPlayObject(KillMe)
    else if (KillMe.Master <> nil) and (KillMe.Master.m_btRaceServer = RC_PLAYOBJECT) then
      KillMeMaster := TPlayObject(KillMe.Master);
    ErrCode := 305;
    if IsAddToBag then
    begin
      ErrCode := 306;
      if (((m_btEnableUseClientPickItems = 0) and (g_Config.boEnablePlayerUseClientPickItems or
        g_Config.boEnableHeroUseClientPickItems or g_Config.boEnablePetUseClientPickItems)) or (m_btEnableUseClientPickItems = 1))
        and (KillMeMaster <> nil) and (KillMeMaster.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        ErrCode := 307;
        if (KillMeMaster.m_ClientPickItems <> nil) and (KillMeMaster.m_ClientPickItems.Count > 0) then
        begin
          if StdItem.Name = '金币' then
            IsAddToBag := KillMeMaster.m_ClientPickItems.CheckCanPickItem(0)
          else
            IsAddToBag := KillMeMaster.m_ClientPickItems.CheckCanPickItem(UserItem.wIndex);
        end
        else
        begin
          IsAddToBag := False;
        end;
        ErrCode := 308;
      end;
      {
        else
        begin
        IsAddToBag := CanPriorityPickUpItem(StdItem.Name) or CanPickUpItem(UserItem.wIndex, StdItem.Name);
        end;
      }
    end;
    ErrCode := 309;
    if IsAddToBag and (ToBagObject <> nil) then
    begin
      ErrCode := 310;
      IsAddToBag := False;
      if CheckOverLapItem(StdItem) then
      begin
        ErrCode := 311;
        OverLapItemsCount := OverLapBagItemCount(ToBagObject, StdItem, OverLapItem);
        if OverLapItemsCount > 0 then
        begin
          ErrCode := 312;
          OverLapItem.Dura := OverLapItem.Dura + 1;
          ErrCode := 313;
          if ToBagObject.m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(ToBagObject).SendUpdateItemDura(-1, OverLapItem.MakeIndex, False, OverLapItem.Dura)
          else
            THeroObject(ToBagObject).SendUpdateItemDura(-1, OverLapItem.MakeIndex, OverLapItem.Dura);
          IsAddToBag := True;
          ProcessDropItem(KillMeMaster, StdItem, OverLapItem);
          ErrCode := 314;
          Dispose(UserItem);
        end
        else if (ToBagObject.IsEnoughBag) then
        begin
          ErrCode := 315;
          ToBagObject.m_ItemList.Add(UserItem);
          ErrCode := 316;
          ProcessDropItem(KillMeMaster, StdItem, UserItem);
          if ToBagObject.m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(ToBagObject).SendAddItem(UserItem)
          else
            THeroObject(ToBagObject).SendAddItem(UserItem);
          IsAddToBag := True;
        end;
      end
      else if (ToBagObject.IsEnoughBag) then
      begin
        ErrCode := 317;
        ToBagObject.m_ItemList.Add(UserItem);
        ProcessDropItem(KillMeMaster, StdItem, UserItem);
        ErrCode := 318;
        if ToBagObject.m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(ToBagObject).SendAddItem(UserItem)
        else
          THeroObject(ToBagObject).SendAddItem(UserItem);
        IsAddToBag := True;
      end;
      ErrCode := 319;
      if IsAddToBag then
      begin
        Result := True;
      end
    end;
  except
    MainOutMessage('[Exception] TBaseObject:DoAutoDropItemToBag ' + m_sCharName + '; Code = ' + IntToStr(ErrCode));
  end;
end;

procedure TBaseObject.ScatterBagItems(ItemOfCreat: TBaseObject; KillMe: TBaseObject);
var
  I, II, DropWide: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  boCanDrop: Boolean;
  MonDrop: pTMonDrop;
  ItemCreateName: string;
  OverLapItem: pTUserItem;
  OverLapItemsCount: Integer;
  IsAddToBag: Boolean;
  ErrCode: Integer;
  IsChange: Boolean;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.ScatterBagItems';
begin
  ErrCode := 0;
  DropWide := g_Config.nScatterItemRange;
  try
    ErrCode := 1;
    ErrCode := 2;
    if (m_PEnvir <> nil) and m_PEnvir.m_boNoDropItem and (m_btRaceServer = RC_PLAYOBJECT) then
      Exit; // 地图禁止死亡掉物品则 piaoyun 2013-07-25
    {
      DropRate := 0;
      if ItemOfCreat <> nil then
      DropRate := ItemOfCreat.m_WAbil.NewValue[11];
      UserEngine.MonGetRandomItems(Self, DropRate);
    }
    ErrCode := 3;
    if m_ItemList <> nil then
    begin
      ErrCode := 4;
      for I := m_ItemList.Count - 1 downto 0 do
      begin
        ErrCode := 5;
        if m_ItemList.Count <= 0 then
          Break;
        UserItem := m_ItemList.Items[I];
        if UserItem = nil then
          Continue;
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem = nil then
          Continue;
        ErrCode := 6;
        if (GetUserItemBindValue(UserItem, ubNoScatter) and UserItem.boIsBind) { or (g_ItemRules.Get(StdItem.Name, 13)) } then
          Continue; // 禁止爆出
        ErrCode := 7;
        boCanDrop := True;
        if g_ItemRules.Get(UserItem.wIndex, 6) then
          boCanDrop := True
        else
        begin
          ErrCode := 8;
          // 防暴几率 chongchong 2015-04-16
          if Random(100) < UserItem.btNewValue[12] then
            Continue;
          ErrCode := 9;
          IsChange := False;
          g_MonDropLimitList.Lock;
          try
            if (g_MonDropLimitList.Count > 0) then
            begin
              ErrCode := 10;
              for II := 0 to g_MonDropLimitList.Count - 1 do
              begin
                ErrCode := 11;
                if (CompareText(StdItem.Name, g_MonDropLimitList.Strings[II]) = 0) then
                begin
                  ErrCode := 12;
                  MonDrop := pTMonDrop(g_MonDropLimitList.Objects[II]);
                  if (MonDrop <> nil) then
                  begin
                    ErrCode := 13;
                    if (MonDrop.nDropCount < MonDrop.nCountLimit) then
                    begin
                      ErrCode := 14;
                      Inc(MonDrop.nDropCount);
                      MonDrop.nNoDropCount := MonDrop.nCountLimit - MonDrop.nDropCount;
                      IsChange := True;
                    end
                    else
                    begin
                      boCanDrop := False;
                    end;
                  end;
                  Break;
                end;
              end;
            end;
          finally
            g_MonDropLimitList.UnLock;
          end;
          ErrCode := 16;
          if IsChange then
          begin
            SaveMonDropLimitList;
          end;
          ErrCode := 16;
          if ItemOfCreat <> nil then
            ItemCreateName := ItemOfCreat.m_sCharName
          else
            ItemCreateName := '?';
          ErrCode := 17;
          if not g_DropLimitMgr.DropItem(m_PEnvir, StdItem.Name, m_sCharName, ItemCreateName, Point(m_nCurrX, m_nCurrY)) then
          begin
            boCanDrop := False;
          end;
        end;
        ErrCode := 18;
        if not boCanDrop then
          Continue;
        ErrCode := 19;
        if StdItem = nil then
          Continue;
        ErrCode := 20;
        if (not(m_btRaceServer in [RC_HEROOBJECT, RC_PLAYOBJECT])) and (UserItem.ItemFrom.ItemForm = ifUnknow) then
        begin
          ErrCode := 21;
          UserItem.ItemFrom.ItemForm := ifMonDrop;
          UserItem.ItemFrom.sMapName := m_PEnvir.sMapDesc;
          UserItem.ItemFrom.sMonName := FilterShowName(m_sCharName);
          UserItem.ItemFrom.DateTime := Now();
          ErrCode := 22;
          if (ItemOfCreat <> nil) then
          begin
            ErrCode := 23;
            if (ItemOfCreat.Master <> nil) then
            begin
              ErrCode := 24;
              if ItemOfCreat.Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
                UserItem.ItemFrom.sMakerName := ItemOfCreat.Master.m_sCharName
              else
                UserItem.ItemFrom.sMakerName := FilterShowName(ItemOfCreat.Master.m_sCharName);
            end
            else
            begin
              ErrCode := 25;
              if ItemOfCreat.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
                UserItem.ItemFrom.sMakerName := ItemOfCreat.m_sCharName
              else
                UserItem.ItemFrom.sMakerName := FilterShowName(ItemOfCreat.m_sCharName);
            end;
          end;
        end;
        ErrCode := 300;
        if (KillMe <> nil) and (not g_ItemRules.Get(UserItem.wIndex, 20)) then // 物品规则：禁止捡起
        begin
          if DoAutoDropItemToBag(KillMe, UserItem, StdItem) then
          begin
            m_ItemList.Delete(I);
            Continue;
          end;
        end;
        ErrCode := 26;
        IsAddToBag := False;
        ErrCode := 27;
        if (ItemOfCreat <> nil) and m_PEnvir.AllowDropToBagItem(UserItem.wIndex) and
          (TBaseObject(ItemOfCreat).m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
        begin
          ErrCode := 28;
          if CheckOverLapItem(StdItem) then
          begin
            ErrCode := 29;
            OverLapItemsCount := OverLapBagItemCount(TBaseObject(ItemOfCreat), StdItem, OverLapItem);
            if OverLapItemsCount > 0 then
            begin
              ErrCode := 30;
              OverLapItem.Dura := OverLapItem.Dura + 1;
              ErrCode := 31;
              if TBaseObject(ItemOfCreat).m_btRaceServer = RC_PLAYOBJECT then
                TPlayObject(ItemOfCreat).SendUpdateItemDura(-1, OverLapItem.MakeIndex, False, OverLapItem.Dura)
              else
                THeroObject(ItemOfCreat).SendUpdateItemDura(-1, OverLapItem.MakeIndex, OverLapItem.Dura);
              IsAddToBag := True;
              ErrCode := 32;
              Dispose(UserItem);
            end
            else if (TBaseObject(ItemOfCreat).IsEnoughBag) then
            begin
              ErrCode := 33;
              TBaseObject(ItemOfCreat).m_ItemList.Add(UserItem);
              ErrCode := 34;
              if TBaseObject(ItemOfCreat).m_btRaceServer = RC_PLAYOBJECT then
                TPlayObject(ItemOfCreat).SendAddItem(UserItem)
              else
                THeroObject(ItemOfCreat).SendAddItem(UserItem);
              IsAddToBag := True;
            end;
          end
          else if (TBaseObject(ItemOfCreat).IsEnoughBag) then
          begin
            ErrCode := 35;
            TBaseObject(ItemOfCreat).m_ItemList.Add(UserItem);
            ErrCode := 36;
            if TBaseObject(ItemOfCreat).m_btRaceServer = RC_PLAYOBJECT then
              TPlayObject(ItemOfCreat).SendAddItem(UserItem)
            else
              THeroObject(ItemOfCreat).SendAddItem(UserItem);
            IsAddToBag := True;
          end;
        end;
        ErrCode := 37;
        if IsAddToBag then
        begin
          m_ItemList.Delete(I);
        end
        else if DropItemDown(UserItem, DropWide, True, ItemOfCreat, Self) then
        begin
          ErrCode := 38;
          m_ItemList.Delete(I);
          Dispose(UserItem);
        end;
      end;
    end;
  except
    MainOutMessage(sExceptionMsg + ' ' + m_sCharName + '; Code = ' + IntToStr(ErrCode));
  end;
end;

procedure TBaseObject.ScatterGolds(GoldOfCreat: TBaseObject);
var
  I, nGold: Integer;
begin
  if m_nGold > 0 then
  begin
    I := 0;
    while (True) do
    begin
      // for i:=0 to 18 do begin
      if m_nGold > g_Config.nMonOneDropGoldCount then
      begin
        nGold := g_Config.nMonOneDropGoldCount;
        m_nGold := m_nGold - g_Config.nMonOneDropGoldCount;
      end
      else
      begin
        nGold := m_nGold;
        m_nGold := 0;
      end;
      if nGold > 0 then
      begin
        if not DropGoldDown(nGold, True, GoldOfCreat, Self) then
        begin
          m_nGold := m_nGold + nGold;
          Break;
        end
        else
        begin
        end;
      end
      else
        Break;
      Inc(I);
      if I >= 17 then
        Break;
    end;
    if m_btRaceServer = RC_PLAYOBJECT then
      TPlayObject(Self).GoldChanged;
  end;
end;

procedure TBaseObject.DropUseItems(BaseObject: TBaseObject);
var
  nC, nRate, nDelCount: Integer;
  StdItem: pTStdItem;
  DelItems: string;
  SmartObject: TSmartObject;
  Castle: TUserCastle;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.DropUseItems';
begin
  DelItems := '';
  nDelCount := 0;
  try
    if m_PEnvir.m_boNoDropItem and (m_btRaceServer = RC_PLAYOBJECT) then
      Exit; // 地图禁止死亡掉物品 piaoyun 2013-07-25
    if ((m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and TSmartObject(Self).m_boNoDropUseItem) or m_PEnvir.m_boNODROPUSEITEMS
    then
      Exit;
    // 攻城区域不掉装备 piaoyun 2013-07-25
    if g_Config.boWarNoDropUseItem and (m_btRaceServer = RC_PLAYOBJECT) then
    begin
      // 检测攻城区域
      Castle := g_CastleManager.InCastleWarArea(Self);
      if (Castle <> nil) and Castle.m_boUnderWar { 攻城 } then
        Exit;
    end;
    if (m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER]) then
    begin
      SmartObject := TSmartObject(Self);
      nC := 0;
      while (True) do
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[nC].wIndex);
        if StdItem <> nil then
        begin
          if StdItem.Reserved and 8 <> 0 then
          begin
            if m_btRaceServer = RC_PLAYOBJECT then
            begin
              if (SmartObject.m_UseItems[nC].btValue[13] = 1) and (SmartObject.m_UseItems[nC].Name <> '') then
                DelItems := DelItems + Format('%s/%d/', [SmartObject.m_UseItems[nC].Name, SmartObject.m_UseItems[nC].MakeIndex])
              else
                DelItems := DelItems + Format('%s/%d/', [StdItem.Name, SmartObject.m_UseItems[nC].MakeIndex]);
              Inc(nDelCount);
            end;
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, SmartObject.m_UseItems[nC].MakeIndex, '0');
            end;
            SmartObject.m_UseItems[nC].wIndex := 0;
            { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
            if m_btRaceServer = RC_PLAYOBJECT then
              TPlayObject(Self).ProcessUseItemSkill(nC, StdItem, False);
          end;
        end;
        Inc(nC);
        if nC >= 9 then
          Break;
      end;
    end;
    nRate := 30;
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      if TSmartObject(Self).PKLevel > 2 then
        nRate := 15;
      if (m_CurrTarget <> nil) and (m_CurrTarget.m_WAbil.NewValue[6] > 0) then
      begin // 增加爆率
        nRate := Max(nRate - nRate * m_CurrTarget.m_WAbil.NewValue[6] div 100, 0);
      end;
    end;
    if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    begin
      nC := 0;
      SmartObject := TSmartObject(Self);
      while (True) do
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[nC].wIndex);
        if StdItem <> nil then
        begin
          if ((not SmartObject.m_UseItems[nC].boIsBind) //
            or (not GetUserItemBindValue(@SmartObject.m_UseItems[nC], ubNoScatter))) //
            and (Random(100) >= SmartObject.m_UseItems[nC].btNewValue[12]) then
          begin // 禁止爆出
            if (Random(nRate) = 0) or g_ItemRules.Get(SmartObject.m_UseItems[nC].wIndex, 6) then
            begin
              if DropItemDown(@SmartObject.m_UseItems[nC], 2, True, BaseObject, Self) then
              begin
                if StdItem.Reserved and 10 = 0 then { 这里会有问题，Reserved=10的物品掉落后，身上的没有删，会产生复制 }
                begin
                  if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
                  begin
                    if (SmartObject.m_UseItems[nC].btValue[13] = 1) and (SmartObject.m_UseItems[nC].Name <> '') then
                      DelItems := DelItems + Format('%s/%d/', [SmartObject.m_UseItems[nC].Name,
                        SmartObject.m_UseItems[nC].MakeIndex])
                    else
                      DelItems := DelItems + Format('%s/%d/', [StdItem.Name, SmartObject.m_UseItems[nC].MakeIndex]);
                    Inc(nDelCount);
                  end;

                  SmartObject.m_UseItems[nC].wIndex := 0;
                  { -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
                  if m_btRaceServer = RC_PLAYOBJECT then
                    TPlayObject(Self).ProcessUseItemSkill(nC, StdItem, False);
                end;
              end;
            end;
          end;
        end;

        Inc(nC);
        if nC >= 9 then
          Break;
      end;

      if DelItems <> '' then
        SendMsg(Self, RM_SENDDELITEMLIST, 0, nDelCount, 0, 0, DelItems);
    end;
  except
    MainOutMessage(sExceptionMsg);
  end;
end;

