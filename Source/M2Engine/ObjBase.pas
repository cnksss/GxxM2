procedure TBaseObject.SendUpdateDelayMsg(BaseObject: TBaseObject; wIdent: Integer; wParam, lParam1, lParam2, lParam3: NativeInt;
  sMsg: AnsiString; dwDelay: LongWord);
var
  SendMessage: pTSendMessage;
  I: Integer;
begin
{$IF LockProcessMsg = 1}
  try
    EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
    I := 0;
    while (True) do
    begin
      if m_MsgList.Count <= I then
        Break;
      SendMessage := m_MsgList.Items[I];
      if (SendMessage.wIdent = wIdent) and (SendMessage.nParam1 = lParam1) then
      begin
        m_MsgList.Delete(I);
        if (SendMessage.Buff <> nil) and (SendMessage.BuffLen > 0) then
          FreeMem(SendMessage.Buff, SendMessage.BuffLen);
        // Dispose(SendMessage);
        FreeMem(SendMessage, SizeOf(TSendMessage));
        Continue;
      end;
      Inc(I);
    end;
{$IF LockProcessMsg = 1}
  finally
    LeaveCriticalSection(ProcessMsgCriticalSection);
  end;
{$IFEND}
  SendDelayMsg(BaseObject, wIdent, wParam, lParam1, lParam2, lParam3, sMsg, dwDelay);
end;

procedure TBaseObject.SendUpdateMsgA(BaseObject: TBaseObject; wIdent: Integer; wParam, lParam1, lParam2, lParam3: NativeInt;
  sMsg: AnsiString);
var
  SendMessage: pTSendMessage;
  I: Integer;
  boLateDelivery: Boolean;
  dwDeliveryTime: LongWord;
  nMaxDeliveryTime: Integer;
begin
  boLateDelivery := False;
  dwDeliveryTime := 0;
  nMaxDeliveryTime := 0;
{$IF LockProcessMsg = 1}
  try
    EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
    I := 0;
    while (True) do
    begin
      if m_MsgList.Count <= I then
        Break;
      SendMessage := m_MsgList.Items[I];
      if SendMessage.wIdent = wIdent then
      begin
        if SendMessage.boLateDelivery then
        begin
          boLateDelivery := True;
          dwDeliveryTime := Max(MyGetTickCount - SendMessage.dwDeliveryTime, dwDeliveryTime);
        end;
        m_MsgList.Delete(I);
        if (SendMessage.Buff <> nil) and (SendMessage.BuffLen > 0) then
          FreeMem(SendMessage.Buff, SendMessage.BuffLen);
        // Dispose(SendMessage);
        FreeMem(SendMessage, SizeOf(TSendMessage));
        Continue;
      end;
      Inc(I);
    end;
{$IF LockProcessMsg = 1}
  finally
    LeaveCriticalSection(ProcessMsgCriticalSection);
  end;
{$IFEND}
  if boLateDelivery then
  begin
    case wIdent of
      CM_SPELL:
        nMaxDeliveryTime := g_Config.nMaxMagicHitDeliveryTime;
      CM_HORSERUN, CM_RUN:
        nMaxDeliveryTime := g_Config.nMaxRunDeliveryTime;
      CM_TURN:
        nMaxDeliveryTime := g_Config.nMaxTurnDeliveryTime;
      CM_WALK:
        nMaxDeliveryTime := g_Config.nMaxWalkDeliveryTime;
      CM_SITDOWN:
        nMaxDeliveryTime := g_Config.nMaxDigUpDeliveryTime;
      CM_HIT, CM_HEAVYHIT, CM_BIGHIT, CM_POWERHIT, CM_LONGHIT, CM_CRSHIT, CM_TWNHIT, CM_WIDEHIT, CM_FIREHIT, CM_43HIT, CM_66HIT,
        CM_66HIT1, CM_SWORDHIT,
      // 逐日剑法  ID=56
      CM_101HIT, // 三绝杀
      CM_102HIT, // 断岳斩
      CM_103HIT, CM_113HIT, CM_115HIT, CM_CUSTOM_HIT001 .. (CM_CUSTOM_HIT001 + CUSTOM_MAGIC_COUNT - 1):
        nMaxDeliveryTime := g_Config.nMaxHitDeliveryTime; // 横扫千军
    end;
    dwDeliveryTime := Min(dwDeliveryTime, nMaxDeliveryTime);
    SendDelayMsg(BaseObject, wIdent, wParam, lParam1, lParam2, lParam3, sMsg, dwDeliveryTime);
  end
  else
    SendMsg(BaseObject, wIdent, wParam, lParam1, lParam2, lParam3, sMsg);
end;

