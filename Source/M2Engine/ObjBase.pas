procedure TBaseObject.CheckPKStatus;
begin
  if m_boPKFlag and ((MyGetTickCount - m_dwPKTick) > g_Config.dwPKFlagTime { 60 * 1000 } ) then
  begin
    m_boPKFlag := False;
    RefNameColor();
  end;
end;

procedure TBaseObject.ZeroArmor(nTime: Integer); // 0防御 0魔法防御
begin
  m_boZeroArmor := True;
  m_dwZeroArmorTick := MyGetTickCount() + nTime * 1000; // 0防御 0魔法防御
  RecalcAbilitys;
  SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
  SysMsg('防御力、魔法防御力减到0，并且效果持续' + IntToStr(nTime) + '秒', c_Red, t_Hint);
end;

procedure TBaseObject.DamageSpell(nSpellPoint: Integer);
begin
  if nSpellPoint > 0 then
  begin
    if (m_WAbil.MP - nSpellPoint) > 0 then
      Dec(m_WAbil.MP, nSpellPoint)
    else
      m_WAbil.MP := 0;
  end
  else
  begin
    if (m_WAbil.MP - nSpellPoint) < m_WAbil.MaxMP then
      Dec(m_WAbil.MP, nSpellPoint)
    else
      m_WAbil.MP := m_WAbil.MaxMP;
  end;
end;

procedure TSmartObject.DecPKPoint(nPoint: Integer);
var
  nC: Integer;
begin
  nC := PKLevel();
  Dec(m_nPkPoint, nPoint);
  if m_nPkPoint < 0 then
    m_nPkPoint := 0;
  if (PKLevel <> nC) and (nC > 0) and (nC <= 2) then
  begin
    RefNameColor();
  end;
end;

procedure TSmartObject.DelItemSkill(nIndex: Integer; IsMagicID: Boolean);
  procedure DeleteSkillByName(sSkillName: string);
  var
    I: Integer;
    UserMagic: pTUserMagic;
    PlayObject: TPlayObject;
  begin
    for I := 0 to m_MagicList.Count - 1 do
    begin
      UserMagic := m_MagicList.Items[I];
      if (UserMagic.MagicInfo <> nil) and SameText(UserMagic.MagicInfo.sMagicName, sSkillName) then
      begin
        if UserMagic.boUsesItemAdd then
        begin
          PlayObject := TPlayObject(Self);
          PlayObject.SendDelMagic(UserMagic);
          Dispose(UserMagic);
          m_MagicList.Delete(I);
        end;
        Break;
      end;
    end;
  end;
  procedure DeleteSkillByID(nSkillID: Integer);
  var
    I: Integer;
    UserMagic: pTUserMagic;
    PlayObject: TPlayObject;
  begin
    for I := 0 to m_MagicList.Count - 1 do
    begin
      UserMagic := m_MagicList.Items[I];
      if (UserMagic.MagicInfo <> nil) and (UserMagic.MagicInfo.wMagicID = nSkillID) then
      begin
        if UserMagic.boUsesItemAdd then
        begin
          PlayObject := TPlayObject(Self);
          PlayObject.SendDelMagic(UserMagic);
          Dispose(UserMagic);
          m_MagicList.Delete(I);
        end;
        Break;
      end;
    end;
  end;

begin
  if m_btRaceServer <> RC_PLAYOBJECT then
    Exit;
  if not IsMagicID then
  begin
    case nIndex of
      1: { if m_btJob <> 1 then }
        DeleteSkillByName(g_Config.sFireBallSkill); // 火球术
      2: { if m_btJob <> 2 then }
        DeleteSkillByName(g_Config.sHealSkill); // 治愈术
      // 流星戒指 + 流星火雨技能 -- piaoyun 2013-06-28
      3: { if m_btJob <> 1 then }
        DeleteSkillByName(g_Config.sStarSkill); // 流星火雨
      4:
        DeleteSkillByName(g_Config.sSkill41Skill); // 倚天辟地
    end;
  end
  else
  begin
    DeleteSkillByID(nIndex); // 火球术
  end;
end;

// 攻击时减武器持久 （减持久）
procedure TSmartObject.DoDamageWeapon(nWeaponDamage: Integer);
var
  nDura, nDuraPoint, nDamageDura: Integer;
  PlayObject: TPlayObject;
  StdItem: pTStdItem;
begin
  if m_UseItems[U_WEAPON].wIndex <= 0 then
    Exit;
  if m_UseItems[U_WEAPON].Dura <= 0 then
  begin
    if g_Config.boDeleteItemDuraZero then
    begin
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        PlayObject := TPlayObject(Self);
        PlayObject.SendDelItem(@m_UseItems[U_WEAPON]);
      end
      else if m_btRaceServer = RC_HEROOBJECT then
      begin
        THeroObject(Self).SendDelItem(@m_UseItems[U_WEAPON]);
      end;
      { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
      // m_UseItems[U_WEAPON].wIndex := 0;
      StdItem := UserEngine.GetStdItem(m_UseItems[U_WEAPON].wIndex);
      if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
      begin
        AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[U_WEAPON].MakeIndex, '0', 0, 0, '持久为0');
      end;
      m_UseItems[U_WEAPON].wIndex := 0;
      if (m_btRaceServer = RC_PLAYOBJECT) and (StdItem <> nil) then
        TPlayObject(Self).ProcessUseItemSkill(U_WEAPON, StdItem, False);
      RecalcAbilitys;
      if (m_btRaceServer in [RC_HEROOBJECT, RC_PLAYOBJECT]) then
      begin
        SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
        SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
      end;
      FeatureChanged(); // 刷新外观
      Exit;
    end
    else
    begin
      Exit;
    end;
  end;
  nDura := m_UseItems[U_WEAPON].Dura;
  nDuraPoint := Round(nDura / 1.03);
  nDamageDura := Round(nWeaponDamage * (g_Config.nDamageItemDuraRate / 100));
  // utputDebugString(PChar(IntToStr(nDura) + '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~' + IntToStr(nDamageDura)));
  Dec(nDura, nDamageDura);
  if nDura <= 0 then
  begin
    nDura := 0;
    m_UseItems[U_WEAPON].Dura := nDura;
    StdItem := UserEngine.GetStdItem(m_UseItems[U_WEAPON].wIndex);
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
      begin
        // 注释日志 chongchong 2017-10-09
        // 减持久
      end;
    end;
    if g_Config.boDeleteItemDuraZero then
    begin
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        PlayObject := TPlayObject(Self);
        if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
        begin
          AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[U_WEAPON].MakeIndex, '0', 0,
            0, '0持久消失');
        end;
        PlayObject.SendDelItem(@m_UseItems[U_WEAPON]);
      end
      else if m_btRaceServer = RC_HEROOBJECT then
      begin
        if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
        begin
          AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[U_WEAPON].MakeIndex, '0', 0,
            0, '0持久消失');
        end;
        THeroObject(Self).SendDelItem(@m_UseItems[U_WEAPON]);
      end;
      { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
      // m_UseItems[U_WEAPON].wIndex := 0;
      StdItem := UserEngine.GetStdItem(m_UseItems[U_WEAPON].wIndex);
      if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
      begin
        AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[U_WEAPON].MakeIndex, '0', 0, 0, '持久为0');
      end;
      m_UseItems[U_WEAPON].wIndex := 0;
      if (m_btRaceServer = RC_PLAYOBJECT) and (StdItem <> nil) then
        TPlayObject(Self).ProcessUseItemSkill(U_WEAPON, StdItem, False);
    end;
    RecalcAbilitys;
    if (m_btRaceServer in [RC_HEROOBJECT, RC_PLAYOBJECT]) and (not g_Config.boDeleteItemDuraZero) then
    begin
      SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
      SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
    end;
    FeatureChanged();
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      if g_FunctionNPC <> nil then
      begin
        TPlayObject(Self).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(Self), '@ItemDamage' + IntToStr(U_WEAPON), False);
      end;
    end;
    // SendMsg(Self, RM_DURACHANGE, U_WEAPON, nDura, m_UseItems[U_WEAPON].DuraMax, 0, '');
  end
  else
  begin // 004C199D
    m_UseItems[U_WEAPON].Dura := nDura;
  end;
  if (nDura / 1.03) <> nDuraPoint then
  begin
    SendMsg(Self, RM_DURACHANGE, U_WEAPON, m_UseItems[U_WEAPON].Dura, m_UseItems[U_WEAPON].DuraMax, 0, '');
  end;
end;

procedure TSmartObject.GetAccessory(Item: TUserItem; var AddAbility: TAddAbility; var AllAddAbility: TAddAbility);
var
  StdItem: pTStdItem;
  StdItemA: TStdItem;
  nMaxAC: Integer;
  Int64Value: Int64;
  I: Integer;
  CustomProperty: PCustomProperty;
begin
  StdItem := UserEngine.GetStdItem(Item.wIndex);
  if StdItem = nil then
    Exit;
  StdItemA := StdItem^;
  ItemUnit.GetItemAddValue(@Item, StdItemA);
  if g_Config.btMaxAC = 0 then
    nMaxAC := High(Word)
  else
    nMaxAC := High(Integer);
  case StdItem.Need of // 内功恢复
    18 .. 21:
      begin
        Int64Value := Int64(AddAbility.wNPRecoverTime) + Min(High(Word), StdItem.Stock);
        AddAbility.wNPRecoverTime := Min(High(Word), Int64Value);
      end;
    22 .. 25:
      begin
        Int64Value := Int64(AddAbility.wNPRecoverPoint) + Min(High(Word), StdItem.Stock);
        AddAbility.wNPRecoverPoint := Min(High(Word), Int64Value);
      end;
  end;
  case StdItem.StdMode of
    5, 6, 68, 69: // 时装武器 chongchong 2013-10-26
      begin
        Int64Value := Int64(AddAbility.wHitPoint) + StdItemA.AC2;
        AddAbility.wHitPoint := Min(Int64Value, High(Word));
        // 英雄武器不计算攻击速度 chongchong 2014-09-16
        if (m_btRaceServer <> RC_HEROOBJECT) or ((m_btRaceServer = RC_HEROOBJECT) and g_Config.boHeroCalcWeaponSpeed) then
        begin
          if StdItemA.MAC2 > 10 then
          begin
            Int64Value := Int64(AddAbility.nHitSpeed) + StdItemA.MAC2 - 10;
            AddAbility.nHitSpeed := Min(Int64Value, High(Integer));
          end
          else
          begin
            Dec(AddAbility.nHitSpeed, StdItemA.MAC2);
          end;
        end;
        Int64Value := Int64(AddAbility.btLuck) + StdItemA.AC1;
        AddAbility.btLuck := Min(Int64Value, High(Byte));
        Int64Value := Int64(AddAbility.btUnLuck) + StdItemA.MAC1;
        AddAbility.btUnLuck := Min(Int64Value, High(Byte));
      end;
    19, 70, 75:
      begin // //项链+幸运
        Int64Value := Int64(AddAbility.wAntiMagic) + StdItemA.AC2;
        AddAbility.wAntiMagic := Min(Int64Value, High(Word));
        Int64Value := Int64(AddAbility.btUnLuck) + StdItemA.MAC1;
        AddAbility.btUnLuck := Min(Int64Value, High(Byte));
        Int64Value := Int64(AddAbility.btLuck) + StdItemA.MAC2;
        AddAbility.btLuck := Min(Int64Value, High(Byte));
        // Int64Value := Int64(AddAbility.wNPRecoverTime) + Min(High(Word), StdItem.Price);
        // AddAbility.wNPRecoverTime := Min(High(Word), Int64Value);
      end;
    53, 88:
      begin // 新加物品属性
        if not g_Config.boAddUserItemNewValue then
        begin
          Int64Value := Int64(AddAbility.wAntiMagic) + StdItemA.AC2;
          AddAbility.wAntiMagic := Min(High(Word), Int64Value);
          Int64Value := Int64(AddAbility.btUnLuck) + StdItemA.MAC1;
          AddAbility.btUnLuck := Min(Int64Value, High(Byte));
          Int64Value := Int64(AddAbility.btLuck) + StdItemA.MAC2;
          AddAbility.btLuck := Min(Int64Value, High(Byte));
        end
        else
        begin
          Int64Value := Int64(AddAbility.nAC1) + StdItemA.AC1;
          AddAbility.nAC1 := Min(nMaxAC, Int64Value);
          Int64Value := Int64(AddAbility.nAC2) + StdItemA.AC2;
