    // if (wMagicID = 27) {and (m_Master <> nil)} and (m_TargetCret <> nil) and AllowUseMagic(27) and (m_TargetCret.m_Abil.Level < m_Abil.Level) { and (GetPoseCreate = m_TargetCret)} and (MyGetTickCount - m_SkillUseTick[27] > 1000 * 10) then
