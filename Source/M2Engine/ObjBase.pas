  procedure Skill101Attack(nSecPwr, nLevel: Integer); // 三绝杀
  var
    nPower: Integer;
  begin
    nPower := Min(LongWord(Round(nSecPwr * (g_Config.SkillContinuousPowerRates[1] / 100))), High(Integer));
    nPower := Min(LongWord(nPower + Round(nPower * (nLevel * g_Config.nContinuousAttackLevelRate / 100))), High(Integer));
    if AttackTarget <> nil then
    begin
      nPower := GetMagicPercentPower(101, nPower, AttackTarget);
      nPower := GetSkillContinuousBlastHitPower(Self, AttackTarget, m_UserMagics[101], nPower); // 暴击
      if Random(100) < g_Config.SkillContinuousCloseDefenseRates[1] then
        nPower := AttackTarget.GetHitStruckDamage(Self, nPower, nil);
      DirectAttack(AttackTarget, nPower, 101);
      // 战技连击锁定 chongchong 2013-11-11
      if Random(100) < g_Config.btWarrContinuousStatusLocks[1] then
      begin
        AttackTarget.OpenContinuousMagicLock(g_Config.nWarrContinuousStatusLockTimes[1]);
        // AttackTarget.MakePosion(POISON_STONE, 2, 0);
      end;
    end;
  end;
