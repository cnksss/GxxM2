procedure TBaseObject.MonsterRecalcAbilitys;
var
  n8, nL: Integer;
  GamePetConfig: PTGamePetConfig;
  MonInfo: pTMonInfo;
  Int64Value: Int64;
begin
  // 下面这两句话在RecalcAbilitys()中已有处理无需再次处理，同时也防止了人形怪属性错乱的问题 By 一支笔 at:2021-07-15 10:39:41
  // m_WAbil.DC1 := m_Abil.DC1;
  // m_WAbil.DC2 := m_Abil.DC2;
  UserEngine.MonRecalcASubAbilitys(Self, m_sCharName);
  n8 := 0;
  if (m_btRaceServer = 100) //
    or (m_btRaceServer = 113) //
    or (m_btRaceServer = 114) //
    or (m_btRaceServer = 140) // 圣兽
    or (m_btRaceServer = 141) // 圣兽
    or (m_btRaceServer = 142) // 圣兽
    or (m_btRaceServer = 143) then
  begin
    if not g_Config.boSlaveLevelupUseNewAttr then
    begin
      m_WAbil.DC1 := m_WAbil.DC1;
      m_WAbil.DC2 := Round((m_btSlaveExpLevel * 0.1 + 0.3) * 3.0 * m_btSlaveExpLevel + m_WAbil.DC2);
      n8 := n8 + Round((m_btSlaveExpLevel * { 1.0e-1 } 0.1 + { 3.0000000000000000001e-1 } 0.3) * m_Abil.MaxHP) *
        m_btSlaveExpLevel;
      n8 := n8 + m_Abil.MaxHP;
      if m_btSlaveExpLevel > 0 then
        m_WAbil.MaxHP := n8
      else
        m_WAbil.MaxHP := m_Abil.MaxHP;

      if m_boChangeAbility then
      begin
        if m_ChangeAbility.MaxHP > 0 then
        begin
          Int64Value := m_ChangeAbility.MaxHP + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * 60;
          m_WAbil.MaxHP := Min(High(LongWord), Int64Value);
        end;

        if m_ChangeAbility.DC1 > 0 then
          m_WAbil.DC1 := m_ChangeAbility.DC1;
        if m_ChangeAbility.DC2 > 0 then
          m_WAbil.DC2 := m_ChangeAbility.DC2;
        if m_ChangeAbility.AC1 > 0 then
          m_WAbil.AC1 := m_ChangeAbility.AC1;
        if m_ChangeAbility.AC2 > 0 then
          m_WAbil.AC2 := m_ChangeAbility.AC2;
        if m_ChangeAbility.MAC1 > 0 then
          m_WAbil.MAC1 := m_ChangeAbility.MAC1;
        if m_ChangeAbility.MAC2 > 0 then
          m_WAbil.MAC2 := m_ChangeAbility.MAC2;
        if m_ChangeAbility.WalkSpeed > 0 then
          m_nWalkSpeed := m_ChangeAbility.WalkSpeed;
        if m_ChangeAbility.NextHitTime > 0 then
          m_nNextHitTime := m_ChangeAbility.NextHitTime;
      end;
    end
    else
    begin
      if g_Config.boSlaveLevelupAddLowerAttr then
      begin
        if m_boChangeAbility and (m_ChangeAbility.DC1 > 0) then
        begin
          Int64Value := m_ChangeAbility.DC1 + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * g_Config.nSlave9DC;
          m_WAbil.DC1 := Min(High(LongWord), Int64Value);
