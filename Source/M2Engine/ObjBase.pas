          m_WAbil.AC2 := m_ChangeAbility.AC2;
        if m_ChangeAbility.MAC1 > 0 then
          m_WAbil.MAC1 := m_ChangeAbility.MAC1;
        if m_ChangeAbility.MAC2 > 0 then
          m_WAbil.MAC2 := m_ChangeAbility.MAC2;
        if m_ChangeAbility.WalkSpeed > 0 then
          m_nWalkSpeed := m_ChangeAbility.WalkSpeed;
        if m_ChangeAbility.NextHitTime > 0 then
          m_nNextHitTime := m_ChangeAbility.NextHitTime;
      end;
    end
    else
    begin
      m_WAbil.DC1 := m_WAbil.DC1;
      if g_Config.boSlaveLevelupAddLowerAttr then
      begin
        if m_boChangeAbility and (m_ChangeAbility.DC1 > 0) then
        begin
          Int64Value := m_ChangeAbility.DC1 + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * g_Config.nSlave9DC;
          m_WAbil.DC1 := Min(High(LongWord), Int64Value);
        end
        else
        begin
          Int64Value := m_WAbil.DC1 + m_btSlaveExpLevel * g_Config.nSlave9DC;
          m_WAbil.DC1 := Min(High(Integer), Int64Value);
        end;

        if m_boChangeAbility and (m_ChangeAbility.AC1 > 0) then
        begin
          Int64Value := m_ChangeAbility.AC1 + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * g_Config.nSlave9AC;
          m_WAbil.AC1 := Min(High(LongWord), Int64Value);
        end
        else
        begin
          Int64Value := m_WAbil.AC1 + m_btSlaveExpLevel * g_Config.nSlave9AC; // 这里的m_Abil改为m_WAbil
          m_WAbil.AC1 := Min(High(Integer), Int64Value);
        end;

        if m_boChangeAbility and (m_ChangeAbility.MAC1 > 0) then
        begin
          Int64Value := m_ChangeAbility.MAC1 + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * g_Config.nSlave9MAC;
          m_WAbil.MAC1 := Min(High(LongWord), Int64Value);
        end
        else
        begin
          Int64Value := m_WAbil.MAC1 + m_btSlaveExpLevel * g_Config.nSlave9MAC; // 这里的m_Abil改为m_WAbil
          m_WAbil.MAC1 := Min(High(Integer), Int64Value);
        end;
      end
      else if m_boChangeAbility then
      begin
        if m_ChangeAbility.AC1 > 0 then
          m_WAbil.AC1 := m_ChangeAbility.AC1;
        if m_ChangeAbility.MAC1 > 0 then
          m_WAbil.MAC1 := m_ChangeAbility.MAC1;
        if m_ChangeAbility.DC1 > 0 then
          m_WAbil.DC1 := m_ChangeAbility.DC1;
      end;

      if m_boChangeAbility and (m_ChangeAbility.DC2 > 0) then
      begin
        Int64Value := m_ChangeAbility.DC2 + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * g_Config.nSlave9DC;
        m_WAbil.DC2 := Min(High(LongWord), Int64Value);
      end
      else
      begin
        Int64Value := m_WAbil.DC2 + m_btSlaveExpLevel * g_Config.nSlave9DC;
        m_WAbil.DC2 := Min(High(Integer), Int64Value);
      end;

      if m_boChangeAbility and (m_ChangeAbility.MaxHP > 0) then
      begin
        Int64Value := m_ChangeAbility.MaxHP + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * g_Config.nSlave9HP;
        m_WAbil.MaxHP := Min(High(LongWord), Int64Value);
      end
      else
      begin
        Int64Value := m_WAbil.MaxHP + m_btSlaveExpLevel * g_Config.nSlave9HP; // 这里的m_Abil改为m_WAbil
        m_WAbil.MaxHP := Min(High(LongWord), Int64Value);
      end;

      if m_boChangeAbility and (m_ChangeAbility.AC2 > 0) then
      begin
        Int64Value := m_ChangeAbility.AC2 + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * g_Config.nSlave9AC;
        m_WAbil.AC2 := Min(High(LongWord), Int64Value);
      end
      else
      begin
        Int64Value := m_WAbil.AC2 + m_btSlaveExpLevel * g_Config.nSlave9AC; // 这里的m_Abil改为m_WAbil
        m_WAbil.AC2 := Min(High(Integer), Int64Value);
      end;

      if m_boChangeAbility and (m_ChangeAbility.MAC2 > 0) then
      begin
        Int64Value := m_ChangeAbility.MAC2 + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * g_Config.nSlave9MAC;
        m_WAbil.MAC2 := Min(High(LongWord), Int64Value);
      end
      else
      begin
        Int64Value := m_WAbil.MAC2 + m_btSlaveExpLevel * g_Config.nSlave9MAC; // 这里的m_Abil改为m_WAbil
        m_WAbil.MAC2 := Min(High(Integer), Int64Value);
      end;

      if m_boChangeAbility and (m_ChangeAbility.WalkSpeed > 0) then
      begin
        Int64Value := m_ChangeAbility.WalkSpeed + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) * g_Config.nSlave9MoveSpeed;
        m_nWalkSpeed := Min(High(LongWord), Int64Value);
      end
      else
        m_nWalkSpeed := Max(10, m_nInitWalkSpeed - m_btSlaveExpLevel * g_Config.nSlave9MoveSpeed);

      if m_boChangeAbility and (m_ChangeAbility.NextHitTime > 0) then
      begin
        Int64Value := m_ChangeAbility.NextHitTime + (m_btSlaveExpLevel - m_ChangeAbility.SlaveExpLevel) *
          g_Config.nSlave9HitSpeed;
        m_nNextHitTime := Min(High(LongWord), Int64Value);
      end
      else
        m_nNextHitTime := Max(100, m_nInitNextHitTime - m_btSlaveExpLevel * g_Config.nSlave9HitSpeed);
    end;

    if m_boChangeAbility then
    begin
      if m_ChangeAbility.MC1 > 0 then
        m_WAbil.MC1 := m_ChangeAbility.MC1;
      if m_ChangeAbility.MC2 > 0 then
        m_WAbil.MC2 := m_ChangeAbility.MC2;
      if m_ChangeAbility.SC1 > 0 then
        m_WAbil.SC1 := m_ChangeAbility.SC1;
      if m_ChangeAbility.SC2 > 0 then
        m_WAbil.SC2 := m_ChangeAbility.SC2;
      if m_boChangeAbilitySetHMP and (m_ChangeAbility.HP > 0) then
        m_WAbil.HP := m_ChangeAbility.HP;
      if m_ChangeAbility.MP > 0 then
        m_WAbil.MP := m_ChangeAbility.MP;
    end;
  end;
end;

procedure TBaseObject.SendFirstMsg(BaseObject: TBaseObject; wIdent: Integer; wParam, lParam1, lParam2, lParam3: NativeInt;
  sMsg: AnsiString);
var
  SendMessage: pTSendMessage;
begin
{$IF LockProcessMsg = 1}
  try
    EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
    if not m_boGhost then
    begin
      New(SendMessage);
      SendMessage.wIdent := wIdent;
      SendMessage.wParam := wParam;
      SendMessage.nParam1 := lParam1;
      SendMessage.nParam2 := lParam2;
      SendMessage.nParam3 := lParam3;
      SendMessage.dwDeliveryTime := 0;
      SendMessage.BaseObject := BaseObject;
      SendMessage.dwTimeTick := MyGetTickCount;
      if sMsg <> '' then
      begin
        try
          SendMessage.BuffLen := Length(sMsg);
          GetMem(SendMessage.Buff, SendMessage.BuffLen);
          // 修复 FreeMem(SendMessage.Buff) 报错 chongchong 2014-10-22
          // Move(sMsg[1], SendMessage.Buff^, Length(sMsg) + 1);
          Move(sMsg[1], SendMessage.Buff^, Length(sMsg));
        except
          SendMessage.Buff := nil;
        end;
      end
      else
      begin
        SendMessage.Buff := nil;
      end;
      m_MsgList.Insert(0, SendMessage);
    end;
{$IF LockProcessMsg = 1}
  finally
    LeaveCriticalSection(ProcessMsgCriticalSection);
  end;
{$IFEND}
end;

function TBaseObject.QueryMsg(wIdent: Integer): Boolean;
var
  SendMessage: pTSendMessage;
  I: Integer;
begin
  Result := False;
{$IF LockProcessMsg = 1}
  try
    EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
    for I := m_MsgList.Count - 1 downto 0 do
    begin
      SendMessage := m_MsgList.Items[I];
      if (SendMessage.wIdent = wIdent) then
      begin
        Result := True;
        Break
      end;
    end;
{$IF LockProcessMsg = 1}
  finally
    LeaveCriticalSection(ProcessMsgCriticalSection);
  end;
{$IFEND}
end;

procedure TBaseObject.DeleteMsg(wIdent: Integer);
var
  SendMessage: pTSendMessage;
  I: Integer;
begin
{$IF LockProcessMsg = 1}
  try
    EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
    for I := m_MsgList.Count - 1 downto 0 do
    begin
      SendMessage := m_MsgList.Items[I];
      if (SendMessage.wIdent = wIdent) then
      begin
        m_MsgList.Delete(I);
        if (SendMessage.Buff <> nil) and (SendMessage.BuffLen > 0) then
          FreeMem(SendMessage.Buff, SendMessage.BuffLen);
        // Dispose(SendMessage);
        FreeMem(SendMessage, SizeOf(TSendMessage));
        Continue;
      end;
    end;
{$IF LockProcessMsg = 1}
  finally
    LeaveCriticalSection(ProcessMsgCriticalSection);
  end;
{$IFEND}
end;

procedure TBaseObject.SendMsg(BaseObject: TBaseObject; wIdent: Integer; wParam, nParam1, nParam2, nParam3: NativeInt;
  sMsg: AnsiString); // 004B865C
var
  SendMessage: pTSendMessage;
  boSend: Boolean;
begin
  boSend := (not m_boOffLine) and (not m_boDummyObject);
  if not boSend then
  begin
    case wIdent of
      RM_MAGSTRUCK, RM_MAGSTRUCK_MINE, RM_DELAYPUSHED, RM_10155, RM_POISON, RM_TRANSPARENT, RM_DOOPENHEALTH, RM_MAGHEALING,
        RM_DELAYMAGIC,
      // RM_SENDREGINFO,
      RM_SENDDELITEMLIST, RM_10101, RM_STRUCK, RM_STRUCK_MAG, RM_10101_EX, RM_10101_2, RM_10101_EX_2, RM_DELAYMAGIC_EX,
        RM_MAGSTRUCK_EX, RM_GROUPITEMON, // 修改假人不触发@GroupItemOn 2019-09-29 19:49:17
      RM_GROUPITEMOFF:
        begin
          boSend := True;
        end;
    end;
  end;
  if boSend then
  begin
{$IF LockProcessMsg = 1}
    try
      EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
      if not m_boGhost then
      begin
        // New(SendMessage);
        GetMem(SendMessage, SizeOf(TSendMessage));
        SendMessage.wIdent := wIdent;
        SendMessage.wParam := wParam;
        SendMessage.nParam1 := nParam1;
        SendMessage.nParam2 := nParam2;
        SendMessage.nParam3 := nParam3;
        SendMessage.dwDeliveryTime := 0;
        SendMessage.dwTimeTick := MyGetTickCount;
        SendMessage.BaseObject := BaseObject;
        SendMessage.boLateDelivery := False;
        SendMessage.Buff := nil;
        if sMsg <> '' then
        begin
          try
            SendMessage.BuffLen := Length(sMsg);
            GetMem(SendMessage.Buff, SendMessage.BuffLen);
            // 修复 FreeMem(SendMessage.Buff) 报错 chongchong 2014-10-22
            // Move(sMsg[1], SendMessage.Buff^, Length(sMsg) + 1);
            Move(sMsg[1], SendMessage.Buff^, Length(sMsg));
          except
            SendMessage.Buff := nil;
          end;
        end;
        m_MsgList.Add(SendMessage);
      end;
{$IF LockProcessMsg = 1}
    finally
      LeaveCriticalSection(ProcessMsgCriticalSection);
    end;
{$IFEND}
  end;
end;

