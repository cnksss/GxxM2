procedure TBaseObject.KickException;
var
  PlayObject: TPlayObject;
  NationInfo: pTNationInfo;
  boHomeMap: Boolean;
begin
  if m_btRaceServer = RC_PLAYOBJECT then
  begin
    boHomeMap := False;
    PlayObject := TPlayObject(Self);
    if PlayObject.m_btNation > 0 then
    begin
      NationInfo := g_NationManage.Items[PlayObject.m_btNation];
      if NationInfo <> nil then
      begin
        m_sMapName := NationInfo.sHomeMap;
        m_nCurrX := NationInfo.nHomeX;
        m_nCurrY := NationInfo.nHomeY;
        boHomeMap := True;
      end;
    end;
    if not boHomeMap then
    begin
      m_sMapName := g_Config.sHomeMap;
      m_nCurrX := g_Config.nHomeX;
      m_nCurrY := g_Config.nHomeY;
    end;
    PlayObject.m_boEmergencyClose := True;
    PlayObject.m_boPlayOffLine := False; // 关闭下线触发
    PlayObject.DisappearB; // 增加清除行会和组对列表
  end
  else
  begin
    m_boDeath := True;
    m_dwDeathTick := MyGetTickCount;
  end;
end;

function TBaseObject.Walk(nIdent: Integer): Boolean;
var
  I: Integer;
  MapCellInfo: pTMapCellinfo;
  GameObject: TGameObject;
  GateObject: TGateObject;
  bo1D: Boolean;
  Event: TGameEvent;
  PlayObject: TPlayObject;
  nCheckCode: Integer;
  sMsg: string;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.Walk  CheckCode:%d %s %s %d:%d';
  HookError = '[Exception] HookObjectWalkIndex';
begin
  Result := True;
  nCheckCode := -1;
  if m_PEnvir = nil then
  begin
    MainOutMessage('Walk nil PEnvir');
    Exit;
  end;
  try
    nCheckCode := 1;
    if m_boImprison and ((m_nCurrX < m_nImprisonPos.X - m_nImprisonRange) or (m_nCurrX > m_nImprisonPos.X + m_nImprisonRange) or
      (m_nCurrY < m_nImprisonPos.Y - m_nImprisonRange) or (m_nCurrY > m_nImprisonPos.Y + m_nImprisonRange)) then
    begin
      Result := False;
      Exit;
    end;
    GateObject := nil;
    Event := nil;
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      m_PEnvir.LockR(12);
    try
{$IFEND}
      bo1D := m_PEnvir.GetMapCellInfo(m_nCurrX, m_nCurrY, MapCellInfo);
      nCheckCode := 2;
      if bo1D and (MapCellInfo.ObjList <> nil) then
      begin
        for I := 0 to {$IF USEOBJLIST = 1}Length(MapCellInfo.ObjList){$ELSE}MapCellInfo.ObjList.Count{$IFEND} - 1 do
        begin
          GameObject :=
{$IF USEOBJLIST = 1}TGameObject(MapCellInfo.ObjList[I]){$ELSE}TGameObject(MapCellInfo.ObjList.Items[I]){$IFEND};
          if GameObject <> nil then
          begin
            if GameObject.m_ObjGame = Obj_Gate then
            begin
              GateObject := TGateObject(GameObject);
            end;
            if GameObject.m_ObjGame = Obj_Event then
            begin
              if TGameEvent(GameObject).m_OwnBaseObject <> nil then
                Event := TGameEvent(GameObject);
            end;
            if GameObject.m_ObjGame = Obj_MapEvent then
            begin
            end;
            if GameObject.m_ObjGame = Obj_Door then
            begin
            end;
            if GameObject.m_ObjGame = Obj_Roon then
            begin
            end;
          end;
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        m_PEnvir.UnLockR;
    end;
{$IFEND}
    nCheckCode := 3;
    if Event <> nil then
    begin
      if (Event.m_OwnBaseObject <> nil) then
      begin
        // 修改防火墙无效 -- piaoyun 2013-07-17
        if (not UnFireCross) and Event.m_OwnBaseObject.IsProperTarget(Self) then
        begin
          if Event is TCustomMagicEffectEvent then
          begin
            SendMsg(Event.m_OwnBaseObject, RM_MAGSTRUCK_MINE, 0, Event.m_nDamage, 0, TCustomMagicEffectEvent(Event).MagicID, '');
          end
          else
            SendMsg(Event.m_OwnBaseObject, RM_MAGSTRUCK_MINE, 0, Event.m_nDamage, 0, 22, '');
        end;
      end;
    end;
    {
      if (g_PlugInSupport5 = 1) then
      begin
      try
      if Assigned(HookObjectWalkIndex) then
      begin
      HookObjectWalkIndex(Self, nIdent);
      end;
      except
      on E: Exception do
      begin
      MainOutMessage(HookError);
      MainOutMessage(E.Message);
      end;
      end;
      end;
    }
    nCheckCode := 4;
    if Result and (GateObject <> nil) then
    begin
      if (m_btRaceServer = RC_PLAYOBJECT) or ((m_btRaceServer = RC_TRUCKOBJECT) and (m_Master <> nil) and
        (m_Master.m_PEnvir <> m_PEnvir) and TTruckMonster(Self).m_boEnterAnotherMap) { 镖车 } then
      begin
        if m_PEnvir.ArroundDoorOpened(m_nCurrX, m_nCurrY) then
        begin
          if (not TEnvirnoment(GateObject.m_DEnvir).m_boNEEDHOLE) or
            (g_EventManager.GetGameEvent(m_PEnvir, m_nCurrX, m_nCurrY, ET_DIGOUTZOMBI) <> nil) then
          begin
            if nServerIndex = TEnvirnoment(GateObject.m_DEnvir).nServerIndex then
            begin
              if (not TEnvirnoment(GateObject.m_DEnvir).m_boNeedLevelTime) or (m_btRaceServer <> RC_PLAYOBJECT) then
              begin
                if not EnterAnotherMap(TEnvirnoment(GateObject.m_DEnvir), GateObject.m_nMapX, GateObject.m_nMapY) then
                  Result := False;
              end
              else if m_Abil.Level >= TEnvirnoment(GateObject.m_DEnvir).m_dwNeedLevelPoint then // 等级达到时才可进入地图
              begin
                if not EnterAnotherMap(TEnvirnoment(GateObject.m_DEnvir), GateObject.m_nMapX, GateObject.m_nMapY) then
                  Result := False;
              end
              else if m_btRaceServer = RC_PLAYOBJECT then
              begin
                TPlayObject(Self).MoveToHome(); // 移动到回城点
                if Length(g_sNeedLevelToXYErrorMsg) > 0 then
                begin
                  sMsg := WideReplaceText(g_sNeedLevelToXYErrorMsg, '%map', TEnvirnoment(GateObject.m_DEnvir).sMapDesc);
                  sMsg := WideReplaceText(sMsg, '%level', IntToStr(TEnvirnoment(GateObject.m_DEnvir).m_dwNeedLevelPoint));
                  SysMsg(sMsg, c_Red, t_Hint);
                end;
              end;
            end
            else if m_btRaceServer = RC_PLAYOBJECT then
            begin
              DisappearA();
              m_bo316 := True;
              PlayObject := TPlayObject(Self);
              PlayObject.m_sSwitchMapName := TEnvirnoment(GateObject.m_DEnvir).sMapName;
              PlayObject.m_nSwitchMapX := GateObject.m_nMapX;
              PlayObject.m_nSwitchMapY := GateObject.m_nMapY;
              PlayObject.m_boSwitchData := True;
              PlayObject.m_nServerIndex := TEnvirnoment(GateObject.m_DEnvir).nServerIndex;
              PlayObject.m_boEmergencyClose := True;
              PlayObject.m_boReconnection := True;
              PlayObject.m_boPlayOffLine := False; // 关闭下线触发
              PlayObject.DisappearB(); // 增加清除行会和组对列表
            end;
          end;
        end;
      end
      else
        Result := False;
    end
    else
    begin
      nCheckCode := 5;
      if Result then
      begin
        nCheckCode := 6;
        SendRefMsg(nIdent, m_btDirection, m_nCurrX, m_nCurrY, 0, '');
        nCheckCode := 7;
        if nIdent = RM_WALK then
        begin
          nCheckCode := 8;
          if (m_btRaceServer = RC_PLAYOBJECT) and TPlayObject(Self).m_boOnHorse then
            OnMapNotifyEvent(Self, meHorseWalk)
          else
            OnMapNotifyEvent(Self, meWalk); // 走路事件触发}
        end
        else if nIdent = RM_RUN then
        begin
          nCheckCode := 9;
          if (m_btRaceServer = RC_PLAYOBJECT) and TPlayObject(Self).m_boOnHorse then
            OnMapNotifyEvent(Self, meHorseRun)
          else
            OnMapNotifyEvent(Self, meRun); // 跑步事件触发}
        end;
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg, [nCheckCode, m_sCharName, m_sMapName, m_nCurrX, m_nCurrY]));
      { MainOutMessage('[Exception] TBaseObject:Walk  CheckCode: ' + IntToStr(nCheckCode) + ' ' +
        m_sCharname + ' ' +
        m_sMapName + ' ' +
        IntToStr(m_nCurrX) + ':' +
        IntToStr(m_nCurrY)); }
      MainOutMessage(E.Message);
    end;
  end;
end;

function TBaseObject.EnterAnotherMap(Envir: TEnvirnoment; nDMapX, nDMapY: Integer): Boolean;
var
  I: Integer;
  MapCellInfo: pTMapCellinfo;
  OldEnvir: TEnvirnoment;
  nOldX: Integer;
  nOldY: Integer;
  Castle: TUserCastle;
  BaseObject: TBaseObject;
  nCode: Integer;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.EnterAnotherMap; Code = ';
begin
  nCode := 0;
  Result := False;
  try
    nCode := 1;
    if (Envir.QuestNPC <> nil) and (m_btRaceServer = RC_PLAYOBJECT) then
      TMerchant(Envir.QuestNPC).Click(TPlayObject(Self));

    nCode := 2;
    if Envir.nNEEDSETONFlag >= 0 then
    begin
      nCode := 3;
      if (m_btRaceServer = RC_PLAYOBJECT) //
        and (TPlayObject(Self).GetQuestFlagStatus(Envir.nNEEDSETONFlag) <> Envir.nNeedONOFF) then
        Exit;
    end;

    nCode := 4;
    if not Envir.GetMapCellInfo(nDMapX, nDMapY, MapCellInfo) then
      Exit;

    nCode := 5;
    Castle := g_CastleManager.IsCastlePalaceEnvir(Envir);

    nCode := 6;
    if (Castle <> nil) and (m_btRaceServer = RC_PLAYOBJECT) then
    begin
      nCode := 7;
      if not Castle.CheckInPalace(m_nCurrX, m_nCurrY, Self) then
        Exit;
    end;

    nCode := 8;
    OldEnvir := m_PEnvir;
    nOldX := m_nCurrX;
    nOldY := m_nCurrY;
    nCode := 9;
    DisappearA();
    nCode := 10;
    ClearObject;
    nCode := 11;
    if m_btRaceServer = RC_PLAYOBJECT then
      SendMsg(Self, RM_CLEAROBJECTS, 0, 0, 0, 0, '');

    nCode := 12;
    m_nCurrX := nDMapX;
    m_nCurrY := nDMapY;
    m_PEnvir := Envir;
    m_sMapName := Envir.sMapName;

    nCode := 13;
    if (m_btRaceServer = RC_PLAYOBJECT) //
      and TPlayObject(Self).m_boOnHorse //
      and (TPlayObject(Self).m_HorseOtherHum <> nil) //
      and TPlayObject(Self).m_boHorseMaster then
      TPlayObject(Self).m_HorseOtherHum.EnterAnotherMap(Envir, nDMapX, nDMapY);

    nCode := 14;
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      nCode := 15;
      if (TPlayObject(Self).m_MyHero <> nil) and (TPlayObject(Self).m_MyHero.m_boTarget) then
      begin
        nCode := 16;
        TPlayObject(Self).m_MyHero.m_boTarget := False;
        TPlayObject(Self).m_MyHero.DelTargetCreat;
      end;

      nCode := 17;
      if (not SameText(Envir.MapName, Envir.sMapName)) then
        SendMsg(Self, RM_CHANGEMAP, 0, 0, 0, 0, Envir.MapName + sLineBreak + Envir.sMapName)
      else
        SendMsg(Self, RM_CHANGEMAP, 0, 0, 0, 0, Envir.MapName);

      // 换地图后，立马把周边的对象发送到客户端 chongchong 2018-09-12 21:31:35
      m_dwSearchTick := MyGetTickCount();
      SearchViewRange;

      nCode := 18;
      // 浑水摸鱼模式，换地图 chongchong 2016-10-20
      if ((OldEnvir.m_nSecretFlag and SecretFlag_ShowEqualName) <> (m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName)) or
        ((OldEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName) <> (m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName)) then
        SendMsg(Self, RM_USERNAME, 0, 0, 0, 0, GetShowName);

      nCode := 19;
      if ((OldEnvir.m_nSecretFlag and SecretFlag_NoChangNameColor) <> (m_PEnvir.m_nSecretFlag and SecretFlag_NoChangNameColor)) or
        ((OldEnvir.m_nSecretFlag2 and SecretFlag_NoChangNameColor) <> (m_PEnvir.m_nSecretFlag2 and SecretFlag_NoChangNameColor))
      then
        SendMsg(Self, SM_CHANGENAMECOLOR, GetCharColor(Self), 0, 0, 0, '');
    end;
    nCode := 20;
    if AddToMap() then
    begin
      nCode := 21;
      if not m_boTempAdminMode then
      begin
        m_dwTempAdminModeTick := MyGetTickCount;
        m_boTempAdminMode := True;
      end;
      nCode := 22;
      m_dwMapMoveTick := MyGetTickCount();
      m_bo316 := True;
      InitSpeed;
      nCode := 23;
      OnSpaceMove;
      nCode := 24;
      // 镖车
      for I := 0 to m_SlaveList.Count - 1 do
      begin
        nCode := 25;
        BaseObject := TBaseObject(m_SlaveList.Items[I]);
        if (BaseObject.m_btRaceServer = RC_TRUCKOBJECT) and (BaseObject.m_PEnvir = OldEnvir) and
          (Abs(nOldX - BaseObject.m_nCurrX) <= m_nViewRange) and (Abs(nOldY - BaseObject.m_nCurrY) <= m_nViewRange) then
        begin
          TTruckMonster(BaseObject).m_nGateX := nOldX;
          TTruckMonster(BaseObject).m_nGateY := nOldY;
          TTruckMonster(BaseObject).m_boEnterAnotherMap := True;
        end;
      end;
      nCode := 26;
      if m_btRaceServer = RC_TRUCKOBJECT then
        TTruckMonster(Self).m_boEnterAnotherMap := False;
      Result := True;
    end
    else
    begin
      // add chongchong 2014-05-15
      // m_PEnvir.DeleteFromMap(m_nCurrX, m_nCurrY, Self);
      nCode := 27;
      m_PEnvir := OldEnvir;
      m_nCurrX := nOldX;
      m_nCurrY := nOldY;
      // add chongchong 2014-05-15
      // OldEnvir.AddToMap(m_nCurrX, m_nCurrY, Self);
      // 虫虫 优化刷怪CPU占用 chongchong 2013-12-24
      // OldEnvir.DelObjectCount(Self);
    end;
    nCode := 28;
    if m_btRaceServer = RC_PLAYOBJECT then
    begin // 复位泡点，及金币，时间
      TPlayObject(Self).m_dwIncGamePointTick := MyGetTickCount();
      TPlayObject(Self).m_dwDecGamePointTick := MyGetTickCount();
      TPlayObject(Self).m_dwIncGameGoldTick := MyGetTickCount();
      TPlayObject(Self).m_dwAutoGetExpTick := MyGetTickCount();
      TPlayObject(Self).m_dwSayAdvertiseTick := MyGetTickCount;
      nCode := 28;
      if m_PEnvir <> OldEnvir then
      begin
        // 换地图清M变量 chongchong 2015-05-24
        FillChar(TPlayObject(Self).m_nMval, SizeOf(TPlayObject(Self).m_nMval), #0);
        if g_Config.boOpenCombatPowerCalc and g_Config.boOpenCombatPowerVarCalc then
        begin
          RecalcPlayCombatPower(TPlayObject(Self));
        end;
        TPlayObject(Self).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(Self), '@EnterMap', False);
        if (MyGetTickCount() - TPlayObject(Self).m_dwTimeMapCurrTime >= OldEnvir.m_nTimeMapMin * 60 * 1000) and
          (OldEnvir.m_sTimeMapLabel <> '') then // 限时地图 By 一支笔 at:2021-10-14 09:51:09
        begin
          g_FunctionNPC.GotoLable(TPlayObject(Self), OldEnvir.m_sTimeMapLabel, False);
        end;
        // if Envir.m_nTimeMapMin > 0 then//限时地图 By 一支笔 at:2021-10-14 09:51:09
        // begin
        TPlayObject(Self).SendDefMessage(SM_FBTIME, Envir.m_nTimeMapMin * 60 * 1000, 0, 0, 5, '');
        // end;
      end;
    end
    else if (m_PEnvir <> OldEnvir) and (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and
      (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(m_Master).m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroEnterMap', False);
    end;
    nCode := 30;
    if m_PEnvir.m_boFight3Zone and (m_PEnvir.m_boFight3Zone <> OldEnvir.m_boFight3Zone) then
      RefShowName();
  except
    MainOutMessage(sExceptionMsg + IntToStr(nCode));
  end;
end;

