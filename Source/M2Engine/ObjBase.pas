procedure TBaseObject.GetFrontPosition(var nX: Integer; var nY: Integer);
var
  Envir: TEnvirnoment;
begin
  Envir := m_PEnvir;
  nX := m_nCurrX;
  nY := m_nCurrY;
  case m_btDirection of //
    DR_UP:
      begin
        if nY > 0 then
          Dec(nY);
      end;
    DR_UPRIGHT:
      begin
        if (nX < (Envir.m_nWidth - 1)) and (nY > 0) then
        begin
          Inc(nX);
          Dec(nY);
        end;
      end;
    DR_RIGHT:
      begin
        if nX < (Envir.m_nWidth - 1) then
          Inc(nX);
      end;
    DR_DOWNRIGHT:
      begin
        if (nX < (Envir.m_nWidth - 1)) and (nY < (Envir.m_nHeight - 1)) then
        begin
          Inc(nX);
          Inc(nY);
        end;
      end;
    DR_DOWN:
      begin
        if nY < (Envir.m_nHeight - 1) then
          Inc(nY);
      end;
    DR_DOWNLEFT:
      begin
        if (nX > 0) and (nY < (Envir.m_nHeight - 1)) then
        begin
          Dec(nX);
          Inc(nY);
        end;
      end;
    DR_LEFT:
      begin
        if nX > 0 then
          Dec(nX);
      end;
    DR_UPLEFT:
      begin
        if (nX > 0) and (nY > 0) then
        begin
          Dec(nX);
          Dec(nY);
        end;
      end;
  end;
end;

