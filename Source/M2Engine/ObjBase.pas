      m_WAbil.MAC1 := Max(m_WAbil.MAC1 - m_AddNewExtValues[anet_SubMAC1], 0);

    if m_AddNewExtValues[anet_SubMAC2] > 0 then
      m_WAbil.MAC2 := Max(m_WAbil.MAC2 - m_AddNewExtValues[anet_SubMAC2], 0);

    if m_AddNewExtValues[anet_SubDC1] > 0 then
      m_WAbil.DC1 := Max(m_WAbil.DC1 - m_AddNewExtValues[anet_SubDC1], 0);

    if m_AddNewExtValues[anet_SubDC2] > 0 then
      m_WAbil.DC2 := Max(m_WAbil.DC2 - m_AddNewExtValues[anet_SubDC2], 0);

    if m_AddNewExtValues[anet_SubMC1] > 0 then
      m_WAbil.MC1 := Max(m_WAbil.MC1 - m_AddNewExtValues[anet_SubMC1], 0);

    if m_AddNewExtValues[anet_SubMC2] > 0 then
      m_WAbil.MC2 := Max(m_WAbil.MC2 - m_AddNewExtValues[anet_SubMC2], 0);

    if m_AddNewExtValues[anet_SubSC1] > 0 then
      m_WAbil.SC1 := Max(m_WAbil.SC1 - m_AddNewExtValues[anet_SubSC1], 0);

    if m_AddNewExtValues[anet_SubSC2] > 0 then
      m_WAbil.SC2 := Max(m_WAbil.SC2 - m_AddNewExtValues[anet_SubSC2], 0);

    if m_AddNewExtValues[anet_SubHitPoint] > 0 then
      m_btHitPoint := Max(Integer(m_btHitPoint) - m_AddNewExtValues[anet_SubHitPoint], 0);

    if m_AddNewExtValues[anet_SubSpeedPoint] > 0 then
      m_btSpeedPoint := Max(Integer(m_btSpeedPoint) - m_AddNewExtValues[anet_SubSpeedPoint], 0);

    if m_AddNewExtValues[anet_SubAntiMagic] > 0 then
      m_nAntiMagic := Max(Integer(m_nAntiMagic) - m_AddNewExtValues[anet_SubAntiMagic], 0);

    if m_AddNewExtValues[anet_SubAntiPoison] > 0 then
      m_btAntiPoison := Max(Integer(m_btAntiPoison) - m_AddNewExtValues[anet_SubAntiPoison], 0);

    if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    begin
      if m_AddNewExtValues[anet_AddNGDamage] > 0 then
        TSmartObject(Self).m_AddNGDamage := TSmartObject(Self).m_AddNGDamage + m_AddNewExtValues[anet_AddNGDamage];

      if m_AddNewExtValues[anet_AddNGDefense] > 0 then
        TSmartObject(Self).m_DecNGDamage := TSmartObject(Self).m_DecNGDamage + m_AddNewExtValues[anet_AddNGDefense];

      for NewExtType := anet_AddBlastHit to anet_AddFatalBlowDefense do
      begin
        II := Integer(NewExtType) - Integer(anet_AddBlastHit);
        // 合并增加/删除 2019-12-17
        NewValue := m_AddNewExtValues[NewExtType] - m_AddNewExtValues[TAddNewExtType(II + Integer(anet_SubBlastHit))];
        if NewValue = 0 then
          Continue;

        // 攻击伤害、体力增加、魔法增加、合击伤害、致命一击伤害增加 chongchong 2015-06-30
        if II in [1, 7, 8, 10, 22] then
        begin
          Int64Value := Max(0, Int64(m_WAbil.NewValue[II]) + NewValue);

          m_WAbil.NewValue[II] := Min(Int64Value, High(LongWord));
          if II = 7 then
          begin
            Int64Value := Int64(m_WAbil.MaxHP) + Round(m_WAbil.MaxHP * (NewValue / 100));
            m_WAbil.MaxHP := Min(nMaxValue, Int64Value);
          end
          else if II = 8 then
          begin
            Int64Value := Int64(m_WAbil.MaxMP) + Round(m_WAbil.MaxMP * (NewValue / 100));
            m_WAbil.MaxMP := Min(nMaxValue, Int64Value);
          end;
        end
        else
        begin
          Int64Value := Int64(m_WAbil.NewValue[II]) + m_AddNewExtValues[NewExtType];
          m_WAbil.NewValue[II] := Min(Int64Value, 100);
        end;
      end;
    end;

    // 宝宝属性叠加 攻击力DC (下限） chongchong 2014-11-29
    if m_nBBAttrPlusValues[0][0] > 0 then
    begin
      Int64Value := Int64(m_nBBAttrPlusValues[0][0]) + m_WAbil.DC1;
      m_WAbil.DC1 := Min(nMaxAC, Max(0, Int64Value));
    end;

    // 宝宝属性叠加 攻击力DC (上限） chongchong 2014-11-29
    if m_nBBAttrPlusValues[0][1] > 0 then
    begin
      Int64Value := Int64(m_nBBAttrPlusValues[0][1]) + m_WAbil.DC2;
      m_WAbil.DC2 := Min(nMaxAC, Max(0, Int64Value));
    end;

    if m_nBBAttrPlusValues[1][0] > 0 then // 加防御下限
    begin
      Int64Value := Int64(m_nBBAttrPlusValues[1][0]) + m_WAbil.AC1;
      m_WAbil.AC1 := Min(nMaxAC, Max(0, Int64Value));
    end;

    if m_nBBAttrPlusValues[1][1] > 0 then // 加防御上限
    begin
      Int64Value := Int64(m_nBBAttrPlusValues[1][1]) + m_WAbil.AC2;
      m_WAbil.AC2 := Min(nMaxAC, Max(0, Int64Value));
    end;

    if m_nBBAttrPlusValues[2][0] > 0 then // 加魔御下限
    begin
      Int64Value := Int64(m_nBBAttrPlusValues[2][0]) + m_WAbil.MAC1;
      m_WAbil.MAC1 := Min(nMaxAC, Max(0, Int64Value));
    end;

    if m_nBBAttrPlusValues[2][1] > 0 then // 加魔御上限
    begin
      Int64Value := Int64(m_nBBAttrPlusValues[2][1]) + m_WAbil.MAC2;
      m_WAbil.MAC2 := Min(nMaxAC, Max(0, Int64Value));
    end;

    if m_nBBAttrPlusValues[3][0] > 0 then // 加HP
    begin
      Int64Value := Int64(m_WAbil.MaxHP) + m_nBBAttrPlusValues[3][0];
      m_WAbil.MaxHP := Min(nMaxValue, Int64Value);
    end;

    // 爬地上的神兽不用检测
    if m_boCheckHPOutOfRange and (m_WAbil.HP > m_WAbil.MaxHP) then
      m_WAbil.HP := m_WAbil.MaxHP;

    if m_WAbil.MP > m_WAbil.MaxMP then
      m_WAbil.MP := m_WAbil.MaxMP;

    if m_boZeroAC then
    begin
      m_WAbil.AC1 := 0;
      m_WAbil.AC2 := 0;
    end;

    if m_boZeroMAC then
    begin
      m_WAbil.MAC1 := 0;
      m_WAbil.MAC2 := 0;
    end;

    if m_boZeroArmor then
    begin
      m_WAbil.AC1 := 0;
      m_WAbil.AC2 := 0;
      m_WAbil.MAC1 := 0;
      m_WAbil.MAC2 := 0;
    end;

    if (g_PluginManager <> nil) then
      g_PluginManager.HookBaseObjectRecalAbilEnd(Self);

    m_WAbil.AC1 := Min(nMaxAC, m_WAbil.AC1);
    m_WAbil.AC2 := Min(nMaxAC, m_WAbil.AC2);
    m_WAbil.MAC1 := Min(nMaxAC, m_WAbil.MAC1);
    m_WAbil.MAC2 := Min(nMaxAC, m_WAbil.MAC2);
    m_WAbil.DC1 := Min(nMaxAC, m_WAbil.DC1);
    m_WAbil.DC2 := Min(nMaxAC, m_WAbil.DC2);
    m_WAbil.MC1 := Min(nMaxAC, m_WAbil.MC1);
    m_WAbil.MC2 := Min(nMaxAC, m_WAbil.MC2);
    m_WAbil.SC1 := Min(nMaxAC, m_WAbil.SC1);
    m_WAbil.SC2 := Min(nMaxAC, m_WAbil.SC2);
  except
    MainOutMessage('[Exception] TBaseObject:RecalcAbilitys;' + '; RACE:' + IntToStr(m_btRaceServer) + ' ; Name:' + m_sCharName);
  end;
end;

procedure TBaseObject.BreakOpenHealth();
begin
  if m_boShowHP then
  begin
    m_boShowHP := False;
    m_nCharStatusEx := m_nCharStatusEx xor STATE_OPENHEATH;
    m_nCharStatus := GetCharStatus();
    SendRefMsg(RM_CLOSEHEALTH, 0, 0, 0, 0, '');
  end;
end;

procedure TBaseObject.MakeOpenHealth();
begin
  m_boShowHP := True;
  m_nCharStatusEx := m_nCharStatusEx or STATE_OPENHEATH;
  m_nCharStatus := GetCharStatus();
  SendRefMsg(RM_OPENHEALTH, 0, m_WAbil.HP, m_WAbil.MaxHP, 0, '');
end;

procedure TBaseObject.IncHealthSpell(nHP, nMP: LongWord; SendHealthSpellChanged: Boolean);
var
  Int64Value: Int64;
begin
  Int64Value := Int64(m_WAbil.HP) + nHP;
  m_WAbil.HP := Min(Int64Value, m_WAbil.MaxHP);
  Int64Value := Int64(m_WAbil.MP) + nMP;
  m_WAbil.MP := Min(Int64Value, m_WAbil.MaxMP);
  if SendHealthSpellChanged then
  begin
    HealthSpellChanged();
  end;
end;

procedure TBaseObject.ItemDamageRevivalRing();
var
  I, nOldLight: Integer;
  pStdItem: pTStdItem;
  nDura, tDura, nDamageDura: Integer;
  PlayObject: TPlayObject;
  bo19: Boolean;
  SmartObject: TSmartObject;
begin
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(Self);
    bo19 := False;
    nOldLight := m_nLight;
    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      if (SmartObject.m_UseItems[I].wIndex > 0) then
      begin
        pStdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[I].wIndex);
        if (pStdItem <> nil) and (not(pStdItem.StdMode in [53, 96])) and
          (not((pStdItem.StdMode = 7) and (pStdItem.Shape in [1, 2, 3]))) and
          (not((pStdItem.StdMode = 25) and (pStdItem.Shape = 9))) then
        begin
          if (SmartObject.m_UseItems[I].Dura <= 0) then
          begin
            if g_Config.boDeleteItemDuraZero then
            begin
              if pStdItem.NeedIdentify = 1 then
              begin
                AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, pStdItem.Name, SmartObject.m_UseItems[I].MakeIndex, '0',
                  0, 0, '持久为0');
              end;
              if m_btRaceServer = RC_PLAYOBJECT then
              begin
                PlayObject := TPlayObject(Self);
                PlayObject.SendDelItem(@SmartObject.m_UseItems[I]);
              end
              else if m_btRaceServer = RC_HEROOBJECT then
              begin
                THeroObject(Self).SendDelItem(@SmartObject.m_UseItems[I]);
              end;
              SmartObject.m_UseItems[I].wIndex := 0;
              { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
              if m_btRaceServer = RC_PLAYOBJECT then
                TPlayObject(Self).ProcessUseItemSkill(I, pStdItem, False);
              bo19 := True;
              Continue;
            end
            else
            begin
              Continue;
            end;
          end;
          if (pStdItem.Shape in [114, 160, 161, 162]) or
            (((I = U_WEAPON) or (I = U_RIGHTHAND)) and (pStdItem.Anicount in [114, 160, 161, 162])) then
          begin
            nDura := SmartObject.m_UseItems[I].Dura;
            tDura := Round(nDura / 1000 { 1.03 } );
            nDamageDura := Round(1000 * (g_Config.nDamageItemDuraRate / 100));
            Dec(nDura, nDamageDura);
            if nDura <= 0 then
            begin
              nDura := 0;
              SmartObject.m_UseItems[I].Dura := nDura;
              if g_Config.boDeleteItemDuraZero then
              begin
                if pStdItem.NeedIdentify = 1 then
                begin
                  AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, pStdItem.Name, SmartObject.m_UseItems[I].MakeIndex, '0',
                    0, 0, '持久为0');
                end;
                if m_btRaceServer = RC_PLAYOBJECT then
                begin
                  PlayObject := TPlayObject(Self);
                  PlayObject.SendDelItem(@SmartObject.m_UseItems[I]);
                end
                else if m_btRaceServer = RC_HEROOBJECT then
                begin
                  THeroObject(Self).SendDelItem(@SmartObject.m_UseItems[I]);
                end;
                SmartObject.m_UseItems[I].wIndex := 0;
                { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
                if (m_btRaceServer = RC_PLAYOBJECT) then
                  TPlayObject(Self).ProcessUseItemSkill(I, pStdItem, False);
              end;
              if m_btRaceServer = RC_PLAYOBJECT then
              begin
                if g_FunctionNPC <> nil then
                begin
                  TPlayObject(Self).m_nScriptGotoCount := 0;
                  g_FunctionNPC.GotoLable(TPlayObject(Self), '@ItemDamage' + IntToStr(I), False);
                end;
              end;
              bo19 := True;
            end
            else
            begin // 004C0331
              SmartObject.m_UseItems[I].Dura := nDura;
            end;
            if tDura <> Round(nDura / 1000 { 1.03 } ) then
            begin
              SendMsg(Self, RM_DURACHANGE, I, nDura, SmartObject.m_UseItems[I].DuraMax, 0, '');
            end;
            if (not bo19) and g_Config.boViewFog and (I = U_RIGHTHAND) and (nDura <> SmartObject.m_UseItems[I].Dura) then
            begin // 火把亮度
              if g_Config.boDuraChangeLight then
                m_nLight := Min(Max(Round(SmartObject.m_UseItems[I].Dura / 10000), 1), 5)
              else
                m_nLight := Min(Max(Round(SmartObject.m_UseItems[I].DuraMax / 10000), 1), 5);
            end;
          end; // 004C0397
        end; // 004C0397 if pStdItem <> nil then begin
      end; // if UseItems[i].wIndex > 0 then begin
    end; // for i:=Low(UseItems) to High(UseItems) do begin
    // if not DecRevivalDamage then
    if g_Config.boJewelryDecDura then
    begin
      for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
      begin
        if (SmartObject.m_JewelryBoxItems[I].wIndex > 0) then
        begin
          pStdItem := UserEngine.GetStdItem(SmartObject.m_JewelryBoxItems[I].wIndex);
          if (pStdItem <> nil) and (pStdItem.Shape in [114, 160, 161, 162]) then
          begin
            nDura := SmartObject.m_JewelryBoxItems[I].Dura;
            tDura := Round(nDura / 1000 { 1.03 } );
            nDamageDura := Round(1000 * (g_Config.nDamageItemDuraRate / 100));
            Dec(nDura, nDamageDura);
            if nDura <= 0 then
            begin
              nDura := 0;
              SmartObject.m_JewelryBoxItems[I].Dura := nDura;
              if g_Config.boDeleteItemDuraZero then
              begin
                if pStdItem.NeedIdentify = 1 then
                begin
                  AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, pStdItem.Name,
                    SmartObject.m_JewelryBoxItems[I].MakeIndex, '0', 0, 0, '持久为0');
                end;
                if m_btRaceServer = RC_PLAYOBJECT then
                begin
                  PlayObject := TPlayObject(Self);
                  PlayObject.SendDelItem(@SmartObject.m_JewelryBoxItems[I]);
                end
                else if m_btRaceServer = RC_HEROOBJECT then
                begin
                  THeroObject(Self).SendDelItem(@SmartObject.m_JewelryBoxItems[I]);
                end;
                SmartObject.m_JewelryBoxItems[I].wIndex := 0;
                { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
                if (m_btRaceServer = RC_PLAYOBJECT) then
                  TPlayObject(Self).ProcessUseItemSkill(I, pStdItem, False);
              end;
              if m_btRaceServer = RC_PLAYOBJECT then
              begin
                if g_FunctionNPC <> nil then
                begin
                  TPlayObject(Self).m_nScriptGotoCount := 0;
                  g_FunctionNPC.GotoLable(TPlayObject(Self), '@ItemDamage' + IntToStr(I), False);
                end;
              end;
              bo19 := True;
            end
            else
            begin // 004C0331
              SmartObject.m_JewelryBoxItems[I].Dura := nDura;
            end;
            if tDura <> Round(nDura / 1000 { 1.03 } ) then
            begin
              SendMsg(Self, RM_DURACHANGE, I, nDura, SmartObject.m_JewelryBoxItems[I].DuraMax, 0, '');
            end;
          end; // 004C0397 if pStdItem <> nil then begin
        end; // if UseItems[i].wIndex > 0 then begin
      end; // for i:=Low(UseItems) to High(UseItems) do begin
    end;
    if bo19 then
      RecalcAbilitys()
    else
    begin
      if nOldLight <> m_nLight then
        SendRefMsg(RM_CHANGELIGHT, 0, 0, 0, 0, '');
    end;
  end;
end;

procedure TBaseObject.Run;
var
  I: Integer;
  boChg: Boolean;
  boNeedRecalc, boNeedRefreshHMP, boSendSubAbility: Boolean;
  nHP, nMP, n18: Integer;
  dwC: LongWord;
  InChsTime: Int64;
  ProcessMsg: TProcessMessage;
  BaseObject: TBaseObject;
  nCheckCode: Integer;
  nInteger: Integer;
  SmartObject: TSmartObject;
  boUnRevival: Boolean;
  nResotreHPSpeed: Integer; // 回血速度
  nResotreMPSpeed: Integer; // 回蓝速度
  nResotreHPBase: Integer; // 回血基数
  nResotreMPBase: Integer; // 回蓝基数
  Int64Value: Int64;
  nDamage: Integer;
  NewExtType: TAddNewExtType;
  IsDummyPlayer: Boolean;
  boCheck: Boolean;
  BaseObjectEffect: pTBaseObjectEffect;
  IsFeatureChanged: Boolean;
  IsNpcReborn: Boolean;
  HPRec: PNpcHumanHPRec;
  LastCustomMagicStatusID: Word;
  CustomMagicStatus: PCustomMagicStatus;
  PlayObject: TPlayObject;
  GamePetData: pTGamePetData;
  dwRunTick: LongWord;
  bo29: Boolean;
resourcestring
  sExceptionMsg0 = '[Exception] TBaseObject.Run 0';
  sExceptionMsg1 = '[Exception] TBaseObject.Run 1 ';
  sExceptionMsg2 = '[Exception] TBaseObject.Run 2';
  sExceptionMsg3 = '[Exception] TBaseObject.Run 3 Code:%d';
  sExceptionMsg4 = '[Exception] TBaseObject.Run 4 Code:%d';
  sExceptionMsg5 = '[Exception] TBaseObject.Run 5';
  sExceptionMsg6 = '[Exception] TBaseObject.Run 6';
  sExceptionMsg7 = '[Exception] TBaseObject.Run 7';
  sExceptionMsg8 = '[Exception] TBaseObject.Run Operate';
  sExceptionMsg9 = '[Exception] TBaseObject.Run 9';
begin
  // 人物职业: m_btJob
  // 人物还是英雄 m_btRaceServer   RC_PLAYOBJECT = 0;
  // RC_HEROOBJECT = 1; 英雄 1;
  if (m_MagicSelfPlay.SelfKeep_File >= 0) //
    and (m_MagicSelfPlay.SelfKeep_PlayCount > 0) //
    and (m_MagicSelfPlay.SelfKeep_KeepTime > 0) //
    and (tick_diff(m_MagicSelfPlayTick, MyGetTickCount) >= m_MagicSelfPlay.SelfKeep_KeepTime * 1000) then
    FillChar(m_MagicSelfPlay, SizeOf(m_MagicSelfPlay), 0);

  boNeedRefreshHMP := False;
  dwRunTick := MyGetTickCount();
  try
    while GetMessage(@ProcessMsg) do
    begin // (MyGetTickCount - dwRunTick < 30) and
      Operate(@ProcessMsg);
      if tick_diff(dwRunTick, MyGetTickCount) >= 2000 then
      begin
        MainOutMessage('提示：消息处理时间过长，wIdent:' + IntToStr(ProcessMsg.wIdent) + ' ' + m_sCharName);
        Break;
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg0 + ' wIdent:' + IntToStr(ProcessMsg.wIdent) + ' ' + m_sCharName);
      MainOutMessage(E.Message);
    end;
  end;

  m_BaseObjectEffects.LockW(1);
  try
    try
      for I := m_BaseObjectEffects.Count - 1 downto 0 do
      begin // 播放效果
        BaseObjectEffect := m_BaseObjectEffects.Items[I];
        if (BaseObjectEffect.ActorEffect.nLoopCount = 0) or (BaseObjectEffect.ActorEffect.nEffectFileIndex < 0) or
          (BaseObjectEffect.ActorEffect.wEffectImageCount <= 0) then
        begin
          Dispose(BaseObjectEffect);
          m_BaseObjectEffects.Delete(I);
        end
        else
        begin
          // -1为永久播放 chongchong 2014-05-05
          if (BaseObjectEffect.ActorEffect.nLoopCount > 0) and
            (MyGetTickCount() - BaseObjectEffect.dwEffectTick > BaseObjectEffect.ActorEffect.wEffectFrameTime *
            BaseObjectEffect.ActorEffect.wEffectImageCount) then
          begin
            BaseObjectEffect.dwEffectTick := MyGetTickCount();
            Dec(BaseObjectEffect.ActorEffect.nLoopCount);
          end;
        end;
      end;
    except
      MainOutMessage(sExceptionMsg2 + '-' + '1');
    end;
  finally
    m_BaseObjectEffects.UnLockW;
  end;

  nCheckCode := 5000;
  boChg := False;
  boNeedRecalc := False;
  boSendSubAbility := False;
  nResotreHPSpeed := g_Config.nHealthFillTime; // MainOutMessage(Format('怪物"%s"回血', [GetShowName()]));
  nResotreMPSpeed := g_Config.nSpellFillTime; // MainOutMessage(Format('怪物"%s"回血', [GetShowName()]));
  nResotreHPBase := g_Config.nHealthBaseNum; // 怪物回血基数
  nResotreMPBase := g_Config.nSpellBaseNum; // 怪物回蓝基数
  try
    if m_boSuperMan then
    begin
      if (m_WAbil.HP <> m_WAbil.MaxHP) or (m_WAbil.MP <> m_WAbil.MaxMP) then
      begin
        m_WAbil.HP := m_WAbil.MaxHP;
        m_WAbil.MP := m_WAbil.MaxMP;
        // HealthSpellChanged;
        boNeedRefreshHMP := True; // 优化chongchong 2018-02-13
      end;
    end;

    if m_boTempAdminMode and (tick_diff(m_dwTempAdminModeTick, MyGetTickCount()) >= g_Config.dwHumChgMapOrLoginProtectTime) then
      m_boTempAdminMode := False;

    dwC := (MyGetTickCount() - m_dwHPMPTick) div 20;
    m_dwHPMPTick := MyGetTickCount();
    n18 := dwC + m_nHealthRecover;
    Inc(m_nHealthTick, n18);
    n18 := dwC + m_nSpellRecover;
    Inc(m_nSpellTick, n18);
    IsDummyPlayer := False;
    case m_btRaceServer of
      RC_PLAYOBJECT: // 人物
        begin
          if m_boDummyObject then
          begin
            IsDummyPlayer := True;
            if m_btJob = 0 then
            begin
              nResotreHPSpeed := g_Config.nDummyHPTime_Warrior; // MainOutMessage('战士人物回血速度')
              nResotreMPSpeed := g_Config.nDummyMPTime_Warrior; // MainOutMessage('战士人物回蓝速度')
              nResotreHPBase := g_Config.nDummyHPBase_Warrior; // MainOutMessage('战士人物回血基数')
              nResotreMPBase := g_Config.nDummyMPBase_Warrior; // MainOutMessage('战士人物回蓝基数')
            end
            else if m_btJob in [1, 2] then
            begin
              nResotreHPSpeed := g_Config.nDummyHPTime_DF; // MainOutMessage('道法人物回血速度')
              nResotreMPSpeed := g_Config.nDummyMPTime_DF; // MainOutMessage('道法人物回蓝速度')
              nResotreHPBase := g_Config.nDummyHPBase_DF; // MainOutMessage('道法人物回血基数')
              nResotreMPBase := g_Config.nDummyMPBase_DF; // MainOutMessage('道法人物回蓝基数')
            end;
          end
          else
          begin
            if m_btJob = 0 then
            begin
              nResotreHPSpeed := g_Config.nHealthFillTime_Human_Warrior; // MainOutMessage('战士人物回血速度')
              nResotreMPSpeed := g_Config.nSpellFillTime_Human_Warrior; // MainOutMessage('战士人物回蓝速度')
              nResotreHPBase := g_Config.nHealthBaseNum_Human_Warrior; // MainOutMessage('战士人物回血基数')
