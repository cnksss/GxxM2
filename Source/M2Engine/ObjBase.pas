destructor TSmartObject.Destroy;
var
  I: Integer;
begin
  for I := 0 to m_MagicList.Count - 1 do
  begin
    Dispose(pTUserMagic(m_MagicList.Items[I]));
  end;
  FreeAndNil(m_MagicList);
  for I := 0 to m_FengHaoItems.Count - 1 do
  begin
    Dispose(pTUserItem(m_FengHaoItems.Items[I]));
  end;
  m_FengHaoItems.Free;
  m_SayList.Free;
  FreeAndNil(m_OldGroupItem);
  FreeAndNil(m_GroupItem);
  m_MovePath := nil;
  m_nMoveIndex := -1;
  m_MagicCDDecList.Free;
  m_StruckDamageAbsorbMgr.Free;
  inherited;
end;

function TSmartObject.DrinkWine(UserItem: pTUserItem; StdItem: pTStdItem): Boolean; // 喝酒
begin
  Result := False;
  if m_boDrinkWineDrunk then
  begin
    SysMsg('自觉头晕不已,酒虽为情所系,奈何量去甚多,暂无余力再饮!', c_Red, t_Hint);
    Exit;
  end;
  if m_Alcohol.MaxAlcohol < StdItem.Need then
  begin // 酒量值达到要求
    SysMsg('酒量需达到' + IntToStr(StdItem.Need) + '才能饮用!', c_Red, t_Hint); // 提示用户
    Exit;
  end;
  if UserItem.Dura > 0 then
  begin
    if UserItem.Dura >= 1000 then
    begin
      Dec(UserItem.Dura, 1000);
    end
    else
    begin
      UserItem.Dura := 0;
    end;
    // SendRefMsg(RM_MYSHOW, 7, 0, 0, 0, ''); //喝酒自身动画  20080623
    if m_Alcohol.WineDrinkValue = 0 then
    begin // 如果醉酒度为0,则初始时间间隔
      m_dwDecWineDrinkValueTick := MyGetTickCount();
      m_dwAddAlcoholTick := MyGetTickCount();
    end;
    Inc(m_Alcohol.WineDrinkValue, (UserItem.btValue[1] * m_Alcohol.MaxAlcohol div 200)); // 增加醉酒度 20080623
    m_nDrinkWineAlcohol := UserItem.btValue[1]; // 饮酒时酒的度数 20080624
    m_nDrinkWineQuality := UserItem.btValue[0]; // 饮酒时酒的品质 20080623
    if m_Alcohol.WineDrinkValue >= m_Alcohol.MaxAlcohol then
    begin // 醉酒度超过上限,即喝醉了
      m_Alcohol.WineDrinkValue := m_Alcohol.MaxAlcohol;
      m_boDrinkWineDrunk := True; // 喝酒醉了 20080623
      SysMsg('自觉头晕不已,酒虽为情所系,奈何量去甚多,暂无余力再饮!', c_Red, t_Hint);
      ShowEffect(Self, 1); // 喝醉自身动画
    end;
    // 普通酒,品质2以上,25%机率加临时属性 20080713
    if (StdItem.Anicount = 1) and (m_nDrinkWineQuality > 2) and (Random(4) = 0) and (not m_boDrinkWineDrunk) then
    begin
      case Random(2) of
        0:
          begin
            m_dwDefenceUpAddRate := 0;
            m_btDefenceUpNewLevel := 0;
            DefenceUp(300); // 增加防御力300秒
          end;
        1:
          begin
            m_dwMagDefenceUpAddRate := 0;
            m_btMagDefenceUpNewLevel := 0;
            MagDefenceUp(300); // 增加魔御300秒
          end;
      end;
    end;
    if (StdItem.Anicount = 2) and (not m_boDrinkWineDrunk) then
    begin // 药酒可增加药力值
      // 品质为4以上,药酒增加临时属性 20080626
      if m_nDrinkWineQuality > 4 then
      begin
        case StdItem.Shape of
          8:
            begin // 虎骨酒 增加攻击上限,魔法上限或道术上限2点,效果持续600秒
              case m_btJob of
                0:
                  begin
                    m_wStatusArrValue[0] := 2;
                    m_dwStatusArrTimeOutTick[0] := MyGetTickCount + 600000 { 600 * 1000 };
                  end;
                1:
                  begin
                    m_wStatusArrValue[1] := 2;
                    m_dwStatusArrTimeOutTick[1] := MyGetTickCount + 600000 { 600 * 1000 };
                  end;
                2:
                  begin
                    m_wStatusArrValue[2] := 2;
                    m_dwStatusArrTimeOutTick[2] := MyGetTickCount + 600000 { 600 * 1000 };
                  end;
              end;
            end;
          9:
            begin // 金箔酒  增加生命值上限100点,效果持续600秒
              m_wStatusArrValue[4] := 100;
              m_dwStatusArrTimeOutTick[4] := MyGetTickCount + 600000 { 600 * 1000 };
            end;
          10:
            begin // 活脉酒  增加敏捷2点,效果持续600秒
              m_wStatusArrValue[11] := 2;
              m_dwStatusArrTimeOutTick[11] := MyGetTickCount + 600000 { 600 * 1000 };
            end;
          11:
            begin // 玄参酒  增加防御上限4点,效果持续600秒
              m_wStatusArrValue[9] := 4;
              m_dwStatusArrTimeOutTick[9] := MyGetTickCount + 600000 { 600 * 1000 };
            end;
          12:
            begin // 蛇胆酒  增加魔法值上限200点,效果持续600秒
              m_wStatusArrValue[5] := 200;
              m_dwStatusArrTimeOutTick[5] := MyGetTickCount + 600000 { 600 * 1000 };
            end;
        end;
      end;
      m_dwUseMedicineTime := g_Config.nDecMedicineTime; // 始化使用药酒时间(12小时)
      Inc(m_Alcohol.MedicineValue, UserItem.btValue[2]); // 增加药力值
      if m_Alcohol.MedicineValue >= m_Alcohol.MaxMedicineValue then
      begin // 当前药力值达到当前等级上限时
        Dec(m_Alcohol.MedicineValue, m_Alcohol.MaxMedicineValue);
        case (m_Alcohol.MedicineLevel mod 6) of // 增加永久属性
          0:
            begin // 攻击/魔法/道术上限(看职业)
              case m_btJob of
                0:
                  m_Abil.DC2 := m_Abil.DC2 + 1;
                1:
                  m_Abil.MC2 := m_Abil.MC2 + 1;
                2:
                  m_Abil.SC2 := m_Abil.SC2 + 1;
              end;
            end;
          1:
            m_Abil.MAC1 := m_Abil.MAC1 + 1; // 加魔御下限
          2:
            m_Abil.AC1 := m_Abil.AC1 + 1; // 加防御下限
          3:
            begin // 攻击/魔法/道术下限(看职业)
              case m_btJob of
                0:
                  m_Abil.DC1 := m_Abil.DC1 + 1;
                1:
                  m_Abil.MC1 := m_Abil.MC1 + 1;
                2:
                  m_Abil.SC1 := m_Abil.SC1 + 1;
              end;
            end;
          4:
            m_Abil.MAC2 := m_Abil.MAC2 + 1; // 魔御上限
          5:
            m_Abil.AC2 := m_Abil.AC2 + 1; // 防御上限
        end; // Case (n_MedicineLevel mod 6) of
        if m_Alcohol.MedicineLevel < MAXUPLEVEL then
          Inc(m_Alcohol.MedicineLevel); // 增加等级
        m_Alcohol.MaxMedicineValue := GetMedicineExp(m_Alcohol.MedicineLevel); // 取升级后的等级对应的药力值
        SysMsg('酒劲在周身弥漫,感觉身体状态有所改变', c_Red, t_Hint); // 提示用户
      end;
    end; // if StdItem.Anicount = 2 then
    RecalcAbilitys();
    SendMsg(Self, RM_ABILITYALCOHOL, 0, 0, 0, 0, '');
  end;
  Result := UserItem.Dura <= 0;
end;

procedure TSmartObject.RefAbilNH(); // 内功
begin
  if m_boTrainingNG then
    SendRefMsg(RM_REFABILNG, 0, NativeInt(Self), m_AbilNG.NH, m_AbilNG.MaxNH, '');
end;

function TSmartObject.GetNGAddPower: Integer; // 获取内功伤害增加
begin
  Result := (m_AbilNG.Level div g_Config.nNGLevelPowerAdd_Level) * g_Config.nNGLevelPowerAdd_Power + m_AddNGDamage;
  if Result < 0 then
    Result := 0;
end;

function TSmartObject.GetNGDecPower: Integer; // 获取内功伤害减少
begin
  Result := (m_AbilNG.Level div g_Config.nNGLevelPowerDec_Level) * g_Config.nNGLevelPowerDec_Power + m_DecNGDamage;
  if Result < 0 then
    Result := 0;
end;

procedure TSmartObject.RecalcLevelAbilitysNG();
var
  Int64Value: Int64;
begin
  Int64Value := Round((2 + 2 * (m_AbilNG.Level - 1)) * m_AbilNG.Level / 2 + g_Config.nNGLevelValue { 10 } ) + m_AddNakedAbil[22] +
    m_AddSaveAbil[22];
  if Int64Value < 0 then
    Int64Value := 0
  else if Int64Value > High(m_AbilNG.MaxNH) then
    Int64Value := High(m_AbilNG.MaxNH);
  m_AbilNG.MaxNH := Int64Value;
  if m_AbilNG.NH > m_AbilNG.MaxNH then
    m_AbilNG.NH := m_AbilNG.MaxNH;
end;

function TSmartObject.GetLevelExpNG(nLevel: Integer): LongWord;
begin
  if m_btRaceServer = RC_HEROOBJECT then
  begin
    Result := 200 * nLevel * nLevel * nLevel + 14240 * nLevel * nLevel + 14240 * nLevel + g_Config.nNGHeroLevelExpValue { 62400 };
    // 英雄经验
  end
  else
  begin
    Result := 200 * nLevel * nLevel * nLevel + 13940 * nLevel * nLevel + g_Config.nNGLevelExpValue { 55330 };
  end;
end;

procedure TSmartObject.HasLevelUpNG(nLevel: Integer);
begin
  m_AbilNG.MaxExp := GetLevelExpNG(m_AbilNG.Level);
  RecalcLevelAbilitysNG();
  // RecalcAbilitys();
  SendMsg(Self, RM_ABILITYNG, 0, 0, 0, 0, '');
  SendRefMsg(RM_LEVELUPNG, m_btDirection, m_nCurrX, m_nCurrY, 0, '');
  if m_btRaceServer = RC_PLAYOBJECT then
  begin
    TPlayObject(Self).LevelUpFuncNG();
  end
  else if m_btRaceServer = RC_HEROOBJECT then
  begin
    THeroObject(Self).LevelUpFuncNG;
  end;
end;

procedure TSmartObject.LoadConfigFile();
var
  I, II: Integer;
  Ini: TIniFile;
  sFileName, sItemName: string;
  sLineText: string;
  TempList: TStringList;
  UserItem: pTUserItem;
  UserMagic: pTUserMagic;
  Magic: pTMagic;
  StdItem: pTStdItem;
begin
  if FileExists(m_sConfigFileName) then
    sFileName := m_sConfigFileName
  else
    sFileName := g_Config.sEnvirDir + sDummyConfig + m_sCharName + '.txt';
  // MainOutMessage('TSmartObject.LoadConfigFile1:' +  m_sCharName+' sFileName:'+sFileName);
  if FileExists(sFileName) then
  begin
    // MainOutMessage('TSmartObject.LoadConfigFile2:' +  m_sCharName+' sFileName:'+sFileName);
    Ini := TIniFile.Create(sFileName);
    if Ini <> nil then
    begin
      m_btJob := Ini.ReadInteger('Info', 'Job', 0);
      m_btGender := Ini.ReadInteger('Info', 'Gender', 0);
      m_btHair := Ini.ReadInteger('Info', 'Hair', 0);
      m_Abil.Level := Ini.ReadInteger('Info', 'Level', 1);
      // ;攻击模式(英雄无效)
      // ;0-全体攻击(主动攻击,但不攻击假人) 1-和平攻击(不PK) 2-夫妻攻击 3-师徒攻击 4-编组攻击 5-行会攻击
      // ;6-红名攻击(不主动攻击，受攻击后反击)
      m_btAttatckMode := Ini.ReadInteger('Info', 'AttatckMode', 0);
      // if (m_btAttatckMode > 6) then
      // m_btAttatckMode := 0;
      // 说话机率(英雄无效)
      m_nSayRate := Ini.ReadInteger('Info', 'SayRate', 10);
      // 假人走位攻击几率 chongchong 2015-11-25
      m_nRunAttackRate := Ini.ReadInteger('Info', 'RunAttackRate', 0);
      // 使用物品(道士有效)
      // 1：身上或包裹中都不需要符或毒，就可以直接使用魔法
      // 2：需要身上佩戴符或毒，才可以使用魔法
      // 3：首先使用身上佩戴符或毒，如果身上没有佩戴，就使用包裹中的符或毒。
      m_nDummyNeedMagicItem := Ini.ReadInteger('Info', 'NeedMagicItem', m_nDummyNeedMagicItem);
      Dec(m_nDummyNeedMagicItem);
      if (m_nDummyNeedMagicItem < 0) or (m_nDummyNeedMagicItem > 2) then
        m_nDummyNeedMagicItem := 0;
      m_nItemAddValueRate := Ini.ReadInteger('Info', 'ItemAddValueRate', g_Config.nMonRandomAddValue);
      m_nItemNewAddValueRate := Ini.ReadInteger('Info', 'ItemNewAddValueRate', g_Config.nItemNewAbilMonRandomAddValue);
      m_boDropBagItem := Ini.ReadBool('Info', 'DropBagItem', m_boDropBagItem);
      m_boDropUseItem := Ini.ReadBool('Info', 'DropUseItem', m_boDropUseItem);
      m_nDieDropUseItemRate := Ini.ReadInteger('Info', 'DropUseItemRate', m_nDieDropUseItemRate);
      // 假人是否显示时装 chongchong 2015-03-29
      m_boShowFashion := Ini.ReadBool('Info', 'ShowFashion', m_boShowFashion);
      m_boAutoPickUpItem := Ini.ReadBool('Info', 'AutoPickUpItem', m_boAutoPickUpItem);
      // 假人读取反击延时
      m_dwCounterattackDelay := Ini.ReadInteger('Info', 'CounterattackDelay', m_dwCounterattackDelay);
      // =====================================读取魔法===============================================
      sLineText := Ini.ReadString('Info', 'UseSkill', '');
      TempList := TStringList.Create;
      try
        ExtractStrings([',', ' '], [], PChar(Trim(sLineText)), TempList);
        for II := 0 to TempList.Count - 1 do
        begin
          if (TempList.Strings[II] = '') or (TempList.Strings[II] = ';') then
            Continue;
          Magic := UserEngine.FindDummyMagic(m_btRaceServer = RC_PLAYOBJECT, TempList.Strings[II]);
          if Magic = nil then
            Continue;
          if FindMagic(TempList.Strings[II]) = nil then
          begin
            if (Magic.btJob = 99) or (Magic.btJob = m_btJob) then
            begin
              New(UserMagic);
              UserMagic.MagicInfo := Magic;
              UserMagic.MagicAttr := Magic.MagicAttr;
              UserMagic.wMagIdx := Magic.wMagicID;
              UserMagic.btLevel := Ini.ReadInteger(TempList.Strings[II], 'Level', 3);
              UserMagic.btNewLevel := Ini.ReadInteger(TempList.Strings[II], 'NewLevel', 0);
              UserMagic.btKey := VK_F1;
              UserMagic.nTranPoint := Magic.MaxTrain[3];
              UserMagic.boUsesItemAdd := False;
              m_MagicList.Add(UserMagic);
            end;
          end;
        end;
        TempList.Clear;
        m_OldGroupItem.Clear;
        // =====================================读取包裹物品==============================================
        sLineText := Ini.ReadString('Info', 'BagItems', '');
        ExtractStrings([',', ' '], [], PChar(Trim(sLineText)), TempList);
        for II := 0 to TempList.Count - 1 do
        begin
          if (TempList.Strings[II] = '') or (TempList.Strings[II] = ';') then
            Continue;
          StdItem := UserEngine.GetStdItem(TempList.Strings[II]);
          if StdItem = nil then
            Continue;
          New(UserItem);
          if UserEngine.CopyToUserItemFromName(TempList.Strings[II], UserItem) then
          begin
            if Random(m_nItemAddValueRate) = 0 then
              UserEngine.RandomUpgradeItem(UserItem);
            if StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26] then
            begin
              if (StdItem.Shape = 130) or (StdItem.Shape = 131) or (StdItem.Shape = 132) then // 神秘装备
                UserEngine.GetUnknowItemValue(UserItem);
            end;
            UserEngine.RandomItemNewAbil(m_nItemNewAddValueRate, UserItem); // 新属性
            if not AddItemToBag(UserItem) then
            begin
              Dispose(UserItem);
              Break;
            end;
          end
          else
            Dispose(UserItem);
        end;
        // =====================================读取说话信息===============================================
        TempList.Clear;
        Ini.ReadSection('Say', TempList);
        for I := 0 to TempList.Count - 1 do
        begin
          sLineText := Ini.ReadString('Say', IntToStr(I), '');
          if sLineText <> '' then
            m_SayList.Add(sLineText);
        end;
      finally
        TempList.Free;
      end;
      // =====================================读取身上装备===============================================
      for II := Low(THumanUseItems) to High(THumanUseItems) do
      begin
        sItemName := Ini.ReadString('UseItems', 'UseItems' + IntToStr(II), '');
        StdItem := UserEngine.GetStdItem(sItemName);
        if StdItem = nil then
          Continue;
        New(UserItem);
        if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
        begin
          if Random(m_nItemAddValueRate) = 0 then
            UserEngine.RandomUpgradeItem(UserItem);
          if StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26] then
          begin
            if (StdItem.Shape = 130) or (StdItem.Shape = 131) or (StdItem.Shape = 132) then // 神秘装备
              UserEngine.GetUnknowItemValue(UserItem);
          end;
          UserEngine.RandomItemNewAbil(m_nItemNewAddValueRate, UserItem); // 新属性
          m_UseItems[II] := UserItem^;
          // 增加假人给物品触发@TakeOn 2019-09-29 19:55:03
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            m_sCurrentItemNewName := sItemName;
            g_FunctionNPC.GotoLable(TPlayObject(Self), '@TakeOn' + IntToStr(II), False);
            m_sCurrentItemNewName := '';
          end;
        end;
        Dispose(UserItem);
      end;
      for II := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
      begin
        sItemName := Ini.ReadString('UseItems', 'UseItems' + IntToStr(U_JEWELRYITEM1 + II), '');
        StdItem := UserEngine.GetStdItem(sItemName);
        if StdItem = nil then
          Continue;
        New(UserItem);
        if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
        begin
          if Random(m_nItemAddValueRate) = 0 then
            UserEngine.RandomUpgradeItem(UserItem);
          if StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26] then
          begin
            if (StdItem.Shape = 130) or (StdItem.Shape = 131) or (StdItem.Shape = 132) then
            begin // 神秘装备
              UserEngine.GetUnknowItemValue(UserItem);
            end;
          end;
          UserEngine.RandomItemNewAbil(m_nItemNewAddValueRate, UserItem); // 新属性
          m_JewelryBoxItems[II] := UserItem^;
          // 增加假人给物品触发@TakeOn 2019-09-29 19:55:03
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            TPlayObject(Self).m_nScriptGotoCount := 0;
            m_sCurrentItemNewName := sItemName;
            g_FunctionNPC.GotoLable(TPlayObject(Self), '@TakeOn' + IntToStr(U_JEWELRYITEM1 + II), False);
            m_sCurrentItemNewName := '';
          end;
        end;
        Dispose(UserItem);
      end;
      for II := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
      begin
        sItemName := Ini.ReadString('UseItems', 'UseItems' + IntToStr(U_GODBLESSITEM1 + II), '');
        StdItem := UserEngine.GetStdItem(sItemName);
        if StdItem = nil then
          Continue;
        New(UserItem);
        if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
        begin
          if Random(m_nItemAddValueRate) = 0 then
            UserEngine.RandomUpgradeItem(UserItem);
          if StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26] then
          begin
            if (StdItem.Shape = 130) or (StdItem.Shape = 131) or (StdItem.Shape = 132) then
            begin // 神秘装备
              UserEngine.GetUnknowItemValue(UserItem);
            end;
          end;
          UserEngine.RandomItemNewAbil(m_nItemNewAddValueRate, UserItem); // 新属性
          m_GodBlessItems[II] := UserItem^;
          // 增加假人给物品触发@TakeOn 2019-09-29 19:55:03
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            TPlayObject(Self).m_nScriptGotoCount := 0;
            m_sCurrentItemNewName := sItemName;
            g_FunctionNPC.GotoLable(TPlayObject(Self), '@TakeOn' + IntToStr(U_GODBLESSITEM1 + II), False);
            m_sCurrentItemNewName := '';
          end;
        end;
        Dispose(UserItem);
      end;
      Ini.Free;
    end;
  end;
  m_Abil.HP := m_Abil.MaxHP;
  m_Abil.MP := m_Abil.MaxMP;
  AbilCopyToWAbil();
  m_nCharStatus := GetCharStatus();
  RecalcLevelAbilitys(False);
  RecalcAbilitys();
  (*
    // 假人出生满血 chongchong 2017-04-30
    m_Abil.HP := m_Abil.MaxHP;
    m_Abil.MP := m_Abil.MaxMP;
    m_wAbil.HP := m_wAbil.MaxHP;
    m_wAbil.MP := m_wAbil.MaxMP;
  *)
  m_Abil.MaxExp := GetLevelExp(m_Abil.Level);
end;

{ ------------------------------------------------------------------------------ }
function TSmartObject.Think(): Boolean;
var
  nOldX, nOldY: Integer;
begin
  Result := False;
  if (MyGetTickCount - m_dwThinkTick) > 3 * 1000 then
  begin
    m_dwThinkTick := MyGetTickCount();
    if ((m_Master = nil) or (not InSafeZone) or ((m_Master <> nil) and (Master.m_btRaceServer <> RC_PLAYOBJECT))) then
    // 防止安全区宝宝被挤出安全区
    begin
      if m_PEnvir.GetXYObjCount(m_nCurrX, m_nCurrY) >= 2 then
        m_boDupMode := True;
    end
    // 不让宝宝和NPC叠到一起 2020-09-07 00:01:53
    else if (m_Master <> nil) and (m_PEnvir.GetXYNpcObjCount(m_nCurrX, m_nCurrY) >= 1) then
    begin
      m_boDupMode := True;
    end;
    // 脱机人物重叠时自己移开 chongchong 2016-03-02
    if (m_btRaceServer = RC_PLAYOBJECT) and m_boOffLine then
    begin
      if m_PEnvir.GetXYObjCount(m_nCurrX, m_nCurrY) >= 2 then
        m_boDupMode := True;
    end;
    if (m_TargetCret <> nil) and (not IsProperTarget(m_TargetCret)) then
      DelTargetCreat;
  end;
  if m_boDupMode and (m_TargetCret = nil) then
  begin
    nOldX := m_nCurrX;
    nOldY := m_nCurrY;
    WalkTo(Random(8), False);
    if (nOldX <> m_nCurrX) or (nOldY <> m_nCurrY) then
    begin
      m_boDupMode := False;
      Result := True;
    end;
  end;
end;

function TSmartObject.InMasterRange(nTargetX, nTargetY, nRange: Integer): Boolean; // 是否超过主人范围
var
  nX, nY: Integer;
begin
  Result := True;
  if (m_Master <> nil) then
  begin
    if m_boProtectStatus then
    begin
      nX := m_nProtectTargetX;
      nY := m_nProtectTargetY;
    end
    else
    begin
      nX := m_Master.m_nCurrX;
      nY := m_Master.m_nCurrY;
    end;
    Result := not((Abs(nX - nTargetX) > nRange) or (Abs(nY - nTargetY) > nRange));
  end;
end;

function TSmartObject.RunToNext(nX, nY: Integer): Boolean;
begin
  if m_boForeverFrozen or m_boDingShen or m_boTanHuan then
    Result := False
  else
    Result := RunTo(GetNextDirection(m_nCurrX, m_nCurrY, nX, nY), False);
end;

function TSmartObject.WalkToNext(nX, nY: Integer): Boolean;
begin
  if m_boForeverFrozen or m_boDingShen or m_boTanHuan then
    Result := False
  else
    Result := WalkTo(GetNextDirection(m_nCurrX, m_nCurrY, nX, nY), False);
end;

function TSmartObject.GotoNext(): Boolean;
// label
// REFGOTONEXT;
begin
  Result := False;
  // REFGOTONEXT:
  while (m_nMoveIndex >= 0) and (m_nMoveIndex < Length(m_MovePath)) do
  begin
    if (m_MovePath[m_nMoveIndex].X <> m_nCurrX) or (m_MovePath[m_nMoveIndex].Y <> m_nCurrY) then
    begin
      if (Abs(m_MovePath[m_nMoveIndex].X - m_nCurrX) <= 1) and (Abs(m_MovePath[m_nMoveIndex].Y - m_nCurrY) <= 1) then
      begin
        if ((m_MovePath[m_nMoveIndex].X <> m_nCurrX) or (m_MovePath[m_nMoveIndex].Y <> m_nCurrY)) and
          WalkToNext(m_MovePath[m_nMoveIndex].X, m_MovePath[m_nMoveIndex].Y) then
        begin
          Inc(m_nMoveIndex);
          Result := True;
          if (m_nMoveIndex < Length(m_MovePath)) then
            Exit
          else
            Break;
        end
        else
          Break;
      end
      else
      begin
        if RunToNext(m_MovePath[m_nMoveIndex].X, m_MovePath[m_nMoveIndex].Y) then
        begin
          Inc(m_nMoveIndex);
          Result := True;
          if (m_nMoveIndex < Length(m_MovePath)) then
            Exit
          else
            Break;
        end
        else
          Break;
      end;
    end
    else
    begin
      Inc(m_nMoveIndex);
      // Result := True;
    end;
  end;
  m_nMoveIndex := -1;
  SetLength(m_MovePath, 0);
  m_MovePath := nil;
end;

function TSmartObject.GotoNext(Path: TPath): Boolean;
var
  I, nMoveCount: Integer;
begin
  Result := False;
  nMoveCount := 0;
  if Length(Path) > 0 then
  begin
    for I := 0 to Length(Path) - 1 do
    begin
      if nMoveCount >= 3 then
        Break;
      if (Path[I].X <> m_nCurrX) or (Path[I].Y <> m_nCurrY) then
      begin
        if (Abs(Path[I].X - m_nCurrX) <= 1) and (Abs(Path[I].Y - m_nCurrY) <= 1) then
        begin
          if WalkToNext(Path[I].X, Path[I].Y) then
          begin
            Inc(nMoveCount);
            Result := True;
          end
          else
            Break;
        end
        else
        begin
          if RunToNext(Path[I].X, Path[I].Y) then
          begin
            Inc(nMoveCount);
            Result := True;
          end
          else
            Break;
        end;
      end;
    end;
  end;
  m_RunPos.nAttackCount := 0;
end;

function TSmartObject.GotoNext(nX, nY: Integer; boRun: Boolean): Boolean;
var
  nTargetX, nTargetY: Integer;
  nTempX, nTempY: Integer;
  nDir1, nDir2: Byte;
begin
  if (nX = m_nCurrX) and (nY = m_nCurrY) then
  begin
    Result := True;
    Exit;
  end;
  Result := False;
  if (Abs(nX - m_nCurrX) <= 2) and (Abs(nY - m_nCurrY) <= 2) then
  begin
    if (Abs(nX - m_nCurrX) <= 1) and (Abs(nY - m_nCurrY) <= 1) then
    begin
      Result := WalkToNext(nX, nY);
    end
    else
    begin
      if boRun then
        Result := RunToNext(nX, nY);
    end;
  end;
  if not Result then
  begin
    // 修改 优化算法，不用寻路（寻路算法占用cpu） chongchong 2017-05-04s
    if boRun then
    begin
      if GotoNearRuntoXY(nX, nY, nTargetX, nTargetY) then
      begin
        if ((nX <> nTargetX) or (nY <> nTargetY)) and GotoNearRuntoXY(nTargetX, nTargetY, nX, nY, nTempX, nTempY) then
        begin
          nDir1 := GetNextDirection(m_nCurrX, m_nCurrY, nTargetX, nTargetY);
          nDir2 := GetNextDirection(nTargetX, nTargetY, nTempX, nTempY);
          // 当前步骤和下一步的方向相反，就是来回搞chongchong 2017-10-26
          if GetDifferenceDirection(nDir1) = nDir2 then
          begin
            // OutputDebugString('aaaa');
            m_dwMoveTimeTick := MyGetTickCount;
            Exit;
          end;
        end;
        if (Abs(m_nCurrX - nTargetX) > 1) or (Abs(m_nCurrY - nTargetY) > 1) then
        begin
          Result := RunToNext(nTargetX, nTargetY);
        end
        else
        begin
          Result := WalkToNext(nTargetX, nTargetY);
        end;
      end;
    end
    else
    begin
      if GotoNearGotoXY(nX, nY, nTargetX, nTargetY) then
      begin
        Result := WalkToNext(nTargetX, nTargetY);
      end;
    end;
  end;
  m_RunPos.nAttackCount := 0;
end;

function TSmartObject.GotoNextOne(nX, nY: Integer; boRun: Boolean): Boolean;
var
  nTargetX, nTargetY: Integer;
  nTempX, nTempY: Integer;
  nDir1, nDir2: Byte;
begin
  if (nX = m_nCurrX) and (nY = m_nCurrY) then
  begin
    Result := True;
    Exit;
  end;
  Result := False;
  if (Abs(nX - m_nCurrX) <= 2) and (Abs(nY - m_nCurrY) <= 2) then
  begin
    if (Abs(nX - m_nCurrX) <= 1) and (Abs(nY - m_nCurrY) <= 1) then
    begin
      Result := WalkToNext(nX, nY);
    end
    else
    begin
      if boRun then
        Result := RunToNext(nX, nY)
      else
        Result := WalkToNext(nX, nY);
    end;
  end;
  if not Result then
  begin
    // 修改 优化算法，不用寻路（寻路算法占用cpu） chongchong 2017-05-04
    if boRun then
    begin
      if GotoNearRuntoXY(nX, nY, nTargetX, nTargetY) then
      begin
        if ((nX <> nTargetX) or (nY <> nTargetY)) and GotoNearRuntoXY(nTargetX, nTargetY, nX, nY, nTempX, nTempY) then
        begin
          nDir1 := GetNextDirection(m_nCurrX, m_nCurrY, nTargetX, nTargetY);
          nDir2 := GetNextDirection(nTargetX, nTargetY, nTempX, nTempY);
          // 当前步骤和下一步的方向相反，就是来回搞chongchong 2017-10-26
          if GetDifferenceDirection(nDir1) = nDir2 then
          begin
            // OutputDebugString('aaaa');
            m_dwMoveTimeTick := MyGetTickCount;
            Exit;
          end;
        end;
        if (Abs(m_nCurrX - nTargetX) > 1) or (Abs(m_nCurrY - nTargetY) > 1) then
        begin
          Result := RunToNext(nTargetX, nTargetY);
        end
        else
        begin
          Result := WalkToNext(nTargetX, nTargetY);
        end;
      end;
    end
    else
    begin
      if GotoNearGotoXY(nX, nY, nTargetX, nTargetY) then
      begin
        Result := WalkToNext(nTargetX, nTargetY);
      end;
    end;
  end;
  m_RunPos.nAttackCount := 0;
end;

function TSmartObject.CanWalk(nCurrX, nCurrY, nTargetX, nTargetY: Integer; nDir: Integer; var nStep: Integer;
  boFlag: Boolean): Boolean;
var
  btDir: Byte;
  nX, nY: Integer;
begin
  Result := True;
  nStep := 0;
  if (nDir >= 0) and (nDir <= 7) then
    btDir := nDir
  else
    btDir := GetNextDirection(nCurrX, nCurrY, nTargetX, nTargetY);
  nX := nCurrX;
  nY := nCurrY;
  while True do
  begin
    if (nX = nTargetX) and (nY = nTargetY) then
      Break;
    if GetNextDirection(nX, nY, nTargetX, nTargetY) <> btDir then
      Break;
    if m_PEnvir.GetNextPosition(nX, nY, btDir, 1, nX, nY) then
    begin
      if (not m_PEnvir.CanWalkEx(Self, nX, nY, False)) then
      begin
        Result := False;
        Break;
      end;
      Inc(nStep);
    end
    else
    begin
      Result := False;
      Break;
    end;
  end;
end;

function TSmartObject.CanGotoXY(X1, Y1, X2, Y2: Integer): Boolean;
var
  nStep: Integer;
  Path: TPath;
begin
  Result := False;
  if (not CanWalk(X1, Y1, X2, Y2, -1, nStep, m_btRaceServer <> RC_MOONOBJECT)) then
  begin
    g_FindPath.BaseObject := Self;
    Path := g_FindPath.FindPath1(m_PEnvir, X1, Y1, X2, Y2, m_btRaceServer <> RC_MOONOBJECT, False);
    if Length(Path) <= 0 then
      Exit;
    Result := True;
  end
  else
    Result := True;
end;

