function TAnimalObject.Operate(ProcessMsg: pTProcessMessage): Boolean;
var
  AttackFrom: TBaseObject;
  Code: Integer;
begin
  Code := 0;
  Result := False;
  AttackFrom := TBaseObject(ProcessMsg.nParam3 { AttackBaseObject } );
  if ProcessMsg.wIdent = RM_STRUCK then
  begin
    try
      Code := 1;
      if (TObject(ProcessMsg.BaseObject) = Self) and (AttackFrom <> nil) and (AttackFrom <> Self) then
      begin
        Code := 2;
        SetLastHiter(AttackFrom);
        Code := 3;
        Struck(AttackFrom); { 0FFEC }
        Code := 4;
        BreakHolySeizeMode();
        if (m_Master <> nil) and (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
        begin
          Code := 5;
          if (AttackFrom <> m_Master) and (AttackFrom <> Master) and (AttackFrom.Master <> Master) then
          begin
            Code := 6;
            if (AttackFrom.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              Code := 7;
              // 人物攻击目标，人物灰名
              if AttackFrom.IsProperTarget(Self) then
                m_Master.SetPKFlag(AttackFrom);
            end
            else if (AttackFrom.m_btRaceServer = RC_HEROOBJECT) and (AttackFrom.m_Master <> nil) and
              (AttackFrom.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              Code := 8;
              // 英雄攻击目标，英雄灰名
              if AttackFrom.IsProperTarget(Self) then
                m_Master.SetPKFlag(AttackFrom.m_Master);
            end
            else if (AttackFrom.Master <> nil) and (AttackFrom.Master.m_btRaceServer = RC_PLAYOBJECT) and g_Config.boSlaveKillHumanIncPK
            then
            begin
              Code := 9;
              // 修正和平模式下，攻击别人宝宝灰名 chongchong 2017-06-25
              if AttackFrom.Master.IsProperTarget(Self) then
                m_Master.SetPKFlag(AttackFrom.Master);
            end;
          end;
        end;
        Code := 10;
        if g_Config.boMonSayMsg then
          MonsterSayMsg(AttackFrom, s_UnderFire);
      end;
      Result := True;
    except
      MainOutMessage('[Exception] TAnimalObject:Operate error; Code:' + IntToStr(Code));
    end;
  end
  else
  begin
    Result := inherited Operate(ProcessMsg);
  end;
end;

procedure TAnimalObject.Struck(hiter: TBaseObject);
  function CanSetTarget: Boolean;
  begin
    Result := IsProperTarget(hiter);
    if (m_TargetCret = nil) then
    begin
      Exit;
    end;
    if (m_TargetCret <> nil) and (hiter <> nil) and (m_boDummyObject or (m_btRaceServer in [RC_HEROOBJECT, RC_PLAYMOSTER])) and Result
    then
    begin
      Result := ((Abs(m_nCurrX - m_TargetCret.m_nCurrX) + Abs(m_nCurrY - m_TargetCret.m_nCurrY)) >
        (Abs(m_nCurrX - hiter.m_nCurrX) + Abs(m_nCurrY - hiter.m_nCurrY))) or
        ((m_Master <> nil) and ((Abs(m_Master.m_nCurrX - m_TargetCret.m_nCurrX) + Abs(m_Master.m_nCurrY - m_TargetCret.m_nCurrY))
        > (Abs(m_Master.m_nCurrX - hiter.m_nCurrX) + Abs(m_Master.m_nCurrY - hiter.m_nCurrY))));
    end;
    {
      if (m_TargetCret <> nil) and (m_boDummyObject or (m_btRaceServer in [RC_HEROOBJECT, RC_PLAYMOSTER])) and Result then begin
      Result := (abs(m_nCurrX - m_TargetCret.m_nCurrX) + abs(m_nCurrY - m_TargetCret.m_nCurrY)) > (abs(m_nCurrX - hiter.m_nCurrX) + abs(m_nCurrY - hiter.m_nCurrY));
      end; }
  end;

var
  btDir: Byte;
begin
  m_dwStruckTick := MyGetTickCount;
  if hiter <> nil then
  begin
    if (m_TargetCret = nil) or ((m_TargetCret <> nil) and GetAttackDir(m_TargetCret, btDir)) or (CanSetTarget) or (Random(6) = 0)
    then
    begin
      // Ctrl + R 宝宝锁定目标 chongchong 2016-03-16
      if ((m_Master = nil) or (
        // 下面的逻辑为有主人
        (m_Master <> nil) and ((not m_Master.m_boSlaveRelax) or (m_boGamePet and (not g_Config.boPetSleepControlBySlave))) and (
        // 主人不攻击，别人只攻击宝宝时，宝宝不动 chongchong 2017-06-30
        ((m_Master.m_TargetCret = hiter) or (m_Master.m_LastHiter = hiter) or (m_Master.m_CurrTarget = hiter)) or
        ((hiter.m_Master = nil) and (not(hiter.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT])))))) and IsProperTarget(hiter)
        and (not m_boTarget) then
        SetTargetCreat(hiter);
    end;
  end;

  if m_boAnimal then
  begin
    m_nMeatQuality := m_nMeatQuality - Random(300);
    if m_nMeatQuality < 0 then
      m_nMeatQuality := 0;
  end;
  m_dwHitTick := m_dwHitTick + LongWord(150 - Min(130, m_Abil.Level * 4));
end;

function TAnimalObject.CheckItemExists(ItemObject: TItemObject): TItemObject;
var
  VisibleMapItem: pTVisibleMapItem;
  TempItem: TItemObject;
begin
  Result := nil;
  if (ItemObject <> nil) and (not ItemObject.m_boGhost) then
  begin
    VisibleMapItem := m_VisibleItems.GetItemByKey(NativeInt(ItemObject));
    if (VisibleMapItem <> nil) then
    begin
      TempItem := TItemObject(VisibleMapItem.BaseObject);
      if (TempItem = ItemObject) then
      begin
        Result := TempItem;
      end;
    end;
  end;
end;

function TAnimalObject.CheckDropItemIsOwner(ItemObject: TItemObject): Boolean;
var
  DropItemObj: TBaseObject;
  ErrCode: Integer;
begin
  Result := False;
  ErrCode := 0;
  try
    if ItemObject = nil then
      Exit;
    ErrCode := 1;
    if (ItemObject.m_DropBaseObject <> nil) then
    begin
      ErrCode := 2;
      DropItemObj := TBaseObject(ItemObject.m_DropBaseObject);
      ErrCode := 3;
      // 自己丢的东西
      Result := DropItemObj = Self;
      if Result then
        Exit;
      ErrCode := 4;
      // 主人丢的东西
      if (m_Master <> nil) then
      begin
        ErrCode := 5;
        Result := (DropItemObj = m_Master) or (DropItemObj = Master);
        if Result then
          Exit;
      end;
      ErrCode := 6;
      if (DropItemObj <> nil) and (DropItemObj.m_Master <> nil) then
      begin
        ErrCode := 7;
        // 自己宝宝丢的物品
        Result := DropItemObj.m_Master = Self;
        if Result then
          Exit;
        ErrCode := 8;
        // 自己是宝宝，东西是另一个宝宝丢的
        if (m_Master <> nil) then
        begin
          ErrCode := 9;
          // Result := DropItemObj.Master = Master;
          // 不知道毛原因报错9 2019-11-28 10:34:39
          Result := DropItemObj.m_Master = Master;
        end;
      end;
    end;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.CheckDropItemIsOwner %s; Code: %d', [m_sCharName, ErrCode]));
  end;
end;

function TAnimalObject.CheckPickItemIsOwner(ItemObject: TItemObject): Boolean;
var
  ItemOwnObject: TBaseObject; // 物品所属对象
  ErrCode: Integer;
begin
  Result := False;
  if ItemObject = nil then
    Exit;
  ErrCode := 0;
  try
    // 物品无所属 或所属为自己
    if (ItemObject.m_OfBaseObject = nil) or (ItemObject.m_OfBaseObject = Self) then
    begin
      Result := True;
      Exit;
    end;
    ErrCode := 1;
    ItemOwnObject := TBaseObject(ItemObject.m_OfBaseObject);
    ErrCode := 2;
    // 主人杀怪爆的物品
    if (m_Master <> nil) then
    begin
      Result := (ItemOwnObject = m_Master) or (ItemOwnObject = Master);
      if Result then
        Exit;
    end;
    ErrCode := 3;
    if (ItemOwnObject <> nil) and (ItemOwnObject.m_Master <> nil) then
    begin
      ErrCode := 4;
      // 自己宝宝杀怪爆的物品
      Result := ItemOwnObject.m_Master = Self;
      if Result then
        Exit;
      ErrCode := 5;
      // 自己是宝宝，东西是另一个宝宝杀怪爆的
      if (m_Master <> nil) then
      begin
        ErrCode := 6;
        Result := ItemOwnObject.Master = Master;
      end;
    end;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.CheckPickItemIsOwner %s; Code: %d', [m_sCharName, ErrCode]));
  end;
end;

function TAnimalObject.CheckPickItemIsGroup(ItemObject: TItemObject): Boolean; // 检测某物品是否属于队友（队友打怪爆的物品）
var
  I: Integer;
  GroupMember: TPlayObject;
  ItemOwnObject: TBaseObject; // 物品所属对象
  ErrCode: Integer;
begin
  Result := False;
  ErrCode := 0;
  try
    if ItemObject = nil then
      Exit;
    if ItemObject.m_OfBaseObject = nil then
      Exit;
    ErrCode := 1;
    ItemOwnObject := TBaseObject(ItemObject.m_OfBaseObject);
    if (ItemOwnObject <> nil) and (ItemOwnObject.m_Master <> nil) then
      ItemOwnObject := ItemOwnObject.Master;
    ErrCode := 2;
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      ErrCode := 3;
      if TPlayObject(Self).m_GroupOwner = nil then
        Exit;
      if TPlayObject(Self).m_GroupOwner.m_GroupMembers = nil then
        Exit;
      ErrCode := 4;
{$IF MULTI_THREAD = 1}
      if g_MultiThreadRun then
        TPlayObject(Self).m_GroupOwner.m_GroupMembers.LockR(4);
      try
{$IFEND}
        ErrCode := 5;
        for I := 0 to TPlayObject(Self).m_GroupOwner.m_GroupMembers.Count - 1 do
        begin
          ErrCode := 6;
          GroupMember := TPlayObject(TPlayObject(Self).m_GroupOwner.m_GroupMembers.Objects[I]);
          if GroupMember = ItemOwnObject then
          begin
            Result := True;
            Break;
          end;
        end;
{$IF MULTI_THREAD = 1}
      finally
        if g_MultiThreadRun then
          TPlayObject(Self).m_GroupOwner.m_GroupMembers.UnLockR;
      end;
{$IFEND}
    end;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.CheckPickItemIsGroup %s; Code: %d', [m_sCharName, ErrCode]));
  end;
end;

function TAnimalObject.CheckCanPickItem(ItemObject: TItemObject; IsForcePick: Boolean; IsFromRangePick: Boolean): Boolean;
// 检测物品是否可捡
var
  I: Integer;
  BaseObject: TBaseObject;
  ItemName: string;
  ErrCode: Integer;
  Msg: string;
  HeroObject: THeroObject;
begin
  Result := False;
  ErrCode := 0;
  try
    if ItemObject = nil then
      Exit;
    if ItemObject.m_boGhost then
      Exit;
    if m_PEnvir = nil then
      Exit;
    ErrCode := 1;
    if (MyGetTickCount - ItemObject.m_dwCanPickUpTick) > ItemObject.m_dwFloorItemCanPickUpTime then
    begin
      ItemObject.m_OfBaseObject := nil;
    end;
    if not IsForcePick then
    begin
      ErrCode := 2;
      if CheckDropItemIsOwner(ItemObject) then
        Exit;
      ErrCode := 3;
      // 仅自己可捡，队友不行
      if (ItemObject.m_btReserved = 1) then
      begin
        ErrCode := 4;
        if (not CheckPickItemIsOwner(ItemObject)) then
          Exit;
      end
      else
      begin
        ErrCode := 5;
        if (not CheckPickItemIsOwner(ItemObject)) and (not CheckPickItemIsGroup(ItemObject)) then
          Exit;
      end;
    end;
    ErrCode := 6;
    ItemName := ItemObject.m_sDBName;
    if ItemName = '' then
      ItemName := ItemObject.m_sName;
    ErrCode := 7;
    // 禁止范围拾取物品 2021-01-18
    if IsFromRangePick and IsDisableRangePickItem(ItemName) then
    begin
      Exit;
    end;
    // 增加捡物判断从客户端的内挂发来 2020-03-09 01:33:53
    if m_boGamePet then
    begin
      // 修正人物被杀后爆出物品，小退后，物品的爆出者为空了，这时候无法判断是否为人物爆出 2020-04-05 23:21:09
      if g_Config.boPetOnlyPickMonsterItem and ItemObject.m_boHumDrop then
      begin
        Exit;
      end;
      if (g_nKey_UseClientPickItems = 1) and (((m_btEnableUseClientPickItems = 0) and g_Config.boEnablePetUseClientPickItems) or
        (m_btEnableUseClientPickItems = 1)) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) and
        (not m_Master.m_boDummyObject) then
      begin
        if not IsForcePick then
        begin
          if (TPlayObject(m_Master).m_ClientPickItems = nil) or (TPlayObject(m_Master).m_ClientPickItems.Count = 0) then
          begin
            Exit;
          end;
          if ItemName = '金币' then
          begin
            if not TPlayObject(m_Master).m_ClientPickItems.CheckCanPickItem(0) then
              Exit;
          end
          else
          begin
            if not TPlayObject(m_Master).m_ClientPickItems.CheckCanPickItem(ItemObject.m_UserItem.wIndex) then
              Exit;
          end;
        end;
        // 物品规则：禁止捡起
        if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
        begin
          Exit;
        end;
      end
      else
      begin
        // 物品规则：禁止捡起
        if not IsForcePick then
        begin
          if not CanPickUpItem(ItemObject.m_UserItem.wIndex, ItemName) then
            Exit;
        end
        else
        begin
          { TODO -ochongchong -c新增 : 物品规则 - 禁止捡起【2013-08-18】 }
          if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
          begin
            Exit;
          end;
        end;
      end;
    end
    else if m_btRaceServer = RC_PLAYOBJECT then
    begin
      // NPC命令ThrowItem搞的物品不让人物自动捡 2020-04-06 00:32:48
      if (not IsForcePick) and ItemObject.m_boNpcThrowItem then
      begin
        Exit;
      end;
      if (g_nKey_UseClientPickItems = 1) and (((m_btEnableUseClientPickItems = 0) and g_Config.boEnablePlayerUseClientPickItems)
        or (m_btEnableUseClientPickItems = 1)) and (not m_boDummyObject) then
      begin
        if (not IsForcePick) then
        begin
          if (TPlayObject(Self).m_ClientPickItems = nil) or (TPlayObject(Self).m_ClientPickItems.Count = 0) then
          begin
            Exit;
          end;
          if ItemName = '金币' then
          begin
            if not TPlayObject(Self).m_ClientPickItems.CheckCanPickItem(0) then
              Exit;
          end
          else
          begin
            if not TPlayObject(Self).m_ClientPickItems.CheckCanPickItem(ItemObject.m_UserItem.wIndex) then
              Exit;
          end;
        end;
        // 物品规则：禁止捡起
        if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
        begin
          Exit;
        end;
      end
      else
      begin
        if not IsForcePick then
        begin
          if not CanPickUpItem(ItemObject.m_UserItem.wIndex, ItemName) then
            Exit;
        end
        else
        begin
          // 物品规则：禁止捡起
          if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
          begin
            Msg := AnsiReplaceStr(g_sDisablePickUp, '%Item', ItemObject.m_sName);
            SysMsg(Msg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
            Exit;
          end;
        end;
      end;
    end
    else if m_btRaceServer = RC_HEROOBJECT then
    begin
      // 修正人物被杀后爆出物品，小退后，物品的爆出者为空了，这时候无法判断是否为人物爆出 2020-04-05 23:21:09
      if g_Config.boHeroOnlyPickMonsterItem and ItemObject.m_boHumDrop then
      begin
        Exit;
      end;
      // 禁止英雄包裹
      if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 15) then
      begin
        Exit;
      end;
      if (g_nKey_UseClientPickItems = 1) and (((m_btEnableUseClientPickItems = 0) and g_Config.boEnableHeroUseClientPickItems) or
        (m_btEnableUseClientPickItems = 1)) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) and
        (not m_Master.m_boDummyObject) then
      begin
        if not IsForcePick then
        begin
          if (TPlayObject(m_Master).m_ClientPickItems = nil) or (TPlayObject(m_Master).m_ClientPickItems.Count = 0) then
          begin
            Exit;
          end;
          if ItemName = '金币' then
          begin
            if not TPlayObject(m_Master).m_ClientPickItems.CheckCanPickItem(0) then
              Exit;
          end
          else
          begin
            if not TPlayObject(m_Master).m_ClientPickItems.CheckCanPickItem(ItemObject.m_UserItem.wIndex) then
              Exit;
          end;
        end;
        // 物品规则：禁止捡起
        if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
        begin
          Exit;
        end;
      end
      else
      begin
        if not IsForcePick then
        begin
          if not CanPickUpItem(ItemObject.m_UserItem.wIndex, ItemName) then
            Exit;
        end
        else
        begin
          // 物品规则：禁止捡起
          if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
          begin
            Msg := AnsiReplaceStr(g_sDisablePickUp, '%Item', ItemObject.m_sName);
            SysMsg(Msg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
            Exit;
          end;
        end;
      end;
    end
    else
    begin
      if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        // NPC命令ThrowItem搞的物品不让人物自动捡 2020-04-06 00:32:48
        if (not IsForcePick) and ItemObject.m_boNpcThrowItem then
        begin
          Exit;
        end;
        if (g_nKey_UseClientPickItems = 1) and (((m_btEnableUseClientPickItems = 0) and g_Config.boEnablePlayerUseClientPickItems)
          or (m_btEnableUseClientPickItems = 1)) and (not m_boDummyObject) then
        begin
          if (not IsForcePick) then
          begin
            if (TPlayObject(m_Master).m_ClientPickItems = nil) or (TPlayObject(m_Master).m_ClientPickItems.Count = 0) then
            begin
              Exit;
            end;
            if ItemName = '金币' then
            begin
              if not TPlayObject(m_Master).m_ClientPickItems.CheckCanPickItem(0) then
                Exit;
            end
            else
            begin
              if not TPlayObject(m_Master).m_ClientPickItems.CheckCanPickItem(ItemObject.m_UserItem.wIndex) then
                Exit;
            end;
          end;
          // 物品规则：禁止捡起
          if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
          begin
            Exit;
          end;
        end
        else
        begin
          if not IsForcePick then
          begin
            if not CanPickUpItem(ItemObject.m_UserItem.wIndex, ItemName) then
              Exit;
          end
          else
          begin
            // 物品规则：禁止捡起
            if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
            begin
              Msg := AnsiReplaceStr(g_sDisablePickUp, '%Item', ItemObject.m_sName);
              SysMsg(Msg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
              Exit;
            end;
          end;
        end;
      end
      else if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_HEROOBJECT) then
      begin
        HeroObject := THeroObject(m_Master);
        if (g_nKey_UseClientPickItems = 1) and (((m_btEnableUseClientPickItems = 0) and g_Config.boEnableHeroUseClientPickItems)
          or (m_btEnableUseClientPickItems = 1)) and (HeroObject.m_Master <> nil) and
          (HeroObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) and (not HeroObject.m_Master.m_boDummyObject) then
        begin
          if not IsForcePick then
          begin
            if (TPlayObject(HeroObject.m_Master).m_ClientPickItems = nil) or
              (TPlayObject(HeroObject.m_Master).m_ClientPickItems.Count = 0) then
            begin
              Exit;
            end;
            if ItemName = '金币' then
            begin
              if not TPlayObject(HeroObject.m_Master).m_ClientPickItems.CheckCanPickItem(0) then
                Exit;
            end
            else
            begin
              if not TPlayObject(HeroObject.m_Master).m_ClientPickItems.CheckCanPickItem(ItemObject.m_UserItem.wIndex) then
                Exit;
            end;
          end;
          // 物品规则：禁止捡起
          if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
          begin
            Exit;
          end;
        end
        else
        begin
          if not IsForcePick then
          begin
            if not CanPickUpItem(ItemObject.m_UserItem.wIndex, ItemName) then
              Exit;
          end
          else
          begin
            // 物品规则：禁止捡起
            if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
            begin
              Msg := AnsiReplaceStr(g_sDisablePickUp, '%Item', ItemObject.m_sName);
              SysMsg(Msg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
              Exit;
            end;
          end;
        end;
      end
      else
      begin
        if not IsForcePick then
        begin
          if not CanPickUpItem(ItemObject.m_UserItem.wIndex, ItemName) then
            Exit;
        end
        else
        begin
          // 物品规则：禁止捡起
          if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
          begin
            Msg := AnsiReplaceStr(g_sDisablePickUp, '%Item', ItemObject.m_sName);
            SysMsg(Msg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
            Exit;
          end;
        end;
      end;
    end;
    if not IsFromRangePick then // 范围捡物不要判断物品上面站人/站怪 2020-09-20 11:44:08
    begin
      ErrCode := 8;
      // 有目标站到物品上面，不捡这个物品 2019-05-29 23:03:37
      BaseObject := m_PEnvir.GetMovingObject(ItemObject.m_nMapX, ItemObject.m_nMapY, True);
      ErrCode := 9;
      if (BaseObject <> nil) and (BaseObject <> Self) and (not BaseObject.m_boDeath) then
        Exit;
    end;
    ErrCode := 10;
    for I := 0 to m_PickUpItemFailList.Count - 1 do
    begin
      if m_PickUpItemFailList.Items[I] = ItemObject then
      begin
        Exit;
      end;
    end;
    Result := True;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.CheckCanPickItem %s; Code: %d', [m_sCharName, ErrCode]));
  end;
end;

function TAnimalObject.FindPriorityPickUpItem(IsPickPlayDropItem, IsPickPlayScatterItem: Boolean; PickScatterToPickTime: LongWord)
  : TItemObject; // 查找优先捡取列表
var
  ItemObject: TItemObject;
  ItemObjectA: TItemObject;
  I, n01, n02: Integer;
  VisibleMapItem: pTVisibleMapItem;
  ErrCode: Integer;
  IsOK: Boolean;
  SmartObject: TSmartObject;
  PlayObject: TPlayObject;
  IsUseClientItem: Boolean;
begin
  Result := nil;
  if m_PEnvir = nil then
    Exit;
  ItemObjectA := nil;
  n01 := 9999;
  ErrCode := 0;
  try
    for I := 0 to m_VisibleItems.Count - 1 do
    begin
      VisibleMapItem := m_VisibleItems[I].Item;
      if VisibleMapItem <> nil then
      begin
        ErrCode := 5;
        ItemObject := TItemObject(VisibleMapItem.BaseObject);
        ErrCode := 6;
        if (ItemObject <> nil) and (not ItemObject.m_boGhost) then
        begin
          // 自动捡物加入选项 2020-03-31 21:58:22
          if MyGetTickCount - ItemObject.m_dwCanPickUpTick < PickScatterToPickTime then
            Continue;
          if (ItemObject.m_DropBaseObject <> nil) and (TBaseObject(ItemObject.m_DropBaseObject).m_btRaceServer
            in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
          begin
            if (not ItemObject.m_boDieDrop) then // 人物丢弃物品
            begin
              if not IsPickPlayDropItem then
                Continue;
            end
            else // 人物爆出物品
            begin
              if not IsPickPlayScatterItem then
                Continue;
            end;
          end;
          ErrCode := 7;
          if CheckCanPickItem(ItemObject) then
          begin
            // 增加捡物判断从客户端的内挂发来 2020-03-09 01:33:53
            if m_boGamePet then
            begin
              if (g_nKey_UseClientPickItems = 1) and
                (((m_btEnableUseClientPickItems = 0) and g_Config.boEnablePetUseClientPickItems) or
                (m_btEnableUseClientPickItems = 1)) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
              begin
                if (TPlayObject(m_Master).m_ClientPickItems <> nil) and (TPlayObject(m_Master).m_ClientPickItems.Count > 0) then
                begin
                  if ItemObject.m_sDBName = '金币' then
                    IsOK := TPlayObject(m_Master).m_ClientPickItems.CheckPriorityPickup(0)
                  else
                    IsOK := TPlayObject(m_Master).m_ClientPickItems.CheckPriorityPickup(ItemObject.m_UserItem.wIndex)
                end
                else
                begin
                  IsOK := False;
                end;
              end
              else
              begin
                IsOK := CanPriorityPickUpItem(ItemObject.m_sDBName);
              end;
            end
            else if m_btRaceServer = RC_HEROOBJECT then
            begin
              if (g_nKey_UseClientPickItems = 1) and
                (((m_btEnableUseClientPickItems = 0) and g_Config.boEnableHeroUseClientPickItems) or
                (m_btEnableUseClientPickItems = 1)) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
              begin
                if (TPlayObject(m_Master).m_ClientPickItems <> nil) and (TPlayObject(m_Master).m_ClientPickItems.Count > 0) then
                begin
                  if ItemObject.m_sDBName = '金币' then
                    IsOK := TPlayObject(m_Master).m_ClientPickItems.CheckEnablePickup(0)
                  else
                    IsOK := TPlayObject(m_Master).m_ClientPickItems.CheckEnablePickup(ItemObject.m_UserItem.wIndex);
                end
                else
                begin
                  IsOK := False;
                end;
              end
              else
              begin
                IsOK := CanPriorityPickUpItem(ItemObject.m_sDBName);
              end;
            end
            else if m_Master <> nil then
            begin
              SmartObject := TSmartObject(m_Master);
              PlayObject := nil;
              if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
                PlayObject := TPlayObject(Master)
              else if (SmartObject.Master <> nil) and (SmartObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
                PlayObject := TPlayObject(SmartObject.Master);
              IsUseClientItem := False;
              if (PlayObject <> nil) and (g_nKey_UseClientPickItems = 1) then
              begin
                if SmartObject.m_btRaceServer = RC_HEROOBJECT then
                  IsUseClientItem := (((m_btEnableUseClientPickItems = 0) and g_Config.boEnableHeroUseClientPickItems) or
                    (m_btEnableUseClientPickItems = 1))
                else
                  IsUseClientItem := (((m_btEnableUseClientPickItems = 0) and g_Config.boEnablePlayerUseClientPickItems) or
                    (m_btEnableUseClientPickItems = 1));
              end;
              if IsUseClientItem then
              begin
                if (PlayObject.m_ClientPickItems <> nil) and (PlayObject.m_ClientPickItems.Count > 0) then
                begin
                  if ItemObject.m_sDBName = '金币' then
                    IsOK := PlayObject.m_ClientPickItems.CheckEnablePickup(0)
                  else
                    IsOK := PlayObject.m_ClientPickItems.CheckEnablePickup(ItemObject.m_UserItem.wIndex);
                end
                else
                begin
                  IsOK := False;
                end;
              end
              else
              begin
                IsOK := CanPriorityPickUpItem(ItemObject.m_sDBName);
              end;
            end
            else
            begin
              IsOK := CanPriorityPickUpItem(ItemObject.m_sDBName);
            end;
            if IsOK then
            begin
              ErrCode := 8;
              if (Abs(VisibleMapItem.nX - m_nCurrX) <= m_nViewRange) and (Abs(VisibleMapItem.nY - m_nCurrY) <= m_nViewRange) then
              begin
                ErrCode := 9;
                n02 := Abs(VisibleMapItem.nX - m_nCurrX) + Abs(VisibleMapItem.nY - m_nCurrY);
                if n02 < n01 then
                begin
                  ErrCode := 10;
                  n01 := n02;
                  ItemObjectA := ItemObject;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
    ErrCode := 11;
    Result := ItemObjectA;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.FindPriorityPickUpItem %s; Code: %d', [m_sCharName, ErrCode]));
  end;
end;

function TAnimalObject.FindPickUpItem(IsPickPlayDropItem, IsPickPlayScatterItem: Boolean; PickScatterToPickTime: LongWord)
  : TItemObject;
var
  ItemObject: TItemObject;
  ItemObjectA: TItemObject;
  I, n01, n02: Integer;
  VisibleMapItem: pTVisibleMapItem;
  ErrCode: Integer;
begin
  Result := nil;
  ErrCode := 0;
  try
    ErrCode := 1;
    if m_PEnvir = nil then
      Exit;
    ItemObjectA := nil;
    n01 := 9999;
    ErrCode := 2;
    for I := 0 to m_VisibleItems.Count - 1 do
    begin
      VisibleMapItem := m_VisibleItems[I].Item;
      ErrCode := 5;
      if VisibleMapItem = nil then
        Continue;
      ErrCode := 6;
      ItemObject := TItemObject(VisibleMapItem.BaseObject);
      if (ItemObject <> nil) and (not ItemObject.m_boGhost) then
      begin
        // 自动捡物加入选项 2020-03-31 21:58:22
        if MyGetTickCount - ItemObject.m_dwCanPickUpTick < PickScatterToPickTime then
          Continue;
        if (ItemObject.m_DropBaseObject <> nil) and (TBaseObject(ItemObject.m_DropBaseObject).m_btRaceServer
          in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
        begin
          if (not ItemObject.m_boDieDrop) then // 人物丢弃物品
          begin
            if not IsPickPlayDropItem then
              Continue;
          end
          else // 人物爆出物品
          begin
            if not IsPickPlayScatterItem then
              Continue;
          end;
        end;
        ErrCode := 7;
        if CheckCanPickItem(ItemObject) then
        begin
          ErrCode := 8;
          if (Abs(VisibleMapItem.nX - m_nCurrX) <= 6) and (Abs(VisibleMapItem.nY - m_nCurrY) <= 6) then
          begin
            ErrCode := 9;
            if (ItemObject <> m_SelItemObject) then
            begin
              ErrCode := 10;
              n02 := Abs(VisibleMapItem.nX - m_nCurrX) + Abs(VisibleMapItem.nY - m_nCurrY);
              if n02 < n01 then
              begin
                n01 := n02;
                ItemObjectA := ItemObject;
              end;
            end;
          end;
        end;
      end;
    end;
    ErrCode := 11;
    Result := ItemObjectA;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.FindPickUpItem %s; Code: %d', [m_sCharName, ErrCode]));
  end;
end;

function TAnimalObject.DoPickUpItem(nX, nY: Integer; AItemObject: TItemObject; IsGamePet, IsToGamePetBag, IsForcePick: Boolean;
  IsFromRangePick: Boolean): Boolean;
var
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  ItemObject: TItemObject;
  SmartObject: TSmartObject;
  ToObject: TSmartObject;
  PlayObject: TPlayObject;
  OverLapItem: pTUserItem;
  Msg: string;
  ItemIdx, ErrCode: Integer;
begin
  Result := False;
  ErrCode := 0;
  if m_PEnvir = nil then
    Exit;
  try
    ErrCode := 1;
    ItemObject := m_PEnvir.GetItem(nX, nY, AItemObject);
    if (ItemObject = nil) or ItemObject.m_boGhost then
      Exit;
    ErrCode := 2;
    // 骑马 - 不能捡物品 chongchong 2013-10-16
    if (m_btRaceServer = RC_PLAYOBJECT) then
    begin
      PlayObject := TPlayObject(Self);
      if PlayObject.m_boOnHorse then
      begin
        if not PlayObject.m_boDummyObject then
          SysMsg(g_sHorseNotPickup, c_Red, t_Hint);
        Exit;
      end;
      ErrCode := 3;
      { TODO -ochongchong -c新增 : 物品规则 - 禁止捡起【2013-08-18】(英雄) }
      if (Length(ItemObject.m_sName) > 0) and g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 20) then
      begin
        if not PlayObject.m_boDummyObject then
        begin
          Msg := AnsiReplaceStr(g_sDisablePickUp, '%Item', ItemObject.m_sName);
          SysMsg(Msg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
        end;
        Exit;
      end;
    end;
    ErrCode := 4;
    // 捡钱
    SmartObject := nil;
    PlayObject := nil;
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      SmartObject := TSmartObject(Self);
      PlayObject := TPlayObject(Self);
    end
    else if m_btRaceServer = RC_HEROOBJECT then
    begin
      SmartObject := TSmartObject(Self);
      if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
        PlayObject := TPlayObject(m_Master);
    end
    else if (m_Master <> nil) and (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
    begin
      SmartObject := TSmartObject(m_Master);
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        PlayObject := TPlayObject(Master)
      else if (SmartObject.Master <> nil) and (SmartObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
        PlayObject := TPlayObject(SmartObject.Master);
    end;
    if (m_btRaceServer = RC_HEROOBJECT) and THeroObject(Self).m_boAutoPickItemToMasterBag then
      ToObject := TSmartObject(m_Master)
    else
      ToObject := TSmartObject(SmartObject);
    if (PlayObject = nil) then
      Exit;
    ErrCode := 5;
    if (CompareText(ItemObject.m_sName, sSTRING_GOLDNAME) = 0) then
    begin
      ErrCode := 6;
      if m_PEnvir.DeleteFromMap(nX, nY, ItemObject) then
      begin
        ErrCode := 7;
        if PlayObject.IncGold(ItemObject.m_nCount) then
        begin
          ItemIdx := ItemObject.m_UserItem.wIndex;
          ErrCode := 8;
          ItemObject.MakeGhost;
          SendRefMsg(RM_ITEMHIDE, 0, NativeInt(ItemObject), nX, nY, '');
          PlayObject.GoldChanged;
          ErrCode := 9;
          m_nScatterItemX := m_nCurrX;
          m_nScatterItemY := m_nCurrY;
          m_sScatterItemName := sSTRING_GOLDNAME;
          ErrCode := 10;
          if PlayObject = Self then
          begin
            ErrCode := 11;
            if (g_FunctionNPC <> nil) and g_ItemRules.Get(ItemIdx, 21) then
            begin
              ErrCode := 12;
              PlayObject.m_nScriptGotoCount := 0;
              m_sPickUpOrDropItemName := sSTRING_GOLDNAME;
              m_nPickUpOrDropItemMakeIndex := 0;
              m_PickUpOrDropItem.MakeIndex := 0;
              m_PickUpOrDropItem.wIndex := 0;
              if IsGamePet then
              begin
                ErrCode := 13;
                g_FunctionNPC.GotoLable(PlayObject, '@PickUpItem', False);
              end
              else if m_btRaceServer = RC_HEROOBJECT then
              begin
                ErrCode := 14;
                g_FunctionNPC.GotoLable(PlayObject, '@H.PickUpItems', False);
              end
              else
              begin
                ErrCode := 15;
                g_FunctionNPC.GotoLable(PlayObject, '@PickUpItem', False);
              end;
            end;
            ErrCode := 16;
            PlayObject.m_nScriptGotoCount := 0;
            m_sPickUpOrDropItemName := sSTRING_GOLDNAME;
            m_nPickUpOrDropItemMakeIndex := 0;
            m_PickUpOrDropItem.MakeIndex := 0;
            m_PickUpOrDropItem.wIndex := 0;
            ErrCode := 17;
            if IsGamePet then
            begin
              ErrCode := 18;
              g_FunctionNPC.GotoLable(PlayObject, '@PickUpItemEx', False);
            end
            else if m_btRaceServer = RC_HEROOBJECT then
            begin
              ErrCode := 19;
              g_FunctionNPC.GotoLable(PlayObject, '@H.PickUpItemEx', False);
            end
            else
            begin
              ErrCode := 20;
              g_FunctionNPC.GotoLable(PlayObject, '@PickUpItemEx', False);
            end;
            ErrCode := 21;
            OnMapNotifyEvent(Self, mePickUpItem, sSTRING_GOLDNAME); // 捡物品事件
          end;
          ErrCode := 22;
          if g_boGameLogGold then
          begin
            ErrCode := 23;
            // 注释日志 chongchong 2017-10-09
            AddGameDataLog(LOG_ItemPickup, LOG_GoldChange, Self, sSTRING_GOLDNAME, 0, '0', m_nGold, ItemObject.m_nCount);
          end;
          Result := True;
        end
        else
        begin
          ErrCode := 24;
          if m_PEnvir.AddToMap(nX, nY, ItemObject) <> ItemObject then
            ItemObject.MakeGhost;
        end;
      end;
      Exit;
    end;
    ErrCode := 25;
    if not CheckCanPickItem(ItemObject, IsForcePick, IsFromRangePick) then
      Exit;
    ErrCode := 26;
    StdItem := UserEngine.GetStdItem(ItemObject.m_UserItem.wIndex);
    if (StdItem = nil) then
      Exit;
    ErrCode := 27;
    if not m_PEnvir.DeleteFromMap(nX, nY, ItemObject) then
      Exit;
    ErrCode := 28;
    if IsGamePet then
    begin
      ErrCode := 29;
      if not IsToGamePetBag then
      begin
        ErrCode := 30;
        // 捡起的物品为绑定物品时，不要叠加到现有物品上面 chongchong 2014-09-26
        if ItemObject.m_UserItem.boIsBind then
          OverLapItem := nil
        else
          OverLapItem := OverLapItems(PlayObject, StdItem, ItemObject.m_UserItem.Dura);
        ErrCode := 31;
        if OverLapItem <> nil then
        begin
          UserItem := OverLapItem;
        end
        else
        begin
          ErrCode := 32;
          New(UserItem);
          UserItem^ := ItemObject.m_UserItem;
          PlayObject.m_ItemList.Add(UserItem);
          ErrCode := 33;
          PlayObject.SendAddItem(UserItem);
          // if not m_boDummyObject then
          // begin
          // if ToObject.m_btRaceServer = RC_PLAYOBJECT then
          // TPlayObject(ToObject).SendAddItem(UserItem)
          // else
          // if ToObject.m_btRaceServer = RC_HEROOBJECT then
          // THeroObject(ToObject).SendAddItem(UserItem)
          // end;
        end;
        ErrCode := 34;
        // 修正英雄捡了物品后，地图上还保留假象 chongchong 2018-01-07
        SendRefMsg(RM_ITEMHIDE, 0, NativeInt(ItemObject), nX, nY, '');
        ItemObject.MakeGhost;
        ErrCode := 35;
        PlayObject.m_WAbil.Weight := ToObject.RecalcBagWeight();
        PlayObject.SendUpdateMsg(ToObject, RM_WEIGHTCHANGED, 0, 0, 0, 0, '');
        ErrCode := 36;
        PlayObject.m_nScatterItemX := m_nCurrX;
        PlayObject.m_nScatterItemY := m_nCurrY;
        PlayObject.m_sScatterItemName := StdItem.Name;
        ErrCode := 37;
        if (g_FunctionNPC <> nil) and g_ItemRules.Get(UserItem.wIndex, 21) then
        begin
          ErrCode := 38;
          PlayObject.m_nScriptGotoCount := 0;
          PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          PlayObject.m_PickUpOrDropItem := UserItem^;
          PlayObject.m_PickUpOrDropItemIsPetBag := False;
          ErrCode := 39;
          g_FunctionNPC.GotoLable(PlayObject, '@PickUpItem', False);
          PlayObject.m_PickUpOrDropItemIsPetBag := False;
        end;
        ErrCode := 40;
        if (g_FunctionNPC <> nil) and g_ItemRules.Get(UserItem.wIndex, 25) then
        begin
          ErrCode := 41;
          PlayObject.m_nScriptGotoCount := 0;
          PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          PlayObject.m_PickUpOrDropItem := UserItem^;
          PlayObject.m_PickUpOrDropItemIsPetBag := False;
          ErrCode := 42;
          g_FunctionNPC.GotoLable(PlayObject, '@PickUpItems' + IntToStr(UserItem.wIndex - 1), False);
          PlayObject.m_PickUpOrDropItemIsPetBag := False;
        end;
        ErrCode := 43;
        PlayObject.m_nScriptGotoCount := 0;
        PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
        PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
        PlayObject.m_PickUpOrDropItem := UserItem^;
        PlayObject.m_PickUpOrDropItemIsPetBag := False;
        ErrCode := 44;
        g_FunctionNPC.GotoLable(PlayObject, '@PickUpItemEx', False);
        PlayObject.m_PickUpOrDropItemIsPetBag := False;
        ErrCode := 45;
        OnMapNotifyEvent(PlayObject, mePickUpItem, StdItem.Name); // 捡物品事件
        ErrCode := 46;
        if not IsCheapStuff(StdItem.StdMode) then
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            ErrCode := 47;
            AddGameDataLog(LOG_ItemPickup, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0');
          end;
        end;
        Result := True;
      end
      else
      begin
        ErrCode := 48;
        // 捡起的物品为绑定物品时，不要叠加到现有物品上面 chongchong 2014-09-26
        if ItemObject.m_UserItem.boIsBind then
          OverLapItem := nil
        else
          OverLapItem := OverLapGamePetBagItems(PlayObject, StdItem, ItemObject.m_UserItem.Dura);
        ErrCode := 49;
        if OverLapItem <> nil then
        begin
          UserItem := OverLapItem;
        end
        else
        begin
          ErrCode := 50;
          New(UserItem);
          UserItem^ := ItemObject.m_UserItem;
          PlayObject.m_GamePetBagItems.Add(UserItem);
          ErrCode := 51;
          if not m_boDummyObject then
          begin
            PlayObject.SendAddPetItem(UserItem)
          end;
        end;
        ErrCode := 52;
        // 修正英雄捡了物品后，地图上还保留假象 chongchong 2018-01-07
        SendRefMsg(RM_ITEMHIDE, 0, NativeInt(ItemObject), nX, nY, '');
        ItemObject.MakeGhost;
        ErrCode := 53;
        SmartObject.m_WAbil.Weight := RecalcBagWeight();
        PlayObject.m_nScatterItemX := m_nCurrX;
        PlayObject.m_nScatterItemY := m_nCurrY;
        PlayObject.m_sScatterItemName := StdItem.Name;
        ErrCode := 54;
        if (g_FunctionNPC <> nil) and g_ItemRules.Get(UserItem.wIndex, 21) then
        begin
          ErrCode := 55;
          PlayObject.m_nScriptGotoCount := 0;
          PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          PlayObject.m_PickUpOrDropItem := UserItem^;
          ErrCode := 56;
          PlayObject.m_PickUpOrDropItemIsPetBag := True;
          try
            g_FunctionNPC.GotoLable(PlayObject, '@PickUpItem', False);
          finally
            PlayObject.m_PickUpOrDropItemIsPetBag := False;
          end;
        end;
        ErrCode := 57;
        if (g_FunctionNPC <> nil) and g_ItemRules.Get(UserItem.wIndex, 25) then
        begin
          ErrCode := 58;
          PlayObject.m_nScriptGotoCount := 0;
          PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          PlayObject.m_PickUpOrDropItem := UserItem^;
          PlayObject.m_PickUpOrDropItemIsPetBag := True;
          ErrCode := 59;
          try
            g_FunctionNPC.GotoLable(PlayObject, '@PickUpItems' + IntToStr(UserItem.wIndex - 1), False);
          finally
            PlayObject.m_PickUpOrDropItemIsPetBag := False;
          end;
        end;
        ErrCode := 60;
        PlayObject.m_nScriptGotoCount := 0;
        PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
        PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
        PlayObject.m_PickUpOrDropItem := UserItem^;
        PlayObject.m_PickUpOrDropItemIsPetBag := True;
        ErrCode := 61;
        try
          g_FunctionNPC.GotoLable(PlayObject, '@PickUpItemEx', False);
        finally
          PlayObject.m_PickUpOrDropItemIsPetBag := False;
        end;
        ErrCode := 62;
        OnMapNotifyEvent(PlayObject, mePickUpItem, StdItem.Name); // 捡物品事件
        ErrCode := 63;
        if not IsCheapStuff(StdItem.StdMode) then
        begin
          ErrCode := 64;
          if StdItem.NeedIdentify = 1 then
          begin
            AddGameDataLog(LOG_ItemPickup, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0');
          end;
        end;
        Result := True;
      end;
    end
    else
    begin
      ErrCode := 65;
      // 捡起的物品为绑定物品时，不要叠加到现有物品上面 chongchong 2014-09-26
      if ItemObject.m_UserItem.boIsBind then
        OverLapItem := nil
      else
        OverLapItem := OverLapItems(ToObject, StdItem, ItemObject.m_UserItem.Dura);
      ErrCode := 66;
      if OverLapItem <> nil then
      begin
        UserItem := OverLapItem;
        ToObject.WeightChanged;
      end
      else
      begin
        ErrCode := 67;
        New(UserItem);
        UserItem^ := ItemObject.m_UserItem;
        ToObject.m_ItemList.Add(UserItem);
        ErrCode := 68;
        if not m_boDummyObject then
        begin
          if ToObject.m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(ToObject).SendAddItem(UserItem)
          else if ToObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(ToObject).SendAddItem(UserItem);
        end;
        ErrCode := 69;
        ToObject.WeightChanged;
      end;
      ErrCode := 70;
      // 修正英雄捡了物品后，地图上还保留假象 chongchong 2018-01-07
      SendRefMsg(RM_ITEMHIDE, 0, NativeInt(ItemObject), nX, nY, '');
      ItemObject.MakeGhost;
      ErrCode := 71;
      ToObject.m_WAbil.Weight := RecalcBagWeight();
      PlayObject.m_nScatterItemX := m_nCurrX;
      PlayObject.m_nScatterItemY := m_nCurrY;
      PlayObject.m_sScatterItemName := StdItem.Name;
      ErrCode := 72;
      if (SmartObject.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        if (g_FunctionNPC <> nil) and g_ItemRules.Get(UserItem.wIndex, 21) then
        begin
          ErrCode := 73;
          PlayObject.m_nScriptGotoCount := 0;
          PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          SmartObject.m_PickUpOrDropItem := UserItem^;
          ErrCode := 74;
          g_FunctionNPC.GotoLable(PlayObject, '@PickUpItem', False);
        end;
        ErrCode := 75;
        if (g_FunctionNPC <> nil) and g_ItemRules.Get(UserItem.wIndex, 25) then
        begin
          ErrCode := 75;
          PlayObject.m_nScriptGotoCount := 0;
          PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          SmartObject.m_PickUpOrDropItem := UserItem^;
          ErrCode := 76;
          g_FunctionNPC.GotoLable(PlayObject, '@PickUpItems' + IntToStr(UserItem.wIndex - 1), False);
        end;
        ErrCode := 77;
        PlayObject.m_nScriptGotoCount := 0;
        PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
        PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
        SmartObject.m_PickUpOrDropItem := UserItem^;
        ErrCode := 78;
        g_FunctionNPC.GotoLable(PlayObject, '@PickUpItemEx', False);
      end
      // 触发ID chongchong 2015-01-05
      else if (SmartObject.m_btRaceServer = RC_HEROOBJECT) and (g_FunctionNPC <> nil) then
      begin
        ErrCode := 80;
        if g_ItemRules.Get(UserItem.wIndex, 25) then
        begin
          ErrCode := 81;
          PlayObject.m_nScriptGotoCount := 0;
          PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          SmartObject.m_PickUpOrDropItem := UserItem^;
          ErrCode := 82;
          g_FunctionNPC.GotoLable(PlayObject, '@H.PickUpItems' + IntToStr(UserItem.wIndex - 1), False);
        end;
        ErrCode := 83;
        PlayObject.m_nScriptGotoCount := 0;
        PlayObject.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
        PlayObject.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
        SmartObject.m_PickUpOrDropItem := UserItem^;
        ErrCode := 84;
        g_FunctionNPC.GotoLable(PlayObject, '@H.PickUpItemEx', False);
      end;
      ErrCode := 85;
      OnMapNotifyEvent(PlayObject, mePickUpItem, StdItem.Name); // 捡物品事件
      ErrCode := 86;
      if not IsCheapStuff(StdItem.StdMode) then
      begin
        if StdItem.NeedIdentify = 1 then
        begin
          ErrCode := 87;
          AddGameDataLog(LOG_ItemPickup, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0');
        end;
      end;
      Result := True;
    end;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.DoPickUpItem %s; Code: %d', [m_sCharName, ErrCode]))
  end;
end;

function TAnimalObject.GamepetPickRangeItem(IsPickAll: Boolean; IsPickPlayDropItem, IsPickPlayScatterItem: Boolean;
  PickScatterToPickTime: LongWord): Boolean;
var
  ItemObject: TItemObject;
  I: Integer;
  VisibleMapItem: pTVisibleMapItem;
  ErrCode: Integer;
  Player: TPlayObject;
  IsToGamePetBag: Boolean;
  boEnoughBag: Boolean;
  StdItem: pTStdItem;
  AddWeight: Integer;
begin
  Result := False;
  if not m_boGamePet then
    Exit;
  if (m_Master = nil) or (m_Master.m_btRaceServer <> RC_PLAYOBJECT) then
    Exit;
  if m_boDeath or m_boGhost then
  begin
    m_SelItemObject := nil;
    m_PickUpItemFailList.Clear;
    Exit;
  end;
  if m_PEnvir = nil then
    Exit;
  Player := TPlayObject(m_Master);
  ErrCode := 0;
  try
    ErrCode := 2;
    for I := 0 to m_VisibleItems.Count - 1 do
    begin
      VisibleMapItem := m_VisibleItems[I].Item;
      ErrCode := 3;
      if VisibleMapItem = nil then
        Continue;
      ErrCode := 4;
      ItemObject := TItemObject(VisibleMapItem.BaseObject);
      if (ItemObject <> nil) and (not ItemObject.m_boGhost) then
      begin
        // 自动捡物加入选项 2020-03-31 21:58:22
        if MyGetTickCount - ItemObject.m_dwCanPickUpTick < PickScatterToPickTime then
          Continue;
        if (ItemObject.m_DropBaseObject <> nil) and (TBaseObject(ItemObject.m_DropBaseObject).m_btRaceServer
          in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
        begin
          if (not ItemObject.m_boDieDrop) then // 人物丢弃物品
          begin
            if not IsPickPlayDropItem then
              Continue;
          end
          else // 人物爆出物品
          begin
            if not IsPickPlayScatterItem then
              Continue;
          end;
        end;
        ErrCode := 5;
        if CheckCanPickItem(ItemObject, False, True) then
        begin
          ErrCode := 6;
          if (Abs(VisibleMapItem.nX - m_nCurrX) <= g_Config.btPetPickupRange) and
            (Abs(VisibleMapItem.nY - m_nCurrY) <= g_Config.btPetPickupRange) then
          begin
            boEnoughBag := True;
            IsToGamePetBag := False;
            ErrCode := 7;
            // 不是直接放到主人背包
            if (not g_Config.boPetPickupToMaster) then
            begin
              if g_ItemRules.Get(ItemObject.m_UserItem.wIndex, 31) then // 禁止宠物背包
              begin
                if g_Config.boPetPickupFullToMaster then
                begin
                  boEnoughBag := Player.IsEnoughBag;
                  IsToGamePetBag := False;
                end
              end
              else
              begin
                if Player.m_GamePetBagItems.Count < MAX_GAMEPET_BAG_COUNT then
                  IsToGamePetBag := True
                else if g_Config.boPetPickupFullToMaster then
                begin
                  boEnoughBag := Player.IsEnoughBag;
                  IsToGamePetBag := False;
                end
                else
                begin
                  boEnoughBag := False;
                  IsToGamePetBag := False;
                end;
              end;
            end
            else
            begin
              boEnoughBag := Player.IsEnoughBag;
              IsToGamePetBag := False;
            end;
            ErrCode := 7;
            if not boEnoughBag then
            begin
              ErrCode := 8;
              m_SelItemObject := nil;
              m_PickUpItemFailList.Clear;
              Exit;
            end;
            // 人物负重不够时不要往人物背包捡物品 2019-12-31 23:44:15
            if not IsToGamePetBag then
            begin
              StdItem := UserEngine.GetStdItem(ItemObject.m_UserItem.wIndex);
              if StdItem <> nil then
              begin
                ErrCode := 81;
                AddWeight := OverLapItemWeight(StdItem, ItemObject.m_UserItem.Dura);
                ErrCode := 82;
                if Player.m_WAbil.Weight + AddWeight > Player.m_WAbil.MaxWeight then
                begin
                  m_SelItemObject := nil;
                  Exit;
                end;
              end;
            end;
            // 和自己坐标相同可以捡取
            if DoPickUpItem(VisibleMapItem.nX, VisibleMapItem.nY, ItemObject, True, IsToGamePetBag, False, True) then
            begin
              ErrCode := 21;
              m_SelItemObject := nil;
              m_dwPickupOKTick := MyGetTickCount;
              Result := True;
              if not IsPickAll then
                Exit;
            end
          end;
        end;
      end;
    end;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.GamepetPickRangeItem %s; Code: %d', [m_sCharName, ErrCode]));
  end;
end;

function TAnimalObject.OtherPickRangeItem(IsPickAll: Boolean; IsPickPlayDropItem, IsPickPlayScatterItem: Boolean;
  PickScatterToPickTime: LongWord): Boolean;
var
  ItemObject: TItemObject;
  I: Integer;
  VisibleMapItem: pTVisibleMapItem;
  ErrCode: Integer;
  SmartObject: TSmartObject;
  StdItem: pTStdItem;
  AddWeight, PickRange: Integer;
begin
  Result := False;
  SmartObject := nil;
  PickRange := 0;
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
  begin
    SmartObject := TSmartObject(Self);
    PickRange := SmartObject.m_btSelfAutoPickItemRange;
  end
  else if (m_Master <> nil) and (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
  begin
    SmartObject := TSmartObject(m_Master);
    PickRange := SmartObject.m_btSlaveAutoPickItemRange;
  end;
  if (m_Master <> nil) and (m_btRaceServer = RC_HEROOBJECT) and (THeroObject(Self).m_boAutoPickItemToMasterBag) then
    SmartObject := TSmartObject(m_Master);
  if SmartObject = nil then
    Exit;
  if m_boDeath or m_boGhost then
  begin
    m_SelItemObject := nil;
    m_PickUpItemFailList.Clear;
    Exit;
  end;
  if m_PEnvir = nil then
    Exit;
  ErrCode := 0;
  try
    ErrCode := 2;
    for I := 0 to m_VisibleItems.Count - 1 do
    begin
      VisibleMapItem := m_VisibleItems[I].Item;
      ErrCode := 3;
      if VisibleMapItem = nil then
        Continue;
      ErrCode := 4;
      ItemObject := TItemObject(VisibleMapItem.BaseObject);
      if (ItemObject <> nil) and (not ItemObject.m_boGhost) then
      begin
        // 自动捡物加入选项 2020-03-31 21:58:22
        if MyGetTickCount - ItemObject.m_dwCanPickUpTick < PickScatterToPickTime then
          Continue;
        if (ItemObject.m_DropBaseObject <> nil) and (TBaseObject(ItemObject.m_DropBaseObject).m_btRaceServer
          in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
        begin
          if (not ItemObject.m_boDieDrop) then // 人物丢弃物品
          begin
            if not IsPickPlayDropItem then
              Continue;
          end
          else // 人物爆出物品
          begin
            if not IsPickPlayScatterItem then
              Continue;
          end;
        end;
        ErrCode := 5;
        if CheckCanPickItem(ItemObject, False, True) then
        begin
          ErrCode := 6;
          if (Abs(VisibleMapItem.nX - m_nCurrX) <= PickRange) and (Abs(VisibleMapItem.nY - m_nCurrY) <= PickRange) then
          begin
            ErrCode := 7;
            if not SmartObject.IsEnoughBag then
            begin
              ErrCode := 8;
              m_SelItemObject := nil;
              m_PickUpItemFailList.Clear;
              Exit;
            end;
            // 人物负重不够时不要往人物背包捡物品 2019-12-31 23:44:15
            StdItem := UserEngine.GetStdItem(ItemObject.m_UserItem.wIndex);
            if StdItem <> nil then
            begin
              ErrCode := 81;
              AddWeight := OverLapItemWeight(StdItem, ItemObject.m_UserItem.Dura);
              ErrCode := 82;
              if SmartObject.m_WAbil.Weight + AddWeight > SmartObject.m_WAbil.MaxWeight then
              begin
                m_SelItemObject := nil;
                Exit;
              end;
            end;
            // 和自己坐标相同可以捡取
            if DoPickUpItem(VisibleMapItem.nX, VisibleMapItem.nY, ItemObject, False, False, False, True) then
            begin
              ErrCode := 21;
              m_SelItemObject := nil;
              m_dwPickupOKTick := MyGetTickCount;
              Result := True;
              if not IsPickAll then
                Exit;
            end
          end;
        end;
      end;
    end;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.GamepetPickRangeItem %s; Code: %d', [m_sCharName, ErrCode]));
  end;
end;

function TAnimalObject.PickRangeItem(IsPickAll: Boolean; IsPickPlayDropItem, IsPickPlayScatterItem: Boolean;
  PickScatterToPickTime: LongWord): Boolean;
begin
  if m_boGamePet then
    Result := GamepetPickRangeItem(IsPickAll, IsPickPlayDropItem, IsPickPlayScatterItem, PickScatterToPickTime)
  else
    Result := OtherPickRangeItem(IsPickAll, IsPickPlayDropItem, IsPickPlayScatterItem, PickScatterToPickTime);
end;

function TAnimalObject.StartPickUpItem(IsPickPlayDropItem, IsPickPlayScatterItem: Boolean; PickScatterToPickTime: LongWord;
  MoveToItem: Boolean): Boolean;
var
  Player: TPlayObject;
  SmartObject: TSmartObject;
  BaseObject: TBaseObject;
  IsGamePet: Boolean;
  IsToGamePetBag: Boolean;
  boEnoughBag: Boolean;
  TimeWait: Integer;
  ErrCode: Integer;
  StdItem: pTStdItem;
  AddWeight: Integer;
begin
  Result := False;
  ErrCode := 0;
  try
    if m_boDeath or m_boGhost then
    begin
      m_SelItemObject := nil;
      m_PickUpItemFailList.Clear;
      Exit;
    end;
    ErrCode := 1;
    IsGamePet := False;
    IsToGamePetBag := False;
    ErrCode := 2;
    if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    begin
      ErrCode := 3;
      if (not IsEnoughBag) then
      begin
        m_SelItemObject := nil;
        m_PickUpItemFailList.Clear;
        Exit;
      end;
      SmartObject := TSmartObject(Self);
    end
    else if m_boGamePet and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      ErrCode := 4;
      boEnoughBag := True;
      ErrCode := 5;
      Player := TPlayObject(m_Master); //
      SmartObject := TSmartObject(m_Master);
      IsGamePet := True;
      ErrCode := 6;
      // 不是直接放到主人背包
      if (not g_Config.boPetPickupToMaster) then
      begin
        if Player.m_GamePetBagItems.Count < MAX_GAMEPET_BAG_COUNT then
          IsToGamePetBag := True
        else if g_Config.boPetPickupFullToMaster then
        begin
          boEnoughBag := Player.IsEnoughBag;
          IsToGamePetBag := False;
        end
        else
        begin
          boEnoughBag := False;
        end;
      end
      else
      begin
        boEnoughBag := Player.IsEnoughBag;
        IsToGamePetBag := False;
      end;
      ErrCode := 7;
      if not boEnoughBag then
      begin
        ErrCode := 8;
        m_SelItemObject := nil;
        m_PickUpItemFailList.Clear;
        Exit;
      end;
    end
    else if (m_Master <> nil) and (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
    begin
      SmartObject := TSmartObject(m_Master);
      boEnoughBag := SmartObject.IsEnoughBag;
      IsToGamePetBag := False;
      if not boEnoughBag then
      begin
        ErrCode := 8;
        m_SelItemObject := nil;
        m_PickUpItemFailList.Clear;
        Exit;
      end;
    end
    else
    begin
      ErrCode := 9;
      m_SelItemObject := nil;
      m_PickUpItemFailList.Clear;
      Exit;
    end;
    ErrCode := 10;
    // 检测地图上是否有这个物品
    if (m_SelItemObject <> nil) and (CheckItemExists(m_SelItemObject) <> m_SelItemObject) then
      m_SelItemObject := nil;
    if (m_SelItemObject <> nil) and (m_SelItemObject.m_boGhost) then
    begin
      m_SelItemObject := nil;
    end;
    ErrCode := 11;
    // 有目标站到物品上面，不捡这个物品 2019-05-29 23:03:37
    if m_SelItemObject <> nil then
    begin
      BaseObject := m_PEnvir.GetMovingObject(m_SelItemObject.m_nMapX, m_SelItemObject.m_nMapY, True);
      if (BaseObject <> nil) and (BaseObject <> Self) and (not BaseObject.m_boDeath) then
      begin
        m_SelItemObject := nil;
      end;
    end;
    ErrCode := 12;
    // 检测这个物品是否在自己的坐标上可以捡取
    if (m_SelItemObject <> nil) then
    begin
      if IsToGamePetBag and g_ItemRules.Get(m_SelItemObject.m_UserItem.wIndex, 31) then
      begin // 禁止宠物背包
        if g_Config.boPetPickupFullToMaster then
          IsToGamePetBag := False;
      end;
      // 人物负重不够时不要往人物背包捡物品 2019-12-31 23:44:15
      if not IsToGamePetBag then
      begin
        StdItem := UserEngine.GetStdItem(m_SelItemObject.m_UserItem.wIndex);
        if StdItem <> nil then
        begin
          ErrCode := 120;
          AddWeight := OverLapItemWeight(StdItem, m_SelItemObject.m_UserItem.Dura);
          ErrCode := 121;
          if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
          begin
            if m_WAbil.Weight + AddWeight > m_WAbil.MaxWeight then
            begin
              m_SelItemObject := nil;
              m_PickUpItemFailList.Clear;
              Exit;
            end;
          end
          else
          begin
            if SmartObject.m_WAbil.Weight + AddWeight > SmartObject.m_WAbil.MaxWeight then
            begin
              m_SelItemObject := nil;
              m_PickUpItemFailList.Clear;
              Exit;
            end;
          end;
        end;
      end;
      ErrCode := 13;
      // 骑马 - 不能捡物品 chongchong 2013-10-16
      if (m_btRaceServer = RC_PLAYOBJECT) then
      begin
        Player := TPlayObject(Self);
        if (not Player.m_boDummyObject) and Player.m_boOnHorse then
        begin
          Player.SysMsg(g_sHorseNotPickup, c_Red, t_Hint);
          Exit;
        end;
      end;
      ErrCode := 14;
      if (m_nCurrX <> m_SelItemObject.m_nMapX) or (m_nCurrY <> m_SelItemObject.m_nMapY) then
      begin
        if MoveToItem then
        begin
          ErrCode := 15;
          if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and
            not(TSmartObject(Self).GotoNextOne(m_SelItemObject.m_nMapX, m_SelItemObject.m_nMapY, True)) then
          begin
            // if not THeroObject(Self).CanGotoXY(m_nCurrX, m_nCurrY, ItemObject.m_nMapX, ItemObject.m_nMapY) then Exit;
            m_dwPickupOKTick := MyGetTickCount;
            m_PickUpItemFailList.Add(m_SelItemObject);
            m_SelItemObject := nil;
          end
          else
          begin
            ErrCode := 16;
            // 修正英雄捡物时跑来跑去，到处窜 2019-10-22 00:12:53
            if (m_nTargetX <> m_SelItemObject.m_nMapX) or (m_nTargetX <> m_SelItemObject.m_nMapX) then
            begin
              m_dwTargetFocusTick := MyGetTickCount;
              m_nTargetX := m_SelItemObject.m_nMapX;
              m_nTargetY := m_SelItemObject.m_nMapY;
            end;
            ErrCode := 17;
            GotoTargetXY;
            Result := True;
            Exit;
          end;
        end;
      end
      else
      begin
        ErrCode := 18;
        if IsGamePet then
          TimeWait := 0
        else if m_btRaceServer = RC_HEROOBJECT then
          TimeWait := 800
        else
          TimeWait := 500; // 宝宝或其他
        ErrCode := 19;
        if MyGetTickCount - m_dwPickupOKTick >= TimeWait then // 英雄捡物品改慢点 chongchong 2018-01-07
        begin
          ErrCode := 20;
          // 和自己坐标相同可以捡取
          if DoPickUpItem(m_nCurrX, m_nCurrY, m_SelItemObject, IsGamePet, IsToGamePetBag) then
          begin
            ErrCode := 21;
            m_SelItemObject := nil;
            m_dwPickupOKTick := MyGetTickCount;
            Result := True;
            Exit;
          end
          else
          begin
            ErrCode := 22;
            m_dwPickupOKTick := MyGetTickCount;
            m_PickUpItemFailList.Add(m_SelItemObject);
            m_SelItemObject := nil;
          end;
        end
        else
        begin
          ErrCode := 23;
          Result := True;
          Exit;
        end;
      end;
    end;
    ErrCode := 24;
    m_SelItemObject := FindPriorityPickUpItem(IsPickPlayDropItem, IsPickPlayScatterItem, PickScatterToPickTime);
    Result := (m_SelItemObject <> nil);
    if not Result then
    begin
      ErrCode := 25;
      m_SelItemObject := FindPickUpItem(IsPickPlayDropItem, IsPickPlayScatterItem, PickScatterToPickTime);
      Result := (m_SelItemObject <> nil);
    end;
  except
    MainOutMessage(Format('[Exception] TAnimalObject.StartPickUpItem %s; Code: %d', [m_sCharName, ErrCode]))
  end;
end;

