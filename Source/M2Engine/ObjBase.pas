        (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (m_Magic42Skill.btLevel < m_Magic42Skill.MagicInfo.btTrainLv) and
        (m_Magic42Skill.MagicInfo.TrainLevel[m_Magic42Skill.btLevel] <= m_Abil.Level) then
      begin
        TrainSkill(m_Magic42Skill, Random(2) + 1);
        if not CheckMagicLevelup(m_Magic42Skill) then
        begin
          SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, m_Magic42Skill.MagicInfo.wMagicID,
            MakeWord(m_Magic42Skill.btLevel, m_Magic42Skill.btNewLevel), m_Magic42Skill.nTranPoint,
            IntToStr(Integer(m_Magic42Skill.MagicAttr)), 3000);
        end;
      end;
      if (wHitMode = 10) and (m_Magic43Skill <> nil) and (m_Magic43Skill.MagicInfo <> nil) and
        (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (m_Magic43Skill.btLevel < m_Magic43Skill.MagicInfo.btTrainLv) and
        (m_Magic43Skill.MagicInfo.TrainLevel[m_Magic43Skill.btLevel] <= m_Abil.Level) then
      begin
        TrainSkill(m_Magic43Skill, Random(2) + 1);
        if not CheckMagicLevelup(m_Magic43Skill) then
        begin
          SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, m_Magic43Skill.MagicInfo.wMagicID,
            MakeWord(m_Magic43Skill.btLevel, m_Magic43Skill.btNewLevel), m_Magic43Skill.nTranPoint,
            IntToStr(Integer(m_Magic43Skill.MagicAttr)), 3000);
        end;
      end;
      // 修复开天斩必须是重击才加经验点 chongchong 2013-12-18
      if (wHitMode in [11, 19]) and (m_Magic66Skill <> nil) and (m_Magic66Skill.MagicInfo <> nil) and
        (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (m_Magic66Skill.btLevel < m_Magic66Skill.MagicInfo.btTrainLv) and
        (m_Magic66Skill.MagicInfo.TrainLevel[m_Magic66Skill.btLevel] <= m_Abil.Level) then
      begin
        // 开天斩轻击加1点经验，重击加1-2点
        if wHitMode = 19 then
          TrainSkill(m_Magic66Skill, 1)
        else
          TrainSkill(m_Magic66Skill, Random(2) + 1);
        if not CheckMagicLevelup(m_Magic66Skill) then
        begin
          SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, m_Magic66Skill.MagicInfo.wMagicID,
            MakeWord(m_Magic66Skill.btLevel, m_Magic66Skill.btNewLevel), m_Magic66Skill.nTranPoint,
            IntToStr(Integer(m_Magic66Skill.MagicAttr)), 3000);
        end;
      end;
      if (wHitMode in [12 .. 14]) and (UserMagic <> nil) and // 合击
        (UserMagic.MagicInfo <> nil) and (m_btRaceServer in [RC_HEROOBJECT]) and
        (UserMagic.btLevel < UserMagic.MagicInfo.btTrainLv) and (UserMagic.MagicInfo.TrainLevel[UserMagic.btLevel] <= m_Abil.Level)
      then
      begin
        TrainSkill(UserMagic, Random(2) + 1);
        if not CheckMagicLevelup(UserMagic) then
        begin
          SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, UserMagic.MagicInfo.wMagicID, MakeWord(UserMagic.btLevel, UserMagic.btNewLevel),
            UserMagic.nTranPoint, IntToStr(Integer(UserMagic.MagicAttr)), 3000);
        end;
      end;
      if (wHitMode = 15) and (m_MagicSwordSkill <> nil) and // 逐日剑法
        (m_MagicSwordSkill.MagicInfo <> nil) and (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and
        (m_MagicSwordSkill.btLevel < m_MagicSwordSkill.MagicInfo.btTrainLv) and
        (m_MagicSwordSkill.MagicInfo.TrainLevel[m_MagicSwordSkill.btLevel] <= m_Abil.Level) then
      begin
        TrainSkill(m_MagicSwordSkill, Random(2) + 1);
        if not CheckMagicLevelup(m_MagicSwordSkill) then
        begin
          SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, m_MagicSwordSkill.MagicInfo.wMagicID,
            MakeWord(m_MagicSwordSkill.btLevel, m_MagicSwordSkill.btNewLevel), m_MagicSwordSkill.nTranPoint,
            IntToStr(Integer(m_MagicSwordSkill.MagicAttr)), 3000);
        end;
      end;
      if (wHitMode = 20) and (m_Magic113Skill <> nil) and (m_Magic113Skill.MagicInfo <> nil) and
        (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (m_Magic113Skill.btLevel < m_Magic113Skill.MagicInfo.btTrainLv) and
        (m_Magic113Skill.MagicInfo.TrainLevel[m_Magic113Skill.btLevel] <= m_Abil.Level) then
      begin
        TrainSkill(m_Magic113Skill, Random(2) + 1);
        if not CheckMagicLevelup(m_Magic113Skill) then
        begin
          SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, m_Magic113Skill.MagicInfo.wMagicID,
            MakeWord(m_Magic113Skill.btLevel, m_Magic113Skill.btNewLevel), m_Magic113Skill.nTranPoint,
            IntToStr(Integer(m_Magic113Skill.MagicAttr)), 3000);
        end;
      end;
      if (wHitMode = 21) and (m_Magic115Skill <> nil) and (m_Magic115Skill.MagicInfo <> nil) and
        (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (m_Magic115Skill.btLevel < m_Magic115Skill.MagicInfo.btTrainLv) and
        (m_Magic115Skill.MagicInfo.TrainLevel[m_Magic115Skill.btLevel] <= m_Abil.Level) then
      begin
        TrainSkill(m_Magic115Skill, Random(2) + 1);
        if not CheckMagicLevelup(m_Magic115Skill) then
        begin
          SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, m_Magic115Skill.MagicInfo.wMagicID,
            MakeWord(m_Magic115Skill.btLevel, m_Magic115Skill.btNewLevel), m_Magic115Skill.nTranPoint,
            IntToStr(Integer(m_Magic115Skill.MagicAttr)), 3000);
        end;
      end;
      { // 连击技能[三绝杀、断岳斩、横扫千军]不增加经验值 -- piaoyun 2013-08-16
        if (wHitMode = 16) and (m_UserMagics[101] <> nil) and                                         // 三绝杀
        (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and
        (m_UserMagics[101].btLevel < m_UserMagics[101].MagicInfo.btTrainLv) and
        (m_UserMagics[101].MagicInfo.TrainLevel[m_UserMagics[101].btLevel] <= m_Abil.Level) then
        begin
        TrainSkill(m_UserMagics[101], Random(2) + 1);
        if not CheckMagicLevelup(m_UserMagics[101]) then
        begin
        SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, m_UserMagics[101].MagicInfo.wMagicId, MakeWord(m_UserMagics[101].btLevel, m_UserMagics[101].btNewLevel), m_UserMagics[101].nTranPoint, IntToStr(Integer(m_UserMagics[101].MagicAttr)), 3000);
        end;
        end;
        if (wHitMode = 17) and (m_UserMagics[102] <> nil) and                                         // 断岳斩
        (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and
        (m_UserMagics[102].btLevel < m_UserMagics[102].MagicInfo.btTrainLv) and
        (m_UserMagics[102].MagicInfo.TrainLevel[m_UserMagics[102].btLevel] <= m_Abil.Level) then
        begin
        TrainSkill(m_UserMagics[102], Random(2) + 1);
        if not CheckMagicLevelup(m_UserMagics[102]) then
        begin
        SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, m_UserMagics[102].MagicInfo.wMagicId, MakeWord(m_UserMagics[102].btLevel, m_UserMagics[102].btNewLevel), m_UserMagics[102].nTranPoint, IntToStr(Integer(m_UserMagics[102].MagicAttr)), 3000);
        end;
        end;
        if (wHitMode = 18) and (m_UserMagics[103] <> nil) and                                         // 横扫千军
        (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and
        (m_UserMagics[103].btLevel < m_UserMagics[103].MagicInfo.btTrainLv) and
        (m_UserMagics[103].MagicInfo.TrainLevel[m_UserMagics[103].btLevel] <= m_Abil.Level) then
        begin
        TrainSkill(m_UserMagics[103], Random(2) + 1);
        if not CheckMagicLevelup(m_UserMagics[103]) then
        begin
        SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, m_UserMagics[103].MagicInfo.wMagicId, MakeWord(m_UserMagics[103].btLevel, m_UserMagics[103].btNewLevel), m_UserMagics[103].nTranPoint, IntToStr(Integer(m_UserMagics[103].MagicAttr)), 3000);
        end;
        end; }
      Result := True;
    end;
    nCheckCode := 9;
    if (nWeaponDamage > 0) and (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and
      (TSmartObject(Self).m_UseItems[U_WEAPON].wIndex > 0) then
      TSmartObject(Self).DoDamageWeapon(nWeaponDamage);
    if CanNextAttack then
    begin // 可以往下攻击
      if (AttackTarget <> nil) and (AttackTarget.m_btRaceServer <> RC_PLAYOBJECT) and
        (IsProperTarget(AttackTarget) or (AttackTarget.m_btRaceServer in [RC_GUARD, RC_GUARD2])) and
      // 修正和平模式下攻击英雄分身会灰名 2021-03-27
        ((AttackTarget.m_Master = nil) or ((AttackTarget.m_Master <> nil) and
        ((AttackTarget.Master.m_btRaceServer <> RC_PLAYOBJECT) or (not AttackTarget.InSafeZone)))) then
      begin
        AttackTarget.SendMsg(AttackTarget, RM_STRUCK, nPower, AttackTarget.m_WAbil.HP, AttackTarget.m_WAbil.MaxHP,
          NativeInt(Self), IntToStr(MakeLong(nUseMagicID, Integer(BlastHitType))));
      end;
      if (nPower = 0) and (not IsChagneMP) and (m_btRaceServer in [RC_PLAYOBJECT]) then
      begin
        SendMsg(AttackTarget, RM_ATTACK_MISS, 0, 0, 0, 0, '');
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg, [m_sCharName, nCheckCode]));
      MainOutMessage(E.Message)
    end;
  end;
end;

procedure TBaseObject.SendAttackMsg(wIdent: Word; btDir: Byte; nX, nY: Integer; nNewLevel: Integer);
begin
  SendRefMsg(wIdent, btDir, nX, nY, nNewLevel, '');
end;

procedure TSmartObject.OpenSuperShiled; // 开启护体神盾
begin
  // 骑马 被邀请到马上的人不自动开盾 chongchong 2013-10-16
  if (m_boOnHorse and (not m_boHorseMaster)) then
    Exit;

  // 变身后 2020-08-22 12:24:05
  if m_nChangeAppr >= 0 then
    Exit;

  m_boSuperShiled := True; // 护体神盾
  m_dwSuperShiledValidTimeTick := MyGetTickCount(); // 护体神盾有效时间
  m_dwLastSuperShiledTimeTick := MyGetTickCount(); // 护体神盾使用间隔
  if g_Config.boShowSuperShiledEffect or g_Config.boShowSuperShiledSound then
  begin
    SendRefMsg(RM_SENDSUPERSHILEDEFFECT, m_btDirection, Integer(g_Config.boShowSuperShiledEffect),
      Integer(g_Config.boShowSuperShiledSound), 0, '');
  end;
end;

procedure TSmartObject.CloseSuperShiled; // 关闭护体神盾
begin
  if m_boSuperShiled then
  begin
    m_boSuperShiled := False;
    m_dwSuperShiledValidTimeTick := MyGetTickCount(); // 护体神盾有效时间
    m_dwLastSuperShiledTimeTick := MyGetTickCount(); // 护体神盾使用间隔

    if not g_Config.boCloseSuperShiledHint then
      SysMsg('护体神盾被击破', c_Blue, t_Hint);
  end;
end;

function TBaseObject.GetHitStruckDamage(Target: TBaseObject; nDamage: Integer; MagicACInfo: PMagicACInfo;
  nType: Integer = 0): Integer;
var
  n14: Integer;
  SmartObject: TSmartObject;
  DefenseValue: Integer;
  IgnoreMagBubbleDefenceValue, nSkill31Rate: Integer; // 忽略魔法盾(破魔法盾)
begin
  if nType <> 4 then // 完全忽视目标防御时，不要忽视盾防御 2020-11-09 23:45:53
  begin
    if nType = 2 then // 破魔法盾防御 piaoyun 2013-08-18
    begin
      // 魔法盾防御
      if (nDamage > 0) and m_boAbilMagBubbleDefence then
      begin
        // nDamage := Max(nDamage - Round((nDamage / 1.0E2) * (m_btMagBubbleDefenceLevel + 2) * 8.0), 0);
        // 魔法盾防御倍率 piaoyun 2013-08-18
        // 强化盾
        if (m_btMagBubbleDefenceNewLevel > 0) or (m_btMagBubbleDefenceLevel > 3) then // 强化魔法盾 / 4级魔法盾 chongchong 2013-12-27
        begin
          // nDamage := Round(nDamage * (Max(0, (100 - g_Config.nSkill31Rate - m_btMagBubbleDefenceNewLevel * 10)) / 100));
          nSkill31Rate := g_Config.nSkill31Rates[0];
          if (m_btMagBubbleDefenceNewLevel > 0) and (m_btMagBubbleDefenceNewLevel <= 9) then
            nSkill31Rate := g_Config.nSkill31Rates[m_btMagBubbleDefenceNewLevel - 1]
          else if m_btMagBubbleDefenceNewLevel > 9 then
            nSkill31Rate := g_Config.nSkill31Rates[8];
          DefenseValue := Min(LongWord(Round(nDamage / 100 * nSkill31Rate)), High(Integer));
          // 比例忽视，不要算盾 2020-11-11 16:15:32
          {
            if (g_Config.boCloseDefenseUseScale) and (Target <> nil) and (Target.m_WAbil.NewValue[4] > 0) then
            DefenseValue := Round(DefenseValue / 100 * (100 - Target.m_WAbil.NewValue[4]));
          }
          // 技能破魔法盾 2019-07-08 21:50:52
          if (MagicACInfo <> nil) and (MagicACInfo.boEnabled) then
          begin
            if m_btRaceServer = RC_PLAYOBJECT then
              IgnoreMagBubbleDefenceValue := MagicACInfo.btDefenceHum
            else if m_btRaceServer = RC_HEROOBJECT then
              IgnoreMagBubbleDefenceValue := MagicACInfo.btDefenceHero
            else
              IgnoreMagBubbleDefenceValue := MagicACInfo.btDefenceMon;

            if (DefenseValue > 0) and (IgnoreMagBubbleDefenceValue > 0) then
              DefenseValue := Round(DefenseValue / 100 * (100 - IgnoreMagBubbleDefenceValue));
          end;

          if DefenseValue < 0 then
            DefenseValue := 0
          else if DefenseValue > nDamage then
            DefenseValue := nDamage;

          nDamage := nDamage - DefenseValue;
        end
        else // 普通魔法盾
        begin
          // nDamage := Round(nDamage * ((100 - (m_btMagBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate {15}) / 100));
          DefenseValue := Min(LongWord(Round(nDamage / 100 * ((m_btMagBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate))),
            High(Integer));
          // 比例忽视，不要算盾 2020-11-11 16:15:32
          {
            if (g_Config.boCloseDefenseUseScale) and (Target <> nil) and (Target.m_WAbil.NewValue[4] > 0) then
            DefenseValue := Round(DefenseValue / 100 * (100 - Target.m_WAbil.NewValue[4]));
          }
          // 技能破魔法盾 2019-07-08 21:50:52
          if (MagicACInfo <> nil) and (MagicACInfo.boEnabled) then
          begin
            if m_btRaceServer = RC_PLAYOBJECT then
              IgnoreMagBubbleDefenceValue := MagicACInfo.btDefenceHum
            else if m_btRaceServer = RC_HEROOBJECT then
              IgnoreMagBubbleDefenceValue := MagicACInfo.btDefenceHero
            else
              IgnoreMagBubbleDefenceValue := MagicACInfo.btDefenceMon;

            if (DefenseValue > 0) and (IgnoreMagBubbleDefenceValue > 0) then
              DefenseValue := Round(DefenseValue / 100 * (100 - IgnoreMagBubbleDefenceValue));
          end;

          if DefenseValue < 0 then
            DefenseValue := 0
          else if DefenseValue > nDamage then
            DefenseValue := nDamage;
          nDamage := nDamage - DefenseValue;
        end;
        DamageBubbleDefence(nDamage);
      end;
      Result := nDamage;
      Exit;
    end;

    if (nType = 1) and (MagicACInfo <> nil) and (MagicACInfo.boEnabled) then
    begin
      n14 := m_WAbil.AC2 - m_WAbil.AC1 + 1;
      if n14 > 0 then
        n14 := Random(n14);

      n14 := Max(0, m_WAbil.AC1 + n14);
      if m_btRaceServer = RC_PLAYOBJECT then
        n14 := n14 - Round(n14 * MagicACInfo.btHum / 100)
      else if m_btRaceServer = RC_HEROOBJECT then
        n14 := n14 - Round(n14 * MagicACInfo.btHero / 100)
      else
        n14 := n14 - Round(n14 * MagicACInfo.btMon / 100);

      if (g_Config.boCloseDefenseUseScale) and (Target <> nil) and (Target.m_WAbil.NewValue[4] > 0) then
        n14 := Round(n14 / 100 * (100 - Target.m_WAbil.NewValue[4]));

      if n14 < 0 then
        n14 := 0;

      // 脚本MAKEPOSION
      if (m_nStatusPowerTime[POISON_DAMAGEARMOR] > 0) and (m_nStatusPowerType[POISON_DAMAGEARMOR] = 1) then
        n14 := Round((1000 - Max(0, Min(1000, m_nStatusPower[POISON_DAMAGEARMOR]))) / 1000 * n14);
      nDamage := Max(0, nDamage - n14);
    end
    else if nType <> 3 then
    begin
      n14 := m_WAbil.AC2 - m_WAbil.AC1 + 1;
      if n14 > 0 then
        n14 := Random(n14);

      n14 := Max(0, m_WAbil.AC1 + n14);

      if (g_Config.boCloseDefenseUseScale) and (Target <> nil) and (Target.m_WAbil.NewValue[4] > 0) then
        n14 := Round(n14 / 100 * (100 - Target.m_WAbil.NewValue[4]));

      if n14 < 0 then
        n14 := 0;

      // 脚本MAKEPOSION
      if (m_nStatusPowerTime[POISON_DAMAGEARMOR] > 0) and (m_nStatusPowerType[POISON_DAMAGEARMOR] = 1) then
        n14 := Round((1000 - Max(0, Min(1000, m_nStatusPower[POISON_DAMAGEARMOR]))) / 1000 * n14);
      nDamage := Max(0, nDamage - n14);
    end;

    // 不死系的怪物攻击人物，英雄，假人时，当攻击目标有神圣属性时，会减少伤害
    if (nType <> 3) and (m_btLifeAttrib = LA_UNDEAD) and (Target <> nil) and
      (Target.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
      Inc(nDamage, TSmartObject(Target).m_AddAbil.bt1DF);

    // 破物理防御 piaoyun 2013-08-18
    if nType = 1 then
    begin
      Result := nDamage;
      Exit;
    end;
  end;

  // 魔法盾防御
  if (nType <> 3) and (nDamage > 0) and m_boAbilMagBubbleDefence then
  begin
    // nDamage := Max(nDamage - Round((nDamage / 1.0E2) * (m_btMagBubbleDefenceLevel + 2) * 8.0), 0);
    // 魔法盾防御倍率 piaoyun 2013-08-18
    // 强化盾
    if (m_btMagBubbleDefenceNewLevel > 0) or (m_btMagBubbleDefenceLevel > 3) then // 强化魔法盾 / 4级魔法盾 chongchong 2013-12-27
    begin
      // nDamage := Round(nDamage * (Max(0, (100 - g_Config.nSkill31Rate - m_btMagBubbleDefenceNewLevel * 10)) / 100));
      nSkill31Rate := g_Config.nSkill31Rates[0];
      if (m_btMagBubbleDefenceNewLevel > 0) and (m_btMagBubbleDefenceNewLevel <= 9) then
        nSkill31Rate := g_Config.nSkill31Rates[m_btMagBubbleDefenceNewLevel - 1]
      else if m_btMagBubbleDefenceNewLevel > 9 then
        nSkill31Rate := g_Config.nSkill31Rates[8];

      DefenseValue := Min(LongWord(Round(nDamage / 100 * nSkill31Rate)), High(Integer));
      // 比例忽视，不要算盾 2020-11-11 16:15:32
      {
        if (g_Config.boCloseDefenseUseScale) and (Target <> nil) and (Target.m_WAbil.NewValue[4] > 0) then
        DefenseValue := Round(DefenseValue / 100 * (100 - Target.m_WAbil.NewValue[4]));
      }
      if DefenseValue < 0 then
        DefenseValue := 0
      else if DefenseValue > nDamage then
        DefenseValue := nDamage;
      nDamage := nDamage - DefenseValue;
    end
    else // 普通魔法盾
    begin
      // nDamage := Round(nDamage * ((100 - (m_btMagBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate {15}) / 100));
      DefenseValue := Min(LongWord(Round(nDamage / 100 * ((m_btMagBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate))),
        High(Integer));
      // 比例忽视，不要算盾 2020-11-11 16:15:32
      {
        if (g_Config.boCloseDefenseUseScale) and (Target <> nil) and (Target.m_WAbil.NewValue[4] > 0) then
        DefenseValue := Round(DefenseValue / 100 * (100 - Target.m_WAbil.NewValue[4]));
      }
      if DefenseValue < 0 then
        DefenseValue := 0
      else if DefenseValue > nDamage then
        DefenseValue := nDamage;
      nDamage := nDamage - DefenseValue;
    end;
    DamageBubbleDefence(nDamage);
  end;

  // 武力盾防御
  if (nDamage > 0) and m_boAbilNewHitBubbleDefence then
  begin
    // 武力盾防御倍率 piaoyun 2013-08-18
    // 强化盾
    if (m_btNewHitBubbleDefenceNewLevel > 0) or (m_btNewHitBubbleDefenceLevel > 3) then // 强化魔法盾 / 4级魔法盾 chongchong 2013-12-27
    begin
      // nDamage := Round(nDamage * ((100 - g_Config.nSkill31Rate) / 100));
      nSkill31Rate := g_Config.nSkill31Rates[0];
      if (m_btNewHitBubbleDefenceNewLevel > 0) and (m_btNewHitBubbleDefenceNewLevel <= 9) then
        nSkill31Rate := g_Config.nSkill31Rates[m_btNewHitBubbleDefenceNewLevel - 1]
      else if m_btNewHitBubbleDefenceNewLevel > 9 then
        nSkill31Rate := g_Config.nSkill31Rates[8];
      DefenseValue := Min(LongWord(Round(nDamage / 100 * nSkill31Rate)), High(Integer));
      // 比例忽视，不要算盾 2020-11-11 16:15:32
      {
        if (g_Config.boCloseDefenseUseScale) and (Target <> nil) and (Target.m_WAbil.NewValue[4] > 0) then
        DefenseValue := Round(DefenseValue / 100 * (100 - Target.m_WAbil.NewValue[4]));
      }
      if DefenseValue < 0 then
        DefenseValue := 0
      else if DefenseValue > nDamage then
        DefenseValue := nDamage;
      nDamage := nDamage - DefenseValue;
    end
    else // 普通武力盾
    begin
      // nDamage := Round(nDamage * ((100 - (m_btNewHitBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate {15}) / 100));
      DefenseValue := Min(LongWord(Round(nDamage / 100 * ((m_btNewHitBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate))),
        High(Integer));
      // 比例忽视，不要算盾 2020-11-11 16:15:32
      {
        if (g_Config.boCloseDefenseUseScale) and (Target <> nil) and (Target.m_WAbil.NewValue[4] > 0) then
        DefenseValue := Round(DefenseValue / 100 * (100 - Target.m_WAbil.NewValue[4]));
      }
      if DefenseValue < 0 then
        DefenseValue := 0
      else if DefenseValue > nDamage then
        DefenseValue := nDamage;
      nDamage := nDamage - DefenseValue;
    end;
    DamageNewHitBubbleDefence(nDamage); // RM_SENDBLASTHIT
    // 去掉武力盾防御效果 chongchong 2015-11-03
    // SendRefMsg(RM_NewHitBubbleDefence, m_btDirection, m_nCurrX, m_nCurrY, 0, '', 200);
  end;

  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(Self);
    // 护体神盾防御
    if SmartObject.m_boSuperShiled and (SmartObject.m_MagicSuperShiledSkill <> nil) then
    begin
      if Random(g_Config.nOpenSuperShiledRate) = 0 then
      begin
        // nDamage := Max(nDamage - Round(nDamage / 100 * (g_Config.nSuperShiledPowerRate + (SmartObject.m_MagicSuperShiledSkill.btLevel + SmartObject.m_MagicSuperShiledSkill.btNewLevel) * g_Config.nSuperShiledLevelUpDecPowerRate)), 0);
        DefenseValue :=
          Min(LongWord(Round(nDamage / 100 * (g_Config.nSuperShiledPowerRate + (SmartObject.m_MagicSuperShiledSkill.btLevel +
          SmartObject.m_MagicSuperShiledSkill.btNewLevel) * g_Config.nSuperShiledLevelUpDecPowerRate))), High(Integer));
        // 比例忽视，不要算盾 2020-11-11 16:15:32
        {
          if (g_Config.boCloseDefenseUseScale) and (Target <> nil) and (Target.m_WAbil.NewValue[4] > 0) then
          DefenseValue := Round(DefenseValue / 100 * (100 - Target.m_WAbil.NewValue[4]));
        }
        if DefenseValue < 0 then
          DefenseValue := 0
        else if DefenseValue > nDamage then
          DefenseValue := nDamage;
        nDamage := nDamage - DefenseValue;

        if g_Config.boShowSuperShiledEffect2 or g_Config.boShowSuperShiledSound2 then
        begin
          SendRefMsg(RM_SENDSUPERSHILEDEFFECT, m_btDirection, Integer(g_Config.boShowSuperShiledEffect2),
            Integer(g_Config.boShowSuperShiledSound2), 0, '');
        end;

        if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (SmartObject.m_MagicSuperShiledSkill <> nil) and
          (SmartObject.m_MagicSuperShiledSkill.MagicInfo <> nil) and
          (SmartObject.m_MagicSuperShiledSkill.btLevel < SmartObject.m_MagicSuperShiledSkill.MagicInfo.btTrainLv) and
          (SmartObject.m_MagicSuperShiledSkill.MagicInfo.TrainLevel[SmartObject.m_MagicSuperShiledSkill.btLevel] <= m_Abil.Level)
        then
        begin
          TrainSkill(SmartObject.m_MagicSuperShiledSkill, Random(3) + 1);
          if not CheckMagicLevelup(SmartObject.m_MagicSuperShiledSkill) then
          begin
            SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, SmartObject.m_MagicSuperShiledSkill.MagicInfo.wMagicID,
              MakeWord(SmartObject.m_MagicSuperShiledSkill.btLevel, SmartObject.m_MagicSuperShiledSkill.btNewLevel),
              SmartObject.m_MagicSuperShiledSkill.nTranPoint,
              IntToStr(Integer(SmartObject.m_MagicSuperShiledSkill.MagicAttr)), 3000);
          end;
        end;
      end;
    end;
  end;

  Result := Max(0, nDamage);
end;

function TBaseObject.GetMagStruckDamage(BaseObject: TBaseObject; nDamage: Integer; MagicACInfo: PMagicACInfo;
  nType: Integer = 0): Integer;
var
  n14, DefenseValue, nSkill31Rate: Integer;
  SmartObject: TSmartObject;
begin
  if nType = 0 then // 完全忽视目标防御时，不要忽视盾防御 2020-11-09 23:45:53
  begin
    n14 := m_WAbil.MAC2 - m_WAbil.MAC1 + 1;
    if n14 > 0 then
      n14 := Random(n14);
    n14 := Max(0, m_WAbil.MAC1 + n14);
    // 中红毒减魔御 chongchong 2016-05-13
    if (n14 > 0) and (g_Config.boEnabledPosionDecMAC) then
    begin
      if m_wStatusTimeArr[POISON_DAMAGEARMOR { 1 0x62 } ] > 0 then
      begin
        n14 := Round(n14 / 100 * (100 - g_Config.nPosionDecMACRate));
      end;
    end;
    if (MagicACInfo <> nil) and (MagicACInfo.boEnabled) then
    begin
      n14 := m_WAbil.AC2 - m_WAbil.AC1 + 1;
      if n14 > 0 then
        n14 := Random(n14);
      n14 := Max(0, m_WAbil.AC1 + n14);
      if m_btRaceServer = RC_PLAYOBJECT then
        n14 := n14 - Round(n14 * MagicACInfo.btHum / 100)
      else if m_btRaceServer = RC_HEROOBJECT then
        n14 := n14 - Round(n14 * MagicACInfo.btHero / 100)
      else
        n14 := n14 - Round(n14 * MagicACInfo.btMon / 100);
    end;
    // +++++++++++++ 2019-05-31 23:10:52
    if (g_Config.boCloseDefenseUseScale) and (BaseObject <> nil) and (BaseObject.m_WAbil.NewValue[4] > 0) then
      n14 := Round(n14 / 100 * (100 - BaseObject.m_WAbil.NewValue[4]));
    if n14 < 0 then
      n14 := 0;
    // +++++++++++++ 2019-05-31 23:10:52
    if (m_nStatusPowerTime[POISON_DAMAGEARMOR] > 0) and (m_nStatusPowerType[POISON_DAMAGEARMOR] = 1) then
    begin // 脚本MAKEPOSION
      n14 := Round((1000 - Max(0, Min(1000, m_nStatusPower[POISON_DAMAGEARMOR]))) / 1000 * n14);
    end;
    nDamage := Max(0, nDamage - n14);
    m_nStruckHP := n14;
    if (m_btLifeAttrib = LA_UNDEAD) and (BaseObject <> nil) and
      (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
    begin
      Inc(nDamage, TSmartObject(BaseObject).m_AddAbil.bt1DF);
    end;
    // 自定义技能才有这玩意 2020-09-15 00:55:06
    if (MagicACInfo <> nil) then
    begin
      if nDamage < 0 then
        nDamage := 0;
      Result := nDamage;
      Exit;
    end;
  end;
  if (nDamage > 0) and m_boAbilMagBubbleDefence then
  begin // 魔法盾防御
    // nDamage := Max(nDamage - Round((nDamage / 1.0E2) * (m_btMagBubbleDefenceLevel + 2) * 8.0), 0);
    // 魔法盾防御倍率 piaoyun 2013-08-18
    if (m_btMagBubbleDefenceNewLevel > 0) or (m_btMagBubbleDefenceLevel > 3) then // 强化魔法盾 / 4级魔法盾 chongchong 2013-12-27
    begin // 强化盾
      // nDamage := Round(nDamage * (Max(0, (100 - g_Config.nSkill31Rate - m_btMagBubbleDefenceNewLevel * 10)) / 100));
      // +++++++++++++ 2019-05-31 23:10:52
      nSkill31Rate := g_Config.nSkill31Rates[0];
      if (m_btMagBubbleDefenceNewLevel > 0) and (m_btMagBubbleDefenceNewLevel <= 9) then
        nSkill31Rate := g_Config.nSkill31Rates[m_btMagBubbleDefenceNewLevel - 1]
      else if m_btMagBubbleDefenceNewLevel > 9 then
        nSkill31Rate := g_Config.nSkill31Rates[8];
      DefenseValue := Min(LongWord(Round(nDamage / 100 * nSkill31Rate)), High(Integer));
      // 比例忽视，不要算盾 2020-11-11 16:15:32
      {
        if (g_Config.boCloseDefenseUseScale) and (BaseObject <> nil) and (BaseObject.m_WAbil.NewValue[4] > 0) then
        DefenseValue := Round(DefenseValue / 100 * (100 - BaseObject.m_WAbil.NewValue[4]));
      }
      if DefenseValue < 0 then
        DefenseValue := 0
      else if DefenseValue > nDamage then
        DefenseValue := nDamage;
      nDamage := nDamage - DefenseValue;
      // +++++++++++++ 2019-05-31 23:10:52
    end
    else // 普通魔法盾
    begin
      // nDamage := Round(nDamage * ((100 - (m_btMagBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate {15}) / 100));
      // +++++++++++++ 2019-05-31 23:10:52
      DefenseValue := Min(LongWord(Round(nDamage / 100 * ((m_btMagBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate))),
        High(Integer));
      // 比例忽视，不要算盾 2020-11-11 16:15:32
      {
        if (g_Config.boCloseDefenseUseScale) and (BaseObject <> nil) and (BaseObject.m_WAbil.NewValue[4] > 0) then
        DefenseValue := Round(DefenseValue / 100 * (100 - BaseObject.m_WAbil.NewValue[4]));
      }
      if DefenseValue < 0 then
        DefenseValue := 0
      else if DefenseValue > nDamage then
        DefenseValue := nDamage;
      nDamage := nDamage - DefenseValue;
      // +++++++++++++ 2019-05-31 23:10:52
    end;
    DamageBubbleDefence(nDamage);
  end;
  if (nDamage > 0) and m_boAbilNewMagBubbleDefence then
  begin // 魔法盾防御
    // nDamage := Max(nDamage - Round((nDamage / 1.0E2) * (m_btNewMagBubbleDefenceLevel + 2) * 8.0), 0);
    // 魔法盾防御倍率 piaoyun 2013-08-18
    if (m_btNewMagBubbleDefenceNewLevel > 0) or (m_btNewMagBubbleDefenceLevel > 3) then // 强化魔法盾 / 4级魔法盾 chongchong 2013-12-27
    begin // 强化盾
      // nDamage := Round(nDamage * ((100 - g_Config.nSkill31Rate) / 100));
      // +++++++++++++ 2019-05-31 23:10:52
      nSkill31Rate := g_Config.nSkill31Rates[0];
      if (m_btNewMagBubbleDefenceNewLevel > 0) and (m_btNewMagBubbleDefenceNewLevel <= 9) then
        nSkill31Rate := g_Config.nSkill31Rates[m_btNewMagBubbleDefenceNewLevel - 1]
      else if m_btNewMagBubbleDefenceNewLevel > 9 then
        nSkill31Rate := g_Config.nSkill31Rates[8];
      DefenseValue := Min(LongWord(Round(nDamage / 100 * nSkill31Rate)), High(Integer));
      // 比例忽视，不要算盾 2020-11-11 16:15:32
      {
        if (g_Config.boCloseDefenseUseScale) and (BaseObject <> nil) and (BaseObject.m_WAbil.NewValue[4] > 0) then
        DefenseValue := Round(DefenseValue / 100 * (100 - BaseObject.m_WAbil.NewValue[4]));
      }
      if DefenseValue < 0 then
        DefenseValue := 0
      else if DefenseValue > nDamage then
        DefenseValue := nDamage;
      nDamage := nDamage - DefenseValue;
      // +++++++++++++ 2019-05-31 23:10:52
    end
    else // 普通魔法盾
    begin
      // nDamage := Round(nDamage * ((100 - (m_btNewMagBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate {15}) / 100));
      // +++++++++++++ 2019-05-31 23:10:52
      DefenseValue := Min(LongWord(Round(nDamage / 100 * ((m_btNewMagBubbleDefenceLevel + 1) * g_Config.nOrdinarySkill31Rate))),
        High(Integer));
      // 比例忽视，不要算盾 2020-11-11 16:15:32
      {
        if (g_Config.boCloseDefenseUseScale) and (BaseObject <> nil) and (BaseObject.m_WAbil.NewValue[4] > 0) then
        DefenseValue := Round(DefenseValue / 100 * (100 - BaseObject.m_WAbil.NewValue[4]));
      }
      if DefenseValue < 0 then
        DefenseValue := 0
      else if DefenseValue > nDamage then
        DefenseValue := nDamage;
      nDamage := nDamage - DefenseValue;
      // +++++++++++++ 2019-05-31 23:10:52
    end;
    DamageNewMagBubbleDefence(nDamage);
  end;
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(Self);
    if SmartObject.m_boSuperShiled and (SmartObject.m_MagicSuperShiledSkill <> nil) then
    begin // 护体神盾防御
      if Random(g_Config.nOpenSuperShiledRate) = 0 then
      begin
        // nDamage := Max(nDamage - Round(nDamage / 100 * (g_Config.nSuperShiledPowerRate + (SmartObject.m_MagicSuperShiledSkill.btLevel + SmartObject.m_MagicSuperShiledSkill.btNewLevel) * g_Config.nSuperShiledLevelUpDecPowerRate)), 0);
        // +++++++++++++ 2019-05-31 23:10:52
        DefenseValue :=
          Min(LongWord(Round(nDamage / 100 * (g_Config.nSuperShiledPowerRate + (SmartObject.m_MagicSuperShiledSkill.btLevel +
          SmartObject.m_MagicSuperShiledSkill.btNewLevel) * g_Config.nSuperShiledLevelUpDecPowerRate))), High(Integer));
        // 比例忽视，不要算盾 2020-11-11 16:15:32
        {
          if (g_Config.boCloseDefenseUseScale) and (BaseObject <> nil) and (BaseObject.m_WAbil.NewValue[4] > 0) then
          DefenseValue := Round(DefenseValue / 100 * (100 - BaseObject.m_WAbil.NewValue[4]));
        }
        if DefenseValue < 0 then
          DefenseValue := 0
        else if DefenseValue > nDamage then
          DefenseValue := nDamage;
        nDamage := nDamage - DefenseValue;
        // +++++++++++++ 2019-05-31 23:10:52
        if g_Config.boShowSuperShiledEffect2 or g_Config.boShowSuperShiledSound2 then
        begin
          SendRefMsg(RM_SENDSUPERSHILEDEFFECT, m_btDirection, Integer(g_Config.boShowSuperShiledEffect2),
            Integer(g_Config.boShowSuperShiledSound2), 0, '');
        end;
        if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (SmartObject.m_MagicSuperShiledSkill.MagicInfo <> nil) and
          (SmartObject.m_MagicSuperShiledSkill.btLevel < SmartObject.m_MagicSuperShiledSkill.MagicInfo.btTrainLv) and
          (SmartObject.m_MagicSuperShiledSkill.MagicInfo.TrainLevel[SmartObject.m_MagicSuperShiledSkill.btLevel] <= m_Abil.Level)
        then
        begin
          TrainSkill(SmartObject.m_MagicSuperShiledSkill, Random(3) + 1);
          if not CheckMagicLevelup(SmartObject.m_MagicSuperShiledSkill) then
          begin
            SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, SmartObject.m_MagicSuperShiledSkill.MagicInfo.wMagicID,
              MakeWord(SmartObject.m_MagicSuperShiledSkill.btLevel, SmartObject.m_MagicSuperShiledSkill.btNewLevel),
              SmartObject.m_MagicSuperShiledSkill.nTranPoint,
              IntToStr(Integer(SmartObject.m_MagicSuperShiledSkill.MagicAttr)), 3000);
          end;
        end;
      end;
    end;
  end;
  if nDamage < 0 then
    nDamage := 0;
  Result := nDamage;
end;

// 受到攻击减持久
function TBaseObject.StruckDamage(nDamage: Integer; StruckFrom: TBaseObject; MagicID: Integer;
  IsSetPKPower: Boolean = True): Integer;
var
  I: Integer;
  nDam, nDamageDura: Integer;
  nDura, nOldDura: Integer;
  PlayObject: TPlayObject;
  StdItem: pTStdItem;
  boFeatureChanged: Boolean;
  SmartObject: TSmartObject;
  Int64Value: Int64;
  boRecalcAbilitys: Boolean;
  nTemp: Integer;
  nOldMP: LongWord;
  nOldMagicID, nOldMagicID2: Integer;
  OldCurTarget: TBaseObject;
begin
  if nDamage < 0 then
    nDamage := 0;
  nDam := Random(10) + 5;
  if m_wStatusTimeArr[POISON_DAMAGEARMOR { 1 0x62 } ] > 0 then
  begin
    nDam := Min(LongWord(Round(nDam * (g_Config.nPosionDamagarmor / 10) { 1.2 } )), High(Integer));
    nDamage := Min(LongWord(Round(nDamage * (g_Config.nPosionDamagarmor / 10) { 1.2 } )), High(Integer));
  end;
  if (m_nStatusPowerTime[POISON_DAMAGEARMOR] > 0) and (m_nStatusPowerType[POISON_DAMAGEARMOR] = 0) then
  begin // 脚本MAKEPOSION
    nDamage := Min(LongWord(nDamage + m_nStatusPower[POISON_DAMAGEARMOR]), High(Integer));
  end;
  if m_boThunderPalsy then
  begin
    Int64Value := Int64(nDamage) + Round(nDamage / 100 * g_Config.nSkill43LDMBPowerAdd);
    nDamage := Min(Int64Value, High(Integer));
  end;
  nDamageDura := Min(LongWord(Round(nDam * (g_Config.nDamageItemDuraRate / 100))), High(Integer));
  boRecalcAbilitys := False;
  boFeatureChanged := False;
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(Self);
    if SmartObject.m_UseItems[U_DRESS].wIndex > 0 then
    begin
      if SmartObject.m_UseItems[U_DRESS].Dura <= 0 then
      begin
        if g_Config.boDeleteItemDuraZero then
        begin
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            PlayObject := TPlayObject(Self);
            PlayObject.SendDelItem(@SmartObject.m_UseItems[U_DRESS]);
          end
          else if m_btRaceServer = RC_HEROOBJECT then
          begin
            THeroObject(Self).SendDelItem(@SmartObject.m_UseItems[U_DRESS]);
          end;
          { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
          // SmartObject.m_UseItems[U_DRESS].wIndex := 0;
          StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_DRESS].wIndex);
          if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
          begin
            AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, SmartObject.m_UseItems[U_DRESS].MakeIndex, '0',
              0, 0, '持久为0');
          end;
          SmartObject.m_UseItems[U_DRESS].wIndex := 0;
          if (m_btRaceServer = RC_PLAYOBJECT) and (StdItem <> nil) then
            TPlayObject(Self).ProcessUseItemSkill(U_DRESS, StdItem, False);
          boRecalcAbilitys := True;
          boFeatureChanged := True;
        end;
      end
      else
      begin
        nDura := SmartObject.m_UseItems[U_DRESS].Dura;
        nOldDura := Round(nDura / 1000);
        Dec(nDura, nDamageDura);
        if nDura <= 0 then
        begin
          StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_DRESS].wIndex);
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
            begin
              // 持久为0
            end;
          end;
          if g_Config.boDeleteItemDuraZero then
          begin
            if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
            begin
              AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, SmartObject, StdItem.Name,
                SmartObject.m_UseItems[U_DRESS].MakeIndex, '0', 0, 0, '0持久消失');
            end;
            if m_btRaceServer = RC_PLAYOBJECT then
            begin
              PlayObject := TPlayObject(Self);
              PlayObject.SendDelItem(@PlayObject.m_UseItems[U_DRESS]);
            end
            else if m_btRaceServer = RC_HEROOBJECT then
            begin
              THeroObject(Self).SendDelItem(@THeroObject(Self).m_UseItems[U_DRESS]);
            end;
            { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
            // SmartObject.m_UseItems[U_DRESS].wIndex := 0;
            SmartObject.m_UseItems[U_DRESS].wIndex := 0;
            if (m_btRaceServer = RC_PLAYOBJECT) and (StdItem <> nil) then
              TPlayObject(Self).ProcessUseItemSkill(U_DRESS, StdItem, False);
          end;
          SmartObject.m_UseItems[U_DRESS].Dura := 0;
          boRecalcAbilitys := True;
          boFeatureChanged := True;
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            if g_FunctionNPC <> nil then
            begin
              TPlayObject(Self).m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(TPlayObject(Self), '@ItemDamage' + IntToStr(U_DRESS), False);
            end;
          end;
        end
        else
        begin
          SmartObject.m_UseItems[U_DRESS].Dura := nDura;
        end;
        if nOldDura <> Round(nDura / 1000) then
        begin
          SendMsg(Self, RM_DURACHANGE, U_DRESS, nDura, SmartObject.m_UseItems[U_DRESS].DuraMax, 0, '');
        end;
      end;
    end;
    // 受到攻击后，减装备持久 chongchong 2014-09-12
    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      if (SmartObject.m_UseItems[I].wIndex > 0) then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[I].wIndex);
        if SmartObject.m_UseItems[I].Dura <= 0 then
        begin
          // stdmode = 96 祝福罐不判断持久 chongchong 2017-07-08
          // tdmode = 53 聚灵不判断持久 chongchong 2019-01-30 14:54:19
          if (StdItem <> nil) and (StdItem.StdMode in [53, 96]) then
            Continue;
          // 魔血石，魔幻石不减持久 2020-05-19
          if (StdItem <> nil) and ((StdItem.StdMode = 7) and (StdItem.Shape in [1, 2, 3])) then
            Continue;
          // 千里传音筒不减持久 2020-05-19
          if (StdItem <> nil) and (StdItem.StdMode = 7) and (StdItem.Shape = 0) then
            Continue;
          // 火龙之心
          if (StdItem <> nil) and (StdItem.StdMode = 25) and (StdItem.Shape = 9) then
            Continue;
          if g_Config.boDeleteItemDuraZero then
          begin
            if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
            begin
              AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, SmartObject, StdItem.Name, SmartObject.m_UseItems[I].MakeIndex,
                '0', 0, 0, '0持久消失');
            end;
            if m_btRaceServer = RC_PLAYOBJECT then
            begin
              PlayObject := TPlayObject(Self);
              PlayObject.SendDelItem(@PlayObject.m_UseItems[I]);
            end
            else if m_btRaceServer = RC_HEROOBJECT then
            begin
              THeroObject(Self).SendDelItem(@THeroObject(Self).m_UseItems[I]);
            end;
            { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
            // SmartObject.m_UseItems[I].wIndex := 0;
            StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[I].wIndex);
            SmartObject.m_UseItems[I].wIndex := 0;
            if (m_btRaceServer = RC_PLAYOBJECT) and (StdItem <> nil) then
              TPlayObject(Self).ProcessUseItemSkill(I, StdItem, False);
            boRecalcAbilitys := True;
            boFeatureChanged := boFeatureChanged or (I in [U_DRESS, U_WEAPON]);
            Continue;
          end
          else
          begin
            Continue;
          end;
        end;
        if (Random(8) <> 0) then
          Continue;
        if StdItem = nil then
          Continue;
        // stdmode = 25；符，毒 不减持久 chongchong 2014-09-12
        if StdItem.StdMode = 25 then
          Continue;
        // stdmode = 96 祝福罐不要减持久 chongchong 2017-07-08
        // tdmode = 53 聚灵不判断持久 chongchong 2019-01-30 14:54:19
        if (StdItem.StdMode in [53, 96]) then
          Continue;
        // 魔血石，魔幻石产减持久 2020-05-19
        if ((StdItem.StdMode = 7) and (StdItem.Shape in [1, 2, 3])) then
          Continue;
        // 千里传音/传音筒不减持久 chongchong 2018-09-13 16:10:28
        if (StdItem.StdMode = 7) and (StdItem.Shape = 0) and (StdItem.Anicount > 0) then
          Continue;
        nDura := SmartObject.m_UseItems[I].Dura;
        nOldDura := Round(nDura / 1000);
        Dec(nDura, nDamageDura);
        if nDura <= 0 then
        begin
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              // 持久为0
            end;
          end;
          if g_Config.boDeleteItemDuraZero then
          begin
            if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
            begin
              AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, SmartObject, StdItem.Name, SmartObject.m_UseItems[I].MakeIndex,
                '0', 0, 0, '0持久消失');
            end;
            if m_btRaceServer = RC_PLAYOBJECT then
            begin
              PlayObject := TPlayObject(Self);
              PlayObject.SendDelItem(@PlayObject.m_UseItems[I]);
            end
            else if m_btRaceServer = RC_HEROOBJECT then
            begin
              THeroObject(Self).SendDelItem(@THeroObject(Self).m_UseItems[I]);
            end;
            { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
            // SmartObject.m_UseItems[I].wIndex := 0;
            SmartObject.m_UseItems[I].wIndex := 0;
            if (m_btRaceServer = RC_PLAYOBJECT) then
              TPlayObject(Self).ProcessUseItemSkill(I, StdItem, False);
          end;
          SmartObject.m_UseItems[I].Dura := 0;
          boRecalcAbilitys := True;
          boFeatureChanged := boFeatureChanged or (I in [U_DRESS, U_WEAPON]);
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            if g_FunctionNPC <> nil then
            begin
              TPlayObject(Self).m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(TPlayObject(Self), '@ItemDamage' + IntToStr(I), False);
            end;
          end;
        end
        else
        begin
          SmartObject.m_UseItems[I].Dura := nDura;
          if nOldDura <> Round(nDura / 1000) then
          begin
            SendMsg(Self, RM_DURACHANGE, I, nDura, SmartObject.m_UseItems[I].DuraMax, 0, '');
          end;
        end;
      end;
    end;
    // 受到攻击后，首饰盒物品减装备持久 chongchong 2014-09-12
    if g_Config.boJewelryDecDura then
    begin
      for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
      begin
        if (SmartObject.m_JewelryBoxItems[I].wIndex > 0) then
        begin
          if SmartObject.m_JewelryBoxItems[I].Dura <= 0 then
          begin
            if g_Config.boDeleteItemDuraZero then
            begin
              StdItem := UserEngine.GetStdItem(SmartObject.m_JewelryBoxItems[I].wIndex);
              if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
              begin
                AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, SmartObject, StdItem.Name,
                  SmartObject.m_JewelryBoxItems[I].MakeIndex, '0', 0, 0, '0持久消失');
              end;
              if m_btRaceServer = RC_PLAYOBJECT then
              begin
                PlayObject := TPlayObject(Self);
                PlayObject.SendDelItem(@PlayObject.m_JewelryBoxItems[I]);
              end
              else if m_btRaceServer = RC_HEROOBJECT then
              begin
                THeroObject(Self).SendDelItem(@THeroObject(Self).m_JewelryBoxItems[I]);
              end;
              SmartObject.m_JewelryBoxItems[I].wIndex := 0;
              if (m_btRaceServer = RC_PLAYOBJECT) and (StdItem <> nil) then
                TPlayObject(Self).ProcessUseItemSkill(I, StdItem, False);
              boRecalcAbilitys := True;
              Continue;
            end
            else
            begin
              Continue;
            end;
          end;
          if (Random(8) <> 0) then
            Continue;
          StdItem := UserEngine.GetStdItem(SmartObject.m_JewelryBoxItems[I].wIndex);
          if StdItem = nil then
            Continue;
          // stdmode = 25；符，毒 不减持久 chongchong 2014-09-12
          if StdItem.StdMode = 25 then
            Continue;
          // 千里传音筒，魔血石，魔幻石不减持久 2020-05-19
          if (StdItem.StdMode = 7) and (StdItem.Shape in [0, 1, 2, 3]) then
            Continue;
          // 火龙之心
          if (StdItem.StdMode = 25) and (StdItem.Shape = 9) then
            Continue;
          nDura := SmartObject.m_JewelryBoxItems[I].Dura;
          nOldDura := Round(nDura / 1000);
          Dec(nDura, nDamageDura);
          if nDura <= 0 then
          begin
            if m_btRaceServer = RC_PLAYOBJECT then
            begin
              if StdItem.NeedIdentify = 1 then
              begin
                // 持久为0
              end;
            end;
            if g_Config.boDeleteItemDuraZero then
            begin
              if (StdItem.NeedIdentify = 1) then
                AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, SmartObject.m_JewelryBoxItems[I].MakeIndex,
                  '0', 0, 0, '0持久消失');
              if m_btRaceServer = RC_PLAYOBJECT then
              begin
                PlayObject := TPlayObject(Self);
                PlayObject.SendDelItem(@PlayObject.m_JewelryBoxItems[I]);
              end
              else if m_btRaceServer = RC_HEROOBJECT then
              begin
                THeroObject(Self).SendDelItem(@THeroObject(Self).m_JewelryBoxItems[I]);
              end;
              { TODO -ochongchong -c修改 : 去装备后，删除特定技能 【2013-08-27】 }
              // SmartObject.m_JewelryBoxItems[I].wIndex := 0;
              SmartObject.m_JewelryBoxItems[I].wIndex := 0;
              if (m_btRaceServer = RC_PLAYOBJECT) then
                TPlayObject(Self).ProcessUseItemSkill(I, StdItem, False);
            end;
            SmartObject.m_JewelryBoxItems[I].Dura := 0;
            boRecalcAbilitys := True;
            if m_btRaceServer = RC_PLAYOBJECT then
            begin
              if g_FunctionNPC <> nil then
              begin
                TPlayObject(Self).m_nScriptGotoCount := 0;
                g_FunctionNPC.GotoLable(TPlayObject(Self), '@ItemDamage' + IntToStr(I), False);
              end;
            end;
          end
          else
          begin
            SmartObject.m_JewelryBoxItems[I].Dura := nDura;
            if nOldDura <> Round(nDura / 1000) then
            begin
              SendMsg(Self, RM_DURACHANGE, I, nDura, SmartObject.m_JewelryBoxItems[I].DuraMax, 0, '');
            end;
          end;
        end;
      end;
    end;
  end;
  if boRecalcAbilitys then
  begin
    RecalcAbilitys();
    if (m_btRaceServer in [RC_HEROOBJECT, RC_PLAYOBJECT]) then
    begin
      SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
      SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
    end;
  end;
  if boFeatureChanged then
    FeatureChanged(); // 刷新外观
  // 秒杀保护 2020-09-17 22:47:01
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    nDamage := TSmartObject(Self).GetStruckProtectHP(nDamage);
  end;
  if StruckFrom = nil then
  begin
    m_MagicShieldDecMP := 0;
    Result := DamageHealth(nDamage, nil, False);
  end
  else
  begin
    nOldMagicID := StruckFrom.m_wCurrMagicId;
    nOldMagicID2 := m_wCurrMagicId;
    OldCurTarget := m_CurrTarget;
    StruckFrom.m_wCurrMagicId := MagicID;
    m_wCurrMagicId := MagicID;
    m_CurrTarget := StruckFrom;
    nOldMP := m_WAbil.MP;
    Result := DamageHealth(nDamage, StruckFrom, True);
    if m_WAbil.MP < nOldMP then
      m_MagicShieldDecMP := nOldMP - m_WAbil.MP
    else
      m_MagicShieldDecMP := 0;
    StruckFrom.m_wCurrMagicId := nOldMagicID;
    m_wCurrMagicId := nOldMagicID2;
    m_CurrTarget := OldCurTarget;
  end;
  if (StruckFrom <> nil) and IsSetPKPower then
  begin
    StruckFrom.m_nLastPKPower := Result + m_MagicShieldDecMP;
  end;
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    if TSmartObject(Self).m_boSuperShiled and (TSmartObject(Self).m_MagicSuperShiledSkill <> nil) then
    begin // 护体神盾被击破
      nTemp := g_Config.nCloseSuperShiledRate +
        Round(g_Config.nCloseSuperShiledRate / 100 * ((TSmartObject(Self).m_MagicSuperShiledSkill.btLevel + TSmartObject(Self)
        .m_MagicSuperShiledSkill.btNewLevel) * g_Config.nCloseSuperShiledLevelUpDecRate));
      Randomize;
      if (nTemp <= 0) or (Random(nTemp) = 0) then
      begin
        TSmartObject(Self).CloseSuperShiled;
      end;
    end;
  end;
end;

