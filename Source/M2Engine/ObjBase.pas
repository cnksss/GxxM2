  for II := 0 to BaseObjectList.Count - 1 do
  begin
    BaseObject := TBaseObject(BaseObjectList.Items[II]);
    if (BaseObject <> nil) //
      and (BaseObject <> Self) //
      and (not BaseObject.m_boDeath) //
      and (not BaseObject.m_boGhost) //
      and IsProperTarget(BaseObject) then
    begin
      if ((BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and (BaseObject.m_btJob = 0)) or
        ((Abs(BaseObject.m_nCurrX - m_nCurrX) <= nRange) and (Abs(BaseObject.m_nCurrY - m_nCurrY) <= nRange)) then
        Inc(Result);
    end;
  end;
