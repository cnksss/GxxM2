  function FloowMasterEx: Boolean;
  var
    CanWalk: Boolean;
    nX, nY: Integer;
  begin
    Result := False;
    CanWalk := False;

    // 往主人左边走
    if m_PEnvir.GetNextPosition(m_Master.m_nCurrX, m_Master.m_nCurrY, (m_Master.m_btDirection + 6) mod 8, 1, nX, nY) then
    begin
      if (m_nCurrX <> nX) or (m_nCurrY <> nY) then
      begin
        if m_PEnvir.CanWalk(nX, nY, True) then
        begin
          CanWalk := True;
          SetTargetXY(nX, nY);
          GotoTargetXY;
          Result := True;
        end
        else
          CanWalk := False;
      end;
    end;

    if not CanWalk then
    begin
      // 往主人右边走
      if m_PEnvir.GetNextPosition(m_Master.m_nCurrX, m_Master.m_nCurrY, (m_Master.m_btDirection + 2) mod 8, 1, nX, nY) then
      begin
        if (m_nCurrX <> nX) or (m_nCurrY <> nY) then
        begin
          if m_PEnvir.CanWalk(nX, nY, True) then
          begin
            CanWalk := True;
            SetTargetXY(nX, nY);
            GotoTargetXY;
            Result := True;
          end
          else
            CanWalk := False;
        end;
      end;
    end;

    if not CanWalk then
    begin
      // 往主人后面走
      if m_Master.GetBackPosition(m_Master.m_btDirection, m_Master.m_nCurrX, m_Master.m_nCurrY, nX, nY, 2) then
      begin
        if (m_nCurrX <> nX) or (m_nCurrY <> nY) then
        begin
          if m_PEnvir.CanWalk(nX, nY, True) then
          begin
            SetTargetXY(nX, nY);
            GotoTargetXY;
            Result := True;
          end;
        end;
      end;
    end
    else
      m_dwMoveTimeTick := MyGetTickCount;
  end;

var
  I, nX, nY: Integer;
  boRun: Boolean;
  nWalkTime: LongWord;
begin
  if (m_Master <> nil) then
  begin
    if ((not m_Master.m_boSlaveRelax) or (m_boGamePet and (not g_Config.boPetSleepControlBySlave))) //
      and (not m_boGhost) //
      and (not m_boDeath) then
    begin
      if (m_PEnvir <> m_Master.m_PEnvir) //
        or (Abs(m_nCurrX - m_Master.m_nCurrX) > 20) //
        or (Abs(m_nCurrY - m_Master.m_nCurrY) > 20) then
      begin
        m_Master.GetBackPosition(nX, nY);
        if not m_Master.m_PEnvir.CanWalk(nX, nY, True) then
        begin
          for I := 0 to 7 do
          begin
            if m_Master.m_PEnvir.GetNextPosition(m_Master.m_nCurrX, m_Master.m_nCurrY, I, 1, nX, nY) then
            begin
              if m_Master.m_PEnvir.CanWalk(nX, nY, True) then
              begin
                Break;
              end;
            end;
          end;
        end;

        DelTargetCreat;
        m_nTargetX := nX;
        m_nTargetY := nY;
        SpaceMove(m_Master.m_PEnvir.sMapName, m_nTargetX, m_nTargetY, 1);
        Exit;
      end;

      if (m_TargetCret = nil) then
      begin
        case m_btJob of
          0:
            nWalkTime := g_Config.dwMonsterWarrorWalkTime;
          1:
            nWalkTime := g_Config.dwMonsterWizardWalkTime;
          2:
            nWalkTime := g_Config.dwMonsterTaoistWalkTime;
        else
          nWalkTime := 500;
        end;

        if MyGetTickCount - m_dwMoveTimeTick > nWalkTime then
        begin
          if m_btRaceServer = RC_MOONOBJECT then
            boRun := True
            { TODO -ochongchong -c修改 : 修正人形怪移动时，速度很快 【2013-08-23】 }
          else if m_btRaceServer = RC_PLAYMOSTER then
            boRun := True
          else
            boRun := True;

          { 面向主人时，宝宝往主人旁边或后面走 }
          if (GetNextDirection(m_Master.m_nCurrX, m_Master.m_nCurrY, m_nCurrX, m_nCurrY) = m_Master.m_btDirection) and
            (Abs(m_Master.m_nCurrX - m_nCurrX) <= 3) and (Abs(m_Master.m_nCurrY - m_nCurrY) <= 3) then
          begin
            FloowMasterEx;
            Exit;
          end;

          if GotoMasterXY(boRun, nX, nY) then
          begin
            SetTargetXY(nX, nY);
            if (Abs(m_nCurrX - nX) > 1) or (Abs(m_nCurrY - nY) > 1) then
            begin
              RunTo(GetNextDirection(m_nCurrX, m_nCurrY, nX, nY), False);
              m_dwMoveTimeTick := MyGetTickCount;
            end
            else
            begin
              WalkTo(GetNextDirection(m_nCurrX, m_nCurrY, nX, nY), False);
              m_dwMoveTimeTick := MyGetTickCount;
            end;
          end;
        end;
      end;
    end;
  end
  else
  begin
    if m_boLockAttack then
    begin
      case m_btJob of
        0:
          nWalkTime := g_Config.dwMonsterWarrorWalkTime;
        1:
          nWalkTime := g_Config.dwMonsterWizardWalkTime;
        2:
          nWalkTime := g_Config.dwMonsterTaoistWalkTime;
      else
        nWalkTime := 500;
      end;

      if MyGetTickCount - m_dwMoveTimeTick > nWalkTime then
      begin
        if (Length(m_MovePath) > 0) and GotoNext() then
        begin
          m_dwMoveTimeTick := MyGetTickCount;
          Exit;
        end;
        m_boLockAttack := False;
      end;
      Exit;
    end;
    inherited;
  end;
end;

function TSmartObject.GetMagicCD(wMagIdx: Word): LongWord;
var
  MagicCD: PMagicInterval;
begin
  Result := 0;
{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun then
    g_MagicCDList.Lock;
  try
{$IFEND}
    MagicCD := g_MagicCDList.Find(wMagIdx);
    if MagicCD = nil then
      Exit;

    Result := MagicCD.Interval;
{$IF MULTI_THREAD = 1}
  finally
    if g_MultiThreadRun then
      g_MagicCDList.UnLock;
  end;
{$IFEND}
  if Result = 0 then
    Exit;
{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun then
    m_MagicCDDecList.Lock;
  try
{$IFEND}
    MagicCD := m_MagicCDDecList.Find(wMagIdx);
    if MagicCD = nil then
      Exit;
    if Result > MagicCD.Interval then
      Result := Result - MagicCD.Interval
    else
      Result := 0;
{$IF MULTI_THREAD = 1}
  finally
    if g_MultiThreadRun then
      m_MagicCDDecList.UnLock;
  end;
{$IFEND}
end;

function TSmartObject.FindMagic(wMagIdx: Word): pTUserMagic;
begin
  if (wMagIdx < Length(m_UserMagics)) then
    Result := m_UserMagics[wMagIdx]
  else
    Result := nil;
end;

function TSmartObject.GetContinuousMagicCount: Integer; // 获取连击技能数量
var
  I: Integer;
  UserMagic: pTUserMagic;
begin
  Result := 0;
  for I := 0 to m_MagicList.Count - 1 do
  begin
    UserMagic := m_MagicList.Items[I];
    if (UserMagic.MagicAttr = mtContinuous) then
      Inc(Result);
  end;
end;

function TSmartObject.GetCurrentSlaveName: string;
begin
  if m_SlaveList.Count > 0 then
    Result := TBaseObject(m_SlaveList[0]).m_sCharName
  else
    Result := '';
end;

function TSmartObject.GetCurrentSlaveTargetName: string;
var
  I: Integer;
  tmpSlaveObj: TBaseObject;
begin
  for I := 0 to m_SlaveList.Count - 1 do
  begin
    tmpSlaveObj := TBaseObject(m_SlaveList[I]);
    if tmpSlaveObj <> nil then
    begin
      if (tmpSlaveObj.m_TargetCret <> nil) and (not tmpSlaveObj.m_TargetCret.m_boGhost) then
        Result := tmpSlaveObj.m_TargetCret.m_sCharName
      else
        Result := '';
    end;
  end;
end;

function TSmartObject.FindContinuousMagic(wMagicID: Word): pTUserMagic; // 获取连击技能
var
  I: Integer;
  UserMagic: pTUserMagic;
begin
  Result := nil;
  for I := 0 to m_MagicList.Count - 1 do
  begin
    UserMagic := m_MagicList.Items[I];
    if (UserMagic.MagicAttr = mtContinuous) and (UserMagic.wMagIdx = wMagicID) then
    begin
      Result := UserMagic;
      Break;
    end;
  end;
end;

function TSmartObject.FindMagic(sMagicName: string): pTUserMagic;
var
  UserMagic: pTUserMagic;
  I: Integer;
begin
  Result := nil;
  for I := 0 to m_MagicList.Count - 1 do
  begin
    UserMagic := m_MagicList.Items[I];
    if (UserMagic.MagicInfo <> nil) and SameText(UserMagic.MagicInfo.sMagicName, sMagicName) then
    begin
      Result := UserMagic;
      Break;
    end;
  end;
end;

procedure TSmartObject.DelTargetCreat();
begin
  inherited;
  m_nTargetX := -1;
  m_nTargetY := -1;
  m_boTarget := False;
  m_boTargetAgain := False;
end;

function TSmartObject.AllowUseMagic(wMagIdx: Word; ShowLowMPHit: Boolean): Boolean;
var
  UserMagic: pTUserMagic;
  nSpellPoint: Integer;
begin
  Result := False;
  if (wMagIdx = 22) and g_Config.boDisableInSafeZoneFireCross and (m_TargetCret <> nil) and
    InSafeZone(m_PEnvir, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY) then
    Exit;

  if (wMagIdx < Length(m_UserMagics)) and m_PEnvir.AllowMagics(wMagIdx) then
  begin
    UserMagic := m_UserMagics[wMagIdx]; // FindMagic(wMagIdx);
    if UserMagic <> nil then
    begin
      if not MagicManager.IsWarrSkill(UserMagic.wMagIdx) then
      begin
        if (UserMagic.btKey > 0) or m_boDummyObject or
          ((ClassType = TCopyMon) and (m_Master <> nil) and (m_Master.m_btRaceServer <> RC_HEROOBJECT)) then
        begin
          nSpellPoint := GetSpellPoint(UserMagic);
          case m_btRaceServer of
            RC_PLAYMOSTER:
              begin
                if m_boInfiniteMagic or ((nSpellPoint > 0) and (nSpellPoint <= m_WAbil.MP)) then
                  Result := True;
              end;
            RC_HEROOBJECT, RC_MOONOBJECT:
              begin
                if (m_WAbil.MP > 0) and (nSpellPoint <= m_WAbil.MP) then
                  Result := True
                else if ShowLowMPHit then
                  SysMsg('MP不足，无法使用技能！', c_Red, t_Hint); // 提示用户
              end;
          else
            if (m_WAbil.MP > 0) and (nSpellPoint <= m_WAbil.MP) then
              Result := True;
          end;
        end;
      end
      else
        Result := UserMagic.btKey > 0;
    end;
  end;
end;

function TSmartObject.CanUseMagic(): Boolean; // 检测是否可以使用保护魔法
var
  I, nCount: Integer;
  UserMagic: pTUserMagic;
begin
  Result := False;
  case m_btJob of
    2:
      begin
        for I := 0 to m_MagicList.Count - 1 do
        begin
          UserMagic := m_MagicList.Items[I];
          if (UserMagic.MagicInfo <> nil) and (UserMagic.MagicInfo.btJob in [2, 99]) then
          begin
            if (UserMagic.wMagIdx = SKILL_HANGMAJINBUB) { 14 }
              or (UserMagic.wMagIdx = SKILL_DEJIWONHO) { 15 }
              or (UserMagic.wMagIdx = SKILL_HOLYSHIELD) { 16 }
              or (UserMagic.wMagIdx = SKILL_SKELLETON) { 17 }
              or (UserMagic.wMagIdx = SKILL_CLOAK) { 18 }
              or (UserMagic.wMagIdx = SKILL_BIGCLOAK) { 19 }
              or (UserMagic.wMagIdx = SKILL_BIGHEALLING) { 29 }
              or (UserMagic.wMagIdx = SKILL_SINSU) { 30 }
              or (UserMagic.wMagIdx = SKILL_76) then
            begin // 需要符
              nCount := 1;
              if UserMagic.wMagIdx = SKILL_AMYOUNSUL { 6 } then
                nCount := 1
              else if UserMagic.wMagIdx = SKILL_HANGMAJINBUB { 14 } then
                nCount := 1
              else if UserMagic.wMagIdx = SKILL_DEJIWONHO { 15 } then
                nCount := 1
              else if UserMagic.wMagIdx = SKILL_HOLYSHIELD { 16 } then
                nCount := 1
              else if UserMagic.wMagIdx = SKILL_SKELLETON { 17 } then
                nCount := 1
              else if UserMagic.wMagIdx = SKILL_CLOAK { 18 } then
                nCount := 1
              else if UserMagic.wMagIdx = SKILL_BIGCLOAK { 19 } then
                nCount := 1
              else if UserMagic.wMagIdx = SKILL_BIGHEALLING { 29 } then
                nCount := 1
              else if UserMagic.wMagIdx = SKILL_SINSU { 30 } then
                nCount := 5;
              Result := CheckUserItem(Self, 5, nCount);
              if Result then
                Break;
            end;
          end;
        end;
      end;
  end;
end;

// 1 为护身符 2 为毒药
function TSmartObject.CanUseAttackMagic(): Boolean; // 检测是否可以使用攻击魔法
var
  I: Integer;
  UserMagic: pTUserMagic;
begin
  Result := False;
  case m_btJob of
    0:
      Result := True;
    1:
      begin
        for I := 0 to m_MagicList.Count - 1 do
        begin
          UserMagic := m_MagicList.Items[I];
          if (UserMagic.wMagIdx = SKILL_FIREBALL) { 1 } or (UserMagic.wMagIdx = SKILL_FIREBALL2) or
            (UserMagic.wMagIdx = SKILL_FIRE) or (UserMagic.wMagIdx = SKILL_SHOOTLIGHTEN) or (UserMagic.wMagIdx = SKILL_LIGHTENING)
            or (UserMagic.wMagIdx = SKILL_EARTHFIRE) or (UserMagic.wMagIdx = SKILL_FIREBOOM) or
            (UserMagic.wMagIdx = SKILL_LIGHTFLOWER) or (UserMagic.wMagIdx = SKILL_SNOWWIND) or
            (UserMagic.wMagIdx = SKILL_GROUPLIGHTENING) or (UserMagic.wMagIdx = SKILL_47) //
            or (UserMagic.wMagIdx = SKILL_205) // 冰霜雪雨
            or (UserMagic.wMagIdx = SKILL_206) then // 冰霜群雨
          begin
            if AllowUseMagic(UserMagic.wMagIdx) then
            begin
              Result := True;
              Break;
            end;
          end;
        end;
      end;
    2:
      begin
        for I := 0 to m_MagicList.Count - 1 do
        begin
          UserMagic := m_MagicList.Items[I];
          if (UserMagic.MagicInfo <> nil) and (UserMagic.MagicInfo.btJob in [2, 99]) then
          begin
            if (UserMagic.wMagIdx = SKILL_AMYOUNSUL) or (UserMagic.wMagIdx = SKILL_GROUPAMYOUNSUL) { 6 施毒术 } then
            begin // 需要毒药    , SKILL_GROUPAMYOUNSUL {51 群体施毒术}
              Result := CheckUserItem(Self, 1, 2) or CheckUserItem(Self, 2, 2);
              if Result then
                Result := AllowUseMagic(SKILL_AMYOUNSUL) or AllowUseMagic(SKILL_GROUPAMYOUNSUL);
              if Result then
                Break;
            end
            else if (UserMagic.wMagIdx = SKILL_FIRECHARM) then
            begin // 需要符
              Result := CheckUserItem(Self, 5, 1);
              if Result then
                Result := AllowUseMagic(SKILL_FIRECHARM);
              if Result then
                Break;
            end;
          end;
        end;
      end;
  end;
end;

function TSmartObject.GetRangeTargetCounByDir(nDir, nX, nY, nRange: Integer): Integer;
var
  I, II: Integer;
  BaseObject: TBaseObject;
  nCurrX, nCurrY: Integer;
  BaseObjectList: TList;
begin
  Result := 0;
  nCurrX := nX;
  nCurrY := nY;
  BaseObjectList := TList.Create;

  for I := 1 to nRange do
  begin
    if m_PEnvir.GetNextPosition(nCurrX, nCurrY, nDir, 1, nCurrX, nCurrY) then
    begin
      BaseObjectList.Clear;
      if m_PEnvir.GetMovingObject(nCurrX, nCurrY, True, BaseObjectList) > 0 then
      begin
        for II := 0 to BaseObjectList.Count - 1 do
        begin
          BaseObject := TBaseObject(BaseObjectList.Items[II]);
          if (BaseObject <> nil) //
            and (not BaseObject.m_boDeath) //
            and (not BaseObject.m_boGhost) //
            and IsProperTarget(BaseObject) then
            Inc(Result);
        end;
      end;
    end;
  end;
  BaseObjectList.Free;
end;

function TSmartObject.GetNearTargetCount(nRange: Integer): Integer;
var
  II: Integer;
  BaseObject: TBaseObject;
  BaseObjectList: TList;
begin
  Result := 0;
  BaseObjectList := TList.Create;
