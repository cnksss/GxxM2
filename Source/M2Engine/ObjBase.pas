            STATE_DEFENCEUP:
              begin
                boNeedRecalc := True;
                // SysMsg('防御力恢复正常', c_Green, t_Hint);
              end;
            STATE_MAGDEFENCEUP:
              begin
                boNeedRecalc := True;
                // SysMsg('魔御力恢复正常', c_Green, t_Hint);
              end;
            STATE_BUBBLEDEFENCEUP:
              m_boAbilMagBubbleDefence := False;
            STATE_NewHitBUBBLEDEFENCEUP:
              m_boAbilNewHitBubbleDefence := False;
            STATE_NewMagBUBBLEDEFENCEUP:
              m_boAbilNewMagBubbleDefence := False;
          end;
        end;
      end;
    end;

    nCheckCode := 5005;
    for I := Low(m_wStatusArrValue) to High(m_wStatusArrValue) do
    begin
      if (m_wStatusArrValue[I] { 218 } > 0) and (MyGetTickCount() > m_dwStatusArrTimeOutTick[I] { 220 } ) then
      begin
        m_wStatusArrValue[I] := 0;
        boChg := True;
        boNeedRecalc := True;
        case I of
          0:
            SysMsg('攻击力恢复正常', c_Green, t_Hint);
          1:
            SysMsg('魔法力恢复正常', c_Green, t_Hint);
          2:
            SysMsg('精神力恢复正常', c_Green, t_Hint);
          3:
            SysMsg('攻击速度恢复正常', c_Green, t_Hint);
          4:
            SysMsg('生命值恢复正常', c_Green, t_Hint);
          5:
            SysMsg('魔法值恢复正常', c_Green, t_Hint);
        end;
      end;
    end;

    nCheckCode := 5006;
    for I := Low(m_dwDecStatusArrTick) to High(m_dwDecStatusArrTick) do
    begin
      if (m_wDecStatusTimeArr[I] > 0) and (m_wDecStatusTimeArr[I] < 60000) then
      begin
        if tick_diff(m_dwDecStatusArrTick[I], MyGetTickCount()) >= 1000 then
        begin
          Dec(m_wDecStatusTimeArr[I]);
          m_dwDecStatusArrTick[I] := MyGetTickCount();
          if (m_wDecStatusTimeArr[I] = 0) then
          begin
            boChg := True;
            case I of
              STATE_TRANSPARENT:
                begin
                  // m_boHideMode := False;
                end;
              STATE_DEFENCEUP:
                begin
                  boNeedRecalc := True;
                  m_wStatusTimeArr[STATE_DEFENCEUP] := 0;
                  SysMsg(g_sDefenceUpTimeOver, c_Green, t_Hint);
                end;
              STATE_MAGDEFENCEUP:
                begin
                  boNeedRecalc := True;
                  m_wStatusTimeArr[STATE_MAGDEFENCEUP] := 0;
                  SysMsg(g_sMagDefenceUpTimeOver, c_Green, t_Hint);
                end;
              STATE_BUBBLEDEFENCEUP:
                begin
                end;
              STATE_NEW_CURSE:
                begin
                  boNeedRecalc := True;
                  m_wStatusTimeArr[STATE_NEW_CURSE] := 0;
                  SysMsg(g_sSubDCMCSCMsgTimeOver, c_Green, t_Hint);
                end;
            end;
          end;
        end;
      end
      else
        m_wDecStatusTimeArr[I] := 0;
    end;

    nCheckCode := 5007;
    for I := Low(m_wDecStatusArrValue) to High(m_wDecStatusArrValue) do
    begin // 恢复减属性
      if (m_wDecStatusArrValue[I] { 218 } > 0) and (MyGetTickCount() > m_dwDecStatusArrTimeOutTick[I] { 220 } ) then
      begin
        m_wDecStatusArrValue[I] := 0;
        boNeedRecalc := True;
        case I of
          0:
            SysMsg('攻击力恢复正常', c_Green, t_Hint);
          1:
            SysMsg('魔法力恢复正常', c_Green, t_Hint);
          2:
            SysMsg('精神力恢复正常', c_Green, t_Hint);
          3:
            SysMsg('攻击速度恢复正常', c_Green, t_Hint);
          4:
            SysMsg('生命值恢复正常', c_Green, t_Hint);
          5:
            SysMsg('魔法值恢复正常', c_Green, t_Hint);
        end;
      end;
    end;

    nCheckCode := 5008;
    if m_boZeroArmor and (MyGetTickCount() > m_dwZeroArmorTick) then
    begin
      m_boZeroArmor := False;
      boNeedRecalc := True;
      SysMsg('防御力、魔法防御力恢复正常', c_Green, t_Hint);
    end;

    nCheckCode := 5009;
    if m_boZeroAC and (MyGetTickCount() > m_dwZeroACTick) then
    begin
      m_boZeroAC := False;
      boNeedRecalc := True;
      SysMsg(g_sDefenceUpTimeOver, c_Green, t_Hint);
    end;

    nCheckCode := 5010;
    if m_boZeroMAC and (MyGetTickCount() > m_dwZeroMACTick) then
    begin
      m_boZeroMAC := False;
      boNeedRecalc := True;
      SysMsg(g_sMagDefenceUpTimeOver, c_Green, t_Hint);
    end;

    nCheckCode := 5011;
    if boChg then
    begin
      nCheckCode := 5012;
      m_nCharStatus := GetCharStatus();
      StatusChanged();
    end;

    nCheckCode := 5013;
    if boNeedRecalc then
    begin
      nCheckCode := 5014;
      RecalcAbilitys();
      nCheckCode := 5015;
      SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
    end;

    if boSendSubAbility then
      SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
  except
    MainOutMessage(sExceptionMsg5 + ';' + IntToStr(nCheckCode));
  end;

  // 蜘蛛网罩住
  if m_boCobwebWindingStatus and (MyGetTickCount() > m_dwCobwebWindingStatusTick) then
    CloseCobwebWinding(); // 蜘蛛网罩住 关闭

  if m_boToxicSmoke and (MyGetTickCount() > m_dwToxicSmokeTick) then
    CloseToxicSmoke();

  // 永恒冰冻
  if m_boForeverFrozen and (MyGetTickCount() > m_dwForeverFrozenTick) then
    CloseForeverFrozen();

  if m_boDingShen and (MyGetTickCount() > m_dwDingShenTick) then
    CloseDingShen;

  if m_boTanHuan and (MyGetTickCount() > m_dwTanHuanTick) then
    CloseTanHuan;

  if m_boThunderPalsy and (MyGetTickCount() > m_dwThunderPalsyTick) then
    CloseThunderPalsy;

  m_CustomMagicStatusList.LockW(2);
  try
    if m_CustomMagicStatusList.Count > 0 then
    begin
      if tick_diff(m_dwCustomMagicStatusCheckTick, MyGetTickCount()) >= 1000 then
      begin
        m_dwCustomMagicStatusCheckTick := MyGetTickCount();
        LastCustomMagicStatusID := PCustomMagicStatus(m_CustomMagicStatusList.Items[0]).MagicID;
        for I := m_CustomMagicStatusList.Count - 1 downto 0 do
        begin
          CustomMagicStatus := m_CustomMagicStatusList.Items[I];
          if tick_diff(CustomMagicStatus.StartTick, MyGetTickCount()) >= CustomMagicStatus.EffectiveTime * 1000 then
          begin
            m_CustomMagicStatusList.Delete(I);
            Dispose(CustomMagicStatus);
          end;
        end;

        if m_CustomMagicStatusList.Count > 0 then
        begin
          CustomMagicStatus := m_CustomMagicStatusList.Items[0];
          if LastCustomMagicStatusID <> CustomMagicStatus.MagicID then
            SendRefMsg(RM_EFFECTSTEP, 9991, CustomMagicStatus.MagicID, CustomMagicStatus.MagicLevel, 0, '', 0);
        end
        else
          SendRefMsg(RM_EFFECTSTEP, 9990, 0, 0, 0, '');
      end;
    end;
  finally
    m_CustomMagicStatusList.UnLockW;
  end;

  try
    if (m_nBloodLossTimeLeft > 0) //
      and (MyGetTickCount() - m_nBloodLossTick > m_nBloodLossTimeInterval) then
    begin
      m_nBloodLossTick := MyGetTickCount();
      Dec(m_nBloodLossTimeLeft);
      DamageHealth(m_nBloodLossPoint, nil);
      boNeedRefreshHMP := True;
    end;

    // 毒烟持续掉血 chongchong 2015-07-31 22:36:43
    if m_boToxicSmoke //
      and (m_nToxicSmokePoint > 0) //
      and (MyGetTickCount() <= m_dwToxicSmokeTick) //
      and (MyGetTickCount() - m_dwToxicSmokeDecHPTick >= g_Config.dwPosionDecHealthTime) then
    begin
      m_dwToxicSmokeDecHPTick := MyGetTickCount();
      DamageHealth(m_nToxicSmokePoint, nil);
      // SendRefMsg(RM_HEALTHSPELLCHANGED, 2, 0, 0, 0, '');
      boNeedRefreshHMP := True; // 优化chongchong 2018-02-13
    end;

    if (MyGetTickCount() - m_dwPoisoningTick) > g_Config.dwPosionDecHealthTime { 2500 } then
    begin // 中毒自动减血
      m_dwPoisoningTick := MyGetTickCount();
      if m_wStatusTimeArr[POISON_DECHEALTH { 0 0x60 } ] > 0 then
      begin
        if m_boAnimal then
          Dec(m_nMeatQuality, 1000);

        nDamage := DamageHealth(m_nGreenPoisoningPoint + 1, nil);
        m_nHealthTick := 0;
        m_nSpellTick := 0;
        // 施毒术不要飘血 chongchong 2017-09-15
        if not g_Config.boPoisoningHideHealthNum then
        begin
          if nDamage > 0 then
            SendRefMsg(RM_HEALTHSPELLCHANGED_STRUCK, nDamage, -1, -1, Integer(m_PoisonHitter), '')
        end
        else
          boNeedRefreshHMP := True;
      end;

      if m_nStatusPowerTime[POISON_DECHEALTH { 0 0x60 } ] > 0 then
      begin
        if m_boAnimal then
          Dec(m_nMeatQuality, 1000);

        if m_nStatusPowerType[POISON_DECHEALTH] = 0 then
          Int64Value := m_nStatusPower[POISON_DECHEALTH]
        else
          Int64Value := Round(m_nStatusPower[POISON_DECHEALTH] / 1000 * m_WAbil.MaxHP);

        nDamage := DamageHealth(Int64Value, nil);
        if not g_Config.boPoisoningHideHealthNum then
        begin
          if nDamage > 0 then
            SendRefMsg(RM_HEALTHSPELLCHANGED_STRUCK, nDamage, -1, -1, Integer(m_PoisonHitter), '')
        end
        else
          boNeedRefreshHMP := True; // 优化chongchong 2018-02-13

        m_nHealthTick := 0;
        m_nSpellTick := 0;
      end;
    end;
  except
    MainOutMessage(sExceptionMsg6);
  end;

  if boNeedRefreshHMP then
    HealthSpellChanged();

  g_nBaseObjTimeMin := MyGetTickCount() - dwRunTick;
  if g_nBaseObjTimeMax < g_nBaseObjTimeMin then
    g_nBaseObjTimeMax := g_nBaseObjTimeMin;

  if m_boGamePet //
    and (m_boEnabledPetAttack <> 1) //
    and (m_TargetCret <> nil) //
    and ((not g_Config.boEnabledPetAttack) or (m_boEnabledPetAttack = 2)) then
    DelTargetCreat;

  if (g_PluginManager <> nil) then
    g_PluginManager.HookBaseObjectRun(Self);
end;

