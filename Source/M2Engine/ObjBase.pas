var
  I, nX, nY: Integer;
  btDir: Byte;
begin
  Result := False;
  if (m_TargetCret = nil) or (m_PEnvir = nil) then
    Exit;
  nX := nCurrX;
  nY := nCurrY;
  if (Abs(nX - m_TargetCret.m_nCurrX) + Abs(nY - m_TargetCret.m_nCurrY) <= 0) then
    Exit;
  btDir := GetNextDirection(nX, nY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY);
  for I := 1 to 10 do
  begin
    if (nX = m_TargetCret.m_nCurrX) and (nY = m_TargetCret.m_nCurrY) then
    begin
      Result := True;
      Break;
    end;
    if GetNextDirection(nX, nY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY) <> btDir then
    begin
      Result := False;
      Break;
    end;
    if m_PEnvir.GetNextPosition(nX, nY, btDir, 1, nX, nY) then
    begin
      if (not m_PEnvir.CanWalk(nX, nY, True)) then
      begin
        Result := False;
        Break;
      end;
    end
    else
    begin
      Result := False;
      Break;
    end;
  end;
end;

