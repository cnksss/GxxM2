{ 形象效果兼容老端 2013-5-8 }
function TBaseObject.GetFeatureOld(BaseObject: TBaseObject): Integer;
var
  nDress, nWeapon, nHair: Integer;
  StdItem: pTStdItem;
  // bo25: Boolean;
  SmartObject: TSmartObject;
begin
  Result := 0;
  { if Assigned(zPlugOfEngine.GetFeature) then begin // 20080813 注释
    Result := zPlugOfEngine.GetFeature(Self, BaseObject);
    end else begin }
  try
    if m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER, RC_HEROOBJECT] then
    begin
      SmartObject := TSmartObject(Self);
      nDress := 0;
      with SmartObject do
      begin
        // 衣服
        if m_UseItems[U_DRESS].wIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(m_UseItems[U_DRESS].wIndex);
          if StdItem <> nil then
          begin
            nDress := StdItem.Shape * 2;
          end;
        end;
        Inc(nDress, m_btGender);
        nWeapon := 0;
        // 武器
        if SmartObject.m_UseItems[U_WEAPON].wIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(m_UseItems[U_WEAPON].wIndex);
          if StdItem <> nil then
          begin
            nWeapon := StdItem.Shape * 2;
          end;
        end;
        Inc(nWeapon, m_btGender);
        // 头盔
        if SmartObject.m_UseItems[U_HELMET].wIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_HELMET].wIndex);
          if StdItem <> nil then
          begin
            case StdItem.Shape of
              1:
                nHair := 4;
              2:
                nHair := 5;
            end;
          end;
        end;
        // 斗笠 20080417
        nHair := m_btHair * 2 + m_btGender;
        if m_UseItems[U_HAT].wIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(m_UseItems[U_HAT].wIndex);
          if StdItem <> nil then
          begin
            case StdItem.Shape of
              0:
                nHair := High(Byte); // 普通斗笠
              1:
                nHair := 254; // 金斗笠 20080807
              2:
                nHair := 254; // 金斗笠 20100117 本来IGE是Shape是1为金色斗笠 现在2
              3:
                nHair := 253; // 金牛斗笠  20100117  科技学院
              4:
                nHair := 252; // 必杀斗笠  20100117  科技学院
            end;
          end;
        end;
        case m_btRaceServer of
          RC_PLAYOBJECT, RC_PLAYMOSTER, RC_HEROOBJECT:
            Result := MakeHumanFeature(RC_PLAYOBJECT, nDress, nWeapon, nHair); // 英雄、人形怪全部按人物处理
          // RC_PLAYMOSTER: Result := MakeHumanFeature(RC_PLAYOBJECT {RC_PLAYMOSTER}, nDress, nWeapon, nHair); // 人形怪处理  --- piaoyun 2013-6-19
          // RC_HEROOBJECT: Result := MakeHumanFeature(RC_PLAYOBJECT, nDress, nWeapon, nHair);
        end;
      end;
      Exit;
    end;
    {
      bo25 := False;
      if bo25 then
      begin
      nRaceImg := m_btRaceImg;
      nAppr := m_wAppr;
      case nAppr of
      0:
      begin
      nRaceImg := 12;
      nAppr := 5;
      end;
      1:
      begin
      nRaceImg := 11;
      nAppr := 9;
      end;
      160:
      begin
      nRaceImg := 10;
      nAppr := 0;
      end;
      161:
      begin
      nRaceImg := 10;
      nAppr := 1;
      end;
      162:
      begin
      nRaceImg := 11;
      nAppr := 6;
      end;
      163:
      begin
      nRaceImg := 11;
      nAppr := 3;
      end;
      end; // case
      Result := MakeMonsterFeature(nRaceImg, m_btMonsterWeapon, nAppr);
      Exit;
      end;
    }
    Result := MakeMonsterFeature(m_btRaceImg, m_btMonsterWeapon, m_wAppr);
  except
    on E: Exception do
    begin
      MainOutMessage('TBaseObject.GetFeatureOld Error');
    end;
  end;
end;

function TBaseObject.GetFeature(BaseObject: TBaseObject; Feature: PAnsiChar): Integer;
var
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  // bo25: Boolean;
  HumFeature: pTHumFeature;
  MonFeature: pTMonFeature;
  ItemEffect: pTItemEffect;
  SmartObject: TSmartObject;
  DressIndex: Integer;
  WeaponIndex: Integer;
  UseFashionItem: Boolean;
  boShowHair: Boolean;
  btHorseWhere: Integer;
  DressEffType_30: Word;
  I: Integer;
  MonInfo: pTMonInfo;
begin
  if m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(Self);
    FillChar(Feature^, SizeOf(THumFeature), 0);
    HumFeature := pTHumFeature(Feature);
    HumFeature.nChangeAppr := m_nChangeAppr;
    HumFeature.nWeaponEffectIndex := -1;
    HumFeature.wWeaponEffectOffSet := 0;
    HumFeature.wDBWeaponEffectOffSet := 0;
    HumFeature.boWeaponEffectNoBlend := False;
    HumFeature.boWeaponEffectNoSex := False;
    HumFeature.nDressEffectIndex := -1;
    HumFeature.wDressEffectOffSet := 0;
    HumFeature.boDressEffectNoBlend := False;
    HumFeature.boDressEffectNoSex := False;
    HumFeature.nShieldEffectIndex := -1;
    HumFeature.wShieldEffectOffSet := 0;
    HumFeature.boShieldEffectNoBlend := False;
    HumFeature.boShieldEffectNoSex := False;
    HumFeature.nDressAddEffectIndex := -1; // 附加武器特效
    HumFeature.bDressAddEffectOrder := 0; // 附加武器特效绘制顺序
    HumFeature.wDressAddEffectOffSet := 0; // 附加武器特效偏移
    HumFeature.wDressAddEffectCount := 0; // 附加武器特效数量
    HumFeature.wDressAddEffectTime := 0; // 附加武器特效时间
    HumFeature.boDressAddEffectNoBlend := False; // 附加武器特 - 普通绘制
    HumFeature.nMedalEffectIndex := -1;
    HumFeature.wMedalEffectOffSet := 0;
    HumFeature.boMedalEffectNoBlend := False;
    HumFeature.boMedalEffectNoSex := False;
    // 判断是否为人形怪
    if (m_btRaceServer = RC_PLAYMOSTER) then
    begin
      HumFeature.wRace := 0;
      // 是分身
      if (m_Master <> nil) and (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
        HumFeature.boPlayMoster := False
      else
        HumFeature.boPlayMoster := True
    end
    else
    begin
      HumFeature.wRace := m_btRaceServer;
      HumFeature.boPlayMoster := False;
    end;
    if m_btRaceServer = RC_HEROOBJECT then
      HumFeature.boShowFashion := SmartObject.m_boShowFashion and (not g_Config.boHeroHideTabSheet2)
    else
      HumFeature.boShowFashion := SmartObject.m_boShowFashion and (not g_Config.boHideTabSheet2);
    // 当穿戴护身属性装备，血条调用新资源 chongchong 2014-04-07
    HumFeature.boMagicShield := SmartObject.m_boMagicShield;
    if m_btRaceServer = RC_PLAYOBJECT then
      HumFeature.btReLevel := TPlayObject(SmartObject).m_btReLevel
    else if m_btRaceServer = RC_HEROOBJECT then
      HumFeature.btReLevel := THeroObject(SmartObject).m_btReLevel
    else
      HumFeature.btReLevel := -1;
    if SmartObject.m_boOnHorse then
    begin
      btHorseWhere := -1;
      if SmartObject.m_UseItems[U_HORSE].wIndex > 0 then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_HORSE].wIndex);
        if StdItem <> nil then
          btHorseWhere := U_HORSE;
      end
      // 合击版界面马牌放在蜡烛位置 chongchong 2013-10-18
      else if SmartObject.m_UseItems[U_RIGHTHAND].wIndex > 0 then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_RIGHTHAND].wIndex);
        if (StdItem <> nil) and (StdItem.StdMode = 28) then
          btHorseWhere := U_RIGHTHAND;
      end;
      HumFeature.btHorseType := SmartObject.m_btHorseType;
      HumFeature.boShowHorseWingsEffect := False;
      HumFeature.btHorseHair := 0;
      HumFeature.btHorseHum := 0;
      HumFeature.btHorseHumExpand := 0;
      HumFeature.btHorseEffectType := 0;
      if (btHorseWhere > 0) and (SmartObject.m_UseItems[btHorseWhere].wIndex > 0) then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[btHorseWhere].wIndex);
        if StdItem <> nil then
        begin
          // 对于官方马来说，OverLap 字段来表示是否显示马特效
          if SmartObject.m_btHorseType in [1, 2] then
            HumFeature.boShowHorseWingsEffect := StdItem.Expand3 <> 0
          else
          begin
            // 对于三方马来说，Expand3 字段来表示发型素材 chongchong 2014-04-18
            HumFeature.btHorseHair := StdItem.Expand3;
            if HumFeature.btHorseHair > 14 then
              HumFeature.btHorseHair := 14;
            HumFeature.btHorseHumExpand := StdItem.Expand2;
            if StdItem.Expand2 = 0 then
            begin
              // 对于三方马来说，Source 字段来表示马上的人物外观素材 chongchong 2014-04-18
              HumFeature.btHorseHum := StdItem.Source;
            end
            else
            begin
              // 将三方马上的人物外观改成衣服上的Horse
              HumFeature.btHorseHum := SmartObject.m_nHorseHumEffType;
              // 如果没穿衣服，默认选没穿衣服的男、女
              if HumFeature.btHorseHum = 0 then
              begin
                if SmartObject.m_btGender <> 0 then
                  HumFeature.btHorseHum := 1;
              end;
            end;
            if HumFeature.btHorseHum > 349 then
              HumFeature.btHorseHum := 349;
          end;
          HumFeature.btHorseEffectType := StdItem.Expand4;
        end;
      end;
      // 天使翅膀支持 SetItemShape chongchong 2017-07-29
      DressEffType_30 := SmartObject.m_wDressEffType_30;
      if (SmartObject.m_UseItems[U_RIGHTHAND].MakeIndex > 0) and (SmartObject.m_UseItems[U_RIGHTHAND].wNewShape > 0) then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_RIGHTHAND].wIndex);
        if (StdItem <> nil) and (StdItem.StdMode = 29) then
        begin
          DressEffType_30 := SmartObject.m_UseItems[U_RIGHTHAND].wNewShape;
        end;
      end;
      if SmartObject.m_wDressEffType = 0 then
      begin
        if DressEffType_30 <> 0 then // if not HumFeature.boShowFashion then //修正勾选外选时装时，不显示勋章翅膀效果 2020-02-03 15:29:24
        begin
          HumFeature.wDressEffType := DressEffType_30;
          HumFeature.boDressEffNormalDraw := SmartObject.m_boDressEffType_30NormalDraw;
          HumFeature.boDressEffNoSex := SmartObject.m_boDressEffType_30NoSex;
        end;
        HumFeature.wDressEffType_30 := 0;
        HumFeature.boDressEff_30NormalDraw := False;
        HumFeature.boDressEff_30NoSex := False;
      end
      else
      begin
        HumFeature.wDressEffType := SmartObject.m_wDressEffType;
        HumFeature.boDressEffNormalDraw := False;
        HumFeature.boDressEffNoSex := False;
        if DressEffType_30 <> 0 then // if not HumFeature.boShowFashion then //修正勾选外选时装时，不显示勋章翅膀效果 2020-02-03 15:29:24
        begin
          HumFeature.wDressEffType_30 := DressEffType_30;
          HumFeature.boDressEff_30NormalDraw := SmartObject.m_boDressEffType_30NormalDraw;
          HumFeature.boDressEff_30NoSex := SmartObject.m_boDressEffType_30NoSex;
        end
        else
        begin
          HumFeature.wDressEffType_30 := 0;
          HumFeature.boDressEff_30NormalDraw := False;
          HumFeature.boDressEff_30NoSex := False;
        end;
      end;
      if SmartObject.m_boHorseMaster then
      begin
        if SmartObject.m_HorseOtherHum <> nil then
        begin
          if SmartObject.m_HorseOtherHum.m_boGhost or SmartObject.m_HorseOtherHum.m_boDeath then
            HumFeature.btDoubleHumHorseType := 0
          else
          begin
            case SmartObject.m_btGender of
              0:
                begin
                  if SmartObject.m_HorseOtherHum.m_btGender = 1 then // 男载女
                    HumFeature.btDoubleHumHorseType := 2
                  else
                    HumFeature.btDoubleHumHorseType := 3; // 男载男
                end;
              1:
                begin
                  if SmartObject.m_HorseOtherHum.m_btGender = 1 then // 女载女
                    HumFeature.btDoubleHumHorseType := 4
                  else
                    HumFeature.btDoubleHumHorseType := 5; // 女载男
                end;
            end;
          end;
        end
        else
          HumFeature.btDoubleHumHorseType := 1; // 1个人骑马
      end
      else
      begin
        if SmartObject.m_HorseOtherHum <> nil then
        begin
          if SmartObject.m_HorseOtherHum.m_boGhost or SmartObject.m_HorseOtherHum.m_boDeath then
          begin
            HumFeature.btHorseType := 0;
            HumFeature.btDoubleHumHorseType := 0;
          end
          else
          begin
            HumFeature.btHorseType := SmartObject.m_HorseOtherHum.m_btHorseType;
            HumFeature.btDoubleHumHorseType := 0; // 骑马但不在客户端显示
          end;
        end;
      end;
    end
    else
    begin
      HumFeature.btHorseType := 0;
      HumFeature.btDoubleHumHorseType := 0;
      HumFeature.boShowHorseWingsEffect := False;
      // 天使翅膀支持 SetItemShape chongchong 2017-07-29
      DressEffType_30 := SmartObject.m_wDressEffType_30;
      if (SmartObject.m_UseItems[U_RIGHTHAND].MakeIndex > 0) and (SmartObject.m_UseItems[U_RIGHTHAND].wNewShape > 0) then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_RIGHTHAND].wIndex);
        if (StdItem <> nil) and (StdItem.StdMode = 29) then
        begin
          DressEffType_30 := SmartObject.m_UseItems[U_RIGHTHAND].wNewShape;
        end;
      end;
      if SmartObject.m_wDressEffType = 0 then
      begin
        if DressEffType_30 <> 0 then // if not HumFeature.boShowFashion then //修正勾选外选时装时，不显示勋章翅膀效果 2020-02-03 15:29:24
        begin
          HumFeature.wDressEffType := DressEffType_30;
          HumFeature.boDressEffNormalDraw := SmartObject.m_boDressEffType_30NormalDraw;
          HumFeature.boDressEffNoSex := SmartObject.m_boDressEffType_30NoSex;
        end;
        HumFeature.wDressEffType_30 := 0;
        HumFeature.boDressEff_30NormalDraw := False;
        HumFeature.boDressEff_30NoSex := False;
      end
      else
      begin
        HumFeature.wDressEffType := SmartObject.m_wDressEffType;
        HumFeature.boDressEffNormalDraw := False;
        HumFeature.boDressEffNoSex := False;
        if DressEffType_30 <> 0 then // if not HumFeature.boShowFashion then //修正勾选外选时装时，不显示勋章翅膀效果 2020-02-03 15:29:24
        begin
          HumFeature.wDressEffType_30 := DressEffType_30;
          HumFeature.boDressEff_30NormalDraw := SmartObject.m_boDressEffType_30NormalDraw;
          HumFeature.boDressEff_30NoSex := SmartObject.m_boDressEffType_30NoSex;
        end
        else
        begin
          HumFeature.wDressEffType_30 := 0;
          HumFeature.boDressEff_30NormalDraw := False;
          HumFeature.boDressEff_30NoSex := False;
        end;
      end;
      HumFeature.btHorseEffectType := 0;
    end;
    HumFeature.btGender := m_btGender;
    HumFeature.btJob := m_btJob;
    HumFeature.sActiveFengHaoName := '';
    HumFeature.nActiveFengHaoID := 0;
    HumFeature.dwActiveFengHaoLooks := 0;
    HumFeature.btActiveFengHaoReserved := 0;
    HumFeature.btActiveFengHaoColor := 0;
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      HumFeature.boShopStall := TPlayObject(Self).m_boShopStall;
      // 摆
      if HumFeature.boShopStall then
      begin
        if TPlayObject(Self).m_btDirection in [0, 2, 4, 6] then
        begin
          TPlayObject(Self).TurnTo(TPlayObject(Self).m_btDirection + 1);
        end;
        HumFeature.btShopStallDir := TPlayObject(Self).m_btDirection;
      end;
    end;
    if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    begin
      // 发送封号到客户端 chongchong 2014-05-25
      if (m_PEnvir.m_nSecretFlag and SecretFlag_HideFengHao = 0) and (m_PEnvir.m_nSecretFlag2 and SecretFlag_HideFengHao = 0) and
        (TSmartObject(Self).m_ActiveFengHao >= 0) and
        (TSmartObject(Self).m_ActiveFengHao < TSmartObject(Self).m_FengHaoItems.Count) then
      begin
        UserItem := TSmartObject(Self).m_FengHaoItems.Items[TSmartObject(Self).m_ActiveFengHao];
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if StdItem <> nil then
        begin
          HumFeature.sActiveFengHaoName := ProcessItemName(StdItem.Name);
          HumFeature.nActiveFengHaoID := UserItem.MakeIndex;
          HumFeature.dwActiveFengHaoLooks := StdItem.Looks;
          HumFeature.btActiveFengHaoReserved := StdItem.Reserved;
          // if StdItem.Color = 251 then
          // HumFeature.btActiveFengHaoColor := g_Config.btThrowAwayItemColor
          // else
          HumFeature.btActiveFengHaoColor := StdItem.Color;
        end;
      end;
    end;
    HumFeature.btCaseltGuild := 0;
    // -------------------------------------------------------------
    // 自定义勋章特效
    if (SmartObject.m_UseItems[U_RIGHTHAND].wIndex > 0) then
    begin
      StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_RIGHTHAND].wIndex);
      if (StdItem <> nil) and (StdItem.StdMode in [29 { 天使翅膀 } , 30]) then
      begin
        ItemEffect := pTItemEffect(StdItem.Effect);
        if ItemEffect <> nil then
        begin
          HumFeature.nMedalEffectIndex := ItemEffect.FileIndex2;
          HumFeature.wMedalEffectOffSet := ItemEffect.StartIndex2;
          HumFeature.boMedalEffectNoBlend := ItemEffect.NoBlendMode2;
          HumFeature.boMedalEffectNoSex := ItemEffect.NoSex2;
        end;
        if SmartObject.m_UseItems[U_RIGHTHAND].wEffect > 0 then
        begin
          ItemEffect := g_ItemEffects.Get(SmartObject.m_UseItems[U_RIGHTHAND].wEffect);
          if ItemEffect <> nil then
          begin
            HumFeature.nMedalEffectIndex := ItemEffect.FileIndex2;
            HumFeature.wMedalEffectOffSet := ItemEffect.StartIndex2;
            HumFeature.boMedalEffectNoBlend := ItemEffect.NoBlendMode2;
            HumFeature.boMedalEffectNoSex := ItemEffect.NoSex2;
          end;
        end;
      end;
    end;
    // -------------------------------------------------------------------------
    UseFashionItem := (SmartObject.m_UseItems[U_FASHIONDRESS].wIndex > 0) or (SmartObject.m_UseItems[U_FASHIONWEAPON].wIndex > 0);
    // 衣服
    if g_Config.boShowNormalFashion and UseFashionItem then
    begin
      if HumFeature.boShowFashion then
        DressIndex := U_FASHIONDRESS
      else
        DressIndex := U_DRESS;
    end
    else
    begin
      if HumFeature.boShowFashion and (SmartObject.m_UseItems[U_FASHIONDRESS].wIndex > 0) then
        DressIndex := U_FASHIONDRESS
      else
        DressIndex := U_DRESS;
    end;
    boShowHair := True;
    if (DressIndex >= 0) and (SmartObject.m_UseItems[DressIndex].wIndex > 0) then
    begin
      StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[DressIndex].wIndex);
      if StdItem <> nil then
      begin
        // 个位用来表示是否显示发型，Expand5 div 10用来表示使提示框文字使用哪个图片作为背景 2019-12-15 10:05:20
        boShowHair := StdItem.Expand5 mod 10 = 0;
        if SmartObject.m_UseItems[DressIndex].wNewShape > 0 then
          HumFeature.wDress := SmartObject.m_UseItems[DressIndex].wNewShape * 2
        else
          HumFeature.wDress := StdItem.Shape * 2;
        if (StdItem.Expand3 >= 1) and (StdItem.Expand3 <= 300) then
          HumFeature.btCboDressUseDiyImage := StdItem.Expand3
        else
          HumFeature.btCboDressUseDiyImage := 0;
        ItemEffect := pTItemEffect(StdItem.Effect);
        if ItemEffect <> nil then
        begin
          HumFeature.nDressEffectIndex := ItemEffect.FileIndex2;
          HumFeature.wDressEffectOffSet := ItemEffect.StartIndex2;
          HumFeature.boDressEffectNoBlend := ItemEffect.NoBlendMode2;
          HumFeature.boDressEffectNoSex := ItemEffect.NoSex2;
          HumFeature.nDressAddEffectIndex := ItemEffect.FileIndex4;
          HumFeature.bDressAddEffectOrder := ItemEffect.AddEffectDrawOrder;
          HumFeature.wDressAddEffectOffSet := ItemEffect.StartIndex4;
          HumFeature.wDressAddEffectCount := ItemEffect.ImageCount4;
          HumFeature.wDressAddEffectTime := ItemEffect.Time4;
          HumFeature.boDressAddEffectNoBlend := ItemEffect.AddEffectNoBlendMode;
          HumFeature.boDressAddEffectDrawCenter := ItemEffect.AddEffectDrawCenter;
        end;
        if SmartObject.m_UseItems[DressIndex].wEffect > 0 then
        begin
          ItemEffect := g_ItemEffects.Get(SmartObject.m_UseItems[DressIndex].wEffect);
          if ItemEffect <> nil then
          begin
            HumFeature.nDressEffectIndex := ItemEffect.FileIndex2;
            HumFeature.wDressEffectOffSet := ItemEffect.StartIndex2;
            HumFeature.boDressEffectNoBlend := ItemEffect.NoBlendMode2;
            HumFeature.boDressEffectNoSex := ItemEffect.NoSex2;
            // HumFeature.boDressEffect := ItemEffect.DressEffect;
            HumFeature.nDressAddEffectIndex := ItemEffect.FileIndex4;
            HumFeature.bDressAddEffectOrder := ItemEffect.AddEffectDrawOrder;
            HumFeature.wDressAddEffectOffSet := ItemEffect.StartIndex4;
            HumFeature.wDressAddEffectCount := ItemEffect.ImageCount4;
            HumFeature.wDressAddEffectTime := ItemEffect.Time4;
            HumFeature.boDressAddEffectNoBlend := ItemEffect.AddEffectNoBlendMode;
            HumFeature.boDressAddEffectDrawCenter := ItemEffect.AddEffectDrawCenter;
          end;
        end;
      end;
    end;
    HumFeature.wDress := HumFeature.wDress + m_btGender;
    // 武器
    if g_Config.boShowNormalFashion and UseFashionItem then
    begin
      if HumFeature.boShowFashion then
        WeaponIndex := U_FASHIONWEAPON
      else
        WeaponIndex := U_WEAPON;
    end
    else
    begin
      if HumFeature.boShowFashion and (SmartObject.m_UseItems[U_FASHIONWEAPON].wIndex > 0) then
        WeaponIndex := U_FASHIONWEAPON
      else
        WeaponIndex := U_WEAPON;
    end;
    if (WeaponIndex >= 0) and (SmartObject.m_UseItems[WeaponIndex].wIndex > 0) then
    begin
      StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[WeaponIndex].wIndex);
      if StdItem <> nil then
      begin
        if SmartObject.m_UseItems[WeaponIndex].wNewShape > 0 then
        begin
          HumFeature.wWeapon := SmartObject.m_UseItems[WeaponIndex].wNewShape * 2;
        end
        else
        begin
          HumFeature.wWeapon := StdItem.Shape * 2;
        end;
        HumFeature.wWeaponSound := StdItem.Horse;
        if StdItem.Expand3 in [1 .. 15] then
          HumFeature.btCboWeaponUseDiyImage := StdItem.Expand3
        else
          HumFeature.btCboWeaponUseDiyImage := 0;
        ItemEffect := pTItemEffect(StdItem.Effect);
        if ItemEffect <> nil then
        begin
          HumFeature.nWeaponEffectIndex := ItemEffect.FileIndex2;
          HumFeature.wWeaponEffectOffSet := ItemEffect.StartIndex2;
          HumFeature.boWeaponEffectNoBlend := ItemEffect.NoBlendMode2;
          HumFeature.boWeaponEffectNoSex := ItemEffect.NoSex2;
        end;
        if SmartObject.m_UseItems[WeaponIndex].wEffect > 0 then
        begin
          ItemEffect := g_ItemEffects.Get(SmartObject.m_UseItems[WeaponIndex].wEffect);
          if ItemEffect <> nil then
          begin
            HumFeature.nWeaponEffectIndex := ItemEffect.FileIndex2;
            HumFeature.wWeaponEffectOffSet := ItemEffect.StartIndex2;
            HumFeature.boWeaponEffectNoBlend := ItemEffect.NoBlendMode2;
            HumFeature.boWeaponEffectNoSex := ItemEffect.NoSex2;
          end;
        end;
        // 把DB库中武器 AniCount 字段 发送过去 piaoyun 2013-07-28
        if (StdItem.Anicount >= 1000) and (StdItem.Anicount <= { 1015 } 2000) then
        begin
          HumFeature.wDBWeaponEffectOffSet := StdItem.Anicount;
        end;
      end;
    end;
    HumFeature.wWeapon := HumFeature.wWeapon + m_btGender;
    // 盾牌 chongchong 2013-09-16
    if not(HumFeature.boShowFashion and g_Config.boShowFashionHideShield and UseFashionItem) then
    begin
      if SmartObject.m_UseItems[U_SHIELD].wIndex > 0 then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_SHIELD].wIndex);
        if StdItem <> nil then
        begin
          if SmartObject.m_UseItems[U_SHIELD].wNewShape > 0 then
            HumFeature.wShield := SmartObject.m_UseItems[U_SHIELD].wNewShape
          else
            HumFeature.wShield := StdItem.Shape;
          ItemEffect := pTItemEffect(StdItem.Effect);
          if ItemEffect <> nil then
          begin
            HumFeature.nShieldEffectIndex := ItemEffect.FileIndex2;
            HumFeature.wShieldEffectOffSet := ItemEffect.StartIndex2;
            HumFeature.boShieldEffectNoBlend := ItemEffect.NoBlendMode2;
            HumFeature.boShieldEffectNoSex := ItemEffect.NoSex2;
          end;
          if SmartObject.m_UseItems[U_SHIELD].wEffect > 0 then
          begin
            ItemEffect := g_ItemEffects.Get(SmartObject.m_UseItems[U_SHIELD].wEffect);
            if ItemEffect <> nil then
            begin
              HumFeature.nShieldEffectIndex := ItemEffect.FileIndex2;
              HumFeature.wShieldEffectOffSet := ItemEffect.StartIndex2;
              HumFeature.boShieldEffectNoBlend := ItemEffect.NoBlendMode2;
              HumFeature.boShieldEffectNoSex := ItemEffect.NoSex2;
            end;
          end;
        end;
      end;
    end;
    if (m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualFeature <> 0) or
      (m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualFeature <> 0) then
    begin
      boShowHair := True;
      if (m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualFeature <> 0) then
      begin
        HumFeature.wDress := m_PEnvir.m_wSecretDressShap2 * 2 + m_btGender;
        HumFeature.wWeapon := m_PEnvir.m_wSecretWeaponShap2 * 2 + m_btGender;
      end
      else
      begin
        HumFeature.wDress := m_PEnvir.m_wSecretDressShap * 2 + m_btGender;
        HumFeature.wWeapon := m_PEnvir.m_wSecretWeaponShap * 2 + m_btGender;
      end;
      HumFeature.wDressEffType := 0;
      HumFeature.wDressEffType_30 := 0;
      HumFeature.nWeaponEffectIndex := -1;
      HumFeature.wWeaponEffectOffSet := 0;
      HumFeature.wDBWeaponEffectOffSet := 0;
      HumFeature.boWeaponEffectNoBlend := False;
      HumFeature.boWeaponEffectNoSex := False;
      HumFeature.nDressEffectIndex := -1;
      HumFeature.wDressEffectOffSet := 0;
      HumFeature.boDressEffectNoBlend := False;
      HumFeature.boDressEffectNoSex := False;
      HumFeature.nDressAddEffectIndex := -1; // 附加武器特效
      HumFeature.bDressAddEffectOrder := 0; // 附加武器特效绘制顺序
      HumFeature.wDressAddEffectOffSet := 0; // 附加武器特效偏移
      HumFeature.wDressAddEffectCount := 0; // 附加武器特效数量
      HumFeature.wDressAddEffectTime := 0; // 附加武器特效时间
      HumFeature.boDressAddEffectNoBlend := False; // 附加武器特 - 普通绘制
      HumFeature.wShield := 0;
      HumFeature.nShieldEffectIndex := -1;
      HumFeature.wShieldEffectOffSet := 0;
      HumFeature.boShieldEffectNoBlend := False;
      HumFeature.boShieldEffectNoSex := False;
      HumFeature.nMedalEffectIndex := -1;
      HumFeature.wMedalEffectOffSet := 0;
      HumFeature.boMedalEffectNoBlend := False;
      HumFeature.boMedalEffectNoSex := False;
    end;
    // 头盔
    if (m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualFeature = 0) and
      (m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualFeature = 0) then
    begin
      if SmartObject.m_UseItems[U_HELMET].wIndex > 0 then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_HELMET].wIndex);
        if StdItem <> nil then
        begin
          case StdItem.Shape of
            1:
              HumFeature.btHair := 4;
            2:
              HumFeature.btHair := 5;
          end;
        end;
      end;
      // 斗笠
      if not(HumFeature.boShowFashion and g_Config.boShowFashionHideHats and UseFashionItem) then
      begin
        if SmartObject.m_UseItems[U_HAT].wIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_HAT].wIndex);
          if StdItem <> nil then
          begin
            // 修正戴面巾时光头 chongchong 2013-11-09
            if (StdItem.Shape <> 1000) then // 等于-1则不显示，按照原始发型发过去 1000为面巾，也发原始发型 2013-07-31
              HumFeature.btHair := 100 + StdItem.Shape;
          end;
        end;
      end;
    end;
    if (m_MyGuild <> nil) and (g_CastleManager.FindCastle(TGUild(m_MyGuild)) <> nil) then
    begin
      if TPlayObject(Self).IsGuildMaster then
      begin
        HumFeature.btCaseltGuild := 2; // 沙行会掌门
      end
      else
      begin
        HumFeature.btCaseltGuild := 1; // 沙行会成员
      end;
    end;
    if HumFeature.btHair = 0 then
      HumFeature.btHair := m_btHair; // 根据注册参数客可知默认 2：男 3：女
    // 发型修改为老端一样的处理
    // if HumFeature.btHair = 0 then HumFeature.btHair := m_btHair * 2 + m_btGender;//HumFeature.btHair := m_btHair;
    { TODO -opiaoyun -c修正 : 修正发型-老版本创建人物后导致的发型错乱修复【2013-6-9】 }
    { TODO -opiaoyun -c修正 : 斗笠显示问题【2013-07-31】 }
    if HumFeature.btHair < 6 then
    begin
      case HumFeature.btGender of
        0:
          begin
            case m_btHair of
              1 .. 6:
                HumFeature.btHair := 2;
            end;
          end;
        1:
          begin
            case m_btHair of
              0:
                HumFeature.btHair := 1;
              1 .. 6:
                HumFeature.btHair := 3;
            end;
          end;
      end;
    end;
    HumFeature.btOldHair := m_btHair;
    if HumFeature.btOldHair < 6 then
    begin
      case HumFeature.btGender of
        0:
          begin
            case m_btHair of
              1 .. 6:
                HumFeature.btOldHair := 2;
            end;
          end;
        1:
          begin
            case m_btHair of
              0:
                HumFeature.btOldHair := 1;
              1 .. 6:
                HumFeature.btOldHair := 3;
            end;
          end;
      end;
    end;
    HumFeature.boShowHair := boShowHair;
    {
      if SmartObject.m_boFixedColor then
      HumFeature.btColor := SmartObject.m_btFixedColor
      else
    }
    HumFeature.btBodyColor := m_btBodyColor; // 人体颜色
    Result := SizeOf(THumFeature);
    Exit;
  end;
  FillChar(Feature^, SizeOf(TMonFeature), 0);
  MonFeature := pTMonFeature(Feature);
  MonFeature.wAppr := m_wAppr;
  MonFeature.wRaceImg := m_btRaceImg;
  MonFeature.wWeapon := m_btMonsterWeapon;
  MonFeature.btBodyColor := m_btBodyColor; // 人体颜色
  MonFeature.btRace := m_btRaceServer; // modify chongchong 2013-07-19
  MonFeature.HumBBType := bbNo;
  MonFeature.IsExploreItem := m_wExploreItem = 1;
  MonFeature.IsDisableSimpleActor := m_boDisableSimpleActor;
  if Master <> nil then
  begin
    if m_boGamePet then
      MonFeature.HumBBType := bbGamePet
    else if Master.m_btRaceServer = RC_PLAYOBJECT then
      MonFeature.HumBBType := bbSlave;
  end;
  if (g_Config.btMonsterShowLevel = 2) or (m_btRaceServer in [RC_BOX, RC_BOX2]) then // 采集类怪物始终发送等级 By 一支笔 at:2021-07-05 18:31:57
  begin
    MonFeature.MonLevel := m_Abil.Level;
  end;
  // 自定义怪物变脸要用 2021-04-18
  if (m_nChangeAppr >= 0) then
  begin
    // if m_nChangeAppr >= 100000 then
    // MonFeature.wAppr := m_nChangeAppr - 100000
    // else
    MonFeature.wAppr := m_nChangeAppr;
    MonFeature.nChangeAppr := m_nChangeAppr;
    for I := 0 to UserEngine.MonsterList.Count - 1 do
    begin
      MonInfo := pTMonInfo(UserEngine.MonsterList.Items[I]);
      if MonInfo.wAppr = m_nChangeAppr then
      begin
        MonFeature.wRaceImg := MonInfo.btRaceImg;
        Break;
      end;
    end;
  end
  else
    MonFeature.nChangeAppr := -1;
  Result := SizeOf(TMonFeature);
end;

function TBaseObject.GetCharStatus(): Integer;
var
  I: Integer;
  nStatus: Integer;
  nRet: Integer;
  boTrue: Boolean;
begin
  nStatus := 0;

  for I := Low(m_wStatusTimeArr) to High(m_wStatusTimeArr) do
  begin
    boTrue := (I = STATE_TRANSPARENT) //
      and (m_btRaceServer in [RC_HEROOBJECT, RC_PLAYOBJECT]) //
      and (TSmartObject(Self).m_boHideModeEx);

    if boTrue or ((m_wStatusTimeArr[I] > 0) or (m_nStatusPowerTime[I] > 0)) then
      nStatus := ($80000000 shr I) or nStatus;
  end;

  // 魔法盾 4级
  if g_Config.boSkill31UseLEGEffect //
    and (nStatus and $100000 <> 0) //
    and ((m_btMagBubbleDefenceNewLevel > 0) or (m_btMagBubbleDefenceLevel > 3)) then
    nStatus := ($80000000 shr STATE_16) or nStatus;

  nRet := (m_nCharStatusEx and $FFFFF) or nStatus;
  Result := nRet;
end;

