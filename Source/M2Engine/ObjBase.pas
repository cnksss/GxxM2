procedure TSmartObject.UseLamp; // 004C759C
var
  nOldDura: Integer;
  nDura, nOldLight: Integer;
  PlayObject: TPlayObject;
  StdItem: pTStdItem;
  bo19: Boolean;
resourcestring
  sExceptionMsg = '[Exception] TSmartObject.UseLamp';
begin
  try
    bo19 := False;
    if m_UseItems[U_RIGHTHAND].wIndex > 0 then
    begin
      StdItem := UserEngine.GetStdItem(m_UseItems[U_RIGHTHAND].wIndex);
      if (StdItem = nil) or (StdItem.Source <> 0) then
        Exit;
      if m_UseItems[U_RIGHTHAND].Dura <= 0 then
      begin
        if g_Config.boDeleteItemDuraZero then
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[U_RIGHTHAND].MakeIndex, '0', 0,
              0, '持久为0');
          end;
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            PlayObject := TPlayObject(Self);
            PlayObject.SendDelItem(@m_UseItems[U_RIGHTHAND]);
          end
          else if m_btRaceServer = RC_HEROOBJECT then
          begin
            THeroObject(Self).SendDelItem(@m_UseItems[U_RIGHTHAND]);
          end;
          m_UseItems[U_RIGHTHAND].wIndex := 0;
          { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
          if m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(Self).ProcessUseItemSkill(U_RIGHTHAND, StdItem, False);
          RecalcAbilitys();
          Exit;
        end
        else
        begin
          if not boRightHandItemDura_Zero then
          begin
            RecalcAbilitys();
            boRightHandItemDura_Zero := True;
          end;
          Exit;
        end;
      end
      else
        boRightHandItemDura_Zero := False;
      nOldDura := Round(m_UseItems[U_RIGHTHAND].Dura / 1000);
      if g_Config.boDecLampDura then
      begin
        nDura := m_UseItems[U_RIGHTHAND].Dura - 1;
      end
      else
      begin
        nDura := m_UseItems[U_RIGHTHAND].Dura;
      end;
      if nDura <= 0 then
      begin
        if g_Config.boDeleteItemDuraZero then
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[U_RIGHTHAND].MakeIndex, '0', 0,
              0, '持久为0');
          end;
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            PlayObject := TPlayObject(Self);
            PlayObject.SendDelItem(@m_UseItems[U_RIGHTHAND]);
          end
          else if m_btRaceServer = RC_HEROOBJECT then
          begin
            THeroObject(Self).SendDelItem(@m_UseItems[U_RIGHTHAND]);
          end;
          m_UseItems[U_RIGHTHAND].wIndex := 0;
          { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
          if m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(Self).ProcessUseItemSkill(U_RIGHTHAND, StdItem, False);
        end;
        m_UseItems[U_RIGHTHAND].Dura := 0;
        m_nLight := 0;
        SendRefMsg(RM_CHANGELIGHT, 0, 0, 0, 0, '');
        // SendMsg(Self, RM_LAMPCHANGEDURA, 0, m_UseItems[U_RIGHTHAND].Dura, 0, 0, '');
        RecalcAbilitys();
        bo19 := True;
        if m_btRaceServer = RC_PLAYOBJECT then
        begin
          if g_FunctionNPC <> nil then
          begin
            TPlayObject(Self).m_nScriptGotoCount := 0;
            g_FunctionNPC.GotoLable(TPlayObject(Self), '@ItemDamage' + IntToStr(U_RIGHTHAND), False);
          end;
        end;
        // FeatureChanged(); 01/21 取消 蜡烛是本人才可以看到的，不需要发送广播信息
      end
      else
        m_UseItems[U_RIGHTHAND].Dura := nDura;
      if nOldDura <> Round(nDura / 1000) then
      begin
        SendMsg(Self, RM_LAMPCHANGEDURA, 0, m_UseItems[U_RIGHTHAND].Dura, 0, 0, '');
      end;
      if (not bo19) and g_Config.boViewFog and (nDura <> m_UseItems[U_RIGHTHAND].Dura) then
      begin
        nOldLight := m_nLight;
        if g_Config.boDuraChangeLight then
          m_nLight := Min(Max(Round(m_UseItems[U_RIGHTHAND].Dura / 10000), 1), 5)
        else
          m_nLight := Min(Max(Round(m_UseItems[U_RIGHTHAND].DuraMax / 10000), 1), 5);
        if nOldLight <> m_nLight then
          SendRefMsg(RM_CHANGELIGHT, 0, 0, 0, 0, '');
      end;
    end;
  except
    MainOutMessage(sExceptionMsg);
  end;
end;

