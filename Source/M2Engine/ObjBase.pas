function TBaseObject.GetStruckMessage(Msg: pTProcessMessage): Boolean;
// Die函数前调用 否则可能造成  m_ExpHitter = nil 秒杀的情况最容易出现 m_ExpHitter = nil)
var
  I: Integer;
  SendMessage: pTSendMessage;
begin
  Result := False;
{$IF LockProcessMsg = 1}
  try
    EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
    I := 0;
    Msg.wIdent := 0;
    while m_MsgList.Count > I do
    begin
      SendMessage := m_MsgList.Items[I];
      if (SendMessage.wIdent <> RM_STRUCK) then
      begin
        Inc(I);
        Continue;
      end;
      m_MsgList.Delete(I);
      Msg.wIdent := SendMessage.wIdent;
      Msg.wParam := SendMessage.wParam;
      Msg.nParam1 := SendMessage.nParam1;
      Msg.nParam2 := SendMessage.nParam2;
      Msg.nParam3 := SendMessage.nParam3;
      Msg.BaseObject := NativeInt(SendMessage.BaseObject);
      Msg.dwTimeTick := SendMessage.dwTimeTick;
      Msg.dwDeliveryTime := SendMessage.dwDeliveryTime;
      Msg.boLateDelivery := SendMessage.boLateDelivery;
      if (SendMessage.Buff <> nil) and (SendMessage.BuffLen > 0) then
      begin
        // Msg.sMsg := StrPas(SendMessage.Buff);
        SetLength(Msg.sMsg, SendMessage.BuffLen);
        Move(SendMessage.Buff^, Msg.sMsg[1], SendMessage.BuffLen);
        FreeMem(SendMessage.Buff, SendMessage.BuffLen);
      end
      else
      begin
        Msg.sMsg := '';
      end;
      // Dispose(SendMessage);
      FreeMem(SendMessage, SizeOf(TSendMessage));
      Result := True;
      Break;
    end;
{$IF LockProcessMsg = 1}
  finally
    LeaveCriticalSection(ProcessMsgCriticalSection);
  end;
{$IFEND}
end;

function TBaseObject.GetMessage(Msg: pTProcessMessage): Boolean;
var
  I: Integer;
  SendMessage: pTSendMessage;
  nError: Integer;
begin
  Result := False;
  nError := 0;
{$IF LockProcessMsg = 1}
  try
    EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
    try
      I := 0;
      Msg.wIdent := 0;
      while m_MsgList.Count > I do
      begin
        nError := 1;
        if I >= m_MsgList.Count then
          Break;

        SendMessage := m_MsgList.Items[I];
        if SendMessage = nil then
        begin
          m_MsgList.Delete(I);
          // Inc(I);
          Continue;
        end;

        nError := 2;
        if (((SendMessage.wIdent = RM_10101) and (m_WAbil.HP > 0)) or (SendMessage.wIdent <> RM_10101)) and
        // (RM_10101消息 m_WAbil.HP > 0 不检测延时 否则可能造成  m_ExpHitter = nil 秒杀的情况最容易出现 m_ExpHitter = nil)
          (SendMessage.boLateDelivery) and (MyGetTickCount < SendMessage.dwDeliveryTime) then
        begin
          Inc(I);
          Continue;
        end;

        nError := 3;
        m_MsgList.Delete(I);
        nError := 4;

        Msg.wIdent := SendMessage.wIdent;
        Msg.wParam := SendMessage.wParam;
        Msg.nParam1 := SendMessage.nParam1;
        Msg.nParam2 := SendMessage.nParam2;
        Msg.nParam3 := SendMessage.nParam3;
        Msg.BaseObject := NativeInt(SendMessage.BaseObject);
        Msg.dwTimeTick := SendMessage.dwTimeTick;
        Msg.dwDeliveryTime := SendMessage.dwDeliveryTime;
        Msg.boLateDelivery := SendMessage.boLateDelivery;

        nError := 5;
        if (SendMessage.Buff <> nil) and (SendMessage.BuffLen > 0) then
        begin
          nError := 50;
          SetLength(Msg.sMsg, SendMessage.BuffLen);
          Move(SendMessage.Buff^, Msg.sMsg[1], SendMessage.BuffLen);
          nError := 51;
          FreeMem(SendMessage.Buff, SendMessage.BuffLen);
          nError := 52;
          SendMessage.Buff := nil;
          nError := 6;
        end
        else
        begin
          nError := 70;
          Msg.sMsg := '';
          nError := 7;
        end;

        FreeMem(SendMessage, SizeOf(TSendMessage));
        nError := 8;
        Result := True;
        Break;
      end;
    except
      MainOutMessage('TBaseObject.GetMessage--->nError:=' + IntToStr(nError));
    end;
{$IF LockProcessMsg = 1}
  finally
    LeaveCriticalSection(ProcessMsgCriticalSection);
  end;
{$IFEND}
end;

// 获取地图上可视指定范围的对象 -- piaoyun 2013-06-27
function TBaseObject.GetMapBaseObjects(tEnvir: TEnvirnoment; nX, nY, nRage: Integer; rList: TList): Boolean; // 004B8D2C
var
  III: Integer;
  X, Y: Integer;
  nStartX, nStartY, nEndX, nEndY: Integer;
  MapCellInfo: pTMapCellinfo;
  GameObject: TGameObject;
  BaseObject: TBaseObject;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.GetMapBaseObjects';
begin
  Result := False;
  if rList = nil then
    Exit;
  try
    nStartX := nX - nRage;
    nEndX := nX + nRage;
    nStartY := nY - nRage;
    nEndY := nY + nRage;
    for X := nStartX to nEndX do
    begin
      for Y := nStartY to nEndY do
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          tEnvir.LockR(8);
        try
{$IFEND}
          if tEnvir.GetMapCellInfo(X, Y, MapCellInfo) and (MapCellInfo.ObjList <> nil) then
          begin
            for III := 0 to {$IF USEOBJLIST = 1}Length(MapCellInfo.ObjList){$ELSE}MapCellInfo.ObjList.Count{$IFEND} - 1 do
            begin
              GameObject :=
{$IF USEOBJLIST = 1}TGameObject(MapCellInfo.ObjList[III]){$ELSE}TGameObject(MapCellInfo.ObjList.Items[III]){$IFEND};
              if (GameObject <> nil) and (GameObject.m_ObjGame = obj_Actor) then
              begin
                BaseObject := TBaseObject(GameObject);
                if (not BaseObject.m_boDeath) and (not BaseObject.m_boGhost) then
                begin
                  rList.Add(BaseObject);
                end;
              end;
            end;
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            tEnvir.UnLockR;
        end;
{$IFEND}
      end;
    end;
  except
    MainOutMessage(sExceptionMsg);
  end;
  Result := True;
end;

