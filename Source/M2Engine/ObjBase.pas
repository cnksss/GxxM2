                end;
              end;
            end;
          end;
        end;
{$IF MULTI_THREAD = 1}
      finally
        if g_MultiThreadRun then
          m_PEnvir.UnLockR;
      end;
{$IFEND}
    end;
  end;
end;

function TBaseObject.AbilityUp(UserMagic: pTUserMagic; btState: Byte): Boolean;
var
  s: string;
  nSpellPoint, n14: Integer;
  Level9Power, Rate: Double;
  dwMaxSC: LongWord;
  nPower: Int64;
begin
  Result := False;
  if btState in [0 .. 5] then
  begin
    nSpellPoint := GetSpellPoint(UserMagic);
    if nSpellPoint > 0 then
    begin
      if m_WAbil.MP < nSpellPoint then
        Exit;
      case btState of
        0:
          begin
            n14 := Random(10 + UserMagic.btLevel) + UserMagic.btLevel;
            m_dwStatusArrTimeOutTick[btState] := MyGetTickCount + n14 * 1000;
            m_wStatusArrValue[btState] := Max(m_WAbil.DC2 div 5, 1);
            if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (Length(g_sDCUPPoint) > 0) then
            begin
              s := StringReplace(g_sDCUPPoint, '%p', IntToStr(m_wStatusArrValue[btState { 2 } ]), []);
              s := StringReplace(s, '%t', IntToStr(n14), []);
              SysMsg(s, c_Green, t_Hint);
            end;
          end;
        1:
          begin
            n14 := Random(10 + UserMagic.btLevel) + UserMagic.btLevel;
            m_dwStatusArrTimeOutTick[btState] := MyGetTickCount + n14 * 1000;
            m_wStatusArrValue[btState] := Max(m_WAbil.MC2 div 5, 1);
            if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (Length(g_sMCUPPoint) > 0) then
            begin
              s := StringReplace(g_sMCUPPoint, '%p', IntToStr(m_wStatusArrValue[btState { 2 } ]), []);
              s := StringReplace(s, '%t', IntToStr(n14), []);
              SysMsg(s, c_Green, t_Hint);
            end;
          end;
        2:
          begin
            { TODO -opiaoyun -c增加 : 道士技能无极真气按照时间控制-最终算法修改 【2013-08-25】 }
            if not g_Config.boElectrodelessTimeSet then
            begin
              // n14 := Random(g_Config.nElectrodelessBase + UserMagic.btLevel) + UserMagic.btLevel;
              n14 := (g_Config.nElectrodelessBase div 2) + (UserMagic.btLevel + 1) + Random((UserMagic.btLevel + 1) * 2);
              if UserMagic.btNewLevel > 0 then
              begin
                if UserMagic.btNewLevel <= 9 then
                  n14 := Min(n14, g_Config.NewLevelMagicElectrodelessTime[UserMagic.btNewLevel - 1])
                else
                begin
                  Level9Power := Min(n14, g_Config.NewLevelMagicElectrodelessTime[9 - 1]);
                  Rate := 1 + (UserMagic.btNewLevel - 9) * (g_Config.NewLevelMagicPowerRatesAfter9 / 100);
                  n14 := Round(Min(Level9Power * Rate, High(Integer)));
                end;
              end
              else
              begin
                n14 := Min(n14, g_Config.dwElectrodelessTimes[Min(UserMagic.btLevel, 4)]);
              end;
            end
            else
            begin
              if UserMagic.btNewLevel > 0 then
              begin
                if UserMagic.btNewLevel <= 9 then
                  n14 := g_Config.NewLevelMagicElectrodelessTime[UserMagic.btNewLevel - 1]
                else
                begin
                  Level9Power := g_Config.NewLevelMagicElectrodelessTime[9 - 1];
                  Rate := 1 + (UserMagic.btNewLevel - 9) * (g_Config.NewLevelMagicPowerRatesAfter9 / 100);
                  n14 := Round(Min(Level9Power * Rate, High(Integer)));
                end;
              end
              else
              begin
                n14 := g_Config.dwElectrodelessTimes[Min(UserMagic.btLevel, 4)];
              end;
            end;
            m_dwStatusArrTimeOutTick[btState] := MyGetTickCount + n14 * 1000;
            if not g_Config.boElectrodelessUseMaxSC then
            begin
              dwMaxSC := m_WAbil.SC1 + m_WAbil.SC2 - m_WAbil.SC1 - m_wStatusArrValue[btState];
              nPower := Min(dwMaxSC, GetAttackPower(m_WAbil.SC1, Max(m_WAbil.SC2 - m_WAbil.SC1,
                1) - m_wStatusArrValue[btState] + 1));
            end
            else
            begin
              dwMaxSC := m_WAbil.SC2 - m_wStatusArrValue[btState] + 1;
              nPower := dwMaxSC;
            end;
            if UserMagic.btNewLevel > 0 then
            begin
              if UserMagic.btNewLevel <= 9 then
                nPower := Round(nPower * (g_Config.NewLevelMagicPowerRatesSpecific[46][UserMagic.btNewLevel - 1] / 100))
              else
              begin
                Level9Power := nPower * (g_Config.NewLevelMagicPowerRatesSpecific[46][9 - 1] / 100);
                Rate := 1 + (UserMagic.btNewLevel - 9) * (g_Config.NewLevelMagicPowerRatesAfter9 / 100);
                nPower := Round(Min(Level9Power * Rate, High(Integer)));
              end;
            end
            else
            begin
              nPower := Trunc(nPower * (g_Config.nElectrodelessPowerRates[Min(UserMagic.btLevel, 4)] / 100));
            end;
            m_wStatusArrValue[btState] := Min(nPower, High(Integer));
            if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (Length(g_sSCUPPoint) > 0) then
            begin
              s := StringReplace(g_sSCUPPoint, '%p', IntToStr(m_wStatusArrValue[btState { 2 } ]), []);
              s := StringReplace(s, '%t', IntToStr(n14), []);
              SysMsg(s, c_Green, t_Hint);
            end;
          end;
        3:
          begin
            n14 := Random(10 + UserMagic.btLevel) + UserMagic.btLevel;
            m_dwStatusArrTimeOutTick[btState] := MyGetTickCount + n14 * 1000;
            m_wStatusArrValue[btState] := Max(m_nHitSpeed div 5, 1);
            if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (Length(g_sHitSpeedUPPoint) > 0) then
            begin
              s := StringReplace(g_sHitSpeedUPPoint, '%p', IntToStr(m_wStatusArrValue[btState { 2 } ]), []);
              s := StringReplace(s, '%t', IntToStr(n14), []);
              SysMsg(s, c_Green, t_Hint);
            end;
          end;
        4:
          begin
            n14 := Random(10 + UserMagic.btLevel) + UserMagic.btLevel;
            m_dwStatusArrTimeOutTick[btState] := MyGetTickCount + n14 * 1000;
            m_wStatusArrValue[btState] := Max(m_WAbil.MaxHP div 5, 1);
            if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (Length(g_sMaxHPUPPoint) > 0) then
            begin
              s := StringReplace(g_sMaxHPUPPoint, '%p', IntToStr(m_wStatusArrValue[btState { 2 } ]), []);
              s := StringReplace(s, '%t', IntToStr(n14), []);
              SysMsg(s, c_Green, t_Hint);
            end;
          end;
        5:
          begin
            n14 := Random(10 + UserMagic.btLevel) + UserMagic.btLevel;
            m_dwStatusArrTimeOutTick[btState] := MyGetTickCount + n14 * 1000;
            m_wStatusArrValue[btState] := Max(m_WAbil.MaxMP div 5, 1);
            if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (Length(g_sMaxMPUPPoint) > 0) then
            begin
              s := StringReplace(g_sMaxMPUPPoint, '%p', IntToStr(m_wStatusArrValue[btState { 2 } ]), []);
              s := StringReplace(s, '%t', IntToStr(n14), []);
              SysMsg(s, c_Green, t_Hint);
            end;
          end;
      end;
      RecalcAbilitys();
      if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
        SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
      Result := True;
    end;
  end;
end;

function TBaseObject.DefenceUp(nSec: Integer): Boolean;
begin
  Result := False;
  if m_wStatusTimeArr[STATE_DEFENCEUP { 0x72 } ] > 0 then
  begin
    if m_wStatusTimeArr[STATE_DEFENCEUP { 0x72 } ] < nSec then
    begin
      m_wStatusTimeArr[STATE_DEFENCEUP { 0x72 } ] := nSec;
