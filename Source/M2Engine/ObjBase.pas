            nNewPower := GetMagicPercentPower(56, nNewPower, BaseObject);
            nNewPower := Max(Round(nNewPower - nNewPower * (I / 8)), 0);
            if nNewPower > 0 then
            begin
              CloseTargetSuperShiled(15, nSkillAttackLevel, BaseObject);
