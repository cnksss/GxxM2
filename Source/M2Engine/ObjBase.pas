    if m_wStatusArrValue[0] > 0 then
    begin
      m_WAbil.DC1 := m_WAbil.DC1;
      Int64Value := Int64(m_WAbil.DC2) + m_wStatusArrValue[0];
      m_WAbil.DC2 := Min(nMaxAC, Int64Value);
    end;

    if m_wStatusArrValue[1] > 0 then
    begin
      m_WAbil.MC1 := m_WAbil.MC1;
      Int64Value := Int64(m_WAbil.MC2) + m_wStatusArrValue[1];
      m_WAbil.MC2 := Min(nMaxAC, Int64Value);
    end;

    if m_wStatusArrValue[2] > 0 then
    begin
      m_WAbil.SC1 := m_WAbil.SC1;
      Int64Value := Int64(m_WAbil.SC2) + m_wStatusArrValue[2];
      m_WAbil.SC2 := Min(nMaxAC, Int64Value);
