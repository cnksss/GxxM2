  function Skill42Attack(nSecPwr: Integer): Boolean; // 龙影剑法     ID=42
  var
    I, nC, n10, nX, nY, AttackX, AttackY: Integer;
    BaseObject: TBaseObject;
    TwinAttack: array [0 .. 2] of Integer;
    IsSetPKPower: Boolean;
  begin
    Result := False;
    nSecPwr := Min(LongWord(Round(nSecPwr * (g_Config.nSkill42PowerRate / 100))), High(Integer));
    if nSecPwr <= 0 then
      Exit;
    // TwinAttack := (7, 0, 1); 参考JS引擎
    TwinAttack[0] := 7;
    TwinAttack[1] := 0;
    TwinAttack[2] := 1;
    IsSetPKPower := True;
    // 修正龙影剑法对近身一格的目标无伤害 chongchong 2013-12-27
    for I := 0 to g_Config.nSkill42Range - 1 do
    begin
      if (I = 0) or m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, m_btDirection, I, AttackX, AttackY) then
      begin
        if I = 0 then
        begin
          AttackX := m_nCurrX;
          AttackY := m_nCurrY;
        end;
        nC := 0;
        while (True) do
        begin
          n10 := (m_btDirection + TwinAttack[nC]) mod 8;
          if m_PEnvir.GetNextPosition(AttackX, AttackY, n10, 1, nX, nY) then
          begin
            BaseObject := m_PEnvir.GetMovingObject(nX, nY, True);
            nSecPwr := GetMagicPercentPower(SKILL_42 { 56--不懂这里为什么是56 chongchong 2013-12-27 } , nSecPwr, BaseObject);
            if (nSecPwr > 0) and (BaseObject <> nil) and IsProperTarget(BaseObject) then
            begin
              if DirectAttack(BaseObject, nSecPwr, 42, IsSetPKPower) then
                Result := True;
              if IsSetPKPower then
                IsSetPKPower := False;
              SetTargetCreat(BaseObject);
              // 修正隔位刺杀只有隔位目标时，<$ATTACKMONSTER_MAXHPEX>等变量为空 2021-01-14
              if m_CurrTargetEx = nil then
                m_CurrTargetEx := BaseObject;
            end;
          end;
          Inc(nC);
          if nC >= 3 then
            Break;
        end;
      end;
    end;
  end;
