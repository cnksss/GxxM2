procedure TBaseObject.SpaceMove(sMapName: string; nX, nY: Integer; nInt: Integer); // 004BCD1C
  function GetRandXY(Envir: TEnvirnoment; var nX: Integer; var nY: Integer): Boolean;
  var
    n14, n18, n1C: Integer;
  begin
    Result := False;
    if Envir.m_nWidth < 80 then
      n18 := 3
    else
      n18 := 10;
    if Envir.m_nHeight < 150 then
    begin
      if Envir.m_nHeight < 50 then
        n1C := 2
      else
        n1C := 15;
    end
    else
      n1C := 50;
    n14 := 0;
    while (True) do
    begin
      if Envir.CanWalk(nX, nY, True) then
      begin
        Result := True;
        Break;
      end;
      if nX < (Envir.m_nWidth - n1C - 1) then
        Inc(nX, n18)
      else
      begin
        nX := Random(Envir.m_nWidth);
        if nY < (Envir.m_nHeight - n1C - 1) then
          Inc(nY, n18)
        else
          nY := Random(Envir.m_nHeight);
      end;
      Inc(n14);
      if n14 >= 201 then
        Break;
    end;
  end;

var
  bo21: Boolean;
  Envir, OldEnvir: TEnvirnoment;
  nOldX, nOldY: Integer;
  PlayObject: TPlayObject;
  Castle: TUserCastle;
  tmpPlayerMove, tmpHeroMove: Boolean;
begin
  if ((m_btRaceServer = RC_PLAYOBJECT) and TPlayObject(Self).m_boShopStall) or (m_btRaceServer = RC_TRUCKOBJECT) then
    Exit; // 正在摆摊

  if m_btRaceServer = RC_PLAYOBJECT then
  begin
    TPlayObject(Self).StopCollect;
    // 修正主人随机时，英雄也随机跟随主人 chongchong 2017-12-12
    if (TPlayObject(Self).m_MyHero <> nil) and not THeroObject(TPlayObject(Self).m_MyHero).m_boTarget then
      TPlayObject(Self).m_MyHero.DelTargetCreat;
  end;

  // 双人骑马 chongchong 2013-10-15
  if (m_btRaceServer = RC_PLAYOBJECT) and TPlayObject(Self).m_boOnHorse and (TPlayObject(Self).m_HorseOtherHum <> nil) then
    Exit;

  if (m_btRaceServer = RC_PLAYOBJECT) and m_boDummyObject and (not CanDummyMoveMap(sMapName)) then
    Exit;

  tmpPlayerMove := False;
  tmpHeroMove := False;

  Envir := g_MapManager.FindMap(sMapName);
  if Envir <> nil then
  begin
    if nServerIndex = Envir.nServerIndex then
    begin
      OldEnvir := m_PEnvir;
      nOldX := m_nCurrX;
      nOldY := m_nCurrY;
      bo21 := False;

      if m_PEnvir.DeleteFromMap(m_nCurrX, m_nCurrY, Self) then
      begin
        ClearObject;

        m_PEnvir := Envir;
        m_sMapName := Envir.sMapName;
        m_nCurrX := nX;
        m_nCurrY := nY;

        if GetRandXY(m_PEnvir, m_nCurrX, m_nCurrY) then
        begin
          if m_PEnvir.AddToMap(m_nCurrX, m_nCurrY, Self) = Self then
          begin
            // 在随机飞或换地图时，将角色设置为管理员模式1秒钟，然后恢复 chongchong 2016-03-22
            if not m_boTempAdminMode then
            begin
              m_dwTempAdminModeTick := MyGetTickCount;
              m_boTempAdminMode := True;
            end;

            // CHECKQUEST地图参数进入地图触发 chongchong 2014-04-03
            if m_PEnvir <> OldEnvir then
            begin
              if m_btRaceServer = RC_PLAYOBJECT then
              begin
                if Envir.QuestNPC <> nil then
                  TMerchant(Envir.QuestNPC).Click(TPlayObject(Self));

                // 换地图清M变量 chongchong 2015-05-24
                FillChar(TPlayObject(Self).m_nMval, SizeOf(TPlayObject(Self).m_nMval), #0);
                TPlayObject(Self).m_nScriptGotoCount := 0;

                tmpPlayerMove := True; // 将 @EnterMap 触发移动到实际移动后再触发
                // g_FunctionNPC.GotoLable(TPlayObject(Self), '@EnterMap', False);

                if (MyGetTickCount() - TPlayObject(Self).m_dwTimeMapCurrTime >= OldEnvir.m_nTimeMapMin * 60 * 1000) and
                  (OldEnvir.m_sTimeMapLabel <> '') then // 限时地图 By 一支笔 at:2021-10-14 09:51:09
                  g_FunctionNPC.GotoLable(TPlayObject(Self), OldEnvir.m_sTimeMapLabel, False);

                // if Envir.m_nTimeMapMin > 0 then//限时地图 By 一支笔 at:2021-10-14 09:51:09
                // begin
                TPlayObject(Self).m_dwTimeMapCurrTime := MyGetTickCount();
                TPlayObject(Self).SendDefMessage(SM_FBTIME, Envir.m_nTimeMapMin * 60 * 1000, 0, 0, 5, '');
                // TPlayObject(Self).SendCenterMsg('还剩d%秒离开本地图', 255, 0, Envir.m_nTimeMapMin * 60 * 1000);
                // end;
              end
              else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
              begin
                TPlayObject(m_Master).m_nScriptGotoCount := 0;

                tmpHeroMove := True; // 将 @HeroEnterMap 触发移动到实际移动后再触发
                // g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroEnterMap', False);
              end;
            end;

            bo21 := True;
            if (m_btRaceServer = RC_PLAYOBJECT) and (not m_boOffLine) and (not m_boDummyObject) then
            begin
              SendMsg(Self, RM_CLEAROBJECTS, 0, 0, 0, 0, '');
              if (TPlayObject(Self).m_MyHero <> nil) and (TPlayObject(Self).m_MyHero.m_boTarget) then
              begin
                TPlayObject(Self).m_MyHero.m_boTarget := False;
                TPlayObject(Self).m_MyHero.DelTargetCreat;
              end;

              // 修正直接飞到攻城攻不变色 2019-12-10 16:20:34
              Castle := g_CastleManager.InCastleWarArea(Self);
              if (Castle <> nil) and Castle.m_boUnderWar then
                ChangePKStatus(True);

              // SendMsg(Self, RM_CHANGEMAP, 0, 0, 0, 0, Envir.MapName); // 获取重复利用地图名称
              if (not SameText(Envir.MapName, Envir.sMapName)) then
                SendMsg(Self, RM_CHANGEMAP, 0, 0, 0, 0, Envir.MapName + sLineBreak + Envir.sMapName)
              else
                SendMsg(Self, RM_CHANGEMAP, 0, 0, 0, 0, Envir.MapName);

              // 换地图后，立马把周边的对象发送到客户端 chongchong 2018-09-12 21:31:35
              m_dwSearchTick := MyGetTickCount();
              SearchViewRange;

              // 浑水摸鱼模式，换地图 chongchong 2016-10-20
              if ((OldEnvir.m_nSecretFlag and SecretFlag_ShowEqualName) <> (m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName))
                or ((OldEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName) <> (m_PEnvir.m_nSecretFlag2 and
                SecretFlag_ShowEqualName)) then
                SendMsg(Self, RM_USERNAME, 0, 0, 0, 0, GetShowName);

              if ((OldEnvir.m_nSecretFlag and SecretFlag_NoChangNameColor) <> (m_PEnvir.m_nSecretFlag and
                SecretFlag_NoChangNameColor)) or ((OldEnvir.m_nSecretFlag2 and SecretFlag_NoChangNameColor) <>
                (m_PEnvir.m_nSecretFlag2 and SecretFlag_NoChangNameColor)) then
                SendMsg(Self, SM_CHANGENAMECOLOR, GetCharColor(Self), 0, 0, 0, '');
            end;

            if nInt = 1 then
              SendRefMsg(RM_SPACEMOVE_SHOW2, m_btDirection, m_nCurrX, m_nCurrY, 0, GetShowName)
            else
              SendRefMsg(RM_SPACEMOVE_SHOW, m_btDirection, m_nCurrX, m_nCurrY, 0, GetShowName);

            if tmpPlayerMove then
              g_FunctionNPC.GotoLable(TPlayObject(Self), '@EnterMap', False);

            if tmpHeroMove then
              g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroEnterMap', False);

            m_dwMapMoveTick := MyGetTickCount();
            m_bo316 := True;
            InitSpeed;
            OnSpaceMove;
          end;
        end;

        if not bo21 then
        begin
          m_PEnvir := OldEnvir;
          m_nCurrX := nOldX;
          m_nCurrY := nOldY;
          m_PEnvir.AddToMap(m_nCurrX, m_nCurrY, Self);
        end;
      end;
    end
    else if GetRandXY(Envir, nX, nY) then
    begin
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        DisappearA();
        m_bo316 := True;
        PlayObject := TPlayObject(Self);
        PlayObject.m_dwSayAdvertiseTick := MyGetTickCount;
        PlayObject.m_sSwitchMapName := Envir.sMapName;
        PlayObject.m_nSwitchMapX := nX;
        PlayObject.m_nSwitchMapY := nY;
        PlayObject.m_boSwitchData := True;
        PlayObject.m_nServerIndex := Envir.nServerIndex;
        PlayObject.m_boEmergencyClose := True;
        PlayObject.m_boReconnection := True;
        PlayObject.DisappearB(); // 增加清除行会和组对列表
      end
      else
        KickException();
    end;
  end;
end;

function TBaseObject.GetRandXY(Envir: TEnvirnoment; var nX: Integer; var nY: Integer): Boolean;
var
  n14, n18, n1C: Integer;
begin
  Result := False;
  if Envir.m_nWidth < 80 then
    n18 := 3
  else
    n18 := 10;
  if Envir.m_nHeight < 150 then
  begin
    if Envir.m_nWidth < 50 then
      n1C := 2
    else
      n1C := 15;
  end
  else
    n1C := 50;
  n14 := 0;
  while (True) do
  begin
    if Envir.CanWalk(nX, nY, True) then
    begin
      Result := True;
      Break;
    end;
    if nX < (Envir.m_nWidth - n1C - 1) then
      Inc(nX, n18)
    else
    begin
      nX := Random(Envir.m_nWidth);
      if nY < (Envir.m_nHeight - n1C - 1) then
        Inc(nY, n18)
      else
        nY := Random(Envir.m_nHeight);
    end;
    Inc(n14);
    if n14 >= 201 then
      Break;
  end;
end;

