    if AllAddAbility.nAC2 <> 0 then
    begin
      Int64Value := Round((Int64(m_WAbil.AC2) + m_WAbil.AC2 / 100 * AllAddAbility.nAC2));
      m_WAbil.AC2 := Min(nMaxAC, Int64Value);
    end;

    if AllAddAbility.nMAC2 <> 0 then
    begin
      Int64Value := Round((Int64(m_WAbil.MAC2) + m_WAbil.MAC2 / 100 * AllAddAbility.nMAC2));
      m_WAbil.MAC2 := Min(nMaxAC, Int64Value);
    end;

    if AllAddAbility.nDC2 <> 0 then
    begin
      Int64Value := Round((Int64(m_WAbil.DC2) + m_WAbil.DC2 / 100 * AllAddAbility.nDC2));
      m_WAbil.DC2 := Min(nMaxAC, Int64Value);
    end;

    if AllAddAbility.nMC2 <> 0 then
    begin
      Int64Value := Round((Int64(m_WAbil.MC2) + m_WAbil.MC2 / 100 * AllAddAbility.nMC2));
      m_WAbil.MC2 := Min(nMaxAC, Int64Value);
    end;

    if AllAddAbility.nSC2 <> 0 then
    begin
      Int64Value := Round((Int64(m_WAbil.SC2) + m_WAbil.SC2 / 100 * AllAddAbility.nSC2));
      m_WAbil.SC2 := Min(nMaxAC, Int64Value);
    end;

    if AllAddAbility.wHP <> 0 then
    begin
      Int64Value := Round((Int64(m_WAbil.MaxHP) + m_WAbil.MaxHP / 100 * AllAddAbility.wHP));
      m_WAbil.MaxHP := Min(nMaxValue, Int64Value);
    end;

    if AllAddAbility.wMP <> 0 then
    begin
      Int64Value := Round((Int64(m_WAbil.MaxMP) + m_WAbil.MaxMP / 100 * AllAddAbility.wMP));
