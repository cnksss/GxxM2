            end;
          end;
          if nMagicLevel >= 3 then
          begin
            if m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, m_btDirection, 2, nX, nY) then
            begin
              BaseObject_30 := TBaseObject(m_PEnvir.GetMovingObject(nX, nY, True));
              if (BaseObject_30 <> nil) and CanMotaebo(BaseObject_30) then
              begin
                if not((BaseObject_30 <> nil) and (BaseObject_30.m_Master <> nil) and (BaseObject_30.m_boGamePet) and
                  g_Config.boPetNoEntity) then
                begin
                  BaseObject_30.CharPushed(m_btDirection, 1);
                end;
              end;
            end;
          end;
          BaseObject_34 := PoseCreate;
          if not((PoseCreate <> nil) and (PoseCreate.m_Master <> nil) and (PoseCreate.m_boGamePet) and g_Config.boPetNoEntity)
