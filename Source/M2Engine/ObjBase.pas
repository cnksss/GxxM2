function TSmartObject.Allow115HitSkill(): Boolean; // //血魄一击     ID=113
var
  nSkill115HitWaitTime: Integer;
  UserMagic: pTUserMagic;
  nSpellPoint: Integer;
  DecHP: Int64;
begin
  Result := False;
  // if m_btRaceServer = RC_HEROOBJECT then
  // nSkill115HitWaitTime := g_Config.nHeroSkill115CD * 1000
  // else
  // nSkill115HitWaitTime := GetMagicCD(SKILL_115);
  if (MyGetTickCount - m_SkillUseTick[115]) >= GetMagicCD(SKILL_115) { nSkill115HitWaitTime } then
  begin
    UserMagic := m_UserMagics[SKILL_115];
    if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (UserMagic <> nil) and g_Config.boSkill115UseNG then
    begin
      nSpellPoint := GetSpellPoint(UserMagic);
      if (not m_boTrainingNG) then
      begin
        if g_Config.boSkill115NGNoEnoughDecHP then
        begin
          if g_Config.nSkill115NGNoEnoughDecHPType = 0 then
          begin
            DecHP := Round(m_WAbil.HP / 100 * g_Config.nSkill115NGNoEnoughDecHPValue);
            if m_WAbil.HP <= DecHP + 1 then
            begin
              if m_btRaceServer = RC_PLAYOBJECT then
              begin
                // SysMsg('血量不足，无法使用', g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
                SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '血量不足，无法使用');
              end;
              Exit;
            end;
            m_WAbil.HP := m_WAbil.HP - DecHP;
            HealthSpellChanged();
          end
          else
          begin
            DecHP := g_Config.nSkill115NGNoEnoughDecHPValue;
            if m_WAbil.HP <= DecHP + 1 then
            begin
              if m_btRaceServer = RC_PLAYOBJECT then
              begin
                // SysMsg('血量不足，无法使用', g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
                SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '血量不足，无法使用');
              end;
              Exit;
            end;
            m_WAbil.HP := m_WAbil.HP - DecHP;
            HealthSpellChanged();
          end;
        end
        else
        begin
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            // SysMsg('没有学习内力，无法使用', g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
            SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '没有学习内力，无法使用');
          end;
          Exit;
        end;
      end
      else
      begin
        // 检测内力值是否达到要求 piaoyun 2013-09-13
        if (m_AbilNG.NH < nSpellPoint) then
        begin
          if g_Config.boSkill115NGNoEnoughDecHP then
          begin
            if g_Config.nSkill115NGNoEnoughDecHPType = 0 then
            begin
              DecHP := Round(m_WAbil.HP / 100 * g_Config.nSkill115NGNoEnoughDecHPValue);
              if m_WAbil.HP <= DecHP + 1 then
              begin
                if m_btRaceServer = RC_PLAYOBJECT then
                begin
                  // SysMsg('血量不足，无法使用', g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
                  SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '血量不足，无法使用');
                end;
                Exit;
              end;
              m_WAbil.HP := m_WAbil.HP - DecHP;
              HealthSpellChanged();
            end
            else
            begin
              DecHP := g_Config.nSkill115NGNoEnoughDecHPValue;
              if m_WAbil.HP <= DecHP + 1 then
              begin
                if m_btRaceServer = RC_PLAYOBJECT then
                begin
                  // SysMsg('血量不足，无法使用', g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
                  SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '血量不足，无法使用');
                end;
                Exit;
              end;
              m_WAbil.HP := m_WAbil.HP - DecHP;
              HealthSpellChanged();
            end;
          end
          else
          begin
            if m_btRaceServer = RC_PLAYOBJECT then
            begin
              // SysMsg('内力不足，无法使用', g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
              SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '内力不足，无法使用');
            end;
            Exit;
          end;
        end
        else
        begin
          m_AbilNG.NH := Max(0, m_AbilNG.NH - nSpellPoint);
          RefAbilNH;
        end;
      end;
    end;
    m_SkillUseTick[115] := MyGetTickCount();
    m_bo115Skill := True;
    if (m_btRaceServer = RC_PLAYOBJECT) and (not m_boDummyObject) and (Length(sXHYJSpiritsSummoned) > 0) then
      SendMsg(Self, RM_MAGIC_HINT_MSG, 1, 0, 0, 0, sXHYJSpiritsSummoned);
    Result := True;
  end
  else
  begin
    // HZQ 20230412 从上面的注释中拷贝过来
    if m_btRaceServer = RC_HEROOBJECT then
      nSkill115HitWaitTime := g_Config.nHeroSkill115CD * 1000
    else
      nSkill115HitWaitTime := GetMagicCD(SKILL_115);
    if (m_btRaceServer = RC_PLAYOBJECT) and (not m_boDummyObject) and (Length(sXHYJSpiritsFail) > 0) then
    begin
      SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, sXHYJSpiritsFail);
    end;
    if (m_btRaceServer = RC_PLAYOBJECT) and (not TPlayObject(Self).m_boOffLine) and (not TPlayObject(Self).m_boDummyObject) and
      (nSkill115HitWaitTime * 1000 - (MyGetTickCount - m_SkillUseTick[115]) > 100) then
    begin
      TPlayObject(Self).SendDefMessage(SM_SENDOPENSKILLTIME,
        Round((nSkill115HitWaitTime * 1000 - (MyGetTickCount - m_SkillUseTick[115])) / 1000), 115, 0, 0, '');
    end;
  end;
end;

// nType 为指定类型 1 为护身符 2 为毒药  3诅咒符    Idx = -1; 不需要毒 符  Idx >= 13 使用包裹中的  Idx < 13 使用身上的
function _CheckAmulet(BaseObject: TSmartObject; var nShape: Integer; nCount: Integer; var Idx: Integer;
  boEqual: Boolean = False): Boolean;
var
  AmuletStdItem: pTStdItem;
begin
  Result := False;
  Idx := -1;
  if BaseObject.m_UseItems[U_ARMRINGL].wIndex > 0 then
  begin
    AmuletStdItem := UserEngine.GetStdItem(BaseObject.m_UseItems[U_ARMRINGL].wIndex);
    if (AmuletStdItem <> nil) and (AmuletStdItem.StdMode = 25) then
    begin
      if BaseObject.m_UseItems[U_ARMRINGL].Dura <= 0 then
      begin
        if AmuletStdItem.NeedIdentify = 1 then
        begin
          AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, BaseObject, AmuletStdItem.Name,
            BaseObject.m_UseItems[U_ARMRINGL].MakeIndex, '0', 0, 0, '持久为0');
        end;
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(BaseObject).SendDelItem(@BaseObject.m_UseItems[U_ARMRINGL])
        else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(BaseObject).SendDelItem(@BaseObject.m_UseItems[U_ARMRINGL]);
        BaseObject.m_UseItems[U_ARMRINGL].wIndex := 0;
        Exit;
      end;
      case nShape of
        5:
          begin // 符咒
            if (AmuletStdItem.Shape = nShape) and
              ((Round(BaseObject.m_UseItems[U_ARMRINGL].Dura / g_Config.nMagicItemRate) >= nCount) or
              (BaseObject.m_UseItems[U_ARMRINGL].Dura > 0)) then
            begin
              Idx := U_ARMRINGL;
              Result := True;
              Exit;
            end;
          end; // 毒
        1, 2:
          begin
            if boEqual then
            begin
              if (AmuletStdItem.Shape = nShape) and (Round(BaseObject.m_UseItems[U_ARMRINGL].Dura / g_Config.nMagicItemRate) >=
                nCount) then
              begin
                nShape := AmuletStdItem.Shape;
                Idx := U_ARMRINGL;
                Result := True;
                Exit;
              end;
            end
            else if (AmuletStdItem.Shape in [1, 2]) and (Round(BaseObject.m_UseItems[U_ARMRINGL].Dura / g_Config.nMagicItemRate)
              >= nCount) then
            begin
              nShape := AmuletStdItem.Shape;
              Idx := U_ARMRINGL;
              Result := True;
              Exit;
            end;
            // end;
          end;
      end;
    end;
  end;
  if BaseObject.m_UseItems[U_BUJUK].wIndex > 0 then
  begin
    AmuletStdItem := UserEngine.GetStdItem(BaseObject.m_UseItems[U_BUJUK].wIndex);
    if (AmuletStdItem <> nil) and (AmuletStdItem.StdMode = 25) then
    begin
      if BaseObject.m_UseItems[U_BUJUK].Dura <= 0 then
      begin
        if AmuletStdItem.NeedIdentify = 1 then
        begin
          AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, BaseObject, AmuletStdItem.Name,
            BaseObject.m_UseItems[U_BUJUK].MakeIndex, '0', 0, 0, '持久为0');
        end;
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(BaseObject).SendDelItem(@BaseObject.m_UseItems[U_BUJUK])
        else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(BaseObject).SendDelItem(@BaseObject.m_UseItems[U_BUJUK]);
        BaseObject.m_UseItems[U_BUJUK].wIndex := 0;
        Exit;
      end;
      case nShape of
        5:
          begin
            if (AmuletStdItem.Shape = nShape) and
              ((Round(BaseObject.m_UseItems[U_BUJUK].Dura / g_Config.nMagicItemRate) >= nCount) or
              (BaseObject.m_UseItems[U_BUJUK].Dura > 0)) then
            begin
              Idx := U_BUJUK;
              Result := True;
              Exit;
            end;
          end;
        1, 2:
          begin // 毒
            if boEqual then
            begin
              if (AmuletStdItem.Shape = nShape) and (Round(BaseObject.m_UseItems[U_BUJUK].Dura / g_Config.nMagicItemRate) >=
                nCount) then
              begin
                nShape := AmuletStdItem.Shape;
                Idx := U_BUJUK;
                Result := True;
                Exit;
              end;
            end
            else if (AmuletStdItem.Shape in [1, 2]) and (Round(BaseObject.m_UseItems[U_BUJUK].Dura / g_Config.nMagicItemRate) >=
              nCount) then
            begin
              Idx := U_BUJUK;
              nShape := AmuletStdItem.Shape;
              Result := True;
              Exit;
            end;
          end;
      end;
    end;
  end;
end;

function _CheckBagAmulet(BaseObject: TSmartObject; var nShape: Integer; nCount: Integer; var Idx: Integer;
  boEqual: Boolean = False): Boolean;
var
  AmuletStdItem: pTStdItem;
  UserItem: pTUserItem;
begin
  Result := False;
  Idx := -1;
  if boEqual then
  begin
    Idx := GetUserItemListEx(BaseObject, nShape, nCount);
    if (Idx < 0) then
    begin
      Idx := GetUserItemList(BaseObject, nShape, nCount);
      boEqual := False;
    end;
  end
  else
  begin
    Idx := GetUserItemList(BaseObject, nShape, nCount);
  end;
  if (Idx >= 0) and (Idx < BaseObject.m_ItemList.Count) then
  begin
    UserItem := BaseObject.m_ItemList.Items[Idx];
    if (UserItem.wIndex > 0) then
    begin
      AmuletStdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (AmuletStdItem <> nil) and (AmuletStdItem.StdMode = 25) then
      begin
        if UserItem.Dura <= 0 then
        begin
          if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(BaseObject).SendDelItem(UserItem)
          else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(BaseObject).SendDelItem(UserItem);
          BaseObject.m_ItemList.Delete(Idx);
          Dispose(UserItem);
          Exit;
        end;
        case nShape of
          5:
            begin
              if (AmuletStdItem.Shape = nShape) and ((Round(UserItem.Dura / g_Config.nMagicItemRate) >= nCount) or
                (UserItem.Dura > 0)) then
              begin
                Inc(Idx, Length(BaseObject.m_UseItems));
                Result := True;
                Exit;
              end;
            end;
          1, 2:
            begin
              if boEqual then
              begin
                if (AmuletStdItem.Shape = nShape) and ((Round(UserItem.Dura / g_Config.nMagicItemRate) >= nCount) or
                  (UserItem.Dura > 0)) then
                begin
                  Inc(Idx, Length(BaseObject.m_UseItems));
                  nShape := AmuletStdItem.Shape;
                  Result := True;
                  Exit;
                end;
              end
              else
              begin
                if (AmuletStdItem.Shape in [1, 2]) and ((Round(UserItem.Dura / g_Config.nMagicItemRate) >= nCount) or
                  (UserItem.Dura > 0)) then
                begin
                  Inc(Idx, Length(BaseObject.m_UseItems));
                  nShape := AmuletStdItem.Shape;
                  Result := True;
                  Exit;
                end;
              end;
            end;
        end;
      end;
    end;
  end;
end;

// nType 为指定类型 1 为护身符 2 为毒药  3诅咒符
procedure _UseAmulet(BaseObject: TSmartObject; nCount: Integer; Idx: Integer);
var
  UserItem: pTUserItem;
begin
  if (Idx >= Length(BaseObject.m_UseItems)) then
  begin // 直接使用包裹中物品
    Dec(Idx, Length(BaseObject.m_UseItems));
    if (Idx >= 0) and (Idx < BaseObject.m_ItemList.Count) then
    begin
      UserItem := BaseObject.m_ItemList.Items[Idx];
      if UserItem.Dura > nCount * g_Config.nMagicItemRate then
      begin
        Dec(UserItem.Dura, nCount * g_Config.nMagicItemRate);
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(BaseObject).SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura)
        else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(BaseObject).SendUpdateItemDura(-1, UserItem.MakeIndex, UserItem.Dura);
      end
      else
      begin
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(BaseObject).SendDelItem(UserItem);
        if BaseObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(BaseObject).SendDelItem(UserItem);
        BaseObject.m_ItemList.Delete(Idx);
        Dispose(UserItem);
      end;
    end;
  end
  else if (Idx in [Low(THumanUseItems) .. High(THumanUseItems)]) then
  begin // 直接使用身上的物品
    if BaseObject.m_UseItems[Idx].Dura > nCount * g_Config.nMagicItemRate then
    begin
      Dec(BaseObject.m_UseItems[Idx].Dura, nCount * g_Config.nMagicItemRate);
      BaseObject.SendMsg(BaseObject, RM_DURACHANGE, Idx, BaseObject.m_UseItems[Idx].Dura,
        BaseObject.m_UseItems[Idx].DuraMax, 0, '');
    end
    else
    begin
      BaseObject.m_UseItems[Idx].Dura := 0;
      if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(BaseObject).SendDelItem(@BaseObject.m_UseItems[Idx]);
      if BaseObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(BaseObject).SendDelItem(@BaseObject.m_UseItems[Idx]);
      BaseObject.m_UseItems[Idx].wIndex := 0;
    end;
  end;
end;

function TSmartObject.AllowCustomSkill(MagicID: Word; boCheckNeedItem: Boolean; OnlyCheckItem: Boolean): Boolean;
label DoCheckExit;
var
  CustomMagicConfig: TCustomMagicConfig;
  I, nTime, UseInterval, nAmuletIdx: Integer;
  nShape: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  boFoundUseItem: Boolean;
  s, sItemName: string;
  ClientConfig: PMagicClientConfig;
  n01: Integer;
  Player: TPlayObject;
  PInt: PInteger;
begin
  Result := False;
  boFoundUseItem := False;
  CustomMagicConfig := GetCustomMagicConfig(MagicID);
  if CustomMagicConfig = nil then
    Exit;
  if (CustomMagicConfig.ClientBaseConfig.MagicSwitchMode = msmPowerHit) and (m_btRaceServer = RC_PLAYOBJECT) then
    Exit;
  PInt := nil;
  if CustomMagicConfig.ServerConfig.IsCheckVarValue then
  begin
    Result := False;
    if (Length(CustomMagicConfig.ServerConfig.CheckVarName) = 0) then
    begin
      boFoundUseItem := True;
      goto DoCheckExit;
      Exit;
    end;
    if not(m_btRaceServer = RC_PLAYOBJECT) then
    begin
      boFoundUseItem := True;
      goto DoCheckExit;
      Exit;
    end;
    Player := Self as TPlayObject;
    n01 := GetValNameNo(CustomMagicConfig.ServerConfig.CheckVarName);
    if n01 < 0 then
    begin
      Exit;
    end;
    boFoundUseItem := True;
    case n01 of
      0 .. 999: // P
        begin
          PInt := @Player.m_nVal[n01];
        end;
      1000 .. 1999: // D
        begin
          PInt := @Player.m_DyVal[n01 - 1000];
        end;
      2000 .. 2999: // M
        begin
          PInt := @Player.m_nMval[n01 - 2000];
        end;
      3000 .. 3999: // N
        begin
          PInt := @Player.m_nInteger[n01 - 3000];
        end;
      {
        4000..4999:                                                                                   // I
        begin
        g_Config.GlobaDyMval[n01 - 4000] := nValue;
        Result := True;
        end;
        5000..5999:
        begin
        g_Config.GlobalVal[n01 - 5000] := nValue;                                                 // G
        Result := True;
        end;
        6000..6999:
        begin
        g_Config.GlobalAVal[n01 - 6000] := sValue;
        Result := True;
        end;
        7000..7999:                                                                                   // A 字符
        begin
        Player.m_sString[n01 - 7000] := sValue;
        Result := True;
        end;
      }
      // 私有变量 U-数字型 chongchong 2014-10-18                                                    // U
      8000 .. 8499:
        begin
          PInt := @Player.m_UVal[n01 - 8000];
        end;
      {
        // 私有变量 T-字符串型 chongchong 2014-10-18
        8255..8509:
        begin
        Player.m_TVal[n01 - 8100] := sValue;
        Result := True;
        end;
      }
      // 私有变量 J-数字型(1天1清) chongchong 2014-10-18
      9000 .. 9499:
        begin
          PInt := @Player.m_JVal[n01 - 9000];
        end;
    else
      boFoundUseItem := False;
    end;
    if boFoundUseItem and (PInt <> nil) then
    begin
      case CustomMagicConfig.ServerConfig.CheckVarType of
        cvtMoreThan:
          boFoundUseItem := PInt^ > CustomMagicConfig.ServerConfig.CheckVarValue;
        cvtLessThan:
          boFoundUseItem := PInt^ < CustomMagicConfig.ServerConfig.CheckVarValue;
        cvtEqual:
          boFoundUseItem := PInt^ = CustomMagicConfig.ServerConfig.CheckVarValue;
        cvtNotEqual:
          boFoundUseItem := PInt^ <> CustomMagicConfig.ServerConfig.CheckVarValue;
        cvtQreaterEqual:
          boFoundUseItem := PInt^ >= CustomMagicConfig.ServerConfig.CheckVarValue;
        cvtLessEqual:
          boFoundUseItem := PInt^ <= CustomMagicConfig.ServerConfig.CheckVarValue;
      end;
    end;
  DoCheckExit:
    if OnlyCheckItem then
    begin
      Result := boFoundUseItem;
      Exit;
    end;
    if boFoundUseItem then
    begin
      if CustomMagicConfig.ClientBaseConfig.MagicSwitchMode = msmNone then
      begin
        UseInterval := GetMagicCD(MagicID); // CustomMagicConfig.ServerConfig.UseInterval * 1000; 2019-08-31 23:05:46
        if MyGetTickCount - m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID] >= UseInterval - 50 then
        begin
          m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID] := MyGetTickCount;
          m_boCustomSKill[MagicID - CUSTOM_MAGIC_START_ID] := True;
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            if Length(CustomMagicConfig.ServerConfig.SucceedMsg) > 0 then
            begin
              SendMsg(Self, RM_MAGIC_HINT_MSG, 1, 0, 0, 0, CustomMagicConfig.ServerConfig.SucceedMsg);
            end;
          end;
          Result := True;
        end
        else
        begin
          if Length(CustomMagicConfig.ServerConfig.FailMsg) > 0 then
          begin
            nTime := Round((GetMagicCD(MagicID) - (MyGetTickCount - m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID]
              )) / 1000);
            if nTime = 0 then
              nTime := 1;
            if m_btRaceServer = RC_PLAYOBJECT then
            begin
              s := StringReplace(CustomMagicConfig.ServerConfig.FailMsg, '%d', IntToStr(nTime), [rfIgnoreCase]);
              SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, s);
            end;
          end;
          case m_CustomSkill[MagicID - CUSTOM_MAGIC_START_ID].btNewLevel of
            0:
              ClientConfig := @CustomMagicConfig.ClientConfigs[mplNone];
            1 .. 3:
              ClientConfig := @CustomMagicConfig.ClientConfigs[mpl1_3];
            4 .. 6:
              ClientConfig := @CustomMagicConfig.ClientConfigs[mpl4_6];
          else
            ClientConfig := @CustomMagicConfig.ClientConfigs[mpl7_9];
          end;
          if Length(ClientConfig.Sounds[custMagicFail]) > 0 then
          begin
            SendMsg(Self, RM_PLAYSOUND, Integer(False), 0, 0, 0, 'Wav\' + ClientConfig.Sounds[custMagicFail]);
          end;
        end;
      end
      else
      begin
        if not m_boCustomSKill[MagicID - CUSTOM_MAGIC_START_ID] then
        begin
          // 不能下面的搞法，学习新烈火，隔位刺杀，新开天，隔位不停的攻击，不停的打刺杀和开天
          // 新烈火一直请求，导致新开天被关了，然后一直新开天假象 2020-04-28 02:40:08
          // 开启自定义技能时，自动关闭前面所有的 chongchong 2017-01-15
          {
            for I := 0 to Length(m_boCustomSKill) - 1 do
            begin
            m_boCustomSKill[I] := (I = MagicID - CUSTOM_MAGIC_START_ID);
            end;
          }
          m_boCustomSKill[MagicID - CUSTOM_MAGIC_START_ID] := True;
          m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID] := MyGetTickCount; // 2020-04-28 02:40:08
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            if Length(CustomMagicConfig.ServerConfig.SucceedMsg) > 0 then
            begin
              // SysMsg(CustomMagicConfig.ServerConfig.SucceedMsg, c_Green, t_Hint);
              SendMsg(Self, RM_MAGIC_HINT_MSG, 1, 0, 0, 0, CustomMagicConfig.ServerConfig.SucceedMsg);
            end;
            // TPlayObject(Self).SendSocket(nil, '+CUSSKILL_' + IntToStr(MagicID - CUSTOM_MAGIC_START_ID));
            TPlayObject(Self).SendOpenMagic(MagicID, True, 0);
          end;
          Result := False;
          // 开关技能在开的时候也减变量值
          if (PInt <> nil) then
          begin
            PInt^ := PInt^ + CustomMagicConfig.ServerConfig.CheckVarAdd;
          end;
        end
        else
        begin
          m_boCustomSKill[MagicID - CUSTOM_MAGIC_START_ID] := False;
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            if Length(CustomMagicConfig.ServerConfig.CloseMsg) > 0 then
            begin
              // SysMsg(CustomMagicConfig.ServerConfig.CloseMsg, c_Red, t_Hint);
              SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, CustomMagicConfig.ServerConfig.CloseMsg);
            end;
            // TPlayObject(Self).SendSocket(nil, '+UCUSSKILL_' + IntToStr(MagicID - CUSTOM_MAGIC_START_ID));
            TPlayObject(Self).SendOpenMagic(MagicID, False, 0);
          end;
          Result := False;
        end;
      end;
      if Result and (PInt <> nil) then
      begin
        PInt^ := PInt^ + CustomMagicConfig.ServerConfig.CheckVarAdd;
      end;
    end
    else
    begin
      if Length(g_sCustomMagicCheckVarValueFail) > 0 then
      begin
        s := StringReplace(g_sCustomMagicCheckVarValueFail, '%s', CustomMagicConfig.MagicName, [rfReplaceAll]);
        SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, s);
      end;
    end;
    Exit;
  end;
  if (CustomMagicConfig.ClientBaseConfig.MagicSwitchMode <> msmPowerHit) then
  begin
    nAmuletIdx := -1;
    boFoundUseItem := False;
    if (not boCheckNeedItem) or (CustomMagicConfig.ServerConfig.NeedItemCount = 0) then
      boFoundUseItem := True
    else
    begin
      case CustomMagicConfig.ServerConfig.NeedItem of
        meiNone:
          begin
            boFoundUseItem := True;
          end;
        meiRedPoison:
          begin
            sItemName := MagicNeedItemNames[CustomMagicConfig.ServerConfig.NeedItem];
            nShape := 2;
            boFoundUseItem := _CheckAmulet(Self, nShape, CustomMagicConfig.ServerConfig.NeedItemCount, nAmuletIdx, True);
            if (not boFoundUseItem) and CustomMagicConfig.ServerConfig.NeedItemUseBagItem then
              boFoundUseItem := _CheckBagAmulet(Self, nShape, CustomMagicConfig.ServerConfig.NeedItemCount, nAmuletIdx, True);
          end;
        meiGreenPoison:
          begin
            sItemName := MagicNeedItemNames[CustomMagicConfig.ServerConfig.NeedItem];
            nShape := 1;
            boFoundUseItem := _CheckAmulet(Self, nShape, CustomMagicConfig.ServerConfig.NeedItemCount, nAmuletIdx, True);
            if (not boFoundUseItem) and CustomMagicConfig.ServerConfig.NeedItemUseBagItem then
              boFoundUseItem := _CheckBagAmulet(Self, nShape, CustomMagicConfig.ServerConfig.NeedItemCount, nAmuletIdx, True);
          end;
        meiFu:
          begin
            sItemName := MagicNeedItemNames[CustomMagicConfig.ServerConfig.NeedItem];
            nShape := 5;
            boFoundUseItem := _CheckAmulet(Self, nShape, CustomMagicConfig.ServerConfig.NeedItemCount, nAmuletIdx, True);
            if (not boFoundUseItem) and CustomMagicConfig.ServerConfig.NeedItemUseBagItem then
              boFoundUseItem := _CheckBagAmulet(Self, nShape, CustomMagicConfig.ServerConfig.NeedItemCount, nAmuletIdx, True);
          end;
        meiCustomItem:
          begin
            sItemName := CustomMagicConfig.ServerConfig.NeedItemCustomItemName;
            if Length(CustomMagicConfig.ServerConfig.NeedItemCustomItemName) = 0 then
              boFoundUseItem := True
            else
            begin
              for I := 0 to Length(m_UseItems) - 1 do
              begin
                UserItem := @m_UseItems[I];
                if UserItem.wIndex > 0 then
                begin
                  StdItem := UserEngine.GetStdItem(UserItem.wIndex);
                  if SameText(StdItem.Name, CustomMagicConfig.ServerConfig.NeedItemCustomItemName) and
                    (Round(UserItem.Dura / g_ClientConfig.nMagicItemRate) >= CustomMagicConfig.ServerConfig.NeedItemCount) then
                  begin
                    boFoundUseItem := True;
                    nAmuletIdx := I;
                    Break;
                  end;
                end;
              end;
              if (not boFoundUseItem) and CustomMagicConfig.ServerConfig.NeedItemUseBagItem then
              begin
                for I := 0 to m_ItemList.Count - 1 do
                begin
                  UserItem := m_ItemList.Items[I];
                  StdItem := UserEngine.GetStdItem(UserItem.wIndex);
                  if StdItem <> nil then
                  begin
                    if SameText(StdItem.Name, CustomMagicConfig.ServerConfig.NeedItemCustomItemName) and
                      (Round(UserItem.Dura / g_ClientConfig.nMagicItemRate) >= CustomMagicConfig.ServerConfig.NeedItemCount) then
                    begin
                      boFoundUseItem := True;
                      nAmuletIdx := I + Length(m_UseItems);
                      Break;
                    end;
                  end;
                end;
              end;
            end;
          end;
      end;
    end;
  end;
  if OnlyCheckItem then
  begin
    Result := boFoundUseItem;
    Exit;
  end;
  if boFoundUseItem then
  begin
    if CustomMagicConfig.ClientBaseConfig.MagicSwitchMode <> msmSwitch then
    begin
      UseInterval := GetMagicCD(MagicID); // CustomMagicConfig.ServerConfig.UseInterval * 1000; 2019-08-31 23:05:46
      if MyGetTickCount - m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID] >= UseInterval - 50 then
      begin
        m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID] := MyGetTickCount;
        m_boCustomSKill[MagicID - CUSTOM_MAGIC_START_ID] := True;
        if m_btRaceServer = RC_PLAYOBJECT then
        begin
          if Length(CustomMagicConfig.ServerConfig.SucceedMsg) > 0 then
          begin
            // SysMsg(CustomMagicConfig.ServerConfig.SucceedMsg, c_Green, t_Hint);
            SendMsg(Self, RM_MAGIC_HINT_MSG, 1, 0, 0, 0, CustomMagicConfig.ServerConfig.SucceedMsg);
          end;
        end;
        Result := True;
      end
      else if (m_btRaceServer = RC_PLAYOBJECT) then
      begin
        if Length(CustomMagicConfig.ServerConfig.FailMsg) > 0 then
        begin
          nTime := Round((GetMagicCD(MagicID) - (MyGetTickCount - m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID])) / 1000);
          if nTime = 0 then
            nTime := 1;
          s := StringReplace(CustomMagicConfig.ServerConfig.FailMsg, '%d', IntToStr(nTime), [rfIgnoreCase]);
          SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, s);
        end;
        if m_CustomSkill[MagicID - CUSTOM_MAGIC_START_ID] <> nil then // 处理报错 2020-09-18 09:24:16
        begin
          case m_CustomSkill[MagicID - CUSTOM_MAGIC_START_ID].btNewLevel of
            0:
              ClientConfig := @CustomMagicConfig.ClientConfigs[mplNone];
            1 .. 3:
              ClientConfig := @CustomMagicConfig.ClientConfigs[mpl1_3];
            4 .. 6:
              ClientConfig := @CustomMagicConfig.ClientConfigs[mpl4_6];
          else
            ClientConfig := @CustomMagicConfig.ClientConfigs[mpl7_9];
          end;
        end
        else
        begin
          ClientConfig := @CustomMagicConfig.ClientConfigs[mplNone];
        end;
        if Length(ClientConfig.Sounds[custMagicFail]) > 0 then
        begin
          SendMsg(Self, RM_PLAYSOUND, Integer(False), 0, 0, 0, 'Wav\' + ClientConfig.Sounds[custMagicFail]);
        end;
      end;
    end
    else
    begin
      if not m_boCustomSKill[MagicID - CUSTOM_MAGIC_START_ID] then
      begin
        // 修正自定义技能-开关技能不判断CD 2019-11-16 22:09:45
        UseInterval := GetMagicCD(MagicID);
        if MyGetTickCount - m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID] >= UseInterval - 50 then
        begin
          // 不能下面的搞法，学习新烈火，隔位刺杀，新开天，隔位不停的攻击，不停的打刺杀和开天
          // 新烈火一直请求，导致新开天被关了，然后一直新开天假象 2020-04-28 02:40:08
          // 开启自定义技能时，自动关闭前面所有的 chongchong 2017-01-15
          {
            for I := 0 to Length(m_boCustomSKill) - 1 do
            begin
            m_boCustomSKill[I] := (I = MagicID - CUSTOM_MAGIC_START_ID);
            end;
          }
          m_boCustomSKill[MagicID - CUSTOM_MAGIC_START_ID] := True;
          m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID] := MyGetTickCount; // 2020-04-28 02:40:08
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            if Length(CustomMagicConfig.ServerConfig.SucceedMsg) > 0 then
            begin
              // SysMsg(CustomMagicConfig.ServerConfig.SucceedMsg, c_Green, t_Hint);3
              SendMsg(Self, RM_MAGIC_HINT_MSG, 1, 0, 0, 0, CustomMagicConfig.ServerConfig.SucceedMsg);
            end;
            // TPlayObject(Self).SendSocket(nil, '+CUSSKILL_' + IntToStr(MagicID - CUSTOM_MAGIC_START_ID));
            TPlayObject(Self).SendOpenMagic(MagicID, True, 0);
          end;
        end
        else
        begin
          // 增加开关技能冷却时间未到时提示失败信息 2019-11-25 17:55:52
          if Length(CustomMagicConfig.ServerConfig.FailMsg) > 0 then
          begin
            nTime := Round((UseInterval - (MyGetTickCount - m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID])) / 1000);
            if nTime = 0 then
              nTime := 1;
            s := StringReplace(CustomMagicConfig.ServerConfig.FailMsg, '%d', IntToStr(nTime), [rfIgnoreCase]);
            SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, s);
          end
          // 未设置失败消息时，提示冷却时间 2020-05-12
          else
          begin
            n01 := Max(1, (UseInterval - (MyGetTickCount - m_CustomSkillUseTick[MagicID - CUSTOM_MAGIC_START_ID])) div 1000);
            s := StringReplace(sSkillCDHit, '%d', IntToStr(n01), []);
            SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, s);
          end;
        end;
        Result := False;
      end
      else
      begin
        m_boCustomSKill[MagicID - CUSTOM_MAGIC_START_ID] := False;
        if m_btRaceServer = RC_PLAYOBJECT then
        begin
          if Length(CustomMagicConfig.ServerConfig.CloseMsg) > 0 then
          begin
            // SysMsg(CustomMagicConfig.ServerConfig.CloseMsg, c_Red, t_Hint);
            SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, CustomMagicConfig.ServerConfig.CloseMsg);
          end;
          // TPlayObject(Self).SendSocket(nil, '+UCUSSKILL_' + IntToStr(MagicID - CUSTOM_MAGIC_START_ID));
          TPlayObject(Self).SendOpenMagic(MagicID, False, 0);
        end;
        Result := False;
      end;
    end;
    if Result and (CustomMagicConfig.ClientBaseConfig.MagicSwitchMode <> msmPowerHit) and (nAmuletIdx >= 0) then
    begin
      _UseAmulet(Self, CustomMagicConfig.ServerConfig.NeedItemCount, nAmuletIdx);
    end;
  end
  else
  begin
    if Length(sItemName) > 0 then
      SendScreenMsg('物品 [' + sItemName + '] 已经用完，请及时补充', 222, 0, 30, 360);
  end;
end;

