function TSmartObject.AttackTarget(wMagicID: Word; dwAttackTime: LongWord): Boolean;
begin
  Result := False;
  case m_btJob of
    0:
      begin
        if (m_TargetCret <> nil) and (tick_diff(m_dwHitTick, MyGetTickCount) > dwAttackTime) then
        begin
          m_dwHitTick := MyGetTickCount();
          if ActThink(wMagicID) then
          begin
            Result := True;
            Exit;
          end;
          if (m_TargetCret <> nil) and StartAttack(wMagicID) then
          begin
            if (wMagicID <= High(m_SkillUseTick)) then
            begin
              m_SkillUseTick[wMagicID] := MyGetTickCount;
            end;
          end;
        end;
      end;
    1:
      begin
        if (m_TargetCret <> nil) and (tick_diff(m_dwHitTick, MyGetTickCount) > dwAttackTime) then
        begin
          m_dwHitTick := MyGetTickCount();
          if ActThink(wMagicID) then
          begin
            Result := True;
            Exit;
          end;
          if (m_TargetCret <> nil) and StartAttack(wMagicID) then
          begin
            if (wMagicID <= High(m_SkillUseTick)) then
            begin
              m_SkillUseTick[wMagicID] := MyGetTickCount;
            end;
          end;
        end;
      end;
    2:
      begin
        if (m_TargetCret <> nil) and (tick_diff(m_dwHitTick, MyGetTickCount) > dwAttackTime) then
        begin
          m_dwHitTick := MyGetTickCount();
          // if (m_TargetCret.m_nCurrX - m_nCurrX) > g_Config.
          if ActThink(wMagicID) then
          begin
            Result := True;
            Exit;
          end;
          if (m_TargetCret <> nil) and StartAttack(wMagicID) then
          begin
            if (wMagicID <= High(m_SkillUseTick)) then
            begin
              m_SkillUseTick[wMagicID] := MyGetTickCount;
            end;
          end;
        end;
      end;
  end;
end;

procedure TSmartObject.Run;
var
  I, II, nValue, dwC: Integer;
  J: Integer;
  StdItem: pTStdItem;
  UserItem: pTUserItem;
  boRecalcAbilitys: Boolean;
  boResendAbilityNG: Boolean;
  boReSendSubAbility: Boolean;
  boSendAbilityAlcohol: Boolean;
  boSendActionMsg: Boolean;
  boNeedFeatureChanged: Boolean;
  nCount, dCount, bCount: Integer;
  Int64Value: Int64;
  ErrCode: Integer;
  Player: TPlayObject;
  boChecked, boUsed: Boolean;
  nTemp: Integer;
resourcestring
  sExceptionMsg0 = '[Exception] TSmartObject.Run 0';
  sExceptionMsg1 = '[Exception] TSmartObject.Run 1';
  sExceptionMsg2 = '[Exception] TSmartObject.Run 2';
  sExceptionMsg3 = '[Exception] TSmartObject.Run 3';
  sExceptionMsg4 = '[Exception] TSmartObject.Run 4';
  sExceptionMsg5 = '[Exception] TSmartObject.Run 5';
  sExceptionMsg6 = '[Exception] TSmartObject.Run 6';
  sExceptionMsg7 = '[Exception] TSmartObject.Run 7';
  sExceptionMsg8 = '[Exception] TSmartObject.Run 8';
  sExceptionMsg9 = '[Exception] TSmartObject.Run 9';
  sExceptionMsg10 = '[Exception] TSmartObject.Run 10';
begin
  if (m_dwChangeModeExTick[0] > 0) then
  begin
    m_WAbil.HP := m_WAbil.MaxHP;
    m_WAbil.MP := m_WAbil.MaxMP;
  end;
  boRecalcAbilitys := False;
  boReSendSubAbility := False;

  if (m_boSelfAutoDropItemToBag or m_boSlaveAutoDropItemToBag) // 角色打怪爆出物品直接入包
    and (m_boAutoDropItemToBagTime > 0) //
    and (g_nKey_UseClientPickItems <> 0) //
    and (tick_diff(m_boAutoDropItemToBagStartTick, MyGetTickCount) >= m_boAutoDropItemToBagTime) then
  begin
    m_boSelfAutoDropItemToBag := False;
    m_boSlaveAutoDropItemToBag := False;
    SysMsg(g_sAutoDropItemToBagClose, c_Green, t_Hint);
  end;

  if (m_boSelfAutoPickItem or m_boSlaveAutoPickItem) // 角色打怪爆出物品自动捡取
    and (m_boAutoPickItemTime > 0) //
    and (g_nKey_UseClientPickItems <> 0) //
    and (tick_diff(m_boAutoPickItemStartTick, MyGetTickCount) >= m_boAutoPickItemTime) then
  begin
    m_boSelfAutoPickItem := False;
    m_boSlaveAutoPickItem := False;
    SysMsg(g_sAutoPickItemClose, c_Green, t_Hint);
  end;

  ErrCode := 0;
  if not m_boDeath then
  begin
    try
      ErrCode := 1;
      // 当前地图魔血石、气血石、幻魔石无效 piaoyun 2013-09-05
      // 被秒杀后不要回血 chongchong 2016-05-31
      if (m_WAbil.HP > 0) //
        and (m_UseItems[U_CHARM].wIndex > 0) //
        and (m_UseItems[U_CHARM].Dura > 0) //
        and (not m_PEnvir.m_boNotStone { 地图参数 } ) then
      begin
        ErrCode := 2;
        StdItem := UserEngine.GetStdItem(m_UseItems[U_CHARM].wIndex);
        ErrCode := 3;
        if (StdItem <> nil) { and (StdItem.StdMode = 7) and (StdItem.Shape > 0) } then
        begin
          // 53类宝石完成气血石功能 piaoyun 2013-08-26
          ErrCode := 4;
          if ((StdItem.StdMode = 7) and (StdItem.Shape = 1)) { 气血石 }
            or ((StdItem.StdMode = 53) and (StdItem.Anicount = 1)) { 53类石头 } then // 气血石 piaoyun 2013-07-17
          begin
            ErrCode := 5;
            if g_Config.nHPRockType in [0, 3, 4] then
              boChecked := Round(m_WAbil.HP / m_WAbil.MaxHP * 100) <= g_Config.nHPRockRate
            else
              boChecked := (m_WAbil.MaxHP - m_WAbil.HP) >= g_Config.nHPRockRate;

            if boChecked //
              and ((m_nIncHealth = 0) or (not(g_Config.nHPRockAddType in [0, 3]))) //
              and (m_UseItems[U_CHARM].wIndex > 0) //
              and ((MyGetTickCount - m_dwHPRockTick) >= g_Config.nHPRockTime) then
            begin
              m_dwHPRockTick := MyGetTickCount;
              ErrCode := 6;
              if g_Config.nHPRockAddType = 0 then
              begin
                ErrCode := 7;
                nCount := Min(Int64(m_UseItems[U_CHARM].Dura) * g_Config.nHMPDivDura, High(Integer));
                bCount := Trunc(nCount / g_Config.nHPRockAddValue);
                dCount := m_WAbil.MaxHP - m_WAbil.HP;
                if dCount > bCount then
                  dCount := bCount;

                if nCount > dCount then
                begin
                  Int64Value := Int64(m_nIncHealth) + dCount;
                  if Int64Value > High(LongWord) then
                    Int64Value := High(LongWord);
                  m_nIncHealth := Int64Value;
                end;
              end
              else if g_Config.nHPRockAddType = 1 then
              begin
                ErrCode := 8;
                Int64Value := Int64(m_WAbil.HP) + g_Config.nHPRockAddValue;
                if Int64Value < m_WAbil.MaxHP then
                  m_WAbil.HP := Int64Value
                else
                  m_WAbil.HP := m_WAbil.MaxHP;
              end
              else if g_Config.nHPRockAddType = 2 then
              begin
                ErrCode := 8;
                Int64Value := Int64(m_WAbil.HP) + Round(m_WAbil.MaxHP / 100 * g_Config.nHPRockAddValue);
                if Int64Value < m_WAbil.MaxHP then
                  m_WAbil.HP := Int64Value
                else
                  m_WAbil.HP := m_WAbil.MaxHP;
              end
              else if g_Config.nHPRockAddType = 3 then
              begin
                ErrCode := 801;
                nCount := Min(Int64(m_UseItems[U_CHARM].DuraMax) * g_Config.nHMPDivDura, High(Integer));
                bCount := Trunc(nCount / g_Config.nHPRockAddValue);
                dCount := m_WAbil.MaxHP - m_WAbil.HP;
                if dCount > bCount then
                  dCount := bCount;
                if nCount > dCount then
                begin
                  Int64Value := Int64(m_nIncHealth) + dCount;
                  if Int64Value > High(LongWord) then
                    Int64Value := High(LongWord);
                  m_nIncHealth := Int64Value;
                end;
              end
              else if g_Config.nHPRockAddType = 4 then
              begin
                ErrCode := 802;
                nCount := Min(Int64(m_UseItems[U_CHARM].DuraMax) * g_Config.nHMPDivDura, High(Integer));
                bCount := Trunc(nCount / g_Config.nHPRockAddValue);
                Int64Value := Int64(m_WAbil.HP) + bCount;
                if Int64Value < m_WAbil.MaxHP then
                  m_WAbil.HP := Int64Value
                else
                  m_WAbil.HP := m_WAbil.MaxHP;
              end;
              ErrCode := 9;
              if m_UseItems[U_CHARM].Dura >= g_Config.nHPRockDecValue then
                Dec(m_UseItems[U_CHARM].Dura, g_Config.nHPRockDecValue)
              else
                m_UseItems[U_CHARM].Dura := 0;

              ErrCode := 10;
              // 持久小于0立即删除此物品-防止外挂利用 -- piaoyun 2013-07-17
              if m_UseItems[U_CHARM].Dura <= 0 then
              begin
                ErrCode := 11;
                // 53类宝石不受此限制 piaoyun 2013-08-26
                if not((StdItem.StdMode = 53) and (StdItem.Anicount = 1)) then
                begin
                  if StdItem.NeedIdentify = 1 then
                  begin
                    AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[U_CHARM].MakeIndex, '0', 0,
                      0, '持久为0');
                  end;

                  ErrCode := 12;
                  if m_btRaceServer = RC_PLAYOBJECT then
                  begin
                    ErrCode := 13;
                    TPlayObject(Self).SendDelItem(@m_UseItems[U_CHARM]);
                  end
                  else if m_btRaceServer = RC_HEROOBJECT then
                  begin
                    ErrCode := 14;
                    THeroObject(Self).SendDelItem(@m_UseItems[U_CHARM]);
                  end;
                  ErrCode := 15;
                  m_UseItems[U_CHARM].wIndex := 0;
                end
                else
                begin
                  ErrCode := 16;
                  for J := 1 to 5 do
                  begin
                    SysMsg(Format('[%s]属性失效，请使用对应宝石补充持久', [StdItem.Name]), g_Config.btRedMsgFColor,
                      g_Config.btRedMsgBColor, t_Hint);
                  end;
                end;
                ErrCode := 17;
                boRecalcAbilitys := True;
                boReSendSubAbility := True;
              end;

              ErrCode := 19;
              if (m_btRaceServer = RC_PLAYOBJECT) and (not m_boDummyObject) then
              begin
                ErrCode := 20;
                TPlayObject(Self).SendMsg(Self, RM_DURACHANGE, U_CHARM, m_UseItems[U_CHARM].Dura,
                  m_UseItems[U_CHARM].DuraMax, 0, '');
              end
              else if m_btRaceServer = RC_HEROOBJECT then
              begin
                ErrCode := 21;
                THeroObject(Self).SendMsg(Self, RM_DURACHANGE, U_CHARM, m_UseItems[U_CHARM].Dura,
                  m_UseItems[U_CHARM].DuraMax, 0, '');
              end;
              ErrCode := 22;
              HPMPChangedFormStone;
            end;
          end
          else if ((StdItem.StdMode = 7) and (StdItem.Shape = 2)) { 幻魔石 }
            or ((StdItem.StdMode = 53) and (StdItem.Anicount = 2)) { 53类石头 } then
          begin
            if g_Config.nMPRockType in [0, 3, 4] then
              boChecked := Round(m_WAbil.MP / m_WAbil.MaxMP * 100) <= g_Config.nMPRockRate
            else
              boChecked := (m_WAbil.MaxMP - m_WAbil.MP) >= g_Config.nMPRockRate;

            ErrCode := 23;
            if boChecked //
              and ((m_nIncSpell = 0) or (not(g_Config.nMPRockAddType in [0, 3]))) //
              and (m_UseItems[U_CHARM].wIndex > 0) //
              and (MyGetTickCount - m_dwMPRockTick >= g_Config.nMPRockTime) then
            begin
              m_dwMPRockTick := MyGetTickCount;
              ErrCode := 24;
              if (g_Config.nMPRockAddType = 0) then
              begin
                ErrCode := 25;
                nCount := Min(Int64(m_UseItems[U_CHARM].Dura) * g_Config.nHMPDivDura, High(Integer));
                bCount := Trunc(nCount / g_Config.nMPRockAddValue);
                dCount := m_WAbil.MaxMP - m_WAbil.MP;
                if dCount > bCount then
                  dCount := bCount;
                if nCount > dCount then
                  Inc(m_nIncSpell, dCount)
                else
                  Inc(m_nIncSpell, 0);
              end
              else if (g_Config.nMPRockAddType = 1) then
              begin
                ErrCode := 26;
                Int64Value := Int64(m_WAbil.MP) + g_Config.nMPRockAddValue;
                if Int64Value < m_WAbil.MaxMP then
                  m_WAbil.MP := Int64Value
                else
                  m_WAbil.MP := m_WAbil.MaxMP;
              end
              else if (g_Config.nMPRockAddType = 2) then
              begin
                ErrCode := 8;
                Int64Value := Int64(m_WAbil.MP) + Round(m_WAbil.MaxMP / 100 * g_Config.nMPRockAddValue);
                if Int64Value < m_WAbil.MaxMP then
                  m_WAbil.MP := Int64Value
                else
                  m_WAbil.MP := m_WAbil.MaxMP;
              end
              else if (g_Config.nMPRockAddType = 3) then
              begin
                ErrCode := 2501;
                nCount := Min(Int64(m_UseItems[U_CHARM].DuraMax) * g_Config.nHMPDivDura, High(Integer));
                bCount := Trunc(nCount / g_Config.nMPRockAddValue);
                dCount := m_WAbil.MaxMP - m_WAbil.MP;
                if dCount > bCount then
                  dCount := bCount;
                if nCount > dCount then
                  Inc(m_nIncSpell, dCount)
                else
                  Inc(m_nIncSpell, 0);
              end
              else if (g_Config.nMPRockAddType = 4) then
              begin
                ErrCode := 2502;
                nCount := Min(Int64(m_UseItems[U_CHARM].DuraMax) * g_Config.nHMPDivDura, High(Integer));
                bCount := Trunc(nCount / g_Config.nHPRockAddValue);
                Int64Value := Int64(m_WAbil.MP) + bCount;
                if Int64Value < m_WAbil.MaxMP then
                  m_WAbil.MP := Int64Value
                else
                  m_WAbil.MP := m_WAbil.MaxMP;
              end;
              ErrCode := 27;
              if m_UseItems[U_CHARM].Dura >= g_Config.nMPRockDecValue then
                Dec(m_UseItems[U_CHARM].Dura, g_Config.nMPRockDecValue)
              else
                m_UseItems[U_CHARM].Dura := 0;
              ErrCode := 28;
              // 持久小于0立即删除此物品-防止外挂利用 -- piaoyun 2013-07-17
              if m_UseItems[U_CHARM].Dura <= 0 then
              begin
                ErrCode := 29;
                // 53类宝石不受此限制 piaoyun 2013-08-26
                if not((StdItem.StdMode = 53) and (StdItem.Anicount = 2)) then
                begin
                  if StdItem.NeedIdentify = 1 then
                  begin
                    AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, m_UseItems[U_CHARM].MakeIndex, '0', 0,
                      0, '持久为0');
                  end;
                  // 优化假人处理 [+ and (not m_boDummyObject)] chongchong 2013-11-17
                  if (m_btRaceServer = RC_PLAYOBJECT) and (not m_boDummyObject) then
                  begin
                    ErrCode := 31;
                    TPlayObject(Self).SendDelItem(@m_UseItems[U_CHARM]);
                  end
                  else if m_btRaceServer = RC_HEROOBJECT then
                  begin
                    ErrCode := 32;
                    THeroObject(Self).SendDelItem(@m_UseItems[U_CHARM]);
                  end;
                  ErrCode := 33;
