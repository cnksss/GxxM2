  GroupFldValue: array [0 .. 40 - 1] of Integer;
  UseFashionItem: Boolean;
  AllAddAbility: TAddAbility;
  NewExtType: TAddNewExtType;
  Level9Power: Double;
  Rate: Double;
begin
  try
    Abil := m_WAbil;
    m_WAbil := m_Abil;
    m_WAbil.HP := Abil.HP;
    m_WAbil.MP := Abil.MP;
    m_WAbil.CreditPoint := Abil.CreditPoint;
    m_WAbil.Weight := 0;
    m_WAbil.WearWeight := 0;
    m_WAbil.HandWeight := 0;

    m_btAntiPoison := 0;
    m_nPoisonRecover := 0;
    m_nHealthRecover := 0;
    m_nSpellRecover := 0;
    m_nAntiMagic := 1;
    m_nHitSpeed := 0;
    m_nLuck := 0;
    boOldHideMode := m_boHideMode;
    m_boHideMode := False;
    boMoXieSuite1 := False;
    boMoXieSuite2 := False;
    boMoXieSuite3 := False;
    boHongMoSuite1 := False;
    boHongMoSuite2 := False;
    boHongMoSuite3 := False;
    boSpirit1 := False;
    boSpirit2 := False;
    boSpirit3 := False;
    boSpirit4 := False;
    boRecallSuite1 := False;
    boRecallSuite2 := False;
    boRecallSuite3 := False;
    boRecallSuite4 := False;
    SmartObject := nil;

    if g_Config.btMaxAC = 0 then
      nMaxAC := High(Word)
    else
      nMaxAC := High(Integer);

    m_boParalysis := False; // 麻痹戒指(Byte)
    m_dwParalysisRate := g_Config.nAttackPosionRate; // 麻痹机率
    m_dwParalysisTime := g_Config.nAttackPosionTime; // 麻痹时间
    m_btFluteStoneParalysisRate := 0; // 镶嵌宝石麻痹几率
    m_btFluteStoneMDParalysisRate := 0; // 镶嵌宝石魔道麻痹几率
    m_btFluteStoneRevivalRate := 0; // 镶嵌宝石复活几率
    m_btFluteStoneFrozenRate := 0; // 镶嵌宝石冰冻几率
    m_btFluteStoneWindingRate := 0; // 镶嵌宝石蛛网几率
    m_btFluteStoneMagicShieldRate := 0; // 镶嵌宝石护身几率

    m_boMDParalysis := False; // 魔道麻痹戒指 chongchong 2013-11-20
    m_dwMDParalysisRate := g_Config.dwMDParalysisRate;
    m_dwMDParalysisTime := g_Config.dwMDParalysisTime;

    m_boFrozen := False; // 冰冻戒指 chongchong 2013-11-20
    m_dwFrozenRate := g_Config.dwFrozenRate;
    m_dwFrozenTime := g_Config.dwFrozenTime;

    m_boCobwebWinding := False; // 蜘蛛网戒指 chongchong 2013-11-20
    m_dwCobwebWindingRate := g_Config.dwCobwebWindingRate;
    m_dwCobwebWindingTime := g_Config.dwCobwebWindingTime;

    // 当宝宝创建时 处理防诱惑数据 -- piaoyun 2013-07-17
    FillChar(m_WAbil.NewValue, SizeOf(m_WAbil.NewValue), 0);
    if m_Master <> nil then
      m_WAbil.NewValue[17] := m_Master.m_WAbil.NewValue[17];

    m_nUnForeverFrozenRate := 0;
    FillChar(AllAddAbility, SizeOf(TAddAbility), 0);

    if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    begin
      SmartObject := TSmartObject(Self);

      FillChar(SmartObject.m_AddAbil, SizeOf(TAddAbility), 0);
      SmartObject.m_nNPRecoverTime := 0; // 增加内力恢复速度 %
      SmartObject.m_nNPRecoverPoint := 0; // 内力恢复速度加几点
      SmartObject.m_boMysteriousMan := False; // 神秘人
      SmartObject.m_TeleportUserItem := nil; // 传送符
      SmartObject.m_boTeleport := False; // 传送戒指(Byte)
      SmartObject.m_boRevival := False; // 复活戒指(Byte)
      SmartObject.m_boFlameRing := False; // 火焰戒指(Byte)
      SmartObject.m_boRecoveryRing := False; // 治愈戒指(Byte)
      SmartObject.m_boAngryRing := False; // 未知戒指(Byte)
      SmartObject.m_boMagicShield := False; // 护身戒指(Byte)
      SmartObject.m_boMuscleRing := False; // 活力戒指(Byte)
      SmartObject.m_boFastTrain := False; // 技巧项链(Byte)
      SmartObject.m_boProbeNecklace := False; // 探测项链(Byte)
      SmartObject.m_boSupermanItem := False; // 不死戒指
      SmartObject.m_boGuildMove := False; // 行会传送
      SmartObject.m_boStarRing := False; // 流星戒指
      SmartObject.m_boSkill114AniCount := False; // 倚天辟地技能 叠加到某某物品上，如武器

      // 套装规则修改：套装多倍属性默认值 add chongchong 2013-07-27
      SmartObject.m_SuiteExpMultiple := 0;
      SmartObject.m_bopirit := False; // 祈祷
      SmartObject.m_btHorseType := 0;
      SmartObject.m_wDressEffType := 0;
      SmartObject.m_wDressEffType_30 := 0;
      SmartObject.m_boDressEffType_30NormalDraw := False;
      SmartObject.m_boDressEffType_30NoSex := False;
      SmartObject.m_boExpItem := False;
      SmartObject.m_boPowerItem := False;
      SmartObject.m_rExpItem := 0;
      SmartObject.m_rPowerItem := 0;
      SmartObject.m_nHorseHumEffType := 0;
      SmartObject.m_boACItem := False;; // 防御物品 chongchong 2013-09-14
      SmartObject.m_boMACItem := False; // 魔御物品 chongchong 2013-09-14
      SmartObject.m_rACItem := 0; // 防御值 chongchong 2013-09-14
      SmartObject.m_rMACItem := 0; // 魔御值 chongchong 2013-09-14
      SmartObject.m_nMoXieSuite := 0;
      SmartObject.m_nHongMoSuite := 0;
      SmartObject.m_boRecallSuite := False;
      SmartObject.m_boNoDropItem := False;
      SmartObject.m_boNoDropUseItem := False;
      SmartObject.m_dwPKDieLostExp := 0;
      SmartObject.m_nPKDieLostLevel := 0;
      SmartObject.m_nRevivalTime := g_Config.dwRevivalTime;
      SmartObject.m_nMagicShield := 150;
      SmartObject.m_nMagicShieldAbsorbDamage := 0;
      SmartObject.m_nRevivalMaxHP := 100;
      FillChar(SmartObject.m_DefenseSkillPercent, SizeOf(SmartObject.m_DefenseSkillPercent), 0); // 增加技能防御百分百
      FillChar(SmartObject.m_AttackSkillPercent, SizeOf(SmartObject.m_AttackSkillPercent), 0); // 增加技能攻击百分百

      // 毒素武器
      SmartObject.m_boPoisonWeapon := False;
      SmartObject.m_nPoisonWeaponRate := 0;
      SmartObject.m_nPoisonWeaponDamageHealth := 0;
      SmartObject.m_nPoisonWeaponBaseTime := 0;
      SmartObject.m_nPoisonWeaponRandomTime := 0;

      // 内功减攻击伤害 chongchong 2015-05-17
      SmartObject.m_AddNGDamage := 0;
      SmartObject.m_DecNGDamage := 0;
    end;

    // 宝宝属性叠加
    if (not(m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT])) and (m_Master <> nil) and m_boAddMasterAttrToSelf then
    begin
      FillChar(m_nBBAttrPlusValues, SizeOf(m_nBBAttrPlusValues), 0);

      // 宝宝属性叠加 2019-07-06 18:27:27
      if g_Config.boBBAttrPlusAddAttack and (g_Config.nBBAttrPlusAddAttackRate > 0) then
      begin
        // +攻击下限
        if g_Config.nBBAttrPlusAddAttackForm = 0 then
        begin
          if m_Master.m_btJob = 0 then
            NewValue := m_Master.m_WAbil.DC1
          else if m_Master.m_btJob = 1 then
            NewValue := m_Master.m_WAbil.MC1
          else
            NewValue := m_Master.m_WAbil.SC1
        end
        else if g_Config.nBBAttrPlusAddAttackForm = 1 then
          NewValue := m_Master.m_WAbil.DC1
        else if g_Config.nBBAttrPlusAddAttackForm = 2 then
          NewValue := m_Master.m_WAbil.MC1
        else
          NewValue := m_Master.m_WAbil.SC1;

        m_nBBAttrPlusValues[0][0] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddAttackRate);

        // +攻击上限
        if g_Config.nBBAttrPlusAddAttackForm = 0 then
        begin
          if m_Master.m_btJob = 0 then
            NewValue := m_Master.m_WAbil.DC2
          else if m_Master.m_btJob = 1 then
            NewValue := m_Master.m_WAbil.MC2
          else
            NewValue := m_Master.m_WAbil.SC2
        end
        else if g_Config.nBBAttrPlusAddAttackForm = 1 then
          NewValue := m_Master.m_WAbil.DC2
        else if g_Config.nBBAttrPlusAddAttackForm = 2 then
          NewValue := m_Master.m_WAbil.MC2
        else
          NewValue := m_Master.m_WAbil.SC2;

        m_nBBAttrPlusValues[0][1] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddAttackRate);
      end;

      if g_Config.nBBAttrPlusAddDefenceRate > 0 then
      begin
        if g_Config.boBBAttrPlusAddDefence then
        begin
          NewValue := m_Master.m_WAbil.AC1;
          m_nBBAttrPlusValues[1][0] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddDefenceRate);
          NewValue := m_Master.m_WAbil.AC2;
          m_nBBAttrPlusValues[1][1] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddDefenceRate);
        end;

        if g_Config.boBBAttrPlusAddMagicDefence then
        begin
          NewValue := m_Master.m_WAbil.MAC1;
          m_nBBAttrPlusValues[2][0] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddDefenceRate);
          NewValue := m_Master.m_WAbil.MAC2;
          m_nBBAttrPlusValues[2][1] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddDefenceRate);
        end;
      end;

      if g_Config.boBBAttrPlusAddHP and (g_Config.nBBAttrPlusAddHPRate > 0) then
      begin
        NewValue := m_Master.m_WAbil.MaxHP;
        m_nBBAttrPlusValues[3][0] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddHPRate);
      end;

      if m_boMakeSelfMagicNewLevel > 0 then
      begin
        if m_boMakeSelfMagicNewLevel <= 9 then
        begin
          NewValue := g_Config.nBBAttrPlusNewLevelRates[m_boMakeSelfMagicNewLevel - 1];
          for I := Low(m_nBBAttrPlusValues) to High(m_nBBAttrPlusValues) do
          begin
            m_nBBAttrPlusValues[I][0] := Round(m_nBBAttrPlusValues[I][0] / 100 * NewValue);
            m_nBBAttrPlusValues[I][1] := Round(m_nBBAttrPlusValues[I][1] / 100 * NewValue);
          end;
        end
        else
        begin
          NewValue := g_Config.nBBAttrPlusNewLevelRates[8];
          for I := Low(m_nBBAttrPlusValues) to High(m_nBBAttrPlusValues) do
          begin
            m_nBBAttrPlusValues[I][0] := Round(m_nBBAttrPlusValues[I][0] / 100 * NewValue);
            m_nBBAttrPlusValues[I][1] := Round(m_nBBAttrPlusValues[I][1] / 100 * NewValue);
          end;
        end;
      end;
    end;

    if g_Config.btMaxLevel = 0 then
      nMaxValue := MAXUPLEVEL
    else if g_Config.btMaxLevel = 1 then
      nMaxValue := High(Integer)
    else
      nMaxValue := High(LongWord);

    if (g_PluginManager <> nil) then
      g_PluginManager.HookBaseObjectRecalAbilBegin(Self);

    if SmartObject <> nil then
    begin
      for I := Low(THumanUseItems) to High(THumanUseItems) do
      begin
        UserItem := @SmartObject.m_UseItems[I];
        // 未勾选功能设置 -> 其他控制 -> 其他控制1 -> 持久为0时消失
        // 当持久为0的物品不要计算属性了 chongchong 2016-08-03
        if UserItem.Dura <= 0 then
          Continue;

        if (I = U_DRESS) then
        begin
          if (SmartObject.m_wHeroM2DressEffect > 0) and
            ((SmartObject.m_UseItems[I].wIndex <= 0) or (UserItem.dwHeroM2DressEffect = 0)) then
          begin
            SmartObject.m_wHeroM2DressEffect := 0;
            SmartObject.m_nHeroM2DressEffect := 0;
            SmartObject.SendRefMsg(RM_HEROM2SENDDRESSEFFECT, 0, SmartObject.m_wHeroM2DressEffect, 0, 0, '');
          end
          else if (UserItem.wIndex > 0) and (UserItem.dwHeroM2DressEffect > 0) and
            (SmartObject.m_wHeroM2DressEffect <> UserItem.dwHeroM2DressEffect) then
          begin
            SmartObject.m_wHeroM2DressEffect := UserItem.dwHeroM2DressEffect;
            SmartObject.m_nHeroM2DressEffect := SmartObject.m_UseItems[I].wIndex;
            SmartObject.SendRefMsg(RM_HEROM2SENDDRESSEFFECT, 0, SmartObject.m_wHeroM2DressEffect, 0, 0, '');
          end;
        end;

        if (UserItem.wIndex <= 0) or (UserItem.Dura <= 0) then
          Continue;

        if (not g_Config.boFashionJewelryOpen) and
          (I in [U_FASHIONNECKLACE, U_FASHIONHELMET, U_FASHIONARMRINGL, U_FASHIONARMRINGR, U_FASHIONRINGL, U_FASHIONRINGR]) then
          Continue;

        SmartObject.GetAccessory(SmartObject.m_UseItems[I], SmartObject.m_AddAbil, AllAddAbility);
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);

        if StdItem = nil then
          Continue;

        // 启用新属性时才计算新属性值  chongchong 2015-01-10
        if g_Config.boItemNewAbilAllowUse then
        begin
          for II := 0 to Length(m_WAbil.NewValue) - 1 do
          begin
            // 攻击伤害、体力增加、魔法增加、合击伤害、致命一击伤害增加 chongchong 2015-06-30
            if II in [1, 7, 8, 10, 22] then
            begin
              Int64Value := Int64(m_WAbil.NewValue[II]) + UserItem.btNewValue[II] + StdItem.Elements[II];
              m_WAbil.NewValue[II] := Min(Int64Value, High(LongWord))
            end
            else
            begin
              Int64Value := Int64(m_WAbil.NewValue[II]) + UserItem.btNewValue[II] + StdItem.Elements[II];
              m_WAbil.NewValue[II] := Min(Int64Value, 100);
            end;
          end;
        end;

        // 装备凹槽 chongchong 2015-01-03
        AddAbiltysByUseItemFlute(SmartObject, UserItem, nMaxValue);

        // 元素属性命令支持有效时间 chongchong 2013-12-26
        if SmartObject.m_dwNPCAddNewMakeIndex[I] = UserItem.MakeIndex then
        begin
          for II := 0 to Length(m_WAbil.NewValue) - 1 do
          begin
            if (SmartObject.m_btNPCAddNewValue[I][II] > 0) and (SmartObject.m_dwNPCAddNewTick[I][II] >= MyGetTickCount) then
            begin
              // 攻击伤害、体力增加、魔法增加、合击伤害、致命一击伤害增加 chongchong 2015-06-30
              if II in [1, 7, 8, 10, 22] then
              begin
                Int64Value := Int64(m_WAbil.NewValue[II]) + SmartObject.m_btNPCAddNewValue[I][II];
                m_WAbil.NewValue[II] := Min(Int64Value, High(LongWord))
              end
              else
              begin
                Int64Value := Int64(m_WAbil.NewValue[II]) + SmartObject.m_btNPCAddNewValue[I][II];
                m_WAbil.NewValue[II] := Min(Int64Value, 100);
              end;
            end;
          end;
        end;

        // 装备技能威力最大为100 ????????
        SkillPowerItem := GetSkillPowerItem(StdItem.Name);
        if SkillPowerItem <> nil then
        begin
          for II := 1 to High(SkillPowerItem.AttackSkillPercent) do
          begin
            Int64Value := Int64(SmartObject.m_AttackSkillPercent[II]) + SkillPowerItem.AttackSkillPercent[II];
            SmartObject.m_AttackSkillPercent[II] := Min(Int64Value, 100);
            Int64Value := Int64(SmartObject.m_DefenseSkillPercent[II]) + SkillPowerItem.DefenseSkillPercent[II];
            SmartObject.m_DefenseSkillPercent[II] := Min(Int64Value, 100);
          end;
        end;

        // 武器 时装武器 盾牌 计算腕力 chongchong 2013-11-18
        if (I = U_WEAPON) or (I = U_RIGHTHAND) or (I = U_DRESS) or (I = U_FASHIONDRESS) or (I = U_FASHIONWEAPON) then
        begin
          if (I = U_WEAPON) or (I = U_FASHIONWEAPON) then
          begin
            Int64Value := Int64(m_WAbil.HandWeight) + StdItem.Weight;
            m_WAbil.HandWeight := Min(High(Word), Int64Value)
          end
          else
          begin
            Int64Value := Int64(m_WAbil.WearWeight) + StdItem.Weight;
            m_WAbil.WearWeight := Min(High(Word), Int64Value);
          end;

          if (I = U_WEAPON) or (I = U_FASHIONWEAPON) then
          begin // 毒素武器
            PoisonWeapon := GetPoisonWeapon(StdItem.Name);
            if PoisonWeapon <> nil then
            begin
              // 毒素武器
              SmartObject.m_boPoisonWeapon := True;
              SmartObject.m_nPoisonWeaponRate := PoisonWeapon.nRate;
              SmartObject.m_nPoisonWeaponDamageHealth := PoisonWeapon.nDamageHealth;
              SmartObject.m_nPoisonWeaponBaseTime := PoisonWeapon.nBaseTime;
              SmartObject.m_nPoisonWeaponRandomTime := PoisonWeapon.nRandomTime;
            end;
          end;

          // 新增属性开始 ------------------------------------------------------
          AddAbilitysByCode(False, SmartObject, StdItem, @SmartObject.m_UseItems[I]);

          // 吸血武器判断 piaoyun 2013-07-24
          if StdItem.StdMode in [5, 6] then
          begin
            if StdItem.Anicount = 138 then
            begin
              if g_Config.boHongMoSuiteWithPower then
                Inc(SmartObject.m_nHongMoSuite, Round(g_Config.nHongMoSuiteRateChange / 100 * StdItem.Weight))
              else
                Inc(SmartObject.m_nHongMoSuite, StdItem.Weight);
            end;
          end;
          // 新增属性结束 ------------------------------------------------------
        end
        else
        begin
          // 武器 时装武器 盾牌 计算腕力 chongchong 2013-11-18
          if I in [U_SHIELD] then
          begin
            Int64Value := Int64(m_WAbil.HandWeight) + StdItem.Weight;
            m_WAbil.HandWeight := Min(High(Word), Int64Value);
          end
          else
          begin
            Int64Value := Int64(m_WAbil.WearWeight) + StdItem.Weight;
            m_WAbil.WearWeight := Min(High(Word), Int64Value);
          end
        end;
        Int64Value := Int64(m_WAbil.Weight) + StdItem.Weight;
        m_WAbil.Weight := Min(High(Word), Int64Value);

        if (I = U_WEAPON) or (I = U_FASHIONWEAPON) then
        begin
          if (StdItem.Source - 1 - 10) < 0 then
            SmartObject.m_AddAbil.btWeaponStrong := StdItem.Source; // 强度+

          if (StdItem.Source <= -1) and (StdItem.Source >= -50) then // -1 至 -50
            SmartObject.m_AddAbil.bt1DF := SmartObject.m_AddAbil.bt1DF + -StdItem.Source; // 神圣+

          if (StdItem.Source <= -51) and (StdItem.Source >= -100) then // -51 至 - 100
            SmartObject.m_AddAbil.bt1DF := SmartObject.m_AddAbil.bt1DF + (StdItem.Source + 50); // 神圣-
          Continue;
        end
        else if (I in [U_DRESS, U_FASHIONDRESS]) then
        begin
          if SmartObject.m_UseItems[I].btValue[5] > 0 then
            SmartObject.m_wDressEffType := SmartObject.m_UseItems[I].btValue[5];
          // if StdItem.AniCount > 0 then
          begin
            if I = U_FASHIONDRESS then
            begin
              if SmartObject.m_btRaceServer = RC_HEROOBJECT then
              begin
                if SmartObject.m_boShowFashion and (not g_Config.boHeroHideTabSheet2) then
                begin
                  SmartObject.m_wDressEffType := StdItem.Anicount;
                  SmartObject.m_nHorseHumEffType := StdItem.Horse;
                end;
              end
              else
              begin
                if SmartObject.m_boShowFashion and (not g_Config.boHideTabSheet2) then
                begin
                  SmartObject.m_wDressEffType := StdItem.Anicount;
                  SmartObject.m_nHorseHumEffType := StdItem.Horse;
                end;
              end;
            end
            else
            begin
              UseFashionItem := (SmartObject.m_UseItems[U_FASHIONDRESS].wIndex > 0) or
                (SmartObject.m_UseItems[U_FASHIONWEAPON].wIndex > 0);
              if g_Config.boShowNormalFashion and UseFashionItem then
              begin
                if SmartObject.m_btRaceServer = RC_HEROOBJECT then
                begin
                  if not(SmartObject.m_boShowFashion and (not g_Config.boHeroHideTabSheet2)) then
                  begin
                    SmartObject.m_wDressEffType := StdItem.Anicount;
                    SmartObject.m_nHorseHumEffType := StdItem.Horse;
                  end;
                end
                else
                begin
                  if not(SmartObject.m_boShowFashion and (not g_Config.boHideTabSheet2)) then
                  begin
                    SmartObject.m_wDressEffType := StdItem.Anicount;
                    SmartObject.m_nHorseHumEffType := StdItem.Horse;
                  end;
                end;
              end
              else
              begin
                SmartObject.m_wDressEffType := StdItem.Anicount;
                SmartObject.m_nHorseHumEffType := StdItem.Horse;
              end;
            end;
          end;
          Continue;
        end
        else if I = U_RIGHTHAND then
        begin
          {
            if StdItem.Shape in [1..50] then
            SmartObject.m_wDressEffType := StdItem.Shape;
          }
          if StdItem.StdMode in [29 { 天使翅膀 } , 30] then
          begin
            SmartObject.m_wDressEffType_30 := StdItem.Shape;
            SmartObject.m_boDressEffType_30NormalDraw := StdItem.Horse and 1 <> 0;
            SmartObject.m_boDressEffType_30NoSex := StdItem.Horse and 2 <> 0;
          end;

          // 骑马 在合击界面时，马牌放在蜡烛的位置  chongchong 2013-10-12
          if StdItem.StdMode = 28 then
            SmartObject.m_btHorseType := StdItem.Horse;
          Continue;
        end

        // 增加62、63、64类装备加负重属性 chongchong 2014-12-31
        else if I in [U_BELT { 腰带 } , U_BOOTS { 鞋 } , U_CHARM { 宝石 } ] then
        begin
          // m_WAbil.MaxWeight := m_WAbil.MaxWeight + StdItem.AniCount;           // 加背包重量
          if StdItem.StdMode in [62, 63, 64] then
            m_WAbil.MaxWearWeight := m_WAbil.MaxWearWeight + StdItem.Anicount; // 装备重量
        end;

        // 新增属性开始 ------------------------------------------------------
        AddAbilitysByCode(I <> U_SHIELD, SmartObject, StdItem, @SmartObject.m_UseItems[I]); // True ---> I <> U_SHIELD 2020-11-25
        if StdItem.Shape = 122 then
          boRecallSuite2 := True;
        if StdItem.Shape = 123 then
          boRecallSuite1 := True;
        if StdItem.Shape = 124 then
          boRecallSuite3 := True;
        if StdItem.Shape = 125 then
          boRecallSuite4 := True;
        if StdItem.Shape = 126 then
          boSpirit3 := True;
        if StdItem.Shape = 127 then
