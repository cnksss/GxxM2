function TBaseObject.GetCharColor(BaseObject: TBaseObject): Byte;
var
  Castle: TUserCastle;
begin
  if (m_PEnvir.m_nSecretFlag and SecretFlag_NoChangNameColor <> 0) or
    (m_PEnvir.m_nSecretFlag2 and SecretFlag_NoChangNameColor <> 0) then
  begin
    if not(BaseObject.m_btRaceServer in [RC_PEACENPC, RC_NPC]) then
    begin
      Result := 255;
      Exit;
    end;
  end;

  Result := BaseObject.GetNamecolor();
  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
  begin
    Castle := g_CastleManager.InCastleWarArea(BaseObject);
    if (Castle <> nil) and Castle.m_boUnderWar and m_boInFreePKArea and BaseObject.m_boInFreePKArea then
    begin
      Result := g_Config.btInFreePKAreaNameColor; // $DD; 当人物在行会战争区域时人物名字颜色，默认为221

      m_boGuildWarArea := True;
      if m_MyGuild = nil then
        Exit;

      if Castle.IsMasterGuild(TGUild(m_MyGuild)) then
      begin
        if (m_MyGuild = BaseObject.m_MyGuild) //
          or (TGUild(m_MyGuild).IsAllyGuild(TGUild(BaseObject.m_MyGuild))) then
          Result := g_Config.btAllyAndGuildNameColor // $B4; 当人物在行会战争时，本行会及联盟行会人物名字颜色，默认为180
        else if Castle.IsAttackGuild(TGUild(BaseObject.m_MyGuild)) then
          Result := g_Config.btWarGuildNameColor; // $45; 当人物在行会战争时，敌对行会人物名字颜色，默认为69
      end
      else if Castle.IsAttackGuild(TGUild(m_MyGuild)) then
      begin
        if (m_MyGuild = BaseObject.m_MyGuild) //
          or (TGUild(m_MyGuild).IsAllyGuild(TGUild(BaseObject.m_MyGuild))) then
          Result := g_Config.btAllyAndGuildNameColor
        else if Castle.IsMember(BaseObject) //
          or Castle.IsAttackGuild(TGUild(BaseObject.m_MyGuild)) then
          Result := g_Config.btWarGuildNameColor;
      end;
    end
    else
    begin
      // 红名不管PK状态控制 chongchong 2015-05-14
      if (TSmartObject(BaseObject).PKLevel < 2) and BaseObject.m_boPKFlag then
        Result := g_Config.btPKFlagNameColor; // $2F

      // 只要宣战，只要不在安全区，任何地图名字都重新着色 Cursor 2023-06-09 11:56:56
      case GetGuildRelationEx(Self, BaseObject) of
        1, 3:
          Result := g_Config.btAllyAndGuildNameColor;
        2:
          Result := g_Config.btWarGuildNameColor;
      end;
    end;
  end
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then // 攻城、行会战时，英雄的名字颜色同主号 chongchong 2013-12-20
  begin
    if BaseObject.m_Master <> nil then
    begin
      Castle := g_CastleManager.InCastleWarArea(BaseObject.m_Master);

      if (Castle <> nil) and Castle.m_boUnderWar and m_boInFreePKArea and BaseObject.m_Master.m_boInFreePKArea then
      begin
        Result := g_Config.btInFreePKAreaNameColor;
        m_boGuildWarArea := True;
        if m_MyGuild = nil then
          Exit;

        if Castle.IsMasterGuild(TGUild(m_MyGuild)) then
        begin
          if (m_MyGuild = BaseObject.m_Master.m_MyGuild) //
            or (TGUild(m_MyGuild).IsAllyGuild(TGUild(BaseObject.m_Master.m_MyGuild))) then
            Result := g_Config.btAllyAndGuildNameColor
          else if Castle.IsAttackGuild(TGUild(BaseObject.m_Master.m_MyGuild)) then
            Result := g_Config.btWarGuildNameColor;
        end
        else if Castle.IsAttackGuild(TGUild(m_MyGuild)) then
        begin
          if (m_MyGuild = BaseObject.m_Master.m_MyGuild) //
            or (TGUild(m_MyGuild).IsAllyGuild(TGUild(BaseObject.m_Master.m_MyGuild))) then
            Result := g_Config.btAllyAndGuildNameColor
          else if Castle.IsMember(BaseObject.m_Master) or Castle.IsAttackGuild(TGUild(BaseObject.m_Master.m_MyGuild)) then
            Result := g_Config.btWarGuildNameColor;
        end;
      end
      else
      begin
        // 红名不管PK状态控制 chongchong 2015-05-14
        if (TSmartObject(BaseObject).PKLevel < 2) and BaseObject.m_boPKFlag then
          Result := g_Config.btPKFlagNameColor; // $2F

        // 主人看自己的英雄不变色，看其他人的英雄按行会逻辑着色 Cursor 2023-06-09 12:35:05
        if (Self <> BaseObject.m_Master) and not BaseObject.InSafeArea then
          case GetGuildRelationEx(Self, BaseObject.m_Master) of
            1, 3:
              Result := g_Config.btAllyAndGuildNameColor;
            2:
              Result := g_Config.btWarGuildNameColor;
          end;
      end;
    end;
  end
  else if (BaseObject.m_btRaceServer = RC_PLAYMOSTER) and (BaseObject is TCopyMon) then
    Result := g_Config.btCopySelfNameColor
  else if (BaseObject.m_btRaceServer in [11, 12] { 大刀卫士，巡逻卫士 } ) then
    Result := g_Config.btGuardNameColor
  else if (BaseObject.m_btRaceServer in [RC_NPC .. RC_ANIMAL]) and not(BaseObject.m_btRaceServer = RC_BOX) then
    Result := g_Config.btMerchantNameColor // 修复普通类采集怪物名字绿色的问题
  else
  begin
    if (BaseObject.m_Master <> nil) then
    begin
      if (BaseObject.m_btSlaveExpLevel <= SLAVEMAXLEVEL) then
        Result := g_Config.SlaveColor[BaseObject.m_btSlaveExpLevel]
      else
        Result := g_Config.SlaveColor[High(g_Config.SlaveColor)];
    end
    else if BaseObject.m_boFixedColor then
      Result := BaseObject.m_btFixedColor;

    if BaseObject.m_boCrazyMode then
      Result := $F9;

    if BaseObject.m_boHolySeize then
      Result := $7D;

    if (BaseObject.m_Master <> nil) and (BaseObject.m_nSlaveNameColor >= 0) then
      Result := BaseObject.m_nSlaveNameColor;

    // 宠物颜色
    if (BaseObject.m_Master <> nil) and (BaseObject.m_boGamePet) then
      Result := g_Config.btPetNameColor;
  end;
end;

// 取等级所需药力值 20080624
function TBaseObject.GetMedicineExp(nLevel: Integer): Word;
begin
  Result := 0;
  if nLevel <= MAXCHANGELEVEL { 1000 } then
  begin
    Result := g_Config.dwMedicineLevelNeedExps[nLevel];
    Exit;
  end;

  if nLevel <= MAXLEVEL then
    Result := High(Word);
end;

function TBaseObject.GetLevelExp(nLevel: LongWord): LongWord;
var
  I64: Int64;
begin
  { TODO -ochongchong -c修改 : 英雄1000以后使用固定经验 【2013-08-17】 }
  if m_btRaceServer = RC_HEROOBJECT then
  begin
    if nLevel <= MAXCHANGELEVEL { 1000 } then
      Result := g_Config.dwHeroNeedExps[nLevel]
    else
    begin
      I64 := Int64(g_Config.dwHeroNeedExps[High(g_Config.dwHeroNeedExps)]) + Max(0, (nLevel - MAXCHANGELEVEL)) *
        g_Config.dwHeroLevel1000FixedExp;
      Result := Min(High(LongWord), I64);
    end;
    Exit;
  end
  else
  begin
    if nLevel <= MAXCHANGELEVEL { 1000 } then
    begin
      if m_boGamePet then
      begin
        if nLevel = 0 then
          nLevel := 1;
        Result := g_Config.dwPetNeedExps[nLevel];
      end
      else
        Result := g_Config.dwNeedExps[nLevel];
      Exit;
    end;
  end;

  if m_boGamePet then
  begin
    if g_Config.boPetUseFixExp then
      Result := Min(High(LongWord), g_Config.dwPetNeedExps[High(g_Config.dwPetNeedExps)] + Max(0, (nLevel - MAXCHANGELEVEL))
        * 10000000)
    else
      Result := Min(High(LongWord), (nLevel - MAXCHANGELEVEL) * g_Config.nPetAddExp + g_Config.nPetBaseExp);
  end
  else
  begin
    if g_Config.boUseFixExp then
    begin
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        Result := Min(High(LongWord), g_Config.dwNeedExps[High(g_Config.dwNeedExps)] + Max(0, (nLevel - MAXCHANGELEVEL)) *
          10000000);
      end
      else
      begin
        Result := Min(High(LongWord), g_Config.dwHeroNeedExps[High(g_Config.dwHeroNeedExps)] + Max(0, (nLevel - MAXCHANGELEVEL)) *
          10000000);
      end;
    end
    else
      Result := Min(High(LongWord), (nLevel - MAXCHANGELEVEL) * g_Config.nAddExp + g_Config.nBaseExp);
  end;
end;

function TBaseObject.GetNamecolor(): Byte;
begin
  Result := m_btNameColor;

  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    if TSmartObject(Self).PKLevel = 1 then
      Result := g_Config.btPKLevel1NameColor; // $FB;

    if TSmartObject(Self).PKLevel >= 2 then
      Result := g_Config.btPKLevel2NameColor; // $F9;
  end;
end;

procedure TBaseObject.HearMsg(sMsg: string);
begin
  if sMsg <> '' then
  begin
    if (m_btRaceServer = RC_PLAYOBJECT) then
      SendMsg(nil, RM_HEAR, 0, TPlayObject(Self).GetHearMsgFColor, g_Config.btHearMsgBColor, 0, sMsg)
    else
      SendMsg(nil, RM_HEAR, 0, g_Config.btHearMsgFColor, g_Config.btHearMsgBColor, 0, sMsg);
  end;
end;

function TBaseObject.InSafeArea(): Boolean;
begin
  Result := (m_PEnvir <> nil) //
    and (m_PEnvir.m_boSAFE or g_SafeAreaManager.PointInSafeArea(m_PEnvir.sMapName, m_nCurrX, m_nCurrY));
end;

