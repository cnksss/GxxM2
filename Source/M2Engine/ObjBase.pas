    if m_wStatusTimeArr[STATE_DEFENCEUP { 10 0x72 } ] > 0 then // 004C0BCD
    begin
      m_WAbil.AC1 := m_WAbil.AC1;
      if m_dwDefenceUpAddRate = 0 then
      begin
        Int64Value := Round((Int64(m_WAbil.AC2) + 2 + (m_Abil.Level div 7) * g_Config.nSkill15PowerRate / 100));
