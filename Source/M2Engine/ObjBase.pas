      2:
        boParalyCan := g_Config.boParalyCanHit;
      3:
        boParalyCan := g_Config.boParalyCanSpell;
    else
      boParalyCan := False;
    end;
    Result := g_Config.boStartGameAuxiliary and g_Config.ClientConfigs[38] and boParalyCan; // 防石化
