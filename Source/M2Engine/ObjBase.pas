procedure TBaseObject.ClientPoison(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nPower: Integer;
  TargeTBaseObject: TBaseObject;
  MagicID: string;
  IsSetPosion: Boolean;
begin
  /// m_boFastParalysis := True;
  TargeTBaseObject := TBaseObject(ProcessMsg.nParam2); // 施毒者
  MagicID := ProcessMsg.sMsg;
  if TargeTBaseObject <> nil then
  begin
    nPower := TargeTBaseObject.GetMagicPercentPower(StrToIntDef(MagicID, -1), ProcessMsg.nParam3, Self);
    if TargeTBaseObject.IsProperTarget(Self) then
    begin
      // 修复在全体模式下，主人对宝宝施毒，宝宝还手 chongchong 2018-01-11
      if not((Self.Master <> nil) and ((Self.Master = TargeTBaseObject) or (Self.Master = TargeTBaseObject.Master))) then
        SetTargetCreat(TargeTBaseObject);

      if (m_btRaceServer in [RC_PLAYOBJECT]) then
      begin
        if (TargeTBaseObject.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          SetPKFlag(TargeTBaseObject);
        end
        else if (TargeTBaseObject.m_btRaceServer = RC_HEROOBJECT) then
        begin
          // 主人打英雄主人不要灰名 chongchong 2018-09-12 11:35:48
          if (TargeTBaseObject.m_Master <> Self) then
          begin
            if TargeTBaseObject.m_Master <> nil then
              SetPKFlag(TargeTBaseObject.m_Master);
            SetPKFlag(TargeTBaseObject);
          end;
        end;
      end
      else if (m_btRaceServer in [RC_HEROOBJECT]) then
      begin
        if (TargeTBaseObject.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          // 主人打英雄主人不要灰名 chongchong 2018-09-12 11:35:48
          if m_Master <> TargeTBaseObject then
            SetPKFlag(TargeTBaseObject);
        end
        else if (TargeTBaseObject.m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) then
        begin
          if TargeTBaseObject.m_Master <> nil then
            m_Master.SetPKFlag(TargeTBaseObject.m_Master);
          m_Master.SetPKFlag(TargeTBaseObject);
        end;
      end;

      SetLastHiter(TargeTBaseObject);
      m_PoisonHitter := TargeTBaseObject;
      if ProcessMsg.wParam in [POISON_DECHEALTH, POISON_DAMAGEARMOR] then
        IsSetPosion := not UnPosion
      else if ProcessMsg.wParam in [POISON_STONE] then
        IsSetPosion := not UnParalysis
      else
        IsSetPosion := True;

      if IsSetPosion then // 防毒
        MakePosion(ProcessMsg.wParam { 中毒类型 } , ProcessMsg.nParam1 { nTime } , nPower { nPower } );
    end;
  end
  else
  begin
    if ProcessMsg.wParam in [POISON_DECHEALTH, POISON_DAMAGEARMOR] then
      IsSetPosion := not UnPosion
    else if ProcessMsg.wParam in [POISON_STONE] then
      IsSetPosion := not UnParalysis
    else
      IsSetPosion := True;

    if IsSetPosion then // 防毒
      MakePosion(ProcessMsg.wParam { 中毒类型 } , ProcessMsg.nParam1 { nTime } , ProcessMsg.nParam3 { nPower } );
  end;
end;

