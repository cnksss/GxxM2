procedure TBaseObject.SendRefMsg(wIdent: Integer; wParam, nParam1, nParam2, nParam3: NativeInt; sMsg: AnsiString;
  dwDelay: LongWord);
var
  Feature_wParam: Integer;
  Feature_sMsg: AnsiString;
  sBackupMsg: AnsiString;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.SendRefMsg Name = %s';
  procedure ProcessRMMsg(Player: TPlayObject);
  begin
    if wIdent = RM_FEATURECHANGED then
    begin
      wParam := Feature_wParam; // GetFeatureToLong(@Feature);
      nParam1 := 0;
      nParam2 := 0;
      nParam3 := 0;
      sMsg := Feature_sMsg; // EncodeBuffer(@Feature, wParam);
    end
    else if wIdent = RM_ITEMSHOW then // 兼容老端 piaoyun 2013-09-07
    begin
      sMsg := sBackupMsg;
    end
    else if (wIdent = RM_HEROLOGON) or (wIdent = RM_MYHEROLOGON) then
    begin
      if m_Master = Player then
        wIdent := RM_MYHEROLOGON
      else
        wIdent := RM_HEROLOGON;
    end;
  end;

var
  boTempFixedHideMode: Boolean;
  II, nC: Integer;
  nCX, nCY, nLX, nLY, nHX, nHY, nViewRange: Integer;
  MapCellInfo: pTMapCellinfo;
  GameObject: TGameObject;
  BaseObject: TBaseObject;
  Feature: array [0 .. 255] of AnsiChar;
  PlayObject: TPlayObject;
  GroupOwner: TPlayObject;
  boSend: Boolean;
begin
  if m_PEnvir = nil then
    Exit;

  sBackupMsg := sMsg;
  // 由于取Feature的运算比较多，先运算好 chongchong 2013-12-22
  if wIdent = RM_FEATURECHANGED then
  begin
    Feature_wParam := GetFeatureToLong(@Feature);
    SetLength(Feature_sMsg, Feature_wParam);
    Move(Feature[0], Feature_sMsg[1], Feature_wParam);
  end;

  // 隐身模式发送规则  piaoyun 2013-09-10
  boTempFixedHideMode := False;

  // NPC命令限时隐身 piaoyun 2013-12-22
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    boTempFixedHideMode := TSmartObject(Self).m_dwChangeModeExTick[1] > 0;

  // 隐身模式下，只发消息给自己
  if m_boObMode or m_boFixedHideMode or boTempFixedHideMode then
  begin
    if m_btRaceServer = RC_PLAYOBJECT then
      ProcessRMMsg(TPlayObject(Self))
      // H.ChangeModeEx 2 1000 主人看不到英雄 2019-04-26 10:37:30
    else if (m_btRaceServer = RC_HEROOBJECT) and ((wIdent = RM_DISAPPEAR) and (wParam = 65535)) then
      Exit;

    if dwDelay <= 0 then
      SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
    else
      SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);

    // H.ChangeModeEx 2 1000 主人看不到英雄 2019-04-26 10:37:30
    if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      ProcessRMMsg(TPlayObject(m_Master));
      if dwDelay <= 0 then
        m_Master.SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
      else
        m_Master.SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);
    end;

    if g_Config.ClientConfigs[73] //
      and (m_btRaceServer = RC_PLAYOBJECT) //
      and (TPlayObject(Self).m_GroupOwner <> nil) //
      and (TPlayObject(Self).m_GroupOwner.m_btRaceServer = RC_PLAYOBJECT) //
      and ((wIdent = RM_HEALTHSPELLCHANGED) // -
      or (wIdent = RM_HEALTHSPELLCHANGED_STRUCK) // -
      or (wIdent = RM_HPMPCHANGED_FORM_STONE) // -
      or (wIdent = RM_MAGICSHIELD_STRUCK) // -
      or (wIdent = RM_STRUCK) // -
      or (wIdent = RM_STRUCK_MAG)) then
    begin
{$IF MULTI_THREAD = 1}
      if g_MultiThreadRun then
        TPlayObject(Self).m_GroupMembers.LockR(27);
      try
{$IFEND}
        GroupOwner := TPlayObject(TPlayObject(Self).m_GroupOwner);
        for II := 0 to GroupOwner.m_GroupMembers.Count - 1 do
        begin
          PlayObject := TPlayObject(GroupOwner.m_GroupMembers.Objects[II]);
          if (PlayObject <> nil) and (PlayObject <> Self) and (PlayObject.m_VisibleHumanList.IndexOf(Self) = -1) then
          begin
            if dwDelay <= 0 then
              PlayObject.SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
            else
              PlayObject.SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);
          end;
        end;
{$IF MULTI_THREAD = 1}
      finally
        if g_MultiThreadRun then
          TPlayObject(Self).m_GroupMembers.UnLockR;
      end;
{$IFEND}
    end;
    Exit;
  end;

{$IF LockProcessMsg = 1}
  try
    EnterCriticalSection(ProcessMsgCriticalSection);
{$IFEND}
    if (MyGetTickCount - m_SendRefMsgTick >= 100) //
      or (m_VisibleHumanList.Count = 0) //
      or (m_nSendRefMsgRange <> g_nSendRefMsgRange) then
    begin
      m_SendRefMsgTick := MyGetTickCount();
      m_VisibleHumanList.Clear;
      m_nSendRefMsgRange := g_nSendRefMsgRange;
      nLX := m_nCurrX - g_nSendRefMsgRange;
      nHX := m_nCurrX + g_nSendRefMsgRange;
      nLY := m_nCurrY - g_nSendRefMsgRange - C_VIEWRANGEEXTY;
      nHY := m_nCurrY + g_nSendRefMsgRange + C_VIEWRANGEEXTY;
      for nCX := nLX to nHX do
      begin
        for nCY := nLY to nHY do
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            m_PEnvir.LockR(10);
          try
{$IFEND}
            if m_PEnvir.GetMapCellInfo(nCX, nCY, MapCellInfo) then
            begin
              if MapCellInfo.ObjList <> nil then
              begin
                for II := {$IF USEOBJLIST = 1}Length(MapCellInfo.ObjList){$ELSE}MapCellInfo.ObjList.Count{$IFEND} - 1 downto 0 do
                begin
                  GameObject := TGameObject({$IF USEOBJLIST = 1}MapCellInfo.ObjList[II]{$ELSE}MapCellInfo.ObjList.Items
                    [II]{$IFEND});

                  if GameObject = nil then
                  begin
                    // 修改试下会不会提高效率 chongchong 2016-10-28
                    (*
                      {$IF USEOBJLIST = 1}
                      for Index := II to Length(MapCellInfo.ObjList) - 2 do
                      MapCellInfo.ObjList[Index] := MapCellInfo.ObjList[Index + 1];
                      SetLength(MapCellInfo.ObjList, Length(MapCellInfo.ObjList) - 1);
                      if Length(MapCellInfo.ObjList) <= 0 then
                      begin
                      MapCellInfo.ObjList := nil;
                      Break;
                      end;
                      {$ELSE}
                      MapCellInfo.ObjList.Delete(II);
                      if MapCellInfo.ObjList.Count <= 0 then
                      begin
                      FreeAndNil(MapCellInfo.ObjList);
                      Break;
                      end;
                      {$IFEND}
                    *)
                    Continue;
                  end;

                  if GameObject.m_ObjGame = obj_Actor then
                  begin
                    if (not m_boDenyRefStatus) and ((MyGetTickCount - GameObject.m_dwAddTime) >= 60 * 1000) then
                    begin
                      // 修改试下会不会提高效率 chongchong 2016-10-28
                      (*
                        {$IF USEOBJLIST = 1}
                        for Index := II to Length(MapCellInfo.ObjList) - 2 do
                        MapCellInfo.ObjList[Index] := MapCellInfo.ObjList[Index + 1];
                        SetLength(MapCellInfo.ObjList, Length(MapCellInfo.ObjList) - 1);
                        if Length(MapCellInfo.ObjList) <= 0 then
                        begin
                        MapCellInfo.ObjList := nil;
                        Break;
                        end;
                        {$ELSE}
                        MapCellInfo.ObjList.Delete(II);
                        if MapCellInfo.ObjList.Count <= 0 then
                        begin
                        FreeAndNil(MapCellInfo.ObjList);
                        Break;
                        end;
                        {$IFEND} *)
                    end
                    else
                    begin
                      try
                        BaseObject := TBaseObject(GameObject);
                        if (BaseObject <> nil) and (not BaseObject.m_boGhost) { and (not BaseObject.m_boDummyObject) } then
                        begin
                          if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
                          begin
                            ProcessRMMsg(TPlayObject(BaseObject));

                            if (BaseObject.m_PEnvir = m_PEnvir) //
                              and (Abs(BaseObject.m_nCurrX - m_nCurrX) <= BaseObject.m_nViewRange) //
                              and (Abs(BaseObject.m_nCurrY - m_nCurrY) <= BaseObject.m_nViewRange //
                              + BaseObject.m_nViewRangeExtY) then
                            begin
                              boSend := True;
                              // 修正掉落装备会发2次 rm_ITEMSHOW 消息  chongchong 2016-07-22
                              if wIdent = RM_ITEMSHOW then
                              begin
                                boSend := (Abs(BaseObject.m_nCurrX - nParam2) <= BaseObject.m_nViewRange) and
                                  (Abs(BaseObject.m_nCurrY - nParam3) <= BaseObject.m_nViewRange + BaseObject.m_nViewRangeExtY);

                                if boSend then // 最后一个参数置True，免得消息发2次 2021-03-23
                                  BaseObject.UpdateVisibleItem(nParam2, nParam3, TItemObject(nParam1), True);
                              end
                              else if (wIdent = RM_ITEMHIDE) then
                              begin
                                boSend := (Abs(BaseObject.m_nCurrX - nParam2) <= BaseObject.m_nViewRange) and
                                  (Abs(BaseObject.m_nCurrY - nParam3) <= BaseObject.m_nViewRange + BaseObject.m_nViewRangeExtY);

                                if boSend then
                                  TPlayObject(BaseObject).HideItem(TItemObject(nParam1)); // 防止重复发送隐藏物品封包 减少流量
                              end;

                              if boSend then
                              begin
                                if dwDelay <= 0 then
                                  BaseObject.SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
                                else
                                  BaseObject.SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);
                              end;
                            end;

                            if (BaseObject.m_PEnvir = m_PEnvir) //
                              and (Abs(BaseObject.m_nCurrX - m_nCurrX) <= BaseObject.m_nViewRange) //
                              and (Abs(BaseObject.m_nCurrY - m_nCurrY) <= BaseObject.m_nViewRange //
                              + BaseObject.m_nViewRangeExtY) then // 在自己的视觉范围
                              m_VisibleHumanList.Add(BaseObject);
                          end
                          else if (BaseObject.m_PEnvir = m_PEnvir) and BaseObject.m_boWantRefMsg then
                          begin
                            if (wIdent = RM_STRUCK) { 增加分身的魔法盾效果 }
                              or (wIdent = RM_HEAR) //
                              or (wIdent = RM_DEATH) //
                              or (wIdent = RM_CHARSTATUSCHANGED) //
                              or (wIdent = RM_RUSH) then
                            begin
                              if dwDelay <= 0 then
                                BaseObject.SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
                              else
                                BaseObject.SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);

                              nViewRange := Max(BaseObject.m_nViewRange, m_nViewRange);
                              if (BaseObject.m_PEnvir = m_PEnvir) //
                                and (Abs(BaseObject.m_nCurrX - m_nCurrX) <= nViewRange) //
                                and (Abs(BaseObject.m_nCurrY - m_nCurrY) <= nViewRange + m_nViewRangeExtY) then // 在自己的视觉范围
                                m_VisibleHumanList.Add(BaseObject);
                            end;
                          end;
                        end;
                      except
                        on E: Exception do
                        begin
                          MainOutMessage(Format(sExceptionMsg, [m_sCharName]));
                          MainOutMessage(E.Message);
                        end;
                      end;
                    end;
                  end;
                end;
              end;
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              m_PEnvir.UnLockR;
          end;
{$IFEND}
        end;
      end;

      // 英雄死亡后还有血量和图标
      // 英雄与主人不在同一地图或同一可视范围时，英雄的状态也要向主人发 chongchong 2013-10-08
      if (m_btRaceServer = RC_HEROOBJECT) //
        and (m_Master <> nil) //
        and (m_Master.m_btRaceServer = RC_PLAYOBJECT) //
        and ((m_PEnvir <> m_Master.m_PEnvir) // -
        or (Abs(m_Master.m_nCurrX - m_nCurrX) > m_Master.m_nViewRange) // -
        or (Abs(m_Master.m_nCurrY - m_nCurrY) > m_Master.m_nViewRange + m_nViewRangeExtY)) then
      begin
        ProcessRMMsg(TPlayObject(m_Master));
        if dwDelay <= 0 then
          m_Master.SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
        else
          m_Master.SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);
      end;

      if g_Config.ClientConfigs[73] //
        and (m_btRaceServer = RC_PLAYOBJECT) //
        and (TPlayObject(Self).m_GroupOwner <> nil) //
        and (TPlayObject(Self).m_GroupOwner.m_btRaceServer = RC_PLAYOBJECT) //
        and ((wIdent = RM_HEALTHSPELLCHANGED) // -
        or (wIdent = RM_HEALTHSPELLCHANGED_STRUCK) // -
        or (wIdent = RM_HPMPCHANGED_FORM_STONE) // -
        or (wIdent = RM_MAGICSHIELD_STRUCK) // -
        or (wIdent = RM_STRUCK) // -
        or (wIdent = RM_STRUCK_MAG)) then
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          TPlayObject(Self).m_GroupMembers.LockR(27);
        try
{$IFEND}
          GroupOwner := TPlayObject(TPlayObject(Self).m_GroupOwner);
          for II := 0 to GroupOwner.m_GroupMembers.Count - 1 do
          begin
            PlayObject := TPlayObject(GroupOwner.m_GroupMembers.Objects[II]);
            if (PlayObject <> nil) and (PlayObject <> Self) and (PlayObject.m_VisibleHumanList.IndexOf(Self) = -1) then
            begin
              if dwDelay <= 0 then
                PlayObject.SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
              else
                PlayObject.SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);
            end;
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            TPlayObject(Self).m_GroupMembers.UnLockR;
        end;
{$IFEND}
      end;
      Exit;
    end;

    for nC := 0 to m_VisibleHumanList.Count - 1 do
    begin
      BaseObject := TBaseObject(m_VisibleHumanList.Items[nC]);
      if (BaseObject = nil) or (BaseObject.m_boGhost) then
        Continue;

      if (BaseObject.m_PEnvir = m_PEnvir) //
        and (Abs(BaseObject.m_nCurrX - m_nCurrX) <= BaseObject.m_nViewRange) //
        and (Abs(BaseObject.m_nCurrY - m_nCurrY) <= BaseObject.m_nViewRange + BaseObject.m_nViewRangeExtY) then
      begin
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          ProcessRMMsg(TPlayObject(BaseObject));
          boSend := True;
          // 修正掉落装备会发2次 rm_ITEMSHOW 消息  chongchong 2016-07-22
          if wIdent = RM_ITEMSHOW then
          begin
            boSend := (Abs(BaseObject.m_nCurrX - nParam2) <= BaseObject.m_nViewRange) and
              (Abs(BaseObject.m_nCurrY - nParam3) <= BaseObject.m_nViewRange + BaseObject.m_nViewRangeExtY);

            if boSend then
              BaseObject.UpdateVisibleItem(nParam2, nParam3, TItemObject(nParam1), True);
          end
          else if wIdent = RM_ITEMHIDE then
          begin
            boSend := (Abs(BaseObject.m_nCurrX - nParam2) <= BaseObject.m_nViewRange) and
              (Abs(BaseObject.m_nCurrY - nParam3) <= BaseObject.m_nViewRange + BaseObject.m_nViewRangeExtY);

            if boSend then
              TPlayObject(BaseObject).HideItem(TItemObject(nParam1)); // 防止重复发送隐藏物品封包 减少流量
          end;

          if boSend then
          begin
            if dwDelay <= 0 then
              BaseObject.SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
            else
              BaseObject.SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);
          end;
        end
        else if BaseObject.m_boWantRefMsg then
        begin
          if (wIdent = RM_STRUCK) //
            or (wIdent = RM_HEAR) //
            or (wIdent = RM_DEATH) //
            or (wIdent = RM_CHARSTATUSCHANGED) //
            or (wIdent = RM_RUSH) then
          begin
            if dwDelay <= 0 then
              BaseObject.SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
            else
              BaseObject.SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);
          end;
        end;
      end;
    end;

    if g_Config.ClientConfigs[73] //
      and (m_btRaceServer = RC_PLAYOBJECT) //
      and (TPlayObject(Self).m_GroupOwner <> nil) //
      and (TPlayObject(Self).m_GroupOwner.m_btRaceServer = RC_PLAYOBJECT) //
      and ((wIdent = RM_HEALTHSPELLCHANGED) // -
      or (wIdent = RM_HEALTHSPELLCHANGED_STRUCK) // -
      or (wIdent = RM_HPMPCHANGED_FORM_STONE) // -
      or (wIdent = RM_MAGICSHIELD_STRUCK) // -
      or (wIdent = RM_STRUCK) // -
      or (wIdent = RM_STRUCK_MAG)) then
    begin
{$IF MULTI_THREAD = 1}
      if g_MultiThreadRun then
        TPlayObject(Self).m_GroupMembers.LockR(27);
      try
{$IFEND}
        GroupOwner := TPlayObject(TPlayObject(Self).m_GroupOwner);
        for II := 0 to GroupOwner.m_GroupMembers.Count - 1 do
        begin
          PlayObject := TPlayObject(GroupOwner.m_GroupMembers.Objects[II]);
          if (PlayObject <> nil) and (PlayObject <> Self) and (PlayObject.m_VisibleHumanList.IndexOf(Self) = -1) then
          begin
            if dwDelay <= 0 then
              PlayObject.SendMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg)
            else
              PlayObject.SendDelayMsg(Self, wIdent, wParam, nParam1, nParam2, nParam3, sMsg, dwDelay);
          end;
        end;
{$IF MULTI_THREAD = 1}
      finally
        if g_MultiThreadRun then
          TPlayObject(Self).m_GroupMembers.UnLockR;
      end;
{$IFEND}
    end;
{$IF LockProcessMsg = 1}
  finally
    LeaveCriticalSection(ProcessMsgCriticalSection);
  end;
{$IFEND}
end;

procedure TBaseObject.UpdateVisibleGay(BaseObject: TBaseObject);
var
  VisibleBaseObject: pTVisibleBaseObject;
  nErrCode: Integer;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.UpdateVisibleGay-->ErrCode=%d';
begin
  nErrCode := 0;
  try
    if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) or (BaseObject.m_Master <> nil) then
      m_boIsVisibleActive := True; // 如果是人物或宝宝则置TRUE
    nErrCode := 2;
    m_VisibleActors.Lock;
    try
      nErrCode := 4;
      VisibleBaseObject := m_VisibleActors.GetItemByKey(NativeInt(BaseObject));
      nErrCode := 5;
      if VisibleBaseObject = nil then
      begin
        nErrCode := 6;
        New(VisibleBaseObject);
        nErrCode := 7;
        VisibleBaseObject.nVisibleFlag := 2;
        nErrCode := 8;
        VisibleBaseObject.BaseObject := BaseObject;
        nErrCode := 9;
        m_VisibleActors.Add(NativeInt(BaseObject), VisibleBaseObject);
      end
      else
      begin
        nErrCode := 11;
        if VisibleBaseObject.BaseObject = BaseObject then
        begin
          nErrCode := 12;
          VisibleBaseObject.nVisibleFlag := 1;
          nErrCode := 13;
        end;
      end;
    finally
      m_VisibleActors.UnLock;
    end;
  except
    MainOutMessage(Format(sExceptionMsg, [nErrCode]));
  end;
end;

procedure TBaseObject.UpdateVisibleItem(wX, wY: Integer; MapItem: TItemObject; boSendItemShow: Boolean = False);
var
  VisibleMapItem: pTVisibleMapItem;
  StdItem: pTStdItem;
  wEffect: Word;
  Index: Integer;
begin
  VisibleMapItem := m_VisibleItems.GetItemByKey(NativeInt(MapItem));
  if VisibleMapItem = nil then
  begin
    New(VisibleMapItem);
    if not boSendItemShow then
      VisibleMapItem.nVisibleFlag := 2
    else
      VisibleMapItem.nVisibleFlag := 1;
    VisibleMapItem.nX := wX;
    VisibleMapItem.nY := wY;
    VisibleMapItem.btColor2 := MapItem.m_btColor;
    VisibleMapItem.BaseObject := MapItem;
    VisibleMapItem.boSendHideMsg := False;
    // 地面物品特效 chongchong 2017-07-01
    wEffect := MapItem.m_UserItem.wEffect;
    if wEffect = 0 then
    begin
      Index := g_DropEffectItemList.IndexOf(MapItem.m_sDBName);
      if Index >= 0 then
      begin
        wEffect := Integer(g_DropEffectItemList.Objects[Index]);
      end;
    end;
    StdItem := UserEngine.GetStdItem(MapItem.m_UserItem.wIndex);
    if (StdItem <> nil) and CheckOverLapItem(StdItem) then
    begin
      VisibleMapItem.OverlapCountAndEffect := MakeLong(MapItem.m_UserItem.Dura + 1, wEffect);
    end
    else
    begin
      VisibleMapItem.OverlapCountAndEffect := MakeLong(0, wEffect);
    end;
    VisibleMapItem.boValue := GetDropItemValue(@MapItem.m_UserItem, StdItem) <> 0;
    if (MapItem.m_sDBName <> '') and (CompareText(MapItem.m_sName, MapItem.m_sDBName) <> 0) then
      VisibleMapItem.sName := MapItem.m_sName + '/' + MapItem.m_sDBName
    else
      VisibleMapItem.sName := MapItem.m_sName;
    VisibleMapItem.wLooks := MapItem.m_wLooks;
    m_VisibleItems.Add(NativeInt(MapItem), VisibleMapItem);
  end
  else
  begin
    if VisibleMapItem.BaseObject = MapItem then
    begin
      VisibleMapItem.nVisibleFlag := 1;
    end;
  end;
end;

procedure TSmartObject.ClearObject;
begin
  inherited;
end;

procedure TBaseObject.ClearObject;
var
  I: Integer;
  VisibleBaseObject: pTVisibleBaseObject;
  VisibleMapItem: pTVisibleMapItem;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.ClearObject %d';
begin
  if m_VisibleHumanList.Count > 0 then
  begin
    try
      m_VisibleHumanList.Clear;
    except
      MainOutMessage(Format(sExceptionMsg, [1]));
    end;
  end;
  if m_VisibleActors.Count > 0 then
  begin
    m_VisibleActors.Lock;
    try
      try
        for I := 0 to m_VisibleActors.Count - 1 do
        begin
          VisibleBaseObject := m_VisibleActors[I].Item;
          if VisibleBaseObject <> nil then
            Dispose(VisibleBaseObject);
          /// // 大部分时间是出在这里
        end;
        m_VisibleActors.Clear;
      except
        MainOutMessage(Format(sExceptionMsg, [2]));
      end;
    finally
      m_VisibleActors.UnLock;
    end;
  end;
  if m_VisibleItems.Count > 0 then
  begin
    m_VisibleItems.Lock;
    try
      try
        for I := 0 to m_VisibleItems.Count - 1 do
        begin
          VisibleMapItem := m_VisibleItems[I].Item;
          if VisibleMapItem <> nil then
            Dispose(VisibleMapItem);
        end;
        m_VisibleItems.Clear;
      except
        MainOutMessage(Format(sExceptionMsg, [3]));
      end;
    finally
      m_VisibleItems.UnLock;
    end;
  end;
end;

function TBaseObject.CheckMasterViewRange: Boolean; // 检测是否在主人的可视范围
var
  nStartX: Integer;
  nEndX: Integer;
  nStartY: Integer;
  nEndY: Integer;
begin
  Result := True;
  if (m_Master <> nil) and (m_Master.m_PEnvir = m_PEnvir) then
  begin
    nStartX := m_Master.m_nCurrX - m_Master.m_nViewRange;
    nEndX := m_Master.m_nCurrX + m_Master.m_nViewRange;
    nStartY := m_Master.m_nCurrY - m_Master.m_nViewRange;
    nEndY := m_Master.m_nCurrY + m_Master.m_nViewRange;
    Result := (m_nCurrX >= nStartX) and (m_nCurrX <= nEndX) and (m_nCurrY >= nStartY) and (m_nCurrY <= nEndY);
    // Result := (m_nCurrX < nStartX) or (m_nCurrX > nEndX) or (m_nCurrY < nStartY) or (m_nCurrY > nEndY);
    // Result := not ((m_nCurrX - m_Master.m_nCurrX > m_Master.m_nViewRange) or (m_nCurrY - m_Master.m_nCurrY > m_Master.m_nViewRange));
  end;
end;

procedure TBaseObject.SearchViewRange;
var
  I, Index: Integer;
  nStartX: Integer;
  nEndX: Integer;
  nStartY: Integer;
  nEndY: Integer;
  n18: Integer;
  n1C: Integer;
  nIdx: Integer;
  MapCellInfo: pTMapCellinfo;
  GameObject: TGameObject;
  BaseObject: TBaseObject;
  ItemObject: TItemObject;
  VisibleBaseObject: pTVisibleBaseObject;
  VisibleMapItem: pTVisibleMapItem;
  nCheckCode: Integer;
  boTempFixedHideMode: Boolean;
  SmartObject: TSmartObject;
  IsSlavePickItem: Boolean;
resourcestring
  sExceptionMsg1 = '[Exception] TBaseObject.SearchViewRange Code:%d';
  sExceptionMsg2 = '[Exception] TBaseObject.SearchViewRange 1-%d %s %s %d %d %d';
  sExceptionMsg3 = '[Exception] TBaseObject.SearchViewRange 2-%d %s %s %d %d %d';
  sExceptionMsg4 = '[Exception] TBaseObject.SearchViewRange 3-%d %s %s %d %d %d';
begin
  nCheckCode := 0;
  try
    nCheckCode := 1;
    if m_PEnvir = nil then
    begin
      MainOutMessage('SearchViewRange nil PEnvir');
      Exit;
    end;

    nCheckCode := 2;
    if m_boOffLine then
    begin
      nCheckCode := 3;
      ClearObject;
      Exit;
    end;

    nCheckCode := 4;
    if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and m_Master.m_boOffLine then
    begin
      nCheckCode := 5;
      ClearObject;
      Exit;
    end;

    nCheckCode := 6;
    if (Master <> nil) and (Master.m_btRaceServer = RC_PLAYOBJECT) and Master.m_boOffLine then
    begin
      nCheckCode := 7;
      ClearObject;
      Exit;
    end;
  except
    MainOutMessage(Format(sExceptionMsg1, [nCheckCode]));
    KickException();
  end;

  nCheckCode := 10;
  IsSlavePickItem := False;
  m_boIsVisibleActive := False; // 先置为FALSE
  try
    nCheckCode := 11;
    if (m_Master <> nil) and (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
    begin
      nCheckCode := 12;
      if m_boGamePet then
        IsSlavePickItem := (m_Master.m_btRaceServer = RC_PLAYOBJECT) and
          (((m_btGamePetEnablePick = 0) and g_Config.boEnabledPetPickup) or (m_btGamePetEnablePick = 1))
      else
      begin
        SmartObject := TSmartObject(m_Master);
        // 禁止范围拾取
        IsSlavePickItem := (not m_PEnvir.m_boNoAutoRangePickItem) and SmartObject.m_boSlaveAutoPickItem and
          (g_nKey_UseClientPickItems <> 0);
      end;
    end;

    nCheckCode := 13;
    if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) or IsSlavePickItem then
    begin
      nCheckCode := 14;
      for I := 0 to m_VisibleItems.Count - 1 do
      begin
        VisibleMapItem := m_VisibleItems[I].Item;
        if VisibleMapItem <> nil then
          VisibleMapItem.nVisibleFlag := 0;
      end;
    end;
  except
    MainOutMessage(Format(sExceptionMsg1, [nCheckCode]));
    KickException();
  end;

  nCheckCode := 20;
  try
    m_VisibleActors.Lock;
    try
      for I := 0 to m_VisibleActors.Count - 1 do
      begin
        VisibleBaseObject := m_VisibleActors[I].Item;
        if VisibleBaseObject <> nil then
          VisibleBaseObject.nVisibleFlag := 0;
      end;
    finally
      m_VisibleActors.UnLock;
    end;
    nCheckCode := 50;
  except
    MainOutMessage(Format(sExceptionMsg1, [nCheckCode]));
    KickException();
  end;

  nCheckCode := 6;
  nStartX := m_nCurrX - m_nViewRange;
  nEndX := m_nCurrX + m_nViewRange;
  nStartY := m_nCurrY - m_nViewRange;
  nEndY := m_nCurrY + m_nViewRange + m_nViewRangeExtY;
  try
    nCheckCode := 7;
    for n18 := nStartX to nEndX do
    begin
      nCheckCode := 8;
      for n1C := nStartY to nEndY do
      begin
        nCheckCode := 9;
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          m_PEnvir.LockW(11);
        try
{$IFEND}
          if m_PEnvir.GetMapCellInfo(n18, n1C, MapCellInfo) and (MapCellInfo.ObjList <> nil) then
          begin
            nCheckCode := 10;
            nIdx := 0;
            while (True) do
            begin
              nCheckCode := 11;
{$IF USEOBJLIST = 1}
              if Length(MapCellInfo.ObjList) <= nIdx then
                Break;

              GameObject := TGameObject(MapCellInfo.ObjList[nIdx]);
{$ELSE}
              if MapCellInfo.ObjList.Count <= nIdx then
                Break;
              GameObject := TGameObject(MapCellInfo.ObjList.Items[nIdx]);
{$IFEND}
              if GameObject = nil then
              begin
{$IF USEOBJLIST = 1}
                for Index := nIdx to Length(MapCellInfo.ObjList) - 2 do
                  MapCellInfo.ObjList[Index] := MapCellInfo.ObjList[Index + 1];

                SetLength(MapCellInfo.ObjList, Length(MapCellInfo.ObjList) - 1);
                if Length(MapCellInfo.ObjList) <= 0 then
                begin
                  MapCellInfo.ObjList := nil;
                  Break;
                end;
{$ELSE}
                MapCellInfo.ObjList.Delete(nIdx);
                if MapCellInfo.ObjList.Count <= 0 then
                begin
                  nCheckCode := 12;
                  FreeAndNil(MapCellInfo.ObjList);
                  Break;
                end;
{$IFEND}
                Continue;
              end;
              try
                nCheckCode := 13;
                if (GameObject <> nil) and (GameObject.m_ObjGame = obj_Actor) then
                begin
                  BaseObject := TBaseObject(GameObject);
                  nCheckCode := 14;
                  if (not m_boDenyRefStatus) and ((MyGetTickCount - GameObject.m_dwAddTime) >= 60 * 1000) then
                  begin
{$IF USEOBJLIST = 1}
                    for Index := nIdx to Length(MapCellInfo.ObjList) - 2 do
                      MapCellInfo.ObjList[Index] := MapCellInfo.ObjList[Index + 1];

                    SetLength(MapCellInfo.ObjList, Length(MapCellInfo.ObjList) - 1);
                    if Length(MapCellInfo.ObjList) <= 0 then
                    begin
                      MapCellInfo.ObjList := nil;
                      Break;
                    end;
{$ELSE}
                    MapCellInfo.ObjList.Delete(nIdx);
                    if MapCellInfo.ObjList.Count <= 0 then
                    begin
                      FreeAndNil(MapCellInfo.ObjList);
                      Break;
                    end;
{$IFEND}
                    Continue;
                  end;
                  nCheckCode := 15;
                  if (BaseObject.m_PEnvir <> nil) and (BaseObject.m_PEnvir <> m_PEnvir) then
                  begin
{$IF USEOBJLIST = 1}
                    MainOutMessage(Format('%s(%d/%d) 发现非本地图角色(%s 所在地图:%s(%d/%d))', [m_PEnvir.sMapDesc, n18, n1C,
                      BaseObject.m_sCharName, BaseObject.m_PEnvir.sMapDesc, BaseObject.m_nCurrX, BaseObject.m_nCurrY]));

                    for Index := nIdx to Length(MapCellInfo.ObjList) - 2 do
                      MapCellInfo.ObjList[Index] := MapCellInfo.ObjList[Index + 1];

                    SetLength(MapCellInfo.ObjList, Length(MapCellInfo.ObjList) - 1);
                    if Length(MapCellInfo.ObjList) <= 0 then
                    begin
                      MapCellInfo.ObjList := nil;
                      Break;
                    end;
{$ELSE}
                    MapCellInfo.ObjList.Delete(nIdx);
                    if MapCellInfo.ObjList.Count <= 0 then
                    begin
                      FreeAndNil(MapCellInfo.ObjList);
                      Break;
                    end;
{$IFEND}
                    Continue;
                  end;
                  nCheckCode := 16;
                  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
                    boTempFixedHideMode := TSmartObject(BaseObject).m_dwChangeModeExTick[1] > 0
                  else
                    boTempFixedHideMode := False;

                  // H.ChangeModeEx 2 1000 主人看不到英雄 2019-04-26 10:37:30
                  if (not BaseObject.m_boGhost) and (not BaseObject.m_boFixedHideMode) and (BaseObject.m_PEnvir = m_PEnvir) and
                    (((not BaseObject.m_boObMode) and (not boTempFixedHideMode)) or (BaseObject.m_Master = Self)) then
                  begin
                    nCheckCode := 17;
                    if (m_btRaceServer < RC_ANIMAL) or (m_Master <> nil) or m_boCrazyMode or m_boWantRefMsg or
                    // 不明白为什么怪物攻击有主人的宝宝，必须得与主人相距3格以内 ????? chongchong 2018-05-29
                    // 修正 赤月恶魔 （RACE=115）的怪物，不攻击主人超过15格的近距离(3格以外)的法师英雄 chongchong 2018-05-29
                      ((BaseObject.m_Master <> nil) and (Abs(BaseObject.m_nCurrX - m_nCurrX) <= m_nViewRange) and
                      (Abs(BaseObject.m_nCurrY - m_nCurrY) <= m_nViewRange + m_nViewRangeExtY)) or
                      (BaseObject.m_btRaceServer = RC_PLAYOBJECT) or
                    // 不同国家怪物相互PK chongchong 2016-03-29
                      ((m_btNation > 0) and (BaseObject.m_btNation > 0) and m_boNoSameNationMonPK and
                      (m_btNation <> BaseObject.m_btNation)) then
                    begin
                      nCheckCode := 18;
                      UpdateVisibleGay(BaseObject);
                      nCheckCode := 19;
                    end;
                  end;
                end
                else if (GameObject <> nil) and (GameObject.m_ObjGame = Obj_Item) then
                begin
                  nCheckCode := 20;
                  if (m_btRaceServer in [RC_HEROOBJECT, RC_PLAYMOSTER]) or IsSlavePickItem then
                  begin
                    nCheckCode := 21;
                    ItemObject := TItemObject(GameObject);
                    nCheckCode := 22;
                    if not ItemObject.m_boGhost then
                    begin
                      nCheckCode := 23;
                      UpdateVisibleItem(n18, n1C, ItemObject);
                      nCheckCode := 24;
                    end;
                  end;
                end;
              except
                on E: Exception do
                begin
                  if nCheckCode = 13 then
                  begin
{$IF USEOBJLIST = 1}
                    for Index := nIdx to Length(MapCellInfo.ObjList) - 2 do
                      MapCellInfo.ObjList[Index] := MapCellInfo.ObjList[Index + 1];

                    SetLength(MapCellInfo.ObjList, Length(MapCellInfo.ObjList) - 1);
                    if Length(MapCellInfo.ObjList) <= 0 then
                    begin
                      MapCellInfo.ObjList := nil;
                      Break;
                    end;
{$ELSE}
                    MapCellInfo.ObjList.Delete(nIdx);
                    if MapCellInfo.ObjList.Count <= 0 then
                    begin
                      nCheckCode := 12;
                      FreeAndNil(MapCellInfo.ObjList);
                      Break;
                    end;
{$IFEND}
                  end
                  else
                  begin
                    MainOutMessage(Format(sExceptionMsg2, [nCheckCode, m_sCharName, m_sMapName, m_nCurrX, m_nCurrY, nCheckCode]));
                    MainOutMessage(E.Message);
                    KickException();
                  end;
                end;
              end;
              Inc(nIdx);
            end;
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            m_PEnvir.UnLockW;
        end;
{$IFEND}
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg2, [nCheckCode, m_sCharName, m_sMapName, m_nCurrX, m_nCurrY, nCheckCode]));
      MainOutMessage(E.Message);
      KickException();
    end;
  end;

  nCheckCode := 40;
  try
    m_VisibleActors.Lock;
    try
      for I := m_VisibleActors.Count - 1 downto 0 do
      begin
        VisibleBaseObject := m_VisibleActors[I].Item;
        if (VisibleBaseObject <> nil) and (VisibleBaseObject.nVisibleFlag = 0) then
        begin
          nCheckCode := 411;
          m_VisibleActors.Delete(I);
          nCheckCode := 413;
          Dispose(VisibleBaseObject);
          nCheckCode := 414;
        end;
      end;
    finally
      m_VisibleActors.UnLock;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg3, [nCheckCode, m_sCharName, m_sMapName, m_nCurrX, m_nCurrY, nCheckCode]));
      KickException();
    end;
  end;

  try
    if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) or IsSlavePickItem then
    begin
      m_VisibleItems.Lock;
      try
        for I := m_VisibleItems.Count - 1 downto 0 do
        begin
          VisibleMapItem := m_VisibleItems[I].Item;
          if (VisibleMapItem <> nil) and (VisibleMapItem.nVisibleFlag = 0) then
          begin
            m_VisibleItems.Delete(I);
            Dispose(VisibleMapItem);
          end;
        end;
      finally
        m_VisibleItems.UnLock;
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg4, [nCheckCode, m_sCharName, m_sMapName, m_nCurrX, m_nCurrY, nCheckCode]));
      KickException();
    end;
  end;
end;

