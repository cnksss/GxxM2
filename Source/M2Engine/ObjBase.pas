  nOldPKLevel: Integer;
begin
  nOldPKLevel := PKLevel;
  Inc(m_nPkPoint, nPoint);

  if (PKLevel <> nOldPKLevel) and (PKLevel <= 2) then
    RefNameColor;
end;

procedure TBaseObject.AddBodyLuck(dLuck: Double);
var
  n: Integer;
begin
  if (dLuck > 0) and (m_dBodyLuck < 5 * BODYLUCKUNIT) then
  begin
    m_dBodyLuck := m_dBodyLuck + dLuck;
  end;
  if (dLuck < 0) and (m_dBodyLuck > -(5 * BODYLUCKUNIT)) then
  begin
    m_dBodyLuck := m_dBodyLuck + dLuck;
  end;
  n := Trunc(m_dBodyLuck / BODYLUCKUNIT);
  if n > 5 then
    n := 5;
  if n < -10 then
    n := -10;
  m_nBodyLuckLevel := n;
end;

procedure TBaseObject.MakeWeaponUnlock;
begin
  // 英雄杀人不诅咒武器 chongchong 2016-04-19
  if (m_btRaceServer = RC_HEROOBJECT) and g_Config.boHeroKillHumanNotWeaponUnlock then
    Exit;
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    if TSmartObject(Self).m_UseItems[U_WEAPON].wIndex <= 0 then
      Exit;
    // 武器幸运 > 0, 先减幸运
    if TSmartObject(Self).m_UseItems[U_WEAPON].btValue[3] > 0 then
    begin
      Dec(TSmartObject(Self).m_UseItems[U_WEAPON].btValue[3]);
      SysMsg(g_sTheWeaponIsCursed, c_Red, t_Hint);
    end
    else
    begin
      // 再加诅咒
      if TSmartObject(Self).m_UseItems[U_WEAPON].btValue[4] < 10 then
      begin
        Inc(TSmartObject(Self).m_UseItems[U_WEAPON].btValue[4]);
        SysMsg(g_sTheWeaponIsCursed, c_Red, t_Hint);
      end;
    end;
  end;
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
  begin
    RecalcAbilitys();
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
      SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
      TPlayObject(Self).SendUpdateItem(@TSmartObject(Self).m_UseItems[U_WEAPON]);
    end;
  end;
end;

function TBaseObject.DamageHealth(nDamage: Integer; StruckFrom: TBaseObject; IsTriggerAttackDamage: Boolean): Integer; // 减血
var
  nSpdam, AttackPower: LongWord;
  boSelfMagicShield, boUnMagicShield: Boolean;
  nMagicShield, nMagicShieldAbsorbDamage: Double;
  Int64Value: Int64;
  IsDecMP: Boolean;
  TempLastHiter, TempCurrTarget, TempTargetCret: TBaseObject;
begin
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    boSelfMagicShield := TSmartObject(Self).m_boMagicShield or (Random(100) < m_btFluteStoneMagicShieldRate);
    nMagicShield := TSmartObject(Self).m_nMagicShield;
    nMagicShieldAbsorbDamage := TSmartObject(Self).m_nMagicShieldAbsorbDamage;
  end
  else
  begin
    boSelfMagicShield := False;
    nMagicShield := 150;
    nMagicShieldAbsorbDamage := 0;
  end;

  if (StruckFrom <> nil) and (StruckFrom.UnMagicShield) then
    boUnMagicShield := True
  else if (m_LastHiter <> nil) and (m_LastHiter.UnMagicShield) then
    boUnMagicShield := True
  else
    boUnMagicShield := False;

  if nMagicShieldAbsorbDamage > 0 then
  begin
    Int64Value := Round(Int64(nDamage) / 100 * Max(100 - nMagicShieldAbsorbDamage, 0));
    if Int64Value > High(Integer) then
      nDamage := High(Integer)
    else
      nDamage := Int64Value;

    if nDamage = 0 then
    begin
      Result := 0;
      Exit;
    end;
  end;

  if (g_FunctionNPC <> nil) and (StruckFrom <> nil) then
  begin
    TempLastHiter := StruckFrom.m_LastHiter;
    TempCurrTarget := StruckFrom.m_CurrTarget;
    TempTargetCret := StruckFrom.m_TargetCret;
    try
      StruckFrom.m_LastHiter := Self;
      StruckFrom.m_CurrTarget := Self;
      StruckFrom.m_TargetCret := Self;
      m_CurrTarget := StruckFrom;

      if StruckFrom.m_btRaceServer = RC_PLAYOBJECT then
      begin
        StruckFrom.m_nLastDamageValue := nDamage;
        TPlayObject(StruckFrom).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(StruckFrom), '@AttackDamage', False);
        nDamage := StruckFrom.m_nLastDamageValue;
      end
      else if (StruckFrom.m_btRaceServer = RC_HEROOBJECT) and (StruckFrom.m_Master <> nil) and
        (StruckFrom.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        StruckFrom.m_nLastDamageValue := nDamage;
        TPlayObject(StruckFrom.m_Master).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(StruckFrom.m_Master), '@HeroAttackDamage', False);
        nDamage := StruckFrom.m_nLastDamageValue;
      end
      else if (StruckFrom.m_Master <> nil) and (StruckFrom.m_Master.m_btRaceServer = RC_PLAYOBJECT) and (StruckFrom.m_boGamePet)
      then
      begin
        StruckFrom.m_nLastDamageValue := nDamage;
        TPlayObject(StruckFrom.m_Master).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(StruckFrom.m_Master), '@GamePetAttackDamage', False);
        nDamage := StruckFrom.m_nLastDamageValue;
      end
      else if (StruckFrom.m_Master <> nil) and (StruckFrom.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        StruckFrom.m_Master.m_nLastDamageValue := nDamage;
        TPlayObject(StruckFrom.m_Master).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(StruckFrom.m_Master), '@SlaveAttackDamage', False);
        nDamage := StruckFrom.m_Master.m_nLastDamageValue;
      end
    finally
      StruckFrom.m_LastHiter := TempLastHiter;
      StruckFrom.m_CurrTarget := TempCurrTarget;
      StruckFrom.m_TargetCret := TempTargetCret;
    end;
  end;

  if (StruckFrom <> nil) //
    and (nDamage > 0) //
    and (m_WAbil.MP > 0) //
    and g_Config.boSlaveKillHumanIncPK //
    and not(StruckFrom.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) //
    and (StruckFrom.m_Master <> nil) //
    and (StruckFrom.m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
    SetPKFlag(StruckFrom.m_Master { AttackBaseObject } );

  if (g_FunctionNPC <> nil) and (StruckFrom <> nil) then
  begin
    TempLastHiter := StruckFrom.m_LastHiter;
    TempCurrTarget := StruckFrom.m_CurrTarget;
    TempTargetCret := StruckFrom.m_TargetCret;
    try
      StruckFrom.m_LastHiter := Self;
      StruckFrom.m_CurrTarget := Self;
      StruckFrom.m_TargetCret := Self;
      m_CurrTarget := StruckFrom;

      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        m_nLastDamageValue := nDamage;
        TPlayObject(Self).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(Self), '@StruckDamage', False);
        nDamage := m_nLastDamageValue;
      end
      else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        m_nLastDamageValue := nDamage;
        TPlayObject(m_Master).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroStruckDamage', False);
        nDamage := m_nLastDamageValue;
      end
      else if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) and (m_boGamePet) then
      begin
        m_nLastDamageValue := nDamage;
        TPlayObject(m_Master).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@GamePetStruckDamage', False);
        nDamage := m_nLastDamageValue;
      end
      else if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        m_Master.m_nLastDamageValue := nDamage;
        TPlayObject(m_Master).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@SlaveStruckDamage', False);
        nDamage := m_Master.m_nLastDamageValue;
      end;
    finally
      StruckFrom.m_LastHiter := TempLastHiter;
      StruckFrom.m_CurrTarget := TempCurrTarget;
      StruckFrom.m_TargetCret := TempTargetCret;
    end;
  end;

  AttackPower := 0;
  if (not boUnMagicShield) and boSelfMagicShield and (nDamage > 0) and (m_WAbil.MP > 0) and (nMagicShield > 0) then
  begin
    // 掉蓝比例 chongchong 2014-05-16
    Int64Value := Round(Int64(nDamage) / 100 * Max(nMagicShield, 0));
    nSpdam := Min(Int64Value, High(LongWord));

    if (nSpdam > 0) and (StruckFrom <> nil) and (StruckFrom <> Self) then
    begin
      if StruckFrom.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
        SetPKFlag(StruckFrom { AttackBaseObject } );

      SetLastHiter(StruckFrom { AttackBaseObject } );
    end;

    IsDecMP := False;
    if LongWord(m_WAbil.MP) >= nSpdam then
    begin
      if nSpdam > 0 then
        IsDecMP := True;
      m_WAbil.MP := m_WAbil.MP - nSpdam;
    end
    else
    begin
      if m_WAbil.MP > 0 then
        IsDecMP := True;
      nSpdam := m_WAbil.MP;
      m_WAbil.MP := 0;
    end;

    if nSpdam > nDamage then
      nDamage := 0
    else
      nDamage := nDamage - nSpdam;

    AttackPower := nSpdam;
    // Result := nDamage;

    SendRefMsg(RM_HEALTHSPELLCHANGED_STRUCK, 0, -1, -1, 0, '', 0);
    if IsDecMP and (nDamage = 0) and g_Config.boMagicshieldStruck then
      SendRefMsg(RM_MAGICSHIELD_STRUCK, 0, 0, 0, NativeInt(m_LastHiter), '', 200);
  end;

  if nDamage > 0 then
  begin
    if m_WAbil.HP - nDamage > 0 then
    begin
      m_WAbil.HP := m_WAbil.HP - nDamage;
      AttackPower := AttackPower + nDamage;
      Result := nDamage;
    end
    else
    begin
      Result := m_WAbil.HP;
      m_WAbil.HP := 0;
      AttackPower := AttackPower + m_WAbil.HP;
    end;
  end
  else
  begin
    Int64Value := Int64(m_WAbil.HP) - nDamage;
    if Int64Value < m_WAbil.MaxHP then
    begin
      Result := nDamage;
      m_WAbil.HP := Int64Value;
    end
    else
    begin
      Result := m_WAbil.HP - m_WAbil.MaxHP;
      m_WAbil.HP := m_WAbil.MaxHP;
    end;
  end;

  if (AttackPower > 0) //
    and (StruckFrom <> nil) //
    and StruckFrom.m_boAbsorbMP //
    and (Random(100) < StruckFrom.m_nAbsorbMPRate) //
    and (StruckFrom.m_nAbsorbMPValue > 0) then
  begin
    nDamage := Round(AttackPower / 100 * StruckFrom.m_nAbsorbMPValue);
    if nDamage > 0 then
    begin
      StruckFrom.m_WAbil.MP := Min(StruckFrom.m_WAbil.MP + nDamage, StruckFrom.m_WAbil.MaxMP);
      StruckFrom.HealthSpellChanged();
    end;
  end;

  if (AttackPower > 0) //
    and (StruckFrom <> nil) //
    and StruckFrom.m_boAbsorbHP //
    and (Random(100) < StruckFrom.m_nAbsorbHPRate) //
    and (StruckFrom.m_nAbsorbHPValue > 0) then
  begin
    nDamage := Round(AttackPower / 100 * StruckFrom.m_nAbsorbHPValue);
    if nDamage > 0 then
    begin
      StruckFrom.m_WAbil.HP := Min(StruckFrom.m_WAbil.HP + nDamage, StruckFrom.m_WAbil.MaxHP);
      StruckFrom.HealthSpellChanged();
    end;
  end;
end;

function TBaseObject.CharPushed(nDir, nPushCount: Integer): Integer; // 冲撞人
var
  I, nX, nY, olddir, nBackDir: Integer;
begin
  Result := 0;
  if m_boDeath or m_boGhost then
    Exit;
  olddir := m_btDirection;
  m_btDirection := nDir;
  nBackDir := GetBackDir(nDir);
  for I := 0 to nPushCount - 1 do
  begin
    GetFrontPosition(nX, nY);
    if m_PEnvir.CanWalk(nX, nY, False) then
    begin
      if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nX, nY, False) then
      begin
        m_nCurrX := nX;
        m_nCurrY := nY;
        SendRefMsg(RM_PUSH, nBackDir, m_nCurrX, m_nCurrY, 0, '');
        Inc(Result);
        if m_btRaceServer >= RC_ANIMAL then
        begin
          // m_dwWalkTick := m_dwWalkTick
          m_nWalkDelay := 800;
          // 修正分身被推后前三刀攻击过快 2021-01-28
          if m_btRaceServer in [RC_PLAYMOSTER] then
            TSmartObject(Self).m_dwPushedTick := MyGetTickCount;
        end
        else if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
          TSmartObject(Self).m_dwPushedTick := MyGetTickCount;

        // 修复连击被中断后不能使用技能 2020-11-18 21:39:05
        if m_btRaceServer = RC_PLAYOBJECT then
        begin
          if TPlayObject(Self).m_boContinuous then
          begin
            TPlayObject(Self).m_boContinuous := False;
            SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
          end;
        end;
      end
      else
        Break;
    end
    else
      Break;
  end;
  m_btDirection := nBackDir;
  if Result = 0 then
    m_btDirection := olddir;
end;

function TBaseObject.CharPushed_Skill100(nDir, nPushCount: Integer): Integer; // 追心刺
var
  I, nX, nY, olddir, nBackDir: Integer;
begin
  Result := 0;
  if m_boDeath or m_boGhost then
    Exit;
  olddir := m_btDirection;
  m_btDirection := nDir;
  nBackDir := GetBackDir(nDir);
  for I := 0 to nPushCount - 1 do
  begin
    GetFrontPosition(nX, nY);
    if m_PEnvir.CanWalk(nX, nY, False) then
    begin
      if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nX, nY, False) then
      begin
        // 修正分身被推后前三刀攻击过快 2021-01-28
        if m_btRaceServer in [RC_PLAYMOSTER] then
        begin
          TSmartObject(Self).m_dwPushedTick := MyGetTickCount;
        end;
        m_nCurrX := nX;
        m_nCurrY := nY;
        // SendRefMsg(RM_PUSH, nBackDir, m_nCurrX, m_nCurrY, 0, '');
        Inc(Result);
        if m_btRaceServer >= RC_ANIMAL then
        begin
          // m_dwWalkTick := m_dwWalkTick;
          m_nWalkDelay := 800;
        end;
      end
      else
        Break;
    end
    else
      Break;
  end;
  m_btDirection := nBackDir;
  if Result = 0 then
    m_btDirection := olddir;
  // SendRefMsg(RM_TURN, m_btDirection, m_nCurrX, m_nCurrY, 0, '');
end;

function TBaseObject.MagPassThroughMagic(sX, sY, tx, ty, nDir, magpwr, wMagicID: Integer; undeadattack: Boolean;
  AttackDealy: Integer = 600): Integer; // 004C69F4
var
  I, tCount, acpwr, nPowerNG: Integer;
  BaseObject: TBaseObject;
  // n14,n18:integer;
begin
  tCount := 0;
  for I := 0 to 12 do
  begin
    BaseObject := TBaseObject(m_PEnvir.GetMovingObject(sX, sY, True));
    if BaseObject <> nil then
    begin
      if IsProperTarget(BaseObject) then
      begin
        if Random(10) >= BaseObject.m_nAntiMagic then
        begin
          if undeadattack then
            acpwr := Round(magpwr * 1.5)
          else
            acpwr := magpwr;
          if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
          begin
            nPowerNG := GetSkillLastPowerNG(acpwr, // 内功技能威力
              GetSkillAttackPowerNG(Self, TSmartObject(Self).m_UserMagics[wMagicID], acpwr),
              GetSkillDefensePowerNG(BaseObject, TSmartObject(Self).m_UserMagics[wMagicID], acpwr));
          end
          else
            nPowerNG := acpwr;
          nPowerNG := GetPowerRateAdd(BaseObject, nPowerNG);
          BaseObject.SendDelayMsg(Self, RM_MAGSTRUCK, 0, nPowerNG, 0, wMagicID, '', AttackDealy);
          // BaseObject.SendMsg(Self, RM_MAGSTRUCK, 0, acpwr, 0, 0, '');
          Inc(tCount);
        end;
      end;
    end;
    if not((Abs(sX - tx) <= 0) and (Abs(sY - ty) <= 0)) then
    begin
      nDir := GetNextDirection(sX, sY, tx, ty);
      if not m_PEnvir.GetNextPosition(sX, sY, nDir, 1, sX, sY) then
        Break;
    end
    else
      Break;
  end;
  Result := tCount;
end;

function TBaseObject.GetShowName(boSuperUser: Boolean): string;
var
  sShowName: string;
begin
  // 是否显示神秘人
  if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
  begin
    if TSmartObject(Self).m_boMysteriousMan and (not boSuperUser) and g_Config.boShowMysteriousMan then
    begin
      Result := g_Config.sMysteriousManName;
      Exit;
    end
    else if (m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and (not boSuperUser) and
      (Length(m_PEnvir.m_sSecretShowName) > 0) then
    begin
      Result := m_PEnvir.m_sSecretShowName;
      Exit;
    end
    else if (m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and (not boSuperUser) and
      (Length(m_PEnvir.m_sSecretShowName2) > 0) then
    begin
      Result := m_PEnvir.m_sSecretShowName2;
      Exit;
    end;
  end;
  if (m_Master <> nil) and (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
  begin
    if (m_PEnvir.m_nSecretFlag and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName) > 0) then
    begin
      Result := m_PEnvir.m_sSecretShowName;
      Exit;
    end
    else if (m_PEnvir.m_nSecretFlag2 and SecretFlag_ShowEqualName <> 0) and (Length(m_PEnvir.m_sSecretShowName2) > 0) then
    begin
      Result := m_PEnvir.m_sSecretShowName2;
      Exit;
    end
  end;
  sShowName := m_sCharName;
  // 人物或英雄的分身，不要过滤数字，因为名字可能全数字，过滤下没了 chongchong 2015-12-01
  if (Self is TCopyMon) and (Master <> nil) and (Master.m_btRaceServer = RC_PLAYOBJECT) then
  begin
    if g_Config.boShowCopySelfSuffix then
      Result := sShowName + g_Config.sCopySelfSuffix
    else
      Result := sShowName;
  end
  else
    Result := FilterShowName(sShowName);
  if (m_Master <> nil) and not m_Master.m_boObMode then
  begin
    // 分身不要显示主人的信息 chongchong 2015-11-09
    if not((m_btRaceServer = RC_PLAYMOSTER) and (Self is TCopyMon)) then
    begin
      // 修正带数字的人形怪召唤的宝宝，显示主人名带数字
      if (m_Master.m_btRaceServer = RC_PLAYMOSTER) and (m_Master is THumMon) then
        Result := Result + '(' + FilterShowName(m_Master.m_sCharName) + ')'
      else
      begin
        if m_boGamePet then
        begin
          if g_Config.boPetShowMasterName then
          begin
            sShowName := g_Config.sPetSuffixName;
            if (Length(sShowName) > 0) and (sShowName[Length(sShowName)] = '\') then
            begin
              sShowName := Copy(sShowName, 1, Length(sShowName) - 1);
              Result := Result + '\' + m_Master.m_sCharName + sShowName;
            end
            else
              Result := m_Master.m_sCharName + sShowName + ' ' + Result;
          end;
        end
        else
        begin
          if not m_boSlaveHideMasterName then
            Result := Result + '(' + m_Master.m_sCharName + ')';
        end;
      end;
    end;
  end
  // chongchong 怪物显示等级 2013-09-10
  else
  begin
    if (g_Config.btMonsterShowLevel = 1) and
      (not(m_btRaceServer in [RC_BOX, RC_BOX2, RC_GUARD, 55 { 练功师 } , RC_ARCHERGUARD, 110, 111])) then
    begin
      sShowName := g_Config.sMonsterShowFormat;
      sShowName := AnsiReplaceText(sShowName, '%d', IntToStr(m_Abil.Level));
      sShowName := AnsiReplaceText(sShowName, '%s', Result);
      Result := sShowName;
    end;
  end;
end;

