procedure TAnimalObject.Run;
begin
  inherited;
  {
    if (m_nAttackState > 0) and (m_TargetCret = nil) and (m_AroundPoint <> nil) and (Length(m_AroundPoint) > 1) then
    begin
    if m_boWalkWaitLocked then
    begin
    if (MyGetTickCount - m_dwWalkWaitTick) > m_dwWalkWait then
    begin
    m_boWalkWaitLocked := False;
    end;
    end;
    if not m_boWalkWaitLocked and (tick_diff(m_dwWalkTick, MyGetTickCount) > m_nWalkSpeed + m_nWalkDelay) then
    begin
    m_dwWalkTick := MyGetTickCount();
    m_nWalkDelay := 0;
    Inc(m_nWalkCount);
    if m_nWalkCount > m_nWalkStep then
    begin
    m_nWalkCount := 0;
    m_boWalkWaitLocked := True;
    m_dwWalkWaitTick := MyGetTickCount();
    end;
    if (m_nTargetX <> -1) then
    begin
    if ((m_nCurrX = m_nTargetX) and (m_nCurrY = m_nTargetY)) or (m_nAroundKeepCount > m_nAroundKeepMaxCount) then
    begin
    m_nTargetX := -1;
    end;
    end;
    if m_nTargetX = -1 then
    begin
    Inc(m_nAroundIndex);
    if m_nAroundIndex > High(m_AroundPoint) then m_nAroundIndex := 0;
    if m_nAroundIndex < 0 then m_nAroundIndex := 0;
    SetTargetXY(m_AroundPoint[m_nAroundIndex].X, m_AroundPoint[m_nAroundIndex].Y);
    m_nAroundKeepMaxCount := MAX(abs(m_nCurrX - m_nTargetX), abs(m_nCurrY - m_nTargetY));
    m_nAroundKeepMaxCount := m_nAroundKeepMaxCount + Round(m_nAroundKeepMaxCount * 0.5);
    m_nAroundKeepCount := 0;
    end;
    if m_nTargetX <> -1 then
    begin
    GotoTargetXY;
    Inc(m_nAroundKeepCount);
    end;
    end;
    end;
  }
end;

function TBaseObject.MakePosion(nType, nTime, nPoint: Integer; CheckOldTime: Boolean): Boolean;
var
  nOldCharStatus: Integer;
begin
  Result := False;

  // 增加防全麻 2019-12-27 23:11:16
  if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) //
    and (nType = POISON_STONE) //
    and (TSmartObject(Self).m_wChangeModeExValue[11] > 0) //
    and (Random(100) < TSmartObject(Self).m_wChangeModeExValue[11]) then
    Exit;

  nTime := Max(0, nTime);
  if nType < MAX_STATUS_ATTR then
  begin
    nOldCharStatus := m_nCharStatus;
    if CheckOldTime then
    begin
      if m_wStatusTimeArr[nType] > 0 then
      begin
        if m_wStatusTimeArr[nType] < nTime then
          m_wStatusTimeArr[nType] := nTime;
      end
      else
        m_wStatusTimeArr[nType] := nTime;
    end
    else
      m_wStatusTimeArr[nType] := nTime;

    m_dwStatusArrTick[nType] := MyGetTickCount();
    m_nCharStatus := GetCharStatus();

    // 修正当设置怪物封顶伤害时，绿毒不受限制 chongchong 2015-06-16
    if nType = POISON_DECHEALTH then
    begin
      // 因为中毒自动减血是+1，所以此处要减1: DamageHealth(m_nGreenPoisoningPoint + 1);
      nPoint := Max(0, GetAttackPowerMax(nPoint) - 1);
      m_nGreenPoisoningPoint := Max(nPoint, 0);
    end;

    if nOldCharStatus <> m_nCharStatus then
      StatusChanged();

    { TODO -ochongchong -c新增 : 添加英雄中毒提示 【2013-08-16】 }
    if g_Config.boShowYouPoisoned and (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (nTime > 0) then
    begin
      if nType = POISON_STONE then
        SysMsg(Format(sYouParaly, [nTime, nPoint]), c_Red, t_Hint)
      else if nType in [POISON_DAMAGEARMOR, POISON_DECHEALTH] then
        SysMsg(Format(sYouPoisoned, [nTime, nPoint]), c_Red, t_Hint)
    end;

    // 修复连击被中断后不能使用技能 2020-11-18 21:39:05
    if nType = POISON_STONE then
    begin
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        if TPlayObject(Self).m_boContinuous then
        begin
          TPlayObject(Self).m_boContinuous := False;
          SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
        end;
      end;
    end;

    // 挂机受到绿毒攻击 chongchong 2018-05-07
    if (m_btRaceServer = RC_PLAYOBJECT) //
      and (TPlayObject(Self).m_boAutoOnline) //
      and (nType = POISON_DECHEALTH) //
      and (m_PoisonHitter <> nil) //
      and ((m_PoisonHitter.m_btRaceServer = RC_PLAYOBJECT) or ((m_PoisonHitter.Master <> nil) and
      (m_PoisonHitter.Master.m_btRaceServer = RC_PLAYOBJECT))) then
      SendMsg(Self, RM_POISON_STRUCK_HUM, 0, 0, 0, 0, '');

    Result := True;
  end;
end;

function TBaseObject.MakeFrozen(nTime: Integer; CheckOldTime: Boolean): Boolean; // 冰冻
var
  nOldCharStatus: Integer;
begin
  nOldCharStatus := m_nCharStatus;
  nTime := Max(0, nTime);

  if CheckOldTime then
  begin
    if m_wStatusTimeArr[STATE_FROZEN] > 0 then
    begin
      if m_wStatusTimeArr[STATE_FROZEN] < nTime then
        m_wStatusTimeArr[STATE_FROZEN] := nTime;
    end
    else
      m_wStatusTimeArr[STATE_FROZEN] := nTime;
  end
  else
    m_wStatusTimeArr[STATE_FROZEN] := nTime;

  m_dwStatusArrTick[STATE_FROZEN] := MyGetTickCount();
  m_nCharStatus := GetCharStatus();

  if nOldCharStatus <> m_nCharStatus then
    StatusChanged();

  if ((m_btRaceServer = RC_PLAYOBJECT) or (m_btRaceServer = RC_HEROOBJECT)) and (nTime > 0) then
    SysMsg(StringReplace(g_sSetFrozen, '%d', IntToStr(nTime), []), c_Red, t_Hint);

  Result := True;

  // 修复连击被中断后不能使用技能 2020-11-18 21:39:05
  if m_btRaceServer = RC_PLAYOBJECT then
  begin
    if TPlayObject(Self).m_boContinuous then
    begin
      TPlayObject(Self).m_boContinuous := False;
      SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
    end;
  end;
end;

function TBaseObject.MakePosionEx(nType, nTime, nPoint: Integer; nPointType: Integer): Boolean;
var
  nOldCharStatus: Integer;
begin
  Result := False;
  // 增加防全麻 2019-12-27 23:11:16
  if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (nType = POISON_STONE) then
  begin
    if (TSmartObject(Self).m_wChangeModeExValue[11] > 0) and (Random(100) < TSmartObject(Self).m_wChangeModeExValue[11]) then
    begin
      Exit;
    end;
  end;
  if nType < MAX_STATUS_ATTR then
  begin
    nOldCharStatus := m_nCharStatus;
    if nType = 5 then
    begin
      if m_wStatusTimeArr[nType] > 0 then
      begin
        if m_wStatusTimeArr[nType] < nTime then
        begin
          m_wStatusTimeArr[nType] := nTime;
        end;
      end
      else
      begin
        m_wStatusTimeArr[nType] := nTime;
      end;
      m_dwStatusArrTick[nType] := MyGetTickCount();
    end
    else
    begin
      if m_nStatusPowerTime[nType] > 0 then
      begin
        if m_nStatusPowerTime[nType] < nTime then
        begin
          m_nStatusPowerTime[nType] := nTime;
        end;
      end
      else
      begin
        m_nStatusPowerTime[nType] := nTime;
      end;
      m_dwStatusPowerTick[nType] := MyGetTickCount();
    end;
    m_nCharStatus := GetCharStatus();
    m_nStatusPower[nType] := Max(nPoint, 0);
    if nType in [POISON_DECHEALTH, POISON_DAMAGEARMOR] then
      m_nStatusPowerType[nType] := nPointType;
    if nOldCharStatus <> m_nCharStatus then
      StatusChanged();
    if (m_btRaceServer = RC_PLAYOBJECT) and g_Config.boShowYouPoisoned then
    begin
      if nType = POISON_STONE then
        SysMsg(Format(sYouParaly, [nTime, nPoint]), c_Red, t_Hint)
      else if nType in [POISON_DECHEALTH, POISON_DAMAGEARMOR] then
      begin
        if nPointType = 0 then
          SysMsg(Format(sYouPoisoned, [nTime, nPoint]), c_Red, t_Hint)
        else
          SysMsg(Format(sYouPoisoned_Ex, [nTime, nPoint]), c_Red, t_Hint)
      end;
    end;
    Result := True;
    // 修复连击被中断后不能使用技能 2020-11-18 21:39:05
    if nType = POISON_STONE then
    begin
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        if TPlayObject(Self).m_boContinuous then
        begin
          TPlayObject(Self).m_boContinuous := False;
          SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
        end;
      end;
    end;
  end;
end;

