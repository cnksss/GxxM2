  function DodgePoint(nRange: Integer; boLineAttatck, boCanUseAttackMagic: Boolean): TPath; // 躲避
    function GetWalkPath(nTargetX, nTargetY: Integer; var nRunMonCount: Integer): TPath;
    var
      btDir: Byte;
      nCurrX: Integer;
      nCurrY: Integer;
      nX, nY: Integer;
    begin
      // 修正假人躲避走位 chongchong 2018-05-24
      nCurrX := m_nCurrX;
      nCurrY := m_nCurrY;
      nX := m_nCurrX;
      nY := m_nCurrY;
      Result := nil;
      nRunMonCount := 0;
      btDir := GetNextDirection(nTargetX, nTargetX, m_nCurrX, m_nCurrY);
      while True do
      begin
        if (Abs(nCurrX - nTargetX) >= 2) or (Abs(nCurrY - nTargetY) >= 2) then
        begin
          if m_PEnvir.GetNextPosition(nCurrX, nCurrY, btDir, 2, nX, nY) and CanRun(nCurrX, nCurrY, nX, nY) then
          begin
            Inc(nRunMonCount, GetRangeTargetCount(nTargetX, nTargetY, 1));
            { Inc(nRunMonCount, m_PEnvir.GetXYObjCount(nX, nY));
              if m_PEnvir.GetNextPosition(nCurrX, nCurrY, btDir, 1, nX1, nY1) then begin
              Inc(nRunMonCount, m_PEnvir.GetXYObjCount(Self, nX1, nY1));
              end; }
            nCurrX := nX;
            nCurrY := nY;
            SetLength(Result, Length(Result) + 1);
            Result[Length(Result) - 1] := Point(nX, nY);
          end
          else
          begin
            // SetLength(WalkPaths, 0);
            Result := nil;
            Break;
          end;
        end
        else
        begin
          if m_PEnvir.GetNextPosition(nCurrX, nCurrY, btDir, 1, nX, nY) and m_PEnvir.CanWalkEx2(Self, nX, nY, False) then
          begin
            // Inc(nRunMonCount, m_PEnvir.GetXYObjCount(Self, nX, nY));
            Inc(nRunMonCount, GetRangeTargetCount(nTargetX, nTargetY, 1));
            nCurrX := nX;
            nCurrY := nY;
            SetLength(Result, Length(Result) + 1);
            Result[Length(Result) - 1] := Point(nX, nY);
          end
          else
          begin
            // SetLength(WalkPaths, 0);
            Result := nil;
            Break;
          end;
        end;
        if btDir <> GetNextDirection(nCurrX, nCurrY, nTargetX, nTargetY) then
          Break;
      end;
    end;

  var
    I, II, nMaxStep, nMinStep: Integer;
    btNextDir: Byte;
    nTargetX, nTargetY: Integer;
    MapWalkPoint: pTMapWalkPoint;
    WalkDirArray: array [0 .. 7, 1 .. 10] of TMapWalkPoint;
    // WalkStep2: array[0..7] of array[1..8] of TMapWalkPoint;
    SortList: TSortStringList;
    NotMonSortList: TSortStringList;
    nDir1, nIndex: Integer;
    btArrDirs: array [0 .. 6] of Integer;
  begin
    Result := nil;
    if m_TargetCret = nil then
      Exit;
    if Self is TCopyMon then
    begin
      nDir1 := GetNextDirection(m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY, m_nCurrX, m_nCurrY);
      if (nDir1 in [0, 2, 4, 6]) then
      begin
        btArrDirs[0] := (nDir1 + 1) mod 8;
        btArrDirs[1] := (nDir1 + 2) mod 8;
        btArrDirs[2] := (nDir1 + 6) mod 8;
        btArrDirs[3] := (nDir1 + 0) mod 8;
        btArrDirs[4] := (nDir1 + 7) mod 8;
        btArrDirs[5] := (nDir1 + 3) mod 8;
        btArrDirs[6] := (nDir1 + 5) mod 8;
        for nIndex := Low(btArrDirs) to High(btArrDirs) do
        begin
          nTargetX := m_nCurrX;
          nTargetY := m_nCurrY;
          if GetRuntoXY(btArrDirs[nIndex], nTargetX, nTargetY) then
          begin
            if CanRun(nTargetX, nTargetY, False) then
            begin
              SetLength(Result, 1);
              Result[0].X := nTargetX;
              Result[0].Y := nTargetY;
              m_boLastAvoidTarget := True;
              m_boAvoidTargetFirst := True;
              m_btAvoidTargetDir := btArrDirs[nIndex];
              {
                // MB的，又要参考LEG，躲避目标连续2次，围绕目标 chongchong 2018-07-20 22:55:28
                nDir1 := (btArrDirs[nIndex] + 1) mod 8;
                if GetRuntoXY(nDir1, nTargetX, nTargetY) then
                begin
                if CanRun(nTargetX, nTargetY, False) then
                begin
                SetLength(Result, 2);
                Result[1].X := nTargetX;
                Result[1].Y := nTargetY;
                end
                else if m_PEnvir.CanWalk(nTargetX, nTargetY, False) then
                begin
                SetLength(Result, 2);
                Result[1].X := nTargetX;
                Result[1].Y := nTargetY;
                end;
                end;
              }
              Break;
            end;
          end;
        end;
      end
      else
      begin
        btArrDirs[0] := (nDir1 + 2) mod 8;
        btArrDirs[1] := (nDir1 + 1) mod 8;
        btArrDirs[2] := (nDir1 + 0) mod 8;
        btArrDirs[3] := (nDir1 - 2 + 8) mod 8;
        btArrDirs[4] := (nDir1 - 1 + 8) mod 8;
        btArrDirs[5] := (nDir1 + 3) mod 8;
        btArrDirs[6] := (nDir1 - 3 + 8) mod 8;
        for nIndex := Low(btArrDirs) to High(btArrDirs) do
        begin
          nTargetX := m_nCurrX;
          nTargetY := m_nCurrY;
          if GetRuntoXY(btArrDirs[nIndex], nTargetX, nTargetY) then
          begin
            if CanRun(nTargetX, nTargetY, False) then
            begin
              SetLength(Result, 1);
              Result[0].X := nTargetX;
              Result[0].Y := nTargetY;
              m_boLastAvoidTarget := True;
              m_boAvoidTargetFirst := True;
              m_btAvoidTargetDir := btArrDirs[nIndex];
              {
                // MB的，又要参考LEG，躲避目标连续2次，围绕目标 chongchong 2018-07-20 22:55:28
                nDir1 := (btArrDirs[nIndex] + 1) mod 8;
                if GetRuntoXY(nDir1, nTargetX, nTargetY) then
                begin
                if CanRun(nTargetX, nTargetY, False) then
                begin
                SetLength(Result, 2);
                Result[1].X := nTargetX;
                Result[1].Y := nTargetY;
                end
                else if m_PEnvir.CanWalk(nTargetX, nTargetY, False) then
                begin
                SetLength(Result, 2);
                Result[1].X := nTargetX;
                Result[1].Y := nTargetY;
                end;
                end;
              }
              Break;
            end;
          end;
        end;
      end;
    end
    else
    begin
      SortList := TSortStringList.Create;
      NotMonSortList := TSortStringList.Create;
      if m_btRaceServer = RC_MOONOBJECT then
      begin
        nMaxStep := 4;
        nMinStep := 2;
      end
      else
      begin
        nMaxStep := 4;
        nMinStep := 2;
      end;
      btNextDir := m_nLastDir;
      for I := 0 to 7 do
      begin
        if m_boDir then
          btNextDir := GetNextDirection(btNextDir)
        else
          btNextDir := GetPrevDirection(btNextDir);
        for II := nMaxStep downto nMinStep do
        begin
          if m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, btNextDir, II, nTargetX, nTargetY) and
            CanAttatckTarget(nTargetX, nTargetY, Max(Abs(nTargetX - m_TargetCret.m_nCurrX), Abs(nTargetY - m_TargetCret.m_nCurrY)
            ), boLineAttatck) then
          begin
            // nError := 4;
            // WalkPath:=GetWalkPath(nTargetX, nTargetY);
            // nError := 5;
            MapWalkPoint := @WalkDirArray[I, II];
            // nError := 6;
            MapWalkPoint.nRange := II;
            MapWalkPoint.Path := GetWalkPath(nTargetX, nTargetY, MapWalkPoint.nRunMonCount);
            // nError := 8;
            MapWalkPoint.nWalkStep := Length(MapWalkPoint.Path);
            // nError := 9;
            MapWalkPoint.nMonCount := GetNearTargetCount(nTargetX, nTargetY);
            MapWalkPoint.nMonRange := Abs(nTargetX - m_TargetCret.m_nCurrX) + Abs(nTargetY - m_TargetCret.m_nCurrY);
            // nError := 10;
            MapWalkPoint.nDir := btNextDir;
            MapWalkPoint.boDir := m_boDir;
            // nError := 11;
            if MapWalkPoint.nWalkStep > 0 then
            begin
              // nError := 12;
              SortList.AddObject(IntToStr(MapWalkPoint.nMonCount + MapWalkPoint.nRunMonCount), TObject(MapWalkPoint));
              // - MapWalkPoint.nWalkStep- (MapWalkPoint.nStep - MapWalkPoint.nWalkStep)
              // nError := 13;
              if MapWalkPoint.nMonCount <= 0 then
              begin
                NotMonSortList.AddObject(IntToStr(MapWalkPoint.nRunMonCount), TObject(MapWalkPoint));
              end;
              // nError := 15;
            end;
          end;
        end;
      end;
      // False 从小到大
      // True 从大到小
      // nError := 110;
      SortList.NumberSort(False);
      NotMonSortList.NumberSort(False);
      // nError := 120;
      if NotMonSortList.Count > 0 then
      begin
        // nError := 130;
        MapWalkPoint := pTMapWalkPoint(NotMonSortList.Objects[0]);
        m_nLastDir := MapWalkPoint.nDir;
        m_boDir := MapWalkPoint.boDir;
        Result := MapWalkPoint.Path;
        // nError := 140;
        // MainOutMessage(Format('1 NotMonSortList.Count:%s %d', [m_sCharName, Length(Result), MapWalkPoint.nRange]));
      end
      else if (SortList.Count > 0) then
      begin
        // nError := 180;
        MapWalkPoint := pTMapWalkPoint(SortList.Objects[0]);
        m_nLastDir := MapWalkPoint.nDir;
        m_boDir := MapWalkPoint.boDir;
        Result := MapWalkPoint.Path;
        // MainOutMessage(Format('2 SortList.Count:%s %d', [m_sCharName, Length(Result), MapWalkPoint.nRange]));
        // nError := 190;
      end;
      SortList.Free;
      NotMonSortList.Free;
      if m_nLastDir = m_nOLastDir then
        Inc(m_nMoveSameCount)
      else
        m_nMoveSameCount := 0;
      m_nOLastDir := m_nLastDir;
    end;
  end;
  function ChasePoint(nRange: Integer; boLineAttatck, boCanUseAttackMagic: Boolean): TPath; // 追
  var
    I: Integer;
    WalkStep: TWalkStep;
    nTargetX, nTargetY: Integer;
    SortPointList: TSortStringList;
    MapWalkPoint: pTMapWalkPoint;
  label
    LoopAll;
  begin
    Result := nil;
    if m_TargetCret = nil then
      Exit;
    if m_PEnvir = nil then
      Exit;
    SortPointList := TSortStringList.Create;
    FillChar(WalkStep, SizeOf(TWalkStep), 0);
  LoopAll:
    for I := 0 to 7 do
    begin
      if m_TargetCret = nil then
        Continue;
      if m_PEnvir.GetNextPosition(m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY, I, nRange, nTargetX, nTargetY) and
        CanAttatckTarget(nTargetX, nTargetY, nRange, boLineAttatck) then
      begin
        MapWalkPoint := @WalkStep[I];
        g_FindPath.BaseObject := Self;
        MapWalkPoint.Path := g_FindPath.FindPath1(m_PEnvir, m_nCurrX, m_nCurrY, nTargetX, nTargetY,
          m_btRaceServer <> RC_MOONOBJECT, False);
        MapWalkPoint.nWalkStep := Length(MapWalkPoint.Path);
        if MapWalkPoint.nWalkStep > 0 then
        begin
          MapWalkPoint.nMonRange := Abs(nTargetX - m_TargetCret.m_nCurrX) + Abs(nTargetY - m_TargetCret.m_nCurrY);
          MapWalkPoint.nMonCount := GetNearTargetCount(nTargetX, nTargetY);
          MapWalkPoint.nMasterRange := GetMasterRange(nTargetX, nTargetY);
          MapWalkPoint.nX := nTargetX;
          MapWalkPoint.nY := nTargetY;
          SortPointList.AddObject(IntToStr(MapWalkPoint.nWalkStep + MapWalkPoint.nMasterRange + MapWalkPoint.nMonCount),
            TObject(MapWalkPoint));
        end;
      end;
    end;
    Dec(nRange);
    if (SortPointList.Count <= 0) and (nRange > 0) then
    begin
      goto LoopAll;
      Exit;
    end;
    SortPointList.NumberSort(False); // False 最小值在Objecs[0]降序
    if SortPointList.Count > 0 then
    begin
      MapWalkPoint := pTMapWalkPoint(SortPointList.Objects[0]);
      Result := MapWalkPoint.Path;
    end;
    SortPointList.Free;
  end;
  function RefreshPoint(nRange: Integer; boLineAttatck, boCanUseAttackMagic: Boolean): TPath; // 跑位
  var
    I, J, nStep, nTempStep: Integer;
    btDir: Byte;
    nTargetX, nTargetY: Integer;
    MapWalkPoint: TMapWalkPoint;
    boDir: Boolean;
    nLoop: Integer;
    boOK: Boolean;
  label
    LoopAll, Loop;
  begin
    Result := nil;
    if (m_TargetCret = nil) or (m_PEnvir = nil) then
      Exit;
    nStep := 3;
    FillChar(MapWalkPoint, SizeOf(TMapWalkPoint), 0);
    // 修正分身乱跑位 chongchong 2016-05-12
    if (boCanUseAttackMagic and boLineAttatck) and (Self is TCopyMon) then
    begin
      if (m_nCurrX = m_TargetCret.m_nCurrX) or (m_nCurrY = m_TargetCret.m_nCurrY) or
        (Abs(m_nCurrX - m_TargetCret.m_nCurrX) = Abs(m_nCurrY - m_TargetCret.m_nCurrY)) then
      begin
        Exit;
      end;
      // 修正方向
      btDir := GetNextDirection(m_nCurrX, m_nCurrY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY);
      boDir := False;
      for nTempStep := 1 to 3 do
      begin
        for I := -nTempStep to nTempStep do
        begin
          for J := -nTempStep to nTempStep do
          begin
            nTargetX := m_nCurrX + I;
            nTargetY := m_nCurrY + J;
            if (nTargetX = m_TargetCret.m_nCurrX) or (nTargetY = m_TargetCret.m_nCurrY) or
              (Abs(nTargetX - m_TargetCret.m_nCurrX) = Abs(nTargetY - m_TargetCret.m_nCurrY)) then
            begin
              g_FindPath.BaseObject := Self;
              MapWalkPoint.Path := g_FindPath.FindPath1(m_PEnvir, m_nCurrX, m_nCurrY, nTargetX, nTargetY,
                m_btRaceServer <> RC_MOONOBJECT, False);
              MapWalkPoint.nWalkStep := Length(MapWalkPoint.Path);
              if MapWalkPoint.nWalkStep > 0 then
              begin
                MapWalkPoint.nDir := btDir;
                m_nLastDir := MapWalkPoint.nDir;
                m_boDir := boDir;
                Result := MapWalkPoint.Path;
                Exit;
              end;
            end;
          end;
        end;
      end;
    end;
    if not(m_nLastDir in [DR_UPLEFT, DR_UPRIGHT, DR_DOWNRIGHT, DR_DOWNLEFT]) then
    begin
      if (m_Master = nil) then
      begin
        btDir := GetNextDirection(m_nCurrX, m_nCurrY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY);
      end
      else
      begin
        if m_boProtectStatus then
        begin
          btDir := GetNextDirection(m_nCurrX, m_nCurrY, m_nProtectTargetX, m_nProtectTargetY);
        end
        else
        begin
          if (Abs(m_nCurrX - m_Master.m_nCurrX) <= m_Master.m_nViewRange div 2) and
            (Abs(m_Master.m_nCurrY - m_nCurrY) <= m_Master.m_nViewRange div 2) then
            btDir := GetNextDirection(m_nCurrX, m_nCurrY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY)
          else
            btDir := GetNextDirection(m_nCurrX, m_nCurrY, m_Master.m_nCurrX, m_Master.m_nCurrY);
        end;
      end;
      if not(btDir in [DR_UPLEFT, DR_UPRIGHT, DR_DOWNRIGHT, DR_DOWNLEFT]) then
      begin
        case btDir of
          DR_LEFT:
            btDir := DR_DOWNLEFT;
          DR_UP:
            btDir := DR_UPLEFT;
          DR_RIGHT:
            btDir := DR_UPRIGHT;
          DR_DOWN:
            btDir := DR_DOWNRIGHT;
        end;
      end;
      m_nLastDir := btDir;
    end;
  LoopAll:
    boDir := m_boDir;
    nLoop := 0;
  Loop:
    Inc(nLoop);
    if boDir then
    begin
      boOK := False;
      btDir := GetNextDirectionRight4(m_nLastDir);
      for I := 0 to 7 do
      begin
        if m_PEnvir.GetNextPosition(m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY, I, nStep, nTargetX, nTargetY) then
        begin
          if GetNextDirection(m_nCurrX, m_nCurrY, nTargetX, nTargetY) = btDir then
          begin
            // MainOutMessage(Format('3 %s nStep:%d Dir:%d nRange:%d nNewX:%d nNewY:%d nTargetX:%d nTargetY:%d', [m_sCharName, nStep, btDir, nRange, nTargetX, nTargetY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY]));
            if CanAttatckTarget(nTargetX, nTargetY, nRange, boLineAttatck) then
            begin
              // MainOutMessage(Format('4 %s nStep:%d Dir:%d nRange:%d nNewX:%d nNewY:%d nTargetX:%d nTargetY:%d', [m_sCharName, nStep, btDir, nRange, nTargetX, nTargetY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY]));
              g_FindPath.BaseObject := Self;
              MapWalkPoint.Path := g_FindPath.FindPath1(m_PEnvir, m_nCurrX, m_nCurrY, nTargetX, nTargetY,
                m_btRaceServer <> RC_MOONOBJECT, False);
              MapWalkPoint.nWalkStep := Length(MapWalkPoint.Path);
              if MapWalkPoint.nWalkStep > 0 then
              begin
                MapWalkPoint.nDir := btDir;
                boOK := True;
              end;
            end;
            Break;
          end;
        end;
      end;
      if not boOK then
      begin
        boDir := False;
        if nLoop < 2 then
        begin
          goto Loop;
          Exit;
        end;
      end;
    end
    else
    begin
      boOK := False;
      btDir := GetNextDirectionLeft4(m_nLastDir);
      for I := 0 to 7 do
      begin
        if m_PEnvir.GetNextPosition(m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY, I, nStep, nTargetX, nTargetY) then
        begin
          if GetNextDirection(m_nCurrX, m_nCurrY, nTargetX, nTargetY) = btDir then
          begin
            // MainOutMessage(Format('3 %s nStep:%d Dir:%d nRange:%d nNewX:%d nNewY:%d nTargetX:%d nTargetY:%d', [m_sCharName, nStep, btDir, nRange, nTargetX, nTargetY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY]));
            if CanAttatckTarget(nTargetX, nTargetY, nRange, boLineAttatck) then
            begin
              // MainOutMessage(Format('4 %s nStep:%d Dir:%d nRange:%d nNewX:%d nNewY:%d nTargetX:%d nTargetY:%d', [m_sCharName, nStep, btDir, nRange, nTargetX, nTargetY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY]));
              g_FindPath.BaseObject := Self;
              MapWalkPoint.Path := g_FindPath.FindPath1(m_PEnvir, m_nCurrX, m_nCurrY, nTargetX, nTargetY,
                m_btRaceServer <> RC_MOONOBJECT, False);
              MapWalkPoint.nWalkStep := Length(MapWalkPoint.Path);
              if MapWalkPoint.nWalkStep > 0 then
              begin
                MapWalkPoint.nDir := btDir;
                boOK := True;
              end;
            end;
            Break;
          end;
        end;
      end;
      if not boOK then
      begin
        boDir := True;
        if nLoop < 2 then
        begin
          goto Loop;
          Exit;
        end;
      end;
    end;
    Dec(nStep);
    if (MapWalkPoint.nWalkStep <= 0) and (nStep > 0) then
    begin
      goto LoopAll;
      Exit;
    end;
    if MapWalkPoint.nWalkStep > 0 then
    begin
      m_nLastDir := MapWalkPoint.nDir;
      m_boDir := boDir;
      Result := MapWalkPoint.Path;
      // MainOutMessage(Format('OK %s nStep:%d %s', [m_sCharName, nStep, BoolToStr(boDir)]));
    end;
  end;

var
  nRange: Integer;
  boChaseMon: Boolean; // 需要追杀
  boDodgeMon: Boolean; // 需要躲避
  boLineAttatck: Boolean; // 需要直线攻击
  boNeedLineAttatck: Boolean; // 需要直线攻击
  boCanUseAttackMagic: Boolean;
  boNeedMove: Boolean; // 需要跑位
  GameEvent: TGameEvent;
  NearTargetRange: Integer;
  boCanAvoid: Boolean;
  nDir1: Integer;
  nTargetX, nTargetY: Integer;
begin
  Result := nil;
  if m_TargetCret = nil then
    Exit;
  if ((m_btJob = 0) and (not MotaeboPos)) or (m_btJob <> 0) then
  begin
    boCanUseAttackMagic := CanUseAttackMagic;
    boChaseMon := False; // 需要追杀
    boDodgeMon := False; // 需要躲避
    boLineAttatck := False; // 需要直线攻击
    boNeedLineAttatck := False; // 需要直线攻击
    // 修正分身躲避速度巨慢，每次在原地停留时间过长 chongchong 2018-06-02
    if Self is TCopyMon then
      boNeedMove := (MyGetTickCount - m_dwStationTick >= 2000) and (GetNearTargetCount(1) > 0)
    else
      boNeedMove := (MyGetTickCount - m_dwStationTick >= 6000) and (GetNearTargetCount(1) > 0);
    // MainOutMessage(m_sCharName + ' ' + IntToStr(MyGetTickCount - m_LastHiterTick));
    nRange := 1;
    boCanAvoid := False;
    if (m_btJob = 0) then
    begin
      boLineAttatck := True;
      if (wMagicID = 66) or (wMagicID = 56) then
        nRange := 4; // wMagicID = 56   逐日剑法  (wMagicID = 66)开天斩
      if (wMagicID = 12) then
        nRange := 2;
      if (wMagicID in [60]) then
        nRange := 6;
      // boLineAttatck := not (wMagicID in [61, 62]);

      if not((wMagicID in [61, 62]) or CanLineAttack(nRange)) then
        boNeedLineAttatck := True; // 需要直线攻击

      // 都在战士攻击范围内。还搞毛 chongchong 2015-11-26
      if (Abs(m_TargetCret.m_nCurrX - m_nCurrX) > nRange) or (Abs(m_TargetCret.m_nCurrY - m_nCurrY) > nRange) then
        boChaseMon := True
      else
        Exit;
    end
    else
    begin
      NearTargetRange := 2;
      if Self is TCopyMon then
      begin
        boCanAvoid := (not m_boLastAvoidTarget);
        // MB的，又要参考LEG，躲避目标连续2次，围绕目标 chongchong 2018-07-20 22:55:28
        if (not m_boLastAvoidTarget) and m_boAvoidTargetFirst then
        begin
          nDir1 := (m_btAvoidTargetDir + 1) mod 8;
          nTargetX := m_nCurrX;
          nTargetY := m_nCurrY;
          if GetRuntoXY(nDir1, nTargetX, nTargetY) then
          begin
            if CanRun(nTargetX, nTargetY, False) then
            begin
              SetLength(Result, 1);
              Result[0].X := nTargetX;
              Result[0].Y := nTargetY;
            end
            else if m_PEnvir.CanWalk(nTargetX, nTargetY, False) then
            begin
              SetLength(Result, 1);
              Result[0].X := nTargetX;
              Result[0].Y := nTargetY;
            end;
          end;
          m_boAvoidTargetFirst := False;
          m_boIsAvoid := True;
          Exit;
        end;
      end
      else
        boCanAvoid := True;
      if not boCanUseAttackMagic then
      begin
        if (Self is TCopyMon) and (m_btJob = 2) and
          (g_Config.boCopyMonWarrorAttack or (g_Config.boCopyMon700HPUseBaseAttack and (m_TargetCret.m_WAbil.MaxHP < 700))) then
        begin
          boDodgeMon := False;
          if ((Abs(m_TargetCret.m_nCurrX - m_nCurrX) > 1) or (Abs(m_TargetCret.m_nCurrY - m_nCurrY) > 1)) then
            boChaseMon := True; // 需要追杀
          if not CanLineAttack(1) then
            boNeedLineAttatck := True; // 需要直线攻击
          boLineAttatck := True;
        end
        else
        begin
          if (not g_Config.boWarrorAttack) and (GetNearTargetCount(NearTargetRange) > 0) and boCanAvoid then
            boDodgeMon := True; // 需要躲避
          if g_Config.boWarrorAttack and ((Abs(m_TargetCret.m_nCurrX - m_nCurrX) > 1) or
            (Abs(m_TargetCret.m_nCurrY - m_nCurrY) > 1)) then
            boChaseMon := True; // 需要追杀
          if g_Config.boWarrorAttack and (not CanLineAttack(1)) then
            boNeedLineAttatck := True; // 需要直线攻击
          boLineAttatck := True;
        end;
      end
      else
      begin
        if (GetNearTargetCount(NearTargetRange) > 0) and boCanAvoid then
          boDodgeMon := True; // 需要躲避
        if (Abs(m_TargetCret.m_nCurrX - m_nCurrX) > 10) or (Abs(m_TargetCret.m_nCurrY - m_nCurrY) > 10) then
        begin
          nRange := 6;
          boChaseMon := True; // 需要追杀
        end;
      end;
      if (wMagicID in [SKILL_FIRECHARM, SKILL_FIREBALL, SKILL_FIREBALL2]) or (m_btRaceServer = RC_MOONOBJECT) then
      begin
        boLineAttatck := True; // 需要直线攻击
        if not CanLineAttack(m_nCurrX, m_nCurrY, 10) then
          boNeedLineAttatck := True; // 需要直线攻击
      end;
    end;
    if not boDodgeMon then
    begin
      GameEvent := TGameEvent(m_PEnvir.GetEvent(m_nCurrX, m_nCurrY)); // 检测站在火墙上
      if GameEvent <> nil then
      begin
        if GameEvent.m_nEventType = ET_FIRE then
        begin
          if (GameEvent.m_OwnBaseObject <> Self) or (GameEvent.m_OwnBaseObject <> m_Master) or
            (GameEvent.m_OwnBaseObject <> Master) and boCanAvoid then
            boDodgeMon := True; // 需要躲避
        end;
      end;
    end;
    if boChaseMon or // 距离超过攻击范围需要追杀
      boDodgeMon or // 需要躲避
      boNeedLineAttatck or // 需要直线攻击
      boNeedMove // 需要跑位
    then
    begin
      // 修改英雄攻杀逻辑 -- 不傻B  piaoyun 2013-08-05
      if boDodgeMon then
      begin
        Result := DodgePoint(nRange, boLineAttatck or boNeedLineAttatck, boCanUseAttackMagic);
        if Result <> nil then
          Exit;
      end;
      if boNeedLineAttatck or boNeedMove then
      begin
        { TODO -ochongchong -c修改 : ++ (GotoTargetXY();)寻路方式改变 【2013-08-06】 }
        // 假人走位几率 假人动了后，就有走位的机会了，我不懂为什么 chongchong 2015-11-25
        if (m_btRaceServer = RC_PLAYOBJECT) and (m_boDummyObject) then
        begin
        end
        else if (m_btRaceServer <> RC_PLAYMOSTER) then
          GotoTargetXY();
        Result := RefreshPoint(nRange, boLineAttatck or boNeedLineAttatck, boCanUseAttackMagic);
      end;
      if boChaseMon then
        Result := ChasePoint(nRange, boLineAttatck or boNeedLineAttatck, boCanUseAttackMagic);
    end;
  end;
end;

{ rrrr 这个地方可能有问题 XXXXXXXXXXXXXXXXXXXXX  2013-08-07 }
function TSmartObject.ActThink(wMagicID: Word): Boolean;
var
  nError: Integer;
begin
  Result := False;
  nError := 0;
  try
    m_MovePath := MovePoint(wMagicID);
    m_nMoveIndex := 0;
    nError := 1;
    if (Length(m_MovePath) > 0) and GotoNext() then
    begin
      nError := 2;
      m_dwLastActThinkTick := MyGetTickCount;
      // 分身，在怪物持续近身的情况，智能躲避，会连续跑两步，在释放一次技能
      if m_boIsAvoid then
      begin
        m_boLastAvoidTarget := True;
      end;
      m_boIsAvoid := False;
      Result := True;
    end;
    nError := 3;
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TSmartObject:ActThink ' + IntToStr(nError));
      MainOutMessage(E.Message);
    end;
  end;
end;

function TSmartObject.StartAttack(wMagIdx: Word): Boolean;
resourcestring
  sExceptionMsg = '[Exception] TSmartObject.StartAttack Race=%d MagIdx=%d';
begin
  m_boLastAvoidTarget := False;
  Result := False;
  try
    m_dwLastAttackTick := MyGetTickCount;
    m_dwTargetFocusTick := MyGetTickCount();
    case m_btJob of
      0:
        begin
          Result := WarrorAttackTarget(wMagIdx);
        end;
      1:
        begin
          Result := WizardAttackTarget(wMagIdx);
        end;
      2:
        begin
          Result := TaoistAttackTarget(wMagIdx);
        end;
    end;
    if Result then
      Inc(m_RunPos.nAttackCount);
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg, [Self.m_btRaceServer, wMagIdx]));
      MainOutMessage(E.Message);
    end;
  end;
end;

function TSmartObject.WarrAttackTarget(wMagIdx, wHitMode: Word): Boolean; { 物理攻击 }
var
  bt06: Byte;
  nRange: Integer;
  UserMagic: pTUserMagic;
  CustomMagicConfig: TCustomMagicConfig;
begin
  Result := False;
  if m_TargetCret <> nil then
  begin
    nRange := 1;
    if (wMagIdx = 40) then
      nRange := 3; // 抱月刀 双龙斩   ID=40
    if (wMagIdx = 42) then
      nRange := 3; // 龙影剑法     ID=42
    if (wMagIdx = 56) then
      nRange := 5;
    if (wMagIdx = 66) then
      nRange := 4; // 开天斩
    if (wMagIdx = 60) then
      nRange := 5;
    if (wMagIdx = 12) or (wMagIdx = 61) or (wMagIdx = 62) then
      nRange := 2;
    // 人形怪加自定义技能 chongchong 2015-10-30
    if CheckIsCustomMagic(wMagIdx) then
    begin
      CustomMagicConfig := GetCustomMagicConfig(wMagIdx);
      if (CustomMagicConfig <> nil) and CustomMagicConfig.IsMagicWarr then
      begin
        nRange := CustomMagicConfig.ServerConfig.AttackNearRange;
      end;
    end;
    if CanLineAttack(nRange) then
    begin
      bt06 := GetNextDirection(m_nCurrX, m_nCurrY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY);
      m_dwTargetFocusTick := MyGetTickCount();
      if m_btRaceServer = RC_HEROOBJECT then
      begin // 合击
        case wMagIdx of
          60:
            begin
              m_Master.m_btDirection := GetNextDirection(m_Master.m_nCurrX, m_Master.m_nCurrY, m_TargetCret.m_nCurrX,
                m_TargetCret.m_nCurrY);
              m_Master.AttackDir(m_TargetCret, wHitMode, m_Master.m_btDirection);
            end;
          61:
            begin
              if m_btJob = 0 then
              begin
                UserMagic := THeroObject(Self).FindGroupMagic;
                if UserMagic = nil then
                  Exit;
                MagicManager.DoSpell(TPlayObject(m_Master), UserMagic, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY,
                  m_TargetCret);
              end;
            end;
          62:
            begin
              if m_btJob = 0 then
              begin
                UserMagic := THeroObject(Self).FindGroupMagic;
                if UserMagic = nil then
                  Exit;
                MagicManager.DoSpell(TPlayObject(m_Master), UserMagic, m_nCurrX, m_nCurrY, m_TargetCret);
              end;
            end;
        end;
      end;
      AttackDir(m_TargetCret, wHitMode, bt06);
      BreakHolySeizeMode();
      Result := True;
    end
    else
    begin
      if m_TargetCret.m_PEnvir = m_PEnvir then
      begin
        SetTargetXY(m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY);
        // 修正人形怪傻站着不动?? chongchong 2016-03-12
        if (Abs(m_TargetCret.m_nCurrX - m_nCurrX) > 2) or (Abs(m_TargetCret.m_nCurrY - m_nCurrY) > 2) then
          RunToTargetXY
        else
          GotoTargetXY;
      end
      else
      begin
        DelTargetCreat();
      end;
    end;
  end;
end;

function TSmartObject.WarrorAttackTarget(wMagIdx: Word): Boolean; { 战士攻击 }
var
  UserMagic: pTUserMagic;
begin
  m_wHitMode := 0;
  if (wMagIdx < Length(m_UserMagics)) then
  begin
    UserMagic := m_UserMagics[wMagIdx]; // FindMagic(wMagIdx);
    if UserMagic <> nil then
    begin
      case wMagIdx of
        27, 39, 41, 114:
          begin
            Result := Spell(UserMagic, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY, m_TargetCret); // 战士魔法
            Exit;
          end;
        61 .. 65:
          begin // 合击
            if m_btJob <> 0 then
            begin
              Result := Spell(UserMagic, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY, m_TargetCret);
              Exit;
            end;
          end;
      end;
      case wMagIdx of
        7:
          m_wHitMode := 3; // 攻杀
        12:
          m_wHitMode := 4; // 使用刺杀
        25:
          m_wHitMode := 5; // 使用半月
        26:
          m_wHitMode := 7; // 使用烈火
        40:
          m_wHitMode := 8; // 抱月刀 双龙斩   ID=40
        42:
          m_wHitMode := 9; // 龙影剑法
        43:
          m_wHitMode := 10; // 雷霆剑法
        56:
          m_wHitMode := 15; // 逐日剑法
        60:
          m_wHitMode := 12; // 破魂斩
        61:
          m_wHitMode := 13; // 劈星斩
        62:
          m_wHitMode := 14; // 雷霆一击
        66:
          m_wHitMode := 11; // 开天斩
      end;
    end;
  end
  // 人形怪加自定义技能 chongchong 2015-10-30
  else if CheckIsCustomMagic(wMagIdx) then
  begin
    UserMagic := m_CustomSkill[wMagIdx - CUSTOM_MAGIC_START_ID]; // FindMagic(wMagIdx);
    if (UserMagic <> nil) and (UserMagic.MagicInfo <> nil) and (UserMagic.MagicInfo.btEffectType = 0) then
    begin
      m_wHitMode := CM_CUSTOM_HIT001 + (wMagIdx - CUSTOM_MAGIC_START_ID);
    end;
  end;
  Result := WarrAttackTarget(wMagIdx, m_wHitMode);
end;

