  procedure Skill103Attack(nSecPwr, nLevel: Integer); // 横扫千军
  var
    I: Integer;
    nPower, nNewPower: Integer;
    nX, nY: Integer;
    BaseObject: TBaseObject;
    BaseObjectList: TList;
    IsSetPKPower: Boolean;
  begin
    IsSetPKPower := True;
    nSecPwr := Min(LongWord(Round(nSecPwr * (g_Config.SkillContinuousPowerRates[3] / 100))), High(Integer));
    nSecPwr := Min(LongWord(nSecPwr + Round(nSecPwr * (nLevel * g_Config.nContinuousAttackLevelRate / 100))), High(Integer));
    nPower := GetSkillContinuousBlastHitPower(Self, AttackTarget, m_UserMagics[103], nSecPwr); // 暴击
    BaseObjectList := TList.Create;
    if AttackTarget <> nil then
    begin
      GetMapBaseObjects(m_PEnvir, AttackTarget.m_nCurrX, AttackTarget.m_nCurrY, g_Config.nSkill103AttackRange, BaseObjectList);
    end
    else
    begin
      if not m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, m_btDirection, 1, nX, nY) then
      begin
        nX := m_nCurrX;
        nY := m_nCurrY;
      end;
      GetMapBaseObjects(m_PEnvir, nX, nY, g_Config.nSkill103AttackRange, BaseObjectList);
    end;
    for I := 0 to BaseObjectList.Count - 1 do
    begin
      BaseObject := TBaseObject(BaseObjectList.Items[I]);
      if (BaseObject <> nil) and IsProperTarget(BaseObject) then
      begin
        nNewPower := GetMagicPercentPower(103, nPower, AttackTarget);
        if nNewPower > 0 then
        begin
          if Random(100) < g_Config.SkillContinuousCloseDefenseRates[3] then
            nNewPower := BaseObject.GetHitStruckDamage(Self, nNewPower, nil);
          DirectAttack(BaseObject, nNewPower, 103, IsSetPKPower);
          if IsSetPKPower then
            IsSetPKPower := False;
        end;
        SetTargetCreat(BaseObject);
        // 战技连击锁定 chongchong 2013-11-11
        if Random(100) < g_Config.btWarrContinuousStatusLocks[3] then
        begin
          BaseObject.OpenContinuousMagicLock(g_Config.nWarrContinuousStatusLockTimes[3]);
          // BaseObject.MakePosion(POISON_STONE, 2, 0);
        end;
      end;
