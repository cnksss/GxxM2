// 根据物品镶嵌添加属性 chongchong 2015-04-13
procedure AddAbiltysByUseItemFlute(SmartObject: TSmartObject; UserItem: pTUserItem; MaxValue: Int64);
var
  I: Integer;
  StdItemEx: pTStdItem;
  nAttType, nAttValue: Integer;
  Int64Value: Int64;
  AddAbil: pTAddAbility;
  OverlapCount: Integer;
begin
  if (not g_Config.boOpenItemFlute) or (UserItem.btFluteCount = 0) then
    Exit;
  for I := 0 to UserItem.btFluteCount - 1 do
  begin
    if not(I in [0 .. MAX_FLUTE_COUNT - 1]) then
      Break;
    if UserItem.Flutes[I].GemIndex > 0 then
    begin
      OverlapCount := UserItem.Flutes[I].GemCount;
      if OverlapCount = 0 then
        OverlapCount := 1;
      StdItemEx := UserEngine.GetStdItem(UserItem.Flutes[I].GemIndex);
      if (StdItemEx <> nil) and (StdItemEx.StdMode = 46) and (StdItemEx.Shape = 3) then
      begin
        nAttValue := StdItemEx.Source * OverlapCount;
        if nAttValue > 0 then
        begin
          AddAbil := @SmartObject.m_AddAbil;
          case StdItemEx.Anicount of
            1: // 加防御
              begin
                AddAbil.nAC1 := AddAbil.nAC1;
                Int64Value := Int64(nAttValue) + AddAbil.nAC2;
                AddAbil.nAC2 := Min(Int64Value, High(Integer));
              end;
            2: // 加魔御
              begin
                AddAbil.nMAC1 := AddAbil.nMAC1;
                Int64Value := Int64(nAttValue) + AddAbil.nMAC2;
                AddAbil.nMAC2 := Min(Int64Value, High(Integer));
              end;
            3: // 加攻击
              begin
                AddAbil.nDC1 := AddAbil.nDC1;
                Int64Value := Int64(nAttValue) + AddAbil.nDC2;
                AddAbil.nDC2 := Min(Int64Value, High(Integer));
              end;
            4: // 加魔法
              begin
                AddAbil.nMC1 := AddAbil.nMC1;
                Int64Value := Int64(nAttValue) + AddAbil.nMC2;
                AddAbil.nMC2 := Min(Int64Value, High(Integer));
              end;
            5: // 加道术
              begin
                AddAbil.nSC1 := AddAbil.nSC1;
                Int64Value := Int64(nAttValue) + AddAbil.nSC2;
                AddAbil.nSC2 := Min(Int64Value, High(Integer));
              end;
            6: // 加生命值
              begin
                Int64Value := Int64(AddAbil.wHP) + nAttValue;
                AddAbil.wHP := Min(MaxValue, Int64Value);
              end;
            7: // 加魔法值
              begin
                Int64Value := Int64(AddAbil.wMP) + nAttValue;
                AddAbil.wMP := Min(MaxValue, Int64Value);
              end;
            8: // 加准确
              begin
                Int64Value := Int64(AddAbil.wHitPoint) + nAttValue;
                AddAbil.wHitPoint := Min(Int64Value, High(Word));
              end;
            9: // 加敏捷
              begin
                Int64Value := Int64(AddAbil.wSpeedPoint) + nAttValue;
                AddAbil.wSpeedPoint := Min(Int64Value, High(Word));
              end;
            10: // 加幸运
              begin
                Int64Value := Int64(AddAbil.btLuck) + nAttValue;
                AddAbil.btLuck := Min(Int64Value, High(Byte));
              end;
            11: // 加攻击速度
              begin
                Int64Value := Int64(AddAbil.nHitSpeed) + nAttValue;
                AddAbil.nHitSpeed := Min(Int64Value, High(Integer));
              end;
            12: // 加魔法躲避
              begin
                Int64Value := Int64(AddAbil.wAntiMagic) + nAttValue;
                AddAbil.wAntiMagic := Min(Int64Value, High(Word));
              end;
            13: // 加毒物躲避
              begin
                Int64Value := Int64(AddAbil.wAntiPoison) + nAttValue;
                AddAbil.wAntiPoison := Min(Int64Value, High(Word));
              end;
            14: // 加中毒恢复
              begin
                Int64Value := Int64(AddAbil.wPoisonRecover) + nAttValue;
                AddAbil.wPoisonRecover := Min(Int64Value, High(Word));
              end;
            15: // 加体力恢复
              begin
                Int64Value := Int64(AddAbil.wHealthRecover) + nAttValue;
                AddAbil.wHealthRecover := Min(Int64Value, High(Word));
              end;
            16: // 加魔法恢复
              begin
                Int64Value := Int64(AddAbil.wSpellRecover) + nAttValue;
                AddAbil.wSpellRecover := Min(Int64Value, High(Word));
              end;
            17: // 加负重
              begin
                Int64Value := Int64(SmartObject.m_WAbil.MaxWearWeight) + nAttValue;
                SmartObject.m_WAbil.MaxWearWeight := Min(Int64Value, High(Integer)); // 加装备重量
              end;
            18: // 加背包重量
              begin
                Int64Value := Int64(SmartObject.m_WAbil.MaxWeight) + nAttValue;
                SmartObject.m_WAbil.MaxWeight := Min(Int64Value, High(Integer));
              end;
          end;
        end;
        nAttType := StdItemEx.AC1;
        nAttValue := StdItemEx.AC2 * OverlapCount;
        if (nAttValue > 0) and (nAttType >= 1) then
        begin
          if (nAttType <= 21) then
          begin
            // 攻击伤害、体力增加、魔法增加 chongchong 2015-06-30
            if nAttType in [2, 8, 9, 11] then
            begin
              Int64Value := Int64(SmartObject.m_WAbil.NewValue[nAttType - 1]) + nAttValue + StdItemEx.Elements[nAttType - 1];
              SmartObject.m_WAbil.NewValue[nAttType - 1] := Min(Int64Value, High(LongWord));
            end
            else
            begin
              Int64Value := Int64(SmartObject.m_WAbil.NewValue[nAttType - 1]) + nAttValue + StdItemEx.Elements[nAttType - 1];
              SmartObject.m_WAbil.NewValue[nAttType - 1] := Min(Int64Value, 100);
            end;
          end
          // 致命一击几率，致命一击攻击，致命一击防御
          else if nAttType in [28, 29, 30] then // 21, 22, 23
          begin
            // 致命一击攻击
            if nAttType in [29] then
            begin
              Int64Value := Int64(SmartObject.m_WAbil.NewValue[nAttType - 7]) + nAttValue + StdItemEx.Elements[nAttType - 7];
              SmartObject.m_WAbil.NewValue[nAttType - 7] := Min(Int64Value, High(LongWord));
            end
            else
            begin
              Int64Value := Int64(SmartObject.m_WAbil.NewValue[nAttType - 7]) + nAttValue + StdItemEx.Elements[nAttType - 7];
              SmartObject.m_WAbil.NewValue[nAttType - 7] := Min(Int64Value, 100);
            end;
          end
          else
          begin
            case nAttType of
              22: // 麻痹
                begin
                  Int64Value := Int64(SmartObject.m_btFluteStoneParalysisRate) + nAttValue;
                  SmartObject.m_btFluteStoneParalysisRate := Min(100, Int64Value);
                end;
              23: // 复活
                begin
                  Int64Value := Int64(SmartObject.m_btFluteStoneRevivalRate) + nAttValue;
                  SmartObject.m_btFluteStoneRevivalRate := Min(100, Int64Value);
                end;
              24: // 护身
                begin
                  Int64Value := Int64(SmartObject.m_btFluteStoneMagicShieldRate) + nAttValue;
                  SmartObject.m_btFluteStoneMagicShieldRate := Min(100, Int64Value);
                end;
              25: // 魔道麻痹
                begin
                  Int64Value := Int64(SmartObject.m_btFluteStoneMDParalysisRate) + nAttValue;
                  SmartObject.m_btFluteStoneMDParalysisRate := Min(100, Int64Value);
                end;
              26: // 冰冻
                begin
                  Int64Value := Int64(SmartObject.m_btFluteStoneFrozenRate) + nAttValue;
                  SmartObject.m_btFluteStoneFrozenRate := Min(100, Int64Value);
                end;
              27: // 蜘蛛网
                begin
                  Int64Value := Int64(SmartObject.m_btFluteStoneWindingRate) + nAttValue;
                  SmartObject.m_btFluteStoneWindingRate := Min(100, Int64Value);
                end;
            end;
          end;
        end;
      end;
    end;
  end;
end;

procedure TBaseObject.RecalcAbilitys;
  procedure AddGroupItemValue(nMaxValue: LongWord; GroupFldValues: array of Integer);
  var
    Int64Value: Int64;
    nMaxAC: Integer;
  begin
    Int64Value := Int64(GroupFldValues[0]) + m_WAbil.MaxHP;
    m_WAbil.MaxHP := Min(nMaxValue, Int64Value);
    Int64Value := Int64(GroupFldValues[1]) + m_WAbil.MaxMP;
    m_WAbil.MaxMP := Min(nMaxValue, Int64Value);

    if g_Config.btMaxAC = 0 then
      nMaxAC := High(Word)
    else
      nMaxAC := High(Integer);

    Int64Value := GroupFldValues[2] + m_WAbil.AC1;
    m_WAbil.AC1 := Min(nMaxAC, Int64Value);
    Int64Value := GroupFldValues[14] + m_WAbil.AC2;
    m_WAbil.AC2 := Min(nMaxAC, Int64Value);
    Int64Value := GroupFldValues[3] + m_WAbil.MAC1;
    m_WAbil.MAC1 := Min(nMaxAC, Int64Value);
    Int64Value := GroupFldValues[15] + m_WAbil.MAC2;
    m_WAbil.MAC2 := Min(nMaxAC, Int64Value);
    Int64Value := GroupFldValues[4] + m_WAbil.DC1;
    m_WAbil.DC1 := Min(nMaxAC, Int64Value);
    Int64Value := GroupFldValues[16] + m_WAbil.DC2;
    m_WAbil.DC2 := Min(nMaxAC, Int64Value);
    Int64Value := GroupFldValues[5] + m_WAbil.MC1;
    m_WAbil.MC1 := Min(nMaxAC, Int64Value);
    Int64Value := GroupFldValues[17] + m_WAbil.MC2;
    m_WAbil.MC2 := Min(nMaxAC, Int64Value);
    Int64Value := GroupFldValues[6] + m_WAbil.SC1;
    m_WAbil.SC1 := Min(nMaxAC, Int64Value);
    Int64Value := GroupFldValues[18] + m_WAbil.SC2;
    m_WAbil.SC2 := Min(nMaxAC, Int64Value);

    // 扩展准确、敏捷为65536 chongchong 2018-01-11
    if g_Config.btMaxHitPoint = 1 then
    begin
      m_btHitPoint := Min(High(Word), GroupFldValues[7] + m_btHitPoint); // 准确
      m_btSpeedPoint := Min(High(Word), GroupFldValues[8] + m_btSpeedPoint); // 敏捷
    end
    else
    begin
      m_btHitPoint := Min(High(Byte), GroupFldValues[7] + m_btHitPoint); // 准确
      m_btSpeedPoint := Min(High(Byte), GroupFldValues[8] + m_btSpeedPoint); // 敏捷
    end;

    m_nAntiMagic := Min(High(Byte), GroupFldValues[9] + m_nAntiMagic); // 魔法躲避
    m_btAntiPoison := Min(High(Byte), GroupFldValues[10] + m_btAntiPoison); // 毒躲避
    m_nPoisonRecover := Min(High(Byte), GroupFldValues[11] + m_nPoisonRecover); // 毒恢复
    m_nHealthRecover := Min(High(Byte), GroupFldValues[12] + m_nHealthRecover); // HP恢复
    m_nSpellRecover := Min(High(Byte), GroupFldValues[13] + m_nSpellRecover); // MP恢复
  end;

