    begin
      Int64Value := Round(m_WAbil.DC1 / 100 * (100 - m_nNewCurseDefenceUpValue));
      m_WAbil.DC1 := Max(0, Int64Value);
      Int64Value := Round(m_WAbil.DC2 / 100 * (100 - m_nNewCurseDefenceUpValue));
      m_WAbil.DC2 := Max(0, Int64Value);
      Int64Value := Round(m_WAbil.MC1 / 100 * (100 - m_nNewCurseDefenceUpValue));
      m_WAbil.MC1 := Max(0, Int64Value);
      Int64Value := Round(m_WAbil.MC2 / 100 * (100 - m_nNewCurseDefenceUpValue));
