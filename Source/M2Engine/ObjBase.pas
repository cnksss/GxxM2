function TBaseObject.GetBackPosition(var nX, nY: Integer): Boolean;
var
  Envir: TEnvirnoment;
begin
  Result := False;
  Envir := m_PEnvir;
  nX := m_nCurrX;
  nY := m_nCurrY;
  // 修复报错 piaoyun 2013-12-25
  if Envir = nil then
    Exit;
  case m_btDirection of
    DR_UP:
      if nY < (Envir.m_nHeight - 1) then
        Inc(nY);
    DR_DOWN:
      if nY > 0 then
        Dec(nY);
    DR_LEFT:
      if nX < (Envir.m_nWidth - 1) then
        Inc(nX);
    DR_RIGHT:
      if nX > 0 then
        Dec(nX);
    DR_UPLEFT:
      begin
        if (nX < (Envir.m_nWidth - 1)) and (nY < (Envir.m_nHeight - 1)) then
        begin
          Inc(nX);
          Inc(nY);
        end;
      end;
    DR_UPRIGHT:
      begin
        if (nX < (Envir.m_nWidth - 1)) and (nY > 0) then
        begin
          Dec(nX);
          Inc(nY);
        end
      end;
    DR_DOWNLEFT:
      begin
        if (nX > 0) and (nY < (Envir.m_nHeight - 1)) then
        begin
          Inc(nX);
          Dec(nY);
        end;
      end;
    DR_DOWNRIGHT:
      begin
        if (nX > 0) and (nY > 0) then
        begin
          Dec(nX);
          Dec(nY);
        end;
      end;
  end;
  Result := True;
end;

function TBaseObject.GetBackPosition(btDirection: Byte; var nX, nY: Integer): Boolean;
var
  Envir: TEnvirnoment;
begin
  Envir := m_PEnvir;
  nX := m_nCurrX;
  nY := m_nCurrY;
  case btDirection of
    DR_UP:
      if nY < (Envir.m_nHeight - 1) then
        Inc(nY);
    DR_DOWN:
      if nY > 0 then
        Dec(nY);
    DR_LEFT:
      if nX < (Envir.m_nWidth - 1) then
        Inc(nX);
    DR_RIGHT:
      if nX > 0 then
        Dec(nX);
    DR_UPLEFT:
      begin
        if (nX < (Envir.m_nWidth - 1)) and (nY < (Envir.m_nHeight - 1)) then
        begin
          Inc(nX);
          Inc(nY);
        end;
      end;
    DR_UPRIGHT:
      begin
        if (nX < (Envir.m_nWidth - 1)) and (nY > 0) then
        begin
          Dec(nX);
          Inc(nY);
        end
      end;
    DR_DOWNLEFT:
      begin
        if (nX > 0) and (nY < (Envir.m_nHeight - 1)) then
        begin
          Inc(nX);
          Dec(nY);
        end;
      end;
    DR_DOWNRIGHT:
      begin
        if (nX > 0) and (nY > 0) then
        begin
          Dec(nX);
          Dec(nY);
        end;
      end;
  end;
  Result := True;
end;

function TBaseObject.GetBackPosition(btDirection: Byte; sX, sY: Integer; var dX, dY: Integer; Step: Byte): Boolean;
var
  Envir: TEnvirnoment;
begin
  Result := False;
  Envir := m_PEnvir;
  dX := sX;
  dY := sY;
  if Step = 0 then
    Exit;
  case btDirection of
    DR_UP:
      if dY < (Envir.m_nHeight - Step) then
        Inc(dY, Step);
    DR_DOWN:
      if dY >= Step then
        Dec(dY);
    DR_LEFT:
      if dX < (Envir.m_nWidth - Step) then
        Inc(dX, Step);
    DR_RIGHT:
      if dX >= Step then
        Dec(dX, Step);
    DR_UPLEFT:
      begin
        if (dX < (Envir.m_nWidth - Step)) and (dY < (Envir.m_nHeight - Step)) then
        begin
          Inc(dX, Step);
          Inc(dY, Step);
        end;
      end;
    DR_UPRIGHT:
      begin
        if (dX >= Step) and (dY < (Envir.m_nHeight - Step)) then
        begin
          Dec(dX, Step);
          Inc(dY, Step);
        end
      end;
    DR_DOWNLEFT:
      begin
        if (dX < (Envir.m_nWidth - Step)) and (dY >= Step) then
        begin
          Inc(dX, Step);
          Dec(dY, Step);
        end;
      end;
    DR_DOWNRIGHT:
      begin
        if (dX >= Step) and (dY >= Step) then
        begin
          Dec(dX, Step);
          Dec(dY, Step);
        end;
      end;
  end;
  Result := True;
end;

// 获取魔法攻击的威力 chongchong 2013-11-23
function TBaseObject.GetMagicPercentPower(wMagic: Word; nPower: Integer; TargeTBaseObject: TBaseObject): Integer;
var
  IsHuman: Boolean;
  _Master: TBaseObject;
  I64: Int64;
begin
  Result := nPower;
  if (wMagic >= CUSTOM_MAGIC_START_ID) and (wMagic < CUSTOM_MAGIC_START_ID + CUSTOM_MAGIC_COUNT) then
  begin
    wMagic := wMagic - CUSTOM_MAGIC_START_ID + DEF_MAGIC_COUNT + 1;
  end;
  if (TargeTBaseObject <> nil) and (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
  begin
    if (wMagic < Length(TSmartObject(Self).m_AttackSkillPercent)) then
    begin
      // m_AttackSkillPercent 列表信息二中的：套装 及 装备技能威力对技能的增幅
      if (g_Config.boSkillPowerItemUseHum and (TargeTBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]))
        or (g_Config.boSkillPowerItemUseMon and (not(TargeTBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT,
        RC_PLAYMOSTER]))) then
        Result := Min(LongWord(nPower + Round(TSmartObject(Self).m_AttackSkillPercent[wMagic] / 100 * nPower)), High(Integer));
    end;
    if wMagic < Length(TSmartObject(Self).m_NpcSkillPowerAdd) then
    begin
      if TargeTBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER] then
      begin
        if (TSmartObject(Self).m_NpcSkillPowerAdd[wMagic].HumanAttackPercent <> 0) then
        begin
          I64 := Int64(Result) + Round(TSmartObject(Self).m_NpcSkillPowerAdd[wMagic].HumanAttackPercent / 100 * nPower);
          Result := Min(I64, High(Integer));
        end;
        if TSmartObject(Self).m_NpcSkillPowerAdd[wMagic].HumanAttackValue <> 0 then
        begin
          I64 := Int64(Result) + TSmartObject(Self).m_NpcSkillPowerAdd[wMagic].HumanAttackValue;
          Result := Min(I64, High(Integer));
        end;
      end
      else
      begin
        if (TSmartObject(Self).m_NpcSkillPowerAdd[wMagic].MonAttackPercent <> 0) then
        begin
          I64 := Int64(Result) + Round(TSmartObject(Self).m_NpcSkillPowerAdd[wMagic].MonAttackPercent / 100 * nPower);
          Result := Min(I64, High(Integer));
        end;
        if TSmartObject(Self).m_NpcSkillPowerAdd[wMagic].MonAttackValue <> 0 then
        begin
          I64 := Int64(Result) + TSmartObject(Self).m_NpcSkillPowerAdd[wMagic].MonAttackValue;
          Result := Min(I64, High(Integer));
        end;
      end;
    end;
  end;
  if (TargeTBaseObject <> nil) and (TargeTBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
  begin
    if (wMagic < Length(TSmartObject(TargeTBaseObject).m_DefenseSkillPercent)) then
    begin
      Result := Min(LongWord(Max(Result - Round(TSmartObject(TargeTBaseObject).m_DefenseSkillPercent[wMagic] / 100 * Result), 0)),
        High(Integer));
      if (TargeTBaseObject.m_btRaceServer = RC_HEROOBJECT) then
      begin
        // 人物攻击英雄威力(这里只判断人物，而不判断宝宝)，因为每个怪物宝宝对应的地方都有写 chongchong 2017-04-05
        if (m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER]) then // {, RC_HEROOBJECT} 只搞人物攻击英雄威力 2020-03-24 18:39:07
        begin
          Result := Round(Result / 100 * g_Config.nHumanAttackHeroPowerRate);
        end;
      end;
    end;
    if wMagic < Length(TSmartObject(TargeTBaseObject).m_NpcSkillPowerAdd) then
    begin
      if TSmartObject(TargeTBaseObject).m_NpcSkillPowerAdd[wMagic].DefensePercent <> 0 then
      begin
        I64 := Int64(Result) - Round(TSmartObject(TargeTBaseObject).m_NpcSkillPowerAdd[wMagic].DefensePercent / 100 * Result);
        if I64 < 0 then
          I64 := 0
        else if I64 >= High(Integer) then
          I64 := High(Integer);
        Result := I64;
      end;
      if TSmartObject(TargeTBaseObject).m_NpcSkillPowerAdd[wMagic].DefenseValue <> 0 then
      begin
        I64 := Int64(Result) - TSmartObject(TargeTBaseObject).m_NpcSkillPowerAdd[wMagic].DefenseValue;
        if I64 < 0 then
          I64 := 0
        else if I64 >= High(Integer) then
          I64 := High(Integer);
        Result := I64;
      end;
    end;
  end;
  if (g_nKey_HeroExt = 1) and (m_btRaceServer = RC_HEROOBJECT) and (TargeTBaseObject <> nil) and (nPower > 0) then
  begin
    IsHuman := TargeTBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
    if not IsHuman then
    begin
      _Master := TargeTBaseObject.Master;
      if (_Master <> nil) then
      begin
        IsHuman := _Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
      end;
    end;
    if IsHuman then
    begin
      Result := Min(LongWord(Round(Result / 100 * g_Config.nHeroAttackHumPowerRate)), High(Integer));
      Result := Min(LongWord(Round(Result / 100 * m_nSlaveAttackHumPowerRate)), High(Integer));
    end
    else
    begin
      Result := Min(LongWord(Round(Result / 100 * g_Config.nHeroAttackMonPowerRate)), High(Integer));
    end;
  end;
end;

function TBaseObject.GetAttackPowerMax(nPower: Integer): Integer; // 获取怪物伤害封顶，封顶数值等于怪物BD中的MP数值，若DB中怪物MP值=0则不计算伤害封顶
var
  MaxMP: LongWord;
  Int64Value: Int64;
begin
  Result := nPower;
  MaxMP := m_Abil.MP;
  {
    无法修改MP，HP是怪物的伤害限制，半兽人目前数据库限制1，也就是伤害最大为1，命令不可修改！！ 2021-05-26
    [@半兽人的MP]
    #if
    #ACT
    ChangeMonAbility 3 半兽人 2 = 10 0 325 323 20
    RecalcMonAbility 3 半兽人 325 323 20
  }
  if m_boChangeAbility and (m_ChangeAbility.MP <> 0) then
  begin
    if m_ChangeAbility.boMPPercentage then
      Int64Value := Round(m_Abil.MP + m_Abil.MP / 100 * Integer(m_ChangeAbility.MP))
    else
      Int64Value := m_Abil.MP + Integer(m_ChangeAbility.MP);

    if Int64Value < 0 then
      Int64Value := 0
    else if Int64Value > High(m_Abil.MP) then
      Int64Value := High(m_Abil.MP);

    MaxMP := Int64Value;
  end;

  // 修复人形怪受到的伤害会封顶的问题 By 一支笔 at:2021-08-02 14:20:27
  if (nPower > 0) //
    and (MaxMP > 0) //
    and (not(m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_MOONOBJECT])) //
    and (g_Config.boDamageLimitation or not(m_btRaceServer in [RC_PLAYMOSTER])) then // 增加人形怪限制伤害开关 Cursor 2023-06-02 17:12:37
  begin
    Result := Min(nPower, MaxMP);
  end;
end;

