    Exit;
  nStartX := nX - nRange;
  nEndX := nX + nRange;
  nStartY := nY - nRange;
  nEndY := nY + nRange;
  for I := nStartX to nEndX do
  begin
    for II := nStartY to nEndY do
    begin
{$IF MULTI_THREAD = 1}
      if g_MultiThreadRun then
        m_PEnvir.LockR(15);
      try
{$IFEND}
        if m_PEnvir.GetMapCellInfo(I, II, MapCellInfo) and (MapCellInfo.ObjList <> nil) then
        begin
          for III := 0 to {$IF USEOBJLIST = 1}Length(MapCellInfo.ObjList){$ELSE}MapCellInfo.ObjList.Count{$IFEND} - 1 do
          begin
            GameObject :=
{$IF USEOBJLIST = 1}TGameObject(MapCellInfo.ObjList[III]){$ELSE}TGameObject(MapCellInfo.ObjList.Items[III]){$IFEND};
            if (GameObject <> nil) and (GameObject.m_ObjGame = obj_Actor) then
            begin
              BaseObject := TBaseObject(GameObject);
              if (BaseObject <> nil) and (not BaseObject.m_boDeath) and (not BaseObject.m_boGhost) then
              begin
                if IsProperTarget(BaseObject) then
                begin
                  if BaseObject.NewCurseDefenceUp(nSec, PercentValue) then
                  begin
                    Inc(Result);
