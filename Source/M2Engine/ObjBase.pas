procedure TSmartObject.SetPKFlag(BaseObject: TBaseObject);
var
  nPKLevel: Integer;
begin
  // 人形怪被人物攻击时，人物不要变灰 chongchong 2015-09-26
  if m_btRaceServer = RC_PLAYMOSTER then
    Exit;

  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    nPKLevel := TSmartObject(BaseObject).PKLevel
  else
