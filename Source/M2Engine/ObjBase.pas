function TBaseObject.IsProtectTarget(BaseObject: TBaseObject): Boolean;
var
  nPKLevel, nSelfPKLevel: Integer;
begin
  Result := True;
  if BaseObject = nil then
    Exit;

  if (InSafeZone) or (BaseObject.InSafeZone) then
    Result := False;

  if not BaseObject.m_boInFreePKArea then
  begin
    if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
      nSelfPKLevel := TSmartObject(Self).PKLevel
    else
      nSelfPKLevel := 0;
    if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
      nPKLevel := TSmartObject(BaseObject).PKLevel
    else
      nPKLevel := 0;
    // 新人保护
    if g_Config.boPKLevelProtect then
    begin
      if (m_Abil.Level > g_Config.nPKProtectLevel) then
      begin // 如果大于指定等级
        if not BaseObject.m_boPKFlag and (BaseObject.m_Abil.Level <= g_Config.nPKProtectLevel) and (nPKLevel < 2) then
        begin
          // 被攻击的人物小指定等级没有红名，则不可以攻击。
          Result := False;
          Exit;
        end;
      end;
      if (m_Abil.Level <= g_Config.nPKProtectLevel) then
      begin // 如果小于指定等级
        if not BaseObject.m_boPKFlag and (BaseObject.m_Abil.Level > g_Config.nPKProtectLevel) and (nPKLevel < 2) then
        begin
          Result := False;
          Exit;
        end;
      end;
    end;
    // 大于指定级别的红名人物不可以杀指定级别未红名的人物。
    if (nSelfPKLevel >= 2) and (m_Abil.Level > g_Config.nRedPKProtectLevel) then
    begin
      if (BaseObject.m_Abil.Level <= g_Config.nRedPKProtectLevel) and (nPKLevel < 2) then
      begin
        Result := False;
        Exit;
      end;
    end;
    // 小于指定级别的非红名人物不可以杀指定级别红名人物。
    if (m_Abil.Level <= g_Config.nRedPKProtectLevel) and (nSelfPKLevel < 2) then
    begin
      if (nPKLevel >= 2) and (BaseObject.m_Abil.Level > g_Config.nRedPKProtectLevel) then
      begin
        Result := False;
        Exit;
      end;
    end;
    // 过地图保护时间不要 chongchong 2017-07-01
    // if (MyGetTickCount - m_dwMapMoveTick < g_Config.dwHumChgMapOrLoginProtectTime) or (MyGetTickCount - BaseObject.m_dwMapMoveTick < g_Config.dwHumChgMapOrLoginProtectTime) then
    // Result := False;
  end;
end;

function TBaseObject.IsAttackTarget(BaseObject: TBaseObject { 被攻击方 } ): Boolean;
// 玩家只有在全体模式下才可以攻击英雄的宝宝 chongchong 2013-11-17
  function IsMyBB: Boolean;
  begin
    Result := False;
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      if (BaseObject.m_Master = Self) then
        Result := True
      else if (TPlayObject(Self).m_MyHero <> nil) and (BaseObject.m_Master = TPlayObject(Self).m_MyHero) then
        Result := True;
    end;
  end;

var
  I: Integer;
  PlayObject: TPlayObject;
  nErrCode: Integer;
  CounterattackDelay: LongWord;
  IsHuman: Boolean;
  _Master: TBaseObject;
begin
  nErrCode := 0;
  Result := False;
  try
    if (BaseObject = nil) or (BaseObject = Self) then
      Exit;
    if (BaseObject.m_btRaceServer = 108) { or (BaseObject.m_btRaceServer = RC_TRUCKOBJECT) } then
      Exit; // 魔王岭怪物 押镖车
    if ((BaseObject.m_btRaceServer = 154) and (BaseObject.m_btRaceImg = 156) { 自定义怪物 - 魔王岭怪物 } ) then
      Exit;
    // 只攻击指定名称的目标 chongchong 2017-06-30
    if (Length(m_sAttackTargetName) > 0) and (not SameText(BaseObject.m_sCharName, m_sAttackTargetName)) then
      Exit;
    // if (BaseObject.m_PEnvir <> m_PEnvir) then Exit;
    PlayObject := nil;
    nErrCode := 1;
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      PlayObject := TPlayObject(BaseObject);
      nErrCode := 2;
      // 如果被攻击方在摆摊状态 摆摊无敌 piaoyun 2013-09-14
      if g_Config.boShopStallCanNotAttack and PlayObject.m_boShopStall then
        Exit;
      // 骑马被邀请到马上的人无敌 chongchong 2013-10-15
      if (PlayObject.m_boOnHorse and (not PlayObject.m_boHorseMaster)) then
        Exit;
    end;
    // 英雄在休息或跟随状态时，英雄的宝宝也不打怪 chongchong 2015-05-17
    if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_HEROOBJECT) and (THeroObject(m_Master).m_btAttackMode in [1, 2]) then
      Exit;
    nErrCode := 3;
    if m_btRaceServer { 攻击方 } >= RC_ANIMAL { 50 } then
    begin { 增加分身检测 }
      if Master <> nil then
      begin
        nErrCode := 4;
        if Master.IsAttackTarget(BaseObject) then
        begin
          if (Master.m_LastHiter = BaseObject) or (Master.m_ExpHitter = BaseObject) or (Master.m_TargetCret = BaseObject) then
            Result := True; { 宝宝攻击 }
          // if (BaseObject.m_btRaceServer in [RC_NPC, RC_ANIMAL]) then
          // Result := False;
          nErrCode := 5;
          { TODO -opiaoyun -c修改 : 修复月灵被玩家直接攻击，不还手BUG 【2013-06-23】 }
          if (BaseObject.m_TargetCret <> nil) then
          begin
            if (BaseObject.m_TargetCret = m_Master) or (BaseObject.m_TargetCret = Master) or
              (BaseObject.m_TargetCret.Master = Master) then
              Result := True;
            {
              // 其他怪物锁定了宝宝，宝宝打回去 chongchong 2017-06-30
              if (BaseObject.m_TargetCret = Self) or (BaseObject.m_CurrTarget = Self) then
              begin
              Result := True;
              end;
            }
          end;
          nErrCode := 6;
          if BaseObject.m_boDummyObject then
          begin
            nErrCode := 7;
            if (BaseObject.m_TargetCret <> nil) then
            begin
              nErrCode := 8;
              if (BaseObject.m_TargetCret = m_Master) or (BaseObject.m_TargetCret = Self) or (BaseObject.m_TargetCret = Master) or
                (BaseObject.m_TargetCret.Master = Master) then
                Result := True;
            end;
          end;
        end
        // 别人打宝宝的主人，不管自己是否处于和平模式，宝宝反击 chongchong 2017-07-01
        else if Master.m_LastHiter = BaseObject then
        begin
          Result := True;
        end;
        nErrCode := 9;
        if (m_btRaceServer = RC_PLAYMOSTER) and (not Result) then
        begin // 分身术
          nErrCode := 10;
          if (BaseObject.Master <> nil) then
          begin
            nErrCode := 11;
            if (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) and (Master.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              nErrCode := 12;
              if (BaseObject.Master.m_TargetCret <> Self) and (BaseObject.m_TargetCret <> Self) and
                (BaseObject.Master.m_TargetCret <> Master) and (BaseObject.m_TargetCret <> Master) then
                Result := False
              else
                Result := True;
            end
            else
              Result := True;
          end
          else
          begin
            nErrCode := 13;
            if not(BaseObject.m_btRaceServer in [RC_GUARD, RC_ARCHERGUARD, RC_MOVE_ARCHERGUARD, RC_PEACENPC, RC_TRUCKOBJECT, 110,
              111, 55]) and (Master <> nil) then
            begin
              nErrCode := 14;
              if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and (Master.m_btRaceServer = RC_PLAYOBJECT) then
              begin
                nErrCode := 15;
                if (BaseObject.m_TargetCret <> Self) and (BaseObject.m_TargetCret <> Master) then
                  Result := False
                else
                  Result := True;
              end
              else if (BaseObject.m_btRaceServer >= RC_ANIMAL) and (Master.m_btRaceServer = RC_PLAYOBJECT) then
              begin
                // 人形怪BB不让主动攻击同国家的怪物 chongchong 2016-08-02
                if (BaseObject.m_btNation > 0) and (BaseObject.m_btNation = Master.m_btNation) and
                  (not BaseObject.m_boCanAttackSameNationPlayer) then
                  Result := False
                else
                  Result := True;
              end
              else if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and (Master.m_btRaceServer >= RC_ANIMAL) then
              begin
                Result := True;
              end;
            end;
          end;
        end;
        nErrCode := 16;
        if BaseObject.m_Master <> nil then
        begin
          nErrCode := 17;
          if (m_Master <> nil) and ((BaseObject.m_Master = m_Master.m_LastHiter) or (BaseObject.m_Master = m_Master.m_TargetCret))
            and m_Master.IsAttackTarget(BaseObject) then
            Result := True;
          nErrCode := 18;
          if (Master.m_btRaceServer >= RC_ANIMAL) and (BaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
            Result := True;
          nErrCode := 19;
          if (Master.m_btRaceServer >= RC_ANIMAL) and (BaseObject.m_Master.m_btRaceServer >= RC_ANIMAL) then
            Result := False;
        end;
        nErrCode := 20;
        if (BaseObject.m_Master <> nil) and (BaseObject.m_Master = Self) then
          Result := False;
        nErrCode := 21;
        if (BaseObject.Master <> nil) and (BaseObject.Master = Master) then
          Result := False; { 检测是自己的宝宝 }
        nErrCode := 22;
        if (BaseObject = m_Master { 也就是self.m_Master好理解点 } ) then
          Result := False; // 目标是主人
        nErrCode := 23;
        if (BaseObject = Master) then
          Result := False; // 目标是主人
        nErrCode := 24;
        if BaseObject.m_boHolySeize then
          Result := False;
        nErrCode := 25;
        if g_Config.boSlaveRelaxCanStruck and m_Master.m_boSlaveRelax and ((not m_boGamePet) or g_Config.boPetSleepControlBySlave)
        then
          Result := False;
        nErrCode := 26;
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
        begin { 检测目标是人物 }
          // if (m_Master.InSafeZone) or (BaseObject.InSafeZone) then begin
          if BaseObject.InSafeZone then
          begin
            Result := False;
            // 目标跑到安全区了，主人也跑到安全区了，目标再跑出来就不攻击了 chongchong 2015-05-02
            if m_Master.InSafeZone then
            begin
              // 这个地方注释掉看可以不可以 chongchong 2015-11-30
              {
                if m_TargetCret <> nil then
                DelTargetCreat;
              }
              if m_Master.m_TargetCret <> nil then
              begin
                m_Master.DelTargetCreat;
              end;
            end;
          end;
        end;
        nErrCode := 27;
        BreakCrazyMode();
      end
      else
      begin
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          nErrCode := 28;
          PlayObject := TPlayObject(BaseObject);
          // 摆摊无敌
          { if g_Config.boShopStallCanNotAttack and PlayObject.m_boShopStall then
            Result := False
            else }
          Result := True;
        end;
        try
          nErrCode := 29;
          if (m_btRaceServer > RC_PEACENPC { 15 } ) and (m_btRaceServer < RC_ANIMAL { 50 } ) then
            Result := True;
          nErrCode := 30;
          if (BaseObject.m_Master <> nil) and (BaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
          begin
            nErrCode := 31;
            PlayObject := TPlayObject(BaseObject.m_Master);
            Result := True;
          end;
          // 修正怪物不攻击自己英雄的宝宝 chongchong 2014-10-12
          if (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
          begin
            nErrCode := 31;
            PlayObject := TPlayObject(BaseObject.Master);
            Result := True;
          end;
          // 不同国家的怪物相互PK chongchong 2016-03-29
          if (BaseObject.Master = nil) and (BaseObject.m_btNation > 0) and (m_btNation > 0) and
            (BaseObject.m_btNation <> m_btNation) and m_boNoSameNationMonPK then
          begin
            Result := True;
          end;
        except
          Exit;
        end;
      end;
      nErrCode := 32;
      if m_boCrazyMode and (not(BaseObject.m_btRaceServer in [RC_NPC, RC_ANIMAL])) then
        Result := True;
      // 国家怪物
      nErrCode := 33;
      if (m_btNation > 0) and (PlayObject <> nil) and (PlayObject.m_btNation > 0) and (m_btNation = PlayObject.m_btNation) then
      begin
        if not m_boCanAttackSameNationPlayer then
        begin
          Result := False;
        end
        else
        begin
          if (PlayObject.m_btAttatckMode = HAM_NATION) then
            Result := False;
        end;
      end;
      nErrCode := 34;
      // 修复假人英雄的宝宝在安全区攻击 chongchong 2013-11-24
      if (m_Master <> nil) and (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (BaseObject.m_Master <> nil) and
        (BaseObject.m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and BaseObject.InSafeZone then
      begin
        Result := False;
      end;
    end
    else
    begin
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        nErrCode := 35;
        if m_boDummyObject and (BaseObject.m_TargetCret = Self) and (m_btAttatckMode <> HAM_PEACE) then
          Result := True;
        case m_btAttatckMode of
          HAM_ALL { 0 } :
            begin
              nErrCode := 36;
              if (BaseObject.m_btRaceServer < RC_NPC { 10 } ) or (BaseObject.m_btRaceServer > RC_PEACENPC { 15 } ) then
                Result := True;
              if g_Config.boNonPKServer then
                Result := True;
            end;
          HAM_PEACE { 1 } :
            begin
              if BaseObject.m_btRaceServer >= RC_ANIMAL then
                Result := True;
            end;
          HAM_DEAR { 2 } :
            begin
              if (BaseObject.m_btRaceServer < RC_NPC { 10 } ) or (BaseObject.m_btRaceServer > RC_PEACENPC { 15 } ) then
                Result := True;
              // 爱人不攻击
              if BaseObject = TPlayObject(Self).m_DearHuman then
                Result := False;
              // 爱人的宝宝不攻击
              if (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) and
                (BaseObject.Master = TPlayObject(Self).m_DearHuman) then
                Result := False;
              if Result and IsMyBB then
                Result := False;
            end;
          HAM_MASTER { 3 } :
            begin
              if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
              begin
                Result := True;
                nErrCode := 37;
                if TPlayObject(Self).m_boMaster and (TPlayObject(Self).m_MasterList <> nil) then
                begin
                  nErrCode := 38;
                  for I := 0 to TPlayObject(Self).m_MasterList.Count - 1 do
                  begin
                    nErrCode := 39;
                    if TPlayObject(Self).m_MasterList.Items[I] = BaseObject then
                    begin
                      Result := False;
                      Break;
                    end;
                  end;
                end;
                nErrCode := 40;
                if TPlayObject(BaseObject).m_boMaster and (TPlayObject(BaseObject).m_MasterList <> nil) then
                begin
                  nErrCode := 41;
                  for I := 0 to TPlayObject(BaseObject).m_MasterList.Count - 1 do
                  begin
                    nErrCode := 42;
                    if TPlayObject(BaseObject).m_MasterList.Items[I] = Self then
                    begin
                      Result := False;
                      Break;
                    end;
                  end;
                end;
              end
              else
              begin
                if (BaseObject.m_btRaceServer < RC_NPC { 10 } ) or (BaseObject.m_btRaceServer > RC_PEACENPC { 15 } ) then
                  Result := True;
              end;
              nErrCode := 43;
              if Result and IsMyBB then
                Result := False;
            end;
          HAM_GROUP { 4 } :
            begin
              nErrCode := 44;
              if (BaseObject.m_btRaceServer < RC_NPC) or (BaseObject.m_btRaceServer > RC_PEACENPC) then
                Result := True;
              nErrCode := 45;
              // 本组的人不攻击
              if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and TPlayObject(Self).IsGroupMember(TPlayObject(BaseObject)) then
                Result := False
                // 本组的人的宝宝不攻击
              else if (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) and TPlayObject(Self)
                .IsGroupMember(TPlayObject(BaseObject.Master)) then
                Result := False;
              if Result and IsMyBB then
                Result := False;
              if g_Config.boNonPKServer then
                Result := True;
            end;
          HAM_GUILD { 5 } :
            begin
              nErrCode := 46;
              if (BaseObject.m_btRaceServer < RC_NPC) or (BaseObject.m_btRaceServer > RC_PEACENPC) then
                Result := True;

              nErrCode := 47;
              if m_MyGuild <> nil then
              begin
                if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
                begin
                  nErrCode := 48;
                  if TGUild(m_MyGuild).IsMember(BaseObject.m_sCharName) then
                    Result := False;

                  nErrCode := 49;
                  if BaseObject.m_MyGuild <> nil then
                  begin
                    nErrCode := 50;
                    if TGUild(m_MyGuild).IsAllyGuild(TGUild(BaseObject.m_MyGuild)) then
                      Result := False;
                  end;
                end
                else if (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
                begin
                  nErrCode := 480;
                  if TGUild(m_MyGuild).IsMember(BaseObject.Master.m_sCharName) then
                    Result := False;

                  nErrCode := 490;
                  if BaseObject.Master.m_MyGuild <> nil then
                  begin
                    nErrCode := 500;
                    if TGUild(m_MyGuild).IsAllyGuild(TGUild(BaseObject.Master.m_MyGuild)) then
                      Result := False;
                  end;
                end;
              end;

              if Result and IsMyBB then
                Result := False;

              if g_Config.boNonPKServer then
                Result := True;
            end;
          HAM_PKATTACK { 6 } :
            begin
              if m_boDummyObject then
              begin
                CounterattackDelay := 0;
                if Self is TSmartObject then
                  CounterattackDelay := TSmartObject(Self).m_dwCounterattackDelay;
                nErrCode := 51;
                if BaseObject.m_Master <> nil then
                begin
                  nErrCode := 52;
                  if BaseObject.m_Master.m_btRaceServer <> RC_PLAYOBJECT then
                  begin
                    Result := True;
                  end
                  else
                  begin
                    nErrCode := 53;
                    if (not BaseObject.InSafeZone) and
                      (((BaseObject.m_TargetCret = Self) and (tick_diff(BaseObject.m_dwSetTargetCretTick, MyGetTickCount) >=
                      CounterattackDelay)) or ((BaseObject.m_Master.m_TargetCret = Self) and
                      (tick_diff(BaseObject.m_Master.m_dwSetTargetCretTick, MyGetTickCount) >= CounterattackDelay)) or
                      ((BaseObject.Master <> nil) and (BaseObject.Master.m_TargetCret = Self) and
                      (tick_diff(BaseObject.Master.m_dwSetTargetCretTick, MyGetTickCount) >= CounterattackDelay))) then
                      Result := True;
                  end;
                end
                else
                begin
                  nErrCode := 54;
                  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
                  begin
                    nErrCode := 55;
                    if (not BaseObject.InSafeZone) and (BaseObject.m_TargetCret = Self) and
                      (tick_diff(BaseObject.m_dwSetTargetCretTick, MyGetTickCount) >= CounterattackDelay) then
                      Result := True;
                  end
                  else
                  begin
                    nErrCode := 56;
                    if (BaseObject.m_btRaceServer >= RC_ANIMAL) or
                      ((BaseObject.m_TargetCret = Self) and (tick_diff(BaseObject.m_dwSetTargetCretTick, MyGetTickCount) >=
                      CounterattackDelay)) then
                      Result := True;
                  end;
                end;
              end
              else
              begin
                nErrCode := 57;
                if (BaseObject.m_btRaceServer < RC_NPC) or (BaseObject.m_btRaceServer > RC_PEACENPC) then
                  Result := True;
                nErrCode := 58;
                if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
                begin
                  nErrCode := 59;
                  if TSmartObject(Self).PKLevel >= 2 then
                  begin
                    if TSmartObject(BaseObject).PKLevel < 2 then
                      Result := True
                    else
                      Result := False;
                  end
                  else
                  begin
                    nErrCode := 60;
                    if TSmartObject(BaseObject).PKLevel >= 2 then
                      Result := True
                    else
                      Result := False;
                  end;
                end;
              end;
              nErrCode := 61;
              if Result and IsMyBB then
                Result := False;
              if g_Config.boNonPKServer then
                Result := True;
            end;
          HAM_NATION:
            begin // 国家攻击模式
              nErrCode := 62;
              if (BaseObject.m_btRaceServer < RC_NPC) or (BaseObject.m_btRaceServer > RC_PEACENPC) then
                Result := True;
              // 国家怪物
              nErrCode := 63;
              if (m_btNation > 0) and (BaseObject.m_btNation > 0) and (m_btNation = BaseObject.m_btNation) and
                (BaseObject.m_btRaceServer >= RC_ANIMAL) then
              begin
                if not BaseObject.m_boCanAttackSameNationPlayer then
                begin
                  Result := False;
                end;
              end;
              nErrCode := 64;
              if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
              begin
                if (TPlayObject(Self).m_btNation = TPlayObject(BaseObject).m_btNation) and (TPlayObject(Self).m_btNation > 0) then
                  Result := False
                else if (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) and
                  (TPlayObject(BaseObject.Master).m_btNation = TPlayObject(Self).m_btNation) then
                  Result := False;
              end
              else if (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) and
                (TPlayObject(BaseObject.Master).m_btNation = TPlayObject(Self).m_btNation) then
              begin
                Result := False;
              end;
              nErrCode := 65;
              if g_Config.boNonPKServer then
                Result := True;
            end;
        end;
        nErrCode := 63;
        if (m_btNation > 0) and (BaseObject.m_btNation > 0) and (m_btNation = BaseObject.m_btNation) and
          (BaseObject.m_btRaceServer >= RC_ANIMAL) and (not BaseObject.m_boAllowSameNationPlayerAttack) then
        begin
          Result := False;
        end;
      end
      else
        Result := True;
    end;
    nErrCode := 66;
    if (BaseObject.m_boAdminMode or BaseObject.m_boTempAdminMode) or BaseObject.m_boStoneMode then
      Result := False;
    nErrCode := 67;
    // 修正在安全区，人物不能攻击假人英雄的宝宝 chongchong 2013-12-10
    if (m_btRaceServer = RC_PLAYOBJECT) and BaseObject.InSafeZone and (BaseObject.m_Master <> nil) and
      (BaseObject.m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
      Result := False;
    // 修复分身在安全区内打人物掉血（改为不掉血) chongchong 2014-01-17
    if (m_btRaceServer = RC_PLAYMOSTER) and (m_Master <> nil) and (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
    begin
      if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (BaseObject.InSafeZone or InSafeZone) then
        Result := False
      else if (BaseObject.m_Master <> nil) then
      begin
        if (BaseObject.m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and
          (BaseObject.m_Master.InSafeZone or InSafeZone) then
          Result := False;
      end;
    end;
    nErrCode := 68;
    // 人物或英雄宝宝 - 宝宝不攻击人物选项 chongchong 2013-12-09
    if (m_btRaceServer { 攻击方 } >= RC_ANIMAL { 50 } ) and (m_Master <> nil) and
      (m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
    begin
      if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        nErrCode := 69;
        if g_Config.boSlaveNotAttackHuman then
          Result := False
        else if (BaseObject.m_PEnvir <> nil) and (BaseObject.m_PEnvir.m_boSlaveNotAttackHuman) then
          Result := False;
      end;
      nErrCode := 70;
      if (BaseObject.m_btRaceServer = RC_HEROOBJECT) then
      begin
        nErrCode := 71;
        if g_Config.boSlaveNotAttackHero then
          Result := False
        else if (BaseObject.m_PEnvir <> nil) and (BaseObject.m_PEnvir.m_boSlaveNotAttackHero) then
          Result := False;
      end;
    end;
    // 怪物不攻击英雄 2019-07-18 20:37:08
    if Result then
    begin
      if (BaseObject.m_btRaceServer = RC_HEROOBJECT) and g_Config.boDisableMonsterAttackHero then
      begin
        IsHuman := m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
        if not IsHuman then
        begin
          _Master := Master;
          if (_Master <> nil) then
          begin
            IsHuman := _Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
          end;
        end;
        if not IsHuman then
          Result := False;
      end
      else if (BaseObject.m_boGamePet) and (BaseObject.m_Master <> nil) then
      begin
        if g_Config.boDisableAllAttackPet or (BaseObject.m_boDisableAllAttackPet <> 0) then
          Result := False
        else
        begin
          if not((m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) or
            ((m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT))) and
            ((g_Config.boDisableMonAttackPet) or (BaseObject.m_boDisableMonAttackPet <> 0)) then
          begin
            Result := False;
          end;
        end;
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage('TBaseObject.IsAttackTarget:' + m_sCharName + ' ' + IntToStr(nErrCode));
    end;
  end;
end;

function TBaseObject.IsProperTarget(BaseObject: TBaseObject): Boolean;
var
  nErrorCode: Integer;
begin
  Result := False;
  nErrorCode := 0;
  try
    // 加入对象空指针判断 -- piaoyun 2013-07-04
    if (BaseObject = nil) or (BaseObject = Self) then
      Exit;
    // BB不攻击自己 chongchong 2014-07-30
    if (Master <> nil) and (Master = BaseObject) then
      Exit;
    // 如果宝宝攻击人物的威力为0，则不攻击人物 chongchong 2015-12-05
    if (m_nSlaveAttackHumPowerRate = 0) and (Master <> nil) and (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      Result := False;
      Exit;
    end;
    nErrorCode := 1;
    Result := IsAttackTarget(BaseObject);
    if Result then
    begin
      nErrorCode := 2;
      if (m_btRaceServer = RC_PLAYOBJECT) and (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        nErrorCode := 3;
        Result := IsProtectTarget(BaseObject);
        nErrorCode := 4;
      end;
    end;
    if (m_btRaceServer = RC_PLAYOBJECT) and (BaseObject.m_Master <> nil) then
    begin
      if BaseObject.Master = Self then
      begin
        nErrorCode := 5;
        if not(BaseObject.m_boGamePet and (g_Config.boDisableAllAttackPet or (BaseObject.m_boDisableAllAttackPet <> 0))) then
          Result := m_btAttatckMode = HAM_ALL;
      end
      else
      begin
        if not(BaseObject.m_boGamePet and (BaseObject.m_Master <> nil) and (BaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT)
          and (g_Config.boDisableAllAttackPet or (BaseObject.m_boDisableAllAttackPet <> 0))) then
        begin
          nErrorCode := 6;
          Result := IsAttackTarget(BaseObject.m_Master);
          nErrorCode := 7;
          if Result then
          begin
            if (BaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              nErrorCode := 8;
              if BaseObject.InSafeZone or InSafeZone then
                Result := False;
              nErrorCode := 9;
            end;
          end;
        end;
        // if Result and (InSafeZone or BaseObject.InSafeZone) then Result:=False;
      end;
    end;
  except
    MainOutMessage(Format('[Exception] TBaseObject.IsProperTarget (%s) ErrorCode = %d', [ClassName, nErrorCode]));
  end;
end;

// 擒龙手目标检测
function TBaseObject.IsProperTargetSKILL_71(nLevel: LongWord; BaseObject: TBaseObject): Boolean;
begin
  Result := False;
  if (BaseObject = nil) or (BaseObject = Self) then
    Exit;
  if (BaseObject.m_btRaceServer < RC_NPC) or (BaseObject.m_btRaceServer > RC_PEACENPC) then
  begin
    if (BaseObject.m_btRaceServer <> RC_GUARD) and (BaseObject.m_btRaceServer <> RC_ARCHERGUARD) and
      (BaseObject.m_btRaceServer <> 110) and (BaseObject.m_btRaceServer <> 111) and (nLevel >= BaseObject.m_Abil.Level) and
      (not BaseObject.m_boGhost) and (not BaseObject.m_boDeath) then
    begin
      // 人物
      if ((not g_Config.boSkill71PullPlayObject) or (nLevel < BaseObject.m_Abil.Level)) and
        (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
        Exit;
      // 宝宝、英雄
      if ((not g_Config.boSkill71PullSlave) or (nLevel < BaseObject.m_Abil.Level)) and (BaseObject.m_Master <> nil) and
        (BaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
        Exit;
      // 安全区全禁止
      if g_Config.boSkill71PullCrossInSafeZone and ((BaseObject.m_btRaceServer = RC_PLAYOBJECT) or (BaseObject.m_Master <> nil)
        and (BaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT)) and (BaseObject.InSafeZone or InSafeZone) then
        Exit;
      if g_Config.boSkill71DisableAttackSameLevel and (nLevel = BaseObject.m_Abil.Level) then
        Exit;
      if g_Config.boSkill71DisableAttackFriend and (not IsProperTarget(BaseObject)) then
        Exit;
      Result := True;
    end;
  end;
end;

// 复活术
function TBaseObject.IsProperTargetSKILL_57(BaseObject: TBaseObject): Boolean;
begin
  Result := False;
  if (BaseObject = nil) or (BaseObject = Self) then
    Exit;
  if BaseObject.m_boDeath then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
      Result := True;
  end;
end;

// 召唤NPC
function TBaseObject.IsProperTargetSKILL_70(PlayObject: TBaseObject): Boolean;
begin
  Result := False;
  if (g_FunctionNPC <> nil) and (PlayObject <> nil) then
  begin
    if PlayObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      TPlayObject(PlayObject).m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(TPlayObject(PlayObject), '@Magic', False);
      Result := True;
    end;
  end;
end;

procedure TBaseObject.WeightChanged;
begin
  m_WAbil.Weight := RecalcBagWeight();
  SendUpdateMsg(Self, RM_WEIGHTCHANGED, 0, 0, 0, 0, '');
end;

// 人物是否在安全区域 -- piaoyun 2013-07-17
function TBaseObject.InSafeZone: Boolean;
var
  NationInfo: pTNationInfo;
begin
  Result := False;
  if m_PEnvir = nil then
    Exit;
  Result := m_PEnvir.m_boSAFE;
  if Result then
    Exit;
  if m_btRaceServer = RC_PLAYOBJECT then
  begin
    if TPlayObject(Self).m_btNation > 0 then
    begin
      NationInfo := g_NationManage.Items[TPlayObject(Self).m_btNation];
      if NationInfo <> nil then
      begin
        if (m_PEnvir.sMapName <> NationInfo.sRedHomeMap) or (Abs(m_nCurrX - NationInfo.nRedHomeX) > g_Config.nSafeZoneSize) or
          (Abs(m_nCurrY - NationInfo.nRedHomeY) > g_Config.nSafeZoneSize) then
        begin
          Result := False;
        end
        else
        begin
          Result := True;
        end;
        if Result then
          Exit;
      end;
    end;
  end;
  if (m_PEnvir.sMapName <> g_Config.sRedHomeMap) or (Abs(m_nCurrX - g_Config.nRedHomeX) > g_Config.nSafeZoneSize) or
    (Abs(m_nCurrY - g_Config.nRedHomeY) > g_Config.nSafeZoneSize) then
  begin
    Result := False;
  end
  else
  begin
    Result := True;
  end;
  if Result then
    Exit;
  Result := g_SafeAreaManager.PointInSafeArea(m_PEnvir.sMapName, m_nCurrX, m_nCurrY);
end;

function TBaseObject.InSafeZone(Envir: TEnvirnoment; nX, nY: Integer): Boolean;
var
  NationInfo: pTNationInfo;
begin
  Result := False;
  if Envir = nil then
    Exit;
  Result := Envir.m_boSAFE;
  if Result then
    Exit;
  if m_btRaceServer = RC_PLAYOBJECT then
  begin
    if TPlayObject(Self).m_btNation > 0 then
    begin
      NationInfo := g_NationManage.Items[TPlayObject(Self).m_btNation];
      if NationInfo <> nil then
      begin
        if (m_PEnvir.sMapName <> NationInfo.sRedHomeMap) or (Abs(nX - NationInfo.nRedHomeX) > g_Config.nSafeZoneSize) or
          (Abs(nY - NationInfo.nRedHomeY) > g_Config.nSafeZoneSize) then
        begin
          Result := False;
        end
        else
        begin
          Result := True;
        end;
        if Result then
          Exit;
      end;
    end;
  end;
  if (Envir.sMapName <> g_Config.sRedHomeMap) or (Abs(nX - g_Config.nRedHomeX) > g_Config.nSafeZoneSize) or
    (Abs(nY - g_Config.nRedHomeY) > g_Config.nSafeZoneSize) then
  begin
    Result := False;
  end
  else
  begin
    Result := True;
  end;
  if Result then
    Exit;
  Result := g_SafeAreaManager.PointInSafeArea(m_PEnvir.sMapName, nX, nY);
end;

procedure TBaseObject.OpenHolySeizeMode(dwInterval: LongWord);
begin
  m_boHolySeize := True;
  m_dwHolySeizeTick := MyGetTickCount();
  m_dwHolySeizeInterval := dwInterval;
  RefNameColor();
end;

procedure TBaseObject.BreakHolySeizeMode;
begin
  m_boHolySeize := False;
  RefNameColor();
end;

procedure TBaseObject.OpenCrazyMode(nTime: Integer);
begin
  m_boCrazyMode := True;
  m_dwCrazyModeTick := MyGetTickCount();
  m_dwCrazyModeInterval := nTime * 1000;
  RefNameColor();
end;

procedure TBaseObject.BreakCrazyMode;
begin
  if m_boCrazyMode then
  begin
    m_boCrazyMode := False;
    RefNameColor();
  end;
end;

function TBaseObject.GetSpellPoint(UserMagic: pTUserMagic): Integer;
begin
  if (UserMagic.MagicInfo <> nil) then
    Result := Round(UserMagic.MagicInfo.wSpell / (UserMagic.MagicInfo.btTrainLv + 1) * (UserMagic.btLevel + 1)) +
      UserMagic.MagicInfo.wDefSpell
  else
    Result := 0;
end;

procedure TBaseObject.TrainSkillNG(UserMagic: pTUserMagic; nTranPoint: Integer);
begin
  if (UserMagic <> nil) and (UserMagic.MagicInfo <> nil) then
  begin
    if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (UserMagic.btLevel < UserMagic.MagicInfo.btTrainLv) and
      (UserMagic.MagicInfo.TrainLevel[UserMagic.btLevel] <= TSmartObject(Self).m_AbilNG.Level) then
    begin
      TrainSkill(UserMagic, Random(3) + 1);
      if not CheckMagicLevelup(UserMagic) then
      begin
        SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, UserMagic.MagicInfo.wMagicID, MakeWord(UserMagic.btLevel, UserMagic.btNewLevel),
          UserMagic.nTranPoint, IntToStr(Integer(UserMagic.MagicAttr)), 3000);
      end;
    end;
  end;
end;

procedure TBaseObject.TrainSkill(UserMagic: pTUserMagic; nTranPoint: Integer);
begin
  if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and TSmartObject(Self).m_boFastTrain then // 技巧项链 //技巧项链
    nTranPoint := nTranPoint * 3;
  Inc(UserMagic.nTranPoint, nTranPoint);
end;

function TBaseObject.CheckMagicLevelup(UserMagic: pTUserMagic): Boolean; // 004C7054
var
  n10: Integer;
  btOldHitPoint: Byte;
begin
  Result := False;
  if (UserMagic.MagicInfo = nil) then
    Exit;
  if (UserMagic.btLevel < UserMagic.MagicInfo.btTrainLv) then
    n10 := UserMagic.btLevel
  else
    n10 := 0;
  if (UserMagic.MagicInfo.btTrainLv > UserMagic.btLevel) and (UserMagic.MagicInfo.MaxTrain[n10] <= UserMagic.nTranPoint) then
  begin
    if (UserMagic.MagicInfo.btTrainLv > UserMagic.btLevel) then
    begin
      Dec(UserMagic.nTranPoint, UserMagic.MagicInfo.MaxTrain[n10]);
      Inc(UserMagic.btLevel);
      SendUpdateDelayMsg(Self, RM_MAGIC_LVEXP, 0, UserMagic.MagicInfo.wMagicID, MakeWord(UserMagic.btLevel, UserMagic.btNewLevel),
        UserMagic.nTranPoint, IntToStr(Integer(UserMagic.MagicAttr)), 800);
      if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
      begin
        // 技能升级后，调整重算精确度 chongchong 2015-09-12
        btOldHitPoint := m_btHitPoint;
        RecalcAbilitys;
        if btOldHitPoint <> m_btHitPoint then
        begin
          SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
        end;
      end;
      sub_4C713C(UserMagic);
    end
    else
    begin
      UserMagic.nTranPoint := UserMagic.MagicInfo.MaxTrain[n10];
    end;
    Result := True;
  end;
end;

procedure TBaseObject.SetTargetCreat(BaseObject: TBaseObject);
begin
  // 已死的就不要设置为目标了 chongchong 2018-08-29
  if (Self <> m_TargetCret) and (m_TargetCret <> BaseObject) then
  begin
    if (BaseObject <> nil) then
    begin
      if (Length(m_sAttackTargetName) > 0) and (not SameText(BaseObject.m_sCharName, m_sAttackTargetName)) then
        Exit;
      if (BaseObject.m_boDeath) or (BaseObject.m_boGhost) then
        Exit;
    end;
    m_TargetCret := BaseObject;
    m_dwTargetFocusTick := MyGetTickCount();
    m_dwSetTargetCretTick := MyGetTickCount;
    m_DoTauntTarget := nil;
  end;
end;

procedure TBaseObject.DelTargetCreat();
begin
  if m_TargetCret <> nil then
    m_TargetCret := nil;
end;

function TBaseObject._Attack(var wHitMode: Word; AttackTarget: TBaseObject; AttackRate: Single;
  NpcReleaseagic: pTUserMagic): Boolean;
var
  nPower, nRetPower, nMagicID, nSuckDamagePoint: Integer;
  nCheckCode: Integer;
  SmartObject: TSmartObject;
  AbsorbRate: Integer;
  MagicACInfo: PMagicACInfo;
  IsUseSuckDamagePoint: Boolean;
  IsHuman: Boolean;
  _Master: TBaseObject;
  nOldMP: LongWord;
  IsChagneMP: Boolean;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject._Attack Name:= %s Code:=%d';
  HookError = '[Exception] TBaseObject.HookObjectAttack 2';
begin
  Result := False;
  nCheckCode := 0;
  case wHitMode of
    3:
      nMagicID := 7; // 攻杀
    4:
      nMagicID := 12; // 使用刺杀
    5:
      nMagicID := 25; // 使用半月
    7:
      nMagicID := 26; // 使用烈火
    8:
      nMagicID := 40; // 抱月刀 双龙斩   ID=40
    9:
      nMagicID := 42; // 龙影剑法
    10:
      nMagicID := 43; // 雷霆剑法
    15:
      nMagicID := 56; // 逐日剑法
    12:
      nMagicID := 60; // 破魂斩
    13:
      nMagicID := 61; // 劈星斩
    14:
      nMagicID := 62; // 雷霆一击
    11:
      nMagicID := 66; // 开天斩
    16:
      nMagicID := 101; // 三绝杀
    17:
      nMagicID := 102; // 断岳斩
    18:
      nMagicID := 103; // 横扫千军
  else
    nMagicID := 0;
  end;
  try
    // 自定义怪物 - 修改代码以支持攻击威力 可以用 MC, SC来计算 chongchong 2014-07-19
    nPower := GetAttackPower;
    if (m_Master <> nil) and (m_btRaceServer <> RC_HEROOBJECT) and (not(Self is TCopyMon)) then
      nPower := Round(nPower * (g_Config.nSlavePowerRate / 100));
    // ==============================================================================
    if AttackTarget = nil then
      Exit;
    {
      if (AttackTarget.m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER, RC_HEROOBJECT]) then
      begin
      SmartObject := TSmartObject(AttackTarget);
      if SmartObject.m_boSuperShiled then
      begin // 护体神盾被击破
      if (wHitMode = 4) and g_Config.UseSkillCloseSuperShileds[0] then
      SmartObject.CloseSuperShiled
      else if (wHitMode = 7) and g_Config.UseSkillCloseSuperShileds[1] then
      SmartObject.CloseSuperShiled
      else if (wHitMode = 11) and g_Config.UseSkillCloseSuperShileds[2] then
      SmartObject.CloseSuperShiled
      else if (wHitMode = 15) and g_Config.UseSkillCloseSuperShileds[3] then
      SmartObject.CloseSuperShiled
      else if (wHitMode in [12..14]) and g_Config.UseSkillCloseSuperShileds[4] then
      SmartObject.CloseSuperShiled;
      end;
      end;
    }
    nCheckCode := 4;
    if IsProperTarget(AttackTarget) then
    begin
      nCheckCode := 41;
      if (Random(AttackTarget.m_btSpeedPoint) >= m_btHitPoint) then
      begin
        nCheckCode := 42;
        nPower := 0;
      end;
      nCheckCode := 43;
    end
    else
      nPower := 0;
    nCheckCode := 5;
    if nPower > 0 then
    begin
      MagicACInfo := nil; // UserEngine.m_MagicACList.Get(nMagicID);
      if not CanCloseDefense then // 忽视目标防御
        nPower := AttackTarget.GetHitStruckDamage(Self, nPower, MagicACInfo)
      else
        nPower := AttackTarget.GetHitStruckDamage(Self, nPower, MagicACInfo, 4); // 不忽视盾防御 ++++++++++++  2020-11-09 23:46:37
      nPower := AttackTarget.NewAbilPower(2, nPower); // 物伤减少
    end;
    nPower := NewAbilPower(1, nPower); // 1元素增加攻击伤害
    nPower := GetPowerRateAdd(AttackTarget, nPower); // 2020-09-12 23:27:18
    nCheckCode := 600;
    if nPower > 0 then
    begin
      nCheckCode := 601;
      IsUseSuckDamagePoint := False;
      if AttackTarget.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
      begin
        SmartObject := TSmartObject(AttackTarget);
        IsHuman := m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
        if not IsHuman then
        begin
          _Master := Master;
          if (_Master <> nil) then
          begin
            IsHuman := _Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
          end;
        end;
        // 伤害吸收百分比 2020-09-17 20:11:44
        if not IsHuman then
          nPower := SmartObject.m_StruckDamageAbsorbMgr.GetStruckDamage(m_sCharName, nPower);
        if SmartObject.m_boTrainingNG and (SmartObject.m_AbilNG.NH >= g_Config.nNGHitStruckDecNG) then
        begin
          nPower := Max(0, nPower - SmartObject.GetNGDecPower);
          SmartObject.m_AbilNG.NH := Max(0, SmartObject.m_AbilNG.NH - g_Config.nNGHitStruckDecNG);
          SmartObject.RefAbilNH;
        end;
        if (SmartObject.m_nSuckDamagePoint > 0) and (nPower > 0) and (SmartObject.m_nSuckDamageRate > 0) then
        begin // 吸收伤害
          if Random(100) <= SmartObject.m_nSuckDamageProbability then
          begin
            nSuckDamagePoint := Round(SmartObject.m_nSuckDamageRate / 1000 * nPower);
            if nSuckDamagePoint > SmartObject.m_nSuckDamagePoint then
              nSuckDamagePoint := SmartObject.m_nSuckDamagePoint;
            Dec(SmartObject.m_nSuckDamagePoint, nSuckDamagePoint);
            nPower := Max(nPower - nSuckDamagePoint, 0);
            IsUseSuckDamagePoint := True;
          end;
        end;
        // 道法连击保护盾 chongchong 2013-11-10
        if (nPower > 0) and (SmartObject.m_btJob in [1, 2]) and (SmartObject.m_boContinuous) then
        begin
          AbsorbRate := Max(Random(g_Config.btContinuousProtectRandom + 1), g_Config.btContinuousProtect);
          if AbsorbRate > 100 then
            AbsorbRate := 100;
          nPower := Max(Round(nPower / 100 * (100 - AbsorbRate)), 0);
        end;
      end;
      if (AttackTarget <> nil) and (g_PluginManager <> nil) then
      begin
        g_PluginManager.HookBaseObjectAttack(Self, AttackTarget, nMagicID, nPower);
      end;
      if nPower > 0 then
      begin
        // 物理攻击倍数 piaoyun 2013-12-10
        nPower := Round(nPower * AttackRate);
        // 怪物伤害封顶 XXXXXXXXXXXXXXXXXX chongchong 2016-01-30
        nPower := GetNextDamage(nPower);
        nPower := AttackTarget.GetAttackPowerMax(nPower);
        nOldMP := AttackTarget.m_WAbil.MP;
        if nPower > 0 then
          nRetPower := AttackTarget.StruckDamage(nPower, Self, nMagicID)
        else
          nRetPower := 0;
        IsChagneMP := AttackTarget.m_WAbil.MP < nOldMP;
        nCheckCode := 602;
        // 带护身的装备飘血显示错误 nPower 改为 nRetPower chongchong 2014-05-16
        if (nRetPower > 0) or IsChagneMP then
          AttackTarget.SendDelayMsg(TBaseObject(RM_STRUCK), RM_10101, nRetPower, AttackTarget.m_WAbil.HP,
            AttackTarget.m_WAbil.MaxHP, NativeInt(Self), IntToStr(nMagicID), 200);
        nCheckCode := 603;
      end
      // 修正伤害被吸收完后，不触发被攻击chongchong 2018-12-09 15:43:30
      else if IsUseSuckDamagePoint then
      begin
        AttackTarget.SendDelayMsg(TBaseObject(RM_STRUCK), RM_10101, 0, AttackTarget.m_WAbil.HP, AttackTarget.m_WAbil.MaxHP,
          NativeInt(Self), IntToStr(nMagicID), 200);
      end;
      if (not AttackTarget.UnParalysis) and (m_boParalysis or (Random(100) < m_btFluteStoneParalysisRate)) and
        (Random(Max(AttackTarget.m_btAntiPoison + m_dwParalysisRate, 0)) = 0) then
      begin
        AttackTarget.m_PoisonHitter := Self;
        AttackTarget.MakePosion(POISON_STONE, m_dwParalysisTime, 0); // g_Config.nAttackPosionTime
      end;
      // 冰冻戒指 chongchong 2013-11-20
      if (not AttackTarget.UnFrozen) and (m_boFrozen or (Random(100) < m_btFluteStoneFrozenRate)) and
        (Random(Max(AttackTarget.m_btAntiPoison + m_dwFrozenRate, 0)) = 0) then
      begin
        AttackTarget.m_PoisonHitter := Self;
        AttackTarget.MakeFrozen(m_dwFrozenTime);
      end;
      // 蛛网戒指 chongchong 2013-11-20
      if (not AttackTarget.UnCobwebWinding) and (m_boCobwebWinding or (Random(100) < m_btFluteStoneWindingRate)) and
        (Random(Max(AttackTarget.m_btAntiPoison + m_dwCobwebWindingRate, 0)) = 0) then
      begin
        AttackTarget.m_PoisonHitter := Self;
        AttackTarget.OpenCobwebWinding(m_dwCobwebWindingTime);
      end;
      nRetPower := AttackTarget.DamageReboundPower(nPower);
      if (nRetPower > 0) then
      begin // 反弹伤害
        nRetPower := StruckDamage(nRetPower, nil, 0);
        SendDelayMsg(TBaseObject(RM_STRUCK), RM_10101, nRetPower, m_WAbil.HP, m_WAbil.MaxHP, NativeInt(AttackTarget), 'FT', 200);
      end;
      Result := True;
    end;
    if (AttackTarget <> nil) and (AttackTarget.m_btRaceServer <> RC_PLAYOBJECT) then
      AttackTarget.SendMsg(AttackTarget, RM_STRUCK, nPower, AttackTarget.m_WAbil.HP, AttackTarget.m_WAbil.MaxHP,
        NativeInt(Self), '');
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg, [m_sCharName, nCheckCode]));
      MainOutMessage(E.Message)
    end;
  end;
end;

procedure TBaseObject.IncGamePetExt(dwExp: LongWord);
var
  dwAddExp: LongWord;
  lwExp: LongWord;
  nMaxLevel: LongWord;
  nMaxUpLevelCount: Integer;
  Int64Value: Int64;
label
  RefExp;
begin
  if not m_boGamePet then
    Exit;
  if g_Config.btMaxLevel = 0 then
    nMaxLevel := MAXUPLEVEL
  else if g_Config.btMaxLevel = 1 then
    nMaxLevel := High(Integer)
  else
    nMaxLevel := High(LongWord);
  lwExp := dwExp;
  nMaxUpLevelCount := 0;
RefExp:
  Inc(nMaxUpLevelCount);
  dwAddExp := m_Abil.MaxExp - m_Abil.Exp;
  if (lwExp >= dwAddExp) and (m_Abil.MaxExp > m_Abil.Exp) then
  begin
    if m_Abil.Level < nMaxLevel then
    begin
      Inc(m_Abil.Level);
      lwExp := lwExp - dwAddExp;
      m_Abil.Exp := 0;
      HasLevelUp(m_Abil.Level - 1);
      IncHealthSpell(2000, 2000);
      if lwExp > 0 then
      begin
        if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
        begin
          goto RefExp;
          Exit;
        end
        else
        begin
          Int64Value := Int64(m_Abil.Exp) + lwExp;
          m_Abil.Exp := Min(Int64Value, High(LongWord));
        end;
      end;
    end;
  end
  else
  begin
    if m_Abil.MaxExp > m_Abil.Exp then
    begin
      Int64Value := Int64(m_Abil.Exp) + lwExp;
      m_Abil.Exp := Min(Int64Value, High(LongWord));
    end
    else
    begin
      Inc(m_Abil.Level);
      Dec(m_Abil.Exp, m_Abil.MaxExp);
      HasLevelUp(m_Abil.Level - 1);
      IncHealthSpell(2000, 2000);
      if nMaxUpLevelCount < g_Config.nMaxUpLevelCount then
      begin
        goto RefExp;
        Exit;
      end
      // 升级完后，还有经验，加到人物身上 chongchong 2016-05-17
      else
      begin
        if lwExp > 0 then
        begin
          Int64Value := Int64(m_Abil.Exp) + lwExp;
          m_Abil.Exp := Min(Int64Value, High(LongWord));
        end;
      end;
    end;
  end;
  m_WAbil.Exp := m_Abil.Exp;
  m_WAbil.MaxExp := m_Abil.MaxExp;
  m_WAbil.Level := m_Abil.Level;
  if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
  begin
    TPlayObject(m_Master).SendDefMessage(SM_PETWINEXP, m_WAbil.Exp, TPlayObject(m_Master).m_MyGamePetIndex, 0, 0, '');
  end;
  if g_FunctionNPC <> nil then
  begin
    // m_nScriptGotoCount := 0;
    // g_FunctionNPC.GotoLable(Self, '@GetExp', False);
  end;
end;

function TSmartObject._Attack(var wHitMode: Word; AttackTarget: TBaseObject; AttackRate: Single;
  NpcReleaseagic: pTUserMagic): Boolean;
// 攻击角色
  function DirectAttack(BaseObject: TBaseObject; nSecPwr, wMagicID: Integer; IsSetPKPower: Boolean = True): Boolean;
  var
    nSuckDamagePoint: Integer;
    SmartObject: TSmartObject;
    AbsorbRate: Integer;
    BlastHitType: TBlastHitType;
    DelayTime: Integer;
    IsDecMP: Boolean;
    nOldMP: LongWord;
  begin
    Result := False;
    // 修复英雄不能使用开天斩 chongchong 2013-12-11
    if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) or (BaseObject.m_btRaceServer = RC_PLAYOBJECT) or
      (not(InSafeZone and BaseObject.InSafeZone)) then
    begin
      if IsProperTarget(BaseObject) then
      begin
        if (Random(BaseObject.m_btSpeedPoint) < m_btHitPoint) or (wMagicID = 62 { 雷霆一击 } ) or (wMagicID = 101 { 三绝杀 } ) or
          (wMagicID = 102 { 断岳斩 } ) or (wMagicID = 103 { 横扫千军 } ) then
        begin // 敏捷 < 准确度 攻击有效    准确
          if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
          begin // 内力增加防御
            SmartObject := TSmartObject(BaseObject);
            if SmartObject.m_boTrainingNG and (SmartObject.m_AbilNG.NH >= g_Config.nNGHitStruckDecNG) then
            begin
              nSecPwr := Max(0, nSecPwr - SmartObject.GetNGDecPower);
              SmartObject.m_AbilNG.NH := Max(0, SmartObject.m_AbilNG.NH - g_Config.nNGHitStruckDecNG);
              SmartObject.RefAbilNH;
            end;
          end;
          nSecPwr := NewAbilPower(1, nSecPwr); // 1元素增加攻击伤害
          nSecPwr := BlastHit(nSecPwr, BaseObject, BlastHitType); // 暴击
          nSecPwr := GetPowerRateAdd(BaseObject, nSecPwr); // 2020-09-12 23:24:45
          nSuckDamagePoint := 0;
          if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
          begin
            // 攻击者不是怪物，伤害吸收百分比 2020-09-17 20:11:44
            // nSecPwr := TSmartObject(BaseObject).m_StruckDamageAbsorbMgr.GetStruckDamage(m_sCharName, nSecPwr);
            if (TSmartObject(BaseObject).m_nSuckDamagePoint > 0) and (nSecPwr > 0) and
              (TSmartObject(BaseObject).m_nSuckDamageRate > 0) then
            begin // 吸收伤害
              if Random(100) < TSmartObject(BaseObject).m_nSuckDamageProbability then
              begin
                nSuckDamagePoint := Round(TSmartObject(BaseObject).m_nSuckDamageRate * nSecPwr / 1000);
                if nSuckDamagePoint > TSmartObject(BaseObject).m_nSuckDamagePoint then
                  nSuckDamagePoint := TSmartObject(BaseObject).m_nSuckDamagePoint;
                Dec(TSmartObject(BaseObject).m_nSuckDamagePoint, nSuckDamagePoint);
                nSecPwr := Max(nSecPwr - nSuckDamagePoint, 0);
              end;
            end;
            // 道法连击保护盾 chongchong 2013-11-10
            if (nSecPwr > 0) and (BaseObject.m_btJob in [1, 2]) and (TSmartObject(BaseObject).m_boContinuous) then
            begin
              AbsorbRate := Max(Random(g_Config.btContinuousProtectRandom + 1), g_Config.btContinuousProtect);
              if AbsorbRate > 100 then
                AbsorbRate := 100;
              nSecPwr := Max(Round(nSecPwr / 100 * (100 - AbsorbRate)), 0);
            end;
          end;
          // chongchong 2014-10-09
          // 修复Envir\MonSpAbilList.txt扩展怪物有两个属性无效的问题
          // 物理攻击减免有问题.近身物理可以减免.隔位攻击(如刺杀等)不能减免 龙影剑法 zhu日剑法等也不能减免.叫修正一下吧
          nSecPwr := BaseObject.NewAbilPower(2, nSecPwr); // 物理防御减少
          nSecPwr := GetNextDamage(nSecPwr);
          // 怪物攻击封顶 XXXXXXXXXXXXXXXX  chongchong 2016-01-30
          nSecPwr := BaseObject.GetAttackPowerMax(nSecPwr);
          // 超出怪物的血量按怪物血来算(目标带了护身就不能这样算。不然血和蓝较少时，减了蓝不减血，打不死 2017-09-19) chongchong 2017-06-30
          // if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
          // begin
          // if not TSmartObject(BaseObject).m_boMagicShield then
          // begin
          // if nSecPwr > BaseObject.m_WAbil.HP then
          // nSecPwr := BaseObject.m_WAbil.HP;
          // end;
          // end
          // else
          // begin
          // if nSecPwr > BaseObject.m_WAbil.HP then
          // nSecPwr := BaseObject.m_WAbil.HP;
          // end;
          if (BaseObject <> nil) and (g_PluginManager <> nil) then
          begin
            g_PluginManager.HookBaseObjectAttack(Self, BaseObject, wMagicID, nSecPwr);
          end;
          IsDecMP := False;
          if nSecPwr > 0 then
          begin
            // 魔法技能对怪物施展时，超过怪物血量，按怪物血量来算 chongchong 2018-02-13
            nOldMP := BaseObject.m_WAbil.MP;
            nSecPwr := BaseObject.StruckDamage(nSecPwr, Self, wMagicID, IsSetPKPower);
            IsDecMP := BaseObject.m_WAbil.MP < nOldMP; // 用护身戒指抵御了伤害 2020-03-26 22:59:29
          end;
          // 隔位刺杀技能延时 chongchong 2017-09-29
          if wHitMode = 4 then
          begin
            DelayTime := 0;
          end
          // 半月弯刀技能延时 chongchong 2017-10-21
          else if wHitMode = 5 then
          begin
            DelayTime := 0;
          end
          // 开天斩
          else if wHitMode = 11 then
          begin
            DelayTime := 0;
          end
          // 破魂斩
          else if wHitMode = 12 then
          begin
            DelayTime := 200;
          end
          // 逐日剑法
          else if wHitMode = 15 then
          begin
            DelayTime := 0;
          end
          // 三绝杀
          else if wHitMode = 16 then
          begin
            DelayTime := 0;
          end
          // 断岳斩
          else if wHitMode = 17 then
          begin
            DelayTime := 0;
          end
          // 横扫千军
          else if wHitMode = 18 then
          begin
            DelayTime := 0;
          end
          else
          begin
            DelayTime := 300; // 将这里原延时500改为了300 chongchong 2018-05-15
          end;
          // 伤害被吸收后，也要触发 +++ (nSuckDamagePoint <> 0)  @Struck/@Attack 2020-09-15 01:18:26
          if (nSecPwr > 0) or (nSuckDamagePoint <> 0) or (IsDecMP) then
          begin
            if DelayTime = 0 then
            begin
              if NpcReleaseagic <> nil then
              begin
                BaseObject.SendMsg(TBaseObject(RM_STRUCK), RM_10101_EX, nSecPwr, BaseObject.m_WAbil.HP, BaseObject.m_WAbil.MaxHP,
                  NativeInt(Self), IntToStr(MakeLong(wMagicID, Integer(BlastHitType))));
              end
              else
              begin
                BaseObject.SendMsg(TBaseObject(RM_STRUCK), RM_10101, nSecPwr, BaseObject.m_WAbil.HP, BaseObject.m_WAbil.MaxHP,
                  NativeInt(Self), IntToStr(MakeLong(wMagicID, Integer(BlastHitType))));
              end;
            end
            else
            begin
              if NpcReleaseagic <> nil then
              begin
                BaseObject.SendDelayMsg(TBaseObject(RM_STRUCK), RM_10101_EX, nSecPwr, BaseObject.m_WAbil.HP,
                  BaseObject.m_WAbil.MaxHP, NativeInt(Self), IntToStr(MakeLong(wMagicID, Integer(BlastHitType))), DelayTime);
              end
              else
              begin
                BaseObject.SendDelayMsg(TBaseObject(RM_STRUCK), RM_10101, nSecPwr, BaseObject.m_WAbil.HP,
                  BaseObject.m_WAbil.MaxHP, NativeInt(Self), IntToStr(MakeLong(wMagicID, Integer(BlastHitType))), DelayTime);
              end;
            end;
          end;
          if BaseObject.m_btRaceServer <> RC_PLAYOBJECT then
          begin
            BaseObject.SendMsg(BaseObject, RM_STRUCK, nSecPwr, BaseObject.m_WAbil.HP, BaseObject.m_WAbil.MaxHP, NativeInt(Self),
              IntToStr(Integer(BlastHitType)));
          end;
          if (GetPoseCreate(AttackTarget) = AttackTarget) and (AttackTarget = BaseObject) and (not BaseObject.UnParalysis) and
            (m_boParalysis or (Random(100) < m_btFluteStoneParalysisRate)) and
            (Random(Max(BaseObject.m_btAntiPoison + m_dwParalysisRate, 0)) = 0) then
          begin
            BaseObject.MakePosion(POISON_STONE, m_dwParalysisTime, 0); // g_Config.nAttackPosionTime
          end;
          // 毒素武器
          if (((GetPoseCreate = AttackTarget) and (AttackTarget = BaseObject)) or (g_Config.boPoisonWeaponCanHitAllTarget and
            (AttackTarget <> BaseObject))) and m_boPoisonWeapon and (not BaseObject.UnPosion) and
            (Random(Max(BaseObject.m_btAntiPoison, 0)) = 0) and (Random(100) < m_nPoisonWeaponRate) then
          begin
            BaseObject.m_PoisonHitter := Self;
            BaseObject.MakePosion(POISON_DECHEALTH, m_nPoisonWeaponBaseTime + Random(m_nPoisonWeaponRandomTime),
              m_nPoisonWeaponDamageHealth);
          end;
          // 冰冻戒指 chongchong 2013-11-20
          if (GetPoseCreate(AttackTarget) = AttackTarget) and (AttackTarget = BaseObject) and (not BaseObject.UnFrozen) and
            (m_boFrozen or (Random(100) < m_btFluteStoneFrozenRate)) and
            (Random(Max(BaseObject.m_btAntiPoison + m_dwFrozenRate, 0)) = 0) then
          begin
            BaseObject.m_PoisonHitter := Self;
            BaseObject.MakeFrozen(m_dwFrozenTime);
          end;
          // 蛛网戒指 chongchong 2013-11-20
          if (GetPoseCreate(AttackTarget) = AttackTarget) and (AttackTarget = BaseObject) and (not BaseObject.UnCobwebWinding) and
            (m_boCobwebWinding or (Random(100) < m_btFluteStoneWindingRate)) and
            (Random(Max(BaseObject.m_btAntiPoison + m_dwCobwebWindingRate, 0)) = 0) then
          begin
            BaseObject.m_PoisonHitter := Self;
            BaseObject.OpenCobwebWinding(m_dwCobwebWindingTime);
          end;
          if (nSecPwr > 0) then
          begin // 反弹伤害
            nSecPwr := BaseObject.DamageReboundPower(nSecPwr);
            if nSecPwr > 0 then
            begin
              nSecPwr := StruckDamage(nSecPwr, nil, wMagicID);
              if NpcReleaseagic <> nil then
              begin
                SendDelayMsg(TBaseObject(RM_STRUCK), RM_10101_EX, nSecPwr, m_WAbil.HP, m_WAbil.MaxHP, NativeInt(BaseObject),
                  'FT', 500);
              end
              else
              begin
                SendDelayMsg(TBaseObject(RM_STRUCK), RM_10101, nSecPwr, m_WAbil.HP, m_WAbil.MaxHP, NativeInt(BaseObject),
                  'FT', 500);
              end;
              if m_btRaceServer <> RC_PLAYOBJECT then
              begin
                SendMsg(Self, RM_STRUCK, nSecPwr, m_WAbil.HP, m_WAbil.MaxHP, NativeInt(BaseObject), 'FT');
              end;
            end;
          end;
          Result := True;
        end;
      end;
    end;
  end;
// 刺杀前面一个位置的攻击
  function SwordLongAttack(nSecPwr: Integer; IsSetPKPower: Boolean; MagicACInfo: PMagicACInfo; MagicLevel: Integer): Boolean;
  var
    nX, nY: Integer;
    BaseObject: TBaseObject;
  begin
    Result := False;
    if m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, m_btDirection, 2, nX, nY) then
    begin
      // 取消刺杀目标权限为10时，目标不受攻击 chongchong 2015-10-08
      // BaseObject := m_PEnvir.GetMovingObjectEx(Self, nX, nY, True);
      BaseObject := nil;
      if m_TargetCret <> nil then
      begin
        if m_PEnvir.GetMovingObject(nX, nY, m_TargetCret, True) = m_TargetCret then
          BaseObject := m_TargetCret;
      end;
      if BaseObject = nil then
      begin
        BaseObject := m_PEnvir.GetMovingObject(nX, nY, True);
      end;
      if BaseObject <> nil then
      begin
        nSecPwr := GetMagicPercentPower(12, nSecPwr, BaseObject);
        if (nSecPwr > 0) and IsProperTarget(BaseObject) then
        begin
          if m_MagicErgumSkill <> nil then
            nSecPwr := GetSkillLastPowerNG(nSecPwr, GetSkillAttackPowerNG(BaseObject, m_MagicErgumSkill, nSecPwr),
              GetSkillDefensePowerNG(BaseObject, m_MagicErgumSkill, nSecPwr));
          // 攻击前破盾  2019-07-24
          CloseTargetSuperShiled(4, MagicLevel, BaseObject);
          /// ////////////////刺杀忽视魔法盾 piaoyun 2013-08-18//////////////////
          nSecPwr := BaseObject.GetHitStruckDamage(Self, nSecPwr, MagicACInfo, 2);
          /// ///////////////////////////////////////////////////////////////////
          /// ////////////////刺杀忽视物理防御 piaoyun 2013-08-18//////////////////
          if { (not g_Config.boSwordLongNotDefence) and } (not CanCloseDefense) then
          begin
            nSecPwr := BaseObject.GetHitStruckDamage(Self, nSecPwr, MagicACInfo, 1);
            nSecPwr := BaseObject.GetHitStruckDamage(Self, nSecPwr, nil, 3);
          end;
          /// ///////////////////////////////////////////////////////////////////
          DirectAttack(BaseObject, nSecPwr, 12, IsSetPKPower);
          // 英雄刺杀可能是误伤经过路人，先不管 chongchong 2013-09-14
          if Self.m_btRaceServer <> RC_HEROOBJECT then
          begin
            SetTargetCreat(BaseObject);
          end;
          // 修正隔位刺杀只有隔位目标时，<$ATTACKMONSTER_MAXHPEX>等变量为空 2021-01-14
          if m_CurrTargetEx = nil then
            m_CurrTargetEx := BaseObject;
          // 攻击后破盾  2019-07-24
          // CloseTargetSuperShiled(4, MagicLevel, BaseObject);
        end;
        Result := True;
      end;
    end;
  end;
// 半月攻击
  function SwordWideAttack(nSecPwr: Integer): Boolean;
  var
    nC, n10, nPower, nPower1, nPower2, nAttackPower1, nAttackPower2, nDefensePower: Integer;
    nX, nY: Integer;
    BaseObject: TBaseObject;
  begin
    Result := False;
    nC := 0;
    if (nSecPwr > 0) then
    begin
      if (m_MagicBanwolSkill <> nil) and (m_MagicBanwolSkill.MagicInfo <> nil) then
      begin
        nPower1 := nSecPwr;
        nPower2 := Min(LongWord(Round(nSecPwr / (m_MagicBanwolSkill.MagicInfo.btTrainLv + 10) * (m_MagicBanwolSkill.btLevel + 2))
          ), High(Integer));
        nAttackPower1 := GetSkillAttackPowerNG(Self, m_MagicBanwolSkill, nPower1);
        nAttackPower2 := GetSkillAttackPowerNG(Self, m_MagicBanwolSkill, nPower2);
      end
      else
      begin
        nPower1 := nSecPwr;
        nPower2 := nSecPwr;
        nAttackPower1 := nPower1;
        nAttackPower2 := nPower2;
      end;
      while (True) do
      begin
        n10 := (m_btDirection + g_Config.WideAttack[nC]) mod 8;
        if m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, n10, 1, nX, nY) then
        begin
          BaseObject := m_PEnvir.GetMovingObject(nX, nY, True);
          if (BaseObject <> nil) and IsProperTarget(BaseObject) then
          begin
            if AttackTarget = BaseObject then
            begin // 正面攻击怪物
              nDefensePower := GetSkillDefensePowerNG(BaseObject, m_MagicBanwolSkill, nPower1);
              nPower := GetSkillLastPowerNG(nPower1, nAttackPower1, nDefensePower);
              nPower := GetMagicPercentPower(25, nPower, BaseObject);
              if nPower > 0 then
                Result := DirectAttack(BaseObject, nPower, 25, True);
            end
            else
            begin // 其他方向的怪物 攻击减小
              nDefensePower := GetSkillDefensePowerNG(BaseObject, m_MagicBanwolSkill, nPower2);
              nPower := GetSkillLastPowerNG(nPower2, nAttackPower2, nDefensePower);
              nPower := GetMagicPercentPower(25, nPower, BaseObject);
              if nPower > 0 then
                Result := DirectAttack(BaseObject, nPower, 25, False);
            end;
            SetTargetCreat(BaseObject);
          end;
        end;
        Inc(nC);
        if nC >= 3 then
          Break;
      end;
    end;
  end;
