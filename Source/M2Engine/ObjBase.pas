          end
          else
          begin
            if m_btJob = 0 then
            begin
              nResotreHPSpeed := g_Config.nHealthFillTime_Hero_Warrior; // MainOutMessage('战士英雄回血速度')
              nResotreMPSpeed := g_Config.nSpellFillTime_Hero_Warrior; // MainOutMessage('战士英雄回蓝速度')
              nResotreHPBase := g_Config.nHealthBaseNum_Hero_Warrior; // MainOutMessage('战士英雄回血基数')
              nResotreMPBase := g_Config.nSpellBaseNum_Hero_Warrior; // MainOutMessage('战士英雄回蓝基数')
            end
            else if m_btJob in [1, 2] then
            begin
              nResotreHPSpeed := g_Config.nHealthFillTime_Hero_TaoistAndWizard; // MainOutMessage('道法英雄回血速度')
              nResotreMPSpeed := g_Config.nSpellFillTime_Hero_TaoistAndWizard; // MainOutMessage('道法英雄回蓝速度')
              nResotreHPBase := g_Config.nHealthBaseNum_Hero_TaoistAndWizard; // MainOutMessage('道法英雄回血基数')
              nResotreMPBase := g_Config.nSpellBaseNum_Hero_TaoistAndWizard; // MainOutMessage('道法英雄回蓝基数')
            end
            else
            begin
              nResotreHPSpeed := g_Config.nHealthFillTime; // MainOutMessage('xxxxxxxxxxxxxxxxxxxxxxxx其它职业英雄回血速度');
              nResotreMPSpeed := g_Config.nSpellFillTime; // MainOutMessage('xxxxxxxxxxxxxxxxxxxxxxxx其它职业英雄回蓝速度');
              nResotreHPBase := g_Config.nHealthBaseNum; // MainOutMessage('xxxxxxxxxxxxxxxxxxxxxxxx其它职业英雄回血基数');
              nResotreMPBase := g_Config.nSpellBaseNum; // MainOutMessage('xxxxxxxxxxxxxxxxxxxxxxxx其它职业英雄回蓝基数');
            end;
          end;
        end;
    else // 怪物
      begin
        nResotreHPSpeed := g_Config.nHealthFillTime; // MainOutMessage(Format('怪物"%s"回血', [GetShowName()]));
        nResotreMPSpeed := g_Config.nSpellFillTime; // MainOutMessage(Format('怪物"%s"回血', [GetShowName()]));
        nResotreHPBase := g_Config.nHealthBaseNum; // 怪物回血基数
        nResotreMPBase := g_Config.nSpellBaseNum; // 怪物回蓝基数
      end;
    end;
    if nResotreHPBase <= 0 then
      nResotreHPBase := 1;

    if nResotreMPBase <= 0 then
      nResotreMPBase := 1;

    if (not m_boDeath) then
    begin
      try
        if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
        begin
          SmartObject := TSmartObject(Self); // {1}
          // 当前地图已经复活次数的自动清零间隔(最小30秒).具体表示:每经过指定秒人物在当前地图复活过的次数自动减1.
          with SmartObject do
          begin // {2}
            if (m_nRevivalCount > 0) //
              and (m_PEnvir <> nil) //
              and (m_PEnvir.m_nRevivalMaxCount > 0) //
              and (MyGetTickCount() - m_dwRevivalCheckTick > m_PEnvir.m_nRevivalCheckTime) then
            begin
              m_dwRevivalCheckTick := MyGetTickCount();
              Dec(m_nRevivalCount); // 复活次数
            end;

            if (MyGetTickCount() - m_dwRevivalTick >= 1000) //
            { and ((m_boRevival or (Random(100) < m_btFluteStoneRevivalRate))) } then
            begin
              m_dwRevivalTick := m_dwRevivalTick + 1000;
              Inc(m_nCheckRevivalTime);
            end;

            if m_WAbil.HP <= 0 then
            begin
              if m_LastHiter = nil then
              begin
                IsNpcReborn := m_boNpcReborn and (m_nNpcRebornCount > 0) and (m_nNpcRebornTime > 0) and
                  (tick_diff(m_dwNpcRebornStartTick, MyGetTickCount()) <= m_nNpcRebornTime);

                if IsNpcReborn then
                begin
                  if (m_PEnvir <> nil) and ((m_PEnvir.m_nRevivalMaxCount < 0) { 小于0则无限制次数 } or
                    (m_nRevivalCount < m_PEnvir.m_nRevivalMaxCount) { 或者以地图参数为准 } ) then
                  begin
                    if m_PEnvir.m_nRevivalMaxCount > 0 then
                      Inc(m_nRevivalCount);

                    Dec(m_nNpcRebornCount);
                    Inc(m_nTriggerNpcRebornCount);

                    if m_nNpcRebornCount = 0 then
                      m_boNpcReborn := False;

                    m_WAbil.HP := m_WAbil.MaxHP;
                    // HealthSpellChanged;
                    boNeedRefreshHMP := True; // 优化chongchong 2018-02-13
                    // NPC复活命令Setreborn生效后，触发QF的[@NpcRevival]字段 无效 2020-03-24 18:22:04
                    if (g_FunctionNPC <> nil) { and (g_Config.boRevivalTouch) } then
                    begin
                      if (m_btRaceServer = RC_PLAYOBJECT) then
                      begin
                        TPlayObject(Self).m_nScriptGotoCount := 0;
                        g_FunctionNPC.GotoLable(TPlayObject(Self), '@NpcRevival', False);
                      end
                      else if (m_btRaceServer = RC_HEROOBJECT) //
                        and (m_Master <> nil) //
                        and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
                      begin
                        TPlayObject(m_Master).m_nScriptGotoCount := 0;
                        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@H.NpcRevival', False);
                      end;
                    end;
                    SysMsg(g_sNPCRevivalRecoverMsg { '复活命令生效，体力恢复' } , c_Green, t_Hint);
                  end
                  // 设置为0 则不允许复活 piaoyun 2013-09-05
                  else if m_PEnvir.m_nRevivalMaxCount = 0 then
                    SysMsg(g_sCurMapDisableRevivalMsg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
                end
                else if (m_nCheckRevivalTime * 1000 >= m_nRevivalTime) and
                  (m_boRevival or (Random(100) < m_btFluteStoneRevivalRate)) then
                begin
                  m_nCheckRevivalTime := 0;
                  if (m_PEnvir <> nil) and ((m_PEnvir.m_nRevivalMaxCount < 0) { 小于0则无限制次数 } or
                    (m_nRevivalCount < m_PEnvir.m_nRevivalMaxCount) { 或者以地图参数为准 } ) then
                  begin
                    if m_PEnvir.m_nRevivalMaxCount > 0 then
                      Inc(m_nRevivalCount);
                    ItemDamageRevivalRing;
                    if (m_nRevivalMaxHP <= 0) or (m_nRevivalMaxHP >= 100) then
                      m_WAbil.HP := m_WAbil.MaxHP
                    else
                      m_WAbil.HP := Max(Round(m_WAbil.MaxHP * m_nRevivalMaxHP / 100), 1);

                    // HealthSpellChanged;
                    boNeedRefreshHMP := True; // 优化chongchong 2018-02-13
                    // 修复触发脚本报错 chongchong 2014-09-21
                    if (g_FunctionNPC <> nil) and (g_Config.boRevivalTouch) then
                    begin
                      if (m_btRaceServer = RC_PLAYOBJECT) then
                      begin
                        TPlayObject(Self).m_nScriptGotoCount := 0;
                        g_FunctionNPC.GotoLable(TPlayObject(Self), '@Revival', False);
                      end
                      else if (m_btRaceServer = RC_HEROOBJECT) //
                        and (m_Master <> nil) //
                        and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
                      begin
                        TPlayObject(m_Master).m_nScriptGotoCount := 0;
                        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@H.Revival', False);
                      end;
                    end;
                    SysMsg(g_sRevivalRecoverMsg { '复活戒指生效，体力恢复' } , c_Green, t_Hint);
                  end
                  // 设置为0 则不允许复活 piaoyun 2013-09-05
                  else if m_PEnvir.m_nRevivalMaxCount = 0 then
                    SysMsg(g_sCurMapDisableRevivalMsg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
                end;
              end
              else
              begin
                if (m_LastHiter <> nil) and m_LastHiter.UnRevival then
                  boUnRevival := True
                else
                  boUnRevival := False;

                IsNpcReborn := m_boNpcReborn and (m_nNpcRebornCount > 0) and (m_nNpcRebornTime > 0) and
                  (tick_diff(m_dwNpcRebornStartTick, MyGetTickCount()) <= m_nNpcRebornTime);

                if (not boUnRevival) and IsNpcReborn then
                begin
                  // m_nCheckRevivalTime := 0;  //不重置复活戒指的时间 By 一支笔 at:2022-03-17 11:05:30
                  if (m_PEnvir <> nil) //
                    and ((m_PEnvir.m_nRevivalMaxCount < 0) or (m_nRevivalCount < m_PEnvir.m_nRevivalMaxCount)) then
                  begin
                    if m_PEnvir.m_nRevivalMaxCount > 0 then
                      Inc(m_nRevivalCount);
                    // ItemDamageRevivalRing;
                    Dec(m_nNpcRebornCount);
                    Inc(m_nTriggerNpcRebornCount);
                    if m_nNpcRebornCount = 0 then
                    begin
                      m_boNpcReborn := False;
                    end;
                    m_WAbil.HP := m_WAbil.MaxHP;
                    // HealthSpellChanged;
                    boNeedRefreshHMP := True; // 优化chongchong 2018-02-13
                    // NPC复活命令Setreborn生效后，触发QF的[@NpcRevival]字段 无效 2020-03-24 18:22:19
                    if (g_FunctionNPC <> nil) { and (g_Config.boRevivalTouch) } then
                    begin
                      if (m_btRaceServer = RC_PLAYOBJECT) then
                      begin
                        TPlayObject(Self).m_nScriptGotoCount := 0;
                        g_FunctionNPC.GotoLable(TPlayObject(Self), '@NpcRevival', False);
                      end
                      else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT)
                      then
                      begin
                        TPlayObject(m_Master).m_nScriptGotoCount := 0;
                        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@H.NpcRevival', False);
                      end;
                    end;
                    SysMsg(g_sNPCRevivalRecoverMsg { '复活命令生效，体力恢复' } , c_Green, t_Hint);
                  end
                  // 设置为0 则不允许复活 piaoyun 2013-09-05
                  else if m_PEnvir.m_nRevivalMaxCount = 0 then
                  begin
                    SysMsg(g_sCurMapDisableRevivalMsg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
                  end
                end
                else if (not boUnRevival) { 防复活 } and (m_nCheckRevivalTime * 1000 >= m_nRevivalTime) and
                  (m_boRevival or (Random(100) < m_btFluteStoneRevivalRate)) then
                begin // g_Config.dwRevivalTime {60 * 1000}
                  m_nCheckRevivalTime := 0;
                  if (m_PEnvir <> nil) and ((m_PEnvir.m_nRevivalMaxCount < 0) or (m_nRevivalCount < m_PEnvir.m_nRevivalMaxCount))
                  then
                  begin
                    if m_PEnvir.m_nRevivalMaxCount > 0 then
                      Inc(m_nRevivalCount);
                    ItemDamageRevivalRing;
                    if (m_nRevivalMaxHP <= 0) or (m_nRevivalMaxHP >= 100) then
                      m_WAbil.HP := m_WAbil.MaxHP
                    else
                      m_WAbil.HP := Max(Round(m_WAbil.MaxHP * m_nRevivalMaxHP / 100), 1);
                    // HealthSpellChanged;
                    boNeedRefreshHMP := True; // 优化chongchong 2018-02-13
                    // 触发复活脚本 piaoyun 2013-09-05
                    if (g_FunctionNPC <> nil) and (g_Config.boRevivalTouch) then
                    begin
                      if (m_btRaceServer = RC_PLAYOBJECT) then
                      begin
                        TPlayObject(Self).m_nScriptGotoCount := 0;
                        g_FunctionNPC.GotoLable(TPlayObject(Self), '@Revival', False);
                      end
                      else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT)
                      then
                      begin
                        TPlayObject(m_Master).m_nScriptGotoCount := 0;
                        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@H.Revival', False);
                      end;
                    end;
                    SysMsg(g_sRevivalRecoverMsg { '复活戒指生效，体力恢复' } , c_Green, t_Hint);
                  end
                  // 设置为0 则不允许复活 piaoyun 2013-09-05
                  else if m_PEnvir.m_nRevivalMaxCount = 0 then
                  begin
                    SysMsg(g_sCurMapDisableRevivalMsg, g_Config.btRedMsgFColor, g_Config.btRedMsgBColor, t_Hint);
                  end
                end;
              end;
            end; // {3}
            if m_boNpcReborn and (tick_diff(m_dwNpcRebornStartTick, MyGetTickCount()) > m_nNpcRebornTime) then
            begin
              m_boNpcReborn := False;
            end;
          end; // {2}                                                                           // {1}
        end;
      except
        MainOutMessage(sExceptionMsg9);
      end;
      nCheckCode := 2003;
      if m_WAbil.HP <= 0 then
      begin
        nCheckCode := 2004;
        if (m_WAbil.HP <= 0) and (not m_boGhost) then
        begin
          try
            while GetStruckMessage(@ProcessMsg) do
            begin // 人物死亡获取 RM_STRUCK 信息
              nCheckCode := 1000;
              Operate(@ProcessMsg);
              nCheckCode := 1001;
            end;
          except
            on E: Exception do
            begin
              MainOutMessage(sExceptionMsg8 + ' wIdent:' + IntToStr(ProcessMsg.wIdent));
              MainOutMessage(E.Message);
            end;
          end;
          nCheckCode := 20004;
          Die;
          // 人物死亡重算下属性，因为可能会爆装备，导致套装失效 2020-06-27 19:35:25
          // 人物死亡时要触发套装失效 @GroupItemOff 2020-06-27 19:35:51
          if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
            boNeedRecalc := True;
        end;
      end;
      if not m_boDeath then
      begin
        if (m_WAbil.HP > 0) and ((m_wStatusTimeArr[POISON_DECHEALTH] = 0) or (not g_Config.boPosionStopIncHealth)) then
        begin
          if not IsDummyPlayer then
            boCheck := (m_WAbil.HP < m_WAbil.MaxHP) and (m_nHealthTick >= nResotreHPSpeed) and (not m_boToxicSmoke) and
              (not((m_btRaceServer = 109) or ((m_btRaceServer = 155) and (m_btRaceImg = 156) { 自定义怪物 - 魔王岭宝宝 } )))
          else
          begin
            boCheck := g_Config.boDummyAutoAddHP and (m_WAbil.HP <= m_WAbil.MaxHP / 100 * g_Config.nDummyAddHPPercent) and
              (m_nHealthTick >= nResotreHPSpeed) and (not m_boToxicSmoke);
          end;
          if boCheck then
          begin
            if m_WAbil.MaxHP div nResotreHPBase = High(LongWord) then
              dwC := High(LongWord)
            else
              dwC := (m_WAbil.MaxHP div nResotreHPBase) + 1;
            if dwC > 0 then
            begin
              Int64Value := Int64(m_WAbil.HP) + dwC;
              if Int64Value < m_WAbil.MaxHP then
              begin
                m_WAbil.HP := Int64Value;
              end
              else
              begin
                m_WAbil.HP := m_WAbil.MaxHP;
              end;
              nCheckCode := 1002;
              // HealthSpellChanged;
              boNeedRefreshHMP := True; // 优化chongchong 2018-02-13
              nCheckCode := 1003;
            end;
          end;
          nCheckCode := 2002;
          if not IsDummyPlayer then
            boCheck := (m_WAbil.MP < m_WAbil.MaxMP) and (m_nSpellTick >= nResotreMPSpeed)
          else
          begin
            boCheck := g_Config.boDummyAutoAddMP and (m_WAbil.MP <= m_WAbil.MaxMP / 100 * g_Config.nDummyAddMPPercent) and
              (m_nSpellTick >= nResotreMPSpeed);
          end;
          if boCheck then // modify chongchong 2013-07-16
          begin
            if m_WAbil.MaxMP div nResotreMPBase = High(LongWord) then
              dwC := High(LongWord)
            else
              dwC := (m_WAbil.MaxMP div nResotreMPBase) + 1;
            if dwC > 0 then
            begin
              Int64Value := Int64(m_WAbil.MP) + dwC;
              if Int64Value < m_WAbil.MaxMP then
              begin
                m_WAbil.MP := Int64Value
              end
              else
              begin
                m_WAbil.MP := m_WAbil.MaxMP;
              end;
              nCheckCode := 1004;
              // HealthSpellChanged;
              boNeedRefreshHMP := True; // 优化chongchong 2018-02-13
              nCheckCode := 1005;
            end;
          end;
        end;
      end;
      if m_nHealthTick >= nResotreHPSpeed then
        m_nHealthTick := 0; // modify chongchong 2013-07-16
      if m_nSpellTick >= nResotreMPSpeed then
        m_nSpellTick := 0; // modify chongchong 2013-07-16
      nCheckCode := 1009;
    end
    else // 对象死亡了，看情况处理尸体 piaoyun 2013-08-10
    begin
      // 地图参数死亡时间控制 piaoyun 2013-09-05
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        if m_PEnvir.m_boDieTime and (m_PEnvir.m_dwDieTime > 0) then
        begin
          if ((MyGetTickCount() - m_dwDeathTick) > m_PEnvir.m_dwDieTime * 1000) then
            MakeGhost(); // 掉线
        end
        else
        begin
          // 死亡清理时间 piaoyun 2013-11-17
          if ((MyGetTickCount() - m_dwDeathTick) > 90 * 1000) then
          begin
            MakeGhost();
          end;
        end;
        // 假人尸体清理时间 chongchong 2013-11-12
        if m_boDummyObject then
        begin
          if (MyGetTickCount() - m_dwDeathTick) > g_Config.dwMakeDummyGhostTime then
            MakeGhost();
        end
      end
      { TODO -opiaoyun -c增加 : 增加人物、人形怪、可挖尸体清理时间处理【2013-07-17】 }
      else if ((not m_boSkeleton) and (m_btRaceServer = RC_PLAYMOSTER) { and (m_CloneHum = nil) } ) or
        (m_btRaceServer = RC_PLAYOBJECT) or ((not m_boSkeleton) and (m_boAnimal)) then
      begin
        // 人物 人形怪 可挖尸体 -- piaoyun 2013-07-17
        if (MyGetTickCount() - m_dwDeathTick) > g_Config.dwMakeGhostTime then
          MakeGhost();
      end
      // 英雄尸体清理 piaoyun 2013-08-10
      else if (m_btRaceServer = RC_HEROOBJECT) and (MyGetTickCount() - m_dwDeathTick > g_Config.nClearHeroGhostTick) then
        MakeGhost()
      else
      begin
        // 怪物 -- piaoyun 2013-07-17
        if (MyGetTickCount() - m_dwDeathTick) > g_Config.dwMakeMonGhostTime then
          MakeGhost();
      end;
    end;
  except
    on E: Exception do
    begin
      // if nCheckCode = 2004 then MakeGhost();
      MainOutMessage(sExceptionMsg1 + IntToStr(nCheckCode) + ' ' + IntToStr(m_btRaceServer));
      MainOutMessage(E.Message);
    end;
  end;
  try
    if (not m_boDeath) and ((m_nIncSpell > 0) or (m_nIncHealth > 0) or (m_nIncHealing > 0)) then
    begin
      if m_wCurrMagicId = SKILL_HEALLING then { 2 SKILL_HEALLING 治愈术 }
      begin
        InChsTime := g_Config.nPerHealingTime - Min(400, m_Abil.Level * 10);
      end
      else if m_wCurrMagicId = SKILL_BIGHEALLING then { 29 SKILL_BIGHEALLING 群体治愈术 }
      begin
        InChsTime := g_Config.nBigPerHealingTime - Min(400, m_Abil.Level * 10);
      end
      else
        InChsTime := g_Config.nIncHealthSpellTime - Min(400, m_Abil.Level * 10);
      // -----------------------------------------------------------------------------
      if InChsTime <= 100 then
        InChsTime := 100;
      // 修复瞬间会加完血 By 一支笔 at:2022-03-19 14:32:13
      if (Integer(MyGetTickCount() - m_dwIncHealthSpellTick) >= InChsTime) and (not m_boDeath) then
      begin
        dwC := Min(200, Max(MyGetTickCount() - m_dwIncHealthSpellTick - InChsTime, 0));
        m_dwIncHealthSpellTick := MyGetTickCount() + dwC;
        if (m_nIncSpell > 0) or (m_nIncHealth > 0) or (m_nPerHealing > 0) then
        begin
          if (m_nPerHealth <= 0) then
            m_nPerHealth := 1;
          if (m_nPerSpell <= 0) then
            m_nPerSpell := 1;
          if (m_nPerHealing <= 0) then
            m_nPerHealing := 1;
          if m_nIncHealth < m_nPerHealth then
          begin
            nHP := m_nIncHealth;
            m_nIncHealth := 0;
          end
          else
          begin
            nHP := m_nPerHealth;
            Dec(m_nIncHealth, m_nPerHealth);
          end;
          if m_nIncSpell < m_nPerSpell then
          begin
            nMP := m_nIncSpell;
            m_nIncSpell := 0;
          end
          else
          begin
            nMP := m_nPerSpell;
            Dec(m_nIncSpell, m_nPerSpell);
          end;
          if m_nIncHealing < m_nPerHealing then
          begin
            Inc(nHP, m_nIncHealing);
            m_nIncHealing := 0;
            m_wCurrMagicId := 0;
          end
          else
          begin
            Inc(nHP, m_nPerHealing);
            Dec(m_nIncHealing, m_nPerHealing);
          end;
          if g_Config.nPerHealth <= 0 then
            g_Config.nPerHealth := 10;
          if g_Config.nPerSpell <= 0 then
            g_Config.nPerSpell := 10;
          m_nPerHealth := Max(m_Abil.Level div g_Config.nPerHealth + 5, 1);
          m_nPerSpell := Max(m_Abil.Level div g_Config.nPerSpell + 5, 1);
