  StdItem: pTStdItem;
  SysMsgText: string;
  UseItem: pTUserItem;
  boRecalcAbil: Boolean;
  ItemName: string;
begin
  boRecalcAbil := False;
  for I := Low(THumanUseItems) to High(THumanUseItems) do
  begin
    UseItem := @m_UseItems[I];
    if (UseItem.wIndex > 0) and (UseItem.Dura < UseItem.DuraMax) then
    begin
      StdItem := UserEngine.GetStdItem(UseItem.wIndex);
      if (StdItem <> nil) and (not(StdItem.StdMode in [7, 2, 25, 96 { 祝福罐 } , 97])) and
        (not((StdItem.StdMode = 53) and (StdItem.Anicount in [1, 2, 3]))) then
      begin
        if g_ItemRules.Get(UseItem.wIndex, 3) then
        begin
          SysMsg(Format(g_sDisableRepairItemMsg, [StdItem.Name]), 255, 249, t_Hint);
          Continue;
        end;
        if (GetUserItemBindValue(UseItem, ubNoRepair) and UseItem.boIsBind) then
          Continue;
        // 禁止叠加物品修理 chongchong 2014-09-26
        if CheckOverLapItem(StdItem) then
          Continue;
        if not IsFromNPC then
        begin
          if m_CurrUserItem.Dura < 100 then
            Break;
          NeedDura := Max(0, UseItem.DuraMax - UseItem.Dura);
          if NeedDura = 0 then
            Continue;
          // 修复神水剩余持久点
          if m_CurrUserItem.Dura * 10 >= NeedDura then
          begin
            if UseItem.Dura <= 0 then
              boRecalcAbil := True;
            UseItem.Dura := UseItem.DuraMax;
            Dec(m_CurrUserItem.Dura, NeedDura div 10);
          end
          else
          begin
            if UseItem.Dura <= 0 then
              boRecalcAbil := True;
            UseItem.Dura := UseItem.Dura + m_CurrUserItem.Dura * 10;
            m_CurrUserItem.Dura := 0;
          end;
        end
        else
