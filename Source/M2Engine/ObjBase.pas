function TBaseObject.Operate(ProcessMsg: pTProcessMessage): Boolean;
  function ProcessBaseObjectMessage(ProcessMsg: pTProcessMessage; var boResult: Boolean): Boolean;
  begin
    Result := False;

    if (ProcessMsg.wIdent >= RM_MAGSTRUCK_MINE) and (ProcessMsg.wIdent <= RM_10101_EX_2) then
    begin
      Result := True;
      if Assigned(BaseObjectMessageArray[ProcessMsg.wIdent]) then
        BaseObjectMessageArray[ProcessMsg.wIdent](ProcessMsg, boResult);
    end;
  end;

begin
  Result := False;
  if (ProcessMsg = nil) or (ProcessMsg.wIdent = 0) then
    Exit;

  if not ProcessBaseObjectMessage(ProcessMsg, Result) and (g_PluginManager <> nil) then
  begin
    g_PluginManager.HookBaseObjectProcessMsg(Self, ProcessMsg.wIdent, ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2,
      ProcessMsg.nParam3, TObject(ProcessMsg.BaseObject), ProcessMsg.dwDeliveryTime, PAnsiChar(ProcessMsg.sMsg));
  end;
end;

