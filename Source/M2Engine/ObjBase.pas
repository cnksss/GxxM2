            Int64Value := Round(Level9Power * Rate);
          end;
        end;
      end
      else
        Int64Value := Round((Int64(m_WAbil.AC2) + 2 + (m_Abil.Level div 7) * m_dwDefenceUpAddRate / 100));

      m_WAbil.AC2 := Min(nMaxAC, Int64Value);
