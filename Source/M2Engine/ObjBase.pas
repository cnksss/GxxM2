function CheckUserItem(SmartObject: TSmartObject; nShape, nCount: Integer): Boolean;
var
  nNeedMagicItem: Integer;
begin
  nNeedMagicItem := 0;
  if (SmartObject.m_btRaceServer = RC_PLAYOBJECT) then
  begin
    if SmartObject.m_boDummyObject then // 假人
      nNeedMagicItem := SmartObject.m_nDummyNeedMagicItem
    else
      nNeedMagicItem := g_Config.nHumNeedMagicItem;
  end
  else if (SmartObject.m_btRaceServer = RC_HEROOBJECT) then
  begin // 英雄需要毒 符
    if SmartObject.m_boDummyObject then // 假人
      nNeedMagicItem := SmartObject.m_nDummyNeedMagicItem
    else
      nNeedMagicItem := g_Config.nHeroNeedMagicItem;
  end
  else if (SmartObject.m_btRaceServer = RC_PLAYMOSTER) then
  begin // 人形怪需要毒 符
    if (g_Config.nMonsterNeedMagicItem = 0) or (SmartObject.m_Master <> nil) then
      nNeedMagicItem := 0
    else
      nNeedMagicItem := g_Config.nMonsterNeedMagicItem;
  end;

  if nNeedMagicItem > 0 then
    Result := CheckUserItemType(SmartObject, nShape, nCount) or
      ((nNeedMagicItem = 2) and (GetUserItemList(SmartObject, nShape, nCount) >= 0))
  else
    Result := True;
end;

function CheckUserItemType(SmartObject: TSmartObject; nShape, nCount: Integer): Boolean;
var
  StdItem: pTStdItem;
begin
  Result := False;
  if (SmartObject.m_UseItems[U_ARMRINGL].wIndex > 0) //
    and (Round(SmartObject.m_UseItems[U_ARMRINGL].Dura / g_Config.nMagicItemRate) >= nCount) then
  begin
    StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_ARMRINGL].wIndex);
    if StdItem <> nil then
    begin
      if CheckItemType(nShape, StdItem) then
      begin
        Result := True;
        Exit;
      end;
    end;
  end;

  if (SmartObject.m_UseItems[U_BUJUK].wIndex > 0) //
    and (Round(SmartObject.m_UseItems[U_BUJUK].Dura / g_Config.nMagicItemRate) >= nCount) then
  begin
    StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[U_BUJUK].wIndex);
    if StdItem <> nil then
    begin
      if CheckItemType(nShape, StdItem) then
      begin
        Result := True;
        Exit;
      end;
    end;
  end;
end;

