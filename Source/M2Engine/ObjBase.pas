procedure TBaseObject.SetCustomMagicStatus(MagicLevel: Byte; MagicID: Word; EffectiveTime: Word);
var
  I: Integer;
  MagicStatus: PCustomMagicStatus;
begin
  m_CustomMagicStatusList.LockW(1);
  try
    for I := 0 to m_CustomMagicStatusList.Count - 1 do
    begin
      MagicStatus := m_CustomMagicStatusList.Items[I];
      if MagicStatus.MagicID = MagicID then
      begin
        MagicStatus.MagicLevel := MagicLevel;
        MagicStatus.EffectiveTime := EffectiveTime;
        MagicStatus.StartTick := MyGetTickCount;
        if I <> 0 then
          m_CustomMagicStatusList.Exchange(I, 0);
        Exit;
      end;
    end;
    New(MagicStatus);
    MagicStatus.MagicLevel := MagicLevel;
    MagicStatus.MagicID := MagicID;
    MagicStatus.EffectiveTime := EffectiveTime;
    MagicStatus.StartTick := MyGetTickCount;
    if m_CustomMagicStatusList.Count > 0 then
      m_CustomMagicStatusList.Insert(0, MagicStatus)
    else
      m_CustomMagicStatusList.Add(MagicStatus);
  finally
    m_CustomMagicStatusList.UnLockW;
  end;
end;

function TBaseObject.DropItemDown(UserItem: pTUserItem; nScatterRange: Integer; boDieDrop: Boolean;
  ItemOfCreat, DropCreat: TBaseObject; NpcCmdMonDropItems: Integer; DropMonName: string): Boolean;
var
  dX, dY, idura: Integer;
  ItemObject: TItemObject;
  ItemObject01: TItemObject;
  StdItem: pTStdItem;
  LogAction: LongWord;
  sUserItemName, sProcessUserItemName, sProcessStdItemName: string;
  sChrName: string;
  DropItemAll: Boolean;
  DropDura: Integer;
  IsOverLapItem: Boolean;
  OverlapCountAndEffect: Integer;
  Index: Integer;
  wEffect: Word;
  Player: TPlayObject;
  LogDesc: string;
begin
  // 爆物品范围 piaoyun 2013-09-12
  // nScatterRange := g_Config.nScatterItemRange;
  Result := False;
  StdItem := UserEngine.GetStdItem(UserItem.wIndex);
  if StdItem <> nil then
  begin
    IsOverLapItem := CheckOverLapItem(StdItem);
    if (not IsOverLapItem) and (StdItem.StdMode = 40) then
    begin
      idura := UserItem.Dura;
      idura := idura - 2000;
      if idura < 0 then
        idura := 0;
      UserItem.Dura := idura;
    end;

    m_sScatterItemName := StdItem.Name;
    if (NpcCmdMonDropItems <> 0) //
      or (boDieDrop and (DropCreat <> nil) //
      and (DropCreat.m_btRaceServer <> RC_NPC) //
      and (DropCreat.m_btRaceServer <> RC_PLAYOBJECT) //
      and (DropCreat.m_btRaceServer <> RC_HEROOBJECT)) then
    begin
      if g_ItemRules.Get(UserItem.wIndex, 28) then
      begin
        Player := TPlayObject(g_GrobalPlayer);
        if ItemOfCreat <> nil then
        begin
          if ItemOfCreat.m_btRaceServer = RC_PLAYOBJECT then
            Player := TPlayObject(ItemOfCreat)
          else if (ItemOfCreat.Master <> nil) and (ItemOfCreat.Master.m_btRaceServer = RC_PLAYOBJECT) then
            Player := TPlayObject(ItemOfCreat.Master);
        end;
        Player.m_ItemList.Add(UserItem);
        try
          Player.m_nScriptGotoCount := 0;
          Player.m_sCurrentItemName := ProcessItemName(StdItem.Name);
          if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
            Player.m_sCurrentItemNewName := UserItem.Name
          else
            Player.m_sCurrentItemNewName := ProcessItemName(StdItem.Name);
          Player.m_sCurrentOperateUserName := m_sCharName;
          Player.m_UpgradeItem := UserItem;
          Player.m_UpgradeItemIsPegBag := False;
          Player.m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          Player.m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          // wSaveIndex := UserItem.wIndex;
          // try
          // UserItem.wIndex := 0;
          g_FunctionNPC.GotoLable(Player, '@M2DropItem', False);
          // finally
          // UserItem.wIndex := wSaveIndex;
          // end;
        finally
          Player.m_sCurrentItemName := '';
          Player.m_sCurrentItemNewName := '';
          Player.m_sCurrentOperateUserName := '';
          Player.m_UpgradeItemIsPegBag := False;
          Player.m_ItemList.Remove(UserItem);
        end;
      end;
    end;

    ItemObject := TItemObject.Create;
    { -ochongchong -c新增 : 物品掉在地上的颜色 【2013-07-28】 }
    // ItemObject.m_btColor := StdItem.Color;
    if StdItem.Color = 251 then
      ItemObject.m_btColor := g_Config.btThrowAwayItemColor
    else
      ItemObject.m_btColor := StdItem.Color;

    ItemObject.m_boDieDrop := boDieDrop;
    ItemObject.m_UserItem := UserItem^;
    DropItemAll := True;

    // 增加爆叠加物品时可以只爆部分数量 chongchong 2014-11-22
    if boDieDrop and g_Config.boNotDropOverlapItemAll and IsOverLapItem and (UserItem.Dura > 1) then
    begin
      Randomize;
      DropDura := 1 + Random(UserItem.Dura - 1);
      if DropDura <> UserItem.Dura then
      begin
        DropItemAll := False;
        ItemObject.m_UserItem.Dura := DropDura - 1;
        ItemObject.m_UserItem.MakeIndex := GetItemNumber;
        UserItem.Dura := UserItem.Dura - DropDura;
        if m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(Self).SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura)
        else if m_btRaceServer = RC_HEROOBJECT then
          THeroObject(Self).SendUpdateItemDura(-1, UserItem.MakeIndex, UserItem.Dura);
      end;
    end;

    if UserItem.btColor > 0 then
      ItemObject.m_btColor := UserItem.btColor;

    ItemObject.m_sName := StdItem.Name;
    ItemObject.m_sDBName := StdItem.Name;
    ItemObject.m_PEnvir := m_PEnvir;
    // 取自定义物品名称
    sUserItemName := '';
    if UserItem.btValue[13] = 1 then
      sUserItemName := UserItem.Name;

    if sUserItemName <> '' then
      ItemObject.m_sName := sUserItemName;

    if UserItem.wNewLooks > 0 then
      ItemObject.m_wLooks := UserItem.wNewLooks
    else
      ItemObject.m_wLooks := StdItem.Looks;

    if StdItem.StdMode = 45 then
      ItemObject.m_wLooks := GetRandomLook(ItemObject.m_wLooks, StdItem.Shape);

    ItemObject.m_wAniCount := StdItem.Anicount;
    ItemObject.m_btReserved := 0;
    ItemObject.m_nCount := 1;
    ItemObject.m_OfBaseObject := ItemOfCreat;
    ItemObject.m_dwCanPickUpTick := MyGetTickCount();
    ItemObject.m_DropBaseObject := DropCreat;
    ItemObject.m_boHumDrop := (DropCreat <> nil) and (DropCreat.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]);
    ItemObject.m_boNpcThrowItem := False;
    // 魔王岭弓箭手打的掉在自己身边
    if (DropCreat <> nil) //
      and ((DropCreat.m_btRaceServer = 108) //
      or ((DropCreat.m_btRaceServer = 154) //
      and (DropCreat.m_btRaceImg = 156) { 自定义怪物 - 魔王岭怪物 } )) //
      and (DropCreat.m_LastHiter <> nil) then
      m_PEnvir.GetDropPosition2(DropCreat.m_LastHiter.m_nCurrX, DropCreat.m_LastHiter.m_nCurrY, nScatterRange, dX, dY) // 取掉物的位置
    else
      m_PEnvir.GetDropPosition(m_nCurrX, m_nCurrY, nScatterRange, dX, dY);

    m_nScatterItemX := dX;
    m_nScatterItemY := dY;

    ItemObject01 := TItemObject(m_PEnvir.AddToMap(dX, dY, ItemObject));
    if ItemObject01 = ItemObject then
    begin
      g_ItemManager.AddItem(ItemObject);
      if CompareText(ItemObject.m_sDBName, ItemObject.m_sName) <> 0 then
        sUserItemName := ItemObject.m_sName + '/' + ItemObject.m_sDBName
      else
        sUserItemName := ItemObject.m_sName;

      { -opiaoyun -c兼容 : 兼容老端地面物品显示-排除数据库COLOR字段 【2013-07-04】 }
      // 地面物品特效 chongchong 2017-07-01
      wEffect := UserItem.wEffect;
      if wEffect = 0 then
      begin
        Index := g_DropEffectItemList.IndexOf(ItemObject.m_sDBName);
        if Index >= 0 then
          wEffect := Integer(g_DropEffectItemList.Objects[Index]);
      end;

      if IsOverLapItem then
        OverlapCountAndEffect := MakeLong(ItemObject.m_UserItem.Dura + 1, wEffect)
      else
        OverlapCountAndEffect := MakeLong(0, wEffect);

      sUserItemName := IntToStr(ItemObject.m_btColor) + '/' + IntToStr(OverlapCountAndEffect) + '/' +
        IntToStr(GetDropItemValue(@ItemObject.m_UserItem, StdItem)) + '/' + sUserItemName;

      SendRefMsg(RM_ITEMSHOW, ItemObject.m_wLooks, NativeInt(ItemObject), dX, dY, sUserItemName);
      LogDesc := '';
      if NpcCmdMonDropItems = 1 then
      begin
        LogAction := LOG_ItemNpcMonDrop;
        LogDesc := 'MonDropItems爆出';
      end
      else if NpcCmdMonDropItems = 2 then
      begin
        LogAction := LOG_ItemNpcMonDrop;
        LogDesc := 'MonDropItemsEx爆出';
      end
      else if boDieDrop then
        LogAction := LOG_ItemFall
      else
        LogAction := LOG_ItemDrop;

      if (not IsCheapStuff(StdItem.StdMode)) and (StdItem.NeedIdentify = 1) then
        AddGameDataLog(LogAction, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, '0', 0, 0, LogDesc);

      if boDieDrop or (NpcCmdMonDropItems = 2) then
      begin
        sProcessStdItemName := ProcessItemName(StdItem.Name);
        if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
          sProcessUserItemName := ProcessItemName(UserItem.Name)
        else
          sProcessUserItemName := sProcessStdItemName;

        if (NpcCmdMonDropItems <> 2) and (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
        begin
          if g_ItemRules.Get(UserItem.wIndex, 26) then
          begin
            if TSmartObject(Self).m_boMysteriousMan and g_Config.boShowMysteriousMan then
              sChrName := g_Config.sMysteriousManName
            else
              sChrName := m_sCharName;
            // sUserItemName := Format('物品[%s]从[%s]身上掉落在地图%s(%d,%d)处', [g_sScatterItemName, sChrName, Envir.sMapDesc, m_nCurrX, m_nCurrY]);
            sUserItemName := WideReplaceText(g_sHumDropItemHint, '%Item', sProcessUserItemName);
            sUserItemName := WideReplaceText(sUserItemName, '%DBItem', sProcessStdItemName);
            sUserItemName := WideReplaceText(sUserItemName, '%Name', sChrName);
            sUserItemName := WideReplaceText(sUserItemName, '%Map', m_PEnvir.sMapDesc);
            sUserItemName := WideReplaceText(sUserItemName, '%X', IntToStr(m_nScatterItemX));
            sUserItemName := WideReplaceText(sUserItemName, '%Y', IntToStr(m_nScatterItemY));
            if Pos('%showdbitem', LowerCase(sUserItemName)) > 0 then
            begin
              SetSayItem(UserItem);
              sUserItemName := WideReplaceText(sUserItemName, '%ShowDBItem',
                Format('{[%s]/%d}', [sProcessStdItemName, UserItem.MakeIndex]));
            end;
            if Pos('%showitem', LowerCase(sUserItemName)) > 0 then
            begin
              SetSayItem(UserItem);
              sUserItemName := WideReplaceText(sUserItemName, '%ShowItem',
                Format('{[%s]/%d}', [sProcessUserItemName, UserItem.MakeIndex]));
            end;
            UserEngine.SendBroadCastMsg(sUserItemName, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_System,
              mfDropItem);
          end;
        end
        else if g_ItemRules.Get(UserItem.wIndex, 12) then
        begin
          // 人物或英雄的分身，不要过滤数字，因为名字可能全数字，过滤下没了 chongchong 2015-12-01
          if NpcCmdMonDropItems <> 2 then
          begin
            if (Self is TCopyMon) and (Master <> nil) and (Master.m_btRaceServer = RC_PLAYOBJECT) then
              sChrName := m_sCharName
            else
              sChrName := DelNumber(m_sCharName);
          end
          else
            sChrName := DelNumber(DropMonName);

          // sUserItemName := Format('物品[%s]从[%s]身上掉落在地图%s(%d,%d)处', [m_sScatterItemName, sChrName, Envir.sMapDesc, m_nCurrX, m_nCurrY]);
          sUserItemName := WideReplaceText(g_sDropItemHint, '%Item', sProcessUserItemName);
          sUserItemName := WideReplaceText(sUserItemName, '%DBItem', sProcessStdItemName);
          sUserItemName := WideReplaceText(sUserItemName, '%Name', sChrName);
          sUserItemName := WideReplaceText(sUserItemName, '%Map', m_PEnvir.sMapDesc);
          sUserItemName := WideReplaceText(sUserItemName, '%X', IntToStr(m_nScatterItemX));
          sUserItemName := WideReplaceText(sUserItemName, '%Y', IntToStr(m_nScatterItemY));
          if Pos('%showdbitem', LowerCase(sUserItemName)) > 0 then
          begin
            SetSayItem(UserItem);
            sUserItemName := WideReplaceText(sUserItemName, '%ShowDBItem',
              Format('{[%s]/%d}', [sProcessStdItemName, UserItem.MakeIndex]));
          end;

          if Pos('%showitem', LowerCase(sUserItemName)) > 0 then
          begin
            SetSayItem(UserItem);
            sUserItemName := WideReplaceText(sUserItemName, '%ShowItem',
              Format('{[%s]/%d}', [sProcessUserItemName, UserItem.MakeIndex]));
          end;
          UserEngine.SendBroadCastMsg(sUserItemName, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_System, mfDropItem);
        end;
      end;
      if not boDieDrop then
        OnMapNotifyEvent(Self, meDropItem, StdItem.Name) // 扔物品事件
      else
        OnMapNotifyEvent(Self, meScatterItem, StdItem.Name); // 爆物品事件触发
      Result := DropItemAll;
    end
    else
      ItemObject.MakeGhost;
  end;
end;

function TBaseObject.NpcGiveAndDropItemDown(UserItem: pTUserItem; nScatterRange: Integer; ItemOfCreat, DropCreat: TBaseObject;
  Envir: TEnvirnoment; nX, nY, nCount, nTime: Integer; ItemReserved: Byte; SetRange: Boolean; NpcName, LogDesc: string): Boolean;
var
  dX, dY, idura: Integer;
  ItemObject: TItemObject;
  ItemObject01: TItemObject;
  StdItem: pTStdItem;
  sUserItemName, sProcessUserItemName, sProcessStdItemName: string;
  sChrName: string;
  IsOverLapItem: Boolean;
  OverlapCountAndEffect: Integer;
  wEffect: Word;
  Index: Integer;
begin
  // 爆物品范围 piaoyun 2013-09-12
  if not SetRange then
    nScatterRange := g_Config.nScatterItemRange;

  Result := False;
  StdItem := UserEngine.GetStdItem(UserItem.wIndex);
  if StdItem <> nil then
  begin
    IsOverLapItem := CheckOverLapItem(StdItem);
    if (not IsOverLapItem) and (StdItem.StdMode = 40) then
    begin
      idura := UserItem.Dura;
      idura := idura - 2000;
      if idura < 0 then
        idura := 0;
      UserItem.Dura := idura;
    end;

    m_sScatterItemName := StdItem.Name;
    if (DropCreat.m_btRaceServer <> RC_NPC) //
      and (DropCreat.m_btRaceServer <> RC_PLAYOBJECT) //
      and (DropCreat.m_btRaceServer <> RC_HEROOBJECT) then
    begin
      if g_ItemRules.Get(UserItem.wIndex, 28) then
      begin
        TPlayObject(g_GrobalPlayer).m_ItemList.Add(UserItem);
        try
          TPlayObject(g_GrobalPlayer).m_nScriptGotoCount := 0;
          TPlayObject(g_GrobalPlayer).m_UpgradeItem := UserItem;
          TPlayObject(g_GrobalPlayer).m_UpgradeItemIsPegBag := False;
          TPlayObject(g_GrobalPlayer).m_sPickUpOrDropItemName := ProcessItemName(StdItem.Name);
          TPlayObject(g_GrobalPlayer).m_nPickUpOrDropItemMakeIndex := UserItem.MakeIndex;
          g_FunctionNPC.GotoLable(TPlayObject(g_GrobalPlayer), '@M2DropItem', False);
        finally
          TPlayObject(g_GrobalPlayer).m_UpgradeItem := nil;
          TPlayObject(g_GrobalPlayer).m_UpgradeItemIsPegBag := False;
          TPlayObject(g_GrobalPlayer).m_ItemList.Clear;
        end;
      end;
    end;

    ItemObject := TItemObject.Create;
    ItemObject.m_dwFloorItemCanPickUpTime := nTime;
    ItemObject.m_btColor := StdItem.Color;
    ItemObject.m_UserItem := UserItem^;
    if UserItem.btColor > 0 then
      ItemObject.m_btColor := UserItem.btColor;

    ItemObject.m_sName := StdItem.Name;
    ItemObject.m_sDBName := StdItem.Name;
    ItemObject.m_PEnvir := Envir;
    // 取自定义物品名称
    if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
      ItemObject.m_sName := UserItem.Name;

    if UserItem.wNewLooks > 0 then
      ItemObject.m_wLooks := UserItem.wNewLooks
    else
      ItemObject.m_wLooks := StdItem.Looks;

    if StdItem.StdMode = 45 then
      ItemObject.m_wLooks := GetRandomLook(ItemObject.m_wLooks, StdItem.Shape);

    ItemObject.m_wAniCount := StdItem.Anicount;
    ItemObject.m_btReserved := ItemReserved;
    ItemObject.m_nCount := nCount;
    ItemObject.m_OfBaseObject := ItemOfCreat;
    ItemObject.m_dwCanPickUpTick := MyGetTickCount();
    ItemObject.m_DropBaseObject := DropCreat;
    ItemObject.m_boHumDrop := True; // Npc搞下来的物品“只捡怪物物品”不让捡 2020-04-06 00:03:18
    ItemObject.m_boNpcThrowItem := True;
    if (SetRange and (nScatterRange = 0)) then
    begin
      dX := nX;
      dY := nY;
    end
    else
      Envir.GetDropPosition(nX, nY, Max(nScatterRange, 1), dX, dY);

    ItemObject01 := TItemObject(Envir.AddToMap(dX, dY, ItemObject));
    m_nScatterItemX := dX;
    m_nScatterItemY := dY;
    if ItemObject01 = ItemObject then
    begin
      g_ItemManager.AddItem(ItemObject);
      if CompareText(ItemObject.m_sDBName, ItemObject.m_sName) <> 0 then
        sUserItemName := ItemObject.m_sName + '/' + ItemObject.m_sDBName
      else
        sUserItemName := ItemObject.m_sName;
      // 地面物品特效 chongchong 2017-07-01
      wEffect := UserItem.wEffect;
      if wEffect = 0 then
      begin
        Index := g_DropEffectItemList.IndexOf(ItemObject.m_sDBName);
        if Index >= 0 then
          wEffect := Integer(g_DropEffectItemList.Objects[Index]);
      end;

      { -opiaoyun -c兼容 : 兼容老端地面物品显示-排除数据库COLOR字段 【2013-07-04】 }
      if IsOverLapItem then
        OverlapCountAndEffect := MakeLong(ItemObject.m_UserItem.Dura + 1, wEffect)
      else
        OverlapCountAndEffect := MakeLong(0, wEffect);

      sUserItemName := IntToStr(ItemObject.m_btColor) + '/' + IntToStr(OverlapCountAndEffect) + '/' +
        IntToStr(GetDropItemValue(@ItemObject.m_UserItem, StdItem)) + '/' + sUserItemName;

      SendRefMsg(RM_ITEMSHOW, ItemObject.m_wLooks, NativeInt(ItemObject), dX, dY, sUserItemName);
      if (not IsCheapStuff(StdItem.StdMode)) and (StdItem.NeedIdentify = 1) then
        AddGameDataLog(LOG_ItemFall, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, NpcName, 0, 0, LogDesc); // ???????

      // 修复ThrowItem 刷物品在地上会进行系统掉落提示 chongchong 2013-11-15
      if (DropCreat.m_btRaceServer <> RC_NPC) then
      begin
        sProcessStdItemName := ProcessItemName(StdItem.Name);
        if (UserItem.btValue[13] = 1) and (UserItem.Name <> '') then
          sProcessUserItemName := ProcessItemName(UserItem.Name)
        else
          sProcessUserItemName := sProcessStdItemName;

        if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
        begin
          if g_ItemRules.Get(UserItem.wIndex, 26) then
          begin
            if TSmartObject(Self).m_boMysteriousMan and g_Config.boShowMysteriousMan then
              sChrName := g_Config.sMysteriousManName
            else
              sChrName := m_sCharName;
            // sUserItemName := Format('物品[%s]从[%s]身上掉落在地图%s(%d,%d)处', [m_sScatterItemName, sChrName, Envir.sMapDesc, m_nCurrX, m_nCurrY]);
            sUserItemName := WideReplaceText(g_sHumDropItemHint, '%Item', sProcessUserItemName);
            sUserItemName := WideReplaceText(sUserItemName, '%DBItem', sProcessStdItemName);
            sUserItemName := WideReplaceText(sUserItemName, '%Name', sChrName);
            sUserItemName := WideReplaceText(sUserItemName, '%Map', Envir.sMapDesc);
            sUserItemName := WideReplaceText(sUserItemName, '%X', IntToStr(m_nScatterItemX));
            sUserItemName := WideReplaceText(sUserItemName, '%Y', IntToStr(m_nScatterItemY));
            if Pos('%showdbitem', LowerCase(sUserItemName)) > 0 then
            begin
              SetSayItem(UserItem);
              sUserItemName := WideReplaceText(sUserItemName, '%ShowDBItem',
                Format('{[%s]/%d}', [sProcessStdItemName, UserItem.MakeIndex]));
            end;

            if Pos('%showitem', LowerCase(sUserItemName)) > 0 then
            begin
              SetSayItem(UserItem);
              sUserItemName := WideReplaceText(sUserItemName, '%ShowItem',
                Format('{[%s]/%d}', [sProcessUserItemName, UserItem.MakeIndex]));
            end;
            UserEngine.SendBroadCastMsg(sUserItemName, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_System,
              mfDropItem);
          end;
        end
        else if g_ItemRules.Get(UserItem.wIndex, 12) then
        begin
          // 人物或英雄的分身，不要过滤数字，因为名字可能全数字，过滤下没了 chongchong 2015-12-01
          if (Self is TCopyMon) and (Master <> nil) and (Master.m_btRaceServer = RC_PLAYOBJECT) then
            sChrName := m_sCharName
          else
            sChrName := DelNumber(m_sCharName);

          // sUserItemName := Format('物品[%s]从[%s]身上掉落在地图%s(%d,%d)处', [m_sScatterItemName, sChrName, Envir.sMapDesc, m_nCurrX, m_nCurrY]);
          sUserItemName := WideReplaceText(g_sDropItemHint, '%Item', sProcessUserItemName);
          sUserItemName := WideReplaceText(sUserItemName, '%DBItem', sProcessStdItemName);
          sUserItemName := WideReplaceText(sUserItemName, '%Name', sChrName);
          sUserItemName := WideReplaceText(sUserItemName, '%Map', Envir.sMapDesc);
          sUserItemName := WideReplaceText(sUserItemName, '%X', IntToStr(m_nScatterItemX));
          sUserItemName := WideReplaceText(sUserItemName, '%Y', IntToStr(m_nScatterItemY));
          if Pos('%showdbitem', LowerCase(sUserItemName)) > 0 then
          begin
            SetSayItem(UserItem);
            sUserItemName := WideReplaceText(sUserItemName, '%ShowDBItem',
              Format('{[%s]/%d}', [sProcessStdItemName, UserItem.MakeIndex]));
          end;

          if Pos('%showitem', LowerCase(sUserItemName)) > 0 then
          begin
            SetSayItem(UserItem);
            sUserItemName := WideReplaceText(sUserItemName, '%ShowItem',
              Format('{[%s]/%d}', [sProcessUserItemName, UserItem.MakeIndex]));
          end;
          UserEngine.SendBroadCastMsg(sUserItemName, g_Config.btDropItemFColor, g_Config.btDropItemBColor, t_System, mfDropItem);
        end;
      end;
      // OnMapNotifyEvent(Self, meDropItem, StdItem.Name); // 扔物品事件
      Result := True;
    end
    else
      ItemObject.MakeGhost;
  end;
end;

procedure TBaseObject.RecalcLevelAbilitys(IsSysDef: Boolean);
var
  n, nLevel, nMaxValue, nLevelSub: LongWord;
  Int64Value: Int64;
  BaseAbil, AddAbil: PBaseAbilInfo;
  boUseSysDef: Boolean;
begin
  // 宠物升级后属性会错乱，原因是，RecallGamePetAbil 时，没有调用RecalcLevelAbilitys，而升级后HasLevelUp会调用RecalcLevelAbilitys 2019-05-06 22:58:00
  if m_boGamePet then
    Exit;

  if g_Config.btMaxLevel = 0 then
    nMaxValue := MAXUPLEVEL
  else if g_Config.btMaxLevel = 1 then
    nMaxValue := High(Integer)
  else
    nMaxValue := High(LongWord);

  nLevel := m_Abil.Level;
  boUseSysDef := g_BaseAbilConfig.UseDefault or IsSysDef or
    ((not g_BaseAbilConfig.UseDefault) and (nLevel > High(g_BaseAbilConfig.HumAbil[0].Base) + 1) and
    g_BaseAbilConfig.HumAbil[m_btJob].AutoCalcLevel1000);

  if boUseSysDef then
  begin
    case m_btJob of
      2:
        begin
          Int64Value := Round((Int64(nLevel) / g_Config.nLevelValueOfTaosHP + g_Config.nLevelValueOfTaosHPRate) * nLevel);
          Int64Value := 14 + Max(0, Int64Value);
          m_Abil.MaxHP := Min(nMaxValue, Int64Value);
          Int64Value := Round((Int64(nLevel) / g_Config.nLevelValueOfTaosMP) * 2.2 * nLevel);
          Int64Value := 13 + Max(0, Int64Value);
          m_Abil.MaxMP := Min(nMaxValue, Int64Value);
          if nLevel > 1000 then
          begin
            m_Abil.MaxWeight := High(Word);
            m_Abil.MaxWearWeight := High(Word);
            m_Abil.MaxHandWeight := High(Word);
          end
          else
          begin
            m_Abil.MaxWeight := Min(High(Word), Max(50 + Round((nLevel / 4) * nLevel), 0));
            m_Abil.MaxWearWeight := Min(High(Word), Max(15 + Round((nLevel / 50) * nLevel), 0));
            m_Abil.MaxHandWeight := Min(High(Word), Max(12 + Round((nLevel / 42) * nLevel), 0));
          end;

          n := nLevel div 7;
          m_Abil.DC1 := n - 1;
          m_Abil.DC1 := Max(m_Abil.DC1, 0);
          m_Abil.DC2 := Max(1, n);
          m_Abil.MC1 := 0;
          m_Abil.MC2 := 0;
          m_Abil.SC1 := n - 1;
          m_Abil.SC1 := Max(m_Abil.SC1, 0);
          m_Abil.SC2 := Max(1, n);
          m_Abil.AC1 := 0;
          m_Abil.AC2 := 0;
          n := Round(nLevel / 6);
          m_Abil.MAC1 := n div 2;
          m_Abil.MAC2 := n + 1;
        end;
      1:
        begin
          Int64Value := Round((Int64(nLevel) / g_Config.nLevelValueOfWizardHP + g_Config.nLevelValueOfWizardHPRate) * nLevel);
          Int64Value := 14 + Max(0, Int64Value);
          m_Abil.MaxHP := Min(nMaxValue, Int64Value);
          Int64Value := Round((Int64(nLevel) / 5 + 2) * 2.2 * nLevel);
          Int64Value := 13 + Max(0, Int64Value);
          m_Abil.MaxMP := Min(nMaxValue, Int64Value);
          if nLevel > 1000 then
          begin
            m_Abil.MaxWeight := High(Word);
            m_Abil.MaxWearWeight := High(Word);
            m_Abil.MaxHandWeight := High(Word);
          end
          else
          begin
            m_Abil.MaxWeight := Min(High(Word), Max(50 + Round((nLevel / 5) * nLevel), 0));
            m_Abil.MaxWearWeight := Min(High(Word), Max(15 + Round((nLevel / 100) * nLevel), 0));
            m_Abil.MaxHandWeight := Min(High(Word), Max(12 + Round((nLevel / 90) * nLevel), 0));
          end;

          n := nLevel div 7;
          m_Abil.DC1 := n - 1;
          m_Abil.DC1 := Max(m_Abil.DC1, 0);
          m_Abil.DC2 := Max(1, n);
          m_Abil.MC1 := n - 1;
          m_Abil.MC1 := Max(m_Abil.MC1, 0);
          m_Abil.MC2 := Max(1, n);
          m_Abil.SC1 := 0;
          m_Abil.SC2 := 0;
          m_Abil.AC1 := 0;
          m_Abil.AC2 := 0;
          m_Abil.MAC1 := 0;
          m_Abil.MAC2 := 0;
        end;
      0:
        begin
          Int64Value := Round((Int64(nLevel) / g_Config.nLevelValueOfWarrHP + g_Config.nLevelValueOfWarrHPRate + nLevel / 20)
            * nLevel);
          Int64Value := 14 + Max(0, Int64Value);
          m_Abil.MaxHP := Min(nMaxValue, Int64Value);
          Int64Value := Round(Int64(nLevel) * 3.5);
          Int64Value := 11 + Max(0, Int64Value);
          m_Abil.MaxMP := Min(nMaxValue, Int64Value);
          if nLevel > 1000 then
          begin
            m_Abil.MaxWeight := High(Word);
            m_Abil.MaxWearWeight := High(Word);
            m_Abil.MaxHandWeight := High(Word);
          end
          else
          begin
            m_Abil.MaxWeight := Min(High(Word), Max(50 + Round((nLevel / 3) * nLevel), 0));
            m_Abil.MaxWearWeight := Min(High(Word), Max(15 + Round((nLevel / 20) * nLevel), 0));
            m_Abil.MaxHandWeight := Min(High(Word), Max(12 + Round((nLevel / 13) * nLevel), 0));
          end;

          if nLevel div 5 > 0 then
          begin
            m_Abil.DC1 := nLevel div 5 - 1;
            m_Abil.DC1 := Max(m_Abil.DC1, 0);
          end
          else
            m_Abil.DC1 := 0;

          m_Abil.DC2 := Max(1, (nLevel div 5));
          m_Abil.SC1 := 0;
          m_Abil.SC2 := 0;
          m_Abil.MC1 := 0;
          m_Abil.MC2 := 0;
          m_Abil.AC1 := 0;
          m_Abil.AC2 := nLevel div 7;
          m_Abil.MAC1 := 0;
          m_Abil.MAC2 := 0;
        end;
    end;
  end
  else
  begin
    if nLevel <= 0 then
      nLevel := 1;

    if (nLevel > 0) and (nLevel <= High(g_BaseAbilConfig.HumAbil[0].Base) + 1) then
    begin
      BaseAbil := @g_BaseAbilConfig.HumAbil[m_btJob].Base[nLevel - 1];
      m_Abil.MaxHP := Min(nMaxValue, BaseAbil.MaxHP);
      m_Abil.MaxMP := Min(nMaxValue, BaseAbil.MaxMP);
      m_Abil.MaxWeight := Min(High(Word), BaseAbil.MaxWeight);
      m_Abil.MaxWearWeight := Min(High(Word), BaseAbil.MaxWearWeight);
      m_Abil.MaxHandWeight := Min(High(Word), BaseAbil.MaxHandWeight);
      m_Abil.DC1 := BaseAbil.DC1;
      m_Abil.DC2 := BaseAbil.DC2;
      m_Abil.MC1 := BaseAbil.MC1;
      m_Abil.MC2 := BaseAbil.MC2;
      m_Abil.SC1 := BaseAbil.SC1;
      m_Abil.SC2 := BaseAbil.SC2;
      m_Abil.AC1 := BaseAbil.AC1;
      m_Abil.AC2 := BaseAbil.AC2;
      m_Abil.MAC1 := BaseAbil.MAC1;
      m_Abil.MAC2 := BaseAbil.MAC2;
    end
    else
    begin
      nLevelSub := nLevel - High(g_BaseAbilConfig.HumAbil[m_btJob].Base) - 1;
      BaseAbil := @g_BaseAbilConfig.HumAbil[m_btJob].Base[High(g_BaseAbilConfig.HumAbil[m_btJob].Base)];
      AddAbil := @g_BaseAbilConfig.HumAbil[m_btJob].Add;
      Int64Value := BaseAbil.MaxHP + AddAbil.MaxHP * nLevelSub;
      m_Abil.MaxHP := Min(nMaxValue, Int64Value);
      Int64Value := BaseAbil.MaxMP + AddAbil.MaxMP * nLevelSub;
      m_Abil.MaxMP := Min(nMaxValue, Int64Value);
      Int64Value := BaseAbil.MaxWeight + AddAbil.MaxWeight * nLevelSub;
      m_Abil.MaxWeight := Min(High(Word), Int64Value);
      Int64Value := BaseAbil.MaxWearWeight + AddAbil.MaxWearWeight * nLevelSub;
      m_Abil.MaxWearWeight := Min(High(Word), Int64Value);
      Int64Value := BaseAbil.MaxHandWeight + AddAbil.MaxHandWeight * nLevelSub;
      m_Abil.MaxHandWeight := Min(High(Word), Int64Value);
      Int64Value := BaseAbil.DC1 + AddAbil.DC1 * nLevelSub;
      m_Abil.DC1 := Min(High(Integer), Int64Value);
      Int64Value := BaseAbil.DC2 + AddAbil.DC2 * nLevelSub;
      m_Abil.DC2 := Min(High(Integer), Int64Value);
      Int64Value := BaseAbil.MC1 + AddAbil.MC1 * nLevelSub;
      m_Abil.MC1 := Min(High(Integer), Int64Value);
      Int64Value := BaseAbil.MC2 + AddAbil.MC2 * nLevelSub;
      m_Abil.MC2 := Min(High(Integer), Int64Value);
      Int64Value := BaseAbil.SC1 + AddAbil.SC1 * nLevelSub;
      m_Abil.SC1 := Min(High(Integer), Int64Value);
      Int64Value := BaseAbil.SC2 + AddAbil.SC2 * nLevelSub;
      m_Abil.SC2 := Min(High(Integer), Int64Value);
      Int64Value := BaseAbil.AC1 + AddAbil.AC1 * nLevelSub;
      m_Abil.AC1 := Min(High(Integer), Int64Value);
      Int64Value := BaseAbil.AC2 + AddAbil.AC2 * nLevelSub;
      m_Abil.AC2 := Min(High(Integer), Int64Value);
      Int64Value := BaseAbil.MAC1 + AddAbil.MAC1 * nLevelSub;
      m_Abil.MAC1 := Min(High(Integer), Int64Value);
      Int64Value := BaseAbil.MAC2 + AddAbil.MAC2 * nLevelSub;
      m_Abil.MAC2 := Min(High(Integer), Int64Value);
    end;
  end;

  if m_Abil.MaxHP <= 0 then
    m_Abil.MaxHP := 15;
  if m_Abil.MaxMP <= 0 then
    m_Abil.MaxMP := 15;
  if m_Abil.HP > m_Abil.MaxHP then
    m_Abil.HP := m_Abil.MaxHP;
  if m_Abil.MP > m_Abil.MaxMP then
    m_Abil.MP := m_Abil.MaxMP;
end;

procedure TBaseObject.HasLevelUp(nLevel: Integer; IsTriggerFunc: Boolean; SendHealthSpellChanged: Boolean);
begin
  m_Abil.MaxExp := GetLevelExp(m_Abil.Level);
  RecalcLevelAbilitys(False);
  RecalcAbilitys();
  if m_btRaceServer = RC_PLAYOBJECT then
  begin
    SendRefMsg(RM_LEVELUP, m_btDirection, m_nCurrX, m_nCurrY, 0, '');
    if IsTriggerFunc then
      TPlayObject(Self).LevelUpFunc();
  end
  else if m_boGamePet and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
  begin
    TPlayObject(m_Master).SendDefMessage(SM_PETLEVELUP, NativeInt(Self), TPlayObject(m_Master).m_MyGamePetIndex,
      LoWord(m_Abil.Level), HiWord(m_Abil.Level), '');

    TPlayObject(m_Master).SendUpdatePetAbility(Self);
    if (g_Config.nPetAbilToMasterRate > 0) //
      and (g_Config.boPetHPToMaster //
      or g_Config.boPetDCToMaster //
      or g_Config.boPetMCToMaster //
      or g_Config.boPetSCToMaster //
      or g_Config.boPetACToMaster //
      or g_Config.boPetMACToMaster) then
    begin
      TPlayObject(m_Master).RecalcAbilitys;
      m_Master.SendMsg(m_Master, RM_ABILITY, 0, 0, 0, 0, '');
    end;

    if IsTriggerFunc and (g_FunctionNPC <> nil) then
    begin
      TPlayObject(m_Master).m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@GamePetLevelUp', False);
    end;
  end;

  if SendHealthSpellChanged then
    SendRefMsg(RM_HEALTHSPELLCHANGED, 0, 0, 0, 0, ''); // 刷新HP
end;

procedure AddUserLog(sMsg: string); // 004E42F8
begin
  MainOutMessage(sMsg);
end;

function TBaseObject.WalkTo(btDir: Byte; boFlag: Boolean): Boolean; // 004C3F64
var
  nOX, nOY, nNX, nNY: Integer;
  // Envir:TEnvirnoment;
  bo29: Boolean;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.WalkTo';
begin
  Result := False;
  if m_boDingShen or m_boHolySeize then
    Exit;

  try
    nOX := m_nCurrX;
    nOY := m_nCurrY;
    m_btDirection := btDir;
    nNX := 0;
    nNY := 0;
    case btDir of
      DR_UP:
        begin
          nNX := m_nCurrX;
          nNY := m_nCurrY - 1;
        end;
      DR_UPRIGHT:
        begin
          nNX := m_nCurrX + 1;
          nNY := m_nCurrY - 1;
        end;
      DR_RIGHT:
        begin
          nNX := m_nCurrX + 1;
          nNY := m_nCurrY;
        end;
      DR_DOWNRIGHT:
        begin
          nNX := m_nCurrX + 1;
          nNY := m_nCurrY + 1;
        end;
      DR_DOWN:
        begin
          nNX := m_nCurrX;
          nNY := m_nCurrY + 1;
        end;
      DR_DOWNLEFT:
        begin
          nNX := m_nCurrX - 1;
          nNY := m_nCurrY + 1;
        end;
      DR_LEFT:
        begin
          nNX := m_nCurrX - 1;
          nNY := m_nCurrY;
        end;
      DR_UPLEFT:
        begin
          nNX := m_nCurrX - 1;
          nNY := m_nCurrY - 1;
        end;
    end;

    if (nNX >= 0) and ((m_PEnvir.m_nWidth - 1) >= nNX) and (nNY >= 0) and ((m_PEnvir.m_nHeight - 1) >= nNY) then
    begin
      if m_boImprison and ((nNX < m_nImprisonPos.X - m_nImprisonRange) or (nNX > m_nImprisonPos.X + m_nImprisonRange) or
        (nNY < m_nImprisonPos.Y - m_nImprisonRange) or (nNY > m_nImprisonPos.Y + m_nImprisonRange)) then
        Exit;

      bo29 := True;
      if bo2BA and not m_PEnvir.CanSafeWalk(nNX, nNY) then
        bo29 := False; // 怪物 检测地面是否有火墙
      // 不能走到主人面前，不知道为什么要加这个，先注释，不然英雄和主人面对面，相隔2格时，不能往主人面前走 ?????? chongchong 2017-11-02
      {
        if m_Master <> nil then
        begin
        m_Master.m_PEnvir.GetNextPosition(m_Master.m_nCurrX, m_Master.m_nCurrY, m_Master.m_btDirection, 1, n20, n24);
        if (nNX = n20) and (nNY = n24) then bo29 := False;
        end;
      }
      if bo29 then
      begin
        if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nNX, nNY, boFlag) then
        begin
          m_nCurrX := nNX;
          m_nCurrY := nNY;
        end;
      end;
    end;

    if (m_nCurrX <> nOX) or (m_nCurrY <> nOY) then
    begin
      if Walk(RM_WALK) then
      begin
        if m_boTransparent and m_boHideMode then
        begin
          bo29 := True;
          if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
            bo29 := TSmartObject(Self).m_nHideModeEx = 0;
          // 隐身术动一下就取消隐身 2020-03-23 17:17:16
          if (m_wStatusTimeArr[STATE_TRANSPARENT { 0 0x70 } ] > 0) and bo29 then
          begin
            m_wStatusTimeArr[STATE_TRANSPARENT { 0 0x70 } ] := 0;
            m_boHideMode := False;
            m_nCharStatus := GetCharStatus();
            StatusChanged();
          end;
          (*
            m_wStatusTimeArr[STATE_TRANSPARENT {0x70}] := 1;
            m_dwDecStatusArrTick[STATE_TRANSPARENT] := 0;     // 2020-03-23 17:00:02
          *)
        end;
        Result := True;
        m_dwStationTick := MyGetTickCount; // 增加检测人物站立不动时间
      end
      else
      begin
        if not m_PEnvir.DeleteFromMap(m_nCurrX, m_nCurrY, Self) then
        begin
          // OutputDebugString('aaa');
        end;
        m_nCurrX := nOX;
        m_nCurrY := nOY;
        m_PEnvir.AddToMap(m_nCurrX, m_nCurrY, Self);
      end;
    end;
  except
    MainOutMessage(sExceptionMsg);
  end;
end;

