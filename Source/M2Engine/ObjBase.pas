        // Inc(m_WAbil.MaxHP,m_nMoXieSuite);
        Int64Value := Int64(m_WAbil.MaxHP) + SmartObject.m_nMoXieSuite;
        m_WAbil.MaxHP := Min(nMaxValue, Int64Value);
