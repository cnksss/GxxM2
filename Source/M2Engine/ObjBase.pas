        if (SmartObject.m_dwAddHumNewValue[I] > 0) and (SmartObject.m_dwAddHumNewValueTime[I] <> 0) then
        begin
          // 攻击伤害、体力增加、魔法增加、致命一击伤害增加 chongchong 2015-06-30
          if I in [1, 7, 8, 10, 22] then
          begin
            Int64Value := Int64(m_WAbil.NewValue[I]) + SmartObject.m_dwAddHumNewValue[I];
            m_WAbil.NewValue[I] := Min(Int64Value, High(LongWord))
          end
          else
          begin
