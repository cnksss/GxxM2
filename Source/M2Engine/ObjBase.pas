      TempList := TList.Create;
      try
        GroupItemList := SmartObject.m_GroupItem;
        OldGroupItemList := SmartObject.m_OldGroupItem;
        FillChar(GroupFldRate, SizeOf(GroupFldRate), 0);
        FillChar(GroupFldValue, SizeOf(GroupFldValue), 0);
        GroupItemList.Clear;
        if g_GroupItems.Get(SmartObject.m_UseItems, SmartObject.m_JewelryBoxItems, SmartObject.m_GodBlessItems,
