procedure TAnimalObject.SearchTarget;
var
  BaseObject, BaseObject18: TBaseObject;
  I, nC, n10: Integer;
  VisibleBaseObject: pTVisibleBaseObject;
  CanAttack: Boolean;
begin
  BaseObject18 := nil;
  n10 := 999;
  if m_boGamePet and (m_boEnabledPetAttack <> 1) and ((not g_Config.boEnabledPetAttack) or (m_boEnabledPetAttack = 2)) then
  begin
    if m_TargetCret <> nil then
      DelTargetCreat;
    Exit;
  end;
  {
    if m_nAttackState <> 0 then
    begin
    if m_TargetCret <> nil then
    DelTargetCreat;
    Exit;
    end;
  }
  m_VisibleActors.Lock;
  try
    for I := 0 to m_VisibleActors.Count - 1 do
    begin
      VisibleBaseObject := m_VisibleActors[I].Item;
      if VisibleBaseObject <> nil then
      begin
        BaseObject := TBaseObject(VisibleBaseObject.BaseObject);
        if (BaseObject <> nil) and (BaseObject <> Self) then
        begin
          if not BaseObject.m_boDeath then
          begin
            if (BaseObject.m_btRaceServer <> RC_GUARD) and // 不主动攻击大刀
            // (BaseObject.m_btRaceServer <> RC_ARCHERGUARD) and    // 不主动攻击弓箭手
              (BaseObject.m_btRaceServer <> 55) and // 不主动攻击练功师
              (BaseObject.m_btRaceServer <> RC_MOVE_ARCHERGUARD) and // 不主动攻击巡 逻弓箭手
              (not(BaseObject.m_btRaceServer in [RC_NPC .. RC_ANIMAL])) then
            begin // 不主动攻击NPC
              // 不主动攻击非攻击型怪物
              if BaseObject.m_boAnimal then
              begin
                CanAttack := False;
                // 没打我的话，不鸟他
                if (BaseObject.m_TargetCret = Self) then
                  CanAttack := True
                  // 没打主人，或主人没有打他也不鸟
                else if (m_Master <> nil) and ((BaseObject.m_TargetCret = m_Master) or (m_Master.m_TargetCret = BaseObject)) then
                  CanAttack := True
                  // 没有攻击自己的主人主人的宝宝也不鸟
                else if (Master <> nil) and (BaseObject.m_TargetCret = Master) then
                  CanAttack := True
                  // 怪物攻击人物的宝宝 chongchong 2016-03-11
                else if (Master = nil) and (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
                  CanAttack := True;
                if not CanAttack then
                  Continue;
              end;
              if m_boDummyObject and CheckIsDummyNoActiveAttackMonster(BaseObject.m_sCharName) then
              begin
                CanAttack := False;
                // 没打我的话，不鸟他
                if (BaseObject.m_TargetCret = Self) then
                  CanAttack := True
                  // 没打主人，或主人没有打他也不鸟
                else if (m_Master <> nil) and ((BaseObject.m_TargetCret = m_Master) or (m_Master.m_TargetCret = BaseObject)) then
                  CanAttack := True
                  // 没有攻击自己的主人主人的宝宝也不鸟
                else if (Master <> nil) and (BaseObject.m_TargetCret = Master) then
                  CanAttack := True
                  // 怪物攻击人物的宝宝 chongchong 2016-03-11
                else if (Master = nil) and (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
                  CanAttack := True;
                if not CanAttack then
                  Continue;
              end;
              // 主人不攻击，别人只攻击宝宝时，宝宝不动 chongchong 2017-06-30
              if (m_Master = nil) or (
                // 下面有逻辑有为主人
                ((m_Master.m_TargetCret = BaseObject) or (m_Master.m_LastHiter = BaseObject) or
                (m_Master.m_CurrTarget = BaseObject)) or ((BaseObject.m_Master = nil) and
                (not(BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT])))) then
              begin
                if IsProperTarget(BaseObject) and ((not BaseObject.m_boHideMode or m_boCoolEye) or
                  // 对方人物隐身后，假人也可以攻击 chongchong 2014-09-01
                  ((m_btRaceServer = RC_PLAYOBJECT) and m_boDummyObject)) then
                begin
                  // 怪物不攻击脱机人物 chongchong 2015-09-07
                  if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and (TPlayObject(BaseObject).m_boOffLine) and g_Config.boMonNoAttackOffLinePlayer
                  then
                  begin
                    Continue;
                  end;
                  nC := Abs(m_nCurrX - BaseObject.m_nCurrX) + Abs(m_nCurrY - BaseObject.m_nCurrY);
                  if nC < n10 then
                  begin
                    n10 := nC;
                    BaseObject18 := BaseObject;
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
    end;
  finally
    m_VisibleActors.UnLock;
  end;
  if (m_DoTauntTarget <> nil) then
  begin
    if ((m_DoTauntTarget.m_boGhost) or (m_DoTauntTarget.m_boDeath)) then
      m_DoTauntTarget := nil
    else if (m_DoTauntTarget.m_PEnvir <> m_PEnvir) then
      m_DoTauntTarget := nil
    else if (Abs(m_DoTauntTarget.m_nCurrX - m_nCurrX) > 20) or (Abs(m_DoTauntTarget.m_nCurrY - m_nCurrY) > 20) then
      m_DoTauntTarget := nil
  end;
  if BaseObject18 <> nil then
  begin
    // SetTargetCreat(BaseObject18);
    // 人物回安全区了，宝宝如果目标是人物就不要攻击 chongchong 2017-06-26
    if (Master <> nil) and (Master.m_btRaceServer = RC_PLAYOBJECT) and (BaseObject18.m_btRaceServer = RC_PLAYOBJECT) and
      (Master.InSafeArea) then
    begin
      DelTargetCreat;
    end
    // 人形怪攻击主人的时候，不要扯蛋去攻击宝宝 chongchong 2016-01-23
    else
      // 修人形怪不打英雄 2019-09-08 00:23:52
      // if not ((m_btRaceServer = RC_PLAYMOSTER) and (m_TargetCret <> nil) and (m_TargetCret.m_btRaceServer = RC_PLAYOBJECT) and (BaseObject18.m_Master = m_TargetCret) and (m_TargetCret.m_TargetCret = Self)) then
      SetTargetCreat(BaseObject18);
  end
  // 修复宝宝不攻击练功师 chongchong 2014-10-25
  else if (m_Master <> nil) and (m_Master.m_TargetCret <> nil) and (m_Master.m_TargetCret.m_btRaceServer = 55) then
  begin
    SetTargetCreat(m_Master.m_TargetCret);
  end
  else if (BaseObject18 = nil) and (m_DoTauntTarget <> nil) then
  begin
    m_TargetCret := m_DoTauntTarget;
  end;
end;

procedure TAnimalObject.sub_4C959C;
var
  I, nC, n10: Integer;
  Creat, BaseObject: TBaseObject;
  VisibleBaseObject: pTVisibleBaseObject;
begin
  Creat := nil;
  n10 := 999;
  m_VisibleActors.Lock;
  try
    for I := 0 to m_VisibleActors.Count - 1 do
    begin
      VisibleBaseObject := m_VisibleActors[I].Item;
      if VisibleBaseObject <> nil then
      begin
        BaseObject := TBaseObject(VisibleBaseObject.BaseObject);
        if (BaseObject <> nil) and (BaseObject <> Self) then
        begin
          if BaseObject.m_boDeath then
            Continue;
          if IsProperTarget(BaseObject) then
          begin
            nC := Abs(m_nCurrX - BaseObject.m_nCurrX) + Abs(m_nCurrY - BaseObject.m_nCurrY);
            if nC < n10 then
            begin
              n10 := nC;
              Creat := BaseObject;
            end;
          end;
        end;
      end;
    end;
  finally
    m_VisibleActors.UnLock;
  end;
  if Creat <> nil then
    SetTargetCreat(Creat);
end;

