            Inc(n02);
        end;
      end;
      BaseObjectList.Free;

      if (n01 > 1) and (n02 = 0) then
      begin
        if CheckUserItem(Self, 1, 2) then
        begin
          m_nSelItemType := 1;
          Result := True;
        end;
      end
      else if (n01 = 0) and (n02 > 1) then
      begin
        if CheckUserItem(Self, 2, 2) then
        begin
          m_nSelItemType := 2;
          Result := True;
        end;
      end
      else if (n01 > 1) and (n02 > 1) then
      begin
        if n01 > n02 then
        begin
          if CheckUserItem(Self, 1, 5) then
          begin
            m_nSelItemType := 1;
            Result := True;
          end
          else if CheckUserItem(Self, 2, 5) then
          begin
            m_nSelItemType := 2;
            Result := True;
          end;
        end
        else
