            nSecPwr := BaseObject.GetHitStruckDamage(Self, nSecPwr, nil, 2)
          else
            nSecPwr := nSecPwr;
          nSecPwr := GetMagicPercentPower(60, nSecPwr, BaseObject);
          SetTargetCreat(BaseObject);
          if nSecPwr > 0 then
          begin
            Result := DirectAttack(BaseObject, nSecPwr, 60, IsSetPKPower);
            if IsSetPKPower then
              IsSetPKPower := False;
          end;
          // 攻击后破盾  2019-07-24
          {
            if (BaseObject <> AttackTarget) then
            begin
            CloseTargetSuperShiled(12, nLevel, BaseObject);
            end;
          }
        end;
      end;
    end;
  end;
  function Skill61Attack(nSecPwr, nLevel: Integer): Boolean;
  var
    nSavePower: Integer;
    nX, nY: Integer;
    BaseObject: TBaseObject;
    SmartObject: TSmartObject;
    nSuckDamagePoint: Integer;
    IsHuman: Boolean;
    _Master: TBaseObject;
  begin
    Result := False;
    nSavePower := Min(LongWord(nSecPwr + Round(nSecPwr * (nLevel * g_Config.nSkillJointAttackLevelRate / 100))), High(Integer));
    nSavePower := nSavePower + Round(nSavePower / 100 * m_WAbil.NewValue[10]);
    if AttackTarget <> nil then
    begin
      // 劈星斩改为群体攻击 chongchong 2013-10-09
      for nX := AttackTarget.m_nCurrX - 3 to AttackTarget.m_nCurrX + 3 do
      begin
        for nY := AttackTarget.m_nCurrY - 3 to AttackTarget.m_nCurrY + 3 do
        begin
          if Abs(nX - AttackTarget.m_nCurrX) = Abs(nY - AttackTarget.m_nCurrY) then
          begin
            BaseObject := TBaseObject(m_PEnvir.GetMovingObject(nX, nY, True));
            if (BaseObject <> nil) and IsProperTarget(BaseObject) then
            begin
              nSecPwr := nSavePower;
              (*
                if (not g_Config.boSkill61NotMagBubbleDefence {忽视魔法盾}) { and (not CanCloseDefense) } then
                nSecPwr := BaseObject.GetHitStruckDamage(Self, nSecPwr, nil, 2)
                else
                nSecPwr := nSecPwr;
              *)
              IsHuman := BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER];
              if not IsHuman then
              begin
                _Master := BaseObject.Master;
                if (_Master <> nil) then
                begin
                  IsHuman := _Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER];
                end;
              end;
              if IsHuman then
              begin
                nSecPwr := Min(LongWord(Round(nSecPwr * (g_Config.nSkill61AttackHumPowerRate / 100))), High(Integer));
              end
              else
              begin
                nSecPwr := Min(LongWord(Round(nSecPwr * (g_Config.nSkill61PowerRate / 100))), High(Integer));
              end;
              nSecPwr := BaseObject.GetNextDamage(nSecPwr);
              // 伤害吸收 chongchong 2016-03-18
              if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
              begin
                SmartObject := TSmartObject(BaseObject);
                // 攻击者不是怪物，伤害吸收百分比 2020-09-17 20:11:44
                // nSecPwr := SmartObject.m_StruckDamageAbsorbMgr.GetStruckDamage(m_sCharName, nSecPwr);
                if SmartObject.m_boTrainingNG and (SmartObject.m_AbilNG.NH >= g_Config.nNGHitStruckDecNG) then
                begin
                  nSecPwr := Max(0, nSecPwr - SmartObject.GetNGDecPower);
                  SmartObject.m_AbilNG.NH := Max(0, SmartObject.m_AbilNG.NH - g_Config.nNGHitStruckDecNG);
                  SmartObject.RefAbilNH;
                end;
                if (SmartObject.m_nSuckDamagePoint > 0) and (nSecPwr > 0) and (SmartObject.m_nSuckDamageRate > 0) then
                begin // 吸收伤害
                  if Random(100) < SmartObject.m_nSuckDamageProbability then
                  begin
                    nSuckDamagePoint := Round(SmartObject.m_nSuckDamageRate / 1000 * nSecPwr);
                    if nSuckDamagePoint > SmartObject.m_nSuckDamagePoint then
                      nSuckDamagePoint := SmartObject.m_nSuckDamagePoint;
                    Dec(SmartObject.m_nSuckDamagePoint, nSuckDamagePoint);
                    nSecPwr := Max(nSecPwr - nSuckDamagePoint, 0);
                  end;
                end;
              end;
              if (BaseObject.m_btRaceServer in [55]) then
              begin
                BaseObject.SendDelayMsg(BaseObject, RM_STRUCK, nSecPwr, BaseObject.m_WAbil.HP, BaseObject.m_WAbil.MaxHP,
                  NativeInt(BaseObject), '0', 600);
              end
              else
                SendDelayMsg(Self, RM_DELAYMAGIC, nSecPwr, MakeLong(BaseObject.m_nCurrX, BaseObject.m_nCurrY), MakeLong(2, 0),
                  NativeInt(BaseObject), IntToStr(61), 600);
              if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and TSmartObject(BaseObject)
                .m_boSuperShiled and g_Config.UseSkillCloseSuperShileds[4] then // 护体神盾被击破
                TSmartObject(BaseObject).CloseSuperShiled;
            end;
          end;
        end;
      end;
    end;
  end;
