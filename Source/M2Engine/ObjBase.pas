// 创建分身
function TBaseObject.MakeCopySelf(sMonName: string; nX, nY: Integer; nMaxCount: Integer; dwRoyaltySec: LongWord;
  nInheritedPercent: Integer): TBaseObject;
var
  MonObj: TCopyMon;
begin
  Result := nil;
  if (nMaxCount <> 0) and (GetCopyHumanCount >= nMaxCount) then
    Exit;

  if not m_PEnvir.CanWalk(nX, nY, True) then
    Exit;

  MonObj := TCopyMon.Create;
  MonObj.m_dwMasterRoyaltyStartTick := MyGetTickCount;
  MonObj.m_dwMasterRoyaltyTime := dwRoyaltySec * 1000;
  MonObj.Copy(Self);
  MonObj.m_nInheritedPercent := nInheritedPercent;
  MonObj.m_boInfiniteMagic := g_Config.boCopySelfNonUseSpellPoint;
  MonObj.m_nCurrX := nX;
  MonObj.m_nCurrY := nY;
  MonObj.m_sCharName := sMonName;
  MonObj.m_sOldCharName := sMonName;
  MonObj.Initialize();
  if MonObj.m_boAddtoMapFail then
  begin
    MonObj.Free;
    MainOutMessage('分身加入到地图失败');
  end
  else
  begin
    MonObj.RefNameColor;
    MonObj.m_BBType := bb_Other;
    m_SlaveList.Add(MonObj);
    UserEngine.AddToMonsterList(MonObj);
    Result := MonObj;
    MonObj.RecalcLevelAbilitys(False);
    MonObj.RecalcAbilitys;
    MonObj.RefGameSpeed;
    // 修改为分身和召唤者血一样多 chongchong 2015-11-10
    MonObj.m_WAbil.HP := Round(Self.m_WAbil.MaxHP / 100 * nInheritedPercent);
    MonObj.m_WAbil.MP := Round(Self.m_WAbil.MaxMP / 100 * nInheritedPercent);

    if Self is TSmartObject then
    begin
      MonObj.m_nAttackSpeed := TSmartObject(Self).m_nAttackSpeed;
      MonObj.m_nSpellSpeed := TSmartObject(Self).m_nSpellSpeed;; // 魔法速度  -10 ~ +10
      MonObj.m_nInitWalkSpeed := MonObj.m_nWalkSpeed;
      MonObj.m_nInitNextHitTime := MonObj.m_nNextHitTime;
    end;
  end;
end;

// 按类型取宝宝数量 piaoyun 2013-11-19
function TBaseObject.GetSlaveCount(BBType: TBBType): Integer;
var
  I: Integer;
  MonObj: TBaseObject;
begin
  Result := 0;
  for I := 0 to m_SlaveList.Count - 1 do
  begin
    MonObj := m_SlaveList.Items[I];
    if (not MonObj.m_boGhost) and (not MonObj.m_boDeath) and (MonObj.m_BBType = BBType) then
      Inc(Result);
  end;
end;

function TBaseObject.PlayerCanMakeSlave(BBType: TBBType; nMaxCount: Integer; IsCheckMaxCount: Boolean): Boolean;
var
  BoneFammCount, DogzCount, BigDogzCount, MonthSpiritCount: Integer;
  I, AllMonCount: Integer;
  MonObj: TBaseObject;
begin
  Result := False;
  if IsCheckMaxCount and (GetSlaveCount(BBType) >= nMaxCount) then
    Exit;

  BoneFammCount := 0;
  DogzCount := 0;
  BigDogzCount := 0;
  MonthSpiritCount := 0;

  for I := 0 to m_SlaveList.Count - 1 do
  begin
    MonObj := m_SlaveList.Items[I];
    if (not MonObj.m_boGhost) and (not MonObj.m_boDeath) then
    begin
      // Inc(AllMonCount);
      case MonObj.m_BBType of
        bb_BoneFamm:
          Inc(BoneFammCount);
        bb_Dogz:
          Inc(DogzCount);
        bb_BigDogz:
          Inc(BigDogzCount);
        bb_MonthSpirit:
          Inc(MonthSpiritCount);
      end;
    end;
  end;

  AllMonCount := BoneFammCount + DogzCount + BigDogzCount + MonthSpiritCount;
  if (BBType <> bb_Other) and (g_Config.dwRecallMonCount > 0) and (AllMonCount >= g_Config.dwRecallMonCount) then
    Exit;

  if (BoneFammCount = 0) and (DogzCount = 0) and (BigDogzCount = 0) and (MonthSpiritCount = 0) then
  begin
    Result := True;
    Exit;
  end;

  if BBType = bb_BoneFamm then
  begin
    if (not g_Config.boRecallManySlave1) and (DogzCount > 0) then // 不允许同时召唤骷髅和神兽
      Exit;
  end

  else if BBType = bb_Dogz then
  begin
    if (not g_Config.boRecallManySlave1) and (BoneFammCount > 0) then // 不允许同时召唤骷髅和神兽
      Exit
    else if (not g_Config.boRecallManySlave3) and (BigDogzCount > 0) then // 不允许同时召唤神兽和圣兽
      Exit;
  end
  else if BBType = bb_BigDogz then
  begin
    if (not g_Config.boRecallManySlave2) and (MonthSpiritCount > 0) then // 不允许同时召唤圣兽和月灵
      Exit
    else if (not g_Config.boRecallManySlave3) and (DogzCount > 0) then // 不允许同时召唤神兽和圣兽
      Exit;
  end;
  Result := True;
end;

// 创建宝宝
// TBBType = (bb_BoneFamm, bb_Dogz, bb_BigDogz, bb_MonthSpirit);
function TBaseObject.MakeSlave(sMonName: string; nMakeLevel, nExpLevel, nMaxCount: Integer; dwRoyaltySec: LongWord;
  BBType: TBBType; MagicNewLevel: Integer; boBBAttrPlusAdd: Boolean; PosX: Integer; PosY: Integer): TBaseObject; // 004C37C0
var
  CurRecallBBCount: Integer; // 当前类型宝宝已有数量
  I, nX, nY: Integer;
  MonObj: TBaseObject;
  NewValue: LongWord;
begin
  Result := nil;
  CurRecallBBCount := GetSlaveCount(BBType);
  if CurRecallBBCount >= nMaxCount then
  begin
    if ((BBType = bb_BoneFamm) and g_Config.boDogzGotoMaster) or ((BBType = bb_Dogz) and g_Config.boDogzGotoMaster) or
      ((BBType = bb_BigDogz) and g_Config.boBigDogzGotoMaster) or ((BBType = bb_MonthSpirit) and g_Config.boMonthSpiritGotoMaster)
    then
    begin // 召唤月灵  回到主人身边
      for I := 0 to m_SlaveList.Count - 1 do
      begin
        MonObj := m_SlaveList.Items[I];
        if (not MonObj.m_boDeath) and (not MonObj.m_boGhost) and (MonObj.m_BBType = BBType) then
        begin
          GetFrontPosition(nX, nY);
          MonObj.DelTargetCreat;
          MonObj.SpaceMove(m_PEnvir.sMapName, nX, nY, 1);
        end;
      end;
    end;
    Exit;
  end;

  if m_btRaceServer <> RC_HEROOBJECT then
  begin
    if not PlayerCanMakeSlave(BBType, nMaxCount, False) then
      Exit;
  end;

  if (PosX <> -1) and (PosY <> -1) then
  begin
    nX := PosX;
    nY := PosY;
  end
  else
    GetFrontPosition(nX, nY);

  MonObj := UserEngine.RegenMonsterByName(m_PEnvir.sMapName, nX, nY, sMonName);
  if MonObj <> nil then
  begin
    MonObj.m_Master := Self; // 设置宝宝主人 -- piaoyun 2013-6-23
    MonObj.m_dwMasterRoyaltyStartTick := MyGetTickCount;
    if dwRoyaltySec >= 4200000 then
      dwRoyaltySec := 4200000;
    MonObj.m_dwMasterRoyaltyTime := dwRoyaltySec * 1000;
    MonObj.m_btSlaveMakeLevel := nMakeLevel;
    MonObj.m_btSlaveExpLevel := nExpLevel;
    if (m_btRaceServer = RC_PLAYOBJECT) or ((Master <> nil) and (Master.m_btRaceServer = RC_PLAYOBJECT)) then
      MonObj.m_PEnvir.AddHumBBCount;
    // 宝宝属性叠加
    if boBBAttrPlusAdd then
    begin
      MonObj.m_boAddMasterAttrToSelf := True;
      MonObj.m_boMakeSelfMagicNewLevel := MagicNewLevel;
      FillChar(MonObj.m_nBBAttrPlusValues, SizeOf(MonObj.m_nBBAttrPlusValues), 0);
      // 宝宝属性叠加 2019-07-06 18:27:27
      if g_Config.boBBAttrPlusAddAttack and (g_Config.nBBAttrPlusAddAttackRate > 0) then
      begin
        // --------- +攻击下限
        if g_Config.nBBAttrPlusAddAttackForm = 0 then
        begin
          if m_btJob = 0 then
            NewValue := m_WAbil.DC1
          else if m_btJob = 1 then
            NewValue := m_WAbil.MC1
          else
            NewValue := m_WAbil.SC1
        end
        else if g_Config.nBBAttrPlusAddAttackForm = 1 then
          NewValue := m_WAbil.DC1
        else if g_Config.nBBAttrPlusAddAttackForm = 2 then
          NewValue := m_WAbil.MC1
        else
          NewValue := m_WAbil.SC1;
        MonObj.m_nBBAttrPlusValues[0][0] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddAttackRate);
        // --------- +攻击上限
        if g_Config.nBBAttrPlusAddAttackForm = 0 then
        begin
          if m_btJob = 0 then
            NewValue := m_WAbil.DC2
          else if m_btJob = 1 then
            NewValue := m_WAbil.MC2
          else
            NewValue := m_WAbil.SC2
        end
        else if g_Config.nBBAttrPlusAddAttackForm = 1 then
          NewValue := m_WAbil.DC2
        else if g_Config.nBBAttrPlusAddAttackForm = 2 then
          NewValue := m_WAbil.MC2
        else
          NewValue := m_WAbil.SC2;
        MonObj.m_nBBAttrPlusValues[0][1] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddAttackRate);
      end;
      if g_Config.nBBAttrPlusAddDefenceRate > 0 then
      begin
        if g_Config.boBBAttrPlusAddDefence then
        begin
          NewValue := m_WAbil.AC1;
          MonObj.m_nBBAttrPlusValues[1][0] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddDefenceRate);
          NewValue := m_WAbil.AC2;
          MonObj.m_nBBAttrPlusValues[1][1] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddDefenceRate);
        end;
        if g_Config.boBBAttrPlusAddMagicDefence then
        begin
          NewValue := m_WAbil.MAC1;
          MonObj.m_nBBAttrPlusValues[2][0] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddDefenceRate);
          NewValue := m_WAbil.MAC2;
          MonObj.m_nBBAttrPlusValues[2][1] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddDefenceRate);
        end;
      end;
      if g_Config.boBBAttrPlusAddHP and (g_Config.nBBAttrPlusAddHPRate > 0) then
      begin
        NewValue := m_WAbil.MaxHP;
        MonObj.m_nBBAttrPlusValues[3][0] := Round(NewValue / 100 * g_Config.nBBAttrPlusAddHPRate);
      end;
      if MagicNewLevel > 0 then
      begin
        if MagicNewLevel <= 9 then
        begin
          NewValue := g_Config.nBBAttrPlusNewLevelRates[MagicNewLevel - 1];
          for I := Low(MonObj.m_nBBAttrPlusValues) to High(MonObj.m_nBBAttrPlusValues) do
          begin
            MonObj.m_nBBAttrPlusValues[I][0] := Round(MonObj.m_nBBAttrPlusValues[I][0] / 100 * NewValue);
            MonObj.m_nBBAttrPlusValues[I][1] := Round(MonObj.m_nBBAttrPlusValues[I][1] / 100 * NewValue);
          end;
        end
        else
        begin
          NewValue := g_Config.nBBAttrPlusNewLevelRates[8];
          for I := Low(MonObj.m_nBBAttrPlusValues) to High(MonObj.m_nBBAttrPlusValues) do
          begin
            MonObj.m_nBBAttrPlusValues[I][0] := Round(MonObj.m_nBBAttrPlusValues[I][0] / 100 * NewValue);
            MonObj.m_nBBAttrPlusValues[I][1] := Round(MonObj.m_nBBAttrPlusValues[I][1] / 100 * NewValue);
          end;
        end;
      end;
    end;
    MonObj.RecalcAbilitys;
    // 召唤出来的新宝宝满血 2019-07-08 23:50:54
    if MonObj.m_WAbil.HP < MonObj.m_WAbil.MaxHP then
      MonObj.m_WAbil.HP := MonObj.m_WAbil.MaxHP;

    MonObj.RefNameColor;
    MonObj.m_BBType := BBType;
    m_SlaveList.Add(MonObj);
    Result := MonObj;
  end;
end;

function TBaseObject.RunTo(btDir: Byte; boFlag: Boolean): Boolean;
var
  nOldX, nOldY: Integer;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.RunTo';
begin
  Result := False;
  if m_boDingShen then
    Exit;
  try
    nOldX := m_nCurrX;
    nOldY := m_nCurrY;
    m_btDirection := btDir;
    // 骑马一步三格 chongchong 2013-10-16
    if (m_btRaceServer = RC_PLAYOBJECT) and (TPlayObject(Self).m_boOnHorse) and g_Config.boHorseRun3Grid then
    begin
      case btDir of
        DR_UP { 0 } :
          begin
            if (m_nCurrY > 1) and (m_PEnvir.CanWalkEx(Self, m_nCurrX, m_nCurrY - 1, g_Config.boDiableHumanRun or
              ((m_btPermission > 9) and g_Config.boGMRunAll)) { or (g_Config.boSafeAreaLimited and InSafeZone) } ) and
