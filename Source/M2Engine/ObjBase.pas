  function Skill66Attack(nSecPwr: Integer; IsHeavyBlow: Boolean { 是否重击 }; nSkillAttackLevel: Integer): Boolean; // 开天斩 66
  var
    nX, nY, nNewPower: Integer;
    BaseObject: TBaseObject;
    I: Integer;
    MagicACInfo: PMagicACInfo;
    IsSetPKPower: Boolean;
    nRange: Integer;
  begin
    Result := False;
    nX := m_nCurrX;
    nY := m_nCurrY;
    IsSetPKPower := True;
    if (nSecPwr > 0) then
    begin
      MagicACInfo := UserEngine.m_MagicACList.Get(66);
      if AttackTarget <> nil then
      begin
        nNewPower := GetMagicPercentPower(66, nSecPwr, AttackTarget);
        /// ////////////////开天斩忽视魔法盾 piaoyun 2013-08-18//////////////////
        nNewPower := AttackTarget.GetHitStruckDamage(Self, nNewPower, MagicACInfo, 2);
        /// ///////////////////////////////////////////////////////////////////
        /// ////////////////开天斩忽视物理防御 piaoyun 2013-08-18////////////////
        if { (not g_Config.boSwordLongNotDefence) and } (not CanCloseDefense) then
        begin
          nNewPower := AttackTarget.GetHitStruckDamage(Self, nNewPower, MagicACInfo, 1);
          nNewPower := AttackTarget.GetHitStruckDamage(Self, nNewPower, nil, 3);
        end;
        /// /////////////////////////////////////////////////////////////////////
        Result := DirectAttack(AttackTarget, nNewPower, 66, IsSetPKPower);
        if AttackTarget <> m_TargetCret then
        begin
          SetTargetCreat(AttackTarget);
        end;
        if IsSetPKPower then
          IsSetPKPower := False;
      end;
      if IsHeavyBlow then
        nRange := 4
      else
        nRange := 2;
      for I := 1 to nRange do
      begin
        if m_PEnvir.GetNextPosition(m_nCurrX, m_nCurrY, m_btDirection, I, nX, nY) then
        begin
          BaseObject := TBaseObject(m_PEnvir.GetMovingObject(nX, nY, True));
          if (BaseObject <> nil) and (BaseObject <> AttackTarget) and IsProperTarget(BaseObject) then
          begin
            nNewPower := GetMagicPercentPower(66, nSecPwr, BaseObject);
            // 开天斩修改为距离越远伤害越大 chongchong 2015-08-14
            nNewPower := Max(Round(nNewPower + nNewPower * I / 8), 0);
            if nNewPower > 0 then
            begin
              CloseTargetSuperShiled(11, nSkillAttackLevel, BaseObject);
              /// ////////////////开天斩忽视魔法盾 piaoyun 2013-08-18//////////////
              nNewPower := BaseObject.GetHitStruckDamage(Self, nNewPower, MagicACInfo, 2);
              /// /////////////////////////////////////////////////////////////////
              /// ////////////////开天斩忽视物理防御 piaoyun 2013-08-18////////////
              if { (not g_Config.boSwordLongNotDefence) and } (not CanCloseDefense) then
              begin
                nNewPower := BaseObject.GetHitStruckDamage(Self, nNewPower, MagicACInfo, 1);
                nNewPower := BaseObject.GetHitStruckDamage(Self, nNewPower, nil, 3);
              end;
              /// /////////////////////////////////////////////////////////////////
              Result := DirectAttack(BaseObject, nNewPower, 66, IsSetPKPower);
              if IsSetPKPower then
                IsSetPKPower := False;
              // 修正隔位刺杀只有隔位目标时，<$ATTACKMONSTER_MAXHPEX>等变量为空 2021-01-14
              if m_CurrTargetEx = nil then
                m_CurrTargetEx := BaseObject;
              // 攻击后破盾  2019-07-24
              // CloseTargetSuperShiled(11, nSkillAttackLevel, BaseObject);
            end;
            SetTargetCreat(BaseObject);
          end;
          // nSecPwr := Max(nSecPwr - nDecValue, 10); //距离越远，威力递减
        end;
      end;
    end;
