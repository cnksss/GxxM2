destructor TBaseObject.Destroy;
var
  I: Integer;
  SendMessage: pTSendMessage;
  nCheckCode: Integer;
  VisibleBaseObject: pTVisibleBaseObject;
  VisibleMapItem: pTVisibleMapItem;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.Destroy Code: %d';
begin
  nCheckCode := 0;
  try
    if g_PluginManager <> nil then
      g_PluginManager.HookBaseObjectFree(Self);
    nCheckCode := 1;
    if m_MsgList.Count > 0 then
    begin
      for I := 0 to m_MsgList.Count - 1 do
      begin
        nCheckCode := 2;
        SendMessage := m_MsgList.Items[I];
        nCheckCode := 6;
        if (SendMessage.Buff <> nil) and (SendMessage.BuffLen > 0) then
        begin
          nCheckCode := 7;
          FreeMem(SendMessage.Buff, SendMessage.BuffLen);
        end;
        // Dispose(SendMessage);
        FreeMem(SendMessage, SizeOf(TSendMessage));
        nCheckCode := 8;
      end;
    end;
    nCheckCode := 9;
    FreeAndNil(m_MsgList);
    nCheckCode := 10;
    // 修复异常 piaoyun 2013-12-18
    if m_VisibleHumanList <> nil then
      FreeAndNil(m_VisibleHumanList);
    nCheckCode := 11;
    for I := 0 to m_VisibleActors.Count - 1 do
    begin
      VisibleBaseObject := m_VisibleActors[I].Item;
      if VisibleBaseObject <> nil then
        Dispose(VisibleBaseObject);
    end;
    nCheckCode := 13;
    m_VisibleActors.Free;
    nCheckCode := 17;
    for I := m_ItemList.Count - 1 downto 0 do
    begin
      nCheckCode := 18;
      if m_ItemList.Items[I] <> nil then
        Dispose(pTUserItem(m_ItemList.Items[I]));
      nCheckCode := 19;
    end;

    nCheckCode := 20;
    if m_ItemList <> nil then
      FreeAndNil(m_ItemList);

    nCheckCode := 24;
    if m_SlaveList <> nil then
      FreeAndNil(m_SlaveList);

    for I := 0 to m_VisibleItems.Count - 1 do
    begin
      VisibleMapItem := m_VisibleItems[I].Item;
      if VisibleMapItem <> nil then
        Dispose(VisibleMapItem);
    end;
    FreeAndNil(m_VisibleItems);

    for I := 0 to m_CustomMagicStatusList.Count - 1 do
      Dispose(PCustomMagicStatus(m_CustomMagicStatusList.Items[I]));
    m_CustomMagicStatusList.Free;

    nCheckCode := 25;
    FreeAndNil(m_Pointer); // 用于插件声明变量

    for I := 0 to m_BaseObjectEffects.Count - 1 do
      Dispose(pTBaseObjectEffect(m_BaseObjectEffects.Items[I]));
    FreeAndNil(m_BaseObjectEffects);

    for I := 0 to m_NpcHumanHPList.Count - 1 do
      FreeMemory(PNpcHumanHPRec(m_NpcHumanHPList.Items[I]));
    FreeAndNil(m_NpcHumanHPList);

    m_PickUpItemFailList.Free;
    m_PreviewMonItemSaveVarList.Free;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg, [nCheckCode]));
      MainOutMessage(E.Message);
    end;
  end;

  inherited;
end;

function TBaseObject.CanStone(nValue: Integer): Boolean;
begin
  Result := (not UnParalysis) and (Random(m_btAntiPoison + nValue) = 0);
end;

function TBaseObject.CanMove(): Boolean;
begin
  // 这里去掉定身，因为怪物是否攻击，会判断CanMove，如果定身了，这里会导致不攻击 chongchong 2015-11-09
  Result := ((m_wStatusTimeArr[POISON_STONE] = 0) and (m_wStatusTimeArr[STATE_FROZEN] = 0)) and
    (m_wStatusTimeArr[STATE_CONTINUOUSMAGICLOCK] = 0) and (not m_boForeverFrozen) { and (not m_boDingShen) } and
    (not m_boTanHuan);
end;

function TBaseObject.CanParaly(btType: Byte): Boolean; // 检测石化
var
  boParalyCan: Boolean;
begin
  Result := (m_wStatusTimeArr[POISON_STONE] = 0);
  if (not Result) or (g_Config.boSkill43LockParaly and m_boThunderPalsy) then
  begin
    case btType of
      0:
