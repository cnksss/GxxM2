procedure TBaseObject.ClientMagStruck(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nDamage, nReboundDamage: Integer;
  nSuckDamagePoint: Integer;
  AttackBaseObject: TBaseObject;
  SmartObject: TSmartObject;
  sAsk: string;
  AbsorbRate: Integer;
  nErrCode: Integer;
  BlastHitType: TBlastHitType;
  TempLastHiter, TempCurrTarget, TempTargetCret: TBaseObject;
  TempCurrMagicId: Integer;
  IsDecMP: Boolean;
  nOldMP: LongWord;
  IsHuman: Boolean;
  _Master: TBaseObject;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.ClientMagStruck; Error Code: ';
  sExceptionMsg1 = '[Exception] TBaseObject.ClientMagStruck1 GotoLable; ';
  sExceptionMsg2 = '[Exception] TBaseObject.ClientMagStruck2 GotoLable; ';
begin
  // 50级以下怪物受到魔法攻击会变得迟缓 2019-08-09 22:33:45
  if (ProcessMsg.wIdent = RM_MAGSTRUCK) and (m_btRaceServer >= RC_ANIMAL) and (not m_boMagStruckMonKeepMoveSpeed) and
    (m_Abil.Level < g_Config.nMagStruckMonLevel) then
  begin
    // m_dwWalkTick := m_dwWalkTick + g_Config.nMagStruckMonDecTime + LongWord(Random(g_Config.nMagStruckMonDecRandom));
    m_nWalkDelay := g_Config.nMagStruckMonDecTime + LongWord(Random(g_Config.nMagStruckMonDecRandom));
    m_nHitDelay := m_nWalkDelay;
  end;
  AttackBaseObject := TBaseObject(ProcessMsg.BaseObject);
  IsDecMP := False;
  BlastHitType := bhtNone;
  nErrCode := 1;
  try
    if (AttackBaseObject <> nil) then
    begin
      if AttackBaseObject.CanCloseDefense() then // 忽视目标防御
      begin
        // nDamage := ProcessMsg.nParam1
        nDamage := GetMagStruckDamage(AttackBaseObject, ProcessMsg.nParam1, nil, 1); // 不忽视盾防御 ++++++++++++  2020-11-09 23:46:37
      end
      else
      begin
        nErrCode := 2;
        if (ProcessMsg.nParam3 = 61) then
        begin
          if not g_Config.boSkill61NotMagBubbleDefence then
            nDamage := GetMagStruckDamage(AttackBaseObject, ProcessMsg.nParam1, nil)
          else
            nDamage := ProcessMsg.nParam1;
        end
        else
        begin
          nDamage := GetMagStruckDamage(AttackBaseObject, ProcessMsg.nParam1, nil);
        end;
      end;
      nDamage := NewAbilPower(3, nDamage); // 魔法伤害减小
      nErrCode := 3;
      nDamage := AttackBaseObject.NewAbilPower(1, nDamage); // 元素元素增加攻击伤害
      nErrCode := 4;
      nDamage := AttackBaseObject.BlastHit(nDamage, Self, BlastHitType); // 暴击
      nDamage := AttackBaseObject.GetPowerRateAdd(Self, nDamage); // 2020-09-12 23:24:45
      nErrCode := 5;
      nDamage := AttackBaseObject.GetMagicPercentPower(ProcessMsg.nParam3, nDamage, Self); // 增加技能攻击百分百
      nDamage := AttackBaseObject.GetNextDamage(nDamage);
    end
    else
    begin
      nErrCode := 6;
      nDamage := GetMagStruckDamage(AttackBaseObject, ProcessMsg.nParam1, nil);
      nDamage := NewAbilPower(3, nDamage);
    end;
  except
    MainOutMessage(sExceptionMsg1 + IntToStr(nErrCode));
  end;
  nSuckDamagePoint := 0;
  nErrCode := 7;
  if nDamage > 0 then
  begin
    try
      if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
      begin
        // 伤害吸收百分比 2020-09-17 20:11:44
        if AttackBaseObject <> nil then
        begin
          IsHuman := AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
          if not IsHuman then
          begin
            _Master := AttackBaseObject.Master;
            if (_Master <> nil) then
            begin
              IsHuman := _Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
            end;
          end;
          if not IsHuman then
            nDamage := TSmartObject(Self).m_StruckDamageAbsorbMgr.GetStruckDamage(AttackBaseObject.m_sCharName, nDamage);
        end;
        if (TSmartObject(Self).m_nSuckDamagePoint > 0) and (nDamage > 0) and (TSmartObject(Self).m_nSuckDamageRate > 0) then
        begin // 吸收伤害
          if Random(100) < TSmartObject(Self).m_nSuckDamageProbability then
          begin
            nErrCode := 8;
            nSuckDamagePoint := Round(TSmartObject(Self).m_nSuckDamageRate * nDamage / 1000);
            nErrCode := 9;
            if nSuckDamagePoint > TSmartObject(Self).m_nSuckDamagePoint then
              TSmartObject(Self).m_nSuckDamagePoint := nSuckDamagePoint;
            nErrCode := 10;
            Dec(TSmartObject(Self).m_nSuckDamagePoint, nSuckDamagePoint);
            nErrCode := 11;
            nDamage := Max(nDamage - nSuckDamagePoint, 0);
          end;
        end;
        nErrCode := 12;
        // 道法连击保护盾 chongchong 2013-11-10
        if (nDamage > 0) and (TSmartObject(Self).m_btJob in [1, 2]) and (TSmartObject(Self).m_boContinuous) then
        begin
          nErrCode := 13;
          AbsorbRate := Max(Random(g_Config.btContinuousProtectRandom + 1), g_Config.btContinuousProtect);
          nErrCode := 14;
          if AbsorbRate > 100 then
            AbsorbRate := 100;
          nErrCode := 15;
          nDamage := Max(Round(nDamage / 100 * (100 - AbsorbRate)), 0);
        end;
      end;
    except
      MainOutMessage(sExceptionMsg1 + IntToStr(nErrCode));
    end;
    if (AttackBaseObject <> nil) and (g_PluginManager <> nil) then
    begin
      g_PluginManager.HookBaseObjectMagicAttack(Self, AttackBaseObject, ProcessMsg.nParam3, nDamage);
    end;
    try
      nErrCode := 16;
      if nDamage > 0 then
      begin
        nErrCode := 17;
        nDamage := GetAttackPowerMax(nDamage); // 去最大攻击限制
        nErrCode := 18;
        // 魔法技能对怪物施展时，超过怪物血量，按怪物血量来算 chongchong 2018-02-13
        nOldMP := m_WAbil.MP;
        nDamage := StruckDamage(nDamage, TBaseObject(ProcessMsg.BaseObject), ProcessMsg.nParam3);
        IsDecMP := m_WAbil.MP < nOldMP; // 用护身戒指抵御了伤害 2020-03-26 22:59:29
      end;
      // MainOutMessage('间隔03 (RM_MAGSTRUCK):' + IntToStr(MyGetTickCount - g_Debug_Spell_Tick));
      // g_Debug_Spell_Tick := MyGetTickCount;
      nErrCode := 19;
      SendRefMsg(RM_STRUCK_MAG, nDamage, m_WAbil.HP, m_WAbil.MaxHP, NativeInt(ProcessMsg.BaseObject),
        BlastHitTypeValues[BlastHitType]);

      if m_btRaceServer <> RC_PLAYOBJECT then
      begin
        nErrCode := 20;
        if m_boAnimal then
          Dec(m_nMeatQuality, nDamage * 1000);
        nErrCode := 21;
        SendUpdateMsg(Self, RM_STRUCK, nDamage, m_WAbil.HP, m_WAbil.MaxHP, NativeInt(ProcessMsg.BaseObject) { AttackBaseObject } ,
          IntToStr(Integer(BlastHitType))); // 修改
      end;
    except
      MainOutMessage(sExceptionMsg1 + IntToStr(nErrCode));
    end;
  end;

  try
    nErrCode := 22;
    if not SameText(ProcessMsg.sMsg, 'FastParalysis') then
    begin
      if m_boFastParalysis then
      begin
        m_wStatusTimeArr[POISON_STONE] := 1;
        m_boFastParalysis := False;
      end;

      if m_boTanHuan then
        CloseTanHuan;
    end;
    AttackBaseObject := TBaseObject(ProcessMsg.BaseObject);

    // 毒素武器
    nErrCode := 23;
    if g_Config.boPoisonWeaponCanMagicAttack and (AttackBaseObject <> nil) and
      (AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
    begin
      nErrCode := 24;
      SmartObject := TSmartObject(AttackBaseObject);
      if SmartObject.m_boPoisonWeapon and (not UnPosion) and (Random(Max(m_btAntiPoison, 0)) = 0) and
        (Random(100) < SmartObject.m_nPoisonWeaponRate) then
      begin
        nErrCode := 25;
        m_PoisonHitter := AttackBaseObject;
        nErrCode := 26;
        MakePosion(POISON_DECHEALTH, SmartObject.m_nPoisonWeaponBaseTime + Random(SmartObject.m_nPoisonWeaponRandomTime),
          SmartObject.m_nPoisonWeaponDamageHealth);
      end;
    end;

    // 魔道麻痹 chongchong 2013-11-20
    nErrCode := 27;
    if (not UnParalysis) and (AttackBaseObject <> nil) and
      (AttackBaseObject.m_boMDParalysis or (Random(100) < AttackBaseObject.m_btFluteStoneMDParalysisRate)) and
      (Random(Max(m_btAntiPoison + AttackBaseObject.m_dwMDParalysisRate, 0)) = 0) and
    // 火墙技能取消魔道麻痹效果 chongchong 2014-03-04
      (ProcessMsg.nParam3 <> SKILL_EARTHFIRE) then
    begin
      nErrCode := 28;
      m_PoisonHitter := AttackBaseObject;
      nErrCode := 29;
      MakePosion(POISON_STONE, AttackBaseObject.m_dwMDParalysisTime, 0);
    end;

    // 冰冻戒指 chongchong 2013-11-20
    nErrCode := 30;
    if g_Config.boFrozenUseMagicStruck and (not UnFrozen) and (AttackBaseObject <> nil) and
      (AttackBaseObject.m_boFrozen or (Random(100) < AttackBaseObject.m_btFluteStoneFrozenRate)) and
      (Random(Max(m_btAntiPoison + AttackBaseObject.m_dwFrozenRate, 0)) = 0) and
    // 火墙技能取消魔法冰冻效果 chongchong 2014-03-04
      (ProcessMsg.nParam3 <> SKILL_EARTHFIRE) then
    begin
      nErrCode := 31;
      m_PoisonHitter := AttackBaseObject;
      nErrCode := 32;
      MakeFrozen(AttackBaseObject.m_dwFrozenTime);
    end;

    // 蛛网戒指 chongchong 2013-11-20
    nErrCode := 33;
    if g_Config.boCobwebWindingUseMagicStruck and (not UnCobwebWinding) and (AttackBaseObject <> nil) and
      (AttackBaseObject.m_boCobwebWinding or (Random(100) < AttackBaseObject.m_btFluteStoneWindingRate)) and
      (Random(Max(m_btAntiPoison + AttackBaseObject.m_dwCobwebWindingRate, 0)) = 0) then
    begin
      nErrCode := 34;
      m_PoisonHitter := AttackBaseObject;
      nErrCode := 35;
      OpenCobwebWinding(AttackBaseObject.m_dwCobwebWindingTime);
    end;

    nErrCode := 36;
    if (AttackBaseObject <> nil) then
    begin // 反弹伤害
      if (nDamage > 0) then
      begin
        nErrCode := 37;
        nReboundDamage := DamageReboundPower(nDamage);
        if nReboundDamage > 0 then
        begin
          AttackBaseObject.StruckDamage(nReboundDamage, nil, ProcessMsg.nParam3);
          nErrCode := 38;
          AttackBaseObject.HealthSpellChanged();
          nErrCode := 39;
          AttackBaseObject.SendRefMsg(RM_STRUCK_MAG, nReboundDamage, AttackBaseObject.m_WAbil.HP, AttackBaseObject.m_WAbil.MaxHP,
            NativeInt(Self), '');

          nErrCode := 40;
          if AttackBaseObject.m_btRaceServer <> RC_PLAYOBJECT then
          begin
            nErrCode := 41;
            if AttackBaseObject.m_boAnimal then
              Dec(AttackBaseObject.m_nMeatQuality, nReboundDamage * 1000);
            nErrCode := 42;
            AttackBaseObject.SendMsg(AttackBaseObject, RM_STRUCK, nReboundDamage, AttackBaseObject.m_WAbil.HP,
              AttackBaseObject.m_WAbil.MaxHP, NativeInt(Self), '');
          end;

          nErrCode := 43;
          if AttackBaseObject.m_boFastParalysis then
          begin
            // AttackBaseObject.m_wStatusTimeArr[POISON_STONE] := Max(Min(m_wStatusTimeArr[POISON_STONE], 5), 1); //修改麻痹被攻击5秒后可以活动
            AttackBaseObject.m_wStatusTimeArr[POISON_STONE] := 1;
            AttackBaseObject.m_boFastParalysis := False;
          end;

          if AttackBaseObject.m_boTanHuan then
            AttackBaseObject.CloseTanHuan;
        end;
      end;
    end;
    // 把这个移到下面 chongchong 2018-08-02 11:59:22
    // m_wCurrMagicId := ProcessMsg.nParam3;
    // m_CurrTarget := AttackBaseObject;
  except
    MainOutMessage(sExceptionMsg1 + IntToStr(nErrCode));
  end;

  m_wCurrMagicId := ProcessMsg.nParam3;
  m_CurrTarget := AttackBaseObject;
  if IsDecMP then
    m_nStruckHP := nDamage + m_MagicShieldDecMP
  else
    m_nStruckHP := nDamage;

  // 增加0伤害时不触发 2019-09-16 22:34:42
  if (nDamage > 0) or IsDecMP or (nSuckDamagePoint > 0) then // 伤害被吸收后也要触发 2020-09-15
  begin
    if (AttackBaseObject <> Self) and (g_FunctionNPC <> nil) then
    begin
      if (m_btRaceServer = RC_PLAYOBJECT) then
      begin
        if not m_NoTriggerAttackStruckScript then
        begin
          TPlayObject(Self).m_nScriptGotoCount := 0;
          try
            g_FunctionNPC.GotoLable(TPlayObject(Self), '@MagicStruck', False);
          except
            MainOutMessage(sExceptionMsg1);
          end;
        end
        else
          m_NoTriggerAttackStruckScript := False;
      end
      else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        TPlayObject(m_Master).m_nScriptGotoCount := 0;
        try
          g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroMagicStruck', False);
        except
          MainOutMessage(sExceptionMsg1);
        end;
      end
      else if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        // 修正在触发中写M. L. 无效
        TempLastHiter := m_Master.m_LastHiter;
        TempCurrTarget := m_Master.m_CurrTarget;
        TempTargetCret := m_Master.m_TargetCret;
        TempCurrMagicId := m_Master.m_wCurrMagicId;
        try
          m_Master.m_LastHiter := m_LastHiter;
          m_Master.m_CurrTarget := m_CurrTarget;
          m_Master.m_TargetCret := m_TargetCret;
          m_Master.m_wCurrMagicId := m_wCurrMagicId;
          TPlayObject(m_Master).m_nScriptGotoCount := 0;
          try
            if m_boGamePet then
              g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@GamePetMagicStruck', False)
            else
              g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@SlaveMagicStruck', False);
          except
            MainOutMessage(sExceptionMsg1);
          end;
        finally
          m_Master.m_LastHiter := TempLastHiter;
          m_Master.m_CurrTarget := TempCurrTarget;
          m_Master.m_TargetCret := TempTargetCret;
          m_Master.m_wCurrMagicId := TempCurrMagicId;
        end;
      end
      else if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_HEROOBJECT) and (Master <> nil) and
        (Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        // 修正在触发中写M. L. 无效
        TempLastHiter := m_Master.m_LastHiter;
        TempCurrTarget := m_Master.m_CurrTarget;
        TempTargetCret := m_Master.m_TargetCret;
        try
          m_Master.m_LastHiter := m_LastHiter;
          m_Master.m_CurrTarget := m_CurrTarget;
          m_Master.m_TargetCret := m_TargetCret;
          TPlayObject(Master).m_nScriptGotoCount := 0;
          try
            g_FunctionNPC.GotoLable(TPlayObject(Master), '@HeroSlaveMagicStruck', False);
          except
            MainOutMessage(sExceptionMsg1);
          end;
        finally
          m_Master.m_LastHiter := TempLastHiter;
          m_Master.m_CurrTarget := TempCurrTarget;
          m_Master.m_TargetCret := TempTargetCret
        end;
      end;
    end;
  end;

  if (AttackBaseObject <> nil) then
  begin
    AttackBaseObject.m_CurrTarget := Self;
    AttackBaseObject.m_wCurrMagicId := ProcessMsg.nParam3;
  end;

  // 增加0伤害时不触发 2019-09-16 22:34:42
  if (AttackBaseObject <> Self) and (AttackBaseObject <> nil) and (g_FunctionNPC <> nil) and
    ((nDamage > 0) or IsDecMP or (nSuckDamagePoint > 0)) then
  begin
    if (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      if not AttackBaseObject.m_NoTriggerAttackStruckScript then
      begin
        TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
        try
          // 修复火墙取不到 <$ATTACKMONSTER_NAME> chongchong 2018-01-25
          TempTargetCret := AttackBaseObject.m_TargetCret;
          try
            AttackBaseObject.m_TargetCret := Self;
            g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@MagicAttack', False);
            if BlastHitType <> bhtNone then
            begin
              if BlastHitType = bhtBlastHit then
                g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@BlastMagicAttack', False)
              else
                g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@FatalMagicAttack', False);
            end;
          finally
            AttackBaseObject.m_TargetCret := TempTargetCret;
          end;
          GiveHitterExp(AttackBaseObject, True, 0);
        except
          MainOutMessage(sExceptionMsg1);
        end;
      end
      else
        AttackBaseObject.m_NoTriggerAttackStruckScript := False;

      if AttackBaseObject.m_PEnvir.m_boHITMON and (AttackBaseObject.m_PEnvir.m_sHITMON <> '') then
      begin
        TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
        try
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), AttackBaseObject.m_PEnvir.m_sHITMON, False);
        except
          MainOutMessage(sExceptionMsg1);
        end;
      end;
    end
    else if (AttackBaseObject.m_btRaceServer = RC_HEROOBJECT) and (AttackBaseObject.m_Master <> nil) and
      (AttackBaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(AttackBaseObject.m_Master).m_nScriptGotoCount := 0;
      try
        // 修复火墙取不到 <$ATTACKMONSTER_NAME> chongchong 2018-01-25
        TempTargetCret := AttackBaseObject.m_TargetCret;
        try
          AttackBaseObject.m_TargetCret := Self;
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroMagicAttack', False);
          if BlastHitType <> bhtNone then
          begin
            if BlastHitType = bhtBlastHit then
              g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroBlastMagicAttack', False)
            else
              g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroFatalMagicAttack', False);
          end;
        finally
          AttackBaseObject.m_TargetCret := TempTargetCret;
        end;
      except
        MainOutMessage(sExceptionMsg1);
      end;
    end
    else if (AttackBaseObject.m_Master <> nil) and (AttackBaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(AttackBaseObject.m_Master).m_nScriptGotoCount := 0;
      try
        if AttackBaseObject is TCopyMon then
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@CloneMagicAttack', False)
        else if AttackBaseObject.m_boGamePet then
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@GamePetMagicAttack', False)
        else
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@SlaveMagicAttack', False);
      except
        MainOutMessage(sExceptionMsg1);
      end;
    end
    else if (AttackBaseObject.m_Master <> nil) and (AttackBaseObject.m_Master.m_btRaceServer = RC_HEROOBJECT) and
      (AttackBaseObject.Master <> nil) and (AttackBaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(AttackBaseObject.Master).m_nScriptGotoCount := 0;
      try
        if AttackBaseObject is TCopyMon then
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.Master), '@HeroCloneMagicAttack', False)
        else
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.Master), '@HeroSlaveMagicAttack', False);
      except
        MainOutMessage(sExceptionMsg1);
      end;
    end;
  end;
  try
    // 假人说话
    nErrCode := 46;
    if (AttackBaseObject <> nil) and (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) and AttackBaseObject.m_boDummyObject and
      (Random(TPlayObject(AttackBaseObject).m_nSayRate) = 0) then
    begin
      sAsk := AttackBaseObject.Ask;
      if sAsk <> '' then
        AttackBaseObject.SendRefMsg(RM_HEAR, 0, TPlayObject(AttackBaseObject).GetHearMsgFColor, g_Config.btHearMsgBColor, 0,
          AttackBaseObject.m_sCharName + ':' + sAsk);
    end;
    nErrCode := 47;
    if (m_btRaceServer = RC_PLAYOBJECT) and m_boDummyObject and (Random(TPlayObject(Self).m_nSayRate) = 0) then
    begin
      sAsk := Ask;
      if sAsk <> '' then
        SendRefMsg(RM_HEAR, 0, TPlayObject(Self).GetHearMsgFColor, g_Config.btHearMsgBColor, 0, m_sCharName + ':' + sAsk);
    end;
  except
    MainOutMessage(sExceptionMsg + IntToStr(nErrCode));
  end;
  if (AttackBaseObject <> nil) and (g_PluginManager <> nil) then
  begin
    g_PluginManager.HookBaseObjectMagicStruck(Self, AttackBaseObject, ProcessMsg.nParam3);
  end;
end;

procedure TBaseObject.ClientMagStruckEx(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  nDamage: Integer;
  nSuckDamagePoint: Integer;
  AttackBaseObject: TBaseObject;
  SmartObject: TSmartObject;
  sAsk: string;
  AbsorbRate: Integer;
  nErrCode: Integer;
  BlastHitType: TBlastHitType;
  IsHuman: Boolean;
  _Master: TBaseObject;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.ClientMagStruck; Error Code: ';
  sExceptionMsg1 = '[Exception] TBaseObject.ClientMagStruckEx1 GotoLable; ';
  sExceptionMsg2 = '[Exception] TBaseObject.ClientMagStruck2 GotoLable; ';
begin
  if (ProcessMsg.wIdent = RM_MAGSTRUCK) //
    and (m_btRaceServer >= RC_ANIMAL) //
    and (not m_boMagStruckMonKeepMoveSpeed) //
    and (m_Abil.Level < g_Config.nMagStruckMonLevel) then
  begin
    m_nWalkDelay := g_Config.nMagStruckMonDecTime + LongWord(Random(g_Config.nMagStruckMonDecRandom));
    m_nHitDelay := m_nWalkDelay;
  end;

  AttackBaseObject := TBaseObject(ProcessMsg.BaseObject);
  BlastHitType := bhtNone;
  nErrCode := 1;
  try
    if (AttackBaseObject <> nil) then
    begin
      if AttackBaseObject.CanCloseDefense() then // 忽视目标防御
      begin
        // nDamage := ProcessMsg.nParam1
        nDamage := GetMagStruckDamage(AttackBaseObject, ProcessMsg.nParam1, nil, 1); // 不忽视盾防御 ++++++++++++  2020-11-09 23:46:37
      end
      else
      begin
        nErrCode := 2;
        nDamage := GetMagStruckDamage(AttackBaseObject, ProcessMsg.nParam1, nil);
      end;
      nDamage := NewAbilPower(3, nDamage); // 魔法伤害减小
      nErrCode := 3;
      nDamage := AttackBaseObject.NewAbilPower(1, nDamage); // 元素元素增加攻击伤害
      nErrCode := 4;
      nDamage := AttackBaseObject.BlastHit(nDamage, Self, BlastHitType); // 暴击
      nDamage := AttackBaseObject.GetPowerRateAdd(Self, nDamage); // 2020-09-12 23:24:45
      nErrCode := 5;
      nDamage := AttackBaseObject.GetMagicPercentPower(ProcessMsg.nParam3, nDamage, Self); // 增加技能攻击百分百
      nDamage := AttackBaseObject.GetNextDamage(nDamage);
    end
    else
    begin
      nErrCode := 6;
      nDamage := GetMagStruckDamage(nil, ProcessMsg.nParam1, nil);
      nDamage := NewAbilPower(3, nDamage);
    end;
  except
    MainOutMessage(sExceptionMsg1 + IntToStr(nErrCode));
  end;
  nErrCode := 7;
  if nDamage > 0 then
  begin
    try
      if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
      begin
        // 伤害吸收百分比 2020-09-17 20:11:44
        if AttackBaseObject <> nil then
        begin
          IsHuman := AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
          if not IsHuman then
          begin
            _Master := AttackBaseObject.Master;
            if (_Master <> nil) then
            begin
              IsHuman := _Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
            end;
          end;
          if not IsHuman then
            nDamage := TSmartObject(Self).m_StruckDamageAbsorbMgr.GetStruckDamage(AttackBaseObject.m_sCharName, nDamage);
        end;
        if (TSmartObject(Self).m_nSuckDamagePoint > 0) and (nDamage > 0) and (TSmartObject(Self).m_nSuckDamageRate > 0) then
        begin // 吸收伤害
          if Random(100) < TSmartObject(Self).m_nSuckDamageProbability then
          begin
            nErrCode := 8;
            nSuckDamagePoint := Round(TSmartObject(Self).m_nSuckDamageRate * nDamage / 1000);
            nErrCode := 9;
            if nSuckDamagePoint > TSmartObject(Self).m_nSuckDamagePoint then
              TSmartObject(Self).m_nSuckDamagePoint := nSuckDamagePoint;
            nErrCode := 10;
            Dec(TSmartObject(Self).m_nSuckDamagePoint, nSuckDamagePoint);
            nErrCode := 11;
            nDamage := Max(nDamage - nSuckDamagePoint, 0);
          end;
        end;
        nErrCode := 12;
        // 道法连击保护盾 chongchong 2013-11-10
        if (nDamage > 0) and (TSmartObject(Self).m_btJob in [1, 2]) and (TSmartObject(Self).m_boContinuous) then
        begin
          nErrCode := 13;
          AbsorbRate := Max(Random(g_Config.btContinuousProtectRandom + 1), g_Config.btContinuousProtect);
          nErrCode := 14;
          if AbsorbRate > 100 then
            AbsorbRate := 100;
          nErrCode := 15;
          nDamage := Max(Round(nDamage / 100 * (100 - AbsorbRate)), 0);
        end;
      end;
    except
      MainOutMessage(sExceptionMsg1 + IntToStr(nErrCode));
    end;
    if (AttackBaseObject <> nil) and (g_PluginManager <> nil) then
    begin
      g_PluginManager.HookBaseObjectMagicAttack(Self, AttackBaseObject, ProcessMsg.nParam3, nDamage);
    end;
    try
      nErrCode := 16;
      if nDamage > 0 then
      begin
        nErrCode := 17;
        nDamage := GetAttackPowerMax(nDamage); // 去最大攻击限制
        nErrCode := 18;
        StruckDamage(nDamage, TBaseObject(ProcessMsg.BaseObject), ProcessMsg.nParam3);
      end;
      nErrCode := 19;
      SendRefMsg(RM_STRUCK_MAG, nDamage, m_WAbil.HP, m_WAbil.MaxHP, NativeInt(ProcessMsg.BaseObject),
        BlastHitTypeValues[BlastHitType]);
      if m_btRaceServer <> RC_PLAYOBJECT then
      begin
        nErrCode := 20;
        if m_boAnimal then
          Dec(m_nMeatQuality, nDamage * 1000);
        nErrCode := 21;
        SendUpdateMsg(Self, RM_STRUCK, nDamage, m_WAbil.HP, m_WAbil.MaxHP, NativeInt(ProcessMsg.BaseObject) { AttackBaseObject } ,
          IntToStr(Integer(BlastHitType))); // 修改
      end;
    except
      MainOutMessage(sExceptionMsg1 + IntToStr(nErrCode));
    end;
  end;
  try
    nErrCode := 22;
    if not SameText(ProcessMsg.sMsg, 'FastParalysis') then
    begin
      if m_boFastParalysis then
      begin
        m_wStatusTimeArr[POISON_STONE] := 1;
        m_boFastParalysis := False;
      end;
      if m_boTanHuan then
      begin
        CloseTanHuan;
      end;
    end;
    AttackBaseObject := TBaseObject(ProcessMsg.BaseObject);
    // 毒素武器
    nErrCode := 23;
    if g_Config.boPoisonWeaponCanMagicAttack and (AttackBaseObject <> nil) and
      (AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
    begin
      nErrCode := 24;
      SmartObject := TSmartObject(AttackBaseObject);
      if SmartObject.m_boPoisonWeapon and (not UnPosion) and (Random(Max(m_btAntiPoison, 0)) = 0) and
        (Random(100) < SmartObject.m_nPoisonWeaponRate) then
      begin
        nErrCode := 25;
        m_PoisonHitter := AttackBaseObject;
        nErrCode := 26;
        MakePosion(POISON_DECHEALTH, SmartObject.m_nPoisonWeaponBaseTime + Random(SmartObject.m_nPoisonWeaponRandomTime),
          SmartObject.m_nPoisonWeaponDamageHealth);
      end;
    end;
    // 魔道麻痹 chongchong 2013-11-20
    nErrCode := 27;
    if (not UnParalysis) and (AttackBaseObject <> nil) and
      (AttackBaseObject.m_boMDParalysis or (Random(100) < AttackBaseObject.m_btFluteStoneMDParalysisRate)) and
      (Random(Max(m_btAntiPoison + AttackBaseObject.m_dwMDParalysisRate, 0)) = 0) and
    // 火墙技能取消魔道麻痹效果 chongchong 2014-03-04
      (ProcessMsg.nParam3 <> SKILL_EARTHFIRE) then
    begin
      nErrCode := 28;
      m_PoisonHitter := AttackBaseObject;
      nErrCode := 29;
      MakePosion(POISON_STONE, AttackBaseObject.m_dwMDParalysisTime, 0);
    end;
    // 冰冻戒指 chongchong 2013-11-20
    nErrCode := 30;
    if g_Config.boFrozenUseMagicStruck and (not UnFrozen) and (AttackBaseObject <> nil) and
      (AttackBaseObject.m_boFrozen or (Random(100) < AttackBaseObject.m_btFluteStoneFrozenRate)) and
      (Random(Max(m_btAntiPoison + AttackBaseObject.m_dwFrozenRate, 0)) = 0) and
    // 火墙技能取消魔法冰冻效果 chongchong 2014-03-04
      (ProcessMsg.nParam3 <> SKILL_EARTHFIRE) then
    begin
      nErrCode := 31;
      m_PoisonHitter := AttackBaseObject;
      nErrCode := 32;
      MakeFrozen(AttackBaseObject.m_dwFrozenTime);
    end;
    // 蛛网戒指 chongchong 2013-11-20
    nErrCode := 33;
    if g_Config.boCobwebWindingUseMagicStruck and (not UnCobwebWinding) and (AttackBaseObject <> nil) and
      (AttackBaseObject.m_boCobwebWinding or (Random(100) < AttackBaseObject.m_btFluteStoneWindingRate)) and
      (Random(Max(m_btAntiPoison + AttackBaseObject.m_dwCobwebWindingRate, 0)) = 0) then
    begin
      nErrCode := 34;
      m_PoisonHitter := AttackBaseObject;
      nErrCode := 35;
      OpenCobwebWinding(AttackBaseObject.m_dwCobwebWindingTime);
    end;
    nErrCode := 36;
    if (AttackBaseObject <> nil) and (nDamage > 0) then
    begin // 反弹伤害
      nErrCode := 37;
      nDamage := DamageReboundPower(nDamage);
      if nDamage > 0 then
      begin
        AttackBaseObject.StruckDamage(nDamage, nil, ProcessMsg.nParam3);
        nErrCode := 38;
        AttackBaseObject.HealthSpellChanged();
        nErrCode := 39;
        AttackBaseObject.SendRefMsg(RM_STRUCK_MAG, nDamage, AttackBaseObject.m_WAbil.HP, AttackBaseObject.m_WAbil.MaxHP,
          NativeInt(Self), '');
        nErrCode := 40;
        if AttackBaseObject.m_btRaceServer <> RC_PLAYOBJECT then
        begin
          nErrCode := 41;
          if AttackBaseObject.m_boAnimal then
            Dec(AttackBaseObject.m_nMeatQuality, nDamage * 1000);
          nErrCode := 42;
          AttackBaseObject.SendMsg(AttackBaseObject, RM_STRUCK, nDamage, AttackBaseObject.m_WAbil.HP,
            AttackBaseObject.m_WAbil.MaxHP, NativeInt(Self), '');
        end;
        nErrCode := 43;
        if AttackBaseObject.m_boFastParalysis then
        begin
          // AttackBaseObject.m_wStatusTimeArr[POISON_STONE] := Max(Min(m_wStatusTimeArr[POISON_STONE], 5), 1); //修改麻痹被攻击5秒后可以活动
          AttackBaseObject.m_wStatusTimeArr[POISON_STONE] := 1;
          AttackBaseObject.m_boFastParalysis := False;
        end;
        if AttackBaseObject.m_boTanHuan then
        begin
          AttackBaseObject.CloseTanHuan;
        end;
      end;
    end;
    m_wCurrMagicId := ProcessMsg.nParam3;
    m_CurrTarget := AttackBaseObject;
  except
    MainOutMessage(sExceptionMsg1 + IntToStr(nErrCode));
  end;
  (*
    if (AttackBaseObject <> Self) and (g_FunctionNPC <> nil) then
    begin
    if (m_btRaceServer = RC_PLAYOBJECT) then
    begin
    if not Self.m_NoTriggerAttackStruckScript then
    begin
    TPlayObject(Self).m_nScriptGotoCount := 0;
    try
    g_FunctionNPC.GotoLable(TPlayObject(Self), '@MagicStruck', False);
    except
    MainOutMessage(sExceptionMsg1);
    end;
    end
    else
    Self.m_NoTriggerAttackStruckScript := False;
    end
    else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
    TPlayObject(m_Master).m_nScriptGotoCount := 0;
    try
    g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroMagicStruck', False);
    except
    MainOutMessage(sExceptionMsg1);
    end;
    end;
    end;
  *)
  if (AttackBaseObject <> nil) then
  begin
    AttackBaseObject.m_CurrTarget := Self;
    AttackBaseObject.m_wCurrMagicId := ProcessMsg.nParam3;
  end;
  (*
    if (AttackBaseObject <> Self) and (AttackBaseObject <> nil) and (g_FunctionNPC <> nil) then
    begin
    if (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) then
    begin
    if not AttackBaseObject.m_NoTriggerAttackStruckScript then
    begin
    TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
    try
    g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@MagicAttack', False);
    except
    MainOutMessage(sExceptionMsg1);
    end;
    end
    else
    begin
    AttackBaseObject.m_NoTriggerAttackStruckScript := False
    end;
    if AttackBaseObject.m_PEnvir.m_boHITMON and (AttackBaseObject.m_PEnvir.m_sHITMON <> '') then
    begin
    TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
    try
    g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), AttackBaseObject.m_PEnvir.m_sHITMON, False);
    except
    MainOutMessage(sExceptionMsg1);
    end;
    end;
    end
    else if (AttackBaseObject.m_btRaceServer = RC_HEROOBJECT) and (AttackBaseObject.m_Master <> nil) and
    (AttackBaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
    TPlayObject(AttackBaseObject.m_Master).m_nScriptGotoCount := 0;
    try
    g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroMagicAttack', False);
    except
    MainOutMessage(sExceptionMsg1);
    end;
    end;
    end;
  *)
  try
    // 假人说话
    nErrCode := 46;
    if (AttackBaseObject <> nil) and (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) and AttackBaseObject.m_boDummyObject and
      (Random(TPlayObject(AttackBaseObject).m_nSayRate) = 0) then
    begin
      sAsk := AttackBaseObject.Ask;
      if sAsk <> '' then
        AttackBaseObject.SendRefMsg(RM_HEAR, 0, TPlayObject(AttackBaseObject).GetHearMsgFColor, g_Config.btHearMsgBColor, 0,
          AttackBaseObject.m_sCharName + ':' + sAsk);
    end;
    nErrCode := 47;
    if (m_btRaceServer = RC_PLAYOBJECT) and m_boDummyObject and (Random(TPlayObject(Self).m_nSayRate) = 0) then
    begin
      sAsk := Ask;
      if sAsk <> '' then
        SendRefMsg(RM_HEAR, 0, TPlayObject(Self).GetHearMsgFColor, g_Config.btHearMsgBColor, 0, m_sCharName + ':' + sAsk);
    end;
  except
    MainOutMessage(sExceptionMsg + IntToStr(nErrCode));
  end;
  if (AttackBaseObject <> nil) and (g_PluginManager <> nil) then
  begin
    g_PluginManager.HookBaseObjectMagicStruck(Self, AttackBaseObject, ProcessMsg.nParam3);
  end;
end;

procedure TBaseObject.ClientMagHealing(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  AttackBaseObject: TBaseObject;
  sAsk: string;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.Operate ';
  sExceptionMsg1 = '[Exception] TBaseObject.Operate1 GotoLable';
  // sExceptionMsg2 = '[Exception] TBaseObject.Operate2 GotoLable';
begin
  {
    if (m_nAttackState > 0) and (m_nAttackState <= 9999) then
    begin
    Exit;
    end;
  }
  // 取消技能加血总量限制在300 2019-07-18 11:36:59
  if (m_nIncHealing + ProcessMsg.nParam1) < g_Config.nIncHealingLimite then
  begin
    { 治愈术和群体治愈术通过参数来配置恢复速度、基数 【2013-07-25】 }
    if ProcessMsg.nParam3 = SKILL_BIGHEALLING then { 29 SKILL_BIGHEALLING 群体治愈术 } { 2 SKILL_HEALLING 治愈术 }
    begin
      Inc(m_nIncHealing, ProcessMsg.nParam1);
      m_nPerHealing := g_Config.nBigPerHealing;
    end
    else
    begin
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        Inc(m_nIncHealing, ProcessMsg.nParam1);
        m_nPerHealing := g_Config.nPerHealing;
      end
      else
      begin
        Inc(m_nIncHealing, ProcessMsg.nParam1);
        m_nPerHealing := g_Config.nPerHealing;
      end;
    end;
  end
  else
    m_nIncHealing := g_Config.nIncHealingLimite;
  AttackBaseObject := TBaseObject(ProcessMsg.BaseObject);
  m_wCurrMagicId := ProcessMsg.nParam3;
  m_CurrTarget := AttackBaseObject;
  m_nStruckHP := -ProcessMsg.nParam1;
  // 增加0伤害时不触发 2019-09-16 22:34:42
  if (AttackBaseObject <> Self) and (g_FunctionNPC <> nil) and (m_nStruckHP > 0) then
  begin
    if (m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(Self).m_nScriptGotoCount := 0;
      try
        g_FunctionNPC.GotoLable(TPlayObject(Self), '@MagicStruck', False);
      except
        MainOutMessage(sExceptionMsg1);
      end;
    end
    else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(m_Master).m_nScriptGotoCount := 0;
      try
        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroMagicStruck', False);
      except
        MainOutMessage(sExceptionMsg1);
      end;
    end
    else if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(m_Master).m_nScriptGotoCount := 0;
      try
        if m_boGamePet then
          g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@GamePetMagicStruck', False)
        else
          g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@SlaveMagicStruck', False);
      except
        MainOutMessage(sExceptionMsg1);
      end;
    end;
  end;
  if (AttackBaseObject <> nil) then
  begin
    AttackBaseObject.m_CurrTarget := Self;
    AttackBaseObject.m_wCurrMagicId := ProcessMsg.nParam3;
  end;
  // 增加0伤害时不触发 2019-09-16 22:34:42
  if (AttackBaseObject <> Self) and (AttackBaseObject <> nil) and (g_FunctionNPC <> nil) and (m_nStruckHP > 0) then
  begin
    if (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
      try
        g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@MagicAttack', False);
        GiveHitterExp(AttackBaseObject, True, 0);
      except
        MainOutMessage(sExceptionMsg1);
      end;
      if AttackBaseObject.m_PEnvir.m_boHITMON and (AttackBaseObject.m_PEnvir.m_sHITMON <> '') then
      begin
        TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
        try
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), AttackBaseObject.m_PEnvir.m_sHITMON, False);
        except
          MainOutMessage(sExceptionMsg1);
        end;
      end;
    end
    else if (AttackBaseObject.m_btRaceServer = RC_HEROOBJECT) and (AttackBaseObject.m_Master <> nil) and
      (AttackBaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(AttackBaseObject.m_Master).m_nScriptGotoCount := 0;
      try
        g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroMagicAttack', False);
      except
        MainOutMessage(sExceptionMsg1);
      end;
    end
    else if (AttackBaseObject.m_Master <> nil) and (AttackBaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(AttackBaseObject.m_Master).m_nScriptGotoCount := 0;
      try
        if AttackBaseObject is TCopyMon then
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@CloneMagicAttack', False)
        else if AttackBaseObject.m_boGamePet then
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@GamePetMagicAttack', False)
        else
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@SlaveMagicAttack', False);
      except
        MainOutMessage(sExceptionMsg1);
      end;
    end
    else if (AttackBaseObject.m_Master <> nil) and (AttackBaseObject.m_Master.m_btRaceServer = RC_HEROOBJECT) and
      (AttackBaseObject.Master <> nil) and (AttackBaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(AttackBaseObject.Master).m_nScriptGotoCount := 0;
      try
        if AttackBaseObject is TCopyMon then
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.Master), '@HeroSlaveMagicAttack', False)
        else
          g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.Master), '@HeroCloneMagicAttack', False);
      except
        MainOutMessage(sExceptionMsg1);
      end;
    end;
  end;
  // 假人说话
  if ProcessMsg.nParam3 <> 2 then
  begin // 不是治愈术 说话
    if (AttackBaseObject <> nil) and (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) and AttackBaseObject.m_boDummyObject and
      (Random(TPlayObject(AttackBaseObject).m_nSayRate) = 0) then
    begin
      sAsk := AttackBaseObject.Ask;
      if sAsk <> '' then
        AttackBaseObject.SendRefMsg(RM_HEAR, 0, TPlayObject(AttackBaseObject).GetHearMsgFColor, g_Config.btHearMsgBColor, 0,
          AttackBaseObject.m_sCharName + ':' + sAsk);
    end;
    if (m_btRaceServer = RC_PLAYOBJECT) and m_boDummyObject and (Random(TPlayObject(Self).m_nSayRate) = 0) then
    begin
      sAsk := Ask;
      if sAsk <> '' then
        SendRefMsg(RM_HEAR, 0, TPlayObject(Self).GetHearMsgFColor, g_Config.btHearMsgBColor, 0, m_sCharName + ':' + sAsk);
    end;
  end;
end;

procedure TBaseObject.Client10101(ProcessMsg: pTProcessMessage; var boResult: Boolean);
var
  AttackBaseObject: TBaseObject;
  sAsk, strMsg, sLabel: string;
  ErrCode, I, TempCurrMagicId: Integer;
  IsMagic: Boolean;
  TempLastHiter, TempCurrTarget, TempTargetCret: TBaseObject;
  Player: TPlayObject;
  IsFromFT: Boolean; // 是否为反弹伤害
  BlastHitType: TBlastHitType; // 是否触发致命一击
  _Index: Integer;
  MonHPProgress: pTMonHPProgress;
  nDamage: Integer;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.Client10101; ErrorCode = %d';
  sExceptionMsg2 = '[Exception] TBaseObject.Client10101; GotoLabel';
begin
  {
    if (m_nAttackState > 0) and (m_nAttackState <= 9999) then
    begin
    Exit;
    end;
  }
  IsFromFT := False;
  BlastHitType := bhtNone;
  m_wCurrMagicId := LoWord(StrToIntDef(ProcessMsg.sMsg, 0));
  ErrCode := 1;
  try
    IsMagic := False;
    I := 0;
    ErrCode := 11;
    if NativeInt(ProcessMsg.BaseObject) = RM_STRUCK then
    begin
      if ProcessMsg.wIdent = RM_10101_2 then
      begin
        sAsk := ProcessMsg.sMsg;
        if (Length(sAsk) > 4) then
        begin
          strMsg := Copy(sAsk, 1, 4);
          if SameText(strMsg, 'MAG:') then
          begin
            sAsk := Copy(sAsk, 5, MaxInt);
          end;
        end;
        m_wCurrMagicId := LoWord(StrToIntDef(sAsk, 0));
        ProcessMsg.wParam := StruckDamage(ProcessMsg.wParam, TBaseObject(ProcessMsg.nParam3), m_wCurrMagicId); // nPower
        ProcessMsg.nParam1 := m_WAbil.HP;
        ProcessMsg.nParam2 := m_WAbil.MaxHP;
        AttackBaseObject := TBaseObject(ProcessMsg.nParam3);
        if (AttackBaseObject <> nil) and (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          // 自定义技能伤害反弹  2019-06-04 23:57:55
          nDamage := DamageReboundPower(ProcessMsg.wParam);
          if nDamage > 0 then
          begin // 反弹伤害
            TPlayObject(AttackBaseObject).SendDelayMsg(TBaseObject(RM_STRUCK), RM_10101, nDamage, AttackBaseObject.m_WAbil.HP,
              AttackBaseObject.m_WAbil.MaxHP, NativeInt(Self), 'FT', 100);
          end;
        end;
      end;
      ErrCode := 12;
      if SameText(ProcessMsg.sMsg, 'FT') then
      begin
        strMsg := '';
        IsFromFT := True;
      end
      else
      begin
        // 宝宝攻击也要显示大血条 2020-07-14 16:08:12
        if (m_btRaceServer >= RC_ANIMAL) then
        begin
          _Index := g_MonHPProgressList.IndexOf(m_sCharName);
          if _Index >= 0 then
          begin
            MonHPProgress := pTMonHPProgress(g_MonHPProgressList.Objects[_Index]);
            Player := nil;
            if (m_ExpHitter <> nil) then
            begin
              if (m_ExpHitter.m_btRaceServer = RC_PLAYOBJECT) then
                Player := TPlayObject(m_ExpHitter)
              else if (m_ExpHitter.Master <> nil) and (m_ExpHitter.Master.m_btRaceServer = RC_PLAYOBJECT) then
                Player := TPlayObject(m_ExpHitter.Master);
            end;
            if Player <> nil then
            begin
              MonHPProgress.m_ExpHinterName := Player.m_sCharName;
              m_DefMsg := MakeDefaultMsg(SM_SENDBIGHPPROGRESS, NativeInt(Self), 0, 0, 0);
              Player.SendSocketEx(@m_DefMsg, PAnsiChar(MonHPProgress), SizeOf(TMonHPProgress));
            end
          end;
        end;
        ErrCode := 13;
        if (Length(ProcessMsg.sMsg) > 4) then
        begin
          ErrCode := 14;
          strMsg := Copy(ProcessMsg.sMsg, 1, 4);
          if SameText(strMsg, 'MAG:') then
          begin
            IsMagic := True;
            ProcessMsg.sMsg := Copy(ProcessMsg.sMsg, 5, MaxInt);
          end;
        end;
        m_wCurrMagicId := LoWord(StrToIntDef(ProcessMsg.sMsg, 0));
        ErrCode := 15;
        I := StrToIntDef(ProcessMsg.sMsg, 0);
        // 高位表示是否暴击，低位是魔法ID
        if I > 0 then
          strMsg := IntToStr(HiWord(I))
        else
          strMsg := ProcessMsg.sMsg;
        if (strMsg <> '') then
        begin
          if (strMsg = BlastHitTypeValues[bhtBlastHit]) then
            BlastHitType := bhtBlastHit
          else if (strMsg = BlastHitTypeValues[bhtFatalBlow1]) then
            BlastHitType := bhtFatalBlow1
          else if (strMsg = BlastHitTypeValues[bhtFatalBlow2]) then
            BlastHitType := bhtFatalBlow2
          else if (strMsg = BlastHitTypeValues[bhtFatalBlow3]) then
            BlastHitType := bhtFatalBlow3
          else if (strMsg = BlastHitTypeValues[bhtFatalBlow4]) then
            BlastHitType := bhtFatalBlow4;
        end;
      end;
      ErrCode := 16;
      SendRefMsg(NativeInt(ProcessMsg.BaseObject), ProcessMsg.wParam { nPower } , ProcessMsg.nParam1 { HP } ,
        ProcessMsg.nParam2 { MaxHP } , ProcessMsg.nParam3 { AttackSrc } , strMsg);
    end
    else
    begin
      SendRefMsg(NativeInt(ProcessMsg.BaseObject), ProcessMsg.wParam { nPower } , ProcessMsg.nParam1 { HP } ,
        ProcessMsg.nParam2 { MaxHP } , ProcessMsg.nParam3 { AttackSrc } , ProcessMsg.sMsg);
    end;
    ErrCode := 2;
    if (NativeInt(ProcessMsg.BaseObject) = RM_STRUCK) and (m_btRaceServer <> RC_PLAYOBJECT) then
    begin
      // 高位表示是否暴击，低位是魔法ID
      ErrCode := 17;
      if SameText(ProcessMsg.sMsg, 'FT') then
      begin
        strMsg := '';
        IsFromFT := True;
      end
      else
      begin
        ErrCode := 18;
        if I > 0 then
          strMsg := IntToStr(HiWord(I))
        else
          strMsg := ProcessMsg.sMsg;
      end;
      ErrCode := 19;
      SendMsg(Self, NativeInt(ProcessMsg.BaseObject), ProcessMsg.wParam, ProcessMsg.nParam1, ProcessMsg.nParam2,
        ProcessMsg.nParam3 { AttackBaseObject } , strMsg);
    end;
    ErrCode := 3;
    if m_boFastParalysis then
    begin
      m_wStatusTimeArr[POISON_STONE] := 1;
      m_boFastParalysis := False;
    end;
    ErrCode := 30;
    if m_boTanHuan then
    begin
      ErrCode := 31;
      CloseTanHuan;
    end;
    ErrCode := 4;
    AttackBaseObject := TBaseObject(ProcessMsg.nParam3);
    m_CurrTarget := AttackBaseObject;
    m_nStruckHP := ProcessMsg.wParam + m_MagicShieldDecMP;
    ErrCode := 5;
    // 反弹伤害不触发脚本 + and (not IsFromFT)  2019-06-04 23:58:18
    if (g_FunctionNPC <> nil) and (not IsFromFT) then
    begin
      if (m_btRaceServer = RC_PLAYOBJECT) then
      begin
        TPlayObject(Self).m_nScriptGotoCount := 0;
        try
          if not IsMagic then
            sLabel := '@Struck'
          else
            sLabel := '@MagicStruck';
          g_FunctionNPC.GotoLable(TPlayObject(Self), sLabel, False);
        except
          MainOutMessage(sExceptionMsg2 + sLabel);
        end;
      end
      else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        TPlayObject(m_Master).m_nScriptGotoCount := 0;
        try
          if not IsMagic then
            sLabel := '@HeroStruck'
          else
            sLabel := '@HeroMagicStruck';
          g_FunctionNPC.GotoLable(TPlayObject(m_Master), sLabel, False);
        except
          MainOutMessage(sExceptionMsg2 + sLabel);
        end;
      end
      else if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        TPlayObject(m_Master).m_nScriptGotoCount := 0;
        try
          sLabel := '';
          // 修正在触发中写M. L. 无效
          TempLastHiter := m_Master.m_LastHiter;
          TempCurrTarget := m_Master.m_CurrTarget;
          TempTargetCret := m_Master.m_TargetCret;
          TempCurrMagicId := m_Master.m_wCurrMagicId;
          try
            m_Master.m_LastHiter := m_LastHiter;
            m_Master.m_CurrTarget := m_CurrTarget;
            m_Master.m_TargetCret := m_TargetCret;
            m_Master.m_wCurrMagicId := m_wCurrMagicId;
            if Self is TCopyMon then
            begin
              if not IsMagic then
                sLabel := '@CloneStruck'
              else
                sLabel := '@CloneMagicStruck';
            end
            else if m_boGamePet then
            begin
              if not IsMagic then
                sLabel := '@GamePetStruck'
              else
                sLabel := '@GamePetMagicStruck';
            end
            else
            begin
              if not IsMagic then
                sLabel := '@SlaveStruck'
              else
                sLabel := '@SlaveMagicStruck';
            end;
            g_FunctionNPC.GotoLable(TPlayObject(m_Master), sLabel, False);
          finally
            m_Master.m_LastHiter := TempLastHiter;
            m_Master.m_CurrTarget := TempCurrTarget;
            m_Master.m_TargetCret := TempTargetCret;
            m_Master.m_wCurrMagicId := TempCurrMagicId;
          end;
        except
          MainOutMessage(sExceptionMsg2 + sLabel);
        end;
      end
      else if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_HEROOBJECT) and (Master <> nil) and
        (Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        Player := TPlayObject(Master);
        Player.m_nScriptGotoCount := 0;
        try
          // 修正在触发中写M. L. 无效
          TempLastHiter := Player.m_LastHiter;
          TempCurrTarget := Player.m_CurrTarget;
          TempTargetCret := Player.m_TargetCret;
          try
            Player.m_LastHiter := m_LastHiter;
            Player.m_CurrTarget := m_CurrTarget;
            Player.m_TargetCret := m_TargetCret;
            if not IsMagic then
              g_FunctionNPC.GotoLable(Player, '@HeroSlaveStruck', False)
            else
              g_FunctionNPC.GotoLable(Player, '@HeroSlaveMagicStruck', False);
          finally
            Player.m_LastHiter := TempLastHiter;
            Player.m_CurrTarget := TempCurrTarget;
            Player.m_TargetCret := TempTargetCret;
          end;
        except
          MainOutMessage(sExceptionMsg2);
        end;
      end;
    end;
    ErrCode := 6;
    AttackBaseObject := TBaseObject(ProcessMsg.nParam3);
    ErrCode := 7;
    if (AttackBaseObject <> nil) then
    begin
      AttackBaseObject.m_CurrTarget := Self;
      AttackBaseObject.m_wCurrMagicId := m_wCurrMagicId;
      // 在物理攻击中，穿插魔法攻击鼠标指向的另一个目标，当前物理攻击有几率将当前目标设置为另一个魔法目标 2020-10-22 11:35:34
      AttackBaseObject.SetTargetCreat(Self);
    end;
    ErrCode := 8;
    if (AttackBaseObject <> nil) and (g_FunctionNPC <> nil) then
    begin
      // 反弹伤害的不要触发 chongchong 2016-06-01
      if (NativeInt(ProcessMsg.BaseObject) <> RM_STRUCK) or (not IsFromFT) then
      begin
        if (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          AttackBaseObject.m_nLastPKPower := ProcessMsg.wParam + m_MagicShieldDecMP;
          ErrCode := 9;
          TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
          try
            if not AttackBaseObject.m_NoTriggerAttackStruckScript then
            begin
              if not IsMagic then
              begin
                g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@Attack', False);
                if BlastHitType <> bhtNone then
                begin
                  if BlastHitType = bhtBlastHit then
                    g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@BlastAttack', False)
                  else
                    g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@FatalAttack', False);
                end;
              end
              else
              begin
                g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@MagicAttack', False);
                if BlastHitType <> bhtNone then
                begin
                  if BlastHitType = bhtBlastHit then
                    g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@BlastMagicAttack', False)
                  else
                    g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@FatalMagicAttack', False);
                end;
              end;
              GiveHitterExp(AttackBaseObject, IsMagic, ProcessMsg.wParam);
            end
            else
              AttackBaseObject.m_NoTriggerAttackStruckScript := False;
          except
            MainOutMessage(sExceptionMsg2);
          end;

          try
            if AttackBaseObject.m_PEnvir.m_boHITMON and (AttackBaseObject.m_PEnvir.m_sHITMON <> '') then
            begin
              TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
              try
                g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), AttackBaseObject.m_PEnvir.m_sHITMON, False);
              except
                MainOutMessage(sExceptionMsg2);
              end;
            end;
          except
          end;
        end
        else if (AttackBaseObject.m_btRaceServer = RC_HEROOBJECT) and (AttackBaseObject.m_Master <> nil) and
          (AttackBaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          AttackBaseObject.m_nLastPKPower := ProcessMsg.wParam + m_MagicShieldDecMP;
          TPlayObject(AttackBaseObject.m_Master).m_nScriptGotoCount := 0;
          try
            if not IsMagic then
            begin
              g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroAttack', False);
              if BlastHitType <> bhtNone then
              begin
                if BlastHitType = bhtBlastHit then
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroBlastAttack', False)
                else
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroFatalAttack', False);
              end;
            end
            else
            begin
              g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroMagicAttack', False);
              if BlastHitType <> bhtNone then
              begin
                if BlastHitType = bhtBlastHit then
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroBlastMagicAttack', False)
                else
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@HeroFatalMagicAttack', False);
              end;
            end;
            GiveHitterExp(AttackBaseObject, IsMagic, ProcessMsg.wParam);
          except
            MainOutMessage(sExceptionMsg2);
          end;
        end
        else if (AttackBaseObject.m_Master <> nil) and (AttackBaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          // 修正在触发中写M. L. 无效
          TempLastHiter := AttackBaseObject.m_Master.m_LastHiter;
          TempCurrTarget := AttackBaseObject.m_Master.m_CurrTarget;
          TempTargetCret := AttackBaseObject.m_Master.m_TargetCret;
          try
            AttackBaseObject.m_Master.m_LastHiter := AttackBaseObject.m_LastHiter;
            AttackBaseObject.m_Master.m_CurrTarget := AttackBaseObject.m_CurrTarget;
            AttackBaseObject.m_Master.m_TargetCret := AttackBaseObject.m_TargetCret;
            TPlayObject(AttackBaseObject.m_Master).m_nScriptGotoCount := 0;
            try
              if AttackBaseObject is TCopyMon then
              begin
                if not IsMagic then
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@CloneAttack', False)
                else
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@CloneMagicAttack', False);
              end
              else if AttackBaseObject.m_boGamePet then
              begin
                if not IsMagic then
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@GamePetAttack', False)
                else
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@GamePetMagicAttack', False);
              end
              else
              begin
                if not IsMagic then
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@SlaveAttack', False)
                else
                  g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject.m_Master), '@SlaveMagicAttack', False);
              end;

              GiveHitterExp(AttackBaseObject, IsMagic, ProcessMsg.wParam);
            except
              MainOutMessage(sExceptionMsg2);
            end;
          finally
            AttackBaseObject.m_Master.m_LastHiter := TempLastHiter;
            AttackBaseObject.m_Master.m_CurrTarget := TempCurrTarget;
            AttackBaseObject.m_Master.m_TargetCret := TempTargetCret;
          end;
        end
        else if (AttackBaseObject.m_Master <> nil) and (AttackBaseObject.m_Master.m_btRaceServer = RC_HEROOBJECT) and
          (AttackBaseObject.Master <> nil) and (AttackBaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          Player := TPlayObject(AttackBaseObject.Master);
          // 修正在触发中写M. L. 无效
          TempLastHiter := Player.m_LastHiter;
          TempCurrTarget := Player.m_CurrTarget;
          TempTargetCret := Player.m_TargetCret;
          try
            Player.m_LastHiter := AttackBaseObject.m_LastHiter;
            Player.m_CurrTarget := AttackBaseObject.m_CurrTarget;
            Player.m_TargetCret := AttackBaseObject.m_TargetCret;
            Player.m_nScriptGotoCount := 0;
            try
              if not IsMagic then
                g_FunctionNPC.GotoLable(Player, '@HeroSlaveAttack', False)
              else
                g_FunctionNPC.GotoLable(Player, '@HeroSlaveMagicAttack', False);
            except
              MainOutMessage(sExceptionMsg2);
            end;
          finally
            Player.m_LastHiter := TempLastHiter;
            Player.m_CurrTarget := TempCurrTarget;
            Player.m_TargetCret := TempTargetCret;
          end;
        end
      end;
    end;

    // 假人说话
    ErrCode := 10;
    if (AttackBaseObject <> nil) and (not AttackBaseObject.m_boDeath) and (not AttackBaseObject.m_boGhost) and
      (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) and AttackBaseObject.m_boDummyObject and
      (Random(TPlayObject(AttackBaseObject).m_nSayRate) = 0) then
    begin
      sAsk := AttackBaseObject.Ask;
      if sAsk <> '' then
        AttackBaseObject.SendRefMsg(RM_HEAR, 0, TPlayObject(AttackBaseObject).GetHearMsgFColor, g_Config.btHearMsgBColor, 0,
          AttackBaseObject.m_sCharName + ':' + sAsk);
    end;
    ErrCode := 11;
    if (m_btRaceServer = RC_PLAYOBJECT) and m_boDummyObject and (Random(TPlayObject(Self).m_nSayRate) = 0) then
    begin
      sAsk := Ask;
      if sAsk <> '' then
        SendRefMsg(RM_HEAR, 0, TPlayObject(Self).GetHearMsgFColor, g_Config.btHearMsgBColor, 0, m_sCharName + ':' + sAsk);
    end;
    ErrCode := 12;
    if (AttackBaseObject <> nil) and (g_PluginManager <> nil) then
    begin
      g_PluginManager.HookBaseObjectStruck(Self, AttackBaseObject);
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg, [ErrCode]));
      MainOutMessage(E.Message);
    end;
  end;
end;

