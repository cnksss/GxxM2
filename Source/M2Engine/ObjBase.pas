function TBaseObject.sub_4C5370(nX, nY: Integer; nRange: Integer; var nDX, nDY: Integer): Boolean; // 004C5370
var
  I: Integer;
  II: Integer;
  III: Integer;
begin
  Result := False;
  if m_PEnvir.GetMovingObject(nX, nY, True) = nil then
  begin
    Result := True;
    nDX := nX;
    nDY := nY;
  end;
  if not Result then
  begin
    for I := 1 to nRange do
    begin
      for II := -I to I do
      begin
        for III := -I to I do
        begin
          nDX := nX + III;
          nDY := nY + II;
          if m_PEnvir.GetMovingObject(nDX, nDY, True) = nil then
          begin
            Result := True;
            Break;
          end;
        end;
        if Result then
          Break;
      end;
      if Result then
        Break;
    end;
  end;
  if not Result then
  begin
    nDX := nX;
    nDY := nY;
  end;
end;

