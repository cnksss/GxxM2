      nValue := Integer(m_nHitSpeed) + m_wStatusArrValue[3];
      if nValue > High(m_nHitSpeed) then
        m_nHitSpeed := High(m_nHitSpeed)
      else if nValue < Low(m_nHitSpeed) then
        m_nHitSpeed := Low(m_nHitSpeed)
      else
        m_nHitSpeed := nValue;
    end;

    if m_wStatusArrValue[4] > 0 then
