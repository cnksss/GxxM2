procedure TBaseObject.ReAlive(IsDelay: Boolean);
var
  DelayTime: Cardinal;
begin
  m_boDeath := False;
  m_Abil.HP := m_Abil.MaxHP;
  m_WAbil.HP := m_Abil.MaxHP;
  RecalcAbilitys;
  SearchViewRange;
  if IsDelay then
    DelayTime := 500
  else
    DelayTime := 0;
  SendRefMsg(RM_ALIVE, m_btDirection, m_nCurrX, m_nCurrY, 0, '', DelayTime);
  if g_Config.boViewFog and (m_nLight > 0) then
    SendRefMsg(RM_CHANGELIGHT, 0, 0, 0, 0, '');
  if (g_FunctionNPC <> nil) and (g_Config.boRevivalTouch) then
  begin
    if (m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(Self).m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(TPlayObject(Self), '@Revival', False);
    end
    else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(m_Master).m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@H.Revival', False);
    end;
  end;
end;

