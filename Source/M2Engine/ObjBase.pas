function TBaseObject.QuestCheckItemEx(sItemName: string; var nCount, nParam: Integer; var nDura: Integer; FullNameCheck: Boolean;
  CheckChangedName: Boolean): pTUserItem;
var
  I: Integer;
  UserItem: pTUserItem;
  s1C: string;
  StdItem: pTStdItem;
  boRet: Boolean;
  boFoundHeroM2Shop: Boolean;
  Player: TPlayObject;
  J: Integer;
  HeroM2ShopItemInfo: pTHeroM2ShopItemInfo;
begin
  Result := nil;
  nParam := 0;
  nDura := 0;
  nCount := 0;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if UserItem = nil then
      Continue;
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem = nil then
      Continue;
    s1C := StdItem.Name;
    if CheckChangedName then
    begin
      if (UserItem.wIndex > 0) and (UserItem.btValue[13] = 1) and (Length(UserItem.Name) > 0) then
        s1C := UserItem.Name;
    end;
    // 检测物品的时候不要算摆摊中的物品 chongchong 2015-05-27
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      Player := TPlayObject(Self);
      boFoundHeroM2Shop := False;
      for J := 0 to Player.m_HeroM2ShopList.Count - 1 do
      begin
        HeroM2ShopItemInfo := Player.m_HeroM2ShopList.Items[J];
        if HeroM2ShopItemInfo.nMakeIndex = UserItem.MakeIndex then
        begin
          boFoundHeroM2Shop := True;
          Break;
        end;
      end;
      if boFoundHeroM2Shop then
        Continue;
    end;
    if FullNameCheck then
      boRet := SameText(s1C, sItemName)
    else
      boRet := Pos(sItemName, s1C) > 0;
    if boRet then
    begin
      if CheckOverLapItem(StdItem) then
      begin // 叠加物品
        nCount := nCount + UserItem.Dura + 1;
      end
      else
      begin
        Inc(nCount);
      end;
      if UserItem.Dura > nDura then
      begin
        nDura := UserItem.Dura;
        Result := UserItem;
      end;
      Inc(nParam, UserItem.Dura);
      if Result = nil then
        Result := UserItem;
    end;
  end;
end;

function TBaseObject.QuestCheckItem(sItemName: string; var nCount, nParam: Integer; var nDura: Integer): pTUserItem;
var
  I: Integer;
  UserItem: pTUserItem;
  s1C: string;
  StdItem: pTStdItem;
begin
  Result := nil;
  nParam := 0;
  nDura := 0;
  nCount := 0;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if UserItem = nil then
      Continue;
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem = nil then
      Continue;
    s1C := StdItem.Name;
    if CompareText(s1C, sItemName) = 0 then
    begin
      if UserItem.Dura > nDura then
      begin
        nDura := UserItem.Dura;
        Result := UserItem;
      end;
      Inc(nParam, UserItem.Dura);
      if Result = nil then
        Result := UserItem;
      Inc(nCount);
    end;
  end;
end;

function TBaseObject.CanCloseDefense(): Boolean; // 忽视目标防御
begin
  if g_Config.boCloseDefenseUseScale then
  begin
    Result := m_WAbil.NewValue[4] >= 100; // 忽视100%的防御才算忽视，只忽视一部分还是要算的
  end
  else
  begin
    Result := False;
    if (m_WAbil.NewValue[4] > 0) then
    begin
      Result := Random(100) <= m_WAbil.NewValue[4];
    end;
  end;
end;

{
  function TBaseObject.DamageRebound(): Boolean; // 反弹伤害
  begin
  if g_Config.boReboundUseScale then
  begin
  Result := m_WAbil.NewValue[5] > 0;
  end
  else
  begin
  Result := False;
  if (m_WAbil.NewValue[5] > 0) then
  begin
  Result := Random(100) <= m_WAbil.NewValue[5];
  end;
  end;
  end;
}
function TBaseObject.DamageReboundPower(nPower: Integer): Integer; // 反弹伤害值
var
  IsRebound: Boolean;
begin
  Result := 0;
  if nPower <= 0 then
    Exit;
  IsRebound := False;
  if g_Config.boReboundUseScale then
    IsRebound := m_WAbil.NewValue[5] > 0
  else if (m_WAbil.NewValue[5] > 0) then
    IsRebound := Random(100) <= m_WAbil.NewValue[5];
  if IsRebound then
  begin
    if g_Config.boReboundUseScale then
      Result := Min(LongWord(Round(nPower / 100 * m_WAbil.NewValue[5])), High(Integer))
    else
      Result := Min(LongWord(Round(nPower / 100 * g_Config.dwDamageReboundRate)), High(Integer));
    if Result < 0 then
      Result := 0;
  end;
end;

function TBaseObject.BlastHit(nPower: Integer; TargeTBaseObject: TBaseObject; var BlastHitType: TBlastHitType;
  nDelayTime: Integer): Integer; // 暴击
var
  AddPower, DecPower: Integer;
  BlastHitRate, PowerRate: Integer;
begin
  BlastHitType := bhtNone;
  Result := nPower;
  if (m_WAbil.NewValue[0] > 0) and (nPower > 0) and (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
  begin
    BlastHitRate := m_WAbil.NewValue[0];
    if TargeTBaseObject <> nil then
      BlastHitRate := BlastHitRate - TargeTBaseObject.m_WAbil.NewValue[24]; // 暴击抗性
    if (BlastHitRate > 0) and (Random(100) <= BlastHitRate) then
    begin
      Result := Min(LongWord(Round(nPower + nPower / 100 * g_Config.dwCritAttackHurtRate)), High(Integer));
      if TSmartObject(Self).m_boBlastHitRate then
      begin
        Result := Min(LongWord(Round(Result / 100 * TSmartObject(Self).m_nBlastHitRateValue)), High(Integer));
      end;
      BlastHitType := bhtBlastHit;
      if TargeTBaseObject <> nil then
      begin
        TargeTBaseObject.SendRefMsg(RM_SENDBLASTHIT, TargeTBaseObject.m_btDirection, TargeTBaseObject.m_nCurrX,
          TargeTBaseObject.m_nCurrY, Result, '', nDelayTime);
      end;
    end;
  end;
  nPower := Result;
  // 致命一击几率 [21],  致命一击伤害 [22]
  if (m_WAbil.NewValue[21] > 0) and (nPower > 0) { and (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) } then
  // 致命一击对所有目标生效 2020-09-05 15:52:12
  begin
    if Random(100) <= m_WAbil.NewValue[21] then
    begin
      AddPower := Min(LongWord(Round(Result / 100 * (g_Config.dwFatalBlowBasePower + m_WAbil.NewValue[22] - 100))),
        High(Integer));
      DecPower := 0;
      // 致命一击防御
      if (TargeTBaseObject <> nil) and (TargeTBaseObject.m_WAbil.NewValue[23] > 0) then
      begin
        if TargeTBaseObject.m_WAbil.NewValue[23] >= 100 then
          DecPower := AddPower
        else
          DecPower := Round(AddPower / 100 * TargeTBaseObject.m_WAbil.NewValue[23])
      end;
      Result := Min(LongWord(Result + AddPower - DecPower), High(Integer));
      PowerRate := Round(Result / nPower * 100);
      if PowerRate < g_Config.dwFatalBlowNeedPower1 then
        BlastHitType := bhtFatalBlow1
      else if PowerRate < g_Config.dwFatalBlowNeedPower2 then
        BlastHitType := bhtFatalBlow2
      else if PowerRate < g_Config.dwFatalBlowNeedPower3 then
        BlastHitType := bhtFatalBlow3
      else
        BlastHitType := bhtFatalBlow4;
    end;
  end;
end;

function TBaseObject.NewAbilPower(btType: Byte; nPower: Integer): Integer;
var
  Int64Value: Int64;
begin
  // 修复当伤害超过一次的值时，计算错误 chongchong 2014-04-11
  Result := nPower;
  if (btType in [1 .. 3]) and (nPower > 0) and (m_WAbil.NewValue[btType] > 0) then
  begin
    // 1增加攻击伤害
    if btType = 1 then
    begin
      Int64Value := nPower + Round(nPower / 100 * m_WAbil.NewValue[btType]);
      Result := Min(Int64Value, High(Integer))
    end
    else
      Result := Max(nPower - Round(nPower / 100 * m_WAbil.NewValue[btType]), 0);
    // 2伤害吸收 3魔法防御
  end;
end;

function TBaseObject.GetPowerRateAdd(TargeTBaseObject: TBaseObject; nPower: Integer): Integer;
var
  IsTargetHuman: Boolean;
  _Master: TBaseObject;
  I64: Int64;
begin
  I64 := nPower;
  if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
  begin
    IsTargetHuman := TargeTBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
    if not IsTargetHuman then
    begin
      _Master := TargeTBaseObject.Master;
      if (_Master <> nil) then
      begin
        IsTargetHuman := _Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
      end;
    end;
    if IsTargetHuman then
    begin
      if TSmartObject(Self).m_nAttackHumPowerRate > 0 then
      begin
        I64 := Round(I64 * (TSmartObject(Self).m_nAttackHumPowerRate / 100));
      end;
      // 分身攻击人物倍数 2020-09-26
      if (m_btRaceServer = RC_PLAYMOSTER) and (m_Master <> nil) then
        I64 := Round(I64 / 100 * m_nSlaveAttackHumPowerRate);
    end
    else
    begin
      if TSmartObject(Self).m_nAttackMonPowerRate > 0 then
      begin
        I64 := Round(I64 * (TSmartObject(Self).m_nAttackMonPowerRate / 100));
      end;
    end;
    // 只搞人物攻击英雄威力 2020-03-24 18:39:07
    if (m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER]) and (TargeTBaseObject.m_btRaceServer = RC_HEROOBJECT) then
    begin
      I64 := Round(I64 / 100 * g_Config.nHumanAttackHeroPowerRate);
    end;
  end
  else if (m_Master <> nil) then // 宝宝攻击人物的威力 chongchong 2015-12-05
  begin
    IsTargetHuman := TargeTBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
    if not IsTargetHuman then
    begin
      _Master := TargeTBaseObject.Master;
      if (_Master <> nil) then
      begin
        IsTargetHuman := _Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT { , RC_PLAYMOSTER } ];
      end;
    end;
    if IsTargetHuman then
      I64 := Round(I64 / 100 * m_nSlaveAttackHumPowerRate);
  end
  else if (TargeTBaseObject.m_btRaceServer = RC_HEROOBJECT) then
  begin
    // 怪物攻击英雄威力 chongchong 2017-03-30
    I64 := Round(I64 / 100 * g_Config.nMonAttackHeroPowerRate);
  end;
  Result := Min(I64, High(Integer));
end;

