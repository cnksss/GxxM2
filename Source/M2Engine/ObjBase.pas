function TBaseObject.GetAttackDir(BaseObject: TBaseObject; var btDir: Byte): Boolean;
begin
  Result := False;
  if (m_nCurrX - 1 <= BaseObject.m_nCurrX) and (m_nCurrX + 1 >= BaseObject.m_nCurrX) and (m_nCurrY - 1 <= BaseObject.m_nCurrY) and
    (m_nCurrY + 1 >= BaseObject.m_nCurrY) and ((m_nCurrX <> BaseObject.m_nCurrX) or (m_nCurrY <> BaseObject.m_nCurrY)) then
  begin
    Result := True;
    if ((m_nCurrX - 1) = BaseObject.m_nCurrX) and (m_nCurrY = BaseObject.m_nCurrY) then
    begin
      btDir := DR_LEFT;
      Exit;
    end;
    if ((m_nCurrX + 1) = BaseObject.m_nCurrX) and (m_nCurrY = BaseObject.m_nCurrY) then
    begin
      btDir := DR_RIGHT;
      Exit;
    end;
    if (m_nCurrX = BaseObject.m_nCurrX) and ((m_nCurrY - 1) = BaseObject.m_nCurrY) then
    begin
      btDir := DR_UP;
      Exit;
    end;
    if (m_nCurrX = BaseObject.m_nCurrX) and ((m_nCurrY + 1) = BaseObject.m_nCurrY) then
    begin
      btDir := DR_DOWN;
      Exit;
    end;
    if ((m_nCurrX - 1) = BaseObject.m_nCurrX) and ((m_nCurrY - 1) = BaseObject.m_nCurrY) then
    begin
      btDir := DR_UPLEFT;
      Exit;
    end;
    if ((m_nCurrX + 1) = BaseObject.m_nCurrX) and ((m_nCurrY - 1) = BaseObject.m_nCurrY) then
    begin
      btDir := DR_UPRIGHT;
      Exit;
    end;
    if ((m_nCurrX - 1) = BaseObject.m_nCurrX) and ((m_nCurrY + 1) = BaseObject.m_nCurrY) then
    begin
      btDir := DR_DOWNLEFT;
      Exit;
    end;
    if ((m_nCurrX + 1) = BaseObject.m_nCurrX) and ((m_nCurrY + 1) = BaseObject.m_nCurrY) then
    begin
      btDir := DR_DOWNRIGHT;
      Exit;
    end;
    btDir := 0;
  end;
end;

function TBaseObject.TargetInSpitRange(BaseObject: TBaseObject; var btDir: Byte): Boolean; // 004C3E68
var
  n14, n18: Integer;
begin
  Result := False;
  if (Abs(BaseObject.m_nCurrX - m_nCurrX) <= 2) and (Abs(BaseObject.m_nCurrY - m_nCurrY) <= 2) then
  begin
    n14 := BaseObject.m_nCurrX - m_nCurrX;
    n18 := BaseObject.m_nCurrY - m_nCurrY;
    if (Abs(n14) <= 1) and (Abs(n18) <= 1) then
    begin
      GetAttackDir(BaseObject, btDir);
      Result := True;
      Exit;
    end;
    Inc(n14, 2);
    Inc(n18, 2);
    if ((n14 >= 0) and (n14 <= 4)) and ((n18 >= 0) and (n18 <= 4)) then
    begin
      btDir := GetNextDirection(m_nCurrX, m_nCurrY, BaseObject.m_nCurrX, BaseObject.m_nCurrY);
      if g_Config.SpitMap[btDir, n18, n14] = 1 then
        Result := True;
    end;
  end;
end;

function TBaseObject.RecalcBagWeightOld: Integer;
var
  I: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  nCode: Byte;
begin
  Result := 0;
  nCode := 0;
  try
    if m_boDeath or m_boGhost then
      Exit; // 20090102
    if m_ItemList <> nil then
    begin // 20090103
      if m_ItemList.Count > 0 then
      begin // 20080628
        nCode := 1;
        for I := 0 to m_ItemList.Count - 1 do
        begin
          nCode := 2;
          UserItem := m_ItemList.Items[I];
          nCode := 3;
          if UserItem <> nil then
          begin
            nCode := 4;
            StdItem := UserEngine.GetStdItem(UserItem.wIndex);
            if StdItem <> nil then
            begin
              nCode := 5;
              Inc(Result, StdItem.Weight);
            end;
          end;
        end;
      end;
    end;
  except
    MainOutMessage('{??} TBaseObject.RecalcBagWeight Code:' + IntToStr(nCode));
  end;
end;

function TBaseObject.RecalcBagWeight: Integer;
var
  I: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
begin
  Result := 0;
  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem <> nil then
    begin
      Result := Min(High(Word), Result + OverLapItemWeight(StdItem, UserItem.Dura));
    end;
  end;
end;

procedure TSmartObject.RecalcHitSpeed;
var
  I: Integer;
  UserMagic: pTUserMagic;
  BonusTick: pTNakedAbility;
begin
  BonusTick := nil;
  case m_btJob of
    0:
      BonusTick := @g_Config.BonusAbilofWarr;
    1:
      BonusTick := @g_Config.BonusAbilofWizard;
    2:
      BonusTick := @g_Config.BonusAbilofTaos;
  end;
  if (m_btRaceServer = RC_PLAYOBJECT) then
  begin
    m_btHitPoint := DEFHIT + TPlayObject(Self).m_BonusAbil.Hit div BonusTick.Hit;
    case m_btJob of
      JOB_TAOS:
        m_btSpeedPoint := DEFSPEED + TPlayObject(Self).m_BonusAbil.Speed div BonusTick.Speed + 3;
    else
      m_btSpeedPoint := DEFSPEED + TPlayObject(Self).m_BonusAbil.Speed div BonusTick.Speed;
    end;
  end
  else
  begin
    m_btHitPoint := DEFHIT;
    case m_btJob of
      JOB_TAOS:
        m_btSpeedPoint := DEFSPEED + 3;
    else
      m_btSpeedPoint := DEFSPEED;
    end;
  end;
  if g_Config.btMaxHitPoint = 1 then
  begin
    m_btHitPoint := Min(High(Word), m_btHitPoint); // 准确
    m_btSpeedPoint := Min(High(Word), m_btSpeedPoint); // 敏捷
  end
  else
  begin
    m_btHitPoint := Min(High(Byte), m_btHitPoint); // 准确
    m_btSpeedPoint := Min(High(Byte), m_btSpeedPoint); // 敏捷
  end;
  m_nHitPlus := 0;
  FillChar(m_UserMagics, SizeOf(m_UserMagics), 0);
  FillChar(m_UserDefenseMagics, SizeOf(m_UserDefenseMagics), 0); // 内功技能增加防御
  FillChar(m_UserAttackMagics, SizeOf(m_UserAttackMagics), 0); // 内功技能增加攻击
  m_MagicOneSwordSkill := nil;
  m_MagicPowerHitSkill := nil;
  m_MagicErgumSkill := nil;
  m_MagicBanwolSkill := nil;
  m_MagicFireSwordSkill := nil;
  m_MagicCrsSkill := nil;
  m_Magic66Skill := nil;
  m_Magic42Skill := nil;
  m_Magic43Skill := nil;
  m_MagicSwordSkill := nil;
  m_MagicSuperShiledSkill := nil; // 护体神盾
  m_Magic113Skill := nil;
  m_Magic115Skill := nil;
  FillChar(m_CustomSkill, SizeOf(m_CustomSkill), 0);
  m_nContinuousMagicCount := 0; // 连击魔法数
  for I := 0 to m_MagicList.Count - 1 do
  begin
    UserMagic := m_MagicList.Items[I];
    if UserMagic = nil then
      Continue;
    // 自定义技能 chongchong 2015-03-19
    // if (UserMagic.wMagIdx > 300) then Continue;
    if ((UserMagic.wMagIdx > 300) and (UserMagic.wMagIdx < CUSTOM_MAGIC_START_ID)) or
      (UserMagic.wMagIdx >= CUSTOM_MAGIC_START_ID + CUSTOM_MAGIC_COUNT) then
      Continue;
    if UserMagic.MagicAttr = mtDefense then
    begin
      m_UserDefenseMagics[UserMagic.wMagIdx] := UserMagic; // 内功技能增加防御
      Continue;
    end
    else if UserMagic.MagicAttr = mtAttack then
    begin
      m_UserAttackMagics[UserMagic.wMagIdx] := UserMagic; // 内功技能增加攻击
      Continue;
    end
    else
    begin
      if UserMagic.wMagIdx <= 300 then
        m_UserMagics[UserMagic.wMagIdx] := UserMagic;
    end;
    case UserMagic.wMagIdx of
      3:
        begin // 基本剑法
          m_MagicOneSwordSkill := UserMagic;
          if UserMagic.btLevel > 0 then
          begin
            m_btHitPoint := m_btHitPoint + Round(9 / 3 * UserMagic.btLevel);
            if g_Config.btMaxHitPoint = 1 then
            begin
              m_btHitPoint := Min(GetNewLevelPower(m_btHitPoint, UserMagic), High(Word)); // 强化技能
            end
            else
            begin
              m_btHitPoint := Min(GetNewLevelPower(m_btHitPoint, UserMagic), High(Byte)); // 强化技能
            end;
          end;
        end;
      7:
        begin // 攻杀剑法
          m_MagicPowerHitSkill := UserMagic;
          if UserMagic.btLevel > 0 then
          begin
            m_btHitPoint := m_btHitPoint + Round(3 / 3 * UserMagic.btLevel);
          end;
          if g_Config.btMaxHitPoint = 1 then
          begin
            m_btHitPoint := Min(High(Word), m_btHitPoint); // 准确
          end
          else
          begin
            m_btHitPoint := Min(High(Byte), m_btHitPoint); // 准确
          end;
          m_nHitPlus := DEFHIT + UserMagic.btLevel;
          m_btAttackSkillCount := 7 - UserMagic.btLevel;
          m_btAttackSkillPointCount := Random(m_btAttackSkillCount);
        end;
      12:
        begin // 刺杀剑法
          m_MagicErgumSkill := UserMagic;
        end;
      25:
        begin // 半月弯刀
          m_MagicBanwolSkill := UserMagic;
        end;
      26:
        begin // 烈火剑法
          m_MagicFireSwordSkill := UserMagic;
          // m_nHitDouble := 4 + UserMagic.btLevel * 4;
        end;
      4:
        begin // 精神力战法
          m_MagicOneSwordSkill := UserMagic;
          if UserMagic.btLevel > 0 then
          begin
            m_btHitPoint := m_btHitPoint + Round(8 / 3 * UserMagic.btLevel);
            if g_Config.btMaxHitPoint = 1 then
            begin
              m_btHitPoint := Min(GetNewLevelPower(m_btHitPoint, UserMagic), High(Word)); // 强化技能
            end
            else
            begin
              m_btHitPoint := Min(GetNewLevelPower(m_btHitPoint, UserMagic), High(Byte)); // 强化技能
            end;
          end;
        end;
      40:
        begin
          m_MagicCrsSkill := UserMagic;
        end;
      42:
        begin
          m_Magic42Skill := UserMagic;
        end;
      43:
        begin
          m_Magic43Skill := UserMagic;
        end;
      56:
        begin
          m_MagicSwordSkill := UserMagic;
        end;
      66:
        begin
          m_Magic66Skill := UserMagic;
        end;
      67:
        begin // 先天元力
          { if UserMagic.btLevel > 0 then begin
            m_btHitPoint := m_btHitPoint + Round(8 / 3 * UserMagic.btLevel);
            end; }
        end;
      75:
        begin
          m_MagicSuperShiledSkill := UserMagic; // 护体神盾
        end;
      100 .. 111:
        begin
          Inc(m_nContinuousMagicCount);
        end;
      113:
        begin
          m_Magic113Skill := UserMagic;
        end;
      115:
        begin
          m_Magic115Skill := UserMagic;
        end;
    else
      // 自定义技能 chongchong 2015-03-19
      begin
        if CheckIsCustomMagic(UserMagic.wMagIdx) then
        begin
          m_CustomSkill[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID] := UserMagic;
        end;
      end;
    end;
  end;
end;

procedure TSmartObject.AddItemSkill(nIndex: Integer; IsMagicID: Boolean; Level: Integer; IsNewLevel: Boolean);
var
  Magic: pTMagic;
  UserMagic: pTUserMagic;
begin
  Magic := nil;
  if not IsMagicID then
  begin
    case nIndex of
      1:
        Magic := UserEngine.FindMagic(g_Config.sFireBallSkill);
      2:
        Magic := UserEngine.FindMagic(g_Config.sHealSkill);
      // 流星戒指 + 流星火雨技能 -- piaoyun 2013-06-28
      3:
        Magic := UserEngine.FindMagic(g_Config.sStarSkill);
      4:
        Magic := UserEngine.FindMagic(g_Config.sSkill41Skill);
    end;
  end
  else
  begin
    Magic := UserEngine.FindMagic(nIndex);
  end;
  if Magic <> nil then
  begin
    if not IsTrainingSkill(Magic.wMagicID, Magic.MagicAttr) then
    begin
      New(UserMagic);
      UserMagic.MagicInfo := Magic;
      UserMagic.MagicAttr := Magic.MagicAttr;
      UserMagic.wMagIdx := Magic.wMagicID;
      UserMagic.btKey := 0;
      if not IsNewLevel then
      begin
        UserMagic.btLevel := Min(Level, 255);
        UserMagic.btNewLevel := 0;
      end
      else
      begin
        UserMagic.btLevel := 1;
        UserMagic.btNewLevel := Min(Level, 255);
      end;
      UserMagic.nTranPoint := 0;
      UserMagic.boUsesItemAdd := True;
      m_MagicList.Add(UserMagic);
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        TPlayObject(Self).SendAddMagic(UserMagic);
      end;
    end;
  end;
end;

function TBaseObject.AddToMap: Boolean;
begin
  Result := m_PEnvir.AddToMap(m_nCurrX, m_nCurrY, Self) = Self;
  if Result and (not m_boFixedHideMode) then
    SendRefMsg(RM_TURN, m_btDirection, m_nCurrX, m_nCurrY, 1, '');
end;

procedure TBaseObject.AttackDir(TargeTBaseObject: TBaseObject; wHitMode: Word; nDir: Integer; AttackRate: Single;
  IsSendRMHit: Boolean; NpcReleaseagic: pTUserMagic; IsReleaseMagicEx: Boolean);
var
  AttackTarget: TBaseObject;
  wIdent: Word;
  nCheckCode: Integer;
resourcestring
  sExceptionMsg = '[Exception] TBaseObject.AttackDir Code: %d';
begin
  nCheckCode := 0;
  try
    nCheckCode := 4;
    m_btDirection := nDir;
    if TargeTBaseObject = nil then
    begin
      nCheckCode := 41;
      AttackTarget := GetPoseCreate();
    end
    else
      AttackTarget := TargeTBaseObject;
    if _Attack(wHitMode, AttackTarget, AttackRate) then
    begin
      nCheckCode := 6;
      SetTargetCreat(AttackTarget);
      nCheckCode := 7;
    end;
    if IsSendRMHit then
    begin
      wIdent := RM_HIT;
      nCheckCode := 8;
      SendAttackMsg(wIdent, m_btDirection, m_nCurrX, m_nCurrY, 0);
      nCheckCode := 9;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(Format(sExceptionMsg, [nCheckCode]));
      MainOutMessage(E.Message);
    end;
  end;
end;

{
  var
  LastAttackTick: LongWord = 0;
}
procedure TSmartObject.AttackDir(TargeTBaseObject: TBaseObject; wHitMode: Word; nDir: Integer; AttackRate: Single;
  IsSendRMHit: Boolean; NpcReleaseagic: pTUserMagic; IsReleaseMagicEx: Boolean);
  function GetMagicSpell(UserMagic: pTUserMagic): Integer;
  begin
    if (UserMagic.MagicInfo <> nil) then
      Result := Round(UserMagic.MagicInfo.wSpell / (UserMagic.MagicInfo.btTrainLv + 1) * (UserMagic.btLevel + 1))
    else
      Result := 0;
  end;
// 武器升级设置
  function CheckWeaponUpgradeStatus(UserItem: pTUserItem): Boolean; // 004C27C0
  begin
    Result := False;
    // if (UserItem.btValue[0] + UserItem.btValue[1] + UserItem.btValue[2]) < 20 then begin
    if (UserItem.btValue[0] + UserItem.btValue[1] + UserItem.btValue[2]) < g_Config.nUpgradeWeaponMaxPoint then
    begin
      Result := True;
      case UserItem.btValue[10] of
        1:
          if not g_Config.boWeaponUpgradeFailNotDelete then
            UserItem.wIndex := 0
          else
            Result := False;
        10 .. 13:
          UserItem.btValue[0] := UserItem.btValue[0] + UserItem.btValue[10] - 9;
        20 .. 23:
          UserItem.btValue[1] := UserItem.btValue[1] + UserItem.btValue[10] - 19;
        30 .. 33:
          UserItem.btValue[2] := UserItem.btValue[2] + UserItem.btValue[10] - 29;
      end;
    end
    else
    begin
      if not g_Config.boWeaponUpgradeFailNotDelete then
        UserItem.wIndex := 0
      else
        Result := False;
    end;
    UserItem.btValue[10] := 0;
  end;
  procedure CheckWeaponUpgrade();
  var
    UseItems: TUserItem;
    PlayObject: TPlayObject;
    StdItem: pTStdItem;
    boWeaponUpgradeStatus: Boolean;
  begin
    if m_UseItems[U_WEAPON].btValue[10] > 0 then
    begin
      UseItems := m_UseItems[U_WEAPON];
      boWeaponUpgradeStatus := CheckWeaponUpgradeStatus(@m_UseItems[U_WEAPON]);
      if m_UseItems[U_WEAPON].wIndex = 0 then
      begin
        SysMsg(g_sTheWeaponBroke, c_Red, t_Hint);
        PlayObject := TPlayObject(Self);
        PlayObject.SendDelItem(@UseItems);
        // PlayObject.StatusChanged;
        SendRefMsg(RM_BREAKWEAPON, 0, 0, 0, 0, '');
        StdItem := UserEngine.GetStdItem(UseItems.wIndex);
        if StdItem <> nil then
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, UseItems.MakeIndex, '0', 0, 0, '武器破碎');
          end;
        end;
        FeatureChanged();
      end
      else
      begin
        if boWeaponUpgradeStatus then
          SysMsg(sTheWeaponRefineSuccessfull, c_Green, t_Hint)
        else
          SysMsg(sTheWeaponRefinefailfull, c_Red, t_Hint);
        PlayObject := TPlayObject(Self);
        PlayObject.SendUpdateItem(@m_UseItems[U_WEAPON]);
        StdItem := UserEngine.GetStdItem(UseItems.wIndex);
        if StdItem <> nil then
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            // 注释日志 chongchong 2017-10-09
            // 升级成功
          end;
        end;
        RecalcAbilitys();
        SendMsg(Self, RM_ABILITY, 0, 0, 0, 0, '');
        SendMsg(Self, RM_SUBABILITY, 0, 0, 0, 0, '');
      end;
    end;
  end;

var
  AttackTarget: TBaseObject;
  boPowerHit: Boolean;
  boFireHit: Boolean;
  boCrsHit: Boolean;
  boSWordHit: Boolean;
  bo66: Boolean;
  bo42: Boolean;
  bo43: Boolean;
  bo113, bo115: Boolean;
  wIdent: Word;
  wSMIdent: Word;
  nCheckCode: Integer;
  nNewLevel: Integer;
  nSpellPoint: Integer;
  nX, nY: Integer;
  TempMagic: pTUserMagic;
  CustomMagicConfig: TCustomMagicConfig;
resourcestring
  sExceptionMsg = '[Exception] TSmartObject.AttackDir Code: %d';
begin
  {
    if m_btRaceServer = RC_HEROOBJECT then
    begin
    MainOutMessage(IntToStr(MyGetTickCount - LastAttackTick));
    LastAttackTick := MyGetTickCount;
    end;
  }
  nCheckCode := 0;
  nNewLevel := 0;
  try
    if (wHitMode = 5) and (m_MagicBanwolSkill <> nil) then
    begin // 半月
      if (m_WAbil.MP > 0) and (m_MagicBanwolSkill.MagicInfo <> nil) then
      begin
        nCheckCode := 1;
        DamageSpell(m_MagicBanwolSkill.MagicInfo.wDefSpell + GetMagicSpell(m_MagicBanwolSkill));
        nCheckCode := 2;
        HealthSpellChanged();
        nCheckCode := 3;
      end
      else
        wHitMode := RM_HIT;
    end;
    // 双龙斩使用时减MP chongchong 2014-09-17
    if (wHitMode = 8) and (m_MagicCrsSkill <> nil) then
    begin
      if (m_WAbil.MP > 0) and (m_MagicCrsSkill.MagicInfo <> nil) then
      begin
        nSpellPoint := m_MagicCrsSkill.MagicInfo.wDefSpell + GetMagicSpell(m_MagicCrsSkill);
        // nSpellPoint := GetSpellPoint(m_MagicCrsSkill);
        if m_WAbil.MP >= nSpellPoint then
        begin
          DamageSpell(nSpellPoint);
          HealthSpellChanged();
          // 减完MP发现MP不够下次使用时，关双龙斩
          if m_WAbil.MP < nSpellPoint then
          begin
            SkillCrsOnOff(False);
            if m_btRaceServer = RC_PLAYOBJECT then
            begin
              // TPlayObject(Self).SendSocket(nil, '+UCRS');
              TPlayObject(Self).SendOpenMagic(SKILL_40, False, 0);
            end;
          end;
        end
        else
        begin
          SkillCrsOnOff(False);
          if m_btRaceServer = RC_PLAYOBJECT then
          begin
            // TPlayObject(Self).SendSocket(nil, '+UCRS');
            TPlayObject(Self).SendOpenMagic(SKILL_40, False, 0);
          end;
          wHitMode := RM_HIT;
        end;
      end
      else
        wHitMode := RM_HIT;
    end
    else if (wHitMode >= CM_CUSTOM_HIT001) and (wHitMode < CM_CUSTOM_HIT001 + CUSTOM_MAGIC_COUNT)
    { and (AttackTarget <> nil) 近距离攻击可能有几格，所有 AttackTarget 有可能为nil } then
    begin
      TempMagic := m_CustomSkill[wHitMode - CM_CUSTOM_HIT001];
      if (TempMagic <> nil) and (TempMagic.MagicInfo <> nil) then
      begin
        CustomMagicConfig := GetCustomMagicConfig(wHitMode - CM_CUSTOM_HIT001 + CUSTOM_MAGIC_START_ID);
        nSpellPoint := TempMagic.MagicInfo.wDefSpell + GetMagicSpell(TempMagic);
        if (CustomMagicConfig <> nil) and (CustomMagicConfig.ServerConfig.IsAttackUseNG) then
        begin
          if m_boTrainingNG and (m_AbilNG.NH >= nSpellPoint) then
          begin
            if nSpellPoint > 0 then
            begin
              m_AbilNG.NH := Max(0, m_AbilNG.NH - nSpellPoint);
              RefAbilNH;
            end;
          end
          else
          begin
            wHitMode := RM_HIT;
          end;
        end
        else
        begin
          if (m_WAbil.MP >= nSpellPoint) then
          begin
            if nSpellPoint > 0 then
            begin
              DamageSpell(nSpellPoint);
              HealthSpellChanged();
            end;
          end
          else
            wHitMode := RM_HIT;
        end;
      end;
    end;
    nCheckCode := 4;
    m_btDirection := nDir;
    if TargeTBaseObject = nil then
    begin
      nCheckCode := 41;
      AttackTarget := nil;
      // 修正当前攻击目标叠加到弓箭手上面时，攻击目标变成了弓箭手 chongchong 2015-10-20
      if m_TargetCret <> nil then
      begin
        if GetPoseCreate(m_TargetCret) = m_TargetCret then
          AttackTarget := m_TargetCret;
      end;
      if AttackTarget = nil then
      begin
        GetFrontPosition(nX, nY);
        AttackTarget := m_PEnvir.GetMovingObject(nX, nY, True);
      end;
    end
    else
      AttackTarget := TargeTBaseObject;
    if (AttackTarget <> nil) and (m_btRaceServer = RC_PLAYOBJECT) and (m_UseItems[U_WEAPON].wIndex > 0) then
    begin
      nCheckCode := 42;
      CheckWeaponUpgrade();
    end;
    nCheckCode := 5;
    boPowerHit := m_boPowerHit;
    boFireHit := m_boFireHitSkill;
    boCrsHit := m_boCrsHitkill;
    bo66 := m_bo66Skill;
    bo42 := m_bo42Skill; // 龙影剑法     ID=42
    bo43 := m_bo43Skill;
    bo113 := m_bo113Skill;
    bo115 := m_bo115Skill;
    boSWordHit := m_boSWordHitSkill;
    if _Attack(wHitMode, AttackTarget, 1, NpcReleaseagic) then
    begin
      nCheckCode := 6;
      SetTargetCreat(AttackTarget);
      nCheckCode := 7;
    end;
    wIdent := RM_HIT;
    if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    begin { 增加分身魔法攻击 }
      if NpcReleaseagic = nil then
      begin
        case wHitMode of
          0:
            wIdent := RM_HIT;
          1:
            wIdent := RM_HEAVYHIT;
          2:
            wIdent := RM_BIGHIT;
          3:
            if boPowerHit and (m_MagicPowerHitSkill <> nil) then
            begin // 攻杀
              nNewLevel := m_MagicPowerHitSkill.btNewLevel;
              wIdent := RM_SPELL2;
            end;
          4:
            if m_MagicErgumSkill <> nil then
            begin // 0x520 刺杀剑法
              nNewLevel := m_MagicErgumSkill.btNewLevel;
              wIdent := RM_LONGHIT;
            end;
          5:
            if m_MagicBanwolSkill <> nil then
            begin // 半月
              nNewLevel := m_MagicBanwolSkill.btNewLevel;
              wIdent := RM_WIDEHIT;
            end;
          7:
            if boFireHit and (m_MagicFireSwordSkill <> nil) then
            begin // 烈火
              nNewLevel := m_MagicFireSwordSkill.btNewLevel;
              wIdent := RM_FIREHIT;
            end;
          8:
            if boCrsHit and (m_MagicCrsSkill <> nil) then
              wIdent := RM_CRSHIT; // 抱月刀 双龙斩   ID=40
          9:
            if bo42 and (m_Magic42Skill <> nil) then
              wIdent := RM_TWNHIT; // 龙影剑法     ID=42
          10:
            if bo43 and (m_Magic43Skill <> nil) then
              wIdent := RM_43HIT; // 雷霆剑法    ID=43
          11:
            if bo66 and (m_Magic66Skill <> nil) and (m_bo66SkillCls) then
              wIdent := RM_66HIT; // 开天斩
          19:
            if bo66 and (m_Magic66Skill <> nil) and (not m_bo66SkillCls) then
              wIdent := RM_66HIT1; // 开天斩轻击 piaoyun 2013-08-24
          12:
            wIdent := RM_60HIT; // 破魂斩
          13:
            wIdent := RM_61HIT; // 劈星斩
          14:
            wIdent := RM_62HIT; // 雷霆一击
          15:
            if boSWordHit and (m_MagicSwordSkill <> nil) then
            begin
              nNewLevel := m_MagicSwordSkill.btNewLevel;
              wIdent := RM_SWORDHIT; // 逐日剑法
            end;
          16:
            if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and (TSmartObject(Self).m_UserMagics[101] <> nil)
            then
              wIdent := RM_101HIT; // 三绝杀
          17:
            if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and (TSmartObject(Self).m_UserMagics[102] <> nil)
            then
              wIdent := RM_102HIT; // 断岳斩
          18:
            if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and (TSmartObject(Self).m_UserMagics[103] <> nil)
            then
              wIdent := RM_103HIT; // 横扫千军
          20:
            if bo113 and (m_Magic113Skill <> nil) then
              wIdent := RM_113HIT; // 断空斩
          21:
            if bo115 and (m_Magic115Skill <> nil) then
              wIdent := RM_115HIT; // 断空斩
        else
          if (wHitMode >= CM_CUSTOM_HIT001) and (wHitMode < CM_CUSTOM_HIT001 + CUSTOM_MAGIC_COUNT) and
            (m_CustomSkill[wHitMode - CM_CUSTOM_HIT001] <> nil) then
          begin
