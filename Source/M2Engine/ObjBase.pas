      Int64Value := Int64(m_Abil.MaxMP) + SmartObject.m_AddAbil.wMP;
      m_WAbil.MaxMP := Min(nMaxValue, Int64Value);

      // 增加防御 202、魔御 203倍数特殊物品代码 chongchong 2013-09-14
      if SmartObject.m_boACItem then
      begin
        if SmartObject.m_rACItem <= 1 then
        begin
          Int64Value := Int64(SmartObject.m_AddAbil.nAC1) + m_Abil.AC1;
          m_WAbil.AC1 := Min(nMaxAC, Int64Value);
          Int64Value := Int64(SmartObject.m_AddAbil.nAC2) + m_Abil.AC2;
          m_WAbil.AC2 := Min(nMaxAC, Int64Value);
        end
        else
        begin
          Int64Value := Round((Int64(SmartObject.m_AddAbil.nAC1) + m_Abil.AC1) * SmartObject.m_rACItem);
          m_WAbil.AC1 := Min(nMaxAC, Int64Value);
          Int64Value := Round((Int64(SmartObject.m_AddAbil.nAC2) + m_Abil.AC2) * SmartObject.m_rACItem);
          m_WAbil.AC2 := Min(nMaxAC, Int64Value);
        end;
      end
      else
      begin
        Int64Value := Int64(SmartObject.m_AddAbil.nAC1) + m_Abil.AC1;
        m_WAbil.AC1 := Min(nMaxAC, Int64Value);
        Int64Value := Int64(SmartObject.m_AddAbil.nAC2) + m_Abil.AC2;
        m_WAbil.AC2 := Min(nMaxAC, Int64Value);
      end;

      // 增加防御 202、魔御 203倍数特殊物品代码 chongchong 2013-09-14
      if SmartObject.m_boMACItem then
      begin
        if SmartObject.m_rMACItem <= 1 then
        begin
          Int64Value := Int64(SmartObject.m_AddAbil.nMAC1) + m_Abil.MAC1;
          m_WAbil.MAC1 := Min(nMaxAC, Int64Value);
          Int64Value := Int64(SmartObject.m_AddAbil.nMAC2) + m_Abil.MAC2;
          m_WAbil.MAC2 := Min(nMaxAC, Int64Value);
        end
        else
        begin
          Int64Value := Round((Int64(SmartObject.m_AddAbil.nMAC1) + m_Abil.MAC1) * SmartObject.m_rMACItem);
          m_WAbil.MAC1 := Min(nMaxAC, Int64Value);
          Int64Value := Round((Int64(SmartObject.m_AddAbil.nMAC1) + m_Abil.MAC1) * SmartObject.m_rMACItem);;
          m_WAbil.MAC2 := Min(nMaxAC, Int64Value);
        end;
      end
      else
      begin
        Int64Value := Int64(SmartObject.m_AddAbil.nMAC1) + m_Abil.MAC1;
        m_WAbil.MAC1 := Min(nMaxAC, Int64Value);
        Int64Value := Int64(SmartObject.m_AddAbil.nMAC2) + m_Abil.MAC2;
        m_WAbil.MAC2 := Min(nMaxAC, Int64Value);
      end;

      Int64Value := Int64(SmartObject.m_AddAbil.nDC1) + m_Abil.DC1;
      m_WAbil.DC1 := Min(nMaxAC, Int64Value);
      Int64Value := Int64(SmartObject.m_AddAbil.nDC2) + m_Abil.DC2;
      m_WAbil.DC2 := Min(nMaxAC, Int64Value);
      Int64Value := Int64(SmartObject.m_AddAbil.nMC1) + m_Abil.MC1;
      m_WAbil.MC1 := Min(nMaxAC, Int64Value);
      Int64Value := Int64(SmartObject.m_AddAbil.nMC2) + m_Abil.MC2;
      m_WAbil.MC2 := Min(nMaxAC, Int64Value);
      Int64Value := Int64(SmartObject.m_AddAbil.nSC1) + m_Abil.SC1;
      m_WAbil.SC1 := Min(nMaxAC, Int64Value);
      Int64Value := Int64(SmartObject.m_AddAbil.nSC2) + m_Abil.SC2;
      m_WAbil.SC2 := Min(nMaxAC, Int64Value);

      if SmartObject.m_nMoXieSuite > 0 then
