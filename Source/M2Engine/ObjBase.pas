function TSmartObject.sub_4C4CD4(sItemName: string; var nCount: Integer; FullNameCheck: Boolean; CheckChangedName: Boolean)
  : pTUserItem;
var
  I: Integer;
  sName: string;
  boRet: Boolean;
begin
  Result := nil;
  nCount := 0;
  for I := Low(THumanUseItems) to High(THumanUseItems) do
  begin
    sName := UserEngine.GetStdItemName(m_UseItems[I].wIndex);
    if CheckChangedName then
    begin
      if (m_UseItems[I].wIndex > 0) and (m_UseItems[I].btValue[13] = 1) and (Length(m_UseItems[I].Name) > 0) then
        sName := m_UseItems[I].Name;
    end;
    if FullNameCheck then
      boRet := SameText(sName, sItemName)
    else
      boRet := Pos(sItemName, sName) > 0;
    if boRet then
    begin
      Result := @m_UseItems[I];
      Inc(nCount);
    end;
  end;
  for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
  begin
    sName := UserEngine.GetStdItemName(m_JewelryBoxItems[I].wIndex);
    if CheckChangedName then
    begin
      if (m_JewelryBoxItems[I].wIndex > 0) and (m_JewelryBoxItems[I].btValue[13] = 1) and (Length(m_JewelryBoxItems[I].Name) > 0)
      then
        sName := m_JewelryBoxItems[I].Name;
    end;
    if FullNameCheck then
      boRet := SameText(sName, sItemName)
    else
      boRet := Pos(sItemName, sName) > 0;
    if boRet then
    begin
      Result := @m_JewelryBoxItems[I];
      Inc(nCount);
    end;
  end;
  for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
  begin
    sName := UserEngine.GetStdItemName(m_GodBlessItems[I].wIndex);
    if CheckChangedName then
    begin
      if (m_GodBlessItems[I].wIndex > 0) and (m_GodBlessItems[I].btValue[13] = 1) and (Length(m_GodBlessItems[I].Name) > 0) then
        sName := m_GodBlessItems[I].Name;
    end;

    if FullNameCheck then
      boRet := SameText(sName, sItemName)
    else
      boRet := Pos(sItemName, sName) > 0;

    if boRet then
    begin
      Result := @m_GodBlessItems[I];
      Inc(nCount);
    end;
  end;
end;

function TBaseObject.CheckItems(sItemName: string): pTUserItem; // 004C4AB0
var
  I: Integer;
  UserItem: pTUserItem;
begin
  Result := nil;

  for I := 0 to m_ItemList.Count - 1 do
  begin
    UserItem := m_ItemList.Items[I];
    if CompareText(UserEngine.GetStdItemName(UserItem.wIndex), sItemName) = 0 then
    begin
      Result := UserItem;
      Break;
    end;
  end;
end;

function TBaseObject.SiegeInspection: Integer; // Cursor 2023-06-19 15:02:28 王系怪，在被围攻时会瞬移
var
  nC, n10: Integer;
begin
  Result := 0;
  nC := -1;

  while nC <> 2 do
  begin
    n10 := -1;
    while n10 <> 2 do
    begin
      if not m_PEnvir.CanWalk(m_nCurrX + nC, m_nCurrY + n10, False) and ((nC <> 0) or (n10 <> 0)) then
        Inc(Result);

      Inc(n10);
    end;
    Inc(nC);
  end;
end;

function TBaseObject.DelBagItem(nIndex: Integer): Boolean;
begin
  Result := False;
  if (nIndex < 0) or (nIndex >= m_ItemList.Count) then
    Exit;

  if pTUserItem(m_ItemList.Items[nIndex]) <> nil then
  begin
    Dispose(pTUserItem(m_ItemList.Items[nIndex]));
    m_ItemList.Delete(nIndex);
    WeightChanged();
    Result := True;
  end;
end;

function TBaseObject.DelBagItem(nItemIndex: Integer; sItemName: string): Boolean;
var
  I: Integer;
  UserItem: pTUserItem;
begin
  Result := False;
  for I := m_ItemList.Count - 1 downto 0 do
  begin
    if m_ItemList.Count <= 0 then
      Break;

    UserItem := m_ItemList.Items[I];
    if (UserItem.MakeIndex = nItemIndex) and (CompareText(UserEngine.GetStdItemName(UserItem.wIndex), sItemName) = 0) then
    begin
      m_ItemList.Delete(I);
      Dispose(UserItem);
      Result := True;
      Break;
    end;
  end;

  if Result then
    WeightChanged();
end;

function TBaseObject.DelBagItem(UserItem: pTUserItem): Boolean;
var
  I: Integer;
  Item: pTUserItem;
begin
  Result := False;
  for I := m_ItemList.Count - 1 downto 0 do
  begin
    if m_ItemList.Count <= 0 then
      Break;

    Item := m_ItemList.Items[I];
    if Item = nil then
      Continue;

    if UserItem.wIndex = Item.wIndex then
    begin
      m_ItemList.Delete(I);
      Dispose(Item);
      Result := True;
      Break;
    end;
  end;

  if Result then
    WeightChanged();
end;

