procedure TBaseObject.Initialize;
var
  I: Integer;
  UserMagic: pTUserMagic;
begin
  AbilCopyToWAbil();
  // if (m_btRaceServer = RC_PLAYOBJECT) or (m_btRaceServer = RC_PLAYMOSTER) or (m_btRaceServer = RC_HEROOBJECT) then begin
  if m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    for I := 0 to TSmartObject(Self).m_MagicList.Count - 1 do
    begin
      UserMagic := TSmartObject(Self).m_MagicList.Items[I];
      if (UserMagic.MagicInfo <> nil) and (UserMagic.btLevel > High(UserMagic.MagicInfo.TrainLevel)) then
        UserMagic.btLevel := 0;
    end;
  end;
  // end;
  m_boAddtoMapFail := True;
  if m_PEnvir.CanWalk(m_nCurrX, m_nCurrY, True) and AddToMap() then
    m_boAddtoMapFail := False;
  m_nCharStatus := GetCharStatus();
  AddBodyLuck(0);
  LoadSayMsg();
  if g_Config.boMonSayMsg then
    MonsterSayMsg(nil, s_MonGen);
end;

