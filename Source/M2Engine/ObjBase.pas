  // 战连击技锁定时，不能动，只能物理攻击chongchong 2013-11-11
  if Result then
  begin
    if (m_wStatusTimeArr[STATE_CONTINUOUSMAGICLOCK] <> 0) and (btType in [0, 1, 3]) then
      Result := False;
  end;
  // 永恒冻结不能走动 piaoyun 2013-12-05
  if m_boForeverFrozen then
  begin
    Result := False;
  end;
  if Result then
  begin
    if m_boDingShen then
    begin
      case btType of
        0:
          Result := False;
        1:
          Result := False;
      end;
    end;
