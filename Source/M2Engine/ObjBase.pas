        begin
          for I := 0 to GroupItemList.Count - 1 do
          begin
            GroupItem := GroupItemList.Items[I];
            for II := Low(GroupFldValue) to High(GroupFldValue) do
            begin
              GroupFldValue[II] := GroupFldValue[II] + GroupItem.FLD_VALUE[II];
              GroupFldRate[II] := GroupFldRate[II] + GroupItem.FLD_RATE[II];
            end;

            // 套装规则修改 套装倍数; add chongchong 2013-07-27
            if GroupItem.FLD_VALUE[19] > 100 then
              SmartObject.m_SuiteExpMultiple := SmartObject.m_SuiteExpMultiple + GroupItem.FLD_VALUE[19];
            if GroupItem.FLD_FLAG[0] then
              SmartObject.m_boParalysis := True; // 麻痹
            if GroupItem.FLD_FLAG[1] then
              SmartObject.m_boMagicShield := True; // 护身
            if GroupItem.FLD_FLAG[2] then
              SmartObject.m_boTeleport := True; // 传送
            if GroupItem.FLD_FLAG[3] then
              SmartObject.m_boRevival := True; // 复活
            if GroupItem.FLD_FLAG[4] then
              SmartObject.m_boMuscleRing := True; // 负载
            if GroupItem.FLD_FLAG[5] then
              SmartObject.m_boFastTrain := True; // 技巧
            if GroupItem.FLD_FLAG[6] then
              SmartObject.m_boProbeNecklace := True; // 探测
            // if GroupItem.FLD_FLAG[7] then m_boMagicShield := True; //护身
            if GroupItem.FLD_FLAG[8] then
            begin
              // 套装隐身属性无效 chongchong 2013-12-11
              SmartObject.m_wStatusTimeArr[STATE_TRANSPARENT { 8 0x70 } ] := 6 * 10 * 1000;
              SmartObject.m_boHideMode := True; // 隐身
              // 修复先对自已使用隐身术，再戴隐身戒指，跑动后隐身无效 chongchong 2015-03-04
              SmartObject.m_boTransparent := False;
            end;

            if GroupItem.FLD_FLAG[9] then
              SmartObject.UnParalysis := True; // 防麻痹
            if GroupItem.FLD_FLAG[10] then
              SmartObject.UnPosion := True; // 防全毒
            if GroupItem.FLD_FLAG[11] then
              SmartObject.UnRevival := True; // 防复活
            if GroupItem.FLD_FLAG[12] then
              SmartObject.UnMagicShield := True; // 防护身
            // if GroupItem.FLD_FLAG[13] then m_boMagicShield := True;              // 护身
            if GroupItem.FLD_FLAG[14] then
              SmartObject.m_boNoDropItem := True; // 不掉背包物品
            if GroupItem.FLD_FLAG[15] then
              SmartObject.m_boNoDropUseItem := True; // 不掉身上装备
            if GroupItem.FLD_FLAG[16] then
              SmartObject.m_boFrozen := True; // 冰冻
            if GroupItem.FLD_FLAG[17] then
              SmartObject.UnFrozen := True; // 防冰冻
            if GroupItem.FLD_FLAG[18] then
              SmartObject.m_boCobwebWinding := True; // 蛛网
            if GroupItem.FLD_FLAG[19] then
              SmartObject.UnCobwebWinding := True; // 防蛛网
            if GroupItem.FLD_FLAG[20] then
              SmartObject.m_boMDParalysis := True; // 魔道麻痹
            for II := 1 to High(GroupItem.AttackSkillPercent) do
            begin
              SmartObject.m_AttackSkillPercent[II] :=
                Min(SmartObject.m_AttackSkillPercent[II] + GroupItem.AttackSkillPercent[II], 100);
              SmartObject.m_DefenseSkillPercent[II] :=
                Min(SmartObject.m_DefenseSkillPercent[II] + GroupItem.DefenseSkillPercent[II], 100);
            end;
          end;
        end;

        // 先算属性再算百分比 chongchong 2015-03-03
        if g_Config.boGroupItemRule then
          AddGroupItemValue(nMaxValue, GroupFldValue);

        Int64Value := g_GroupItems.RateValue2(GroupFldRate[0], m_WAbil.MaxHP);
        m_WAbil.MaxHP := Min(nMaxValue, Int64Value);
        Int64Value := g_GroupItems.RateValue2(GroupFldRate[1], m_WAbil.MaxMP);
        m_WAbil.MaxMP := Min(nMaxValue, Int64Value);
        m_WAbil.AC1 := g_GroupItems.RateValue(GroupFldRate[2], m_WAbil.AC1);
        m_WAbil.AC2 := g_GroupItems.RateValue(GroupFldRate[14], m_WAbil.AC2);
        m_WAbil.MAC1 := g_GroupItems.RateValue(GroupFldRate[3], m_WAbil.MAC1);
        m_WAbil.MAC2 := g_GroupItems.RateValue(GroupFldRate[15], m_WAbil.MAC2);
        m_WAbil.DC1 := g_GroupItems.RateValue(GroupFldRate[4], m_WAbil.DC1);
        m_WAbil.DC2 := g_GroupItems.RateValue(GroupFldRate[16], m_WAbil.DC2);
        m_WAbil.MC1 := g_GroupItems.RateValue(GroupFldRate[5], m_WAbil.MC1);
        m_WAbil.MC2 := g_GroupItems.RateValue(GroupFldRate[17], m_WAbil.MC2);
        m_WAbil.SC1 := g_GroupItems.RateValue(GroupFldRate[6], m_WAbil.SC1);
        m_WAbil.SC2 := g_GroupItems.RateValue(GroupFldRate[18], m_WAbil.SC2);

        // 扩展准确、敏捷为65536 chongchong 2018-01-11
        if g_Config.btMaxHitPoint = 1 then
        begin
          m_btHitPoint := Min(High(Word), g_GroupItems.RateValue(GroupFldRate[7], m_btHitPoint)); // 准确
          m_btSpeedPoint := Min(High(Word), g_GroupItems.RateValue(GroupFldRate[8], m_btSpeedPoint)); // 敏捷
        end
        else
        begin
          m_btHitPoint := Min(High(Byte), g_GroupItems.RateValue(GroupFldRate[7], m_btHitPoint)); // 准确
          m_btSpeedPoint := Min(High(Byte), g_GroupItems.RateValue(GroupFldRate[8], m_btSpeedPoint)); // 敏捷
        end;

        m_nAntiMagic := Min(High(Byte), g_GroupItems.RateValue(GroupFldRate[9], m_nAntiMagic)); // 魔法躲避
        m_btAntiPoison := Min(High(Byte), g_GroupItems.RateValue(GroupFldRate[10], m_btAntiPoison)); // 毒躲避
        m_nPoisonRecover := Min(High(Byte), g_GroupItems.RateValue(GroupFldRate[11], m_nPoisonRecover)); // 毒恢复
        m_nHealthRecover := Min(High(Byte), g_GroupItems.RateValue(GroupFldRate[12], m_nHealthRecover)); // HP恢复
        m_nSpellRecover := Min(High(Byte), g_GroupItems.RateValue(GroupFldRate[13], m_nSpellRecover)); // MP恢复

        // 先算百分比再算属性
        if not g_Config.boGroupItemRule then
          AddGroupItemValue(nMaxValue, GroupFldValue);

        TempList.Assign(OldGroupItemList);
        for I := 0 to GroupItemList.Count - 1 do
        begin
          GroupItem := GroupItemList.Items[I];
          boFind := False;
          for II := 0 to TempList.Count - 1 do
          begin
            if TempList[II] = GroupItem then
            begin
              boFind := True;
              // 同一个套装可能在2套 chongchong 2018-07-11 13:49:30
              // TempList.Delete(II);
              Break;
            end;
          end;
          if not boFind then
          begin
            SendMsg(Self, RM_GROUPITEMON, GroupItem.FLD_INDEX, 0, 0, 0, GroupItem.FLD_HINTMSG);
            OldGroupItemList.Add(GroupItem);
          end;
        end;

        // 同一个套装可能在2套 chongchong 2018-07-11 13:49:30
        TempList.Assign(GroupItemList);
        for I := OldGroupItemList.Count - 1 downto 0 do
        begin
          GroupItem := OldGroupItemList.Items[I];
          boFind := False;
          for II := 0 to TempList.Count - 1 do
          begin
            if TempList[II] = GroupItem then
            begin
              boFind := True;
              // 同一个套装可能在2套 chongchong 2018-07-11 13:49:30
              // TempList.Delete(II);
              Break;
            end;
          end;

          // 如果没有找到套装，则发消息
          if not boFind then
          begin
            SendMsg(Self, RM_GROUPITEMOFF, GroupItem.FLD_INDEX, 0, 0, 0, '');
            OldGroupItemList.Delete(I);
          end;
        end;

        // 修改套装属性：负重无效 chongchong 2017-01-09
        if SmartObject.m_boMuscleRing then
        begin // 活力
          m_WAbil.MaxWeight := Min(MAXHUMPOWER, m_WAbil.MaxWeight + m_WAbil.MaxWeight);
          m_WAbil.MaxWearWeight := Min(MAXHUMPOWER, m_WAbil.MaxWearWeight + m_WAbil.MaxWearWeight);
          m_WAbil.MaxHandWeight := Min(MAXHUMPOWER, m_WAbil.MaxHandWeight + m_WAbil.MaxHandWeight);
        end;
      finally
        TempList.Free;
      end;
    end;

    if (SmartObject <> nil) and (SmartObject.m_nHideModeEx > 0) then
      m_boHideMode := True;

    // 隐身状态改变，移动套装后面，套装也支持隐身 chongchong 2013-12-11
    if m_boTransparent and (m_wStatusTimeArr[STATE_TRANSPARENT { 8 0x70 } ] > 0) then
      m_boHideMode := True;

    if m_boHideMode then
    begin
      if not boOldHideMode then
      begin
        m_nCharStatus := GetCharStatus();
        StatusChanged();
      end;
    end
    else
    begin
      if boOldHideMode then
      begin
        m_wStatusTimeArr[STATE_TRANSPARENT { 8 0x70 } ] := 0;
        m_nCharStatus := GetCharStatus();
        StatusChanged();
      end;
    end;
    { ================================套装属性结束====================================== }

