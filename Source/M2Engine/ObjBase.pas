            end
            else if m_btJob in [1, 2] then
            begin
              nResotreHPSpeed := g_Config.nDummyHeroHPTime_DF; // MainOutMessage('道法人物回血速度')
              nResotreMPSpeed := g_Config.nDummyHeroMPTime_DF; // MainOutMessage('道法人物回蓝速度')
