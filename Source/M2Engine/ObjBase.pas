function OverLapItems(BaseObject: TBaseObject; StdItem: pTStdItem; wDura: Word): pTUserItem; // 叠加物品
var
  I: Integer;
  UserItem: pTUserItem;
  pStdItem: pTStdItem;
begin
  Result := nil;
  if CheckOverLapItem(StdItem) then
  begin
    wDura := wDura + 1;
    for I := 0 to BaseObject.m_ItemList.Count - 1 do
    begin
      UserItem := BaseObject.m_ItemList.Items[I];
      // 绑定物品不能和非绑定物品叠加到一起 chongchong 2014-09-26
      if not UserItem.boIsBind then
      begin
        pStdItem := UserEngine.GetStdItem(UserItem.wIndex);
        // MainOutMessage(Format('UserItem.Dura:%d UserItem.DuraMax:%d wDura:%d',[UserItem.Dura, UserItem.DuraMax, wDura]));
        if (pStdItem <> nil) and (pStdItem = StdItem) and (UserItem.Dura + wDura < UserItem.DuraMax) then
        begin
          UserItem.Dura := UserItem.Dura + wDura;
          if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
          begin
            TPlayObject(BaseObject).SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura);
            BaseObject.WeightChanged;
          end
          else
          begin
            if BaseObject.m_btRaceServer = RC_HEROOBJECT then
            begin
              THeroObject(BaseObject).SendUpdateItemDura(-1, UserItem.MakeIndex, UserItem.Dura);
              BaseObject.WeightChanged;
            end;
          end;
          Result := UserItem;
          Break;
        end;
      end;
    end;
  end;
end;

