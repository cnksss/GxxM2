function TSmartObject.GetStruckProtectHP(nDamage: Integer): Integer;
var
  ProtectHP: LongWord;
begin
  Result := nDamage;
  if not m_ProtectHPInfo.IsOpen then
    Exit;

  if nDamage < m_WAbil.HP then
    Exit;

  if m_ProtectHPInfo.IsPercentage then
  begin
    if m_WAbil.HP >= m_WAbil.MaxHP / 100 * m_ProtectHPInfo.dwCheckValue then
    begin
      ProtectHP := Round(m_WAbil.MaxHP / 100 * m_ProtectHPInfo.dwProtectValue);
      if m_WAbil.HP <= ProtectHP then
        Result := 0
      else
        Result := Min(Result - ProtectHP, m_WAbil.HP - ProtectHP);

      if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroProtectHP', False)
      else
        g_FunctionNPC.GotoLable(TPlayObject(Self), '@ProtectHP', False);
    end;
  end
  else if m_WAbil.HP >= m_ProtectHPInfo.dwCheckValue then
  begin
    ProtectHP := m_ProtectHPInfo.dwProtectValue;
    if m_WAbil.HP <= ProtectHP then
      Result := 0
    else
      Result := Min(Result - ProtectHP, m_WAbil.HP - ProtectHP);

    if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroProtectHP', False)
    else
      g_FunctionNPC.GotoLable(TPlayObject(Self), '@ProtectHP', False);
  end;
end;

