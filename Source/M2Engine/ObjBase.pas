function TSmartObject.AllowRecallSlaveCount(wMagicID: Word): Boolean;
var
  I: Integer;
  BaseObject: TBaseObject;
  nCount, AllMonCount: Integer;
begin
  nCount := 0;
  case wMagicID of
    17: // 召唤骷髅
      begin
        nCount := g_Config.nBoneFammCount;
        for I := Low(g_Config.BoneFammArray) to High(g_Config.BoneFammArray) do
        begin
          if (g_Config.BoneFammArray[I].nHumLevel = 0) or (g_Config.BoneFammArray[I].sMonName = '') then
            Break;

          if m_Abil.Level >= g_Config.BoneFammArray[I].nHumLevel then
            nCount := g_Config.BoneFammArray[I].nCount;
        end;

        AllMonCount := 0;
        for I := 0 to m_SlaveList.Count - 1 do
        begin
          BaseObject := m_SlaveList.Items[I];
          if not(BaseObject.m_boDeath) and (not BaseObject.m_boGhost) then
          begin
            Inc(AllMonCount);
            if BaseObject.m_BBType = bb_BoneFamm then
            begin
              Dec(nCount);
              if nCount = 0 then
                Break;
            end
            else if (not g_Config.boRecallManySlave1) and (BaseObject.m_BBType = bb_Dogz) then // 不允许同时召唤骷髅和神兽
            begin
              nCount := 0;
              Break;
            end;
          end;
        end;

        if (nCount > 0) //
          and (g_Config.dwRecallMonCount > 0) //
          and (AllMonCount >= g_Config.dwRecallMonCount) then
          nCount := 0;
      end;
    30: // 召唤神兽
      begin
        nCount := g_Config.nDogzCount;
        for I := Low(g_Config.DogzArray) to High(g_Config.DogzArray) do
        begin
          if (g_Config.DogzArray[I].nHumLevel = 0) or (g_Config.DogzArray[I].sMonName = '') then
            Break;

          if m_Abil.Level >= g_Config.DogzArray[I].nHumLevel then
            nCount := g_Config.DogzArray[I].nCount;
        end;

        AllMonCount := 0;
        for I := 0 to m_SlaveList.Count - 1 do
        begin
          BaseObject := m_SlaveList.Items[I];
          if not(BaseObject.m_boDeath) and (not BaseObject.m_boGhost) then
          begin
            Inc(AllMonCount);
            if BaseObject.m_BBType = bb_Dogz then
            begin
              Dec(nCount);
              if nCount = 0 then
                Break;
            end
            else if (not g_Config.boRecallManySlave1) and (BaseObject.m_BBType = bb_BoneFamm) then // 不允许同时召唤骷髅和神兽
            begin
              nCount := 0;
              Break;
            end
            else if (not g_Config.boRecallManySlave3) and (BaseObject.m_BBType = bb_BigDogz) then // 不允许同时召唤神兽和圣兽
            begin
              nCount := 0;
              Break;
            end
          end;
        end;

        if (nCount > 0) //
          and (g_Config.dwRecallMonCount > 0) //
          and (AllMonCount >= g_Config.dwRecallMonCount) then
          nCount := 0;
      end;
    76:
      begin // 召唤圣兽
        nCount := g_Config.nBigDogzCount;
        for I := Low(g_Config.BigDogzArray) to High(g_Config.BigDogzArray) do
        begin
          if (g_Config.BigDogzArray[I].nHumLevel = 0) or (g_Config.BigDogzArray[I].sMonName = '') then
            Break;

          if m_Abil.Level >= g_Config.BigDogzArray[I].nHumLevel then
            nCount := g_Config.BigDogzArray[I].nCount;
        end;

        AllMonCount := 0;
        for I := 0 to m_SlaveList.Count - 1 do
        begin
          BaseObject := m_SlaveList.Items[I];
          if not(BaseObject.m_boDeath) and (not BaseObject.m_boGhost) then
          begin
            Inc(AllMonCount);
            if BaseObject.m_BBType = bb_BigDogz then
            begin
              Dec(nCount);
              if nCount = 0 then
                Break;
            end
            else if (not g_Config.boRecallManySlave2) and (BaseObject.m_BBType = bb_MonthSpirit) then // 不允许同时召唤月灵和圣兽
            begin
              nCount := 0;
              Break;
            end
            else if (not g_Config.boRecallManySlave3) and (BaseObject.m_BBType = bb_Dogz) then // 不允许同时召唤神兽和圣兽
            begin
              nCount := 0;
              Break;
            end
          end;
        end;

        if (nCount > 0) //
          and (g_Config.dwRecallMonCount > 0) //
          and (AllMonCount >= g_Config.dwRecallMonCount) then
          nCount := 0;
      end;
  end;
  Result := nCount > 0;
end;

function TSmartObject.AllowRecallMoonSlave: Boolean;
var
  I: Integer;
  nCount: Integer;
  BaseObject: TBaseObject;
begin
  nCount := g_Config.nMonthSpiritCount;
  for I := Low(g_Config.MonthSpiritArray) to High(g_Config.MonthSpiritArray) do
  begin
    if (g_Config.MonthSpiritArray[I].nHumLevel = 0) and (g_Config.MonthSpiritArray[I].sMonName = '') then
      Break;

    if m_Abil.Level >= g_Config.MonthSpiritArray[I].nHumLevel then
      nCount := g_Config.MonthSpiritArray[I].nCount;
  end;

  for I := 0 to m_SlaveList.Count - 1 do
  begin
    BaseObject := m_SlaveList.Items[I];
    if not(BaseObject.m_boDeath) and (not BaseObject.m_boGhost) then
    begin
      if BaseObject.m_BBType = bb_MonthSpirit then
      begin
        Dec(nCount);
        if nCount = 0 then
          Break;
      end
      else if (not g_Config.boRecallManySlave2) and (BaseObject.m_BBType = bb_BigDogz) then // 不允许同时召唤月灵和圣兽
      begin
        nCount := 0;
        Break;
      end
    end;
  end;
  Result := (nCount > 0) { and (m_Abil.Level >= nMakeLevel) };
end;

function TBaseObject.IsAddWeightAvailable(nWeight: Integer): Boolean; // 004C4A78
begin
  Result := False;

  if (m_WAbil.Weight + nWeight) <= m_WAbil.MaxWeight then
    Result := True;
end;

function TBaseObject.GetLevelExpRate(dwExp: LongWord): LongWord;
begin
  Result := dwExp;

  if (m_Abil.Level > 0) //
    and (m_Abil.Level < MAXCHANGELEVEL) //
    and (dwExp > 0) //
    and (g_Config.LevelExpRates[m_Abil.Level] > 0) then
    Result := Round(dwExp / 100 * g_Config.LevelExpRates[m_Abil.Level]);
end;

procedure TBaseObject.Die;
var
  I: Integer;
  boPK, guildwarkill: Boolean;
  tStr: string;
  tExp: LongWord;
  GroupHuman: TPlayObject;
  QuestNPC: TMerchant;
  tCheck: Boolean;
  boClick: Boolean;
  AttackBaseObject: TBaseObject;
  Castle: TUserCastle;
  nCheckCode: Integer;
  nSaveValue, nReadValue, n01: Integer;
  AMaster: TBaseObject;
  ALastHiter: TBaseObject;
  AExpHitterMaster: TBaseObject;
  ALastHiterMaster: TBaseObject;
  ATempHitter: TPlayObject;
  sChrName: string;
  Players: TList;
  Npcs: TList;
  TempTargetCret: TBaseObject;
  DropRate, DropRate2: Integer;
  boGetRandItem: Boolean;
  GamePetData: pTGamePetData;
resourcestring
  sExceptionMsg1 = '[Exception] TBaseObject.Die 1';
  sExceptionMsg2 = '[Exception] TBaseObject.Die 2';
  sExceptionMsg3 = '[Exception] TBaseObject.Die 3 CheckCode:';
  sExceptionMsg4 = '[Exception] TBaseObject.Die 4 GOTO LABEL:';
begin
  if m_boSuperMan then
    Exit;

  if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) and TSmartObject(Self).m_boSupermanItem then
    Exit;

  if m_btRaceServer = RC_PLAYOBJECT then
  begin
    TPlayObject(Self).StopCollect;
    // 骑马 死亡处理 chongchong 2013-10-14
    if TSmartObject(Self).m_boOnHorse and (TSmartObject(Self).m_HorseOtherHum <> nil) then
    begin
      TSmartObject(Self).m_HorseOtherHum.m_HorseOtherHum := nil;
      if TSmartObject(Self).m_boHorseMaster then
      begin
        TSmartObject(Self).m_HorseOtherHum.m_boOnHorse := False;
        TPlayObject(Self).m_HorseOtherHum.m_boCanOnHorse := False;
        TPlayObject(Self).m_HorseOtherHum.m_dwCanOnHorseTime := 0;
        TSmartObject(Self).m_HorseOtherHum.m_dwDownHorseTick := MyGetTickCount;
        TSmartObject(Self).m_HorseOtherHum.DoTalkStatusChanged;
        TSmartObject(Self).m_HorseOtherHum.TriggerHorseScript;
        TSmartObject(Self).m_HorseOtherHum.SendTakeOffHorse;
      end
      else
        TSmartObject(Self).SendTakeOffHorse;
      TSmartObject(Self).m_HorseOtherHum := nil;
      TSmartObject(Self).DoTalkStatusChanged;
    end;

    if TPlayObject(Self).m_boContinuous then
    begin
      TPlayObject(Self).m_boContinuous := False;
      SendMsg(Self, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
    end;
  end;

  m_boDeath := True;
  m_dwDeathTick := MyGetTickCount();
  m_dwDeathTickEx := g_Config.dwMonButchDelayClearTime * 1000;
  if m_ExpHitter = nil then
    m_ExpHitter := m_PoisonHitter; // 施毒者

  if m_LastHiter = nil then
    m_LastHiter := m_PoisonHitter; // 施毒者

  AMaster := m_Master;
  ALastHiter := m_LastHiter;
  if m_Master <> nil then
  begin
    m_ExpHitter := nil;
    m_LastHiter := nil;
  end;

  if (m_ExpHitter <> nil) and (m_ExpHitter.m_Master <> nil) then
    AExpHitterMaster := m_ExpHitter.Master
  else
    AExpHitterMaster := nil;

  if (m_LastHiter <> nil) and (m_LastHiter.m_Master <> nil) then
    ALastHiterMaster := m_LastHiter.Master
  else
    ALastHiterMaster := nil;

  m_nIncSpell := 0;
  m_nIncHealth := 0;
  m_nIncHealing := 0;
  try
    if (m_btRaceServer <> RC_PLAYOBJECT) and (m_LastHiter <> nil) then
    begin
      if g_Config.boMonSayMsg then
        MonsterSayMsg(m_LastHiter, s_Die);

      if m_ExpHitter <> nil then
      begin
        m_sKillerName := m_ExpHitter.m_sCharName;
        m_btKillerRace := m_ExpHitter.m_btRaceServer;
        m_ExpHitter.m_CurrTarget := Self;
        m_CurrTarget := m_ExpHitter;

        if m_ExpHitter.m_btRaceServer = RC_PLAYOBJECT then
        begin
          TPlayObject(m_ExpHitter).m_sLastKillMonName := m_sCharName;

          tExp := m_ExpHitter.CalcGetExp(m_Abil.Level, m_dwFightExp);
          if not g_Config.boVentureServer then
          begin
            TPlayObject(m_ExpHitter).m_boExpFromFromHero := False;
            if m_boISNGMonster then
            begin
              TPlayObject(m_ExpHitter).GainExpNG(tExp);
              TPlayObject(m_ExpHitter).GainExp(tExp);
            end
            else
              TPlayObject(m_ExpHitter).GainExp(tExp);
          end;

          // 是否执行任务脚本
          if m_PEnvir.IsCheapStuff then
          begin
            boClick := False;
            if (TPlayObject(m_ExpHitter).m_GroupOwner <> nil) //
              and (TPlayObject(m_ExpHitter).m_GroupOwner.m_GroupMembers <> nil) then
            begin
              Players := TList.Create;
              Npcs := TList.Create;
              try
{$IF MULTI_THREAD = 1}
                if g_MultiThreadRun then
                  TPlayObject(m_ExpHitter).m_GroupOwner.m_GroupMembers.LockR(5);
                try
{$IFEND}
                  if TPlayObject(m_ExpHitter).m_GroupOwner.m_GroupMembers.Count > 0 then
                  begin
                    for I := 0 to TPlayObject(m_ExpHitter).m_GroupOwner.m_GroupMembers.Count - 1 do
                    begin
                      GroupHuman := TPlayObject(TPlayObject(m_ExpHitter).m_GroupOwner.m_GroupMembers.Objects[I]);
                      if GroupHuman <> nil then
                      begin
                        tCheck := GroupHuman.m_boDeath // Cursor 2023-05-24 09:53:34
                          or (m_ExpHitter <> GroupHuman) //
                          or (m_ExpHitter.m_PEnvir <> GroupHuman.m_PEnvir) //
                          or (Abs(m_ExpHitter.m_nCurrX - GroupHuman.m_nCurrX) > m_ExpHitter.m_nViewRange) //
                          or (Abs(m_ExpHitter.m_nCurrY - GroupHuman.m_nCurrY) > m_ExpHitter.m_nViewRange);

                        QuestNPC := TMerchant(m_PEnvir.GetQuestNPC(GroupHuman, m_sCharName, '', tCheck));
                        if QuestNPC <> nil then
                        begin
                          if (not boClick) and (GroupHuman = m_ExpHitter) then
                            boClick := True;

                          Npcs.Add(QuestNPC);
                          Players.Add(GroupHuman);
                        end;
                      end;
                    end;
                  end;
{$IF MULTI_THREAD = 1}
                finally
                  if g_MultiThreadRun then
                    TPlayObject(m_ExpHitter).m_GroupOwner.m_GroupMembers.UnLockR;
                end;
{$IFEND}
                if Npcs.Count = Players.Count then
                begin
                  for I := 0 to Npcs.Count - 1 do
                  begin
                    QuestNPC := TMerchant(Npcs[I]);
                    GroupHuman := TPlayObject(Players[I]);
                    QuestNPC.Click(GroupHuman);
                  end;
                end;
              finally
                Players.Free;
                Npcs.Free;
              end;
            end;

            // 防止执行2次
            if not boClick then
            begin
              QuestNPC := TMerchant(m_PEnvir.GetQuestNPC(m_ExpHitter, m_sCharName, '', False));
              if QuestNPC <> nil then
                QuestNPC.Click(TPlayObject(m_ExpHitter));
            end;
          end;
        end
        else
        begin
          if AExpHitterMaster <> nil then
          begin
            if AExpHitterMaster.m_btRaceServer = RC_PLAYOBJECT then
            begin
              AExpHitterMaster.m_CurrTarget := Self;
              m_CurrTarget := AExpHitterMaster;
            end;

            if ((m_ExpHitter.m_btRaceServer = RC_HEROOBJECT) //
              and (m_ExpHitter.m_Master <> nil) //
              and (m_ExpHitter.m_Master.m_btRaceServer = RC_PLAYOBJECT)) //
              or ((m_ExpHitter.m_Master <> nil) // 修正英雄的宝宝打怪不获取经验 chongchong 2014-08-08 20:18:00
              and (m_ExpHitter.m_Master.m_btRaceServer = RC_HEROOBJECT) //
              and (AExpHitterMaster.m_btRaceServer = RC_PLAYOBJECT)) then
            begin
              if ((m_ExpHitter.m_Master <> nil) // 英雄宝宝打怪升级
                and (m_ExpHitter.m_Master.m_btRaceServer = RC_HEROOBJECT) //
                and (AExpHitterMaster.m_btRaceServer = RC_PLAYOBJECT)) then
                m_ExpHitter.GainSlaveExp(m_Abil.Level)
              else
                THeroObject(m_ExpHitter).m_sLastKillMonName := m_sCharName;

              tExp := m_ExpHitter.m_Master.CalcGetExp(m_Abil.Level, m_dwFightExp);
              if not g_Config.boVentureServer then
              begin
                TPlayObject(AExpHitterMaster).m_boExpFromFromHero := True;
                if m_boISNGMonster then
                begin
                  TPlayObject(AExpHitterMaster).GainExpNG(tExp);
                  TPlayObject(AExpHitterMaster).GainExp(tExp);
                end
                else
                  TPlayObject(AExpHitterMaster).GainExp(tExp);

                TPlayObject(AExpHitterMaster).m_boExpFromFromHero := False; // 用完还原
              end;
            end
            else
            begin
              if (not m_ExpHitter.m_boGamePet) // 排除分身 2020-09-10 01:09:33
                and (m_ExpHitter.m_btRaceServer <> RC_PLAYMOSTER) then
                m_ExpHitter.GainSlaveExp(m_Abil.Level);

              if (AExpHitterMaster <> nil) //
                and (AExpHitterMaster.m_btRaceServer = RC_PLAYOBJECT) //
                and (m_ExpHitter.m_Master <> nil) //
                and (m_ExpHitter.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
              begin
                tExp := m_ExpHitter.m_Master.CalcGetExp(m_Abil.Level, m_dwFightExp);
                if m_ExpHitter.m_boGamePet then
                begin
                  if m_ExpHitter.m_Abil.Level >= g_Config.nPetHighLevel then
                    m_ExpHitter.IncGamePetExt(Min(tExp, g_Config.nPetHighLevelGetExp))
                  else
                    m_ExpHitter.IncGamePetExt(tExp);
                end;

                if not g_Config.boVentureServer then
                begin
                  TPlayObject(AExpHitterMaster).m_boExpFromFromHero := False;
                  if m_boISNGMonster then
                  begin
                    TPlayObject(AExpHitterMaster).GainExpNG(tExp);
                    TPlayObject(AExpHitterMaster).GainExp(tExp);
                  end
                  else
                    TPlayObject(AExpHitterMaster).GainExp(tExp);
                end;
              end;
            end;

            if (AExpHitterMaster <> nil) and (AExpHitterMaster.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              // 是否执行任务脚本
              if m_PEnvir.IsCheapStuff then
              begin
                boClick := False;
                if (TPlayObject(AExpHitterMaster).m_GroupOwner <> nil) //
                  and (TPlayObject(AExpHitterMaster).m_GroupOwner.m_GroupMembers <> nil) then
                begin
                  Players := TList.Create;
                  Npcs := TList.Create;
                  try
{$IF MULTI_THREAD = 1}
                    if g_MultiThreadRun then
                      TPlayObject(AExpHitterMaster).m_GroupOwner.m_GroupMembers.LockR(6);
                    try
{$IFEND}
                      if (TPlayObject(AExpHitterMaster).m_GroupOwner.m_GroupMembers.Count > 0) then
                      begin
                        for I := 0 to TPlayObject(AExpHitterMaster).m_GroupOwner.m_GroupMembers.Count - 1 do
                        begin
                          GroupHuman := TPlayObject(TPlayObject(AExpHitterMaster).m_GroupOwner.m_GroupMembers.Objects[I]);
                          if GroupHuman <> nil then
                          begin
                            tCheck := GroupHuman.m_boDeath // Cursor 2023-05-24 09:59:00
                              or (AExpHitterMaster <> GroupHuman) //
                              or (AExpHitterMaster.m_PEnvir <> GroupHuman.m_PEnvir) //
                              or (Abs(AExpHitterMaster.m_nCurrX - GroupHuman.m_nCurrX) > AExpHitterMaster.m_nViewRange) //
                              or (Abs(AExpHitterMaster.m_nCurrY - GroupHuman.m_nCurrY) > AExpHitterMaster.m_nViewRange);

                            QuestNPC := TMerchant(m_PEnvir.GetQuestNPC(GroupHuman, m_sCharName, '', tCheck));
                            if QuestNPC <> nil then
                            begin
                              if (not boClick) and (GroupHuman = AExpHitterMaster) then
                                boClick := True;

                              Npcs.Add(QuestNPC);
                              Players.Add(GroupHuman);
                            end;
                          end;
                        end;
                      end;
{$IF MULTI_THREAD = 1}
                    finally
                      if g_MultiThreadRun then
                        TPlayObject(AExpHitterMaster).m_GroupOwner.m_GroupMembers.UnLockR;
                    end;
{$IFEND}
                    if Npcs.Count = Players.Count then
                    begin
                      for I := 0 to Npcs.Count - 1 do
                      begin
                        QuestNPC := TMerchant(Npcs[I]);
                        GroupHuman := TPlayObject(Players[I]);
                        QuestNPC.Click(GroupHuman);
                      end;
                    end;
                  finally
                    Players.Free;
                    Npcs.Free;
                  end;
                end;

                // 防止执行2次
                if not boClick then
                begin
                  QuestNPC := TMerchant(m_PEnvir.GetQuestNPC(AExpHitterMaster, m_sCharName, '', False));
                  if QuestNPC <> nil then
                    QuestNPC.Click(TPlayObject(AExpHitterMaster));
                end;
              end;
            end;
          end;
        end;
      end
      else if m_LastHiter <> nil then
      begin
        m_sKillerName := m_LastHiter.m_sCharName;
        m_btKillerRace := m_LastHiter.m_btRaceServer;
        m_LastHiter.m_CurrTarget := Self;
        m_CurrTarget := m_LastHiter;

        if m_LastHiter.m_btRaceServer = RC_PLAYOBJECT then
        begin
          TPlayObject(m_LastHiter).m_sLastKillMonName := m_sCharName;
          tExp := m_LastHiter.CalcGetExp(m_Abil.Level, m_dwFightExp);

          if not g_Config.boVentureServer then
          begin
            TPlayObject(m_LastHiter).m_boExpFromFromHero := False;
            if m_boISNGMonster then
            begin
              TPlayObject(m_LastHiter).GainExpNG(tExp);
              TPlayObject(m_LastHiter).GainExp(tExp);
            end
            else
              TPlayObject(m_LastHiter).GainExp(tExp);
          end;
        end;
      end;
    end;

    if (g_Config.boMonSayMsg) //
      and (m_btRaceServer = RC_PLAYOBJECT) //
      and (m_LastHiter <> nil) then
      m_LastHiter.MonsterSayMsg(Self, s_KillHuman);

    // 魔王领杀怪主人触发
    if (m_LastHiter <> nil) //
      and ((m_LastHiter.m_btRaceServer = 109) or ((m_LastHiter.m_btRaceServer = 155) //
      and (m_LastHiter.m_btRaceImg = 156) { 自定义怪物 - 魔王岭宝宝 } )) //
      and (m_LastHiter.m_Master <> nil) //
      and (m_LastHiter.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      if g_FunctionNPC <> nil then
      begin
        TPlayObject(m_LastHiter.m_Master).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(m_LastHiter.m_Master), '@KillMissionMob', False);
      end;
    end;

    { 执行杀怪触发 }
    // 修复宝宝死亡后名字颜色为白色，正常应该和未死亡前一样的颜色... chongchong 2014-09-01
    // m_Master := nil;
  except
    on E: Exception do
    begin
      MainOutMessage(sExceptionMsg1);
      MainOutMessage(E.Message);
    end;
  end;

  { 执行杀人和死亡触发 }
  try
    boPK := False;
    if (not g_Config.boVentureServer) //
      and (not m_PEnvir.m_boFightZone) //
      and (not m_PEnvir.m_boFight3Zone) //
      and (not m_PEnvir.m_boFight4Zone) then
    begin
      if (m_btRaceServer = RC_PLAYOBJECT) and (m_LastHiter <> nil) and (TSmartObject(Self).PKLevel < 2) then
      begin
        { 修改日期2004/07/21，允许NPC杀死人物 }
        if (m_LastHiter.m_btRaceServer = RC_PLAYOBJECT) or (m_LastHiter.m_btRaceServer = RC_NPC) then
          boPK := True;

        if (m_LastHiter.Master <> nil) and (m_LastHiter.Master.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          m_LastHiter := m_LastHiter.Master;
          boPK := True;
        end;
      end;
    end;

    if boPK and (m_LastHiter <> nil) then
    begin
      guildwarkill := False;
      if (m_MyGuild <> nil) and (m_LastHiter.m_MyGuild <> nil) and (GetGuildRelation(Self, m_LastHiter) = 2) then
        guildwarkill := True;

      Castle := g_CastleManager.InCastleWarArea(Self);
      if ((Castle <> nil) and Castle.m_boUnderWar) or (m_boInFreePKArea) then
        guildwarkill := True;

      // 国战模式杀人不加PK
      if (not guildwarkill) //
        and (TPlayObject(Self).m_btAttatckMode = HAM_NATION) //
        and (TPlayObject(m_LastHiter).m_btAttatckMode = HAM_NATION) //
        and (TPlayObject(Self).m_btNation > 0) //
        and (TPlayObject(m_LastHiter).m_btNation > 0) //
        and (TPlayObject(Self).m_btNation <> TPlayObject(m_LastHiter).m_btNation) then
        guildwarkill := True;

      if not guildwarkill then
      begin
        // Fight2 PK不加PK值
        if not m_PEnvir.m_boFight2Zone then
        begin
          if (g_Config.boKillHumanWinLevel // 1
            or g_Config.boKillHumanWinExp // 1
            or m_PEnvir.m_boPKWINLEVEL // 1
            or m_PEnvir.m_boPKWINEXP // 1
            or m_PEnvir.m_boPKLOSTLEVEL // 1
            or m_PEnvir.m_boPKLOSTEXP) // 1
            and (ALastHiter.m_btRaceServer = RC_PLAYOBJECT) then
          begin
            TPlayObject(Self).PKDie(TPlayObject(ALastHiter));
          end
          else if ALastHiter <> nil then
          begin
            if not m_LastHiter.IsGoodKilling(Self) then
            begin
              { TODO -ochongchong -c修改 : 英雄杀人增加PK值 【2013-08-13】 }
              if (ALastHiter.m_btRaceServer = RC_HEROOBJECT) then
              begin
                (*
                  if g_Config.boHeroKillAddPK then
                  TSmartObject(ALastHiter).IncPkPoint(g_Config.nKillHumanAddPKPoint {100})
                  else
                *)
                if ALastHiter.m_Master <> nil then
                  TSmartObject(ALastHiter.m_Master).IncPkPoint(g_Config.dwKillHeroAddPKPoint { 100 } )
              end
              else if ALastHiter.m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER] then
              begin
                if ALastHiter.m_boDummyObject then
                  TSmartObject(ALastHiter).IncPkPoint(g_Config.nDummyAddPKPoint { 100 } )
                else
                  TSmartObject(ALastHiter).IncPkPoint(g_Config.nKillHumanAddPKPoint { 100 } );
              end
              else if g_Config.boSlaveKillHumanIncPK and (ALastHiter.Master <> nil) then
                TSmartObject(ALastHiter.Master).IncPkPoint(g_Config.nKillHumanAddPKPoint { 100 } );

              if ALastHiter.Master <> nil then
                ALastHiter.Master.SysMsg(g_sYouMurderedMsg { '你犯了谋杀罪！' } , c_Red, t_Hint)
              else
                ALastHiter.SysMsg(g_sYouMurderedMsg { '你犯了谋杀罪！' } , c_Red, t_Hint);

              { TODO -ochongchong -c修改 : 杀人武器诅咒机率 【2013-08-17】 }
              if (Random(g_Config.dwKillHumanWeaponUnlockRate) = 0) then
                ALastHiter.MakeWeaponUnlock;

              // 是否显示神秘人 piaoyun 2013-08-17
              if (m_LastHiter.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) //
                and TSmartObject(m_LastHiter).m_boMysteriousMan //
                and g_Config.boShowMysteriousMan then
              begin
                sChrName := g_Config.sMysteriousManName;
              end
              else
              begin
                if ALastHiter.Master <> nil then
                begin
                  sChrName := ALastHiter.Master.m_sCharName;
                end
                else
                begin
                  if ALastHiter.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
                    sChrName := ALastHiter.m_sCharName
                  else
                    sChrName := DelNumber(ALastHiter.m_sCharName);
                end;
              end;

              SysMsg(Format(g_sYouKilledByMsg, [sChrName]), c_Red, t_Hint);
              ALastHiter.AddBodyLuck(-g_Config.nKillHumanDecLuckPoint { 500 } );
            end
            else
              ALastHiter.SysMsg(g_sYouProtectedByLawOfDefense { '[你受到正当规则保护。]' } , c_Green, t_Hint);
          end;
        end;

        // 检查攻击人是否用了着经验或等级装备
        if (ALastHiter <> nil) and (ALastHiter.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          if TPlayObject(ALastHiter).m_dwPKDieLostExp > 0 then
          begin
            if m_Abil.Exp >= TPlayObject(ALastHiter).m_dwPKDieLostExp then
              Dec(m_Abil.Exp, TPlayObject(ALastHiter).m_dwPKDieLostExp)
            else
              m_Abil.Exp := 0;
          end;

          if TPlayObject(ALastHiter).m_nPKDieLostLevel > 0 then
          begin
            if m_Abil.Level >= TPlayObject(ALastHiter).m_nPKDieLostLevel then
              Dec(m_Abil.Level, TPlayObject(ALastHiter).m_nPKDieLostLevel)
            else
              m_Abil.Level := 0;
          end;
        end;
      end;
    end;
  except
    MainOutMessage(sExceptionMsg2);
  end;

  // 怪物，人形怪死亡时载入MonItems\中的物品 chongchong 2015-04-18
  AttackBaseObject := m_ExpHitter;
  if (m_ExpHitter <> nil) and (m_ExpHitter.m_Master <> nil) then
    AttackBaseObject := m_ExpHitter.Master; // m_ExpHitter.m_Master;

  if m_boMonGetRandomItems then
  begin
    boGetRandItem := True;
    ATempHitter := nil;

    if m_boPreviewMonItem then
    begin
      if ALastHiter <> nil then
      begin
        if (ALastHiter.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          boGetRandItem := not SameText(m_sPreviewMonItemPlayerName, ALastHiter.m_sCharName);
          ATempHitter := TPlayObject(ALastHiter);
        end
        else if (ALastHiter.Master <> nil) and (ALastHiter.Master.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          boGetRandItem := not SameText(m_sPreviewMonItemPlayerName, ALastHiter.Master.m_sCharName);
          ATempHitter := TPlayObject(ALastHiter.Master);
        end;
      end;
    end;

    // 当怪物死亡时，检测透视者影响爆率的变量是否变更，若变更则刷新爆率 2020-10-23
    if (not boGetRandItem) and (ATempHitter <> nil) and (m_PreviewMonItemSaveVarList.Count > 0) then
    begin
      for I := 0 to m_PreviewMonItemSaveVarList.Count - 1 do
      begin
        nReadValue := 0;
        nSaveValue := Integer(m_PreviewMonItemSaveVarList.Objects[I]);
        n01 := GetValNameNo(m_PreviewMonItemSaveVarList.Strings[I]);

        case n01 of
          0 .. 999:
            nReadValue := ATempHitter.m_nVal[n01]; // P
          1000 .. 1999:
            nReadValue := ATempHitter.m_DyVal[n01 - 1000]; // D
          2000 .. 2999:
            nReadValue := ATempHitter.m_nMval[n01 - 2000]; // M
          3000 .. 3999:
            nReadValue := ATempHitter.m_nInteger[n01 - 3000]; // N
          4000 .. 4999:
            nReadValue := g_Config.GlobaDyMval[n01 - 4000]; // I
          5000 .. 5999:
            nReadValue := g_Config.GlobalVal[n01 - 5000]; // G
          8000 .. 8499:
            nReadValue := ATempHitter.m_UVal[n01 - 8000]; // U
          9000 .. 9499:
            nReadValue := ATempHitter.m_JVal[n01 - 9000]; // J
        end;

        if nSaveValue <> nReadValue then
        begin
          boGetRandItem := True;
          Break;
        end;
      end;
    end;

    if boGetRandItem then
    begin
      DropRate := 0;
      DropRate2 := 100;

      if AttackBaseObject <> nil then
      begin
        DropRate := AttackBaseObject.m_WAbil.NewValue[11];

        if (AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) //
          and (TSmartObject(AttackBaseObject).m_dwKillMonBurstRate > 0) then
          DropRate2 := TSmartObject(AttackBaseObject).m_dwKillMonBurstRate
        else if (AttackBaseObject.m_Master <> nil) //
          and (TSmartObject(AttackBaseObject.m_Master).m_boSyncKillMonBurstRate) //
          and (AttackBaseObject.m_Master.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) //
          and (TSmartObject(AttackBaseObject.m_Master).m_dwKillMonBurstRate > 0) then
          DropRate2 := TSmartObject(AttackBaseObject.m_Master).m_dwKillMonBurstRate;
      end;

      UserEngine.MonGetRandomItems(AttackBaseObject, Self, DropRate, DropRate2, False);
    end;
  end;

  nCheckCode := 1000;
  // 掉落相关
  try
    if (not m_PEnvir.m_boFightZone) //
      and (not m_PEnvir.m_boFight3Zone or (m_PEnvir.m_btFight3Flag > 0)) //
      and (not m_PEnvir.m_boFight4Zone) //
      and (not m_boAnimal) then
    begin
      nCheckCode := 1001;
      AttackBaseObject := m_ExpHitter;
      if (m_ExpHitter <> nil) and (m_ExpHitter.m_Master <> nil) then
        AttackBaseObject := m_ExpHitter.Master;

      nCheckCode := 1002;
      if m_btRaceServer <> RC_PLAYOBJECT then
      begin
        nCheckCode := 1003;
        if AttackBaseObject <> nil then
        begin
          nCheckCode := 1004;
          if m_btRaceServer = RC_HEROOBJECT then
          begin
            nCheckCode := 1005;
            if (g_Config.boKillByHumanDropHeroUseItem // 1
              and (AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT])) //
              or (g_Config.boKillByMonstDropHeroUseItem //
              and (not(AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]))) then
              DropUseItems(nil);

            nCheckCode := 1006;
            if (g_Config.boKillByHumanDropHeroJewelryBoxItem // 1
              and (AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT])) //
              or (g_Config.boKillByMonstDropHeroJewelryBoxItem //
              and (not(AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]))) then
              DropJewelryBoxItems(nil);

            nCheckCode := 1007;
            if (g_Config.boKillByHumanDropHeroGodBlessItem // 1
              and (AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT])) //
              or (g_Config.boKillByMonstDropHeroGodBlessItem //
              and (not(AttackBaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]))) then
              DropGodBlessItems(nil);
          end
          else if m_btRaceServer = RC_PLAYMOSTER then
          begin
            nCheckCode := 1008;
            DropUseItems(nil);
            DropJewelryBoxItems(nil);
            DropGodBlessItems(nil);
          end;
        end;

        nCheckCode := 1009;
        if (m_Master = nil) and (not m_boNoItem) { and (AttackBaseObject <> nil) } then
        begin
          if m_btRaceServer = RC_HEROOBJECT then
          begin
            // 英雄爆出的物品可以秒捡 chongchong 2015-03-02 ScatterBagItems(AttackBaseObject);
            if g_Config.boDieScatterHeroBag then
              ScatterBagItems(nil, ALastHiter);
          end
          else
            ScatterBagItems(AttackBaseObject, ALastHiter);
        end;

        nCheckCode := 1010;
        if (m_btRaceServer >= RC_ANIMAL) and (m_Master = nil) and (not m_boNoItem) then
        begin
          nCheckCode := 1011;
          if (AttackBaseObject <> nil) //
            and (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) //
            and (g_Config.boDropGoldToPlayBag) then
          begin
            nCheckCode := 1012;
            if TPlayObject(AttackBaseObject).IncGold(m_nGold) then
            begin
              if m_nGold > 0 then
              begin
                nCheckCode := 1013;
                TPlayObject(AttackBaseObject).GoldChanged();
                nCheckCode := 1014;
              end;
            end
            else
            begin
              nCheckCode := 1015;
              ScatterGolds(AttackBaseObject);
              nCheckCode := 1016;
            end;
          end
          else
          begin
            nCheckCode := 1017;
            ScatterGolds(AttackBaseObject);
            nCheckCode := 1018;
          end;
        end;
      end
      else // 当前对象是玩家
      begin
        nCheckCode := 1019;
        if not m_boNoItem then
        begin { 修改日期2004/07/21，增加此行，允许设置 m_boNoItem 后人物死亡不掉物品 }
          if AttackBaseObject <> nil then
          begin
            nCheckCode := 1020;
            if (g_Config.boKillByHumanDropUseItem // 1
              and (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT)) //
              or (g_Config.boKillByMonstDropUseItem //
              and (AttackBaseObject.m_btRaceServer <> RC_PLAYOBJECT)) then
              DropUseItems(nil);

            nCheckCode := 1021;
            if (g_Config.boKillByHumanDropJewelryBoxItem // 1
              and (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT)) //
              or (g_Config.boKillByMonstDropJewelryBoxItem //
              and (AttackBaseObject.m_btRaceServer <> RC_PLAYOBJECT)) then
              DropJewelryBoxItems(nil);

            nCheckCode := 1021;
            if (g_Config.boKillByHumanDropGodBlessItem // 1
              and (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT)) //
              or (g_Config.boKillByMonstDropGodBlessItem //
              and (AttackBaseObject.m_btRaceServer <> RC_PLAYOBJECT)) then
              DropGodBlessItems(nil);
          end
          else
          begin
            nCheckCode := 1023;
            DropUseItems(nil);
            nCheckCode := 1024;
            DropJewelryBoxItems(nil);
            nCheckCode := 1025;
            DropGodBlessItems(nil);
            nCheckCode := 1026;
          end;

          nCheckCode := 1027;
          if g_Config.boDieScatterBag then
            ScatterBagItems(nil, ALastHiter);

          nCheckCode := 1028;
          if g_Config.boDieDropGold then
            ScatterGolds(nil);
          nCheckCode := 1029;
        end;
        nCheckCode := 1030;
        AddBodyLuck(-(50 - (50 - m_Abil.Level * 5)));
        nCheckCode := 1031;
      end;
    end;

    nCheckCode := 1032;
    if m_PEnvir.m_boFight3Zone then
    begin
      nCheckCode := 1033;
      Inc(m_nFightZoneDieCount);
      if m_MyGuild <> nil then
      begin
        nCheckCode := 1034;
        TGUild(m_MyGuild).TeamFightWhoDead(m_sCharName);
        nCheckCode := 1035;
      end;

      nCheckCode := 1036;
      if m_LastHiter <> nil then
      begin
        nCheckCode := 1037;
        if (m_LastHiter.m_MyGuild <> nil) and (m_MyGuild <> nil) then
        begin
          nCheckCode := 1038;
          TGUild(m_LastHiter.m_MyGuild).TeamFightWhoWinPoint(m_LastHiter.m_sCharName, 100);

          nCheckCode := 1039;
          tStr := TGUild(m_LastHiter.m_MyGuild).sGuildName + ':' + IntToStr(TGUild(m_LastHiter.m_MyGuild).nContestPoint) + '  ' +
            TGUild(m_MyGuild).sGuildName + ':' + IntToStr(TGUild(m_MyGuild).nContestPoint);

          nCheckCode := 1040;
          UserEngine.CryCry(RM_CRY, m_PEnvir, m_nCurrX, m_nCurrY, 1000, g_Config.btCryMsgFColor, g_Config.btCryMsgBColor,
            '- ' + tStr);
        end;
      end;
    end;

    nCheckCode := 1041;
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      nCheckCode := 1042;
      // Jacky 2004/09/05 人物死亡立即退组，以防止组队刷经验
      if TPlayObject(Self).m_GroupOwner <> nil then
        TPlayObject(Self).m_GroupOwner.DelGroupMember(TPlayObject(Self));

      nCheckCode := 1043;
      if m_LastHiter <> nil then
      begin
        if m_LastHiter.m_btRaceServer = RC_PLAYOBJECT then
          tStr := m_LastHiter.m_sCharName
        else
          tStr := '#' + m_LastHiter.m_sCharName;
      end
      else
        tStr := '####';

      nCheckCode := 1044;
      AddGameDataLog(LOG_PlayerDie, LOG_ActionNone, Self, TPlayObject(Self).m_sUserID, 0, tStr, 0, 0,
        'FZ-' + BoolToIntStr(m_PEnvir.m_boFightZone) + ', F3-' + BoolToIntStr(m_PEnvir.m_boFight3Zone));
    end;

    nCheckCode := 1045;
    if m_btRaceServer = RC_PLAYOBJECT then
    begin // 正在挑战
      if TPlayObject(Self).m_boChallengeStart and (TPlayObject(Self).m_ChallengeCreat <> nil) then
      begin
        TPlayObject(Self).SysMsg(g_sChallengeFailMsg, c_Red, t_Hint);
        TPlayObject(Self).m_ChallengeCreat.ChallengeVictory;
      end;
    end;

    nCheckCode := 1046;
    // 减少地图上怪物计数
    if (m_Master = nil) and (not m_boDelFormMaped) then
    begin
      nCheckCode := 1047;
      m_boDelFormMaped := True;
      nCheckCode := 1048;
    end;

    nCheckCode := 1049;
    SendRefMsg(RM_DEATH, m_btDirection, m_nCurrX, m_nCurrY, 1, '');
  except
    MainOutMessage(sExceptionMsg3 + IntToStr(nCheckCode));
  end;

  try
    { 执行杀人和死亡触发 }
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      if ALastHiter <> nil then
      begin
        nCheckCode := 1018;
        if ALastHiterMaster <> nil then
        begin
          nCheckCode := 1019;
          if ALastHiterMaster.m_btRaceServer = RC_PLAYOBJECT then
          begin
            nCheckCode := 1020;
            // 修复@KillPlay 触发取不到 M. chongchong 2014-10-23
            TempTargetCret := ALastHiterMaster.m_TargetCret;
            ALastHiterMaster.m_TargetCret := Self;
            TPlayObject(ALastHiterMaster).KillPlayFunc;
            ALastHiterMaster.m_TargetCret := TempTargetCret;

            (*
              // 英雄杀人 chongchong 2015-11-12
              if ALastHiter.m_btRaceServer = RC_HEROOBJECT then
              begin
              ALastHiter.m_TargetCret := self;

              TempTargetCret := ALastHiterMaster.m_TargetCret;
              ALastHiterMaster.m_TargetCret := self;
              TPlayObject(ALastHiterMaster).HeroKillPlayFunc;
              ALastHiterMaster.m_TargetCret := TempTargetCret;

              nCheckCode := 1023;
              end;
            *)
          end;
        end
        else if ALastHiter.m_btRaceServer = RC_PLAYOBJECT then
        begin
          nCheckCode := 1022;
          if Master <> nil then
            ALastHiter.m_TargetCret := Master
          else
            ALastHiter.m_TargetCret := Self;

          TPlayObject(ALastHiter).KillPlayFunc;
          nCheckCode := 1023;
        end;
      end;

      nCheckCode := 102400;
      TempTargetCret := m_CurrTarget;

      if (ALastHiter <> nil) and (ALastHiter.Master <> nil) then
        m_CurrTarget := ALastHiter.Master
      else
        m_CurrTarget := ALastHiter;

      // 死亡触发要判断是否npc杀的 2019-09-26 00:00:19
      if (m_CurrTarget = nil) and (TempTargetCret <> nil) and (TempTargetCret.m_btRaceServer in [RC_PEACENPC, RC_NPC]) then
        m_CurrTarget := TempTargetCret;

      nCheckCode := 1024;
      TPlayObject(Self).DieFunc(); // 死亡触发

      m_CurrTarget := TempTargetCret;

      nCheckCode := 1025;
    end;

    { 执行杀怪触发 }
    if g_FunctionNPC <> nil then
    begin
      nCheckCode := 1026;
      AttackBaseObject := m_CurrTarget;
      nCheckCode := 1027;

      if (m_CurrTarget <> nil) and (m_CurrTarget.m_Master <> nil) then
        AttackBaseObject := m_CurrTarget.Master;

      nCheckCode := 1028;
      if (m_btRaceServer <> 108) //
        and (not((m_btRaceServer = 154) and (m_btRaceImg = 156) { 自定义怪物 - 魔王岭怪物 } )) //
        and (m_btRaceServer >= RC_ANIMAL) //
        and (AttackBaseObject <> nil) then
      begin
        if AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          if g_Config.boGamePetKillMonTrigger //
            and (ALastHiter <> nil) //
            and (ALastHiter.m_boGamePet) //
            and (ALastHiter.m_CurrTarget <> nil) //
            and (not ALastHiter.m_CurrTarget.bo94) then
          begin
            g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@GamePetKillMon', False);
          end
          else if g_Config.boHeroKillMonTrigger //
            and (ALastHiter <> nil) //
            and (ALastHiter.m_btRaceServer = RC_HEROOBJECT) //
            and (ALastHiter.m_CurrTarget <> nil) //
            and (not ALastHiter.m_CurrTarget.bo94) then
          begin
            g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@HeroKillMon', False);
          end
          else
          begin
            nCheckCode := 1029;

            // 修复镖车劫镖BUG piaoyun 2013-08-21
            if (AttackBaseObject.m_CurrTarget <> nil) and (not AttackBaseObject.m_CurrTarget.bo94) then
            begin
              TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
              TPlayObject(AttackBaseObject).m_sLastKillMonName := m_sCharName;
              g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@KillMon', False);
            end;
            nCheckCode := 1030;

            if (TPlayObject(AttackBaseObject).m_PEnvir <> nil) and TPlayObject(AttackBaseObject).m_PEnvir.m_boOnKillMob then
            begin
              TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
              TPlayObject(AttackBaseObject).m_sLastKillMonName := m_sCharName;
              g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@OnKillMob', False);
            end;

            nCheckCode := 1031;
            if AMaster <> nil then
            begin
              nCheckCode := 1032;
              // 修复镖车劫镖BUG piaoyun 2013-08-21
              // 修复引擎假人报错1 piaoyun 2013-11-13
              TPlayObject(AttackBaseObject).m_nScriptGotoCount := 0;
              if (AttackBaseObject.m_CurrTarget <> nil) and (not AttackBaseObject.m_CurrTarget.bo94) then
                g_FunctionNPC.GotoLable(TPlayObject(AttackBaseObject), '@KillSlave', False);
            end;
          end;
        end;

        if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          TPlayObject(m_Master).m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@OnSlaveDie', False);
        end
        else if (m_Master <> nil) //
          and (m_Master.m_btRaceServer = RC_HEROOBJECT) //
          and (Master <> nil) //
          and (Master.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          TPlayObject(Master).m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(TPlayObject(Master), '@OnHeroSlaveDie', False);
        end;
      end;

      if (AttackBaseObject <> nil) //
        and (AttackBaseObject.m_btRaceServer = RC_PLAYOBJECT) //
        and (TPlayObject(AttackBaseObject).m_GroupOwner <> nil) //
        and (TPlayObject(AttackBaseObject).m_GroupOwner.m_GroupMembers <> nil) then
      begin
        Players := TList.Create;
        try
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            TPlayObject(AttackBaseObject).m_GroupOwner.m_GroupMembers.LockR(7);
          try
{$IFEND}
            if (TPlayObject(AttackBaseObject).m_GroupOwner.m_GroupMembers.Count > 0) then
            begin
              nCheckCode := 1035;
              for I := 0 to TPlayObject(AttackBaseObject).m_GroupOwner.m_GroupMembers.Count - 1 do
              begin
                nCheckCode := 1036;
                GroupHuman := TPlayObject(TPlayObject(AttackBaseObject).m_GroupOwner.m_GroupMembers.Objects[I]);
                nCheckCode := 1037;

                if GroupHuman <> nil then
                begin
                  nCheckCode := 1038;
                  Players.Add(GroupHuman);
                end;
              end;
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              TPlayObject(AttackBaseObject).m_GroupOwner.m_GroupMembers.UnLockR;
          end;
{$IFEND}
          for I := 0 to Players.Count - 1 do
          begin
            GroupHuman := Players.Items[I];
            nCheckCode := 1039;
            GroupHuman.m_nScriptGotoCount := 0;

            nCheckCode := 1040;
            g_FunctionNPC.GotoLable(GroupHuman, '@GroupKillMon', False);
          end;
        finally
          Players.Free;
        end;
      end;
    end;
  except
    MainOutMessage(sExceptionMsg4 + IntToStr(nCheckCode));
  end;

  if (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) and m_boGamePet then
  begin
    if TPlayObject(m_Master).m_MyGamePet = Self then
    begin
      // 修正宠物死亡后会掉等级 chongchong 2019-05-06 22:57:36
      if (TPlayObject(m_Master).m_MyGamePetIndex >= 0) //
        and (TPlayObject(m_Master).m_MyGamePetIndex < TPlayObject(m_Master).m_GamePetList.Count) then
      begin
        GamePetData := TPlayObject(m_Master).m_GamePetList.Items[TPlayObject(m_Master).m_MyGamePetIndex];

        GamePetData.Level := m_WAbil.Level;

        // 血量加满，不然召唤出来分分钟又死
        GamePetData.HP := m_WAbil.MaxHP;
        GamePetData.MP := m_WAbil.MP;
        GamePetData.Exp := m_WAbil.Exp;
        GamePetData.DieTick := MyGetTickCount;
      end;

      TPlayObject(m_Master).m_sMyGamePetName := m_sCharName;
      TPlayObject(m_Master).m_MyGamePet := nil;
      TPlayObject(m_Master).m_LastMyGamePetIndex := TPlayObject(m_Master).m_MyGamePetIndex;
      TPlayObject(m_Master).m_MyGamePetIndex := -1;
      TPlayObject(m_Master).SendCurrentRecalGamePetIndex(-1);

      TPlayObject(m_Master).RecalcAbilitys;
      TPlayObject(m_Master).SendMsg(m_Master, RM_ABILITY, 0, 0, 0, 0, '');
      TPlayObject(m_Master).SendMsg(m_Master, RM_SUBABILITY, 0, 0, 0, 0, '');

      m_Master := nil;
    end;
  end;

  if g_PluginManager <> nil then
    g_PluginManager.HookBaseObjectDie(Self);

  if (m_PEnvir.m_boGuardianLevel) and (m_PEnvir.m_boStartGuardianLevel) then
    Dec(m_PEnvir.m_nGuardinaLevelMonCount);
end;

function TSmartObject.DoItemFluteStoneEx(UserItem: pTUserItem; StoneItemName: string; var StoneUserItem: pTUserItem;
  var nStoneDelIndex: Integer): Integer;

// 获取相同Anicount宝石的数量
  function GetAnicountFluteCount(Item: pTUserItem; Anicount: Integer): Integer;
  var
    I: Integer;
    StdItem: pTStdItem;
  begin
    Result := 0;

    for I := 0 to Item.btFluteCount - 1 do
    begin
      if (I in [0 .. MAX_FLUTE_COUNT - 1]) then
      begin
        if Item.Flutes[I].GemIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(Item.Flutes[I].GemIndex);
          if (StdItem <> nil) and (StdItem.Anicount = Anicount) then
            Inc(Result, Max(1, Item.Flutes[I].GemCount));
        end;
      end;
    end;
  end;

// 获取相同idx宝石数量 chongchong 2015-05-20
  function GetIdxFluteCount(Item: pTUserItem; nItemIdx: Integer): Integer;
  var
    I: Integer;
  begin
    Result := 0;

    for I := 0 to Item.btFluteCount - 1 do
    begin
      if (I in [0 .. MAX_FLUTE_COUNT - 1]) then
      begin
        if (Item.Flutes[I].GemIndex > 0) and (Item.Flutes[I].GemIndex = nItemIdx) then
          Inc(Result, Max(1, Item.Flutes[I].GemCount));
      end;
    end;
  end;

var
  StdItem, StdItem2: pTStdItem;
  StoneItem: pTUserItem;
  I, J: Integer;
  sName: string;
begin
  Result := 1;
  if (UserItem = nil) or (Length(StoneItemName) = 0) then
    Exit;

  StdItem2 := UserEngine.GetStdItem(UserItem.wIndex);
  if (StdItem2 = nil) or (not CheckInlaidGemstone(StdItem2.StdMode)) then
  begin
    Result := 2;
    Exit;
  end;

  nStoneDelIndex := -1;
  try
    // 获取背包中的物品
    for I := m_ItemList.Count - 1 downto 0 do
    begin
      StoneItem := m_ItemList[I];
      if StoneItem = nil then
        Continue;

      StdItem := UserEngine.GetStdItem(StoneItem.wIndex);
      if StdItem = nil then
        Continue;

      if (StdItem.StdMode <> 46) and (StdItem.Shape <> 3) then
        Continue;

      if (StoneItem.btValue[13] = 1) and (Length(StoneItem.Name) > 0) then
        sName := StoneItem.Name
      else
        sName := StdItem.Name;

      if SameText(sName, StoneItemName) then
      begin
        StoneUserItem := StoneItem;
        nStoneDelIndex := I;

        if (UserItem.btFluteCount > 0) and (UserItem.btFluteCount <= MAX_FLUTE_COUNT) then
        begin
          if (g_Config.nItemFluteStoneCount > 0) and
            (g_Config.nItemFluteStoneCount <= GetAnicountFluteCount(UserItem, StdItem.Anicount)) then
          begin
            Result := 2;
            Exit;
          end;

          if (g_Config.nItemFluteStoneIdxCount > 0) and
            (g_Config.nItemFluteStoneIdxCount <= GetIdxFluteCount(UserItem, StoneItem.wIndex)) then
          begin
            Result := 3;
            Exit;
          end;

          if g_Config.nItemFluteStoneOverlapCount > 1 then
          begin
            for J := 0 to UserItem.btFluteCount - 1 do
            begin
              if (J in [0 .. MAX_FLUTE_COUNT - 1]) then
              begin
                if (Max(1, UserItem.Flutes[I].GemCount) < g_Config.nItemFluteStoneOverlapCount) and
                  (UserItem.Flutes[J].GemIndex = StoneUserItem.wIndex) then
                begin
                  if UserItem.Flutes[I].GemCount = 0 then
                    UserItem.Flutes[I].GemCount := 1;

                  Inc(UserItem.Flutes[I].GemCount);

                  if StdItem2.NeedIdentify = 1 then
                    AddGameDataLog(LOG_ItemInlaid, LOG_ActionNone, Self, StdItem2.Name, UserItem.MakeIndex, StdItem.Name);

                  if StdItem.NeedIdentify = 1 then
                    AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, StoneItem.MakeIndex, StdItem2.Name, 0,
                      0, '镶嵌使用');

                  Result := 0;
                  Exit;
                end;
              end;
            end;
          end;

          for J := 0 to UserItem.btFluteCount - 1 do
          begin
            if (J in [0 .. MAX_FLUTE_COUNT - 1]) then
            begin
              if (UserItem.Flutes[J].GemIndex = 0) then
              begin
                UserItem.Flutes[I].GemIndex := StoneItem.wIndex;
                UserItem.Flutes[I].GemCount := 1;

                if StdItem2.NeedIdentify = 1 then
                  AddGameDataLog(LOG_ItemInlaid, LOG_ActionNone, Self, StdItem2.Name, UserItem.MakeIndex, StdItem.Name);

                if StdItem.NeedIdentify = 1 then
                  AddGameDataLog(LOG_ItemDisappear, LOG_ActionNone, Self, StdItem.Name, StoneItem.MakeIndex, StdItem2.Name, 0,
                    0, '镶嵌使用');

                Result := 0;
                Exit;
              end;
            end;
          end;
        end;
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TPlayObject:DoItemFluteStone ' + m_sCharName);
      MainOutMessage(E.Message);
    end;
  end;
end;

// 直接给装备增加宝石 （背包无需宝石）
function TSmartObject.DoItemAddStone(UserItem: pTUserItem; StoneItemName: string; nStoneIndex: Integer;
  var StoneUserItemIndex: Integer): Integer;
// 获取相同Anicount宝石的数量
  function GetAnicountFluteCount(Item: pTUserItem; Anicount: Integer): Integer;
  var
    I: Integer;
    StdItem: pTStdItem;
  begin
    Result := 0;
    for I := 0 to Item.btFluteCount - 1 do
    begin
      if (I in [0 .. MAX_FLUTE_COUNT - 1]) then
      begin
        if (nStoneIndex > 0) and (I = nStoneIndex - 1) then
          Continue;

        if Item.Flutes[I].GemIndex > 0 then
        begin
          StdItem := UserEngine.GetStdItem(Item.Flutes[I].GemIndex);
          if (StdItem <> nil) and (StdItem.Anicount = Anicount) then
            Inc(Result, Max(1, Item.Flutes[I].GemCount));
        end;
      end;
    end;
  end;

// 获取相同idx宝石数量 chongchong 2015-05-20
  function GetIdxFluteCount(Item: pTUserItem; nItemIdx: Integer): Integer;
  var
    I: Integer;
  begin
    Result := 0;
    for I := 0 to Item.btFluteCount - 1 do
    begin
      if (I in [0 .. MAX_FLUTE_COUNT - 1]) then
      begin
        if (nStoneIndex > 0) and (I = nStoneIndex - 1) then
          Continue;

        if (Item.Flutes[I].GemIndex > 0) and (Item.Flutes[I].GemIndex = nItemIdx) then
          Inc(Result, Max(1, Item.Flutes[I].GemCount));
      end;
    end;
  end;

var
  StdItem: pTStdItem;
  StoneItem: pTStdItem;
  J, StoneItemIndex: Integer;
begin
  Result := 1;
  if (UserItem = nil) or (Length(StoneItemName) = 0) then
    Exit;

  StdItem := UserEngine.GetStdItem(UserItem.wIndex);
  if (StdItem = nil) or (not CheckInlaidGemstone(StdItem.StdMode)) then
  begin
    Result := 2;
    Exit;
  end;

  StoneItemIndex := -1;
  StoneItem := UserEngine.GetStdItemEx(StoneItemName, StoneItemIndex);
  if StoneItemIndex < 0 then
  begin
    Result := 3;
    Exit;
  end;

  if StoneItem = nil then
  begin
    Result := 4;
  end;

  if (StoneItem.StdMode <> 46) and (StoneItem.Shape <> 3) then
  begin
    Result := 5;
    Exit;
  end;

  try
    if (UserItem.btFluteCount > 0) and (UserItem.btFluteCount <= MAX_FLUTE_COUNT) then
    begin
      if (g_Config.nItemFluteStoneCount > 0) and
        (g_Config.nItemFluteStoneCount <= GetAnicountFluteCount(UserItem, StoneItem.Anicount)) then
      begin
        Result := 6;
        Exit;
      end;

      if (g_Config.nItemFluteStoneIdxCount > 0) and
        (g_Config.nItemFluteStoneIdxCount <= GetIdxFluteCount(UserItem, StoneItemIndex)) then
      begin
        Result := 7;
        Exit;
      end;

      if (nStoneIndex <= 0) or (nStoneIndex > MAX_FLUTE_COUNT) then
      begin
        if g_Config.nItemFluteStoneOverlapCount > 1 then
        begin
          for J := 0 to UserItem.btFluteCount - 1 do
          begin
            if (J in [0 .. MAX_FLUTE_COUNT - 1]) then
            begin
              if (Max(1, UserItem.Flutes[J].GemCount) < g_Config.nItemFluteStoneOverlapCount) and
                (UserItem.Flutes[J].GemIndex = StoneItemIndex) then
              begin
                if UserItem.Flutes[J].GemCount = 0 then
                  UserItem.Flutes[J].GemCount := 1;

                Inc(UserItem.Flutes[J].GemCount);

                if StdItem.NeedIdentify = 1 then
                  AddGameDataLog(LOG_ItemInlaid, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, StoneItem.Name, 0, 0,
                    'ItemAddStone无宝石镶嵌');

                Result := 0;
                Exit;
              end;
            end;
          end;
        end;

        for J := 0 to UserItem.btFluteCount - 1 do
        begin
          if (J in [0 .. MAX_FLUTE_COUNT - 1]) then
          begin
            if (UserItem.Flutes[J].GemIndex = 0) then
            begin
              UserItem.Flutes[J].GemIndex := StoneItemIndex;
              UserItem.Flutes[J].GemCount := 1;

              if StdItem.NeedIdentify = 1 then
                AddGameDataLog(LOG_ItemInlaid, LOG_ActionNone, Self, StdItem.Name, UserItem.MakeIndex, StoneItem.Name, 0, 0,
                  'ItemAddStone无宝石镶嵌');

              Result := 0;
              Exit;
            end;
          end;
        end;
      end
      else
      begin
        UserItem.Flutes[nStoneIndex - 1].GemIndex := StoneItemIndex;
        UserItem.Flutes[nStoneIndex - 1].GemCount := 1;

        StoneUserItemIndex := StoneItemIndex;
        Result := 0;
        Exit;
      end;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] TPlayObject:DoItemFluteStone ' + m_sCharName);
      MainOutMessage(E.Message);
    end;
  end;
end;

