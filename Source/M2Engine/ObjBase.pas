          end;
          GetFrontPosition(nX, nY);
          if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nX, nY, False) then
          begin
            m_nCurrX := nX;
            m_nCurrY := nY;
            SendRefMsg(RM_RUSH, nDir, m_nCurrX, m_nCurrY, 0, '');
            Result := True;
          end;
          Dec(n24);
        end; // 004C32D7  if PoseCreate <> nil  then begin
      end; // 004C32DD for i:=0 to Max(2,nMagicLevel + 1) do begin
    end;
  end;
  if (BaseObject_34 <> nil) then
  begin
    if n24 < 0 then
      n24 := 0;
    n20 := Random((n24 + 1) * 10) + ((n24 + 1) * 10);
    MagicACInfo := nil;
    // MagicACInfo := UserEngine.m_MagicACList.Get(SKILL_MOOTEBO);
    // n20 := BaseObject_34.GetHitStruckDamage(Self, n20, MagicACInfo, 2);
    if not CanCloseDefense then // 忽视目标防御
      n20 := BaseObject_34.GetHitStruckDamage(Self, n20, MagicACInfo)
    else
      n20 := BaseObject_34.GetHitStruckDamage(Self, n20, MagicACInfo, 4); // 不忽视盾防御 ++++++++++++  2020-11-09 23:46:37
    n20 := BaseObject_34.NewAbilPower(2, n20); // 物伤减少
    n20 := NewAbilPower(1, n20); // 元素增加攻击伤害
    n20 := BaseObject_34.StruckDamage(n20, Self, 27);
    BaseObject_34.SendRefMsg(RM_STRUCK, n20, BaseObject_34.m_WAbil.HP, BaseObject_34.m_WAbil.MaxHP, NativeInt(Self), '');
    if BaseObject_34.m_btRaceServer <> RC_PLAYOBJECT then
    begin
      BaseObject_34.SendMsg(BaseObject_34, RM_STRUCK, n20, BaseObject_34.m_WAbil.HP, BaseObject_34.m_WAbil.MaxHP,
        NativeInt(Self), '');
    end;
    // 修正英雄使用野蛮冲撞不触发
    m_wCurrMagicId := 27;
    m_CurrTarget := BaseObject_34;
    if (BaseObject_34 <> Self) and (g_FunctionNPC <> nil) and (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and
      (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(m_Master).m_nLastPKPower := n20 + m_MagicShieldDecMP;
      try
        TPlayObject(m_Master).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(m_Master), '@HeroMagicAttack', False);
        GiveHitterExp(Self, True, 0);
      except
        MainOutMessage('[Exception] TSmartObject:DoMotaebo GotoLable @HeroMagicAttack');
      end;
      BaseObject_34.m_CurrTarget := Self;
      BaseObject_34.m_wCurrMagicId := 27;
      if (BaseObject_34.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        BaseObject_34.m_nStruckHP := n20 + m_MagicShieldDecMP;
        TPlayObject(BaseObject_34).m_nScriptGotoCount := 0;
        try
          g_FunctionNPC.GotoLable(TPlayObject(BaseObject_34), '@HeroMagicStruck', False);
        except
          MainOutMessage('[Exception] TSmartObject:DoMotaebo GotoLable @HeroMagicStruck');
        end;
      end;
    end;
  end;
end;

function TSmartObject.Spell(UserMagic: pTUserMagic; nTargetX, nTargetY: Integer; TargeTBaseObject: TBaseObject): Boolean;
var
  nSpellPoint: Integer;
  n14: Integer;
  BaseObject: TBaseObject;
  MagicRange: Integer;
begin
  Result := False;
  if m_boDeath then
    Exit;
  if (not CanMove) then
  begin
    if (not g_Config.boStartGameAuxiliary) or (not g_Config.ClientConfigs[38]) or (not g_Config.boParalyCanSpell) then
      Exit; // 防石化
  end;
  MagicManager.IsWarrSkill(UserMagic.wMagIdx);
  Dec(m_nSpellTick, 450);
  m_nSpellTick := Max(0, m_nSpellTick);
  if UserMagic.wMagIdx = SKILL_ERGUM { 12 } then
  begin // 刺杀剑法
    if m_MagicErgumSkill <> nil then
    begin
      if not m_boUseThrusting then
      begin
        ThrustingOnOff(True);
      end
      else
      begin
        ThrustingOnOff(False);
      end;
    end;
    Result := True;
  end
  else if UserMagic.wMagIdx = SKILL_BANWOL { 25 } then
  begin // 半月弯刀
    if m_MagicBanwolSkill <> nil then
    begin
      if not m_boUseHalfMoon then
      begin
        HalfMoonOnOff(True);
      end
      else
      begin
        HalfMoonOnOff(False);
      end;
    end;
    Result := True;
  end
  else if UserMagic.wMagIdx = SKILL_FIRESWORD { 26 } then
  begin // 烈火剑法
    if m_MagicFireSwordSkill <> nil then
    begin
      if AllowFireHitSkill then
      begin
        nSpellPoint := GetSpellPoint(UserMagic);
        if m_WAbil.MP >= nSpellPoint then
        begin
          if nSpellPoint > 0 then
          begin
            DamageSpell(nSpellPoint);
            HealthSpellChanged();
          end;
        end;
      end;
    end;
    Result := True;
  end
  else if UserMagic.wMagIdx = SKILL_MOOTEBO { 27 } then
  begin // 野蛮冲撞
    Result := True;
    if MyGetTickCount - m_SkillUseTick[27] > 1000 * 10 then
    begin
      m_SkillUseTick[27] := MyGetTickCount;
      // m_btDirection := nTargetX;
      nSpellPoint := GetSpellPoint(UserMagic);
      if m_WAbil.MP >= nSpellPoint then
      begin
        if nSpellPoint > 0 then
        begin
          DamageSpell(nSpellPoint);
          HealthSpellChanged();
        end;
        m_btDirection := GetNextDirection(m_nCurrX, m_nCurrY, m_TargetCret.m_nCurrX, m_TargetCret.m_nCurrY);
        if DoMotaebo(m_btDirection, UserMagic.btLevel) then
        begin
          if UserMagic.btLevel < 3 then
          begin
            if (UserMagic.MagicInfo <> nil) and (UserMagic.MagicInfo.TrainLevel[UserMagic.btLevel] < m_Abil.Level) then
            begin
              TrainSkill(UserMagic, Random(3) + 1);
              if not CheckMagicLevelup(UserMagic) then
              begin
                SendDelayMsg(Self, RM_MAGIC_LVEXP, 0, UserMagic.MagicInfo.wMagicID,
                  MakeWord(UserMagic.btLevel, UserMagic.btNewLevel), UserMagic.nTranPoint,
                  IntToStr(Integer(UserMagic.MagicAttr)), 1000);
              end;
            end;
          end;
        end;
      end;
    end;
  end
  else if UserMagic.wMagIdx = SKILL_40 then
  begin // 双龙斩 抱月刀法
    if m_MagicCrsSkill <> nil then
    begin
      if not m_boCrsHitkill then
      begin
        SkillCrsOnOff(True);
      end
      else
      begin
        SkillCrsOnOff(False);
      end;
    end;
    Result := True;
  end
  else if UserMagic.wMagIdx = SKILL_42 { 42 } then
  begin // 龙影剑法     ID=42
    if m_Magic42Skill <> nil then
    begin
      if Allow42HitSkill then
      begin
        nSpellPoint := GetSpellPoint(UserMagic);
        if m_WAbil.MP >= nSpellPoint then
        begin
          if nSpellPoint > 0 then
          begin
            DamageSpell(nSpellPoint);
            HealthSpellChanged();
          end;
        end;
      end;
    end;
    Result := True;
  end
  else if UserMagic.wMagIdx = SKILL_43 then
  begin // 雷霆剑法
    if m_Magic43Skill <> nil then
    begin
      if not m_bo43Skill then
      begin
        Skill43OnOff(True);
      end
      else
      begin
        Skill43OnOff(False);
      end;
    end;
    Result := True;
  end
  else if UserMagic.wMagIdx = SKILL_66 then
  begin // 开天斩
    if m_Magic66Skill <> nil then
    begin
      if Allow66HitSkill(m_TargetCret) then
      begin
        nSpellPoint := GetSpellPoint(UserMagic);
        if m_WAbil.MP >= nSpellPoint then
        begin
          if nSpellPoint > 0 then
          begin
            DamageSpell(nSpellPoint);
            HealthSpellChanged();
          end;
        end;
      end;
    end;
    Result := True;
  end
  else if UserMagic.wMagIdx = SKILL_113 then
  begin // 断空斩
    if m_Magic113Skill <> nil then
    begin
      if Allow113HitSkill then
      begin
        nSpellPoint := GetSpellPoint(UserMagic);
        if m_WAbil.MP >= nSpellPoint then
        begin
          if nSpellPoint > 0 then
          begin
            DamageSpell(nSpellPoint);
            HealthSpellChanged();
          end;
        end;
      end;
    end;
    Result := True;
  end
  else if UserMagic.wMagIdx = SKILL_115 then
  begin // 断空斩
    if m_Magic115Skill <> nil then
    begin
      if Allow115HitSkill then
      begin
        if not((m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and g_Config.boSkill115UseNG) then
        begin
          nSpellPoint := GetSpellPoint(UserMagic);
          if m_WAbil.MP >= nSpellPoint then
          begin
            if nSpellPoint > 0 then
            begin
              DamageSpell(nSpellPoint);
              HealthSpellChanged();
            end;
          end;
        end;
      end;
    end;
    Result := True;
  end
  else if UserMagic.wMagIdx = SKILL_56 then
  begin // 逐日剑法
    if m_MagicSwordSkill <> nil then
    begin
      if AllowSWordHitSkill then
      begin
        nSpellPoint := GetSpellPoint(UserMagic);
        if m_WAbil.MP >= nSpellPoint then
        begin
          if nSpellPoint > 0 then
          begin
            DamageSpell(nSpellPoint);
            HealthSpellChanged();
          end;
        end;
      end;
    end;
    Result := True;
  end
  else
  begin
    n14 := GetNextDirection(m_nCurrX, m_nCurrY, nTargetX, nTargetY);
    m_btDirection := n14;
    BaseObject := nil;
    // 检查目标角色，与目标座标误差范围，如果在误差范围内则修正目标座标
    if (UserMagic.wMagIdx = SKILL_HEALLING) { 2 治愈术 } or (UserMagic.wMagIdx = SKILL_HANGMAJINBUB) { 14 幽灵盾 } or
      (UserMagic.wMagIdx = SKILL_DEJIWONHO) { 15 神圣战甲术 } or (UserMagic.wMagIdx = SKILL_BIGHEALLING) { 29 群体治愈术 } or
    // SKILL_SINSU, {30 召唤神兽}
      (UserMagic.wMagIdx = SKILL_UNAMYOUNSUL) { 34 解毒术 } then
    begin
      if m_boSelSelf then
      begin
        BaseObject := Self;
        nTargetX := m_nCurrX;
        nTargetY := m_nCurrY;
      end
      else
      begin
        if m_Master <> nil then
        begin
          BaseObject := m_Master;
          nTargetX := m_Master.m_nCurrX;
          nTargetY := m_Master.m_nCurrY;
        end
        else
        begin
          BaseObject := Self;
          nTargetX := m_nCurrX;
          nTargetY := m_nCurrY;
        end;
      end;
      n14 := GetNextDirection(m_nCurrX, m_nCurrY, nTargetX, nTargetY);
      m_btDirection := n14;
    end
    else
    begin
      // 人形怪倚天劈地隔远了打不到 chongchong 2014-08-13
      if UserMagic.wMagIdx = SKILL_114 then
        MagicRange := g_Config.nSkill114AttackRange
      else
        MagicRange := g_Config.nMagicLockRange;
      if CretInNearXY(TargeTBaseObject, nTargetX, nTargetY, MagicRange) then
      begin
        BaseObject := TargeTBaseObject;
        nTargetX := BaseObject.m_nCurrX;
        nTargetY := BaseObject.m_nCurrY;
        n14 := GetNextDirection(m_nCurrX, m_nCurrY, nTargetX, nTargetY);
        m_btDirection := n14;
      end;
    end;
    if not DoSpell(UserMagic, nTargetX, nTargetY, BaseObject) then
    begin
      SendRefMsg(RM_MAGICFIREFAIL, 0, 0, 0, 0, '');
    end;
    Result := True;
  end;
end;

function TSmartObject.DoSpell(UserMagic: pTUserMagic; nTargetX, nTargetY: Integer; BaseObject: TBaseObject;
  FormClient: Boolean): Boolean;
var
  nSpellPoint: Integer;
  ErrCode: Integer;
  DecHP: Int64;
  Player: TPlayObject;
  CustomMagicConfig: TCustomMagicConfig;
begin
  Result := False;
  ErrCode := 1;
  try
    if not MagicManager.IsWarrSkill(UserMagic.wMagIdx) then
    begin
      ErrCode := 10;
      nSpellPoint := GetSpellPoint(UserMagic);
      ErrCode := 11;
      case m_btRaceServer of
        RC_PLAYMOSTER:
          begin
            ErrCode := 12;
            if not m_boInfiniteMagic then
            begin
              ErrCode := 13;
              if nSpellPoint > 0 then
              begin
                ErrCode := 14;
                if m_WAbil.MP < nSpellPoint then
                  Exit;
                DamageSpell(nSpellPoint);
                ErrCode := 15;
                HealthSpellChanged();
              end;
            end;
          end;
        RC_HEROOBJECT, RC_MOONOBJECT:
          begin
            ErrCode := 16;
            if not m_boContinuous then
            begin // 非连击状态
              ErrCode := 17;
              if nSpellPoint > 0 then
              begin
                if m_btRaceServer = RC_HEROOBJECT then
                begin
                  if g_Config.boSkill114AttackUseNG and (UserMagic.wMagIdx in [SKILL_114 { 倚天辟地 } ]) then
                  begin // 道士连击
                    if (not m_boTrainingNG) then
                    begin
                      Exit;
                    end;
                    // 检测内力值是否达到要求 piaoyun 2013-09-13
                    if m_AbilNG.NH < nSpellPoint then
                      Exit;
                    ErrCode := 22;
                    m_AbilNG.NH := Max(0, m_AbilNG.NH - nSpellPoint);
                    RefAbilNH;
                  end
                  else if g_Config.boSkill115UseNG and (UserMagic.wMagIdx in [SKILL_116, SKILL_117 { 血魄一击(法), 血魄一击(道) } ]) then
                  begin
                    if (not m_boTrainingNG) then
                    begin
                      if g_Config.boSkill115NGNoEnoughDecHP then
                      begin
                        if g_Config.nSkill115NGNoEnoughDecHPType = 0 then
                        begin
                          DecHP := Round(m_WAbil.HP / 100 * g_Config.nSkill115NGNoEnoughDecHPValue);
                          if m_WAbil.HP <= DecHP + 1 then
                          begin
                            Exit;
                          end;
                          m_WAbil.HP := m_WAbil.HP - DecHP;
                          HealthSpellChanged();
                        end
                        else
                        begin
                          DecHP := g_Config.nSkill115NGNoEnoughDecHPValue;
                          if m_WAbil.HP <= DecHP + 1 then
                          begin
                            Exit;
                          end;
                          m_WAbil.HP := m_WAbil.HP - DecHP;
                          HealthSpellChanged();
                        end;
                      end
                      else
                      begin
                        Exit;
                      end;
                    end
                    else
                    begin
                      // 检测内力值是否达到要求 piaoyun 2013-09-13
                      if (m_AbilNG.NH < nSpellPoint) then
                      begin
                        if g_Config.boSkill115NGNoEnoughDecHP then
                        begin
                          if g_Config.nSkill115NGNoEnoughDecHPType = 0 then
                          begin
                            DecHP := Round(m_WAbil.HP / 100 * g_Config.nSkill115NGNoEnoughDecHPValue);
                            if m_WAbil.HP <= DecHP + 1 then
                            begin
                              Exit;
                            end;
                            m_WAbil.HP := m_WAbil.HP - DecHP;
                            HealthSpellChanged();
                          end
                          else
                          begin
                            DecHP := g_Config.nSkill115NGNoEnoughDecHPValue;
                            if m_WAbil.HP <= DecHP + 1 then
                            begin
                              Exit;
                            end;
                            m_WAbil.HP := m_WAbil.HP - DecHP;
                            HealthSpellChanged();
                          end;
                        end
                        else
                        begin
                          Exit;
                        end;
                      end
                      else
                      begin
                        ErrCode := 22;
                        m_AbilNG.NH := Max(0, m_AbilNG.NH - nSpellPoint);
                        RefAbilNH;
                      end;
                    end;
                  end
                  /// ///////////////////////////////////////////////////////////////
                  else
                  begin
                    ErrCode := 23;
                    if m_WAbil.MP < nSpellPoint then
                      Exit;
                    DamageSpell(nSpellPoint);
                    HealthSpellChanged();
                  end;
                end
                else
                begin
                  ErrCode := 18;
                  if m_WAbil.MP < nSpellPoint then
                    Exit;
                  DamageSpell(nSpellPoint);
                  ErrCode := 19;
                  HealthSpellChanged();
                end;
              end;
            end;
          end;
      else
        begin
          ErrCode := 20;
          if not m_boContinuous then
          begin // 非连击状态
            if nSpellPoint > 0 then
            begin
              ErrCode := 21;
              { TODO -ochongchong -c修改 : 倚天辟地增加需要内力值释放 【chongchong】 2013-08-27 }
              /// ///////////////////////////////////////////////////////////////
              // 二次修改 : 倚天辟地增加需要魔法或内力值释放 piaoyun 2013-09-13
              if g_Config.boSkill114AttackUseNG and (UserMagic.wMagIdx in [SKILL_114 { 倚天辟地 } ]) then // 道士连击
              begin
                if (not m_boTrainingNG) then
                begin
                  if (UserMagic.MagicInfo <> nil) then
                    SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '没有学习内力，无法使用' + UserMagic.MagicInfo.sMagicName);
                  Exit;
                end;
                // 检测内力值是否达到要求 piaoyun 2013-09-13
                if m_AbilNG.NH < nSpellPoint then
                  Exit;
                ErrCode := 22;
                m_AbilNG.NH := Max(0, m_AbilNG.NH - nSpellPoint);
                RefAbilNH;
              end
              else if g_Config.boSkill115UseNG and (UserMagic.wMagIdx in [SKILL_116, SKILL_117 { 血魄一击(法), 血魄一击(道) } ]) then
              begin
                if (not m_boTrainingNG) then
                begin
                  if g_Config.boSkill115NGNoEnoughDecHP then
                  begin
                    if g_Config.nSkill115NGNoEnoughDecHPType = 0 then
                    begin
                      DecHP := Round(m_WAbil.HP / 100 * g_Config.nSkill115NGNoEnoughDecHPValue);
                      if (m_WAbil.HP <= DecHP + 1) then
                      begin
                        if (UserMagic.MagicInfo <> nil) then
                          SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '血量不足，无法使用' + UserMagic.MagicInfo.sMagicName);
                        Exit;
                      end;
                      m_WAbil.HP := m_WAbil.HP - DecHP;
                      HealthSpellChanged();
                    end
                    else
                    begin
                      DecHP := g_Config.nSkill115NGNoEnoughDecHPValue;
                      if (m_WAbil.HP <= DecHP + 1) then
                      begin
                        if (UserMagic.MagicInfo <> nil) then
                          SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '血量不足，无法使用' + UserMagic.MagicInfo.sMagicName);
                        Exit;
                      end;
                      m_WAbil.HP := m_WAbil.HP - DecHP;
                      HealthSpellChanged();
                    end;
                  end
                  else
                  begin
                    if (UserMagic.MagicInfo <> nil) then
                      SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '没有学习内力，无法使用' + UserMagic.MagicInfo.sMagicName);
                    Exit;
                  end;
                end
                else
                begin
                  // 检测内力值是否达到要求 piaoyun 2013-09-13
                  if (m_AbilNG.NH < nSpellPoint) then
                  begin
                    if g_Config.boSkill115NGNoEnoughDecHP then
                    begin
                      if g_Config.nSkill115NGNoEnoughDecHPType = 0 then
                      begin
                        DecHP := Round(m_WAbil.HP / 100 * g_Config.nSkill115NGNoEnoughDecHPValue);
                        if m_WAbil.HP <= DecHP + 1 then
                        begin
                          if (UserMagic.MagicInfo <> nil) then
                            SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '血量不足，无法使用' + UserMagic.MagicInfo.sMagicName);
                          Exit;
                        end;
                        m_WAbil.HP := m_WAbil.HP - DecHP;
                        HealthSpellChanged();
                      end
                      else
                      begin
                        DecHP := g_Config.nSkill115NGNoEnoughDecHPValue;
                        if m_WAbil.HP <= DecHP + 1 then
                        begin
                          if (UserMagic.MagicInfo <> nil) then
                            SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '血量不足，无法使用' + UserMagic.MagicInfo.sMagicName);
                          Exit;
                        end;
                        m_WAbil.HP := m_WAbil.HP - DecHP;
                        HealthSpellChanged();
                      end;
                    end
                    else
                    begin
                      if (UserMagic.MagicInfo <> nil) then
                        SendMsg(Self, RM_MAGIC_HINT_MSG, 0, 0, 0, 0, '内力不足，无法使用' + UserMagic.MagicInfo.sMagicName);
                      Exit;
                    end;
                  end
                  else
                  begin
                    ErrCode := 22;
                    m_AbilNG.NH := Max(0, m_AbilNG.NH - nSpellPoint);
                    RefAbilNH;
                  end;
                end;
              end
              // 自定义技能内功释放
              else if CheckIsCustomMagic(UserMagic.wMagIdx) then
              begin
                CustomMagicConfig := GetCustomMagicConfig(UserMagic.wMagIdx);
                if (CustomMagicConfig <> nil) and (CustomMagicConfig.ServerConfig.IsAttackUseNG) then
                begin
                  if not m_boTrainingNG or (m_AbilNG.NH < nSpellPoint) then
                    Exit;
                  m_AbilNG.NH := Max(0, m_AbilNG.NH - nSpellPoint);
                  RefAbilNH;
                end
                else
                begin
                  ErrCode := 24;
                  if m_WAbil.MP < nSpellPoint then
                    Exit;
                  DamageSpell(nSpellPoint);
                  HealthSpellChanged();
                end;
              end
              else
              begin
                ErrCode := 23;
                if m_WAbil.MP < nSpellPoint then
                  Exit;
                DamageSpell(nSpellPoint);
                HealthSpellChanged();
              end;
            end;
          end;
        end;
      end;
      ErrCode := 2;
      Result := MagicManager.DoSpell(Self, UserMagic, nTargetX, nTargetY, BaseObject, FormClient);
      ErrCode := 3;
      m_CurrTarget := BaseObject;
      if m_btRaceServer = RC_PLAYOBJECT then
      begin
        TPlayObject(Self).m_nInteger[998] := nTargetX;
        TPlayObject(Self).m_nInteger[999] := nTargetY;
        if (g_FunctionNPC <> nil) then
        begin
          TPlayObject(Self).m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(TPlayObject(Self), '@MagSelfFunc' + IntToStr(UserMagic.wMagIdx), False);
          if (UserMagic.wMagIdx = SKILL_HEALLING) and (BaseObject = nil) then
          begin
            BaseObject := Self;
          end;
          if (BaseObject <> nil) then
          begin
            BaseObject.m_CurrTarget := Self;
            TPlayObject(Self).m_sString[999] := BaseObject.m_sCharName;
            if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              TPlayObject(BaseObject).m_sString[999] := m_sCharName;
              TPlayObject(Self).m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(TPlayObject(Self), '@MagTagFunc' + IntToStr(UserMagic.wMagIdx), False);
              TPlayObject(BaseObject).m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(TPlayObject(BaseObject), '@MagTagFuncEx' + IntToStr(UserMagic.wMagIdx), False);
            end
            else
            begin
              TPlayObject(Self).m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(TPlayObject(Self), '@MagMonFunc' + IntToStr(UserMagic.wMagIdx), False);
            end;
          end;
        end;
      end
      else if (m_btRaceServer = RC_HEROOBJECT) and (m_Master <> nil) and (m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        Player := TPlayObject(m_Master);
        Player.m_nInteger[998] := nTargetX;
        Player.m_nInteger[999] := nTargetY;
        if (g_FunctionNPC <> nil) then
        begin
          Player.m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(Player, '@HeroMagSelfFunc' + IntToStr(UserMagic.wMagIdx), False);
          if (UserMagic.wMagIdx = SKILL_HEALLING) and (BaseObject = nil) then
          begin
            BaseObject := Self;
          end;
          if (BaseObject <> nil) then
          begin
            BaseObject.m_CurrTarget := Self;
            Player.m_sString[999] := BaseObject.m_sCharName;
            if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              TPlayObject(BaseObject).m_sString[999] := m_sCharName;
              Player.m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(Player, '@HeroMagTagFunc' + IntToStr(UserMagic.wMagIdx), False);
              TPlayObject(BaseObject).m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(TPlayObject(BaseObject), '@HeroMagTagFuncEx' + IntToStr(UserMagic.wMagIdx), False);
            end
            else
            begin
              Player.m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(Player, '@HeroMagMonFunc' + IntToStr(UserMagic.wMagIdx), False);
            end;
          end;
        end;
      end;
      ErrCode := 4;
    end;
  except
    on E: Exception do
    begin
      MainOutMessage(Format('[Exception, Code:%d] TSmartObject.DoSpell MagID:%d X:%d Y:%d', [ErrCode, UserMagic.wMagIdx, nTargetX,
        nTargetY]));
      MainOutMessage(E.Message);
    end;
  end;
end;

procedure TSmartObject.DoTalkStatusChanged(IsFeatureChanged: Boolean);
var
  StdItem: pTStdItem;
begin
  if IsFeatureChanged then
    FeatureChanged;
  RefShowName;
  m_btHorseType := 0;
  if m_UseItems[U_HORSE].wIndex > 0 then
  begin
    StdItem := UserEngine.GetStdItem(m_UseItems[U_HORSE].wIndex);
    if StdItem <> nil then
      m_btHorseType := StdItem.Horse;
  end
  // 合击版界面马牌放在蜡烛位置 chongchong 2013-10-18
  else if m_UseItems[U_RIGHTHAND].wIndex > 0 then
  begin
    StdItem := UserEngine.GetStdItem(m_UseItems[U_RIGHTHAND].wIndex);
    if (StdItem <> nil) and (StdItem.StdMode = 28) then
      m_btHorseType := StdItem.Horse;
  end;
end;

procedure TSmartObject.SendTakeOffHorse;
begin
  if m_btRaceServer = RC_PLAYOBJECT then
  begin
    TPlayObject(Self).SendMsg(Self, RM_TAKEHORSE, 0, m_nCurrX, m_nCurrY, 0, '');
  end;
end;

procedure TSmartObject.TriggerHorseScript;
begin
  if (g_FunctionNPC <> nil) and (m_btRaceServer = RC_PLAYOBJECT) then
  begin
    TPlayObject(Self).m_nScriptGotoCount := 0;
    if m_boOnHorse then
      g_FunctionNPC.GotoLable(TPlayObject(Self), '@UpHorse', False)
    else
      g_FunctionNPC.GotoLable(TPlayObject(Self), '@DownHorse', False);
  end;
end;

