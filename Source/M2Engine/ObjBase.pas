procedure TBaseObject.GainSlaveExp(nLevel: Integer);
  function GetUpKillCount(): Integer;
  var
    tCount: Integer;
  begin
    if m_btSlaveExpLevel < SLAVEMAXLEVEL - 2 then
      tCount := g_Config.MonUpLvNeedKillCount[m_btSlaveExpLevel]
    else
      tCount := 0;

    // Result:= ((m_Abil.Level shl 4) - m_Abil.Level) + 100 + tCount
    Result := ((m_Abil.Level * g_Config.nMonUpLvRate { 16 } ) - m_Abil.Level) + g_Config.nMonUpLvNeedKillBase { 100 } + tCount;
  end;

begin
  if m_boSlaveNoLevelUP then
    Exit;

  Inc(n294, nLevel);
  if GetUpKillCount() < n294 then
  begin
    Dec(n294, GetUpKillCount);
    if m_btSlaveExpLevel < (m_btSlaveMakeLevel * 2 + 1) then
    begin
      Inc(m_btSlaveExpLevel);
      RecalcAbilitys();
      RefNameColor();
    end;
  end;
end;

function TBaseObject.DropGoldDown(nGold: Integer; boFalg: Boolean; GoldOfCreat, DropGoldCreat: TBaseObject): Boolean;
var
  ItemObject, ItemObjectA: TItemObject;
  nX, nY: Integer;
  LogAction: LongWord;
begin
  ItemObject := TItemObject.Create;
  ItemObject.m_sName := sSTRING_GOLDNAME;
  ItemObject.m_wAniCount := 0;
  ItemObject.m_btReserved := 0;
  ItemObject.m_nCount := nGold;
  // ItemObject.m_btColor := g_btGoldItemColor;                                                        // StdItem.Color;
  { TODO -ochongchong -c新增 : 金币掉落颜色以 装备信息显示 物品显示颜色 为准 【2013-09-07】 }
  ItemObject.m_btColor := g_Config.btThrowAwayItemColor;
  ItemObject.m_wLooks := GetGoldShape(nGold);
  ItemObject.m_OfBaseObject := GoldOfCreat;
  ItemObject.m_dwCanPickUpTick := MyGetTickCount();
  ItemObject.m_DropBaseObject := DropGoldCreat;
  ItemObject.m_PEnvir := m_PEnvir;
  m_PEnvir.GetDropPosition(m_nCurrX, m_nCurrY, 3, nX, nY);
  ItemObjectA := TItemObject(m_PEnvir.AddToMap(nX, nY, ItemObject));
  // 修正不停的丢金币地面丢满还丢的时候，会刷金币
  // 因为上面的方法m_PEnvir.AddToMap会叠加金币到地面物品 2019-08-11 01:40:37
  Result := ItemObjectA <> nil;
  if ItemObjectA = ItemObject then
  begin
    g_ItemManager.AddItem(ItemObject);
    SendRefMsg(RM_ITEMSHOW, ItemObject.m_wLooks, NativeInt(ItemObject), nX, nY, IntToStr(ItemObject.m_btColor) + '/0/0/' +
      ItemObject.m_sName);
    if m_btRaceServer = RC_PLAYOBJECT then
    begin
      if boFalg then
        LogAction := LOG_ItemFall
      else
        LogAction := LOG_ItemDrop;
      if g_boGameLogGold then
      begin
        AddGameDataLog(LogAction, LOG_GoldChange, Self, sSTRING_GOLDNAME, NativeInt(ItemObject), '丢弃:' + IntToStr(nGold), m_nGold,
          m_nGold + nGold);
      end;
    end;
  end
  else
  begin
    if Result and g_boGameLogGold and (m_btRaceServer = RC_PLAYOBJECT) then
    begin
      AddGameDataLog(LOG_ItemDrop, LOG_GoldChange, Self, sSTRING_GOLDNAME, NativeInt(ItemObjectA), '丢弃到叠加:' + IntToStr(nGold),
        m_nGold, m_nGold + nGold);
    end;
    ItemObject.MakeGhost;
  end;
end;

function TBaseObject.GetGuildRelation(cert1, cert2: TBaseObject): Integer;
begin
  Result := 0;
  m_boGuildWarArea := False;
  if (cert1.m_MyGuild = nil) or (cert2.m_MyGuild = nil) then
    Exit;

  if cert2.InSafeArea then
    Exit;

  if TGUild(cert1.m_MyGuild).GuildWarList.Count <= 0 then
    Exit;

  if cert1.m_MyGuild = cert2.m_MyGuild then
    Result := 1;

  m_boGuildWarArea := True;
  if TGUild(cert1.m_MyGuild).IsWarGuild(TGUild(cert2.m_MyGuild)) // 敌对
    and TGUild(cert2.m_MyGuild).IsWarGuild(TGUild(cert1.m_MyGuild)) then
    Result := 2;

  if TGUild(cert1.m_MyGuild).IsAllyGuild(TGUild(cert2.m_MyGuild)) // 盟友
    and TGUild(cert2.m_MyGuild).IsAllyGuild(TGUild(cert1.m_MyGuild)) then
    Result := 3;
end;

function TBaseObject.GetGuildRelationEx(cert1, cert2: TBaseObject): Integer;
var
  I: Integer;
  tmpBool: Boolean;
  tmpAllyGuild: TGUild;
begin
  Result := 0;
  m_boGuildWarArea := False;

  if (cert1.m_MyGuild = nil) or (cert2.m_MyGuild = nil) then
    Exit;

  if cert2.InSafeArea then
    Exit;

  if TGUild(cert1.m_MyGuild).GuildWarList.Count <= 0 then
  begin
    tmpBool := False;
    for I := 0 to TGUild(cert1.m_MyGuild).GuildAllyList.Count - 1 do
    begin
      tmpAllyGuild := TGUild(TGUild(cert1.m_MyGuild).GuildAllyList.Objects[I]);
      if tmpAllyGuild.GuildWarList.Count > 0 then
      begin
        tmpBool := True;
        Break;
      end;
    end;

    if not tmpBool then
      Exit;
  end;

  if TGUild(cert2.m_MyGuild).GuildWarList.Count <= 0 then
  begin
    tmpBool := False;
    for I := 0 to TGUild(cert2.m_MyGuild).GuildAllyList.Count - 1 do
    begin
      tmpAllyGuild := TGUild(TGUild(cert2.m_MyGuild).GuildAllyList.Objects[I]);
      if tmpAllyGuild.GuildWarList.Count > 0 then
      begin
        tmpBool := True;
        Break;
      end;
    end;

    if not tmpBool then
      Exit;
  end;

  m_boGuildWarArea := True;

  if cert1.m_MyGuild = cert2.m_MyGuild then // 同行会蓝名
    Result := 1
  else if TGUild(cert1.m_MyGuild).IsWarGuild(TGUild(cert2.m_MyGuild)) then // 敌对橙名
    Result := 2
  else if TGUild(cert1.m_MyGuild).IsAllyGuild(TGUild(cert2.m_MyGuild)) then // 盟友蓝名
    Result := 3;
end;

