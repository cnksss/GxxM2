function TBaseObject.GetAttackPower(nBasePower, nPower: Integer): Integer;
var
  Value1, Value2, I64: Int64;
  nLuck: Integer;
begin
  if not g_Config.boLuckUseNewAlgorism then
  begin
    Randomize();
    if nPower < 0 then
      nPower := 0;
    if m_nLuck > 0 then
    begin
      if (Random(g_Config.nMaxLuckMaxPower - Min(g_Config.nMaxLuckMaxPower, m_nLuck) + 1) = 0) then
        I64 := Int64(nBasePower) + nPower
      else
        I64 := Int64(nBasePower) + Random(nPower + 1);
    end
    else
    begin
      I64 := Int64(nBasePower) + Random(nPower + 1);
      if m_nLuck < 0 then
      begin
        if Random(g_Config.nMaxLuckMaxPower - Min(g_Config.nMaxLuckMaxPower, Max(0, -m_nLuck)) + 1) = 0 then
          I64 := nBasePower;
      end;
    end;
  end
  else
  begin
    // 修改幸运+诅咒算法 chongchong 2017-07-29
    // 算法为：
    // 幸运：攻击下限 := 攻击下限 + (上限-下限) * 幸运值 / 最大幸运值
    // 诅咒：攻击上限 := 攻击上限 - (上限-下限) * 诅咒值 / 最大诅咒值
    Value1 := nBasePower;
    Value2 := Int64(nBasePower) + nPower;
    if Value2 > High(Integer) then
      Value2 := High(Integer)
    else if Value2 < 0 then
      Value2 := 0;
    if m_nLuck > 0 then // 幸运 chongchong 2017-07-29
    begin
      if g_Config.nMaxLuckMaxPower <= 0 then // 最大幸运为0，取攻击上限
      begin
        I64 := Value2;
      end
      else
      begin
        nLuck := Min(m_nLuck, g_Config.nMaxLuckMaxPower);
        Value1 := Round(Value1 + nPower / g_Config.nMaxLuckMaxPower * nLuck);
        if Value1 < Value2 then
        begin
          I64 := Value1 + Random(Value2 - Value1 + 1);
        end
        else if Value1 = Value2 then
        begin
          I64 := Value1;
        end
        else // if Value1 > Value2 then
        begin
          I64 := Value2 + Random(Value1 - Value2 + 1);
        end;
      end;
    end
    else if m_nLuck = 0 then
    begin
      if Value1 < Value2 then
      begin
        I64 := Value1 + Random(Value2 - Value1 + 1);
      end
      else if Value1 = Value2 then
      begin
        I64 := Value1;
      end
      else // if Value1 > Value2 then
      begin
        I64 := Value2 + Random(Value1 - Value2 + 1);
      end;
    end
    else // 诅咒
    begin
      if g_Config.nMaxLuckMaxPower <= 0 then // 最大诅咒为0，取攻击下限
      begin
        I64 := Value1;
      end
      else
      begin
        nLuck := Min(Abs(m_nLuck), g_Config.nMaxLuckMaxPower);
        Value2 := Round(Value2 - nPower / g_Config.nMaxLuckMaxPower * nLuck);
        if Value1 < Value2 then
        begin
          I64 := Value1 + Random(Value2 - Value1 + 1);
        end
        else if Value1 = Value2 then
        begin
          I64 := Value1;
        end
        else // if Value1 > Value2 then
        begin
          I64 := Value2 + Random(Value1 - Value2 + 1);
        end;
      end;
    end;
  end;
  if (m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) then
  begin
    if (I64 > 0) and TSmartObject(Self).m_boPowerItem then
    begin
      I64 := Round(I64 * TSmartObject(Self).m_rPowerItem);
    end;
    // 内功护体，加攻击
    if TSmartObject(Self).m_boTrainingNG and (TSmartObject(Self).m_AbilNG.NH > 0) then
    begin
      I64 := I64 + TSmartObject(Self).GetNGAddPower;
    end;
  end;
  {
    // 宝宝攻击威力倍率
    if (m_Master <> nil) and (m_btRaceServer <> RC_PLAYMOSTER) and (m_btRaceServer <> RC_HEROOBJECT) and (I64 > 0) then
    begin
    I64 := Round(I64 * (g_Config.nSlavePowerRate / 100));
    end;
  }
  if I64 < 0 then
    I64 := 0;
  Result := Min(I64, High(Integer));
end;

