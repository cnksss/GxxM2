function TSmartObject.AllowSWordHitSkill(): Boolean;
begin
  Result := False;
  if (MyGetTickCount - m_SkillUseTick[56]) >= GetMagicCD(SKILL_56) then
  begin // 逐日剑法
    m_SkillUseTick[56] := MyGetTickCount();
    m_boSWordHitSkill := True;
    Result := True;
  end
  else
  begin
    if (m_btRaceServer = RC_PLAYOBJECT) //
      and (not TPlayObject(Self).m_boOffLine) //
      and (not TPlayObject(Self).m_boDummyObject) //
      and (GetMagicCD(SKILL_56) - (MyGetTickCount - m_SkillUseTick[56]) >= 100) then
      TPlayObject(Self).SendDefMessage(SM_SENDOPENSKILLTIME,
        Round((GetMagicCD(SKILL_56) - (MyGetTickCount - m_SkillUseTick[56])) / 1000), 56, 0, 0, '');
  end;
end;

function TSmartObject.Allow66HitSkill(Target: TBaseObject): Boolean; // //开天斩     ID=66
var
  nSkill66HitWaitTime: Integer;
begin
  Result := False;

  if (MyGetTickCount - m_SkillUseTick[66]) >= GetMagicCD(SKILL_66) { nSkill66HitWaitTime } then
  begin
    m_SkillUseTick[66] := MyGetTickCount();
    m_bo66Skill := True;
    Result := True;

    if (Target <> nil) and (m_btRaceServer = RC_HEROOBJECT) then
    begin
      if not g_Config.boHeroSkill66HighAttackNoUseRate then
        m_bo66SkillCls := (Random(g_Config.nHeroSkill66HighAttackRate) = 0)
      else
        m_bo66SkillCls := (m_Abil.Level >= Target.m_Abil.Level);
    end
    else
      m_bo66SkillCls := True
  end
  else
  begin
    // HZQ 20230410
    if m_btRaceServer = RC_HEROOBJECT then
      nSkill66HitWaitTime := g_Config.nHeroSkill66CD * 1000
    else
      nSkill66HitWaitTime := GetMagicCD(SKILL_66);

    if (m_btRaceServer = RC_PLAYOBJECT) //
      and (not TPlayObject(Self).m_boOffLine) //
      and (not TPlayObject(Self).m_boDummyObject) //
      and (nSkill66HitWaitTime - (MyGetTickCount - m_SkillUseTick[66]) > 100) then
      TPlayObject(Self).SendDefMessage(SM_SENDOPENSKILLTIME, Round((nSkill66HitWaitTime - (MyGetTickCount - m_SkillUseTick[66])) /
        1000), 66, 0, 0, '');
  end;
end;

