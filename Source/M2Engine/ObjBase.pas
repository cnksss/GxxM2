function TBaseObject.MagCanHitTarget(nX, nY: Integer; TargeTBaseObject: TBaseObject): Boolean;
var
  n14, n18, n1C, n20: Integer;
begin
  Result := False;
  if TargeTBaseObject = nil then
    Exit;
  // 魔法忽略障碍 piaoyun 2013-09-12
  if g_Config.boMagicNotHinder then
  begin
    Result := True;
    Exit;
  end;
  n20 := Abs(nX - TargeTBaseObject.m_nCurrX) + Abs(nY - TargeTBaseObject.m_nCurrY);
  n14 := 0;
  while (n14 < 13) do
  begin
    n18 := GetNextDirection(nX, nY, TargeTBaseObject.m_nCurrX, TargeTBaseObject.m_nCurrY);
    if m_PEnvir.GetNextPosition(nX, nY, n18, 1, nX, nY) and m_PEnvir.sub_4B5FC8(nX, nY) then
    begin
      if (nX = TargeTBaseObject.m_nCurrX) and (nY = TargeTBaseObject.m_nCurrY) then
      begin
        Result := True;
        Break;
      end
      else
      begin
        n1C := Abs(nX - TargeTBaseObject.m_nCurrX) + Abs(nY - TargeTBaseObject.m_nCurrY);
        if n1C > n20 then
        begin
          Result := True;
          Break;
        end;
      end;
    end
    else
    begin
      Break;
    end;
    Inc(n14);
  end;
end;

// 十步一杀允许穿越障碍勾选后 人物叠加到目标身上了，正常情况应该和没勾选那样站目标身边 chongchong 2014-09-24
// 加了三个参数，boMove: Boolean; var NewX, NewY: Integer；boMove原始为True
function TBaseObject.MagCanMoveTarget(nX, nY: Integer; Flag: TWalkFlagArr; IsDisableStopItem: Boolean;
  nDistance: Integer): Boolean;
var
  n20, n14, n18, nSX, nSY, nTX, nTY: Integer;
  NoItemPoint: TPoint;
  ItemObject: TItemObject;
begin
  Result := False;
  n20 := Abs(nX - m_nCurrX) + Abs(nY - m_nCurrY);
  nSX := m_nCurrX;
  nSY := m_nCurrY;
  n18 := m_btDirection;
  n14 := 0;
  NoItemPoint := Point(m_nCurrX, m_nCurrY);
  // 修正十步一杀允许穿人时，中间有一个人，直接穿过和目标叠一起 2019-11-14 22:55:23
  if m_PEnvir.GetXYObjCount(nX, nY) >= 1 then
  begin
    n18 := GetNextDirection(nSX, nSY, nX, nY);
    GetBackPosition(n18, nX, nY, nX, nY, 1);
  end;
  if IsDisableStopItem then
  begin
    ItemObject := m_PEnvir.GetItem(nX, nY);
    if (ItemObject <> nil) and (not ItemObject.m_boGhost) then
    begin
      Exit;
    end;
    while (n14 <= nDistance) do
    begin
      n18 := GetNextDirection(nSX, nSY, nX, nY);
      if m_PEnvir.GetNextPosition(nSX, nSY, n18, 1, nTX, nTY) and m_PEnvir.CanWalkEx3(nTX, nTY, Flag) then
      begin
        // 修改十步一杀不叠加到攻击目标上 chongchong 2014-09-28
        // 注释下面两行，移到下面处理 2014-09-28
        // nSX := nTX;
        // nSY := nTY;
        ItemObject := m_PEnvir.GetItem(nTX, nTY);
        if (ItemObject = nil) or (ItemObject.m_boGhost) then
        begin
          NoItemPoint := Point(nTX, nTY);
        end;
        if (nTX = nX) and (nTY = nY) then
        begin
          // 判断目标处有没有对象 2014-09-28
          if (GetMapBaseObjectCount(m_PEnvir, nTX, nTY, 0) = 0) and ((ItemObject = nil) or (ItemObject.m_boGhost)) then
          begin
            nSX := nTX;
            nSY := nTY;
          end
          else
          begin
            nSX := NoItemPoint.X;
            nSY := NoItemPoint.Y;
          end;
          Break;
        end
        else if (Abs(nX - nTX) + Abs(nY - nTY)) > n20 then
        begin
          nSX := nTX; // +++ 2014-09-28
          nSY := nTY; // +++ 2014-09-28
          Break;
        end;
        nSX := nTX; // +++ 2014-09-28
        nSY := nTY; // +++ 2014-09-28
      end
      else
      begin
        Break;
      end;
    end;
  end
  else
  begin
    while (n14 <= nDistance) do
    begin
      n18 := GetNextDirection(nSX, nSY, nX, nY);
      if m_PEnvir.GetNextPosition(nSX, nSY, n18, 1, nTX, nTY) and m_PEnvir.CanWalkEx3(nTX, nTY, Flag) then
      begin
        // 修改十步一杀不叠加到攻击目标上 chongchong 2014-09-28
        // 注释下面两行，移到下面处理 2014-09-28
        // nSX := nTX;
        // nSY := nTY;
        if (nTX = nX) and (nTY = nY) then
        begin
          // 判断目标处有没有对象 2014-09-28
          if GetMapBaseObjectCount(m_PEnvir, nTX, nTY, 0) = 0 then // +++ 2014-09-28
          begin // +++ 2014-09-28
            nSX := nTX; // +++ 2014-09-28
            nSY := nTY; // +++ 2014-09-28
          end; // +++ 2014-09-28
          Break;
        end
        else if (Abs(nX - nTX) + Abs(nY - nTY)) > n20 then
        begin
          nSX := nTX; // +++ 2014-09-28
          nSY := nTY; // +++ 2014-09-28
          Break;
        end;
        nSX := nTX; // +++ 2014-09-28
        nSY := nTY; // +++ 2014-09-28
      end
      else
      begin
        Break;
      end;
    end;
  end;
  if (nSX <> m_nCurrX) or (nSY <> m_nCurrY) then
  begin
    if m_PEnvir.MoveToMovingObject(m_nCurrX, m_nCurrY, Self, nSX, nSY, True) then
    begin
      m_nCurrX := nSX;
      m_nCurrY := nSY;
      m_btDirection := n18;
      // GetStartType();
      Result := True;
    end;
  end
  else
  begin
    // 位置已经是对的，不用再移位了 chongchong 2016-07-02
    Result := True;
  end;
end;

function TBaseObject.IsProperFriend(BaseObject: TBaseObject): Boolean;
  function IsFriend(cret: TBaseObject): Boolean;
  var
    I: Integer;
  begin
    Result := False;
    if cret.m_btRaceServer = RC_PLAYOBJECT then
    begin // 措惑捞 荤恩牢 版快父
      case m_btAttatckMode of
        HAM_ALL:
          Result := True;
        HAM_PEACE:
          Result := True;
        HAM_DEAR:
          begin
            if (Self = cret) or (cret = TPlayObject(Self).m_DearHuman) then
            begin
              Result := True;
            end;
          end;
        HAM_MASTER:
          begin
            if (Self = cret) then
            begin
              Result := True;
            end
            else if TPlayObject(Self).m_boMaster then
            begin
              for I := 0 to TPlayObject(Self).m_MasterList.Count - 1 do
              begin
                if TPlayObject(Self).m_MasterList.Items[I] = cret then
                begin
                  Result := True;
                  Break;
                end;
              end;
            end
            else if TPlayObject(cret).m_boMaster then
            begin
              for I := 0 to TPlayObject(cret).m_MasterList.Count - 1 do
              begin
                if TPlayObject(cret).m_MasterList.Items[I] = Self then
                begin
                  Result := True;
                  Break;
                end;
              end;
            end;
          end;
        HAM_GROUP:
          begin
            if cret = Self then
              Result := True
            else if Self.m_Master = cret then
              Result := True
            else if Self.m_btRaceServer = RC_PLAYOBJECT then
            begin
              if TPlayObject(Self).IsGroupMember(TPlayObject(cret)) then
                Result := True;
            end
            else if Self.m_btRaceServer = RC_HEROOBJECT then
            begin
              if (Self.m_Master <> nil) and (Self.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
                Result := TPlayObject(Self.Master).IsGroupMember(TPlayObject(cret));
            end;
          end;
        HAM_GUILD:
          begin
            if cret = Self then
              Result := True;
            if m_MyGuild <> nil then
            begin
              if TGUild(m_MyGuild).IsMember(cret.m_sCharName) then
                Result := True;
              if m_boGuildWarArea and (cret.m_MyGuild <> nil) then
              begin
                if TGUild(m_MyGuild).IsAllyGuild(TGUild(cret.m_MyGuild)) then
                  Result := True;
              end;
            end;
          end;
        HAM_PKATTACK:
          begin
            if cret = Self then
              Result := True;
            if TSmartObject(Self).PKLevel >= 2 then
            begin
              if TPlayObject(Self).PKLevel < 2 then
                Result := True;
            end
            else
            begin
              if TPlayObject(Self).PKLevel >= 2 then
                Result := True;
            end;
          end;
        HAM_NATION:
          begin
            if cret = Self then
              Result := True;
            if (TPlayObject(Self).m_btNation = TPlayObject(cret).m_btNation) and (TPlayObject(Self).m_btNation > 0) then
              Result := True;
          end;
      end;
    end;
  end;

begin
  Result := False;
  if BaseObject = nil then
    Exit;
  if m_Master <> nil then
  begin
    if (Master.m_btRaceServer >= RC_ANIMAL) then
    begin
      if BaseObject.m_Master = nil then
      begin
        if (BaseObject.m_btRaceServer >= RC_ANIMAL) then
          Result := True;
        Exit;
      end
      else
      begin
        if (Master.m_btRaceServer >= RC_ANIMAL) then
          Result := True;
        Exit;
      end;
    end
    else if Master.m_btRaceServer = RC_PLAYOBJECT then
    begin
      if BaseObject.m_Master = nil then
      begin
        if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
          Result := IsFriend(BaseObject);
        Exit;
      end
      else
      begin
        if BaseObject.Master = Self then
        begin
          Result := True;
          Exit;
        end;
        if (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
        begin
          Result := IsFriend(BaseObject.Master);
          Exit;
        end;
      end;
    end;
  end
  else
  begin
    if (m_btRaceServer >= RC_ANIMAL) then
    begin
      if BaseObject.m_Master <> nil then
      begin
        if (BaseObject.Master.m_btRaceServer >= RC_ANIMAL) then
          Result := True;
      end
      else
      begin
        if (BaseObject.m_btRaceServer >= RC_ANIMAL) then
          Result := True;
      end;
    end
    else if m_btRaceServer = RC_PLAYOBJECT then
    begin
      if BaseObject.m_Master <> nil then
      begin
        if BaseObject.Master = Self then
        begin
          Result := True;
          Exit;
        end;
        if (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
          Result := IsFriend(BaseObject.Master);
      end
      else
      begin
        if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
          Result := IsFriend(BaseObject);
      end;
    end;
  end;
end;

function TBaseObject.MagMakeDefenceArea(nX, nY, nRange, nSec: Integer; btState: Byte; btNewLevel: Integer): Integer;
var
  III: Integer;
  I, II: Integer;
  nStartX, nStartY, nEndX, nEndY: Integer;
  MapCellInfo: pTMapCellinfo;
  GameObject: TGameObject;
  BaseObject: TBaseObject;
  Int64Value: Int64;
  ObjList: TList;
begin
  nStartX := nX - nRange;
  nEndX := nX + nRange;
  nStartY := nY - nRange;
  nEndY := nY + nRange;
  // 神圣战甲术、幽灵盾威力倍数
  Int64Value := Round(Int64(nSec) * (g_Config.nSkill15TimeRate / 100));
  nSec := Min(Int64Value, High(Integer));;
  ObjList := TList.Create;
  try
    for I := nStartX to nEndX do
    begin
      for II := nStartY to nEndY do
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          m_PEnvir.LockR(13);
        try
{$IFEND}
          if m_PEnvir.GetMapCellInfo(I, II, MapCellInfo) and (MapCellInfo.ObjList <> nil) then
          begin
            for III := 0 to {$IF USEOBJLIST = 1}Length(MapCellInfo.ObjList) - 1{$ELSE}MapCellInfo.ObjList.Count - 1{$IFEND} do
            begin
              GameObject := TGameObject(MapCellInfo.ObjList[III]);
              if (GameObject <> nil) and (GameObject.m_ObjGame = obj_Actor) then
              begin
                BaseObject := TBaseObject(GameObject);
                if (BaseObject <> nil) and (not BaseObject.m_boGhost) then
                begin
                  if IsProperFriend(BaseObject) then
                  begin
                    ObjList.Add(BaseObject);
                    {
                      if btState = 0 then
                      begin
                      //m_wStatusArrValue[STATE_DEFENCEUP] := nDefencePowerRate; // piaoyun 2013-07-25
                      BaseObject.DefenceUp(nSec); // 防御时间
                      // 加属性
                      end
                      else
                      begin
                      //m_wStatusArrValue[STATE_MAGDEFENCEUP] := nMagDefencePowerRate; // piaoyun 2013-07-25
                      BaseObject.MagDefenceUp(nSec);
                      end;
                      Inc(Result);
                    }
                  end
                end;
              end;
            end;
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            m_PEnvir.UnLockR;
        end;
{$IFEND}
      end;
    end;
    if btState = 0 then
    begin
      for I := 0 to ObjList.Count - 1 do
      begin
        BaseObject := ObjList.Items[I];
        BaseObject.m_dwDefenceUpAddRate := 0;
        BaseObject.m_btDefenceUpNewLevel := btNewLevel;
        BaseObject.DefenceUp(nSec); // 防御时间
      end;
    end
    else
    begin
      for I := 0 to ObjList.Count - 1 do
      begin
        BaseObject := ObjList.Items[I];
        BaseObject.m_btMagDefenceUpNewLevel := btNewLevel;
        BaseObject.m_dwMagDefenceUpAddRate := 0;
        BaseObject.MagDefenceUp(nSec);
      end;
    end;
    Result := ObjList.Count;
  finally
    ObjList.Free;
  end;
end;

function TBaseObject.MagMakeDefenceAreaDown(nX, nY, nRange, nSec: Integer; btState: Byte): Integer;
var
  III: Integer;
  I, II: Integer;
  nStartX, nStartY, nEndX, nEndY: Integer;
  MapCellInfo: pTMapCellinfo;
  GameObject: TGameObject;
  BaseObject: TBaseObject;
begin
  Result := 0;
  nStartX := nX - nRange;
  nEndX := nX + nRange;
  nStartY := nY - nRange;
  nEndY := nY + nRange;
  for I := nStartX to nEndX do
  begin
    for II := nStartY to nEndY do
    begin
{$IF MULTI_THREAD = 1}
      if g_MultiThreadRun then
        m_PEnvir.LockR(14);
      try
{$IFEND}
        if m_PEnvir.GetMapCellInfo(I, II, MapCellInfo) and (MapCellInfo.ObjList <> nil) then
        begin
          for III := 0 to {$IF USEOBJLIST = 1}Length(MapCellInfo.ObjList){$ELSE}MapCellInfo.ObjList.Count{$IFEND} - 1 do
          begin
            GameObject :=
{$IF USEOBJLIST = 1}TGameObject(MapCellInfo.ObjList[III]){$ELSE}TGameObject(MapCellInfo.ObjList.Items[III]){$IFEND};
            if (GameObject <> nil) and (GameObject.m_ObjGame = obj_Actor) then
            begin
              BaseObject := TBaseObject(GameObject);
              if (BaseObject <> nil) and (not BaseObject.m_boDeath) and (not BaseObject.m_boGhost) then
              begin
                if IsProperTarget(BaseObject) then
                begin
                  if btState = 0 then
                  begin
                    BaseObject.DefenceDown(nSec);
                  end
                  else if btState = 1 then
                  begin
                    BaseObject.MagDefenceDown(nSec);
                  end
                  else
                  begin
                    BaseObject.DefenceDown(nSec);
                    BaseObject.MagDefenceDown(nSec);
                  end;
                  Inc(Result);
                end
              end;
            end;
          end;
        end;
{$IF MULTI_THREAD = 1}
      finally
        if g_MultiThreadRun then
          m_PEnvir.UnLockR;
      end;
{$IFEND}
    end;
  end;
end;

