{ 检测指定方向和范围内坐标的怪物数量 }
function TAnimalObject.CheckTargetXYCountOfDirection(nX, nY, nDir, nRange: Integer): Integer;
var
  I: Integer;
  VisibleBaseObject: pTVisibleBaseObject;
  BaseObject: TBaseObject;
begin
  Result := 0;
  m_VisibleActors.Lock;
  try
    for I := 0 to m_VisibleActors.Count - 1 do
    begin
      VisibleBaseObject := m_VisibleActors[I].Item;
      if VisibleBaseObject <> nil then
      begin
        BaseObject := TBaseObject(VisibleBaseObject.BaseObject);
        if (not BaseObject.m_boDeath) and (not BaseObject.m_boGhost) and IsProperTarget(BaseObject) and
          (not BaseObject.m_boHideMode or m_boCoolEye) then
        begin
          case nDir of
            DR_UP:
              begin
                if (Abs(nX - BaseObject.m_nCurrX) = 0) and ((BaseObject.m_nCurrY - nY) in [1 .. nRange]) then
                  Inc(Result);
              end;
            DR_UPRIGHT:
              begin
                if ((BaseObject.m_nCurrX - nX) in [1 .. nRange]) and ((BaseObject.m_nCurrY - nY) in [1 .. nRange]) then
                  Inc(Result);
              end;
            DR_RIGHT:
              begin
                if ((BaseObject.m_nCurrX - nX) in [1 .. nRange]) and (Abs(nY - BaseObject.m_nCurrY) = 0) then
                  Inc(Result);
              end;
            DR_DOWNRIGHT:
              begin
                if ((BaseObject.m_nCurrX - nX) in [1 .. nRange]) and ((nY - BaseObject.m_nCurrY) in [1 .. nRange]) then
                  Inc(Result);
              end;
            DR_DOWN:
              begin
                if (Abs(nX - BaseObject.m_nCurrX) = 0) and ((nY - BaseObject.m_nCurrY) in [1 .. nRange]) then
                  Inc(Result);
              end;
            DR_DOWNLEFT:
              begin
                if ((nX - BaseObject.m_nCurrX) in [1 .. nRange]) and ((nY - BaseObject.m_nCurrY) in [1 .. nRange]) then
                  Inc(Result);
              end;
            DR_LEFT:
              begin
                if ((nX - BaseObject.m_nCurrX) in [1 .. nRange]) and (Abs(nY - BaseObject.m_nCurrY) = 0) then
                  Inc(Result);
              end;
            DR_UPLEFT:
              begin
                if ((nX - BaseObject.m_nCurrX) in [1 .. nRange]) and ((BaseObject.m_nCurrY - nY) in [1 .. nRange]) then
                  Inc(Result);
              end;
          end;
        end;
      end
    end;
  finally
    m_VisibleActors.UnLock;
  end;
end;

