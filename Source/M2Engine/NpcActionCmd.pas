// 扩展参数 chongchong 2014-10-30
  procedure AddNewValue(Item: pTUserItem);
  var
    Int64Value: Int64;
  begin
    Int64Value := Item.btValue[0] + StrToInt64Def(QuestActionInfo.sParam3, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[0] := Max(0, Int64Value);

    Int64Value := Item.btValue[1] + StrToInt64Def(QuestActionInfo.sParam4, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[1] := Max(0, Int64Value);

    Int64Value := Item.btValue[2] + StrToInt64Def(QuestActionInfo.sParam5, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[2] := Max(0, Int64Value);

    Int64Value := Item.btValue[3] + StrToInt64Def(QuestActionInfo.sParam6, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[3] := Max(0, Int64Value);

    Int64Value := Item.btValue[4] + StrToInt64Def(QuestActionInfo.sParam7, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[4] := Max(0, Int64Value);

    Int64Value := Item.btValue[5] + StrToInt64Def(QuestActionInfo.sParam8, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[5] := Max(0, Int64Value);
  end;

