procedure ActionOfGetAllCustomItemValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  I, J, nBindType: Integer;
  UserItem: pTUserItem;
  nValueIndex, nValue1, nValue2, nValue3: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBindType := QuestActionInfo.nParam1;
  nValueIndex := QuestActionInfo.nParam4;

  if (nBindType <= 0) or (nBindType > CUSTOM_PROPERTY_BIND_TYPE_COUNT) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (QuestActionInfo.sRawParam2 = '') or (QuestActionInfo.sRawParam3 = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nValueIndex < 0) or (nValueIndex >= ITEM_PROP_VALUES_COUNT) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  nValue1 := 0;
  nValue2 := 0;
  nValue3 := 0;

  for I := Low(THumanUseItems) to High(THumanUseItems) do
  begin
    UserItem := @SmartObject.m_UseItems[I];
    if (UserItem.wIndex > 0) then
    begin
      for J := Low(UserItem.CustomProperty.Properties) to High(UserItem.CustomProperty.Properties) do
      begin
        if UserItem.CustomProperty.Properties[J].btBindType = nBindType then
        begin
          case UserItem.CustomProperty.Properties[J].btPercent of
            0:
              Inc(nValue1, UserItem.CustomProperty.Properties[J].nValues[nValueIndex]);
            1:
              Inc(nValue2, UserItem.CustomProperty.Properties[J].nValues[nValueIndex]);
            2:
              Inc(nValue3, UserItem.CustomProperty.Properties[J].nValues[nValueIndex]);
          end;
        end;
      end;
    end;
  end;

  for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
  begin
    UserItem := @SmartObject.m_JewelryBoxItems[I];
    if (UserItem.wIndex > 0) then
    begin
      for J := Low(UserItem.CustomProperty.Properties) to High(UserItem.CustomProperty.Properties) do
      begin
        if UserItem.CustomProperty.Properties[J].btBindType = nBindType then
        begin
          case UserItem.CustomProperty.Properties[J].btPercent of
            0:
              Inc(nValue1, UserItem.CustomProperty.Properties[J].nValues[nValueIndex]);
            1:
              Inc(nValue2, UserItem.CustomProperty.Properties[J].nValues[nValueIndex]);
            2:
              Inc(nValue3, UserItem.CustomProperty.Properties[J].nValues[nValueIndex]);
          end;
        end;
      end;
    end;
  end;

  for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
  begin
    UserItem := @SmartObject.m_GodBlessItems[I];
    if (UserItem.wIndex > 0) then
    begin
      for J := Low(UserItem.CustomProperty.Properties) to High(UserItem.CustomProperty.Properties) do
      begin
        if UserItem.CustomProperty.Properties[J].btBindType = nBindType then
        begin
          case UserItem.CustomProperty.Properties[J].btPercent of
            0:
              Inc(nValue1, UserItem.CustomProperty.Properties[J].nValues[nValueIndex]);
            1:
              Inc(nValue2, UserItem.CustomProperty.Properties[J].nValues[nValueIndex]);
            2:
              Inc(nValue3, UserItem.CustomProperty.Properties[J].nValues[nValueIndex]);
          end;
        end;
      end;
    end;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(nValue1), nValue1) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, IntToStr(nValue2), nValue2) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;

  if QuestActionInfo.sRawParam5 <> '' then
  begin
    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam5, IntToStr(nValue3), nValue3) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    end;
  end;
end;

procedure ActionOfGetAllCustomItemValueByTextLine(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  I, J, nBindType: Integer;
  UserItem: pTUserItem;
  nValueType, nTextVarLineIndex, nVarIndex, nTemp, nValue1, nValue2, nValue3: Integer;
  sText: string;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBindType := QuestActionInfo.nParam1;
  nValueType := QuestActionInfo.nParam2;
  nTextVarLineIndex := QuestActionInfo.nParam3;

  if (nBindType <= 0) or (nBindType > CUSTOM_PROPERTY_BIND_TYPE_COUNT) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (QuestActionInfo.sRawParam4 = '') or (QuestActionInfo.sRawParam5 = '') or (QuestActionInfo.sRawParam6 = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  nVarIndex := -1;
  sText := UpperCase(g_CustomItemPropertyBindNames[nBindType]);
  nTemp := Pos('<TEXT:', sText);
  if nTemp > 0 then
  begin
    sText := Copy(sText, nTemp + 6, MaxInt);
    if (Length(sText) > 2) and (sText[1] = '$') and (sText[2] = '$') then
    begin
      nVarIndex := StrToIntDef(sText[3], 0);
      nVarIndex := nVarIndex - 1;
    end;
  end;

  nValue1 := 0;
  nValue2 := 0;
  nValue3 := 0;

  if (nVarIndex >= 0) or (nVarIndex < ITEM_PROP_VALUES_COUNT) then
  begin
    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      UserItem := @SmartObject.m_UseItems[I];
      if (UserItem.wIndex > 0) then
      begin
        for J := Low(UserItem.CustomProperty.Properties) to High(UserItem.CustomProperty.Properties) do
        begin
          if UserItem.CustomProperty.Properties[J].btBindType = nBindType then
          begin
            if UserItem.CustomProperty.Properties[J].nValues[nVarIndex] = nTextVarLineIndex then
            begin
              if nValueType < 0 then
              begin
                Inc(nValue1, UserItem.CustomProperty.Properties[J].nValues[0]);
                Inc(nValue2, UserItem.CustomProperty.Properties[J].nValues[1]);
                Inc(nValue3, UserItem.CustomProperty.Properties[J].nValues[2]);
              end
              else if UserItem.CustomProperty.Properties[J].btPercent = nValueType then
              begin
                Inc(nValue1, UserItem.CustomProperty.Properties[J].nValues[0]);
                Inc(nValue2, UserItem.CustomProperty.Properties[J].nValues[1]);
                Inc(nValue3, UserItem.CustomProperty.Properties[J].nValues[2]);
              end;
            end;
          end;
        end;
      end;
    end;

    for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
    begin
      UserItem := @SmartObject.m_JewelryBoxItems[I];
      if (UserItem.wIndex > 0) then
      begin
        for J := Low(UserItem.CustomProperty.Properties) to High(UserItem.CustomProperty.Properties) do
        begin
          if UserItem.CustomProperty.Properties[J].btBindType = nBindType then
          begin
            if UserItem.CustomProperty.Properties[J].nValues[nVarIndex] = nTextVarLineIndex then
            begin
              if nValueType < 0 then
              begin
                Inc(nValue1, UserItem.CustomProperty.Properties[J].nValues[0]);
                Inc(nValue2, UserItem.CustomProperty.Properties[J].nValues[1]);
                Inc(nValue3, UserItem.CustomProperty.Properties[J].nValues[2]);
              end
              else if UserItem.CustomProperty.Properties[J].btPercent = nValueType then
              begin
                Inc(nValue1, UserItem.CustomProperty.Properties[J].nValues[0]);
                Inc(nValue2, UserItem.CustomProperty.Properties[J].nValues[1]);
                Inc(nValue3, UserItem.CustomProperty.Properties[J].nValues[2]);
              end;
            end;
          end;
        end;
      end;
    end;

    for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
    begin
      UserItem := @SmartObject.m_GodBlessItems[I];
      if (UserItem.wIndex > 0) then
      begin
        for J := Low(UserItem.CustomProperty.Properties) to High(UserItem.CustomProperty.Properties) do
        begin
          if UserItem.CustomProperty.Properties[J].btBindType = nBindType then
          begin
            if UserItem.CustomProperty.Properties[J].nValues[nVarIndex] = nTextVarLineIndex then
            begin
              if nValueType < 0 then
              begin
                Inc(nValue1, UserItem.CustomProperty.Properties[J].nValues[0]);
                Inc(nValue2, UserItem.CustomProperty.Properties[J].nValues[1]);
                Inc(nValue3, UserItem.CustomProperty.Properties[J].nValues[2]);
              end
              else if UserItem.CustomProperty.Properties[J].btPercent = nValueType then
              begin
                Inc(nValue1, UserItem.CustomProperty.Properties[J].nValues[0]);
                Inc(nValue2, UserItem.CustomProperty.Properties[J].nValues[1]);
                Inc(nValue3, UserItem.CustomProperty.Properties[J].nValues[2]);
              end;
            end;
          end;
        end;
      end;
    end;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, IntToStr(nValue1), nValue1) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam5, IntToStr(nValue2), nValue2) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam6, IntToStr(nValue3), nValue3) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

procedure ActionOfGetItemStoneInfo(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nStoneIndex, ValueType: Integer;
  UserItem: pTUserItem;
  nBoxItemIndex, nMakeIndex: Integer;
  SmartObject: TSmartObject;
  nValue: Integer;
  sValue: string;
  StdItem: pTStdItem;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  nStoneIndex := QuestActionInfo.nParam2;
  ValueType := QuestActionInfo.nParam3;

  if (QuestActionInfo.sParam3 = '') or (nStoneIndex < 0) or (nStoneIndex >= MAX_FLUTE_COUNT) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if (ValueType < 0) or (ValueType > 6) or (Length(QuestActionInfo.sRawParam4) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem = nil then
  begin
    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, '', 0) then
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if UserItem.Flutes[nStoneIndex].GemIndex <= 0 then
  begin
    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, '', 0) then
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  StdItem := UserEngine.GetStdItem(UserItem.Flutes[nStoneIndex].GemIndex);
  if (StdItem = nil) or (StdItem.StdMode <> 46) and (StdItem.Shape <> 3) then
  begin
    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, '', 0) then
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  nValue := 0;
  sValue := '';
  case ValueType of
    0:
      begin
        nValue := 0;
        sValue := StdItem.DBName;
      end;
    1:
      begin
        nValue := StdItem.AniCount;
        sValue := IntToStr(nValue);
      end;
    2:
      begin
        nValue := StdItem.Source;
        sValue := IntToStr(nValue);
      end;
    3:
      begin
        nValue := StdItem.AC1;
        sValue := IntToStr(nValue);
      end;
    4:
      begin
        nValue := StdItem.AC2;
        sValue := IntToStr(nValue);
      end;
    5:
      begin
        nValue := StdItem.Reserved;
        sValue := IntToStr(nValue);
      end;
    6:
      begin
        nValue := UserItem.Flutes[nStoneIndex].GemCount;
        if nValue = 0 then
          nValue := 1;
        sValue := IntToStr(nValue);
      end;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, sValue, nValue) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

function CheckOrCreateIniFile(const AIniFilePath: string): Boolean;
var
  tmpSL: TStrings;
begin
  Result := False;
  if not FileExists(AIniFilePath) then
  begin
    tmpSL := TStringList.Create;
    try
      try
        tmpSL.SaveToFile(AIniFilePath); // 文件路径可能是错的，比如没有此盘符。
        Result := True;
      except
      end;
    finally
      tmpSL.Free;
    end;
  end
  else
    Result := True;
end;

procedure ActionOfReadConfigFileItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  FileName: string;
  Inifile: TFastIniFile;
  SectionName, IdentName, ReadValue: string;
begin
  if QuestActionInfo.nParam5 = 0 then
    FileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    FileName := QuestActionInfo.sParam1;

  SectionName := QuestActionInfo.sParam2;
  IdentName := QuestActionInfo.sParam3;

  if (Length(QuestActionInfo.sParam1) = 0) //
    or (Length(SectionName) = 0) //
    or (Length(IdentName) = 0) //
    or (Length(QuestActionInfo.sRawParam4) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if not CheckOrCreateIniFile(FileName) then
  begin
    Npc.ScriptActionError(PlayObject, '无效的文件路径', QuestActionInfo);
    Exit;
  end;

  Inifile := TFastIniFile.Create(FileName);
  ReadValue := Inifile.ReadString(SectionName, IdentName, '');
  Inifile.Free;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, ReadValue, StrToIntDef(ReadValue, 0)) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

procedure ActionOfWriteConfigFileItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  FileName: string;
