procedure ActionOfSetAngryValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  BaseObj: TBaseObject;
  cMethod: Char;
  Hero: THeroObject;
  Value, OldAngryValue: Integer;
begin

  BaseObj := nil;
  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    BaseObj := TPlayObject(BaseObject).m_MyHero
  else if (BaseObject.m_btRaceServer in [RC_HEROOBJECT]) then
    BaseObj := BaseObject
  else if (BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT) then
    BaseObj := TPlayObject(BaseObject.Master).m_MyHero;

  if BaseObj = nil then
    Exit;

  Hero := THeroObject(BaseObj);

  if QuestActionInfo.sRawParam1 = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sRawParam1[1];

  // SetAngryValue 操作符(+/-/=) 值 是否为百分比值(0:点数；1：百分比)  来自于GeeM2引擎帮助文档

  if QuestActionInfo.nParam3 = 1 then
  begin // 百分比
    Value := Round(g_Config.btMaxAngryValue / 100 * QuestActionInfo.nParam2);
  end
  else
  begin
    Value := QuestActionInfo.nParam2; // HZQ 20230410 , 根据Gee资料 nParam3 = 0 为点数绝对值
  end;

  OldAngryValue := Hero.m_btAngryValue;
  case cMethod of
    '+':
      begin
        Hero.m_btAngryValue := Hero.m_btAngryValue + Value;
        if Hero.m_btAngryValue < 0 then
          Hero.m_btAngryValue := 0
        else if Hero.m_btAngryValue > g_Config.btMaxAngryValue then
          Hero.m_btAngryValue := g_Config.btMaxAngryValue;
      end;
    '-':
      begin
        Hero.m_btAngryValue := Hero.m_btAngryValue - Value;
        if Hero.m_btAngryValue < 0 then
          Hero.m_btAngryValue := 0
        else if Hero.m_btAngryValue > g_Config.btMaxAngryValue then
          Hero.m_btAngryValue := g_Config.btMaxAngryValue;
      end;
    '=':
      begin
        Hero.m_btAngryValue := Value;
        if Hero.m_btAngryValue < 0 then
          Hero.m_btAngryValue := 0
        else if Hero.m_btAngryValue > g_Config.btMaxAngryValue then
          Hero.m_btAngryValue := g_Config.btMaxAngryValue;
      end
  end;

  if Hero.m_btAngryValue <> OldAngryValue then
  begin
    Hero.SendMsg(Hero, RM_REFANGRYVALUE, MakeWord(Hero.m_btAngryValue, g_Config.btMaxAngryValue), 1, Hero.m_UseItems[U_BUJUK].Dura, 0, '');
  end;
end;

procedure ActionOfUpOrDownHorse(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  dwTime: LongWord;
begin
  if not PlayObject.m_boOnHorse then
  begin
    if PlayObject.m_boShopStall then
    begin
      PlayObject.SysMsg(g_sHorseStopShop, c_Red, t_Hint);
      Exit;
    end;

    // 2020-08-22 12:28:15
    if PlayObject.m_nChangeAppr >= 0 then
    begin
      PlayObject.SysMsg('变身状态不允许骑马', c_Red, t_Hint);
      Exit;
    end;

    if (PlayObject.m_btHorseType = 0) then
    begin
      PlayObject.SysMsg(g_sHorseBrand, c_Red, t_Hint);
      Exit;
    end;

    if PlayObject.m_PEnvir.m_boNOHORSE then
    begin
      PlayObject.SysMsg(g_sHorseMapDisable, c_Red, t_Hint);
      Exit;
    end;

    PlayObject.StopCollect;

    dwTime := MyGetTickCount - PlayObject.m_dwDownHorseTick;
    if dwTime < g_Config.dwHorseTakeTime * 1000 then
    begin
      dwTime := g_Config.dwHorseTakeTime * 1000 - dwTime;

      if dwTime mod 1000 > 0 then
        dwTime := dwTime div 1000 + 1
      else
        dwTime := dwTime div 1000;

      PlayObject.SysMsg(Format(g_sHorseTime, [dwTime]), c_Red, t_Hint);
      Exit;
    end;

    if (not PlayObject.m_boCanOnHorse) and (g_Config.dwTakeOnHorseUseTime > 1) then
    begin
      PlayObject.m_boCanOnHorse := True;
      PlayObject.m_dwCanOnHorseTime := MyGetTickCount + LongWord(g_Config.dwTakeOnHorseUseTime * 1000);
      PlayObject.SendDefMessage(SM_SHOWPROGRESSBAR, NativeInt(PlayObject), 2, CM_CLICKBOX, g_Config.dwTakeOnHorseUseTime, '正在准备坐骑...');
      Exit;
    end
    else if (g_Config.dwTakeOnHorseUseTime > 1) and (PlayObject.m_boCanOnHorse and (MyGetTickCount < PlayObject.m_dwCanOnHorseTime)) then
    begin
      PlayObject.SysMsg('坐骑正在恢复，暂时无法骑乘！', c_Red, t_Hint);
      Exit;
    end;

    // 在跑的过程中按快捷键上下马 chongchong 2015-07-04
    PlayObject.m_boOnHorse := True;
    PlayObject.m_dwClientTakeHorseTick := MyGetTickCount;

    PlayObject.m_boCanOnHorse := False;
    PlayObject.m_dwCanOnHorseTime := 0;

    PlayObject.m_boHorseMaster := True;
    PlayObject.m_HorseOtherHum := nil;
    PlayObject.FeatureChanged();
    PlayObject.RefShowName;

    PlayObject.TriggerHorseScript;
  end
  else
  begin
    if PlayObject.m_HorseOtherHum <> nil then
    begin
      { 骑马发起人下马，被邀请人也下马 chongchong 2013-10-14 }
      if PlayObject.m_boHorseMaster then
      begin
        PlayObject.m_HorseOtherHum.m_boOnHorse := False;
        PlayObject.m_HorseOtherHum.m_dwDownHorseTick := MyGetTickCount;
        PlayObject.m_HorseOtherHum.m_dwClientTakeHorseTick := MyGetTickCount;
      end;

      PlayObject.m_HorseOtherHum.m_HorseOtherHum := nil;
      PlayObject.m_HorseOtherHum.DoTalkStatusChanged;
      PlayObject.m_HorseOtherHum.TriggerHorseScript;
      if PlayObject.m_boHorseMaster then
        PlayObject.m_HorseOtherHum.SendTakeOffHorse;
    end;

    PlayObject.StopCollect;

    PlayObject.m_boOnHorse := False;
    PlayObject.m_dwClientTakeHorseTick := MyGetTickCount;
    PlayObject.m_dwDownHorseTick := MyGetTickCount;
    PlayObject.m_HorseOtherHum := nil;
    PlayObject.DoTalkStatusChanged;
    PlayObject.TriggerHorseScript;
    if not PlayObject.m_boHorseMaster then
      PlayObject.SendTakeOffHorse;
  end;
end;

procedure ActionOfCopyFile(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SrcFile, DestFile: string;
begin
  SrcFile := QuestActionInfo.sParam1;
  DestFile := QuestActionInfo.sParam2;

  if SrcFile = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if DestFile = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if not CheckAbsolutePath(SrcFile) then
    SrcFile := g_Config.sEnvirDir + Npc.m_sPath + SrcFile;

  if not CheckAbsolutePath(DestFile) then
    DestFile := g_Config.sEnvirDir + Npc.m_sPath + DestFile;

  if not FileExists(SrcFile) then
  begin
    Npc.ScriptActionError(BaseObject, '"' + SrcFile + '" File not exists.', QuestActionInfo);
    Exit;
  end;

  if (QuestActionInfo.nParam3 = 1) and FileExists(DestFile) then
    Exit;

  try
    CopyFile(PChar(SrcFile), PChar(DestFile), False);
  except
    on E: Exception do
    begin
      MainOutMessage('[Exception] Copy file error; ' + E.Message);
    end;
  end;
end;

procedure ActionOfCloneCommonFile(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
resourcestring
  HookError = '[Exception] CloneCommonFile %s';
var
  s30: string;
  SrcFile: TStringList;
  MemoryStream: TMemoryStream;
begin
  if (g_PluginManager <> nil) and g_PluginManager.IsCheckCommonFileHook then
  begin
    try
      MemoryStream := TMemoryStream.Create;
      if not g_PluginManager.HookCloneCommonFile(PAnsiChar(AnsiString(QuestActionInfo.sParam1)), MemoryStream) then
      begin
        MemoryStream.Free;
        Exit;
      end;

      if (MemoryStream.Size > 0) then
      begin
        ;
        s30 := FrmDB.DeCodePlugBuffer(MemoryStream);
        SrcFile := TStringList.Create;
        SrcFile.Text := s30;
        SrcFile.SaveToFile(g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1);
        SrcFile.Free;
      end;

      MemoryStream.Free;
    except
      on E: Exception do
      begin
        MainOutMessage(Format(HookError, [QuestActionInfo.sParam1]));
        MainOutMessage(E.Message);
        Exit;
      end;
    end;
  end;
end;

