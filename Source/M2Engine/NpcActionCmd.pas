procedure ActionOfAutoGetExp(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nInterval, nPoint: Integer;
  boIsSafeZone: Boolean;
  boIncExpHero, boIncBead: Boolean;
  sMAP: string;
  Envir: TEnvirnoment;
  ValidTime: Integer;
  nLimitLevel: Int64;
begin
  nInterval := QuestActionInfo.nParam1;
  nPoint := QuestActionInfo.nParam2;
  boIsSafeZone := QuestActionInfo.sParam3 = '1';
  sMAP := QuestActionInfo.sParam4;
  boIncExpHero := QuestActionInfo.nParam5 = 1;
  boIncBead := QuestActionInfo.nParam6 = 1;
  ValidTime := QuestActionInfo.nParam7;

  nLimitLevel := StrToInt64Def(QuestActionInfo.sParam8, 0);
  if nLimitLevel > High(LongWord) then
    nLimitLevel := High(LongWord)
  else if nLimitLevel < 0 then
    nLimitLevel := 0;

  if g_MapManager.FindMap(QuestActionInfo.sRawParam4) <> nil then
    sMAP := QuestActionInfo.sRawParam4;

  if sMAP <> '' then
    Envir := g_MapManager.FindMap(sMAP)
  else
    Envir := nil;

  if (nInterval <= 0) or (nPoint <= 0) or ((sMAP <> '') and (sMAP <> '*') and (Envir = nil)) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  PlayObject.m_dwAutoGetExpTick := 0;
  PlayObject.m_boAutoGetExpInSafeZone := boIsSafeZone;
  PlayObject.m_AutoGetExpEnvir := Envir;
  PlayObject.m_nAutoGetExpInterval := nInterval * 1000;
  PlayObject.m_nAutoGetExpPoint := nPoint;
  PlayObject.m_boAutoGetExpIncHero := boIncExpHero;
  PlayObject.m_boAutoGetExpIncBead := boIncBead;

  if ValidTime > 0 then
    PlayObject.m_dwAutoGetExpTime := MyGetTickCount + ValidTime * 1000
  else
    PlayObject.m_dwAutoGetExpTime := High(PlayObject.m_dwAutoGetExpTime);

  PlayObject.m_dwAutoGetExpLimitLevel := nLimitLevel;
end;

procedure ActionOfVar(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  sType: string;
  VarType: TVarType;
  sVarName: string;
  sVarValue: string;
  nVarValue: Integer;
  sName: string;
  DynamicVar: pTDynamicVar;
  DynamicVarList: TList;
resourcestring
  sVarTypeError = '变量类型错误，错误类型:%s 当前支持类型(HUMAN、GUILD、GLOBAL)';
begin
  sType := Trim(QuestActionInfo.sParam2);
  sVarName := Trim(QuestActionInfo.sParam3);
  sVarValue := Trim(QuestActionInfo.sParam4);
  nVarValue := QuestActionInfo.nParam4;

  VarType := vNone;
  if SameText(Trim(QuestActionInfo.sParam1), 'Integer') then
    VarType := vInteger;
  if SameText(Trim(QuestActionInfo.sParam1), 'String') then
    VarType := vString;

  if sType.IsEmpty or sVarName.IsEmpty or (VarType = vNone) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  DynamicVarList := Npc.GetDynamicVarList(PlayObject, sType, sName);
  if DynamicVarList = nil then
  begin
    Npc.ScriptActionError(PlayObject, Format(sVarTypeError, [sType]), QuestActionInfo);
    Exit;
  end;

  for I := 0 to DynamicVarList.Count - 1 do
  begin
    if SameText(pTDynamicVar(DynamicVarList.Items[I]).sName, sVarName) then
      Exit;
  end;

  New(DynamicVar);
  DynamicVar.sName := sVarName;
  DynamicVar.VarType := VarType;
  DynamicVar.nInternet := nVarValue;
  DynamicVar.sString := sVarValue;
  DynamicVarList.Add(DynamicVar);
end;

procedure ActionOfLoadVar(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  sType: string;
  sVarName: string;
  sFileName: string;
  sName: string;
  DynamicVar: pTDynamicVar;
  boFoundVar: Boolean;
  DynamicVarList: TList;
  Inifile: TFastIniFile;
resourcestring
  sVarFound = '变量%s不存在，变量类型:%s';
  sVarTypeError = '变量类型错误，错误类型:%s 当前支持类型(HUMAN、GUILD、GLOBAL)';
begin
  sType := QuestActionInfo.sParam1;
  sVarName := QuestActionInfo.sParam2;

  if QuestActionInfo.nParam4 = 1 then
    sFileName := QuestActionInfo.sParam3
  else
    sFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam3;

  if (sType = '') or (sVarName = '') or not FileExists(sFileName) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  DynamicVarList := Npc.GetDynamicVarList(PlayObject, sType, sName);
  if DynamicVarList = nil then
  begin
    Npc.ScriptActionError(PlayObject, Format(sVarTypeError, [sType]), QuestActionInfo);
    Exit;
  end
  else
  begin
    Inifile := TFastIniFile.Create(sFileName);
    try
      boFoundVar := False;
      for I := 0 to DynamicVarList.Count - 1 do
      begin
        DynamicVar := DynamicVarList.Items[I];
        if CompareText(DynamicVar.sName, sVarName) = 0 then
        begin
          case DynamicVar.VarType of
            vInteger:
              DynamicVar.nInternet := Inifile.ReadInteger(sName, DynamicVar.sName, 0);
            vString:
              DynamicVar.sString := Inifile.ReadString(sName, DynamicVar.sName, '');
          end;
          boFoundVar := True;
          Break;
        end;
      end;

      if not boFoundVar then
        Npc.ScriptActionError(PlayObject, Format(sVarFound, [sVarName, sType]), QuestActionInfo);
    finally
      Inifile.Free;
    end;
  end;
end;

procedure ActionOfSaveVar(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  sType: string;
  sVarName: string;
  sFileName: string;
  sName: string;
  DynamicVar: pTDynamicVar;
  DynamicVarList: TList;
  Inifile: TFastIniFile;
resourcestring
  sVarFound = '变量%s不存在，变量类型:%s';
  sVarTypeError = '变量类型错误，错误类型:%s 当前支持类型(HUMAN、GUILD、GLOBAL)';
begin
  sType := QuestActionInfo.sParam1;
  sVarName := QuestActionInfo.sParam2;

  if QuestActionInfo.nParam4 = 1 then
    sFileName := QuestActionInfo.sParam3
  else
    sFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam3;

  if (sType = '') or (sVarName = '') { or (not FileExists(sFileName)) } then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  DynamicVarList := Npc.GetDynamicVarList(PlayObject, sType, sName);
  if DynamicVarList = nil then
  begin
    Npc.ScriptActionError(PlayObject, Format(sVarTypeError, [sType]), QuestActionInfo);
    Exit;
  end
  else
  begin
    Inifile := TFastIniFile.Create(sFileName);
    for I := 0 to DynamicVarList.Count - 1 do
    begin
      DynamicVar := DynamicVarList.Items[I];
      if CompareText(DynamicVar.sName, sVarName) = 0 then
      begin
        case DynamicVar.VarType of
          vInteger:
            Inifile.WriteInteger(sName, DynamicVar.sName, DynamicVar.nInternet);
          vString:
            Inifile.WriteString(sName, DynamicVar.sName, DynamicVar.sString);
        end;
        Break;
      end;
    end;

    try
      Inifile.Free;
    except
      MainOutMessage(Format('Save fail; [%s; %s]', [QuestActionInfo.sCmd, sFileName]));
    end;
  end;
end;

procedure ActionOfCalcVar(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  sType: string;
  sVarName: string;
  sName: string;
  sVarValue: string;
  nVarValue: Integer;
  sMethod: string;
  cMethod: Char;
  DynamicVar: pTDynamicVar;
  boFoundVar: Boolean;
  DynamicVarList: TList;
resourcestring
  sVarFound = '变量%s不存在，变量类型:%s';
  sVarTypeError = '变量类型错误，错误类型:%s 当前支持类型(HUMAN、GUILD、GLOBAL)';
begin
  sType := QuestActionInfo.sParam1;
  sVarName := QuestActionInfo.sParam2;
  sMethod := QuestActionInfo.sParam3;
  sVarValue := QuestActionInfo.sParam4;
  nVarValue := QuestActionInfo.nParam4;

  if (sType = '') or (sVarName = '') or (sMethod = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if nVarValue < 0 then
    nVarValue := 0;

  boFoundVar := False;
  cMethod := sMethod[1];

  DynamicVarList := Npc.GetDynamicVarList(PlayObject, sType, sName);
  if DynamicVarList = nil then
  begin
    Npc.ScriptActionError(PlayObject, Format(sVarTypeError, [sType]), QuestActionInfo);
    Exit;
  end;

  for I := 0 to DynamicVarList.Count - 1 do
  begin
    DynamicVar := DynamicVarList.Items[I];
    if CompareText(DynamicVar.sName, sVarName) = 0 then
    begin
      case DynamicVar.VarType of
        vInteger:
          begin
            case cMethod of
              '=':
                DynamicVar.nInternet := nVarValue;
              '+':
                DynamicVar.nInternet := DynamicVar.nInternet + nVarValue;
              '-':
                DynamicVar.nInternet := DynamicVar.nInternet - nVarValue;
              '*':
                DynamicVar.nInternet := DynamicVar.nInternet * nVarValue;
              '/':
                if nVarValue > 0 then
                  DynamicVar.nInternet := DynamicVar.nInternet div nVarValue;
            end;
          end;
        vString:
          begin
            case cMethod of
              '=':
                DynamicVar.sString := sVarValue;
              '+':
                DynamicVar.sString := DynamicVar.sString + sVarValue;
            end;
          end;
      end;
      boFoundVar := True;
      Break;
    end;
  end;

  if not boFoundVar then
    Npc.ScriptActionError(PlayObject, Format(sVarFound, [sVarName, sType]), QuestActionInfo);
end;

procedure ActionOfOffLine(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nOffOnlineGetExpTime: Integer;
  nOffOnlineTime: Integer;
  nOffOnlineExp: Integer;
  I: Integer;
  HeroObject: THeroObject;
begin
  if (not PlayObject.m_boOffLine) and (not PlayObject.m_boDummyObject) and (not PlayObject.m_boDeath) then
  begin
    nOffOnlineGetExpTime := QuestActionInfo.nParam1;
    nOffOnlineExp := QuestActionInfo.nParam2;
    nOffOnlineTime := QuestActionInfo.nParam3;

    if (nOffOnlineGetExpTime < 0) or (nOffOnlineExp < 0) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;

    PlayObject.m_nOffOnlineTick := MyGetTickCount;
    PlayObject.m_nOffOnlineTime := nOffOnlineTime * 60 * 1000;

    PlayObject.m_dwOfflineGetExpTick := MyGetTickCount;
    PlayObject.m_nOfflineGetExpTime := nOffOnlineGetExpTime * 1000;
    PlayObject.m_nOffOnlineExp := nOffOnlineExp;

    PlayObject.m_boReconnection := False;
    PlayObject.m_boSoftClose := True;

    PlayObject.m_boOffLine := True;
    PlayObject.m_boOfflineKick := False;

    UserEngine.m_ReallyPlayObjectList.Remove(PlayObject);

    // MainOutMessage('ActionOfOffLine');

    PlayObject.m_boAllowChallenge := False; // 是否允许挑战
    PlayObject.m_boAllowDeal := False; // 禁止交易
    PlayObject.m_boAllowGuild := False; // 禁止加入行会
    PlayObject.m_boAllowGroup := False; // 禁止组队
    PlayObject.m_boCanMasterRecall := False; // 禁止师徒传送
    PlayObject.m_boCanDearRecall := False; // 禁止夫妻传送
    PlayObject.m_boAllowGuildReCall := False; // 禁止行会合一
    PlayObject.m_boAllowGroupReCall := False; // 禁止天地合一
    PlayObject.m_boDisableHorseInvite := True; // 禁止邀请上马 chongchong 2013-10-16

    if PlayObject.m_GroupOwner = PlayObject then
      PlayObject.CancelGroup; // 解散小组

    if PlayObject.m_boDealing then // 交易中退出挂机
      PlayObject.DealCancel;

    if PlayObject.m_boChallengeing then
      PlayObject.ChallengeCancel();

    // 离线挂机禁止摆摊功能调用 piaoyun 2013-07-17
    // 禁止离线摆摊
    if g_Config.boOffLineShop then
    begin
      PlayObject.m_boShopStall := False;
      PlayObject.FeatureChanged;
    end;

    // 禁止离线英雄
    if g_Config.boOffLineHero then
    begin
      HeroObject := THeroObject(PlayObject.m_MyHero);
      if HeroObject <> nil then
        HeroObject.LogOut;
    end;

    // 禁止离线宝宝
    if g_Config.boOffLineSlave then
    begin
      for I := PlayObject.m_SlaveList.Count - 1 downto 0 do
      begin
        TBaseObject(PlayObject.m_SlaveList.Items[I]).MakeGhost;
        TBaseObject(PlayObject.m_SlaveList.Items[I]).m_WAbil.HP := 0;
      end;
    end;

    PlayObject.ClearObject;
  end;
end;

procedure ActionOfKickOffLine(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  if PlayObject.m_boOffLine then
