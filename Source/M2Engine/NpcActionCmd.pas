procedure ActionOfGetDBItemFieldValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  StdItem: pTStdItem;
  sValue: string;
  nIdx: Integer;
begin
  if (Length(QuestActionInfo.sParam1) = 0) //
    or (Length(QuestActionInfo.sParam2) = 0) //
    or (Length(QuestActionInfo.sRawParam3) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  StdItem := UserEngine.GetStdItemEx(QuestActionInfo.sParam1, nIdx);
  if StdItem = nil then
    sValue := ''
  else
  begin
    if SameText(QuestActionInfo.sParam2, 'Idx') then
      sValue := IntToStr(nIdx - 1)
    else if SameText(QuestActionInfo.sParam2, 'Name') then
      sValue := StdItem.Name
    else if SameText(QuestActionInfo.sParam2, 'StdMode') then
      sValue := IntToStr(StdItem.StdMode)
    else if SameText(QuestActionInfo.sParam2, 'Shape') then
      sValue := IntToStr(StdItem.Shape)
    else if SameText(QuestActionInfo.sParam2, 'Weight') then
      sValue := IntToStr(StdItem.Weight)
    else if SameText(QuestActionInfo.sParam2, 'Anicount') then
      sValue := IntToStr(StdItem.AniCount)
    else if SameText(QuestActionInfo.sParam2, 'Source') then
      sValue := IntToStr(StdItem.Source)
    else if SameText(QuestActionInfo.sParam2, 'Reserved') then
      sValue := IntToStr(StdItem.Reserved)
    else if SameText(QuestActionInfo.sParam2, 'Looks') then
      sValue := IntToStr(StdItem.Looks)
    else if SameText(QuestActionInfo.sParam2, 'DuraMax') then
      sValue := IntToStr(StdItem.DuraMax)
    else if SameText(QuestActionInfo.sParam2, 'Ac') then
      sValue := IntToStr(StdItem.AC1)
    else if SameText(QuestActionInfo.sParam2, 'Ac2') then
      sValue := IntToStr(StdItem.AC2)
    else if SameText(QuestActionInfo.sParam2, 'Mac') then
      sValue := IntToStr(StdItem.MAC1)
    else if SameText(QuestActionInfo.sParam2, 'Mac2') then
      sValue := IntToStr(StdItem.MAC2)
    else if SameText(QuestActionInfo.sParam2, 'Dc') then
      sValue := IntToStr(StdItem.DC1)
    else if SameText(QuestActionInfo.sParam2, 'Dc2') then
      sValue := IntToStr(StdItem.DC2)
    else if SameText(QuestActionInfo.sParam2, 'Mc') then
