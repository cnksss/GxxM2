procedure ActionOfAddHumNewValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  nValType, nPoint, nTime, nOldValue: Integer;
  cMethod: Char;
  Int64Value: Int64;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nValType := QuestActionInfo.nParam1;

  if Length(QuestActionInfo.sParam2) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  nPoint := QuestActionInfo.nParam3;
  nTime := QuestActionInfo.nParam4;

  cMethod := QuestActionInfo.sParam2[1];
  nOldValue := SmartObject.m_dwAddHumNewValue[nValType];

  if nTime <= 0 then
    nTime := -1;

  case cMethod of
    '+':
      begin
        if nValType in [1, 7, 8, 10, 22] then
        begin
          Int64Value := Int64(SmartObject.m_dwAddHumNewValue[nValType]) + nPoint;
          SmartObject.m_dwAddHumNewValue[nValType] := Min(Int64Value, High(LongWord))
        end
        else
        begin
          Int64Value := Int64(SmartObject.m_dwAddHumNewValue[nValType]) + nPoint;
          SmartObject.m_dwAddHumNewValue[nValType] := Min(Int64Value, 100)
        end;
      end;
    '-':
      begin
        SmartObject.m_dwAddHumNewValue[nValType] := Max(SmartObject.m_dwAddHumNewValue[nValType] - nPoint, 0);
      end;
    '=':
      begin
        SmartObject.m_dwAddHumNewValue[nValType] := nPoint;
      end;
  end;
  SmartObject.m_dwAddHumNewValueTime[nValType] := nTime;

  if nOldValue <> SmartObject.m_dwAddHumNewValue[nValType] then
  begin
    // SmartObject.m_boRecalcAbilitys := True;

    if SmartObject.m_nLockUpdateAbil = 0 then
    begin
      SmartObject.RecalcAbilitys;
      // 属性不在人物身上显示
      SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
    end;
  end;
end;

procedure ActionOfVerifyCode(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
