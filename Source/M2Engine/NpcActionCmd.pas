  begin
    PlayObject.SendDefMessage(SM_ENABLE_UPLOAD_PICKITEMS, 0, 1, 0, 0, '');
  end;
end;

procedure ActionOfChangeMapMonName(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  MonList: TList;
  mon: TBaseObject;
  I: Integer;
  Envir: TEnvirnoment;
  nX, nY, nRange: Integer;
  sOldMonName, sNewMonName: string;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  nX := QuestActionInfo.nParam2;
  nY := QuestActionInfo.nParam3;
  nRange := QuestActionInfo.nParam4;
  sOldMonName := QuestActionInfo.sParam5;
  sNewMonName := QuestActionInfo.sParam6;

  if (sNewMonName = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if Envir <> nil then
  begin
    MonList := TList.Create;

    try
      if (nX = 0) and (nY = 0) and (nRange = 0) then
        UserEngine.GetMapMonster(Envir, MonList, True)
      else
        Envir.GetRangeBaseObject(nX, nY, nRange, True, MonList);

      for I := 0 to MonList.Count - 1 do
      begin
        mon := TBaseObject(MonList.Items[I]);
        if mon.m_Master <> nil then
          Continue;

        if mon.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
          Continue;

        // 在调用 ClearMapMon时，会干掉城堡中的守卫等 chongchong 2018-01-26
        // 修正沙巴克城门等过段时间会自动改变 chongchong 2018-01-26
        if mon.m_Castle <> nil then
          Continue;

        if mon.m_boDeath or mon.m_boGhost then
          Continue;

        if (sOldMonName = '*') or SameText(mon.m_sCharName, sOldMonName) then
        begin
          mon.m_sCharName := sNewMonName;
          mon.m_boUseOldDropFile := False;
          mon.RefShowName;
        end;
      end;
    finally
      MonList.Free;
    end;
  end;
end;

