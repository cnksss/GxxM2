// 设置封号元素属性 chongchong 2014-05-28
procedure ActionOfSetNewFengHaoValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sItemName: string;
  I, nValType, nPoint, nOldValue: Integer;
  UserItem: pTUserItem;
  cMethod: Char;
  StdItem: pTStdItem;
  SmartObject: TSmartObject;
begin
  sItemName := QuestActionInfo.sParam1;
  nValType := QuestActionInfo.nParam2;
  nPoint := QuestActionInfo.nParam4;

  if (QuestActionInfo.sParam3 = '') or (nValType < 0) or (nValType > 25) or (Length(sItemName) = 0) or (nPoint < 0) or (nPoint > 100) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if not (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
    Exit;

  SmartObject := TSmartObject(BaseObject);

  cMethod := QuestActionInfo.sParam3[1];
  for I := 0 to SmartObject.m_FengHaoItems.Count - 1 do
  begin
    UserItem := SmartObject.m_FengHaoItems.Items[I];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);

    if (StdItem <> nil) and SameText(StdItem.Name, sItemName) then
    begin
      nOldValue := UserItem.btNewValue[nValType];
      case cMethod of
        '+':
          begin
            UserItem.btNewValue[nValType] := Min(UserItem.btNewValue[nValType] + nPoint, 100);
          end;
        '-':
          begin
            UserItem.btNewValue[nValType] := Max(UserItem.btNewValue[nValType] - nPoint, 0);
          end;
        '=':
          begin
            UserItem.btNewValue[nValType] := nPoint;
          end;
      end;

      if nOldValue <> UserItem.btNewValue[nValType] then
      begin
        // SmartObject.m_boRecalcAbilitys := True;
        // SmartObject.m_RecalcAbilitysChanges := SmartObject.m_RecalcAbilitysChanges + [racSubAbility];
        if SmartObject.m_nLockUpdateAbil = 0 then
        begin
          SmartObject.RecalcAbilitys;
          SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
          SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
        end;

        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(SmartObject).SendUpdateItemNewValue(-1, UserItem.MakeIndex, False, nValType, UserItem.btNewValue[nValType])
        else
          THeroObject(SmartObject).SendUpdateItemNewValue(-1, UserItem.MakeIndex, nValType, UserItem.btNewValue[nValType]);
      end;

      Break;
    end;
  end;
end;

