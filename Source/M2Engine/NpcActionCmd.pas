procedure ActionOfGetAllDBItemFieldValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
resourcestring
  SQL_STR = 'select %s from StdItems where name = "%s"';
var
  I, tmpSum: Integer;
  tmpFind: Boolean;
  tmpStdItem: pTStdItem;
  tmpDB: TSQLite3Database;
  tmpSM: TSQLStatement;
  tmpItemNames: TStrings;

  function SqliteExtractValue(const AFieldName, AItemName: string): Integer;
  var
    tmpSubSM: TSQLStatement;
  begin
    Result := 0;
    if not SameText(QuestActionInfo.sParam2, 'Name') then //
    begin
      tmpSubSM := tmpDB.Statements.AddSQLStatement('Select_StdItems');
      tmpSubSM.Sql := Format(SQL_STR, [AFieldName, AItemName]);
      tmpSubSM.Prepare;
      try
        if (tmpSubSM.Step = SQLITE_ROW) and (tmpSubSM.GetColumnCount > 0) then
          Result := tmpSubSM.GetColumnValueInt(0);
      finally
        tmpSubSM.Finalize;
      end;
    end;
  end;

begin
  if (PlayObject = nil) //
    or QuestActionInfo.sParam1.IsEmpty //
    or QuestActionInfo.sRawParam2.IsEmpty //
    or not FileExists(g_sSqliteDBName) then
  begin
    Npc.ScriptActionError(BaseObject, '参数缺失', QuestActionInfo);
    Exit;
  end;

  tmpItemNames := TStringList.Create;
  try
    with PlayObject do
    begin
      for I := Low(m_UseItems) to High(m_UseItems) do // 身上装备
      begin
        tmpStdItem := UserEngine.GetStdItem(m_UseItems[I].wIndex);
        if tmpStdItem <> nil then
          tmpItemNames.Add(tmpStdItem.DBName);
      end;

      for I := Low(m_JewelryBoxItems) to High(m_JewelryBoxItems) do // 首饰盒
      begin
        tmpStdItem := UserEngine.GetStdItem(m_JewelryBoxItems[I].wIndex);
        if tmpStdItem <> nil then
          tmpItemNames.Add(tmpStdItem.DBName);
      end;

      for I := Low(m_GodBlessItems) to High(m_GodBlessItems) do // 神佑袋
      begin
        tmpStdItem := UserEngine.GetStdItem(m_GodBlessItems[I].wIndex);
        if tmpStdItem <> nil then
          tmpItemNames.Add(tmpStdItem.DBName);
      end;
    end;

    tmpSum := 0;
    tmpFind := False;
    if g_boUseSqliteDB then
    begin
      tmpDB := TSQLite3Database.Create;
      try
        tmpDB.MustExist := True;
        tmpDB.Database := g_sSqliteDBName;
        tmpDB.Connected := True;
        tmpSM := tmpDB.Statements.AddSQLStatement('Select_StdItems');
        tmpSM.Sql := 'select * from StdItems';
        tmpSM.Prepare;
        try
          for I := 0 to tmpSM.GetColumnCount - 1 do
          begin
            if SameText(QuestActionInfo.sParam1, tmpSM.GetColumnName(I)) then
            begin
              tmpFind := True;
              Break;
            end;
          end;

          if not tmpFind then
          begin
            Npc.ScriptActionError(BaseObject, '字段名不存在', QuestActionInfo);
            Exit;
          end;
        finally
          tmpSM.Finalize;
        end;

        for I := 0 to tmpItemNames.Count - 1 do
          Inc(tmpSum, SqliteExtractValue(QuestActionInfo.sParam1, tmpItemNames[I]));

        tmpDB.Connected := False;
      finally
        tmpDB.Free;
      end;
    end
    else
    begin
      Npc.ScriptActionError(BaseObject, '非SQLite数据库不支持此命令', QuestActionInfo);
      Exit;
    end;
  finally
    tmpItemNames.Free;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(tmpSum), tmpSum) then
    Npc.ScriptActionError(PlayObject, '变量保存错误', QuestActionInfo);
end;

procedure GetDBMagicValue(ADataType: Byte; Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
resourcestring
  SQL_STR1 = 'select %s from Magic where MagName = "%s"';
  SQL_STR2 = 'select %s from Magic where MagID = "%d"';
var
  tmpSum: Integer;
  tmpDB: TSQLite3Database;
  tmpSM: TSQLStatement;
begin
  if (PlayObject = nil) //
    or QuestActionInfo.sParam1.IsEmpty //
    or QuestActionInfo.sParam2.IsEmpty //
    or SameText(QuestActionInfo.sParam2, 'MagName') //
    or QuestActionInfo.sRawParam3.IsEmpty //
    or not FileExists(g_sSqliteDBName) then
  begin
    Npc.ScriptActionError(BaseObject, '数据库不存在或参数缺失或字段类型非整形', QuestActionInfo);
    Exit;
  end;

  tmpSum := 0;
  if g_boUseSqliteDB then
  begin
    tmpDB := TSQLite3Database.Create;
    try
      tmpDB.MustExist := True;
      tmpDB.Database := g_sSqliteDBName;
      tmpDB.Connected := True;
      tmpSM := tmpDB.Statements.AddSQLStatement('Select_Magics');
      if ADataType = 0 then
        tmpSM.Sql := Format(SQL_STR1, [QuestActionInfo.sParam2, QuestActionInfo.sParam1])
      else
        tmpSM.Sql := Format(SQL_STR2, [QuestActionInfo.sParam2, QuestActionInfo.nParam1]);

      tmpSM.Prepare;
      try
        if tmpSM.GetColumnCount > 0 then
        begin
          if tmpSM.Step = SQLITE_ROW then
            tmpSum := tmpSM.GetColumnValueInt(0);
        end
        else
        begin
          Npc.ScriptActionError(BaseObject, '技能名或字段名不存在', QuestActionInfo);
          Exit;
        end;
      finally
        tmpSM.Finalize;
      end;

      tmpDB.Connected := False;
    finally
      tmpDB.Free;
    end;
  end
  else
  begin
    Npc.ScriptActionError(BaseObject, '非SQLite数据库不支持此命令', QuestActionInfo);
    Exit;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, IntToStr(tmpSum), tmpSum) then
    Npc.ScriptActionError(PlayObject, '变量保存错误', QuestActionInfo);
end;

