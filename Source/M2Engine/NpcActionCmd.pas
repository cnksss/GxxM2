var
  I: Integer;
  tempUserItem: pTUserItem;
  UserItem: TUserItem;
  StdItem: pTStdItem;
  List: TList<string>;
  sValue: string;
  aryLValue: TArray<string>;
  sItem: string;
begin

  if not QuestActionInfo.nParam1 in [0, 1] then
  begin
    Npc.ScriptActionError(PlayObject, '第一个参数不正确', QuestActionInfo);
    Exit;
  end;

//  if QuestActionInfo.sParam2 = '' then
//  begin
//    Npc.ScriptActionError(PlayObject, '第二个参数不正确', QuestActionInfo);
//    Exit;
//  end;

  if QuestActionInfo.sRawParam3 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '第三个参数不正确', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.sRawParam4 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '第四个参数不正确', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.nParam1 = 0 then
  begin
    tempUserItem := pTUserItem(PlayObject.m_ItemList[QuestActionInfo.nParam2]);
    UserItem := tempUserItem^;
    if not IsHeroM2ShopItem(PlayObject, UserItem) then
    begin
      sValue := GetItemValue(QuestActionInfo.sRawParam3, tempUserItem);
    end;
  end
  else
  begin
    aryLValue := QuestActionInfo.sParam2.Split([',']);
    for sItem in aryLValue do
    begin
      for I := 0 to PlayObject.m_ItemList.Count - 1 do
      begin
        tempUserItem := pTUserItem(PlayObject.m_ItemList[I]);
        UserItem := pTUserItem(PlayObject.m_ItemList[I])^;
        if not IsHeroM2ShopItem(PlayObject, UserItem) then
        begin
          if UserItem.MakeIndex = strtoint(sItem) then
          begin
            sValue := GetItemValue(QuestActionInfo.sRawParam3, tempUserItem);
          end;
        end;
      end;
    end;

  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, sValue, 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;

end;

