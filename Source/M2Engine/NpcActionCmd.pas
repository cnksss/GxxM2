procedure ActionOfReturn(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nCut, nParam: Integer;
  sCmd, sCmdLine, sTmp, sParam: string;
  sTmpList: TStringList;
  nFalg: Boolean;
begin
  sCmdLine := QuestActionInfo.sCmdLine;
  sCmdLine := GetValidStr3(sCmdLine, sCmd, [' ', ',', #9]);

  sTmpList := TStringList.Create;
  try
    while True do
    begin
      if sCmdLine = '' then
        Break;
      sCmdLine := GetValidStr3(sCmdLine, sTmp, [' ', ',', #9]);
      Npc.GetVarValue(PlayObject, sTmp, sParam, nParam, nFalg);
      sTmpList.AddObject(sParam, TObject(nParam));
    end;
    nCut := 0;
    while True do
    begin
      if PlayObject.m_sReturnParams[nCut] = '' then
        Break;
      if not Npc.SetVarValue(PlayObject, PlayObject.m_sReturnParams[nCut], sTmpList[nCut], Integer(sTmpList.Objects[nCut])) then
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Inc(nCut, 1);
    end;
  finally
    sTmpList.Free;
  end;
  boBreak := True;
end;

