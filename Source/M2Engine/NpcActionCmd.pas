          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 4) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 4);
        end
        else if TempMagic.wMagIdx = SKILL_101 then // 三绝杀
