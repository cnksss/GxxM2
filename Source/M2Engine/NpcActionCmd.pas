procedure ActionOfChangeGamePetLevel(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  boChgOK: Boolean;
  nLevel: Int64;
  cMethod: Char;
begin
  if PlayObject.m_MyGamePet = nil then
    Exit;

  boChgOK := False;
  nLevel := StrToInt64Def(QuestActionInfo.sParam2, 0);
  if nLevel > High(LongWord) then
    nLevel := High(LongWord);

  if (QuestActionInfo.sParam1 = '') or (nLevel < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if g_Config.btMaxLevel = 0 then
          nLevel := Min(nLevel, MAXLEVEL)
        else if g_Config.btMaxLevel = 1 then
          nLevel := Min(nLevel, High(Integer));

        PlayObject.m_MyGamePet.m_Abil.Level := nLevel;
        boChgOK := True;
      end;
    '-':
      begin
        nLevel := PlayObject.m_MyGamePet.m_Abil.Level - nLevel;
        if nLevel < 0 then
          nLevel := 0;

        if g_Config.btMaxLevel = 0 then
          nLevel := Min(nLevel, MAXLEVEL)
        else if g_Config.btMaxLevel = 1 then
          nLevel := Min(nLevel, High(Integer));

        PlayObject.m_MyGamePet.m_Abil.Level := nLevel;
        boChgOK := True;
      end;
    '+':
      begin
        nLevel := PlayObject.m_MyGamePet.m_Abil.Level + nLevel;

        if g_Config.btMaxLevel = 0 then
          nLevel := Min(nLevel, MAXLEVEL)
        else if g_Config.btMaxLevel = 1 then
          nLevel := Min(nLevel, High(Integer))
        else
          nLevel := Min(nLevel, High(LongWord));

        PlayObject.m_MyGamePet.m_Abil.Level := nLevel;
        boChgOK := True;
      end;
  end;

  if boChgOK then
  begin
    PlayObject.m_MyGamePet.RecalcAbilitys;
    PlayObject.SendUpdatePetAbility(PlayObject.m_MyGamePet);

    if g_FunctionNPC <> nil then
    begin
      PlayObject.m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(PlayObject, '@GamePetLevelUp', False);
    end;

    if (g_Config.nPetAbilToMasterRate > 0) and (g_Config.boPetHPToMaster or g_Config.boPetDCToMaster or g_Config.boPetMCToMaster or g_Config.boPetSCToMaster or g_Config.boPetACToMaster or g_Config.boPetMACToMaster) then
    begin
      // PlayObject.m_boRecalcAbilitys := True;
      PlayObject.RecalcAbilitys;
      PlayObject.SendMsg(PlayObject, RM_ABILITY, 0, 0, 0, 0, '');
    end;
  end;
end;

procedure ActionOfChangeGamePetAbility(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  AObject: TBaseObject;
