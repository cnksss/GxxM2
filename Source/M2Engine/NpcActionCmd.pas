procedure ActionOfPlayMagicBallEffect(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Info: TMagicBallEffectInfo;
  sSendMsg: AnsiString;
begin
  Info.FileIndex := QuestActionInfo.nParam1;
  Info.ImageIndex := QuestActionInfo.nParam2;
  Info.ImageCount := QuestActionInfo.nParam3;
  Info.FrameTime := QuestActionInfo.nParam4;
  Info.ShowTime := QuestActionInfo.nParam5;
  Info.ShowType := QuestActionInfo.nParam6;
  Info.DrawHeigh := QuestActionInfo.nParam7;
  Info.DrawType := QuestActionInfo.nParam8;
  Info.OffsetX := QuestActionInfo.nParam9;
  Info.OffsetY := QuestActionInfo.nParam10;
  Info.IsNormalDraw := Trim(QuestActionInfo.sSubParam10) = '1';
