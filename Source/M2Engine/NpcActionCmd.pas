procedure ActionOfChangeItemAddValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nType, nBoxItemIndex, nMakeIndex: Integer;
  cMethod: Char;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  nValue: Integer;
  Int64Value: Int64;
  SmartObject: TSmartObject;
  LockUpdateItemIndex: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  nType := QuestActionInfo.nParam2;
  nValue := QuestActionInfo.nParam4;

  // 扩展装备位置 chongchong 2014-04-26
  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if (QuestActionInfo.sParam3 = '') or (not (nType in [0..14])) or (nValue < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  LockUpdateItemIndex := -1;
  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;
      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(BaseObject).m_LinkItem then
        begin
          UserItem := THeroObject(BaseObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    cMethod := QuestActionInfo.sParam3[1];
    if nType = 14 then
    begin
      case cMethod of
        '+':
          begin
            Int64Value := Int64(UserItem.DuraMax) + nValue;
            if Int64Value > High(Word) then
              Int64Value := High(Word);
            UserItem.DuraMax := Int64Value;
          end;
        '-':
          begin
            Int64Value := Int64(UserItem.DuraMax) - nValue;
            UserItem.DuraMax := Max(Int64Value, 0);
          end;
        '=':
          UserItem.DuraMax := Min(nValue, High(Word));
      end;
      // 2020-10-26
      if (UserItem.DuraMax = 0) and (StdItem <> nil) then
        UserItem.DuraMax := StdItem.DuraMax;
    end // 武器幸运诅咒调整  // 修正幸运和诅咒不会抵消 2019-01-30 17:55:53
    else if (StdItem <> nil) and (StdItem.StdMode in [5, 6, 68, 69]) and (nType in [3, 4]) then
    begin
      // 调整幸运
      if nType = 3 then
      begin
        case cMethod of
          '+':
            begin
              if UserItem.btValue[4] > 0 then
              begin
                if nValue >= UserItem.btValue[4] then
                begin
                  nValue := nValue - UserItem.btValue[4];
                  UserItem.btValue[4] := 0;
                end
                else
                begin
                  UserItem.btValue[4] := UserItem.btValue[4] - nValue;
                  nValue := 0;
                end;
              end;

              Int64Value := Int64(UserItem.btValue[nType]) + nValue;
              if Int64Value > High(Integer) then
                Int64Value := High(Integer);
              UserItem.btValue[nType] := Int64Value;
            end;
          '-':
            begin
              if UserItem.btValue[nType] > nValue then // 幸运够
                UserItem.btValue[nType] := UserItem.btValue[nType] - nValue
              else
              begin
                if UserItem.btValue[nType] > 0 then
                begin
                  nValue := nValue - UserItem.btValue[nType];
                  UserItem.btValue[nType] := 0;
                end;

                if nValue > 0 then
                begin
                  Int64Value := UserItem.btValue[4] + nValue;
                  if Int64Value > High(Integer) then
                    Int64Value := High(Integer);
                  UserItem.btValue[4] := Int64Value;
                end;
              end;
            end;
          '=':
            UserItem.btValue[nType] := nValue;
        end;
      end // 诅咒
      else
      begin
        case cMethod of
          '+':
            begin
              if UserItem.btValue[3] > 0 then
              begin
                if nValue >= UserItem.btValue[3] then
                begin
                  nValue := nValue - UserItem.btValue[3];
                  UserItem.btValue[3] := 0;
                end
                else
                begin
                  UserItem.btValue[3] := UserItem.btValue[3] - nValue;
                  nValue := 0;
                end;
              end;

              Int64Value := Int64(UserItem.btValue[nType]) + nValue;
              if Int64Value > High(Integer) then
                Int64Value := High(Integer);
              UserItem.btValue[nType] := Int64Value;
            end;
          '-':
            begin
              if UserItem.btValue[nType] > nValue then // 诅咒够
                UserItem.btValue[nType] := UserItem.btValue[nType] - nValue
              else
              begin
                if UserItem.btValue[nType] > 0 then
                begin
                  nValue := nValue - UserItem.btValue[nType];
                  UserItem.btValue[nType] := 0;
                end;

                if nValue > 0 then
                begin
                  Int64Value := UserItem.btValue[3] + nValue;
                  if Int64Value > High(Integer) then
                    Int64Value := High(Integer);
                  UserItem.btValue[3] := Int64Value;
                end;
              end;
            end;
          '=':
            UserItem.btValue[nType] := nValue;
        end;
      end;
    end
    else
    begin
      case cMethod of
        '+':
          begin
            Int64Value := Int64(UserItem.btValue[nType]) + nValue;
            if Int64Value > High(Integer) then
              Int64Value := High(Integer);
            UserItem.btValue[nType] := Int64Value;
          end;
        '-':
          begin
            Int64Value := Int64(UserItem.btValue[nType]) - nValue;
            if Int64Value < 0 then
              Int64Value := 0;
            UserItem.btValue[nType] := Int64Value;
          end;
        '=':
          UserItem.btValue[nType] := nValue;
      end;
    end;

    // if (nWhere >= 0) then
    // begin
    // SmartObject.m_boRecalcAbilitys := True;
    // end;
    if (nWhere >= 0) and (SmartObject.m_nLockUpdateAbil = 0) then
    begin
      SmartObject.RecalcAbilitys;
      SmartObject.SendMsg(PlayObject, RM_ABILITY, 0, 0, 0, 0, '');
    end;

    if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        if nType = 14 then
        begin
          if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
            TPlayObject(SmartObject).SendUpdateItemDuraMax(nBoxItemIndex, UserItem.MakeIndex, True, UserItem.DuraMax)
          else
            TPlayObject(SmartObject).SendUpdateItemDuraMax(nWhere, UserItem.MakeIndex, False, UserItem.DuraMax)
        end
        else
        begin
          if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
            TPlayObject(SmartObject).UpdateBoxItem(nBoxItemIndex)
          else
            TPlayObject(SmartObject).SendUpdateItem(UserItem);
        end;
      end
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
      begin
        if nType = 14 then
          THeroObject(SmartObject).SendUpdateItemDuraMax(nWhere, UserItem.MakeIndex, UserItem.DuraMax)
        else
          THeroObject(SmartObject).SendUpdateItem(UserItem);
      end;
    end;
  end;
end;

