procedure ActionOfLockUpdateItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nBoxItemIndex, nWhere, I, LockUpdateItemIndex: Integer;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -3;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -3);

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  LockUpdateItemIndex := -1;

  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;
  end
  else if nWhere = -1 then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;
    end
  end;

  if (LockUpdateItemIndex >= Low(SmartObject.m_nLockUpdateItems)) and (LockUpdateItemIndex <= High(SmartObject.m_nLockUpdateItems)) then
    Inc(SmartObject.m_nLockUpdateItems[LockUpdateItemIndex]);
end;

procedure ActionOfUpdateItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nBoxItemIndex, nMakeIndex: Integer;
  UserItem: pTUserItem;
  LockUpdateItemIndex: Integer;
  SmartObject: TSmartObject;
  IsBoxItem: Boolean;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -3;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -3);

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  LockUpdateItemIndex := -1;
  UserItem := nil;
  IsBoxItem := False;

  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := PlayObject.m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex <> 0 then
      begin
        for I := 0 to PlayObject.m_ItemList.Count - 1 do
        begin
          if pTUserItem(PlayObject.m_ItemList[I]).MakeIndex = nMakeIndex then
          begin
            IsBoxItem := True;
            UserItem := PlayObject.m_ItemList[I];
            Break;
          end;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
    end;
  end
  else if nWhere = -1 then
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if (LockUpdateItemIndex >= Low(SmartObject.m_nLockUpdateItems)) and (LockUpdateItemIndex <= High(SmartObject.m_nLockUpdateItems)) then
  begin
    if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] > 0 then
      Dec(SmartObject.m_nLockUpdateItems[LockUpdateItemIndex]);

    if (SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0) and (UserItem <> nil) and (UserItem.wIndex > 0) then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        if IsBoxItem then
          TPlayObject(SmartObject).UpdateBoxItem(nBoxItemIndex)
        else
          TPlayObject(SmartObject).SendUpdateItem(UserItem);
      end
      else
      begin
        THeroObject(SmartObject).SendUpdateItem(UserItem)
      end;
    end;
  end;
end;

procedure ActionOfLinkPickupItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  Player: TPlayObject;
begin
  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
  begin
    Player := TPlayObject(BaseObject);

    // 先把升级框的清掉再说 chongchong 2015-11-14
    if (Player.m_UpgradeItem <> nil) then
    begin
      Player.SendDefMessage(SM_UPGRADEDLGITEM_TAKE, 0, 0, 0, 0, '');
    end;

    if Player.m_PickUpOrDropItemIsPetBag then
    begin
      for I := 0 to Player.m_GamePetBagItems.Count - 1 do
      begin
        UserItem := Player.m_GamePetBagItems.Items[I];
        if UserItem.MakeIndex = BaseObject.m_PickUpOrDropItem.MakeIndex then
        begin
          Player.m_UpgradeItemIsPegBag := True;
          Player.m_UpgradeItem := UserItem;
          Break;
        end;
      end;
    end
    else
    begin
      for I := 0 to BaseObject.m_ItemList.Count - 1 do
      begin
        UserItem := BaseObject.m_ItemList.Items[I];
        if UserItem.MakeIndex = BaseObject.m_PickUpOrDropItem.MakeIndex then
        begin
          Player.m_UpgradeItemIsPegBag := False;
          Player.m_UpgradeItem := UserItem;
          Break;
        end;
      end;
    end;
  end
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
  begin
    for I := 0 to BaseObject.m_ItemList.Count - 1 do
    begin
      UserItem := BaseObject.m_ItemList.Items[I];
      if UserItem.MakeIndex = BaseObject.m_PickUpOrDropItem.MakeIndex then
      begin
        THeroObject(BaseObject).m_LinkItem := UserItem;
        Break;
      end;
    end;
  end;
end;

procedure ActionOfGiveOnItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);

// 扩展参数 chongchong 2014-10-30
  procedure AddNewValue(Item: pTUserItem);
  var
    Int64Value: Int64;
  begin
    Int64Value := Item.btValue[0] + StrToInt64Def(QuestActionInfo.sParam4, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[0] := Max(0, Int64Value);

    Int64Value := Item.btValue[1] + StrToInt64Def(QuestActionInfo.sParam5, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[1] := Max(0, Int64Value);

    Int64Value := Item.btValue[2] + StrToInt64Def(QuestActionInfo.sParam6, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[2] := Max(0, Int64Value);

    Int64Value := Item.btValue[3] + StrToInt64Def(QuestActionInfo.sParam7, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[3] := Max(0, Int64Value);

    Int64Value := Item.btValue[4] + StrToInt64Def(QuestActionInfo.sParam8, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[4] := Max(0, Int64Value);

    Int64Value := Item.btValue[5] + StrToInt64Def(QuestActionInfo.sParam9, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[5] := Max(0, Int64Value);
  end;

var
  UserItem: pTUserItem;
  OldUserItem: TUserItem;
  StdItem: pTStdItem;
  sItemName, sTakeOffItemName: string;
  nItemCount: Integer;
  TakeOffItem: TUserItem;
  I, nWhere, nBoxItemIndex, NewItemMakeIndex: Integer;
  SmartObject: TSmartObject;
begin

  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -3;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -3);

  sItemName := QuestActionInfo.sParam2;
  nItemCount := QuestActionInfo.nParam3;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)) and (SmartObject.m_btRaceServer <> RC_PLAYOBJECT) then
  begin
    Npc.ScriptActionError(BaseObject, '自定义OK框的操作对象必须是人物', QuestActionInfo);
    Exit;
  end;

  if (nWhere = -1) and (SmartObject.m_btRaceServer <> RC_PLAYOBJECT) then
  begin
    Npc.ScriptActionError(BaseObject, '升级框的操作对象必须是人物', QuestActionInfo);
    Exit;
  end;

  if (sItemName = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  NewItemMakeIndex := -1;
  if nItemCount <= 0 then
    nItemCount := 1;

  StdItem := UserEngine.GetStdItem(sItemName);
  if StdItem = nil then
    Exit;

  if not SmartObject.IsEnoughBag then
  begin
    SmartObject.SysMsg('包裹没有空位', c_Red, t_Hint);
    Exit;
  end;

  if CheckOverLapItem(StdItem) then
  begin
    New(UserItem);
    if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
    begin
      if UserItem.DuraMax > nItemCount then
      begin
        UserItem.Dura := nItemCount - 1;
      end
      else
      begin
        UserItem.Dura := UserItem.DuraMax - 1;
      end;

      { TODO -ochongchong -c修改 : 脚本制造的装备不给特殊属性 【2013-08-01】 }
      UserEngine.RandomItemNewAbil(u_Script, UserItem);
      AddNewValue(UserItem);

      UserItem.ItemFrom.ItemForm := ifScript;
      UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
      UserItem.ItemFrom.DateTime := Now();

      SmartObject.m_ItemList.Add(UserItem);

      SmartObject.m_nLastGiveItemMakeIndex := UserItem.MakeIndex;

      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).SendAddItem(UserItem)
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(SmartObject).SendAddItem(UserItem);

      NewItemMakeIndex := UserItem.MakeIndex;

      if StdItem.NeedIdentify = 1 then
      begin
        // 注释日志 chongchong 2017-10-09
        AddGameDataLog(LOG_ItemNpcGive, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, UserItem.Dura + 1, 0, Format('叠加;[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;
    end
    else
      Dispose(UserItem);
  end
  else
  begin
    New(UserItem);
    if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
    begin
      { TODO -ochongchong -c修改 : 脚本制造的装备不给特殊属性 【2013-08-01】 }
      UserEngine.RandomItemNewAbil(u_Script, UserItem);
      AddNewValue(UserItem);

      UserItem.ItemFrom.ItemForm := ifScript;
      UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
      UserItem.ItemFrom.DateTime := Now();

      SmartObject.m_ItemList.Add(UserItem);

      SmartObject.m_nLastGiveItemMakeIndex := UserItem.MakeIndex;

      if (UserItem.boStartTime) then
      begin
        if StdItem.Need = 103 then
          SmartObject.SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System)
        else
          SmartObject.SysMsg(Format('您的限时物品[%s]开始计时，到期时间%s', [StdItem.Name, GetIncMinuteTime(UserItem.ItemFrom.DateTime, StdItem.NeedLevel)]), c_Red, t_System)
      end;

      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).SendAddItem(UserItem)
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(SmartObject).SendAddItem(UserItem);

      NewItemMakeIndex := UserItem.MakeIndex;

      if StdItem.NeedIdentify = 1 then
      begin
        // 注释日志 chongchong 2017-10-09
        AddGameDataLog(LOG_ItemNpcGive, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;
    end
    else
      Dispose(UserItem);
  end;

  if NewItemMakeIndex = -1 then
    Exit;

  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex] <> 0 then
    begin
      TPlayObject(SmartObject).m_nScriptGotoCount := 0;
      if not Npc.GotoLable(TPlayObject(SmartObject), '@ItemOutBox' + IntToStr(nBoxItemIndex), False) then
      begin
        if g_FunctionNPC <> nil then
        begin
          g_FunctionNPC.GotoLable(TPlayObject(SmartObject), '@ItemOutBox' + IntToStr(nBoxItemIndex), False);
        end;
      end;

      TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex] := 0;
      TPlayObject(SmartObject).SendDefMessage(SM_TAKEBOXITEM, nBoxItemIndex, 0, 0, 0, '');
    end;

    TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex] := NewItemMakeIndex;
    TPlayObject(SmartObject).m_ItemBoxAddIndex := nBoxItemIndex;

    TPlayObject(SmartObject).m_nScriptGotoCount := 0;
    if not Npc.GotoLable(TPlayObject(SmartObject), '@ItemIntoBox' + IntToStr(nBoxItemIndex), False) then
    begin
      if g_FunctionNPC <> nil then
      begin
        g_FunctionNPC.GotoLable(TPlayObject(SmartObject), '@ItemIntoBox' + IntToStr(nBoxItemIndex), False);
      end;
    end;

    TPlayObject(SmartObject).SendDefMessage(SM_GIVEBOXITEM, NewItemMakeIndex, nBoxItemIndex, 0, 0, '');
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      TPlayObject(BaseObject).ClientTakeOnItemsEx(nWhere, NewItemMakeIndex, sItemName);
    end
    else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    begin
      THeroObject(BaseObject).ClientTakeOnItemsEx(nWhere, NewItemMakeIndex, sItemName);
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    if (StdItem <> nil) and (StdItem.OverLap and 2 <> 0) and ((StdItem.Expand1 = nWhere - U_JEWELRYITEM1 + 1) or (StdItem.Expand1 in [0, 7])) and (GetTakeOnPosition(StdItem.StdMode) in [U_HELMET { 头盔 }, U_NECKLACE { 项链 }, U_ARMRINGL { 左手镯 }, U_ARMRINGR
      { 右手镯 }, U_RINGL { 左戒指 }, U_RINGL { 右戒指 } ]) then
    begin
      OldUserItem := UserItem^;

      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        TPlayObject(SmartObject).SendDelItem(UserItem);

        // 删除物品时，清升级框  chongchong 2018-05-16
        if TPlayObject(SmartObject).m_UpgradeItem = UserItem then
        begin
          TPlayObject(SmartObject).m_UpgradeItem := nil;
          TPlayObject(SmartObject).m_UpgradeItemIsPegBag := False;
        end;
      end
      else if (SmartObject.m_Master <> nil) and (SmartObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        THeroObject(SmartObject).SendDelItem(UserItem);

        if THeroObject(SmartObject).m_LinkItem = UserItem then
        begin
          THeroObject(SmartObject).m_LinkItem := nil;
        end;
      end;

      SmartObject.m_ItemList.Remove(UserItem);
      Dispose(UserItem);

      if SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1].wIndex > 0 then
      begin
        New(UserItem);
        UserItem^ := SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
        TakeOffItem := UserItem^;

        if SmartObject.AddItemToBag(UserItem) then
        begin
          if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(SmartObject).SendAddItem(UserItem)
          else
            THeroObject(SmartObject).SendAddItem(UserItem);
        end
        else
        begin
          Dispose(UserItem);
          Exit;
        end;

        if g_FunctionNPC <> nil then
        begin
          if (TakeOffItem.btValue[13] = 1) and (TakeOffItem.Name <> '') then
            sTakeOffItemName := TakeOffItem.Name
          else
            sTakeOffItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);

          PlayObject.m_nScriptGotoCount := 0;

          if SmartObject.m_btRaceServer = RC_HEROOBJECT then
          begin
            SmartObject.m_nCurrentItemMakeIndex := TakeOffItem.MakeIndex;
            SmartObject.m_nCurrentItemPos := nWhere;
            SmartObject.m_sCurrentItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
            SmartObject.m_sCurrentItemNewName := sTakeOffItemName;

            SmartObject.m_PickUpOrDropItem := TakeOffItem;

            g_FunctionNPC.GotoLable(PlayObject, '@HeroTakeOff' + IntToStr(nWhere), False);
            g_FunctionNPC.GotoLable(PlayObject, '@HeroTakeOffEx', False);

            SmartObject.m_PickUpOrDropItem.MakeIndex := 0;
            SmartObject.m_PickUpOrDropItem.wIndex := 0;

            SmartObject.m_nCurrentItemMakeIndex := 0;
            SmartObject.m_nCurrentItemPos := 0;
            SmartObject.m_sCurrentItemName := '';
            SmartObject.m_sCurrentItemNewName := '';
          end
          else
          begin
            SmartObject.m_nCurrentItemMakeIndex := TakeOffItem.MakeIndex;
            SmartObject.m_nCurrentItemPos := nWhere;
            SmartObject.m_sCurrentItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
            SmartObject.m_sCurrentItemNewName := sTakeOffItemName;

            SmartObject.m_PickUpOrDropItem := TakeOffItem;

            g_FunctionNPC.GotoLable(PlayObject, '@TakeOff' + IntToStr(nWhere), False);
            g_FunctionNPC.GotoLable(PlayObject, '@TakeOffEx', False);

            SmartObject.m_PickUpOrDropItem.MakeIndex := 0;
            SmartObject.m_PickUpOrDropItem.wIndex := 0;

            SmartObject.m_nCurrentItemMakeIndex := 0;
            SmartObject.m_nCurrentItemPos := 0;
            SmartObject.m_sCurrentItemName := '';
            SmartObject.m_sCurrentItemNewName := '';
          end;
        end;
      end;

      SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1] := OldUserItem;

      // SmartObject.m_boRecalcAbilitys := True;
      // SmartObject.m_RecalcAbilitysChanges := [racSubAbility, racFeatureChanged];
      if SmartObject.m_nLockUpdateAbil = 0 then
      begin
        SmartObject.RecalcAbilitys();
        SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
        SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
      end;
      SmartObject.FeatureChanged();

      if g_FunctionNPC <> nil then
      begin
        if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        begin
          SmartObject.m_nCurrentItemMakeIndex := OldUserItem.MakeIndex;
          SmartObject.m_nCurrentItemPos := nWhere;
          SmartObject.m_sCurrentItemName := StdItem.Name;
          SmartObject.m_sCurrentItemNewName := sItemName;

          g_FunctionNPC.GotoLable(PlayObject, '@HeroTakeOn' + IntToStr(nWhere), False);
          g_FunctionNPC.GotoLable(PlayObject, '@HeroTakeOnEx', False);

          SmartObject.m_nCurrentItemMakeIndex := 0;
          SmartObject.m_nCurrentItemPos := 0;
          SmartObject.m_sCurrentItemName := '';
          SmartObject.m_sCurrentItemNewName := '';
        end
        else
        begin
          SmartObject.m_nCurrentItemMakeIndex := OldUserItem.MakeIndex;
          SmartObject.m_nCurrentItemPos := nWhere;
          SmartObject.m_sCurrentItemName := StdItem.Name;
          SmartObject.m_sCurrentItemNewName := sItemName;

          g_FunctionNPC.GotoLable(PlayObject, '@TakeOn' + IntToStr(nWhere), False);
          g_FunctionNPC.GotoLable(PlayObject, '@TakeOnEx', False);

          SmartObject.m_nCurrentItemMakeIndex := 0;
          SmartObject.m_nCurrentItemPos := 0;
          SmartObject.m_sCurrentItemName := '';
          SmartObject.m_sCurrentItemNewName := '';
        end;
      end;

      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).SendJewelryBox(False)
      else if (SmartObject.m_Master <> nil) and (SmartObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
        TPlayObject(SmartObject.m_Master).SendJewelryBox(True);
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    if (StdItem <> nil) and (StdItem.OverLap and 4 <> 0) and ((StdItem.Expand1 = nWhere - U_GODBLESSITEM1 + 1) or (StdItem.Expand1 = 13)) and (SmartObject.m_GodBlessItemsState[nWhere - U_GODBLESSITEM1] <> 0) then
    begin
      OldUserItem := UserItem^;

      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        TPlayObject(SmartObject).SendDelItem(UserItem);

        // 删除物品时，清升级框  chongchong 2018-05-16
        if TPlayObject(SmartObject).m_UpgradeItem = UserItem then
        begin
          TPlayObject(SmartObject).m_UpgradeItem := nil;
        end;
      end
      else if (SmartObject.m_Master <> nil) and (SmartObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        THeroObject(SmartObject).SendDelItem(UserItem);

        if THeroObject(SmartObject).m_LinkItem = UserItem then
        begin
          THeroObject(SmartObject).m_LinkItem := nil;
        end;
      end;

      SmartObject.m_ItemList.Remove(UserItem);
      Dispose(UserItem);

      if SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1].wIndex > 0 then
      begin
        New(UserItem);
        UserItem^ := SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
        TakeOffItem := UserItem^;

        if SmartObject.AddItemToBag(UserItem) then
        begin
          if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(SmartObject).SendAddItem(UserItem)
          else
            THeroObject(SmartObject).SendAddItem(UserItem);
        end
        else
        begin
          Dispose(UserItem);
          Exit;
        end;

        if g_FunctionNPC <> nil then
        begin
          if (TakeOffItem.btValue[13] = 1) and (TakeOffItem.Name <> '') then
            sTakeOffItemName := TakeOffItem.Name
          else
            sTakeOffItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);

          PlayObject.m_nScriptGotoCount := 0;

          if SmartObject.m_btRaceServer = RC_HEROOBJECT then
          begin
            SmartObject.m_nCurrentItemMakeIndex := TakeOffItem.MakeIndex;
            SmartObject.m_nCurrentItemPos := nWhere;
            SmartObject.m_sCurrentItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
            SmartObject.m_sCurrentItemNewName := sTakeOffItemName;

            SmartObject.m_PickUpOrDropItem := TakeOffItem;

            g_FunctionNPC.GotoLable(PlayObject, '@HeroTakeOff' + IntToStr(nWhere), False);
            g_FunctionNPC.GotoLable(PlayObject, '@HeroTakeOffEx', False);

            SmartObject.m_PickUpOrDropItem.MakeIndex := 0;
            SmartObject.m_PickUpOrDropItem.wIndex := 0;

            SmartObject.m_nCurrentItemMakeIndex := 0;
            SmartObject.m_nCurrentItemPos := 0;
            SmartObject.m_sCurrentItemName := '';
            SmartObject.m_sCurrentItemNewName := '';
          end
          else
          begin
            SmartObject.m_nCurrentItemMakeIndex := TakeOffItem.MakeIndex;
            SmartObject.m_nCurrentItemPos := nWhere;
            SmartObject.m_sCurrentItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
            SmartObject.m_sCurrentItemNewName := sTakeOffItemName;

            SmartObject.m_PickUpOrDropItem := TakeOffItem;

            g_FunctionNPC.GotoLable(PlayObject, '@TakeOff' + IntToStr(nWhere), False);
            g_FunctionNPC.GotoLable(PlayObject, '@TakeOffEx', False);

            SmartObject.m_PickUpOrDropItem.MakeIndex := 0;
            SmartObject.m_PickUpOrDropItem.wIndex := 0;

            SmartObject.m_nCurrentItemMakeIndex := 0;
            SmartObject.m_nCurrentItemPos := 0;
            SmartObject.m_sCurrentItemName := '';
            SmartObject.m_sCurrentItemNewName := '';
          end;
        end;
      end;

      SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1] := OldUserItem;

      // SmartObject.m_boRecalcAbilitys := True;
      // SmartObject.m_RecalcAbilitysChanges := [racSubAbility, racFeatureChanged];
      if SmartObject.m_nLockUpdateAbil = 0 then
      begin
        SmartObject.RecalcAbilitys();
        SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
        SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
      end;
      SmartObject.FeatureChanged();

      if g_FunctionNPC <> nil then
      begin
        if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        begin
          SmartObject.m_nCurrentItemMakeIndex := OldUserItem.MakeIndex;
          SmartObject.m_nCurrentItemPos := nWhere;
          SmartObject.m_sCurrentItemName := StdItem.Name;
          SmartObject.m_sCurrentItemNewName := sItemName;

          g_FunctionNPC.GotoLable(PlayObject, '@HeroTakeOn' + IntToStr(nWhere), False);
          g_FunctionNPC.GotoLable(PlayObject, '@HeroTakeOnEx', False);

          SmartObject.m_nCurrentItemMakeIndex := 0;
          SmartObject.m_nCurrentItemPos := 0;
          SmartObject.m_sCurrentItemName := '';
          SmartObject.m_sCurrentItemNewName := '';
        end
        else
        begin
          SmartObject.m_nCurrentItemMakeIndex := OldUserItem.MakeIndex;
          SmartObject.m_nCurrentItemPos := nWhere;
          SmartObject.m_sCurrentItemName := StdItem.Name;
          SmartObject.m_sCurrentItemNewName := sItemName;

          g_FunctionNPC.GotoLable(PlayObject, '@TakeOn' + IntToStr(nWhere), False);
          g_FunctionNPC.GotoLable(PlayObject, '@TakeOnEx', False);

          SmartObject.m_nCurrentItemMakeIndex := 0;
          SmartObject.m_nCurrentItemPos := 0;
          SmartObject.m_sCurrentItemName := '';
          SmartObject.m_sCurrentItemNewName := '';
        end;
      end;

      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).SendUpdateGodBless(False)
      else if (SmartObject.m_Master <> nil) and (SmartObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
        TPlayObject(SmartObject.m_Master).SendUpdateGodBless(True);
    end;
  end
  else if nWhere = -1 then
  begin
    TPlayObject(SmartObject).m_UpgradeItem := UserItem;
    TPlayObject(SmartObject).SendDefMessage(SM_SetUpgradeItem, NewItemMakeIndex, 0, 0, 0, '');
  end;

  SmartObject.WeightChanged;
end;

procedure ActionOfLinkGiveItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  SmartObject: TSmartObject;
begin

  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  // 先把升级框的清掉再说 chongchong 2015-11-14
  if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and (TPlayObject(SmartObject).m_UpgradeItem <> nil) then
  begin
    TPlayObject(SmartObject).SendDefMessage(SM_UPGRADEDLGITEM_TAKE, 0, 0, 0, 0, '');
  end;

  if SmartObject.m_nLastGiveItemMakeIndex = 0 then
    Exit;

  for I := 0 to SmartObject.m_ItemList.Count - 1 do
  begin
    UserItem := SmartObject.m_ItemList.Items[I];
    if UserItem.MakeIndex = SmartObject.m_nLastGiveItemMakeIndex then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).m_UpgradeItem := UserItem
      else
        THeroObject(SmartObject).m_LinkItem := UserItem;

      Exit;
    end;
  end;

  for I := Low(SmartObject.m_UseItems) to High(SmartObject.m_UseItems) do
  begin
    UserItem := @SmartObject.m_UseItems[I];
    if UserItem.MakeIndex = SmartObject.m_nLastGiveItemMakeIndex then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).m_UpgradeItem := UserItem
      else
        THeroObject(SmartObject).m_LinkItem := UserItem;

      Exit;
    end;
  end;

  for I := Low(SmartObject.m_JewelryBoxItems) to High(SmartObject.m_JewelryBoxItems) do
  begin
    UserItem := @SmartObject.m_JewelryBoxItems[I];
    if UserItem.MakeIndex = SmartObject.m_nLastGiveItemMakeIndex then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).m_UpgradeItem := UserItem
      else
        THeroObject(SmartObject).m_LinkItem := UserItem;

      Exit;
    end;
  end;

  for I := Low(SmartObject.m_GodBlessItems) to High(SmartObject.m_GodBlessItems) do
  begin
    UserItem := @SmartObject.m_GodBlessItems[I];
    if UserItem.MakeIndex = SmartObject.m_nLastGiveItemMakeIndex then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).m_UpgradeItem := UserItem
      else
        THeroObject(SmartObject).m_LinkItem := UserItem;

      Exit;
    end;
  end;
end;

procedure ActionOfKillMonBurstRate(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  V1, V2: Int64;
begin

  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  V1 := StrToInt64Def(QuestActionInfo.sParam1, 0);
  V2 := StrToInt64Def(QuestActionInfo.sParam2, 0);

  if V1 <= 0 then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if V2 < 0 then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if V1 > High(LongWord) then
    V1 := High(LongWord);

  if V2 > High(LongWord) then
    V2 := High(LongWord);

  SmartObject.m_dwKillMonBurstRate := V1;
  SmartObject.m_dwKillMonBurstRateTime := V2; // 杀怪倍率时长
  SmartObject.m_boSaveKillMonBurstRate := QuestActionInfo.nParam3 <> 0; // 是否保存杀怪倍率

  if QuestActionInfo.nParam4 = 0 then
  begin
    if SmartObject.m_dwKillMonBurstRateTime = 0 then
    begin
      if Length(g_sKillMonBurstRateForeverMsg) > 0 then
        SmartObject.SysMsg(Format(g_sKillMonBurstRateForeverMsg, [SmartObject.m_dwKillMonBurstRate / 100]), g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint);
    end
    else
    begin
      if Length(g_sKillMonBurstRateMsg) > 0 then
        SmartObject.SysMsg(Format(g_sKillMonBurstRateMsg, [SmartObject.m_dwKillMonBurstRate / 100, SmartObject.m_dwKillMonBurstRateTime]), g_Config.btGreenMsgFColor, g_Config.btGreenMsgBColor, t_Hint)
    end;
  end;
end;

