procedure ActionOfExChangeLineText(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sVar, sVar2, sListFileName, S1, s2: string;
  nL1, nL2: Integer;
  LoadList: TStringList;
begin
  sListFileName := QuestActionInfo.sParam1;
  nL1 := QuestActionInfo.nParam2;
  sVar := QuestActionInfo.sRawParam3;
  nL2 := QuestActionInfo.nParam4;
  sVar2 := QuestActionInfo.sRawParam5;

  LoadList := TStringList.Create;
  if FileExists(sListFileName) then
  begin
    try
      LoadList.LoadFromFile(sListFileName);
    except
      MainOutMessage('loading fail.... => ' + sListFileName);
    end;
  end
  else
  begin
    MainOutMessage('file not found => ' + sListFileName);
  end;
  if (nL1 = 0) or (nL2 = 0) or (LoadList.Count < nL1) or (LoadList.Count < abs(nL2)) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  S1 := LoadList.Strings[nL1 - 1];
  s2 := LoadList.Strings[LoadList.Count + nL2];
  LoadList.Strings[nL1 - 1] := s2;
  LoadList.Strings[LoadList.Count + nL2] := S1;
  LoadList.SaveToFile(sListFileName);
  LoadList.Free;
  if not Npc.SetVarValue(PlayObject, sVar, s2, 0) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);

  if not Npc.SetVarValue(PlayObject, sVar2, S1, 0) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

