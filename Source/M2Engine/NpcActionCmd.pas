procedure ActionOfAddSkill(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Magic: pTMagic;
  UserMagic: pTUserMagic;
  nLevel: Integer;
  nNewLevel: Integer;
  SmartObject: TSmartObject;
  btOldHitPoint: Byte;
  CustomMagicConfig: TCustomMagicConfig;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  Magic := nil;
  nLevel := Min(3, QuestActionInfo.nParam2);
  nNewLevel := Min(9, QuestActionInfo.nParam3);

  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    Magic := UserEngine.FindMagic(QuestActionInfo.sParam1)
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    Magic := UserEngine.FindHeroMagic(QuestActionInfo.sParam1);

  if Magic <> nil then
  begin
    if not SmartObject.IsTrainingSkill(Magic.wMagicId, Magic.MagicAttr) then
    begin
      New(UserMagic);
      UserMagic.MagicInfo := Magic;
      UserMagic.MagicAttr := Magic.MagicAttr;
      UserMagic.wMagIdx := Magic.wMagicId;

      if (BaseObject.m_btRaceServer = RC_HEROOBJECT) //
        or (Magic.MagicAttr in [mtDefense, mtAttack]) //
        or BaseObject.m_boDummyObject then
        UserMagic.btKey := VK_F1
      else
        UserMagic.btKey := 0;

      UserMagic.btLevel := Min(nLevel, Magic.btTrainLv);
      UserMagic.btNewLevel := nNewLevel;
      UserMagic.nTranPoint := 0;
      UserMagic.boUsesItemAdd := False;
      SmartObject.m_MagicList.Add(UserMagic);
      if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        TPlayObject(BaseObject).SendAddMagic(UserMagic);

        if (UserMagic.wMagIdx = SKILL_ERGUM) and (TPlayObject(BaseObject).m_MagicErgumSkill = nil) then
        begin
          TPlayObject(BaseObject).m_MagicErgumSkill := UserMagic;
          if (not TPlayObject(BaseObject).m_boUseThrusting) then
            TPlayObject(BaseObject).ThrustingOnOff(True);

          // TPlayObject(BaseObject).SendSocket(nil, '+LNG');
          TPlayObject(BaseObject).SendOpenMagic(SKILL_ERGUM, True, 0);

          if g_FunctionNPC <> nil then
          begin
            TPlayObject(BaseObject).m_nLearnMagicID := Magic.wMagicId;
            g_FunctionNPC.GotoLable(TPlayObject(BaseObject), '@LearnMagic', False);
            TPlayObject(BaseObject).m_nLearnMagicID := 0;
          end;
        end
        else if CheckIsCustomMagic(UserMagic.wMagIdx) then
        begin
          CustomMagicConfig := GetCustomMagicConfig(UserMagic.wMagIdx);
          if (CustomMagicConfig <> nil) //
            and (CustomMagicConfig.ClientBaseConfig.MagicSwitchMode = msmSwitch) //
            and (not TPlayObject(BaseObject).m_boCustomSkill[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID]) then
          begin
            if (CustomMagicConfig.ClientBaseConfig.MagicWarrNGOption = mngoLongHit) //
              or CustomMagicConfig.ClientBaseConfig.MagicAutoOpen then
            begin
              TPlayObject(BaseObject).m_boCustomSkill[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID] := True;
              TPlayObject(BaseObject).SendOpenMagic(UserMagic.wMagIdx, True, 0);
            end;
          end;
        end;

        // 脚本自动开启刺杀剑术 -- piaoyun 2013-07-20
        if (UserMagic.wMagIdx = SKILL_ERGUM) //
          and (TPlayObject(BaseObject).m_MagicErgumSkill <> nil) //
          and (not TPlayObject(BaseObject).m_boUseThrusting) then
        begin
          TPlayObject(BaseObject).ThrustingOnOff(True);
          // TPlayObject(BaseObject).SendSocket(nil, '+LNG');
          TPlayObject(BaseObject).SendOpenMagic(SKILL_ERGUM, True, 0);
        end;
        // /////////////////////////////////////////////////
      end
      else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
      begin
        THeroObject(BaseObject).SendAddMagic(UserMagic);
        if (g_FunctionNPC <> nil) and (THeroObject(BaseObject).m_Master <> nil) then
        begin
          THeroObject(BaseObject).m_nLearnMagicID := Magic.wMagicId;
          g_FunctionNPC.GotoLable(TPlayObject(THeroObject(BaseObject).m_Master), '@HeroLearnMagic', False);
          THeroObject(BaseObject).m_nLearnMagicID := 0;
        end;
      end;
      // 添加技能后，调整重算精确度 chongchong 2015-09-12
      btOldHitPoint := BaseObject.m_btHitPoint;
      BaseObject.RecalcAbilitys();
      if btOldHitPoint <> BaseObject.m_btHitPoint then
        BaseObject.SendMsg(BaseObject, RM_SUBABILITY, 0, 0, 0, 0, '');

      if g_Config.boShowScriptActionMsg then
        BaseObject.SysMsg(Magic.sMagicName + '练习成功。', c_Green, t_Hint);
    end;
  end
  else
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
end;

procedure ActionOfSkillLevel(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Magic: pTMagic;
  UserMagic: pTUserMagic;
  nLevel: Integer;
  cMethod: Char;
  boNewLevel: Boolean;
  sMagicName: string;
  SmartObject: TSmartObject;
  btOldHitPoint: Byte;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  sMagicName := QuestActionInfo.sParam1;
  nLevel := QuestActionInfo.nParam3;
  boNewLevel := QuestActionInfo.sParam4 = '1';

  if (sMagicName = '') or (QuestActionInfo.sParam2 = '') or (nLevel < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam2[1];

  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    Magic := UserEngine.FindMagic(sMagicName)
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    Magic := UserEngine.FindHeroMagic(sMagicName)
  else
    Magic := nil;

  if Magic <> nil then
  begin
    for I := 0 to SmartObject.m_MagicList.Count - 1 do
    begin
      UserMagic := SmartObject.m_MagicList.Items[I];
      if UserMagic.MagicInfo = Magic then
      begin
        case cMethod of
          '=':
            begin
              if nLevel >= 0 then
              begin
                if boNewLevel then
                begin
                  nLevel := Min(100, nLevel);
                  UserMagic.btNewLevel := nLevel;
                end
                else
                begin
                  nLevel := Min(High(Magic.TrainLevel), nLevel);
                  UserMagic.btLevel := nLevel;
                end;
              end;
            end;
          '-':
            begin
              if boNewLevel then
              begin
                if UserMagic.btNewLevel >= nLevel then
                  Dec(UserMagic.btNewLevel, nLevel)
                else
                  UserMagic.btNewLevel := 0;
              end
              else
              begin
                if UserMagic.btLevel >= nLevel then
                  Dec(UserMagic.btLevel, nLevel)
                else
                  UserMagic.btLevel := 0;
              end;
            end;
          '+':
            begin
              if boNewLevel then
              begin
                if UserMagic.btNewLevel + nLevel <= 100 then
                  Inc(UserMagic.btNewLevel, nLevel)
                else
                  UserMagic.btNewLevel := 100;
              end
              else
              begin
                if UserMagic.btLevel + nLevel <= High(Magic.TrainLevel) then
                  Inc(UserMagic.btLevel, nLevel)
                else
                  UserMagic.btLevel := High(Magic.TrainLevel);
              end;
            end;
        end;

        // 修改技能等级后，调整重算精确度 chongchong 2015-09-12
        btOldHitPoint := BaseObject.m_btHitPoint;
        BaseObject.RecalcAbilitys();
        if btOldHitPoint <> BaseObject.m_btHitPoint then
          BaseObject.SendMsg(BaseObject, RM_SUBABILITY, 0, 0, 0, 0, '');

        BaseObject.SendDelayMsg(BaseObject, RM_MAGIC_LVEXP, 0, UserMagic.MagicInfo.wMagicId, MakeWord(UserMagic.btLevel, UserMagic.btNewLevel), UserMagic.nTranPoint, IntToStr(Integer(UserMagic.MagicAttr)), 100);
        Break;
      end;
    end;
  end;
end;

procedure ActionOfSetSkillDecCD(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Magic: pTMagic;
  UserMagic: pTUserMagic;
  sMagicName: string;
  SmartObject: TSmartObject;
  DecTime: Integer;
  MagicCD: PMagicInterval;
  CDTime: LongWord;
  DefMsg: TDefaultMessage;
  cMethod: Char;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  sMagicName := QuestActionInfo.sParam1;
  DecTime := QuestActionInfo.nParam3;

  if (sMagicName = '') or (QuestActionInfo.sParam2 = '') or (DecTime < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam2[1];

  if SameText(sMagicName, '[连击技能]') then
  begin
    case cMethod of
      '=':
        SmartObject.m_nContinuousMagic_DecTime := DecTime;
      '+':
        SmartObject.m_nContinuousMagic_DecTime := SmartObject.m_nContinuousMagic_DecTime + DecTime;
      '-':
        begin
          if SmartObject.m_nContinuousMagic_DecTime >= DecTime then
            SmartObject.m_nContinuousMagic_DecTime := SmartObject.m_nContinuousMagic_DecTime - DecTime
          else
            SmartObject.m_nContinuousMagic_DecTime := 0;
        end;
    end;
    Exit;
  end;

  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    Magic := UserEngine.FindMagic(sMagicName, mtHum)
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    Magic := UserEngine.FindHeroMagic(sMagicName)
  else
    Magic := nil;

  if Magic <> nil then
  begin
    for I := 0 to SmartObject.m_MagicList.Count - 1 do
    begin
      UserMagic := SmartObject.m_MagicList.Items[I];
      if UserMagic.MagicInfo = Magic then
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          g_MagicCDList.Lock;
        try
{$IFEND}
          MagicCD := g_MagicCDList.Find(Magic.wMagicId);
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            g_MagicCDList.UnLock;
        end;
{$IFEND}
        if MagicCD <> nil then
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            SmartObject.m_MagicCDDecList.Lock;
          try
{$IFEND}
            MagicCD := SmartObject.m_MagicCDDecList.Find(Magic.wMagicId);
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              SmartObject.m_MagicCDDecList.UnLock;
          end;
{$IFEND}
          if MagicCD <> nil then
          begin
            case cMethod of
              '=':
                MagicCD.Interval := DecTime * 1000;
              '+':
                MagicCD.Interval := MagicCD.Interval + DecTime * 1000;
              '-':
                begin
                  if MagicCD.Interval >= DecTime * 1000 then
                    MagicCD.Interval := MagicCD.Interval - DecTime * 1000
                  else
                    MagicCD.Interval := 0;
                end;
            end;
          end
          else if cMethod <> '-' then
          begin
{$IF MULTI_THREAD = 1}
            if g_MultiThreadRun then
              SmartObject.m_MagicCDDecList.Lock;
            try
{$IFEND}
              SmartObject.m_MagicCDDecList.Add(Magic.wMagicId, DecTime * 1000);
{$IF MULTI_THREAD = 1}
            finally
              if g_MultiThreadRun then
                SmartObject.m_MagicCDDecList.UnLock;
            end;
{$IFEND}
          end;

          if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
          begin
            // 更新人物的技能CD时间，英雄就不用了
            CDTime := SmartObject.GetMagicCD(Magic.wMagicId);
            DefMsg := MakeDefaultMsg(SM_UPDATE_MAGIC_INTERVAL, CDTime, Magic.wMagicId, 0, 0);
            TPlayObject(BaseObject).SendSocket(@DefMsg, '');
          end;
        end;

        Break;
      end;
    end;
  end;
end;

procedure ActionOfClearSkillCD(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Magic: pTMagic;
  UserMagic: pTUserMagic;
  sMagicName: string;
  SmartObject: TSmartObject;
  SysMagicCD, UserMagicCD: PMagicInterval;
  CDTime: LongWord;
  DefMsg: TDefaultMessage;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  sMagicName := QuestActionInfo.sParam1;
  if (sMagicName = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if SameText(sMagicName, '[连击技能]') then
  begin
    SmartObject.m_nContinuousMagic_DecTime := g_Config.nUseContinuousMagicTime;
    Exit;
  end;

  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    Magic := UserEngine.FindMagic(sMagicName, mtHum)
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    Magic := UserEngine.FindHeroMagic(sMagicName)
  else
  begin
    Magic := nil;
  end;

  if Magic <> nil then
  begin
    for I := 0 to SmartObject.m_MagicList.Count - 1 do
    begin
      UserMagic := SmartObject.m_MagicList.Items[I];
      if UserMagic.MagicInfo = Magic then
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          g_MagicCDList.Lock;
        try
{$IFEND}
          SysMagicCD := g_MagicCDList.Find(Magic.wMagicId);
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            g_MagicCDList.UnLock;
        end;
{$IFEND}
        if (SysMagicCD <> nil) and (SysMagicCD.Interval > 0) then
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            SmartObject.m_MagicCDDecList.Lock;
          try
{$IFEND}
            UserMagicCD := SmartObject.m_MagicCDDecList.Find(Magic.wMagicId);
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              SmartObject.m_MagicCDDecList.UnLock;
          end;
{$IFEND}
          if UserMagicCD <> nil then
          begin
            UserMagicCD.Interval := SysMagicCD.Interval;
          end
          else
          begin
{$IF MULTI_THREAD = 1}
            if g_MultiThreadRun then
              SmartObject.m_MagicCDDecList.Lock;
            try
{$IFEND}
              SmartObject.m_MagicCDDecList.Add(Magic.wMagicId, SysMagicCD.Interval);
{$IF MULTI_THREAD = 1}
            finally
              if g_MultiThreadRun then
                SmartObject.m_MagicCDDecList.UnLock;
            end;
{$IFEND}
          end;

          if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
          begin
            // 更新人物的技能CD时间，英雄就不用了
            CDTime := SmartObject.GetMagicCD(Magic.wMagicId);
            DefMsg := MakeDefaultMsg(SM_UPDATE_MAGIC_INTERVAL, CDTime, Magic.wMagicId, 0, 0);
            TPlayObject(BaseObject).SendSocket(@DefMsg, '');
          end;
        end;

        Break;
      end;
    end;
  end;
end;

procedure ActionOfGetSkillDecCD(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Magic: pTMagic;
  UserMagic: pTUserMagic;
  sMagicName: string;
  SmartObject: TSmartObject;
  MagicCD: PMagicInterval;
  CDTime: LongWord;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  sMagicName := QuestActionInfo.sParam1;

  if (sMagicName = '') or (QuestActionInfo.sRawParam2 = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if SameText(sMagicName, '[连击技能]') then
  begin
    CDTime := SmartObject.m_nContinuousMagic_DecTime;
    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(CDTime), CDTime) then
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);

    Exit;
  end;

  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    Magic := UserEngine.FindMagic(sMagicName, mtHum)
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    Magic := UserEngine.FindHeroMagic(sMagicName)
  else
    Magic := nil;

  CDTime := 0;

  if Magic <> nil then
  begin
    for I := 0 to SmartObject.m_MagicList.Count - 1 do
    begin
      UserMagic := SmartObject.m_MagicList.Items[I];
      if UserMagic.MagicInfo = Magic then
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          SmartObject.m_MagicCDDecList.Lock;
        try
{$IFEND}
          MagicCD := SmartObject.m_MagicCDDecList.Find(Magic.wMagicId);
          if MagicCD <> nil then
            CDTime := MagicCD.Interval div 1000;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            SmartObject.m_MagicCDDecList.UnLock;
        end;
{$IFEND}
      end;
    end;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(CDTime), CDTime) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

