var
  Envir: TEnvirnoment;
  nX, nY: Integer;
begin
  Envir := nil;
  if (not PlayObject.m_boChallengeStart) and PlayObject.m_boChallengeOK and (PlayObject.m_ChallengeCreat <> nil) then
