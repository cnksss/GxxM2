              AddGameDataLog(LOG_ItemNpcGive, LOG_ActionNone, HeroObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end
          else
            Dispose(UserItem);
        end
        else
        begin
          New(UserItem);
          if UserEngine.CopyToUserItemFromItem(StdItem, nItemIdx + 1, UserItem) then
          begin
            { TODO -ochongchong -c修改 : 脚本制造的装备不给特殊属性 【2013-08-01】 }
            UserEngine.RandomItemNewAbil(u_Script, UserItem);
            AddNewValue(UserItem);

            UserItem.ItemFrom.ItemForm := ifScript;
            UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
            UserItem.ItemFrom.DateTime := Now();

            HeroObject.DropItemDown(UserItem, 3, False, HeroObject, nil);
            HeroObject.m_nLastGiveItemMakeIndex := UserItem.MakeIndex;

            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcGive, LOG_ItemDrop, HeroObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end;
          Dispose(UserItem);
        end;
      end;
    end;
  end;

  if IsGiveOK then
  begin
    if BaseObject.m_btRaceServer = RC_HEROOBJECT then
      HeroObject.WeightChanged
    else
      PlayObject.WeightChanged;
  end;
end;

procedure ActionOfClickOfNPC(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  NormNpc: TNormNpc;
  sName: string;
  // nX, nY: Integer;
  // nX := QuestActionInfo.nParam2;
  // nY := QuestActionInfo.nParam3;
begin
  if not BaseObject.m_btRaceServer in [RC_PLAYOBJECT] then
    Exit;

  sName := QuestActionInfo.sParam1;

  if not PlayObject.m_boCanDeal then
  begin
    PlayObject.SendMsg(g_ManageNPC, RM_MENU_OK, 0, NativeInt(PlayObject), 0, 0, g_sCanotTryDealMsg);
    Exit;
  end;

  if { m_boDeath or } PlayObject.m_boGhost then
    Exit;

  NormNpc := UserEngine.FindMerchantByName(PlayObject.m_sMapName, sName);
  if NormNpc = nil then
    NormNpc := UserEngine.FindNPCByName(PlayObject.m_sMapName, sName);

  if NormNpc <> nil then
  begin
    if (NormNpc.m_PEnvir = PlayObject.m_PEnvir) //
      and (abs(NormNpc.m_nCurrX - PlayObject.m_nCurrX) <= 15) //
      and (abs(NormNpc.m_nCurrY - PlayObject.m_nCurrY) <= 15) then
      NormNpc.Click(PlayObject);
  end;

  if PlayObject.m_boMessageBox then
  begin
    PlayObject.m_sYesLable := '';
    PlayObject.m_sNoLable := '';
  end;
  PlayObject.m_boMessageBox := False;
end;

procedure ActionOfChangeGetBeadExp(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  cMethod: Char;
  dwBeadExp: LongWord;
begin
  if not BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    Exit;
  cMethod := QuestActionInfo.sParam1[1];
  dwBeadExp := QuestActionInfo.nParam2;

  case cMethod of
    '=':
      TSmartObject(BaseObject).m_dwBeadExp := dwBeadExp;
    '+':
      TSmartObject(BaseObject).m_dwBeadExp := TSmartObject(BaseObject).m_dwBeadExp + dwBeadExp;
    '-':
      begin
        if TSmartObject(BaseObject).m_dwBeadExp >= dwBeadExp then
          TSmartObject(BaseObject).m_dwBeadExp := TSmartObject(BaseObject).m_dwBeadExp - dwBeadExp
        else
          TSmartObject(BaseObject).m_dwBeadExp := 0;
      end;
  end;
end;

