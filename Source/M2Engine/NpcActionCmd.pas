  else
  begin
    if BaseObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    if QuestActionInfo.nParam2 = 0 then
      sVarValue := IntToStr(Integer(UserItem.ItemFrom.ItemForm))
    else if QuestActionInfo.nParam2 = 1 then
      sVarValue := UserItem.ItemFrom.sMapName
    else if QuestActionInfo.nParam2 = 2 then
      sVarValue := UserItem.ItemFrom.sMonName
    else if QuestActionInfo.nParam2 = 3 then
      sVarValue := UserItem.ItemFrom.sMakerName
    else if QuestActionInfo.nParam2 = 4 then
      sVarValue := FormatDateTime('yyyy/mm/dd hh:nn:ss', UserItem.ItemFrom.DateTime);

    if (not Npc.SetVarValue(PlayObject, sVarName, sVarValue, StrToIntDef(sVarValue, 0))) then
      Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfSetItemFrom(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere: Integer;
  UserItem: pTUserItem;
  nBoxItemIndex, nMakeIndex: Integer;
  SmartObject: TSmartObject;
  LockUpdateItemIndex: Integer;
  sValue: string;
  nDateTime: TDateTime;
  DateFmt: TFormatSettings;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  sValue := QuestActionInfo.sParam3;
  nDateTime := Now;

  if (QuestActionInfo.nParam2 < 0) or (QuestActionInfo.nParam2 > 4) or (sValue = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if (QuestActionInfo.nParam2 = 0) and ((QuestActionInfo.nParam3 < 0) or (QuestActionInfo.nParam3 > Integer(High(TItemFormType)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if (QuestActionInfo.nParam2 = 4) then
  begin
    if Length(QuestActionInfo.sParam4) = 0 then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;

{$IF CompilerVersion >= 22}
    DateFmt := TFormatSettings.Create(GetThreadLocale);
{$ELSE}
    GetLocaleFormatSettings(GetThreadLocale, DateFmt);
{$IFEND}
    DateFmt.DateSeparator := '-';
    DateFmt.TimeSeparator := ':';

    try
      nDateTime := StrToDateTime(sValue + ' ' + QuestActionInfo.sParam4, DateFmt);
    except
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;
  end;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  LockUpdateItemIndex := -1;
  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    if BaseObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    if QuestActionInfo.nParam2 = 0 then
      UserItem.ItemFrom.ItemForm := TItemFormType(Integer(QuestActionInfo.nParam3))
    else if QuestActionInfo.nParam2 = 1 then
      UserItem.ItemFrom.sMapName := sValue
    else if QuestActionInfo.nParam2 = 2 then
      UserItem.ItemFrom.sMonName := sValue
    else if QuestActionInfo.nParam2 = 3 then
      UserItem.ItemFrom.sMakerName := sValue
    else if QuestActionInfo.nParam2 = 4 then
      UserItem.ItemFrom.DateTime := nDateTime;

    if (nWhere >= 0) then
    begin
      if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
      begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
            TPlayObject(SmartObject).UpdateBoxItem(nBoxItemIndex)
          else
            TPlayObject(SmartObject).SendUpdateItem(UserItem)
        end
        else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(SmartObject).SendUpdateItem(UserItem);
      end;
    end;
  end;
end;

