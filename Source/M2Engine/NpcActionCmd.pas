procedure ActionOfRecalcMonAbility(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nRange, nX, nY: Integer;
  sMonName: string;
  mon: TBaseObject;
  MonList: TList;
  IsAllMon: Boolean;
  Envir: TEnvirnoment;
  IsRange: Boolean;
begin
  if (QuestActionInfo.sRawParam1 = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  sMonName := QuestActionInfo.sParam2;
  if (sMonName = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;
  IsAllMon := sMonName = '*';

  nX := QuestActionInfo.nParam3;
  nY := QuestActionInfo.nParam4;
  nRange := QuestActionInfo.nParam5;

  if (nX = 0) and (nY = 0) and (nRange = 0) then
    nRange := -1;

  if SameText(QuestActionInfo.sParam1, 'SELF') then
  begin
    Envir := BaseObject.m_PEnvir;
  end
  else
  begin
    Envir := nil;
    if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
      Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
    if Envir = nil then
      Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  end;

  if Envir <> nil then
  begin
    MonList := TList.Create;
    try
      UserEngine.GetMapMonster(Envir, MonList);
      for I := 0 to MonList.Count - 1 do
      begin
        mon := TBaseObject(MonList.Items[I]);

        if mon = nil then
          Continue;

        if mon.m_Master <> nil then
          Continue;

        // 在调用 ClearMapMon时，会干掉城堡中的守卫等 chongchong 2018-01-26
        if mon.m_Castle <> nil then
          Continue;

        if mon.m_boDeath or mon.m_boGhost then
          Continue;

        if nRange >= 0 then
        begin
          IsRange := (abs(nX - mon.m_nCurrX) <= nRange) and (abs(nY - mon.m_nCurrY) <= nRange);
          if not IsRange then
            Continue;
        end;

        if IsAllMon or SameText(sMonName, mon.m_sCharName) then
        begin
          mon.m_boChangeAbilitySetHMP := True;
          mon.RecalcAbilitys;
          mon.m_boChangeAbilitySetHMP := False;
        end;
      end;
    finally
      MonList.Free;
    end;
  end;
end;

procedure ActionOfSetNextDamage(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  if BaseObject = nil then
    Exit;

  if (QuestActionInfo.nParam1 < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  BaseObject.m_nNextDamageRate := QuestActionInfo.nParam1;
end;

{
  参数1 X坐标
  参数2 Y坐标
  参数3 范围
  参数4 伤害值
  参数5 附加效果 0=无；1=击退，2=冻结，3=麻痹，4=吸血，5=吸蓝, 6真实伤害, 7.石化 8.冰冻 9.蛛网效果 10.红毒 11.绿毒, 12.定身 13.瘫痪 14.防禁锢
  参数6 附加属性值 分别对应 击退距离 冻结时间 麻痹时间 吸血值 吸蓝值 真实伤害值（真实伤害无视防御无视护身）
  参数7 是否检查防冻结/麻痹/石化/冰冻/蛛网/红毒/绿毒 状态（0: 直接设置状态; 1：检查后设置状态)
  参数8 目标(0或空:所有目标; 1:仅人物; 2:仅怪物)
  // 不触发'@Struck','@MagicStruck'
}
procedure ActionOfRangeHarm(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nX, nY, nRange, nDamage, nAddStatus, nAddValue, nPower: Integer;
  BaseObjectList: TList;
  Target: TBaseObject;
  nSuckDamagePoint: Integer;
  Int64Value: Int64;
  nFixedDamage: Integer;
  btNewDir: Byte;
  tmpEnvir: TEnvirnoment;
  sTemp, S11, S12, S13, S14, S15, S16, sMsg: string;
  ImgFileIndex, ImgIndex, ImgCount, ImgPlayTime, nTemp, tmpFlag: Integer;
  IsBlendDraw, IsAttack: Boolean;
  BlastHitType: TBlastHitType;
  IsBreakParseVar: Boolean;

  procedure SendCustomEffect(AObject: TBaseObject);
  begin
    if (ImgFileIndex >= 0) and (ImgIndex >= 0) and (ImgCount > 0) and (ImgPlayTime > 0) then
    begin
      AObject.SendRefMsg(RM_ADD_EFFECT_PLAY, ImgFileIndex, ImgIndex, ImgCount, ImgPlayTime, BoolToIntStr(IsBlendDraw));
    end;
  end;

begin
  nX := QuestActionInfo.nParam1;
  nY := QuestActionInfo.nParam2;
  nRange := Max(0, QuestActionInfo.nParam3);
  nDamage := QuestActionInfo.nParam4;
  nAddStatus := QuestActionInfo.nParam5;
  nAddValue := QuestActionInfo.nParam6;

  ImgFileIndex := QuestActionInfo.nParam9;
  ImgIndex := QuestActionInfo.nParam10;

  sTemp := QuestActionInfo.sSubParam10;
  sTemp := GetValidStr3(sTemp, S11, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S12, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S13, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S14, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S15, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S16, [' ', #9]);

  Npc.GetVarValue(PlayObject, S11, S11, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S12, S12, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S13, S13, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S14, S14, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S15, S15, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S16, S16, nTemp, IsBreakParseVar);

  ImgCount := StrToIntDef(S11, 0);
  ImgPlayTime := StrToIntDef(S12, 0);
  IsBlendDraw := S13 = '1';
  IsAttack := S14 = '1';
  tmpFlag := StrToIntDef(S15, -1);
  if S16.IsEmpty or (StrToIntDef(S16, 0) = 0) then
    tmpEnvir := BaseObject.m_PEnvir
  else
    tmpEnvir := g_MapManager.FindMap(S16);

  if tmpEnvir = nil then
  begin
    Npc.ScriptActionError(BaseObject, '指定地图未找到.', QuestActionInfo);
    Exit;
  end;

  if (nX < 0) or (nY < 0) or (nDamage < 0) or (nAddStatus < 0) or (nAddStatus > 14) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  BaseObjectList := TList.Create;
  try
    BaseObject.GetMapBaseObjects(tmpEnvir, nX, nY, nRange, BaseObjectList);

    for I := 0 to BaseObjectList.Count - 1 do
    begin
      Target := TBaseObject(BaseObjectList.Items[I]);
      if (Target <> nil) //
        and (not Target.m_boDeath) //
        and (not Target.m_boGhost) //
        and BaseObject.IsProperTarget(Target) //
        and (Target.m_Master <> BaseObject) then
      begin
        // 仅人物
        if (QuestActionInfo.nParam8 = 1) and (not ((Target.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) or (Target.m_Master <> nil))) then
          Continue;

        // 仅怪物
        if (QuestActionInfo.nParam8 = 2) //
          and ((Target.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) or (Target.m_Master <> nil)) then
          Continue;

        nFixedDamage := 0;
        if (nAddStatus > 0) and (nAddValue > 0) then
        begin
          case nAddStatus of
            1:
              begin
                if (not Target.m_boStickMode) then
                begin
                  btNewDir := GetNextDirection(BaseObject.m_nCurrX, BaseObject.m_nCurrY, Target.m_nCurrX, Target.m_nCurrY);
                  Target.CharPushed(btNewDir, nAddValue);
                  SendCustomEffect(Target);
                end;
              end;
            2:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.OpenForeverFrozen(nAddValue);
                  SendCustomEffect(Target);
                end
                else if (not Target.m_boUnForeverFrozen) or (Random(100) >= Target.m_nUnForeverFrozenRate) then
                begin
                  Target.OpenForeverFrozen(nAddValue);
                  SendCustomEffect(Target);
                end;
              end;
            3:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.MakePosion(POISON_STONE, nAddValue, 0);
                  SendCustomEffect(Target);
                end
                else if (not Target.UnParalysis) then
                begin
                  Target.MakePosion(POISON_STONE, nAddValue, 0);
                  SendCustomEffect(Target);
                end;
              end;
            4:
              begin
                Int64Value := Int64(BaseObject.m_WAbil.HP) + nAddValue;
                if Int64Value <= BaseObject.m_WAbil.MaxHP then
                  BaseObject.m_WAbil.HP := Int64Value
                else
                  BaseObject.m_WAbil.HP := BaseObject.m_WAbil.MaxHP;
                SendCustomEffect(BaseObject);
              end;
            5:
              begin
                Int64Value := Int64(BaseObject.m_WAbil.MP) + nAddValue;
                if Int64Value <= BaseObject.m_WAbil.MaxMP then
                  BaseObject.m_WAbil.MP := Int64Value
                else
                  BaseObject.m_WAbil.MP := BaseObject.m_WAbil.MaxMP;
                SendCustomEffect(BaseObject);
              end;
            6:
              begin
                nFixedDamage := nAddValue;
              end;
            7:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.MakePosion(POISON_STONE, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end
                else if not Target.UnParalysis then
                begin
                  Target.MakePosion(POISON_STONE, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end;
              end;
            8:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.MakeFrozen(nAddValue, False);
                  SendCustomEffect(Target);
                end
                else if (not Target.UnFrozen) then
                begin
                  Target.MakeFrozen(nAddValue, False);
                  SendCustomEffect(Target);
                end;
              end;
            9:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.OpenCobwebWinding(nAddValue);
                  SendCustomEffect(Target);
                end
                else if not Target.UnCobwebWinding then
                begin
                  Target.OpenCobwebWinding(nAddValue);
                  SendCustomEffect(Target);
                end;
              end;
            10:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.MakePosion(POISON_DAMAGEARMOR, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end
                else if not Target.UnPosion then
                begin
                  Target.MakePosion(POISON_DAMAGEARMOR, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end;
              end;
            11:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.MakePosion(POISON_DECHEALTH, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end
                else if not Target.UnPosion then
                begin
                  Target.MakePosion(POISON_DECHEALTH, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end;
              end;
            12:
              begin
                Target.OpenDingShen(nAddValue);
                SendCustomEffect(Target);
              end;
            13:
              begin
                Target.OpenTanHuan(nAddValue);
                SendCustomEffect(Target);
              end;
            14:
              begin
                Target.m_dwUnImprisonTick := MyGetTickCount();
                Target.m_dwUnImprisonTime := nAddValue * 1000;
                Target.m_boUnImprison := True;

                SendCustomEffect(Target);
              end;
          end;
        end;

        case tmpFlag of
          1:
            nDamage := BaseObject.m_WAbil.MaxHP * nDamage div 100;
          2:
            nDamage := BaseObject.m_WAbil.MaxHP * nDamage div 1000;
          3:
            nDamage := BaseObject.m_WAbil.MaxHP * nDamage div 10000;
          4:
            nDamage := BaseObject.m_WAbil.HP * nDamage div 100;
          5:
            nDamage := BaseObject.m_WAbil.HP * nDamage div 1000;
          6:
            nDamage := BaseObject.m_WAbil.HP * nDamage div 10000;
        end;

        if nDamage + nFixedDamage >= 0 then // 当伤害为0时，也发送特效 Cursor 2023-08-07 15:39:31
        begin
          nPower := nDamage;
          if not IsAttack then
          begin
            // 元素属性 - 魔法伤害减少
            if not BaseObject.CanCloseDefense then
              nPower := Target.GetMagStruckDamage(BaseObject, nPower, nil) // 忽视目标防御
            else
              nPower := Target.GetMagStruckDamage(BaseObject, nPower, nil, 1); // 不忽视盾防御 ++++++++++++  2020-11-09 23:46:37

            nPower := Target.NewAbilPower(3, nPower); // 魔法伤害减少
          end
          else
          begin
            if not BaseObject.CanCloseDefense then // 忽视目标防御
              nPower := Target.GetHitStruckDamage(BaseObject, nPower, nil)
            else
              nPower := Target.GetHitStruckDamage(BaseObject, nPower, nil, 4); // 不忽视盾防御 ++++++++++++  2020-11-09 23:46:37

            nPower := Target.NewAbilPower(2, nPower); // 物理伤害减少
          end;

          nPower := BaseObject.GetPowerRateAdd(Target, nPower); // 2020-09-12 23:24:45
          nPower := BaseObject.BlastHit(nPower, Target, BlastHitType); // 暴击

          // SetSuckDamage 伤害吸收
          if Target.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
          begin
            // 伤害吸收百分比 2020-09-17 20:11:44
            nPower := TSmartObject(Target).m_StruckDamageAbsorbMgr.GetStruckDamage(BaseObject.m_sCharName, nPower);
            if (nPower > 0)
            //
              and (TSmartObject(Target).m_nSuckDamagePoint > 0) //
              and (TSmartObject(Target).m_nSuckDamageRate > 0) // 吸收伤害
              and (Random(100) < TSmartObject(Target).m_nSuckDamageProbability) then
            begin
              nSuckDamagePoint := Round(TSmartObject(Target).m_nSuckDamageRate / 1000 * nPower);
              if nSuckDamagePoint > TSmartObject(Target).m_nSuckDamagePoint then
                nSuckDamagePoint := TSmartObject(Target).m_nSuckDamagePoint;

              Dec(TSmartObject(Target).m_nSuckDamagePoint, nSuckDamagePoint);
              nPower := Max(nPower - nSuckDamagePoint, 0);
            end;
          end;

          nPower := BaseObject.GetNextDamage(nPower);
          nPower := Target.GetAttackPowerMax(nPower); // 怪物伤害封顶 chongchong 2016-01-30
          nPower := Target.StruckDamage(nPower + nFixedDamage, BaseObject, 0);

          if (Target.m_btRaceServer in [55]) then
            Target.SendMsg(Target, RM_STRUCK, nPower, Target.m_WAbil.HP, Target.m_WAbil.MaxHP, NativeInt(BaseObject), '0')
          else
          begin
            if IsAttack then
              sMsg := IntToStr(MakeLong(0, Integer(BlastHitType)))
            else
              sMsg := 'MAG:' + IntToStr(MakeLong(0, Integer(BlastHitType)));

            Target.SendMsg(TBaseObject(RM_STRUCK), RM_10101_EX, nPower, Target.m_WAbil.HP, Target.m_WAbil.MaxHP, NativeInt(BaseObject), sMsg);
          end;

          if (Target is TAnimalObject) then
          begin
            Target.SetLastHiter(BaseObject);
            SendCustomEffect(Target);
            TAnimalObject(Target).Struck(BaseObject); { 0FFEC }
          end;
        end;
      end;
    end;
  finally
    BaseObjectList.Free;
  end;
end;

{
  参数1 X坐标
  参数2 Y坐标
  参数3 范围
  参数4 伤害值
  参数5 附加效果 0=无；1=击退，2=冻结，3=麻痹，4=吸血，5=吸蓝, 6真实伤害, 7.石化 8.冰冻 9.蛛网效果 10.红毒 11.绿毒, 12.定身 13.瘫痪 14.防禁锢
  参数6 附加属性值 分别对应 击退距离 冻结时间 麻痹时间 吸血值 吸蓝值 真实伤害值（真实伤害无视防御无视护身）
  参数7 是否检查防冻结/麻痹/石化/冰冻/蛛网/红毒/绿毒 状态（0: 直接设置状态; 1：检查后设置状态)
  参数8 目标(0或空:所有目标; 1:仅人物; 2:仅怪物)
  参数9 触发选项(0:所有目标触发； 1:只触发一次)
  参数10 触发几率(仅对所有目标触发有效，值越小几率越高)
  // 触发'@Struck','@MagicStruck'
}
procedure ActionOfRangeHarmEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nX, nY, nRange, nDamage, nAddStatus, nAddValue, nPower: Integer;
  BaseObjectList: TList;
  Target: TBaseObject;
  nSuckDamagePoint: Integer;
  Int64Value: Int64;
  nFixedDamage: Integer;
  btNewDir: Byte;
  IsTriggerScript: Boolean;
  tmpEnvir: TEnvirnoment;
  sTemp, S11, S12, S13, S14, S15, S16, S17, S18, sMsg: string;
  ImgFileIndex, ImgIndex, ImgCount, ImgPlayTime, nTemp, tmpFlag: Integer;
  IsBlendDraw, IsAttack: Boolean;
  BlastHitType: TBlastHitType;
  IsBreakParseVar: Boolean;

  procedure SendCustomEffect(AObject: TBaseObject);
  begin
    if (ImgFileIndex >= 0) and (ImgIndex >= 0) and (ImgCount > 0) and (ImgPlayTime > 0) then
    begin
      AObject.SendRefMsg(RM_ADD_EFFECT_PLAY, ImgFileIndex, ImgIndex, ImgCount, ImgPlayTime, BoolToIntStr(IsBlendDraw));
    end;
  end;

begin
  nX := QuestActionInfo.nParam1;
  nY := QuestActionInfo.nParam2;
  nRange := Max(0, QuestActionInfo.nParam3);
  nDamage := QuestActionInfo.nParam4;
  nAddStatus := QuestActionInfo.nParam5;
  nAddValue := QuestActionInfo.nParam6;

  sTemp := QuestActionInfo.sSubParam10;
  sTemp := GetValidStr3(sTemp, S11, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S12, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S13, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S14, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S15, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S16, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S17, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S18, [' ', #9]);

  Npc.GetVarValue(PlayObject, S11, S11, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S12, S12, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S13, S13, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S14, S14, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S15, S15, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S16, S16, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S15, S17, nTemp, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, S16, S18, nTemp, IsBreakParseVar);

  ImgFileIndex := StrToIntDef(S11, 0);
  ImgIndex := StrToIntDef(S12, 0);
  ImgCount := StrToIntDef(S13, 0);
  ImgPlayTime := StrToIntDef(S14, 0);
  IsBlendDraw := S15 = '1';
  IsAttack := S16 = '1';
  tmpFlag := StrToIntDef(S17, -1);
  if S18.IsEmpty or (StrToIntDef(S18, 0) = 0) then
    tmpEnvir := BaseObject.m_PEnvir
  else
    tmpEnvir := g_MapManager.FindMap(S18);

  if tmpEnvir = nil then
  begin
    Npc.ScriptActionError(BaseObject, '指定地图未找到.', QuestActionInfo);
    Exit;
  end;

  if (nX < 0) or (nY < 0) or (nDamage < 0) or (nAddStatus < 0) or (nAddStatus > 14) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  IsTriggerScript := False;
  BaseObjectList := TList.Create;
  try
    BaseObject.GetMapBaseObjects(tmpEnvir, nX, nY, nRange, BaseObjectList);

    for I := 0 to BaseObjectList.Count - 1 do
    begin
      Target := TBaseObject(BaseObjectList.Items[I]);
      if (Target <> nil) and (not Target.m_boDeath) and (not Target.m_boGhost) and
      { (not BaseObject.m_boHideMode or Player.m_boCoolEye) and }
        BaseObject.IsProperTarget(Target) and (Target.m_Master <> BaseObject) then
      begin
        // 仅人物
        if (QuestActionInfo.nParam8 = 1) and (not ((Target.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) or (Target.m_Master <> nil))) then
          Continue;

        // 仅怪物
        if (QuestActionInfo.nParam8 = 2) and ((Target.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) or (Target.m_Master <> nil)) then
          Continue;

        nFixedDamage := 0;
        if (nAddStatus > 0) and (nAddValue > 0) then
        begin
          case nAddStatus of
            1:
              begin
                if (not Target.m_boStickMode) then
                begin
                  btNewDir := GetNextDirection(BaseObject.m_nCurrX, BaseObject.m_nCurrY, Target.m_nCurrX, Target.m_nCurrY);
                  Target.CharPushed(btNewDir, nAddValue);
                  SendCustomEffect(Target);
                end;
              end;
            2:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.OpenForeverFrozen(nAddValue);
                  SendCustomEffect(Target);
                end
                else if ((not Target.m_boUnForeverFrozen) or (Random(100) >= Target.m_nUnForeverFrozenRate)) then
                begin
                  Target.OpenForeverFrozen(nAddValue);
                  SendCustomEffect(Target);
                end;
              end;
            3:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.MakePosion(POISON_STONE, nAddValue, 0);
                  SendCustomEffect(Target);
                end
                else if (not Target.UnParalysis) then
                begin
                  Target.MakePosion(POISON_STONE, nAddValue, 0);
                  SendCustomEffect(Target);
                end;
              end;
            4:
              begin
                Int64Value := Int64(BaseObject.m_WAbil.HP) + nAddValue;
                if Int64Value <= BaseObject.m_WAbil.MaxHP then
                  BaseObject.m_WAbil.HP := Int64Value
                else
                  BaseObject.m_WAbil.HP := BaseObject.m_WAbil.MaxHP;

                SendCustomEffect(BaseObject);
              end;
            5:
              begin
                Int64Value := Int64(BaseObject.m_WAbil.MP) + nAddValue;
                if Int64Value <= BaseObject.m_WAbil.MaxMP then
                  BaseObject.m_WAbil.MP := Int64Value
                else
                  BaseObject.m_WAbil.MP := BaseObject.m_WAbil.MaxMP;

                SendCustomEffect(BaseObject);
              end;
            6:
              begin
                nFixedDamage := nAddValue;
              end;
            7:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.MakePosion(POISON_STONE, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end
                else if not Target.UnParalysis then
                begin
                  Target.MakePosion(POISON_STONE, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end;
              end;
            8:
              begin
                if QuestActionInfo.nParam7 = 0 then
                  Target.MakeFrozen(nAddValue, False)
                else if (not Target.UnFrozen) then
                  Target.MakeFrozen(nAddValue, False);
              end;
            9:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.OpenCobwebWinding(nAddValue);
                  SendCustomEffect(Target);
                end
                else if (not Target.UnCobwebWinding) then
                begin
                  Target.OpenCobwebWinding(nAddValue);
                  SendCustomEffect(Target);
                end;
              end;
            10:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.MakePosion(POISON_DAMAGEARMOR, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end
                else if (not Target.UnPosion) then
                begin
                  Target.MakePosion(POISON_DAMAGEARMOR, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end;
              end;
            11:
              begin
                if QuestActionInfo.nParam7 = 0 then
                begin
                  Target.MakePosion(POISON_DECHEALTH, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end
                else if (not Target.UnPosion) then
                begin
                  Target.MakePosion(POISON_DECHEALTH, nAddValue, 0, False);
                  SendCustomEffect(Target);
                end;
              end;
            12:
              begin
                Target.OpenDingShen(nAddValue);
                SendCustomEffect(Target);
              end;
            13:
              begin
                Target.OpenTanHuan(nAddValue);
                SendCustomEffect(Target);
              end;
            14:
              begin
                Target.m_dwUnImprisonTick := MyGetTickCount();
                Target.m_dwUnImprisonTime := nAddValue * 1000;
                Target.m_boUnImprison := True;
                SendCustomEffect(Target);
              end;
          end;
        end;

        case tmpFlag of
          1:
            nDamage := BaseObject.m_WAbil.MaxHP * nDamage div 100;
          2:
            nDamage := BaseObject.m_WAbil.MaxHP * nDamage div 1000;
          3:
            nDamage := BaseObject.m_WAbil.MaxHP * nDamage div 10000;
          4:
            nDamage := BaseObject.m_WAbil.HP * nDamage div 100;
          5:
            nDamage := BaseObject.m_WAbil.HP * nDamage div 1000;
          6:
            nDamage := BaseObject.m_WAbil.HP * nDamage div 10000;
        end;

        if nDamage + nFixedDamage > 0 then
        begin
          nPower := nDamage;

          if not IsAttack then
          begin
            // 元素属性 - 魔法伤害减少
            if not BaseObject.CanCloseDefense then
              nPower := Target.GetMagStruckDamage(BaseObject, nPower, nil) // 忽视目标防御
            else
              nPower := Target.GetMagStruckDamage(BaseObject, nPower, nil, 1); // 不忽视盾防御 ++++++++++++  2020-11-09 23:46:37

            nPower := Target.NewAbilPower(3, nPower); // 魔法伤害减少
          end
          else
          begin
            if not BaseObject.CanCloseDefense then
              nPower := Target.GetHitStruckDamage(BaseObject, nPower, nil)
              // 忽视目标防御
            else
              nPower := Target.GetHitStruckDamage(BaseObject, nPower, nil, 4); // 不忽视盾防御 ++++++++++++  2020-11-09 23:46:37

            nPower := Target.NewAbilPower(2, nPower); // 物理伤害减少
          end;

          nPower := BaseObject.GetPowerRateAdd(Target, nPower); // 2020-09-12 23:24:45
          nPower := BaseObject.BlastHit(nPower, Target, BlastHitType); // 暴击

          // SetSuckDamage 伤害吸收
          if (nPower > 0) //
            and (Target.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER]) //
            and (TSmartObject(Target).m_nSuckDamagePoint > 0) //
            and (TSmartObject(Target).m_nSuckDamageRate > 0) //
            and (Random(100) < TSmartObject(Target).m_nSuckDamageProbability) then
          begin
            nSuckDamagePoint := Round(TSmartObject(Target).m_nSuckDamageRate / 1000 * nPower);
            if nSuckDamagePoint > TSmartObject(Target).m_nSuckDamagePoint then
              nSuckDamagePoint := TSmartObject(Target).m_nSuckDamagePoint;

            Dec(TSmartObject(Target).m_nSuckDamagePoint, nSuckDamagePoint);
            nPower := Max(nPower - nSuckDamagePoint, 0);
          end;

          nPower := BaseObject.GetNextDamage(nPower);
          nPower := Target.GetAttackPowerMax(nPower);
          // 怪物伤害封顶 XXXXXXXXXXXXXXXXXX chongchong 2016-01-30
          nPower := Target.StruckDamage(nPower + nFixedDamage, BaseObject, 0);

          SendCustomEffect(Target);

          if (Target is TAnimalObject) then
          begin
            Target.SetLastHiter(BaseObject);
            TAnimalObject(Target).Struck(BaseObject); { 0FFEC }
          end;

          if (Target.m_btRaceServer in [55]) then
            Target.SendMsg(Target, RM_STRUCK, nPower, Target.m_WAbil.HP, Target.m_WAbil.MaxHP, NativeInt(BaseObject), '0')
          else
          begin
            if IsAttack then
              sMsg := IntToStr(MakeLong(0, Integer(BlastHitType)))
            else
              sMsg := 'MAG:' + IntToStr(MakeLong(0, Integer(BlastHitType)));

            if (QuestActionInfo.nParam9 = 1) then
            begin
              if (not IsTriggerScript) then
              begin
                Target.SendMsg(TBaseObject(RM_STRUCK), RM_10101, nPower, Target.m_WAbil.HP, Target.m_WAbil.MaxHP, NativeInt(BaseObject), sMsg);
                IsTriggerScript := True;
              end
              else
              begin
                Target.SendMsg(TBaseObject(RM_STRUCK), RM_10101_EX, nPower, Target.m_WAbil.HP, Target.m_WAbil.MaxHP, NativeInt(BaseObject), sMsg);
              end;
            end
            else if Random(QuestActionInfo.nParam10) = 0 then
            begin
              Target.SendMsg(TBaseObject(RM_STRUCK), RM_10101, nPower, Target.m_WAbil.HP, Target.m_WAbil.MaxHP, NativeInt(BaseObject), sMsg);
            end
            else
              Target.SendMsg(TBaseObject(RM_STRUCK), RM_10101_EX, nPower, Target.m_WAbil.HP, Target.m_WAbil.MaxHP, NativeInt(BaseObject), sMsg);
          end;
        end;
      end;
    end;
  finally
    BaseObjectList.Free;
  end;
end;

procedure ActionOfCancelHeroForcePeaceMode(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nTime: Integer;
begin
  if g_nKey_HeroExt <> 0 then
  begin
    if PlayObject.m_MyHero = nil then
      Exit;

