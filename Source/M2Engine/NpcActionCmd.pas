procedure ActionOfGoldCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nGold: Integer;
  nOldGold: Integer;
  cMethod: Char;
  Int64Value: Int64;
begin
  nOldGold := PlayObject.m_nGold;
  nGold := QuestActionInfo.nParam2;

  if (QuestActionInfo.sParam1 = '') or (nGold < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if (nGold >= 0) then
        begin
          PlayObject.m_nGold := nGold;
        end;
      end;
    '-':
      begin
        nGold := Max(0, PlayObject.m_nGold - nGold);
        PlayObject.m_nGold := nGold;
      end;
    '+':
      begin
        Int64Value := Int64(PlayObject.m_nGold) + nGold;
        if Int64Value > g_Config.nHumanMaxGold then
          Int64Value := g_Config.nHumanMaxGold;
        PlayObject.m_nGold := Max(0, Int64Value);
      end;
  end;

  if nOldGold <> PlayObject.m_nGold then
  begin
    PlayObject.GoldChanged;

    if g_boGameLogGold then
    begin
      AddGameDataLog(LOG_GoldChange, LOG_ActionNone, PlayObject, sSTRING_GOLDNAME, 0, Npc.m_sCharName, PlayObject.m_nGold, nOldGold, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
    end;
  end;
end;

procedure ActionOfGiveFengHao(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  UserItem, TempUserItem: pTUserItem;
  StdItem: pTStdItem;
  IsDoActive: Boolean;
  SmartObject: TSmartObject;
begin
  if not (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
    Exit;

  SmartObject := TSmartObject(BaseObject);
  if (Length(QuestActionInfo.sParam1) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if SmartObject.m_FengHaoItems.Count >= High(THumanFengHaoItems) + 1 then
  begin
    SmartObject.SysMsg('给予玩家的称号已经达到最大值', c_Red, t_Hint);
    Exit;
  end;

  StdItem := UserEngine.GetStdItem(QuestActionInfo.sParam1);
  if (StdItem = nil) or (not (StdItem.StdMode in [70, 71, 72, 73, 74])) then
  begin
    SmartObject.SysMsg('称号不存在', c_Red, t_Hint);
    Exit;
  end;

  for I := 0 to SmartObject.m_FengHaoItems.Count - 1 do
  begin
    UserItem := SmartObject.m_FengHaoItems.Items[I];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (StdItem <> nil) and SameText(StdItem.Name, QuestActionInfo.sParam1) then
    begin
      SmartObject.SysMsg(Format('你已经被授予了[%s]称号', [QuestActionInfo.sParam1]), c_Red, t_Hint);
      Exit;
    end;
  end;

  IsDoActive := QuestActionInfo.sParam2 = '1';

  New(UserItem);
  if not UserEngine.CopyToUserItemFromName(QuestActionInfo.sParam1, UserItem) then
  begin
    Dispose(UserItem);
    Exit;
  end;

  StdItem := UserEngine.GetStdItem(UserItem.wIndex);
  if StdItem = nil then
  begin
    Dispose(UserItem);
    Exit;
  end;

  UserItem.nLimitTime := StdItem.NeedLevel;
  SmartObject.m_FengHaoItems.Add(UserItem);

  if (UserItem.boStartTime) then
  begin
    if StdItem.Need = 103 then
      SmartObject.SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System)
    else
      SmartObject.SysMsg(Format('您的限时物品[%s]开始计时，到期时间%s', [StdItem.Name, GetIncMinuteTime(UserItem.ItemFrom.DateTime, StdItem.NeedLevel)]), c_Red, t_System)
  end;

  if IsDoActive then
  begin
    if (SmartObject.m_ActiveFengHao >= 0) and (SmartObject.m_ActiveFengHao < SmartObject.m_FengHaoItems.Count) and (g_FunctionNPC <> nil) then
    begin
      TempUserItem := SmartObject.m_FengHaoItems.Items[SmartObject.m_ActiveFengHao];

      if TempUserItem <> nil then
      begin
        StdItem := UserEngine.GetStdItem(TempUserItem.wIndex);
        if StdItem <> nil then
        begin
          PlayObject.m_nScriptGotoCount := 0;
          if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
            g_FunctionNPC.GotoLable(PlayObject, '@UnactiveTitle_' + IntToStr(StdItem.Shape), False)
          else
            g_FunctionNPC.GotoLable(PlayObject, '@HeroUnactiveTitle_' + IntToStr(StdItem.Shape), False)
        end;
      end;
    end;

    SmartObject.m_ActiveFengHao := SmartObject.m_FengHaoItems.Count - 1;
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem <> nil then
    begin
      PlayObject.m_nScriptGotoCount := 0;
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        g_FunctionNPC.GotoLable(PlayObject, '@ActiveTitle_' + IntToStr(StdItem.Shape), False)
      else
        g_FunctionNPC.GotoLable(PlayObject, '@HeroActiveTitle_' + IntToStr(StdItem.Shape), False)
    end;
  end;

  UserItem.ItemFrom.ItemForm := ifScript;
  UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
  UserItem.ItemFrom.DateTime := Now();

  PlayObject.SendAddFengHaoItem(UserItem, SmartObject.m_btRaceServer = RC_HEROOBJECT);

  if (StdItem.Need in [101, 102]) and (not UserItem.boStartTime) then
  begin
    UserItem.nLimitTime := StdItem.NeedLevel;
    UserItem.boStartTime := True;
    SmartObject.SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System);
  end;

  // SmartObject.m_boRecalcAbilitys := True;
  // SmartObject.m_RecalcAbilitysChanges := [racSubAbility, racFeatureChanged];
  if SmartObject.m_nLockUpdateAbil = 0 then
  begin
    SmartObject.RecalcAbilitys;
    SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
    SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
  end;
  SmartObject.FeatureChanged;
end;

