procedure ActionOfHumanHP(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  tmpValue: Int64;
  tmpResID, tmpResIdx: Integer;
  tmpHPRec: PNpcHumanHPRec;
begin
  QuestActionInfo.sParam1 := Trim(QuestActionInfo.sParam1);
  if QuestActionInfo.sParam1.IsEmpty then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  tmpValue := Max(0, Min(QuestActionInfo.nParam2, MAXDWORD));
  if (BaseObject = nil) or BaseObject.m_boDeath or BaseObject.m_boGhost or (tmpValue = 0) then
    Exit;

  case QuestActionInfo.nParam7 of
    1:
      tmpValue := BaseObject.m_WAbil.MaxHP * tmpValue div 100;
    2:
      tmpValue := BaseObject.m_WAbil.MaxHP * tmpValue div 1000;
    3:
      tmpValue := BaseObject.m_WAbil.MaxHP * tmpValue div 10000;
    4:
      tmpValue := BaseObject.m_WAbil.HP * tmpValue div 100;
    5:
      tmpValue := BaseObject.m_WAbil.HP * tmpValue div 1000;
    6:
      tmpValue := BaseObject.m_WAbil.HP * tmpValue div 10000;
  end;

  tmpResID := IfThen(QuestActionInfo.sParam5.IsEmpty, -1, QuestActionInfo.nParam5);
  tmpResIdx := IfThen(QuestActionInfo.sParam6.IsEmpty, -1, QuestActionInfo.nParam6);

  tmpHPRec := AllocMem(SizeOf(TNpcHumanHPRec));
  tmpHPRec.Tick := MyGetTickCount;
  tmpHPRec.DelayTime := Max(0, QuestActionInfo.nParam3);
  tmpHPRec.Count := Max(1, QuestActionInfo.nParam4);
  tmpHPRec.ResID := tmpResID;
  tmpHPRec.ResStartIdx := tmpResIdx;
  case QuestActionInfo.sParam1[1] of
    '=':
      tmpHPRec.Value := tmpValue - BaseObject.m_WAbil.HP;
    '-':
      tmpHPRec.Value := -tmpValue;
    '+':
      tmpHPRec.Value := tmpValue;
  else
    FreeMemory(tmpHPRec);
    Exit;
  end;
  BaseObject.m_NpcHumanHPList.Add(tmpHPRec);
end;

procedure ActionOfHumanMP(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nMP: Int64;
  cMethod: Char;
begin
  nMP := StrToInt64Def(QuestActionInfo.sParam2, 0);
  if nMP > High(LongWord) then
    nMP := High(LongWord);
  if (QuestActionInfo.sParam1 = '') or (nMP < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;
  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        BaseObject.m_WAbil.MP := Min(nMP, BaseObject.m_WAbil.MaxMP);
      end;
    '-':
      begin
        nMP := BaseObject.m_WAbil.MP - nMP;
        if nMP < 0 then
          nMP := 0;
        BaseObject.m_WAbil.MP := Min(nMP, BaseObject.m_WAbil.MaxMP);
      end;
    '+':
      begin
        nMP := BaseObject.m_WAbil.MP + nMP;
        if nMP > High(LongWord) then
          nMP := High(LongWord);
        BaseObject.m_WAbil.MP := Min(nMP, BaseObject.m_WAbil.MaxMP);
      end;
  end;

  if (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
    BaseObject.HealthSpellChanged();
end;

procedure ActionOfGuildBuildPoint(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nBuildPoint: Integer;
  cMethod: Char;
  Guild: TGUild;
begin
  nBuildPoint := QuestActionInfo.nParam2;

  if (QuestActionInfo.sParam1 = '') or (nBuildPoint < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_MyGuild = nil then
  begin
    PlayObject.SysMsg(g_sScriptGuildBuildPointNoGuild, c_Red, t_Hint);
    Exit;
  end;

  Guild := TGUild(PlayObject.m_MyGuild);
  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        Guild.nBuildPoint := nBuildPoint;
      end;
    '-':
      begin
        if Guild.nBuildPoint >= nBuildPoint then
          Guild.nBuildPoint := Guild.nBuildPoint - nBuildPoint
        else
          Guild.nBuildPoint := 0;
      end;
    '+':
      begin
        if (High(Integer) - Guild.nBuildPoint) >= nBuildPoint then
          Guild.nBuildPoint := Guild.nBuildPoint + nBuildPoint
        else
          Guild.nBuildPoint := High(Integer);
      end;
  end;

  if g_Config.boShowScriptActionMsg then
    PlayObject.SysMsg(Format(g_sScriptGuildBuildPointMsg, [Guild.nBuildPoint]), c_Green, t_Hint);
end;

