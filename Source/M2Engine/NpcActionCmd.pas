procedure ActionOfGotoLabel(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, II: Integer;
  AObject: TPlayObject;
  GuildRank: pTGuildRank;
  BaseObjectList: TList;
  nRange: Integer;
  sSendVar, sRecvVar: string;
begin
  if (not (QuestActionInfo.nParam1 in [0..8])) or (QuestActionInfo.sParam2 = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  nRange := QuestActionInfo.nParam3;
  if (nRange < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  case QuestActionInfo.nParam1 of
    0:
      begin
        if (PlayObject.m_GroupOwner <> nil) and (PlayObject.m_GroupOwner.m_GroupMembers <> nil) then
        begin
          BaseObjectList := TList.Create;
          try
{$IF MULTI_THREAD = 1}
            if g_MultiThreadRun then
              PlayObject.m_GroupOwner.m_GroupMembers.LockR(16);
            try
{$IFEND}
              for I := 0 to PlayObject.m_GroupOwner.m_GroupMembers.Count - 1 do
              begin
                AObject := TPlayObject(PlayObject.m_GroupOwner.m_GroupMembers.Objects[I]);
                if (AObject <> nil) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
                begin
                  BaseObjectList.Add(AObject);

                  {
                    if nRange = 0 then
                    Npc.GotoLable(AObject, QuestActionInfo.sParam2, False)
                    else if (Abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (Abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                    Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
                  }
                end;
              end;
{$IF MULTI_THREAD = 1}
            finally
              if g_MultiThreadRun then
                PlayObject.m_GroupOwner.m_GroupMembers.UnLockR;
            end;
{$IFEND}
            for I := 0 to BaseObjectList.Count - 1 do
            begin
              AObject := BaseObjectList.Items[I];
              if AObject <> nil then
              begin
                if nRange = 0 then
                  Npc.GotoLable(AObject, QuestActionInfo.sParam2, False)
                else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                  Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
              end;
            end;
          finally
            BaseObjectList.Free;
          end;
        end;
      end;
    1:
      begin
        if PlayObject.m_MyGuild <> nil then
        begin
          for I := 0 to TGUild(PlayObject.m_MyGuild).m_RankList.Count - 1 do
          begin
            GuildRank := TGUild(PlayObject.m_MyGuild).m_RankList.Items[I];
            if GuildRank = nil then
              Continue;
            for II := 0 to GuildRank.MemberList.Count - 1 do
            begin
              AObject := TPlayObject(GuildRank.MemberList.Objects[II]);
              if AObject = nil then
                Continue;
              if (not AObject.m_boDeath) and (not AObject.m_boGhost) then
              begin
                if nRange = 0 then
                  Npc.GotoLable(AObject, QuestActionInfo.sParam2, False)
                else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                  Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
              end;
            end;
          end;
        end;
      end;
    2:
      begin
        BaseObjectList := TList.Create;
        try
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.LockR(82);
          try
{$IFEND}
            for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
            begin
              AObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
              if (AObject <> nil) and (PlayObject.m_PEnvir = AObject.m_PEnvir) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
                BaseObjectList.Add(AObject);
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              UserEngine.m_PlayObjectList.UnLockR;
          end;
{$IFEND}
          for I := 0 to BaseObjectList.Count - 1 do
          begin
            AObject := BaseObjectList.Items[I];
            if AObject <> nil then
            begin
              if nRange = 0 then
                Npc.GotoLable(AObject, QuestActionInfo.sParam2, False)
              else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
            end;
          end;
        finally
          BaseObjectList.Free;
        end;
      end;
    3:
      begin
        BaseObjectList := TList.Create;
        PlayObject.m_PEnvir.GetRangePlayObject(PlayObject.m_nCurrX, PlayObject.m_nCurrY, nRange, True, BaseObjectList);
        for I := 0 to BaseObjectList.Count - 1 do
        begin
          AObject := TPlayObject(BaseObjectList.Items[I]);
          if (AObject <> nil) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
            Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
        end;
        BaseObjectList.Free;
      end;
    4:
      begin
        if (PlayObject.m_GroupOwner <> nil) and (PlayObject.m_GroupOwner.m_GroupMembers <> nil) then
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            PlayObject.m_GroupOwner.m_GroupMembers.LockR(17);
          try
{$IFEND}
            for I := 0 to PlayObject.m_GroupOwner.m_GroupMembers.Count - 1 do
            begin
              AObject := TPlayObject(PlayObject.m_GroupOwner.m_GroupMembers.Objects[I]);
              if (AObject <> nil) and (not AObject.m_boDeath) and (not AObject.m_boGhost) and (AObject <> PlayObject) then
              begin
                if nRange = 0 then
                  Npc.GotoLable(AObject, QuestActionInfo.sParam2, False)
                else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                  Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
              end;
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              PlayObject.m_GroupOwner.m_GroupMembers.UnLockR;
          end;
{$IFEND}
        end;
      end;
    5:
      begin
        if PlayObject.m_MyGuild <> nil then
        begin
          for I := 0 to TGUild(PlayObject.m_MyGuild).m_RankList.Count - 1 do
          begin
            GuildRank := TGUild(PlayObject.m_MyGuild).m_RankList.Items[I];
            if GuildRank = nil then
              Continue;
            for II := 0 to GuildRank.MemberList.Count - 1 do
            begin
              AObject := TPlayObject(GuildRank.MemberList.Objects[II]);
              if (AObject <> nil) and (AObject <> PlayObject) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
              begin
                if nRange = 0 then
                  Npc.GotoLable(AObject, QuestActionInfo.sParam2, False)
                else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                  Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
              end;
            end;
          end;
        end;
      end;
    6:
      begin
        BaseObjectList := TList.Create;
        try
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.LockR(83);
          try
{$IFEND}
            for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
            begin
              AObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
              if (AObject <> nil) and (AObject <> PlayObject) then
              begin
                if (PlayObject.m_PEnvir = AObject.m_PEnvir) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
                begin
                  BaseObjectList.Add(AObject);
                end;
              end;
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              UserEngine.m_PlayObjectList.UnLockR;
          end;
{$IFEND}
          for I := 0 to BaseObjectList.Count - 1 do
          begin
            // 修正gotolable 6的 bug 2019-08-19 16:15:27
            AObject := TPlayObject(BaseObjectList.Items[I]);

            if nRange = 0 then
              Npc.GotoLable(AObject, QuestActionInfo.sParam2, False)
            else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
              Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
          end;
        finally
          BaseObjectList.Free;
        end;
      end;
    7:
      begin
        BaseObjectList := TList.Create;
        PlayObject.m_PEnvir.GetRangePlayObject(PlayObject.m_nCurrX, PlayObject.m_nCurrY, nRange, True, BaseObjectList);
        for I := 0 to BaseObjectList.Count - 1 do
        begin
          AObject := TPlayObject(BaseObjectList.Items[I]);
          if (AObject <> nil) and (AObject <> PlayObject) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
          begin
            Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
          end;
        end;
        BaseObjectList.Free;
      end;
    8:
      begin
        // GOTOLABEL 8 @触发字段 X Y 范围  是否包含自己(0=包含,1=不包含)   传递的变量(允许为空)   接受的变量(允许为空)
        sSendVar := QuestActionInfo.sParam7;
        sRecvVar := QuestActionInfo.sRawParam8;

        BaseObjectList := TList.Create;
        PlayObject.m_PEnvir.GetRangePlayObject(QuestActionInfo.nParam3, QuestActionInfo.nParam4, QuestActionInfo.nParam5, True, BaseObjectList);
        for I := 0 to BaseObjectList.Count - 1 do
        begin
          AObject := TPlayObject(BaseObjectList.Items[I]);
          if (AObject <> nil) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
          begin
            if (QuestActionInfo.nParam6 = 1) and (AObject = PlayObject) then
              Continue;

            if sRecvVar <> '' then
            begin
              if (not Npc.SetVarValue(AObject, sRecvVar, sSendVar, StrToIntDef(sSendVar, 0))) then
                Npc.ScriptActionError(AObject, '', QuestActionInfo);
            end;
            Npc.GotoLable(AObject, QuestActionInfo.sParam2, False);
          end;
        end;
        BaseObjectList.Free;
      end;
  end;
end;

procedure ActionOfJoinNation(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  NationInfo: pTNationInfo;
begin
  if (QuestActionInfo.nParam1 < 1) or (QuestActionInfo.nParam1 > MAXNATIONCOUNT) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_btNation > 0 then
    Exit;

  if PlayObject.m_boAllowNation then
  begin
    g_NationManage.DeleteMember(PlayObject);
    PlayObject.m_btNation := 0;
    PlayObject.m_sNationaName := '';

    NationInfo := g_NationManage.Items[QuestActionInfo.nParam1];
    if NationInfo <> nil then
    begin
      Inc(NationInfo.nPeoples);
      PlayObject.m_btNation := QuestActionInfo.nParam1;
      PlayObject.m_sNationaName := NationInfo.sName;
      g_NationManage.AddMember(PlayObject);
      g_NationManage.SaveConfig(PlayObject.m_btNation);
    end;
  end;
end;

// 退出国家
procedure ActionOfExitNation(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  NationInfo: pTNationInfo;
begin
  if (PlayObject.m_btNation > 0) and (Length(PlayObject.m_sNationaName) > 0) then
  begin
    NationInfo := g_NationManage.Items[PlayObject.m_btNation];
    if NationInfo <> nil then
    begin
      g_NationManage.DeleteMember(PlayObject);
      PlayObject.m_btNation := 0;
      PlayObject.m_sNationaName := '';

      if SameText(NationInfo.sKingName, PlayObject.m_sCharName) then
      begin
        if g_ManageNPC <> nil then
        begin
          g_ManageNPC.GotoLable(PlayObject, '@Abdication', False);
        end;
      end;

      Dec(NationInfo.nPeoples);

      g_NationManage.SaveConfig(QuestActionInfo.nParam1);
    end;
  end;
end;

// 设置为国王
procedure ActionOfSetNationKing(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  NationInfo: pTNationInfo;
  Player: TPlayObject;
begin
  if (not (QuestActionInfo.nParam1 in [1..100])) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (PlayObject.m_btNation = 0) then
  begin
    if PlayObject.m_boAllowNation then
    begin
      g_NationManage.DeleteMember(PlayObject);
      PlayObject.m_btNation := 0;
      PlayObject.m_sNationaName := '';

      NationInfo := g_NationManage.Items[QuestActionInfo.nParam1];
      if NationInfo <> nil then
      begin
        Inc(NationInfo.nPeoples);
        PlayObject.m_btNation := QuestActionInfo.nParam1;
        PlayObject.m_sNationaName := NationInfo.sName;
        g_NationManage.AddMember(PlayObject);

        if Length(NationInfo.sKingName) > 0 then
        begin
          Player := UserEngine.GetPlayObject(NationInfo.sKingName);
          if Player <> nil then
          begin
            if g_ManageNPC <> nil then
            begin
              g_ManageNPC.GotoLable(Player, '@Abdication', False);
            end;
          end;
        end;

        NationInfo.sKingName := PlayObject.m_sCharName;
        g_NationManage.SaveConfig(PlayObject.m_btNation);
      end;
    end;
  end
  else if PlayObject.m_btNation = QuestActionInfo.nParam1 then
  begin
    NationInfo := g_NationManage.Items[QuestActionInfo.nParam1];
    if NationInfo <> nil then
    begin
      if Length(NationInfo.sKingName) > 0 then
      begin
        Player := UserEngine.GetPlayObject(NationInfo.sKingName);
        if Player <> nil then
        begin
          if g_ManageNPC <> nil then
          begin
            g_ManageNPC.GotoLable(Player, '@Abdication', False);
          end;
        end;
      end;

      NationInfo.sKingName := PlayObject.m_sCharName;
      g_NationManage.SaveConfig(PlayObject.m_btNation);
    end;
  end;
end;

