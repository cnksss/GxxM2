procedure ActionOfInc(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sParam1: string;
  nParam1: Integer;
  IsBreakParseVar: Boolean;
  sValue: string;
begin
  // Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, QuestActionInfo.sParam1, QuestActionInfo.nParam1);

  Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam2, QuestActionInfo.sParam2, QuestActionInfo.nParam2, IsBreakParseVar);

  if (Length(QuestActionInfo.sRawParam1) > 2) and (UpCase(QuestActionInfo.sRawParam1[1]) = 'L') and (QuestActionInfo.sRawParam1[2] = '$') then
  begin
    sValue := QuestActionInfo.sParam1 + ',' + QuestActionInfo.sParam2
  end
  else
    sValue := QuestActionInfo.sParam1 + QuestActionInfo.sParam2;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, sValue, QuestActionInfo.nParam1 + QuestActionInfo.nParam2) then
  begin
    if (QuestActionInfo.VarInfo1.VarAttr > aNone) then
    begin
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, sParam1, nParam1, IsBreakParseVar);
      if not Npc.SetVarValue(PlayObject, sParam1, QuestActionInfo.sParam1 + QuestActionInfo.sParam2, QuestActionInfo.nParam1 + QuestActionInfo.nParam2) then
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    end
    else
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfDec(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sValue1: AnsiString;
  nValue1: Integer;
  nValue2: Integer;
  nValue3: Integer;
  IsBreakParseVar: Boolean;
  sParam1: string;
  nParam1: Integer;
  aryLValue: TArray<string>;
  I: integer;
begin
  Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam2, QuestActionInfo.sParam2, QuestActionInfo.nParam2, IsBreakParseVar);
  Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam3, QuestActionInfo.sParam3, QuestActionInfo.nParam3, IsBreakParseVar);
  nValue1 := QuestActionInfo.nParam1;
  nValue2 := QuestActionInfo.nParam2;
  nValue3 := QuestActionInfo.nParam3;
  if (Length(QuestActionInfo.sRawParam1) > 2) and (UpCase(QuestActionInfo.sRawParam1[1]) = 'L') and (QuestActionInfo.sRawParam1[2] = '$') then
  begin
    aryLValue := QuestActionInfo.sParam1.Split([',']);
    // 使用反向循环遍历数组
    for I := High(aryLValue) downto Low(aryLValue) do
    begin
      if aryLValue[I] = QuestActionInfo.sParam2 then
      begin
        System.Delete(aryLValue, I, 1);
      end;
    end;
    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, string.Join(',', aryLValue), strtointdef(string.Join(',', aryLValue), 0)) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;

  end
  else if (nValue2 > 0) and (nValue3 > 0) then
  begin
    if nValue3 >= nValue2 then
    begin // 删除指定位置的字符串
      sValue1 := QuestActionInfo.sParam1;
      Delete(sValue1, nValue2, nValue3 - nValue2 + 1);
      if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, sValue1, nValue1) then
      begin
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
        Exit;
      end;
    end;
  end
  else if (QuestActionInfo.VarInfo1.VarType = vInteger) and (nValue2 <> 0) then
  begin // 数字变量减
    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, QuestActionInfo.sParam1, nValue1 - nValue2) then
    begin
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, sParam1, nParam1, IsBreakParseVar);
      if not Npc.SetVarValue(PlayObject, sParam1, IntToStr(nValue1 - nValue2), nValue1 - nValue2) then
      begin
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
        Exit;
      end;
    end;
  end
  else if (QuestActionInfo.VarInfo1.VarAttr = aDynamic) then
  begin
    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, QuestActionInfo.sParam1, nValue1 - nValue2) then
    begin
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, sParam1, nParam1, IsBreakParseVar);
      if not Npc.SetVarValue(PlayObject, sParam1, IntToStr(nValue1 - nValue2), nValue1 - nValue2) then
      begin
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
        Exit;
      end;
    end;
  end
  else if QuestActionInfo.sParam2 <> '' then
  begin // 删除指定字符串
    sValue1 := StringReplace(QuestActionInfo.sParam1, QuestActionInfo.sParam2, '', [rfReplaceAll]);
    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, sValue1, nValue1) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;
  end;
end;

procedure ActionOfDiv(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nValue: Integer;
  nValue2: Integer;
  nValue3: Integer;
  sParam1: string;
  nParam1: Integer;
  IsBreakParseVar: Boolean;
begin
  nValue := 0;
  nValue2 := QuestActionInfo.nParam2;
  nValue3 := QuestActionInfo.nParam3;

  if QuestActionInfo.sRawParam3 <> '' then
  begin
    if nValue3 <> 0 then
      nValue := nValue2 div nValue3;
  end
  else if nValue2 <> 0 then
    nValue := QuestActionInfo.nParam1 div nValue2;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, IntToStr(nValue), nValue) then
  begin
    Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, sParam1, nParam1, IsBreakParseVar);
    if not Npc.SetVarValue(PlayObject, sParam1, IntToStr(nValue), nValue) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;
  end;
end;

procedure ActionOfMul(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nValue: Integer;
  nValue2: Integer;
  nValue3: Integer;
  sParam1: string;
  nParam1: Integer;
  IsBreakParseVar: Boolean;
begin
  nValue2 := QuestActionInfo.nParam2;
  nValue3 := QuestActionInfo.nParam3;
  if QuestActionInfo.sRawParam3 <> '' then
    nValue := nValue2 * nValue3
  else
    nValue := QuestActionInfo.nParam1 * nValue2;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, IntToStr(nValue), nValue) then
  begin
    Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, sParam1, nParam1, IsBreakParseVar);
    if not Npc.SetVarValue(PlayObject, sParam1, IntToStr(nValue), nValue) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
