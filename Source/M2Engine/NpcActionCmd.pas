procedure ActionOfGiveBoxItemEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, J, ItemBoxIndex, FoundUserItemIndex: Integer;
  UserItem, NewUserItem: pTUserItem;
  StdItem: pTStdItem;
  FindInItemBox: Boolean;
  nCount: Integer;
  IsOverlapItem: Boolean;
begin
  ItemBoxIndex := QuestActionInfo.nParam1;
  if (ItemBoxIndex < Low(THumanItemBoxItems)) or (ItemBoxIndex > High(THumanItemBoxItems)) then
  begin
    Npc.ScriptActionError(PlayObject, 'OK框序号错误', QuestActionInfo);
    Exit;
  end;

  if Length(QuestActionInfo.sParam2) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '未指定物品', QuestActionInfo);
    Exit;
  end;

  nCount := QuestActionInfo.nParam3;
  if nCount = 0 then
    nCount := 1;

  IsOverlapItem := False; // HZQ 20230410， 根据程序意思，此处应为假
  for I := 0 to PlayObject.m_ItemList.Count - 1 do
  begin
    UserItem := PlayObject.m_ItemList.Items[I];
    if (UserItem <> nil) and (UserItem.MakeIndex = QuestActionInfo.nParam2) then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem = nil then
        Exit;

      IsOverlapItem := CheckOverLapItem(StdItem);
      Break;
    end;
  end;

  if not IsOverlapItem then
  begin
    for I := 0 to PlayObject.m_ItemList.Count - 1 do
    begin
      UserItem := PlayObject.m_ItemList.Items[I];
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);

      if UserItem = nil then
        Continue;
      if CheckOverLapItem(StdItem) then
        Continue;

      if UserItem.MakeIndex = QuestActionInfo.nParam2 then
      begin
        // 物品已经放到OK框中就不要再折腾了....
        FindInItemBox := False;
        for J := Low(PlayObject.m_ItemBoxItems) to High(PlayObject.m_ItemBoxItems) do
        begin
          if PlayObject.m_ItemBoxItems[J] = UserItem.MakeIndex then
          begin
            FindInItemBox := True;
            Break;
          end;
        end;
        if FindInItemBox then
          Continue;

        if PlayObject.m_ItemBoxItems[ItemBoxIndex] <> 0 then
        begin
          PlayObject.m_nScriptGotoCount := 0;
          if not Npc.GotoLable(PlayObject, '@ItemOutBox' + IntToStr(ItemBoxIndex), False) then
          begin
            if g_FunctionNPC <> nil then
            begin
              g_FunctionNPC.GotoLable(PlayObject, '@ItemOutBox' + IntToStr(ItemBoxIndex), False);
            end;
          end;

          PlayObject.m_ItemBoxItems[ItemBoxIndex] := 0;
          PlayObject.SendDefMessage(SM_TAKEBOXITEM, ItemBoxIndex, 0, 0, 0, '');
        end;

        PlayObject.m_ItemBoxItems[ItemBoxIndex] := UserItem.MakeIndex;
        PlayObject.m_ItemBoxAddIndex := ItemBoxIndex;

        PlayObject.m_nScriptGotoCount := 0;
        if not Npc.GotoLable(PlayObject, '@ItemIntoBox' + IntToStr(ItemBoxIndex), False) then
        begin
          if g_FunctionNPC <> nil then
          begin
            g_FunctionNPC.GotoLable(PlayObject, '@ItemIntoBox' + IntToStr(ItemBoxIndex), False);
          end;
        end;

        PlayObject.SendDefMessage(SM_GIVEBOXITEM, UserItem.MakeIndex, ItemBoxIndex, 0, 0, '');
        Break;
      end;
    end;
  end
  else
  begin
    FoundUserItemIndex := -1;
    for I := 0 to PlayObject.m_ItemList.Count - 1 do
    begin
      UserItem := PlayObject.m_ItemList.Items[I];
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);

      if UserItem = nil then
        Continue;
      if not CheckOverLapItem(StdItem) then
        Continue;

      if UserItem.MakeIndex = QuestActionInfo.nParam2 then
      begin
        if nCount = UserItem.Dura + 1 then
        begin
          FoundUserItemIndex := I;
          Break;
        end;
      end;
    end;

    if FoundUserItemIndex = -1 then
    begin
      for I := 0 to PlayObject.m_ItemList.Count - 1 do
      begin
        UserItem := PlayObject.m_ItemList.Items[I];
        StdItem := UserEngine.GetStdItem(UserItem.wIndex);

        if UserItem = nil then
          Continue;
        if not CheckOverLapItem(StdItem) then
          Continue;

        if UserItem.MakeIndex = QuestActionInfo.nParam2 then
        begin
          if nCount <= UserItem.Dura + 1 then
          begin
            FoundUserItemIndex := I;
            Break;
          end;
        end;
      end;
    end;

    if (FoundUserItemIndex >= 0) and (FoundUserItemIndex < PlayObject.m_ItemList.Count) then
    begin
      UserItem := PlayObject.m_ItemList[FoundUserItemIndex];
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if StdItem = nil then
        Exit;

      FindInItemBox := False;
      for J := Low(PlayObject.m_ItemBoxItems) to High(PlayObject.m_ItemBoxItems) do
      begin
        if PlayObject.m_ItemBoxItems[J] = UserItem.MakeIndex then
        begin
          FindInItemBox := True;
          Break;
        end;
      end;

      if FindInItemBox then
        Exit;

      if PlayObject.m_ItemBoxItems[ItemBoxIndex] <> 0 then
      begin
        PlayObject.m_nScriptGotoCount := 0;
        if not Npc.GotoLable(PlayObject, '@ItemOutBox' + IntToStr(ItemBoxIndex), False) then
        begin
          if g_FunctionNPC <> nil then
          begin
            g_FunctionNPC.GotoLable(PlayObject, '@ItemOutBox' + IntToStr(ItemBoxIndex), False);
          end;
        end;

        PlayObject.m_ItemBoxItems[ItemBoxIndex] := 0;
        PlayObject.SendDefMessage(SM_TAKEBOXITEM, ItemBoxIndex, 0, 0, 0, '');
      end;

      if UserItem.Dura + 1 > nCount then
      begin
        New(NewUserItem);
        if UserEngine.CopyToUserItemFromName(StdItem.Name, NewUserItem) then
        begin
          NewUserItem.Dura := UserItem.Dura - nCount;

          // 解包叠加物品时，保证与源物品的绑定属性一致 chongchong 2014-09-26
          NewUserItem.boIsBind := UserItem.boIsBind;
          NewUserItem.btBindOption := UserItem.btBindOption;

          NewUserItem.ItemFrom.ItemForm := ifScript;
          NewUserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
          NewUserItem.ItemFrom.DateTime := Now();

          if PlayObject.IsEnoughBag then
          begin
            PlayObject.m_ItemList.Add(NewUserItem);
            PlayObject.SendAddItem(NewUserItem);

            if (NewUserItem.boStartTime) then
            begin
              if StdItem.Need = 103 then
                PlayObject.SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System)
              else
                PlayObject.SysMsg(Format('您的限时物品[%s]开始计时，到期时间%s', [StdItem.Name, GetIncMinuteTime(NewUserItem.ItemFrom.DateTime, StdItem.NeedLevel)]), c_Red, t_System)
            end;
          end
          else
            PlayObject.DropItemDown(NewUserItem, 6, False, PlayObject, PlayObject);

          UserItem.Dura := nCount - 1;
          PlayObject.SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura);

          PlayObject.m_ItemBoxItems[ItemBoxIndex] := UserItem.MakeIndex;
          PlayObject.m_ItemBoxAddIndex := ItemBoxIndex;

          PlayObject.m_nScriptGotoCount := 0;
          if not Npc.GotoLable(PlayObject, '@ItemIntoBox' + IntToStr(ItemBoxIndex), False) then
          begin
            if g_FunctionNPC <> nil then
            begin
              g_FunctionNPC.GotoLable(PlayObject, '@ItemIntoBox' + IntToStr(ItemBoxIndex), False);
            end;
          end;
        end
        else
        begin
          Dispose(UserItem);
          Exit;
        end;
      end
      else
      begin
        PlayObject.m_ItemBoxItems[ItemBoxIndex] := UserItem.MakeIndex;
        PlayObject.m_ItemBoxAddIndex := ItemBoxIndex;

        PlayObject.m_nScriptGotoCount := 0;
        if not Npc.GotoLable(PlayObject, '@ItemIntoBox' + IntToStr(ItemBoxIndex), False) then
        begin
          if g_FunctionNPC <> nil then
          begin
            g_FunctionNPC.GotoLable(PlayObject, '@ItemIntoBox' + IntToStr(ItemBoxIndex), False);
          end;
        end;
      end;

      PlayObject.SendDefMessage(SM_GIVEBOXITEM, UserItem.MakeIndex, ItemBoxIndex, 0, 0, '');
    end;
  end;
end;

