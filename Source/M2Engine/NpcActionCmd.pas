procedure ActionOfChangeGuildMaster(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Guild: TGUild;
  I, II: Integer;
  GuildRank: pTGuildRank;
  boChanged: Boolean;
begin
  if PlayObject.m_MyGuild = nil then
  begin
    PlayObject.SysMsg('你还没有加入该行会！', c_Red, t_Hint);
    Exit;
  end;
  Guild := g_GuildManager.FindGuild(QuestActionInfo.sParam1);
  if Guild = nil then
  begin
    PlayObject.SysMsg(Format('没有找到行会“%s”', [QuestActionInfo.sParam1]), c_Red, t_Hint);
    // Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_MyGuild <> Guild then
  begin
    PlayObject.SysMsg(Format('你不是“%s”的成员', [QuestActionInfo.sParam1]), c_Red, t_Hint);
    Exit;
  end;

  if PlayObject.m_nGuildRankNo = 1 then
  begin
    PlayObject.SysMsg('你已经是该行会的掌门人了', c_Red, t_Hint);
    Exit;
  end;

  // 掌门数
  for I := 0 to Guild.m_RankList.Count - 1 do
  begin
    GuildRank := Guild.m_RankList.Items[I];
    if GuildRank.nRankNo = 1 then
    begin
      if GuildRank.MemberList.Count >= 2 then
      begin
        PlayObject.SysMsg('该行会已经有掌门人了', c_Red, t_Hint);
        Exit;
      end;
    end;
  end;

  boChanged := False;
  for I := 0 to Guild.m_RankList.Count - 1 do
  begin
    GuildRank := Guild.m_RankList.Items[I];
    for II := 0 to GuildRank.MemberList.Count - 1 do
    begin
      if GuildRank.MemberList.Strings[II] = PlayObject.m_sCharName then
      begin
        GuildRank.MemberList.Delete(II);
        boChanged := True;
        Break;
      end;
    end;
    if boChanged then
      Break;
  end;

  for I := 0 to Guild.m_RankList.Count - 1 do
  begin
    GuildRank := Guild.m_RankList.Items[I];
    if GuildRank.nRankNo = 1 then
    begin
      GuildRank.MemberList.AddObject(PlayObject.m_sCharName, PlayObject);
      boChanged := True;
      Break;
    end;
  end;

  if boChanged then
  begin
    PlayObject.m_sGuildRankName := TGUild(PlayObject.m_MyGuild).GetRankName2(PlayObject, PlayObject.m_nGuildRankNo);
    PlayObject.RefShowName();
    Guild.UpdateGuildFile;
  end;
end;

procedure ActionOfAddGuild(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Human: TPlayObject;
  boAddState: Boolean;
begin
  boAddState := False;
  if QuestActionInfo.sParam2 = 'SELF' then
  begin
    Human := PlayObject;
  end
  else
  begin
    Human := UserEngine.GetPlayObject(QuestActionInfo.sParam2);
  end;
  if Human = nil then
  begin
    PlayObject.SysMsg(Format(g_sNowNotOnLineOrOnOtherServer, [QuestActionInfo.sParam2]), c_Red, t_Hint);
    Exit;
  end;
  if g_GuildManager.MemberOfGuild(Human.m_sCharName) = nil then
  begin
    if g_GuildManager.AddGuild(QuestActionInfo.sParam1, Human.m_sCharName) then
    begin
      // PlayObject.SysMsg('行会名称: ' + QuestActionInfo.sParam1 + ' 掌门人: ' + Human.m_sCharName, c_Green, t_Hint);
      boAddState := True;
    end;
  end;
  if boAddState then
  begin
    Human.m_MyGuild := TObject(g_GuildManager.MemberOfGuild(Human.m_sCharName));
    if Human.m_MyGuild <> nil then
    begin
      Human.m_sGuildRankName := TGUild(Human.m_MyGuild).GetRankName2(PlayObject, Human.m_nGuildRankNo);
      Human.RefShowName();

      // 创建行会触发 chongchong 2013-10-28
      if (g_FunctionNPC <> nil) then
      begin
        Human.m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Human, '@CreateGuild', False);
      end;
    end;
  end;
end;

procedure ActionOfClearHeroAllSkill(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
