procedure ActionOfGuildMove(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, II: Integer;
  AObject: TBaseObject;
  GuildRank: pTGuildRank;
  Envir: TEnvirnoment;
begin
  if PlayObject.m_MyGuild = nil then
    Exit;

  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
