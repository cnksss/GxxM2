procedure ActionOfSetSkillKey(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Magic: pTMagic;
  UserMagic: pTUserMagic;
  sMagicName: string;
  nKey: Integer;
  DefMsg: TDefaultMessage;
begin
  sMagicName := QuestActionInfo.sParam1;
  nKey := QuestActionInfo.nParam2;

  if (sMagicName = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  {
    49~56:    F1 ~ F8
    69~76:    Ctrl+F1 ~ Ctrl+F8
    97~122:   A ~ Z
  }

  if not (nKey in [0, 49..56, 69..76, 97..122]) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  Magic := UserEngine.FindMagic(sMagicName, mtHum);

  if Magic <> nil then
  begin
    for I := 0 to PlayObject.m_MagicList.Count - 1 do
    begin
      UserMagic := PlayObject.m_MagicList.Items[I];
      if (UserMagic.MagicInfo.wMagicId <> Magic.wMagicId) and (UserMagic.btKey = nKey) then
      begin
        UserMagic.btKey := 0;

        DefMsg := MakeDefaultMsg(SM_UPDATE_MAGIC_KEY, 0, UserMagic.MagicInfo.wMagicId, 0, 0);
        PlayObject.SendSocket(@DefMsg, '');

        Break;
      end;
    end;

    for I := 0 to PlayObject.m_MagicList.Count - 1 do
    begin
      UserMagic := PlayObject.m_MagicList.Items[I];
      if UserMagic.MagicInfo.wMagicId = Magic.wMagicId then
      begin
        UserMagic.btKey := nKey;

        DefMsg := MakeDefaultMsg(SM_UPDATE_MAGIC_KEY, nKey, UserMagic.MagicInfo.wMagicId, 0, 0);
        PlayObject.SendSocket(@DefMsg, '');

        Break;
      end;
    end;
  end;
end;

procedure ActionOfChangePkPoint(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nPKPOINT: Integer;
  nPoint: Integer;
  nOldPKLevel: Integer;
  cMethod: Char;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nOldPKLevel := SmartObject.PKLevel;
  nPKPOINT := QuestActionInfo.nParam2;

  if (QuestActionInfo.sParam1 = '') or (nPKPOINT < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if (nPKPOINT >= 0) then
        begin
          SmartObject.m_nPkPoint := nPKPOINT;
        end;
      end;
    '-':
      begin
        nPoint := Max(0, SmartObject.m_nPkPoint - nPKPOINT);
        SmartObject.m_nPkPoint := nPoint;
      end;
    '+':
      begin
        nPoint := Max(0, SmartObject.m_nPkPoint + nPKPOINT);
        SmartObject.m_nPkPoint := nPoint;
      end;
  end;

  if nOldPKLevel <> SmartObject.PKLevel then
    SmartObject.RefNameColor;
end;

procedure ActionOfChangeExp(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nExp: Int64;
  nOldExp: LongWord;
  cMethod: Char;
  boIncBead: Boolean;
  sParamHero: string;
begin
  nExp := StrToInt64Def(QuestActionInfo.sParam2, 0);
  if nExp > High(LongWord) then
    nExp := High(LongWord);

  sParamHero := QuestActionInfo.sParam3;
  boIncBead := QuestActionInfo.nParam4 = 1;

  if QuestActionInfo.sParam1 = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  nOldExp := BaseObject.m_Abil.Exp;
  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if nExp >= 0 then
          BaseObject.m_Abil.Exp := nExp;

        if nOldExp <> BaseObject.m_Abil.Exp then
        begin
          if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
            PlayObject.GetExp(0, sParamHero = '1', True, boIncBead)
          else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(BaseObject).GetExp(0, True, boIncBead);
        end;
      end;
    '-':
      begin
        if BaseObject.m_Abil.Exp > nExp then
          Dec(BaseObject.m_Abil.Exp, nExp)
        else
          BaseObject.m_Abil.Exp := 0;

        if nOldExp <> BaseObject.m_Abil.Exp then
        begin
          if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
            PlayObject.GetExp(0, sParamHero = '1', True, boIncBead)
          else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(BaseObject).GetExp(0, True, boIncBead);
        end;
      end;
    '+':
      begin
        if g_Config.boLimitChangeExp and (BaseObject.m_Abil.Level >= g_Config.nHighLevel) then
          nExp := Max(g_Config.nHighLevelGetExp, 0);

        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
          PlayObject.GetExp(nExp, sParamHero = '1', True, boIncBead, True)
        else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(BaseObject).GetExp(nExp, True, boIncBead, True);
      end;
  end;
end;

procedure ActionOfChangeJob(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nJob: Integer;
  sJob: string;
begin
  nJob := QuestActionInfo.nParam1;
  sJob := QuestActionInfo.sParam1;

  if CompareLStr(sJob, sWARRIOR, 3) or (CompareText(sJob, '战士') = 0) then
    nJob := 0;
  if CompareLStr(sJob, sWIZARD, 3) or (CompareText(sJob, '法师') = 0) then
    nJob := 1;
  if CompareLStr(sJob, sTAOS, 3) or (CompareText(sJob, '道士') = 0) then
    nJob := 2;

  if not (nJob in [0..2]) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if BaseObject.m_btJob <> nJob then
  begin
    BaseObject.m_btJob := nJob;
    BaseObject.HasLevelUp(0, False);
    BaseObject.FeatureChanged;
  end;
end;

