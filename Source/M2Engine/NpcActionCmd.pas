procedure ActionOfOpenPulse(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nMeridian, nAcupoint: Integer;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(BaseObject);
    if SmartObject.m_boTrainingNG then
    begin

      nMeridian := QuestActionInfo.nParam1;
      nAcupoint := QuestActionInfo.nParam2;

      if (not (nMeridian in [0..4])) or (not (nAcupoint in [1..5])) then
      begin
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
        Exit;
      end;

      Dec(nAcupoint);

      if (nAcupoint > 0) and (nMeridian <> 4) then // 检测上一个穴道有没有打通
        if SmartObject.m_HumMeridians[nMeridian].Acupoints[nAcupoint - 1] <= 0 then
          Exit;

      SmartObject.m_HumMeridians[nMeridian].Acupoints[nAcupoint] := 1;
      BaseObject.SendMsg(BaseObject, RM_ABILITYMERIDIANS, 0, 0, 0, 0, ''); // 经络
      if nAcupoint = 4 then
        ShowEffect(BaseObject, 5) // 显示穴位全部打通动画效果
      else
        ShowEffect(BaseObject, 4) // 显示打通穴位动画效果
    end;
  end;
end;

procedure ActionOfClearAllPulse(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, J: Integer;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(BaseObject);
    if SmartObject.m_boTrainingNG then
    begin
      for I := Low(SmartObject.m_HumMeridians) to High(SmartObject.m_HumMeridians) do
      begin
        for J := Low(SmartObject.m_HumMeridians[I].Acupoints) to High(SmartObject.m_HumMeridians[I].Acupoints) do
        begin
          SmartObject.m_HumMeridians[I].Acupoints[J] := 0;
        end;
      end;
      SmartObject.SendMsg(BaseObject, RM_ABILITYMERIDIANS, 0, 0, 0, 0, ''); // 经络
    end;
  end;
end;

procedure ActionOfChangePulseLevel(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nMeridian, nLevel: Integer;
  nOldLevel: Integer;
  cMethod: Char;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(BaseObject);
    if SmartObject.m_boTrainingNG then
    begin
      nMeridian := QuestActionInfo.nParam1;
      nLevel := QuestActionInfo.nParam3;

      if (QuestActionInfo.sParam2 = '') or (not (nMeridian in [0..4])) or (not (nLevel in [0..5])) then
      begin
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
        Exit;
      end;

      nOldLevel := SmartObject.m_HumMeridians[nMeridian].Level;
      cMethod := QuestActionInfo.sParam2[1];
      case cMethod of
        '=':
          begin
            if (nLevel >= 0) then
            begin
              SmartObject.m_HumMeridians[nMeridian].Level := nLevel;
            end;
          end;
        '-':
          begin
            if SmartObject.m_HumMeridians[nMeridian].Level - nLevel >= 1 then
              SmartObject.m_HumMeridians[nMeridian].Level := Max(0, SmartObject.m_HumMeridians[nMeridian].Level - nLevel);
          end;
        '+':
          begin
            if SmartObject.m_HumMeridians[nMeridian].Level + nLevel <= 5 then
              SmartObject.m_HumMeridians[nMeridian].Level := Max(0, SmartObject.m_HumMeridians[nMeridian].Level + nLevel);
          end;
      end;
      if nOldLevel <> SmartObject.m_HumMeridians[nMeridian].Level then
        BaseObject.SendMsg(BaseObject, RM_ABILITYMERIDIANS, 0, 0, 0, 0, ''); // 经络
    end;
  end;
end;

procedure ActionOfReadSkillNG(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(BaseObject);
    if (BaseObject.m_btRaceServer = RC_HEROOBJECT) then
    begin
      if (not SmartObject.m_boTrainingNG) and TPlayObject(BaseObject.m_Master).m_boTrainingNG then
      begin
        SmartObject.m_boTrainingNG := True;
        SmartObject.m_AbilNG.Level := 1;
        SmartObject.m_AbilNG.Exp := 0;
        SmartObject.m_AbilNG.MaxExp := SmartObject.GetLevelExpNG(SmartObject.m_AbilNG.Level);
        SmartObject.RecalcLevelAbilitysNG;
        SmartObject.SendMsg(SmartObject, RM_ABILITYNG, 0, 0, 0, 0, ''); // 内功属性
        SmartObject.SendMsg(SmartObject, RM_ABILITYMERIDIANS, 0, 0, 0, 0, ''); // 经络
