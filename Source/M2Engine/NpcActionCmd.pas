procedure ActionOfAddGamePetMagic(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  StdItem: pTStdItem;
  ItemIndex: Integer;
  MagicIndex: Integer;
begin
  if (QuestActionInfo.sParam1 = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  StdItem := UserEngine.GetStdItemEx(QuestActionInfo.sParam1, ItemIndex);
  if StdItem = nil then
    Exit;

  if (PlayObject.m_MyGamePetIndex >= 0) and (PlayObject.m_MyGamePetIndex < PlayObject.m_GamePetList.Count) and (PlayObject.m_MyGamePet <> nil) then
  begin
    if PlayObject.GetGamePetMagicCount >= MAX_GamePet_MAGIC_COUNT then
    begin
      PlayObject.SysMsg('最多只能学习8个技能！', 255, 253, t_Hint);
      Exit;
    end;

    if PlayObject.GamePetAddMagic(ItemIndex, StdItem.Name, MagicIndex, False) = gpr_OK then
    begin
      if (g_FunctionNPC <> nil) then
      begin
        PlayObject.m_nGamePetMagicID := ItemIndex - 1;
        PlayObject.m_nGamePetMagicIndex := MagicIndex;
        PlayObject.m_sGamePetMagicName := StdItem.Name;
        g_FunctionNPC.GotoLable(PlayObject, '@GamePetAddMagic', False);
        PlayObject.m_nGamePetMagicID := 0;
        PlayObject.m_nGamePetMagicIndex := 0;
        PlayObject.m_sGamePetMagicName := '';
      end;

      PlayObject.SendSetPetMagic(PlayObject.m_MyGamePetIndex, MagicIndex, ItemIndex);

      PlayObject.m_MyGamePet.RecalcAbilitys;
      PlayObject.m_MyGamePet.SendMsg(PlayObject.m_MyGamePet, RM_ABILITY, 0, 0, 0, 0, '');
      PlayObject.m_MyGamePet.SendMsg(PlayObject.m_MyGamePet, RM_SUBABILITY, 0, 0, 0, 0, '');
    end;
  end;
end;

procedure ActionOfDelGamePetMagic(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  GamePetData: pTGamePetData;
  StdItem: pTStdItem;
  I, ItemIndex: Integer;
  IsChange: Boolean;
begin
  if (QuestActionInfo.sParam1 = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  StdItem := UserEngine.GetStdItemEx(QuestActionInfo.sParam1, ItemIndex);
  if StdItem = nil then
    Exit;

  if (PlayObject.m_MyGamePetIndex >= 0) and (PlayObject.m_MyGamePetIndex < PlayObject.m_GamePetList.Count) and (PlayObject.m_MyGamePet <> nil) then
  begin
    GamePetData := PlayObject.m_GamePetList.Items[PlayObject.m_MyGamePetIndex];

    IsChange := False;
    for I := Low(GamePetData.wMagics) to High(GamePetData.wMagics) do
    begin
      if GamePetData.wMagics[I] = ItemIndex then
      begin
        GamePetData.wMagics[I] := 0;
        PlayObject.SendSetPetMagic(PlayObject.m_MyGamePetIndex, I, 0);
        IsChange := True;
      end;
    end;

    if IsChange then
    begin
      PlayObject.m_MyGamePet.RecalcAbilitys;
      PlayObject.m_MyGamePet.SendMsg(PlayObject.m_MyGamePet, RM_ABILITY, 0, 0, 0, 0, '');
      PlayObject.m_MyGamePet.SendMsg(PlayObject.m_MyGamePet, RM_SUBABILITY, 0, 0, 0, 0, '');
    end;
  end;
end;

procedure ActionOfGamePetChangeExp(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nExp: Int64;
  nOldExp: LongWord;
  cMethod: Char;
begin
  nExp := StrToInt64Def(QuestActionInfo.sParam2, 0);
  if nExp > High(LongWord) then
    nExp := High(LongWord);

  if QuestActionInfo.sParam1 = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_MyGamePet = nil then
    Exit;

  nOldExp := PlayObject.m_MyGamePet.m_Abil.Exp;
  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if nExp >= 0 then
          PlayObject.m_MyGamePet.m_Abil.Exp := nExp;

        if nOldExp <> PlayObject.m_MyGamePet.m_Abil.Exp then
        begin
          PlayObject.m_MyGamePet.IncGamePetExt(0);
        end;
      end;
    '-':
      begin
        if PlayObject.m_MyGamePet.m_Abil.Exp > nExp then
          Dec(PlayObject.m_MyGamePet.m_Abil.Exp, nExp)
        else
          PlayObject.m_MyGamePet.m_Abil.Exp := 0;

        if nOldExp <> PlayObject.m_MyGamePet.m_Abil.Exp then
        begin
          PlayObject.m_MyGamePet.IncGamePetExt(0);
        end;
      end;
    '+':
      begin
        if g_Config.boLimitChangeExp and (PlayObject.m_MyGamePet.m_Abil.Level >= g_Config.nHighLevel) then
          nExp := Max(g_Config.nHighLevelGetExp, 0);
        PlayObject.m_MyGamePet.IncGamePetExt(nExp);
      end;
  end;
end;

