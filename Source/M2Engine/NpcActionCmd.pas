procedure ActionOfDummyLogon(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nCount: Integer;
  DummyLogon: TDummyLogon;
  LogonList: TStringList;
  nX, nY: Integer;
  Envir: TEnvirnoment;
  Index1: Integer;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  nX := QuestActionInfo.nParam2;
  nY := QuestActionInfo.nParam3;
  nCount := QuestActionInfo.nParam4;

  if (Envir = nil) or (nX < 0) or (nY < 0) or (nCount < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if nCount > 0 then
  begin
    DummyLogon.sMapName := Envir.sMapName;
    DummyLogon.nX := nX;
    DummyLogon.nY := nY;
    LogonList := TStringList.Create;

    g_DummyNameList.Lock;
    try
      LogonList.Capacity := g_DummyNameList.Count;

      for I := 0 to g_DummyNameList.Count - 1 do
      begin
        if (UserEngine.GetPlayObject(g_DummyNameList.Strings[I]) = nil) and (not UserEngine.FindDummyLogon(g_DummyNameList.Strings[I])) then
        begin
          LogonList.Add(g_DummyNameList.Strings[I]);
        end;
      end;
    finally
      g_DummyNameList.UnLock;
    end;

    if (not g_Config.boDummyLogonRand) then
    begin
      for I := 0 to LogonList.Count - 1 do
      begin
        if nCount <= 0 then
          Break;
        DummyLogon.sCharName := LogonList.Strings[I];
        UserEngine.AddDummyLogon(@DummyLogon);
        Dec(nCount);
      end;
    end
    else
    begin
      Randomize;

      while nCount > 0 do
      begin
        Index1 := Random(LogonList.Count);
        DummyLogon.sCharName := LogonList.Strings[Index1];
        UserEngine.AddDummyLogon(@DummyLogon);
        LogonList.Delete(Index1);
        if LogonList.Count <= 0 then
          Break;
        Dec(nCount);
      end;
    end;

    LogonList.Free;
  end;
end;

procedure ActionOfSetWeatherEffect(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nWeatherEffect: Integer;
  nTime: Integer;
  nDark: Integer; // 是否黑暗效果
  sMusic: string;
  Envir: TEnvirnoment;
  I: Integer;
begin
  Envir := nil;
  sMusic := '';

  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  nWeatherEffect := QuestActionInfo.nParam2;
  nTime := QuestActionInfo.nParam3;
  nDark := QuestActionInfo.nParam4;
  sMusic := QuestActionInfo.sParam5;

  if (Envir = nil) or (not (nWeatherEffect in [0..High(Envir.m_WeatherEffect)])) or (nTime < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;
  // 脚本格式:SETWEATHEREFFECT 地图号 天气效果(0=关闭天气效果 1=黄沙效果 2=花瓣效果 3=下雪效果) 有效时间(秒) 是否黑暗(0正常 1黑暗) 音乐文件
  { 修改天气特效扩展 2013-07-15 }
  if nWeatherEffect <> 0 then
  begin
    Envir.m_WeatherEffect[nWeatherEffect - 1].boIsUsed := True;
    Envir.m_WeatherEffect[nWeatherEffect - 1].boIsDark := StrToBool(IntToStr(nDark));
    Envir.m_WeatherEffect[nWeatherEffect - 1].dwTick := MyGetTickCount;
    Envir.m_WeatherEffect[nWeatherEffect - 1].dwTime := nTime * 1000;
    Envir.m_WeatherEffect[nWeatherEffect - 1].sMusic := sMusic;
  end
  else
  begin
    for I := Low(Envir.m_WeatherEffect) to High(Envir.m_WeatherEffect) do
    begin
      Envir.m_WeatherEffect[I].boIsUsed := False;
    end;
  end;

  UserEngine.WeatherChanged(Envir);

  {
    case nWeatherEffect of
    0: begin
    boWeatherChanged := Envir.m_boWeatherEffect1 or Envir.m_boWeatherEffect2 or Envir.m_boWeatherEffect3;
    Envir.m_boWeatherEffect1 := False;
    Envir.m_boWeatherEffect2 := False;
    Envir.m_boWeatherEffect3 := False;
    if boWeatherChanged then
    UserEngine.WeatherChanged(Envir);
    end;
    1: begin
    boWeatherChanged := Envir.m_boWeatherEffect1;
    Envir.m_boWeatherEffect1 := True;
    Envir.m_dwWeatherEffectTick1 := MyGetTickCount;
    Envir.m_dwWeatherEffectTime1 := nTime * 1000;
    Envir.m_boIsWeatherDark1 := StrToBool(IntToStr(nDark));
    if boWeatherChanged <> Envir.m_boWeatherEffect1 then
    UserEngine.WeatherChanged(Envir);
    end;
    2: begin
    boWeatherChanged := Envir.m_boWeatherEffect2;
    Envir.m_boWeatherEffect2 := True;
    Envir.m_dwWeatherEffectTick2 := MyGetTickCount;
    Envir.m_dwWeatherEffectTime2 := nTime * 1000;
    Envir.m_boIsWeatherDark2 := StrToBool(IntToStr(nDark));
    if boWeatherChanged <> Envir.m_boWeatherEffect2 then
    UserEngine.WeatherChanged(Envir);
    end;
    3: begin
    boWeatherChanged := Envir.m_boWeatherEffect3;
    Envir.m_boWeatherEffect3 := True;
    Envir.m_dwWeatherEffectTick3 := MyGetTickCount;
    Envir.m_dwWeatherEffectTime3 := nTime * 1000;
    Envir.m_boIsWeatherDark3 := StrToBool(IntToStr(nDark));
    if boWeatherChanged <> Envir.m_boWeatherEffect3 then
    UserEngine.WeatherChanged(Envir);
    end;
    end;
  }
end;

