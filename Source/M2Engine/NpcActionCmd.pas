procedure ActionOfChangeHumAbilityPercentage(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  tmpWhere, tmpPoint, tmpBaseValue: Integer;
  tmpQuestActionInfo: pTQuestActionInfo;
begin
  if not BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    Exit;

  tmpWhere := QuestActionInfo.nParam1;
  tmpPoint := QuestActionInfo.nParam3;

  if (QuestActionInfo.sParam2 = '') or (not (tmpWhere in [1..23])) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  tmpBaseValue := 0;
  Dec(tmpWhere);
  case tmpWhere of
    0:
      tmpBaseValue := PlayObject.m_WAbil.AC1;
    1:
      tmpBaseValue := PlayObject.m_WAbil.AC2;
    2:
      tmpBaseValue := PlayObject.m_WAbil.MAC1;
    3:
      tmpBaseValue := PlayObject.m_WAbil.MAC2;
    4:
      tmpBaseValue := PlayObject.m_WAbil.DC1;
    5:
      tmpBaseValue := PlayObject.m_WAbil.DC2;
    6:
      tmpBaseValue := PlayObject.m_WAbil.MC1;
    7:
      tmpBaseValue := PlayObject.m_WAbil.MC2;
    8:
      tmpBaseValue := PlayObject.m_WAbil.SC1;
    9:
      tmpBaseValue := PlayObject.m_WAbil.SC2;
    10:
      tmpBaseValue := PlayObject.m_WAbil.MaxHP;
    11:
      tmpBaseValue := PlayObject.m_WAbil.MaxMP;
    12:
      tmpBaseValue := PlayObject.m_DecNGDamage;
    13:
      tmpBaseValue := PlayObject.m_nHealthRecover;
    14:
      tmpBaseValue := PlayObject.m_nSpellRecover;
    15:
      tmpBaseValue := PlayObject.m_nPoisonRecover;
    16:
      tmpBaseValue := PlayObject.m_btAntiPoison;
    17:
      tmpBaseValue := PlayObject.m_nAntiMagic;
    18:
      tmpBaseValue := PlayObject.m_btHitPoint;
    19:
      tmpBaseValue := PlayObject.m_btSpeedPoint;
    20:
      tmpBaseValue := PlayObject.m_nLuck;
    21:
      tmpBaseValue := PlayObject.m_AddNGDamage;
    22:
      tmpBaseValue := PlayObject.m_AbilNG.NH;
  end;

  tmpQuestActionInfo := AllocMem(SizeOf(TQuestActionInfo));

  Move(QuestActionInfo^, tmpQuestActionInfo^, SizeOf(TQuestActionInfo));

  if QuestActionInfo.sParam2[1] = '=' then // 等号的逻辑和ActionOfChangeHumAbility不同，单独处理
    tmpQuestActionInfo.nParam3 := -Round((tmpBaseValue - PlayObject.m_AddNakedAbil[tmpWhere]) * (100 - tmpPoint) / 100)
  else // 只使用基本属性值，所以每次需要减去附加属性再计算
    tmpQuestActionInfo.nParam3 := Round((tmpBaseValue - PlayObject.m_AddNakedAbil[tmpWhere]) * tmpPoint / 100);

  ActionOfChangeHumAbility(Npc, BaseObject, PlayObject, tmpQuestActionInfo, boSendNpcSay, boBreak);
  FreeMemory(tmpQuestActionInfo);
end;

procedure ActionOfGetItemAddValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nType, nBoxItemIndex, nMakeIndex: Integer;
  UserItem: pTUserItem;
  nValue: Integer;
  SmartObject: TSmartObject;
  Player: TPlayObject;
  boAll: Boolean;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  boAll := False;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if Pos('all', LowerCase(QuestActionInfo.sParam1)) > 0 then
    boAll := True
  else if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  nType := QuestActionInfo.nParam2;

  if (not (nType in [0..14])) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if boAll then
  begin
    nValue := 0;

    for I := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      UserItem := @SmartObject.m_UseItems[I];
      // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (UserItem.wIndex > 0) { or (StdItem = nil) } then
      begin
        if UserItem <> nil then
        begin
          if nType = 14 then
            nValue := nValue + UserItem.Dura
          else
            nValue := nValue + UserItem.btValue[nType];
        end;
      end;
    end;

    for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
    begin
      UserItem := @SmartObject.m_JewelryBoxItems[I];
      // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (UserItem.wIndex > 0) { or (StdItem = nil) } then
      begin
        if UserItem <> nil then
        begin
          if nType = 14 then
            nValue := nValue + UserItem.Dura
          else
            nValue := nValue + UserItem.btValue[nType];
        end;
      end;
    end;

    for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
    begin
      UserItem := @SmartObject.m_GodBlessItems[I];
      // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (UserItem.wIndex > 0) { or (StdItem = nil) } then
      begin
        if UserItem <> nil then
        begin
          if nType = 14 then
            nValue := nValue + UserItem.Dura
          else
            nValue := nValue + UserItem.btValue[nType];
        end;
      end;
    end;

    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      Player := TPlayObject(SmartObject)
    else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
      Player := TPlayObject(SmartObject.Master)
    else
      Player := nil;

    if Player <> nil then
    begin
      if not Npc.SetVarValue(Player, QuestActionInfo.sRawParam3, IntToStr(nValue), nValue) then
      begin
        Npc.ScriptActionError(Player, '', QuestActionInfo);
      end;
    end;
    Exit;
  end;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
