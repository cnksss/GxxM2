        SmartObject.RefAbilNH(); // 内功
        ShowEffect(SmartObject, 3); // 人物升级效果
        Npc.GotoLable(TPlayObject(BaseObject.m_Master), '@ReadNGHeroOK', False);
      end
      else
        Npc.GotoLable(TPlayObject(BaseObject.m_Master), '@ReadNGHeroFail', False);
    end
    else if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      if (not SmartObject.m_boTrainingNG) then
      begin
        SmartObject.m_boTrainingNG := True;
        SmartObject.m_AbilNG.Level := 1;
        SmartObject.m_AbilNG.Exp := 0;
        SmartObject.m_AbilNG.MaxExp := SmartObject.GetLevelExpNG(SmartObject.m_AbilNG.Level);
        SmartObject.RecalcLevelAbilitysNG;
        SmartObject.SendMsg(SmartObject, RM_ABILITYNG, 0, 0, 0, 0, ''); // 内功属性
        SmartObject.SendMsg(SmartObject, RM_ABILITYMERIDIANS, 0, 0, 0, 0, ''); // 经络
        SmartObject.SendMsg(SmartObject, RM_CONTINUOUSMAGICORDER, 0, 0, 0, 0, ''); // 连击顺序
        SmartObject.SendMsg(SmartObject, RM_TRAININGNG, NativeInt(SmartObject), Integer(SmartObject.m_boTrainingNG), Integer(SmartObject.m_boTrainingXF), 0, ''); // 是否修炼内功心法 界面相应显示内功心法界面  series=0 人物 series=1 英雄
        SmartObject.RefAbilNH(); // 内功
        ShowEffect(SmartObject, 3);
        Npc.GotoLable(TPlayObject(BaseObject), '@ReadNGOK', False);
      end
      else
        Npc.GotoLable(TPlayObject(BaseObject), '@ReadNGFail', False);
    end;
  end;
end;

procedure ActionOfChangeNGLevel(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  boChgOK: Boolean;
  nLevel: Integer;
  nLv: Integer;
  nOldLevel: Integer;
  cMethod: Char;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(BaseObject);
    if SmartObject.m_boTrainingNG then
    begin
      // 修炼过内功才可以调整内功等级

      boChgOK := False;
      nOldLevel := SmartObject.m_AbilNG.Level;
      nLevel := QuestActionInfo.nParam2;

      if (QuestActionInfo.sParam1 = '') or (nLevel < 0) or (nLevel > MAXNG_LEVEL) then
      begin
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
        Exit;
      end;

      cMethod := QuestActionInfo.sParam1[1];
      case cMethod of
        '=':
          begin
            if (nLevel > 0) and (nLevel <= MAXNG_LEVEL) then
            begin
              SmartObject.m_AbilNG.Level := nLevel;
              boChgOK := True;
            end;
          end;
        '-':
          begin
            nLv := Max(0, SmartObject.m_AbilNG.Level - nLevel);
            nLv := Min(MAXNG_LEVEL, nLv);
            SmartObject.m_AbilNG.Level := nLv;
            boChgOK := True;
          end;
        '+':
          begin
            nLv := Max(0, SmartObject.m_AbilNG.Level + nLevel);
            nLv := Min(MAXNG_LEVEL, nLv);
            SmartObject.m_AbilNG.Level := nLv;
            boChgOK := True;
          end;
      end;
      if boChgOK then
        SmartObject.HasLevelUpNG(nOldLevel);

      if nOldLevel <> SmartObject.m_AbilNG.Level then
      begin
        // 注释日志 chongchong 2017-10-09
        AddGameDataLog(LOG_LevelChange, LOG_ActionNone, SmartObject, '内功等级', 0, Npc.m_sCharName, SmartObject.m_AbilNG.Level, nOldLevel, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;
    end;
  end;
end;

procedure ActionOfChangeNGExp(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nExp: Integer;
  nOldExp: LongWord;
  cMethod: Char;
  dwInt: LongWord;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(BaseObject);
    if SmartObject.m_boTrainingNG then
    begin
      // 修炼过内功才可以调整内功经验
      nExp := QuestActionInfo.nParam2;

      if (QuestActionInfo.sParam1 = '') or (nExp < 0) then
      begin
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
        Exit;
      end;

      nOldExp := SmartObject.m_AbilNG.Exp;
      cMethod := QuestActionInfo.sParam1[1];
      case cMethod of
        '=':
          begin
            if nExp >= 0 then
            begin
              SmartObject.m_AbilNG.Exp := LongWord(nExp);
            end;

            if nOldExp <> SmartObject.m_AbilNG.Exp then
            begin
              if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
              begin
                PlayObject.GetExpNG(0, False);
              end
              else
              begin
                THeroObject(BaseObject).GetExpNG(0);
              end;
            end;
            // boLevelUp := BaseObject.m_Abil.Exp >= BaseObject.m_Abil.MaxExp;
          end;
        '-':
          begin
            if SmartObject.m_AbilNG.Exp > LongWord(nExp) then
            begin
              Dec(SmartObject.m_AbilNG.Exp, LongWord(nExp));
            end
            else
            begin
              SmartObject.m_AbilNG.Exp := 0;
            end;
            if nOldExp <> SmartObject.m_AbilNG.Exp then
              if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
              begin
                PlayObject.GetExpNG(0, False);
              end
              else
              begin
                THeroObject(BaseObject).GetExpNG(0);
              end;
          end;

        '+':
          begin
            dwInt := LongWord(nExp);
            if g_Config.boLimitChangeExp and (SmartObject.m_AbilNG.Level >= g_Config.nHighLevel) then
              dwInt := Max(g_Config.nHighLevelGetExp, 0);

            if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
            begin
              PlayObject.GetExpNG(dwInt, False);
            end
            else
            begin
              THeroObject(BaseObject).GetExpNG(dwInt);
            end;
          end;
      end;
    end;
  end;
end;

