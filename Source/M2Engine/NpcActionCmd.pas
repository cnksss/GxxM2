procedure ActionOfSetSlaveAttackHumPowerRate(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  sSlaveName: string;
  I, PowerRate: Integer;
  SlaveObject: TBaseObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  sSlaveName := DelNumber(QuestActionInfo.sParam1);
  PowerRate := QuestActionInfo.nParam2;

  if (Length(sSlaveName) = 0) or (PowerRate < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  for I := 0 to SmartObject.m_SlaveList.Count - 1 do
  begin
    SlaveObject := TBaseObject(SmartObject.m_SlaveList.Items[I]);
    if CompareText(sSlaveName, DelNumber(SlaveObject.m_sCharName)) = 0 then
    begin
      SlaveObject.m_nSlaveAttackHumPowerRate := PowerRate;
    end;
  end;
end;

procedure ActionOfSetSlaveAttackHumPowerRateEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  sSlaveName: string;
  I, PowerRate: Integer;
  SlaveObject: TBaseObject;
  cMethod: Char;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  sSlaveName := DelNumber(QuestActionInfo.sParam1);
  PowerRate := QuestActionInfo.nParam3;

  if (Length(sSlaveName) = 0) or (PowerRate < 0) or (QuestActionInfo.sParam2 = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam2[1];

  for I := 0 to SmartObject.m_SlaveList.Count - 1 do
  begin
    SlaveObject := TBaseObject(SmartObject.m_SlaveList.Items[I]);
    if CompareText(sSlaveName, DelNumber(SlaveObject.m_sCharName)) = 0 then
    begin
      case cMethod of
        '+':
          begin
            SlaveObject.m_nSlaveAttackHumPowerRate := SlaveObject.m_nSlaveAttackHumPowerRate + PowerRate;
          end;
        '-':
          begin
            SlaveObject.m_nSlaveAttackHumPowerRate := Max(SlaveObject.m_nSlaveAttackHumPowerRate - PowerRate, 0);
          end;
        '=':
          begin
            SlaveObject.m_nSlaveAttackHumPowerRate := PowerRate;
          end;
      end;
    end;
  end;
end;

