  PlayObject.SendMsg(Npc, RM_PLAYDRINKSAY, nMode, 0, 0, NativeInt(Npc), sMsg);
end;

procedure ActionOfSaveHero(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  if (PlayObject.m_sHeroName = '') and (PlayObject.m_sDeputyHeroName = '') then
  begin // 玩家没有英雄
    if PlayObject.m_boPleaseDrink then
      Npc.GotoLable(PlayObject, '~PlayDrink_Already_NotHero', False)
    else
      Exit;
  end;
  if PlayObject.m_MyHero <> nil then
  begin // 英雄在线,才能进寄放
    if PlayObject.m_boFixedHero then
    begin // 评定过不能寄存
      if not THeroObject(PlayObject.m_MyHero).m_boIsDeputy then
      begin
        Npc.GotoLable(PlayObject, '@NoSaveHero2', False);
      end
      else
      begin
        Npc.GotoLable(PlayObject, '@NoSaveHero3', False);
      end;
      Exit;
    end;
    if THeroObject(PlayObject.m_MyHero).m_boIsDeputy then
    begin
      PlayObject.m_boStorageDeputyHero := True; // 副将英雄是否寄存
    end
    else
    begin
      PlayObject.m_boStorageHero := True; // 英雄是否寄存
    end;
    THeroObject(PlayObject.m_MyHero).LogOut; // 英雄退出
    Npc.GotoLable(PlayObject, '~PlayDrink_HeroOk', False);
  end
  else
  begin // 英雄不在线
    if PlayObject.m_boPleaseDrink then
      Npc.GotoLable(PlayObject, '~PlayDrink_Already_HeroBegin', False)
    else
      Npc.GotoLable(PlayObject, '~PlayDrink_HeroBegin', False);
  end;
end;

