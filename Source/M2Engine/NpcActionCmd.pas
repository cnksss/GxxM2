          AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, SmartObject.m_JewelryBoxItems[I].MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
        end;

        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(SmartObject).SendDelItem(@SmartObject.m_JewelryBoxItems[I])
        else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(SmartObject).SendDelItem(@SmartObject.m_JewelryBoxItems[I]);
        SmartObject.m_JewelryBoxItems[I].wIndex := 0;

        IsChanged := True;
        Dec(nItemCount);
      end;
    end;
  end;

  for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
  begin
    if nItemCount <= 0 then
      Break;
    if SmartObject.m_GodBlessItems[I].wIndex > 0 then
