  if g_OnlineMsgControl.boDisableUseNpc then
  begin
    Exit;
  end;

  if PlayObject.m_boGameGoldDeal then
  begin
    PlayObject.SendMsg(Npc, RM_MERCHANTSAY, 0, 0, 0, 0, '[失败]：您已经开启元宝交易系统！\ \<返回/@main>');
