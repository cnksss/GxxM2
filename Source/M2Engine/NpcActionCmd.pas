procedure ActionOfSetArrBuff(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nFileIndex, nTag, nGroupID, nImageIndex, nTime: Integer;
  sTemp, S11, S12, S13: string;
  sSendMsg, sHintMsg: AnsiString;
  boFind: Boolean;
  ArrBufInfo: PArrBufInfo;
  ArrBuffAddData: TArrBuffAddData;
begin
  // MB这个命令只支持人物触发的，非要搞成M.触发
  if BaseObject.m_btRaceServer <> RC_PLAYOBJECT then
    Exit;

  nGroupID := QuestActionInfo.nParam1 - 1;
  nTag := QuestActionInfo.nParam2;
  nFileIndex := QuestActionInfo.nParam3;
  nImageIndex := QuestActionInfo.nParam4;
  nTime := QuestActionInfo.nParam5;

  ArrBuffAddData.FlashTimeLeft := QuestActionInfo.nParam6;
  ArrBuffAddData.FlashStartIndex := QuestActionInfo.nParam7;
  ArrBuffAddData.FlashCount := QuestActionInfo.nParam8;
  sHintMsg := QuestActionInfo.sParam9;

  ArrBuffAddData.nTextOffsetX := QuestActionInfo.nParam10;

  sTemp := QuestActionInfo.sSubParam10;
  sTemp := GetValidStr3(sTemp, S11, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S12, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S13, [' ', #9]);

  ArrBuffAddData.nTextOffsetY := StrToIntDef(S11, 0);
  ArrBuffAddData.boTimeOffNoHide := StrToIntDef(S12, 0) <> 0;
  ArrBuffAddData.nTimeOffImageIndex := StrToIntDef(S13, 0);

  SetLength(sSendMsg, SizeOf(ArrBuffAddData));
  Move(ArrBuffAddData, sSendMsg[1], SizeOf(ArrBuffAddData));

  if (nGroupID < Low(g_ArrButtonConfig)) or (nGroupID > High(g_ArrButtonConfig)) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nFileIndex < 0) or (ArrBuffAddData.nTimeOffImageIndex < 0) or (nTag <= 0) or (nTag > 50) or (nTime = 0) or (nTime > 2100000) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  boFind := False;
  PlayObject.m_ArrBufList.LockW(4);
  try
    for I := 0 to PlayObject.m_ArrBufList.Count - 1 do
    begin
      ArrBufInfo := PlayObject.m_ArrBufList[I];
      if ArrBufInfo.ClientBufID = nTag then
      begin
        boFind := True;
        ArrBufInfo.Time := nTime * 1000;
        ArrBufInfo.StartTick := MyGetTickCount;
        Break;
      end;
    end;
  finally
    PlayObject.m_ArrBufList.UnLockW;
  end;

  if (not boFind) and (nTime <> 0) then
  begin
    New(ArrBufInfo);
    ArrBufInfo.ClientBufID := nTag;
    ArrBufInfo.Time := nTime * 1000;
    ArrBufInfo.StartTick := MyGetTickCount;
    PlayObject.m_ArrBufList.LockW(5);
    try
      PlayObject.m_ArrBufList.Add(ArrBufInfo);
    finally
      PlayObject.m_ArrBufList.UnLockW;
    end;
  end;

  sSendMsg := sSendMsg + sHintMsg;
  PlayObject.SendMsg(PlayObject, RM_SETARRBUFF, nFileIndex, nImageIndex, nTime, MakeWord(nGroupID, nTag), sSendMsg);
end;

