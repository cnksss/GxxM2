    nID := StrToIntDef(QuestActionInfo.sSubParam10, -1);

  if (Envir = nil) or (nX < 0) or (nY < 0) or (nImageIndex < 0) or (nStartImage < 0) or (nImageCount < 0)
  { or (nPlayCount < 0) } or (nTime < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if nID < 0 then
  begin
    for I := 0 to g_EventManager.m_EventList.Count - 1 do
    begin
      Event := g_EventManager.m_EventList.Items[I];
      if Event is TMapEffectEvent then
      begin
        MapEvent := Event as TMapEffectEvent;
        if (not MapEvent.m_boClosed) and (MapEvent.m_Envir = Envir) and (MapEvent.m_nX = nX) and (MapEvent.m_nY = nY) and (MapEvent.m_nFileIndex = nImageIndex) and (MapEvent.m_nImageIndex = nStartImage) and (MapEvent.m_nImageCount = nImageCount) and (MapEvent.m_nLoopCount = nPlayCount) and (MapEvent.m_dwSpeedTime = nTime) and (MapEvent.m_btBlend = Integer(QuestActionInfo.sParam9 = '1')) and (MapEvent.m_btLight = nLight) then
        begin
          MapEvent.m_dwSpeedTick := 0;
          MapEvent.m_boAllowClose := True;
          Break;
        end;
      end;
    end;
  end
  else
  begin
    for I := 0 to g_EventManager.m_EventList.Count - 1 do
    begin
      Event := g_EventManager.m_EventList.Items[I];
      if Event is TMapEffectEvent then
      begin
        MapEvent := Event as TMapEffectEvent;
        if MapEvent.m_nID = nID then
        begin
          MapEvent.m_dwSpeedTick := 0;
          MapEvent.m_boAllowClose := True;
        end;
      end;
    end;
  end;
end;

procedure ActionOfRectMapEffect(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Envir: TEnvirnoment;
  nX, nY, nWidth, nHeight, nType, nTime: Integer;
  nMinX, nMaxX, nMinY, nMaxY, nDir: Integer;
  SafeEvent: TSafeEvent;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  nX := QuestActionInfo.nParam2;
  nY := QuestActionInfo.nParam3;
  nWidth := QuestActionInfo.nParam4;
  nHeight := QuestActionInfo.nParam5;
  nType := QuestActionInfo.nParam6;
  nTime := QuestActionInfo.nParam7;

  if (Envir = nil) or (nX < 0) or (nY < 0) or (nTime < 0) or (nType <= 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  nMinX := nX;
  nMaxX := nX + nWidth;
  nMinY := nY;
  nMaxY := nY + nHeight;
  for nX := nMinX to nMaxX do
  begin
    for nY := nMinY to nMaxY do
    begin
      if ((nX < nMaxX) and (nY = nMinY)) or ((nY < nMaxY) and (nX = nMinX)) or (nX = nMaxX) or (nY = nMaxY) then
      begin
        if nX = nMinX then
        begin
          if nY = nMinY then
            nDir := DR_UPLEFT
          else if nY = nMaxY then
            nDir := DR_DOWNLEFT
          else
            nDir := DR_LEFT;
        end
        else if nX = nMaxX then
        begin
          if nY = nMinY then
            nDir := DR_UPRIGHT
          else if nY = nMaxY then
            nDir := DR_DOWNRIGHT
          else
            nDir := DR_RIGHT;
        end
        else
        begin
          if nY = nMinY then
            nDir := DR_UP
          else
            nDir := DR_DOWN;
        end;

        if nTime = 0 then
        begin
          SafeEvent := TSafeEvent.Create(Envir, nX, nY, nType, nDir);
        end
        else
        begin
          SafeEvent := TSafeEventEx.Create(Envir, nX, nY, nType, nDir, nTime);
        end;
        g_EventManager.AddEvent(SafeEvent);
      end;
    end;
  end;
end;

procedure ActionOfPlaySound(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  sFileName: string;
  LoopCount: Integer;
  Mode: Integer;
  IsAlwaysPlay: Boolean;
  Online: TPlayObject;
  BaseObjectList: TList;
begin
  sFileName := QuestActionInfo.sParam1;
  if (sFileName = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
  LoopCount := QuestActionInfo.nParam2;
  Mode := QuestActionInfo.nParam3;
  IsAlwaysPlay := LoopCount <= 0;
  if IsAlwaysPlay then
    LoopCount := 1;

  case Mode of
    0:
      PlayObject.SendMsg(PlayObject, RM_PLAYSOUND, Integer(IsAlwaysPlay), LoopCount, 0, 0, sFileName);
    1:
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          UserEngine.m_PlayObjectList.LockR(68);
        try
{$IFEND}
          for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
          begin
            Online := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
            if (not Online.m_boGhost) and (not Online.m_boOffLine) and (not Online.m_boDummyObject) then
              Online.SendMsg(PlayObject, RM_PLAYSOUND, Integer(IsAlwaysPlay), LoopCount, 0, 0, sFileName);
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.UnLockR;
        end;
{$IFEND}
      end;
    2:
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          UserEngine.m_PlayObjectList.LockR(69);
        try
{$IFEND}
          for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
          begin
            Online := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
            if (not Online.m_boGhost) and (not Online.m_boOffLine) and (not Online.m_boDummyObject) and (Online.m_PEnvir = PlayObject.m_PEnvir) then
              Online.SendMsg(PlayObject, RM_PLAYSOUND, Integer(IsAlwaysPlay), LoopCount, 0, 0, sFileName);
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.UnLockR;
        end;
{$IFEND}
      end;
    3:
      begin
        if PlayObject.m_MyGuild <> nil then
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.LockR(70);
          try
{$IFEND}
            for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
            begin
              Online := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
              if (not Online.m_boGhost) and (not Online.m_boOffLine) and (not Online.m_boDummyObject) and (Online.m_MyGuild = PlayObject.m_MyGuild) then
                Online.SendMsg(PlayObject, RM_PLAYSOUND, Integer(IsAlwaysPlay), LoopCount, 0, 0, sFileName);
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              UserEngine.m_PlayObjectList.UnLockR;
          end;
{$IFEND}
        end;
      end;

    4:
      begin
        BaseObjectList := TList.Create;
        PlayObject.m_PEnvir.GetRangePlayObject(PlayObject.m_nCurrX, PlayObject.m_nCurrY, PlayObject.m_nViewRange, True, BaseObjectList);
        for I := 0 to BaseObjectList.Count - 1 do
        begin
          Online := TPlayObject(BaseObjectList.Items[I]);
          if (not Online.m_boGhost) and (not Online.m_boOffLine) and (not Online.m_boDummyObject) then
            Online.SendMsg(PlayObject, RM_PLAYSOUND, 0, LoopCount, 0, 0, sFileName);
        end;
        BaseObjectList.Free;
      end;
  end;
end;

