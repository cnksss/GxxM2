procedure ActionOfChangeMapDesc(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMapDesc: string;
  sFileName: string;
  sLineText: string;
  LoadList: TStringList;
  I: Integer;
  Path: string;
begin
  if BaseObject.m_PEnvir = nil then
    Exit;
  sMapDesc := BaseObject.m_PEnvir.sMapDesc;
  BaseObject.m_PEnvir.sMapDesc := QuestActionInfo.sParam1;
  UserEngine.SendMapDescription(BaseObject.m_PEnvir);
  if QuestActionInfo.nParam2 = 1 then
  begin
    sFileName := g_Config.sEnvirDir + 'MapInfo.txt';
    if FileExists(sFileName) then
    begin
      LoadList := TStringList.Create;
      try
        LoadList.LoadFromFile(sFileName);
      except
        MainOutMessage('ChangeMapDesc loading fail.... => ' + sFileName);
      end;
      for I := 0 to LoadList.Count - 1 do
      begin
        sLineText := Trim(LoadList.Strings[I]);
        if (sLineText = '') or (sLineText[1] = ';') then
          Continue;
        if AnsiContainsText(sLineText, sMapDesc) then
        begin
          sLineText := AnsiReplaceText(sLineText, sMapDesc, QuestActionInfo.sParam1);
          LoadList.Strings[I] := sLineText;
        end;
      end;
      try
        Path := ExtractFilePath(sFileName);
        if not DirectoryExists(Path) then
        begin
          ForceDirectories(Path);
        end;

        LoadList.SaveToFile(sFileName);
      except
        MainOutMessage('ChangeMapDesc saveing fail.... => ' + sFileName);
      end;
      LoadList.Free;
    end;
  end;
end;

procedure ActionOfChangeItemDura(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nDura: Integer;
  UserItem: pTUserItem;
  cMethod: Char;
  nBoxItemIndex, nMakeIndex: Integer;
  SmartObject: TSmartObject;
  LockUpdateItemIndex: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  nDura := QuestActionInfo.nParam3;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if (nDura < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  LockUpdateItemIndex := -1;
  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    cMethod := QuestActionInfo.sParam2[1];

    if QuestActionInfo.nParam4 = 1 then
    begin
      case cMethod of
        '+':
          UserItem.DuraMax := Min(UserItem.DuraMax + nDura, High(Word));
        '-':
          UserItem.DuraMax := Max(Integer(UserItem.DuraMax) - nDura, 0);
        '=':
          UserItem.DuraMax := Min(nDura, High(Word));
      end;
    end
    else
    begin
      case cMethod of
        '+':
          UserItem.Dura := Min(UserItem.Dura + nDura, UserItem.DuraMax);
        '-':
          UserItem.Dura := Max(Integer(UserItem.Dura) - nDura, 0);
        '=':
          UserItem.Dura := Min(nDura, UserItem.DuraMax);
      end;
    end;

    if nWhere >= 0 then
    begin
      // SmartObject.m_boRecalcAbilitys := True;
      if SmartObject.m_nLockUpdateAbil = 0 then
      begin
        SmartObject.RecalcAbilitys;
      end;

      if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
      begin
        if QuestActionInfo.nParam4 = 1 then
        begin
          if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
          begin
            if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
              TPlayObject(SmartObject).SendUpdateItemDuraMax(nBoxItemIndex, UserItem.MakeIndex, True, UserItem.DuraMax)
            else
              TPlayObject(SmartObject).SendUpdateItemDuraMax(nWhere, UserItem.MakeIndex, True, UserItem.DuraMax)
          end
          else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(SmartObject).SendUpdateItemDuraMax(nWhere, UserItem.MakeIndex, UserItem.DuraMax);
        end
        else
        begin
          if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
          begin
            if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
              TPlayObject(SmartObject).SendUpdateItemDura(nBoxItemIndex, UserItem.MakeIndex, True, UserItem.Dura)
            else
              TPlayObject(SmartObject).SendUpdateItemDura(nWhere, UserItem.MakeIndex, True, UserItem.Dura)
          end
          else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(SmartObject).SendUpdateItemDura(nWhere, UserItem.MakeIndex, UserItem.Dura);
