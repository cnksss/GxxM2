procedure ActionOfChangeBmz(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  NewName, OldName: string;
  I: Integer;
  BBObject: TBaseObject;
begin
  if not BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    Exit;

  NewName := QuestActionInfo.sParam1;
  OldName := QuestActionInfo.sParam2;

  if Length(NewName) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '新名字不能为空', QuestActionInfo);
    Exit;
  end;

  SmartObject := TSmartObject(BaseObject);
  for I := 0 to SmartObject.m_SlaveList.Count - 1 do
  begin
    BBObject := TBaseObject(SmartObject.m_SlaveList.Items[I]);
    if (OldName = '') or (OldName = '*') or SameText(BBObject.m_sCharName, OldName) then
    begin
      if not SameText(BBObject.m_sCharName, NewName) then
      begin
        BBObject.m_sCharName := NewName;
        BBObject.RefShowName;
      end;
    end;
  end;
end;

