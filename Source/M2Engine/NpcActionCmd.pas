procedure ActionOfClearStoneUpgrade(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere: Integer;
  UserItem: pTUserItem;
  LockUpdateItemIndex: Integer;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  if (nWhere < -1) or (nWhere > U_GODBLESSITEM12) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := nil;
  if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    FillChar(UserItem.btValue, SizeOf(UserItem.btValue), 0);
    UserItem.btUpgradeCount := 0;
    if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        TPlayObject(SmartObject).SendUpdateItem(UserItem)
      end
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(SmartObject).SendUpdateItem(UserItem);
    end;
  end;
end;

procedure ActionOfTakeMine(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  sItemName: string;
  nCount: Integer;
  nDura, nPoint: Integer;
  cMethod: Char;
  boFind: Boolean;
begin
  sItemName := QuestActionInfo.sParam1;
  nCount := QuestActionInfo.nParam2;
  nPoint := QuestActionInfo.nParam4;

  if (sItemName = '') or (nCount < 0) or (nPoint < 0) or (Length(QuestActionInfo.sRawParam3) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sRawParam3[1];
  for I := PlayObject.m_ItemList.Count - 1 downto 0 do
  begin
    if nCount <= 0 then
      Break;
    UserItem := PlayObject.m_ItemList.Items[I];
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem = nil then
      Continue;
    if (CompareText(StdItem.Name, sItemName) = 0) { and (StdItem.StdMode = 43) } then
    begin
      // chongchong 2013-11-22
      if (StdItem.StdMode = 43) or // 矿石 纯度
      // --------------------------------------------------------------------------------------------------------持久
        ((StdItem.StdMode = 7) and (StdItem.Shape in [0, 1, 2, 3])) or // 千里传音,气血石,幻魔石,魔血石
        (StdItem.StdMode = 53) or // 53类宝石
        ((StdItem.StdMode = 2) and (StdItem.Shape in [1, 2, 3])) or // 自定义记次物品,随机传送石,回城石
        ((StdItem.StdMode = 25) and (StdItem.Shape = 9)) or // 火龙之心
        (StdItem.StdMode = 5) or // 武器
        (StdItem.StdMode = 6) or // 武器
        (StdItem.StdMode = 10) or // 衣服 (男)
        (StdItem.StdMode = 11) or // 衣服 (女)
        (StdItem.StdMode = 12) or // 盾牌
        (StdItem.StdMode = 15) or // 头盔
        (StdItem.StdMode = 16) or // 斗笠
        (StdItem.StdMode = 19) or // 项链
        (StdItem.StdMode = 20) or // 项链
        (StdItem.StdMode = 21) or // 项链
        (StdItem.StdMode = 22) or // 戒指
        (StdItem.StdMode = 23) or // 戒指
        (StdItem.StdMode = 24) or // 手镯
        (StdItem.StdMode = 26) or // 手镯
        (StdItem.StdMode = 28) or // 勋章 马牌
        (StdItem.StdMode = 30) or // 照明物体
        (StdItem.StdMode = 49) or // 聚灵珠
        (StdItem.StdMode = 66) or // 时装衣服 (男)
        (StdItem.StdMode = 67) or // 时装衣服 (女)
        (StdItem.StdMode = 68) or // 时装武器
        (StdItem.StdMode = 69) or // 时装武器
        ((StdItem.StdMode >= 75) and (StdItem.Shape <= 89)) or // 时装首饰
        (StdItem.StdMode = 90) or // 灵玉
        (StdItem.StdMode = 94) or // 捕兽网
        (StdItem.StdMode = 96) or // 祝福罐
        (StdItem.StdMode = 97) or // 火龙补品 2017-07-10
      // --------------------------------------------------------------------------------------------------------品质
        (StdItem.StdMode = 40) // 肉
        then
      begin
        nDura := Round(UserItem.Dura / 1000);
        case cMethod of
          '=':
            boFind := nDura = nPoint;
          '>':
            boFind := nDura > nPoint;
          '<':
            boFind := nDura < nPoint;
        else
          boFind := nDura >= nPoint;
        end;

        if boFind then
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            // 注释日志 chongchong 2017-10-09
            AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
          end;

          // 删除物品时，清升级框  chongchong 2018-05-16
          if PlayObject.m_UpgradeItem = UserItem then
          begin
            PlayObject.m_UpgradeItem := nil;
            PlayObject.m_UpgradeItemIsPegBag := False;
          end;

          PlayObject.SendDelItem(UserItem);
          PlayObject.m_ItemList.Delete(I);
          Dispose(UserItem);
          Dec(nCount);
        end;
      end;
    end;
  end;
end;

procedure ActionOfSetSuckDamage(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nSuckDamagePoint: Integer; // 总吸收值
  nSuckDamageRate: Integer; // 总吸收比例
  nSuckDamageProbability: Integer; // 吸收成功机率
  cMethod: Char;
  SmartObject: TSmartObject;
  Int64Value: Int64;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nSuckDamagePoint := QuestActionInfo.nParam2; // 总吸收值
  nSuckDamageRate := QuestActionInfo.nParam3; // 总吸收比例
  nSuckDamageProbability := QuestActionInfo.nParam4; // 吸收成功机率

  if (QuestActionInfo.sParam1 = '') or (nSuckDamagePoint < 0) or (nSuckDamageRate < 0) or (nSuckDamageRate > 1000) or (nSuckDamageProbability < 0) or (nSuckDamageProbability > 100) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '+':
      begin
        Int64Value := Int64(SmartObject.m_nSuckDamagePoint) + nSuckDamagePoint;
        SmartObject.m_nSuckDamagePoint := Min(Int64Value, High(Integer));
      end;
    '-':
      SmartObject.m_nSuckDamagePoint := Max(SmartObject.m_nSuckDamagePoint - nSuckDamagePoint, 0);
    '=':
      SmartObject.m_nSuckDamagePoint := nSuckDamagePoint;
  end;
  SmartObject.m_nSuckDamageRate := nSuckDamageRate;
  SmartObject.m_nSuckDamageProbability := nSuckDamageProbability;
end;

