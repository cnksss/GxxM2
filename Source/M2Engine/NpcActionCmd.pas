procedure ActionOfSendDelayMsg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMsg: string;
  sLabel: string;
  nTime, nX: Integer;
  nColor: Integer;
  nDelete: Integer;
  TimeLabel: pTTimeLabel;
begin
  if PlayObject.m_TimeLabelList.Count < 600 then
  begin
    nTime := QuestActionInfo.nParam2;
    nColor := QuestActionInfo.nParam3;
    nDelete := QuestActionInfo.nParam4;
    sLabel := QuestActionInfo.sParam5;
    sMsg := QuestActionInfo.sParam1;
    nX := QuestActionInfo.nParam6;

    if (sMsg <> '') and (nTime > 0) and (sLabel <> '') then
    begin

      sMsg := AnsiReplaceText(sMsg, '%x', IntToStr(PlayObject.m_nCurrX));
      sMsg := AnsiReplaceText(sMsg, '%y', IntToStr(PlayObject.m_nCurrY));
      if PlayObject.m_PEnvir <> nil then
        sMsg := AnsiReplaceText(sMsg, '%m', PlayObject.m_PEnvir.sMapDesc)
      else
        sMsg := AnsiReplaceText(sMsg, '%m', '????');
      sMsg := AnsiReplaceText(sMsg, '%d', Npc.m_sCharName);

      New(TimeLabel);
      TimeLabel.boDelete := False;
      TimeLabel.nType := 1;
      TimeLabel.sLabel := sLabel;
      TimeLabel.dwTime := MyGetTickCount + LongWord(nTime) * 1000;
      TimeLabel.boChangeMapDelete := nDelete <> 0;
      TimeLabel.Npc := Npc;
      TimeLabel.Envir := PlayObject.m_PEnvir;
      Npc.AddSelectLable(sLabel);

      PlayObject.m_TimeLabelList.Add(TimeLabel);

      PlayObject.SendMsg(PlayObject, RM_DELAYMESSAGE, nTime, NativeInt(TimeLabel), MakeWord(nColor, 0), nX, sMsg);
    end
    else
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

