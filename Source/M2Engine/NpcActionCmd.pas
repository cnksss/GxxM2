procedure ActionOfExeAction(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nInt1: Integer;
  OldValue, dwInt: LongWord;
begin
  // ================================================
  // 更改人物当前经验值
  // EXEACTION CHANGEEXP 0 经验数  设置为指定经验值
  // EXEACTION CHANGEEXP 1 经验数  增加指定经验
  // EXEACTION CHANGEEXP 2 经验数  减少指定经验
  // ================================================
  if CompareText(QuestActionInfo.sParam1, 'CHANGEEXP') = 0 then
  begin
    nInt1 := QuestActionInfo.nParam1;
    // if nInt1<0 then
    // GetVarValue(BaseObject, sParam2, nInt1);
    case nInt1 of //
      0:
        begin
          if QuestActionInfo.nParam3 >= 0 then
          begin
            BaseObject.m_Abil.Exp := LongWord(QuestActionInfo.nParam3);
            // BaseObject.HasLevelUp(BaseObject.m_Abil.Level - 1);
          end;
        end;
      1:
        begin
          if BaseObject.m_Abil.Exp >= LongWord(QuestActionInfo.nParam3) then
          begin
            if (BaseObject.m_Abil.Exp - LongWord(QuestActionInfo.nParam3)) > (High(LongWord) - BaseObject.m_Abil.Exp) then
              dwInt := High(LongWord) - BaseObject.m_Abil.Exp
            else
              dwInt := LongWord(QuestActionInfo.nParam3);
          end
          else
          begin
            if (LongWord(QuestActionInfo.nParam3) - BaseObject.m_Abil.Exp) > //
              (High(LongWord) - LongWord(QuestActionInfo.nParam3)) then
              dwInt := High(LongWord) - LongWord(QuestActionInfo.nParam3)
            else
              dwInt := LongWord(QuestActionInfo.nParam3);
          end;
          Inc(BaseObject.m_Abil.Exp, dwInt);
          // BaseObject.HasLevelUp(BaseObject.m_Abil.Level - 1);
        end;
      2:
        begin
          if BaseObject.m_Abil.Exp > LongWord(QuestActionInfo.nParam3) then
            Dec(BaseObject.m_Abil.Exp, LongWord(QuestActionInfo.nParam3))
          else
            BaseObject.m_Abil.Exp := 0;
          // BaseObject.HasLevelUp(BaseObject.m_Abil.Level - 1);
        end;
    end;

    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
      TPlayObject(BaseObject).GetExp(0, False, False)
    else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
      THeroObject(BaseObject).GetExp(0, False, False);

    BaseObject.SysMsg('您当前经验点数为: ' + IntToStr(BaseObject.m_Abil.Exp) + '/' + IntToStr(BaseObject.m_Abil.MaxExp), c_Green, t_Hint);
    Exit;
  end;

  // ================================================
  // 更改人物当前等级
  // EXEACTION CHANGELEVEL 0 等级数  设置为指定等级
  // EXEACTION CHANGELEVEL 1 等级数  增加指定等级
  // EXEACTION CHANGELEVEL 2 等级数  减少指定等级
  // ================================================
  if CompareText(QuestActionInfo.sParam1, 'CHANGELEVEL') = 0 then
  begin
    nInt1 := QuestActionInfo.nParam2;
    case nInt1 of //
      0:
        begin
          if LongWord(QuestActionInfo.nParam3) > 0 then
          begin
            OldValue := BaseObject.m_Abil.Level;

            if g_Config.btMaxLevel = 0 then
              BaseObject.m_Abil.Level := Min(LongWord(QuestActionInfo.nParam3), High(Word))
            else if g_Config.btMaxLevel = 1 then
              BaseObject.m_Abil.Level := Min(LongWord(QuestActionInfo.nParam3), High(Integer))
            else
              BaseObject.m_Abil.Level := Min(LongWord(QuestActionInfo.nParam3), High(LongWord));
            BaseObject.HasLevelUp(BaseObject.m_Abil.Level - 1);

            if OldValue <> BaseObject.m_Abil.Level then
            begin
              AddGameDataLog(LOG_LevelChange, LOG_ActionNone, BaseObject, '等级', 0, Npc.m_sCharName, BaseObject.m_Abil.Level, OldValue, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end;
        end;
      1:
        begin
          OldValue := BaseObject.m_Abil.Level;
          if g_Config.btMaxLevel = 0 then
          begin
            if BaseObject.m_Abil.Level >= LongWord(QuestActionInfo.nParam3) then
            begin
              if (BaseObject.m_Abil.Level - LongWord(QuestActionInfo.nParam3)) > (High(Word) - BaseObject.m_Abil.Level) then
                dwInt := High(Word) - BaseObject.m_Abil.Level
              else
                dwInt := LongWord(QuestActionInfo.nParam3);
            end
            else
            begin
              if (LongWord(QuestActionInfo.nParam3) - BaseObject.m_Abil.Level) > //
                (High(Word) - LongWord(QuestActionInfo.nParam3)) then
                dwInt := High(LongWord) - LongWord(QuestActionInfo.nParam3)
              else
                dwInt := LongWord(QuestActionInfo.nParam3);
            end;
          end
          else if g_Config.btMaxLevel = 1 then
          begin
            if BaseObject.m_Abil.Level >= LongWord(QuestActionInfo.nParam3) then
            begin
              if (BaseObject.m_Abil.Level - LongWord(QuestActionInfo.nParam3)) > (High(LongInt) - BaseObject.m_Abil.Level) then
                dwInt := High(LongInt) - BaseObject.m_Abil.Level
              else
                dwInt := LongWord(QuestActionInfo.nParam3);
            end
            else
            begin
              if (LongWord(QuestActionInfo.nParam3) - BaseObject.m_Abil.Level) > (High(LongInt) - LongWord(QuestActionInfo.nParam3)) then
                dwInt := High(LongInt) - LongWord(QuestActionInfo.nParam3)
              else
                dwInt := LongWord(QuestActionInfo.nParam3);
            end;
          end
          else
          begin
            if BaseObject.m_Abil.Level >= LongWord(QuestActionInfo.nParam3) then
            begin
              if (BaseObject.m_Abil.Level - LongWord(QuestActionInfo.nParam3)) > (High(LongWord) - BaseObject.m_Abil.Level) then
                dwInt := High(LongWord) - BaseObject.m_Abil.Level
              else
                dwInt := LongWord(QuestActionInfo.nParam3);
            end
            else
            begin
              if (LongWord(QuestActionInfo.nParam3) - BaseObject.m_Abil.Level) > (High(LongWord) - LongWord(QuestActionInfo.nParam3)) then
                dwInt := High(LongWord) - LongWord(QuestActionInfo.nParam3)
              else
                dwInt := LongWord(QuestActionInfo.nParam3);
            end;
          end;

          Inc(BaseObject.m_Abil.Level, dwInt);

          if g_Config.btMaxLevel = 0 then
            BaseObject.m_Abil.Level := Min(BaseObject.m_Abil.Level, High(Word))
          else if g_Config.btMaxLevel = 1 then
            BaseObject.m_Abil.Level := Min(BaseObject.m_Abil.Level, High(Integer))
          else
            BaseObject.m_Abil.Level := Min(BaseObject.m_Abil.Level, High(LongWord));

          BaseObject.HasLevelUp(BaseObject.m_Abil.Level - 1);

          if OldValue <> BaseObject.m_Abil.Level then
          begin
            AddGameDataLog(LOG_LevelChange, LOG_ActionNone, BaseObject, '等级', 0, Npc.m_sCharName, BaseObject.m_Abil.Level, OldValue, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
          end;
        end;
      2:
        begin
          OldValue := BaseObject.m_Abil.Level;

          if BaseObject.m_Abil.Level > LongInt(LongWord(QuestActionInfo.nParam3)) then
            Dec(BaseObject.m_Abil.Level, LongWord(QuestActionInfo.nParam3))
          else
            BaseObject.m_Abil.Level := 0;

          if g_Config.btMaxLevel = 0 then
            BaseObject.m_Abil.Level := Min(BaseObject.m_Abil.Level, High(Word))
          else if g_Config.btMaxLevel = 1 then
            BaseObject.m_Abil.Level := Min(BaseObject.m_Abil.Level, High(Integer))
          else
            BaseObject.m_Abil.Level := Min(BaseObject.m_Abil.Level, High(LongWord));

          BaseObject.HasLevelUp(BaseObject.m_Abil.Level - 1);

          if OldValue <> BaseObject.m_Abil.Level then
          begin
            AddGameDataLog(LOG_LevelChange, LOG_ActionNone, BaseObject, '等级', 0, Npc.m_sCharName, BaseObject.m_Abil.Level, OldValue, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
          end;
        end;
    end;
    BaseObject.SysMsg('您当前等级为: ' + IntToStr(BaseObject.m_Abil.Level), c_Green, t_Hint);
    Exit;
  end;

  // ================================================
  // 杀死人物
  // EXEACTION KILL 0 人物死亡,不显示凶手信息
  // EXEACTION KILL 1 人物死亡不掉物品,不显示凶手信息
  // EXEACTION KILL 2 人物死亡,显示凶手信息为NPC
  // EXEACTION KILL 3 人物死亡不掉物品,显示凶手信息为NPC
  // ================================================
  if CompareText(QuestActionInfo.sParam1, 'KILL') = 0 then
  begin
    nInt1 := QuestActionInfo.nParam2;
    case nInt1 of //
      1:
        begin
          BaseObject.m_boNoItem := True;
          BaseObject.Die;
        end;
      2:
        begin
          BaseObject.SetLastHiter(Npc);
          BaseObject.Die;
        end;
      3:
        begin
          BaseObject.m_boNoItem := True;
          BaseObject.SetLastHiter(Npc);
          BaseObject.Die;
        end;
    else
      BaseObject.Die;
    end;
    Exit;
  end;

  // ================================================
  // 踢人物下线
  // EXEACTION KICK
  // ================================================
  if CompareText(QuestActionInfo.sParam1, 'KICK') = 0 then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
      TPlayObject(BaseObject).m_boKickFlag := True
    else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
      THeroObject(BaseObject).LogOut;
    Exit;
  end;
  // ==============================================================================
end;

procedure ActionOfMapMove(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Envir: TEnvirnoment;
  nRange, X, Y: Integer;
  S1: string;
  N1: Integer;
  IsBreakParseVar: Boolean;
begin
  Envir := nil;

  // 双人骑马 chongchong 2013-10-15
  if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) //
    and TPlayObject(BaseObject).m_boOnHorse //
    and (TPlayObject(BaseObject).m_HorseOtherHum <> nil) then
  begin
    boBreak := True;
    Exit;
  end;

  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
  begin
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
    if Envir = nil then
    begin
      S1 := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, S1, N1, IsBreakParseVar);

      if Length(S1) > 0 then
        Envir := g_MapManager.FindMap(S1);
    end;
  end;

  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  if Envir <> nil then
  begin
    if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and (BaseObject.m_boDummyObject) and (not CanDummyMoveMap(Envir.sMapName)) then
    begin
      Exit;
    end;

    X := QuestActionInfo.nParam2;
    Y := QuestActionInfo.nParam3;
    nRange := QuestActionInfo.nParam4;

    if nRange > 0 then
    begin
      X := Random(nRange * 2 + 1) + (X - nRange);
      Y := Random(nRange * 2 + 1) + (Y - nRange);
    end;

    BaseObject.SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');
    BaseObject.SpaceMove(Envir.sMapName, X, Y, 0);
    boSendNpcSay := True;
  end;
end;

