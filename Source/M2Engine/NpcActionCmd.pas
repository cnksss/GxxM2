                and (not AObject.m_boOffLine) //
                and (not AObject.m_boDummyObject) //
                and (AObject.m_btNation = PlayObject.m_btNation) then
                AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime)
