procedure ActionOfSetSayItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nMakeIndex: Integer;
  UserItem: pTUserItem;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nMakeIndex := QuestActionInfo.nParam1;

  if (nMakeIndex = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  for I := 0 to SmartObject.m_ItemList.Count - 1 do
  begin
    UserItem := SmartObject.m_ItemList[I];
    if UserItem.MakeIndex = nMakeIndex then
    begin
      UserItem := @SmartObject.m_UseItems[I];
      SetSayItem(UserItem);
      Exit;
    end;
  end;

  for I := Low(THumanUseItems) to High(THumanUseItems) do
  begin
    if (SmartObject.m_UseItems[I].wIndex > 0) and (SmartObject.m_UseItems[I].MakeIndex = nMakeIndex) then
    begin
      UserItem := @SmartObject.m_UseItems[I];
      SetSayItem(UserItem);
      Exit;
    end;
  end;

  for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
  begin
    if (SmartObject.m_JewelryBoxItems[I].wIndex > 0) and (SmartObject.m_JewelryBoxItems[I].MakeIndex = nMakeIndex) then
    begin
      UserItem := @SmartObject.m_JewelryBoxItems[I];
      SetSayItem(UserItem);
      Exit;
    end;
  end;

  for I := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
  begin
    if (SmartObject.m_GodBlessItems[I].wIndex > 0) and (SmartObject.m_GodBlessItems[I].MakeIndex = nMakeIndex) then
    begin
      UserItem := @SmartObject.m_GodBlessItems[I];
      SetSayItem(UserItem);
      Exit;
    end;
  end;
end;

// 自定义表达式 By 一支笔 at:2021-07-16 14:17:44
procedure ActionOfFormulation(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  str, infoStr, signParamStr: string;
  f1: double;
  I, len, { decN, } signP: Integer;
  nResult: Integer;
  sResult: string;
begin
  if Length(QuestActionInfo.sRawParam2) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  str := QuestActionInfo.sParam1;

  if str <> '' then
  begin
    len := Length(str);
    for I := 1 to len do
    begin
      // 先去掉回车符
      if ord(str[I]) in [10, 13] then
        str[I] := ' ';

      // 替换全角的括号
      if (ord(str[I]) = 163) and ((I + 1) <= len) then
      begin
        if ord(str[I + 1]) = 168 then
        begin
          str[I] := '(';
          str[I + 1] := ' ';
        end;

        if ord(str[I + 1]) = 169 then
        begin
          str[I] := ')';
          str[I + 1] := ' ';
        end;
      end;

      // 替换全角的逗号
      if (ord(str[I]) = 163) and ((I + 1) <= len) then
      begin
        if ord(str[I + 1]) = 172 then
        begin
          str[I] := ',';
          str[I + 1] := ' ';
        end;
      end;
    end;

    str := StringReplace(str, ' ', '', [rfReplaceAll]);
    InitSignParam(); // 清除前面自定义的参数，恢复常数 pi, e

    signP := Pos('@@', str);
    if signP > 0 then
    begin
      signParamStr := midStr(str, signP + 2, Length(str) - signP - 1);
      signParamStr := StringReplace(signParamStr, ' ', '', [rfReplaceAll]);
      AddSignParam(signParamStr);
      str := leftStr(str, signP - 1);
    end;

    if CalcExp(str, f1, infoStr) then
    begin
      nResult := Round(f1);
      sResult := IntToStr(nResult);
    end
    else
    begin
      Npc.ScriptActionError(PlayObject, '表达式输入错误或者超出计算范围！', QuestActionInfo);
      Exit;
      // HZQ 20230410 //解决后面 nResult可能存在未赋值的问题
    end;
  end
  else
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit; // HZQ  20230410 //nResult可能存在未赋值的问题
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, sResult, nResult) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

