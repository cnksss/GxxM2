  if (QuestActionInfo.nParam1 < 0) or (QuestActionInfo.nParam2 < 0) or (QuestActionInfo.nParam3 < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  SmartObject.m_ProtectHPInfo.dwCheckValue := QuestActionInfo.nParam1;
  SmartObject.m_ProtectHPInfo.dwProtectValue := QuestActionInfo.nParam2;
  SmartObject.m_ProtectHPInfo.dwEffectiveTime := QuestActionInfo.nParam3;
  SmartObject.m_ProtectHPInfo.IsPercentage := QuestActionInfo.nParam4 <> 0;
  SmartObject.m_ProtectHPInfo.dwStartTick := MyGetTickCount;

  if SmartObject.m_ProtectHPInfo.IsPercentage then
  begin
    if SmartObject.m_ProtectHPInfo.dwCheckValue > 100 then
      SmartObject.m_ProtectHPInfo.dwCheckValue := 100;

    if SmartObject.m_ProtectHPInfo.dwProtectValue > 100 then
      SmartObject.m_ProtectHPInfo.dwProtectValue := 100;
  end;

  SmartObject.m_ProtectHPInfo.IsOpen := True;
end;

procedure ActionOfEnableUseClientPickItems(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  if BaseObject = nil then
    Exit;
  if (QuestActionInfo.nParam1 < 0) or (QuestActionInfo.nParam1 > 2) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
