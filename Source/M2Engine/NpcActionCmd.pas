procedure ActionOfMission(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Envir: TEnvirnoment;
  SL: TStringList;
  I, nXCount, nYCount: Integer;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  if (Envir <> nil) and (Length(QuestActionInfo.sParam2) > 0) and (Length(QuestActionInfo.sParam3) > 0) then
  begin
    SL := TStringList.Create;
    try
      SL.Delimiter := ';';

      SL.DelimitedText := QuestActionInfo.sParam2;
      nXCount := SL.Count;

      SL.DelimitedText := QuestActionInfo.sParam3;
      nYCount := SL.Count;

      if nXCount <> nYCount then
      begin
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
        Exit;
      end;

      SetLength(g_nMissionPoints, nXCount);

      SL.DelimitedText := QuestActionInfo.sParam2;
      for I := 0 to SL.Count - 1 do
      begin
        g_nMissionPoints[I].X := StrToIntDef(Trim(SL.Strings[I]), 0);
      end;

      SL.DelimitedText := QuestActionInfo.sParam3;
      for I := 0 to SL.Count - 1 do
      begin
        g_nMissionPoints[I].Y := StrToIntDef(Trim(SL.Strings[I]), 0);
      end;

      g_sMissionMap := Envir.sMapName;
    finally
      SL.Free;
    end;
  end
  else
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
end;

procedure ActionOfMobPlace(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  nRandX, nRandY: Integer;
  mon: TBaseObject;
  nX, nY, nCount, nRange: Integer;
begin
  nX := g_nNpcParam1;
  nY := g_nNpcParam2;
  nCount := g_nNpcParam3;
  nRange := g_nNpcParam4;

  for I := 0 to nCount - 1 do
  begin
    nRandX := Random(nRange * 2 + 1) + (nX - nRange);
    nRandY := Random(nRange * 2 + 1) + (nY - nRange);
    mon := UserEngine.RegenMonsterByName(g_sMissionMap, nRandX, nRandY, QuestActionInfo.sParam1);
    if mon <> nil then
    begin
      if Length(g_nMissionPoints) > 0 then
      begin
        mon.m_boMission := True;
        mon.m_nMissionPointIndex := -1;
        SetLength(mon.m_nMissionPoints, Length(g_nMissionPoints));
        Move(g_nMissionPoints[0], mon.m_nMissionPoints[0], Length(g_nMissionPoints) * SizeOf(TPoint));
      end;

      mon.m_sAttackTargetName := QuestActionInfo.sParam2;

      mon.m_btNation := g_nNpcParam5; // GetNationIndex(
      mon.m_boCanAttackSameNationPlayer := g_nNpcParam6 <> 0;
      mon.m_boNoSameNationMonPK := g_nNpcParam7 <> 0;
      mon.m_boAllowSameNationPlayerAttack := g_nNpcParam9 = 0; // 参数9为禁止同国家人物攻击怪物 1:禁止攻击；0:允许攻击

      if g_nNpcParam8 <> 0 then
      begin
        mon.m_boFixedColor := True;
        mon.m_btFixedColor := g_nNpcParam8;
      end;
    end
    else
    begin
      Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
      Break;
    end;
  end;
end;

procedure ActionOfSetMemberType(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
