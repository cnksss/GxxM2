procedure ActionOfGetRandomLineText(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIndex: Integer;
  LoadList: TStringList;
  sVar, sListFileName: string;
  sStr: string;
begin
  sVar := QuestActionInfo.sRawParam2;
  nIndex := StrToIntDef(QuestActionInfo.sParam3, 0);

  if QuestActionInfo.nParam4 = 0 then
    sListFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    sListFileName := QuestActionInfo.sParam1;

  LoadList := TStringList.Create;
  if FileExists(sListFileName) then
  begin
    try
      LoadList.LoadFromFile(sListFileName);
    except
      MainOutMessage('loading fail.... => ' + sListFileName);
    end;
  end
  else
  begin
    MainOutMessage('file not found => ' + sListFileName);
  end;

  if (LoadList.Count > 0) then
  begin
    if nIndex >= 1 then
    begin
      if (nIndex <= LoadList.Count) then
      begin
        if QuestActionInfo.nParam5 = 0 then // 增加反向取行数 By 一支笔 at:2021-06-09 15:17:14
          sStr := LoadList.Strings[nIndex - 1]
        else
          sStr := LoadList.Strings[LoadList.Count - nIndex];
      end;
    end
    else
    begin
      nIndex := Random(LoadList.Count);

      if (nIndex >= 0) and (nIndex < LoadList.Count) then
      begin
        sStr := LoadList.Strings[nIndex];
      end;
    end;
    if (not Npc.SetVarValue(PlayObject, sVar, sStr, StrToIntDef(sStr, 0))) then
      Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
  end;

  LoadList.Free;
end;

procedure ActionOfGetMultiRandomLineText(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIndex, nCount, nReadCount, nIndex1, nIndex2, nTemp: Integer;
  LoadList: TStringList;
  sVarRead, sVarCount, sListFileName, sTemp: string;
  ArrIndex: array of Integer;
  sSetVarName: Char;
  nSetVarIndex: Integer;
begin
  nCount := QuestActionInfo.nParam2;
  sVarRead := QuestActionInfo.sRawParam3;
  sVarCount := QuestActionInfo.sRawParam4;

  if (nCount <= 0) or (sVarRead = '') or (sVarCount = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if not ExtractVar(sVarRead, sSetVarName, nSetVarIndex) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.nParam5 = 0 then
    sListFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    sListFileName := QuestActionInfo.sParam1;

  LoadList := TStringList.Create;
  if FileExists(sListFileName) then
  begin
    try
      LoadList.LoadFromFile(sListFileName);
    except
      MainOutMessage('loading fail.... => ' + sListFileName);
    end;
  end
  else
  begin
    MainOutMessage('file not found => ' + sListFileName);
  end;

  if (LoadList.Count > 0) then
  begin
    nReadCount := LoadList.Count;

    SetLength(ArrIndex, nReadCount);
    for nIndex := 0 to nReadCount - 1 do
    begin
      ArrIndex[nIndex] := nIndex;
    end;

    Randomize;
    for nIndex := 0 to nReadCount * 2 - 1 do
    begin
      nIndex1 := Random(nReadCount);
      nIndex2 := Random(nReadCount);
      nTemp := ArrIndex[nIndex1];
      ArrIndex[nIndex1] := ArrIndex[nIndex2];
      ArrIndex[nIndex2] := nTemp;
    end;

    if nCount > nReadCount then
      nCount := nReadCount;

    for nIndex := 0 to nCount - 1 do
    begin
      sTemp := LoadList.Strings[ArrIndex[nIndex]];

      if (not Npc.SetVarValue(PlayObject, sSetVarName + IntToStr(nSetVarIndex), sTemp, StrToIntDef(sTemp, 0))) then
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);

      Inc(nSetVarIndex);
    end;
  end
  else
  begin
    nCount := 0;
  end;

  if (not Npc.SetVarValue(PlayObject, sVarCount, IntToStr(nCount), nCount)) then
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);

  LoadList.Free;

end;

procedure ActionOfGetCacheRandomLineText(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIndex, nFileIndex: Integer;
  LoadList: TStringList;
  sVar, sFileName: string;
begin
  sVar := QuestActionInfo.sRawParam2;
  nIndex := StrToIntDef(QuestActionInfo.sParam3, 0);

  if QuestActionInfo.nParam4 = 0 then
    sFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    sFileName := QuestActionInfo.sParam1;

  if FileExists(sFileName) then
  begin
    nFileIndex := g_NpcTextFilesCache.IndexOf(sFileName);

    if nFileIndex >= 0 then
      LoadList := TStringList(g_NpcTextFilesCache.Objects[nFileIndex])
    else
    begin
      LoadList := TStringList.Create;
      g_NpcTextFilesCache.AddObject(sFileName, LoadList);
      try
        LoadList.LoadFromFile(sFileName);
      except
        MainOutMessage('loading fail.... => ' + sFileName);
      end;
    end;
  end
  else
  begin
    MainOutMessage('file not found => ' + sFileName);
    Exit;
  end;

  if LoadList.Count > 0 then
  begin
    if nIndex >= 1 then
    begin
      if (nIndex <= LoadList.Count) then
      begin
        if (not Npc.SetVarValue(PlayObject, sVar, LoadList.Strings[nIndex - 1], StrToIntDef(LoadList.Strings[nIndex - 1], 0))) then
          Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
      end;
    end
    else
    begin
      nIndex := Random(LoadList.Count);

      if (nIndex >= 0) and (nIndex < LoadList.Count) //
        and (not Npc.SetVarValue(PlayObject, sVar, LoadList.Strings[nIndex], StrToIntDef(LoadList.Strings[nIndex], 0))) then
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    end;
  end;
end;

procedure ActionOfGetRandomLineTextEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nIndex, nRandom, nRandomCount: Integer;
  TempList, LoadList: TStringList;
  sVar, sListFileName: string;
  SortStringList: TSortStringList;
begin
  sVar := QuestActionInfo.sRawParam2;
  nRandomCount := QuestActionInfo.nParam3;
  if nRandomCount < 0 then
    nRandomCount := 1;

  if QuestActionInfo.nParam4 = 0 then
    sListFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    sListFileName := QuestActionInfo.sParam1;

  LoadList := TStringList.Create;
  if FileExists(sListFileName) then
  begin
    try
      LoadList.LoadFromFile(sListFileName);
    except
      MainOutMessage('loading fail.... => ' + sListFileName);
    end;
  end
  else
  begin
    MainOutMessage('file not found => ' + sListFileName);
  end;

  TempList := TStringList.Create;
  for nIndex := 0 to LoadList.Count - 1 do
  begin
    TempList.Clear;
    ExtractStrings([' '], [], PChar(LoadList.Strings[nIndex]), TempList);
    if TempList.Count > 1 then
    begin
      nRandom := StrToIntDef(TempList.Strings[TempList.Count - 1], -1);
      if nRandom >= 0 then
      begin
        for I := 0 to nRandomCount - 1 do
        begin
          if Random(nRandom) = 0 then
          begin
            if (not Npc.SetVarValue(PlayObject, sVar, TempList.Strings[0], StrToIntDef(TempList.Strings[0], 0))) then
              Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
            TempList.Free;
            LoadList.Free;
            Exit;
          end;
        end;
      end;
    end;
  end;

  SortStringList := TSortStringList.Create;

  for nIndex := 0 to LoadList.Count - 1 do
  begin
    TempList.Clear;
    ExtractStrings([' '], [], PChar(LoadList.Strings[nIndex]), TempList);
    if TempList.Count > 0 then
    begin
      nRandom := StrToIntDef(TempList.Strings[TempList.Count - 1], 0);
      SortStringList.AddObject(IntToStr(nRandom), TObject(nIndex));
    end;
  end;

  SortStringList.NumberSort(False);

  if SortStringList.Count > 0 then
  begin
    nIndex := Integer(SortStringList.Objects[0]);
    TempList.Clear;
    ExtractStrings([' '], [], PChar(LoadList.Strings[nIndex]), TempList);
    if (not Npc.SetVarValue(PlayObject, sVar, TempList.Strings[0], StrToIntDef(TempList.Strings[0], 0))) then
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
  SortStringList.Free;

  LoadList.Free;
  TempList.Free;
end;

procedure ActionOfCreateFile(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nParam1, nFileHandle: Integer;
  sVar, sParam1, sListFileName: string;
  IsBreakParseVar: Boolean;
begin
  if QuestActionInfo.sRawParam2 <> '' then
  begin
    Npc.GetVarValue(PlayObject, QuestActionInfo.sSubParam1, sParam1, nParam1, IsBreakParseVar);
    Npc.GetVarValue(PlayObject, sParam1, sVar, sParam1, nParam1);
  end
  else
  begin
    sParam1 := QuestActionInfo.sParam1;
  end;

  sListFileName := g_Config.sEnvirDir + Npc.m_sPath + sParam1;
  if not DirectoryExists(g_Config.sEnvirDir + Npc.m_sPath) then
  begin
    ForceDirectories(g_Config.sEnvirDir + Npc.m_sPath);
  end;

  if not FileExists(sListFileName) then
  begin
    try
      nFileHandle := FileCreate(sListFileName);
    except
      MainOutMessage('CreateFile fail.... => ' + sListFileName);
      Exit;
    end;

    if nFileHandle > 0 then
    begin
      FileClose(nFileHandle);
    end
    else
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    end;
  end;
end;

procedure ActionOfChangeRangeMonPos(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nX, nY, nRange, nNewX, nNewY: Integer;
  sMonName: string;
  AObject: TBaseObject;
  Envir, NewEnvir: TEnvirnoment;
  BaseObjectList: TList;
begin
  sMonName := QuestActionInfo.sParam1;

  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat2) and (QuestActionInfo.VarInfo2.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam2);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam2);

  nX := QuestActionInfo.nParam3;
  nY := QuestActionInfo.nParam4;
  nRange := QuestActionInfo.nParam5;

  NewEnvir := nil;
  if (not QuestActionInfo.boCompleteFormat6) and (QuestActionInfo.VarInfo6.VarAttr = aFixVar) then
    NewEnvir := g_MapManager.FindMap(QuestActionInfo.sRawParam6);
  if NewEnvir = nil then
    NewEnvir := g_MapManager.FindMap(QuestActionInfo.sParam6);

  nNewX := QuestActionInfo.nParam7;
  nNewY := QuestActionInfo.nParam8;

  if (Envir = nil) or (NewEnvir = nil) or (sMonName = '') or (nX < 0) or (nY < 0) or (nNewX < 0) or (nNewY < 0) or (nRange < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;
  // if Envir = NewEnvir then begin
  BaseObjectList := TList.Create;
  Envir.GetRangeBaseObject(nX, nY, nRange, True, BaseObjectList);
  for I := 0 to BaseObjectList.Count - 1 do
  begin
    AObject := TBaseObject(BaseObjectList.Items[I]);
    if CompareText(AObject.m_sCharName, sMonName) = 0 then
    begin
      AObject.SpaceMove(NewEnvir.sMapName, nNewX, nNewY, 0);
    end;
  end;
  BaseObjectList.Free;
end;

procedure ActionOfRecallMobEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  mon: TBaseObject;
  I, nX, nY, nCount: Integer;
  sMonName: string;
  dwRoyaltySec: LongWord;
  boAutoChangeColor: Boolean;
  nBodyColor: Integer;
begin
  sMonName := QuestActionInfo.sParam1;
  nX := QuestActionInfo.nParam2;
  nY := QuestActionInfo.nParam3;
  nCount := QuestActionInfo.nParam5;
  if QuestActionInfo.nParam6 <= 1 then
    dwRoyaltySec := 10 * 24 * 60 * 60
  else
    dwRoyaltySec := QuestActionInfo.nParam6 * 60;

  boAutoChangeColor := QuestActionInfo.nParam7 = 1;
  nBodyColor := QuestActionInfo.nParam8;

  if (sMonName = '') or (nX < 0) or (nY < 0) or (nCount < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (not (nBodyColor in [0..255])) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if nCount = 0 then
    nCount := 1;

  for I := 0 to nCount - 1 do
  begin
    mon := BaseObject.MakeSlave(sMonName, 3, QuestActionInfo.nParam4, 100, dwRoyaltySec, bb_Other, 0, not g_Config.boBBAttrPlusAddOnlyMagic, nX, nY);
    if mon <> nil then
    begin
      mon.m_boAutoChangeColor := boAutoChangeColor;
      mon.m_nAutoChangeIdx := 0;
      mon.m_dwChangeBodyColorTime := 0;
      mon.m_dwStartChangeBodyColor := MyGetTickCount;

      if not mon.m_boAutoChangeColor then
      begin
        mon.m_btBodyColor := nBodyColor;
      end;
    end;
  end;
end;

