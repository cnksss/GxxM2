      nAbilityValue := AObject.m_WAbil.HP;
    1:
      nAbilityValue := AObject.m_WAbil.MaxHP;
    2:
      nAbilityValue := AObject.m_WAbil.MP;
    3:
      nAbilityValue := AObject.m_WAbil.MaxMP;
    4:
      nAbilityValue := AObject.m_WAbil.AC1;
    5:
      nAbilityValue := AObject.m_WAbil.AC2;
    6:
      nAbilityValue := AObject.m_WAbil.MAC1;
    7:
      nAbilityValue := AObject.m_WAbil.MAC2;
    8:
      nAbilityValue := AObject.m_WAbil.DC1;
    9:
      nAbilityValue := AObject.m_WAbil.DC2;
    10:
      nAbilityValue := AObject.m_WAbil.MC1;
    11:
      nAbilityValue := AObject.m_WAbil.MC2;
    12:
      nAbilityValue := AObject.m_WAbil.SC1;
    13:
      nAbilityValue := AObject.m_WAbil.SC2;
    14:
      nAbilityValue := AObject.m_nNextHitTime;
    15:
      nAbilityValue := AObject.m_nWalkSpeed;
    30:
      nAbilityValue := (MyGetTickCount - AObject.m_ChangeAbility.StartTick) div 1000;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(nAbilityValue), nAbilityValue) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
  end;
