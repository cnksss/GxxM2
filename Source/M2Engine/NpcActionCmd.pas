procedure ActionOfMonGen(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nX, nY: Integer;
  sMapName: string;
  MonObj: TBaseObject;
begin
  if (QuestActionInfo.sParam1 <> '') and (g_sNpcParam1 <> '') and (QuestActionInfo.nParam2 > 0) then
  begin
    if g_sNpcParam1 = 'SELF' then
      sMapName := BaseObject.m_sMapName
    else
      sMapName := g_sNpcParam1;

    for I := 0 to QuestActionInfo.nParam2 - 1 do
    begin
      nX := Random(QuestActionInfo.nParam3 * 2 + 1) + (g_nNpcParam2 - QuestActionInfo.nParam3);
      nY := Random(QuestActionInfo.nParam3 * 2 + 1) + (g_nNpcParam3 - QuestActionInfo.nParam3);
      MonObj := UserEngine.RegenMonsterByName(sMapName, nX, nY, QuestActionInfo.sParam1);
      if MonObj <> nil then
      begin
        MonObj.m_btNation := QuestActionInfo.nParam4; // GetNationIndex(
        MonObj.m_boCanAttackSameNationPlayer := QuestActionInfo.nParam5 <> 0;
        MonObj.m_boNoSameNationMonPK := QuestActionInfo.nParam6 <> 0;
        MonObj.m_boAllowSameNationPlayerAttack := QuestActionInfo.nParam7 <> 0;
      end;
    end;
  end;
end;

