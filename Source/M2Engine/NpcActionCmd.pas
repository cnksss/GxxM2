procedure ActionOfMoney(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMoneyName: string;
  nOldMoney, nCurrMoney, nMoney, n01: Integer;
  cMethod: Char;
begin
  if not BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    Exit;
  sMoneyName := QuestActionInfo.sParam1;
  cMethod := QuestActionInfo.sParam2[1];
  nMoney := QuestActionInfo.nParam3;
  nOldMoney := 0;
  nCurrMoney := nMoney;
  if FindCustomMoney(sMoneyName) = nil then
  begin
    MainOutMessage(Format('用户:[%s]使用不存在的自定义货币[%s]', [PlayObject.m_sCharName, sMoneyName]));
    Exit;
  end;
  n01 := PlayObject.m_MoneyList.GetIndex(UpperCase(sMoneyName));
  if n01 >= 0 then
  begin
    nOldMoney := Integer(PlayObject.m_MoneyList.Objects[n01]);
    case cMethod of
      '=':
        nCurrMoney := nMoney;
      '+':
        nCurrMoney := nOldMoney + nMoney;
      '-':
        nCurrMoney := _MAX(nOldMoney - nMoney, 0);
    end;
    PlayObject.m_MoneyList.Objects[n01] := TObject(nCurrMoney);
  end
  else
  begin
    case cMethod of
      '=':
        PlayObject.m_MoneyList.AddRecord(UpperCase(sMoneyName), nMoney);
      '+':
        PlayObject.m_MoneyList.AddRecord(UpperCase(sMoneyName), nMoney);
    end;
  end;
  if nCurrMoney <> nOldMoney then
    PlayObject.SendDefMessage(SM_MONEY, nCurrMoney, 0, 0, 0, sMoneyName);
end;

