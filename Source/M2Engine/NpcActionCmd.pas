procedure ActionOfTakePosW(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  { I, }
  nPos: Integer;
  // sName: string;
  SmartObject: TSmartObject;
  IsChanged: Boolean;
  StdItem: pTStdItem;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  IsChanged := False;
  nPos := QuestActionInfo.nParam1;
  if (nPos < 0) or (nPos > U_GODBLESSITEM12) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if nPos < U_JEWELRYITEM1 then
  begin
    IsChanged := True;
    if SmartObject.m_UseItems[nPos].wIndex > 0 then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).SendDelItem(@SmartObject.m_UseItems[nPos])
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(SmartObject).SendDelItem(@SmartObject.m_UseItems[nPos]);

      StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[nPos].wIndex);

      if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
      begin
        // 注释日志 chongchong 2017-10-09
        AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, SmartObject.m_UseItems[nPos].MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;

      SmartObject.m_UseItems[nPos].wIndex := 0;
    end;
  end
  else if nPos < U_GODBLESSITEM1 then
  begin
    IsChanged := True;
    if SmartObject.m_JewelryBoxItems[nPos - U_JEWELRYITEM1].wIndex > 0 then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).SendDelItem(@SmartObject.m_JewelryBoxItems[nPos])
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(SmartObject).SendDelItem(@SmartObject.m_JewelryBoxItems[nPos]);

      StdItem := UserEngine.GetStdItem(SmartObject.m_JewelryBoxItems[nPos].wIndex);

      if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
      begin
        // 注释日志 chongchong 2017-10-09
        AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, SmartObject.m_JewelryBoxItems[nPos].MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;

      SmartObject.m_UseItems[nPos].wIndex := 0;
    end;
  end
  else if nPos < U_GODBLESSITEM12 + 1 then
  begin
    IsChanged := True;
    if SmartObject.m_GodBlessItems[nPos - U_GODBLESSITEM1].wIndex > 0 then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).SendDelItem(@SmartObject.m_GodBlessItems[nPos])
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(SmartObject).SendDelItem(@SmartObject.m_GodBlessItems[nPos]);

      StdItem := UserEngine.GetStdItem(SmartObject.m_GodBlessItems[nPos].wIndex);

      if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
      begin
        // 注释日志 chongchong 2017-10-09
        AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, SmartObject.m_GodBlessItems[nPos].MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;

      SmartObject.m_GodBlessItems[nPos].wIndex := 0;
    end;
  end;

  if IsChanged then
  begin
    // SmartObject.m_boRecalcAbilitys := True;
    // SmartObject.m_RecalcAbilitysChanges := [racSubAbility, racFeatureChanged];
    if SmartObject.m_nLockUpdateAbil = 0 then
    begin
      SmartObject.RecalcAbilitys();
      SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
      SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
    end;

    SmartObject.FeatureChanged();
  end;
end;

