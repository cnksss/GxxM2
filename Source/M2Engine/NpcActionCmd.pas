{

  SetClientBuff WIL文件序号  按钮序号  图片序号 倒计时间  文字备注    (开启)
  CloseClientBuff 按钮序号 特殊属性                       (关闭)

  说明:序号为0-20，每10个Buff 显示1行，  图片默认在小地图右面  从右往左一次类推
  每个图片间隔10点像素。时间单位为秒(黄字黑底，位于图片底部2个像素点)
  自动进行倒计，完了执行QFunction对应的 @CloseClientBuffX 请在 X 为Buff序号
  如果参数为-1  就不自动进行倒计，并且可点击触发QFunction-0 里的 [@文字备注] 脚本

  例1     SetClientBuff  0  1  360   255/测试说明啊\251/只是测试啊
}

procedure ActionOfSetClientBuff(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nFileIndex, nTag, nImageIndex, nTime, nX, nY: Integer;
  sHintMsg: string;
  boFind: Boolean;
  ClientBufInfo: PClientBufInfo;
begin
  nFileIndex := QuestActionInfo.nParam1;
  nTag := QuestActionInfo.nParam2;
  nImageIndex := QuestActionInfo.nParam3;
  nTime := QuestActionInfo.nParam4;
  nX := QuestActionInfo.nParam5;
  nY := QuestActionInfo.nParam6;
  sHintMsg := QuestActionInfo.sParam7;

  if (nFileIndex < 0) or (nTag <= 0) or (nTag > 200) or (nTime = 0) or (nTime > 2100000) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  boFind := False;
  PlayObject.m_ClientBufList.LockW(3);
  try
    for I := 0 to PlayObject.m_ClientBufList.Count - 1 do
    begin
      ClientBufInfo := PlayObject.m_ClientBufList[I];
      if ClientBufInfo.ClientBufID = nTag then
      begin
        boFind := True;
        ClientBufInfo.Time := nTime * 1000;
        ClientBufInfo.StartTick := MyGetTickCount;
        Break;
      end;
    end;
  finally
    PlayObject.m_ClientBufList.UnLockW;
  end;

  if (not boFind) and (nTime <> 0) then
  begin
    New(ClientBufInfo);
    ClientBufInfo.ClientBufID := nTag;
    ClientBufInfo.Time := nTime * 1000;
    ClientBufInfo.StartTick := MyGetTickCount;
    PlayObject.m_ClientBufList.LockW(4);
    try
      PlayObject.m_ClientBufList.Add(ClientBufInfo);
    finally
      PlayObject.m_ClientBufList.UnLockW;
    end;
  end;

  PlayObject.SendMsg(PlayObject, RM_SETCLIENTBUFF, nFileIndex, nImageIndex, nTime, nTag, Format('%d,%d|', [nX, nY]) + sHintMsg);
end;

procedure ActionOfCloseClientBuff(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  ClientBufInfo: PClientBufInfo;
begin
  if (QuestActionInfo.nParam1 <= 0) or (QuestActionInfo.nParam1 > 200) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  PlayObject.m_ClientBufList.LockW(5);
  try
    for I := PlayObject.m_ClientBufList.Count - 1 downto 0 do
    begin
      ClientBufInfo := PlayObject.m_ClientBufList[I];
      if ClientBufInfo.ClientBufID = QuestActionInfo.nParam1 then
      begin
        Dispose(ClientBufInfo);
        PlayObject.m_ClientBufList.Delete(I);
        Break;
      end;
    end;
  finally
    PlayObject.m_ClientBufList.UnLockW;
  end;

  PlayObject.SendMsg(PlayObject, RM_CLOSECLIENTBUFF, 0, QuestActionInfo.nParam1, 0, 0, '');
end;

procedure ActionOfShowClientBuff(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
