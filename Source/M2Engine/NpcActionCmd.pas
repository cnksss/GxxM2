// 创建副本地图 chongchong 2013-09-06

procedure ActionOfCreateEctype(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sFBName: string;
  FBList: TList;
  nIdx, I, K: Integer;
  dwTime: LongWord;
  Envir: TEnvirnoment;
  MonGen: pTMonGenInfo;
  mon: TBaseObject;
  IsEnterGroupFB: Boolean;
  IsEnterGuildFB: Boolean;
  GuildMaster1, GuildMaster2: TPlayObject;

  function CanEnterToMap(Map: TEnvirnoment): Boolean;
  begin
    // 在延时时间内进入
    if MyGetTickCount - Map.m_dwFBCreateTime <= 60000 + Map.m_dwFBEnterDelayMin then
    begin
      Result := True;
      Npc.GotoLable(PlayObject, '@CreateEctype_IN', False);
    end // 超过延时进入时间
    else
    begin
      Result := False;
      Npc.GotoLable(PlayObject, '@CreateEctype_IN_Time', False);
    end;
  end;

begin
  sFBName := QuestActionInfo.sParam1;
  dwTime := StrToIntDef(QuestActionInfo.sParam2, 0);
  if (sFBName = '') or (dwTime = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  Envir := nil;
  nIdx := g_FBMapManager.IndexOf(sFBName);
  if nIdx <> -1 then
  begin
    FBList := TList(g_FBMapManager.Objects[nIdx]);
    if FBList.Count > 0 then
      Envir := FBList[0];
  end;

  if Envir = nil then
  begin
    Npc.ScriptActionError(PlayObject, '副本不存在', QuestActionInfo);
    Npc.GotoLable(PlayObject, '@CreateEctype_NoExists', False);
    Exit;
  end;

  if (PlayObject.m_FBEnvir <> nil) and (PlayObject.m_FBEnvir.m_boFBCreate) and (PlayObject.m_dwFBCreateTime = PlayObject.m_FBEnvir.m_dwFBCreateTime) and SameText(sFBName, PlayObject.m_FBEnvir.m_sFBName) then
  begin
    CanEnterToMap(PlayObject.m_FBEnvir);
    Exit;
  end;

  if Envir.m_FBEnterLimit in [fbel_JOB3, fbel_Group] then
  begin
    IsEnterGroupFB := (PlayObject.m_GroupOwner <> nil) and (TPlayObject(PlayObject.m_GroupOwner).m_FBEnvir <> nil) and (TPlayObject(PlayObject.m_GroupOwner).m_FBEnvir.m_boFBCreate) and SameText(sFBName, TPlayObject(PlayObject.m_GroupOwner).m_FBEnvir.m_sFBName);

    if IsEnterGroupFB then
    begin
      CanEnterToMap(TPlayObject(PlayObject.m_GroupOwner).m_FBEnvir);
      Exit;
    end;
  end
  else if Envir.m_FBEnterLimit = fbel_Guild then
  begin
    IsEnterGuildFB := False;
    if PlayObject.m_MyGuild <> nil then
    begin
      TGUild(PlayObject.m_MyGuild).GetGuildMaster(GuildMaster1, GuildMaster2);

      if GuildMaster1 <> nil then
      begin
        IsEnterGuildFB := (GuildMaster1.m_FBEnvir <> nil) and (GuildMaster1.m_FBEnvir.m_boFBCreate) and SameText(sFBName, GuildMaster1.m_FBEnvir.m_sFBName);

        if IsEnterGuildFB then
        begin
          CanEnterToMap(GuildMaster1.m_FBEnvir);
          Exit;
        end;
      end;

      if (not IsEnterGuildFB) and (GuildMaster2 <> nil) then
      begin
        IsEnterGuildFB := (GuildMaster2.m_FBEnvir <> nil) and (GuildMaster2.m_FBEnvir.m_boFBCreate) and SameText(sFBName, GuildMaster2.m_FBEnvir.m_sFBName);

        if IsEnterGuildFB then
        begin
          CanEnterToMap(GuildMaster2.m_FBEnvir);
          Exit;
        end;
      end;
    end;
  end;

  if Envir.m_FBEnterLimit in [fbel_JOB3, fbel_Group] then
  begin
    // 必须队长才能创建副本地图
    if PlayObject.m_GroupOwner <> PlayObject then
    begin
      Npc.GotoLable(PlayObject, '@CreateEctype_Fail_GroupMaster', False);
      Exit;
    end;
  end
  else if Envir.m_FBEnterLimit = fbel_Guild then
  begin
    // 必须行会掌门人才能创建副本地图
    if not PlayObject.IsGuildMaster then
    begin
      Npc.GotoLable(PlayObject, '@CreateEctype_Fail_GuildMaster', False);
      Exit;
    end;
  end;

  FBList := TList(g_FBMapManager.Objects[nIdx]);
  for I := 0 to FBList.Count - 1 do
  begin
    Envir := FBList[I];
    if (Envir.m_dwFBPlayObjectCount <= 0) and (not Envir.m_boFBCreate) then
    begin
      Inc(Envir.m_btFBIndex);
      Envir.m_boFBCreate := True;
      Envir.m_boFBPlayObjectEnter := False;
      Envir.m_dwFBTime := MyGetTickCount + dwTime * 60 * 1000;
      Envir.m_FBMasterObject := PlayObject;
      Envir.m_dwFBCreateTime := MyGetTickCount;
      Envir.m_dwFBFailTime := 0;
      Envir.m_boFBFail := False;
      PlayObject.m_FBEnvir := Envir;
      PlayObject.m_dwFBCreateTime := Envir.m_dwFBCreateTime;

      (* 原来的逻辑
        // 先调用副本创建成功的脚本，在副本创建成功的脚本中清怪，清地图事件
        NPC.GotoLable(PlayObject, '@CreateEctype_OK', False);
        {
        [@CreateEctype_OK]
        #IF
        #ACT
        CLEARECTYPEMON FBMAP
        CLEARMACHINERYEVENT FBMAP
        SENDMSG 5  副本地图创建成功，并初始化地图怪物成功
        SENDMSG 5  副本地图创建成功，并初始化地图事件成功。
        }
      *)
      // 清理副本地图的怪
      for K := 0 to Envir.m_FBMonsterList.Count - 1 do
      begin
        mon := TBaseObject(Envir.m_FBMonsterList.Items[K]);
        if (not mon.m_boGhost) and (mon.m_Master = nil) then
          mon.MakeGhost;
      end;
      Envir.m_FBMonsterList.Clear;

      // 创建地图怪物 (重新刷怪)
      for K := 0 to Envir.m_FBMonGenList.Count - 1 do
      begin
        MonGen := Envir.m_FBMonGenList[K];
        UserEngine.RegenMonsters(MonGen, MonGen.nCount);
      end;

      Npc.GotoLable(PlayObject, '@CreateEctype_OK', False);

      Exit;
    end;
  end;
  Npc.GotoLable(PlayObject, '@CreateEctype_Fail', False); // 副本创建失败
end;

// 传送到指定副本地图的某坐标 chongchong 2013-09-06

procedure ActionOfMoveEctype(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nX, nY: Integer;
  Envir: TEnvirnoment;
  sFBName: string;
  nIdx: Integer;
  IsEnterGroupFB: Boolean;
  IsEnterGuildFB: Boolean;
  FBList: TList;
  GuildMaster1, GuildMaster2: TPlayObject;

  procedure DoEnterToMap(Map: TEnvirnoment);
  begin
    // 在延时时间内进入
    if MyGetTickCount - Map.m_dwFBCreateTime <= 60000 + Map.m_dwFBEnterDelayMin then
    begin
      if PlayObject.EnterAnotherMap(Map, nX, nY) then
      begin
        PlayObject.m_FBEnvir := Map;
        Map.m_boFBPlayObjectEnter := True;
        PlayObject.m_dwFBCreateTime := Map.m_dwFBCreateTime;
        Npc.GotoLable(PlayObject, '@MoveEctype_OK', False);
      end
      else
        Npc.GotoLable(PlayObject, '@MoveEctype_Fail', False);
    end
    // 超过延时进入时间
    else
    begin
      Npc.GotoLable(PlayObject, '@MoveEctype_Fail_Time', False);
    end;
  end;

begin
  sFBName := QuestActionInfo.sParam1;
  nX := StrToIntDef(QuestActionInfo.sParam2, -1);
  nY := StrToIntDef(QuestActionInfo.sParam3, -1);
  if (nX < 0) or (nY < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  Envir := nil;
  nIdx := g_FBMapManager.IndexOf(sFBName);
  if nIdx <> -1 then
  begin
    FBList := TList(g_FBMapManager.Objects[nIdx]);
    if FBList.Count > 0 then
      Envir := FBList[0];
  end;

  if Envir = nil then
    Exit;

  if ((PlayObject.m_FBEnvir <> nil) and (PlayObject.m_FBEnvir.m_boFBCreate) and (PlayObject.m_dwFBCreateTime = PlayObject.m_FBEnvir.m_dwFBCreateTime) and SameText(sFBName, PlayObject.m_FBEnvir.m_sFBName)) then
  begin
    DoEnterToMap(PlayObject.m_FBEnvir);
    Exit;
  end;

  if Envir.m_FBEnterLimit in [fbel_JOB3, fbel_Group] then
  begin
    IsEnterGroupFB := (PlayObject.m_GroupOwner <> nil) and (TPlayObject(PlayObject.m_GroupOwner).m_FBEnvir <> nil) and (TPlayObject(PlayObject.m_GroupOwner).m_FBEnvir.m_boFBCreate) and SameText(sFBName, TPlayObject(PlayObject.m_GroupOwner).m_FBEnvir.m_sFBName);

    if IsEnterGroupFB then
    begin
      DoEnterToMap(TPlayObject(PlayObject.m_GroupOwner).m_FBEnvir);
      Exit;
    end;
  end
  else if Envir.m_FBEnterLimit = fbel_Guild then
  begin
    IsEnterGuildFB := False;
    if PlayObject.m_MyGuild <> nil then
    begin
      TGUild(PlayObject.m_MyGuild).GetGuildMaster(GuildMaster1, GuildMaster2);

      if GuildMaster1 <> nil then
      begin
        IsEnterGuildFB := (GuildMaster1.m_FBEnvir <> nil) and (GuildMaster1.m_FBEnvir.m_boFBCreate) and SameText(sFBName, GuildMaster1.m_FBEnvir.m_sFBName);

        if IsEnterGuildFB then
        begin
          DoEnterToMap(GuildMaster1.m_FBEnvir);
          Exit;
        end;
      end;

      if (not IsEnterGuildFB) and (GuildMaster2 <> nil) then
      begin
        IsEnterGuildFB := (GuildMaster2.m_FBEnvir <> nil) and (GuildMaster2.m_FBEnvir.m_boFBCreate) and SameText(sFBName, GuildMaster2.m_FBEnvir.m_sFBName);

        if IsEnterGuildFB then
        begin
          DoEnterToMap(GuildMaster2.m_FBEnvir);
          Exit;
        end;
      end;
    end;
  end;

  Npc.GotoLable(PlayObject, '@MoveEctype_Fail', False);
end;

// 副本地图组队传送 chongchong 2013-09-11

procedure ActionOfMoveGroupEctype(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nX, nY: Integer;
  Envir, EnterMap: TEnvirnoment;
  sFBName: string;
  I, nIdx: Integer;
  FBList: TList;
  IsRadomMove: Boolean;
  GroupObject: TPlayObject;
begin
  sFBName := QuestActionInfo.sParam1;
  nX := StrToIntDef(QuestActionInfo.sParam2, -1);
  nY := StrToIntDef(QuestActionInfo.sParam3, -1);

  IsRadomMove := (nX < 0) or (nY < 0);

  Envir := nil;
  nIdx := g_FBMapManager.IndexOf(sFBName);
  if nIdx <> -1 then
  begin
    FBList := TList(g_FBMapManager.Objects[nIdx]);
    if FBList.Count > 0 then
      Envir := FBList[0];
  end;

  // 地图不允许组队传送
  if (Envir = nil) or (not (Envir.m_FBEnterLimit in [fbel_JOB3, fbel_Group])) then
  begin
    Npc.GotoLable(PlayObject, '@MoveEctype_Fail', False);
    Exit;
  end;

  // 只有队长才能传送
  if PlayObject.m_GroupOwner <> PlayObject then
  begin
    Npc.GotoLable(PlayObject, '@MoveEctype_Fail', False);
    Exit;
  end;

  if ((PlayObject.m_FBEnvir <> nil) and (PlayObject.m_FBEnvir.m_boFBCreate) and (PlayObject.m_dwFBCreateTime = PlayObject.m_FBEnvir.m_dwFBCreateTime) and SameText(sFBName, PlayObject.m_FBEnvir.m_sFBName)) then
  begin
    EnterMap := PlayObject.m_FBEnvir;
    if MyGetTickCount - EnterMap.m_dwFBCreateTime > 60000 + EnterMap.m_dwFBEnterDelayMin then
      Npc.GotoLable(PlayObject, '@MoveEctype_Fail_Time', False)
    else
    begin
{$IF MULTI_THREAD = 1}
      if g_MultiThreadRun then
        PlayObject.m_GroupMembers.LockR(22);
      try
{$IFEND}
        for I := 0 to PlayObject.m_GroupMembers.Count - 1 do
        begin
          GroupObject := TPlayObject(PlayObject.m_GroupMembers.Objects[I]);

          if (not GroupObject.m_boDeath) and (not GroupObject.m_boGhost) then
          begin
            if (not GroupObject.m_boDummyObject) or (CanDummyMoveMap(EnterMap.sMapName)) then
            begin
              GroupObject.SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');

              if IsRadomMove then
                GroupObject.MapRandomMove(EnterMap.sMapName, 0)
              else
                GroupObject.SpaceMove(EnterMap.sMapName, nX, nY, 0);

              GroupObject.m_FBEnvir := EnterMap;
              GroupObject.m_dwFBCreateTime := EnterMap.m_dwFBCreateTime;
            end;
          end;
        end;
{$IF MULTI_THREAD = 1}
      finally
        if g_MultiThreadRun then
          PlayObject.m_GroupMembers.UnLockR;
      end;
{$IFEND}
    end;
  end;
  Npc.GotoLable(PlayObject, '@MoveEctype_Fail', False);
end;

