                      I64 := AObject.m_ChangeAbility.HP - nAbilityValue;
                      if I64 < Low(LongWord) then
                        I64 := Low(LongWord);

                      AObject.m_ChangeAbility.HP := I64;
                      AObject.m_ChangeAbility.boHPPercentage := IsPercentage;
                    end;
                  1:
