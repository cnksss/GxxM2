procedure ActionOfTakeKimneedle(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  nCount: Integer;
  sName: string;
begin
  // PlayObject.m_boCanQueryBag := True;                                                               //NPC操作物品时,不能刷新包裹
  try
    sName := QuestActionInfo.sParam1;
    nCount := QuestActionInfo.nParam2;
    if sName = '' then
      Exit;
    if nCount <= 0 then
      Exit;
    try
      for I := PlayObject.m_ItemList.Count - 1 downto 0 do
      begin
        if nCount <= 0 then
          Break;
        if PlayObject.m_ItemList.Count <= 0 then
          Break; // 20080917
        UserItem := PlayObject.m_ItemList.Items[I];
        if UserItem = nil then
          Continue;
        if CompareText(UserEngine.GetStdItemName(UserItem.wIndex), sName) = 0 then
        begin
          StdItem := UserEngine.GetStdItem(UserItem.wIndex);
          if StdItem <> nil then
          begin // 20081006 修改
            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            PlayObject.m_ItemList.Delete(I);
            PlayObject.SendDelItem(UserItem);
            // SC := StdItem.Name{UserEngine.GetStdItemName(UserItem.wIndex)};
            DisPoseAndNil(UserItem);
            Dec(nCount);
          end; // if StdItem <> nil
        end;
      end;
    except
      MainOutMessage('{异常} TakeKimneedle');
    end;
  finally
    // PlayObject.m_boCanQueryBag := False;                                                            // NPC操作物品时,不能刷新包裹
  end;
end;

