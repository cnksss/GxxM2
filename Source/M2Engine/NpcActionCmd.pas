procedure ActionOfChangeDateTime(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  pTime: TDateTime;
  sTime: string;
begin
  if not TryStrToDateTime(QuestActionInfo.sParam1, pTime) then
  begin
    MainOutMessage('[注意]GetInterval命令收到了错误的时间格式');
    Exit;
  end;

  case QuestActionInfo.nParam2 of
    0:
      pTime := IncYear(pTime, QuestActionInfo.nParam3);
    1:
      pTime := IncMonth(pTime, QuestActionInfo.nParam3);
    2:
      pTime := IncWeek(pTime, QuestActionInfo.nParam3);
    3:
      pTime := IncDay(pTime, QuestActionInfo.nParam3);
    4:
      pTime := IncHour(pTime, QuestActionInfo.nParam3);
    5:
      pTime := IncMinute(pTime, QuestActionInfo.nParam3);
    6:
      pTime := IncSecond(pTime, QuestActionInfo.nParam3);
  end;

  sTime := FormatDateTime('yyyy/mm/dd,dddd,hh:nn:ss', pTime);

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, sTime, 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
end;

procedure ActionOfPrintUseTime(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
{$J+}
const
  TickValue: Cardinal = 0;
{$J-}
var
  tmpTick: Cardinal;
begin
  if not (QuestActionInfo.nParam1 in [1, 2]) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  case QuestActionInfo.nParam1 of
    1:
      TickValue := GetTickCount;
    2:
      begin
        tmpTick := tick_diff(TickValue, GetTickCount);

        if not QuestActionInfo.sRawParam2.IsEmpty then
        begin
          if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(tmpTick), tmpTick) then
            Npc.ScriptActionError(PlayObject, '变量保存错误', QuestActionInfo);
        end
        else
          PlayObject.SysMsg(Format('两次计时间隔:%d 毫秒.', [tmpTick]), c_Green, t_Hint);
      end;
  end;
end;

