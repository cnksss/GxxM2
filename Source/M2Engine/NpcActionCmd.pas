procedure ActionOfChangeSpeed(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nType: Integer;
  nValue: Integer;
  nSpeed: Integer;
  nTime: Integer;
  // ChangeSpeed 速度类型 速度值
  // 速度类型 1为 移动速度 2为攻击速度 3为魔法速度
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nType := QuestActionInfo.nParam1;
  nValue := QuestActionInfo.nParam2;
  nTime := QuestActionInfo.nParam3;
  if (not (nType in [1..3])) or (nValue < -1000) or (nValue > 1000) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  {
    if nType in [1, 3] then
    begin
    Npc.ScriptActionError(BaseObject, '不支持移动速度及魔法速度调整', QuestActionInfo);
    Exit;
    end;
  }

  if nTime < 0 then
    nTime := 0;

  if nTime > 0 then
    SmartObject.m_ChangeSpeedTimeTick[nType - 1] := MyGetTickCount + LongWord(nTime) * 1000
  else
    SmartObject.m_ChangeSpeedTimeTick[nType - 1] := High(DWORD);

  case nType of
    1:
      begin
        nSpeed := SmartObject.m_nMoveSpeed;
        SmartObject.m_nMoveSpeed := nValue;
        if nSpeed <> SmartObject.m_nMoveSpeed then
        begin
          SmartObject.RefGameSpeed;
          RecalcPlayCombatPower(SmartObject);
        end;
      end;
    2:
      begin
        {
          nSpeed := SmartObject.m_nAttackSpeed;
          SmartObject.m_nAttackSpeed := nValue;
          if nSpeed <> SmartObject.m_nAttackSpeed then
          SmartObject.RefGameSpeed;
        }
        // nSpeed := SmartObject.m_nAttackSpeed;
        SmartObject.m_nNpcAttackSpeed := nValue;
        SmartObject.RecalcAbilitys;
      end;
    3:
      begin
        nSpeed := SmartObject.m_nSpellSpeed;
        SmartObject.m_nSpellSpeed := nValue;
        if nSpeed <> SmartObject.m_nSpellSpeed then
        begin
          SmartObject.RefGameSpeed;
          RecalcPlayCombatPower(SmartObject);
        end;
      end;
  end;
end;

