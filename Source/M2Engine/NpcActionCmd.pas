  end;
end;

procedure ActionOfAddMirrorMap(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
label
  DoExit;
var
  S1, s2, sMapName, sMapDesc, ExitToMap, sVarName: string;
  N1, N2, dwSurvivalTime, MirrorMinMap: Integer;
  Envir, tmpEnvir, MirrorEnvir, ExitEnvir: TEnvirnoment;
  IsBreakParseVar: Boolean;
  Index: Integer;
begin
  sMapName := QuestActionInfo.sParam2;
  sMapDesc := QuestActionInfo.sParam3;
  dwSurvivalTime := QuestActionInfo.nParam4;
  ExitToMap := QuestActionInfo.sParam5;
  MirrorMinMap := QuestActionInfo.nParam6;
  sVarName := QuestActionInfo.sRawParam7;

  if Length(sVarName) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '参数7：变量不能为空', QuestActionInfo);
    Exit;
  end;

  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
  begin
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
    if Envir = nil then
    begin
      S1 := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, S1, N1, IsBreakParseVar);
      if Length(S1) > 0 then
        Envir := g_MapManager.FindMap(S1);
    end;
  end;

  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  if Envir = nil then
  begin
    Npc.ScriptActionError(PlayObject, '原地图不存在', QuestActionInfo);
    goto DoExit;
  end;

  if Envir.m_boFB then
  begin
    Npc.ScriptActionError(PlayObject, '原地图不能为副本地图', QuestActionInfo);
    goto DoExit;
  end;

  if Envir.m_boMirror then
  begin
    Npc.ScriptActionError(PlayObject, '原地图不能为镜像地图', QuestActionInfo);
    goto DoExit;
  end;

  {
    增加(tmpEnvir.m_dwMirrorSurvivalTime > 0)条件。
    避免删除地图不及时，导致此处判断地图是否存在时，地图存在，
    但进入镜像地图时地图被TUserEngine.ProcessMirrorMap加入到g_GhostMapManager.Add(Envir)后，被删除的时序BUG
    Cursor 2023-08-21 17:25:17
  }
  tmpEnvir := g_MapManager.FindMap(sMapName);
  if (tmpEnvir <> nil) and (tmpEnvir.m_dwMirrorSurvivalTime > 0) then
  begin
    goto DoExit;
  end;

  if dwSurvivalTime <= 0 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    goto DoExit;
  end;

  if g_MapManager.FindMap(ExitToMap) = nil then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    goto DoExit;
  end;

  ExitEnvir := g_MapManager.FindMap(ExitToMap);
  if (ExitEnvir = nil) or (ExitEnvir.m_boMirror) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    goto DoExit;
  end;

  N1 := 0;
  N2 := 0;

  Index := Pos(',', QuestActionInfo.sParam9);
  if Index > 0 then
  begin
    S1 := Copy(QuestActionInfo.sParam9, 1, Index - 1);
    s2 := Copy(QuestActionInfo.sParam9, Index + 1, MaxInt);
    if not (TryStrToInt(S1, N1) and TryStrToInt(s2, N2)) then
    begin
      N1 := 0;
      N2 := 0;
    end;
  end;

  if (N1 <> 0) or (N2 <> 0) then
  begin
    if not ExitEnvir.CanWalk(N1, N2, True) then
    begin
      Npc.ScriptActionError(BaseObject, '参数9：坐标不可达', QuestActionInfo);
      Exit;
    end;
  end;

  MirrorEnvir := g_MapManager.AddMapInfo(sMapName, Envir.sMapName, sMapDesc, Envir.nServerIndex, @Envir.FMapFlag, Envir.QuestNPC);
  if MirrorEnvir <> nil then
  begin
    MirrorEnvir.m_dwMirrorCreateTick := MyGetTickCount;
    MirrorEnvir.m_boMirror := True;
    MirrorEnvir.m_dwMirrorSurvivalTime := dwSurvivalTime;
    MirrorEnvir.m_sMirrorExitToMap := ExitToMap;
    MirrorEnvir.m_nMirrorMinMap := MirrorMinMap;
    MirrorEnvir.m_boAlwaysShowTime := QuestActionInfo.nParam8 > 0;

    MirrorEnvir.m_MirrorExitMapPostion.X := N1;
    MirrorEnvir.m_MirrorExitMapPostion.Y := N2;

    if (not Npc.SetVarValue(PlayObject, sVarName, '1', 1)) then
      Npc.ScriptActionError(BaseObject, '', QuestActionInfo);

    Exit;
  end;

DoExit:
  if (not Npc.SetVarValue(PlayObject, sVarName, '0', 0)) then
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
end;

procedure ActionOfDelMirrorMap(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  S1: string;
  N1: Integer;
  Envir: TEnvirnoment;
  IsBreakParseVar: Boolean;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
  begin
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
    if Envir = nil then
    begin
      S1 := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, S1, N1, IsBreakParseVar);
      if Length(S1) > 0 then
        Envir := g_MapManager.FindMap(S1);
    end;
  end;

  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

