function GetBoxLockUpdateIndex(nIndex: Integer): Integer;
begin
  Result := U_GODBLESSITEM12 + 1 + nIndex;
end;

function GetUpgradeLockUpdateIndex: Integer;
begin
  Result := U_GODBLESSITEM12 + 1 + High(THumanItemBoxItems) + 1;
end;

function JmpToLable(Npc: TNormNpc; PlayObject: TPlayObject; sLabel: string; CustomMaxCount: Integer = 0): Boolean;
begin
  Result := False;
  Inc(PlayObject.m_nScriptGotoCount);

  if CustomMaxCount = 0 then
  begin
    if PlayObject.m_nScriptGotoCount > g_Config.nLimitScriptGotoCount { 10 } then
      Exit;
  end
  else if PlayObject.m_nScriptGotoCount > CustomMaxCount { 10 } then
    Exit;

  Npc.GotoLable(PlayObject, sLabel, False);
  Result := True;
end;

procedure AddList(sHumName, sListFileName: string); // 0049B620
var
  I: Integer;
  LoadList: TStringList;
  s10: string;
  bo15: Boolean;
begin
  sListFileName := g_Config.sEnvirDir + sListFileName;
  LoadList := TStringList.Create;
  if FileExists(sListFileName) then
  begin
    try
      LoadList.LoadFromFile(sListFileName);
    except
      MainOutMessage('读取失败 => ' + sListFileName);
    end;
  end;

  bo15 := False;
  for I := 0 to LoadList.Count - 1 do
  begin
    s10 := Trim(LoadList.Strings[I]);
    if CompareText(sHumName, s10) = 0 then
    begin
      bo15 := True;
      Break;
    end;
  end;

  if not bo15 then
  begin
    LoadList.Add(sHumName);
    try
      // 修正保存时没有路径保存不会创建目录报错 chongchong 2014-10-31
      s10 := ExtractFileDir(sListFileName);
      if not DirectoryExists(s10) then
        ForceDirectories(s10);

      LoadList.SaveToFile(sListFileName);
    except
      MainOutMessage('保存失败 => ' + sListFileName);
    end;
  end;
  LoadList.Free;
end;

procedure DelList(sHumName, sListFileName: string); // 0049B7F8
var
  I: Integer;
  LoadList: TStringList;
  s10: string;
  bo15: Boolean;
begin
  sListFileName := g_Config.sEnvirDir + sListFileName;
  LoadList := TStringList.Create;
  if FileExists(sListFileName) then
  begin
    try
      LoadList.LoadFromFile(sListFileName);
    except
      MainOutMessage('读取失败 => ' + sListFileName);
    end;
  end
  else
    MainOutMessage('文件不存在 => ' + sListFileName);

  bo15 := False;
  for I := 0 to LoadList.Count - 1 do
  begin
    if LoadList.Count <= 0 then
      Break;

    s10 := Trim(LoadList.Strings[I]);
    if CompareText(sHumName, s10) = 0 then
    begin
      LoadList.Delete(I);
      bo15 := True;
      Break;
    end;
  end;

  if bo15 then
  begin
    try
      LoadList.SaveToFile(sListFileName);
    except
      MainOutMessage('保存失败 => ' + sListFileName);
    end;
  end;
  LoadList.Free;
end;

procedure ActionOfSet(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  if (QuestActionInfo.nParam1 >= 0) and (QuestActionInfo.nParam2 >= 0) then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
      TPlayObject(BaseObject).SetQuestFlagStatus(QuestActionInfo.nParam1, QuestActionInfo.nParam2)
    else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
      THeroObject(BaseObject).SetQuestFlagStatus(QuestActionInfo.nParam1, QuestActionInfo.nParam2)
  end;
end;

procedure ActionOfTakeItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, J: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  nItemCount: Integer;
  sItemName, sUseItemName: string;
  boFoundInOK, boFoundHeroM2Shop: Boolean;
  Player: TPlayObject;
  HeroM2ShopItemInfo: pTHeroM2ShopItemInfo;
  OldGold: LongWord;
  IsFullName, IsOK: Boolean;
  OldDura: Word;
begin
  sItemName := QuestActionInfo.sParam1;
  nItemCount := QuestActionInfo.nParam2;
  IsFullName := QuestActionInfo.nParam4 = 0;

  if nItemCount <= 0 then
    nItemCount := 1;

  if CompareText(sItemName, sSTRING_GOLDNAME) = 0 then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      OldGold := TPlayObject(BaseObject).m_nGold;
      TPlayObject(BaseObject).DecGold(nItemCount);
      TPlayObject(BaseObject).GoldChanged();
      if g_boGameLogGold then
      begin
        // 注释日志 chongchong 2017-10-09
        AddGameDataLog(LOG_ItemNpcRecycle, LOG_GoldChange, BaseObject, sSTRING_GOLDNAME, nItemCount, Npc.m_sCharName, TPlayObject(BaseObject).m_nGold, OldGold, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;
    end;
    Exit;
  end;

  for I := BaseObject.m_ItemList.Count - 1 downto 0 do
  begin
    if nItemCount <= 0 then
      Break;
    UserItem := BaseObject.m_ItemList.Items[I];

    // 不回收摆摊中的装备 chongchong 2015-05-02
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      Player := TPlayObject(BaseObject);

      boFoundHeroM2Shop := False;
      for J := 0 to Player.m_HeroM2ShopList.Count - 1 do
      begin
        HeroM2ShopItemInfo := Player.m_HeroM2ShopList.Items[J];
        if HeroM2ShopItemInfo.nMakeIndex = UserItem.MakeIndex then
        begin
          boFoundHeroM2Shop := True;
          Break;
        end;
      end;

      if boFoundHeroM2Shop then
        Continue;
    end;

    sUseItemName := UserEngine.GetStdItemName(UserItem.wIndex);

    if QuestActionInfo.nParam3 > 0 then
    begin
      if (UserItem.btValue[13] = 1) and (Length(UserItem.Name) > 0) then
        sUseItemName := UserItem.Name;
    end;

    if IsFullName then
      IsOK := SameText(sUseItemName, sItemName)
    else
      IsOK := Pos(sItemName, sUseItemName) > 0;

    if IsOK then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      boFoundInOK := False;
      if CheckOverLapItem(StdItem) then
      begin // 重叠物品
        // MainOutMessage('1 take StdItem:'+StdItem.Name+' nItemCount '+IntToStr(nItemCount));
        if nItemCount >= (UserItem.Dura + 1) then
        begin
          // MainOutMessage('2 take StdItem:'+StdItem.Name+' nItemCount '+IntToStr(nItemCount));
          nItemCount := nItemCount - (UserItem.Dura + 1);
          if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
          begin
            TPlayObject(BaseObject).SendDelItem(UserItem);
            for J := Low(TPlayObject(BaseObject).m_ItemBoxItems) to High(TPlayObject(BaseObject).m_ItemBoxItems) do
            begin
              if TPlayObject(BaseObject).m_ItemBoxItems[J] = UserItem.MakeIndex then
              begin
                {
                  if StdItem.NeedIdentify = 1 then
                  begin
                  // 注释日志 chongchong 2017-10-09
                  AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, BaseObject.m_sMapName, BaseObject.m_nCurrX, BaseObject.m_nCurrY, sItemName, UserItem.MakeIndex, BaseObject.m_sCharName, , 0, 0, );
                  end;
                }
                TPlayObject(BaseObject).DelBoxItem(J, Npc.m_sCharName, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
                boFoundInOK := True;
                Break;
              end;
            end;
          end
          else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(BaseObject).SendDelItem(UserItem);

          if not boFoundInOK then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, BaseObject, sItemName, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            // 回收了物品，清掉升级框 chongchong 2018-05-16
            if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and (TPlayObject(BaseObject).m_UpgradeItem = UserItem) then
            begin
              TPlayObject(BaseObject).m_UpgradeItem := nil;
              TPlayObject(BaseObject).m_UpgradeItemIsPegBag := False;
            end
            else if (BaseObject.m_btRaceServer = RC_HEROOBJECT) and (THeroObject(BaseObject).m_LinkItem = UserItem) then
              THeroObject(BaseObject).m_LinkItem := nil;

            BaseObject.m_ItemList.Delete(I);
            Dispose(UserItem);
          end;
          Continue;
        end
        else
        begin
          OldDura := UserItem.Dura;
          if UserItem.Dura > 0 then
            UserItem.Dura := Max(UserItem.Dura - nItemCount, 0);

          if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(BaseObject).SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura)
          else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(BaseObject).SendUpdateItemDura(-1, UserItem.MakeIndex, UserItem.Dura);

          if StdItem.NeedIdentify = 1 then
          begin
            // 注释日志 chongchong 2017-10-09
            AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, BaseObject, sItemName, UserItem.MakeIndex, Npc.m_sCharName, UserItem.Dura + 1, OldDura + 1, Format('减叠加;[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
          end;

          Break;
        end;
      end
      else
      begin
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          TPlayObject(BaseObject).SendDelItem(UserItem);

          for J := Low(TPlayObject(BaseObject).m_ItemBoxItems) to High(TPlayObject(BaseObject).m_ItemBoxItems) do
          begin
            if TPlayObject(BaseObject).m_ItemBoxItems[J] = UserItem.MakeIndex then
            begin
              {
                if StdItem.NeedIdentify = 1 then
                begin
                // 注释日志 chongchong 2017-10-09
                AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, BaseObject.m_sMapName, BaseObject.m_nCurrX, BaseObject.m_nCurrY, sItemName, UserItem.MakeIndex, BaseObject.m_sCharName, , 0, 0, );
                end;
              }
              TPlayObject(BaseObject).DelBoxItem(J, Npc.m_sCharName, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
              boFoundInOK := True;
              Break;
            end;
          end;
        end
        else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(BaseObject).SendDelItem(UserItem);
      end;

      if not boFoundInOK then
      begin
        if StdItem.NeedIdentify = 1 then
        begin
          // 注释日志 chongchong 2017-10-09
          AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, BaseObject, sItemName, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
        end;

        // 回收了物品，清掉升级框 chongchong 2018-05-16
        if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) and (TPlayObject(BaseObject).m_UpgradeItem = UserItem) then
        begin
          TPlayObject(BaseObject).m_UpgradeItem := nil;
          TPlayObject(BaseObject).m_UpgradeItemIsPegBag := False;
        end
        else if (BaseObject.m_btRaceServer = RC_HEROOBJECT) and (THeroObject(BaseObject).m_LinkItem = UserItem) then
          THeroObject(BaseObject).m_LinkItem := nil;

        BaseObject.m_ItemList.Delete(I);
        Dispose(UserItem);
      end;
      Dec(nItemCount);
    end;
  end;

  // 修复老端收回包裹物品不及时刷新 chongchong 2013-12-03
  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    TPlayObject(BaseObject).WeightChanged
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    THeroObject(BaseObject).WeightChanged;
end;

procedure ActionOfGiveItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);

// 扩展参数 chongchong 2014-10-30
  procedure AddNewValue(Item: pTUserItem);
  var
    Int64Value: Int64;
  begin
    Int64Value := Item.btValue[0] + StrToInt64Def(QuestActionInfo.sParam3, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[0] := Max(0, Int64Value);

    Int64Value := Item.btValue[1] + StrToInt64Def(QuestActionInfo.sParam4, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[1] := Max(0, Int64Value);

    Int64Value := Item.btValue[2] + StrToInt64Def(QuestActionInfo.sParam5, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[2] := Max(0, Int64Value);

    Int64Value := Item.btValue[3] + StrToInt64Def(QuestActionInfo.sParam6, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[3] := Max(0, Int64Value);

    Int64Value := Item.btValue[4] + StrToInt64Def(QuestActionInfo.sParam7, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[4] := Max(0, Int64Value);

    Int64Value := Item.btValue[5] + StrToInt64Def(QuestActionInfo.sParam8, 0);
    if Int64Value > High(Integer) then
      Int64Value := High(Integer);
    Item.btValue[5] := Max(0, Int64Value);
  end;

var
  I: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  sItemName: string;
  nItemCount: Integer;
  HeroObject: THeroObject;
  OverLapItem: pTUserItem;
  OverLapItemsCount: Integer;
  Int64Value: Int64;
  IsGiveOK: Boolean;
  OldGold: LongWord;
  OldDura: Word;
begin
  sItemName := QuestActionInfo.sParam1;
  nItemCount := QuestActionInfo.nParam2;

  if (sItemName = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    HeroObject := THeroObject(BaseObject)
  else
    HeroObject := nil;

  if nItemCount <= 0 then
    nItemCount := 1;

  IsGiveOK := False;

  if CompareText(sItemName, sSTRING_GOLDNAME) = 0 then
  begin
    OldGold := PlayObject.m_nGold;

    Int64Value := Int64(PlayObject.m_nGold) + nItemCount;
    if Int64Value > g_Config.nHumanMaxGold then
      Int64Value := g_Config.nHumanMaxGold;
    PlayObject.m_nGold := Int64Value;

    PlayObject.GoldChanged();

    if g_boGameLogGold then
    begin
      // 注释日志 chongchong 2017-10-09
      AddGameDataLog(LOG_ItemNpcGive, LOG_GoldChange, PlayObject, sSTRING_GOLDNAME, nItemCount, Npc.m_sCharName, PlayObject.m_nGold, OldGold, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
    end;

    Exit;
  end;

  StdItem := UserEngine.GetStdItem(sItemName);
  if StdItem <> nil then
  begin
    if CheckOverLapItem(StdItem) then
    begin
      while True do
      begin
        if nItemCount <= 0 then
          Break;
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          // GIVE 叠加物品 不自动重叠到已有的物品上面 chongchong 2014-04-09
          OverLapItemsCount := OverLapBagItemCount(BaseObject, StdItem, OverLapItem);
          if OverLapItemsCount > 0 then
          begin
            if OverLapItemsCount > nItemCount then
            begin
              OldDura := OverLapItem.Dura;
              OverLapItem.Dura := OverLapItem.Dura + nItemCount;
              nItemCount := 0
            end
            else
            begin
              OldDura := OverLapItem.Dura;
              OverLapItem.Dura := OverLapItem.Dura + OverLapItemsCount;
              nItemCount := nItemCount - OverLapItemsCount;
            end;

            IsGiveOK := True;
            PlayObject.SendUpdateItemDura(-1, OverLapItem.MakeIndex, False, OverLapItem.Dura);
            PlayObject.m_nLastGiveItemMakeIndex := OverLapItem.MakeIndex;

            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcGive, LOG_ActionNone, PlayObject, sItemName, OverLapItem.MakeIndex, Npc.m_sCharName, OverLapItem.Dura + 1, OldDura + 1, Format('叠加;[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end // GIVE 叠加物品 不自动重叠到已有的物品上面 ----------------------------
          else if PlayObject.IsEnoughBag then
          begin
            New(UserItem);
            if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
            begin
              if UserItem.DuraMax > nItemCount then
              begin
                UserItem.Dura := nItemCount - 1;
                nItemCount := 0;
              end
              else
              begin
                UserItem.Dura := UserItem.DuraMax - 1;
                nItemCount := nItemCount - UserItem.DuraMax;
              end;

              { TODO -ochongchong -c修改 : 脚本制造的装备不给特殊属性 【2013-08-01】 }
              UserEngine.RandomItemNewAbil(u_Script, UserItem);

              UserItem.ItemFrom.ItemForm := ifScript;
              UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
              UserItem.ItemFrom.DateTime := Now();

              PlayObject.m_ItemList.Add(UserItem);
              PlayObject.SendAddItem(UserItem);

              if (UserItem.boStartTime) then
              begin
                if StdItem.Need = 103 then
                  PlayObject.SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System)
                else
                  PlayObject.SysMsg(Format('您的限时物品[%s]开始计时，到期时间%s', [StdItem.Name, GetIncMinuteTime(UserItem.ItemFrom.DateTime, StdItem.NeedLevel)]), c_Red, t_System)
              end;

              IsGiveOK := True;

              PlayObject.m_nLastGiveItemMakeIndex := UserItem.MakeIndex;

              if StdItem.NeedIdentify = 1 then
              begin
                // 注释日志 chongchong 2017-10-09
                AddGameDataLog(LOG_ItemNpcGive, LOG_ActionNone, PlayObject, sItemName, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
              end;
            end
            else
              Dispose(UserItem);
          end
          else
          begin
            New(UserItem);
            if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
            begin
              if UserItem.DuraMax > nItemCount then
              begin
                UserItem.Dura := nItemCount - 1;
                nItemCount := 0;
              end
              else
              begin
                UserItem.Dura := UserItem.DuraMax - 1;
                nItemCount := nItemCount - UserItem.DuraMax;
              end;

              { TODO -ochongchong -c修改 : 脚本制造的装备不给特殊属性 【2013-08-01】 }
              UserEngine.RandomItemNewAbil(u_Script, UserItem);

              UserItem.ItemFrom.ItemForm := ifScript;
              UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
              UserItem.ItemFrom.DateTime := Now();

              PlayObject.DropItemDown(UserItem, 3, False, PlayObject, nil);

              PlayObject.m_nLastGiveItemMakeIndex := 0;

              if StdItem.NeedIdentify = 1 then
              begin
                // 注释日志 chongchong 2017-10-09
                AddGameDataLog(LOG_ItemNpcGive, LOG_ItemFall, PlayObject, sItemName, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
              end;
            end;
            Dispose(UserItem);
          end;
        end
        else if HeroObject <> nil then
        begin
          // GIVE 叠加物品 不自动重叠到已有的物品上面 chongchong 2014-04-09
          OverLapItemsCount := OverLapBagItemCount(HeroObject, StdItem, OverLapItem);
          if OverLapItemsCount > 0 then
          begin
            if OverLapItemsCount > nItemCount then
            begin
              OldDura := OverLapItem.Dura;
              OverLapItem.Dura := OverLapItem.Dura + nItemCount;
              nItemCount := 0
            end
            else
            begin
              OldDura := OverLapItem.Dura;
              OverLapItem.Dura := OverLapItem.Dura + OverLapItemsCount;
              nItemCount := nItemCount - OverLapItemsCount;
            end;

            HeroObject.SendUpdateItemDura(-1, OverLapItem.MakeIndex, OverLapItem.Dura);
            IsGiveOK := True;
            HeroObject.m_nLastGiveItemMakeIndex := OverLapItem.MakeIndex;

            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcGive, LOG_ActionNone, HeroObject, sItemName, OverLapItem.MakeIndex, Npc.m_sCharName, OverLapItem.Dura + 1, OldDura + 1, Format('叠加;[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end // GIVE 叠加物品 不自动重叠到已有的物品上面---------------------------
          else if HeroObject.IsEnoughBag then
          begin
            New(UserItem);
            if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
            begin
              if UserItem.DuraMax > nItemCount then
              begin
                UserItem.Dura := nItemCount - 1;
                nItemCount := 0;
              end
              else
              begin
                UserItem.Dura := UserItem.DuraMax - 1;
                nItemCount := nItemCount - UserItem.DuraMax;
              end;

              { TODO -ochongchong -c修改 : 脚本制造的装备不给特殊属性 【2013-08-01】 }
              UserEngine.RandomItemNewAbil(u_Script, UserItem);

              UserItem.ItemFrom.ItemForm := ifScript;
              UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
              UserItem.ItemFrom.DateTime := Now();

              HeroObject.m_ItemList.Add((UserItem));
              HeroObject.SendAddItem(UserItem);

              if (UserItem.boStartTime) then
              begin
                if StdItem.Need = 103 then
                  HeroObject.SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System)
                else
                  HeroObject.SysMsg(Format('您的限时物品[%s]开始计时，到期时间%s', [StdItem.Name, GetIncMinuteTime(UserItem.ItemFrom.DateTime, StdItem.NeedLevel)]), c_Red, t_System)
              end;

              IsGiveOK := True;

              HeroObject.m_nLastGiveItemMakeIndex := UserItem.MakeIndex;

              if StdItem.NeedIdentify = 1 then
              begin
                // 注释日志 chongchong 2017-10-09
