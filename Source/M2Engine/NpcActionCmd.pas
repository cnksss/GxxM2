procedure ActionOfSetIcon(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIndex, nFileIndex, nIconIndex, nIconCount, nX, nY: Integer;
begin
  nIndex := QuestActionInfo.nParam1;
  nFileIndex := QuestActionInfo.nParam2;
  nIconIndex := QuestActionInfo.nParam3;
  nX := QuestActionInfo.nParam4;
  nY := QuestActionInfo.nParam5;
  nIconCount := Max(QuestActionInfo.nParam6, 1);

  if not (nIndex in [Low(TActorIconArray)..High(TActorIconArray)]) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nFileIndex < 0) and (BaseObject.m_ActorIcons[nIndex].nFileIndex >= 0) then
  begin
    BaseObject.m_ActorIcons[nIndex].nFileIndex := -1;
    BaseObject.RefUseIcons;
  end
  else
  begin
    BaseObject.m_ActorIcons[nIndex].nFileIndex := nFileIndex;
    BaseObject.m_ActorIcons[nIndex].nIconIndex := nIconIndex;
