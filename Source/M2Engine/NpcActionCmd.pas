procedure ActionOfUpgradeItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nRate, nWhere, nValType, nPoint, nAddPoint: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  Int64Value: Int64;
begin
  nWhere := QuestActionInfo.nParam1;
  nRate := QuestActionInfo.nParam2;
  nPoint := QuestActionInfo.nParam3;

  if (nWhere < 0) or (nWhere > High(THumanUseItems)) or (nRate < 0) or (nPoint < 0) or (nPoint > 255) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := @PlayObject.m_UseItems[nWhere];
  StdItem := UserEngine.GetStdItem(UserItem.wIndex);
  if (UserItem.wIndex <= 0) or (StdItem = nil) then
  begin
    if not g_Config.boCloseNPCNoItemMsg then
      PlayObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
    Exit;
  end;

  nRate := Random(nRate);
  nPoint := Random(nPoint);
  nValType := Random(14);
  if nRate <> 0 then
  begin
    PlayObject.SysMsg('装备升级失败！', c_Red, t_Hint);
    Exit;
  end;

  if nValType = 14 then
  begin
    nAddPoint := (nPoint * 1000);
    if UserItem.DuraMax + nAddPoint > High(Word) then
    begin
      nAddPoint := High(Word) - UserItem.DuraMax;
    end;
    UserItem.DuraMax := UserItem.DuraMax + nAddPoint;
  end // 武器幸运诅咒调整  // 修正幸运和诅咒不会抵消 2019-01-30 17:55:53
  else if (StdItem <> nil) and (StdItem.StdMode in [5, 6, 68, 69]) and (nValType in [3, 4]) then
  begin
    // 调整幸运
    if nValType = 3 then
    begin
      if UserItem.btValue[4] > 0 then
      begin
        if nPoint >= UserItem.btValue[4] then
        begin
          nPoint := nPoint - UserItem.btValue[4];
          UserItem.btValue[4] := 0;
        end
        else
        begin
          UserItem.btValue[4] := UserItem.btValue[4] - nPoint;
          nPoint := 0;
        end;
      end;

      Int64Value := Int64(UserItem.btValue[nValType]) + nPoint;
      if Int64Value > High(Integer) then
        Int64Value := High(Integer);
      UserItem.btValue[nValType] := Int64Value;
    end // 诅咒
    else
    begin
      if UserItem.btValue[3] > 0 then
      begin
        if nPoint >= UserItem.btValue[3] then
        begin
          nPoint := nPoint - UserItem.btValue[3];
          UserItem.btValue[3] := 0;
        end
        else
        begin
          UserItem.btValue[3] := UserItem.btValue[3] - nPoint;
          nPoint := 0;
        end;
      end;

      Int64Value := Int64(UserItem.btValue[nValType]) + nPoint;
      if Int64Value > High(Integer) then
        Int64Value := High(Integer);
      UserItem.btValue[nValType] := Int64Value;
    end;
  end
  else
  begin
    nAddPoint := nPoint;
    if UserItem.btValue[nValType] + nAddPoint > High(Byte) then
      nAddPoint := High(Byte) - UserItem.btValue[nValType];

    UserItem.btValue[nValType] := UserItem.btValue[nValType] + nAddPoint;
  end;

  // PlayObject.m_boRecalcAbilitys := True;
  // PlayObject.m_RecalcAbilitysChanges := PlayObject.m_RecalcAbilitysChanges + [racSubAbility];
  if PlayObject.m_nLockUpdateAbil = 0 then
  begin
    PlayObject.RecalcAbilitys();
    PlayObject.SendMsg(PlayObject, RM_ABILITY, 0, 0, 0, 0, '');
    PlayObject.SendMsg(PlayObject, RM_SUBABILITY, 0, 0, 0, 0, '');
  end;

  if PlayObject.m_nLockUpdateItems[nWhere] = 0 then
  begin
    if nValType = 14 then
      PlayObject.SendUpdateItemDuraMax(nWhere, UserItem.MakeIndex, False, UserItem.DuraMax)
    else
      PlayObject.SendUpdateItem(UserItem);
  end;

  PlayObject.SysMsg('装备升级成功', c_Green, t_Hint);

  if QuestActionInfo.nParam4 <> 0 then
  begin
    PlayObject.SysMsg(StdItem.Name + ': ' + IntToStr(UserItem.Dura) + '/' + IntToStr(UserItem.DuraMax) + '/' + IntToStr(UserItem.btValue[0]) + '/' + IntToStr(UserItem.btValue[1]) + '/' + IntToStr(UserItem.btValue[2]) + '/' + IntToStr(UserItem.btValue[3]) + '/' + IntToStr(UserItem.btValue[4]) + '/' + IntToStr(UserItem.btValue[5]) + '/' + IntToStr(UserItem.btValue[6]) + '/' + IntToStr(UserItem.btValue[7]) + '/' + IntToStr(UserItem.btValue[8]) + '/' + IntToStr(UserItem.btValue[9]) + '/' + IntToStr(UserItem.btValue[10]) + '/' + IntToStr(UserItem.btValue[11]) + '/' + IntToStr(UserItem.btValue[12]) + '/' + IntToStr(UserItem.btValue[13]), c_Blue, t_Hint);
  end;
end;

procedure ActionOfUpgradeItemEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nRate, nWhere, nValType, nPoint: Integer;
  nAddPoint: Int64;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  nUpgradeItemStatus: Integer;
  nRatePoint: Integer;
  boShowMsg: Boolean;
  SmartObject: TSmartObject;
  LockUpdateItemIndex: Integer;
  CurUserItem: TUserItem;
  sTakeOffItemName: string;
  Int64Value: Int64;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nWhere := QuestActionInfo.nParam1;
  nValType := QuestActionInfo.nParam2;
  nRate := QuestActionInfo.nParam3;
  nPoint := QuestActionInfo.nParam4;
  nUpgradeItemStatus := QuestActionInfo.nParam5;
  boShowMsg := QuestActionInfo.nParam6 <> 0;
  if (nValType < 0) or (nValType > 14) or (nWhere < 0) or (nWhere > U_GODBLESSITEM12) or (nRate < 0) or (nPoint < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  LockUpdateItemIndex := -1;
  UserItem := nil;

  if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end;

  nRatePoint := Random(nRate * 10);
  nPoint := Max(1, Random(nPoint));

  CurUserItem := UserItem^;
  StdItem := UserEngine.GetStdItem(CurUserItem.wIndex);

  if not (nRatePoint in [0..10]) then
  begin
    case nUpgradeItemStatus of //
      0:
        begin
          SmartObject.SysMsg('装备升级未成功！', c_Red, t_Hint);
        end;
      1:
        begin
          if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(SmartObject).SendDelItem(UserItem)
          else
            THeroObject(SmartObject).SendDelItem(UserItem);
          UserItem.wIndex := 0;

          // SmartObject.m_boRecalcAbilitys := True;
          // SmartObject.m_RecalcAbilitysChanges := SmartObject.m_RecalcAbilitysChanges + [racFeatureChanged];
          if SmartObject.m_nLockUpdateAbil = 0 then
          begin
            SmartObject.RecalcAbilitys();
            SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
          end;
          SmartObject.FeatureChanged();

          SmartObject.SysMsg('装备破碎！', c_Red, t_Hint);

          if StdItem <> nil then
          begin
            if (CurUserItem.btValue[13] = 1) and (CurUserItem.Name <> '') then
              sTakeOffItemName := CurUserItem.Name
            else
              sTakeOffItemName := StdItem.Name;

            if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
            begin
              SmartObject.m_nCurrentItemMakeIndex := CurUserItem.MakeIndex;
              SmartObject.m_nCurrentItemPos := nWhere;
              SmartObject.m_sCurrentItemName := StdItem.Name;
              SmartObject.m_sCurrentItemNewName := sTakeOffItemName;

              SmartObject.m_PickUpOrDropItem := CurUserItem;

              g_FunctionNPC.GotoLable(TPlayObject(SmartObject), '@TakeOff' + IntToStr(nWhere), False);
              g_FunctionNPC.GotoLable(TPlayObject(SmartObject), '@TakeOffEx', False);

              SmartObject.m_PickUpOrDropItem.MakeIndex := 0;
              SmartObject.m_PickUpOrDropItem.wIndex := 0;

              SmartObject.m_nCurrentItemMakeIndex := 0;
              SmartObject.m_nCurrentItemPos := 0;
              SmartObject.m_sCurrentItemName := '';
              SmartObject.m_sCurrentItemNewName := '';
            end
            else if (SmartObject.m_btRaceServer = RC_HEROOBJECT) and (SmartObject.m_Master <> nil) and (SmartObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
            begin
              SmartObject.m_nCurrentItemMakeIndex := CurUserItem.MakeIndex;
              SmartObject.m_nCurrentItemPos := nWhere;
              SmartObject.m_sCurrentItemName := StdItem.Name;
              SmartObject.m_sCurrentItemNewName := sTakeOffItemName;

              SmartObject.m_PickUpOrDropItem := CurUserItem;

              g_FunctionNPC.GotoLable(TPlayObject(SmartObject.m_Master), '@HeroTakeOff' + IntToStr(nWhere), False);
              g_FunctionNPC.GotoLable(TPlayObject(SmartObject.m_Master), '@HeroTakeOffEx', False);

              SmartObject.m_PickUpOrDropItem.MakeIndex := 0;
              SmartObject.m_PickUpOrDropItem.wIndex := 0;

              SmartObject.m_nCurrentItemMakeIndex := 0;
              SmartObject.m_nCurrentItemPos := 0;
              SmartObject.m_sCurrentItemName := '';
              SmartObject.m_sCurrentItemNewName := '';
            end;
          end;
        end;
      2:
        begin
          SmartObject.SysMsg('装备升级失败，装备属性恢复默认！', c_Red, t_Hint);

          if nValType <> 14 then
            UserItem.btValue[nValType] := 0;

          if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
          begin
            if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
              TPlayObject(SmartObject).SendUpdateItem(UserItem)
            else
              THeroObject(SmartObject).SendUpdateItem(UserItem);
          end;
        end;
    end;
    Exit;
  end;

  if nValType = 14 then
  begin
    nAddPoint := Int64(nPoint) * 1000;
    nAddPoint := UserItem.DuraMax + nAddPoint;
    if nAddPoint > High(Word) then
      nAddPoint := High(Word);
    UserItem.DuraMax := nAddPoint;
  end // 武器幸运诅咒调整  // 修正幸运和诅咒不会抵消 2019-01-30 17:55:53
  else if (StdItem <> nil) and (StdItem.StdMode in [5, 6, 68, 69]) and (nValType in [3, 4]) then
  begin
    // 调整幸运
    if nValType = 3 then
    begin
      if UserItem.btValue[4] > 0 then
      begin
        if nPoint >= UserItem.btValue[4] then
        begin
          nPoint := nPoint - UserItem.btValue[4];
          UserItem.btValue[4] := 0;
        end
        else
        begin
          UserItem.btValue[4] := UserItem.btValue[4] - nPoint;
          nPoint := 0;
        end;
      end;

      Int64Value := Int64(UserItem.btValue[nValType]) + nPoint;
      if Int64Value > High(Integer) then
        Int64Value := High(Integer);
      UserItem.btValue[nValType] := Int64Value;
    end // 诅咒
    else
    begin
      if UserItem.btValue[3] > 0 then
      begin
        if nPoint >= UserItem.btValue[3] then
        begin
          nPoint := nPoint - UserItem.btValue[3];
          UserItem.btValue[3] := 0;
        end
        else
        begin
          UserItem.btValue[3] := UserItem.btValue[3] - nPoint;
          nPoint := 0;
        end;
      end;

      Int64Value := Int64(UserItem.btValue[nValType]) + nPoint;
      if Int64Value > High(Integer) then
        Int64Value := High(Integer);
      UserItem.btValue[nValType] := Int64Value;
    end;
  end
  else
  begin
    nAddPoint := Int64(UserItem.btValue[nValType]) + nPoint;
    if nAddPoint > High(Integer) then
      nAddPoint := High(Integer);
    UserItem.btValue[nValType] := nAddPoint;
  end;

  // SmartObject.m_boRecalcAbilitys := True;
  if SmartObject.m_nLockUpdateAbil = 0 then
  begin
    SmartObject.RecalcAbilitys;
    SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
  end;

  if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      if nValType = 14 then
        TPlayObject(SmartObject).SendUpdateItemDuraMax(nWhere, UserItem.MakeIndex, False, UserItem.DuraMax)
      else
        TPlayObject(SmartObject).SendUpdateItem(UserItem)
    end
    else
    begin
      if nValType = 14 then
        THeroObject(SmartObject).SendUpdateItemDuraMax(nWhere, UserItem.MakeIndex, UserItem.DuraMax)
      else
        THeroObject(SmartObject).SendUpdateItem(UserItem);
    end;
  end;

  SmartObject.SysMsg('装备升级成功', c_Green, t_Hint);

  if boShowMsg then
  begin
    if StdItem <> nil then
    begin
      SmartObject.SysMsg(StdItem.Name + ': ' + IntToStr(CurUserItem.Dura) + '/' + IntToStr(CurUserItem.DuraMax) + '-' + IntToStr(CurUserItem.btValue[0]) + '/' + IntToStr(CurUserItem.btValue[1]) + '/' + IntToStr(CurUserItem.btValue[2]) + '/' + IntToStr(CurUserItem.btValue[3]) + '/' + IntToStr(CurUserItem.btValue[4]) + '/' + IntToStr(CurUserItem.btValue[5]) + '/' + IntToStr(CurUserItem.btValue[6]) + '/' + IntToStr(CurUserItem.btValue[7]) + '/' + IntToStr(CurUserItem.btValue[8]) + '/' + IntToStr(CurUserItem.btValue[9]) + '/' + IntToStr(CurUserItem.btValue[10]) + '/' + IntToStr(CurUserItem.btValue[11]) + '/' + IntToStr(CurUserItem.btValue[12]) + '/' + IntToStr(CurUserItem.btValue[13]), c_Blue, t_Hint);
    end;
  end;
end;

procedure ActionOfMonGenEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMapName, sMonName, sTemp, S11, S12: string;
  nMapX, nMapY, nRange, nCount, nTotal, RunCount: Integer;
  nRandX, nRandY: Integer;
  Envir: TEnvirnoment;
  MonObj: TBaseObject;
  NameColor: Integer;
  boIsNGMon, boAllowSameNationPlayerAttack: Boolean;
  boNotSameNationaPK: Boolean;
begin
  sMapName := QuestActionInfo.sParam1;
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1)
  else
    sMapName := Envir.sMapName;

  nMapX := QuestActionInfo.nParam2;
  nMapY := QuestActionInfo.nParam3;
  sMonName := QuestActionInfo.sParam4;
  nRange := QuestActionInfo.nParam5;
  nCount := QuestActionInfo.nParam6;

  if (sMapName = '') or (Envir = nil) or (nMapX <= 0) or (nMapY <= 0) or (sMapName = '') or (nRange < 0) or (nCount <= 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.sParam7 = '' then
    NameColor := 255
  else
  begin
    NameColor := QuestActionInfo.nParam7;
    if (NameColor < 0) or (NameColor > 255) then
      NameColor := 255;
  end;

  boIsNGMon := False;
  if QuestActionInfo.nParam8 = 1 then
    boIsNGMon := True;

  sTemp := QuestActionInfo.sSubParam10;

  sTemp := GetValidStr3(sTemp, S11, [' ', #9]);
  sTemp := GetValidStr3(sTemp, S12, [' ', #9]);

  boNotSameNationaPK := S11 = '1'; // 第11个参数为同国家怪物PK
  boAllowSameNationPlayerAttack := S12 = '1'; // 第12个参数为是否可被同国家的人物攻击

  nTotal := 0;
  RunCount := 0;
  while True do
  begin
    if nRange = 0 then
    begin
      nRandX := nMapX;
      nRandY := nMapY;
    end
    else
    begin
      nRandX := Random(nRange * 2 + 1) + (nMapX - nRange);
      nRandY := Random(nRange * 2 + 1) + (nMapY - nRange);
    end;

    MonObj := UserEngine.RegenMonsterByName(sMapName, nRandX, nRandY, sMonName);
    if MonObj <> nil then
    begin
      MonObj.m_btNameColor := NameColor;
      MonObj.m_boISNGMonster := boIsNGMon;
      MonObj.m_btNation := QuestActionInfo.nParam9; // GetNationIndex(
      MonObj.m_boCanAttackSameNationPlayer := QuestActionInfo.nParam10 = 1;
      MonObj.m_boNoSameNationMonPK := boNotSameNationaPK;
      MonObj.m_boAllowSameNationPlayerAttack := boAllowSameNationPlayerAttack;

      Inc(nTotal);
      if nTotal >= nCount then
        Break;
    end;

    Inc(RunCount);
    if RunCount >= nCount * 3 then
      Break;
  end;
end;

procedure ActionOfClearMapMon(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  MonList: TList;
  mon: TBaseObject;
  II: Integer;
  Envir: TEnvirnoment;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  if Envir <> nil then
  begin
    MonList := TList.Create;
    UserEngine.GetMapMonster(Envir, MonList, True);
    for II := 0 to MonList.Count - 1 do
    begin
      mon := TBaseObject(MonList.Items[II]);
      if mon.m_Master <> nil then
        Continue;

      // 在调用 ClearMapMon时，会干掉城堡中的守卫等 chongchong 2018-01-26
      // 修正沙巴克城门等过段时间会自动改变 chongchong 2018-01-26
      if mon.m_Castle <> nil then
        Continue;

      if (not Envir.m_boMirror) and (not Envir.m_boFB) and GetNoClearMonList(mon.m_sCharName) then
        Continue;

      if not mon.m_boGhost then
      begin
        mon.m_boNoItem := True;
        mon.MakeGhost;
      end;
    end;
    MonList.Free;
  end;
end;

