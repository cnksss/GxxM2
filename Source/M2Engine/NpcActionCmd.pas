  sNo := '';
  nIndex := -1;
  for I := 0 to StringList.Count - 1 do
  begin
    sLineText := StringList.Strings[I];
    if (sLineText <> '') and ((sLineText[1] = '@') or (sLineText[1] = '~')) then
    begin
      nIndex := I - 1;
      sYes := sLineText;
      if I + 1 < StringList.Count then
      begin
        sLineText := StringList.Strings[I + 1];
        if (sLineText <> '') and ((sLineText[1] = '@') or (sLineText[1] = '~')) then
        begin
          sNo := sLineText;
        end;
      end;
      Break;
    end;
  end;

  sMsg := '';
  if nIndex >= 0 then
  begin
    for I := 0 to nIndex do
      sMsg := sMsg + ' ' + StringList.Strings[I];
  end
  else
    sMsg := QuestActionInfo.sParam1;

  if (sYes <> '') or (sNo <> '') then
  begin
    sMsg := sMsg + #13#10 + sYes + #13#10 + sNo;
    PlayObject.m_sYesLable := sYes;
    PlayObject.m_sNoLable := sNo;
  end;

  // 修正以下脚本点两次才触发chongchong 2015-10-3
  PlayObject.m_boMessageBox := False;
  {
    脚本实例(第一次点取消，第二次点确定)

    [@测试]
    #ACT
    MESSAGEBOX 是否确定使用10张书页，升级强化冰咆哮至下一等级？ @确定33 @取消

    [@确定33]
    #ACT
    MESSAGEBOX 您点了确定!
  }

  PlayObject.SendMsg(Npc, RM_MENU_OK, 0, NativeInt(Npc), 0, 0, sMsg);

  StringList.Free;
end;

