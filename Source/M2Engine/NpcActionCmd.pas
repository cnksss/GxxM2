procedure ActionOfSetMonColor(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMapName, sMonName: string;
  Envir: TEnvirnoment;
  nColor, nTime, nColorType: Integer;
  MonList: TList;
  I, nX, nY: Integer;
  AObject: TBaseObject;
begin
  sMapName := QuestActionInfo.sParam1;
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1)
  else
    sMapName := Envir.sMapName;

  sMonName := QuestActionInfo.sParam2;
  nColor := QuestActionInfo.nParam3;
  nTime := QuestActionInfo.nParam4;
  nColorType := QuestActionInfo.nParam5;

  if CompareText(sMapName, 'Self') = 0 then
  begin
    sMapName := BaseObject.m_sMapName;
    Envir := g_MapManager.FindMap(sMapName);
  end;

  if (nTime < 0) or (not (nColor in [0..255])) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (Length(sMapName) = 0) or (Length(sMonName) = 0) then
    Exit;

  MonList := TList.Create;
  nX := Envir.m_nWidth div 2;
  nY := Envir.m_nHeight div 2;
  Envir.GetRangeBaseObject(nX, nY, Max(Envir.m_nWidth div 2, Envir.m_nHeight div 2), True, MonList);

  for I := MonList.Count - 1 downto 0 do
  begin
    if MonList.Count <= 0 then
      Break;
    AObject := TBaseObject(MonList.Items[I]);
    if not ((CompareText(AObject.m_sCharName, sMonName) <> 0) or (AObject.m_btRaceServer < RC_ANIMAL) or (AObject.m_btRaceServer = RC_ARCHERGUARD) or (AObject.m_Master <> nil) or (AObject.m_btRaceServer = RC_NPC) or (AObject.m_btRaceServer = RC_PEACENPC)) then
    begin

      AObject.m_nChangeBodyType := nColorType;
      AObject.m_nChangeBodyColorIndex := 0;
      if nColorType <> 0 then
        AObject.m_btBodyColor := AObject.GetCharColor(AObject)
      else
        AObject.m_btBodyColor := nColor;
      AObject.m_dwChangeBodyColorTime := nTime * 1000;
      AObject.m_dwStartChangeBodyColor := MyGetTickCount;
      AObject.FeatureChanged;
    end;
  end;
end;

// 修改宝宝身体颜色 chongchong 2013-12-07

procedure ActionOfSetSlaveBodyColor(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nColor, nTime: Integer;
  nColorType: Integer;
  sSlaveName, sCharName: string;
  SlaveObject: TBaseObject;
begin
  sSlaveName := DelNumber(QuestActionInfo.sParam1);
  nColor := QuestActionInfo.nParam2;
  nTime := QuestActionInfo.nParam3;
  nColorType := QuestActionInfo.nParam4;

  if (nTime < 0) or (not (nColor in [0..255])) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  for I := 0 to BaseObject.m_SlaveList.Count - 1 do
  begin
    SlaveObject := TBaseObject(BaseObject.m_SlaveList.Items[I]);
    sCharName := SlaveObject.m_sCharName;
    sCharName := DelNumber(sCharName);

    if (sSlaveName = '*') or (CompareText(sCharName, sSlaveName) = 0) then
    begin
      SlaveObject.m_nChangeBodyType := nColorType;
      if nColorType = 1 then
        SlaveObject.m_btBodyColor := SlaveObject.GetCharColor(SlaveObject)
      else
        SlaveObject.m_btBodyColor := nColor;
      SlaveObject.m_dwChangeBodyColorTime := nTime * 1000;
      SlaveObject.m_dwStartChangeBodyColor := MyGetTickCount;
      SlaveObject.m_nChangeBodyColorIndex := 0;
      SlaveObject.FeatureChanged;
    end;
  end;
end;

procedure ActionOfMakePosion(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nType, nTime, nPoint: Integer;
  CanState: Boolean;
begin
  nType := QuestActionInfo.nParam1;
  nTime := QuestActionInfo.nParam2;
  nPoint := QuestActionInfo.nParam3;

  if (not (nType in [0..12])) or (nTime < 0) or (nPoint < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (QuestActionInfo.nParam5 < 0) or (QuestActionInfo.nParam5 > 1) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.nParam4 = 0 then
  begin
    CanState := True;
  end
  else
  begin
    case nType of
      STATE_FROZEN:
        CanState := not BaseObject.UnFrozen;
      POISON_DECHEALTH, POISON_DAMAGEARMOR:
        CanState := not BaseObject.UnPosion;
      POISON_STONE:
        CanState := not BaseObject.UnParalysis;
    else
      CanState := True;
    end;
  end;

  if nType = STATE_FROZEN then
  begin
    if CanState then
    begin
      BaseObject.MakeFrozen(nTime) // 冰冻
    end;
  end
  else
  begin
    if CanState then
    begin
      BaseObject.MakePosionEx(nType, nTime, nPoint, QuestActionInfo.nParam5);
    end;
  end;
end;

procedure ActionOfShopStall(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  if not PlayObject.m_boShopStall then
  begin
    PlayObject.m_boShopStall := True;
