procedure ActionOfDoTaunt(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  List: TList;
  boCheckTarget: Boolean;
  boSpaceMove: Boolean;
begin
  if (QuestActionInfo.nParam1 = 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  boSpaceMove := QuestActionInfo.nParam3 = 1;
  boCheckTarget := QuestActionInfo.nParam4 = 1;

  if QuestActionInfo.nParam1 > 20 then
    QuestActionInfo.nParam1 := 20;

  List := TList.Create;
  try
    PlayObject.GetMapBaseObjects(PlayObject.m_PEnvir, PlayObject.m_nCurrX, PlayObject.m_nCurrY, QuestActionInfo.nParam1, List);

    if QuestActionInfo.nParam2 <= 0 then
    begin
      for I := 0 to List.Count - 1 do
      begin
        BaseObject := List[I];
        if not (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) //
          and (BaseObject <> nil) //
          and (not BaseObject.m_boDeath) //
          and (BaseObject.m_Master = nil) //
          and (not BaseObject.m_boGhost) //
          and PlayObject.IsProperTarget(BaseObject) //
          and not (boCheckTarget //
          and (BaseObject.m_TargetCret <> nil)) then
        begin
          if boSpaceMove then
          begin
            BaseObject.SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');
            BaseObject.SpaceMove(PlayObject.m_PEnvir.sMapName, PlayObject.m_nCurrX, PlayObject.m_nCurrY, 0);
          end;
          BaseObject.m_dwSearchTick := MyGetTickCount;
          BaseObject.m_DoTauntTarget := PlayObject;
        end;
      end;
    end
    else
    begin
      for I := 0 to List.Count - 1 do
      begin
        BaseObject := List[I];
        if not (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) and (BaseObject <> nil) and (not BaseObject.m_boDeath) and (BaseObject.m_Master = nil) and (not BaseObject.m_boGhost) and
        { (not BaseObject.m_boHideMode or Player.m_boCoolEye) and }
          (BaseObject.m_Abil.Level <= QuestActionInfo.nParam2) and PlayObject.IsProperTarget(BaseObject) and not (boCheckTarget and (BaseObject.m_TargetCret <> nil)) then
        begin
          if boSpaceMove then
          begin
            BaseObject.SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');
            BaseObject.SpaceMove(PlayObject.m_PEnvir.sMapName, PlayObject.m_nCurrX, PlayObject.m_nCurrY, 0);
          end;
          BaseObject.m_dwSearchTick := MyGetTickCount;
          BaseObject.m_DoTauntTarget := PlayObject;
        end;
      end;
    end;
  finally
    List.Free;
  end;
end;

