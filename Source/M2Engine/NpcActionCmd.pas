procedure ActionOfReNewLevel(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nReLevel, nLevel: Integer;
  nOldBounsuPoint, nBounsuPoint: Integer;
  PlayObj: TPlayObject;
  HeroObj: THeroObject;
begin
  nReLevel := QuestActionInfo.nParam1;
  nLevel := QuestActionInfo.nParam2;
  nBounsuPoint := QuestActionInfo.nParam3;

  if (nReLevel < 0) or (nLevel < 0) or (nBounsuPoint < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
  begin
    PlayObj := BaseObject as TPlayObject;
    if (PlayObj.m_btReLevel + nReLevel) <= 255 then
    begin
      Inc(PlayObj.m_btReLevel, nReLevel);
      if nLevel > 0 then
        PlayObj.m_Abil.Level := nLevel;
      if g_Config.boReNewLevelClearExp then
        PlayObj.m_Abil.Exp := 0;

      if nBounsuPoint > 0 then
      begin
        nOldBounsuPoint := PlayObj.m_nBonusPoint;
        Inc(PlayObj.m_nBonusPoint, nBounsuPoint);

        AddGameDataLog(LOG_AbilPointChange, LOG_ActionNone, PlayObject, '未分配属性点', 0, Npc.m_sCharName, PlayObj.m_nBonusPoint, nOldBounsuPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;

      PlayObj.SendMsg(PlayObj, RM_ADJUST_BONUS, 0, 0, 0, 0, '');
      PlayObj.HasLevelUp(0, False);
      PlayObj.RefShowName();

      if g_FunctionNPC <> nil then
      begin
        PlayObject.m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(PlayObject, '@PlayReNewLevel', False);
      end;
    end;
  end
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
  begin
    HeroObj := BaseObject as THeroObject;
    if (HeroObj.m_btReLevel + nReLevel) <= 255 then
    begin
      Inc(HeroObj.m_btReLevel, nReLevel);
      if nLevel > 0 then
        HeroObj.m_Abil.Level := nLevel;
      if g_Config.boReNewLevelClearExp then
        HeroObj.m_Abil.Exp := 0;
      HeroObj.HasLevelUp(0, False);
      HeroObj.RefShowName();

      if (g_FunctionNPC <> nil) and (BaseObject.m_Master <> nil) and (BaseObject.m_Master.m_btRaceServer = RC_PLAYOBJECT) then
      begin
        TPlayObject(BaseObject.m_Master).m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(TPlayObject(BaseObject.m_Master), '@HeroReNewLevel', False);
      end;
    end;
  end;
end;

procedure ActionOfKillSlave(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Slave: TBaseObject;
  SlaveName: string;
begin
  SlaveName := QuestActionInfo.sParam2;
  if SlaveName = '' then
    SlaveName := '*';

  for I := BaseObject.m_SlaveList.Count - 1 downto 0 do
  begin
    Slave := TBaseObject(BaseObject.m_SlaveList.Items[I]);

    if (SlaveName = '*') or SameText(SlaveName, Slave.m_sCharName) then
    begin

      Slave.m_WAbil.HP := 0;

      /// //////////////////////修复镖车劫镖BUG piaoyun 2013-08-21/////////////////
      Slave.bo94 := True;
      Slave.m_CurrTarget := TBaseObject(Npc);

      // 修复人形怪带复活装备，用KillSlave NPC脚本杀不死 chongchong 2013-12-30

      if QuestActionInfo.nParam1 = 1 then // 是否清尸体
      begin
        Slave.m_Master := nil;
        Slave.MakeGhost;
        BaseObject.m_SlaveList.Delete(I);
      end
      else
        Slave.Die;
    end;
  end;
end;

procedure ActionOfChangeGender(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nGENDER: Integer;
  btGender: Byte;
begin
  nGENDER := QuestActionInfo.nParam1;

  if not (nGENDER in [0, 1]) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;
  btGender := BaseObject.m_btGender;

  BaseObject.m_btGender := nGENDER;
  if btGender <> BaseObject.m_btGender then
  begin
    case BaseObject.m_btGender of
      0:
        begin
          case BaseObject.m_btHair of
            1, 3:
              BaseObject.m_btHair := 2;
          end;
        end;
      1:
        begin
          case BaseObject.m_btHair of
            2:
              case Random(2) of
                1:
                  BaseObject.m_btHair := 1;
                2:
                  BaseObject.m_btHair := 3;
              else
                BaseObject.m_btHair := 1;
              end;
          end;
        end;
    end;

    BaseObject.FeatureChanged;
  end;
end;

procedure ActionOfKillMonExpRate(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nRate: Integer;
  nTime: Integer;
  SmartObject: TSmartObject;
  S: string;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nRate := QuestActionInfo.nParam1;
  nTime := QuestActionInfo.nParam2;

  if (nRate < 0) or (nTime < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  SmartObject.m_boSaveKillMonExpRate := QuestActionInfo.nParam3 <> 0;
  SmartObject.m_nKillMonExpRate := nRate;
  SmartObject.m_dwKillMonExpRateTime := LongWord(nTime);

  if SmartObject.m_dwKillMonExpRateTime = 0 then
  begin
    if (Length(g_sKillMonExpRateForeverMsg) > 0) and (QuestActionInfo.nParam4 = 0) then
    begin
      S := StringReplace(g_sKillMonExpRateForeverMsg, '%g', FloatToStr(SmartObject.m_nKillMonExpRate / 100), [rfReplaceAll]);
