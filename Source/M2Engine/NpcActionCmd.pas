procedure ActionOfGetDummyName(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIndex: Integer;
  sCharName: string;
  DummyNameList: TStringList;
  CanLogonNameList: TStringList;
begin
  if QuestActionInfo.sParam2 = '0' then
    DummyNameList := g_DummyNameList
  else
    DummyNameList := g_DummyHeroNameList;

  CanLogonNameList := TStringList.Create;
  for nIndex := 0 to DummyNameList.Count - 1 do
  begin
    if (not UserEngine.FindDummyLogon(DummyNameList.Strings[nIndex])) and (UserEngine.GetPlayObject(DummyNameList.Strings[nIndex]) = nil) and (UserEngine.GetHeroObject(DummyNameList.Strings[nIndex]) = nil) then
    begin
      CanLogonNameList.Add(DummyNameList.Strings[nIndex]);
    end;
  end;

  if CanLogonNameList.Count > 0 then
  begin
    nIndex := 0;
    if QuestActionInfo.sParam3 = '1' then
    begin
      while True do
      begin
        nIndex := Random(CanLogonNameList.Count - 1);
        if (nIndex >= 0) and (nIndex < CanLogonNameList.Count) then
          Break;
      end;
    end;
    if (nIndex >= 0) and (nIndex < CanLogonNameList.Count) then
    begin
      sCharName := CanLogonNameList.Strings[nIndex];
      if (not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, sCharName, StrToIntDef(sCharName, 0))) then
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    end;
  end;
  CanLogonNameList.Free;
end;

