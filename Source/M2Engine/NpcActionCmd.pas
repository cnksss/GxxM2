procedure ActionOfCreateHeroEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nJob: Integer;
  nSex: Integer;
  nHair: Integer;
  sHeroName: AnsiString;
begin
  nJob := QuestActionInfo.nParam1;
  nSex := QuestActionInfo.nParam2;
  sHeroName := QuestActionInfo.sParam3;

  if (not (nJob in [0..2])) or (not (nSex in [0..1])) or (Length(PlayObject.m_sHeroName) > 0) or (Length(sHeroName) < 4) or (Length(sHeroName) >= 15) or GetNameInFilterList(sHeroName) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_boWaitHeroDate then
  begin
    Npc.GotoLable(PlayObject, '@CreateingHero', False);
    Exit;
  end;

  nHair := 0;
  case nSex of
    0:
      begin
        nHair := 2;
      end;
    1:
      begin
        case Random(2) of
          1:
            nHair := 1;
          2:
            nHair := 3;
        else
          nHair := 1;
        end;
      end;
  end;

  PlayObject.m_sTempHeroName := sHeroName;
  DataEngine.CreateHero(PlayObject, Npc, sHeroName, nSex, nJob, nHair, False);
end;

procedure ActionOfCreateHero(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nJob: Integer;
  nSex: Integer;
  nHair: Integer;
  sHeroName: string;
  boDeputyHero: Boolean;
begin
  nJob := QuestActionInfo.nParam1;
  nSex := QuestActionInfo.nParam2;
  if (not (nJob in [0..2])) or (not (nSex in [0..1])) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_boWaitHeroDate then
  begin
    Npc.GotoLable(PlayObject, '@CreateingHero', False);
    Exit;
  end;

  boDeputyHero := QuestActionInfo.sParam3 = 'TRUE'; // 是否是卧龙英雄
  if boDeputyHero then
    sHeroName := PlayObject.m_sDeputyHeroName
  else
    sHeroName := PlayObject.m_sHeroName;

  nHair := 0;
  if (sHeroName = '') then
  begin
    if (PlayObject.m_sTempHeroName <> '') then
    begin
      case nSex of
        0:
          begin
            nHair := 2;
          end;
        1:
          begin
            case Random(2) of
              1:
                nHair := 1;
              2:
                nHair := 3;
            else
              nHair := 1;
            end;
          end;
      end;

      if boDeputyHero then
        DataEngine.CreateHero(PlayObject, Npc, PlayObject.m_sTempHeroName, nSex, nJob, nHair, True)
      else
        DataEngine.CreateHero(PlayObject, Npc, PlayObject.m_sTempHeroName, nSex, nJob, nHair, False);
    end
    else
    begin
      Npc.GotoLable(PlayObject, '@SetHeroName', False);
    end;
  end
  else
  begin
    Npc.GotoLable(PlayObject, '@HaveHero', False);
  end;
end;

procedure ActionOfDeleteHero(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  if PlayObject.m_boWaitHeroDate then
