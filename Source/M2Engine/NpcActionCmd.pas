procedure ActionOfGiveGamePet(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  MonInfo: pTMonInfo;
  UserItem: pTUserItem;
  sVarName: string;
begin
  if (QuestActionInfo.sParam1 = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  MonInfo := UserEngine.GetMonInfo(QuestActionInfo.sParam1);
  if MonInfo = nil then
  begin
    Npc.ScriptActionError(PlayObject, '怪物不存在', QuestActionInfo);
    Exit;
  end;

  sVarName := QuestActionInfo.sRawParam2;

  if not PlayObject.IsEnoughBag then
    Exit;

  New(UserItem);
  if UserEngine.CopyToUserItemFromName('宠物蛋', UserItem) then
  begin
    UserItem.ItemFrom.ItemForm := ifScript;
    UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
    UserItem.ItemFrom.DateTime := Now();

    UserItem.btValue[13] := 1;
    UserItem.Name := MonInfo.sName;

    PlayObject.m_ItemList.Add(UserItem);
    PlayObject.SendAddItem(UserItem);

    if sVarName <> '' then
    begin
      if not Npc.SetVarValue(PlayObject, sVarName, IntToStr(UserItem.MakeIndex), UserItem.MakeIndex) then
      begin
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      end;
    end;
  end
  else
    Dispose(UserItem);
end;

