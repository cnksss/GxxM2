procedure ActionOfSetCustomItemAbil(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nBoxItemIndex, nMakeIndex: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  SmartObject: TSmartObject;
  nPropertyIndex, nValueType, nValue: Integer;
  LockUpdateItemIndex: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -3;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -3);

  nPropertyIndex := QuestActionInfo.nParam2;
  nValueType := QuestActionInfo.nParam3;
  nValue := QuestActionInfo.nParam4;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nPropertyIndex < 0) or (nPropertyIndex >= ITEM_PROP_COUNT) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nValueType < 0) or (nValueType > 4) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if ((nValueType = 0) or (nValueType = 2)) and ((nValue < 0) or (nValue > 255)) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nValueType = 1) and ((nValue < 0) or (nValue > CUSTOM_PROPERTY_BIND_TYPE_COUNT)) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  LockUpdateItemIndex := -1;
  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := PlayObject.m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to PlayObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(PlayObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := PlayObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere = -1 then
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    if nValueType = 0 then
    begin
      UserItem.CustomProperty.Properties[nPropertyIndex].btColor := nValue;
    end
    else if nValueType = 1 then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (StdItem <> nil) and (nValue in [1, 2]) and (StdItem.StdMode in [5, 6, 68, 69, 19, 70, 75, 53, 88, 20, 24, 71, 76, 79, 52, 86, 21, 54 { 腰带 }, 72, 77, 84 { 时装腰带 }, 23, 74, 82]) then
      begin
        SmartObject.SysMsg('装备 ' + StdItem.Name + ' 不支持绑定防御、魔御属性', c_Red, t_Hint);
        Exit;
      end;
      UserItem.CustomProperty.Properties[nPropertyIndex].btBindType := nValue;
    end
    else if nValueType = 2 then
    begin
      UserItem.CustomProperty.Properties[nPropertyIndex].btShowFlag := nValue;
    end
    else if nValueType = 3 then
    begin
      if (nValue < 0) or (nValue > 2) then
        nValue := 0;

      UserItem.CustomProperty.Properties[nPropertyIndex].btPercent := nValue;
    end
    else if nValueType = 4 then
    begin
      if (nValue < 0) or (nValue > 14) then
        nValue := 0;

      UserItem.CustomProperty.Properties[nPropertyIndex].btHintModule := nValue;
    end;

    if (SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0) and (UserItem <> nil) then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
          TPlayObject(SmartObject).SendUpdateItemPropertyValue(nBoxItemIndex, True, UserItem, nPropertyIndex)
        else
          TPlayObject(SmartObject).SendUpdateItemPropertyValue(nWhere, False, UserItem, nPropertyIndex);
      end
      else
      begin
        THeroObject(SmartObject).SendUpdateItemPropertyValue(nWhere, UserItem, nPropertyIndex)
      end;
    end;

    // if (nValueType in [1, 3]) and (nBoxItemIndex = -1) and (nWhere > 0) then
    // begin
    // SmartObject.m_boRecalcAbilitys := True;
    // SmartObject.m_RecalcAbilitysChanges := SmartObject.m_RecalcAbilitysChanges + [racSubAbility];
    // end;
    if (nValueType in [1, 3]) and (nBoxItemIndex = -1) and (nWhere > 0) and (SmartObject.m_nLockUpdateAbil = 0) then
    begin
      SmartObject.RecalcAbilitys();
      SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
      SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
    end;
  end;
end;

