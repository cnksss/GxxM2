procedure ActionOfSetUpgradeItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  UserItem: pTUserItem;
  I, nMakeIndex: Integer;
begin
  if Length(QuestActionInfo.sParam1) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '未指定变量', QuestActionInfo);
    Exit;
  end;

  if (not (QuestActionInfo.nParam1 in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)])) then
  begin
    Npc.ScriptActionError(PlayObject, '变量超出范围', QuestActionInfo);
    Exit;
  end;

  nMakeIndex := PlayObject.m_ItemBoxItems[QuestActionInfo.nParam1];
  PlayObject.m_UpgradeItem := nil;
  PlayObject.m_UpgradeItemIsPegBag := False;

  if nMakeIndex > 0 then
  begin
    for I := 0 to PlayObject.m_ItemList.Count - 1 do
    begin
      UserItem := pTUserItem(PlayObject.m_ItemList[I]);
      if UserItem.MakeIndex = nMakeIndex then
      begin
        PlayObject.m_UpgradeItem := UserItem;
        PlayObject.m_UpgradeItemIsPegBag := False;
        Break;
      end;
    end;
  end;
end;


