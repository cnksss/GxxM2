// 屏幕震动 piaoyun 2013-09-14
// 脚本命令：SCENESHAKE 是否全局[0自己，1全局，2屏幕范围内，3.当前地图 4.指定地图(地图ID)]

procedure ActionOfSceneShake(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, ShakeType, nCount: Integer;
  sMapName: string;
  Envir: TEnvirnoment;
begin
  try
    ShakeType := StrToIntDef(QuestActionInfo.sParam1, -1);
    case ShakeType of
      0:
        begin
          nCount := QuestActionInfo.nParam2;
          if nCount <= 0 then
            nCount := 1;
          PlayObject.SendSceneShake(nCount, QuestActionInfo.nParam3 = 1);
        end;
      1:
        begin
          nCount := QuestActionInfo.nParam2;
          if nCount <= 0 then
            nCount := 1;

          for I := 0 to g_MapManager.Count - 1 do
          begin
            TEnvirnoment(g_MapManager.Items[I]).AddSceneShake(nCount, '', QuestActionInfo.nParam3 = 1);
          end;
        end;
      2:
        begin
          nCount := QuestActionInfo.nParam2;
          if nCount <= 0 then
            nCount := 1;

          Envir := g_MapManager.FindMap(PlayObject.m_sMapName);
          if Envir <> nil then
            Envir.AddSceneShake(nCount, PlayObject.m_sCharName, QuestActionInfo.nParam3 = 1);
        end;
      3:
        begin
          nCount := QuestActionInfo.nParam2;
          if nCount <= 0 then
            nCount := 1;

          PlayObject.m_PEnvir.AddSceneShake(nCount, '', QuestActionInfo.nParam3 = 1);
        end;
      4:
        begin
          sMapName := QuestActionInfo.sParam2;
          nCount := QuestActionInfo.nParam3;
          if nCount <= 0 then
            nCount := 1;

          Envir := g_MapManager.FindMap(sMapName);
          if Envir <> nil then
            Envir.AddSceneShake(nCount, '', QuestActionInfo.nParam4 = 1);
        end;
    end;
  except
    MainOutMessage('{异常} TNormNpc.ActionOfSceneShake');
  end;
end;

// 更改人物状态 piaoyun 2013-10-08
// 1.石化 2.冰冻 3.蛛网效果 4.红毒 5.绿毒 6.定身 7.瘫痪 8.禁锢 9.防禁锢 10.吸血 11.吸蓝 12.禁锢 13.间隔掉血 14.禁止使用技能
procedure ActionOfChangeState(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nStateType: Integer;
  nStateTime: Integer;
  I, nX, nY, nMaxX, nMaxY, nMinX, nMinY, nRange: Integer;
  MagicEvent: pTMagicEvent;
  Event: TImprisonCurtainEvent;
  BaseObjectList: TList;
  Obj: TBaseObject;
  ImgFileIndex, ImgIndex, ImgCount, ImgPlayTime: Integer;
  IsBlendDraw: Boolean;
  SmartObject: TSmartObject;

  procedure SendCustomEffect(AObject: TBaseObject);
  begin
    if (ImgFileIndex >= 0) and (ImgIndex >= 0) and (ImgCount > 0) and (ImgPlayTime > 0) then
    begin
      AObject.SendRefMsg(RM_ADD_EFFECT_PLAY, ImgFileIndex, ImgIndex, ImgCount, ImgPlayTime, BoolToIntStr(IsBlendDraw));
    end;
  end;

begin
  nStateType := QuestActionInfo.nParam1;
  nStateTime := QuestActionInfo.nParam2;
  if not nStateType in [1..14] then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  ImgFileIndex := QuestActionInfo.nParam5;
  ImgIndex := QuestActionInfo.nParam6;
  ImgCount := QuestActionInfo.nParam7;
  ImgPlayTime := QuestActionInfo.nParam8;
  IsBlendDraw := QuestActionInfo.nParam9 = 1;

  if (ImgFileIndex < 0) or (ImgPlayTime < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  case nStateType of
    1:
      begin
        if QuestActionInfo.nParam3 = 0 then
          BaseObject.MakePosion(POISON_STONE, nStateTime, 0, False)
        else if not BaseObject.UnParalysis then
          BaseObject.MakePosion(POISON_STONE, nStateTime, 0, False);

        SendCustomEffect(BaseObject);
      end;
    2:
      begin
        if QuestActionInfo.nParam3 = 0 then
          BaseObject.MakeFrozen(nStateTime, False)
        else if (not BaseObject.UnFrozen) then
          BaseObject.MakeFrozen(nStateTime, False);

        SendCustomEffect(BaseObject);
      end;
    3:
      begin
        if QuestActionInfo.nParam3 = 0 then
          BaseObject.OpenCobwebWinding(nStateTime)
        else if (not BaseObject.UnCobwebWinding) then
          BaseObject.OpenCobwebWinding(nStateTime);

        SendCustomEffect(BaseObject);
      end;
    4:
      begin
        if QuestActionInfo.nParam3 = 0 then
          BaseObject.MakePosion(POISON_DAMAGEARMOR, nStateTime, 0, False)
        else if (not BaseObject.UnPosion) then
          BaseObject.MakePosion(POISON_DAMAGEARMOR, nStateTime, 0, False);

        SendCustomEffect(BaseObject);
      end;
    5:
      begin
        if QuestActionInfo.nParam3 = 0 then
          BaseObject.MakePosion(POISON_DECHEALTH, nStateTime, 0, False)
        else if (not BaseObject.UnPosion) then
          BaseObject.MakePosion(POISON_DECHEALTH, nStateTime, 0, False);

        SendCustomEffect(BaseObject);
      end;

    6:
      begin
        BaseObject.OpenDingShen(nStateTime);
        SendCustomEffect(BaseObject);
      end;
    7:
      begin
        BaseObject.OpenTanHuan(nStateTime);
        SendCustomEffect(BaseObject);
      end;
    8:
      begin
        nRange := Max(0, QuestActionInfo.nParam3);
        if nRange > 0 then
        begin
          BaseObjectList := TList.Create;
          try
            BaseObject.GetMapBaseObjects(BaseObject.m_PEnvir, BaseObject.m_nCurrX, BaseObject.m_nCurrY, nRange, BaseObjectList);

            MagicEvent := nil;

            if nStateTime > 0 then
            begin
              New(MagicEvent);
              FillChar(MagicEvent^, SizeOf(TMagicEvent), #0);
              MagicEvent.FormNPC := True;
              MagicEvent.BaseObjectList_2 := TList.Create;
              MagicEvent.dwStartTick := MyGetTickCount;
              MagicEvent.dwTime := nStateTime * 1000;
              MagicEvent.Events_2 := TList.Create;
              MagicEvent.Envir := BaseObject.m_PEnvir;
            end;

            for I := 0 to BaseObjectList.Count - 1 do
            begin
              Obj := BaseObjectList.Items[I];
              if Obj = nil then
                Continue;
              if Obj.m_boDeath then
                Continue;
              if Obj.m_boGhost then
                Continue;
              if Obj.m_boUnImprison then
                Continue;
              if Obj = BaseObject then
                Continue;
              if Obj.Master = PlayObject then
                Continue;

              Obj.m_dwImprisonTick := MyGetTickCount;
              Obj.m_dwImprisonTime := nStateTime * 1000;
              Obj.m_nImprisonRange := nRange;
              Obj.m_nImprisonPos.X := BaseObject.m_nCurrX;
              Obj.m_nImprisonPos.Y := BaseObject.m_nCurrY;
              Obj.m_boImprison := nStateTime > 0;

              if (nStateTime > 0) and (MagicEvent <> nil) then
                MagicEvent.BaseObjectList_2.Add(Obj);

              SendCustomEffect(Obj);
            end;

            if (nStateTime > 0) and (MagicEvent <> nil) then
            begin
              if (MagicEvent.BaseObjectList_2.Count = 0) then
              begin
                MagicEvent.Events_2.Free;
                MagicEvent.BaseObjectList_2.Free;
                Dispose(MagicEvent);
              end
              else
              begin
                nMinX := BaseObject.m_nCurrX - nRange;
                nMaxX := BaseObject.m_nCurrX + nRange;
                nMinY := BaseObject.m_nCurrY - nRange;
                nMaxY := BaseObject.m_nCurrY + nRange;

                for nX := nMinX to nMaxX do
                begin
                  for nY := nMinY to nMaxY do
                  begin
                    if ((nX < nMaxX) and (nY = nMinY)) or ((nY < nMaxY) and (nX = nMinX)) or (nX = nMaxX) or (nY = nMaxY) then
                    begin
                      Event := TImprisonCurtainEvent.Create(BaseObject.m_PEnvir, nX, nY, ET_HOLYCURTAIN, nStateTime * 1000);
                      g_EventManager.AddEvent(Event);
                      MagicEvent.Events_2.Add(Event);
                    end;
                  end;
                end;

{$IF MULTI_THREAD = 1}
                if g_MultiThreadRun then
                  UserEngine.m_MagicEventList.LockW(4);
                try
{$IFEND}
                  UserEngine.m_MagicEventList.Add(MagicEvent);

{$IF MULTI_THREAD = 1}
                finally
                  if g_MultiThreadRun then
                    UserEngine.m_MagicEventList.UnLockW;
                end;
{$IFEND}
              end;
            end;
          finally
            BaseObjectList.Free;
          end;
        end
        else if (BaseObject.m_TargetCret <> nil) and (not BaseObject.m_TargetCret.m_boDeath) and (not BaseObject.m_TargetCret.m_boGhost) and (not BaseObject.m_TargetCret.m_boUnImprison) then
        begin
          MagicEvent := nil;

          if nStateTime > 0 then
          begin
            New(MagicEvent);
            FillChar(MagicEvent^, SizeOf(TMagicEvent), #0);
            MagicEvent.FormNPC := True;
            MagicEvent.BaseObjectList_2 := TList.Create;
            MagicEvent.dwStartTick := MyGetTickCount;
            MagicEvent.dwTime := nStateTime * 1000;
            MagicEvent.Events_2 := TList.Create;
            MagicEvent.Envir := BaseObject.m_PEnvir;

{$IF MULTI_THREAD = 1}
            if g_MultiThreadRun then
              UserEngine.m_MagicEventList.LockW(4);
            try
{$IFEND}
              UserEngine.m_MagicEventList.Add(MagicEvent);

{$IF MULTI_THREAD = 1}
            finally
              if g_MultiThreadRun then
                UserEngine.m_MagicEventList.UnLockW;
            end;
{$IFEND}
          end;

          BaseObject.m_TargetCret.m_dwImprisonTick := MyGetTickCount;
          BaseObject.m_TargetCret.m_dwImprisonTime := nStateTime * 1000;
          BaseObject.m_TargetCret.m_nImprisonRange := nRange;
          BaseObject.m_TargetCret.m_nImprisonPos.X := BaseObject.m_TargetCret.m_nCurrX;
          BaseObject.m_TargetCret.m_nImprisonPos.Y := BaseObject.m_TargetCret.m_nCurrY;
          BaseObject.m_TargetCret.m_boImprison := nStateTime > 0;

          if (nStateTime > 0) and (MagicEvent <> nil) then
          begin
            MagicEvent.BaseObjectList_2.Add(BaseObject.m_TargetCret);

            Event := TImprisonCurtainEvent.Create(BaseObject.m_PEnvir, BaseObject.m_TargetCret.m_nCurrX - 1, BaseObject.m_TargetCret.m_nCurrY, ET_HOLYCURTAIN, nStateTime * 1000);
            g_EventManager.AddEvent(Event);
            MagicEvent.Events_2.Add(Event);

            Event := TImprisonCurtainEvent.Create(BaseObject.m_PEnvir, BaseObject.m_TargetCret.m_nCurrX + 1, BaseObject.m_TargetCret.m_nCurrY, ET_HOLYCURTAIN, nStateTime * 1000);
            g_EventManager.AddEvent(Event);
            MagicEvent.Events_2.Add(Event);

            Event := TImprisonCurtainEvent.Create(BaseObject.m_PEnvir, BaseObject.m_TargetCret.m_nCurrX, BaseObject.m_TargetCret.m_nCurrY - 1, ET_HOLYCURTAIN, nStateTime * 1000);
            g_EventManager.AddEvent(Event);
            MagicEvent.Events_2.Add(Event);

            Event := TImprisonCurtainEvent.Create(BaseObject.m_PEnvir, BaseObject.m_TargetCret.m_nCurrX, BaseObject.m_TargetCret.m_nCurrY + 1, ET_HOLYCURTAIN, nStateTime * 1000);
            g_EventManager.AddEvent(Event);
            MagicEvent.Events_2.Add(Event);
          end;
        end;
      end;
    9:
      begin
        BaseObject.m_dwUnImprisonTick := MyGetTickCount();
        BaseObject.m_dwUnImprisonTime := nStateTime * 1000;
        BaseObject.m_boUnImprison := True;

        SendCustomEffect(BaseObject);
      end;
    10:
      begin
        BaseObject.m_dwAbsorbHPTick := MyGetTickCount();
        BaseObject.m_dwAbsorbHPTime := nStateTime * 1000;
        BaseObject.m_nAbsorbHPRate := Min(Max(0, QuestActionInfo.nParam3), 100);
        BaseObject.m_nAbsorbHPValue := Max(0, QuestActionInfo.nParam4);
        BaseObject.m_boAbsorbHP := True;
        SendCustomEffect(BaseObject);
      end;
    11:
      begin
        BaseObject.m_dwAbsorbMPTick := MyGetTickCount();
        BaseObject.m_dwAbsorbMPTime := nStateTime * 1000;
        BaseObject.m_nAbsorbMPRate := Min(Max(0, QuestActionInfo.nParam3), 100);
        BaseObject.m_nAbsorbMPValue := Max(0, QuestActionInfo.nParam4);
        BaseObject.m_boAbsorbMP := True;
        SendCustomEffect(BaseObject);
      end;
    12:
      begin
        nRange := Max(0, QuestActionInfo.nParam3);
        if nRange > 0 then
        begin
          MagicEvent := nil;

          if nStateTime > 0 then
          begin
            New(MagicEvent);
            FillChar(MagicEvent^, SizeOf(TMagicEvent), #0);
            MagicEvent.FormNPC := True;
            MagicEvent.BaseObjectList_2 := TList.Create;
            MagicEvent.dwStartTick := MyGetTickCount;
            MagicEvent.dwTime := nStateTime * 1000;
            MagicEvent.Events_2 := TList.Create;
            MagicEvent.Envir := BaseObject.m_PEnvir;
          end;

          BaseObject.m_dwImprisonTick := MyGetTickCount;
          BaseObject.m_dwImprisonTime := nStateTime * 1000;
          BaseObject.m_nImprisonRange := nRange;
          BaseObject.m_nImprisonPos.X := BaseObject.m_nCurrX;
          BaseObject.m_nImprisonPos.Y := BaseObject.m_nCurrY;
          BaseObject.m_boImprison := nStateTime > 0;

          if (nStateTime > 0) and (MagicEvent <> nil) then
          begin
            MagicEvent.BaseObjectList_2.Add(BaseObject);

            SendCustomEffect(BaseObject);

            nMinX := BaseObject.m_nCurrX - nRange;
            nMaxX := BaseObject.m_nCurrX + nRange;
            nMinY := BaseObject.m_nCurrY - nRange;
            nMaxY := BaseObject.m_nCurrY + nRange;

            for nX := nMinX to nMaxX do
            begin
              for nY := nMinY to nMaxY do
              begin
                if ((nX < nMaxX) and (nY = nMinY)) or ((nY < nMaxY) and (nX = nMinX)) or (nX = nMaxX) or (nY = nMaxY) then
                begin
                  Event := TImprisonCurtainEvent.Create(BaseObject.m_PEnvir, nX, nY, ET_HOLYCURTAIN, nStateTime * 1000);
                  g_EventManager.AddEvent(Event);
                  MagicEvent.Events_2.Add(Event);
                end;
              end;
            end;

{$IF MULTI_THREAD = 1}
            if g_MultiThreadRun then
              UserEngine.m_MagicEventList.LockW(4);
            try
{$IFEND}
              UserEngine.m_MagicEventList.Add(MagicEvent);
{$IF MULTI_THREAD = 1}
            finally
              if g_MultiThreadRun then
                UserEngine.m_MagicEventList.UnLockW;
            end;
{$IFEND}
          end;
        end;
      end;
    13:
      begin
        BaseObject.m_nBloodLossTimeLeft := nStateTime; // 掉血剩余时间
        BaseObject.m_nBloodLossPoint := QuestActionInfo.nParam3; // 掉血值
        BaseObject.m_nBloodLossTimeInterval := QuestActionInfo.nParam4 * 1000;
      end;
    14:
      begin
        if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
        begin
          SmartObject := TSmartObject(BaseObject);
          SmartObject.m_dwCanSpellStateTick := MyGetTickCount + nStateTime * 1000;
          if nStateTime = 0 then
            SmartObject.m_boCanSpellState := True
          else
            SmartObject.m_boCanSpellState := False;
        end;
      end;
  end;
end;

