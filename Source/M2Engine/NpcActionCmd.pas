procedure ActionOfRecallSelf(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);

  procedure GetCopySelfPos(var nCurrX, nCurrY: Integer); // 使用分身术时，获取分身的坐标
  var
    I, II, nX, nY: Integer;
  begin
    nCurrX := BaseObject.m_nCurrX;
    nCurrY := BaseObject.m_nCurrY;
    for I := 5 downto 1 do
    begin
      if BaseObject.m_PEnvir.GetNextPosition(BaseObject.m_nCurrX, BaseObject.m_nCurrY, BaseObject.m_btDirection, I, nX, nY) and BaseObject.m_PEnvir.CanWalk(nX, nY, True) then
      begin
        BaseObject.m_btDirection := GetNextDirection(BaseObject.m_nCurrX, BaseObject.m_nCurrY, nX, nY);
        nCurrX := nX;
        nCurrY := nY;
        Exit;
      end;
    end;

    for I := 5 downto 1 do
    begin
      for II := DR_UP to DR_UPLEFT do
      begin
        if II <> BaseObject.m_btDirection then
        begin
          if BaseObject.m_PEnvir.GetNextPosition(BaseObject.m_nCurrX, BaseObject.m_nCurrY, II, I, nX, nY) and BaseObject.m_PEnvir.CanWalk(nX, nY, True) then
          begin
            BaseObject.m_btDirection := GetNextDirection(BaseObject.m_nCurrX, BaseObject.m_nCurrY, nX, nY);
            nCurrX := nX;
            nCurrY := nY;
            Exit;
          end;
        end;
      end;
    end;
  end;

var
  I, nTime, nCount, nValueRate, nBodyColor, nDressShape, nWeaponShape, nX, nY: Integer;
  nTempX, nTempY: Integer;
  sName: string;
  CopyMon: TBaseObject;
begin
  nTime := QuestActionInfo.nParam1;
  nCount := QuestActionInfo.nParam2;
  nValueRate := QuestActionInfo.nParam3;

  if QuestActionInfo.sParam4 = '' then
    nBodyColor := 255
  else
    nBodyColor := QuestActionInfo.nParam4;

  nDressShape := QuestActionInfo.nParam5;
  nWeaponShape := QuestActionInfo.nParam6;
  nX := QuestActionInfo.nParam7;
  nY := QuestActionInfo.nParam8;

  if nValueRate <= 0 then
    nValueRate := 100;

  if nTime <= 0 then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (not (nBodyColor in [0..255])) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  sName := PlayObject.m_sCharName;
  for I := 0 to nCount - 1 do
  begin
    if ((nX <= 0) and (nY <= 0)) or (not BaseObject.m_PEnvir.CanWalk(nX, nY, True)) then
    begin
      GetCopySelfPos(nTempX, nTempY);
    end
    else
    begin
      nTempX := nX;
      nTempY := nY;
    end;

    CopyMon := BaseObject.MakeCopySelf(sName, nTempX, nTempY, 0, nTime, nValueRate);

    if (TSmartObject(CopyMon).m_UseItems[U_DRESS].wIndex > 0) then
    begin
      TSmartObject(CopyMon).m_UseItems[U_DRESS].wNewShape := nDressShape;
      TSmartObject(CopyMon).m_UseItems[U_FASHIONDRESS].wNewShape := nDressShape;
    end;

    if (TSmartObject(CopyMon).m_UseItems[U_WEAPON].wIndex > 0) then
    begin
      TSmartObject(CopyMon).m_UseItems[U_WEAPON].wNewShape := nWeaponShape;
      TSmartObject(CopyMon).m_UseItems[U_FASHIONWEAPON].wNewShape := nDressShape;
    end;

    TSmartObject(CopyMon).m_btBodyColor := nBodyColor;
    CopyMon.m_dwChangeBodyColorTime := 0;
    CopyMon.m_dwStartChangeBodyColor := MyGetTickCount;
  end;
end;

procedure ActionOfSendTopMsg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMsg: string;
  I, nFColor, nBColor, nMode: Integer;
  OnlineObject: TPlayObject;
begin
  nFColor := QuestActionInfo.nParam1;
  nBColor := QuestActionInfo.nParam2;
  nMode := StrToIntDef(QuestActionInfo.sParam4, -1);
  if (nFColor < 0) or (nFColor > 255) or (nBColor < 0) or (nBColor > 255) or (nMode < 0) or (nMode > 4) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
  sMsg := QuestActionInfo.sParam3;
  sMsg := AnsiReplaceText(sMsg, '%s', PlayObject.m_sCharName);
  sMsg := AnsiReplaceText(sMsg, '%x', IntToStr(PlayObject.m_nCurrX));
  sMsg := AnsiReplaceText(sMsg, '%y', IntToStr(PlayObject.m_nCurrY));
  if PlayObject.m_PEnvir <> nil then
    sMsg := AnsiReplaceText(sMsg, '%m', PlayObject.m_PEnvir.sMapDesc)
  else
    sMsg := AnsiReplaceText(sMsg, '%m', '????');
  sMsg := AnsiReplaceText(sMsg, '%d', Npc.m_sCharName);
  case nMode of
    0:
      PlayObject.SendMoveMsg(sMsg, nFColor, nBColor, 20, 1, 11, 60);
    1:
      UserEngine.SendMoveMsg(sMsg, nFColor, nBColor, 20, 1, 11, 60);
    2:
      begin
        if PlayObject.m_MyGuild <> nil then
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.LockR(80);
          try
{$IFEND}
            for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
            begin
              OnlineObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
              if (OnlineObject <> nil) and (not OnlineObject.m_boGhost) and (not OnlineObject.m_boOffLine) and (not OnlineObject.m_boDummyObject) and (OnlineObject.m_MyGuild = PlayObject.m_MyGuild) then
              begin
                OnlineObject.SendMoveMsg(sMsg, nFColor, nBColor, 20, 1, 11, 60);
              end;
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              UserEngine.m_PlayObjectList.UnLockR;
          end;
{$IFEND}
        end;
      end;
    3:
      ;
    4:
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          UserEngine.m_PlayObjectList.LockR(81);
        try
{$IFEND}
          for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
          begin
            OnlineObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
            if (OnlineObject <> nil) and (not OnlineObject.m_boGhost) and (not OnlineObject.m_boOffLine) and (not OnlineObject.m_boDummyObject) and (OnlineObject.m_PEnvir = PlayObject.m_PEnvir) then
            begin
              OnlineObject.SendMoveMsg(sMsg, nFColor, nBColor, 20, 1, 11, 60);
            end;
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.UnLockR;
        end;
{$IFEND}
      end;
  end;
end;

procedure ActionOfChangeSlaveLevel(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  cMethod: Char;
  SlaveObject: TBaseObject;
  nSlaveLevel: Integer;
  sSlaveName: string;
  sCharName: string;
begin
  sSlaveName := QuestActionInfo.sParam1;
  nSlaveLevel := QuestActionInfo.nParam3;

  if (QuestActionInfo.sParam2 = '') or (nSlaveLevel < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if sSlaveName = '' then
  begin
    // ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  sSlaveName := DelNumber(sSlaveName);
  cMethod := QuestActionInfo.sParam2[1];
  for I := 0 to BaseObject.m_SlaveList.Count - 1 do
  begin
    SlaveObject := TBaseObject(BaseObject.m_SlaveList.Items[I]);
    sCharName := SlaveObject.m_sCharName;

    sCharName := DelNumber(sCharName);

    if (sSlaveName = '*') or SameText(sCharName, sSlaveName) then
    begin
      case cMethod of
        '+':
          begin
            if SlaveObject.m_btSlaveExpLevel + nSlaveLevel <= SLAVEMAXLEVEL { (SlaveObject.m_btSlaveMakeLevel * 2 + 1) } then
            begin
              SlaveObject.m_btSlaveExpLevel := SlaveObject.m_btSlaveExpLevel + nSlaveLevel;
            end
            else
            begin
              SlaveObject.m_btSlaveExpLevel := SLAVEMAXLEVEL; // (SlaveObject.m_btSlaveMakeLevel * 2 + 1);
            end;
            SlaveObject.RecalcAbilitys();
            SlaveObject.RefNameColor();
          end;
        '-':
          begin
            if SlaveObject.m_btSlaveExpLevel > 0 then
            begin
              if SlaveObject.m_btSlaveExpLevel >= nSlaveLevel then
              begin
                SlaveObject.m_btSlaveExpLevel := SlaveObject.m_btSlaveExpLevel - nSlaveLevel;
              end
              else
              begin
                SlaveObject.m_btSlaveExpLevel := 0;
              end;
              SlaveObject.RecalcAbilitys();
              SlaveObject.RefNameColor();
            end;
          end;
        '=':
          begin
            SlaveObject.m_btSlaveExpLevel := Min(SLAVEMAXLEVEL { (SlaveObject.m_btSlaveMakeLevel * 2 + 1) } , nSlaveLevel);
            SlaveObject.RecalcAbilitys();
            SlaveObject.RefNameColor();
          end;
      end;

      if QuestActionInfo.nParam4 = 0 then
      begin
        Break;
      end;
    end;
  end;
end;

procedure ActionOfSetHumAttackMode(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nAttatckMode: Integer;
  nTime: Integer;
  SmartObject: TSmartObject;
  sMapName: string;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nAttatckMode := QuestActionInfo.nParam1;
  nTime := QuestActionInfo.nParam2;
  sMapName := QuestActionInfo.sParam3;
  if Length(sMapName) = 0 then
    sMapName := '*';

  if (nAttatckMode in [HAM_ALL..HAM_NATION]) and (nTime > 0) then
  begin
    if (SmartObject.m_btRaceServer = RC_PLAYOBJECT) and TPlayObject(SmartObject).m_boChangeAttatckMode then
    begin
      TPlayObject(SmartObject).m_btAttatckMode := SmartObject.m_btOldAttatckMode;
      TPlayObject(SmartObject).m_boChangeAttatckMode := False;
    end;

    if (SmartObject.m_btRaceServer = RC_PLAYOBJECT) then
    begin
      TPlayObject(SmartObject).m_boChangeAttatckMode := True;
      TPlayObject(SmartObject).m_dwChangeAttatckModeTick := MyGetTickCount + LongWord(nTime) * 1000;
      TPlayObject(SmartObject).m_sChangeAttatckMapName := sMapName;
    end;

    if (sMapName = '*') or SameText(SmartObject.m_PEnvir.sMapName, sMapName) then
    begin
      SmartObject.m_btOldAttatckMode := SmartObject.m_btAttatckMode;
      SmartObject.m_btAttatckMode := nAttatckMode;

      if (SmartObject.m_btRaceServer = RC_PLAYOBJECT) then
        TPlayObject(SmartObject).SendDefMessage(SM_ATTATCKMODE, SmartObject.m_btAttatckMode, 0, 0, 0, '') // 攻击模式
      else
        THeroObject(SmartObject).SendDefMessage(SM_ATTATCKMODE, SmartObject.m_btAttatckMode, 0, 0, 0, '') // 攻击模式
    end;
  end
  else
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfGetListString(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nPostion: Integer;
  LoadList: TStringList;
  sListFileName, sLineText, sName: string;
begin
  if QuestActionInfo.nParam5 = 0 then
    sListFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    sListFileName := QuestActionInfo.sParam1;

  nPostion := QuestActionInfo.nParam2;
  if nPostion < 0 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if FileExists(sListFileName) then
  begin
    LoadList := TStringList.Create;
    try
      LoadList.LoadFromFile(sListFileName);
    except
      MainOutMessage('loading fail.... => ' + sListFileName);
    end;

    if (nPostion >= 0) and (nPostion < LoadList.Count) then
    begin
      sLineText := Trim(LoadList.Strings[nPostion]);
      if QuestActionInfo.sRawParam4 <> '' then
      begin
        sLineText := GetValidStr3_Ex(sLineText, sName, ':');
        if not (Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, sName, StrToIntDef(sName, 0)) and Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, sLineText, StrToIntDef(sLineText, 0))) then
        begin
          Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
        end;
      end
      else
      begin
        if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, sLineText, StrToIntDef(sLineText, 0)) then
        begin
          Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
        end;
      end;
    end
    else
    begin
      if QuestActionInfo.sRawParam4 <> '' then
      begin
        if not (Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, '', 0) and Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, '', 0)) then
        begin
          Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
        end;
      end
      else
      begin
        if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, '', 0) then
        begin
          Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
        end;
      end;
    end;
    LoadList.Free;
  end
  else
  begin
    MainOutMessage('file not found => ' + sListFileName);
  end;

end;

procedure ActionOfGetUserItemName(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nBoxItemIndex, nMakeIndex: Integer;
  UserItem: pTUserItem;
  SmartObject: TSmartObject;
  StdItem: pTStdItem;
  sUserItemName: string;
  sVar: string;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := BaseObject as TSmartObject
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  sVar := QuestActionInfo.sRawParam2;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if (sVar = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  sUserItemName := '';
  if UserItem <> nil then
  begin
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if StdItem <> nil then
    begin
      if (QuestActionInfo.nParam3 = 0) and (UserItem.btValue[13] = 1) then
        sUserItemName := UserItem.Name;
      if sUserItemName = '' then
        sUserItemName := StdItem.Name;
    end;
  end;

  if StrToIntDef(sVar, -1) >= 0 then
    sVar := 'S' + sVar;

  if not Npc.SetVarValue(PlayObject, sVar, sUserItemName, 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

// 指定宝宝立即叛变的脚本命令

procedure ActionOfGetCallMob(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  SlaveObject: TBaseObject;
  sSlaveName: string;
  sCharName: string;
  nCount: Integer;
begin
  sSlaveName := QuestActionInfo.sParam1;
  nCount := 0;
  sSlaveName := DelNumber(sSlaveName);

  for I := BaseObject.m_SlaveList.Count - 1 downto 0 do
  begin
    SlaveObject := TBaseObject(BaseObject.m_SlaveList.Items[I]);
    sCharName := DelNumber(SlaveObject.m_sCharName);

    if (Length(QuestActionInfo.sParam1) = 0) or (QuestActionInfo.sParam1 = '*') or SameText(sCharName, sSlaveName) then
    begin
      BaseObject.m_SlaveList.Delete(I);
      if SlaveObject is TCopyMon then
      begin
        if QuestActionInfo.nParam3 <> 0 then
        begin
          TCopyMon(SlaveObject).m_boAliveRebelled := True;
          SlaveObject.m_dwMasterRoyaltyTime := 0;
        end
        else
        begin
          SlaveObject.m_Master := nil; // 宝宝叛变，设置为nil 就不认主人了 -- piaoyun 2013-6-23
          SlaveObject.MakeGhost;
        end;
      end
      else
      begin
        SlaveObject.m_Master := nil; // 宝宝叛变，设置为nil 就不认主人了 -- piaoyun 2013-6-23

        if not g_Config.boMasterRoyaltyFullHP then
        begin
          SlaveObject.m_WAbil.HP := SlaveObject.m_WAbil.HP div 10;
        end;

        SlaveObject.RefShowName();

        if (BaseObject.m_btRaceServer = RC_PLAYOBJECT) or ((BaseObject.Master <> nil) and (BaseObject.Master.m_btRaceServer = RC_PLAYOBJECT)) then
        begin
          SlaveObject.RefHumsBB(False);
        end;
      end;

      Inc(nCount);
      if (QuestActionInfo.nParam2 > 0) and (QuestActionInfo.nParam2 = nCount) then
      begin
        Break;
      end;
    end;
  end;
end;

procedure ActionOfKillCallMob(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  nCount: Integer;
  SlaveObject: TBaseObject;
  sSlaveName: string;
  sCharName: string;
begin
  sSlaveName := QuestActionInfo.sParam1;
  nCount := QuestActionInfo.nParam2;

  if sSlaveName = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if nCount <= 0 then
    nCount := 1;

  sSlaveName := DelNumber(sSlaveName);
  for I := BaseObject.m_SlaveList.Count - 1 downto 0 do
  begin
    SlaveObject := TBaseObject(BaseObject.m_SlaveList.Items[I]);
    if nCount <= 0 then
      Break;
    sCharName := SlaveObject.m_sCharName;
    sCharName := DelNumber(sCharName);
    if CompareText(sCharName, sSlaveName) = 0 then
    begin
      SlaveObject.m_WAbil.HP := 0;

      // 修改killcallmob命令杀死BB后不计算给当前攻击玩家 chongchong 2013-11-09
      SlaveObject.bo94 := True;
      SlaveObject.m_CurrTarget := TBaseObject(Npc);

      // 修复人形怪带复活装备，用命令杀不死 chongchong 2013-12-30
      if QuestActionInfo.nParam3 = 1 then
      begin
        SlaveObject.m_Master := nil;
        SlaveObject.MakeGhost;
        BaseObject.m_SlaveList.Delete(I);
      end
      else
      begin
        SlaveObject.m_Master := nil;
        SlaveObject.Die;
      end;

      Dec(nCount);
    end;
  end;
end;

procedure ActionOfChangeItemUpgradeCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nBoxItemIndex, nMakeIndex, nWhere, nCount: Integer;
  nOldCount: Integer;
  cMethod: Char;
  SmartObject: TSmartObject;
  UserItem: pTUserItem;
  LockUpdateItemIndex: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(BaseObject);

    nBoxItemIndex := -1;
    nWhere := -2;
    I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
    if I = 1 then
      nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
    else
      nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

    nCount := QuestActionInfo.nParam3;

    if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;

    if (QuestActionInfo.sParam2 = '') or (not (nCount in [0..255])) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;

    LockUpdateItemIndex := -1;
    UserItem := nil;
    if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

        nMakeIndex := PlayObject.m_ItemBoxItems[nBoxItemIndex];
        if nMakeIndex = 0 then
          Exit;

        for I := 0 to PlayObject.m_ItemList.Count - 1 do
        begin
          if pTUserItem(PlayObject.m_ItemList[I]).MakeIndex = nMakeIndex then
          begin
            UserItem := PlayObject.m_ItemList[I];
            Break;
          end;
        end;
      end;
    end
    else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
    begin
      LockUpdateItemIndex := nWhere;

      UserItem := @SmartObject.m_UseItems[nWhere];
      // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
      begin
        if not g_Config.boCloseNPCNoItemMsg then
          PlayObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
        Exit;
      end;
    end
    else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
    begin
      LockUpdateItemIndex := nWhere;

      UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
      if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
      begin
        if not g_Config.boCloseNPCNoItemMsg then
          SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
        Exit;
      end;
    end
    else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
    begin
      LockUpdateItemIndex := nWhere;

      UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
      if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
      begin
        if not g_Config.boCloseNPCNoItemMsg then
          SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
        Exit;
      end;
    end
    else
    begin
      if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
      begin
        LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

        UserItem := TPlayObject(SmartObject).GetUpdateItem;
      end
      else
      begin
        LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

        for I := 0 to SmartObject.m_ItemList.Count - 1 do
        begin
          if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
          begin
            UserItem := THeroObject(SmartObject).m_LinkItem;
            Break;
          end;
        end;
      end;
    end;

    if UserItem <> nil then
    begin
      cMethod := QuestActionInfo.sParam2[1];
      nOldCount := UserItem.btUpgradeCount;
      case cMethod of
        '+':
          begin
            UserItem.btUpgradeCount := Min(UserItem.btUpgradeCount + nCount, High(Byte));
          end;
        '-':
          begin
            UserItem.btUpgradeCount := Max(UserItem.btUpgradeCount - nCount, 0);
          end;
        '=':
          begin
            UserItem.btUpgradeCount := Min(nCount, High(Byte));
          end;
      end;

      if (nOldCount <> UserItem.btUpgradeCount) then
      begin
        if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
        begin
          if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
          begin
            if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
              TPlayObject(SmartObject).SendUpdateItemUpgradeCount(nBoxItemIndex, UserItem.MakeIndex, True, UserItem.btUpgradeCount)
            else
              TPlayObject(SmartObject).SendUpdateItemUpgradeCount(nWhere, UserItem.MakeIndex, False, UserItem.btUpgradeCount);
          end
          else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(SmartObject).SendUpdateItemUpgradeCount(nWhere, UserItem.MakeIndex, UserItem.btUpgradeCount);
        end;
      end;
    end;
  end;
end;

