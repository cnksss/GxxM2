procedure ActionOfChangeSlaveAppr(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nNewAppr: Integer;
  sCharName, sSlaveName: string;
  AObject: TBaseObject;
begin
  nNewAppr := QuestActionInfo.nParam1;
  sCharName := QuestActionInfo.sParam2;

  if (nNewAppr < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  for I := 0 to BaseObject.m_SlaveList.Count - 1 do
  begin
    AObject := TBaseObject(BaseObject.m_SlaveList.Items[I]);
    sSlaveName := DelNumber(AObject.m_sCharName);
    if (Length(sCharName) = 0) or SameText(sCharName, '*') or (CompareText(sSlaveName, sCharName) = 0) or SameText(AObject.m_sCharName, sCharName) then
    begin
      AObject.m_nChangeAppr := nNewAppr;
      AObject.m_dwChangeApprTick := MyGetTickCount;
      AObject.m_nChangeApprTime := QuestActionInfo.nParam3 * 60;
      AObject.FeatureChanged;
    end;
  end;
end;

procedure ActionOfChangeSlaveAbility(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nAbilityType, nAbilityValue: Integer;
  sCharName, sSlaveName: string;
  AObject: TBaseObject;
begin
  nAbilityType := QuestActionInfo.nParam1;
  nAbilityValue := QuestActionInfo.nParam2;
  sCharName := QuestActionInfo.sParam3;

  if not (nAbilityType in [0..15, 30]) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  for I := 0 to BaseObject.m_SlaveList.Count - 1 do
  begin
    AObject := TBaseObject(BaseObject.m_SlaveList.Items[I]);
    sSlaveName := DelNumber(AObject.m_sCharName);

    if (Length(sCharName) = 0) //
      or SameText(sCharName, '*') //
      or SameText(sSlaveName, sCharName) //
      or SameText(AObject.m_sCharName, sCharName) then
    begin
      AObject.m_boChangeAbility := True;
      AObject.m_ChangeAbility.SlaveExpLevel := AObject.m_btSlaveExpLevel;

      case nAbilityType of
        0:
          begin
            AObject.m_ChangeAbility.HP := nAbilityValue;
            AObject.m_ChangeAbility.boHPPercentage := False;
          end;
        1:
          begin
            AObject.m_ChangeAbility.MaxHP := nAbilityValue;
            AObject.m_ChangeAbility.boMaxHPPercentage := False;
          end;
        2:
          begin
            AObject.m_ChangeAbility.MP := nAbilityValue;
            AObject.m_ChangeAbility.boMPPercentage := False;
          end;
        3:
          begin
            AObject.m_ChangeAbility.MaxMP := nAbilityValue;
            AObject.m_ChangeAbility.boMaxMPPercentage := False;
          end;
        4:
          begin
            AObject.m_ChangeAbility.AC1 := nAbilityValue;
            AObject.m_ChangeAbility.boAC1Percentage := False;
          end;
        5:
          begin
            AObject.m_ChangeAbility.AC2 := nAbilityValue;
            AObject.m_ChangeAbility.boAC2Percentage := False;
          end;
        6:
          begin
            AObject.m_ChangeAbility.MAC1 := nAbilityValue;
            AObject.m_ChangeAbility.boMAC1Percentage := False;
          end;
        7:
          begin
            AObject.m_ChangeAbility.MAC2 := nAbilityValue;
            AObject.m_ChangeAbility.boMAC2Percentage := False;
          end;
        8:
          begin
            AObject.m_ChangeAbility.DC1 := nAbilityValue;
            AObject.m_ChangeAbility.boDC1Percentage := False;
          end;
        9:
          begin
            AObject.m_ChangeAbility.DC2 := nAbilityValue;
            AObject.m_ChangeAbility.boDC2Percentage := False;
          end;
        10:
          begin
            AObject.m_ChangeAbility.MC1 := nAbilityValue;
            AObject.m_ChangeAbility.boMC1Percentage := False;
          end;
        11:
          begin
            AObject.m_ChangeAbility.MC2 := nAbilityValue;
            AObject.m_ChangeAbility.boMC2Percentage := False;
          end;
        12:
          begin
            AObject.m_ChangeAbility.SC1 := nAbilityValue;
            AObject.m_ChangeAbility.boSC1Percentage := False;
          end;
        13:
          begin
            AObject.m_ChangeAbility.SC2 := nAbilityValue;
            AObject.m_ChangeAbility.boSC2Percentage := False;
          end;
        14:
          begin
            AObject.m_ChangeAbility.NextHitTime := nAbilityValue;
            AObject.m_ChangeAbility.boNextHitTimePercentage := False;
          end;
        15:
          begin
            AObject.m_ChangeAbility.WalkSpeed := nAbilityValue;
            AObject.m_ChangeAbility.boWalkSpeedPercentage := False;
          end;
        30:
          begin
            AObject.m_ChangeAbility.StartTick := MyGetTickCount;
            AObject.m_ChangeAbility.ValidTime := nAbilityValue;
          end;
      end;
    end;
  end;
end;

procedure ActionOfChangeSlaveAbilityEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, tmpAbilityType, tmpAbilityValue, tmpProcessType, tmpBaseValue: Integer;
  tmpCharName, tmpSlaveName: string;
  tmpObject: TBaseObject;
  tmpQuestActionInfo: pTQuestActionInfo;
begin
  tmpAbilityType := QuestActionInfo.nParam1;
  tmpAbilityValue := QuestActionInfo.nParam2;
  tmpProcessType := QuestActionInfo.nParam3;
  tmpCharName := QuestActionInfo.sParam4;

  if not (tmpAbilityType in [0..15, 30]) or not (tmpProcessType in [0, 1]) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  tmpQuestActionInfo := AllocMem(SizeOf(TQuestActionInfo));
  for I := 0 to BaseObject.m_SlaveList.Count - 1 do
  begin
    tmpObject := TBaseObject(BaseObject.m_SlaveList.Items[I]);
    if tmpObject = nil then
      Continue;

    tmpSlaveName := DelNumber(tmpObject.m_sCharName);
    if (Length(tmpCharName) = 0) //
      or SameText(tmpCharName, '*') //
      or SameText(tmpSlaveName, tmpCharName) //
      or SameText(tmpObject.m_sCharName, tmpCharName) then
    begin
      if tmpProcessType = 1 then
      begin
        tmpBaseValue := 0;
        case tmpAbilityType of
          0:
            tmpBaseValue := tmpObject.m_WAbil.HP;
          1:
            tmpBaseValue := tmpObject.m_WAbil.MaxHP;
          2:
            tmpBaseValue := tmpObject.m_WAbil.MP;
          3:
            tmpBaseValue := tmpObject.m_WAbil.MaxMP;
          4:
            tmpBaseValue := tmpObject.m_WAbil.AC1;
          5:
            tmpBaseValue := tmpObject.m_WAbil.AC2;
          6:
            tmpBaseValue := tmpObject.m_WAbil.MAC1;
          7:
            tmpBaseValue := tmpObject.m_WAbil.MAC2;
          8:
            tmpBaseValue := tmpObject.m_WAbil.DC1;
          9:
            tmpBaseValue := tmpObject.m_WAbil.DC2;
          10:
            tmpBaseValue := tmpObject.m_WAbil.MC1;
          11:
            tmpBaseValue := tmpObject.m_WAbil.MC2;
          12:
            tmpBaseValue := tmpObject.m_WAbil.SC1;
          13:
            tmpBaseValue := tmpObject.m_WAbil.SC2;
          14:
            tmpBaseValue := tmpObject.m_nNextHitTime;
          15:
            tmpBaseValue := tmpObject.m_nWalkSpeed;
          30:
            tmpBaseValue := tmpObject.m_ChangeAbility.ValidTime;
        end;
        tmpAbilityValue := Round(tmpBaseValue * (tmpAbilityValue / 100));
      end;

      ZeroMemory(tmpQuestActionInfo, SizeOf(TQuestActionInfo));
      tmpQuestActionInfo.nParam1 := tmpAbilityType;
      tmpQuestActionInfo.nParam2 := tmpAbilityValue;
      tmpQuestActionInfo.nParam3 := tmpProcessType;
      tmpQuestActionInfo.sParam4 := tmpCharName;
      ActionOfChangeSlaveAbility(Npc, BaseObject, PlayObject, tmpQuestActionInfo, boSendNpcSay, boBreak);
    end;
  end;
  FreeMemory(tmpQuestActionInfo);
end;

procedure ActionOfRecalcSlaveAbility(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  sCharName, sSlaveName: string;
  AObject: TBaseObject;
begin
  sCharName := QuestActionInfo.sParam1;

  for I := 0 to BaseObject.m_SlaveList.Count - 1 do
  begin
    AObject := TBaseObject(BaseObject.m_SlaveList.Items[I]);
    if AObject = nil then
      Continue;

    sSlaveName := DelNumber(AObject.m_sCharName);
    if (Length(sCharName) = 0) or SameText(sSlaveName, sCharName) or SameText(AObject.m_sCharName, sCharName) then
    begin
      AObject.m_boChangeAbilitySetHMP := True;
      AObject.RecalcAbilitys;
      AObject.m_boChangeAbilitySetHMP := False;
    end;
  end;
end;

procedure ActionOfChangeMonAbility(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nAbilityType, nAbilityValue, nRange, nX, nY: Integer;
  sMonName, sMethod: string;
  AObject: TBaseObject;
  MonList: TList;
  IsAllMon, IsRange: Boolean;
  Envir: TEnvirnoment;
  IsPercentage: Boolean;
  I64: Int64;
begin
  if (QuestActionInfo.sRawParam1 = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  sMonName := QuestActionInfo.sParam2;
  if (sMonName = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;
  IsAllMon := sMonName = '*';

  nAbilityType := QuestActionInfo.nParam3;
  sMethod := QuestActionInfo.sParam4;
  nAbilityValue := QuestActionInfo.nParam5;
  IsPercentage := QuestActionInfo.nParam6 = 1;
  nX := QuestActionInfo.nParam7;
  nY := QuestActionInfo.nParam8;
  nRange := QuestActionInfo.nParam9;

  if (nX = 0) and (nY = 0) and (nRange = 0) then
    nRange := -1;

  if not (nAbilityType in [0..15, 30]) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if sMethod = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if SameText(QuestActionInfo.sParam1, 'SELF') then
  begin
    Envir := BaseObject.m_PEnvir;
  end
  else
  begin
    Envir := nil;
    if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
      Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
    if Envir = nil then
      Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  end;

  if Envir <> nil then
  begin
    MonList := TList.Create;
    try
      UserEngine.GetMapMonster(Envir, MonList);
      for I := 0 to MonList.Count - 1 do
      begin
        AObject := TBaseObject(MonList.Items[I]);

        if AObject = nil then
          Continue;

        if AObject.m_Master <> nil then
          Continue;

        // 在调用 ClearMapMon时，会干掉城堡中的守卫等 chongchong 2018-01-26
        if AObject.m_Castle <> nil then
          Continue;

        if AObject.m_boDeath or AObject.m_boGhost then
          Continue;

        if nRange >= 0 then
        begin
          IsRange := (abs(nX - AObject.m_nCurrX) <= nRange) and (abs(nY - AObject.m_nCurrY) <= nRange);
          if not IsRange then
            Continue;
        end;

        if IsAllMon or SameText(sMonName, AObject.m_sCharName) then
        begin
          AObject.m_boChangeAbility := True;
          AObject.m_ChangeAbility.SlaveExpLevel := 0; // Mon.m_btSlaveExpLevel;

          case sMethod[1] of
            '=':
              begin
                case nAbilityType of
                  0:
                    begin
                      AObject.m_ChangeAbility.HP := nAbilityValue;
                      AObject.m_ChangeAbility.boHPPercentage := IsPercentage;
                    end;
                  1:
                    begin
                      AObject.m_ChangeAbility.MaxHP := nAbilityValue;
                      AObject.m_ChangeAbility.boMaxHPPercentage := IsPercentage;
                    end;
                  2:
                    begin
                      AObject.m_ChangeAbility.MP := nAbilityValue;
                      AObject.m_ChangeAbility.boMPPercentage := IsPercentage;
                    end;
                  3:
                    begin
                      AObject.m_ChangeAbility.MaxMP := nAbilityValue;
                      AObject.m_ChangeAbility.boMaxMPPercentage := IsPercentage;
                    end;
                  4:
                    begin
                      AObject.m_ChangeAbility.AC1 := nAbilityValue;
                      AObject.m_ChangeAbility.boAC1Percentage := IsPercentage;
                    end;
                  5:
                    begin
                      AObject.m_ChangeAbility.AC2 := nAbilityValue;
                      AObject.m_ChangeAbility.boAC2Percentage := IsPercentage;
                    end;
                  6:
                    begin
                      AObject.m_ChangeAbility.MAC1 := nAbilityValue;
                      AObject.m_ChangeAbility.boMAC1Percentage := IsPercentage;
                    end;
                  7:
                    begin
                      AObject.m_ChangeAbility.MAC2 := nAbilityValue;
                      AObject.m_ChangeAbility.boMAC2Percentage := IsPercentage;
                    end;
                  8:
                    begin
                      AObject.m_ChangeAbility.DC1 := nAbilityValue;
                      AObject.m_ChangeAbility.boDC1Percentage := IsPercentage;
                    end;
                  9:
                    begin
                      AObject.m_ChangeAbility.DC2 := nAbilityValue;
                      AObject.m_ChangeAbility.boDC2Percentage := IsPercentage;
                    end;
                  10:
                    begin
                      AObject.m_ChangeAbility.MC1 := nAbilityValue;
                      AObject.m_ChangeAbility.boMC1Percentage := IsPercentage;
                    end;
                  11:
                    begin
                      AObject.m_ChangeAbility.MC2 := nAbilityValue;
                      AObject.m_ChangeAbility.boMC2Percentage := IsPercentage;
                    end;
                  12:
                    begin
                      AObject.m_ChangeAbility.SC1 := nAbilityValue;
                      AObject.m_ChangeAbility.boSC1Percentage := IsPercentage;
                    end;
                  13:
                    begin
                      AObject.m_ChangeAbility.SC2 := nAbilityValue;
