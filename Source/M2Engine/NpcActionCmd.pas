  UserMagic: pTUserMagic;
  nTranPoint: Integer;
  cMethod: Char;
  SmartObject: TSmartObject;
  IsMsgSend: Boolean;
begin
  try
    if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
      SmartObject := TSmartObject(BaseObject)
    else
      Exit;

    nTranPoint := Str_ToInt(QuestActionInfo.sParam3, 0);
    if nTranPoint < 0 then
    begin
      Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
      Exit;
    end;

    sMagicName := QuestActionInfo.sParam1;
    cMethod := QuestActionInfo.sParam2[1];

    for I := 0 to SmartObject.m_MagicList.Count - 1 do
    begin
      UserMagic := SmartObject.m_MagicList.Items[I];
      if SameText(UserMagic.MagicInfo.sMagicName, sMagicName) then
      begin
        case cMethod of
          '=':
            begin
              if nTranPoint >= 0 then
              begin
                UserMagic.nTranPoint := nTranPoint;
              end;
            end;
          '-':
            begin
              if UserMagic.nTranPoint >= nTranPoint then
              begin
                Dec(UserMagic.nTranPoint, nTranPoint);
              end
              else
              begin
                UserMagic.nTranPoint := 0;
              end;
            end;
          '+':
            begin
              Inc(UserMagic.nTranPoint, nTranPoint);
            end;
        end;

        IsMsgSend := False;
        for II := 1 to 9 do
        begin
          if (UserMagic.btLevel < UserMagic.MagicInfo.btTrainLv) and (UserMagic.MagicInfo.TrainLevel[UserMagic.btLevel] <= BaseObject.m_Abil.Level) then
          begin
            if BaseObject.CheckMagicLevelup(UserMagic) then
              IsMsgSend := True
            else
              Break;
          end
          else
          begin
            Break;
          end;
        end;

        if not IsMsgSend then
        begin
          BaseObject.SendDelayMsg(BaseObject, RM_MAGIC_LVEXP, 0, UserMagic.MagicInfo.wMagicId, MakeWord(UserMagic.btLevel, UserMagic.btNewLevel), UserMagic.nTranPoint, IntToStr(Integer(UserMagic.MagicAttr)), 100);
        end;

        Break;
      end;
    end;
  except
    MainOutMessage('[Exception] TNormNpc:ActionOfChangeTranPoint');
  end;
end;

