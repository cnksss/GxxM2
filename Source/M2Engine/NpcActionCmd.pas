procedure ActionOfSendMsg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMsg: string;
  nFColor, nBColor: Integer;
begin
  nFColor := StrToIntDef(QuestActionInfo.sParam3, -1);
  nBColor := StrToIntDef(QuestActionInfo.sParam4, -1);

  if (nFColor in [0..255]) and ((nBColor in [0..255])) then
    sMsg := QuestActionInfo.sParam2
  else
    sMsg := QuestActionInfo.sSubParam1;

  Npc.GetVarValue(PlayObject, sMsg, sMsg);

  if Npc.m_boMapEvent then
  begin
    sMsg := AnsiReplaceText(sMsg, '%s', PlayObject.m_sScatterItemName);
    sMsg := AnsiReplaceText(sMsg, '%x', IntToStr(PlayObject.m_nScatterItemX));
    sMsg := AnsiReplaceText(sMsg, '%y', IntToStr(PlayObject.m_nScatterItemY));
  end
  else
  begin
    sMsg := AnsiReplaceText(sMsg, '%s', PlayObject.m_sCharName);
    sMsg := AnsiReplaceText(sMsg, '%x', IntToStr(PlayObject.m_nCurrX));
    sMsg := AnsiReplaceText(sMsg, '%y', IntToStr(PlayObject.m_nCurrY));
  end;

  if PlayObject.m_PEnvir <> nil then
    sMsg := AnsiReplaceText(sMsg, '%m', PlayObject.m_PEnvir.sMapDesc)
  else
    sMsg := AnsiReplaceText(sMsg, '%m', '????');
  sMsg := AnsiReplaceText(sMsg, '%d', Npc.m_sCharName);

  sMsg := AnsiReplaceText(sMsg, '%Item', PlayObject.m_sLackFoundryItem);
  PlayObject.GetItemInfo(sMsg);

  // MainOutMessage('ActionOfLineMsg m_sLackFoundryItem:'+PlayObject.m_sLackFoundryItem);
  if (nFColor in [0..255]) and ((nBColor in [0..255])) then
  begin
    case QuestActionInfo.nParam1 of
      0:
        UserEngine.SendBroadCastMsg(sMsg, nFColor, nBColor, t_System, mfSendMsg);
      1:
        UserEngine.SendBroadCastMsg('(*) ' + sMsg, nFColor, nBColor, t_System, mfSendMsg);
      2:
        UserEngine.SendBroadCastMsg('[' + Npc.m_sCharName + ']' + sMsg, nFColor, nBColor, t_System, mfSendMsg);
      3:
        UserEngine.SendBroadCastMsg('[' + PlayObject.m_sCharName + ']' + sMsg, nFColor, nBColor, t_System, mfSendMsg);
      4:
        Npc.ProcessSayMsg(sMsg);
      5..7:
        PlayObject.SysMsg(sMsg, nFColor, nBColor, t_Say);
    else
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    end;
  end
  else
  begin
    if PlayObject = nil then
      Exit;

    // 修复报错????????? 2013-12-31
    try
      case QuestActionInfo.nParam1 of
        0:
          UserEngine.SendBroadCastMsg(sMsg, t_System, mfSendMsg);
        1:
          UserEngine.SendBroadCastMsg('(*) ' + sMsg, t_System, mfSendMsg);
        2:
          UserEngine.SendBroadCastMsg('[' + Npc.m_sCharName + ']' + sMsg, t_System, mfSendMsg);
        3:
          UserEngine.SendBroadCastMsg('[' + PlayObject.m_sCharName + ']' + sMsg, t_System, mfSendMsg);
        4:
          Npc.ProcessSayMsg(sMsg);
        5:
          PlayObject.SysMsg(sMsg, c_Red, t_Say);
        6:
          PlayObject.SysMsg(sMsg, c_Green, t_Say);
        7:
          PlayObject.SysMsg(sMsg, c_Blue, t_Say);
      else
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      end;
    except
    end;
  end;
end;

