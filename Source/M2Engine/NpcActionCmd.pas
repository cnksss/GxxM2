                      AObject.m_ChangeAbility.DC2 := I64;
                      AObject.m_ChangeAbility.boDC2Percentage := IsPercentage;
                    end;
                  10:
                    begin
                      I64 := AObject.m_ChangeAbility.MC1 + nAbilityValue;
                      if I64 >= High(Integer) then
                        I64 := High(Integer);

                      AObject.m_ChangeAbility.MC1 := I64;
                      AObject.m_ChangeAbility.boMC1Percentage := IsPercentage;
                    end;
                  11:
                    begin
                      I64 := AObject.m_ChangeAbility.MC2 + nAbilityValue;
                      if I64 >= High(Integer) then
