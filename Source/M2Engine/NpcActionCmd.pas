procedure ActionOfHumanDropUseItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nWhere: Integer;
  UserItem: pTUserItem;
  SmartObject: TSmartObject;
  StdItem: pTStdItem;
begin
  nWhere := QuestActionInfo.nParam1;

  if not (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
    Exit;
  SmartObject := TSmartObject(BaseObject);

  if (nWhere > U_GODBLESSITEM12) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := nil;

  if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end;

  if UserItem <> nil then
  begin
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);

    if SmartObject.DropItemDown(UserItem, 4, False, nil, nil, 1) then // SmartObject
    begin
      { TODO -ochongchong -c修改 : 去掉特定装备后，删除特定技能 【2013-08-27】 }
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        TPlayObject(SmartObject).ProcessUseItemSkill(nWhere, StdItem, False);
        TPlayObject(SmartObject).SendDelItem(UserItem);
      end
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
      begin
        THeroObject(SmartObject).SendDelItem(UserItem);
      end;

      UserItem.wIndex := 0;
      SmartObject.FeatureChanged;
    end;
  end;
end;

procedure ActionOfWhile(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  cMethod: Char;
begin
  if QuestActionInfo.sRawParam1 = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.sRawParam2 = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  // if QuestActionInfo.sRawParam3 = '' then
  // begin
  // Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
  // Exit;
  // end;

  cMethod := QuestActionInfo.sRawParam2[1];

  case cMethod of
    '=':
      boBreak := QuestActionInfo.nParam1 = QuestActionInfo.nParam3;
    '>':
      boBreak := QuestActionInfo.nParam1 > QuestActionInfo.nParam3;
    '<':
      boBreak := QuestActionInfo.nParam1 < QuestActionInfo.nParam3;
    '&':
      boBreak := QuestActionInfo.sParam1 = QuestActionInfo.sParam3;
    '!':
      boBreak := QuestActionInfo.sParam1 <> QuestActionInfo.sParam3;
    '|':
      boBreak := Pos(QuestActionInfo.sParam1, QuestActionInfo.sParam3) > 0;
  else
    boBreak := QuestActionInfo.nParam1 >= QuestActionInfo.nParam3;
  end;

  boBreak := not boBreak;
end;

