procedure ActionOfGiveStateItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  sItemName: string;
  nItemCount: Integer;
  HeroObject: THeroObject;
  OverLapItem: pTUserItem;
  OverLapItemsCount: Integer;
  nState0, nState1, nState2, nState3, nState4, nState5, nState6: Integer;
  BindValues: Byte;
  OldDura: Word;

  procedure AddBindState(Item: pTUserItem);
  begin
    Item.boIsBind := True;
    Item.btBindOption := BindValues;
  end;

begin
  sItemName := QuestActionInfo.sParam1;
  nState0 := QuestActionInfo.nParam2;
  nState1 := QuestActionInfo.nParam3;
  nState2 := QuestActionInfo.nParam4;
  nState3 := QuestActionInfo.nParam5;
  nState4 := QuestActionInfo.nParam6;
  nState5 := QuestActionInfo.nParam7;
  nState6 := QuestActionInfo.nParam8;
  nItemCount := QuestActionInfo.nParam9;

  BindValues := 0;
  SetUserItemBindValue(BindValues, ubNoDrop, nState0 > 0);
  SetUserItemBindValue(BindValues, ubNoDeal, nState1 > 0);
  SetUserItemBindValue(BindValues, ubNoStorage, nState2 > 0);
  SetUserItemBindValue(BindValues, ubNoRepair, nState3 > 0);
  SetUserItemBindValue(BindValues, ubNoSell, nState4 > 0);
  SetUserItemBindValue(BindValues, ubNoScatter, nState5 > 0);
  SetUserItemBindValue(BindValues, ubDropDelete, nState6 > 0);
  // SetUserItemBindValue(BindValues, ubTakeOff, nState7 > 0);

  if nItemCount <= 0 then
    nItemCount := 1;

  if (sItemName = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if CompareText(sItemName, sSTRING_GOLDNAME) = 0 then
  begin
    Exit;
  end;

  if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    HeroObject := THeroObject(BaseObject)
