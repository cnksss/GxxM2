procedure ActionOfClearVar(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sVar: Char;
  I, Index, Count: Integer;
begin
  sVar := UpCase(QuestActionInfo.sRawParam1[1]);

{$IF CompilerVersion >= 22}
  if not CharInSet(sVar, ['P', 'D', 'M', 'N', 'I', 'G', 'A', 'S', 'U', 'T', 'J', 'Z']) then
  begin
    Npc.ScriptActionError(PlayObject, '变量错误', QuestActionInfo);
    Exit;
  end;
{$ELSE}
  if not (sVar in ['P', 'D', 'M', 'N', 'I', 'G', 'A', 'S', 'U', 'T', 'J', 'Z']) then
  begin
    Npc.ScriptActionError(PlayObject, '变量错误', QuestActionInfo);
    Exit;
  end;
{$ENDIF}
  if not TryStrToInt(Copy(QuestActionInfo.sRawParam1, 2, MaxInt), Index) then
  begin
    Npc.ScriptActionError(PlayObject, '变量错误', QuestActionInfo);
    Exit;
  end;

  Count := QuestActionInfo.nParam2;
  if Count <= 0 then
  begin
    Npc.ScriptActionError(PlayObject, '数量错误', QuestActionInfo);
    Exit;
  end;

  Count := Index + Count;
  for I := Index to Count - 1 do
  begin
    if not Npc.SetValNameValue(PlayObject, sVar + IntToStr(I), '', 0) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;
  end;
end;

procedure ActionOfConvertSkill(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Magic1, Magic2: pTMagic;
  SmartObject: TSmartObject;
  UserMagic: pTUserMagic;
  btOldHitPoint: Word;
  CustomMagicConfig: TCustomMagicConfig;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  if QuestActionInfo.sParam1 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.sParam2 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    Magic1 := UserEngine.FindHeroMagic(QuestActionInfo.sParam1)
  else
    Magic1 := UserEngine.FindMagic(QuestActionInfo.sParam1);

  if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    Magic2 := UserEngine.FindHeroMagic(QuestActionInfo.sParam2)
  else
    Magic2 := UserEngine.FindMagic(QuestActionInfo.sParam2);

  if (Magic1 = nil) or (Magic2 = nil) then
  begin
    Exit;
  end;

  for I := 0 to SmartObject.m_MagicList.Count - 1 do
  begin
    UserMagic := SmartObject.m_MagicList.Items[I];
    if UserMagic.MagicInfo.wMagicId = Magic1.wMagicId then
    begin
      if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER] then
      begin
        TPlayObject(BaseObject).SendDelMagic(UserMagic);
      end
      else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
      begin
        THeroObject(BaseObject).SendDelMagic(UserMagic);
      end;

      UserMagic.wMagIdx := Magic2.wMagicId;
      UserMagic.MagicInfo := Magic2;

      if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_PLAYMOSTER] then
      begin
        TPlayObject(BaseObject).SendAddMagic(UserMagic);

        if (UserMagic.wMagIdx = SKILL_ERGUM) and (TPlayObject(BaseObject).m_MagicErgumSkill = nil) then
        begin
          TPlayObject(BaseObject).m_MagicErgumSkill := UserMagic;
          if (not TPlayObject(BaseObject).m_boUseThrusting) then
            TPlayObject(BaseObject).ThrustingOnOff(True);

          // TPlayObject(BaseObject).SendSocket(nil, '+LNG');
          TPlayObject(BaseObject).SendOpenMagic(SKILL_ERGUM, True, 0);

          if g_FunctionNPC <> nil then
          begin
            TPlayObject(BaseObject).m_nLearnMagicID := UserMagic.wMagIdx;
            g_FunctionNPC.GotoLable(TPlayObject(BaseObject), '@LearnMagic', False);
            TPlayObject(BaseObject).m_nLearnMagicID := 0;
          end;
        end
        else if CheckIsCustomMagic(UserMagic.wMagIdx) then
        begin
          CustomMagicConfig := GetCustomMagicConfig(UserMagic.wMagIdx);
          if (CustomMagicConfig <> nil) and (CustomMagicConfig.ClientBaseConfig.MagicSwitchMode = msmSwitch) and (not TPlayObject(BaseObject).m_boCustomSkill[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID]) then
          begin
            if (CustomMagicConfig.ClientBaseConfig.MagicWarrNGOption = mngoLongHit) or CustomMagicConfig.ClientBaseConfig.MagicAutoOpen then
            begin
              TPlayObject(BaseObject).m_boCustomSkill[UserMagic.wMagIdx - CUSTOM_MAGIC_START_ID] := True;
              TPlayObject(BaseObject).SendOpenMagic(UserMagic.wMagIdx, True, 0);
            end;
          end;
        end;

        // 脚本自动开启刺杀剑术 -- piaoyun 2013-07-20
        if (UserMagic.wMagIdx = SKILL_ERGUM) and (TPlayObject(BaseObject).m_MagicErgumSkill <> nil) and (not TPlayObject(BaseObject).m_boUseThrusting) then
        begin
          TPlayObject(BaseObject).ThrustingOnOff(True);
          // TPlayObject(BaseObject).SendSocket(nil, '+LNG');
          TPlayObject(BaseObject).SendOpenMagic(SKILL_ERGUM, True, 0);
        end;
      end
      else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
      begin
        THeroObject(BaseObject).SendAddMagic(UserMagic);
      end;

      // 添加技能后，调整重算精确度 chongchong 2015-09-12
      btOldHitPoint := BaseObject.m_btHitPoint;
      BaseObject.RecalcAbilitys();
      if btOldHitPoint <> BaseObject.m_btHitPoint then
      begin
        BaseObject.SendMsg(BaseObject, RM_SUBABILITY, 0, 0, 0, 0, '');
      end;
    end;
  end;
end;

procedure ActionOfKillMapMon(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Envir: TEnvirnoment;
  ObjectList: TList;
  AObject: TBaseObject;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  if Envir = nil then
    Exit;

  ObjectList := TList.Create;
  try
    Envir.GetRangeBaseObject(QuestActionInfo.nParam2, QuestActionInfo.nParam3, QuestActionInfo.nParam4, True, ObjectList);
    for I := 0 to ObjectList.Count - 1 do
    begin
      AObject := TBaseObject(ObjectList.Items[I]);
      if not ((AObject.m_btRaceServer in [RC_HEROOBJECT, RC_PLAYOBJECT, RC_NPC, RC_PEACENPC, RC_GUARD, 55, 108]) or (AObject.m_Master <> nil)) then
      begin
        if (QuestActionInfo.sParam5 = '*') or SameText(DelNumber(AObject.m_sCharName), QuestActionInfo.sParam5) then
        begin
          AObject.m_boNoItem := QuestActionInfo.nParam6 = 0;
          AObject.m_WAbil.HP := 0;

          if QuestActionInfo.nParam7 = 1 then // 是否清尸体
          begin
            AObject.Die;
            AObject.m_Master := nil;
            AObject.MakeGhost;
          end
          else
            AObject.Die;
        end;
      end;
    end;
  finally
    ObjectList.Free;
  end;
end;

// AddDlg 编号 图片文件序号 图片编号 是否可移动 界面X:界面Y 文字偏移X:文字偏移Y 预留(0) 内容
procedure ActionOfAddDlg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);

  procedure GetItemShowIndex(sMsg: string);
  var
    sText, sCmdStr, sData, sTemp: string;
    nPos: Integer;
  begin
    while (True) do
    begin
      if sMsg = '' then
        Break;
      sMsg := GetValidStr3_Ex(sMsg, sText, '\');
      if sText <> '' then
      begin
        sData := '';
        while (Pos('<', sText) > 0) and (Pos('>', sText) > 0) and (sText <> '') do
        begin
          if sText[1] <> '<' then
          begin
            sText := '<' + GetValidStr3_Ex(sText, sData, '<');
          end;
          sText := ArrestStringEx(sText, '<', '>', sCmdStr);

          if CompareLStr(sCmdStr, 'ItemShow:', 9) then
          begin
            sTemp := Copy(sCmdStr, 10, MaxInt);
            nPos := Pos(':', sTemp);
            if nPos > 0 then
            begin
              sTemp := Copy(sTemp, 1, nPos - 1);
              nPos := StrToIntDef(sTemp, -1);
              if nPos >= 0 then
              begin
                PlayObject.m_CanRequestStdItemList.Add(Pointer(nPos));
              end;
            end;
          end;
        end;
      end;
    end;
  end;

var
  nDlgIndex, nFileIndex, nImageIndex: Integer;
  ptDlgPositon, ptTextOffset: TPoint;
  sDlgPosition, sTextOffset, sX, sY: string;
  boCanMove: Boolean;
  sText: string;
  btOwner: Byte;
begin
  nDlgIndex := QuestActionInfo.nParam1;
  nFileIndex := QuestActionInfo.nParam2;
  nImageIndex := QuestActionInfo.nParam3;
  boCanMove := QuestActionInfo.nParam4 <> 0;
  sDlgPosition := QuestActionInfo.sParam5;
  sTextOffset := QuestActionInfo.sParam6;
  btOwner := QuestActionInfo.nParam7;
  sText := QuestActionInfo.sParam8;

  sY := GetValidStr3_Ex(sDlgPosition, sX, ':');
  ptDlgPositon.X := StrToIntDef(sX, 0);
  ptDlgPositon.Y := StrToIntDef(sY, 0);

  sY := GetValidStr3_Ex(sTextOffset, sX, ':');
  ptTextOffset.X := StrToIntDef(sX, 0);
  ptTextOffset.Y := StrToIntDef(sY, 0);

  if (nDlgIndex <= 0) or (nDlgIndex > 50) or (nFileIndex < 0) or (nImageIndex < 0) or (sText = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  // 第1bit为是否可移动，后面7bit为btOwner
  btOwner := (Byte(boCanMove) shl 7) or btOwner;
  GetItemShowIndex(sText);

  PlayObject.SendMsg(PlayObject, RM_ADDDLG, MakeLong(nFileIndex, MakeWord(nDlgIndex, btOwner)), MakeLong(ptDlgPositon.X, ptDlgPositon.Y), MakeLong(ptTextOffset.X, ptTextOffset.Y), nImageIndex, sText);
end;

procedure ActionOfAddDlgEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);

  procedure GetItemShowIndex(sMsg: string);
  var
    sText, sCmdStr, sData, sTemp: string;
    nPos: Integer;
  begin
    while (True) do
    begin
      if sMsg = '' then
        Break;
      sMsg := GetValidStr3_Ex(sMsg, sText, '\');
      if sText <> '' then
      begin
        sData := '';
        while (Pos('<', sText) > 0) and (Pos('>', sText) > 0) and (sText <> '') do
        begin
          if sText[1] <> '<' then
          begin
            sText := '<' + GetValidStr3_Ex(sText, sData, '<');
          end;
          sText := ArrestStringEx(sText, '<', '>', sCmdStr);

          if CompareLStr(sCmdStr, 'ItemShow:', 9) then
          begin
            sTemp := Copy(sCmdStr, 10, MaxInt);
            nPos := Pos(':', sTemp);
            if nPos > 0 then
            begin
              sTemp := Copy(sTemp, 1, nPos - 1);
              nPos := StrToIntDef(sTemp, -1);
              if nPos >= 0 then
              begin
                PlayObject.m_CanRequestStdItemList.Add(Pointer(nPos));
              end;
            end;
          end;
        end;
      end;
    end;
  end;

  function ProcessMsg(sMsg: string): string;
  var
    s10, S14: string;
    nCount, nPos: Integer;
    nStartPos: Integer;
    IsBreakParseVar: Boolean;
  begin
    S14 := sMsg;
    nCount := 0;
    nStartPos := 1;
    while (True) do
    begin
      S14 := sMsg;
      if (Pos('>', S14) <= 0) or (Pos('$', S14) <= 0) or (nStartPos >= Length(S14)) then
        Break;
      nPos := ArrestVariable(S14, '<', '$', '>', nStartPos, s10);
      if s10 = '' then
        Break;

      if (g_FunctionNPC <> nil) then
      begin
        if not g_FunctionNPC.GetVariableText(PlayObject, sMsg, s10, IsBreakParseVar, nPos) then
        begin
          nStartPos := nPos + 2;
        end;
      end;

      Inc(nCount);
      if nCount >= 1001 then
        Break;
    end;

    Result := sMsg;
  end;

var
  nDlgIndex, nFileIndex, nImageIndex: Integer;
  ptDlgPositon, ptTextOffset: TPoint;
  sDlgPosition, sTextOffset, sX, sY: string;
  boCanMove: Boolean;
  btOwner: Byte;
  sFileName, sText: string;
  SL: TStringList;
  I: Integer;
begin
  nDlgIndex := QuestActionInfo.nParam1;
  nFileIndex := QuestActionInfo.nParam2;
  nImageIndex := QuestActionInfo.nParam3;
  boCanMove := QuestActionInfo.nParam4 <> 0;
  sDlgPosition := QuestActionInfo.sParam5;
  sTextOffset := QuestActionInfo.sParam6;
  btOwner := QuestActionInfo.nParam7;
  sFileName := QuestActionInfo.sParam8;

  if QuestActionInfo.nParam9 = 0 then
    sFileName := g_Config.sEnvirDir + Npc.m_sPath + sFileName;

  sText := '';
  if FileExists(sFileName) then
  begin
    SL := TStringList.Create;
    try
      SL.LoadFromFile(sFileName);

      // 去掉换行
      for I := 0 to SL.Count - 1 do
      begin
        sText := sText + SL.Strings[I];
      end;
    finally
      SL.Free;
    end;
  end;

  sY := GetValidStr3_Ex(sDlgPosition, sX, ':');
  ptDlgPositon.X := StrToIntDef(sX, 0);
  ptDlgPositon.Y := StrToIntDef(sY, 0);

  sY := GetValidStr3_Ex(sTextOffset, sX, ':');
  ptTextOffset.X := StrToIntDef(sX, 0);
  ptTextOffset.Y := StrToIntDef(sY, 0);

  if (nDlgIndex <= 0) or (nDlgIndex > 50) or (nFileIndex < 0) or (nImageIndex < 0) or (sText = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  sText := ProcessMsg(sText);

  // 第1bit为是否可移动，后面7bit为btOwner
  btOwner := (Byte(boCanMove) shl 7) or btOwner;
  GetItemShowIndex(sText);

  PlayObject.SendMsg(PlayObject, RM_ADDDLG, MakeLong(nFileIndex, MakeWord(nDlgIndex, btOwner)), MakeLong(ptDlgPositon.X, ptDlgPositon.Y), MakeLong(ptTextOffset.X, ptTextOffset.Y), nImageIndex, sText);
end;

procedure ActionOfDelDlg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  APlayObject: TPlayObject;
begin
  if QuestActionInfo.nParam2 = 1 then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      UserEngine.m_PlayObjectList.LockR(84);
    try
{$IFEND}
      for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
      begin
        APlayObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
