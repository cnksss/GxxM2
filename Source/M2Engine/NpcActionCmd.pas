procedure ActionOfOpenDragonBox(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nSource: Integer;
  UseBox: PTBox;
begin
  if PlayObject.m_BoxConfig.boOpen or (PlayObject.m_BoxConfig.Box <> nil) then
  begin
    PlayObject.SysMsg('当前有宝箱开启中...', 255, 253, t_Hint);
    Exit;
  end;

  nSource := QuestActionInfo.nParam1;

  { if not (nShape in [15..49]) then
    begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
    end; }
  if PlayObject.m_BoxConfig.Box <> nil then
  begin
    Dispose(PlayObject.m_BoxConfig.Box);
    PlayObject.m_BoxConfig.Box := nil;
  end;

  UseBox := g_BoxsList.Find(nSource);
  if UseBox <> nil then
  begin
    PlayObject.m_BoxConfig.Box := AllocMem(SizeOf(TBox));
    MoveMemory(PlayObject.m_BoxConfig.Box, UseBox, SizeOf(TBox));

    PlayObject.m_BoxConfig.boOpen := True;
    PlayObject.m_BoxConfig.ItemList.Clear;
    PlayObject.m_BoxConfig.StdItem.Name := PlayObject.m_BoxConfig.Box.Name;
    // PlayObject.m_BoxConfig.StdItem.Shape := PlayObject.m_BoxConfig.Box.Shape;
    PlayObject.m_BoxConfig.StdItem.Source := PlayObject.m_BoxConfig.Box.Source;
    PlayObject.m_BoxConfig.boRotation := False;
    PlayObject.m_BoxConfig.nIndex := -1;
    // 初始化三个结构体变量 piaoyun 2013-08-22
    PlayObject.m_BoxConfig.Box.BoxSet.nNowGold := 0;
    PlayObject.m_BoxConfig.Box.BoxSet.nNowGameGold := 0;
    PlayObject.m_BoxConfig.Box.BoxSet.nNowCount := 0;
    PlayObject.GetBoxItems;
  end
  else
  begin
    PlayObject.SysMsg('未知宝箱！', 255, 253, t_Hint);
  end;
end;

