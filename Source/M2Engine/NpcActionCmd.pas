      end;
    end
    else
    begin
      if SmartObject.m_boShowGodBless then
      begin
        SmartObject.m_boShowGodBless := False;
        PlayObject.SendUpdateGodBless(BaseObject.m_btRaceServer = RC_HEROOBJECT);
      end;
    end;
  end;
end;

// 开启-将神佑袋的图标由禁止图片改为生肖图片 chongchong 2014-04-17

procedure ActionOfOpenGodBless(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  nIndex: Integer;
  boAll: Boolean;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
  begin
    SmartObject := TSmartObject(BaseObject);
    boAll := LowerCase(QuestActionInfo.sParam1) = 'all';

    if boAll then
    begin
      for nIndex := Low(SmartObject.m_GodBlessItemsState) to High(SmartObject.m_GodBlessItemsState) do
        SmartObject.m_GodBlessItemsState[nIndex] := 1;
      Exit;
    end;
    nIndex := QuestActionInfo.nParam1;

    if (nIndex < Low(SmartObject.m_GodBlessItemsState)) or (nIndex > High(SmartObject.m_GodBlessItemsState)) then
    begin
      Npc.ScriptActionError(BaseObject, '神佑袋位置错误', QuestActionInfo);
      Exit;
    end;

    if SmartObject.m_GodBlessItemsState[nIndex] = 0 then
    begin
      SmartObject.m_GodBlessItemsState[nIndex] := 1;
      PlayObject.SendOpenGodBlessItem(BaseObject.m_btRaceServer = RC_HEROOBJECT, nIndex);
    end;
  end;
end;

// 关闭-将神佑袋的图标由生肖图片改为禁止图片 chongchong 2014-04-17

procedure ActionOfCloseGodBless(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  nIndex: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
  begin
    SmartObject := TSmartObject(BaseObject);
    nIndex := QuestActionInfo.nParam1;

    if (nIndex < Low(SmartObject.m_GodBlessItemsState)) or (nIndex > High(SmartObject.m_GodBlessItemsState)) then
    begin
      Npc.ScriptActionError(BaseObject, '神佑袋位置错误', QuestActionInfo);
      Exit;
    end;

    if SmartObject.m_GodBlessItemsState[nIndex] <> 0 then
    begin
      {
        if SmartObject.m_GodBlessItems[nIndex].MakeIndex > 0 then
        begin
        if not SmartObject.AddItemToBag(@SmartObject.m_GodBlessItems[nIndex]) then Exit;

        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).SendAddItem(@SmartObject.m_GodBlessItems[nIndex])
        else
        THeroObject(SmartObject).SendAddItem(@SmartObject.m_GodBlessItems[nIndex]);

        StdItem := UserEngine.GetStdItem(SmartObject.m_GodBlessItems[nIndex].wIndex);

        if StdItem <> nil then
        begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).ProcessUseItemSkill(U_GODBLESSITEM1, StdItem, False);

        if g_FunctionNPC <> nil then
        begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
        SmartObject.m_sCurrentItemNewName := StdItem.Name;
        g_FunctionNPC.GotoLable(TPlayObject(SmartObject), '@TakeOff' + IntToStr(nIndex + U_GODBLESSITEM1), False);
        SmartObject.m_sCurrentItemNewName := '';
        end
        else
        begin
        THeroObject(SmartObject).m_sCurrentItemNewName := StdItem.Name;
        g_FunctionNPC.GotoLable(TPlayObject(SmartObject.m_Master), '@HeroTakeOff' + IntToStr(nIndex + U_GODBLESSITEM1), False);
        THeroObject(SmartObject).m_sCurrentItemNewName := '';
        end;
        end;
        end;

        FillChar(SmartObject.m_GodBlessItems[nIndex], SizeOf(TUserItem), 0);
        SmartObject.RecalcAbilitys();
        SmartObject.WeightChanged;
        SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
        SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
        end;
      }

      SmartObject.m_GodBlessItemsState[nIndex] := 0;
      PlayObject.SendCloseGodBlessItem(BaseObject.m_btRaceServer = RC_HEROOBJECT, nIndex);
    end;
  end;
end;


// 数据采集 chongchong 2013-10-27

procedure ActionOfShowProgressbarDlg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  ShowTime: Integer;
  sTriggerOK, sTriggerBreak, sMsg: string;
  IsCanBreak: Boolean;
begin
  ShowTime := QuestActionInfo.nParam1;
  sTriggerOK := QuestActionInfo.sParam2;
  sMsg := QuestActionInfo.sParam3;
  IsCanBreak := QuestActionInfo.nParam4 <> 0;
  sTriggerBreak := QuestActionInfo.sParam5;
  if ShowTime <= 0 then
  begin
    Npc.ScriptActionError(PlayObject, '采集时间必须大于0', QuestActionInfo);
    Exit;
  end;

  if Length(sTriggerOK) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '采集完成触发字段不能为空', QuestActionInfo);
    Exit;
  end;

  if Length(sMsg) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '采集提示信息不能为空', QuestActionInfo);
    Exit;
  end;

  if Length(sTriggerOK) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '采集完成触发字段不能为空', QuestActionInfo);
    Exit;
  end;

  if IsCanBreak and (Length(sTriggerBreak) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '采集中断触发字段不能为空', QuestActionInfo);
    Exit;
  end;

  PlayObject.StartCollect(ShowTime, sMsg, IsCanBreak, sTriggerOK, sTriggerBreak);
end;

procedure ActionOfStopCollect(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  PlayObject.StopCollectEx;
end;

// 一键回收包裹物品 chongchong 2013-10-28

// TakeBagItem 物品名称 收取数量 每个物品增加元宝值 每个物品增加金币值 每个物品增加泡点值 每个物品增加泡点经验值 变量(保存实际回收的物品数量)

procedure ActionOfTakeBagItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sItemName: string; // 物品名称
  nCount: Integer; // 回收数量
  nAddGameGold: Integer; // 每物品增加元宝
  nAddGold: Integer; // 每物品增加金币
  nAddGamePoint: Integer; // 每物品增加泡点
  nAddExp: Integer; // 每物品增加经验
  sVarName: string; // 变量名

  I, J, K: Integer;
  nItemCount, nTotalCount: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  OldGameGold: LongWord;
  OldGold: LongWord;
  OldGamePoint: LongWord;
  ChangValue: Integer;
  CompareColor, ItemColor: Integer;
  boFoundHeroM2Shop: Boolean;
  HeroM2ShopItemInfo: pTHeroM2ShopItemInfo;
  SLItems: TStringList;
  SmartObject: TSmartObject;
  IsBreakParseVar: Boolean;
  tmpNum: Integer;
begin
  if (BaseObject = nil) //
    or (not (BaseObject.m_btRaceServer in [RC_HEROOBJECT, RC_PLAYOBJECT])) //
    or QuestActionInfo.sRawParam1.IsEmpty //
    or (QuestActionInfo.nParam2 = 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  SmartObject := TSmartObject(BaseObject);
  // Cursor 2023-06-19 17:04:22 增加对变量的支持
  Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, sItemName, tmpNum, IsBreakParseVar); // 物品名称
  nCount := QuestActionInfo.nParam2; // 回收数量
  nAddGameGold := QuestActionInfo.nParam3; // 每物品增加元宝
  nAddGold := QuestActionInfo.nParam4; // 每物品增加金币
  nAddGamePoint := QuestActionInfo.nParam5; // 每物品增加泡点
  nAddExp := QuestActionInfo.nParam6; // 每物品增加经验
  sVarName := QuestActionInfo.sRawParam7; // 变量名

  if (QuestActionInfo.sParam10 = '') or (QuestActionInfo.sParam10 = '*') then
    CompareColor := -1
  else if (QuestActionInfo.nParam10 < 0) or (QuestActionInfo.nParam10 > 255) then
    CompareColor := -1
  else
    CompareColor := QuestActionInfo.nParam10;

  nTotalCount := 0;
  OldGold := PlayObject.m_nGold;
  OldGameGold := PlayObject.m_nGameGold;
  OldGamePoint := PlayObject.m_nGamePoint;

  SLItems := TStringList.Create;
  try
    SLItems.Delimiter := '|';
    SLItems.DelimitedText := sItemName;

    for K := 0 to SLItems.Count - 1 do
    begin
      sItemName := SLItems[K];
      if sItemName.IsEmpty then
        Continue;

      nItemCount := 0;
      for I := SmartObject.m_ItemList.Count - 1 downto 0 do
      begin
        UserItem := SmartObject.m_ItemList.Items[I];

        // 不回收摆摊中的装备 chongchong 2015-05-02
        boFoundHeroM2Shop := False;
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          for J := 0 to TPlayObject(SmartObject).m_HeroM2ShopList.Count - 1 do
          begin
            HeroM2ShopItemInfo := TPlayObject(SmartObject).m_HeroM2ShopList.Items[J];
            if HeroM2ShopItemInfo.nMakeIndex = UserItem.MakeIndex then
            begin
              boFoundHeroM2Shop := True;
              Break;
            end;
          end;
        end;
        if boFoundHeroM2Shop then
          Continue;

        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if (StdItem = nil) or (not SameText(StdItem.Name, sItemName) and not SameText(UserItem.Name, sItemName)) then
          Continue;

        if UserItem.btColor > 0 then
          ItemColor := UserItem.btColor
        else
          ItemColor := StdItem.Color;

        if (CompareColor <> -1) and (ItemColor <> CompareColor) then // 按颜色回收 2020-07-08 21:00:42
          Continue;

        if CheckOverLapItem(StdItem) then // 叠加物品
        begin
          if nCount - nItemCount >= UserItem.Dura + 1 then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, UserItem.Dura + 1, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            nItemCount := nItemCount + (UserItem.Dura + 1);
            nTotalCount := nTotalCount + (UserItem.Dura + 1);

            if (SmartObject.m_btRaceServer = RC_PLAYOBJECT) //
              and (TPlayObject(SmartObject).m_UpgradeItem = UserItem) then
            begin
              TPlayObject(SmartObject).m_UpgradeItem := nil;
              TPlayObject(SmartObject).m_UpgradeItemIsPegBag := False;
            end;

            SmartObject.m_ItemList.Delete(I);
            if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
              TPlayObject(SmartObject).SendDelItem(UserItem)
            else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
              THeroObject(SmartObject).SendDelItem(UserItem);

            Dispose(UserItem);
          end
          else
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, UserItem.Dura - (nCount - nItemCount) + 1, UserItem.Dura + 1, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            UserItem.Dura := UserItem.Dura - (nCount - nItemCount);
            nTotalCount := nTotalCount + (nCount - nItemCount);

            if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
              TPlayObject(SmartObject).SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura)
            else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
              THeroObject(SmartObject).SendUpdateItemDura(-1, UserItem.MakeIndex, UserItem.Dura);

            Break;
          end;
        end
        else
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
          end;

          Inc(nItemCount);
          Inc(nTotalCount);

          // 每收回一个物品发一条消息到客户端 chongchong 2014-04-03
          if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
            TPlayObject(SmartObject).SendDelItem(UserItem)
          else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(SmartObject).SendDelItem(UserItem);

          if (SmartObject.m_btRaceServer = RC_PLAYOBJECT) //
            and (TPlayObject(SmartObject).m_UpgradeItem = UserItem) then
          begin
            TPlayObject(SmartObject).m_UpgradeItem := nil;
            TPlayObject(SmartObject).m_UpgradeItemIsPegBag := False;
          end;

          // 开始收回物品
          SmartObject.m_ItemList.Delete(I);
          Dispose(UserItem);
          if nItemCount >= nCount then
            Break;
        end;
      end;
    end;

    if nTotalCount > 0 then
    begin
      if nAddGameGold <> 0 then
        PlayObject.IncGameGold(nAddGameGold * nTotalCount);

      if nAddGold <> 0 then
        PlayObject.IncGold(nAddGold * nTotalCount);

      if nAddGamePoint <> 0 then
        PlayObject.IncGamePoint(nAddGamePoint * nTotalCount);

      // TakeBagItem 经验不让超过最高限制
      if nAddExp <> 0 then
        PlayObject.GetExp(nAddExp * nTotalCount, True, True, QuestActionInfo.nParam8 <> 0, False);

      ChangValue := PlayObject.m_nGameGold - OldGameGold;
      if (ChangValue <> 0) and (Length(g_sIncGameGold) > 0) and (QuestActionInfo.nParam9 = 0) then
        PlayObject.SysMsg(Format(g_sIncGameGold, [ChangValue, g_Config.sGameGoldName]), c_Red, t_Hint);

      ChangValue := PlayObject.m_nGold - OldGold;
      if (ChangValue <> 0) and (Length(g_sIncGold) > 0) and (QuestActionInfo.nParam9 = 0) then
        PlayObject.SysMsg(Format(g_sIncGold, [ChangValue]), c_Red, t_Hint);

      ChangValue := PlayObject.m_nGamePoint - OldGamePoint;
      if (ChangValue <> 0) and (Length(g_sIncGamePoint) > 0) and (QuestActionInfo.nParam9 = 0) then
        PlayObject.SysMsg(Format(g_sIncGamePoint, [ChangValue, g_Config.sGamePointName]), c_Red, t_Hint);

      if (nAddExp <> 0) and (Length(g_sIncExp) > 0) and (QuestActionInfo.nParam9 = 0) then
        PlayObject.SysMsg(Format(g_sIncExp, [nAddExp * nTotalCount]), c_Red, t_Hint);

      PlayObject.GoldChanged();
      PlayObject.GameGoldChanged;
    end;

    if g_boGameLogGameGold and (PlayObject.m_nGameGold <> OldGameGold) then
    begin
      AddGameDataLog(LOG_GameGoldChange, LOG_ActionNone, PlayObject, g_Config.sGameGoldName, 0, Npc.m_sCharName, PlayObject.m_nGameGold, OldGameGold, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
    end;

    if g_boGameLogGold and (PlayObject.m_nGold <> OldGold) then
    begin
      AddGameDataLog(LOG_GoldChange, LOG_ActionNone, PlayObject, sSTRING_GOLDNAME, 0, Npc.m_sCharName, PlayObject.m_nGold, OldGold, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
    end;

    if g_boGameLogGamePoint and (PlayObject.m_nGamePoint <> OldGamePoint) then
    begin
      AddGameDataLog(LOG_GamePointChange, LOG_ActionNone, PlayObject, g_Config.sGamePointName, 0, Npc.m_sCharName, PlayObject.m_nGamePoint, OldGamePoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
    end;

    if Length(sVarName) <> 0 then
      Npc.SetValNameValue(PlayObject, sVarName, '', nTotalCount);

    SmartObject.WeightChanged;
  finally
    SLItems.Free;
  end;
end;
// TakeBagItemEx 物品编号 收取数量 每个物品增加元宝值 每个物品增加金币值 每个物品增加泡点值 每个物品增加泡点经验值 变量(保存实际回收的物品数量)

procedure ActionOfTakeBagItemEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sItemIndex, sTemp: string; // 物品编号
  nItemIndex1, nItemIndex2: Integer;
  nCount: Integer; // 回收数量
  nAddGameGold: Integer; // 每物品增加元宝
  nAddGold: Integer; // 每物品增加金币
  nAddGamePoint: Integer; // 每物品增加泡点
  nAddExp: Integer; // 每物品增加经验
  sVarName: string; // 变量名

  I, J, K: Integer;
  nItemCount, nTotalCount: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  OldGameGold: Integer;
  OldGold: Integer;
  OldGamePoint: Integer;
  ChangValue: Integer;
  CompareColor, ItemColor: Integer;
  boFoundHeroM2Shop: Boolean;
  HeroM2ShopItemInfo: pTHeroM2ShopItemInfo;
  SLItems: TStringList;
begin
  sItemIndex := QuestActionInfo.sParam1; // 物品编号

  nCount := QuestActionInfo.nParam2; // 回收数量
  nAddGameGold := QuestActionInfo.nParam3; // 每物品增加元宝
  nAddGold := QuestActionInfo.nParam4; // 每物品增加金币
  nAddGamePoint := QuestActionInfo.nParam5; // 每物品增加泡点
  nAddExp := QuestActionInfo.nParam6; // 每物品增加经验
  sVarName := QuestActionInfo.sRawParam7; // 变量名

  if (QuestActionInfo.sParam10 = '') or (QuestActionInfo.sParam10 = '*') then
    CompareColor := -1
  else if (QuestActionInfo.nParam10 < 0) or (QuestActionInfo.nParam10 > 255) then
    CompareColor := -1
  else
    CompareColor := QuestActionInfo.nParam10;

  if PlayObject = nil then
    Exit;

  if Length(sItemIndex) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '收回物品编号不能为空', QuestActionInfo);
    Exit;
  end;

  if nCount = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '收回物品数量不能为0', QuestActionInfo);
    Exit;
  end;

  SLItems := TStringList.Create;
  try
    nTotalCount := 0;
    SLItems.Delimiter := '|';
    SLItems.DelimitedText := sItemIndex;

    OldGameGold := PlayObject.m_nGameGold;
    OldGold := PlayObject.m_nGold;
    OldGamePoint := PlayObject.m_nGamePoint;

    for K := 0 to SLItems.Count - 1 do
    begin
      nItemCount := 0;

      sItemIndex := SLItems.Strings[K];
      if Length(sItemIndex) = 0 then
        Continue;

      J := Pos('-', sItemIndex);
      if J <= 0 then
      begin
        if not TryStrToInt(sItemIndex, nItemIndex1) then
          Continue;
        nItemIndex2 := nItemIndex1;
      end
      else
      begin
        sTemp := Copy(sItemIndex, 1, J - 1);
        sItemIndex := Copy(sItemIndex, J + 1, MaxInt);
        if not TryStrToInt(sTemp, nItemIndex1) then
          Continue;
        if not TryStrToInt(sItemIndex, nItemIndex2) then
          Continue;

        if nItemIndex1 > nItemIndex2 then
        begin
          J := nItemIndex1;
          nItemIndex1 := nItemIndex2;
          nItemIndex2 := J;
        end;
      end;

      if nItemIndex1 < 0 then
        Continue;
      if nItemIndex2 < 0 then
        Continue;

      for I := PlayObject.m_ItemList.Count - 1 downto 0 do
      begin
        UserItem := PlayObject.m_ItemList.Items[I];

        if UserItem.wIndex = 0 then
          Continue;

        // 不回收摆摊中的装备 chongchong 2015-05-02
        boFoundHeroM2Shop := False;
        for J := 0 to PlayObject.m_HeroM2ShopList.Count - 1 do
        begin
          HeroM2ShopItemInfo := PlayObject.m_HeroM2ShopList.Items[J];
          if HeroM2ShopItemInfo.nMakeIndex = UserItem.MakeIndex then
          begin
            boFoundHeroM2Shop := True;
            Break;
          end;
        end;
        if boFoundHeroM2Shop then
          Continue;

        if (UserItem.wIndex < nItemIndex1 + 1) or (UserItem.wIndex > nItemIndex2 + 1) then
          Continue;

        StdItem := UserEngine.GetStdItem(UserItem.wIndex);
        if (StdItem = nil) then
          Continue;

        if UserItem.btColor > 0 then
          ItemColor := UserItem.btColor
        else
          ItemColor := StdItem.Color;

        if (CompareColor <> -1) then // 按颜色回收 2020-07-08 21:00:42
        begin
          if ItemColor <> CompareColor then
            Continue;
        end;

        if CheckOverLapItem(StdItem) then
        begin // 叠加物品
          if nCount - nItemCount >= UserItem.Dura + 1 then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            nItemCount := nItemCount + (UserItem.Dura + 1);

            nTotalCount := nTotalCount + (UserItem.Dura + 1);

            if PlayObject.m_UpgradeItem = UserItem then
            begin
              PlayObject.m_UpgradeItem := nil;
              PlayObject.m_UpgradeItemIsPegBag := False;
            end;

            PlayObject.m_ItemList.Delete(I);
            PlayObject.SendDelItem(UserItem);
            Dispose(UserItem);
          end
          else
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, UserItem.Dura - (nCount - nItemCount) + 1, UserItem.Dura + 1, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            UserItem.Dura := UserItem.Dura - (nCount - nItemCount);

            nTotalCount := nTotalCount + (nCount - nItemCount);

            // nItemCount := nCount;

            PlayObject.SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura);
            Break;
          end;
        end
        else
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            // 注释日志 chongchong 2017-10-09
            AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
          end;

          Inc(nItemCount);
          Inc(nTotalCount);

          // 每收回一个物品发一条消息到客户端 chongchong 2014-04-03
          PlayObject.SendDelItem(UserItem);

          if PlayObject.m_UpgradeItem = UserItem then
          begin
            PlayObject.m_UpgradeItem := nil;
            PlayObject.m_UpgradeItemIsPegBag := False;
          end;

          // 开始收回物品
          PlayObject.m_ItemList.Delete(I);
          Dispose(UserItem);
          if nItemCount >= nCount then
            Break;
        end;
      end;
    end;
  finally
    SLItems.Free;
  end;

  if nTotalCount > 0 then
  begin
    if nAddGameGold <> 0 then
      PlayObject.IncGameGold(nAddGameGold * nTotalCount);

    if nAddGold <> 0 then
      PlayObject.IncGold(nAddGold * nTotalCount);

    if nAddGamePoint <> 0 then
      PlayObject.IncGamePoint(nAddGamePoint * nTotalCount);

    // TakeBagItem 经验不让超过最高限制
    if nAddExp <> 0 then
      PlayObject.GetExp(nAddExp * nTotalCount, True, True, QuestActionInfo.nParam8 <> 0, False);

    ChangValue := PlayObject.m_nGameGold - OldGameGold;
    if (ChangValue <> 0) and (Length(g_sIncGameGold) > 0) and (QuestActionInfo.nParam9 = 0) then
    begin
      PlayObject.SysMsg(Format(g_sIncGameGold, [ChangValue, g_Config.sGameGoldName]), c_Red, t_Hint);
    end;

    ChangValue := PlayObject.m_nGold - OldGold;
    if (ChangValue <> 0) and (Length(g_sIncGold) > 0) and (QuestActionInfo.nParam9 = 0) then
    begin
      PlayObject.SysMsg(Format(g_sIncGold, [ChangValue]), c_Red, t_Hint);
    end;

    ChangValue := PlayObject.m_nGamePoint - OldGamePoint;
    if (ChangValue <> 0) and (Length(g_sIncGamePoint) > 0) and (QuestActionInfo.nParam9 = 0) then
    begin
      PlayObject.SysMsg(Format(g_sIncGamePoint, [ChangValue, g_Config.sGamePointName]), c_Red, t_Hint);
    end;

    if (nAddExp <> 0) and (Length(g_sIncExp) > 0) and (QuestActionInfo.nParam9 = 0) then
      PlayObject.SysMsg(Format(g_sIncExp, [nAddExp * nTotalCount]), c_Red, t_Hint);

    PlayObject.GoldChanged();
    PlayObject.GameGoldChanged;
  end;

  if g_boGameLogGameGold and (PlayObject.m_nGameGold <> OldGameGold) then
  begin
    AddGameDataLog(LOG_GameGoldChange, LOG_ActionNone, PlayObject, g_Config.sGameGoldName, 0, Npc.m_sCharName, PlayObject.m_nGameGold, OldGameGold, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
  end;

  if g_boGameLogGold and (PlayObject.m_nGold <> OldGold) then
  begin
    AddGameDataLog(LOG_GoldChange, LOG_ActionNone, PlayObject, sSTRING_GOLDNAME, 0, Npc.m_sCharName, PlayObject.m_nGold, OldGold, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
  end;

  if g_boGameLogGamePoint and (PlayObject.m_nGamePoint <> OldGamePoint) then
  begin
    AddGameDataLog(LOG_GamePointChange, LOG_ActionNone, PlayObject, g_Config.sGamePointName, 0, Npc.m_sCharName, PlayObject.m_nGamePoint, OldGamePoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
  end;

  if Length(sVarName) <> 0 then
    Npc.SetValNameValue(PlayObject, sVarName, '', nTotalCount);

  PlayObject.WeightChanged;
end;

// 按最大HP值的百分比来加减HP chongchong 2013-10-29

procedure ActionOfAddHpper(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  cMethod: Char;
  NewHP: Int64;
  Int64Value: Int64;
  nBaseValue: Integer;
  OldHP: LongWord;
begin
  if Length(QuestActionInfo.sParam1) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '操作符不能为空', QuestActionInfo);
    Exit;
  end;

  if (BaseObject = nil) or BaseObject.m_boDeath or BaseObject.m_boGhost then
    Exit;

  cMethod := QuestActionInfo.sParam1[1];

  if QuestActionInfo.nParam3 = 0 then
    nBaseValue := 100
  else if QuestActionInfo.nParam3 = 1 then
    nBaseValue := 1000
  else if QuestActionInfo.nParam3 = 2 then
    nBaseValue := 10000
  else
    nBaseValue := 100;

  NewHP := Round(QuestActionInfo.nParam2 / nBaseValue * BaseObject.m_WAbil.MaxHP);
  if NewHP > High(LongWord) then
    NewHP := High(LongWord);

  case cMethod of
    '+':
      begin
        Int64Value := Int64(BaseObject.m_WAbil.HP) + NewHP;
        BaseObject.m_WAbil.HP := Min(Int64Value, BaseObject.m_WAbil.MaxHP);
        BaseObject.HealthSpellChanged;
      end;
    '-':
      begin
        OldHP := BaseObject.m_WAbil.HP;
        Int64Value := Int64(BaseObject.m_WAbil.HP) - NewHP;
        if Int64Value < 0 then
          Int64Value := 0;
        BaseObject.m_WAbil.HP := Int64Value;

        if BaseObject.m_WAbil.HP < OldHP then
        begin
          BaseObject.SendRefMsg(RM_HEALTHSPELLCHANGED_STRUCK, OldHP - BaseObject.m_WAbil.HP, -1, -1, 0, '');
        end;
      end;
    '=':
      begin
        if NewHP < 0 then
          BaseObject.m_WAbil.HP := 0
        else if NewHP > BaseObject.m_WAbil.MaxHP then
          BaseObject.m_WAbil.HP := BaseObject.m_WAbil.MaxHP
        else
          BaseObject.m_WAbil.HP := NewHP;
        BaseObject.HealthSpellChanged;
      end;
  else
    Npc.ScriptActionError(BaseObject, '操作符错误', QuestActionInfo);
    Exit;
  end;
end;

