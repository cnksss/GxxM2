procedure ActionOfDelNoJobSkill(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  boDeleted: Boolean;
  UserMagic: pTUserMagic;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;
  boDeleted := False;
  for I := SmartObject.m_MagicList.Count - 1 downto 0 do
  begin
    if SmartObject.m_MagicList.Count <= 0 then
      Break;

    UserMagic := SmartObject.m_MagicList.Items[I];
    if (UserMagic.MagicInfo.btJob <> 99) and (UserMagic.MagicInfo.btJob <> BaseObject.m_btJob) then
    begin
      boDeleted := True;
      if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(BaseObject).SendDelMagic(UserMagic)
      else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(BaseObject).SendDelMagic(UserMagic);

      SmartObject.m_MagicList.Delete(I);
      Dispose(UserMagic);
    end;
  end;

  if boDeleted then
    BaseObject.RecalcAbilitys();
end;

procedure ActionOfDelSkill(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  sMagicName: string;
  Magic: pTMagic;
  UserMagic: pTUserMagic;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  Magic := nil;
  sMagicName := QuestActionInfo.sParam1;

  if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    Magic := UserEngine.FindMagic(sMagicName)
  else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    Magic := UserEngine.FindHeroMagic(sMagicName);

  if Magic = nil then
