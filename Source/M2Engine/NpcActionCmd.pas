procedure ActionOfChangeLevel(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  boChgOK: Boolean;
  nLevel: Int64;
  nOldLevel: LongWord;
  cMethod: Char;
begin
  boChgOK := False;
  nOldLevel := BaseObject.m_Abil.Level;
  nLevel := StrToInt64Def(QuestActionInfo.sParam2, 0);
  if nLevel > High(LongWord) then
    nLevel := High(LongWord);

  if (QuestActionInfo.sParam1 = '') or (nLevel < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if g_Config.btMaxLevel = 0 then
          nLevel := Min(nLevel, MAXLEVEL)
        else if g_Config.btMaxLevel = 1 then
          nLevel := Min(nLevel, High(Integer));

        BaseObject.m_Abil.Level := nLevel;
        boChgOK := True;
      end;
    '-':
      begin
        nLevel := BaseObject.m_Abil.Level - nLevel;
        if nLevel < 0 then
          nLevel := 0;

        if g_Config.btMaxLevel = 0 then
          nLevel := Min(nLevel, MAXLEVEL)
        else if g_Config.btMaxLevel = 1 then
          nLevel := Min(nLevel, High(Integer));

        BaseObject.m_Abil.Level := nLevel;
        boChgOK := True;
      end;
    '+':
      begin
        nLevel := BaseObject.m_Abil.Level + nLevel;

        if g_Config.btMaxLevel = 0 then
          nLevel := Min(nLevel, MAXLEVEL)
        else if g_Config.btMaxLevel = 1 then
          nLevel := Min(nLevel, High(Integer))
        else
          nLevel := Min(nLevel, High(LongWord));

        BaseObject.m_Abil.Level := nLevel;
        boChgOK := True;
      end;
  end;

  if boChgOK then
  begin
    // 在PlayLevelUP中，又改等级，死循环
    BaseObject.HasLevelUp(nOldLevel);

    if BaseObject.m_Abil.Level <> nOldLevel then
    begin
      AddGameDataLog(LOG_LevelChange, LOG_ActionNone, BaseObject, '等级', 0, Npc.m_sCharName, BaseObject.m_Abil.Level, nOldLevel, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
    end;
  end;
end;

procedure ActionOfMarry(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  PoseHuman: TPlayObject;
  sSayMsg: string;
begin
  if PlayObject.m_sDearName <> '' then
    Exit;
  PoseHuman := TPlayObject(PlayObject.GetPoseCreate());
  if (PoseHuman = nil) then
  begin
    Npc.GotoLable(PlayObject, '@MarryCheckDir', False);
    Exit;
  end;
  if QuestActionInfo.sParam1 = '' then
  begin
    if PoseHuman.m_btRaceServer <> RC_PLAYOBJECT then
    begin
      Npc.GotoLable(PlayObject, '@HumanTypeErr', False);
      Exit;
    end;
    if PoseHuman.GetPoseCreate = PlayObject then
    begin
      if PlayObject.m_btGender <> PoseHuman.m_btGender then
      begin
        Npc.GotoLable(PlayObject, '@StartMarry', False);
        Npc.GotoLable(PoseHuman, '@StartMarry', False);
        if (PlayObject.m_btGender = 0) and (PoseHuman.m_btGender = 1) then
        begin
          sSayMsg := AnsiReplaceText(g_sStartMarryManMsg, '%n', Npc.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
          UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
          sSayMsg := AnsiReplaceText(g_sStartMarryManAskQuestionMsg, '%n', Npc.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
          UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
        end
        else if (PlayObject.m_btGender = 1) and (PoseHuman.m_btGender = 0) then
        begin
          sSayMsg := AnsiReplaceText(g_sStartMarryWoManMsg, '%n', Npc.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
          UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
          sSayMsg := AnsiReplaceText(g_sStartMarryWoManAskQuestionMsg, '%n', Npc.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
          UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
        end;
        PlayObject.m_boStartMarry := True;
        PoseHuman.m_boStartMarry := True;
      end
      else
      begin
        Npc.GotoLable(PoseHuman, '@MarrySexErr', False);
        Npc.GotoLable(PlayObject, '@MarrySexErr', False);
      end;
    end
    else
    begin
      Npc.GotoLable(PlayObject, '@MarryDirErr', False);
      Npc.GotoLable(PoseHuman, '@MarryCheckDir', False);
    end;
    Exit;
  end;
  if CompareText(QuestActionInfo.sParam1, 'REQUESTMARRY' { sREQUESTMARRY } ) = 0 then
  begin
    if PlayObject.m_boStartMarry and PoseHuman.m_boStartMarry then
    begin
      if (PlayObject.m_btGender = 0) and (PoseHuman.m_btGender = 1) then
      begin
        sSayMsg := AnsiReplaceText(g_sMarryManAnswerQuestionMsg, '%n', Npc.m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
        UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
        sSayMsg := AnsiReplaceText(g_sMarryManAskQuestionMsg, '%n', Npc.m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
        UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
        Npc.GotoLable(PlayObject, '@WateMarry', False);
        Npc.GotoLable(PoseHuman, '@RevMarry', False);
      end;
    end;
    Exit;
  end;
  if CompareText(QuestActionInfo.sParam1, 'RESPONSEMARRY' { sRESPONSEMARRY } ) = 0 then
  begin
    if (PlayObject.m_btGender = 1) and (PoseHuman.m_btGender = 0) then
    begin
      if CompareText(QuestActionInfo.sParam2, 'OK') = 0 then
      begin
        if PlayObject.m_boStartMarry and PoseHuman.m_boStartMarry then
        begin
          sSayMsg := AnsiReplaceText(g_sMarryWoManAnswerQuestionMsg, '%n', Npc.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
          UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
          sSayMsg := AnsiReplaceText(g_sMarryWoManGetMarryMsg, '%n', Npc.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
          sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
          UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
          Npc.GotoLable(PlayObject, '@EndMarry', False);
          Npc.GotoLable(PoseHuman, '@EndMarry', False);
          PlayObject.m_boStartMarry := False;
          PoseHuman.m_boStartMarry := False;
          PlayObject.m_sDearName := PoseHuman.m_sCharName;
          PlayObject.m_DearHuman := PoseHuman;
          PoseHuman.m_sDearName := PlayObject.m_sCharName;
          PoseHuman.m_DearHuman := PlayObject;
          PlayObject.RefShowName;
          PoseHuman.RefShowName;
        end;
      end
      else if PlayObject.m_boStartMarry and PoseHuman.m_boStartMarry then
      begin
        Npc.GotoLable(PlayObject, '@EndMarryFail', False);
        Npc.GotoLable(PoseHuman, '@EndMarryFail', False);
        PlayObject.m_boStartMarry := False;
        PoseHuman.m_boStartMarry := False;
        sSayMsg := AnsiReplaceText(g_sMarryWoManDenyMsg, '%n', Npc.m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
        UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
        sSayMsg := AnsiReplaceText(g_sMarryWoManCancelMsg, '%n', Npc.m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%s', PlayObject.m_sCharName);
        sSayMsg := AnsiReplaceText(sSayMsg, '%d', PoseHuman.m_sCharName);
        UserEngine.SendBroadCastMsg(sSayMsg, t_Say);
      end;
    end;
  end;
end;

procedure ActionOfMaster(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  PoseHuman: TPlayObject;
begin
  if PlayObject.m_sMasterName <> '' then
    Exit;

  PoseHuman := TPlayObject(PlayObject.GetPoseCreate());
  if PoseHuman = nil then
  begin
    Npc.GotoLable(PlayObject, '@MasterCheckDir', False);
    Exit;
  end;

  if QuestActionInfo.sParam1 = '' then
  begin
    if PoseHuman.m_btRaceServer <> RC_PLAYOBJECT then
    begin
      Npc.GotoLable(PlayObject, '@HumanTypeErr', False);
      Exit;
    end;

    if PoseHuman.GetPoseCreate = PlayObject then
    begin
      Npc.GotoLable(PlayObject, '@StartGetMaster', False);
      Npc.GotoLable(PoseHuman, '@StartMaster', False);
      PlayObject.m_boStartMaster := True;
      PoseHuman.m_boStartMaster := True;
    end
    else
    begin
      Npc.GotoLable(PlayObject, '@MasterDirErr', False);
      Npc.GotoLable(PoseHuman, '@MasterCheckDir', False);
    end;
    Exit;
  end;

  if CompareText(QuestActionInfo.sParam1, 'REQUESTMASTER') = 0 then
  begin
    if PlayObject.m_boStartMaster and PoseHuman.m_boStartMaster then
    begin
      PlayObject.m_PoseBaseObject := PoseHuman;
      PoseHuman.m_PoseBaseObject := PlayObject;
      Npc.GotoLable(PlayObject, '@WateMaster', False);
      Npc.GotoLable(PoseHuman, '@RevMaster', False);
    end;
    Exit;
  end;

  if CompareText(QuestActionInfo.sParam1, 'RESPONSEMASTER') = 0 then
  begin
    if CompareText(QuestActionInfo.sParam2, 'OK') = 0 then
    begin
      if (PlayObject.m_PoseBaseObject = PoseHuman) and (PoseHuman.m_PoseBaseObject = PlayObject) then
      begin
        // 超过可收徒弟数,则退出 chongchong 2014-10-29
        if (PlayObject.m_MasterNoList.Count >= g_Config.nMasterCount) then
        begin
          Npc.GotoLable(PoseHuman, '@EndMasterFail', False); // 提示拜师失败
          Npc.GotoLable(PlayObject, '@EndMasterFail', False); // 提示拜师失败
          PlayObject.m_boStartMaster := False;
          PoseHuman.m_boStartMaster := False;
          Exit;
        end;

        if PlayObject.m_boStartMaster and PoseHuman.m_boStartMaster then
        begin
          Npc.GotoLable(PlayObject, '@EndMaster', False);
          Npc.GotoLable(PoseHuman, '@EndMaster', False);
          PlayObject.m_boStartMaster := False;
          PoseHuman.m_boStartMaster := False;

          // PlayObject 是师傅
          // PoseHuman 是徒弟
          {
            if PlayObject.m_sMasterName = '' then
            begin
            PlayObject.m_sMasterName := PoseHuman.m_sCharName;
            PlayObject.m_boMaster := True;
            end;
          }
          PlayObject.m_boMaster := True; // chongchong 2014-10-11
          PlayObject.AddMaster(PoseHuman.m_sCharName); // chongchong 2014-10-11 收徒
          PlayObject.m_MasterList.Add(PoseHuman);
          PoseHuman.m_sMasterName := PlayObject.m_sCharName;
          PoseHuman.m_boMaster := False;
          PoseHuman.GetMasterNoList; // chongchong 2014-10-11 取排名

          PlayObject.RefShowName;
          PoseHuman.RefShowName;
        end;
      end;
    end
    else
    begin
      if PlayObject.m_boStartMaster and PoseHuman.m_boStartMaster then
      begin
        Npc.GotoLable(PlayObject, '@EndMasterFail', False);
        Npc.GotoLable(PoseHuman, '@EndMasterFail', False);
        PlayObject.m_boStartMaster := False;
        PoseHuman.m_boStartMaster := False;
      end;
    end;
    Exit;
  end;
end;

procedure ActionOfUnMaster(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  PoseHuman: TPlayObject;
  sMsg: string;
begin
  PoseHuman := TPlayObject(PlayObject.GetPoseCreate);
  if PoseHuman = nil then
  begin
    Npc.GotoLable(PlayObject, '@UnMasterCheckDir', False);
  end;

  if PoseHuman <> nil then
  begin
    if QuestActionInfo.sParam1 = '' then
    begin
      if PoseHuman.m_btRaceServer <> RC_PLAYOBJECT then
      begin
        Npc.GotoLable(PlayObject, '@UnMasterTypeErr', False);
        Exit;
      end;
      if PoseHuman.GetPoseCreate = PlayObject then
      begin
        if (PlayObject.m_sMasterName = PoseHuman.m_sCharName) then
        begin
          if PlayObject.m_boMaster then
          begin
            Npc.GotoLable(PlayObject, '@UnIsMaster', False);
            Exit;
          end;

          if PlayObject.m_sMasterName <> PoseHuman.m_sCharName then
          begin
            Npc.GotoLable(PlayObject, '@UnMasterError', False);
            Exit;
          end;

          Npc.GotoLable(PlayObject, '@StartUnMaster', False);
          // Npc.GotoLable(PoseHuman, '@WateUnMaster', False);
          Exit;
        end;
      end;
    end;
  end;

  if (CompareText(QuestActionInfo.sParam1, 'REQUESTUNMASTER' { sREQUESTUNMARRY } ) = 0) then
  begin
    if PlayObject.m_sMasterName = '' then
    begin
      Npc.GotoLable(PlayObject, '@ExeMasterFail', False);
      Exit;
    end;

    if (QuestActionInfo.sParam2 = '') then
    begin
      if PoseHuman <> nil then
      begin
        PlayObject.m_boStartUnMaster := True;
        {
          if PlayObject.m_boStartUnMaster and PoseHuman.m_boStartUnMaster then
          begin
          sMsg := AnsiReplaceText(g_sNPCSayUnMasterOKMsg, '%n', Npc.m_sCharName);
          sMsg := AnsiReplaceText(sMsg, '%s', PlayObject.m_sCharName);
          sMsg := AnsiReplaceText(sMsg, '%d', PoseHuman.m_sCharName);
          UserEngine.SendBroadCastMsg(sMsg, t_Say);
          PlayObject.m_sMasterName := '';
          PoseHuman.m_sMasterName := '';
          PlayObject.m_boStartUnMaster := False;
          PoseHuman.m_boStartUnMaster := False;

          PoseHuman.DelMaster(PlayObject.m_sCharName, True);//出师 2014-10-11
          if g_FunctionNPC <> nil then
          begin
          g_FunctionNPC.GotoLable(PoseHuman, '@UnMasterEnd', False);//师傅触发 2014-10-11
          g_FunctionNPC.GotoLable(PlayObject, '@UnMasterEnd1', False);//徒弟触发 2014-10-11
          end;

          PlayObject.RefShowName;
          PoseHuman.RefShowName;
          Npc.GotoLable(PlayObject, '@UnMasterEnd', False);
          Npc.GotoLable(PoseHuman, '@UnMasterEnd', False);
          end
          else
        }
        begin
          Npc.GotoLable(PlayObject, '@WateUnMaster', False);
          Npc.GotoLable(PoseHuman, '@RevUnMaster', False);
        end;
      end;
      Exit;
    end
    else
    begin
      // 强行出师
      if (CompareText(QuestActionInfo.sParam2, 'FORCE') = 0) then
      begin
        if PlayObject.m_boMaster then
        begin
          PlayObject.SysMsg('强行出师不支持师傅操作', c_Red, t_Hint);
          Exit;
        end;

        sMsg := AnsiReplaceText(g_sNPCSayForceUnMasterMsg, '%n', Npc.m_sCharName);
        sMsg := AnsiReplaceText(sMsg, '%s', PlayObject.m_sCharName);
        sMsg := AnsiReplaceText(sMsg, '%d', PlayObject.m_sMasterName);
        UserEngine.SendBroadCastMsg(sMsg, t_Say);

        if g_FunctionNPC <> nil then
          g_FunctionNPC.GotoLable(PlayObject, '@ForceUnMasterEnd1', False); // 徒弟触发 2014-10-11

        PoseHuman := UserEngine.GetPlayObject(PlayObject.m_sMasterName);
        if PoseHuman <> nil then
        begin
          PoseHuman.m_sMasterName := '';
          PoseHuman.DelMaster(PlayObject.m_sCharName, True); // 出师 2014-10-11
          if g_FunctionNPC <> nil then
            g_FunctionNPC.GotoLable(PoseHuman, '@ForceUnMasterEnd', False); // 师傅触发 2014-10-11
          PoseHuman.RefShowName;
        end
        else
        begin
          g_UnForceMasterList.Lock;
          try
            // 多师徒，强制脱师 chongchong 2014-10-12
            g_UnForceMasterList.Add(PlayObject.m_sMasterName + #9 + PlayObject.m_sCharName);
          finally
            g_UnForceMasterList.UnLock;
          end;

          SaveUnForceMasterList();
        end;

        PlayObject.m_sMasterName := '';
        Npc.GotoLable(PlayObject, '@UnMasterEnd', False);
        PlayObject.RefShowName;
      end;
    end;
  end
  else if (CompareText(QuestActionInfo.sParam1, 'RESPONSEUNMASTER' { sREQUESTUNMARRY } ) = 0) then
  begin
    if (PoseHuman <> nil) and SameText(PoseHuman.m_sMasterName, PlayObject.m_sCharName) then
    begin
      PoseHuman.m_sMasterName := '';
      PoseHuman.m_MasterHuman := nil;

      PlayObject.DelMaster(PoseHuman.m_sCharName, True); // 出师 2014-10-11
      if g_FunctionNPC <> nil then
      begin
        g_FunctionNPC.GotoLable(PlayObject, '@UnMasterEnd', False); // 师傅触发 2014-10-11
        g_FunctionNPC.GotoLable(PoseHuman, '@UnMasterEnd1', False); // 徒弟触发 2014-10-11
      end;

      PoseHuman.RefShowName;
    end;
  end;
end;

procedure ActionOfUnMarry(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  PoseHuman: TPlayObject;
  LoadList: TStringList;
  sUnMarryFileName: string;
begin
  if PlayObject.m_sDearName = '' then
  begin
    Npc.GotoLable(PlayObject, '@ExeMarryFail', False);
    Exit;
  end;

  PoseHuman := TPlayObject(PlayObject.GetPoseCreate);
  if PoseHuman = nil then
    Npc.GotoLable(PlayObject, '@UnMarryCheckDir', False);

  if PoseHuman <> nil then
  begin
    if QuestActionInfo.sParam1 = '' then
    begin
      if PoseHuman.m_btRaceServer <> RC_PLAYOBJECT then
      begin
        Npc.GotoLable(PlayObject, '@UnMarryTypeErr', False);
        Exit;
      end;

      if PoseHuman.GetPoseCreate = PlayObject then
      begin
        if (PlayObject.m_sDearName = PoseHuman.m_sCharName) { and (PosHum.AddInfo.sDearName = Hum.sName) } then
        begin
          Npc.GotoLable(PlayObject, '@StartUnMarry', False);
          Npc.GotoLable(PoseHuman, '@StartUnMarry', False);
          Exit;
        end;
      end;
    end;
  end;

  if (CompareText(QuestActionInfo.sParam1, 'REQUESTUNMARRY' { sREQUESTUNMARRY } ) = 0) then
  begin
    if (QuestActionInfo.sParam2 = '') then
    begin
      if PoseHuman <> nil then
      begin
        PlayObject.m_boStartUnMarry := True;
        if PlayObject.m_boStartUnMarry and PoseHuman.m_boStartUnMarry then
        begin
          UserEngine.SendBroadCastMsg('[' + Npc.m_sCharName + ']: ' + '我宣布' { sUnMarryMsg8 } + PoseHuman.m_sCharName + ' ' + '与'
            { sMarryMsg0 } + PlayObject.m_sCharName + ' ' + ' ' + '正式脱离夫妻关系。' { sUnMarryMsg9 } , t_Say);
          PlayObject.m_sDearName := '';
          PoseHuman.m_sDearName := '';
          Inc(PlayObject.m_btMarryCount);
          Inc(PoseHuman.m_btMarryCount);
          PlayObject.m_boStartUnMarry := False;
          PoseHuman.m_boStartUnMarry := False;
          PlayObject.RefShowName;
          PoseHuman.RefShowName;
          Npc.GotoLable(PlayObject, '@UnMarryEnd', False);
          Npc.GotoLable(PoseHuman, '@UnMarryEnd', False);
        end
        else
        begin
          Npc.GotoLable(PlayObject, '@WateUnMarry', False);
          // GotoLable(PoseHuman,'@RevUnMarry',False);
        end;
      end;
      Exit;
    end
    else
    begin
      // 强行离婚
      if (CompareText(QuestActionInfo.sParam2, 'FORCE') = 0) then
      begin
        UserEngine.SendBroadCastMsg('[' + Npc.m_sCharName + ']: ' + '我宣布' { sUnMarryMsg8 } + PlayObject.m_sCharName + ' ' + '与'
          { sMarryMsg0 } + PlayObject.m_sDearName + ' ' + ' ' + '已经正式脱离夫妻关系！' { sUnMarryMsg9 } , t_Say);
        PoseHuman := UserEngine.GetPlayObject(PlayObject.m_sDearName);
        if PoseHuman <> nil then
        begin
          PoseHuman.m_sDearName := '';
          Inc(PoseHuman.m_btMarryCount);
          PoseHuman.RefShowName;
        end
        else
        begin
          sUnMarryFileName := g_Config.sEnvirDir + 'UnMarry.txt';
          LoadList := TStringList.Create;
          if FileExists(sUnMarryFileName) then
          begin
            LoadList.LoadFromFile(sUnMarryFileName);
          end;
          LoadList.Add(PlayObject.m_sDearName);
          LoadList.SaveToFile(sUnMarryFileName);
          LoadList.Free;
        end;
        PlayObject.m_sDearName := '';
        Inc(PlayObject.m_btMarryCount);
        Npc.GotoLable(PlayObject, '@UnMarryEnd', False);
        PlayObject.RefShowName;
      end;
    end;
  end;
end;

