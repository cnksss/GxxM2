        else if TempMagic.wMagIdx = SKILL_40 { 40 } then // 双龙斩
        begin
          wHitMode := 8;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_42 { 42 } then // 龙影剑法
        begin
          wHitMode := 9;
