procedure ActionOfAddNameDateList(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  LoadList: TStringList;
  boFound: Boolean;
  sListFileName, sLineText, sHumName, sDate: string;
  IsOK: Boolean;
  Path: string;
begin
  if QuestActionInfo.nParam2 = 0 then
    sListFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    sListFileName := QuestActionInfo.sParam1;

  LoadList := TStringList.Create;
  try
    if FileExists(sListFileName) then
    begin
      try
        LoadList.LoadFromFile(sListFileName);
      except
        MainOutMessage('loading fail.... => ' + sListFileName);
      end;
    end;

    boFound := False;
    for I := 0 to LoadList.Count - 1 do
    begin
      sLineText := Trim(LoadList.Strings[I]);
      sLineText := GetValidStr3(sLineText, sHumName, [' ', #9]);
      sLineText := GetValidStr3(sLineText, sDate, [' ', #9]);
      if CompareText(sHumName, BaseObject.m_sCharName) = 0 then
      begin
        LoadList.Strings[I] := BaseObject.m_sCharName + #9 + DateToStr(Date);
        boFound := True;
        Break;
      end;
    end;

    if not boFound then
      LoadList.Add(BaseObject.m_sCharName + #9 + DateToStr(Date));

    IsOK := False;
    for I := 1 to SAVE_RETRY_COUNT do
    begin
      try
        Path := ExtractFilePath(sListFileName);
        if not DirectoryExists(Path) then
        begin
          ForceDirectories(Path);
        end;

        LoadList.SaveToFile(sListFileName);
        IsOK := True;
        Break;
      except
        // Sleep(SAVE_SLEEP_TIME);
      end;
    end;

    if not IsOK then
      MainOutMessage(Format('Save fail; [%s; %s]', [QuestActionInfo.sCmd, sListFileName]));
  finally
    LoadList.Free;
  end;
end;

