procedure ActionOfSetNationValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  cMethod: Char;
  Value: Int64;
  NationInfo: pTNationInfo;
  NationID: Integer;
begin
  NationID := QuestActionInfo.nParam1;

  if (NationID < 0) or (NationID > 100) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (not (QuestActionInfo.nParam2 in [0..6])) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (Length(QuestActionInfo.sParam3) = 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.nParam4 < 0 then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if NationID = 0 then
  begin
    if PlayObject.m_btNation = 0 then
    begin
      Exit;
    end;

    NationInfo := g_NationManage.Items[PlayObject.m_btNation];
    if NationInfo = nil then
    begin
      Exit;
    end;
  end
  else
  begin
    NationInfo := g_NationManage.Items[NationID];
    if NationInfo = nil then
    begin
      Exit;
    end;
  end;

  Value := StrToInt64Def(QuestActionInfo.sParam4, 0);

  cMethod := QuestActionInfo.sParam3[1];
  case cMethod of
    '=':
      begin
        case QuestActionInfo.nParam2 of
          0:
            NationInfo.nGold := Min(Value, High(NationInfo.nGold));
          1:
            NationInfo.wBuilding := Min(Value, High(NationInfo.wBuilding));
          2:
            NationInfo.wArm := Min(Value, High(NationInfo.wArm));
          3:
            NationInfo.wEconomy := Min(Value, High(NationInfo.wEconomy));
          4:
            NationInfo.wPolitics := Min(Value, High(NationInfo.wPolitics));
          5:
            NationInfo.wContribution := Min(Value, High(NationInfo.wContribution));
          6:
            NationInfo.btMaps := Min(Value, High(NationInfo.btMaps));
        end;
      end;
    '+':
      begin
        case QuestActionInfo.nParam2 of
          0:
            NationInfo.nGold := Min(NationInfo.nGold + Value, High(NationInfo.nGold));
          1:
            NationInfo.wBuilding := Min(NationInfo.wBuilding + Value, High(NationInfo.wBuilding));
          2:
            NationInfo.wArm := Min(NationInfo.wArm + Value, High(NationInfo.wArm));
          3:
            NationInfo.wEconomy := Min(NationInfo.wEconomy + Value, High(NationInfo.wEconomy));
          4:
            NationInfo.wPolitics := Min(NationInfo.wPolitics + Value, High(NationInfo.wPolitics));
          5:
            NationInfo.wContribution := Min(NationInfo.wContribution + Value, High(NationInfo.wContribution));
          6:
            NationInfo.btMaps := Min(NationInfo.btMaps + Value, High(NationInfo.btMaps));
        end;
      end;
    '-':
      begin
        case QuestActionInfo.nParam2 of
          0:
            NationInfo.nGold := Max(NationInfo.nGold - Value, 0);
          1:
            NationInfo.wBuilding := Max(NationInfo.wBuilding - Value, 0);
          2:
            NationInfo.wArm := Max(NationInfo.wArm - Value, 0);
          3:
            NationInfo.wEconomy := Max(NationInfo.wEconomy - Value, 0);
          4:
            NationInfo.wPolitics := Max(NationInfo.wPolitics - Value, 0);
          5:
            NationInfo.wContribution := Max(NationInfo.wContribution - Value, 0);
          6:
            NationInfo.btMaps := Max(NationInfo.btMaps - Value, 0);
        end;
      end;
  end;

  g_NationManage.SaveConfig(PlayObject.m_btNation);
end;

procedure ActionOfAutoUseMagic(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
