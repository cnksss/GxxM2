// 清除副本地图的怪物 chongchong 2013-09-06

procedure ActionOfClearEctypeMon(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMAP: string;
  Envir: TEnvirnoment;
  mon: TBaseObject;
  I: Integer;
begin
  sMAP := QuestActionInfo.sParam1;
  if (sMAP = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
  if CompareText(sMAP, 'NPCMAP') = 0 then
    Envir := Npc.m_PEnvir
  else if CompareText(sMAP, 'FBMAP') = 0 then
    Envir := PlayObject.m_FBEnvir
  else if CompareText(sMAP, 'SELF') = 0 then
    Envir := PlayObject.m_PEnvir
  else
    Envir := g_MapManager.FindMap(sMAP);
  if (Envir <> nil) then
  begin
    if Envir.m_boFB then
    begin
      { 清理副本地图的怪 }
      for I := 0 to Envir.m_FBMonsterList.Count - 1 do
      begin
        mon := TBaseObject(Envir.m_FBMonsterList.Items[I]);
        if (not mon.m_boGhost) and (mon.m_Master = nil) then
        begin
          mon.MakeGhost;
        end;
      end;
      Envir.m_FBMonsterList.Clear;
    end
    else
    begin
      { 清理非副本地图的怪物 }
{$IF MULTI_THREAD = 1}
      if g_MultiThreadRun then
        UserEngine.m_MonObjectList.LockR(2);
      try
{$IFEND}
        for I := 0 to UserEngine.m_MonObjectList.Count - 1 do
        begin
          mon := TBaseObject(Envir.m_FBMonsterList.Items[I]);
          if mon.m_PEnvir = Envir then
          begin
            if (not mon.m_boGhost) and (mon.m_Master = nil) then
            begin
              mon.MakeGhost;
            end;
          end;
        end;
{$IF MULTI_THREAD = 1}
      finally
        if g_MultiThreadRun then
          UserEngine.m_MonObjectList.UnLockR;
      end;
{$IFEND}
    end;
  end
  else
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

