  nItemCount: Integer;
  SmartObject: TSmartObject;
  IsChanged: Boolean;
  StdItem: pTStdItem;

  procedure DeleteUseItem(Where: Byte);
  begin
    if SmartObject.m_UseItems[Where].wIndex > 0 then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        TPlayObject(SmartObject).SendDelItem(@SmartObject.m_UseItems[Where])
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(SmartObject).SendDelItem(@SmartObject.m_UseItems[Where]);

      StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[Where].wIndex);

