procedure ActionOfStruckDamageAbsorb(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  AbsorbDamageRate, AbsorbDamageValue: Integer;
  EffectiveTime: LongWord;
  MonsterName: string;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  MonsterName := QuestActionInfo.sParam1; // 怪物名称
  AbsorbDamageRate := QuestActionInfo.nParam2; // 几率
  AbsorbDamageValue := QuestActionInfo.nParam3; // 吸收百分比
  EffectiveTime := QuestActionInfo.nParam4; // 有效时间

  if (MonsterName = '') or (AbsorbDamageRate < 0) or (AbsorbDamageRate > 100) or (AbsorbDamageValue < 0) or (AbsorbDamageValue > 100) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  SmartObject.m_StruckDamageAbsorbMgr.Add(MonsterName, AbsorbDamageRate, AbsorbDamageValue, EffectiveTime);
end;

