        AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, SmartObject.m_UseItems[Where].MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
