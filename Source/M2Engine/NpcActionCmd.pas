procedure ActionOfGetMapHumCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  AObject: TPlayObject;
  Envir: TEnvirnoment;
  S1: string;
  nCount, N1: Integer;
  IsBreakParseVar: Boolean;
begin
  if (QuestActionInfo.sRawParam1 = '') or (QuestActionInfo.sRawParam3 = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
  begin
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
    if Envir = nil then
    begin
      S1 := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, S1, N1, IsBreakParseVar);
      if Length(S1) > 0 then
        Envir := g_MapManager.FindMap(S1);
    end;
  end;

  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  nCount := 0;

  if Envir <> nil then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      UserEngine.m_PlayObjectList.LockR(63);
    try
{$IFEND}
      for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
      begin
        AObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
        if AObject <> nil then
        begin
          if (not AObject.m_boDeath) and (not AObject.m_boGhost) and (AObject.m_PEnvir <> nil) and (AObject.m_PEnvir = Envir) then
          begin
            if AObject.m_boDummyObject then
            begin
              if QuestActionInfo.nParam2 <> 0 then
                Inc(nCount);
            end
            else
            begin
              Inc(nCount);
            end;
          end;
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        UserEngine.m_PlayObjectList.UnLockR;
    end;
{$IFEND}
  end;

  if (not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, IntToStr(nCount), nCount)) then
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
end;

procedure ActionOfMoveMapMonToPos(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  MonName, OldMap, NewMap, sTemp: string;
  OldX, OldY, Range, NewX, NewY, nTemp, nRange, nTempX, nTempY, I: Integer;
  OldEnvir, NewEnvir: TEnvirnoment;
  IsBreakParseVar: Boolean;
  BaseObjectList: TList;
  mon: TBaseObject;
begin
  MonName := QuestActionInfo.sParam1;
  OldMap := QuestActionInfo.sRawParam2;
  OldX := QuestActionInfo.nParam3;
  OldY := QuestActionInfo.nParam4;
  Range := QuestActionInfo.nParam5;
  NewMap := QuestActionInfo.sRawParam6;
  NewX := QuestActionInfo.nParam7;
  NewY := QuestActionInfo.nParam8;
  nRange := QuestActionInfo.nParam9;

  if (MonName = '') or (OldMap = '') or (NewMap = '') or (Range < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  OldEnvir := nil;
  NewEnvir := nil;

  if (not QuestActionInfo.boCompleteFormat2) and (QuestActionInfo.VarInfo2.VarAttr = aFixVar) then
  begin
    OldEnvir := g_MapManager.FindMap(QuestActionInfo.sRawParam2);
    if OldEnvir = nil then
    begin
      sTemp := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam2, sTemp, nTemp, IsBreakParseVar);
      if Length(sTemp) > 0 then
        OldEnvir := g_MapManager.FindMap(sTemp);
    end;
  end;
  if OldEnvir = nil then
    OldEnvir := g_MapManager.FindMap(QuestActionInfo.sParam2);

  if (not QuestActionInfo.boCompleteFormat6) and (QuestActionInfo.VarInfo6.VarAttr = aFixVar) then
  begin
    NewMap := QuestActionInfo.sRawParam6;
    NewEnvir := g_MapManager.FindMap(QuestActionInfo.sRawParam6);
    if NewEnvir = nil then
    begin
      sTemp := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam6, sTemp, nTemp, IsBreakParseVar);
      if Length(sTemp) > 0 then
      begin
        NewMap := sTemp;
        NewEnvir := g_MapManager.FindMap(sTemp);
      end;
    end;
  end;
  if NewEnvir = nil then
  begin
    NewMap := QuestActionInfo.sParam6;
    NewEnvir := g_MapManager.FindMap(QuestActionInfo.sParam6);
  end;

  if (OldEnvir = nil) or (NewEnvir = nil) then
  begin
    Exit;
  end;

  BaseObjectList := TList.Create;
  OldEnvir.GetRangeBaseObject(OldX, OldY, Range, True, BaseObjectList);
  for I := 0 to BaseObjectList.Count - 1 do
  begin
    mon := TBaseObject(BaseObjectList.Items[I]);
    if mon.m_Master <> nil then
      Continue;

    if g_DisableMoveMapMonToPos.IndexOf(mon.m_sCharName) >= 0 then
      Continue;

    if mon.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
      Continue;

    if mon.m_btRaceServer in [RC_MERCHANT, RC_NPC, RC_PEACENPC] then
      Continue;

    if (mon.m_btRaceServer in [ { RC_BOX, } RC_GUARD, 55 { 练功师 }, RC_ARCHERGUARD, 110, 111]) then
      Continue;

    // 在调用 ClearMapMon时，会干掉城堡中的守卫等 chongchong 2018-01-26
    // 修正沙巴克城门等过段时间会自动改变 chongchong 2018-01-26
    if mon.m_Castle <> nil then
      Continue;

    if (MonName = '*') or SameText(MonName, mon.m_sCharName) then
    begin
      if Random(2) = 0 then
        nTempX := NewX + Random(nRange + 1)
      else
        nTempX := NewX - Random(nRange + 1);

      if Random(2) = 0 then
        nTempY := NewY + Random(nRange + 1)
      else
        nTempY := NewY - Random(nRange + 1);

      mon.SpaceMove(NewMap, nTempX, nTempY, 0);
    end;
  end;
  BaseObjectList.Free;
end;

procedure ActionOfGetObjectAbilityEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nAbilityType, nAbilityValue: Integer;
begin
  if BaseObject = nil then
    Exit;

  nAbilityType := QuestActionInfo.nParam1;

  if not (nAbilityType in [0..15, 30]) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.sRawParam2 = '' then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  nAbilityValue := 0;
  case nAbilityType of
    0:
      nAbilityValue := BaseObject.m_WAbil.HP;
    1:
      nAbilityValue := BaseObject.m_WAbil.MaxHP;
    2:
      nAbilityValue := BaseObject.m_WAbil.MP;
    3:
      nAbilityValue := BaseObject.m_WAbil.MaxMP;
    4:
      nAbilityValue := BaseObject.m_WAbil.AC1;
    5:
      nAbilityValue := BaseObject.m_WAbil.AC2;
    6:
      nAbilityValue := BaseObject.m_WAbil.MAC1;
    7:
      nAbilityValue := BaseObject.m_WAbil.MAC2;
    8:
      nAbilityValue := BaseObject.m_WAbil.DC1;
    9:
      nAbilityValue := BaseObject.m_WAbil.DC2;
    10:
      nAbilityValue := BaseObject.m_WAbil.MC1;
    11:
      nAbilityValue := BaseObject.m_WAbil.MC2;
    12:
      nAbilityValue := BaseObject.m_WAbil.SC1;
    13:
      nAbilityValue := BaseObject.m_WAbil.SC2;
    14:
      nAbilityValue := BaseObject.m_nNextHitTime;
    15:
      nAbilityValue := BaseObject.m_nWalkSpeed;
    30:
      nAbilityValue := (MyGetTickCount - BaseObject.m_ChangeAbility.StartTick) div 1000;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(nAbilityValue), nAbilityValue) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfPreviewMonDropItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  DropRate, DropRate2: Integer;
  nIndex, nMaxShowCount: Integer;
  DefMsg: TDefaultMessage;
  dwRefreshTime: LongWord;
  dwTime: LongWord;
  boGetRandItem: Boolean;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    Exit;
  if BaseObject.m_btRaceServer in [RC_MERCHANT, RC_NPC, RC_PEACENPC] then
    Exit;
  if BaseObject.m_boGhost or BaseObject.m_boDeath then
    Exit;

  nMaxShowCount := QuestActionInfo.nParam1;

  dwRefreshTime := 0;
  g_PreviewItemMonList.Lock;
  try
    nIndex := g_PreviewItemMonList.IndexOf(BaseObject.m_sCharName);

    if nIndex >= 0 then
    begin
      dwRefreshTime := DWORD(g_PreviewItemMonList.Objects[nIndex]);
    end;
  finally
    g_PreviewItemMonList.UnLock;
  end;

  if nIndex < 0 then
  begin
    DefMsg := MakeDefaultMsg(SM_PREVIEW_MON_ITEM_RET, 0, 1, 0, 0);
    PlayObject.SendSocket(@DefMsg, '');
    Exit;
  end;

  if not SameText(BaseObject.m_sPreviewMonItemPlayerName, PlayObject.m_sCharName) then
  begin
    if BaseObject.m_boPreviewMonItem then
    begin
      if (dwRefreshTime = 0) or (BaseObject.m_WAbil.HP < BaseObject.m_WAbil.MaxHP) then
      begin
        DefMsg := MakeDefaultMsg(SM_PREVIEW_MON_ITEM_RET, 0, 2, 0, 0);
        PlayObject.SendSocket(@DefMsg, '');
        Exit;
      end
      else if (tick_diff(BaseObject.m_dwPreviewMonItemTick, MyGetTickCount) <= dwRefreshTime * 60 * 1000) then
      begin
        dwTime := (dwRefreshTime * 60 * 1000 + 999 - tick_diff(BaseObject.m_dwPreviewMonItemTick, MyGetTickCount)) div 1000;
        DefMsg := MakeDefaultMsg(SM_PREVIEW_MON_ITEM_RET, 0, 3, LoWord(dwTime), HiWord(dwTime));
        PlayObject.SendSocket(@DefMsg, '');
        Exit;
      end;
    end;
  end;

{$IF NEED_KEY = 1}
  if g_nKey_PreviewMonItem = 0 then
    Exit;
{$IFEND}
  if BaseObject.m_boMonGetRandomItems then
  begin
    boGetRandItem := True;

    if SameText(BaseObject.m_sPreviewMonItemPlayerName, PlayObject.m_sCharName) then
    begin
      if dwRefreshTime = 0 then
        boGetRandItem := False
      else if (tick_diff(BaseObject.m_dwPreviewMonItemTick, MyGetTickCount) < dwRefreshTime * 60 * 1000) then
        boGetRandItem := False;
    end;

    if boGetRandItem then
    begin
      DropRate := PlayObject.m_WAbil.NewValue[11];
      if PlayObject.m_dwKillMonBurstRate > 0 then
        DropRate2 := PlayObject.m_dwKillMonBurstRate
      else
        DropRate2 := 100;

      UserEngine.MonGetRandomItems(PlayObject, BaseObject, DropRate, DropRate2, True);

      BaseObject.m_sPreviewMonItemPlayerName := PlayObject.m_sCharName;
      BaseObject.m_boPreviewMonItem := True;
    end;

    BaseObject.m_dwPreviewMonItemTick := MyGetTickCount;
    BaseObject.m_btPreviewMonItemnMaxCount := nMaxShowCount;
    PlayObject.SendPreviewMonItem(BaseObject);
  end;
end;

procedure ActionOfPreviewMonDropItemRefresh(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  DropRate, DropRate2: Integer;
  nIndex, nMaxShowCount: Integer;
  DefMsg: TDefaultMessage;
  dwRefreshTime: LongWord;
  boGetRandItem: Boolean;
  boIncludeNoTime: Boolean;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    Exit;
  if BaseObject.m_btRaceServer in [RC_MERCHANT, RC_NPC, RC_PEACENPC] then
    Exit;
  if BaseObject.m_boGhost or BaseObject.m_boDeath then
    Exit;

  nMaxShowCount := QuestActionInfo.nParam1;
  boIncludeNoTime := QuestActionInfo.nParam2 <> 0; // 是否刷新所有（含间隔设置为0）

  dwRefreshTime := 0;
  g_PreviewItemMonList.Lock;
  try
    nIndex := g_PreviewItemMonList.IndexOf(BaseObject.m_sCharName);

    if nIndex >= 0 then
    begin
      dwRefreshTime := DWORD(g_PreviewItemMonList.Objects[nIndex]);
    end;
  finally
    g_PreviewItemMonList.UnLock;
  end;

  if nIndex < 0 then
  begin
    DefMsg := MakeDefaultMsg(SM_PREVIEW_MON_ITEM_RET, 0, 1, 0, 0);
    PlayObject.SendSocket(@DefMsg, '');
    Exit;
  end;

  if not SameText(BaseObject.m_sPreviewMonItemPlayerName, PlayObject.m_sCharName) then
  begin
    if BaseObject.m_boPreviewMonItem then
    begin
      if (dwRefreshTime = 0) then
      begin
        if not boIncludeNoTime then
        begin
          Exit;
        end;
      end;
    end;
  end;

{$IF NEED_KEY = 1}
  if g_nKey_PreviewMonItem = 0 then
    Exit;
{$IFEND}
  if BaseObject.m_boMonGetRandomItems then
  begin
    boGetRandItem := True;

    {
      if SameText(BaseObject.m_sPreviewMonItemPlayerName, PlayObject.m_sCharName) then
      begin
      if dwRefreshTime = 0 then
      boGetRandItem := False
      else if (tick_diff(BaseObject.m_dwPreviewMonItemTick, MyGetTickCount) < dwRefreshTime * 60 * 1000) then
      boGetRandItem := False;
      end;
    }

    if boGetRandItem then
    begin
      DropRate := PlayObject.m_WAbil.NewValue[11];
      if PlayObject.m_dwKillMonBurstRate > 0 then
        DropRate2 := PlayObject.m_dwKillMonBurstRate
      else
        DropRate2 := 100;

      UserEngine.MonGetRandomItems(PlayObject, BaseObject, DropRate, DropRate2, True);

      BaseObject.m_sPreviewMonItemPlayerName := PlayObject.m_sCharName;
      BaseObject.m_boPreviewMonItem := True;
    end;

    BaseObject.m_dwPreviewMonItemTick := MyGetTickCount;
    BaseObject.m_btPreviewMonItemnMaxCount := nMaxShowCount;
    PlayObject.SendPreviewMonItem(BaseObject);
  end;

end;

procedure ActionOfChangeAccountInfo(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sAccount, sPassword, sL2Password, sUserName, sBirthday, sAsk1, sAnswer1, sAsk2, sAnswer2, sMail, sMobilePhone: AnsiString;
  sLabel: string;
  FmtSettings: TFormatSettings;
  dtBirthDay: TDateTime;
  AccountInfo: TAccountInfo2;
begin
  sAccount := QuestActionInfo.sParam1;
  sPassword := QuestActionInfo.sParam2;
  sUserName := QuestActionInfo.sParam3;
  sBirthday := QuestActionInfo.sParam4;
  sAsk1 := QuestActionInfo.sParam5;
  sAnswer1 := QuestActionInfo.sParam6;
  sAsk2 := QuestActionInfo.sParam7;
  sAnswer2 := QuestActionInfo.sParam8;
  sMail := QuestActionInfo.sParam9;
  sMobilePhone := QuestActionInfo.sParam10;
  sL2Password := Trim(QuestActionInfo.sSubParam10);

  if (Length(sAccount) < MIN_ACCOUNT_LEN) or (not CheckAccountName(sAccount)) or (not CheckAccountValid(sAccount)) or (not CheckStringValid(sAccount)) then
  begin
    sLabel := '@ChangeAccountInfo_Error_Account';
    PlayObject.m_nScriptGotoCount := 0;
    Npc.GotoLable(PlayObject, sLabel, False);
    Exit;
  end;

  if (Length(sPassword) < 3) or (not CheckStringValid(sPassword)) then
  begin
    sLabel := '@ChangeAccountInfo_Error_Password';
    PlayObject.m_nScriptGotoCount := 0;
    Npc.GotoLable(PlayObject, sLabel, False);
    Exit;
  end;

  if (Length(sUserName) = 0) or (not CheckStringValid(sUserName)) then
  begin
    sLabel := '@ChangeAccountInfo_Error_UserName';
    PlayObject.m_nScriptGotoCount := 0;
    Npc.GotoLable(PlayObject, sLabel, False);
    Exit;
  end;

{$IF CompilerVersion >= 22}
  FmtSettings := TFormatSettings.Create(GetThreadLocale);
{$ELSE}
  GetLocaleFormatSettings(GetUserDefaultLCID, FmtSettings);
{$IFEND}
  FmtSettings.DateSeparator := '/';
  if not TryStrToDateTime(sBirthday, dtBirthDay, FmtSettings) then
  begin
    sLabel := '@ChangeAccountInfo_Error_BirthDay';
    PlayObject.m_nScriptGotoCount := 0;
    Npc.GotoLable(PlayObject, sLabel, False);
    Exit;
  end;

  if (Length(sAsk1) = 0) or (not CheckStringValid(sAsk1)) then
  begin
    sLabel := '@ChangeAccountInfo_Error_Quiz1';
    PlayObject.m_nScriptGotoCount := 0;
    Npc.GotoLable(PlayObject, sLabel, False);
    Exit;
  end;

  if (Length(sAnswer1) = 0) or (not CheckStringValid(sAnswer1)) then
  begin
    sLabel := '@ChangeAccountInfo_Error_Answer1';
    PlayObject.m_nScriptGotoCount := 0;
    Npc.GotoLable(PlayObject, sLabel, False);
    Exit;
  end;

  if (Length(sAsk2) = 0) or (not CheckStringValid(sAsk2)) then
  begin
    sLabel := '@ChangeAccountInfo_Error_Quiz2';
    PlayObject.m_nScriptGotoCount := 0;
    Npc.GotoLable(PlayObject, sLabel, False);
    Exit;
  end;

  if (Length(sAnswer2) = 0) or (not CheckStringValid(sAnswer2)) then
  begin
    sLabel := '@ChangeAccountInfo_Error_Answer2';
    PlayObject.m_nScriptGotoCount := 0;
    Npc.GotoLable(PlayObject, sLabel, False);
    Exit;
  end;

  if (Length(sMail) > 0) then
  begin
    if (not CheckStringValid2(sMail)) then
    begin
      sLabel := '@ChangeAccountInfo_Error_Mail';
      PlayObject.m_nScriptGotoCount := 0;
      Npc.GotoLable(PlayObject, sLabel, False);
      Exit;
    end;
  end;

  if (Length(sMobilePhone) > 0) then
  begin
    if (not CheckStringValid(sMobilePhone)) then
    begin
      sLabel := '@ChangeAccountInfo_Error_MobilePhone';
      PlayObject.m_nScriptGotoCount := 0;
      Npc.GotoLable(PlayObject, sLabel, False);
      Exit;
    end;
  end;

  if (Length(sL2Password) > 0) then
  begin
    if (not CheckStringValid(sL2Password)) then
    begin
      sLabel := '@ChangeAccountInfo_Error_L2Password';
      PlayObject.m_nScriptGotoCount := 0;
      Npc.GotoLable(PlayObject, sLabel, False);
      Exit;
    end;
  end;

  AccountInfo.PlayObject := Int64(PlayObject);
  AccountInfo.Npc := Int64(Npc);
  AccountInfo.AccountName := sAccount;
  AccountInfo.Password := sPassword;
  AccountInfo.UserName := sUserName;
  AccountInfo.BirthDay := sBirthday;
  AccountInfo.Questions1 := sAsk1;
  AccountInfo.Answers1 := sAnswer1;
  AccountInfo.Questions2 := sAsk2;
  AccountInfo.Answers2 := sAnswer2;
  AccountInfo.MobilePhone := sMobilePhone;
  AccountInfo.Mail := sMail;
  AccountInfo.L2Password := sL2Password;

  sLabel := '@ChangeAccountInfoing';
  PlayObject.m_nScriptGotoCount := 0;
  Npc.GotoLable(PlayObject, sLabel, False);

  FrmIDSoc.SendChangeAccountInfo(@AccountInfo);
end;

