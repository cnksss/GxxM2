procedure ActionOfAddToCastleWarList(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIndex, nDay: Integer;
  sCastleName: string;
  sGuildName: string;
  Guild: TGUild;
  UserCastle: TUserCastle;
begin
  sCastleName := QuestActionInfo.sParam1;

  UserCastle := g_CastleManager.Find(sCastleName);
  if UserCastle = nil then
  begin
    BaseObject.SysMsg(Format('[失败] 没有找到城堡“%s”', [sCastleName]), c_Red, t_Hint);
    // Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  sGuildName := QuestActionInfo.sParam2;
  nDay := StrToIntDef(QuestActionInfo.sParam3, -1);

  if nDay < 0 then
    nDay := g_Config.nStartCastleWarDays;

  if (sGuildName = '*') or (sGuildName = '') then
  begin
    for nIndex := 0 to g_GuildManager.GuildList.Count - 1 do
    begin
      UserCastle.AddAttackerInfo(TGUild(g_GuildManager.GuildList.Items[nIndex]), nDay);
    end;
  end
  else
  begin
    Guild := g_GuildManager.FindGuild(sGuildName);
    if (Guild = nil) then
    begin
      BaseObject.SysMsg(Format('[失败] 没有找到行会“%s”', [sGuildName]), c_Red, t_Hint);
      // Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
      Exit;
    end;
    UserCastle.AddAttackerInfo(Guild, nDay);
  end;
end;

procedure ActionOfAddAttacksabukAll(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIndex: Integer;
  UserCastle: TUserCastle;
begin
  nIndex := QuestActionInfo.nParam1;
  if (nIndex < 0) or (nIndex >= g_CastleManager.m_CastleList.Count) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  g_CastleManager.Lock;
  try
    UserCastle := TUserCastle(g_CastleManager.m_CastleList.Items[nIndex]);
  finally
    g_CastleManager.UnLock;
  end;

  for nIndex := 0 to g_GuildManager.GuildList.Count - 1 do
  begin
    UserCastle.AddAttackerInfo(TGUild(g_GuildManager.GuildList.Items[nIndex]), 0);
  end;
end;

procedure ActionOfRelive(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  IsDelay: Boolean;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;
  if (BaseObject.m_PEnvir <> nil) and ((BaseObject.m_PEnvir.m_nRevivalMaxCount < 0) or (SmartObject.m_nRevivalCount < BaseObject.m_PEnvir.m_nRevivalMaxCount)) then
  begin
    if BaseObject.m_PEnvir.m_nRevivalMaxCount >= 0 then
      Inc(SmartObject.m_nRevivalCount);

    IsDelay := False;
    if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    begin
      IsDelay := MyGetTickCount - BaseObject.m_dwDeathTick < 1000;
    end;

    BaseObject.ReAlive(IsDelay);

    if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    begin
      BaseObject.SendMsg(BaseObject, RM_ABILITY, 0, 0, 0, 0, '');

      if TSmartObject(BaseObject).m_boContinuous then
      begin
        TPlayObject(BaseObject).m_boContinuous := False;
        TPlayObject(BaseObject).SendMsg(BaseObject, RM_STOPCONTINUOUSMAGIC, 0, 0, 0, 0, '');
      end;
    end;
  end;
end;

procedure ActionOfAddGuildMember(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sCharName: string;
  sGuildName: string;
  Guild: TGUild;
  Member: TPlayObject;
begin
  sGuildName := QuestActionInfo.sParam1;
  sCharName := QuestActionInfo.sParam2;

  Guild := g_GuildManager.FindGuild(sGuildName);
  if Guild = nil then
  begin
    BaseObject.SysMsg(Format('[会员增加失败] 没有找到行会“%s”', [sGuildName]), c_Red, t_Hint);
    // Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if sCharName = '' then
    sCharName := BaseObject.m_sCharName;

  Member := UserEngine.GetPlayObject(sCharName);

  if (Member = nil) or (Member.m_MyGuild <> nil) then
    Exit;

  if not Guild.IsMember(sCharName) then
  begin
    if not Guild.IsFull then
    begin
      Guild.AddMember(Member);
      Member.m_MyGuild := Guild;
      Member.m_sGuildRankName := Guild.GetRankName2(Member, Member.m_nGuildRankNo);
      Member.SendMsg(Member, RM_CHANGEGUILDNAME, 0, 0, 0, 0, '');
      Member.RefShowName();

      if g_FunctionNPC <> nil then
      begin
        Member.m_nScriptGotoCount := 0;
        g_FunctionNPC.GotoLable(Member, '@JoinGuild', False);
      end;
    end
    else
    begin
      BaseObject.SysMsg(Format('[会员增加失败] %s最高只能增加%d个成员', [Guild.sGuildName, Guild.m_nMemberMaxLimit]), c_Red, t_Hint);
    end;
  end;
end;

procedure ActionOfSetThrowItemFrom(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  ItemForm: Integer; // TItemFormType;
  Envir: TEnvirnoment;
  sMonName, sMakerName: string;
  sDate, sTime: string;
  ddDate, dtTime: TDateTime;
  DateFmt: TFormatSettings;
begin
  ItemForm := QuestActionInfo.nParam1;
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat2) and (QuestActionInfo.VarInfo2.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam2);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam2);
  sMonName := QuestActionInfo.sParam3;
  sMakerName := QuestActionInfo.sParam4;
  sDate := QuestActionInfo.sParam5;
  sTime := QuestActionInfo.sParam6;

  if (Envir = nil) or (ItemForm < Integer(Low(TItemFormType))) or (ItemForm > Integer(High(TItemFormType))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

{$IF CompilerVersion >= 22}
  DateFmt := TFormatSettings.Create(GetThreadLocale);
{$ELSE}
  GetLocaleFormatSettings(GetThreadLocale, DateFmt);
{$IFEND}
  DateFmt.DateSeparator := '-';
  DateFmt.TimeSeparator := ':';
  try
    ddDate := StrToDate(sDate, DateFmt);
  except
    Npc.ScriptActionError(PlayObject, '日期错误(格式:yyyy-mm-dd)', QuestActionInfo);
    Exit;
  end;

  try
    dtTime := StrToTime(sTime, DateFmt);
  except
    Npc.ScriptActionError(PlayObject, '时间错误(格式:hh:nn:ss)', QuestActionInfo);
    Exit;
  end;

  BaseObject.m_boSetThrowItemFrom := True;
  BaseObject.m_ThrowItemFrom.ItemForm := TItemFormType(ItemForm);
  BaseObject.m_ThrowItemFrom.sMapName := Envir.sMapDesc;
  BaseObject.m_ThrowItemFrom.sMonName := sMonName;
  BaseObject.m_ThrowItemFrom.sMakerName := sMakerName;
  BaseObject.m_ThrowItemFrom.DateTime := Trunc(ddDate) + dtTime - Trunc(dtTime);
end;

procedure ActionOfThrowItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  sItemName: string;
  sParam6: string;
  sCount: string;
  sTime: string;
  nX, nY: Integer;
  ItemX, ItemY: Integer;
  nCount: Integer;
  nTime: Integer;
  nRange: Integer;
  nPos: Integer;
  Envir: TEnvirnoment;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  ItemOfCreat: TBaseObject;
  ItemReserved: Byte;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  nX := QuestActionInfo.nParam2;
  nY := QuestActionInfo.nParam3;
  nRange := QuestActionInfo.nParam4;
  sItemName := QuestActionInfo.sParam5;
  sParam6 := QuestActionInfo.sParam6;

  sCount := sParam6;
  sTime := '';
  nPos := Pos('|', sParam6);
  if nPos > 0 then
  begin
    sCount := Copy(sParam6, 1, nPos - 1);
    sTime := Copy(sParam6, nPos + 1, Length(sParam6) - nPos);
  end;
  nCount := StrToIntDef(sCount, -1);
  nTime := StrToIntDef(sTime, -1);
  if nTime < 0 then
    nTime := g_Config.dwFloorItemCanPickUpTime
  else
    nTime := nTime * 1000;

  StdItem := nil;
  if sItemName <> sSTRING_GOLDNAME then
  begin
    StdItem := UserEngine.GetStdItem(sItemName);
  end;

  if ((sItemName <> sSTRING_GOLDNAME) and (StdItem = nil)) then
    Exit;

  { if (Envir = nil) or (nCount < 0) or (nX < 0) or (nY < 0) or (nRange < 0) then
    begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
    end; }

  if sItemName = sSTRING_GOLDNAME then
  begin
    New(UserItem);
    if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
    begin
      if BaseObject.m_boSetThrowItemFrom then
      begin
        UserItem.ItemFrom := BaseObject.m_ThrowItemFrom;
        BaseObject.m_boSetThrowItemFrom := False;
      end
      else
      begin
        UserItem.ItemFrom.ItemForm := ifScript;
        UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
        UserItem.ItemFrom.DateTime := Now();
      end;

      // 随机掉落 piaoyun 2013-07-27
      if Envir.GetRangeXY(nX, nY, nRange, ItemX, ItemY) then
      begin
        ItemOfCreat := Npc;
        ItemReserved := 0;

        case QuestActionInfo.nParam7 of
          0:
            begin
              ItemOfCreat := Npc;
            end;
          1: // 所有人都可立即捡
            begin
              ItemOfCreat := nil;
            end;
          2: // 自己与队伍可立即拾取，其他人不可拾取，需等到时间
            begin
              ItemOfCreat := PlayObject;
              ItemReserved := 0;
            end;
          3: // 自己可以立即拾取。其他人需要等到时间才可以
            begin
              ItemOfCreat := PlayObject;
              ItemReserved := 1;
            end;
        end;

        BaseObject.NpcGiveAndDropItemDown(UserItem, nRange, ItemOfCreat, Npc, Envir, ItemX, ItemY, nCount, nTime, ItemReserved, False, Npc.m_sCharName, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;
    end;
    Dispose(UserItem);

    Exit;
  end;

  // 参数8为0，叠加物品叠加存放，1：非叠加存放
  if (QuestActionInfo.nParam8 = 0) and CheckOverLapItem(StdItem) then
  begin
    New(UserItem);
    while True do
    begin
      if nCount <= 0 then
        Break;

      if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
      begin
        if BaseObject.m_boSetThrowItemFrom then
        begin
          UserItem.ItemFrom := BaseObject.m_ThrowItemFrom;
          BaseObject.m_boSetThrowItemFrom := False;
        end
        else
        begin
          UserItem.ItemFrom.ItemForm := ifScript;
          UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
          UserItem.ItemFrom.DateTime := Now();
        end;

        if nCount >= UserItem.DuraMax then
        begin
          UserItem.Dura := UserItem.DuraMax - 1;
          Dec(nCount, UserItem.DuraMax);
        end
        else
        begin
          UserItem.Dura := nCount - 1;
          nCount := 0;
        end;

        // 随机掉落 piaoyun 2013-07-27
        // BaseObject.DropItemDown(UserItem, nRange, Npc, Envir, nX, nY, 1, nTime);
        if Envir.GetRangeXY(nX, nY, nRange, ItemX, ItemY) then
        begin
          ItemOfCreat := Npc;
          ItemReserved := 0;

          case QuestActionInfo.nParam7 of
            0:
              begin
                ItemOfCreat := Npc;
              end;
            1: // 所有人都可立即捡
              begin
                ItemOfCreat := nil;
              end;
            2: // 自己与队伍可立即拾取，其他人不可拾取，需等到时间
              begin
                ItemOfCreat := PlayObject;
                ItemReserved := 0;
              end;
            3: // 自己可以立即拾取。其他人需要等到时间才可以
              begin
                ItemOfCreat := PlayObject;
                ItemReserved := 1;
              end;
          end;

          BaseObject.NpcGiveAndDropItemDown(UserItem, nRange, ItemOfCreat, Npc, Envir, ItemX, ItemY, nCount, nTime, ItemReserved, True, Npc.m_sCharName, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
        end;
      end;
    end;
    Dispose(UserItem);
  end
  else
  begin
    for I := 0 to nCount - 1 do
    begin
      New(UserItem);
      if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
      begin
        if BaseObject.m_boSetThrowItemFrom then
        begin
          UserItem.ItemFrom := BaseObject.m_ThrowItemFrom;
          BaseObject.m_boSetThrowItemFrom := False;
        end
        else
        begin
          UserItem.ItemFrom.ItemForm := ifScript;
          UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
          UserItem.ItemFrom.DateTime := Now();
        end;

        // 随机掉落 piaoyun 2013-07-27
        // BaseObject.DropItemDown(UserItem, nRange, Npc, Envir, nX, nY, 1, nTime);
        if Envir.GetRangeXY(nX, nY, nRange, ItemX, ItemY) then
        begin
          ItemOfCreat := Npc;
          ItemReserved := 0;

          case QuestActionInfo.nParam7 of
            0:
              begin
                ItemOfCreat := Npc;
              end;
            1: // 所有人都可立即捡
              begin
                ItemOfCreat := nil;
              end;
            2: // 自己与队伍可立即拾取，其他人不可拾取，需等到时间
              begin
                ItemOfCreat := PlayObject;
                ItemReserved := 0;
              end;
            3: // 自己可以立即拾取。其他人需要等到时间才可以
              begin
                ItemOfCreat := PlayObject;
                ItemReserved := 1;
              end;
          end;

          BaseObject.NpcGiveAndDropItemDown(UserItem, nRange, ItemOfCreat, Npc, Envir, ItemX, ItemY, nCount, nTime, ItemReserved, True, Npc.m_sCharName, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
        end;
      end;
      Dispose(UserItem);
    end;
  end;
end;

