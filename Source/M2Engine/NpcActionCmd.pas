procedure ActionOfGetBagItemFieldValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);

  function GetItemValue(FieldName: string; UserItem: pTUserItem): string;
  var
    sRet: string;
    StdItem: pTStdItem;
    NewStdItem: TStdItem;
  begin
    if SameText(FieldName, 'makeindex') then
      sRet := IntToStr(UserItem.MakeIndex)
    else if SameText(FieldName, 'idx') then
      sRet := IntToStr(UserItem.wIndex - 1)
    else if SameText(FieldName, 'dura') then
      sRet := IntToStr(UserItem.Dura)
    else if SameText(FieldName, 'duramax') then
      sRet := IntToStr(UserItem.DuraMax)
    else if SameText(FieldName, 'upgradecount') then
      sRet := IntToStr(UserItem.btUpgradeCount)
    else if SameText(FieldName, 'Value0') then
      sRet := IntToStr(UserItem.btValue[0])
    else if SameText(FieldName, 'Value1') then
      sRet := IntToStr(UserItem.btValue[1])
    else if SameText(FieldName, 'Value2') then
      sRet := IntToStr(UserItem.btValue[2])
    else if SameText(FieldName, 'Value3') then
      sRet := IntToStr(UserItem.btValue[3])
    else if SameText(FieldName, 'Value4') then
      sRet := IntToStr(UserItem.btValue[4])
    else if SameText(FieldName, 'Value5') then
      sRet := IntToStr(UserItem.btValue[5])
    else if SameText(FieldName, 'Value6') then
      sRet := IntToStr(UserItem.btValue[6])
    else if SameText(FieldName, 'Value7') then
      sRet := IntToStr(UserItem.btValue[7])
    else if SameText(FieldName, 'Value8') then
      sRet := IntToStr(UserItem.btValue[8])
    else if SameText(FieldName, 'Value9') then
      sRet := IntToStr(UserItem.btValue[9])
    else if SameText(FieldName, 'Value10') then
      sRet := IntToStr(UserItem.btValue[10])
    else if SameText(FieldName, 'Value11') then
      sRet := IntToStr(UserItem.btValue[11])
