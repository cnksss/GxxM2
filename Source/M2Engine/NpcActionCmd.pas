procedure ActionOfDelLinkItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nCount: Integer;
  UserItem, LinkItem: pTUserItem;
  SmartObject: TSmartObject;
  StdItem: pTStdItem;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nCount := QuestActionInfo.nParam1;
  if nCount < 0 then
    nCount := 0;

  if SmartObject.m_btRaceServer = RC_HEROOBJECT then
  begin
    LinkItem := THeroObject(SmartObject).m_LinkItem;
    THeroObject(SmartObject).m_LinkItem := nil;
  end
  else
  begin
    LinkItem := TPlayObject(SmartObject).m_UpgradeItem;
    TPlayObject(SmartObject).m_UpgradeItem := nil;
  end;

  for I := 0 to SmartObject.m_ItemList.Count - 1 do
  begin
    UserItem := SmartObject.m_ItemList[I];

    if UserItem = LinkItem then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);

      if StdItem <> nil then
      begin
        if CheckOverLapItem(StdItem) then
        begin
          if (nCount = 0) or (nCount >= UserItem.Dura + 1) then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, UserItem.Dura + 1, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            if SmartObject.m_btRaceServer = RC_HEROOBJECT then
              THeroObject(SmartObject).SendDelItem(UserItem)
            else
              TPlayObject(SmartObject).SendDelItem(UserItem);

            SmartObject.m_ItemList.Delete(I);
            Dispose(UserItem);
          end
          else
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, UserItem.Dura - nCount + 1, UserItem.Dura + 1, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            UserItem.Dura := UserItem.Dura - nCount;

            if SmartObject.m_btRaceServer = RC_HEROOBJECT then
              THeroObject(SmartObject).SendUpdateItemDura(-1, UserItem.MakeIndex, UserItem.Dura)
            else
              TPlayObject(SmartObject).SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura);
          end;
        end
        else
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            // 注释日志 chongchong 2017-10-09
            AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, UserItem.Dura + 1, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
          end;

          if SmartObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(SmartObject).SendDelItem(UserItem)
          else
            TPlayObject(SmartObject).SendDelItem(UserItem);

          SmartObject.m_ItemList.Delete(I);
          Dispose(UserItem);
        end;
      end;

      Break;
    end;
  end;
end;

procedure ActionOfSetGuildMaster(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  IsSetMaster1: Boolean;
  Guild: TGUild;
  Master1, Master2: string;
  MasterPlayer: TPlayObject;
  GuildRank: pTGuildRank;
begin
  if PlayObject.m_MyGuild = nil then
    Exit;

  if not (QuestActionInfo.nParam1 in [1, 2]) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  IsSetMaster1 := QuestActionInfo.nParam1 = 1;

  Guild := TGUild(PlayObject.m_MyGuild);
  Guild.GetGuildMasterName(Master1, Master2);

  if SameText(PlayObject.m_sCharName, Master1) then
    Exit;

  if SameText(PlayObject.m_sCharName, Master2) then
    Exit;

  for I := 0 to Guild.m_RankList.Count - 1 do
  begin
    GuildRank := Guild.m_RankList.Items[I];
    if GuildRank.nRankNo = 1 then
    begin
      if IsSetMaster1 then
      begin
        if Guild.DelMember(PlayObject.m_sCharName) then
        begin
          GuildRank.MemberList.Delete(0);
          GuildRank.MemberList.InsertObject(0, PlayObject.m_sCharName, PlayObject);

          PlayObject.m_sGuildRankName := Guild.GetRankName2(PlayObject, PlayObject.m_nGuildRankNo);
          PlayObject.RefShowName();

          MasterPlayer := UserEngine.GetPlayObject(Master1);
          if MasterPlayer <> nil then
          begin
            Guild.AddMember(MasterPlayer);
            MasterPlayer.m_sGuildRankName := Guild.GetRankName2(MasterPlayer, MasterPlayer.m_nGuildRankNo);
            MasterPlayer.RefShowName();
          end
          else
            Guild.AddMember2(Master1);

          Guild.UpdateGuildFile;
        end;
      end
      else
      begin
        if Master2 <> '' then
        begin
          if Guild.DelMember(PlayObject.m_sCharName) then
          begin
            GuildRank.MemberList.Delete(1);
            GuildRank.MemberList.AddObject(PlayObject.m_sCharName, PlayObject);

            PlayObject.m_sGuildRankName := Guild.GetRankName2(PlayObject, PlayObject.m_nGuildRankNo);
            PlayObject.RefShowName();

            MasterPlayer := UserEngine.GetPlayObject(Master2);
            if MasterPlayer <> nil then
            begin
              Guild.AddMember(MasterPlayer);
              MasterPlayer.m_sGuildRankName := Guild.GetRankName2(MasterPlayer, MasterPlayer.m_nGuildRankNo);
              MasterPlayer.RefShowName();
            end
            else
              Guild.AddMember2(Master2);

            Guild.UpdateGuildFile;
          end;
        end
        else if Guild.DelMember(PlayObject.m_sCharName) then
        begin
          GuildRank.MemberList.AddObject(PlayObject.m_sCharName, PlayObject);
          PlayObject.m_sGuildRankName := Guild.GetRankName2(PlayObject, PlayObject.m_nGuildRankNo);
          PlayObject.RefShowName();

          Guild.UpdateGuildFile;
        end;
      end;

      Break;
    end;
  end;
end;

procedure ActionOfSetSecretMode(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Envir: TEnvirnoment;
  SecretFlag: Integer;
  SecretShowName: string;
  SecretDressShap: Word;
  SecretWeaponShap: Word;
  Player: TPlayObject;
begin
  Envir := nil;
  if QuestActionInfo.sRawParam1 = '*' then
    Envir := nil
  else
  begin
    if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
      Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);

    if Envir = nil then
      Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

    if Envir = nil then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;
  end;

  SecretFlag := QuestActionInfo.nParam2;
  SecretShowName := QuestActionInfo.sParam3;
  SecretDressShap := QuestActionInfo.nParam4;
  SecretWeaponShap := QuestActionInfo.nParam5;

  if Envir = nil then
  begin
    g_MapManager.Lock;
    try
      for I := 0 to g_MapManager.Count - 1 do
      begin
        Envir := g_MapManager.Items[I];
        Envir.m_nSecretFlag2 := SecretFlag;
        Envir.m_sSecretShowName2 := SecretShowName;
        Envir.m_wSecretDressShap2 := SecretDressShap;
        Envir.m_wSecretWeaponShap2 := SecretWeaponShap;
      end;
    finally
      g_MapManager.UnLock;
    end;

{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      UserEngine.m_PlayObjectList.LockR(63);
    try
{$IFEND}
      for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
      begin
        Player := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
        if Player <> nil then
        begin
          if (not Player.m_boDeath) and (not Player.m_boGhost) then
          begin
            Player.FeatureChanged;
            Player.RefShowName;
            Player.RefUseIcons;

            if (Player.m_MyHero <> nil) and (not Player.m_MyHero.m_boDeath) and (not Player.m_MyHero.m_boGhost) then
            begin
              Player.m_MyHero.FeatureChanged;
              Player.m_MyHero.RefShowName;
            end;
          end;
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        UserEngine.m_PlayObjectList.UnLockR;
    end;
{$IFEND}
  end
  else
  begin
    Envir.m_nSecretFlag2 := SecretFlag;
    Envir.m_sSecretShowName2 := SecretShowName;
    Envir.m_wSecretDressShap2 := SecretDressShap;
    Envir.m_wSecretWeaponShap2 := SecretWeaponShap;

{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      UserEngine.m_PlayObjectList.LockR(63);
    try
{$IFEND}
      for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
      begin
        Player := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
        if Player <> nil then
        begin
          if (Player.m_PEnvir = Envir) and (not Player.m_boDeath) and (not Player.m_boGhost) then
          begin
            Player.FeatureChanged;
            Player.RefShowName;
            Player.RefUseIcons;

            if (Player.m_MyHero <> nil) and (not Player.m_MyHero.m_boDeath) and (not Player.m_MyHero.m_boGhost) then
            begin
              Player.m_MyHero.FeatureChanged;
              Player.m_MyHero.RefShowName;
            end;
          end;
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        UserEngine.m_PlayObjectList.UnLockR;
    end;
{$IFEND}
  end;
end;

procedure ActionOfChangeAppr(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nNewAppr: Integer;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nNewAppr := QuestActionInfo.nParam1;

  if (nNewAppr < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
  begin
    // 人物变身，下马 2020-08-22 16:26:40
    if PlayObject.m_boOnHorse then
    begin
      if PlayObject.m_HorseOtherHum <> nil then
      begin
        { 骑马发起人下马，被邀请人也下马 chongchong 2013-10-14 }
        if PlayObject.m_boHorseMaster then
        begin
          PlayObject.m_HorseOtherHum.m_boOnHorse := False;
          PlayObject.m_HorseOtherHum.m_dwDownHorseTick := MyGetTickCount;
          PlayObject.m_HorseOtherHum.m_dwClientTakeHorseTick := MyGetTickCount;
        end;

        PlayObject.m_HorseOtherHum.m_HorseOtherHum := nil;
        PlayObject.m_HorseOtherHum.DoTalkStatusChanged;
        PlayObject.m_HorseOtherHum.TriggerHorseScript;
        if PlayObject.m_boHorseMaster then
          PlayObject.m_HorseOtherHum.SendTakeOffHorse;
      end;

      PlayObject.StopCollect;

      PlayObject.m_boOnHorse := False;
      PlayObject.m_dwClientTakeHorseTick := MyGetTickCount;
      PlayObject.m_dwDownHorseTick := MyGetTickCount;
      PlayObject.m_HorseOtherHum := nil;
      PlayObject.DoTalkStatusChanged;
      PlayObject.TriggerHorseScript;
      if not PlayObject.m_boHorseMaster then
        PlayObject.SendTakeOffHorse;
    end;
  end;

  SmartObject.m_nChangeAppr := nNewAppr;
  SmartObject.m_dwChangeApprTick := MyGetTickCount;
  SmartObject.m_nChangeApprTime := QuestActionInfo.nParam2;
  SmartObject.FeatureChanged;
end;

procedure ActionOfSetItemAddByte(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nValueIndex, nValue: Integer;
  UserItem: pTUserItem;
  SmartObject: TSmartObject;
  nBoxItemIndex, nMakeIndex: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  nValueIndex := QuestActionInfo.nParam2;
  nValue := QuestActionInfo.nParam3;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) or (nValueIndex < 0) or (nValueIndex >= USER_ITEM_ADD_DATA_BYTE_COUNT) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  // LockUpdateItemIndex := -1;
  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      // LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
