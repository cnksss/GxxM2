procedure ActionOfSendMoveHintMsg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMsg: string;
  nFColor, nBColor, nX, nY: Integer;
begin
  nFColor := StrToIntDef(QuestActionInfo.sParam2, -1);
  nBColor := StrToIntDef(QuestActionInfo.sParam3, -1);
  nX := StrToIntDef(QuestActionInfo.sParam4, 0);
  nY := StrToIntDef(QuestActionInfo.sParam5, 0);

  if not ((nFColor in [0..255]) and ((nBColor in [0..255]))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  sMsg := QuestActionInfo.sParam1;
  Npc.GetVarValue(PlayObject, sMsg, sMsg);

  if Npc.m_boMapEvent then
  begin
    sMsg := AnsiReplaceText(sMsg, '%s', PlayObject.m_sScatterItemName);
    sMsg := AnsiReplaceText(sMsg, '%x', IntToStr(PlayObject.m_nScatterItemX));
    sMsg := AnsiReplaceText(sMsg, '%y', IntToStr(PlayObject.m_nScatterItemY));
  end
  else
  begin
    sMsg := AnsiReplaceText(sMsg, '%s', PlayObject.m_sCharName);
    sMsg := AnsiReplaceText(sMsg, '%x', IntToStr(PlayObject.m_nCurrX));
    sMsg := AnsiReplaceText(sMsg, '%y', IntToStr(PlayObject.m_nCurrY));
  end;

  if PlayObject.m_PEnvir <> nil then
    sMsg := AnsiReplaceText(sMsg, '%m', PlayObject.m_PEnvir.sMapDesc)
  else
    sMsg := AnsiReplaceText(sMsg, '%m', '????');
  sMsg := AnsiReplaceText(sMsg, '%d', Npc.m_sCharName);

  sMsg := AnsiReplaceText(sMsg, '%Item', PlayObject.m_sLackFoundryItem);

  PlayObject.SendMoveHintMsg(sMsg, nFColor, nBColor, nX, nY);
end;

procedure ActionOfGetRankNameByNo(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  RankType, RankNo: Integer;
  List: TGStringList;
  UserName: string;
begin
  RankType := QuestActionInfo.nParam1;
  RankNo := QuestActionInfo.nParam2;

  if (RankType < 1) or (RankType > 4) or (Length(QuestActionInfo.sRawParam3) = 0) and (RankNo <= 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if RankType = 1 then
    List := g_HumanRankList
  else if RankType = 2 then
    List := g_WarriorRankList
  else if RankType = 3 then
    List := g_WizardRankList
  else if RankType = 4 then
    List := g_TaoistRankList
  else
    Exit;

  RankNo := RankNo - 1;
  if RankNo >= List.Count then
    UserName := ''
  else
    UserName := List.Strings[RankNo];

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, UserName, StrToIntDef(UserName, 0)) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

