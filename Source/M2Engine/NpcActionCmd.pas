procedure ActionOfClearItemMap(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, II, nX, nY, nRange: Integer;
  sItemName: string;
  Envir: TEnvirnoment;
  ItemList: TList;
  ItemObject, ItemObject2: TItemObject;
  IsFree: Boolean;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  nX := QuestActionInfo.nParam2;
  nY := QuestActionInfo.nParam3;
  nRange := QuestActionInfo.nParam4;
  sItemName := QuestActionInfo.sParam5;

  if (nX < 0) or (nY < 0) or (nRange < 0) or (Envir = nil) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if sItemName = '' then
    sItemName := '*';

  if (nX = 0) and (nY = 0) and (nRange = 0) then
  begin
    for II := g_ItemManager.m_ItemList.Count - 1 downto 0 do
    begin
      ItemObject := g_ItemManager.m_ItemList.Items[II];
      if (ItemObject.m_PEnvir = Envir) and ((sItemName = '*') or SameText(ItemObject.m_sDBName, sItemName)) then
      begin
        ItemObject.MakeGhost;
      end;
    end;

    Exit;
  end;

  ItemList := TList.Create;
  Envir.GetRangeItemObject(nX, nY, nRange, ItemList);
  if (Length(sItemName) = 0) or (sItemName = '*') then
  begin
    if (Envir.m_boMirror) then
    begin
      for I := 0 to ItemList.Count - 1 do
      begin
        ItemObject := TItemObject(ItemList.Items[I]);

        IsFree := False;
        for II := g_ItemManager.m_ItemList.Count - 1 downto 0 do
        begin
          ItemObject2 := g_ItemManager.m_ItemList.Items[II];
          if ItemObject2 = ItemObject then
          begin
            ItemObject.Free;
            g_ItemManager.m_ItemList.Delete(II);
            IsFree := True;
            Break;
          end;
        end;

        if not IsFree then
        begin
          ItemObject.MakeGhost;
        end;
      end;
    end
    else
    begin
      for I := 0 to ItemList.Count - 1 do
      begin
        ItemObject := TItemObject(ItemList.Items[I]);
        ItemObject.MakeGhost;
      end;
    end;
  end
  else
  begin
    if (Envir.m_boMirror) then
    begin
      for I := 0 to ItemList.Count - 1 do
      begin
        ItemObject := TItemObject(ItemList.Items[I]);

        if CompareText(UserEngine.GetStdItemName(ItemObject.m_UserItem.wIndex), sItemName) = 0 then
        begin
          IsFree := False;
          for II := g_ItemManager.m_ItemList.Count - 1 downto 0 do
          begin
            ItemObject2 := g_ItemManager.m_ItemList.Items[II];
            if ItemObject2 = ItemObject then
            begin
              ItemObject.Free;
              g_ItemManager.m_ItemList.Delete(II);
              IsFree := True;
              Break;
            end;
          end;

          if not IsFree then
          begin
            ItemObject.MakeGhost;
          end;
        end;
      end;
    end
    else
    begin
      for I := 0 to ItemList.Count - 1 do
      begin
        ItemObject := TItemObject(ItemList.Items[I]);
        if CompareText(UserEngine.GetStdItemName(ItemObject.m_UserItem.wIndex), sItemName) = 0 then
        begin
          ItemObject.MakeGhost;
        end;
      end;
    end;
  end;

  ItemList.Free;
end;

