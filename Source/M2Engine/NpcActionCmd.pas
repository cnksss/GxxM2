procedure ActionOfItemFluteStone(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  ItemBoxIndex, StoneBoxIndex: Integer;
  nItemIndex, nStoneIndex, nStoneDelIndex: Integer;
  ItemUserItem, StoneUserItem: pTUserItem;
  StoneStdItem: pTStdItem;
begin
  ItemBoxIndex := StrToIntDef(QuestActionInfo.sParam1, -1);
  StoneBoxIndex := StrToIntDef(QuestActionInfo.sParam2, -1);

  if (not (ItemBoxIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)])) or (not (StoneBoxIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)])) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  nItemIndex := PlayObject.m_ItemBoxItems[ItemBoxIndex];
  nStoneIndex := PlayObject.m_ItemBoxItems[StoneBoxIndex];

  if PlayObject.DoItemFluteStone(nItemIndex, nStoneIndex, ItemUserItem, StoneUserItem, StoneStdItem, nStoneDelIndex) = 0 then
  begin
    PlayObject.UpdateBoxItem(ItemBoxIndex);

    if (StoneStdItem <> nil) and CheckOverLapItem(StoneStdItem) and (StoneUserItem.Dura > 0) then
    begin
      StoneUserItem.Dura := StoneUserItem.Dura - 1;

      PlayObject.UpdateBoxItem(StoneBoxIndex);
    end
    else
    begin
      PlayObject.DelBoxItem(StoneBoxIndex, Npc.m_sCharName, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
    end;

    if (g_FunctionNPC <> nil) then
    begin
      PlayObject.m_nScriptGotoCount := 0;
      PlayObject.m_PickUpOrDropItem := ItemUserItem^;
      PlayObject.m_UseStoneItemIndex := StoneUserItem.wIndex - 1;
      g_FunctionNPC.GotoLable(PlayObject, '@BagUseStoneItemOK', False);
      PlayObject.m_PickUpOrDropItem.wIndex := 0;
    end;
  end;
end;

procedure ActionOfItemFluteStoneEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, StoneUserItemIndex: Integer;
  UserItem, StoneUserItem: pTUserItem;
  nBoxItemIndex, nMakeIndex: Integer;
  StoneStdItem: pTStdItem;
  SmartObject: TSmartObject;
  StoneName: string;
  LockUpdateItemIndex, nStoneDelIndex: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  StoneName := QuestActionInfo.sParam2;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if (Length(StoneName) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  LockUpdateItemIndex := -1;
  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    if BaseObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if (UserItem <> nil) and (SmartObject.DoItemFluteStoneEx(UserItem, StoneName, StoneUserItem, nStoneDelIndex) = 0) then
  begin
    if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
          TPlayObject(SmartObject).SendUpdateItemFlute(nBoxItemIndex, True, UserItem)
        else
          TPlayObject(SmartObject).SendUpdateItemFlute(nWhere, False, UserItem);
      end
      else
        THeroObject(SmartObject).SendUpdateItemFlute(nWhere, UserItem);
    end;

    StoneUserItemIndex := StoneUserItem.wIndex - 1;

    StoneStdItem := UserEngine.GetStdItem(StoneUserItem.wIndex);
    if (StoneStdItem <> nil) and CheckOverLapItem(StoneStdItem) and (StoneUserItem.Dura > 0) then
    begin
      StoneUserItem.Dura := StoneUserItem.Dura - 1;

      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
