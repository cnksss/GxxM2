procedure ActionOfChangeHumNameFile(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  SLine, sOldLine, sName, sPrefix, sSuffix: string;
  sListFileName: string;
  SL: TStringList;
  Path: string;
  IsChanged: Boolean;
begin
  if QuestActionInfo.nParam2 = 0 then
    sListFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    sListFileName := QuestActionInfo.sParam1;

  if not FileExists(sListFileName) then
    Exit;
  if Length(PlayObject.m_sCharNewName) = 0 then
    Exit;

  sPrefix := QuestActionInfo.sParam3;
  sSuffix := QuestActionInfo.sParam4;

  SL := TStringList.Create;
  try
    IsChanged := False;
    SL.LoadFromFile(sListFileName);
    for I := 0 to SL.Count - 1 do
    begin
      SLine := SL.Strings[I];

      if SameText(SLine, sPrefix + PlayObject.m_sCharName + sSuffix) then
      begin
        SL.Strings[I] := sPrefix + PlayObject.m_sCharNewName + sSuffix;
        IsChanged := True;
      end
      else
      begin
        sOldLine := SLine;
        SLine := GetValidStr3_Ex(SLine, sName, ' ');
        if SameText(sName, sPrefix + PlayObject.m_sCharName + sSuffix) then
        begin
          SL.Strings[I] := sPrefix + PlayObject.m_sCharNewName + sSuffix + ' ' + SLine;
          IsChanged := True;
        end
        else
        begin
          SLine := GetValidStr3_Ex(sOldLine, sName, #9);
          if SameText(sName, sPrefix + PlayObject.m_sCharName + sSuffix) then
          begin
            SL.Strings[I] := sPrefix + PlayObject.m_sCharNewName + sSuffix + #9 + SLine;
            IsChanged := True;
          end
        end;
      end;
    end;

    if IsChanged then
    begin
      IsChanged := False;
      for I := 1 to SAVE_RETRY_COUNT do
      begin
        try
          Path := ExtractFilePath(sListFileName);
          if not DirectoryExists(Path) then
          begin
            ForceDirectories(Path);
          end;

          SL.SaveToFile(sListFileName);
          IsChanged := True;
          Break;
        except
          // Sleep(SAVE_SLEEP_TIME);
        end;
      end;

      if not IsChanged then
      begin
        MainOutMessage(Format('Save fail; [%s; %s]', [QuestActionInfo.sCmd, sListFileName]));
      end;
    end;
  finally
    SL.Free;
  end;
end;

procedure ActionOfFilterGlobalMsg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  {
    ;过滤掉落提示信息
    FILTERGLOBALMSG 1 1 （最后参数为1或者0;过滤掉落提示信息

    ;过滤SendCenterMsg全局信息（信息模式1）
    FILTERGLOBALMSG 2 1 （最后参数为1或者0,0或者空关闭过滤）--------------------------

    ;过滤SENDMSG全局信息（信息代码1234）
    FILTERGLOBALMSG 3 1 （最后参数为1或者0,0或者空关闭过滤）
  }

  if (QuestActionInfo.nParam1 < 1) or (QuestActionInfo.nParam1 > 3) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  case QuestActionInfo.nParam1 of
    1:
      PlayObject.m_boFilterGlobalDropItemMsg := QuestActionInfo.nParam2 <> 0; // 过滤掉落提示信息
    2:
      PlayObject.m_boFilterGlobalCenterMsg := QuestActionInfo.nParam2 <> 0; // 过滤SendCenterMsg
    3:
      PlayObject.m_boFilterGolbalSendMsg := QuestActionInfo.nParam2 <> 0; // 过滤SendMsg全局信息
  end;
end;

procedure ActionOfSetCustomItemProgressbar(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nBoxItemIndex, nMakeIndex: Integer;
  nProgressIndex, nValueType, nValue: Integer;
  UserItem: pTUserItem;
  SmartObject: TSmartObject;
  LockUpdateItemIndex: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -3;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -3);

  nProgressIndex := QuestActionInfo.nParam2;
  nValueType := QuestActionInfo.nParam3;
  nValue := QuestActionInfo.nParam4;

  if (nProgressIndex < 0) or (nProgressIndex > 1) or (nValueType < 0) or (nValueType > 4) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nValueType = 2) and ((nValue < 0) or (nValue > 255)) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nValueType = 3) and ((nValue < 0) or (nValue > 19)) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (nValueType = 4) and ((nValue < 0) or (nValue > 3)) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  LockUpdateItemIndex := -1;
  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := PlayObject.m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to PlayObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(PlayObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := PlayObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere = -1 then
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    if nValueType = 0 then
    begin
      UserItem.Progress[nProgressIndex].boOpen := nValue > 0;
    end
    else if nValueType = 1 then
    begin
      UserItem.Progress[nProgressIndex].sName := QuestActionInfo.sParam4;
    end
    else if nValueType = 2 then
    begin
      UserItem.Progress[nProgressIndex].btNameColor := nValue;
    end
    else if nValueType = 3 then
    begin
      UserItem.Progress[nProgressIndex].btCount := nValue;
    end
    else if nValueType = 4 then
    begin
      UserItem.Progress[nProgressIndex].btShowType := nValue;
    end;

    if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
    begin
      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
          TPlayObject(SmartObject).SendUpdateItemProgress(nBoxItemIndex, True, UserItem, nProgressIndex)
        else
          TPlayObject(SmartObject).SendUpdateItemProgress(nWhere, False, UserItem, nProgressIndex);
      end
      else
        THeroObject(SmartObject).SendUpdateItemProgress(nWhere, UserItem, nProgressIndex);
    end;
  end;
end;

