procedure ActionOfBonusPoint(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nOldBonusPoint, nBonusPoint: Integer;
  cMethod: Char;
begin
  nBonusPoint := QuestActionInfo.nParam2;

  if (QuestActionInfo.sParam1 = '') or (nBonusPoint < 0) or (nBonusPoint > 10000) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  nOldBonusPoint := PlayObject.m_nBonusPoint;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        FillChar(PlayObject.m_BonusAbil, SizeOf(TNakedAbility), #0);
        PlayObject.HasLevelUp(0, False);
        PlayObject.m_nBonusPoint := nBonusPoint;
        PlayObject.SendMsg(PlayObject, RM_ADJUST_BONUS, 0, 0, 0, 0, '');
      end;
    '-':
      begin
        if PlayObject.m_nBonusPoint >= nBonusPoint then
        begin
          Dec(PlayObject.m_nBonusPoint, nBonusPoint);
        end
        else
        begin
          PlayObject.m_nBonusPoint := 0;
        end;
        PlayObject.SendMsg(PlayObject, RM_ADJUST_BONUS, 0, 0, 0, 0, '');
      end;
    '+':
      begin
        Inc(PlayObject.m_nBonusPoint, nBonusPoint);
        PlayObject.SendMsg(PlayObject, RM_ADJUST_BONUS, 0, 0, 0, 0, '');
      end;
  end;

  AddGameDataLog(LOG_AbilPointChange, LOG_ActionNone, PlayObject, '未分配属性点', 0, Npc.m_sCharName, PlayObject.m_nBonusPoint, nOldBonusPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
end;

