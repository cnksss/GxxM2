procedure ActionOfRandomSplit(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
type
  TElement = record
    Value1: string;
    Value2: string;
    Probability: Integer;
  end;

  PElement = ^TElement;
var
  I, J, idx, Sum: Integer;
  tmpSL: TStrings;
  tmpStr: string;
  tmpNum: Extended;
  tmpElem: PElement;
begin
  if (BaseObject = nil) //
    or Trim(QuestActionInfo.sParam1).IsEmpty //
    or not (QuestActionInfo.nParam2 in [0..2]) //
    or not AnsiStartsText('S$', QuestActionInfo.sRawParam3) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  Randomize;
  Sum := 0;
  tmpSL := TStringList.Create;
  tmpSL.StrictDelimiter := True;
  tmpSL.Delimiter := '|';
  tmpSL.DelimitedText := Trim(QuestActionInfo.sParam1);
  for I := 0 to tmpSL.Count - 1 do
  begin
    idx := Pos('#', tmpSL[I]);
    if idx > 0 then
    begin
      tmpElem := AllocMem(SizeOf(TElement));
      tmpElem.Value1 := Copy(tmpSL[I], 1, idx - 1);
      tmpElem.Value2 := Copy(tmpSL[I], idx + 1, Length(tmpSL[I]) - idx);
      tmpElem.Probability := StrToIntDef(tmpElem.Value2, 0);
      tmpSL.Objects[I] := TObject(tmpElem);

      Inc(Sum, tmpElem.Probability);
    end
    else
      tmpSL.Objects[I] := nil;
  end;

  tmpNum := Random * Sum;
  for I := 0 to tmpSL.Count - 1 do
  begin
    if tmpSL.Objects[I] = nil then
      Continue;

    tmpElem := PElement(tmpSL.Objects[I]);
    if tmpNum <= tmpElem.Probability then
    begin
      case QuestActionInfo.nParam2 of
        0:
          Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, tmpElem.Value1, 0);
        1:
          Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, tmpElem.Value2, tmpElem.Probability);
        2:
          Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, tmpSL[I], 0);
      end;

      if (QuestActionInfo.nParam4 in [0..2]) and AnsiStartsText('S$', QuestActionInfo.sRawParam5) then
      begin
        tmpStr := '';
        case QuestActionInfo.nParam4 of
          0:
            begin
              for J := 0 to tmpSL.Count - 1 do
              begin
                if (J <> I) and (tmpSL.Objects[J] <> nil) then
                begin
                  if tmpStr.IsEmpty then
                    tmpStr := PElement(tmpSL.Objects[J]).Value1
                  else
                    tmpStr := tmpStr + '|' + PElement(tmpSL.Objects[J]).Value1;
                end;
              end;
            end;
          1:
            begin
              for J := 0 to tmpSL.Count - 1 do
              begin
                if (J <> I) and (tmpSL.Objects[J] <> nil) then
                begin
                  if tmpStr.IsEmpty then
                    tmpStr := PElement(tmpSL.Objects[J]).Value2
                  else
                    tmpStr := tmpStr + '|' + PElement(tmpSL.Objects[J]).Value2;
                end;
              end;
            end;
          2:
            begin
              for J := 0 to tmpSL.Count - 1 do
              begin
                if J <> I then
                begin
                  if tmpStr.IsEmpty then
                    tmpStr := tmpSL[J]
                  else
                    tmpStr := tmpStr + '|' + tmpSL[J];
                end;
              end;
            end;
        end;
        Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam5, tmpStr, 0);
      end;
      Break;
    end
    else
      tmpNum := tmpNum - tmpElem.Probability;
  end;

  for I := 0 to tmpSL.Count - 1 do
    FreeMemory(PElement(tmpSL.Objects[I]));

  tmpSL.Free;
end;

