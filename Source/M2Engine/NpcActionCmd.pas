procedure ActionOfMobEctypeMon(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMAP, sName: string;
  nX, nY: Integer;
  Envir: TEnvirnoment;
  I: Integer;
begin
  sMAP := QuestActionInfo.sParam1;
  nX := StrToIntDef(QuestActionInfo.sParam2, -1);
  nY := StrToIntDef(QuestActionInfo.sParam3, -1);
  sName := QuestActionInfo.sParam4;

  if (sMAP = '') or (nX < 0) or (nY < 0) or (sName = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if CompareText(sMAP, 'NPCMAP') = 0 then
    Envir := Npc.m_PEnvir
  else if CompareText(sMAP, 'FBMAP') = 0 then
    Envir := PlayObject.m_FBEnvir
  else if CompareText(sMAP, 'SELF') = 0 then
    Envir := PlayObject.m_PEnvir
  else
    Envir := g_MapManager.FindMap(sMAP);
  if (Envir <> nil) and (Envir.m_boFB) then
  begin
    for I := 0 to QuestActionInfo.nParam5 - 1 do
    begin
      nX := Random(QuestActionInfo.nParam6 * 2 + 1) + (nX - QuestActionInfo.nParam6);
      nY := Random(QuestActionInfo.nParam6 * 2 + 1) + (nY - QuestActionInfo.nParam6);
      UserEngine.RegenMonsterByName(Envir.sMapName, nX, nY, sName);
    end;
  end
  else
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
