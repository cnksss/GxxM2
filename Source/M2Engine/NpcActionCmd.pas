    HeroObject := nil;

  StdItem := UserEngine.GetStdItem(sItemName);
  if StdItem <> nil then
  begin
    if CheckOverLapItem(StdItem) then
    begin
      while True do
      begin
        if nItemCount <= 0 then
          Break;
        if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          // GIVE 叠加物品 不自动重叠到已有的物品上面 chongchong 2014-04-09
          OverLapItemsCount := OverLapBindBagItemCount(BaseObject, StdItem, BindValues, OverLapItem);
