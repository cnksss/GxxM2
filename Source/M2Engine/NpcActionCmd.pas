procedure ActionOfQueryGameGoldDeal(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIndex: Integer;
  Dealing: TGameGoldDeal;
  DealItems: TDealItems;
  StdItem: pTStdItem;
  ClientItem: TClientItem;
  sSendText: string;
begin
  FillChar(Dealing, SizeOf(TGameGoldDeal), #0);
  FillChar(DealItems, SizeOf(TDealItems), #0);
  if not g_GameGoldDealDB.QueryDeal(PlayObject.m_sCharName, @Dealing, @DealItems) then
  begin
    PlayObject.SendDelayMsg(Npc, RM_QUERYDEALFAIL, 0, 0, 0, 0, '@AskYBDealFail', 100);
    Exit;
  end;

  sSendText := EncodeBuffer(@Dealing, SizeOf(TGameGoldDeal));
  for nIndex := 0 to Dealing.ItemCount - 1 do
  begin
    StdItem := UserEngine.GetStdItem(DealItems[nIndex].wIndex);
    if StdItem = nil then
      Continue;

    UserItemToClientItem(@DealItems[nIndex], StdItem, @ClientItem, True, True);

    sSendText := sSendText + '/' + EncodeBuffer(@ClientItem, SizeOf(TClientItem));
  end;

  PlayObject.SendMsg(PlayObject, RM_SENDGAMEGOLDDALITEM, 0, 0, 0, 0, sSendText);
end;

