procedure ActionOfSetStringBlank(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sValue, sNewValue: AnsiString;
  nLen: Integer;
  I: Integer;
  boAddBack: Boolean;
  P: PAnsiChar;
begin
  nLen := QuestActionInfo.nParam2;
  if (nLen < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  boAddBack := QuestActionInfo.sParam3 = '1';
  sValue := QuestActionInfo.sParam1;
  if boAddBack then
  begin
    if nLen > Length(sValue) then
    begin
      sNewValue := sValue;
      SetLength(sNewValue, nLen);
      P := PAnsiChar(sNewValue);
      Inc(P, Length(sValue));
      for I := 0 to nLen - Length(sValue) - 1 do
      begin
        P^ := ' ';
        Inc(P);
      end;
    end
    else
    begin
      sNewValue := sValue;
    end;
  end
  else
  begin
    if nLen > Length(sValue) then
    begin
      SetLength(sNewValue, nLen);
      P := PAnsiChar(sNewValue);
      for I := 0 to nLen - Length(sValue) - 1 do
      begin
        P^ := ' ';
        Inc(P);
      end;
      Move(sValue[1], P^, Length(sValue));
    end
    else
    begin
      sNewValue := sValue;
    end;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, sNewValue, StrToIntDef(sNewValue, 0)) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
  end;
end;

// 减法操作时，能减到0以下，可以减自身属性
procedure ActionOfChangeHumAbility(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nWhere, nPoint, nOldPoint, nTime: Integer;
  cMethod: Char;
  SmartObject: TSmartObject;
  Int64Value: Int64;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nWhere := QuestActionInfo.nParam1;
  nPoint := QuestActionInfo.nParam3;
  nTime := QuestActionInfo.nParam4;

  if (QuestActionInfo.sParam2 = '') or (not (nWhere in [1..23])) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  Dec(nWhere);
  nOldPoint := SmartObject.m_AddNakedAbil[nWhere];
  cMethod := QuestActionInfo.sParam2[1];

  case cMethod of
    '+':
      begin
        Int64Value := Int64(SmartObject.m_AddNakedAbil[nWhere]) + nPoint;

        if (nWhere in [12..22]) then
          SmartObject.m_AddNakedAbil[nWhere] := Min(Int64Value, High(Integer))
        else if (nWhere in [10, 11]) then
        begin
          if g_Config.btMaxLevel = 0 then
            SmartObject.m_AddNakedAbil[nWhere] := Min(Int64Value, High(Word))
          else if g_Config.btMaxLevel = 1 then
            SmartObject.m_AddNakedAbil[nWhere] := Min(Int64Value, High(Integer))
          else
            SmartObject.m_AddNakedAbil[nWhere] := Min(Int64Value, High(Integer)); // LongWord
        end
        else
        begin
          if g_Config.btMaxAC = 0 then
            SmartObject.m_AddNakedAbil[nWhere] := Min(Int64Value, High(Word))
          else
            SmartObject.m_AddNakedAbil[nWhere] := Min(Int64Value, High(Integer));
        end;
      end;
    '-':
      begin
        Int64Value := SmartObject.m_AddNakedAbil[nWhere] - nPoint;
        if Int64Value < Low(Integer) then
          Int64Value := Low(Integer)
        else if Int64Value > High(Integer) then
          Int64Value := High(Integer);

        SmartObject.m_AddNakedAbil[nWhere] := Int64Value;
      end;
    '=':
      begin
        if nWhere in [12..22] then
          SmartObject.m_AddNakedAbil[nWhere] := Min(nPoint, High(Integer))
        else if nWhere in [10, 11] then
        begin
          if g_Config.btMaxLevel = 0 then
            SmartObject.m_AddNakedAbil[nWhere] := Min(nPoint, High(Word))
          else if g_Config.btMaxLevel = 1 then
            SmartObject.m_AddNakedAbil[nWhere] := Min(nPoint, High(Integer))
          else
            SmartObject.m_AddNakedAbil[nWhere] := Min(nPoint, High(Integer)) // LongWord
        end
        else
        begin
          if g_Config.btMaxAC = 0 then
            SmartObject.m_AddNakedAbil[nWhere] := Min(nPoint, High(Word))
          else
            SmartObject.m_AddNakedAbil[nWhere] := Min(nPoint, High(Integer));
        end;
      end;
  end;

  SmartObject.m_CheckAddNakedAbilTime[nWhere] := nTime > 0;
  SmartObject.m_dwAddNakedAbilTick[nWhere] := MyGetTickCount + LongWord(Max(nTime * 1000, 0));

  if nOldPoint <> SmartObject.m_AddNakedAbil[nWhere] then
  begin
    if SmartObject.m_nLockUpdateAbil = 0 then
    begin
      SmartObject.RecalcAbilitys;
      SmartObject.SendMsg(BaseObject, RM_ABILITY, 0, 0, 0, 0, '');
    end;

    if nWhere in [12, 21] then
    begin
      SmartObject.SendMsg(BaseObject, RM_ABILITYNG, 0, 0, 0, 0, '');
    end
    else if nWhere = 22 then
    begin
      SmartObject.RecalcLevelAbilitysNG;
      SmartObject.SendMsg(SmartObject, RM_ABILITYNG, 0, 0, 0, 0, ''); // 内功属性
    end
    else if (nWhere >= 13) and (nWhere <= 21) then
      SmartObject.SendMsg(BaseObject, RM_SUBABILITY, 0, 0, 0, 0, '');
  end;
end;

