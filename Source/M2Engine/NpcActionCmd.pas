procedure ActionOfTextReplace(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  S: string;
  Flags: TReplaceFlags;
begin
  if QuestActionInfo.sParam2 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.sRawParam4 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  Flags := [rfReplaceAll, rfIgnoreCase];

  if QuestActionInfo.nParam5 = 1 then
    Flags := Flags - [rfIgnoreCase];

  if QuestActionInfo.nParam6 = 1 then
    Flags := Flags - [rfReplaceAll];

  S := StringReplace(QuestActionInfo.sParam1, QuestActionInfo.sParam2, QuestActionInfo.sParam3, Flags);

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, S, StrToIntDef(S, 0)) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

procedure ActionOfTextSplit(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Chr: Char;
  SL: TStringList;
  sVar: Char;
  I, Index: Integer;
  S: string;
begin
  if QuestActionInfo.sParam1 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '分隔符不能为空', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.sParam2 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '分隔字符串不能为空', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.sRawParam3 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '变量名不能为空', QuestActionInfo);
    Exit;
  end;

  sVar := UpCase(QuestActionInfo.sRawParam3[1]);

{$IF CompilerVersion >= 22}
  if not CharInSet(sVar, ['P', 'D', 'M', 'N', 'I', 'G', 'A', 'S', 'U', 'T', 'J', 'Z']) then
  begin
    Npc.ScriptActionError(PlayObject, '保存变量错误', QuestActionInfo);
    Exit;
  end;
{$ELSE}
  if not (sVar in ['P', 'D', 'M', 'N', 'I', 'G', 'A', 'S', 'U', 'T', 'J', 'Z']) then
  begin
    Npc.ScriptActionError(PlayObject, '保存变量错误', QuestActionInfo);
    Exit;
  end;
{$ENDIF}
  if not TryStrToInt(Copy(QuestActionInfo.sRawParam3, 2, MaxInt), Index) then
  begin
    Npc.ScriptActionError(PlayObject, '保存变量错误', QuestActionInfo);
    Exit;
  end;

  Chr := QuestActionInfo.sParam1[1];
  SL := TStringList.Create;
  try
    ExtractStrings([Chr], [], PChar(QuestActionInfo.sParam2), SL);

    if not Trim(QuestActionInfo.sRawParam4).IsEmpty then
    begin
      if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, IntToStr(SL.Count), SL.Count) then
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    end;

    for I := 0 to SL.Count - 1 do
    begin
      S := SL.Strings[I];
      if not Npc.SetVarValue(PlayObject, sVar + IntToStr(Index + I), S, StrToIntDef(S, 0)) then
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    end;
  finally
    SL.Free;
  end;
end;

