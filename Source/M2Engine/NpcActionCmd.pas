      begin
      Player.SysMsg(g_sCanotTakeOffItem {'无法取下物品！'}, c_Red, t_Hint);
      Exit;
      end;
    *)

    if (StdItem.StdMode in [15, 19, 20, 21, 22, 23, 24, 26]) then
