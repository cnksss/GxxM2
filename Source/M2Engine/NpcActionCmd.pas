procedure ActionOfChangeGuildMemberMaxLimitCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sGuildName: string;
  Guild: TGUild;
  cMethod: Char;
  nCount: Integer;
begin
  if UpperCase(QuestActionInfo.sParam1) = 'SELF' then
  begin
    if PlayObject.m_MyGuild = nil then
    begin
      PlayObject.SysMsg(Format('[失败] %s需要加入行会后，才能调整行会最高成员数', [PlayObject.m_sCharName]), c_Red, t_Hint);
      // ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;
    Guild := TGUild(PlayObject.m_MyGuild);
  end
  else
  begin
    sGuildName := QuestActionInfo.sParam1;
    Guild := g_GuildManager.FindGuild(sGuildName);
    if Guild = nil then
    begin
      PlayObject.SysMsg(Format('[失败] 没有找到行会 %s', [sGuildName]), c_Red, t_Hint);
      // ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;
  end;

  nCount := QuestActionInfo.nParam3;
  if (QuestActionInfo.sParam2 = '') or (nCount < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam2[1];
  case cMethod of
    '+':
      begin
        Inc(Guild.m_nMemberMaxLimit, nCount);
      end;
    '-':
      begin
        Dec(Guild.m_nMemberMaxLimit, nCount);
      end;
    '=':
      begin
        Guild.m_nMemberMaxLimit := nCount;
      end;
  end;
  Guild.m_nMemberMaxLimit := Max(Guild.m_nMemberMaxLimit, 0);
  Guild.SaveGuildInfoFile;
end;

procedure ActionOfAddGuildMemberCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  Guild: TGUild;
  cMethod: Char;
  nCount: Integer;
begin
  if PlayObject.m_MyGuild = nil then
  begin
    PlayObject.SysMsg(Format('[失败] %s需要加入行会后，才能调整行会最高成员数', [PlayObject.m_sCharName]), c_Red, t_Hint);
    Exit;
  end;
  Guild := TGUild(PlayObject.m_MyGuild);

  if not PlayObject.IsGuildMaster then
  begin
    PlayObject.SysMsg('[失败] 需要行会掌门人才能使用', c_Red, t_Hint);
    Exit;
  end;

  nCount := QuestActionInfo.nParam2;

  if (QuestActionInfo.sParam1 = '') or (nCount < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  for I := 0 to g_GuildManager.GuildList.Count - 1 do
  begin
    Guild := TGUild(g_GuildManager.GuildList.Items[I]);
    case cMethod of
      '+':
        begin
          Inc(Guild.m_nMemberMaxLimit, nCount);
        end;
      '-':
        begin
          Dec(Guild.m_nMemberMaxLimit, nCount);
        end;
      '=':
        begin
          Guild.m_nMemberMaxLimit := nCount;
        end;
    end;
  end;

  Guild.m_nMemberMaxLimit := Max(Guild.m_nMemberMaxLimit, 0);
  Guild.SaveGuildInfoFile;
end;

