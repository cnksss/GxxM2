begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;
  nMode := QuestActionInfo.nParam1;
  nTime := QuestActionInfo.nParam2;
  nValue := QuestActionInfo.nParam3;

  if (not (nMode in [1..14])) or ((nMode in [3..8, 11, 12, 13]) and (nValue < 0)) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  Dec(nMode);

  if nTime = 0 then
  begin
    SmartObject.m_dwChangeModeExTick[nMode] := 0;
    SmartObject.m_wChangeModeExValue[nMode] := 0;
  end
  else
  begin
    if nTime < 0 then
      SmartObject.m_dwChangeModeExTick[nMode] := High(LongWord)
    else
      SmartObject.m_dwChangeModeExTick[nMode] := MyGetTickCount + LongWord(nTime) * 1000;
    SmartObject.m_wChangeModeExValue[nMode] := nValue;
  end;
  // if nMode = 13 then
  // begin
  // SmartObject.m_boTeleport := True;
  // end
  // else
  if nMode in [1..7, 10, 11, 12, 13] then
  begin
    SmartObject.RecalcAbilitys;
    if (nMode in [2..7, 10]) and (SmartObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
      SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');

    if nMode = 10 then
    begin
      SmartObject.FeatureChanged;
    end;
  end
  else if nMode >= 8 then
  begin
    if nTime = 0 then
    begin
      SmartObject.m_boCanHit := True;
      SmartObject.m_boCanSpell := True;
    end
    else
    begin
      SmartObject.m_boCanHit := False;
      SmartObject.m_boCanSpell := False;
    end;

    if nMode = 9 then
    begin
      if nTime = 0 then
      begin
        SmartObject.m_boCanDeal := True;
        SmartObject.m_boCanDrop := True;
        SmartObject.m_boCanUseItem := True;
        SmartObject.m_boCanWalk := True;
        SmartObject.m_boCanRun := True;
      end
      else
      begin
        SmartObject.m_boCanDeal := False;
        SmartObject.m_boCanDrop := False;
        SmartObject.m_boCanUseItem := False;
        SmartObject.m_boCanWalk := False;
        SmartObject.m_boCanRun := False;
      end;
    end;
  end;

  if (nMode in [8, 9]) and (SmartObject.m_btRaceServer = RC_PLAYOBJECT) then
    TPlayObject(SmartObject).SendDefMessage(SM_SENDACTIONMSG, 0, MakeWord(BoolToInt((SmartObject.m_dwChangeModeExTick[8] = 0) and (SmartObject.m_dwChangeModeExTick[9] = 0)), BoolToInt((SmartObject.m_dwChangeModeExTick[9] = 0))), 0, 0, '');

  if (nMode = 1) and (SmartObject.m_dwChangeModeExTick[1] > 0) then
  begin
    BaseObject.SendRefMsg(RM_DISAPPEAR, 65535, 0, 0, 0, '');
  end;
end;

procedure ActionOfMoveMapPlay(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  OldEnvir, NewEnvir: TEnvirnoment;
  I, nX, nY: Integer;
  User: TPlayObject;
begin
  OldEnvir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    OldEnvir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if OldEnvir = nil then
    OldEnvir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  NewEnvir := nil;
  if (not QuestActionInfo.boCompleteFormat2) and (QuestActionInfo.VarInfo2.VarAttr = aFixVar) then
    NewEnvir := g_MapManager.FindMap(QuestActionInfo.sRawParam2);
  if NewEnvir = nil then
    NewEnvir := g_MapManager.FindMap(QuestActionInfo.sParam2);

  nX := QuestActionInfo.nParam3;
  nY := QuestActionInfo.nParam4;

  if (OldEnvir = nil) or (NewEnvir = nil) or (nX < 0) or (nY < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun then
    UserEngine.m_PlayObjectList.LockR(79);
  try
{$IFEND}
    for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
    begin
      User := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
      if not User.m_boDeath and not User.m_boGhost and (User.m_PEnvir = OldEnvir) then
      begin
        if (not User.m_boDummyObject) or (CanDummyMoveMap(NewEnvir.sMapName)) then
          User.SpaceMove(NewEnvir.sMapName, nX, nY, 0);
      end;
    end;
{$IF MULTI_THREAD = 1}
  finally
    if g_MultiThreadRun then
      UserEngine.m_PlayObjectList.UnLockR;
  end;
{$IFEND}
end;

procedure ActionOfChangeHeroLoyal(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nPoint: Integer;
  rLoyalPoint: Real; // 忠诚度
  cMethod: Char;
begin
  nPoint := QuestActionInfo.nParam2;

  if (QuestActionInfo.sParam1 = '') or (nPoint < 0) or (nPoint > 10000) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_MyHero = nil then
    Exit;

  rLoyalPoint := THeroObject(PlayObject.m_MyHero).m_rLoyalPoint;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        THeroObject(PlayObject.m_MyHero).m_rLoyalPoint := nPoint / 100;
      end;
    '-':
      begin
        if THeroObject(PlayObject.m_MyHero).m_rLoyalPoint >= nPoint / 100 then
        begin
          THeroObject(PlayObject.m_MyHero).m_rLoyalPoint := THeroObject(PlayObject.m_MyHero).m_rLoyalPoint - nPoint / 100;
        end
        else
        begin
          THeroObject(PlayObject.m_MyHero).m_rLoyalPoint := 0.00;
        end;
      end;
    '+':
      begin
        if THeroObject(PlayObject.m_MyHero).m_rLoyalPoint + nPoint / 100 <= 100.00 then
        begin
          THeroObject(PlayObject.m_MyHero).m_rLoyalPoint := THeroObject(PlayObject.m_MyHero).m_rLoyalPoint + nPoint / 100;
        end
        else
        begin
          THeroObject(PlayObject.m_MyHero).m_rLoyalPoint := 100.00;
        end;
      end;
  end;
  if rLoyalPoint <> THeroObject(PlayObject.m_MyHero).m_rLoyalPoint then
    THeroObject(PlayObject.m_MyHero).SendLoyalPoint;
end;

