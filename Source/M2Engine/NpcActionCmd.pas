      begin
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
        Exit;
      end;
    end;

    if (Length(QuestActionInfo.sRawParam8) > 0) and (SL.Count >= 6) then
    begin
      if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam8, SL[5], StrToIntDef(SL[5], 0)) then
      begin
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
        Exit;
      end;
    end;

    if (Length(QuestActionInfo.sRawParam9) > 0) and (SL.Count >= 7) then
    begin
