procedure ActionOfChangeDamageValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
  cMethod: Char;
  nType, nValue: Integer;
begin
  (*
    // 原设计对基本对象类型进行了判断，导致多级脚本调用时，宠物的类型不符合如下判断，逻辑被跳空。

    if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
    else
    Exit;
  *)

  SmartObject := TSmartObject(BaseObject);
  if SmartObject = nil then
    Exit;

  nType := QuestActionInfo.nParam1;
  nValue := QuestActionInfo.nParam3;
  if (nType < 0) or (nType > 1) or (QuestActionInfo.sParam2 = '') or (nValue < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam2[1];
  with SmartObject do
    case cMethod of
      '=':
        begin
          if nType = 0 then
            m_nLastDamageValue := nValue
          else
            m_nLastDamageValue := m_nLastDamageValue * nValue div 100;
        end;
      '-':
        begin
          if nType = 0 then
            Dec(m_nLastDamageValue, nValue)
          else
            Dec(m_nLastDamageValue, m_nLastDamageValue * nValue div 100);
        end;
      '+':
        begin
          if nType = 0 then
            Inc(m_nLastDamageValue, nValue)
          else
            Inc(m_nLastDamageValue, m_nLastDamageValue * nValue div 100);
        end;
    end;
  SmartObject.m_nLastDamageValue := Max(0, Min(MaxInt, SmartObject.m_nLastDamageValue));
end;

procedure ActionOfGetMultiRandomNumber(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nMin, nMax, nCount, nIndex1, nIndex2, nTemp: Integer;
  sVarRead, sVarCount: string;
  ArrNums: array of Integer;
  sSetVarName: Char;
  nSetVarIndex, nRunCount: Integer;
  IsOK: Boolean;
begin
  nMin := QuestActionInfo.nParam1;
  nMax := QuestActionInfo.nParam2;
  nCount := QuestActionInfo.nParam3;
  sVarRead := QuestActionInfo.sRawParam4;
  sVarCount := QuestActionInfo.sRawParam5;

  if nMin > nMax then
  begin
    nTemp := nMin;
    nMin := nMax;
    nMax := nTemp;
  end;

  if (nMin < 0) or (nMax < 0) or (nCount <= 0) or (sVarRead = '') or (sVarCount = '') or (nCount > 200) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if not ExtractVar(sVarRead, sSetVarName, nSetVarIndex) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if nCount <= (nMax - nMin + 1) * 4 then
  begin
    Randomize;

    SetLength(ArrNums, nMax - nMin + 1);
    for I := 0 to Length(ArrNums) - 1 do
    begin
      ArrNums[I] := nMin + I;
    end;

    for I := 0 to Length(ArrNums) * 2 - 1 do
    begin
      nIndex1 := Random(Length(ArrNums));
      nIndex2 := Random(Length(ArrNums));
      nTemp := ArrNums[nIndex1];
      ArrNums[nIndex1] := ArrNums[nIndex2];
      ArrNums[nIndex2] := nTemp;
    end;

    if nCount > Length(ArrNums) then
      nCount := Length(ArrNums);

    for I := 0 to nCount - 1 do
    begin
      nTemp := ArrNums[I];

      if (not Npc.SetVarValue(PlayObject, sSetVarName + IntToStr(nSetVarIndex), IntToStr(nTemp), nTemp)) then
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);

      Inc(nSetVarIndex);
    end;
  end
  else
  begin
    SetLength(ArrNums, nCount);

    nIndex1 := 0;
    Randomize;

    nRunCount := 0;
    while True do
    begin
      nTemp := nMin + Random(nMax - nMin + 1);
      IsOK := True;
      for I := 0 to nIndex1 - 1 do
      begin
        if ArrNums[I] = nTemp then
        begin
          IsOK := False;
          Break;
        end;
      end;

      if IsOK then
      begin
        nRunCount := 0;

        ArrNums[nIndex1] := nTemp;
        Inc(nIndex1);
        if nIndex1 >= nCount then
          Break;
      end
      else
      begin
        Inc(nRunCount);
        if nRunCount >= 100 then
        begin
          ArrNums[nIndex1] := nTemp;
          Inc(nIndex1);
          if nIndex1 >= nCount then
            Break;
        end;
      end;
    end;

    for I := 0 to nCount - 1 do
    begin
      nTemp := ArrNums[I];

      if (not Npc.SetVarValue(PlayObject, sSetVarName + IntToStr(nSetVarIndex), IntToStr(nTemp), nTemp)) then
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);

      Inc(nSetVarIndex);
    end;
  end;

  if (not Npc.SetVarValue(PlayObject, sVarCount, IntToStr(nCount), nCount)) then
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
end;

