procedure ActionOfMapEffect(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Envir: TEnvirnoment;
  I, nX, nY, nImageIndex, nStartImage, nImageCount, nPlayCount, nTime: Integer;
  Event: TMapEffectEvent;
  nLight, nID: Integer;
  Online: TPlayObject;
  VarInfo: TVarInfo;
  sID: string;
  IsBreakParseVar: Boolean;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  nX := QuestActionInfo.nParam2;
  nY := QuestActionInfo.nParam3;
  nImageIndex := QuestActionInfo.nParam4;
  nStartImage := QuestActionInfo.nParam5;
  nImageCount := QuestActionInfo.nParam6;
  nPlayCount := QuestActionInfo.nParam7;
  nTime := QuestActionInfo.nParam8;
  nLight := Min(Max(QuestActionInfo.nParam10, 0), 5);

  VarInfo := GetValNameInfo(QuestActionInfo.sSubParam10);
  if VarInfo.VarAttr > aNone then
    Npc.GetVarValue(PlayObject, QuestActionInfo.sSubParam10, sID, nID, IsBreakParseVar)
  else
    nID := StrToIntDef(QuestActionInfo.sSubParam10, -1);

  if (Envir = nil) or (nX < 0) or (nY < 0) or (nImageIndex < 0) or (nStartImage < 0) or (nImageCount < 0)
  { or (nPlayCount < 0) } or (nTime < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  Event := TMapEffectEvent.Create(nil, Envir, nX, nY, nImageIndex, nStartImage, nImageCount, nPlayCount, nTime, QuestActionInfo.sParam9 = '1', nLight, nID);
  g_EventManager.AddEvent(Event);
{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun then
    UserEngine.m_PlayObjectList.LockR(701);
  try
{$IFEND}
    for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
    begin
      Online := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
      if (not Online.m_boGhost) and (not Online.m_boOffLine) and (not Online.m_boDummyObject) and (Online.m_PEnvir = Envir) and (abs(Online.m_nCurrX - nX) <= 20) and (abs(Online.m_nCurrY - nY) <= 20) and Online.m_boReadyRun then
      begin
        Online.SearchViewRange;
      end;
    end;
{$IF MULTI_THREAD = 1}
  finally
    if g_MultiThreadRun then
      UserEngine.m_PlayObjectList.UnLockR;
  end;
{$IFEND}
end;

