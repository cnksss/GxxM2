procedure ActionOfPlayEffect(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nFileIndex, nStartImage, nImageCount, nPlayCount, nTime: Integer;
  BaseObjectEffect: pTBaseObjectEffect;
  btDrawOrder: Byte;
  nOffsetX, nOffsetY: Integer;
  boBlendMode: Boolean;
begin
  if BaseObject = nil then
    Exit;

  nFileIndex := QuestActionInfo.nParam1;
  nStartImage := QuestActionInfo.nParam2;
  nImageCount := QuestActionInfo.nParam3;
  nPlayCount := QuestActionInfo.nParam4;
  nTime := QuestActionInfo.nParam5;
  btDrawOrder := QuestActionInfo.nParam6;
  nOffsetX := QuestActionInfo.nParam7;
  nOffsetY := QuestActionInfo.nParam8;
  boBlendMode := QuestActionInfo.nParam9 = 0;

  if (nFileIndex < 0) or (nStartImage < 0) or (nImageCount < 0) or (nTime < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  New(BaseObjectEffect);
  BaseObjectEffect.ActorEffect.nEffectFileIndex := nFileIndex;
  BaseObjectEffect.ActorEffect.nEffectImageOffSet := nStartImage;
  BaseObjectEffect.ActorEffect.wEffectImageCount := nImageCount;
  BaseObjectEffect.ActorEffect.wEffectFrameTime := nTime;
  BaseObjectEffect.ActorEffect.btDrawOrder := btDrawOrder;
  BaseObjectEffect.ActorEffect.nOffsetX := nOffsetX;
  BaseObjectEffect.ActorEffect.nOffsetY := nOffsetY;
  BaseObjectEffect.ActorEffect.boBlendMode := boBlendMode;

  if nPlayCount <= 0 then
    BaseObjectEffect.ActorEffect.nLoopCount := -1
  else
    BaseObjectEffect.ActorEffect.nLoopCount := nPlayCount;

  BaseObjectEffect.nOldLoopCount := nPlayCount;
  BaseObjectEffect.dwEffectTick := MyGetTickCount;
  BaseObject.m_BaseObjectEffects.LockW(2);
  try
    BaseObject.m_BaseObjectEffects.Add(BaseObjectEffect);
  finally
    BaseObject.m_BaseObjectEffects.UnLockW;
  end;
  BaseObject.RefUseEffects;
end;

procedure ActionOfStopPlayEffect(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nFileIndex, nStartImage, nImageCount, nPlayCount, nTime: Integer;
  BaseObjectEffect: pTBaseObjectEffect;
  IsFound: Boolean;
  btDrawOrder: Byte;
  nOffsetX, nOffsetY: Integer;
begin
  nFileIndex := QuestActionInfo.nParam1;
  nStartImage := QuestActionInfo.nParam2;
  nImageCount := QuestActionInfo.nParam3;
  nPlayCount := QuestActionInfo.nParam4;
  nTime := QuestActionInfo.nParam5;
  btDrawOrder := QuestActionInfo.nParam6;
  nOffsetX := QuestActionInfo.nParam7;
  nOffsetY := QuestActionInfo.nParam8;

  if (nFileIndex < 0) or (nStartImage < 0) or (nImageCount < 0) or (nPlayCount < 0) or (nTime < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  IsFound := False;
  BaseObject.m_BaseObjectEffects.LockW(4);
  try
    for I := BaseObject.m_BaseObjectEffects.Count - 1 downto 0 do
    begin
      BaseObjectEffect := BaseObject.m_BaseObjectEffects.Items[I];
      if (BaseObjectEffect.ActorEffect.nEffectFileIndex = nFileIndex) and (BaseObjectEffect.ActorEffect.nEffectImageOffSet = nStartImage) and (BaseObjectEffect.ActorEffect.wEffectImageCount = nImageCount) and (BaseObjectEffect.ActorEffect.wEffectFrameTime = nTime) and (BaseObjectEffect.nOldLoopCount = nPlayCount) and (BaseObjectEffect.ActorEffect.btDrawOrder = btDrawOrder) and (BaseObjectEffect.ActorEffect.nOffsetX = nOffsetX) and (BaseObjectEffect.ActorEffect.nOffsetY = nOffsetY) then
      begin
        Dispose(BaseObjectEffect);
        BaseObject.m_BaseObjectEffects.Delete(I);
        IsFound := True;
      end;
    end;
  finally
    BaseObject.m_BaseObjectEffects.UnLockW;
  end;

  if IsFound then
    BaseObject.RefUseEffects;
end;

procedure ActionOfClearPlayEffect(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  BaseObjectEffect: pTBaseObjectEffect;
  IsChange: Boolean;
begin
  IsChange := False;
  BaseObject.m_BaseObjectEffects.LockW(5);
  try
    if BaseObject.m_BaseObjectEffects.Count > 0 then
    begin
      for I := BaseObject.m_BaseObjectEffects.Count - 1 downto 0 do
      begin
        BaseObjectEffect := BaseObject.m_BaseObjectEffects.Items[I];
        Dispose(BaseObjectEffect);
      end;
      BaseObject.m_BaseObjectEffects.Clear;

      IsChange := True;
    end;
  finally
    BaseObject.m_BaseObjectEffects.UnLockW;
  end;

  if IsChange then
    BaseObject.RefUseEffects;
end;

procedure ActionOfScreenEffect(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  ScreenEffectData: TScreenEffectData;
  sSendMsg: AnsiString;
  I: Integer;
  AObject: TPlayObject;
begin
  ScreenEffectData.nX := QuestActionInfo.nParam1;
  ScreenEffectData.nY := QuestActionInfo.nParam2;
  ScreenEffectData.nImageIndex := QuestActionInfo.nParam3;
  ScreenEffectData.nStartImage := QuestActionInfo.nParam4;
  ScreenEffectData.nImageCount := QuestActionInfo.nParam5;
  ScreenEffectData.nPlayCount := QuestActionInfo.nParam6;
  ScreenEffectData.nTime := QuestActionInfo.nParam7;
  ScreenEffectData.boBlend := QuestActionInfo.sParam8 = '1';
  ScreenEffectData.boDrawTopmost := QuestActionInfo.nParam10 <> 0;

  if (ScreenEffectData.nX < 0) or (ScreenEffectData.nY < 0) or (ScreenEffectData.nImageIndex < 0) or (ScreenEffectData.nStartImage < 0) or (ScreenEffectData.nImageCount <= 0) { or (ScreenEffectData.nPlayCount <= 0) } or (ScreenEffectData.nTime <= 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  SetLength(sSendMsg, SizeOf(TScreenEffectData));
  Move(ScreenEffectData, sSendMsg[1], Length(sSendMsg));

  if QuestActionInfo.sParam9 = '1' then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      UserEngine.m_PlayObjectList.LockR(64);
    try
{$IFEND}
      for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
      begin
        AObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
        if (AObject <> nil) then
        begin
          AObject.SendMsg(AObject, RM_SCREENEFFECT, Length(sSendMsg), NativeInt(AObject), 0, 0, sSendMsg);
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        UserEngine.m_PlayObjectList.UnLockR;
    end;
{$IFEND}
  end
  else
    PlayObject.SendMsg(PlayObject, RM_SCREENEFFECT, Length(sSendMsg), NativeInt(PlayObject), 0, 0, sSendMsg);
end;

