procedure ActionOfCreateNpc(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);

  function GetRandXY(Envir: TEnvirnoment; var nX: Integer; var nY: Integer): Boolean;
  var
    n14, n18, n1C: Integer;
  begin
    Result := False;
    if Envir.m_nWidth < 80 then
      n18 := 3
    else
      n18 := 10;

    if Envir.m_nHeight < 150 then
    begin
      if Envir.m_nHeight < 50 then
        n1C := 2
      else
        n1C := 15;
    end
    else
      n1C := 50;
    n14 := 0;

    nX := Random(Envir.m_nWidth - n18 - 1) + n18;
    nY := Random(Envir.m_nHeight - n18 - 1) + n18;

    while (True) do
    begin
      if Envir.CanWalk(nX, nY, True) then
      begin
        Result := True;
        Break;
      end;

      if nX < (Envir.m_nWidth - n1C - 1) then
        Inc(nX, n18)
      else
      begin
        nX := Random(Envir.m_nWidth);
        if nY < (Envir.m_nHeight - n1C - 1) then
          Inc(nY, n18)
        else
          nY := Random(Envir.m_nHeight);
      end;

      Inc(n14);
      if n14 >= 201 then
        Break;
    end;
  end;

var
  tMerchantNPC: TMerchant;
  nX, nY, nAppr, nPos: Integer;
  sCharName: string;
  sScript: string;
  Envir: TEnvirnoment;
begin
  Envir := nil;
  sCharName := QuestActionInfo.sParam1;
  if (not QuestActionInfo.boCompleteFormat2) and (QuestActionInfo.VarInfo2.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam2);

  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam2);

  nX := QuestActionInfo.nParam3;
  nY := QuestActionInfo.nParam4;
  nAppr := QuestActionInfo.nParam5;
  sScript := QuestActionInfo.sParam6;

  if (Envir = nil) or (nAppr < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  nPos := Pos('-', sScript);
  if nPos > 0 then
    sScript := Copy(sScript, 1, nPos - 1);

  if not UserEngine.MerchantExists(Envir, nX, nY) then
  begin
    tMerchantNPC := TMerchant.Create;
    tMerchantNPC.m_sScript := sScript;
    tMerchantNPC.m_sMapName := Envir.sMapName;
    tMerchantNPC.m_PEnvir := Envir;

    if (nX < 0) or (nY < 0) then
      GetRandXY(Envir, nX, nY);

    tMerchantNPC.m_nCurrX := nX;
    tMerchantNPC.m_nCurrY := nY;

    tMerchantNPC.m_sCharName := sCharName;
    tMerchantNPC.m_nFlag := 0;
    tMerchantNPC.m_wAppr := nAppr;
    tMerchantNPC.m_dwMoveTime := 0;
    tMerchantNPC.m_dwNpcAutoChangeColorTime := 0;

    tMerchantNPC.Initialize;
    if not tMerchantNPC.m_boAddtoMapFail or tMerchantNPC.m_boIsHide then
    begin
      tMerchantNPC.LoadNpcScript(QuestActionInfo.nParam7 = 0);
      tMerchantNPC.LoadNPCData();
      UserEngine.AddMerchant(tMerchantNPC);
      UserEngine.AddScriptCreateNpcInfo(Npc, BaseObject, PlayObject, QuestActionInfo);
    end
    else
      tMerchantNPC.Free;
  end
  else
    Npc.ScriptActionError(BaseObject, '当前地图当前坐标已经存在NPC，不能重复创建！', QuestActionInfo);
end;

procedure ActionOfDelNpc(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  sCharName, sMapName: string;
  Merchant: TMerchant;
begin
  sCharName := QuestActionInfo.sParam1;
  sMapName := QuestActionInfo.sParam2;

  if sCharName.IsEmpty then
    Exit;

  UserEngine.m_MerchantList.LockR(15);
  try
    for I := UserEngine.m_MerchantList.Count - 1 downto 0 do
    begin
      Merchant := TMerchant(UserEngine.m_MerchantList.Items[I]);
      if CompareText(Merchant.m_sCharName, sCharName) = 0 then
      begin
        if sMapName.IsEmpty //
          or SameText(Merchant.m_sMapName, sMapName) //
          or (Merchant.m_PEnvir = nil) //
          or ((Merchant.m_PEnvir.m_boFB) and SameText(Merchant.m_PEnvir.m_sFBName, sMapName)) then
        begin
          UserEngine.DelScriptCreateNpcInfo(Merchant.m_sCharName, sMapName);

          Merchant.MakeGhost;
          if not Merchant.m_boIsHide then
            Merchant.SendRefMsg(RM_DISAPPEAR, 0, 0, 0, 0, '');
        end;
      end;
    end;
  finally
    UserEngine.m_MerchantList.UnLockR;
  end;
end;

