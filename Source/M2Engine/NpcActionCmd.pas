procedure ActionOfSetNpcImage(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  OldEffigyState: TFeature_New;
  OldEffigyOffset: Integer;
  OldLevel: Integer;
  OldName: string;
  OldGrayShow: Boolean;
  OldScaleShow: Boolean;
  SetImageInfo: TSetImageInfo;
begin
  if Npc.m_wAppr <> 273 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.nParam1 < 0 then
  begin
    OldEffigyState := Npc.m_nEffigyState;
    OldEffigyOffset := Npc.m_nEffigyOffset;
    OldName := Npc.m_sAddName;
    OldLevel := Npc.m_nAddLevel;
    OldGrayShow := Npc.m_boGrayShow;
    OldScaleShow := Npc.m_boScaleShow;

    Npc.m_nEffigyState.Value1 := 0;
    Npc.m_nEffigyState.Value2 := 0;
    Npc.m_sAddName := '';
    Npc.m_nEffigyOffset := 0;
    Npc.m_nAddLevel := 0;
    Npc.m_boGrayShow := True;
    Npc.m_boScaleShow := True;
    Npc.m_nValidTime := -1;
  end
  else
  begin
    OldEffigyState := Npc.m_nEffigyState;
    OldEffigyOffset := Npc.m_nEffigyOffset;
    OldName := Npc.m_sAddName;
    OldLevel := Npc.m_nAddLevel;
    OldGrayShow := Npc.m_boGrayShow;
    OldScaleShow := Npc.m_boScaleShow;

    Npc.m_nEffigyState := PlayObject.GetFeature_New;
    Npc.m_nEffigyOffset := QuestActionInfo.nParam1;
    Npc.m_sAddName := PlayObject.m_sCharName;
    Npc.m_nAddLevel := PlayObject.m_Abil.Level;
    Npc.m_boGrayShow := QuestActionInfo.nParam2 = 0;
    Npc.m_boScaleShow := QuestActionInfo.nParam3 = 0;
    Npc.m_nValidTime := -1;
  end;

  if (OldEffigyState.Value1 <> Npc.m_nEffigyState.Value1) or (OldEffigyState.Value2 <> Npc.m_nEffigyState.Value2) or (OldEffigyOffset <> Npc.m_nEffigyOffset) or (OldName <> Npc.m_sAddName) or (OldLevel <> Npc.m_nAddLevel) or (OldGrayShow <> Npc.m_boGrayShow) or (OldScaleShow <> Npc.m_boScaleShow) then
  begin
    SetImageInfo.EffigyState := Npc.m_nEffigyState;
    SetImageInfo.ChrName := Npc.m_sCharName + '\' + Npc.m_sAddName;

    Npc.m_wValidTimeTick := MyGetTickCount;

    PlayObject.SendRefMsg(RM_SETNPCIMAGE, NativeInt(Npc), Npc.m_nEffigyOffset, Integer(Npc.m_boGrayShow), Integer(Npc.m_boScaleShow), EncodeBuffer(@SetImageInfo, SizeOf(SetImageInfo)));
    Npc.SaveAddData;
  end;
end;

// 设置NPC外观有效时间 chongchong 2015-01-16
procedure ActionOfSetNpcImageTime(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  cMethod: Char;
  nTime: Integer;
  Int64Value: Int64;
begin
  if Npc.m_wAppr <> 273 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  nTime := QuestActionInfo.nParam2;
  if (QuestActionInfo.sParam1 = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if nTime <= 0 then
          nTime := -1;
        Npc.m_nValidTime := nTime;
      end;
    '+':
      begin
        if nTime < 0 then
        begin
          Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
          Exit;
        end
        else if Npc.m_nValidTime >= 0 then
        begin
          Int64Value := Int64(Npc.m_nValidTime) + nTime;
          Npc.m_nValidTime := Min(Int64Value, High(Integer));
        end;
      end;
    '-':
      begin
        if nTime < 0 then
        begin
          Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
          Exit;
        end
        else if Npc.m_nValidTime >= 0 then
        begin
          if Npc.m_nValidTime >= nTime then
            Npc.m_nValidTime := Npc.m_nValidTime - nTime
          else
            Npc.m_nValidTime := 0;
        end;
      end;
  end;
end;

