procedure ActionOfChangeGamePetEggAbil(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, AbilType, nValue: Integer;
  dwOldValue, dwMaxValue: LongWord;
  UserItem: pTUserItem;
  nBoxItemIndex, nMakeIndex, LockUpdateItemIndex: Integer;
  SmartObject: TSmartObject;
  cMethod: Char;
  StdItem: pTStdItem;
  PetName: string;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  AbilType := QuestActionInfo.nParam2;
  nValue := QuestActionInfo.nParam4;

  if (QuestActionInfo.sParam3 = '') or (AbilType < 1) or (AbilType > 4) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if not (((nWhere = -1)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := nil;
  LockUpdateItemIndex := 0;

  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else
  begin
    LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  StdItem := UserEngine.GetStdItem(UserItem.wIndex);
  cMethod := QuestActionInfo.sParam3[1];
  if UserItem <> nil then
  begin
    case cMethod of
      '=':
        begin
          case AbilType of // 宠物等级
            1:
              begin
                UserItem.Dura := LoWord(nValue);
                UserItem.DuraMax := HiWord(nValue);

                PetName := UserItem.Name;
                if (StdItem <> nil) and (StdItem.StdMode = 92) then
                  PetName := StdItem.Name;

                RecallGamePetAbilToUserItem(PetName, nValue, UserItem);
              end;
            2:
              begin
                // MaxHP
                dwMaxValue := MakeLong(UserItem.btNewValue[14], UserItem.btNewValue[15]);
                if nValue > dwMaxValue then
                  nValue := dwMaxValue;

                // HP
                UserItem.btNewValue[0] := LoWord(nValue);
                UserItem.btNewValue[11] := HiWord(nValue);
              end;
            3:
              begin
                // MaxMP
                dwMaxValue := MakeLong(UserItem.btNewValue[16], UserItem.btNewValue[17]);
                if nValue > dwMaxValue then
                  nValue := dwMaxValue;

                // MP
                UserItem.btNewValue[1] := LoWord(nValue);
                UserItem.btNewValue[12] := HiWord(nValue);
              end;
            4:
              begin
                // MaxExp
                dwMaxValue := MakeLong(UserItem.btNewValue[18], UserItem.btNewValue[19]);
                if nValue > dwMaxValue then
                  nValue := dwMaxValue;

                // Exp
                UserItem.btNewValue[2] := LoWord(nValue);
                UserItem.btNewValue[13] := HiWord(nValue);
              end;
          end;
        end;
      '-':
        begin
          case AbilType of
            1:
              begin
                dwOldValue := MakeLong(UserItem.Dura, UserItem.DuraMax);
                nValue := dwOldValue - nValue;
                if nValue < 0 then
                  nValue := 0;
                UserItem.Dura := LoWord(nValue);
                UserItem.DuraMax := HiWord(nValue);

                PetName := UserItem.Name;
                if (StdItem <> nil) and (StdItem.StdMode = 92) then
                  PetName := StdItem.Name;

                RecallGamePetAbilToUserItem(PetName, nValue, UserItem);
              end;
            2:
              begin
                dwOldValue := MakeLong(UserItem.btNewValue[0], UserItem.btNewValue[11]);
                nValue := dwOldValue - nValue;
                if nValue < 0 then
                  nValue := 0;
                // HP
                UserItem.btNewValue[0] := LoWord(nValue);
                UserItem.btNewValue[11] := HiWord(nValue);
              end;
            3:
              begin
                dwOldValue := MakeLong(UserItem.btNewValue[1], UserItem.btNewValue[12]);
                nValue := dwOldValue - nValue;
                if nValue < 0 then
                  nValue := 0;
                // MP
                UserItem.btNewValue[1] := LoWord(nValue);
                UserItem.btNewValue[12] := HiWord(nValue);
              end;
            4:
              begin
                dwOldValue := MakeLong(UserItem.btNewValue[2], UserItem.btNewValue[13]);
                nValue := dwOldValue - nValue;
                if nValue < 0 then
                  nValue := 0;
                // Exp
                UserItem.btNewValue[2] := LoWord(nValue);
                UserItem.btNewValue[13] := HiWord(nValue);
              end;
          end;
        end;
      '+':
        begin
          case AbilType of
            1:
              begin
                dwOldValue := MakeLong(UserItem.Dura, UserItem.DuraMax);
                nValue := dwOldValue + nValue;

                UserItem.Dura := LoWord(nValue);
                UserItem.DuraMax := HiWord(nValue);

                PetName := UserItem.Name;
                if (StdItem <> nil) and (StdItem.StdMode = 92) then
                  PetName := StdItem.Name;

                RecallGamePetAbilToUserItem(PetName, nValue, UserItem);
              end;
            2:
              begin
                dwOldValue := MakeLong(UserItem.btNewValue[0], UserItem.btNewValue[11]);
                nValue := dwOldValue + nValue;

                // MaxHP
                dwMaxValue := MakeLong(UserItem.btNewValue[14], UserItem.btNewValue[15]);
                if nValue > dwMaxValue then
                  nValue := dwMaxValue;

                // HP
                UserItem.btNewValue[0] := LoWord(nValue);
                UserItem.btNewValue[11] := HiWord(nValue);
              end;
            3:
              begin
                dwOldValue := MakeLong(UserItem.btNewValue[1], UserItem.btNewValue[12]);
                nValue := dwOldValue + nValue;

                // MaxMP
                dwMaxValue := MakeLong(UserItem.btNewValue[16], UserItem.btNewValue[17]);
                if nValue > dwMaxValue then
                  nValue := dwMaxValue;

                // MP
                UserItem.btNewValue[1] := LoWord(nValue);
                UserItem.btNewValue[12] := HiWord(nValue);
              end;
            4:
              begin
                dwOldValue := MakeLong(UserItem.btNewValue[2], UserItem.btNewValue[13]);
                nValue := dwOldValue + nValue;

                // MaxExp
                dwMaxValue := MakeLong(UserItem.btNewValue[18], UserItem.btNewValue[19]);
                if nValue > dwMaxValue then
                  nValue := dwMaxValue;

                // MP
                UserItem.btNewValue[2] := LoWord(nValue);
                UserItem.btNewValue[13] := HiWord(nValue);
              end;
          end;
        end;
    end;
  end;

  if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
        TPlayObject(SmartObject).UpdateBoxItem(nBoxItemIndex)
      else
        TPlayObject(SmartObject).SendUpdateItem(UserItem)
    end
    else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
      THeroObject(SmartObject).SendUpdateItem(UserItem);
  end;
end;

