procedure ActionOfGoto(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  InputStr, GotoTypeStr, Parameter, InputValue, ReturnValue: string;
  nCut, PosOfParenthesis: Integer;
begin
  InputStr := QuestActionInfo.sParam1;
  PosOfParenthesis := Pos('(', InputStr);
  if PosOfParenthesis > 0 then
  begin
    GotoTypeStr := Copy(InputStr, 1, PosOfParenthesis - 1);
    ArrestStringEx(InputStr, '(', ')', Parameter);
    Parameter := Trim(Parameter);
    ReturnValue := GetValidStr3(Parameter, InputValue, ['|']);

    nCut := 0;
    while True do
    begin
      if InputValue = '' then
        Break;
      InputValue := GetValidStr3(InputValue, PlayObject.m_sScriptParams[nCut], [',']);
      Inc(nCut, 1);
    end;

    nCut := 0;
    while True do
    begin
      if ReturnValue = '' then
        Break;
      ReturnValue := GetValidStr3(ReturnValue, PlayObject.m_sReturnParams[nCut], [',']);
      Inc(nCut, 1);
    end;

    if not JmpToLable(Npc, PlayObject, GotoTypeStr) then
    begin
      MainOutMessage('[脚本死循环] NPC:' + Npc.m_sCharName + ' 位置:' + Npc.m_sMapName + '(' + IntToStr(Npc.m_nCurrX) + ':' + IntToStr(Npc.m_nCurrY) + ')' + ' 命令:GOTO ' + QuestActionInfo.sParam1);
      boBreak := True;
    end;
  end
  else
  begin
    if not JmpToLable(Npc, PlayObject, QuestActionInfo.sParam1) then
    begin
      MainOutMessage('[脚本死循环] NPC:' + Npc.m_sCharName + ' 位置:' + Npc.m_sMapName + '(' + IntToStr(Npc.m_nCurrX) + ':' + IntToStr(Npc.m_nCurrY) + ')' + ' 命令:GOTO ' + QuestActionInfo.sParam1);
      boBreak := True;
    end;
  end;
end;

