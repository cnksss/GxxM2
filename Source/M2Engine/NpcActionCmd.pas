procedure ActionOfSendMobileVerifyCode(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  if g_nKey_MobileSMS <> 0 then
  begin
    if Length(g_AcsUtil.KeyID) = 0 then
    begin
      MainOutMessage('无法发送短信，KeyID未配置');
      Exit;
    end;

    if Length(g_AcsUtil.KeySecret) = 0 then
    begin
      MainOutMessage('无法发送短信，KeySecret未配置');
      Exit;
    end;

    if Length(g_SendSMSConfig.SignName) = 0 then
    begin
      MainOutMessage('无法发送短信，SignName未配置');
      Exit;
    end;

    if Length(g_SendSMSConfig.TemplateCodeBind) = 0 then
    begin
      MainOutMessage('无法发送短信，TemplateCodeBind未配置');
      Exit;
    end;

    if Length(g_SendSMSConfig.TemplateCodeCheck) = 0 then
    begin
      MainOutMessage('无法发送短信，TemplateCodeCheck未配置');
      Exit;
    end;

    if Length(PlayObject.m_sMobileNumber) > 0 then
    begin
      if tick_diff(PlayObject.m_dwMobileVerifyTick, MyGetTickCount) <= g_SendSMSConfig.VerifySendInterval * 1000 then
      begin
        // NPC.GotoLable(PlayObject, '@MobileVerifyCodeInterval', False)
        if g_FunctionNPC <> nil then
        begin
          PlayObject.m_nScriptGotoCount := 0;
          g_FunctionNPC.GotoLable(PlayObject, '@MobileVerifyCodeInterval', False);
        end;
      end
      else
      begin
        PlayObject.m_nMobileVerifyCodeErrorCount := 0;
        g_AliyunSendSMSThread.AddTask(PlayObject, Npc);
      end;
    end;
  end;
end;

