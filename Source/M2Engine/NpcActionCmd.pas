procedure ActionOfOpenMerchantBigDlg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nImageIndex, nImageFace, nX, nY, nCloseX, nCloseY: Integer;
  IsKeepBigDlg: Boolean;
begin
  nImageIndex := QuestActionInfo.nParam1;
  nImageFace := QuestActionInfo.nParam2;
  nX := QuestActionInfo.nParam5;
  nY := QuestActionInfo.nParam6;
  nCloseX := StrToIntDef(QuestActionInfo.sParam8, -High(Integer));
  nCloseY := StrToIntDef(QuestActionInfo.sParam9, -High(Integer));
  IsKeepBigDlg := QuestActionInfo.nParam10 = 1;

  if (nImageIndex < 0) or (nImageFace < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
  // sParam1 = WIL文件序号
  // sParam2 = 图片序号
  // sParam3 = 是否可以移动
  // sParam4 = 显示位置
  // sParam5 = 微调坐标X
  // sParam6 = 微调坐标Y
  // sParam7 = 是否显示关闭按钮
  // sParam8 = 关闭按钮  nX
  // sParam9 = 关闭按钮  nY

