procedure ActionOfSetBigStorageCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  StorageExtCount: Integer;
  cMethod: Char;
begin
  StorageExtCount := QuestActionInfo.nParam2;

  if (QuestActionInfo.sParam1 = '') or (StorageExtCount < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if (StorageExtCount >= 0) then
        begin
          PlayObject.m_nInfinityStorageExtCount := Min(StorageExtCount, High(Word));
        end;
      end;
    '-':
      begin
        StorageExtCount := Max(0, PlayObject.m_nInfinityStorageExtCount - StorageExtCount);
        PlayObject.m_nInfinityStorageExtCount := StorageExtCount;
      end;
    '+':
      begin
        StorageExtCount := Max(0, PlayObject.m_nInfinityStorageExtCount + StorageExtCount);
        if StorageExtCount > High(Word) then
          StorageExtCount := High(Word);
        PlayObject.m_nInfinityStorageExtCount := StorageExtCount;
      end;
  end;
end;

