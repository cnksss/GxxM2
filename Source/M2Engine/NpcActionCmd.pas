procedure ActionOfGetUpgradeCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nCount, nMakeIndex: Integer;
  UserItem: pTUserItem;
  nBoxItemIndex: Integer;
  SmartObject: TSmartObject;
  IsAll: Boolean;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  if QuestActionInfo.sRawParam2 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  IsAll := SameText(QuestActionInfo.sParam1, 'all') or SameText(QuestActionInfo.sParam1, '*');
  if IsAll then
  begin
    nCount := 0;

    for nWhere := Low(THumanUseItems) to High(THumanUseItems) do
    begin
      UserItem := @SmartObject.m_UseItems[nWhere];
      if (UserItem.wIndex > 0) then
        Inc(nCount, UserItem.btUpgradeCount);
    end;

    for nWhere := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
    begin
      UserItem := @SmartObject.m_JewelryBoxItems[nWhere];
      if (UserItem.wIndex > 0) then
        Inc(nCount, UserItem.btUpgradeCount);
    end;

    for nWhere := Low(THumanGodBlessItems) to High(THumanGodBlessItems) do
    begin
      UserItem := @SmartObject.m_GodBlessItems[nWhere];
      if (UserItem.wIndex > 0) then
        Inc(nCount, UserItem.btUpgradeCount);
    end;

    if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(nCount), nCount) then
    begin
      Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    end;

    Exit;
  end;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      nMakeIndex := PlayObject.m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to PlayObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(PlayObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := PlayObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    UserItem := @SmartObject.m_UseItems[nWhere];
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
  end
  else if nWhere = -1 then
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if (UserItem = nil) or (UserItem.wIndex <= 0) then
    nCount := 0
  else
    nCount := UserItem.btUpgradeCount;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(nCount), nCount) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfSetSkillPower(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  wMagicIndex: Integer;
  SmartObject: TSmartObject;
  cMethod: Char;
  Value: Integer;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  wMagicIndex := QuestActionInfo.nParam1;
  if (wMagicIndex >= CUSTOM_MAGIC_START_ID) and (wMagicIndex < CUSTOM_MAGIC_START_ID + CUSTOM_MAGIC_COUNT) then
  begin
    wMagicIndex := wMagicIndex - CUSTOM_MAGIC_START_ID + DEF_MAGIC_COUNT + 1;
  end;

