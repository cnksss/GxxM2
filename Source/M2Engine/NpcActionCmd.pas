procedure ActionOfGetBagItemCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, J, nCount: Integer;
  sItemName: string;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  FindInItemBox: Boolean;
  SmartObject: TSmartObject;
begin
  sItemName := QuestActionInfo.sParam1;

  if (Length(sItemName) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.sRawParam2 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '变量名不能为空', QuestActionInfo);
    Exit;
  end;

  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nCount := 0;
  for I := 0 to SmartObject.m_ItemList.Count - 1 do
  begin
    UserItem := pTUserItem(SmartObject.m_ItemList[I]);
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (StdItem <> nil) and SameText(StdItem.Name, sItemName) then
    begin
      FindInItemBox := False;

      if QuestActionInfo.nParam3 = 1 then
      begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          for J := Low(TPlayObject(SmartObject).m_ItemBoxItems) to High(TPlayObject(SmartObject).m_ItemBoxItems) do
          begin
            if TPlayObject(SmartObject).m_ItemBoxItems[J] = UserItem.MakeIndex then
            begin
              FindInItemBox := True;
              Break;
            end;
          end;
        end;
      end;

      if not FindInItemBox then
      begin
        if CheckOverLapItem(StdItem) then
          Inc(nCount, UserItem.Dura + 1)
        else
          Inc(nCount, 1);
      end;
    end;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam2, IntToStr(nCount), nCount) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfWriteLine(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sFileName: string;
  SL: TStringList;
begin
  if QuestActionInfo.nParam4 = 1 then
    sFileName := QuestActionInfo.sParam1
  else
    sFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1;

  if QuestActionInfo.nParam2 < 0 then
  begin
    Npc.ScriptActionError(PlayObject, '行号必须>=0', QuestActionInfo);
    Exit;
  end;

  SL := TStringList.Create;
  try
    if FileExists(sFileName) then
      SL.LoadFromFile(sFileName);

    if QuestActionInfo.nParam2 >= SL.Count then
      SL.Add(QuestActionInfo.sParam3)
    else
      SL.Strings[QuestActionInfo.nParam2] := QuestActionInfo.sParam3;

    SL.SaveToFile(sFileName);
  finally
    SL.Free;
  end;
end;

