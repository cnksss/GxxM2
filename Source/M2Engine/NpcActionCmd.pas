    if not Player.m_boUserUnLockDurg and ((StdItem.Reserved and 2) <> 0) then
    begin
      Player.SysMsg(g_sCanotTakeOffItem { '无法取下物品！' } , c_Red, t_Hint);
      Exit;
    end;

    (*
      if (StdItem.Reserved and 4) <> 0 then
      begin
      Player.SysMsg(g_sCanotTakeOffItem {'无法取下物品！'}, c_Red, t_Hint);
      Exit;
      end;

