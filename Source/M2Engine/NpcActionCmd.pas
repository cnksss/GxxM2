procedure ActionOfGetMagicInfo(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nValueType: Integer;
  Magic1: pTMagic;
  SmartObject: TSmartObject;
  UserMagic: pTUserMagic;
  nValue: Integer;
  sValue: string;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  if (QuestActionInfo.sParam1 = '') and (QuestActionInfo.sRawParam3 = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  nValueType := QuestActionInfo.nParam2;

  if not (nValueType in [0..2]) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if BaseObject.m_btRaceServer = RC_HEROOBJECT then
    Magic1 := UserEngine.FindHeroMagic(QuestActionInfo.sParam1)
  else
    Magic1 := UserEngine.FindMagic(QuestActionInfo.sParam1);

  if (Magic1 = nil) then
    Exit;

  nValue := 0;
  for I := 0 to SmartObject.m_MagicList.Count - 1 do
  begin
    UserMagic := SmartObject.m_MagicList.Items[I];
    if UserMagic.MagicInfo.wMagicId = Magic1.wMagicId then
    begin
      case nValueType of
        0:
          begin
            nValue := UserMagic.btLevel;
            sValue := IntToStr(nValue);
          end;
        1:
          begin
            nValue := UserMagic.btNewLevel;
            sValue := IntToStr(nValue);
          end;
        2:
          begin
            nValue := UserMagic.nTranPoint;
            sValue := IntToStr(nValue);
          end;
      end;

      Break;
    end;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, sValue, nValue) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

