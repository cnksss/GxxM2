procedure ActionOfGameGoldEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nGameGold: Integer;
  cMethod: Char;
begin
  nGameGold := QuestActionInfo.nParam2;

  if (QuestActionInfo.sParam1 = '') or (nGameGold < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if (nGameGold >= 0) then
        begin
          PlayObject.m_nGameGoldEx := nGameGold;
        end;
      end;
    '-':
      begin
        nGameGold := Max(0, PlayObject.m_nGameGoldEx - nGameGold);
        PlayObject.m_nGameGoldEx := nGameGold;
      end;
    '+':
      begin
        nGameGold := Max(0, PlayObject.m_nGameGoldEx + nGameGold);
        PlayObject.m_nGameGoldEx := nGameGold;
      end;
  end;
end;

