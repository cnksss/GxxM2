// 打开酒界面
// 格式:OPENPLAYDRINK 人物头像(0,1,2) 人物名字(0:翔天,1:辰星,2:影月)----(打开请酒界面)
// 格式:OPENPLAYDRINK 人物头像(0,1,2) 人物名字(0:翔天,1:辰星,2:影月)  DRINK----(打开斗酒界面)

procedure ActionOfOpenDrinkDlg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIcon: Integer; // 人物头像
  sName: string; // 人物名称
begin
  nIcon := QuestActionInfo.nParam1;
  sName := QuestActionInfo.sParam2;

  if (nIcon < 0) or (nIcon > 3) or (sName = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
  if CompareText(QuestActionInfo.sParam3, 'DRINK') = 0 then
  begin // 打开斗酒界面
    PlayObject.SendMsg(Npc, RM_OPENPLAYDRINK, 0, 0, 1, nIcon, sName);
    PlayObject.m_DrinkValue[0] := 0; // 喝酒的醉酒值 0-NPC 1-玩家
    PlayObject.m_DrinkValue[1] := 0;
    PlayObject.m_btDrinkCount := 0; // 喝酒的次数(斗酒一次最高6次)
  end
  else
  begin // 打开请酒界面
    if PlayObject.m_boPleaseDrink then
    begin // 已请过酒的直接操作
      Npc.GotoLable(PlayObject, '@SaveHero', False);
    end
    else
    begin // 没请过酒的,打开请酒界面
      PlayObject.SendMsg(Npc, RM_OPENPLAYDRINK, 0, 0, 2, nIcon, sName);
    end;
  end;
end;

