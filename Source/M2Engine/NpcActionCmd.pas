procedure ActionOfSetItemState(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nBoxItemIndex, nMakeIndex, nState: Integer;
  UserItem: pTUserItem;
  SmartObject: TSmartObject;
