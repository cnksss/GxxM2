    PlayObject.m_nVerifyCodeErrorCount := 0;
    PlayObject.m_VerifyCodeGotoNpc := Npc;
    PlayObject.m_sVerifyCodeGotoLabel := QuestActionInfo.sParam1;

    PlayObject.SendMsg(PlayObject, RM_VERIFYCODE, 0, 0, 0, 0, '');
  end;
end;

procedure ActionOfGetNPCName(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  IsBreakParseVar: Boolean;
begin
  if Length(QuestActionInfo.sRawParam1) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, Npc.m_sCharName, StrToIntDef(Npc.m_sCharName, 0)) then
  begin
    if (QuestActionInfo.VarInfo1.VarAttr > aNone) then
    begin
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, QuestActionInfo.sParam1, QuestActionInfo.nParam1, IsBreakParseVar);
      if not Npc.SetVarValue(PlayObject, QuestActionInfo.sParam1, Npc.m_sCharName, StrToIntDef(Npc.m_sCharName, 0)) then
      begin
        Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      end;
    end
    else
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    end;
  end;
end;

procedure ActionOfReleaseMagic(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  wMagIdx: Integer;
  Magic: pTMagic;
  TempMagic: TUserMagic;
  wHitMode: Integer;
  TargetCret: TBaseObject;
  nDir: Integer;
  CanAttack: Boolean;
  boShowAttackAction: Boolean;
  SmartObject: TSmartObject;
begin
  CanAttack := False; // HZQ
  wHitMode := 0; // HZQ

  wMagIdx := QuestActionInfo.nParam1;
  if not (QuestActionInfo.nParam4 in [1, 2]) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  if QuestActionInfo.nParam4 = 1 then
    TargetCret := SmartObject.m_TargetCret
  else
    TargetCret := SmartObject;

  if TargetCret = nil then
    Exit;

  boShowAttackAction := QuestActionInfo.nParam5 = 0;

  if BaseObject.m_btRaceServer = RC_HEROOBJECT then
  begin
    if wMagIdx > 0 then
      Magic := UserEngine.FindHeroMagic(wMagIdx)
    else
      Magic := UserEngine.FindHeroMagic(QuestActionInfo.sParam1);
  end
  else
  begin
    if wMagIdx > 0 then
      Magic := UserEngine.FindMagic(wMagIdx)
    else
      Magic := UserEngine.FindMagic(QuestActionInfo.sParam1);
  end;

  if Magic <> nil then
  begin
    if not CheckIsCustomMagic(Magic.wMagicId) then
    begin
      TempMagic.MagicInfo := Magic;

      TempMagic.MagicAttr := Magic.MagicAttr;
      TempMagic.wMagIdx := Magic.wMagicId;

      TempMagic.btLevel := 0;
      TempMagic.btNewLevel := 0;
      TempMagic.btKey := Integer(boShowAttackAction);
      TempMagic.nTranPoint := 0;
      TempMagic.boUsesItemAdd := False;

      if QuestActionInfo.nParam2 = 0 then
        TempMagic.btLevel := QuestActionInfo.nParam3
      else
        TempMagic.btNewLevel := QuestActionInfo.nParam3;

      if MagicManager.IsWarrSkill(TempMagic.wMagIdx) then
      begin
        if (TempMagic.wMagIdx = SKILL_ONESWORD) { 3 } then
        begin
          // 基本剑术
          wHitMode := 0;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_ILKWANG { 4 } then
        begin
          // 精神力战法
          wHitMode := 0;
          CanAttack := True;
        end
        else if TempMagic.wMagIdx = SKILL_YEDO { 7 } then
        begin // 攻杀剑术
          wHitMode := 3;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_ERGUM { 12 } then
        begin
          // 刺杀
          wHitMode := 4;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) = 0) or (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) = 0) or (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) = abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY));
        end
        else if TempMagic.wMagIdx = SKILL_BANWOL { 25 } then
        begin
          // 半月弯刀
          wHitMode := 8;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_FIRESWORD { 26 } then
        begin // 烈火剑法
          wHitMode := 7;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_MOOTEBO { 27 } then
        begin // 野蛮冲撞
          // 增加释放野蛮冲撞技能 By 一支笔 at:2021-06-30 14:15:23
          SmartObject.m_NoTriggerAttackStruckScript := True;
          TargetCret.m_NoTriggerAttackStruckScript := True;
          SmartObject.m_btDirection := GetNextDirection(SmartObject.m_nCurrX, SmartObject.m_nCurrY, TargetCret.m_nCurrX, TargetCret.m_nCurrY);
          SmartObject.DoMotaebo(SmartObject.m_btDirection, TempMagic.btLevel) // wHitMode := 0;
          // CanAttack := True;
        end
        else if TempMagic.wMagIdx = SKILL_40 { 40 } then
        begin // 双龙斩
          wHitMode := 8;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_42 { 42 } then
        begin
          // 龙影剑法
          wHitMode := 9;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_43 { 43 } then
        begin
          // 雷霆剑法
          wHitMode := 10;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_56 { 56 } then
        begin
          // 逐日剑法
          wHitMode := 15;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 4) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 4);
        end
        else if TempMagic.wMagIdx = SKILL_60 { 60 } then
        begin
          // 破魂斩
          wHitMode := 0;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_66 { 66 } then
        begin
          // 开天斩
          wHitMode := 11; // 重击
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 4) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 4);
        end
        else if TempMagic.wMagIdx = SKILL_100 then
        begin
          // 增加释放追心刺技能 By 一支笔 at:2021-06-30 14:15:23
          SmartObject.m_NoTriggerAttackStruckScript := True;
          TargetCret.m_NoTriggerAttackStruckScript := True;
          SmartObject.m_btDirection := GetNextDirection(SmartObject.m_nCurrX, SmartObject.m_nCurrY, TargetCret.m_nCurrX, TargetCret.m_nCurrY);
          TPlayObject(SmartObject).DoMotaebo100(TargetCret, @TempMagic);
        end
        else if TempMagic.wMagIdx = SKILL_101 then
        begin // 三绝杀
          wHitMode := 16;
          CanAttack := True;
        end
        else if TempMagic.wMagIdx = SKILL_102 then
        begin // 断岳斩
          wHitMode := 17;
          CanAttack := True;
        end
        else if TempMagic.wMagIdx = SKILL_103 then
        begin // 横扫千军
          wHitMode := 18;
          CanAttack := True;
        end
        else if TempMagic.wMagIdx = SKILL_113 then
        begin // 断空斩
          wHitMode := 20;
          CanAttack := True;
        end
        else
        begin
          wHitMode := 0;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end;

        if TargetCret = SmartObject then
          nDir := SmartObject.m_btDirection
        else
          nDir := GetNextDirection(SmartObject.m_nCurrX, SmartObject.m_nCurrY, TargetCret.m_nCurrX, TargetCret.m_nCurrY);

        if CanAttack then
        begin
          SmartObject.m_NoTriggerAttackStruckScript := True;
          TargetCret.m_NoTriggerAttackStruckScript := True;
          SmartObject.AttackDir(nil, wHitMode, nDir, 1, True, @TempMagic);
        end;
      end
      else
      begin
        SmartObject.m_NoTriggerAttackStruckScript := True;
        TargetCret.m_NoTriggerAttackStruckScript := True;

        // 脚本释放技能不检查CD Cursor 2023-07-05 10:36:10
        MagicManager.DoSpell(SmartObject, @TempMagic, TargetCret.m_nCurrX, TargetCret.m_nCurrY, TargetCret, False, 1, True);
      end;
    end
    else
    begin
      // 人形怪加自定义技能 chongchong 2015-10-30
      TempMagic.MagicInfo := Magic;

      TempMagic.MagicAttr := Magic.MagicAttr;
      TempMagic.wMagIdx := Magic.wMagicId;

      TempMagic.btLevel := 0;
      TempMagic.btNewLevel := 0;
      TempMagic.btKey := Integer(boShowAttackAction);
      TempMagic.nTranPoint := 0;
      TempMagic.boUsesItemAdd := False;

      if QuestActionInfo.nParam2 = 0 then
        TempMagic.btLevel := QuestActionInfo.nParam3
      else
        TempMagic.btNewLevel := QuestActionInfo.nParam3;

      SmartObject.m_NoTriggerAttackStruckScript := True;
      TargetCret.m_NoTriggerAttackStruckScript := True;

      // 脚本释放技能不检查CD Cursor 2023-07-05 10:36:10
      MagicManager.DoSpell(SmartObject, @TempMagic, TargetCret.m_nCurrX, TargetCret.m_nCurrY, TargetCret, False, 1, True);
    end;
  end;
end;

