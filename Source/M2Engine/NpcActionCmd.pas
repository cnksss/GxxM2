// 显示、隐藏神佑袋的图标 chongchong 2014-04-17

procedure ActionOfShowGodBless(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
  begin
    SmartObject := TSmartObject(BaseObject);
    if QuestActionInfo.nParam1 <> 0 then
