      if CompareText(sName, sItemName) = 0 then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_GodBlessItems[I].wIndex);
        if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
        begin
          // 注释日志 chongchong 2017-10-09
          AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, SmartObject.m_GodBlessItems[I].MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
        end;

        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(SmartObject).SendDelItem(@SmartObject.m_GodBlessItems[I])
        else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(SmartObject).SendDelItem(@SmartObject.m_GodBlessItems[I]);
        SmartObject.m_GodBlessItems[I].wIndex := 0;

        IsChanged := True;
        Dec(nItemCount);
      end;
    end;
  end;

  if IsChanged then
  begin
    // SmartObject.m_boRecalcAbilitys := True;
    // SmartObject.m_RecalcAbilitysChanges := [racSubAbility, racFeatureChanged];
    if SmartObject.m_nLockUpdateAbil = 0 then
    begin
      SmartObject.RecalcAbilitys();
      SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
      SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
    end;

    SmartObject.FeatureChanged();
  end;
end;

