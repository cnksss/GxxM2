function GetIniFileObject(AIniFilePath: string): TFastIniFile;
begin
  AIniFilePath := UpperCase(AIniFilePath); // TDictionary的Key用字符串时，区分大小写。

  if IniFileCache.TryGetValue(AIniFilePath, Result) then
    Exit;

  if CheckOrCreateIniFile(AIniFilePath) then
  begin
    Result := TFastIniFile.Create(AIniFilePath);
    if not IniFileCache.TryAdd(AIniFilePath, Result) then
      FreeAndNil(Result);
  end
  else
    Result := nil;
end;

procedure CloseIniFileObjects;
var
  tmpValue: TFastIniFile;
begin
  for tmpValue in IniFileCache.values do
    tmpValue.Free;
end;

