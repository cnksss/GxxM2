procedure ActionOfDeleteGamePet(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nIndex: Integer;
  GamePetData: pTGamePetData;
begin
  nIndex := QuestActionInfo.nParam1;
  if (nIndex >= 0) and (nIndex < PlayObject.m_GamePetList.Count) then
  begin
    GamePetData := PlayObject.m_GamePetList.Items[nIndex];

    if (nIndex = PlayObject.m_MyGamePetIndex) then
    begin
      if (PlayObject.m_MyGamePet <> nil) then
      begin
        // 将主人置空 2019-12-06 11:25:57
        PlayObject.m_MyGamePet.m_Master := nil;
        PlayObject.m_MyGamePet.MakeGhost;
        PlayObject.m_MyGamePet := nil;
      end;

      PlayObject.m_MyGamePetIndex := -1;

      PlayObject.m_LastMyGamePetIndex := -1;
      PlayObject.SendCurrentRecalGamePetIndex(PlayObject.m_MyGamePetIndex);

      Dispose(GamePetData);
      PlayObject.m_GamePetList.Delete(nIndex);
      PlayObject.SendDelGamePet(nIndex);

      PlayObject.RecalcAbilitys;
      PlayObject.SendMsg(PlayObject, RM_ABILITY, 0, 0, 0, 0, '');
      PlayObject.SendMsg(PlayObject, RM_SUBABILITY, 0, 0, 0, 0, '');
    end
    else
    begin
      if nIndex < PlayObject.m_MyGamePetIndex then
      begin
        PlayObject.m_MyGamePetIndex := PlayObject.m_MyGamePetIndex - 1;
        PlayObject.m_LastMyGamePetIndex := PlayObject.m_MyGamePetIndex;
        PlayObject.SendCurrentRecalGamePetIndex(PlayObject.m_MyGamePetIndex);
      end;

      Dispose(GamePetData);
      PlayObject.m_GamePetList.Delete(nIndex);
      PlayObject.SendDelGamePet(nIndex);
    end;
  end;
end;

procedure ActionOfGamePetSetAttackOption(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  OptionType: Integer;
  btValue: Byte;
  nTime: Integer;
begin
  OptionType := QuestActionInfo.nParam1;
  btValue := QuestActionInfo.nParam2;
  nTime := QuestActionInfo.nParam3;

  if (OptionType < 0) or (OptionType > 2) or (btValue > 2) or (nTime < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if (PlayObject.m_MyGamePetIndex >= 0) and (PlayObject.m_MyGamePetIndex < PlayObject.m_GamePetList.Count) and (PlayObject.m_MyGamePet <> nil) then
  begin
    case OptionType of
      0:
        begin
          PlayObject.m_MyGamePet.m_boEnabledPetAttack := btValue;
          PlayObject.m_MyGamePet.m_dwEnabledPetAttackTick := MyGetTickCount;
          PlayObject.m_MyGamePet.m_dwEnabledPetAttackTime := nTime * 1000;
        end;
      1:
        begin
          PlayObject.m_MyGamePet.m_boDisableMonAttackPet := btValue;
          PlayObject.m_MyGamePet.m_dwDisableMonAttackPetTick := MyGetTickCount;
          PlayObject.m_MyGamePet.m_dwDisableMonAttackPetTime := nTime * 1000;
        end;
      2:
        begin
          PlayObject.m_MyGamePet.m_boDisableAllAttackPet := btValue;
          PlayObject.m_MyGamePet.m_dwDisableAllAttackPetTick := MyGetTickCount;
          PlayObject.m_MyGamePet.m_dwDisableAllAttackPetTime := nTime * 1000;
        end;
    end;
  end;
end;

// 扩展背包页数
procedure ActionOfExtBagPageCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  OldExtPageCount, PageCount: Integer;
  cMethod: Char;
begin
  if (QuestActionInfo.sParam1 = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  PageCount := QuestActionInfo.nParam2;

  OldExtPageCount := PlayObject.m_btExtBagPageCount;
  case cMethod of
    '=':
      begin
        if (PageCount < 0) or (PageCount > MAX_EXT_BAG_PAGE_COUNT) then
        begin
          Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
          Exit;
        end;
        PlayObject.m_btExtBagPageCount := PageCount;
      end;
    '-':
      begin
        PageCount := PlayObject.m_btExtBagPageCount - PageCount;
        if PageCount < 0 then
          PageCount := 0
        else if PageCount > 4 then
          PageCount := 4;

        PlayObject.m_btExtBagPageCount := PageCount;
      end;
    '+':
      begin
        PageCount := PlayObject.m_btExtBagPageCount + PageCount;

        if PageCount < 0 then
          PageCount := 0
        else if PageCount > MAX_EXT_BAG_PAGE_COUNT then
          PageCount := MAX_EXT_BAG_PAGE_COUNT;

        PlayObject.m_btExtBagPageCount := PageCount;
      end;
  end;

  if OldExtPageCount <> PlayObject.m_btExtBagPageCount then
  begin
    PlayObject.SendDefMessage(SM_EXT_BAG_COUNT_CHANGE, 0, PlayObject.m_btExtBagPageCount, PlayObject.m_btExtBagOpenItemCount, 0, '');
  end;
end;

