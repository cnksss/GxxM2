procedure ActionOfGetSlavePosition(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  tmpSlave: TBaseObject;
  tmpSlaveName, tmpMapName, tmpX, tmpY: string;
  tmpPlayer: TPlayObject;
begin
  tmpSlaveName := QuestActionInfo.sParam1;
  tmpMapName := QuestActionInfo.sRawParam2;
  tmpX := QuestActionInfo.sRawParam3;
  tmpY := QuestActionInfo.sRawParam4;

  if tmpSlaveName.IsEmpty or tmpMapName.IsEmpty or tmpX.IsEmpty or tmpY.IsEmpty then
  begin
    Npc.ScriptActionError(BaseObject, 'GetSlavePosition参数数量不正确！', QuestActionInfo);
    Exit;
  end;

  tmpPlayer := TPlayObject(BaseObject);
  if tmpPlayer.m_SlaveList.Count > 0 then
  begin
    for I := 0 to tmpPlayer.m_SlaveList.Count - 1 do
    begin
      tmpSlave := TBaseObject(tmpPlayer.m_SlaveList[I]);

      if (tmpSlave <> nil) and SameText(tmpSlave.m_sCharName, tmpSlaveName) then
      begin
        if not Npc.SetVarValue(tmpPlayer, tmpMapName, tmpSlave.m_sMapName, 0) then
          Npc.ScriptActionError(tmpPlayer, '', QuestActionInfo);

        if not Npc.SetVarValue(tmpPlayer, tmpX, IntToStr(tmpSlave.m_nCurrX), tmpSlave.m_nCurrX) then
          Npc.ScriptActionError(tmpPlayer, '', QuestActionInfo);

        if not Npc.SetVarValue(tmpPlayer, tmpY, IntToStr(tmpSlave.m_nCurrY), tmpSlave.m_nCurrY) then
          Npc.ScriptActionError(tmpPlayer, '', QuestActionInfo);

        Exit;
      end;
    end;
  end;
  tmpPlayer.SysMsg(Format('您的宝宝并未出战，或宝宝名称“%s”错误！', [tmpSlaveName]), c_Red, t_System);
end;

procedure ActionOfStopExitGuild(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  tmpPlayer: TPlayObject;
begin
  if BaseObject = nil then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  tmpPlayer := TPlayObject(BaseObject);
  if (tmpPlayer.m_MyGuild <> nil) //
    and (tmpPlayer.m_nGuildRankNo > 1) //
    and TGUild(tmpPlayer.m_MyGuild).IsMember(tmpPlayer.m_sCharName) then
    TGUild(tmpPlayer.m_MyGuild).AddExemptedPersonnel(tmpPlayer.m_sCharName);
end;

procedure ActionOfGiveFullBead(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  tmpCmd: pTGameCmd;
  tmpUserItem: pTUserItem;
  tmpItemName: string;
begin
  if (BaseObject = nil) and (not QuestActionInfo.sParam1.IsEmpty) and (QuestActionInfo.nParam2 > 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  tmpItemName := Trim(QuestActionInfo.sParam1);
  New(tmpUserItem);
  UserEngine.CopyToUserItemFromName(tmpItemName, tmpUserItem);
  tmpCmd := AllocMem(SizeOf(TGameCmd));
  tmpCmd.sCmd := '';
  tmpCmd.nPermissionMin := 0;
  tmpCmd.nPermissionMax := 0;
  TPlayObject(BaseObject).m_boFromGmExecute := True;
  CmdMakeItem(TPlayObject(BaseObject), tmpCmd, tmpItemName, QuestActionInfo.nParam2, IntToStr(tmpUserItem.DuraMax), IntToStr(tmpUserItem.DuraMax));
  TPlayObject(BaseObject).m_boFromGmExecute := False;
  Dispose(tmpUserItem);
  FreeMemory(tmpCmd);
end;

procedure ActionOfTakeFullBead(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  tmpCmd: pTGameCmd;
  tmpItemName: string;

  function tmpCheck(AUserItem: pTUserItem): Boolean;
  begin
    Result := AUserItem.Dura = AUserItem.DuraMax
  end;

begin
  if (BaseObject = nil) and (not QuestActionInfo.sParam1.IsEmpty) and (QuestActionInfo.nParam2 > 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  tmpItemName := Trim(QuestActionInfo.sParam1);
  tmpCmd := AllocMem(SizeOf(TGameCmd));
  tmpCmd.sCmd := '';
  tmpCmd.nPermissionMin := 0;
  tmpCmd.nPermissionMax := 0;
  CmdDeleteItem(TPlayObject(BaseObject), tmpCmd, BaseObject.m_sCharName, tmpItemName, QuestActionInfo.nParam2, @tmpCheck);
  FreeMemory(tmpCmd);
end;

procedure ActionOfClearStorageItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, II: Integer;
  tmpPlayer: TPlayObject;
  tmpUserItem: pTUserItem;
  tmpStdItem: pTStdItem;
begin
  if (BaseObject = nil) and (not QuestActionInfo.nParam1 in [1, 2]) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  tmpPlayer := TPlayObject(BaseObject);
  case QuestActionInfo.nParam1 of
    1:
      begin
        for I := Low(tmpPlayer.m_StorageItemList) to High(tmpPlayer.m_StorageItemList) do
        begin
          for II := 0 to tmpPlayer.m_StorageItemList[I].Count - 1 do
          begin
            tmpUserItem := pTUserItem(tmpPlayer.m_StorageItemList[I].Items[II]);
            tmpStdItem := UserEngine.GetStdItem(tmpUserItem.wIndex);

            if tmpStdItem.NeedIdentify = 1 then
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, tmpPlayer, tmpStdItem.Name, tmpUserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));

            Dispose(tmpStdItem);
          end;

          tmpPlayer.m_StorageItemList[I].Clear;
        end;
      end;
    2:
      begin
        for I := 0 to tmpPlayer.m_BigStorageItemList.Count - 1 do
        begin
          tmpUserItem := pTUserItem(tmpPlayer.m_BigStorageItemList.Items[I]);
          tmpStdItem := UserEngine.GetStdItem(tmpUserItem.wIndex);

          if tmpStdItem.NeedIdentify = 1 then
            AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, tmpPlayer, tmpStdItem.Name, tmpUserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));

          Dispose(tmpStdItem);
        end;
        tmpPlayer.m_BigStorageItemList.Clear;
      end;
  end;
end;

