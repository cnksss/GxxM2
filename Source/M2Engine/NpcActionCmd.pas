procedure ActionOfTakeOffItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nItemIdx: Integer;
  sUserItemName: string;
  nWhere: Integer;
  SmartObject: TSmartObject;
  UserItem: pTUserItem;
  TakeOffItem: TUserItem;
  sTakeOffItemName: string;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nWhere := QuestActionInfo.nParam1;

  if (nWhere > U_GODBLESSITEM12) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    if SmartObject.m_UseItems[nWhere].wIndex > 0 then
    begin
      sUserItemName := '';
      if SmartObject.m_UseItems[nWhere].btValue[13] = 1 then
        sUserItemName := SmartObject.m_UseItems[nWhere].Name;
      if sUserItemName = '' then
        sUserItemName := UserEngine.GetStdItemName(SmartObject.m_UseItems[nWhere].wIndex);

      nItemIdx := SmartObject.m_UseItems[nWhere].MakeIndex;

      if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        TPlayObject(BaseObject).ClientTakeOffItemsEx(nWhere, nItemIdx, sUserItemName);
      end
      else if BaseObject.m_btRaceServer = RC_HEROOBJECT then
      begin
        THeroObject(BaseObject).ClientTakeOffItemsEx(nWhere, nItemIdx, sUserItemName);
      end;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    if SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1].wIndex > 0 then
    begin
      New(UserItem);
      UserItem^ := SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
      TakeOffItem := UserItem^;

      if SmartObject.AddItemToBag(UserItem) then
      begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          TPlayObject(SmartObject).SendDelItem(UserItem);
          TPlayObject(SmartObject).SendAddItem(UserItem)
        end
        else
        begin
          THeroObject(SmartObject).SendDelItem(UserItem);
          THeroObject(SmartObject).SendAddItem(UserItem);
        end
      end
      else
      begin
        TPlayObject(SmartObject).SendDelItem(UserItem);

        Dispose(UserItem);
        Exit;
      end;

      if g_FunctionNPC <> nil then
      begin
        if (TakeOffItem.btValue[13] = 1) and (TakeOffItem.Name <> '') then
          sTakeOffItemName := TakeOffItem.Name
        else
          sTakeOffItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);

        SmartObject.m_nCurrentItemMakeIndex := TakeOffItem.MakeIndex;
        SmartObject.m_nCurrentItemPos := nWhere;
        SmartObject.m_sCurrentItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
        SmartObject.m_sCurrentItemNewName := sTakeOffItemName;

        SmartObject.m_PickUpOrDropItem := TakeOffItem;

        g_FunctionNPC.GotoLable(PlayObject, '@TakeOff' + IntToStr(nWhere), False);
        g_FunctionNPC.GotoLable(PlayObject, '@TakeOffEx', False);

        SmartObject.m_PickUpOrDropItem.MakeIndex := 0;
        SmartObject.m_PickUpOrDropItem.wIndex := 0;

        SmartObject.m_nCurrentItemMakeIndex := 0;
        SmartObject.m_nCurrentItemPos := 0;
        SmartObject.m_sCurrentItemName := '';
        SmartObject.m_sCurrentItemNewName := '';
      end;

      SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1].wIndex := 0;
    end;

    // SmartObject.m_boRecalcAbilitys := True;
    // SmartObject.m_RecalcAbilitysChanges := SmartObject.m_RecalcAbilitysChanges + [racSubAbility];
    SmartObject.RecalcAbilitys();
    SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
    SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    if SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1].wIndex > 0 then
    begin
      New(UserItem);
      UserItem^ := SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
      TakeOffItem := UserItem^;

      if SmartObject.AddItemToBag(UserItem) then
      begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          TPlayObject(SmartObject).SendDelItem(UserItem);
          TPlayObject(SmartObject).SendAddItem(UserItem)
        end
        else
        begin
          THeroObject(SmartObject).SendDelItem(UserItem);
          THeroObject(SmartObject).SendAddItem(UserItem);
        end;
      end
      else
      begin
        Dispose(UserItem);
        Exit;
      end;

      if g_FunctionNPC <> nil then
      begin
        if (TakeOffItem.btValue[13] = 1) and (TakeOffItem.Name <> '') then
          sTakeOffItemName := TakeOffItem.Name
        else
          sTakeOffItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);

        SmartObject.m_nCurrentItemMakeIndex := TakeOffItem.MakeIndex;
        SmartObject.m_nCurrentItemPos := nWhere;
        SmartObject.m_sCurrentItemName := UserEngine.GetStdItemName(TakeOffItem.wIndex);
        SmartObject.m_sCurrentItemNewName := sTakeOffItemName;

        SmartObject.m_PickUpOrDropItem := TakeOffItem;

        g_FunctionNPC.GotoLable(PlayObject, '@TakeOff' + IntToStr(nWhere), False);
        g_FunctionNPC.GotoLable(PlayObject, '@TakeOffEx', False);

        SmartObject.m_PickUpOrDropItem.MakeIndex := 0;
        SmartObject.m_PickUpOrDropItem.wIndex := 0;

        SmartObject.m_nCurrentItemMakeIndex := 0;
        SmartObject.m_nCurrentItemPos := 0;
        SmartObject.m_sCurrentItemName := '';
        SmartObject.m_sCurrentItemNewName := '';
      end;

      SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1].wIndex := 0;
    end;

    // SmartObject.m_boRecalcAbilitys := True;
    // SmartObject.m_RecalcAbilitysChanges := SmartObject.m_RecalcAbilitysChanges + [racSubAbility];
    SmartObject.RecalcAbilitys();
    SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
    SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
  end;
end;

procedure ActionOfAutoGotoXY(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nX, nY: Integer;
  Envir: TEnvirnoment;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  nX := QuestActionInfo.nParam2;
  nY := QuestActionInfo.nParam3;
  if (Envir = nil) or (nX < 0) or (nY < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_PEnvir = Envir then
  begin
    if PlayObject.m_boDummyObject then
    begin
      TDummyObject(PlayObject).m_nAutoGotoX := nX;
      TDummyObject(PlayObject).m_nAutoGotoY := nY;
    end
    else
    begin
      PlayObject.SendDefMessage(SM_AUTOGOTOXY, NativeInt(PlayObject), nX, nY, 0, '');
    end;
  end
  else
  begin
    PlayObject.SysMsg(Format('请到[%s]内使用此功能！', [Envir.sMapDesc]), 168, 255, t_Hint);
  end;
end;

