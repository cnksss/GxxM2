        end
        else if TempMagic.wMagIdx = SKILL_43 { 43 } then // 雷霆剑法
        begin
          wHitMode := 10;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_56 { 56 } then // 逐日剑法
        begin
          wHitMode := 15;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 4) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 4);
        end
        else if TempMagic.wMagIdx = SKILL_60 { 60 } then // 破魂斩
        begin
          wHitMode := 0;
          CanAttack := (abs(SmartObject.m_nCurrX - TargetCret.m_nCurrX) <= 1) and (abs(SmartObject.m_nCurrY - TargetCret.m_nCurrY) <= 1);
        end
        else if TempMagic.wMagIdx = SKILL_66 { 66 } then // 开天斩
        begin
