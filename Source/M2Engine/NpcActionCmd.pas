procedure ActionOfScatterMonItems(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMonName: string;
  I, nRace: Integer;
  MonObj: TBaseObject;
  MonInfo: pTMonInfo;
  DropRate1, DropRate2: Integer;
begin
  sMonName := QuestActionInfo.sParam1;

  if (sMonName = '') then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  nRace := -1;
  // nAppr := -1;

  if UserEngine.FindMonster(sMonName, I) then
  begin
    MonInfo := UserEngine.MonsterList.Items[I];
    nRace := MonInfo.btRace;
    // nAppr := MonInfo.wAppr;
  end;

  if nRace = 0 then
    Exit;

  MonObj := UserEngine.CreateBaseObjectByRace(sMonName, nRace, 0, 0);
  if MonObj <> nil then
  begin
    try
      MonObj.m_sMapName := PlayObject.m_sMapName;
      MonObj.m_PEnvir := PlayObject.m_PEnvir;
      MonObj.m_LastHiter := PlayObject;
      MonObj.m_nCurrX := PlayObject.m_nCurrX;
      MonObj.m_nCurrY := PlayObject.m_nCurrY;

      DropRate1 := PlayObject.m_WAbil.NewValue[11];

      if (PlayObject.m_dwKillMonBurstRate > 0) then
        DropRate2 := PlayObject.m_dwKillMonBurstRate
      else
        DropRate2 := 0;

      UserEngine.MonGetRandomItems(PlayObject, MonObj, DropRate1, DropRate2, False);

      if not MonObj.m_boNoItem then
      begin
        if (g_Config.boDropGoldToPlayBag) or PlayObject.m_boSelfAutoDropItemToBag then
        begin
          if PlayObject.IncGold(MonObj.m_nGold) then
            PlayObject.GoldChanged()
          else
            MonObj.ScatterGolds(PlayObject);
        end
        else
          MonObj.ScatterGolds(PlayObject);

        MonObj.ScatterBagItems(PlayObject, PlayObject);
      end;
    finally
      MonObj.Free;
    end;
  end;
end;

