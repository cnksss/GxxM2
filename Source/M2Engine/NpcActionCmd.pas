procedure ActionOfSetNewItemValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere, nValType, nPoint, nOldValue: Integer;
  UserItem: pTUserItem;
  cMethod: Char;
  nBoxItemIndex, nMakeIndex: Integer;
  SmartObject: TSmartObject;
  LockUpdateItemIndex: Integer;
  StdItem: pTStdItem;
  Int64Value: Int64;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  nValType := QuestActionInfo.nParam2;
  nPoint := QuestActionInfo.nParam4;

  if (QuestActionInfo.sParam3 = '') or (nValType < 0) or (nValType > 25) or (nPoint < 0) or ((nPoint > 100) and (not nValType in [1, 7, 8, 10, 22])) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if nPoint > 65535 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam3[1];

  LockUpdateItemIndex := -1;
  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;
      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (StdItem <> nil) and (not (StdItem.StdMode in [91, 92])) then
    begin
      nOldValue := UserItem.btNewValue[nValType];
      case cMethod of
        '+':
          begin
            if nValType in [1, 7, 8, 10, 22] then
            begin
              Int64Value := Int64(UserItem.btNewValue[nValType]) + nPoint;
              UserItem.btNewValue[nValType] := Min(Int64Value, High(UserItem.btNewValue[nValType]))
            end
            else
            begin
              UserItem.btNewValue[nValType] := Min(UserItem.btNewValue[nValType] + nPoint, 100);
            end;
          end;
        '-':
          begin
            UserItem.btNewValue[nValType] := Max(UserItem.btNewValue[nValType] - nPoint, 0);
          end;
        '=':
          begin
            UserItem.btNewValue[nValType] := nPoint;
          end;
      end;

      if (nWhere >= 0) and (nOldValue <> UserItem.btNewValue[nValType]) then
      begin
        // SmartObject.m_boRecalcAbilitys := True;
        // SmartObject.m_RecalcAbilitysChanges := SmartObject.m_RecalcAbilitysChanges + [racSubAbility];
        if SmartObject.m_nLockUpdateAbil = 0 then
        begin
          SmartObject.RecalcAbilitys;
          SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
          SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
        end;

        if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
        begin
          if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
          begin
            if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
              TPlayObject(SmartObject).SendUpdateItemNewValue(nBoxItemIndex, UserItem.MakeIndex, True, nValType, UserItem.btNewValue[nValType])
            else
              TPlayObject(SmartObject).SendUpdateItemNewValue(nWhere, UserItem.MakeIndex, False, nValType, UserItem.btNewValue[nValType]);
          end
          else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
            THeroObject(SmartObject).SendUpdateItemNewValue(nWhere, UserItem.MakeIndex, nValType, UserItem.btNewValue[nValType]);
        end;
      end;
    end;
  end;
end;

procedure ActionOfSetNewItemValueEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nWhere, nValType, nPoint, nOldValue, nTime: Integer;
  UserItem: pTUserItem;
  cMethod: Char;
  SmartObject: TSmartObject;
begin
  if BaseObject = nil then
    Exit;

  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nWhere := StrToIntDef(QuestActionInfo.sParam1, -1);
  nValType := QuestActionInfo.nParam2;
  nPoint := QuestActionInfo.nParam4;
  nTime := QuestActionInfo.nParam5;

  if (QuestActionInfo.sParam3 = '') or (nValType < 0) or (nValType > 25) or (nWhere < 0) or (nWhere > U_GODBLESSITEM12) or (nPoint < 0) or (nPoint > 100) or (nTime <= 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    Exit;
  end;

  cMethod := QuestActionInfo.sParam3[1];

  nOldValue := SmartObject.m_btNPCAddNewValue[nWhere][nValType];
  case cMethod of
    '+':
      begin
        SmartObject.m_btNPCAddNewValue[nWhere][nValType] := Min(SmartObject.m_btNPCAddNewValue[nWhere][nValType] + nPoint, 100);
      end;
    '-':
      begin
        SmartObject.m_btNPCAddNewValue[nWhere][nValType] := Max(SmartObject.m_btNPCAddNewValue[nWhere][nValType] - nPoint, 0);
      end;
    '=':
      begin
        SmartObject.m_btNPCAddNewValue[nWhere][nValType] := nPoint;
      end;
  end;
  SmartObject.m_dwNPCAddNewMakeIndex[nWhere] := UserItem.MakeIndex;
  SmartObject.m_dwNPCAddNewTick[nWhere][nValType] := MyGetTickCount + nTime * 1000;

  if nOldValue <> SmartObject.m_btNPCAddNewValue[nWhere][nValType] then
  begin
    // SmartObject.m_boRecalcAbilitys := True;
    if SmartObject.m_nLockUpdateAbil = 0 then
      SmartObject.RecalcAbilitys;
  end;
end;

