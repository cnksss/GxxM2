procedure ActionOfLoopGoto(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nMax: Integer;
begin
  if QuestActionInfo.nParam2 <= 0 then
    nMax := 1
  else
    nMax := QuestActionInfo.nParam2;

  PlayObject.m_nScriptGotoCount := 0;
  PlayObject.m_boBreakLoopGoto := False;

  for I := 0 to nMax - 1 do
  begin
    {
      #ACT
      mov N1 0
      mov N2 1
      Loopgoto @运算 100
      sendmsg 6 1加到100的结果为：<$STR(N1)>

      [@运算]
      #ACT
      Inc <$STR(N1)> <$STR(N2)>
      Inc N2 1
      #CALL [\\运算测试.txt] @运算测试
    }
    // 修正上面示例加了 #call 后，会显示死循环 chongchong 2017-09-16
    PlayObject.m_nScriptGotoCount := 0;
    PlayObject.m_nOneLabelGotoCount := 0;

    if not JmpToLable(Npc, PlayObject, QuestActionInfo.sParam1, nMax) then
    begin
      MainOutMessage('[脚本死循环] NPC:' + Npc.m_sCharName + ' 位置:' + Npc.m_sMapName + '(' + IntToStr(Npc.m_nCurrX) + ':' + IntToStr(Npc.m_nCurrY) + ')' + ' 命令:GOTO ' + QuestActionInfo.sParam1);
      boBreak := True;
    end
    else
    begin
      if PlayObject.m_boBreakLoopGoto then
      begin
        Break;
      end;
    end;
  end;
end;

