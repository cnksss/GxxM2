procedure ActionOfGameGold(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nGameGold: Int64;
  nOldGameGold: LongWord;
  cMethod: Char;
begin
  nOldGameGold := PlayObject.m_nGameGold;
  nGameGold := StrToInt64Def(QuestActionInfo.sParam2, 0);
  if nGameGold > High(LongWord) then
    nGameGold := High(LongWord);

  if (QuestActionInfo.sParam1 = '') or (nGameGold < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if (nGameGold >= 0) then
        begin
          PlayObject.m_nGameGold := nGameGold;
        end;
      end;
    '-':
      begin
        nGameGold := Max(0, PlayObject.m_nGameGold - nGameGold);
        PlayObject.m_nGameGold := nGameGold;
      end;
    '+':
      begin
        nGameGold := Max(0, PlayObject.m_nGameGold + nGameGold);
        if nGameGold > High(LongWord) then
          nGameGold := High(LongWord);
        PlayObject.m_nGameGold := nGameGold;
      end;
  end;

  if nOldGameGold <> PlayObject.m_nGameGold then
  begin
    PlayObject.GameGoldChanged;

    if g_boGameLogGameGold then
    begin
      AddGameDataLog(LOG_GameGoldChange, LOG_ActionNone, PlayObject, g_Config.sGameGoldName, 0, Npc.m_sCharName, PlayObject.m_nGameGold, nOldGameGold, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
    end;
  end;
end;

