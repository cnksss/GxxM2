procedure ActionOfSetMobileNumber(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMobileNumber: string;
begin
  if g_nKey_MobileSMS <> 0 then
  begin
    sMobileNumber := QuestActionInfo.sParam1;
    if (Length(sMobileNumber) < 11) or (Length(sMobileNumber) >= 16) then
    begin
      PlayObject.m_nScriptGotoCount := 0;
      Npc.GotoLable(PlayObject, '@MobileNumberError', False);
    end;

    if (QuestActionInfo.nParam2 = 0) and ((not IsStringNumber(sMobileNumber)) or (Length(sMobileNumber) <> 11) or (sMobileNumber[1] <> '1')) then
    begin
      PlayObject.m_nScriptGotoCount := 0;
      Npc.GotoLable(PlayObject, '@MobileNumberError', False);
    end
    else
    begin
      PlayObject.m_sMobileNumber := sMobileNumber;
