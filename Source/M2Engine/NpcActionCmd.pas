procedure ActionOfGetStringPos(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  LoadList: TStringList;
  sListFileName: string;
  sValue: string;
begin
  sValue := QuestActionInfo.sParam2;

  if QuestActionInfo.nParam3 = 0 then
    sListFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    sListFileName := QuestActionInfo.sParam1;

  PlayObject.m_nInteger[0] := 9999999;
  if FileExists(sListFileName) then
  begin

    LoadList := TStringList.Create;
    try
      LoadList.LoadFromFile(sListFileName);
    except
      MainOutMessage('loading fail.... => ' + sListFileName);
    end;

    for I := 0 to LoadList.Count - 1 do
    begin
      if CompareText(LoadList.Strings[I], sValue) = 0 then
      begin
        PlayObject.m_nInteger[0] := I;
        Break;
      end;
    end;

    LoadList.Free;
  end
  else
  begin
    MainOutMessage('file not found => ' + sListFileName);
  end;
end;

procedure ActionOfChangeItemName(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nWhere: Integer;
  sItemName: string;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  nBoxItemIndex, nMakeIndex: Integer;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  sItemName := QuestActionInfo.sParam2;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems)))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    UserItem := @SmartObject.m_UseItems[nWhere];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你首饰盒中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    if (UserItem.wIndex <= 0) { or (StdItem = nil) } then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你神佑袋中没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else
  begin
    if BaseObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    // 91类宠物蛋不允许改名 chongchong 2016-05-20
    if (StdItem <> nil) and (not (StdItem.StdMode in [91])) then
    begin
      UserItem.Name := sItemName;
      UserItem.btValue[13] := 1;

      if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
      begin
        if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
          TPlayObject(SmartObject).SendUpdateItemName(nBoxItemIndex, UserItem.MakeIndex, True, sItemName)
        else
          TPlayObject(SmartObject).SendUpdateItemName(nWhere, UserItem.MakeIndex, False, sItemName)
      end
      else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
        THeroObject(SmartObject).SendUpdateItemName(nWhere, UserItem.MakeIndex, sItemName);
    end;
  end;
end;

procedure ActionOfThroughHum(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nMode, nTime: Integer;
begin
  nMode := StrToIntDef(QuestActionInfo.sParam1, -2);
  nTime := QuestActionInfo.nParam2;

  if (nMode < -1) or (nMode > 2) or ((nMode <> -1) and (nTime < 0)) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
  case nMode of
    -1:
      begin
        PlayObject.m_boRUNHUMAN := False; // 可以穿人
        PlayObject.m_boRUNMON := False; // 可以穿怪
        PlayObject.m_dwRUNHUMANTick := MyGetTickCount(); // 可以穿人
        PlayObject.m_dwRUNMONTick := MyGetTickCount(); // 可以穿怪
        PlayObject.m_dwRUNHUMANTime := 0; // 可以穿人
        PlayObject.m_dwRUNMONTime := 0; // 可以穿怪
        PlayObject.SendMapCanRun;
      end;
    0:
      begin
        PlayObject.m_boRUNHUMAN := True; // 可以穿人
        PlayObject.m_boRUNMON := True; // 可以穿怪
        PlayObject.m_dwRUNHUMANTick := MyGetTickCount(); // 可以穿人
        PlayObject.m_dwRUNMONTick := MyGetTickCount(); // 可以穿怪
        PlayObject.m_dwRUNHUMANTime := MyGetTickCount + LongWord(nTime) * 1000; // 可以穿人
        PlayObject.m_dwRUNMONTime := nTime * 1000; // 可以穿怪
        PlayObject.SendMapCanRun;
      end;
    1:
      begin
        PlayObject.m_boRUNMON := True; // 可以穿怪
        PlayObject.m_dwRUNMONTick := MyGetTickCount(); // 可以穿怪
        PlayObject.m_dwRUNMONTime := nTime * 1000; // 可以穿怪
        PlayObject.SendMapCanRun;
      end;
    2:
      begin
        PlayObject.m_boRUNHUMAN := True; // 可以穿人
        PlayObject.m_dwRUNHUMANTick := MyGetTickCount(); // 可以穿人
        PlayObject.m_dwRUNHUMANTime := nTime * 1000; // 可以穿人
        PlayObject.SendMapCanRun;
      end;
  end;
end;

