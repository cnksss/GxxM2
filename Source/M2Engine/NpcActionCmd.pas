procedure ActionOfChangeNGPoint(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nNGValue: Integer;
  nOldExp: LongWord;
  cMethod: Char;
  IsPercentage: Boolean;
  SmartObject: TSmartObject;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    SmartObject := TSmartObject(BaseObject);
    if SmartObject.m_boTrainingNG then
    begin
      IsPercentage := QuestActionInfo.sParam3 = '%';

      nNGValue := QuestActionInfo.nParam2;

      if IsPercentage then
        nNGValue := Round(SmartObject.m_AbilNG.MaxNH / 100 * nNGValue);

      if (QuestActionInfo.sParam1 = '') or (nNGValue < 0) then
      begin
        Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
        Exit;
      end;

      nOldExp := SmartObject.m_AbilNG.NH;
      cMethod := QuestActionInfo.sParam1[1];
      case cMethod of
        '=':
          begin
            if nNGValue >= 0 then
            begin
              SmartObject.m_AbilNG.NH := Min(nNGValue, SmartObject.m_AbilNG.MaxNH);
            end;

            if nOldExp <> SmartObject.m_AbilNG.NH then
            begin
              SmartObject.SendMsg(SmartObject, RM_ABILITYNG, 0, 0, 0, 0, ''); // 内功属性
            end;
          end;
        '-':
          begin
            if SmartObject.m_AbilNG.NH > LongWord(nNGValue) then
            begin
              Dec(SmartObject.m_AbilNG.NH, LongWord(nNGValue));
            end
            else
            begin
              SmartObject.m_AbilNG.NH := 0;
            end;
            if nOldExp <> SmartObject.m_AbilNG.NH then
            begin
              SmartObject.SendMsg(SmartObject, RM_ABILITYNG, 0, 0, 0, 0, ''); // 内功属性
            end;
          end;

        '+':
          begin
            SmartObject.m_AbilNG.NH := Min(SmartObject.m_AbilNG.NH + LongWord(nNGValue), SmartObject.m_AbilNG.MaxNH);

            if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
            begin
              SmartObject.SendMsg(SmartObject, RM_ABILITYNG, 0, 0, 0, 0, '');
              // 内功属性
            end;
          end;
      end;
    end;
  end;
end;

procedure ActionOfChangeHeroLevel(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  boChgOK: Boolean;
  nLevel: Int64;
  nOldLevel: LongWord;
  cMethod: Char;
  HeroObject: TBaseObject;
begin
  if PlayObject.m_MyHero <> nil then
  begin
    HeroObject := PlayObject.m_MyHero;
    boChgOK := False;
    nOldLevel := HeroObject.m_Abil.Level;
    nLevel := StrToInt64Def(QuestActionInfo.sParam2, 0);
    if nLevel > High(LongWord) then
      nLevel := High(LongWord);

    if (QuestActionInfo.sParam1 = '') or (nLevel < 0) then
    begin
      Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
      Exit;
    end;

    cMethod := QuestActionInfo.sParam1[1];
    case cMethod of
      '=':
        begin
          if g_Config.btMaxLevel = 0 then
            nLevel := Min(nLevel, MAXLEVEL)
          else if g_Config.btMaxLevel = 1 then
            nLevel := Min(nLevel, High(Integer));

          HeroObject.m_Abil.Level := nLevel;
          boChgOK := True;
        end;
      '-':
        begin
          nLevel := HeroObject.m_Abil.Level - nLevel;
          if nLevel < 0 then
            nLevel := 0;

          if g_Config.btMaxLevel = 0 then
            nLevel := Min(nLevel, MAXLEVEL)
          else if g_Config.btMaxLevel = 1 then
            nLevel := Min(nLevel, High(Integer));

          HeroObject.m_Abil.Level := nLevel;
          boChgOK := True;
        end;
      '+':
        begin
          nLevel := HeroObject.m_Abil.Level + nLevel;

          if g_Config.btMaxLevel = 0 then
            nLevel := Min(nLevel, MAXLEVEL)
          else if g_Config.btMaxLevel = 1 then
            nLevel := Min(nLevel, High(Integer))
          else
            nLevel := Min(nLevel, High(LongWord));

          HeroObject.m_Abil.Level := nLevel;
          boChgOK := True;
        end;
    end;
    if boChgOK then
      HeroObject.HasLevelUp(nOldLevel);
  end;
end;

procedure ActionOfChangeHeroPKPoint(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nPKPOINT: Integer;
  nPoint: Integer;
  nOldPKLevel: Integer;
  cMethod: Char;
  HeroObject: THeroObject;
begin
  if PlayObject.m_MyHero <> nil then
  begin
    HeroObject := THeroObject(PlayObject.m_MyHero);
    nOldPKLevel := HeroObject.PKLevel;
    nPKPOINT := QuestActionInfo.nParam2;

    if (QuestActionInfo.sParam1 = '') or (nPKPOINT < 0) then
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;

    cMethod := QuestActionInfo.sParam1[1];
    case cMethod of
      '=':
        begin
          if (nPKPOINT >= 0) then
          begin
            HeroObject.m_nPkPoint := nPKPOINT;
          end;
        end;
      '-':
        begin
          nPoint := Max(0, HeroObject.m_nPkPoint - nPKPOINT);
          HeroObject.m_nPkPoint := nPoint;
        end;
      '+':
        begin
          nPoint := Max(0, HeroObject.m_nPkPoint + nPKPOINT);
          HeroObject.m_nPkPoint := nPoint;
        end;
    end;
    if nOldPKLevel <> HeroObject.PKLevel then
      HeroObject.RefNameColor;
  end;
end;

