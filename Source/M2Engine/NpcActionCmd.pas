procedure ActionOfPKPoint(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
  begin
    if QuestActionInfo.nParam1 = 0 then
    begin
      TSmartObject(BaseObject).m_nPkPoint := 0;
    end
    else if QuestActionInfo.nParam1 < 0 then
    begin
      if (TSmartObject(BaseObject).m_nPkPoint + QuestActionInfo.nParam1) >= 0 then
        Inc(TSmartObject(BaseObject).m_nPkPoint, QuestActionInfo.nParam1)
      else
        TSmartObject(BaseObject).m_nPkPoint := 0;
    end
    else
    begin
      if (TSmartObject(BaseObject).m_nPkPoint + QuestActionInfo.nParam1) > 10000 then
        TSmartObject(BaseObject).m_nPkPoint := 10000
      else
        Inc(TSmartObject(BaseObject).m_nPkPoint, QuestActionInfo.nParam1);
    end;
    BaseObject.RefNameColor();
  end;
end;

// RECALLMOB 怪物名称 等级 叛变时间 变色(0,1) 固定颜色(1 - 7)
// 变色为0 时固定颜色才起作用

procedure ActionOfReCallMob(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  mon: TBaseObject;
  sMonName: string;
  nExpLevel: Integer;
  dwRoyaltySec: Integer;
  BBType: TBBType;
  I, RecallCount: Integer;
  boAutoChangeColor: Boolean;
  nBodyColor: Byte;
begin
  sMonName := QuestActionInfo.sParam1;
  nExpLevel := QuestActionInfo.nParam2;
  dwRoyaltySec := QuestActionInfo.nParam3;
  boAutoChangeColor := QuestActionInfo.nParam4 = 1;
  nBodyColor := QuestActionInfo.nParam5;

  if (not (nBodyColor in [0..255])) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  case QuestActionInfo.nParam6 of
    1:
      BBType := bb_BoneFamm;
    2:
      BBType := bb_Dogz;
    3:
      BBType := bb_BigDogz;
    4:
      BBType := bb_MonthSpirit;
  else
    BBType := bb_Other;
  end;

  RecallCount := QuestActionInfo.nParam7;

  if nExpLevel <= 0 then
    nExpLevel := 0;

  if RecallCount <= 1 then
    RecallCount := 1;

  for I := 1 to RecallCount do
  begin
    if dwRoyaltySec < 1 then
    begin
      mon := BaseObject.MakeSlave(sMonName, 3, nExpLevel, 100, 10 * 24 * 60 * 60, BBType, 0, not g_Config.boBBAttrPlusAddOnlyMagic);
    end
    else
    begin
      mon := BaseObject.MakeSlave(sMonName, 3, nExpLevel, 100, LongWord(dwRoyaltySec) * 60, BBType, 0, not g_Config.boBBAttrPlusAddOnlyMagic)
    end;

    if mon <> nil then
    begin
      mon.m_boAutoChangeColor := boAutoChangeColor;
      mon.m_nAutoChangeIdx := 0;
      mon.m_dwChangeBodyColorTime := 0;
      mon.m_dwStartChangeBodyColor := MyGetTickCount;

      if not mon.m_boAutoChangeColor then
      begin
        mon.m_btBodyColor := nBodyColor;
      end;
    end;
  end;
end;

