procedure ActionOfGameDiamond(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nPoint: Int64;
  nOldPoint: LongWord;
  cMethod: Char;
begin
  nPoint := StrToInt64Def(QuestActionInfo.sParam2, 0);
  if nPoint > High(LongWord) then
    nPoint := High(LongWord);

  if (QuestActionInfo.sParam1 = '') or (nPoint < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  nOldPoint := PlayObject.m_nGameDiamond;
  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        PlayObject.m_nGameDiamond := nPoint;
      end;
    '-':
      begin
        if PlayObject.m_nGameDiamond >= nPoint then
          Dec(PlayObject.m_nGameDiamond, nPoint)
        else
          PlayObject.m_nGameDiamond := 0;
      end;
    '+':
      begin
        nPoint := Int64(PlayObject.m_nGameDiamond) + nPoint;
        if nPoint > High(LongWord) then
          nPoint := High(LongWord);
        PlayObject.m_nGameDiamond := nPoint;
      end;
  end;
  if nOldPoint <> PlayObject.m_nGameDiamond then
  begin
    PlayObject.NewGamePointChanged;
    if g_boGameLogGameGold then
    begin
      AddGameDataLog(LOG_GameDiamondChange, LOG_ActionNone, PlayObject, g_Config.sGameDiamondName, 0, Npc.m_sCharName, PlayObject.m_nGameDiamond, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
    end;
  end;
end;

