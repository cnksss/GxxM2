procedure ActionOfAddTextListEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  LoadList: TStringList;
  sListFileName: string;
  I, LineIndex: Integer;
  IsOK: Boolean;
  Path: string;
begin
  LineIndex := QuestActionInfo.nParam3;
  if (LineIndex < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.nParam4 = 0 then
    sListFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1
  else
    sListFileName := QuestActionInfo.sParam1;

  LoadList := TStringList.Create;
  try
    if FileExists(sListFileName) then
    begin
      try
        LoadList.LoadFromFile(sListFileName);
      except
        MainOutMessage('loading fail.... => ' + sListFileName);
      end;
    end;

    while LoadList.Count < LineIndex do
      LoadList.Add('');

    // 修复AddTextListEx命令错误 piaoyun 2013-07-27
    // LoadList.Insert(QuestActionInfo.nParam2, QuestActionInfo.sParam1);
    LoadList.Insert(LineIndex, QuestActionInfo.sParam2);

    IsOK := False;
    for I := 1 to SAVE_RETRY_COUNT do
    begin
      try
        Path := ExtractFilePath(sListFileName);
        if not DirectoryExists(Path) then
        begin
          ForceDirectories(Path);
        end;

        LoadList.SaveToFile(sListFileName);
        IsOK := True;
        Break;
      except
        // Sleep(SAVE_SLEEP_TIME);
      end;
    end;

    if not IsOK then
    begin
      MainOutMessage(Format('Save fail; [%s; %s]', [QuestActionInfo.sCmd, sListFileName]));
    end;
  finally
    LoadList.Free;
  end;
end;

procedure ActionOfMoveMonToPos(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nX, nY, nNewX, nNewY: Integer;
  sMonName: string;
  sMapName: string;
  AObject: TBaseObject;
  Envir: TEnvirnoment;
  BaseObjectList: TList;
  nOldX: Integer;
  nOldY: Integer;
begin
  sMonName := QuestActionInfo.sParam1;
  sMapName := QuestActionInfo.sParam2;

  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat2) and (QuestActionInfo.VarInfo2.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam2);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam2);

  nX := QuestActionInfo.nParam3;
  nY := QuestActionInfo.nParam4;

  nNewX := QuestActionInfo.nParam5;
  nNewY := QuestActionInfo.nParam6;

  if (Envir = nil) or (sMonName = '') or (nX < 0) or (nY < 0) or (nNewX < 0) or (nNewY < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if not Envir.CanWalk(nNewX, nNewY, True) then
  begin
    Exit;
  end;

  BaseObjectList := TList.Create;
  Envir.GetMovingObject(nX, nY, True, BaseObjectList);
  for I := 0 to BaseObjectList.Count - 1 do
  begin
    AObject := TBaseObject(BaseObjectList.Items[I]);
    if CompareText(AObject.m_sCharName, sMonName) = 0 then
    begin
      nOldX := AObject.m_nCurrX;
      nOldY := AObject.m_nCurrY;
      AObject.DisappearA();
      AObject.ClearObject;
      AObject.m_nCurrX := nNewX;
      AObject.m_nCurrY := nNewY;

      if AObject.AddToMap() then
      begin
        AObject.m_dwMapMoveTick := MyGetTickCount();
        AObject.m_bo316 := True;
        AObject.InitSpeed;

        AObject.OnSpaceMove;
      end
      else
      begin
        AObject.m_nCurrX := nOldX;
        AObject.m_nCurrY := nOldY;
        AObject.AddToMap;
        // AObject.m_PEnvir.AddToMap(AObject.m_nCurrX, AObject.m_nCurrY, AObject);
      end;
    end;
  end;
  BaseObjectList.Free;
end;

