procedure ActionOfUseBonusPoint(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nPosition, nCount: Integer;
  cMethod: Char;
begin
  nPosition := QuestActionInfo.nParam1;
  nCount := QuestActionInfo.nParam3;
  if (QuestActionInfo.sParam2 = '') or (nPosition < 0) or (nCount < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  cMethod := QuestActionInfo.sParam2[1];
  case cMethod of
    '+':
      begin
        case nPosition of
          1:
            Inc(PlayObject.m_BonusAbil.DC, nCount);
          2:
            Inc(PlayObject.m_BonusAbil.MC, nCount);
          3:
            Inc(PlayObject.m_BonusAbil.SC, nCount);
          4:
            Inc(PlayObject.m_BonusAbil.AC, nCount);
          5:
            Inc(PlayObject.m_BonusAbil.MAC, nCount);
          6:
            Inc(PlayObject.m_BonusAbil.HP, nCount);
          7:
            Inc(PlayObject.m_BonusAbil.MP, nCount);
          8:
            Inc(PlayObject.m_BonusAbil.Hit, nCount);
          9:
            Inc(PlayObject.m_BonusAbil.Speed, nCount);
        end;
      end;
    '-':
      begin
        case nPosition of
          1:
            begin
              if PlayObject.m_BonusAbil.DC >= nCount then
                Dec(PlayObject.m_BonusAbil.DC, nCount)
              else
                PlayObject.m_BonusAbil.DC := 0;
            end;
          2:
            begin
              if PlayObject.m_BonusAbil.MC >= nCount then
                Dec(PlayObject.m_BonusAbil.MC, nCount)
              else
                PlayObject.m_BonusAbil.MC := 0;
            end;
          3:
            begin
              if PlayObject.m_BonusAbil.SC >= nCount then
                Dec(PlayObject.m_BonusAbil.SC, nCount)
              else
                PlayObject.m_BonusAbil.SC := 0;
            end;
          4:
            begin
              if PlayObject.m_BonusAbil.AC >= nCount then
                Dec(PlayObject.m_BonusAbil.AC, nCount)
              else
                PlayObject.m_BonusAbil.AC := 0;
            end;
          5:
            begin
              if PlayObject.m_BonusAbil.MAC >= nCount then
                Dec(PlayObject.m_BonusAbil.MAC, nCount)
              else
                PlayObject.m_BonusAbil.MAC := 0;
            end;
          6:
            begin
              if PlayObject.m_BonusAbil.HP >= nCount then
                Dec(PlayObject.m_BonusAbil.HP, nCount)
              else
                PlayObject.m_BonusAbil.HP := 0;
            end;
          7:
            begin
              if PlayObject.m_BonusAbil.MP >= nCount then
                Dec(PlayObject.m_BonusAbil.MP, nCount)
              else
                PlayObject.m_BonusAbil.MP := 0;
            end;
          8:
            begin
              if PlayObject.m_BonusAbil.Hit >= nCount then
                Dec(PlayObject.m_BonusAbil.Hit, nCount)
              else
                PlayObject.m_BonusAbil.Hit := 0;
            end;
          9:
            begin
              if PlayObject.m_BonusAbil.Speed >= nCount then
                Dec(PlayObject.m_BonusAbil.Speed, nCount)
              else
                PlayObject.m_BonusAbil.Speed := 0;
            end;
        end;
      end;
    '=':
      begin
        case nPosition of
          1:
            PlayObject.m_BonusAbil.DC := nCount;
          2:
            PlayObject.m_BonusAbil.MC := nCount;
          3:
            PlayObject.m_BonusAbil.SC := nCount;
          4:
            PlayObject.m_BonusAbil.AC := nCount;
          5:
            PlayObject.m_BonusAbil.MAC := nCount;
          6:
            PlayObject.m_BonusAbil.HP := nCount;
          7:
            PlayObject.m_BonusAbil.MP := nCount;
          8:
            PlayObject.m_BonusAbil.Hit := nCount;
          9:
            PlayObject.m_BonusAbil.Speed := nCount;
        end;
      end;
  end;

  // PlayObject.m_boRecalcAbilitys := True;
  // PlayObject.m_RecalcAbilitysChanges := PlayObject.m_RecalcAbilitysChanges + [racSubAbility];
  if PlayObject.m_nLockUpdateAbil = 0 then
  begin
    PlayObject.RecalcAbilitys();
    PlayObject.SendMsg(PlayObject, RM_ABILITY, 0, 0, 0, 0, '');
    PlayObject.SendMsg(PlayObject, RM_SUBABILITY, 0, 0, 0, 0, '');
  end;
end;

procedure ActionOfSetScTimer(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  nIndex: Integer;
  nTime: Integer;
  TimeLabel: pTTimeLabel;
begin
  nIndex := QuestActionInfo.nParam1;
  nTime := QuestActionInfo.nParam2;

  // 优化假人CPU占用 chongchong 2013-11-26
  if nTime = 0 then
    nTime := 1;

  if (nIndex in [0..255]) and (nTime >= 0) then
  begin
    for I := 0 to PlayObject.m_TimeLabelList.Count - 1 do
    begin
      TimeLabel := PlayObject.m_TimeLabelList.Items[I];
      if (TimeLabel.nType = 2) and (not TimeLabel.boDelete) and (TimeLabel.nIndex = nIndex) then
      begin
        TimeLabel.dwTime := nTime * 1000;
        TimeLabel.dwTick := MyGetTickCount;
        Exit;
      end;
    end;

    New(TimeLabel);
    TimeLabel.boDelete := False;
    TimeLabel.nType := 2;
    TimeLabel.nIndex := nIndex;
    TimeLabel.dwTick := MyGetTickCount;
    TimeLabel.sLabel := '@OnTimer' + IntToStr(nIndex);
    TimeLabel.dwTime := nTime * 1000;
    TimeLabel.boChangeMapDelete := False;
    TimeLabel.Npc := g_ManageNPC;
    TimeLabel.Envir := PlayObject.m_PEnvir;
    // SetTimer增加启动次数 chongchong 2014-08-12
    TimeLabel.nCount := QuestActionInfo.nParam3;
    if TimeLabel.nCount <= 0 then
      TimeLabel.nCount := -1;
    PlayObject.m_TimeLabelList.Add(TimeLabel);
  end
  else
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

procedure ActionOfKillScTimer(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  nIndex: Integer;
  TimeLabel: pTTimeLabel;
begin
  if SameText(QuestActionInfo.sParam1, 'all') then
    nIndex := -1
  else
    nIndex := QuestActionInfo.nParam1;

  if (nIndex in [0..255]) or (nIndex = -1) then
  begin
    for I := 0 to PlayObject.m_TimeLabelList.Count - 1 do
    begin
      TimeLabel := PlayObject.m_TimeLabelList.Items[I];
      if (TimeLabel.nType = 2) and (not TimeLabel.boDelete) and ((TimeLabel.nIndex = nIndex) or (nIndex = -1)) then
      begin
        TimeLabel.boDelete := True;
        Exit;
      end;
    end;
  end
  else
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

procedure ActionOfDelayGoto(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sLabel: string;
  nTime: Integer;
  TimeLabel: pTTimeLabel;
begin
  if PlayObject.m_TimeLabelList.Count < 600 then
  begin
    nTime := QuestActionInfo.nParam1;
    sLabel := QuestActionInfo.sParam2;
    if (nTime > 0) and (sLabel <> '') then
    begin
      New(TimeLabel);
      TimeLabel.boDelete := False;
      TimeLabel.nType := 0;
      TimeLabel.sLabel := sLabel;
      TimeLabel.dwTick := MyGetTickCount;
      TimeLabel.dwTime := MyGetTickCount + LongWord(nTime);
      TimeLabel.boChangeMapDelete := not ((QuestActionInfo.sParam3 = '') or (QuestActionInfo.sParam3 = '0'));
      TimeLabel.Npc := Npc;
      TimeLabel.Envir := PlayObject.m_PEnvir;

      // 修正DELAYGOTO后，NPC标签不可再点击 chongchong 2016-07-28
      // Npc.AddSelectLable(sLabel);
      // m_NoUserSelectList.Add(sLabel);
      PlayObject.m_TimeLabelList.Add(TimeLabel);

      {
        if Length(sLabel) > 0 then
        begin
        Npc.AddSelectLable(sLabel);
        end;
      }
    end
    else
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfSendMoveMsg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMsg: string;
  I, II: Integer;
  nRange: Integer;
  nFColor, nBColor, nY, nCount: Integer;
  nFontSize, nMarqueeTime: Integer;
  AObject: TPlayObject;
  GuildRank: pTGuildRank;
begin
  nFColor := QuestActionInfo.nParam2;
  nBColor := QuestActionInfo.nParam3;
  nY := QuestActionInfo.nParam4;
  nCount := QuestActionInfo.nParam5;
  if (nFColor < 0) or (nFColor > 255) or (nBColor < 0) or (nBColor > 255) or (nY < 0) or (nCount < 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  sMsg := QuestActionInfo.sParam6;
  nFontSize := QuestActionInfo.nParam7;
  nMarqueeTime := QuestActionInfo.nParam8;
  nRange := QuestActionInfo.nParam9;

  if (nFontSize < 9) then
    nFontSize := 10
  else if (nFontSize > 20) then
    nFontSize := 20;

  if nMarqueeTime <= 0 then
  begin
    nMarqueeTime := 50;
  end;

  sMsg := AnsiReplaceText(sMsg, '%s', PlayObject.m_sCharName);
  sMsg := AnsiReplaceText(sMsg, '%x', IntToStr(PlayObject.m_nCurrX));
  sMsg := AnsiReplaceText(sMsg, '%y', IntToStr(PlayObject.m_nCurrY));
  if PlayObject.m_PEnvir <> nil then
    sMsg := AnsiReplaceText(sMsg, '%m', PlayObject.m_PEnvir.sMapDesc)
  else
    sMsg := AnsiReplaceText(sMsg, '%m', '????');
  sMsg := AnsiReplaceText(sMsg, '%d', Npc.m_sCharName);
  case QuestActionInfo.nParam1 of
    0:
      UserEngine.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime);
    1:
      PlayObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime);
    2:
      begin
        if (PlayObject.m_GroupOwner <> nil) and (PlayObject.m_GroupOwner.m_GroupMembers <> nil) then
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            PlayObject.m_GroupOwner.m_GroupMembers.LockR(13);
          try
{$IFEND}
            for I := 0 to PlayObject.m_GroupOwner.m_GroupMembers.Count - 1 do
            begin
              AObject := TPlayObject(PlayObject.m_GroupOwner.m_GroupMembers.Objects[I]);
              if (AObject <> nil) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
              begin
                if nRange = 0 then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime)
                else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime);
              end;
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              PlayObject.m_GroupOwner.m_GroupMembers.UnLockR;
          end;
{$IFEND}
        end;
      end;
    3:
      begin
        if PlayObject.m_MyGuild <> nil then
        begin
          for I := 0 to TGUild(PlayObject.m_MyGuild).m_RankList.Count - 1 do
          begin
            GuildRank := TGUild(PlayObject.m_MyGuild).m_RankList.Items[I];
            if GuildRank = nil then
              Continue;
            for II := 0 to GuildRank.MemberList.Count - 1 do
            begin
              AObject := TPlayObject(GuildRank.MemberList.Objects[II]);
              if AObject = nil then
                Continue;
              if (not AObject.m_boDeath) and (not AObject.m_boGhost) then
              begin
                if nRange = 0 then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime)
                else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime);
              end;
            end;
          end;
        end;
      end;
    4:
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          UserEngine.m_PlayObjectList.LockR(63);
        try
{$IFEND}
          for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
          begin
            AObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
            if AObject <> nil then
            begin
              if (PlayObject.m_PEnvir = AObject.m_PEnvir) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
              begin
                if nRange = 0 then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime)
                else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime);
              end;
            end;
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.UnLockR;
        end;
{$IFEND}
      end;
    5:
      begin
        if (PlayObject.m_GroupOwner <> nil) and (PlayObject.m_GroupOwner.m_GroupMembers <> nil) then
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            PlayObject.m_GroupOwner.m_GroupMembers.LockR(14);
          try
{$IFEND}
            for I := 0 to PlayObject.m_GroupOwner.m_GroupMembers.Count - 1 do
            begin
              AObject := TPlayObject(PlayObject.m_GroupOwner.m_GroupMembers.Objects[I]);
              if (AObject <> nil) and (not AObject.m_boDeath) and (not AObject.m_boGhost) and (AObject <> PlayObject) then
              begin
                if nRange = 0 then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime)
                else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime);
              end;
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              PlayObject.m_GroupOwner.m_GroupMembers.UnLockR;
          end;
{$IFEND}
        end;
      end;
    6:
      begin
        if PlayObject.m_MyGuild <> nil then
        begin
          for I := 0 to TGUild(PlayObject.m_MyGuild).m_RankList.Count - 1 do
          begin
            GuildRank := TGUild(PlayObject.m_MyGuild).m_RankList.Items[I];
            if GuildRank = nil then
              Continue;
            for II := 0 to GuildRank.MemberList.Count - 1 do
            begin
              AObject := TPlayObject(GuildRank.MemberList.Objects[II]);
              if (AObject <> nil) and (AObject <> PlayObject) and (not AObject.m_boDeath) and (not AObject.m_boGhost) then
              begin
                if nRange = 0 then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime)
                else if (abs(AObject.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(AObject.m_nCurrY - PlayObject.m_nCurrY) <= nRange) then
                  AObject.SendMoveMsg(sMsg, nFColor, nBColor, nY, nCount, nFontSize, nMarqueeTime);
              end;
            end;
          end;
        end;
      end;
    7:
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          UserEngine.m_PlayObjectList.LockR(64);
        try
{$IFEND}
          for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
          begin
            AObject := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
            if (AObject <> nil) //
              and (AObject <> PlayObject) //
              and (PlayObject.m_PEnvir = AObject.m_PEnvir) //
              and (not AObject.m_boDeath) //
              and (not AObject.m_boGhost) then
            begin
              if nRange = 0 then
