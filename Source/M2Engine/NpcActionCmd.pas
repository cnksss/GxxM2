procedure ActionOfAddTextList(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  IsNew, IsOK: Boolean;
  sFileName: string;
  TxtFile: TextFile;
  I: Integer;
begin
  if QuestActionInfo.nParam4 = 1 then
    sFileName := QuestActionInfo.sParam1
  else
    sFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1;

  IsNew := (QuestActionInfo.sRawParam3 <> '') and (QuestActionInfo.sRawParam3 <> '""');

  IsOK := False;
  AssignFile(TxtFile, sFileName);
  if not FileExists(sFileName) then
  begin
    Rewrite(TxtFile);

    for I := 1 to SAVE_RETRY_COUNT do
    begin
      try
        Rewrite(TxtFile);
        IsOK := True;
        Break;
      except
        // Sleep(SAVE_SLEEP_TIME);
      end;
    end;
  end
  else
  begin
    for I := 1 to SAVE_RETRY_COUNT do
    begin
      try
        Append(TxtFile);
        IsOK := True;
        Break;
      except
        // Sleep(SAVE_SLEEP_TIME);
      end;
    end;
  end;

  if IsOK then
  begin
    if IsNew then
      Writeln(TxtFile, QuestActionInfo.sParam2 + ' ' + QuestActionInfo.sParam3)
    else
      Writeln(TxtFile, QuestActionInfo.sParam2);

    CloseFile(TxtFile);
  end
  else
    MainOutMessage(Format('Save fail; [%s; %s]', [QuestActionInfo.sCmd, sFileName]));
end;

procedure ActionOfDelTextList(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  IsNew, IsChanged: Boolean;
  sFileName: string;
  sLineText, s10, S12: string;
  LoadList: TStringList;
  I: Integer;
  Path: string;
begin
  if QuestActionInfo.nParam4 = 1 then
    sFileName := QuestActionInfo.sParam1
  else
    sFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1;

  IsNew := (QuestActionInfo.sRawParam3 <> '') and (QuestActionInfo.sRawParam3 <> '""');

  LoadList := TStringList.Create;

  try
    if FileExists(sFileName) then
    begin
      try
        LoadList.LoadFromFile(sFileName);
      except
        MainOutMessage('loading fail.... => ' + sFileName);
      end;
    end
    else
      MainOutMessage('file not found => ' + sFileName);

    IsChanged := False;
    if IsNew then
    begin
      for I := 0 to LoadList.Count - 1 do
      begin
        if LoadList.Count <= 0 then
          Break;

        sLineText := Trim(LoadList.Strings[I]);
        sLineText := GetValidStr3_Ex(sLineText, s10, ' ');
        sLineText := GetValidStr3_Ex(sLineText, S12, ' ');
        if (CompareStr(QuestActionInfo.sParam2, s10) = 0) and (CompareStr(QuestActionInfo.sParam3, S12) = 0) then
        begin
          LoadList.Delete(I);
          IsChanged := True;
          Break;
        end;
      end;
    end
    else
    begin
      for I := 0 to LoadList.Count - 1 do
      begin
        if LoadList.Count <= 0 then
          Break;

        s10 := Trim(LoadList.Strings[I]);
        if (CompareText(QuestActionInfo.sParam2, s10) = 0) then
        begin
          LoadList.Delete(I);
          IsChanged := True;
          Break;
        end;
      end;
    end;

    if IsChanged then
    begin
      IsChanged := False;
      for I := 1 to SAVE_RETRY_COUNT do
      begin
        try
          Path := ExtractFilePath(sFileName);
          if not DirectoryExists(Path) then
          begin
            ForceDirectories(Path);
          end;

          LoadList.SaveToFile(sFileName);
          IsChanged := True;
          Break;
        except
          // Sleep(SAVE_SLEEP_TIME);
        end;
      end;

      if not IsChanged then
        MainOutMessage(Format('Save fail; [%s; %s]', [QuestActionInfo.sCmd, sFileName]));
    end;
  finally
    LoadList.Free;
  end;
end;

procedure ActionOfDelTextListLine(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sFileName: string;
  I, nLine: Integer;
  LoadList: TStringList;
begin
  if QuestActionInfo.nParam3 = 1 then
    sFileName := QuestActionInfo.sParam1
  else
    sFileName := g_Config.sEnvirDir + Npc.m_sPath + QuestActionInfo.sParam1;

  nLine := QuestActionInfo.nParam2;

  if (nLine < 0) or (QuestActionInfo.sParam1 = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if FileExists(sFileName) then
  begin
    LoadList := TStringList.Create;
    try
      try
        LoadList.LoadFromFile(sFileName);
      except
        MainOutMessage('loading fail.... => ' + sFileName);
      end;

      if (nLine >= 0) and (nLine < LoadList.Count) then
      begin
        LoadList.Delete(nLine);

        for I := 1 to SAVE_RETRY_COUNT do
        begin
          try
            LoadList.SaveToFile(sFileName);
            Break;
          except
            // Sleep(SAVE_SLEEP_TIME);
          end;
        end;
      end;
    finally
      LoadList.Free;
    end;
  end;
end;

procedure ActionOfGroupMove(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nMaxLevel: Integer;
  Envir: TEnvirnoment;
  Player: TPlayObject;
  boCanMove: Boolean;
  nRange: Integer;
begin
  if PlayObject.m_GroupOwner = nil then
    Exit;

  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  nRange := QuestActionInfo.nParam4;

  if Envir <> nil then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      PlayObject.m_GroupOwner.m_GroupMembers.LockR(11);
    try
{$IFEND}
      if PlayObject.m_GroupOwner.m_GroupMembers.Count > 0 then
      begin
        nMaxLevel := QuestActionInfo.nParam2;
        for I := 0 to PlayObject.m_GroupOwner.m_GroupMembers.Count - 1 do
        begin
          Player := TPlayObject(PlayObject.m_GroupOwner.m_GroupMembers.Objects[I]);

          if (not Player.m_boDeath) and (not Player.m_boGhost) and (Player.m_WAbil.Level >= nMaxLevel) then
          begin
            if nRange > 0 then
            begin
              boCanMove := (Player.m_PEnvir = PlayObject.m_PEnvir) and (abs(Player.m_nCurrX - PlayObject.m_nCurrX) <= nRange) and (abs(Player.m_nCurrY - PlayObject.m_nCurrY) <= nRange);
            end
            else
              boCanMove := True;

            if boCanMove then
            begin
              if (Player.m_boDummyObject) and (not CanDummyMoveMap(Envir.sMapName)) then
                Continue;

              Player.SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');
              Player.MapRandomMove(Envir.sMapName, 0);
              if QuestActionInfo.sParam3 <> '' then
              begin
                Npc.GotoLable(Player, QuestActionInfo.sParam3, False);
              end;
            end;
          end;
        end;
        boSendNpcSay := True;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        PlayObject.m_GroupOwner.m_GroupMembers.UnLockR;
    end;
{$IFEND}
  end;
end;

procedure ActionOfGroupMapMove(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nMaxLevel: Integer;
  Envir: TEnvirnoment;
  sLabel: string;
  nRange: Integer;
  Player: TPlayObject;
  boCanMove: Boolean;
  OldEnvir: TEnvirnoment;
  OldX, OldY: Integer;
begin
  if PlayObject.m_GroupOwner = nil then
    Exit;

  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  nMaxLevel := QuestActionInfo.nParam4;

  if Pos('@', QuestActionInfo.sParam4) > 0 then
    sLabel := QuestActionInfo.sParam4
  else
    sLabel := '';

  nRange := QuestActionInfo.nParam5;

  if Envir <> nil then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      PlayObject.m_GroupOwner.m_GroupMembers.LockR(12);
    try
{$IFEND}
      if PlayObject.m_GroupOwner.m_GroupMembers.Count > 0 then
      begin
        OldEnvir := PlayObject.m_PEnvir;
        OldX := PlayObject.m_nCurrX;
        OldY := PlayObject.m_nCurrY;

        for I := 0 to PlayObject.m_GroupOwner.m_GroupMembers.Count - 1 do
        begin
          Player := TPlayObject(PlayObject.m_GroupOwner.m_GroupMembers.Objects[I]);
          if (not Player.m_boDeath) and (not Player.m_boGhost) and (Player.m_WAbil.Level >= nMaxLevel) then
          begin
            if nRange > 0 then
            begin
              boCanMove := (Player.m_PEnvir = OldEnvir) and (abs(Player.m_nCurrX - OldX) <= nRange) and (abs(Player.m_nCurrY - OldY) <= nRange);
            end
            else
              boCanMove := True;

            if boCanMove then
            begin
              if (Player.m_boDummyObject) and (not CanDummyMoveMap(Envir.sMapName)) then
                Continue;

              Player.SendRefMsg(RM_SPACEMOVE_FIRE, 0, 0, 0, 0, '');
              Player.SpaceMove(Envir.sMapName, QuestActionInfo.nParam2, QuestActionInfo.nParam3, 0);
              if Length(sLabel) > 0 then
              begin
                Npc.GotoLable(Player, sLabel, False);
                Npc.AddSelectLable(sLabel);
              end;
            end;
          end;
        end;
        boSendNpcSay := True;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        PlayObject.m_GroupOwner.m_GroupMembers.UnLockR;
    end;
{$IFEND}
  end;
end;

