procedure ActionOfGetMirrorMapTime(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  S1, sVarName, sVarName2: string;
  N1: Integer;
  Envir: TEnvirnoment;
  IsBreakParseVar: Boolean;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
  begin
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
    if Envir = nil then
    begin
      S1 := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, S1, N1, IsBreakParseVar);
      if Length(S1) > 0 then
        Envir := g_MapManager.FindMap(S1);
    end;
  end;

  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  if (Envir = nil) or (not Envir.m_boMirror) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  sVarName := QuestActionInfo.sRawParam2;
  if (Length(sVarName) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  sVarName2 := QuestActionInfo.sRawParam3;

  if (not Npc.SetVarValue(PlayObject, sVarName, IntToStr(Envir.m_dwMirrorSurvivalTime), Envir.m_dwMirrorSurvivalTime)) then
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);

  if sVarName2 <> '' then
  begin
    N1 := (Envir.m_dwMirrorSurvivalTime * 1000 - tick_diff(Envir.m_dwMirrorCreateTick, MyGetTickCount) + 999) div 1000;
    if N1 < 0 then
      N1 := 0;

    if (not Npc.SetVarValue(PlayObject, sVarName2, IntToStr(N1), N1)) then
      Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfSetMirrorMapTime(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  S1: string;
  I, N1: Integer;
  Envir: TEnvirnoment;
  Player: TPlayObject;
  IsBreakParseVar: Boolean;
begin
  Envir := nil;
  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
  begin
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
    if Envir = nil then
    begin
      S1 := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam1, S1, N1, IsBreakParseVar);
      if Length(S1) > 0 then
        Envir := g_MapManager.FindMap(S1);
    end;
  end;

  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  if (Envir = nil) or (not Envir.m_boMirror) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  Envir.m_dwMirrorSurvivalTime := QuestActionInfo.nParam2;

  // 清掉副本已经使用时间 chongchong 2017-11-15
  if QuestActionInfo.nParam3 = 1 then
  begin
    Envir.m_dwMirrorCreateTick := MyGetTickCount;
  end;

{$IF MULTI_THREAD = 1}
  if g_MultiThreadRun then
    UserEngine.m_PlayObjectList.LockR(63);
  try
{$IFEND}
    for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
    begin
      Player := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
      if Player <> nil then
      begin
        if (Player.m_PEnvir = Envir) and (not Player.m_boDeath) and (not Player.m_boGhost) then
        begin
          Player.m_MirrorMapSendTimeEnvir := nil;
        end;
      end;
    end;
{$IF MULTI_THREAD = 1}
  finally
    if g_MultiThreadRun then
      UserEngine.m_PlayObjectList.UnLockR;
  end;
{$IFEND}
end;

