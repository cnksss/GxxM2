// 删除行会成员 chongchong 2014-09-23
procedure ActionOfDelGuildMember(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sGuildName, Master1, Master2, UserName: string;
  Guild: TGUild;
  PlayHum: TPlayObject;
begin
  sGuildName := QuestActionInfo.sParam1;
  UserName := QuestActionInfo.sParam2;

  if (sGuildName = '') or (UserName = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  try
    PlayHum := UserEngine.GetPlayObject(UserName);
    Guild := g_GuildManager.FindGuild(sGuildName);
    if Guild <> nil then
    begin
      if (PlayHum <> nil) { and (not PlayHum.m_boOffLine) } then // 人物存在,不是离线挂机,允许加入行会
      begin
        if Guild.IsMember(UserName) and (PlayHum.m_nGuildRankNo <> 1) then // 是行会成员
        begin
          if Guild.DelMember(UserName) then
          begin
            PlayHum.m_MyGuild := nil;
            PlayHum.RefRankInfo(0, '');
            PlayHum.RefShowName();

            if (g_FunctionNPC <> nil) then
            begin
              PlayHum.m_nScriptGotoCount := 0;
              g_FunctionNPC.GotoLable(PlayHum, '@ExitGuild', False);
            end;
          end;
        end;
      end
      else
      begin
        Guild.GetGuildMasterName(Master1, Master2);
        if (UserName <> Master1) and Guild.IsMember(UserName) then
          Guild.DelMember(UserName);
      end;
    end
    else
    begin
      Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
      Exit;
    end;
  except
    MainOutMessage('{异常} ActionOfDelGuildMember');
  end;
end;

// 强制组队 chongchong 2014-10-17
procedure ActionOfCreatGroup(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  GroupObject: TPlayObject;
  sHumName: string;
begin
  sHumName := QuestActionInfo.sParam1;
  if Length(sHumName) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_boDeath or PlayObject.m_boGhost then
  begin
    PlayObject.SendDefMessage(SM_CREATEGROUP_FAIL, -1, 0, 0, 0, '');
    Exit;
  end;

  GroupObject := UserEngine.GetPlayObject(sHumName);
  if (PlayObject.m_GroupOwner <> nil) and (PlayObject.m_GroupOwner <> PlayObject) then
  begin
    PlayObject.SendDefMessage(SM_CREATEGROUP_FAIL, -1, 0, 0, 0, '');
    Exit;
  end;

  if (GroupObject = nil) or (GroupObject = PlayObject) or GroupObject.m_boDeath or GroupObject.m_boGhost then
  begin
    PlayObject.SendDefMessage(SM_CREATEGROUP_FAIL, -2, 0, 0, 0, '');
    Exit;
  end;

  if (GroupObject.m_GroupOwner <> nil) then
  begin
    PlayObject.SendDefMessage(SM_CREATEGROUP_FAIL, -3, 0, 0, 0, '');
    Exit;
  end;

  {
    if (not GroupObject.m_boAllowGroup) then
    begin
    SendDefMessage(SM_CREATEGROUP_FAIL, -4, 0, 0, 0, '');
    Exit;
    end;
  }

  if PlayObject.m_GroupOwner = nil then
  begin
    PlayObject.m_boAllowStartGroup := True;
    if g_FunctionNPC <> nil then
    begin
      PlayObject.m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(PlayObject, '@StartGroup', False);
    end;

    if not PlayObject.m_boAllowStartGroup then
      Exit;

{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      PlayObject.m_GroupMembers.LockW(23);
    try
{$IFEND}
      PlayObject.m_GroupMembers.Clear;
      PlayObject.m_GroupMembers.AddObject(PlayObject.m_sCharName, PlayObject);
      PlayObject.m_GroupMembers.AddObject(sHumName, GroupObject);
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        PlayObject.m_GroupMembers.UnLockW;
    end;
{$IFEND}
    PlayObject.JoinGroup(PlayObject);
    GroupObject.JoinGroup(PlayObject);
    PlayObject.m_boAllowGroup := True;
    PlayObject.SendDefMessage(SM_CREATEGROUP_OK, 0, 0, 0, 0, '');
    PlayObject.SendGroupMembers();
    if g_FunctionNPC <> nil then
    begin
      PlayObject.m_sString[0] := sHumName;
      PlayObject.m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(PlayObject, '@GroupCreate', False);
    end;

    Npc.GotoLable(PlayObject, '@CreatGroupOK', False);
  end
  else
  begin
    if PlayObject.m_GroupMembers.Count > g_Config.nGroupMembersMax then
    begin
      PlayObject.SendDefMessage(SM_GROUPADDMEM_FAIL, -5, 0, 0, 0, '');
      Exit;
    end;

    if PlayObject.IsGroupMember(GroupObject) then
    begin
      PlayObject.SendDefMessage(SM_GROUPADDMEM_FAIL, -3, 0, 0, 0, '');
      Exit;
    end;

{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      PlayObject.m_GroupMembers.LockW(24);
    try
{$IFEND}
      PlayObject.m_GroupMembers.AddObject(sHumName, GroupObject);
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        PlayObject.m_GroupMembers.UnLockW;
    end;
{$IFEND}
    GroupObject.JoinGroup(PlayObject);
    PlayObject.SendDefMessage(SM_GROUPADDMEM_OK, 0, 0, 0, 0, '');
    PlayObject.SendGroupMembers();
    if (g_FunctionNPC <> nil) then
    begin
      PlayObject.m_sString[0] := sHumName;
      PlayObject.m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(PlayObject, '@GroupAddMember', False);
    end;

    Npc.GotoLable(PlayObject, '@CreatGroupOK', False);
  end;
end;

// 获取队友数量 chongchong 2014-10-17
procedure ActionOfGetGroupCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nGroupCount, nRange: Integer;
  Player: TPlayObject;
begin
  if Length(QuestActionInfo.sRawParam1) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  nRange := QuestActionInfo.nParam2;

  nGroupCount := 0;
  if (PlayObject.m_GroupOwner <> nil) and (PlayObject.m_GroupOwner.m_GroupMembers <> nil) then
  begin
{$IF MULTI_THREAD = 1}
    if g_MultiThreadRun then
      PlayObject.m_GroupOwner.m_GroupMembers.LockR(25);
    try
{$IFEND}
      if nRange <= 0 then
      begin
        nGroupCount := PlayObject.m_GroupOwner.m_GroupMembers.Count;
      end
      else
      begin
        for I := 0 to PlayObject.m_GroupOwner.m_GroupMembers.Count - 1 do
        begin
          Player := TPlayObject(PlayObject.m_GroupOwner.m_GroupMembers.Objects[I]);

          if (not Player.m_boDeath) and (not Player.m_boGhost) and (abs(Player.m_nCurrX - PlayObject.m_GroupOwner.m_nCurrX) <= nRange) and (abs(Player.m_nCurrY - PlayObject.m_GroupOwner.m_nCurrY) <= nRange) then
          begin
            Inc(nGroupCount);
          end;
        end;
      end;
{$IF MULTI_THREAD = 1}
    finally
      if g_MultiThreadRun then
        PlayObject.m_GroupOwner.m_GroupMembers.UnLockR;
    end;
{$IFEND}
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam1, IntToStr(nGroupCount), nGroupCount) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

