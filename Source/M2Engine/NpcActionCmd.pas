procedure ActionOfBagItemToStorage(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, J, nCount: Integer;
  sItemName: string;
  nType: Byte;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
begin
  if not BaseObject.m_btRaceServer in [RC_PLAYOBJECT] then
    Exit;

  nCount := 0;
  sItemName := QuestActionInfo.sParam1;
  nType := QuestActionInfo.nParam2;

  if (sItemName = '') or (not nType in [0..1]) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  for I := PlayObject.m_ItemList.Count - 1 downto 0 do
  begin
    UserItem := PlayObject.m_ItemList[I];
    if UserItem <> nil then
    begin
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (StdItem <> nil) and (StdItem.Name = sItemName) then
      begin
        case nType of
          0:
            for J := Low(PlayObject.m_StorageItemList) to High(PlayObject.m_StorageItemList) do
            begin
              if PlayObject.CanSaveToStorage(J) then // 修改无限仓库 -- piaoyun 2013-6-22
              begin
                if (GetUserItemBindValue(UserItem, ubNoStorage) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 2) then
                  Break;

                PlayObject.m_StorageItemList[J].Add(UserItem);
                PlayObject.SendDelItem(UserItem);
                PlayObject.m_ItemList.Delete(I);
                PlayObject.WeightChanged();
                Inc(nCount);
                Break;
              end;
            end;
          1:
            if PlayObject.CanSaveToBigStorage() then
            // 修改无限仓库 -- piaoyun 2013-6-22
            begin
              if (GetUserItemBindValue(UserItem, ubNoStorage) and UserItem.boIsBind) or g_ItemRules.Get(UserItem.wIndex, 2) then
                Continue;

              PlayObject.m_BigStorageItemList.Add(UserItem);
              PlayObject.SendDelItem(UserItem);
              PlayObject.m_ItemList.Delete(I);
              PlayObject.WeightChanged();
              Inc(nCount);
            end;
        else
          Exit;
        end;
        PlayObject.m_sCurrentItemName := StdItem.DBName;
        PlayObject.m_sCurrentItemNewName := StdItem.Name;
        PlayObject.m_CurrentItemOverlapCount := IfThen(StdItem.OverLap > 0, UserItem.Dura + 1, 1);
        PlayObject.m_nCurrentItemMakeIndex := UserItem.MakeIndex;
      end;
    end;
  end;

  g_FunctionNPC.GotoLable(PlayObject, '@BeginStorageSave', False); // Cursor 2023-06-05 16:23:04 增加存仓库触发
  PlayObject.m_sCurrentItemName := '';
  PlayObject.m_sCurrentItemNewName := '';
  PlayObject.m_CurrentItemOverlapCount := 0;
  PlayObject.m_nCurrentItemMakeIndex := 0;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, IntToStr(nCount), nCount) then
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
end;

