procedure ActionOfRandomKillMon(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  MonList, KillList: TList;
  mon: TBaseObject;
  II, nCount: Integer;
  Envir: TEnvirnoment;
  Idx1, Idx2: Integer;
begin
  if (QuestActionInfo.sParam1 = '') or (QuestActionInfo.sParam2 = '') or (QuestActionInfo.nParam3 <= 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if GetNoClearMonList(QuestActionInfo.sParam2) then
  begin
    PlayObject.SysMsg('怪物 [' + QuestActionInfo.sParam2 + '] 禁止清理', c_Red, t_Hint);
    Exit;
  end;

  if SameText(QuestActionInfo.sParam1, 'SELF') then
  begin
    Envir := BaseObject.m_PEnvir;
  end
  else
  begin
    Envir := nil;
    if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
      Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
    if Envir = nil then
      Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);
  end;

  if Envir <> nil then
  begin
    nCount := QuestActionInfo.nParam3;

    MonList := TList.Create;
    KillList := TList.Create;

    UserEngine.GetMapMonster(Envir, MonList);
    for II := 0 to MonList.Count - 1 do
    begin
      mon := TBaseObject(MonList.Items[II]);
      if mon.m_Master <> nil then
        Continue;

      // 在调用 ClearMapMon时，会干掉城堡中的守卫等 chongchong 2018-01-26
      // 修正沙巴克城门等过段时间会自动改变 chongchong 2018-01-26
      if mon.m_Castle <> nil then
        Continue;

      if CompareText(QuestActionInfo.sParam2, mon.m_sCharName) = 0 then
      begin
        KillList.Add(mon);
      end;
    end;

    if KillList.Count <= nCount then
    begin
      for II := 0 to KillList.Count - 1 do
      begin
        mon := TBaseObject(KillList.Items[II]);
        mon.m_boNoItem := QuestActionInfo.nParam4 = 1;
        mon.m_WAbil.HP := 0;
        mon.Die;
      end;
    end
    else if KillList.Count > 0 then
    begin
      Randomize;
      for II := 0 to 1000 do
      begin
        Idx1 := Random(KillList.Count);
        Idx2 := Random(KillList.Count);

        if Idx1 <> Idx2 then
        begin
          mon := KillList.Items[Idx1];
          KillList.Items[Idx1] := KillList.Items[Idx2];
          KillList.Items[Idx2] := mon;
        end;
      end;

      for II := 0 to nCount - 1 do
      begin
        mon := TBaseObject(KillList.Items[II]);
        mon.m_boNoItem := QuestActionInfo.nParam4 = 1;
        mon.m_WAbil.HP := 0;
        mon.Die;
      end;
    end;

    MonList.Free;
    KillList.Free;
  end;
end;

