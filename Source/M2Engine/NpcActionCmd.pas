procedure ActionOfGuildNoticeMsg(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nMode: Integer;
  sMsg: string;
  nFColor, nBColor: Integer;
  Online: TPlayObject;
begin
  nFColor := QuestActionInfo.nParam1;
  nBColor := QuestActionInfo.nParam2;

  if (not (nFColor in [0..255]) or (not (nBColor in [0..255]))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
  // MainOutMessage('QuestActionInfo.sSubParam2:'+QuestActionInfo.sSubParam2+' QuestActionInfo.sSubParam3:'+QuestActionInfo.sSubParam3);
  sMsg := QuestActionInfo.sSubParam2;
  Npc.GetVarValue(PlayObject, QuestActionInfo.sSubParam2, sMsg);

  if CompareBackLStr(sMsg, 'SELF', Length('SELF')) then
  begin
    nMode := 0;
    sMsg := Copy(sMsg, 1, Length(sMsg) - Length('SELF') - 1);
  end
  else if CompareBackLStr(sMsg, 'MAP', Length('MAP')) then
  begin
    nMode := 1;
    sMsg := Copy(sMsg, 1, Length(sMsg) - Length('MAP') - 1);
  end
  else if CompareBackLStr(sMsg, 'GROUP', Length('GROUP')) then
  begin
    nMode := 2;
    sMsg := Copy(sMsg, 1, Length(sMsg) - Length('GROUP') - 1);
  end
  else if CompareBackLStr(sMsg, 'NATIONAL', Length('NATIONAL')) then
  begin
    nMode := 3;
    sMsg := Copy(sMsg, 1, Length(sMsg) - Length('NATIONAL') - 1);
  end
  else
  begin
    nMode := 4;
  end;

  sMsg := AnsiReplaceText(sMsg, '%s', PlayObject.m_sCharName);
  sMsg := AnsiReplaceText(sMsg, '%x', IntToStr(PlayObject.m_nCurrX));
  sMsg := AnsiReplaceText(sMsg, '%y', IntToStr(PlayObject.m_nCurrY));
  if PlayObject.m_PEnvir <> nil then
    sMsg := AnsiReplaceText(sMsg, '%m', PlayObject.m_PEnvir.sMapDesc)
  else
    sMsg := AnsiReplaceText(sMsg, '%m', '????');
  sMsg := AnsiReplaceText(sMsg, '%d', Npc.m_sCharName);
  case nMode of
    0:
      PlayObject.SysMsg(sMsg, nFColor, nBColor, t_Char);
    1:
      begin
{$IF MULTI_THREAD = 1}
        if g_MultiThreadRun then
          UserEngine.m_PlayObjectList.LockR(77);
        try
{$IFEND}
          for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
          begin
            Online := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
            if (Online <> nil) and (not Online.m_boGhost) and (not Online.m_boOffLine) and (not Online.m_boDummyObject) and (Online.m_PEnvir = PlayObject.m_PEnvir) then
              Online.SysMsg(sMsg, nFColor, nBColor, t_Char);
          end;
{$IF MULTI_THREAD = 1}
        finally
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.UnLockR;
        end;
{$IFEND}
      end;
    2:
      begin
        if PlayObject.m_GroupOwner <> nil then
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            PlayObject.m_GroupOwner.m_GroupMembers.LockR(15);
          try
{$IFEND}
            for I := 0 to PlayObject.m_GroupOwner.m_GroupMembers.Count - 1 do
            begin
              Online := TPlayObject(PlayObject.m_GroupOwner.m_GroupMembers.Objects[I]);
              if (Online <> nil) and (not Online.m_boGhost) and (not Online.m_boOffLine) and (not Online.m_boDummyObject) then
                Online.SysMsg(sMsg, nFColor, nBColor, t_Char);
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              PlayObject.m_GroupOwner.m_GroupMembers.UnLockR;
          end;
{$IFEND}
        end;
      end;
    3:
      begin
        if PlayObject.m_btNation > 0 then
        begin
{$IF MULTI_THREAD = 1}
          if g_MultiThreadRun then
            UserEngine.m_PlayObjectList.LockR(78);
          try
{$IFEND}
            for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
            begin
              Online := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
              if (Online <> nil) and (not Online.m_boGhost) and (not Online.m_boOffLine) and (not Online.m_boDummyObject) and (Online.m_btNation = PlayObject.m_btNation) then
                // Online.SysMsg(sMsg, nFColor, nBColor, t_System);
                Online.SendMsg(Online, RM_NATIONMESSAGE, 0, nFColor, nBColor, 0, sMsg);
            end;
{$IF MULTI_THREAD = 1}
          finally
            if g_MultiThreadRun then
              UserEngine.m_PlayObjectList.UnLockR;
          end;
{$IFEND}
        end;
      end;
  else
    begin
      UserEngine.SendBroadCastMsg(sMsg, nFColor, nBColor, t_Char);
    end;
  end;
end;

