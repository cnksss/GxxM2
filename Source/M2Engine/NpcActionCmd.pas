procedure ActionOfLoadMonItems(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  List: TList;
  Index: Integer;
begin
  if Length(QuestActionInfo.sParam1) = 0 then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if UserEngine.GetMonRace(QuestActionInfo.sParam1) < 0 then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  if Length(QuestActionInfo.sParam2) = 0 then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  Index := PlayObject.m_MonItems.IndexOf(QuestActionInfo.sParam1);
  if Index >= 0 then
  begin
    List := TList(PlayObject.m_MonItems.Objects[Index]);
    FrmDB.LoadMonitems_Ex(g_Config.sEnvirDir + QuestActionInfo.sParam2, QuestActionInfo.sParam3, List);
  end
  else
  begin
    List := TList.Create;
    PlayObject.m_MonItems.AddObject(QuestActionInfo.sParam1, List);
    FrmDB.LoadMonitems_Ex(g_Config.sEnvirDir + QuestActionInfo.sParam2, QuestActionInfo.sParam3, List);
  end;

end;

procedure ActionOfResetMonItems(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  List: TList;
  Index: Integer;
begin
  Index := PlayObject.m_MonItems.IndexOf(QuestActionInfo.sParam1);
  if Index >= 0 then
  begin
    List := TList(PlayObject.m_MonItems.Objects[Index]);
    if List <> nil then
    begin
      ClearMonItemList(List);
      List.Free;
    end;

    PlayObject.m_MonItems.Delete(Index);
  end;
end;

procedure ActionOfResetAllMonItems(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I: Integer;
  List: TList;
begin
  for I := 0 to PlayObject.m_MonItems.Count - 1 do
  begin
    List := TList(PlayObject.m_MonItems.Objects[I]);
    if List <> nil then
    begin
      ClearMonItemList(List);
    end;
    List.Free;
  end;
  PlayObject.m_MonItems.Clear;
end;

procedure ActionOfGetDBMonsterFieldValue(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  MonInfo: pTMonInfo;
  sMonName, sFieldName, sValue: string;
begin
  sMonName := QuestActionInfo.sParam1;
  sFieldName := QuestActionInfo.sParam2;
  if (Length(sMonName) = 0) or (Length(sFieldName) = 0) or (Length(QuestActionInfo.sRawParam3) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  MonInfo := UserEngine.GetMonInfo(sMonName);
  if MonInfo = nil then
    sValue := ''
  else
  begin
    if SameText(sFieldName, 'Name') then
      sValue := MonInfo.sName
    else if SameText(sFieldName, 'Race') then
      sValue := IntToStr(MonInfo.btRace)
    else if SameText(sFieldName, 'RaceImg') then
      sValue := IntToStr(MonInfo.btRaceImg)
    else if SameText(sFieldName, 'Appr') then
      sValue := IntToStr(MonInfo.wAppr)
    else if SameText(sFieldName, 'Lvl') then
      sValue := IntToStr(MonInfo.nLevel)
    else if SameText(sFieldName, 'Undead') then
      sValue := IntToStr(MonInfo.btLifeAttrib)
    else if SameText(sFieldName, 'CoolEye') then
      sValue := IntToStr(MonInfo.wCoolEye)
    else if SameText(sFieldName, 'Exp') then
      sValue := IntToStr(MonInfo.dwExp)
    else if SameText(sFieldName, 'HP') then
      sValue := IntToStr(MonInfo.nHP)
    else if SameText(sFieldName, 'MP') then
      sValue := IntToStr(MonInfo.nMP)
    else if SameText(sFieldName, 'AC') then
      sValue := IntToStr(MonInfo.nAC)
    else if SameText(sFieldName, 'MAC') then
      sValue := IntToStr(MonInfo.nMAC)
    else if SameText(sFieldName, 'DC') then
      sValue := IntToStr(MonInfo.nDC)
    else if SameText(sFieldName, 'DCMAX') then
      sValue := IntToStr(MonInfo.nMaxDC)
    else if SameText(sFieldName, 'MC') then
      sValue := IntToStr(MonInfo.nMC)
    else if SameText(sFieldName, 'SC') then
      sValue := IntToStr(MonInfo.nSC)
    else if SameText(sFieldName, 'SPEED') then
      sValue := IntToStr(MonInfo.wSpeed)
    else if SameText(sFieldName, 'HIT') then
      sValue := IntToStr(MonInfo.wHitPoint)
    else if SameText(sFieldName, 'WALK_SPD') then
      sValue := IntToStr(MonInfo.wWalkSpeed)
    else if SameText(sFieldName, 'WalkStep') then
      sValue := IntToStr(MonInfo.wWalkStep)
    else if SameText(sFieldName, 'WaLkWait') then
      sValue := IntToStr(MonInfo.wWalkWait)
    else if SameText(sFieldName, 'ATTACK_SPD') then
      sValue := IntToStr(MonInfo.wAttackSpeed)
    else
    begin
      sValue := FrmDB.GetMonsterDBField(sMonName, sFieldName);
    end;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, sValue, StrToIntDef(sValue, 0)) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfMoveMonTo(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  S: string;
  SrcEnvir, DesEnvir: TEnvirnoment;
  MonList: TList;
  MoveMon: TBaseObject;
  I, N1: Integer;
  IsBreakParseVar: Boolean;
begin
  SrcEnvir := nil;
  DesEnvir := nil;

  if (not QuestActionInfo.boCompleteFormat2) and (QuestActionInfo.VarInfo2.VarAttr = aFixVar) then
  begin
    SrcEnvir := g_MapManager.FindMap(QuestActionInfo.sRawParam2);
    if SrcEnvir = nil then
    begin
      S := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam2, S, N1, IsBreakParseVar);
      if Length(S) > 0 then
        SrcEnvir := g_MapManager.FindMap(S);
    end;
  end;
  if SrcEnvir = nil then
    SrcEnvir := g_MapManager.FindMap(QuestActionInfo.sParam2);

  if (not QuestActionInfo.boCompleteFormat5) and (QuestActionInfo.VarInfo5.VarAttr = aFixVar) then
  begin
    DesEnvir := g_MapManager.FindMap(QuestActionInfo.sRawParam5);
    if DesEnvir = nil then
    begin
      S := '';
      Npc.GetVarValue(PlayObject, QuestActionInfo.sRawParam5, S, N1, IsBreakParseVar);
      if Length(S) > 0 then
        DesEnvir := g_MapManager.FindMap(S);
    end;
  end;
  if DesEnvir = nil then
    DesEnvir := g_MapManager.FindMap(QuestActionInfo.sParam5);

  if (SrcEnvir = nil) or (DesEnvir = nil) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  MonList := TList.Create;
  try
    if QuestActionInfo.sParam1 <> '*' then
    begin // 指定名称的怪移动
      SrcEnvir.GetMovingObject(QuestActionInfo.nParam3, QuestActionInfo.nParam4, True, MonList);
      if MonList.Count > 0 then
      begin // 20080629
        for I := 0 to MonList.Count - 1 do
        begin
          MoveMon := TBaseObject(MonList.Items[I]);
          if MoveMon <> PlayObject then
          begin
            if CompareText(MoveMon.m_sCharName, QuestActionInfo.sParam1) = 0 then // 是否是指定名称的怪
              MoveMon.SpaceMove(DesEnvir.sMapName, QuestActionInfo.nParam6, QuestActionInfo.nParam7, 0);
          end;
        end; // for
      end;
    end;
  finally
    MonList.Free;
  end;
end;

// 初始化守关信息 关卡号 总波数 守护雕像名称 守护雕像坐标X 守护雕像坐标Y  刷怪坐标X  刷怪坐标Y  奖励物品1  奖励物品2  奖励物品3  奖励物品4
procedure ActionOfSetGuardianLevelInfo(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  LevelNo, BatchCount: Integer;
  sStatueName: string;
  nStatueX, nStatueY, nMonX, nMonY: Integer;
  sItem1, sItem2, sItem3, sItem4, StdItems: string;
  mon: TBaseObject;
  StdItem: pTStdItem;
  IsBreakParseVar: Boolean;
  s10, sVar: string;
  N10: Integer;
  VarInfo10: TVarInfo;
begin
  LevelNo := QuestActionInfo.nParam1;
  BatchCount := QuestActionInfo.nParam2;
  sStatueName := QuestActionInfo.sParam3;
  nStatueX := QuestActionInfo.nParam4;
  nStatueY := QuestActionInfo.nParam5;
  nMonX := QuestActionInfo.nParam6;
  nMonY := QuestActionInfo.nParam7;

  sItem1 := QuestActionInfo.sParam8;
  sItem2 := QuestActionInfo.sParam9;
  sItem3 := QuestActionInfo.sParam10;
  sItem4 := QuestActionInfo.sSubParam10;

  VarInfo10 := GetValNameInfo(QuestActionInfo.sSubParam10);
  if VarInfo10.VarAttr > aNone then
  begin
    Npc.GetVarValue(PlayObject, QuestActionInfo.sSubParam10, s10, N10, IsBreakParseVar);

    if not IsBreakParseVar then
      Npc.GetVarValue(PlayObject, s10, sVar, s10, N10);

    sItem4 := s10;
  end;

  if (LevelNo <= 0) or (BatchCount <= 0) or (BatchCount >= 40) or (Length(sStatueName) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if UserEngine.GetMonInfo(sStatueName) = nil then
  begin
    Npc.ScriptActionError(PlayObject, '雕像未找到', QuestActionInfo);
    Exit;
  end;

  if not PlayObject.m_PEnvir.CanWalk(nStatueX, nStatueY, True) then
  begin
    Npc.ScriptActionError(PlayObject, '雕像坐标不可达', QuestActionInfo);
    Exit;
  end;

  if not PlayObject.m_PEnvir.CanWalk(nMonX, nMonY, True) then
  begin
    Npc.ScriptActionError(PlayObject, '刷怪坐标不可达', QuestActionInfo);
    Exit;
  end;

  StdItems := '';
  if (Length(sItem1) > 0) then
  begin
    StdItem := UserEngine.GetStdItem(sItem1);
    if StdItem = nil then
    begin
      Npc.ScriptActionError(PlayObject, '奖励物品1未找到', QuestActionInfo);
      Exit;
    end
    else
    begin
      StdItems := StdItems + EncodeBuffer(PAnsiChar(StdItem), SizeOf(TStdItem)) + '/';
    end;
  end;

  if (Length(sItem2) > 0) then
  begin
    StdItem := UserEngine.GetStdItem(sItem2);
    if StdItem = nil then
    begin
      Npc.ScriptActionError(PlayObject, '奖励物品2未找到', QuestActionInfo);
      Exit;
    end
    else
    begin
      StdItems := StdItems + EncodeBuffer(PAnsiChar(StdItem), SizeOf(TStdItem)) + '/';
    end;
  end;

  if (Length(sItem3) > 0) then
  begin
    StdItem := UserEngine.GetStdItem(sItem3);
    if StdItem = nil then
    begin
      Npc.ScriptActionError(PlayObject, '奖励物品3未找到', QuestActionInfo);
      Exit;
    end
    else
    begin
      StdItems := StdItems + EncodeBuffer(PAnsiChar(StdItem), SizeOf(TStdItem)) + '/';
    end;
  end;

  if (Length(sItem4) > 0) then
  begin
    StdItem := UserEngine.GetStdItem(sItem4);
    if StdItem = nil then
    begin
      Npc.ScriptActionError(PlayObject, '奖励物品4未找到', QuestActionInfo);
      Exit;
    end
    else
    begin
      StdItems := StdItems + EncodeBuffer(PAnsiChar(StdItem), SizeOf(TStdItem)) + '/';
    end;
  end;

  mon := BaseObject.MakeSlave(sStatueName, 3, 0, 100, 10 * 24 * 60 * 60, bb_Other, 0, not g_Config.boBBAttrPlusAddOnlyMagic, nStatueX, nStatueY);
  if mon <> nil then
  begin
    mon.m_boSlaveHideMasterName := True;
    mon.m_boSlaveNoLevelUP := True;
  end
  else
  begin
