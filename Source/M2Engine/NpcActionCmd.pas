procedure ActionOfGetInterval(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Time1, Time2: TDateTime;
  I: Integer;
begin
  if not TryStrToDateTime(QuestActionInfo.sParam1, Time1) or not TryStrToDateTime(QuestActionInfo.sParam2, Time2) then
  begin
    MainOutMessage('[注意]GetInterval命令收到了错误的时间格式');
    Exit;
  end;

  case QuestActionInfo.nParam3 of
    0:
      I := YearsBetween(Time1, Time2);
    1:
      I := MonthsBetween(Time1, Time2);
    2:
      I := WeeksBetween(Time1, Time2);
    3:
      I := DaysBetween(Time1, Time2);
    4:
      I := HoursBetween(Time1, Time2);
    5:
      I := MinutesBetween(Time1, Time2);
    6:
      I := SecondsBetween(Time1, Time2);
  else
    I := 0; // HZQ
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam4, IntToStr(I), I) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
end;

procedure ActionOfChangeBindMoney(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sMoneyName: string;
  nOldMoney, nCurrMoney, nMoney, n01: Integer;
  I, nCount: Integer;
  CustomMoney: pTCustomMoney;
  MoneyArr: TDynamicCustomMoneyArray;
begin
  if not BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT] then
    Exit;
  sMoneyName := QuestActionInfo.sParam1;
  // cMethod := QuestActionInfo.sParam2[1];
  nMoney := QuestActionInfo.nParam2;
  CustomMoney := FindCustomMoney(sMoneyName);
  if CustomMoney = nil then
  begin
    MainOutMessage(Format('用户:[%s]使用不存在的自定义货币[%s]', [PlayObject.m_sCharName, sMoneyName]));
    Exit;
  end;
  // CustomMoney := FindCustomMoneyBindName(CustomMoney);
  nCount := GetCustomMoneyBindArr(CustomMoney, MoneyArr);
  for I := 0 to nCount - 1 do
  begin
    n01 := PlayObject.m_MoneyList.GetIndex(UpperCase(MoneyArr[I].sName));
    nOldMoney := 0;
    nCurrMoney := 0;
    if n01 >= 0 then
    begin
      nOldMoney := Integer(PlayObject.m_MoneyList.Objects[n01]);
      nCurrMoney := _MAX(nOldMoney - nMoney, 0);
      PlayObject.m_MoneyList.Objects[n01] := TObject(nCurrMoney);
    end;

    if nCurrMoney <> nOldMoney then
      PlayObject.SendDefMessage(SM_MONEY, nCurrMoney, 0, 0, 0, MoneyArr[I].sName);

    if nOldMoney < nMoney then
      nMoney := nMoney - nOldMoney
    else
      Exit;
  end;

end;

