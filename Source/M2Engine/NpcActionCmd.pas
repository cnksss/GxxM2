procedure ActionOfGiveGamePetEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  MonInfo: pTMonInfo;
  nCount, II: Integer;
  GamePetData: pTGamePetData;
begin
  if (QuestActionInfo.sParam1 = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  MonInfo := UserEngine.GetMonInfo(QuestActionInfo.sParam1);
  if MonInfo = nil then
  begin
    Npc.ScriptActionError(PlayObject, '怪物不存在', QuestActionInfo);
    Exit;
  end;

  if PlayObject.m_GamePetList.Count >= g_Config.nGamePetMaxCount then
  begin
    PlayObject.SysMsg('你的宠物已经达到最大数量，请先回收一个到包裹', 255, 253, t_Hint);
    Exit;
  end;

  nCount := 0;
  for II := 0 to PlayObject.m_GamePetList.Count - 1 do
  begin
    GamePetData := PlayObject.m_GamePetList.Items[II];
    if SameText(GamePetData.sName, QuestActionInfo.sParam1) then
    begin
      Inc(nCount);
    end;
  end;

