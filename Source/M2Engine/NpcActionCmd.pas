procedure ActionOfDelMaster(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  Index: Integer;
  MasterHum: TPlayObject;
  MasterRankInfo: pTMasterRankInfo;
  sMasterName: string;
begin
  if not PlayObject.m_boMaster then
  begin
    // 徒弟删除师傅 chongchong 2014-10-19
    if Length(PlayObject.m_sMasterName) > 0 then
    begin
      MasterHum := UserEngine.GetPlayObject(PlayObject.m_sMasterName);
      if MasterHum <> nil then
      begin
        // PlayObject.m_sMasterName := '';

        MasterHum.DelMaster(PlayObject.m_sCharName, True); // 出师 2014-10-11
        if g_FunctionNPC <> nil then
        begin
          g_FunctionNPC.GotoLable(MasterHum, '@ForceUnMasterEnd', False); // 师傅触发 2014-10-11
          g_FunctionNPC.GotoLable(PlayObject, '@ForceUnMasterEnd1', False); // 徒弟触发 2014-10-11
        end;

        // MasterHum.RefShowName;
      end
      else
      begin
        g_UnForceMasterList.Lock;
        try
          // 多师徒，逐出师门 chongchong 2014-10-12
          g_UnForceMasterList.Add(PlayObject.m_sMasterName + #9 + PlayObject.m_sCharName);
        finally
          g_UnForceMasterList.UnLock;
        end;

        SaveUnForceMasterList();
      end;

      PlayObject.m_sMasterName := '';
      PlayObject.RefShowName;
    end;
  end
  else
  begin
    if (PlayObject.m_MasterNoList.Count > 0) and (QuestActionInfo.nParam1 >= 0) and (QuestActionInfo.nParam1 <= PlayObject.m_MasterNoList.Count) then
    begin
      Index := Max(QuestActionInfo.nParam1 - 1, 0);
      MasterRankInfo := PlayObject.m_MasterNoList.Items[Index];
      sMasterName := MasterRankInfo.sChrName;
      MasterHum := UserEngine.GetPlayObject(sMasterName);
      PlayObject.DelMaster(sMasterName, True); // 出师 2014-10-11

      if MasterHum <> nil then
      begin
        MasterHum.m_sMasterName := '';
        if g_FunctionNPC <> nil then
        begin
          g_FunctionNPC.GotoLable(PlayObject, '@ForceUnMasterEnd', False); // 师傅触发 2014-10-11
          g_FunctionNPC.GotoLable(MasterHum, '@ForceUnMasterEnd1', False); // 徒弟触发 2014-10-11
        end;

        MasterHum.RefShowName;
      end
      else
      begin
        g_UnForceMasterList.Lock;
        try
          // 多师徒，强制脱师 chongchong 2014-10-12
          g_UnForceMasterList.Add(sMasterName + #9 + PlayObject.m_sCharName);
        finally
          g_UnForceMasterList.UnLock;
        end;
      end;

      SaveUnForceMasterList();
      PlayObject.m_sMasterName := '';
      PlayObject.RefShowName;
    end;
  end;
end;

procedure ActionOfChangeCreditPoint(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nCreditPoint: Integer;
  nOldCreditPoint: Integer;
  cMethod: Char;
  Int64Value: Int64;
begin
  nCreditPoint := QuestActionInfo.nParam2;

  if (QuestActionInfo.sParam1 = '') or (nCreditPoint < 0) then
  begin
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
    Exit;
  end;

  nOldCreditPoint := BaseObject.m_WAbil.CreditPoint;
  cMethod := QuestActionInfo.sParam1[1];
  case cMethod of
    '=':
      begin
        if nCreditPoint >= 0 then
        begin
          BaseObject.m_WAbil.CreditPoint := nCreditPoint;
        end;
      end;
    '-':
      begin
        Int64Value := Int64(BaseObject.m_WAbil.CreditPoint) - nCreditPoint;
        if Int64Value < 0 then
          Int64Value := 0;
        BaseObject.m_WAbil.CreditPoint := Int64Value;
      end;
    '+':
      begin
        Int64Value := Int64(BaseObject.m_WAbil.CreditPoint) + nCreditPoint;
        if Int64Value > High(Integer) then
          Int64Value := High(Integer);
        BaseObject.m_WAbil.CreditPoint := Int64Value;
      end;
  else
    begin
      Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
      Exit;
    end;
  end;

  if nOldCreditPoint <> BaseObject.m_WAbil.CreditPoint then
  begin
    BaseObject.SendMsg(BaseObject, RM_ABILITY, 0, 0, 0, 0, '');

    // 声望日志
    AddGameDataLog(LOG_CreditPointChange, LOG_ActionNone, PlayObject, g_Config.sCreditPointName, 0, Npc.m_sCharName, PlayObject.m_WAbil.CreditPoint, nOldCreditPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
  end;
end;

procedure ActionOfClearNeedItems(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, II: Integer;
  nNeed: Integer;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
begin
  nNeed := QuestActionInfo.nParam1;

  if nNeed < 0 then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  for I := PlayObject.m_ItemList.Count - 1 downto 0 do
  begin
    if PlayObject.m_ItemList.Count <= 0 then
      Break;
    UserItem := PlayObject.m_ItemList.Items[I];
    if UserItem = nil then
      Continue;
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (StdItem <> nil) and (StdItem.Need = nNeed) then
    begin

      // 回收了物品，清掉升级框 chongchong 2018-05-16
      if (PlayObject.m_UpgradeItem = UserItem) then
      begin
        PlayObject.m_UpgradeItem := nil;
        PlayObject.m_UpgradeItemIsPegBag := False;
      end;

      PlayObject.SendDelItem(UserItem);
      PlayObject.m_ItemList.Delete(I);
      Dispose(UserItem);
    end;
  end;

  for I := Low(PlayObject.m_StorageItemList) to High(PlayObject.m_StorageItemList) do
  begin
    for II := PlayObject.m_StorageItemList[I].Count - 1 downto 0 do
    begin
      if PlayObject.m_StorageItemList[I].Count <= 0 then
        Break;

      UserItem := PlayObject.m_StorageItemList[I].Items[II];
      if UserItem = nil then
        Continue;

      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (StdItem <> nil) and (StdItem.Need = nNeed) then
      begin
        PlayObject.m_StorageItemList[I].Delete(II);
        Dispose(UserItem);
      end;
    end;
  end;
end;

procedure ActionOfClearMakeItems(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, II: Integer;
  nMakeIndex: Integer;
  sItemName: string;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  boMatchName: Boolean;
begin
  sItemName := QuestActionInfo.sParam1;
  nMakeIndex := QuestActionInfo.nParam2;
  boMatchName := QuestActionInfo.sParam3 = '1';
  if (sItemName = '') or (nMakeIndex <= 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  for I := PlayObject.m_ItemList.Count - 1 downto 0 do
  begin
    if PlayObject.m_ItemList.Count <= 0 then
      Break;
    UserItem := PlayObject.m_ItemList.Items[I];
    if UserItem = nil then
      Continue;
    if UserItem.MakeIndex <> nMakeIndex then
      Continue;
    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if not boMatchName or ((StdItem <> nil) and (CompareText(StdItem.Name, sItemName) = 0)) then
    begin
      if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
      begin
        AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;

      // 回收了物品，清掉升级框 chongchong 2018-05-16
      if (PlayObject.m_UpgradeItem = UserItem) then
      begin
        PlayObject.m_UpgradeItem := nil;
        PlayObject.m_UpgradeItemIsPegBag := False;
      end;

      PlayObject.SendDelItem(UserItem);
      PlayObject.m_ItemList.Delete(I);
      Dispose(UserItem);
    end;
  end;

  for I := Low(PlayObject.m_StorageItemList) to High(PlayObject.m_StorageItemList) do
  begin
    for II := PlayObject.m_StorageItemList[I].Count - 1 downto 0 do
    begin
      if PlayObject.m_StorageItemList[I].Count <= 0 then
        Break;
      UserItem := PlayObject.m_StorageItemList[I].Items[II];
      // UserItem := PlayObject.m_ItemList.Items[II];
      if UserItem = nil then
        Continue;
      if UserItem.MakeIndex <> nMakeIndex then
        Continue;
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if not boMatchName or ((StdItem <> nil) and (CompareText(StdItem.Name, sItemName) = 0)) then
      begin
        if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
        begin
          AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
        end;

        PlayObject.m_StorageItemList[I].Delete(II);
        Dispose(UserItem);
      end;
    end;
  end;

  for I := Low(PlayObject.m_UseItems) to High(PlayObject.m_UseItems) do
  begin
    UserItem := @PlayObject.m_UseItems[I];
    if UserItem.MakeIndex <> nMakeIndex then
      Continue;

    StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if not boMatchName or ((StdItem <> nil) and (CompareText(StdItem.Name, sItemName) = 0)) then
    begin
      if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
      begin
        AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
      end;

      UserItem.wIndex := 0;
    end;
  end;
end;

