procedure ActionOfSortVarToList(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
type
  pTSortVarValue = ^string;
var
  I, II: Integer;
  sVarName: string;
  sVarFileName: string;
  sListFileName: string;
  // DynamicVar: pTDynamicVar;
  // boFoundVar: Boolean;
  LoadList: TStringList;
  SaveList: TStringList;
  Strings: TValueList;
  MemoryIniFile: TMemoryIniFile;
  boSort: Boolean;
  boSave: Boolean;
  SortList: TSortStringList;
  VarValue: pTSortVarValue;
  Path: string;
begin
  if (Length(QuestActionInfo.sParam2) = 0) or (Length(QuestActionInfo.sParam3) = 0) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  sVarName := QuestActionInfo.sParam1;
  sVarFileName := QuestActionInfo.sParam2;
  if QuestActionInfo.nParam6 <> 1 then
    sVarFileName := g_Config.sEnvirDir + Npc.m_sPath + sVarFileName;

  sListFileName := QuestActionInfo.sParam3;
  if QuestActionInfo.nParam7 <> 1 then
    sListFileName := g_Config.sEnvirDir + Npc.m_sPath + sListFileName;

  if (sVarName = '') or (not FileExists(sVarFileName)) { or (not FileExists(sListFileName)) }
    then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  boSort := QuestActionInfo.sParam4 = '0';
  boSave := QuestActionInfo.sParam5 = '1';

  SortList := TSortStringList.Create;
  SaveList := TStringList.Create;
  LoadList := TStringList.Create;

  MemoryIniFile := nil; // TMemoryIniFile.Create(LoadList);
  try
    try
      LoadList.LoadFromFile(sVarFileName);
      MemoryIniFile := TMemoryIniFile.Create(LoadList);
    except
      MainOutMessage('SortVarToList loading fail.... => ' + sVarFileName);
    end;

    for I := 0 to MemoryIniFile.Sections.Count - 1 do
    begin
      Strings := TValueList(MemoryIniFile.Sections.Objects[I]);
      for II := 0 to Strings.Count - 1 do
      begin
        if CompareText(Strings.Names[II], sVarName) = 0 then
        begin
          New(VarValue);
          if boSave then
          begin
            VarValue^ := MemoryIniFile.Sections.Strings[I] + ':' + Strings.Strings[II];
            // SaveList.Add(Sections.Strings[I] + ' ' + Strings.Strings[II])
          end
          else
          begin
            VarValue^ := MemoryIniFile.Sections.Strings[I];
            // SaveList.Add(Sections.Strings[I]);
          end;

          SortList.AddObject(IntToStr(StrToIntDef(Strings.Strings[II], 0)), TObject(VarValue));
          Break;
        end;
      end;
    end;

    SortList.NumberSort(boSort);
    for I := 0 to SortList.Count - 1 do
    begin
      VarValue := pTSortVarValue(SortList.Objects[I]);
      SaveList.Add(VarValue^);
      Dispose(VarValue);
    end;

    boSave := False;
    for I := 1 to SAVE_RETRY_COUNT do
    begin
      try
        Path := ExtractFilePath(sListFileName);
        if not DirectoryExists(Path) then
        begin
          ForceDirectories(Path);
        end;

        SaveList.SaveToFile(sListFileName);
        boSave := True;
        Break;
      except
        // Sleep(SAVE_SLEEP_TIME);
      end;
    end;

    if not boSave then
    begin
      MainOutMessage(Format('Save fail; [%s; %s]', [QuestActionInfo.sCmd, sListFileName]));
    end;
  finally
    SortList.Free;
    LoadList.Free;
    SaveList.Free;
    if MemoryIniFile <> nil then
      MemoryIniFile.Free;
  end;

end;

