var
  I, K, nWhere: Integer;
  UserItem: pTUserItem;
  nBagItemIndex, nBoxItemIndex, nMakeIndex: Integer;
  SmartObject: TSmartObject;
  FieldName, VarName, sRet: string;
  StdItem: pTStdItem;
  NewStdItem: TStdItem;
begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  nBoxItemIndex := -1;
  nBagItemIndex := -1;
  nWhere := -2;
  I := Pos('boxitem', LowerCase(QuestActionInfo.sParam1));
  K := Pos('bagitem', LowerCase(QuestActionInfo.sParam1));
  if I = 1 then
    nBoxItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('boxitem') + 1, MaxInt), -1)
  else if K = 1 then
    nBagItemIndex := StrToIntDef(Copy(QuestActionInfo.sParam1, Length('bagitem') + 1, MaxInt), -1)
    // ALL_BAG_ITEM_COUNT
  else
    nWhere := StrToIntDef(QuestActionInfo.sParam1, -2);

  FieldName := QuestActionInfo.sParam2;
  VarName := QuestActionInfo.sRawParam3;

  if not (((nWhere >= -1) and (nWhere <= U_GODBLESSITEM12)) or ((nBoxItemIndex >= 0) and (nBoxItemIndex <= High(THumanItemBoxItems))) or ((nBagItemIndex >= 0) and (nBagItemIndex <= ALL_BAG_ITEM_COUNT))) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  if (FieldName = '') or (VarName = '') then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  UserItem := nil;
  if (nBagItemIndex <> -1) and (nBagItemIndex < SmartObject.m_ItemList.Count) then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      UserItem := SmartObject.m_ItemList[nBagItemIndex];
    end;
  end
  else if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      nMakeIndex := TPlayObject(SmartObject).m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(SmartObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := SmartObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    UserItem := @SmartObject.m_UseItems[nWhere];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
