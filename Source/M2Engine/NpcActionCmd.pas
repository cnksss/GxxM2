      begin
        Int64Value := Int64(BaseObject.m_WAbil.HP) + NewHP;
        BaseObject.m_WAbil.HP := Min(Int64Value, BaseObject.m_WAbil.MaxHP);
        BaseObject.HealthSpellChanged;
      end;
    '-':
      begin
        OldHP := BaseObject.m_WAbil.HP;
        Int64Value := Int64(BaseObject.m_WAbil.HP) - NewHP;
        Int64Value := Max(0, Int64Value);
        BaseObject.m_WAbil.HP := Int64Value;

        if BaseObject.m_WAbil.HP < OldHP then
          BaseObject.SendRefMsg(RM_HEALTHSPELLCHANGED_STRUCK, OldHP - BaseObject.m_WAbil.HP, -1, -1, 0, '');
      end;
    '=':
      begin
        if NewHP < 0 then
          BaseObject.m_WAbil.HP := 0
        else if NewHP > BaseObject.m_WAbil.MaxHP then
          BaseObject.m_WAbil.HP := BaseObject.m_WAbil.MaxHP
        else
          BaseObject.m_WAbil.HP := NewHP;
        BaseObject.HealthSpellChanged;
      end;
  else
    Npc.ScriptActionError(BaseObject, '操作符错误', QuestActionInfo);
    Exit;
  end;
end;

// 按当前MP值的百分比来加减MP chongchong 2013-10-29
procedure ActionOfAddMpperEx(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  cMethod: Char;
  nBaseValue: Integer;
  NewMP: Int64;
  Int64Value: Int64;
begin
  if Length(QuestActionInfo.sParam1) = 0 then
  begin
    Npc.ScriptActionError(PlayObject, '操作符不能为空', QuestActionInfo);
    Exit;
  end;

  if QuestActionInfo.nParam2 < 0 then
  begin
    Exit;
  end;

  cMethod := QuestActionInfo.sParam1[1];

  if QuestActionInfo.nParam3 = 0 then
    nBaseValue := 100
  else if QuestActionInfo.nParam3 = 1 then
    nBaseValue := 1000
  else if QuestActionInfo.nParam3 = 2 then
    nBaseValue := 10000
  else
    nBaseValue := 100;

  NewMP := Round(QuestActionInfo.nParam2 / nBaseValue * BaseObject.m_WAbil.MP);
  if NewMP > High(LongWord) then
    NewMP := High(LongWord);

  case cMethod of
    '+':
      begin
        Int64Value := Int64(BaseObject.m_WAbil.MP) + NewMP;
        BaseObject.m_WAbil.MP := Min(Int64Value, BaseObject.m_WAbil.MaxMP);
      end;
    '-':
      begin
        Int64Value := Int64(BaseObject.m_WAbil.MP) - NewMP;
        if Int64Value < 0 then
          Int64Value := 0;
        BaseObject.m_WAbil.MP := Int64Value;
      end;
    '=':
      begin
        if NewMP < 0 then
          BaseObject.m_WAbil.MP := 0
        else if NewMP > BaseObject.m_WAbil.MaxMP then
          BaseObject.m_WAbil.MP := BaseObject.m_WAbil.MaxMP
        else
          BaseObject.m_WAbil.MP := NewMP;
      end;
  else
    Npc.ScriptActionError(BaseObject, '操作符错误', QuestActionInfo);
    Exit;
  end;

  BaseObject.HealthSpellChanged;
end;

