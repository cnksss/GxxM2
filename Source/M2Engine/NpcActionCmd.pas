  sItemName := QuestActionInfo.sParam1;
  nPrice := QuestActionInfo.nParam2;
  nMoneyType := QuestActionInfo.nParam3;

  if (nPrice < 0) or (not nMoneyType in [0..4]) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;

  StdItem := UserEngine.GetStdItem(sItemName);
  if StdItem = nil then
    Exit;

  for I := PlayObject.m_ItemList.Count - 1 downto 0 do
  begin
    UserItem := PlayObject.m_ItemList.Items[I];
    if (UserItem <> nil) and (UserEngine.GetStdItemName(UserItem.wIndex) = sItemName) then
      Break;
  end;
  if UserItem = nil then
    Exit;

  for I := 0 to PlayObject.m_HeroM2ShopList.Count - 1 do
  begin
    if pTHeroM2ShopItemInfo(PlayObject.m_HeroM2ShopList.Items[I]).nMakeIndex = UserItem.MakeIndex then
      Exit;
  end;

  New(HeroM2ShopItemInfo);
  HeroM2ShopItemInfo.nMakeIndex := UserItem.MakeIndex;
  HeroM2ShopItemInfo.nPrice := nPrice;
  HeroM2ShopItemInfo.nMoneyType := nMoneyType;
  HeroM2ShopItemInfo.dwAddTick := MyGetTickCount;
  PlayObject.m_HeroM2ShopList.Add(HeroM2ShopItemInfo);
  if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
  begin
    AddGameDataLog(LOG_ItemPutInto, LOG_ActionNone, PlayObject, StdItem.Name, HeroM2ShopItemInfo.nMakeIndex, '假人摆摊')
  end;
end;

