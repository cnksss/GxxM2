        SmartObject.m_NpcSkillPowerAdd[wMagicIndex].DefenseValue := Value;
      end;
  end;

  SmartObject.m_NpcSkillPowerAdd[wMagicIndex].RemainingTime := QuestActionInfo.nParam9;
  SmartObject.m_NpcSkillPowerAdd[wMagicIndex].IsSave := QuestActionInfo.nParam10 <> 0;
