      SmartObject.m_UseItems[Where].wIndex := 0;

      // SmartObject.m_boRecalcAbilitys := True;
      // SmartObject.m_RecalcAbilitysChanges := [racSubAbility, racFeatureChanged];
      if SmartObject.m_nLockUpdateAbil = 0 then
      begin
        SmartObject.RecalcAbilitys();
        SmartObject.SendMsg(SmartObject, RM_ABILITY, 0, 0, 0, 0, '');
        SmartObject.SendMsg(SmartObject, RM_SUBABILITY, 0, 0, 0, 0, '');
      end;

      SmartObject.FeatureChanged();
    end;
  end;

begin
  if BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT, RC_PLAYMOSTER] then
    SmartObject := TSmartObject(BaseObject)
  else
    Exit;

  sItemName := QuestActionInfo.sParam1;
  nItemCount := QuestActionInfo.nParam2;

  if SameText(sItemName, '[NECKLACE]') then
  begin
    DeleteUseItem(U_NECKLACE);
    Exit;
  end;

  if SameText(sItemName, '[RING]') then
  begin
    if SmartObject.m_UseItems[U_RINGL].wIndex > 0 then
      DeleteUseItem(U_RINGL)
    else if SmartObject.m_UseItems[U_RINGR].wIndex > 0 then
      DeleteUseItem(U_RINGR);
    Exit;
  end;

  if SameText(sItemName, '[ARMRING]') then
  begin
    if SmartObject.m_UseItems[U_ARMRINGL].wIndex > 0 then
      DeleteUseItem(U_ARMRINGL)
    else if SmartObject.m_UseItems[U_ARMRINGR].wIndex > 0 then
      DeleteUseItem(U_ARMRINGR);
    Exit;
  end;

  if SameText(sItemName, '[WEAPON]') then
  begin
    DeleteUseItem(U_WEAPON);
    Exit;
  end;

  if SameText(sItemName, '[HELMET]') then
  begin
    DeleteUseItem(U_HELMET);
    Exit;
  end;

  if SameText(sItemName, '[DRESS]') then
  begin
    DeleteUseItem(U_DRESS);
    Exit;
  end;

  if SameText(sItemName, '[BUJUK]') then
  begin
    DeleteUseItem(U_BUJUK);
    Exit;
  end;

  if SameText(sItemName, '[BELT]') then
  begin
    DeleteUseItem(U_BELT);
    Exit;
  end;

  if SameText(sItemName, '[BOOTS]') then
  begin
    DeleteUseItem(U_BOOTS);
    Exit;
  end;

  if SameText(sItemName, '[CHARM]') then
  begin
    DeleteUseItem(U_CHARM);
    Exit;
  end;

  if SameText(sItemName, '[HAT]') then
  begin
    DeleteUseItem(U_HAT);
    Exit;
  end;

  if SameText(sItemName, '[HORSE]') then
  begin
    DeleteUseItem(U_HORSE);
    Exit;
  end;

  if SameText(sItemName, '[SHIELD]') then
  begin
    DeleteUseItem(U_SHIELD);
    Exit;
  end;

  if SameText(sItemName, '[FASHIONDRESS]') then
  begin
    DeleteUseItem(U_FASHIONDRESS);
    Exit;
  end;

  if SameText(sItemName, '[FASHIONWEAPON]') then
  begin
    DeleteUseItem(U_FASHIONWEAPON);
    Exit;
  end;

  IsChanged := False;
  for I := Low(THumanUseItems) to High(THumanUseItems) do
  begin
    if nItemCount <= 0 then
      Break;
    if SmartObject.m_UseItems[I].wIndex > 0 then
    begin
      sName := UserEngine.GetStdItemName(SmartObject.m_UseItems[I].wIndex);
      if CompareText(sName, sItemName) = 0 then
      begin
        StdItem := UserEngine.GetStdItem(SmartObject.m_UseItems[I].wIndex);
        if (StdItem <> nil) and (StdItem.NeedIdentify = 1) then
        begin
          // 注释日志 chongchong 2017-10-09
          AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, SmartObject, StdItem.Name, SmartObject.m_UseItems[I].MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
        end;

        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
          TPlayObject(SmartObject).SendDelItem(@SmartObject.m_UseItems[I])
        else if SmartObject.m_btRaceServer = RC_HEROOBJECT then
          THeroObject(SmartObject).SendDelItem(@SmartObject.m_UseItems[I]);
        SmartObject.m_UseItems[I].wIndex := 0;

        IsChanged := True;
        Dec(nItemCount);
      end;
    end;
  end;

  for I := Low(THumanJewelryBoxItems) to High(THumanJewelryBoxItems) do
  begin
    if nItemCount <= 0 then
      Break;
    if SmartObject.m_JewelryBoxItems[I].wIndex > 0 then
    begin
      sName := UserEngine.GetStdItemName(SmartObject.m_JewelryBoxItems[I].wIndex);
      if CompareText(sName, sItemName) = 0 then
