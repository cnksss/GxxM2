procedure ActionOfRecallGamePet(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, Index: Integer;
  GamePetData: pTGamePetData;
  Target: TBaseObject;
  nX, nY: Integer;
  nTime: Integer;
begin
  if PlayObject.m_MyGamePet <> nil then
    Exit;

  if PlayObject.m_GamePetList.Count = 0 then
    Exit;

  Index := -1;
  if QuestActionInfo.sParam1 <> '' then
  begin
    for I := 0 to PlayObject.m_GamePetList.Count - 1 do
    begin
      GamePetData := PlayObject.m_GamePetList.Items[I];
      if SameText(GamePetData.sName, QuestActionInfo.sParam1) then
      begin
        Index := I;
        Break;
      end;
    end;
  end
  else
  begin
    Index := PlayObject.m_LastMyGamePetIndex;
    if Index < 0 then
      Index := 0
    else if Index >= PlayObject.m_GamePetList.Count then
      Index := 0;
  end;

  if Index < 0 then
    Exit;

  GamePetData := PlayObject.m_GamePetList.Items[Index];
  if tick_diff(GamePetData.DieTick, MyGetTickCount) <= g_Config.nGamePetRecallTime * 1000 then
  begin
    nTime := Round(g_Config.nGamePetRecallTime - tick_diff(GamePetData.DieTick, MyGetTickCount) / 1000);
    if nTime <= 0 then
      nTime := 1;

    PlayObject.SysMsg('你的宠物太虚弱，请等待' + IntToStr(nTime) + '秒后重新召唤', 255, 253, t_Hint);
    Exit;
  end;

  PlayObject.GetFrontPosition(nX, nY);
  Target := UserEngine.RegenMonsterByName(PlayObject.m_PEnvir.sMapName, nX, nY, GamePetData.sName);
  if Target <> nil then
  begin
    Target.m_Master := PlayObject; // 设置宝宝主人 -- piaoyun 2013-6-23

    Target.m_dwMasterRoyaltyStartTick := MyGetTickCount;
    Target.m_dwMasterRoyaltyTime := High(LongWord) - 10000;

    Target.m_Abil.Level := GamePetData.Level;
    Target.m_WAbil.Level := GamePetData.Level;

    Target.m_Abil.Exp := GamePetData.Exp;
    Target.m_WAbil.Exp := GamePetData.Exp;

    Target.m_boGamePet := True;

    Target.RecalcAbilitys;

    Target.m_Abil.MaxExp := Target.GetLevelExp(Target.m_Abil.Level);

    if GamePetData.HP <= Target.m_WAbil.MaxHP then
      Target.m_WAbil.HP := GamePetData.HP;

    if Target.m_WAbil.HP <= 0 then
      Target.m_WAbil.HP := 2;

    if GamePetData.MP <= Target.m_WAbil.MaxHP then
      Target.m_WAbil.MP := GamePetData.MP;

    PlayObject.m_MyGamePet := Target;
    PlayObject.m_MyGamePetIndex := Index;
    PlayObject.m_LastMyGamePetIndex := PlayObject.m_MyGamePetIndex;
    PlayObject.SendCurrentRecalGamePetIndex(Index);

    PlayObject.m_sMyGamePetName := PlayObject.m_MyGamePet.m_sCharName;
    if g_FunctionNPC <> nil then
    begin
      PlayObject.m_nScriptGotoCount := 0;
      g_FunctionNPC.GotoLable(PlayObject, '@GamePetRecall', False);
    end;

    // PlayObject.m_boRecalcAbilitys := True;
    // PlayObject.m_RecalcAbilitysChanges := PlayObject.m_RecalcAbilitysChanges + [racSubAbility];
    PlayObject.RecalcAbilitys;
    PlayObject.SendMsg(PlayObject, RM_ABILITY, 0, 0, 0, 0, '');
    PlayObject.SendMsg(PlayObject, RM_SUBABILITY, 0, 0, 0, 0, '');
  end;
end;

