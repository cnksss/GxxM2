    '+':
      begin
        Value := SmartObject.m_NpcSkillPowerAdd[wMagicIndex].HumanAttackPercent + QuestActionInfo.nParam3;
        if Value < Low(SmallInt) then
          Value := Low(SmallInt)
        else if Value > High(SmallInt) then
          Value := High(SmallInt);
        SmartObject.m_NpcSkillPowerAdd[wMagicIndex].HumanAttackPercent := Value;

        Value := SmartObject.m_NpcSkillPowerAdd[wMagicIndex].HumanAttackValue + QuestActionInfo.nParam4;
        if Value < Low(SmallInt) then
