      BaseObject.m_ActorIcons[nIndex].btDrawOrder := 0
    else
      BaseObject.m_ActorIcons[nIndex].btDrawOrder := 1;

    if QuestActionInfo.nParam9 <= 0 then
      BaseObject.m_ActorIcons[nIndex].nPlayTime := 300
    else
      BaseObject.m_ActorIcons[nIndex].nPlayTime := QuestActionInfo.nParam9;
    BaseObject.RefUseIcons;
  end;
