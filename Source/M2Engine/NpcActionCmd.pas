procedure ActionOfKill(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  nMode: Integer;
  boGhost: Boolean;
begin
  nMode := QuestActionInfo.nParam1;
  boGhost := QuestActionInfo.nParam2 <> 0;
  if nMode in [0..3] then
  begin
    // 2019-09-25 23:38:05
    BaseObject.bo94 := True;
    BaseObject.m_CurrTarget := Npc;

    case nMode of
      1:
        begin
          BaseObject.m_boNoItem := True;
          BaseObject.m_WAbil.HP := 0;
          BaseObject.Die;
        end;
      2:
        begin
          BaseObject.SetLastHiter(Npc);
          BaseObject.m_WAbil.HP := 0;
          BaseObject.Die;
        end;
      3:
        begin
          BaseObject.m_boNoItem := True;
          BaseObject.SetLastHiter(Npc);
          BaseObject.m_WAbil.HP := 0;
          BaseObject.Die;
        end;
    else
      begin
        BaseObject.m_WAbil.HP := 0;
        BaseObject.Die;
      end;
    end; // 人物，英雄 无法变成鬼魂 By 一支笔 at:2021-07-05 17:51:50
    if boGhost and not (BaseObject.m_btRaceServer in [RC_PLAYOBJECT, RC_HEROOBJECT]) then
      BaseObject.MakeGhost;
  end
  else
    Npc.ScriptActionError(BaseObject, '', QuestActionInfo);
end;

