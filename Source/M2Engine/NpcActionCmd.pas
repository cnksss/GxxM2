procedure ActionOfGmExecute(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  sData: string;
  btOldPermission: Byte;
  sParam1, sParam2, sParam3, sParam4, sParam5, sParam6: string;
begin
  sParam1 := QuestActionInfo.sParam1;
  sParam2 := QuestActionInfo.sParam2;
  sParam3 := QuestActionInfo.sParam3;
  sParam4 := QuestActionInfo.sParam4;
  sParam5 := QuestActionInfo.sParam5;
  sParam6 := QuestActionInfo.sParam6;

  if (not QuestActionInfo.boCompleteFormat2) and (QuestActionInfo.VarInfo2.VarAttr = aFixVar) and ((CompareText(sParam1, g_GameCommand.Move.sCmd) = 0) or (CompareText(sParam1, g_GameCommand.POSITIONMOVE.sCmd) = 0) or (CompareText(sParam1, g_GameCommand.MAPMOVE.sCmd) = 0) or (CompareText(sParam1, g_GameCommand.SHOWMAPMODE.sCmd) = 0) or (CompareText(sParam1, g_GameCommand.MAPINFO.sCmd) = 0) or (CompareText(sParam1, g_GameCommand.CLEARMON.sCmd) = 0)) then
  begin
    if (g_MapManager.FindMap(QuestActionInfo.sRawParam2) <> nil) then
      sParam2 := QuestActionInfo.sRawParam2;
  end
  else if (((not QuestActionInfo.boCompleteFormat2) and (QuestActionInfo.VarInfo2.VarAttr = aFixVar)) or ((not QuestActionInfo.boCompleteFormat3) and (QuestActionInfo.VarInfo3.VarAttr = aFixVar))) and (CompareText(sParam1, g_GameCommand.MAPMOVE.sCmd) = 0) then
  begin
    if g_MapManager.FindMap(QuestActionInfo.sRawParam2) <> nil then
      sParam2 := QuestActionInfo.sRawParam2;
    if g_MapManager.FindMap(QuestActionInfo.sRawParam3) <> nil then
      sParam3 := QuestActionInfo.sRawParam3;
  end;

  if CompareText(sParam2, 'Self') = 0 then
    sParam2 := PlayObject.m_sCharName;

  sData := Format('@%s %s %s %s %s %s', [sParam1, sParam2, sParam3, sParam4, sParam5, sParam6]);
  btOldPermission := PlayObject.m_btPermission;
  try
    PlayObject.m_btPermission := 10;
    PlayObject.m_boFromGmExecute := True;
    ProcessUserLineMsg(PlayObject, sData);
    // MainOutMessage('TNormNpc.ActionOfGmExecute '+sData);
  finally
    PlayObject.m_btPermission := btOldPermission;
    PlayObject.m_boFromGmExecute := False;
  end;
end;

