    Exit;
  end;

  LockUpdateItemIndex := -1;
  UserItem := nil;
  if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
  begin
    if BaseObject.m_btRaceServer = RC_PLAYOBJECT then
    begin
      LockUpdateItemIndex := GetBoxLockUpdateIndex(nBoxItemIndex);

      nMakeIndex := PlayObject.m_ItemBoxItems[nBoxItemIndex];
      if nMakeIndex = 0 then
        Exit;

      for I := 0 to PlayObject.m_ItemList.Count - 1 do
      begin
        if pTUserItem(PlayObject.m_ItemList[I]).MakeIndex = nMakeIndex then
        begin
          UserItem := PlayObject.m_ItemList[I];
          Break;
        end;
      end;
    end;
  end
  else if nWhere in [Low(THumanUseItems)..High(THumanUseItems)] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_UseItems[nWhere];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_JEWELRYITEM1..U_JEWELRYITEM6] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_JewelryBoxItems[nWhere - U_JEWELRYITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere in [U_GODBLESSITEM1..U_GODBLESSITEM12] then
  begin
    LockUpdateItemIndex := nWhere;

    UserItem := @SmartObject.m_GodBlessItems[nWhere - U_GODBLESSITEM1];
    // StdItem := UserEngine.GetStdItem(UserItem.wIndex);
    if (UserItem.wIndex <= 0) then
    begin
      if not g_Config.boCloseNPCNoItemMsg then
        SmartObject.SysMsg('你身上没有戴指定物品！', c_Red, t_Hint);
      Exit;
    end;
  end
  else if nWhere = -1 then
  begin
    if SmartObject.m_btRaceServer <> RC_HEROOBJECT then
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      UserItem := TPlayObject(SmartObject).GetUpdateItem;
    end
    else
    begin
      LockUpdateItemIndex := GetUpgradeLockUpdateIndex;

      for I := 0 to SmartObject.m_ItemList.Count - 1 do
      begin
        if SmartObject.m_ItemList.Items[I] = THeroObject(SmartObject).m_LinkItem then
        begin
          UserItem := THeroObject(SmartObject).m_LinkItem;
          Break;
        end;
      end;
    end;
  end;

  if UserItem <> nil then
  begin
    cMethod := QuestActionInfo.sParam4[1];

    if nValueType = 0 then
    begin
      case cMethod of
        '+':
          UserItem.Progress[nProgressIndex].wMax := Min(UserItem.Progress[nProgressIndex].wMax + nValue, High(Word));
        '-':
          UserItem.Progress[nProgressIndex].wMax := Max(UserItem.Progress[nProgressIndex].wMax - nValue, 0);
        '=':
          begin
            if nValue < 0 then
              UserItem.Progress[nProgressIndex].wMax := 0
            else if nValue > High(Word) then
              UserItem.Progress[nProgressIndex].wMax := High(Word)
            else
              UserItem.Progress[nProgressIndex].wMax := nValue;
          end;
      end;

      if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
      begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
            TPlayObject(SmartObject).SendUpdateItemProgress(nBoxItemIndex, True, UserItem, nProgressIndex)
          else
            TPlayObject(SmartObject).SendUpdateItemProgress(nWhere, False, UserItem, nProgressIndex);
        end
        else
          THeroObject(SmartObject).SendUpdateItemProgress(nWhere, UserItem, nProgressIndex);
      end;
    end
    else if nValueType = 1 then
    begin
      case cMethod of
        '+':
          UserItem.Progress[nProgressIndex].wValue := Min(UserItem.Progress[nProgressIndex].wValue + nValue, UserItem.Progress[nProgressIndex].wMax);
        '-':
          UserItem.Progress[nProgressIndex].wValue := Max(UserItem.Progress[nProgressIndex].wValue - nValue, 0);
        '=':
          begin
            if nValue < 0 then
              UserItem.Progress[nProgressIndex].wValue := 0
            else if nValue > UserItem.Progress[nProgressIndex].wMax then
              UserItem.Progress[nProgressIndex].wValue := UserItem.Progress[nProgressIndex].wMax
            else
              UserItem.Progress[nProgressIndex].wValue := nValue;
          end;
      end;

      if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
      begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
            TPlayObject(SmartObject).SendUpdateItemProgress(nBoxItemIndex, True, UserItem, nProgressIndex)
          else
            TPlayObject(SmartObject).SendUpdateItemProgress(nWhere, False, UserItem, nProgressIndex);
        end
        else
          THeroObject(SmartObject).SendUpdateItemProgress(nWhere, UserItem, nProgressIndex);
      end;
    end
    else if nValueType = 2 then
    begin
      if UserItem.Progress[nProgressIndex].wMax = 0 then
        nCurValue := 0
      else
        nCurValue := Round(UserItem.Progress[nProgressIndex].wValue / UserItem.Progress[nProgressIndex].wMax * 100);

      case cMethod of
        '+':
          UserItem.Progress[nProgressIndex].wValue := Round(Min(nCurValue + nValue, 100) / 100 * UserItem.Progress[nProgressIndex].wMax);
        '-':
          UserItem.Progress[nProgressIndex].wValue := Round(Max(nCurValue - nValue, 0) / 100 * UserItem.Progress[nProgressIndex].wMax);
        '=':
          begin
            if nValue < 0 then
              UserItem.Progress[nProgressIndex].wValue := 0
            else if nValue > 100 then
              UserItem.Progress[nProgressIndex].wValue := UserItem.Progress[nProgressIndex].wMax
            else
              UserItem.Progress[nProgressIndex].wValue := Round(nValue / 100 * UserItem.Progress[nProgressIndex].wMax);
          end;
      end;

      if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
      begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
            TPlayObject(SmartObject).SendUpdateItemProgress(nBoxItemIndex, True, UserItem, nProgressIndex)
          else
            TPlayObject(SmartObject).SendUpdateItemProgress(nWhere, False, UserItem, nProgressIndex);
        end
        else
          THeroObject(SmartObject).SendUpdateItemProgress(nWhere, UserItem, nProgressIndex);
      end;
    end
    else if nValueType = 3 then
    begin
      case cMethod of
        '+':
          UserItem.Progress[nProgressIndex].wLevel := Min(UserItem.Progress[nProgressIndex].wLevel + nValue, High(Word));
        '-':
          UserItem.Progress[nProgressIndex].wLevel := Max(UserItem.Progress[nProgressIndex].wLevel - nValue, 0);
        '=':
          begin
            if nValue < 0 then
              UserItem.Progress[nProgressIndex].wLevel := 0
            else if nValue > High(Word) then
              UserItem.Progress[nProgressIndex].wLevel := High(Word)
            else
              UserItem.Progress[nProgressIndex].wLevel := nValue;
          end;
      end;

      if SmartObject.m_nLockUpdateItems[LockUpdateItemIndex] = 0 then
      begin
        if SmartObject.m_btRaceServer = RC_PLAYOBJECT then
        begin
          if nBoxItemIndex in [Low(THumanItemBoxItems)..High(THumanItemBoxItems)] then
            TPlayObject(SmartObject).SendUpdateItemProgress(nBoxItemIndex, True, UserItem, nProgressIndex)
          else
            TPlayObject(SmartObject).SendUpdateItemProgress(nWhere, False, UserItem, nProgressIndex);
        end
        else
          THeroObject(SmartObject).SendUpdateItemProgress(nWhere, UserItem, nProgressIndex);
      end;
    end
  end;
end;

