  if (not QuestActionInfo.boCompleteFormat1) and (QuestActionInfo.VarInfo1.VarAttr = aFixVar) then
    Envir := g_MapManager.FindMap(QuestActionInfo.sRawParam1);
  if Envir = nil then
    Envir := g_MapManager.FindMap(QuestActionInfo.sParam1);

  if Envir = nil then
    Exit;

  if QuestActionInfo.sRawParam3 = '' then
  begin
    Npc.ScriptActionError(PlayObject, '变量名不能为空', QuestActionInfo);
    Exit;
  end;

  nCount := 0;

  UserEngine.m_PlayObjectList.LockR(240);
  try
    for I := 0 to UserEngine.m_PlayObjectList.Count - 1 do
    begin
      Player := TPlayObject(UserEngine.m_PlayObjectList.Objects[I]);
      if Player <> nil then
      begin
        if not Player.m_boDeath and not PlayObject.m_boGhost and (Player.m_PEnvir = Envir) then
        begin
          if not ((QuestActionInfo.nParam2 = 1) and (Player.m_boDummyObject)) then
            Inc(nCount);
        end;
      end;
    end;
  finally
    UserEngine.m_PlayObjectList.UnLockR;
  end;

  if not Npc.SetVarValue(PlayObject, QuestActionInfo.sRawParam3, IntToStr(nCount), nCount) then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
  end;
end;

procedure ActionOfGetMapMonCount(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
