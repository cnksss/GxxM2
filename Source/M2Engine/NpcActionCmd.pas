procedure ActionOfSetRandomNo(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);
var
  I, nIndex, nCount: Integer;
  List: TStringList;
  P: PChar;
begin
  List := TStringList.Create;

  for I := 0 to 9 do // 0~9
    List.Add(IntToStr(I));

  if QuestActionInfo.nParam1 and 1 <> 0 then
  begin
    for I := 97 to 122 do // a~z      //10~25
      List.Add(Chr(I));
  end;

  if QuestActionInfo.nParam1 and 2 <> 0 then
  begin
    for I := 65 to 90 do // A~Z     //26~51
      List.Add(Chr(I));
  end;

  nCount := 4;
  PlayObject.m_sRandomString := '';
  PlayObject.m_sInputData := '';
  SetLength(PlayObject.m_sRandomString, nCount);
  P := PChar(PlayObject.m_sRandomString);
  while True do
  begin
    if nCount <= 0 then
      Break;
    nIndex := Random(List.Count);
    if (nIndex >= 0) and (nIndex < List.Count) then
    begin
      P^ := List.Strings[nIndex][1];
      Inc(P);
      Dec(nCount);
    end;
  end;
  List.Free;
end;

procedure ActionOfGiveFoundryItem(Npc: TNormNpc; BaseObject: TBaseObject; PlayObject: TPlayObject; QuestActionInfo: pTQuestActionInfo; var boSendNpcSay, boBreak: Boolean);

  procedure DeleteBagItemCount(const sItemName: string; nItemCount: Integer);
  var
    I: Integer;
    UserItem: pTUserItem;
    StdItem: pTStdItem;
  begin
    for I := PlayObject.m_ItemList.Count - 1 downto 0 do
    begin
      if nItemCount <= 0 then
        Break;
      UserItem := PlayObject.m_ItemList.Items[I];
      StdItem := UserEngine.GetStdItem(UserItem.wIndex);
      if (StdItem <> nil) and (CompareText(StdItem.Name, sItemName) = 0) then
      begin
        if CheckOverLapItem(StdItem) then
        begin // 叠加物品
          if nItemCount >= UserItem.Dura + 1 then
          begin
            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, -(UserItem.Dura + 1), Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            // 删除物品时，清升级框  chongchong 2018-05-16
            if PlayObject.m_UpgradeItem = UserItem then
            begin
              PlayObject.m_UpgradeItem := nil;
              PlayObject.m_UpgradeItemIsPegBag := False;
            end;

            nItemCount := nItemCount - (UserItem.Dura + 1);
            PlayObject.m_ItemList.Delete(I);
            PlayObject.SendDelItem(UserItem);
            Dispose(UserItem);
          end
          else
          begin
            UserItem.Dura := UserItem.Dura - nItemCount;
            PlayObject.SendUpdateItemDura(-1, UserItem.MakeIndex, False, UserItem.Dura);

            if StdItem.NeedIdentify = 1 then
            begin
              // 注释日志 chongchong 2017-10-09
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, UserItem.Dura + 1, -nItemCount, '部分回收;' + Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;

            Break;
          end;
        end
        else
        begin
          if StdItem.NeedIdentify = 1 then
          begin
            // 注释日志 chongchong 2017-10-09
            AddGameDataLog(LOG_ItemNpcRecycle, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
          end;

          // 删除物品时，清升级框  chongchong 2018-05-16
          if PlayObject.m_UpgradeItem = UserItem then
          begin
            PlayObject.m_UpgradeItem := nil;
            PlayObject.m_UpgradeItemIsPegBag := False;
          end;

          PlayObject.m_ItemList.Delete(I);
          PlayObject.SendDelItem(UserItem);
          Dispose(UserItem);
          Dec(nItemCount);
          if nItemCount <= 0 then
          begin
            Break;
          end;
        end;
      end;
    end;
  end;

var
  I, nItemCount: Integer;
  sItemName: string;
  FoundryItem: pTFoundryItem;
  FoundryNeedItem: pTFoundryNeedItem;
  UserItem: pTUserItem;
  StdItem: pTStdItem;
  OverLapItemsCount: Integer;
  OverLapItem: pTUserItem;
  nOldPoint: LongWord;
  OldDura: Word;
begin
  sItemName := QuestActionInfo.sParam1;
  if CompareText(sItemName, '%FoundryItem') = 0 then
  begin
    sItemName := PlayObject.m_sNpcSelectItemName;
  end;
  if sItemName = '' then
  begin
    Npc.ScriptActionError(PlayObject, '', QuestActionInfo);
    Exit;
  end;
  FoundryItem := GetFoundryItem(sItemName);
  if (FoundryItem <> nil) and (FoundryItem.nItemCount > 0) then
  begin
    StdItem := UserEngine.GetStdItem(sItemName);
    if StdItem <> nil then
    begin
      // MainOutMessage('ActionOfGiveFoundryItem:'+sItemName+' FoundryItem.nItemRate:'+IntToStr(FoundryItem.nItemRate));
      if Random(100) < FoundryItem.nItemRate then
      begin
        nItemCount := FoundryItem.nItemCount;
        for I := 0 to FoundryItem.ItemList.Count - 1 do
        begin
          FoundryNeedItem := FoundryItem.ItemList.Items[I];
          if CompareText(FoundryNeedItem.sItemName, sSTRING_GOLDNAME) = 0 then
          begin
            nOldPoint := PlayObject.m_nGold;
            PlayObject.DecGold(FoundryNeedItem.nItemCount);
            PlayObject.GoldChanged;

            if g_boGameLogGold and (nOldPoint <> PlayObject.m_nGold) then
            begin
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_GoldChange, PlayObject, sSTRING_GOLDNAME, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGold, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end
          else if CompareText(FoundryNeedItem.sItemName, g_Config.sGameGoldName) = 0 then
          begin
            nOldPoint := PlayObject.m_nGameGold;
            PlayObject.DecGameGold(FoundryNeedItem.nItemCount);
            PlayObject.GameGoldChanged;

            if g_boGameLogGameGold and (nOldPoint <> PlayObject.m_nGameGold) then
            begin
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_GameGoldChange, PlayObject, g_Config.sGameGoldName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGameGold, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end
          else if CompareText(FoundryNeedItem.sItemName, g_Config.sCreditPointName) = 0 then
          begin
            nOldPoint := PlayObject.m_WAbil.CreditPoint;
            if PlayObject.m_WAbil.CreditPoint >= FoundryNeedItem.nItemCount then
              PlayObject.m_WAbil.CreditPoint := PlayObject.m_WAbil.CreditPoint - FoundryNeedItem.nItemCount
            else
              PlayObject.m_WAbil.CreditPoint := 0;

            // 声望日志
            AddGameDataLog(LOG_ItemNpcRecycle, LOG_CreditPointChange, PlayObject, g_Config.sCreditPointName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_WAbil.CreditPoint, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));

            PlayObject.SendMsg(PlayObject, RM_ABILITY, 0, 0, 0, 0, '');
          end
          else if CompareText(FoundryNeedItem.sItemName, g_Config.sGamePointName) = 0 then
          begin
            nOldPoint := PlayObject.m_nGamePoint;
            PlayObject.DecGamePoint(FoundryNeedItem.nItemCount);
            PlayObject.GameGoldChanged;

            if g_boGameLogGamePoint and (nOldPoint <> PlayObject.m_nGamePoint) then
            begin
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_GamePointChange, PlayObject, g_Config.sGamePointName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGamePoint, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end
          else if CompareText(FoundryNeedItem.sItemName, g_Config.sGameGirdName) = 0 then
          begin
            nOldPoint := PlayObject.m_nGameGird;
            PlayObject.DecGameGird(FoundryNeedItem.nItemCount);
            PlayObject.NewGamePointChanged;

            if (nOldPoint <> PlayObject.m_nGameGird) then
            begin
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_GameGirdChange, PlayObject, g_Config.sGameGirdName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGameGird, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end
          else if CompareText(FoundryNeedItem.sItemName, g_Config.sGameDiamondName) = 0 then
          begin
            nOldPoint := PlayObject.m_nGameDiamond;
            PlayObject.DecGameDiamond(FoundryNeedItem.nItemCount);
            PlayObject.NewGamePointChanged;

            if (nOldPoint <> PlayObject.m_nGameDiamond) then
            begin
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_GameDiamondChange, PlayObject, g_Config.sGameDiamondName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGameDiamond, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end;
          end
          else
          begin
            DeleteBagItemCount(FoundryNeedItem.sItemName, FoundryNeedItem.nItemCount);
          end;
        end;
        // MainOutMessage('1 ActionOfGiveFoundryItem:'+sItemName+' nItemCount:'+IntToStr(nItemCount));
        if CheckOverLapItem(StdItem) then
        begin
          while True do
          begin
            if nItemCount <= 0 then
              Break;

            // GIVE 叠加物品 不自动重叠到已有的物品上面 chongchong 2014-04-09
            OverLapItemsCount := OverLapBagItemCount(BaseObject, StdItem, OverLapItem);
            if OverLapItemsCount > 0 then
            begin
              if OverLapItemsCount > nItemCount then
              begin
                OldDura := OverLapItem.Dura;
                OverLapItem.Dura := OverLapItem.Dura + nItemCount;
                nItemCount := 0
              end
              else
              begin
                OldDura := OverLapItem.Dura;
                OverLapItem.Dura := OverLapItem.Dura + OverLapItemsCount;
                nItemCount := nItemCount - OverLapItemsCount;
              end;

              PlayObject.SendUpdateItemDura(-1, OverLapItem.MakeIndex, False, OverLapItem.Dura);
              PlayObject.WeightChanged;

              if StdItem.NeedIdentify = 1 then
              begin
                // 注释日志 chongchong 2017-10-09
                AddGameDataLog(LOG_ItemNpcGive, LOG_ActionNone, PlayObject, StdItem.DBName, OverLapItem.MakeIndex, Npc.m_sCharName, OverLapItem.Dura + 1, OldDura + 1, Format('叠加;[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
              end;
            end
            else if PlayObject.IsEnoughBag then
            begin
              New(UserItem);
              if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
              begin
                if UserItem.DuraMax > nItemCount then
                begin
                  UserItem.Dura := nItemCount - 1;
                  nItemCount := 0;
                end
                else
                begin
                  UserItem.Dura := UserItem.DuraMax - 1;
                  nItemCount := nItemCount - UserItem.DuraMax;
                end;

                UserItem.ItemFrom.ItemForm := ifScript;
                UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
                UserItem.ItemFrom.DateTime := Now();

                PlayObject.m_ItemList.Add(UserItem);
                PlayObject.SendAddItem(UserItem);

                PlayObject.WeightChanged;

                // 添加铸造成功标签 piaoyun 2013-07-27
                PlayObject.m_sLackFoundryItem := sItemName;
                ;
                Npc.GotoLable(PlayObject, '@FoundryOK', False);
                // MainOutMessage('2 ActionOfGiveFoundryItem:'+sItemName+' nItemCount:'+IntToStr(nItemCount));
                if StdItem.NeedIdentify = 1 then
                begin
                  // 注释日志 chongchong 2017-10-09
                  AddGameDataLog(LOG_ItemNpcGive, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
                end;
              end
              else
                Dispose(UserItem);
            end
            else
            begin
              New(UserItem);
              if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
              begin
                if UserItem.DuraMax > nItemCount then
                begin
                  UserItem.Dura := nItemCount - 1;
                  nItemCount := 0;
                end
                else
                begin
                  UserItem.Dura := UserItem.DuraMax - 1;
                  nItemCount := nItemCount - UserItem.DuraMax;
                end;

                UserItem.ItemFrom.ItemForm := ifScript;
                UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
                UserItem.ItemFrom.DateTime := Now();
                PlayObject.DropItemDown(UserItem, 3, False, PlayObject, nil);

                if StdItem.NeedIdentify = 1 then
                begin
                  // 注释日志 chongchong 2017-10-09
                  AddGameDataLog(LOG_ItemNpcGive, LOG_ItemDrop, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
                end;
              end;
              Dispose(UserItem);
            end;
          end;
        end
        else
        begin // if CheckOverLapItem(StdItem) then begin
          for I := 0 to nItemCount - 1 do
          begin // nItemCount 为0时出死循环
            if PlayObject.IsEnoughBag then
            begin
              New(UserItem);
              if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
              begin
                UserItem.ItemFrom.ItemForm := ifScript;
                UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
                UserItem.ItemFrom.DateTime := Now();

                PlayObject.m_ItemList.Add(UserItem);
                PlayObject.SendAddItem(UserItem);
                // 添加铸造成功标签 piaoyun 2013-07-27
                PlayObject.m_sLackFoundryItem := sItemName;

                if (UserItem.boStartTime) then
                begin
                  if StdItem.Need = 103 then
                    PlayObject.SysMsg(Format('您的限时物品[%s]开始计时，有效时间%d分钟。', [StdItem.Name, StdItem.NeedLevel]), c_Red, t_System)
                  else
                    PlayObject.SysMsg(Format('您的限时物品[%s]开始计时，到期时间%s', [StdItem.Name, GetIncMinuteTime(UserItem.ItemFrom.DateTime, StdItem.NeedLevel)]), c_Red, t_System)
                end;

                PlayObject.WeightChanged;
                Npc.GotoLable(PlayObject, '@FoundryOK', False);

                if StdItem.NeedIdentify = 1 then
                begin
                  // 注释日志 chongchong 2017-10-09
                  AddGameDataLog(LOG_ItemNpcGive, LOG_ActionNone, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
                end;
              end
              else
                Dispose(UserItem);
            end
            else
            begin
              New(UserItem);
              if UserEngine.CopyToUserItemFromName(sItemName, UserItem) then
              begin

                UserItem.ItemFrom.ItemForm := ifScript;
                UserItem.ItemFrom.sMakerName := PlayObject.m_sCharName;
                UserItem.ItemFrom.DateTime := Now();

                PlayObject.DropItemDown(UserItem, 3, False, PlayObject, nil);

                if StdItem.NeedIdentify = 1 then
                begin
                  // 注释日志 chongchong 2017-10-09
                  AddGameDataLog(LOG_ItemNpcGive, LOG_ItemDrop, PlayObject, StdItem.Name, UserItem.MakeIndex, Npc.m_sCharName, 0, 0, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
                end;
              end;
              Dispose(UserItem);
            end;
          end;
        end;
      end
      else
      begin // if Random(abs(100 - FoundryItem.nItemRate)) = 0 then begin
        for I := 0 to FoundryItem.ItemList.Count - 1 do
        begin
          FoundryNeedItem := FoundryItem.ItemList.Items[I];
          if FoundryNeedItem.btDelete = 1 then
          begin
            if CompareText(FoundryNeedItem.sItemName, sSTRING_GOLDNAME) = 0 then
            begin
              nOldPoint := PlayObject.m_nGold;

              PlayObject.DecGold(FoundryNeedItem.nItemCount);
              PlayObject.GoldChanged;

              if g_boGameLogGold and (nOldPoint <> PlayObject.m_nGold) then
              begin
                AddGameDataLog(LOG_ItemNpcRecycle, LOG_GoldChange, PlayObject, sSTRING_GOLDNAME, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGold, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
              end
            end
            else if CompareText(FoundryNeedItem.sItemName, g_Config.sGameGoldName) = 0 then
            begin
              nOldPoint := PlayObject.m_nGameGold;

              PlayObject.DecGameGold(FoundryNeedItem.nItemCount);
              PlayObject.GameGoldChanged;

              if g_boGameLogGameGold and (nOldPoint <> PlayObject.m_nGameGold) then
              begin
                AddGameDataLog(LOG_ItemNpcRecycle, LOG_GameGoldChange, PlayObject, g_Config.sGameGoldName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGameGold, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
              end;
            end
            else if CompareText(FoundryNeedItem.sItemName, g_Config.sCreditPointName) = 0 then
            begin
              nOldPoint := PlayObject.m_WAbil.CreditPoint;
              if PlayObject.m_WAbil.CreditPoint >= FoundryNeedItem.nItemCount then
                PlayObject.m_WAbil.CreditPoint := PlayObject.m_WAbil.CreditPoint - FoundryNeedItem.nItemCount
              else
                PlayObject.m_WAbil.CreditPoint := 0;

              // 声望日志
              AddGameDataLog(LOG_ItemNpcRecycle, LOG_CreditPointChange, PlayObject, g_Config.sCreditPointName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_WAbil.CreditPoint, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
            end
            else if CompareText(FoundryNeedItem.sItemName, g_Config.sGamePointName) = 0 then
            begin
              nOldPoint := PlayObject.m_nGamePoint;

              PlayObject.DecGamePoint(FoundryNeedItem.nItemCount);
              PlayObject.GameGoldChanged;

              if g_boGameLogGamePoint and (nOldPoint <> PlayObject.m_nGamePoint) then
              begin
                AddGameDataLog(LOG_ItemNpcRecycle, LOG_GamePointChange, PlayObject, g_Config.sGamePointName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGamePoint, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
              end;
            end
            else if CompareText(FoundryNeedItem.sItemName, g_Config.sGameGirdName) = 0 then
            begin
              nOldPoint := PlayObject.m_nGameGird;
              PlayObject.DecGameGird(FoundryNeedItem.nItemCount);
              PlayObject.NewGamePointChanged;

              if (nOldPoint <> PlayObject.m_nGameGird) then
              begin
                AddGameDataLog(LOG_ItemNpcRecycle, LOG_GameGirdChange, PlayObject, g_Config.sGameGirdName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGameGird, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
              end;
            end
            else if CompareText(FoundryNeedItem.sItemName, g_Config.sGameDiamondName) = 0 then
            begin
              nOldPoint := PlayObject.m_nGameDiamond;
              PlayObject.DecGameDiamond(FoundryNeedItem.nItemCount);
              PlayObject.NewGamePointChanged;

              if (nOldPoint <> PlayObject.m_nGameDiamond) then
              begin
                AddGameDataLog(LOG_ItemNpcRecycle, LOG_GameDiamondChange, PlayObject, g_Config.sGameDiamondName, -FoundryNeedItem.nItemCount, Npc.m_sCharName, PlayObject.m_nGameDiamond, nOldPoint, Format('[%s]%s', [Npc.m_sLastLabel, QuestActionInfo.sCmdLine]));
              end;
            end
            else
            begin
              DeleteBagItemCount(FoundryNeedItem.sItemName, FoundryNeedItem.nItemCount);
            end;
          end;
        end;
        PlayObject.m_sLackFoundryItem := sItemName;
        Npc.GotoLable(PlayObject, '@FoundryFail', False);
      end;
    end;
  end;
end;

