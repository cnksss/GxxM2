package Mir2Pack;

{$R *.res}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Mir2Pack'}
{$IMPLICITBUILD ON}
{$DEFINE DEBUG}

requires
  rtl,
  vcl,
  VclSmp,
  vclx,
  dclstd,
  designide,
  vclactnband,
  vclie;

contains
  ColorIndexEdit in '..\source\ColorIndexEdit.pas',
  Mir2Reg in '..\source\Mir2Reg.pas',
  SpinEditEx in '..\source\SpinEditEx.pas',
  BmpProgressBar in '..\source\BmpProgressBar.pas',
  PictureButton in '..\source\PictureButton.pas',
  PaintPanel in '..\source\PaintPanel.pas',
  ButtonEdit in '..\source\ButtonEdit.pas',
  EditEx in '..\source\EditEx.pas',
  FrmWizard in '..\source\FrmWizard.pas',
  StyleForm in '..\source\StyleForm.pas',
  Mir2Common in '..\source\Mir2Common.pas',
  HtmlLabel in '..\source\HtmlLabel.pas',
  SimpleHTML in '..\source\SimpleHTML.pas',
  RealTimeMarquee in '..\source\RealTimeMarquee.pas',
  ThreadTimer in '..\source\ThreadTimer.pas';

end.
