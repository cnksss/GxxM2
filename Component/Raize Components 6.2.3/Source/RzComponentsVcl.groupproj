    <Target Name="RaizeComponentsVcl_Design:Make">
        <MSBuild Projects="RaizeComponentsVcl_Design.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="RaizeComponentsVcl;RaizeComponentsVcl_Design"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="RaizeComponentsVcl:Clean;RaizeComponentsVcl_Design:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="RaizeComponentsVcl:Make;RaizeComponentsVcl_Design:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
